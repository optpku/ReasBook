def cachedGramNumerator (a b : Bool) (d : ℕ) : IntInterval :=
  (gramCacheTree.get ((if a then 2048 else 0) + (if b then 1024 else 0) + d % 1024)).re

def cachedGramEntryNumerator (i j : ℕ) : IntInterval :=
  cachedGramNumerator (decide (1024 ≤ i)) (decide (1024 ≤ j))
    ((j % 1024 + 1024 - i % 1024) % 1024)

def cachedPairNumerator (A B : SparseVector) : IntInterval :=
  IntInterval.sum (A.map fun a ↦ IntInterval.sum (B.map fun b ↦
    IntInterval.scale (a.2 * b.2) (cachedGramEntryNumerator a.1 b.1)))

