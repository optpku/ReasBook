/-! ## Positive definiteness of the period-48 Gram matrix -/

/-- Reindexing the flat integer matrix `2K - I₉₆` along `finProdFinEquiv` and adding
the rank-one correction `3hhᵀ` reproduces the period-48 Gram matrix `H`. -/
lemma gramMatrix_eq_j0_reindex_add_rankOne :
    gramMatrix =
      (j0.map (Int.castRingHom ℝ)).submatrix finProdFinEquiv finProdFinEquiv +
        (3 : ℝ) • Matrix.vecMulVec perturbationVector perturbationVector := by
  -- Compare entries block by block: `j0_blocks` gives the reindexed integer part and
  -- the defining body of `gramMatrix` gives the rank-one perturbation.
  ext ⟨a₁, a₂⟩ ⟨b₁, b₂⟩
  simp only [Matrix.add_apply, Matrix.submatrix_apply, Matrix.map_apply, Matrix.smul_apply,
    Matrix.vecMulVec_apply, gramMatrix_apply, j0_blocks, Int.coe_castRingHom]
  push_cast
  ring

/-- The period-48 Gram matrix `H = 2K - I₉₆ + 3hhᵀ` is positive definite. -/
theorem gramMatrix_posDef : gramMatrix.PosDef := by
  -- Rewrite `H` as a reindexing of the positive definite `2K - I₉₆` plus a positive
  -- semidefinite rank-one term, then apply the two definiteness closure rules.
  rw [gramMatrix_eq_j0_reindex_add_rankOne]
  refine (j0_posDef.submatrix finProdFinEquiv.injective).add_posSemidef ?_
  refine Matrix.PosSemidef.smul ?_ (by norm_num : (0 : ℝ) ≤ 3)
  simpa using Matrix.posSemidef_vecMulVec_star_self perturbationVector

/-! ## Compactness and convexity of the realized hulls -/

/-- The convex hull of a finite set in a topological real vector space is a compact
convex polytope. -/
theorem Set.Finite.isCompactConvexPolytope {E : Type*} [AddCommGroup E] [Module ℝ E]
    [TopologicalSpace E] [IsTopologicalAddGroup E] [ContinuousSMul ℝ E]
    {s : Set E} (hs : s.Finite) :
    IsCompactConvexPolytope (convexHull ℝ s) := by
  -- Compactness and convexity are the standard finite-hull facts, and the finset of
  -- the finite set presents the hull as a finite convex hull.
  refine ⟨hs.isCompact_convexHull ℝ, convex_convexHull ℝ s, hs.toFinset, ?_⟩
  rw [hs.coe_toFinset]

/-- The two convex hulls generated by the origin and the realized vertex families of a
Gram factor are compact convex polytopes. -/
theorem xSet_ySet_isCompactConvexPolytope
    (S : Matrix (Fin 2 × Fin 48) (Fin 2 × Fin 48) ℝ) :
    IsCompactConvexPolytope (xSet S) ∧ IsCompactConvexPolytope (ySet S) := by
  -- Both hulls are convex hulls of finite sets, namely the origin together with one
  -- of the two realized vertex families.
  rw [Realization.xSet_def, Realization.ySet_def]
  exact ⟨Set.Finite.isCompactConvexPolytope ((Set.finite_range (xi S)).insert 0),
    Set.Finite.isCompactConvexPolytope ((Set.finite_range (eta S)).insert 0)⟩

/-- On the critical half-line the generic projection-cycle hulls of the realized data
coincide with the two multiplier-independent realized hulls. -/
theorem xSet_ySet_eq
    (S : Matrix (Fin 2 × Fin 48) (Fin 2 × Fin 48) ℝ) (γ : ℝ)
    (lowerBound : criticalFactor ≤ γ) :
    ProjectionCycle.xSet γ (eta S) (nu S γ) = xSet S ∧
      ProjectionCycle.ySet (eta S) = ySet S := by
  have hγ : γ ≠ 0 := (criticalFactor_pos.trans_le lowerBound).ne'
  constructor
  -- The generic vertices are the realized vertices, so the two ranges agree.
  · rw [ProjectionCycle.xSet_def, Realization.xSet_def]
    -- The two ranges agree because the generic vertex at every phase is the realized
    -- vertex of the same phase.
    have hrange : Set.range (fun i => ProjectionCycle.xVertex γ (eta S) (nu S γ) i) =
        Set.range (xi S) := by
      ext z
      constructor
      · rintro ⟨i, rfl⟩
        exact ⟨i, (Realization.xVertex_eq S γ hγ i).symm⟩
      · rintro ⟨i, rfl⟩
        exact ⟨i, Realization.xVertex_eq S γ hγ i⟩
    rw [hrange]
  -- The second hull is definitionally the same convex hull.
  · rfl

/-! ## Realized-to-coefficient bridges for the normals and vertices -/

/-- The realized first-block supporting normal is the `S`-image of the coefficient
first normal. -/
lemma realized_firstNormal_eq
    (S : Matrix (Fin 2 × Fin 48) (Fin 2 × Fin 48) ℝ) (γ : ℝ) (hγ : γ ≠ 0)
    (i : ZMod 48) :
    ProjectionCycle.firstNormal γ (eta S) (nu S γ) i =
      WithLp.toLp 2 (S.mulVec (Coefficient.firstNormal γ i)) := by
  -- Expand the realized normal and push the matrix action and the embedding through
  -- the affine combination defining `Coefficient.firstNormal`.
  rw [Realization.firstNormal_eq S γ hγ i, Realization.eta_apply, Realization.w_mulVec,
    Realization.xi_mulVec, Coefficient.firstNormal]
  simp only [Matrix.mulVec_sub, Matrix.mulVec_smul, WithLp.toLp_sub, WithLp.toLp_smul]

/-- The realized second-block supporting normal is the `S`-image of the coefficient
second normal. -/
lemma realized_secondNormal_eq
    (S : Matrix (Fin 2 × Fin 48) (Fin 2 × Fin 48) ℝ) (γ : ℝ) (hγ : γ ≠ 0)
    (i : ZMod 48) :
    ProjectionCycle.secondNormal γ (nu S γ) i =
      WithLp.toLp 2 (S.mulVec (Coefficient.secondNormal γ i)) := by
  -- Expand the realized normal and push the matrix action and the embedding through
  -- the affine combination defining `Coefficient.secondNormal`.
  rw [Realization.secondNormal_eq S γ hγ i, Realization.w_mulVec, Realization.rho_mulVec,
    Coefficient.secondNormal]
  simp only [Matrix.mulVec_add, Matrix.mulVec_smul, WithLp.toLp_add, WithLp.toLp_smul]

/-- The realized first-block vertex difference is the `S`-image of the coefficient
vertex difference. -/
lemma xi_sub_eq (S : Matrix (Fin 2 × Fin 48) (Fin 2 × Fin 48) ℝ) (i j : ZMod 48) :
    xi S i - xi S j = WithLp.toLp 2 (S.mulVec (Coefficient.xi i - Coefficient.xi j)) := by
  -- Distribute the matrix action and the embedding over both differences.
  rw [Realization.xi_mulVec S, Realization.xi_mulVec S, ← WithLp.toLp_sub,
    ← Matrix.mulVec_sub]

/-- The realized first-block family difference is the `S`-image of the coefficient
family difference. -/
lemma eta_sub_eq (S : Matrix (Fin 2 × Fin 48) (Fin 2 × Fin 48) ℝ) (i j : ZMod 48) :
    eta S i - eta S j = WithLp.toLp 2 (S.mulVec (Coefficient.eta i - Coefficient.eta j)) := by
  -- Distribute the matrix action and the embedding over both differences.
  rw [Realization.eta_apply S, Realization.eta_apply S, ← WithLp.toLp_sub,
    ← Matrix.mulVec_sub]

/-- The coefficient pairing of a block normal against its own vertex is the
corresponding origin support. -/
lemma support_eq_origin_pairing (b : Fin 2) (γ : ℝ) (i : ZMod 48) :
    Coefficient.support b γ i 0 =
      dotProduct (Coefficient.normal b γ i) (gramMatrix.mulVec (Coefficient.vertex b i)) := by
  rw [Coefficient.support_def, Coefficient.testVector_eq_origin]

/-- The coefficient pairing of a block normal against a vertex difference is the
corresponding nonself support. -/
lemma support_eq_diff_pairing (b : Fin 2) (γ : ℝ) (i j : ZMod 48) (hj : j ≠ i) :
    Coefficient.support b γ i (j - i) =
      dotProduct (Coefficient.normal b γ i)
        (gramMatrix.mulVec (Coefficient.vertex b i - Coefficient.vertex b j)) := by
  have hji : (j - i) ≠ 0 := sub_ne_zero.mpr hj
  have hcancel : i + (j - i) = j := by rw [add_comm, sub_add_cancel]
  rw [Coefficient.support_def, Coefficient.testVector_eq_diff b i (j - i) hji, hcancel]

/-- The realized first-block origin support is the coefficient pairing of the
first-block normal against its vertex. -/
lemma inner_firstNormal_xi
    (S : Matrix (Fin 2 × Fin 48) (Fin 2 × Fin 48) ℝ)
    (factor : S.transpose * S = gramMatrix) (γ : ℝ) (hγ : γ ≠ 0) (i : ZMod 48) :
    inner ℝ (ProjectionCycle.firstNormal γ (eta S) (nu S γ) i) (xi S i) =
      dotProduct (Coefficient.normal 0 γ i) (gramMatrix.mulVec (Coefficient.vertex 0 i)) := by
  rw [realized_firstNormal_eq S γ hγ i, Realization.xi_mulVec,
    Realization.inner_mulVec S factor, Coefficient.normal_zero, Coefficient.vertex_zero]

/-- The realized first-block nonself support is the coefficient pairing of the
first-block normal against a vertex difference. -/
lemma inner_firstNormal_xi_sub
    (S : Matrix (Fin 2 × Fin 48) (Fin 2 × Fin 48) ℝ)
    (factor : S.transpose * S = gramMatrix) (γ : ℝ) (hγ : γ ≠ 0) (i j : ZMod 48) :
    inner ℝ (ProjectionCycle.firstNormal γ (eta S) (nu S γ) i) (xi S i - xi S j) =
      dotProduct (Coefficient.normal 0 γ i)
        (gramMatrix.mulVec (Coefficient.vertex 0 i - Coefficient.vertex 0 j)) := by
  rw [realized_firstNormal_eq S γ hγ i, xi_sub_eq S i j,
    Realization.inner_mulVec S factor, Coefficient.normal_zero]
  simp only [Coefficient.vertex_zero]

/-- The realized second-block origin support is the coefficient pairing of the
second-block normal against its vertex. -/
lemma inner_secondNormal_eta
    (S : Matrix (Fin 2 × Fin 48) (Fin 2 × Fin 48) ℝ)
    (factor : S.transpose * S = gramMatrix) (γ : ℝ) (hγ : γ ≠ 0) (i : ZMod 48) :
    inner ℝ (ProjectionCycle.secondNormal γ (nu S γ) i) (eta S i) =
      dotProduct (Coefficient.normal 1 γ i) (gramMatrix.mulVec (Coefficient.vertex 1 i)) := by
  rw [realized_secondNormal_eq S γ hγ i, Realization.eta_apply,
    Realization.inner_mulVec S factor, Coefficient.normal_one, Coefficient.vertex_one]

/-- The realized second-block nonself support is the coefficient pairing of the
second-block normal against a vertex difference. -/
lemma inner_secondNormal_eta_sub
    (S : Matrix (Fin 2 × Fin 48) (Fin 2 × Fin 48) ℝ)
    (factor : S.transpose * S = gramMatrix) (γ : ℝ) (hγ : γ ≠ 0) (i j : ZMod 48) :
    inner ℝ (ProjectionCycle.secondNormal γ (nu S γ) i) (eta S i - eta S j) =
      dotProduct (Coefficient.normal 1 γ i)
        (gramMatrix.mulVec (Coefficient.vertex 1 i - Coefficient.vertex 1 j)) := by
  rw [realized_secondNormal_eq S γ hγ i, eta_sub_eq S i j,
    Realization.inner_mulVec S factor, Coefficient.normal_one]
  simp only [Coefficient.vertex_one]

/-- For every Gram factor `S` with `Sᵀ S = H` and every multiplier factor on the critical
half-line, the realized families form a projection cycle. -/
theorem isProjectionCycle
    (S : Matrix (Fin 2 × Fin 48) (Fin 2 × Fin 48) ℝ)
    (factor : S.transpose * S = gramMatrix) (γ : ℝ)
    (lowerBound : criticalFactor ≤ γ) :
    ConsensusADMM.IsProjectionCycle γ (eta S) (nu S γ) := by
  have hγ : γ ≠ 0 := (criticalFactor_pos.trans_le lowerBound).ne'
  -- The coefficient-level nonnegativity table, repackaged as the pairing form.
  have h0 := (Coefficient.support_nonneg_iff_pairing γ 0).mp
    (Coefficient.allSupportsNonneg γ lowerBound 0)
  have h1 := (Coefficient.support_nonneg_iff_pairing γ 1).mp
    (Coefficient.allSupportsNonneg γ lowerBound 1)
  refine ⟨?_, ?_⟩
  · intro i
    refine ⟨?_, ?_⟩
    · rw [Realization.xVertex_eq S γ hγ, inner_firstNormal_xi S factor γ hγ i]
      exact h0.1 i
    · intro j hj
      rw [Realization.xVertex_eq S γ hγ, Realization.xVertex_eq S γ hγ,
        inner_firstNormal_xi_sub S factor γ hγ i j]
      exact h0.2 i j hj
  · intro i
    refine ⟨?_, ?_⟩
    · rw [inner_secondNormal_eta S factor γ hγ i]
      exact h1.1 i
    · intro j hj
      rw [inner_secondNormal_eta_sub S factor γ hγ i j]
      exact h1.2 i j hj

/-! ## Phase-invariant coefficient quadratic form -/

/-- The quadratic form of the coefficient space defined by the Gram matrix. -/
def coefficientQuadratic (u : (Fin 2 × Fin 48) → ℝ) : ℝ :=
  dotProduct u (gramMatrix.mulVec u)

/-- The coefficient quadratic form is strictly positive on nonzero vectors. -/
lemma coefficientQuadratic_pos {u : (Fin 2 × Fin 48) → ℝ} (hu : u ≠ 0) :
    0 < coefficientQuadratic u := by
  -- Positive definiteness of `H` makes the vector ``star u ⬝ᵥ (H *ᵥ u)`` positive,
  -- and over `ℝ` the star on the left factor is the identity.
  simpa only [coefficientQuadratic, dotProduct, Pi.star_apply, star_trivial] using
    gramMatrix_posDef.dotProduct_mulVec_pos hu

/-- The coefficient pairing is invariant under a simultaneous cyclic phase shift of
both arguments. -/
lemma dotProduct_phaseShift (m : ZMod 48) (u v : (Fin 2 × Fin 48) → ℝ) :
    dotProduct (fun p => u (Coefficient.phaseShift m p))
      (fun p => v (Coefficient.phaseShift m p)) = dotProduct u v := by
  -- Reindex the defining sum along the phase-shift equivalence.
  simpa only [dotProduct] using
    (Equiv.sum_comp (Coefficient.phaseShift m) (fun p => u p * v p))

/-- Multiplying by the Gram matrix commutes with a cyclic phase shift. -/
lemma gramMatrix_mulVec_phaseShift (m : ZMod 48) (u : (Fin 2 × Fin 48) → ℝ) :
    gramMatrix.mulVec (fun p => u (Coefficient.phaseShift m p)) =
      fun p => gramMatrix.mulVec u (Coefficient.phaseShift m p) := by
  funext x
  -- Reindex the matrix-vector sum along the phase shift and use that `H` itself is
  -- phase-shift invariant.
  calc gramMatrix.mulVec (fun p => u (Coefficient.phaseShift m p)) x
      = ∑ y, gramMatrix x y * u (Coefficient.phaseShift m y) := by
          simp only [Matrix.mulVec_apply, Matrix.row, dotProduct]
    _ = ∑ y, gramMatrix x ((Coefficient.phaseShift m).symm y) * u y := by
          simpa only [Equiv.symm_apply_apply] using
            (Equiv.sum_comp (Coefficient.phaseShift m)
              (fun y => gramMatrix x ((Coefficient.phaseShift m).symm y) * u y))
    _ = ∑ y, gramMatrix (Coefficient.phaseShift m x) y * u y := by
          refine Finset.sum_congr rfl fun y _ => ?_
          rw [← Coefficient.gramMatrix_phaseShift m x ((Coefficient.phaseShift m).symm y),
            Equiv.apply_symm_apply]
    _ = gramMatrix.mulVec u (Coefficient.phaseShift m x) := by
          simp only [Matrix.mulVec_apply, Matrix.row, dotProduct]

/-- The coefficient quadratic form is invariant under precomposition with a cyclic
phase shift. -/
lemma coefficientQuadratic_comp_phaseShift (m : ZMod 48) (u : (Fin 2 × Fin 48) → ℝ) :
    coefficientQuadratic (fun p => u (Coefficient.phaseShift m p)) =
      coefficientQuadratic u := by
  rw [coefficientQuadratic, coefficientQuadratic, gramMatrix_mulVec_phaseShift]
  exact dotProduct_phaseShift m u (gramMatrix.mulVec u)

/-- The phase-zero coefficient residual is nonzero. -/
lemma coefficient_rho_eq_smul (i : ZMod 48) :
    Coefficient.rho i = gammaZero⁻¹ • (Coefficient.nu i - Coefficient.nu (i - 1)) := by
  -- Factor the common scale out of the difference of the two scaled basis vectors.
  simp only [Coefficient.rho, Coefficient.w]
  rw [← smul_sub]

/-- The multiplier value `γ₀ = 1887 / 1000` is nonzero. -/
lemma gammaZero_ne_zero : gammaZero ≠ 0 := by
  rw [gammaZero_eq]
  norm_num

/-- Distinct phases give distinct second-block basis vectors. -/
lemma coefficient_nu_ne_of_ne {i j : ZMod 48} (h : i ≠ j) :
    Coefficient.nu i ≠ Coefficient.nu j := by
  -- Evaluate the assumed equality at the phase-`i` second-block coordinate.
  intro hnu
  have hval := congrFun hnu (Coefficient.blockCoord 1 i)
  rw [Coefficient.nu_eq_single, Coefficient.nu_eq_single, Pi.single_eq_same,
    Pi.single_apply] at hval
  by_cases hcoord : Coefficient.blockCoord 1 i = Coefficient.blockCoord 1 j
  · exact h ((Coefficient.blockCoord_eq_iff 1 i j).mp hcoord)
  · rw [if_neg hcoord] at hval
    exact one_ne_zero hval

/-- The phase-zero coefficient residual does not vanish. -/
lemma coefficient_rho_zero_ne_zero : Coefficient.rho (0 : ZMod 48) ≠ 0 := by
  rw [coefficient_rho_eq_smul]
  intro h
  rcases smul_eq_zero.mp h with hscale | hdiff
  · exact (inv_ne_zero gammaZero_ne_zero) hscale
  · -- `ν₀ - ν₋₁ ≠ 0` because the two phases are distinct.
    exact coefficient_nu_ne_of_ne (i := 0) (j := 0 - 1)
      (fun hc : (0 : ZMod 48) = 0 - 1 =>
        absurd (ZMod.one_eq_zero_iff.mp (sub_eq_zero.mp hc.symm).symm) (by norm_num))
      (sub_eq_zero.mp hdiff)

/-- The squared norm of an `S`-image is the Gram quadratic form of its coefficient
vector. -/
lemma norm_sq_toLp_mulVec (S : Matrix (Fin 2 × Fin 48) (Fin 2 × Fin 48) ℝ)
    (factor : S.transpose * S = gramMatrix) (u : (Fin 2 × Fin 48) → ℝ) :
    ‖WithLp.toLp 2 (S.mulVec u)‖ ^ 2 = coefficientQuadratic u := by
  rw [← real_inner_self_eq_norm_sq (WithLp.toLp 2 (S.mulVec u)),
    Realization.inner_mulVec S factor, coefficientQuadratic]

/-- The coefficient residual has a phase-independent quadratic form value. -/
lemma coefficientQuadratic_rho_eq (i : ZMod 48) :
    coefficientQuadratic (Coefficient.rho i) = coefficientQuadratic (Coefficient.rho 0) := by
  -- Write `ρᵢ` as the phase shift of `ρ₀` and use phase invariance of the form.
  have hrho : Coefficient.rho i =
      fun p => Coefficient.rho (0 : ZMod 48) (Coefficient.phaseShift (-i) p) := by
    funext p
    rw [Coefficient.rho_phaseShift (0 : ZMod 48) (-i) p]
    simp
  rw [hrho, coefficientQuadratic_comp_phaseShift]

/-! ## Injectivity of the realized phase family -/

/-- For a Gram factor `S` with `Sᵀ S = H`, the realized first-block family is
injective in the cyclic phase. -/
lemma eta_injective (S : Matrix (Fin 2 × Fin 48) (Fin 2 × Fin 48) ℝ)
    (factor : S.transpose * S = gramMatrix) :
    Function.Injective (eta S) := by
  -- Positivity of `Sᵀ S = H` forces the coefficient difference to vanish, and the
  -- basis family `Coefficient.eta` then forces the phases to agree.
  intro i j hij
  have hmv : S.mulVec (Coefficient.eta i - Coefficient.eta j) = 0 := by
    have h1 : S.mulVec (Coefficient.eta i) = S.mulVec (Coefficient.eta j) := by
      refine WithLp.toLp_injective 2 ?_
      simpa only [Realization.eta_apply] using hij
    rw [Matrix.mulVec_sub, h1, sub_self]
  have hdot : coefficientQuadratic (Coefficient.eta i - Coefficient.eta j) = 0 := by
    rw [← norm_sq_toLp_mulVec S factor, hmv]
    simp
  have hzero : Coefficient.eta i - Coefficient.eta j = 0 := by
    by_contra hne
    exact absurd hdot (ne_of_gt (coefficientQuadratic_pos hne))
  have heta : Coefficient.eta i = Coefficient.eta j := sub_eq_zero.mp hzero
  -- Evaluating `ηᵢ = ηⱼ` at the phase-`i` first-block coordinate forces the phases to
  -- agree.
  have hcoord : Coefficient.blockCoord 0 i = Coefficient.blockCoord 0 j := by
    have hval := congrFun heta (Coefficient.blockCoord 0 i)
    simp only [Coefficient.eta_eq_single, Pi.single_eq_same, Pi.single_apply] at hval
    by_cases h : Coefficient.blockCoord 0 i = Coefficient.blockCoord 0 j
    · exact h
    · rw [if_neg h] at hval
      exact absurd hval (by norm_num)
  exact (Coefficient.blockCoord_eq_iff 0 i j).mp hcoord

/-- The post-update ADMM state of the realized period-48 data, indexed by its cyclic
phase. -/
def statePhase (S : Matrix (Fin 2 × Fin 48) (Fin 2 × Fin 48) ℝ) (γ : ℝ) (i : ZMod 48) :
    EuclideanSpace ℝ (Fin 2 × Fin 48) × EuclideanSpace ℝ (Fin 2 × Fin 48) ×
      EuclideanSpace ℝ (Fin 2 × Fin 48) :=
  (ProjectionCycle.xVertex γ (eta S) (nu S γ) i, eta S i, nu S γ i)

/-- The realized phase family is injective, because its second component is the
realized first-block family. -/
lemma statePhase_injective (S : Matrix (Fin 2 × Fin 48) (Fin 2 × Fin 48) ℝ)
    (factor : S.transpose * S = gramMatrix) (γ : ℝ) :
    Function.Injective (statePhase S γ) := by
  intro i j hij
  refine eta_injective S factor ?_
  have hcomp := congrArg (fun s => s.2.1) hij
  simpa only [statePhase] using hcomp

/-! ## Critical-factor support statements -/

/-- At the critical factor a first-block support equals the phase-zero critical
expression. -/
lemma support_zero_at_critical (i d : ZMod 48) :
    Coefficient.support 0 criticalFactor i d = Coefficient.supportAtCritical 0 d :=
  Coefficient.supportCyclic 0 criticalFactor i d

/-- At the critical factor every second-block origin test and nonself test exceeds
two. -/
lemma two_lt_support_one_at_critical (i d : ZMod 48) :
    (2 : ℝ) < Coefficient.support 1 criticalFactor i d := by
  rw [Coefficient.supportCyclic 1 criticalFactor i d]
  exact Coefficient.secondValueBound d

/-- The phase-zero first-block critical support vanishes exactly at the exceptional
displacement `-10`. -/
lemma supportAtCritical_zero_eq_zero_iff (d : ZMod 48) :
    Coefficient.supportAtCritical 0 d = 0 ↔ d = (-10 : ZMod 48) := by
  constructor
  · intro h
    by_contra hd
    have hpos := Coefficient.firstValueBound d hd
    rw [h] at hpos
    norm_num at hpos
  · intro hd
    rw [hd]
    exact Coefficient.supportAtCritical_zero_active

/-! ## The remaining period-48 certificates -/

/-- For every Gram factor `S` with `Sᵀ S = H` and every multiplier factor on the critical
half-line, the prescribed sequences form an indicator-objective consensus ADMM trajectory
of exact period `48`. -/
theorem trajectory_exactPeriod
    (S : Matrix (Fin 2 × Fin 48) (Fin 2 × Fin 48) ℝ)
    (factor : S.transpose * S = gramMatrix) (γ : ℝ)
    (lowerBound : criticalFactor ≤ γ) :
    IsTrajectory γ (extendedIndicator (xSet S)) (extendedIndicator (ySet S))
        (ProjectionCycle.xSequence γ (eta S) (nu S γ))
        (ProjectionCycle.ySequence (eta S)) (ProjectionCycle.dualSequence (nu S γ)) ∧
      HasExactPeriod 48 (ProjectionCycle.xSequence γ (eta S) (nu S γ))
        (ProjectionCycle.ySequence (eta S)) (ProjectionCycle.dualSequence (nu S γ)) := by
  have hγ : 0 < γ := criticalFactor_pos.trans_le lowerBound
  have hcycle := isProjectionCycle S factor γ lowerBound
  have hsets := xSet_ySet_eq S γ lowerBound
  -- Identify every post-update state with the injective cyclic phase family.
  have hstate : ∀ k : ℕ,
      (ProjectionCycle.xSequence γ (eta S) (nu S γ) (k + 1),
        ProjectionCycle.ySequence (eta S) (k + 1),
        ProjectionCycle.dualSequence (nu S γ) (k + 1)) = statePhase S γ (k : ZMod 48) := by
    intro k
    simp only [ProjectionCycle.xSequence_succ, ProjectionCycle.ySequence_succ,
      ProjectionCycle.dualSequence_succ, statePhase]
  refine ⟨?_, ?_⟩
  · -- Transfer the generic trajectory across the hull identifications.
    simpa only [hsets.1, hsets.2] using
      IsProjectionCycle.isTrajectory γ (eta S) (nu S γ) (by norm_num) hγ hcycle
  · rw [ConsensusADMM.exactPeriod_iff]
    constructor
    · -- Adding `48` returns to the same residue class.
      intro k
      simp only [hstate (k + 48), hstate k, Nat.cast_add, ZMod.natCast_self, add_zero]
    · -- A positive period identifies two phases, so injectivity forces `48 ∣ n`.
      intro n hn hper
      have hper' : (ProjectionCycle.xSequence γ (eta S) (nu S γ) (n + 1),
            ProjectionCycle.ySequence (eta S) (n + 1),
            ProjectionCycle.dualSequence (nu S γ) (n + 1)) =
          (ProjectionCycle.xSequence γ (eta S) (nu S γ) (0 + 1),
            ProjectionCycle.ySequence (eta S) (0 + 1),
            ProjectionCycle.dualSequence (nu S γ) (0 + 1)) := by
        simpa using hper 0
      rw [hstate n] at hper'
      rw [hstate 0] at hper'
      have hp : statePhase S γ (n : ZMod 48) = statePhase S γ (0 : ZMod 48) := hper'
      have hzero : (n : ZMod 48) = 0 := statePhase_injective S factor γ hp
      exact Nat.le_of_dvd hn ((ZMod.natCast_eq_zero_iff n 48).mp hzero)

/-- For every Gram factor `S` with `Sᵀ S = H` and every multiplier factor on the critical
half-line, the realized residual norms are all equal to one positive constant. -/
theorem constantPositiveResidual
    (S : Matrix (Fin 2 × Fin 48) (Fin 2 × Fin 48) ℝ)
    (factor : S.transpose * S = gramMatrix) (γ : ℝ)
    (lowerBound : criticalFactor ≤ γ) :
    ∃ c : ℝ, 0 < c ∧ ∀ i, ‖ProjectionCycle.residual γ (nu S γ) i‖ = c := by
  have hγ : γ ≠ 0 := (criticalFactor_pos.trans_le lowerBound).ne'
  -- The squared residual norm is the phase-invariant quadratic form of `ρ`.
  have hsq : ∀ i : ZMod 48, ‖ProjectionCycle.residual γ (nu S γ) i‖ ^ 2 =
      coefficientQuadratic (Coefficient.rho 0) := by
    intro i
    rw [Realization.residual_eq S γ hγ i, Realization.rho_mulVec,
      norm_sq_toLp_mulVec S factor, coefficientQuadratic_rho_eq i]
  refine ⟨‖ProjectionCycle.residual γ (nu S γ) 0‖, ?_, fun i => ?_⟩
  · -- The common value is nonzero because the phase-zero residual is nonzero.
    have hpos : 0 < coefficientQuadratic (Coefficient.rho 0) :=
      coefficientQuadratic_pos coefficient_rho_zero_ne_zero
    have hne : ‖ProjectionCycle.residual γ (nu S γ) 0‖ ≠ 0 := by
      intro hzero
      have h0 := hsq 0
      rw [hzero, pow_two, zero_mul] at h0
      linarith
    exact lt_of_le_of_ne (norm_nonneg _) (Ne.symm hne)
  · -- Equal squared norms and nonnegativity give equal norms.
    have hsquare : ‖ProjectionCycle.residual γ (nu S γ) i‖ ^ 2 =
        ‖ProjectionCycle.residual γ (nu S γ) 0‖ ^ 2 := by
      rw [hsq i, hsq 0]
    rcases sq_eq_sq_iff_eq_or_eq_neg.mp hsquare with heq | heq
    · exact heq
    · nlinarith [norm_nonneg (ProjectionCycle.residual γ (nu S γ) i),
        norm_nonneg (ProjectionCycle.residual γ (nu S γ) 0)]

/-- At the critical multiplier factor every second-block support against the origin and
against every nonself phase is strictly positive. -/
theorem secondSupports_strict
    (S : Matrix (Fin 2 × Fin 48) (Fin 2 × Fin 48) ℝ)
    (factor : S.transpose * S = gramMatrix) :
    ∀ i, 0 < inner ℝ (ProjectionCycle.secondNormal criticalFactor
          (nu S criticalFactor) i) (eta S i) ∧
      ∀ j, j ≠ i →
        0 < inner ℝ (ProjectionCycle.secondNormal criticalFactor
          (nu S criticalFactor) i) (eta S i - eta S j) := by
  have hγ : criticalFactor ≠ 0 := criticalFactor_pos.ne'
  intro i
  refine ⟨?_, ?_⟩
  · rw [inner_secondNormal_eta S factor criticalFactor hγ i,
      ← support_eq_origin_pairing 1 criticalFactor i]
    exact lt_trans (by norm_num : (0 : ℝ) < 2) (two_lt_support_one_at_critical i 0)
  · intro j hj
    rw [inner_secondNormal_eta_sub S factor criticalFactor hγ i j,
      ← support_eq_diff_pairing 1 criticalFactor i j hj]
    exact lt_trans (by norm_num : (0 : ℝ) < 2) (two_lt_support_one_at_critical i (j - i))

/-- At the critical multiplier factor every first-block support against the origin is
strictly positive, and the only nonself first-block support vanishing at phase `i` is the
one against phase `i - 10`. -/
theorem firstSupports_zero_iff
    (S : Matrix (Fin 2 × Fin 48) (Fin 2 × Fin 48) ℝ)
    (factor : S.transpose * S = gramMatrix) :
    ∀ i, 0 < inner ℝ (ProjectionCycle.firstNormal criticalFactor
          (eta S) (nu S criticalFactor) i) (xi S i) ∧
      ∀ j, j ≠ i →
        (inner ℝ (ProjectionCycle.firstNormal criticalFactor
            (eta S) (nu S criticalFactor) i) (xi S i - xi S j) = 0 ↔
          j = i - 10) := by
  have hγ : criticalFactor ≠ 0 := criticalFactor_pos.ne'
  intro i
  refine ⟨?_, ?_⟩
  · -- The origin test is a critical support at displacement zero, which exceeds `1/10`.
    rw [inner_firstNormal_xi S factor criticalFactor hγ i,
      ← support_eq_origin_pairing 0 criticalFactor i, support_zero_at_critical]
    have h := Coefficient.firstValueBound (0 : ZMod 48) (by decide)
    linarith
  · intro j hj
    -- The nonself test is the `-10` displacement, the unique vanishing critical support.
    rw [inner_firstNormal_xi_sub S factor criticalFactor hγ i j,
      ← support_eq_diff_pairing 0 criticalFactor i j hj, support_zero_at_critical,
      supportAtCritical_zero_eq_zero_iff]
    constructor
    · intro h
      rw [sub_eq_iff_eq_add] at h
      rw [sub_eq_add_neg, add_comm]
      exact h
    · intro h
      rw [sub_eq_iff_eq_add]
      rw [sub_eq_add_neg, add_comm] at h
      exact h

end

