namespace FractionFree

/-- The k-th fraction-free elimination stage of the integer matrix `2K - I₉₆`. -/
def stage (k : Fin 96) : Matrix (Fin 96) (Fin 96) ℤ :=
  let rec go : ℕ → Matrix (Fin 96) (Fin 96) ℤ
    | 0 => j0
    | n + 1 =>
        let B := go n
        let pivotIndex : Fin 96 := Fin.ofNat 96 n
        let previousIndex : Fin 96 := Fin.ofNat 96 (n - 1)
        let previous := if n = 0 then 1 else B previousIndex previousIndex
        fun i j ↦
          if pivotIndex < i ∧ pivotIndex < j then
            (B pivotIndex pivotIndex * B i j - B i pivotIndex * B pivotIndex j) /
              previous
          else B i j
  go k.val

/-- The denominator of the fraction-free update at the given index, with value `1`
before the first update. -/
def previousPivot (k : Fin 95) : ℤ :=
  if k.val = 0 then 1
  else
    let previousIndex : Fin 96 := Fin.ofNat 96 (k.val - 1)
    stage (Fin.castAdd 1 k) previousIndex previousIndex

/-- The k-th pivot of the fraction-free elimination. -/
def pivot (k : Fin 96) : ℤ :=
  stage k k k

/-- The leading square submatrix of `2K - I₉₆` through the given coordinate. -/
def principal (k : Fin 96) : Matrix (Fin (k.val + 1)) (Fin (k.val + 1)) ℤ :=
  fun i j ↦ j0 (Fin.castLE (Nat.succ_le_of_lt k.isLt) i)
    (Fin.castLE (Nat.succ_le_of_lt k.isLt) j)

/-- A residue class of a value of `Fin 95` read in `Fin 96` is the canonical
inclusion of that value. -/
lemma ofNat_val_castAdd_one (k : Fin 95) : Fin.ofNat 96 k.val = Fin.castAdd 1 k := by
  ext
  exact Nat.mod_eq_of_lt (by omega)

/-- A residue class of a value of `Fin 94` read in `Fin 96` is the two-step canonical
inclusion of that value. -/
lemma ofNat_val_castAdd_two (k : Fin 94) : Fin.ofNat 96 k.val = Fin.castAdd 2 k := by
  ext
  exact Nat.mod_eq_of_lt (by omega)

/-- The initial fraction-free elimination stage of `2K - I₉₆` is the matrix itself. -/
theorem stage_zero : stage 0 = j0 := rfl

/-- A successor elimination stage performs the trailing fraction-free update and
leaves every nontrailing entry unchanged. -/
theorem stage_succ_apply (k : Fin 95) (i j : Fin 96) :
    stage k.succ i j =
      if Fin.castAdd 1 k < i ∧ Fin.castAdd 1 k < j then
        (pivot (Fin.castAdd 1 k) * stage (Fin.castAdd 1 k) i j -
            stage (Fin.castAdd 1 k) i (Fin.castAdd 1 k) *
              stage (Fin.castAdd 1 k) (Fin.castAdd 1 k) j) /
          previousPivot k
      else stage (Fin.castAdd 1 k) i j := by
  -- Unfold `stage` to its auxiliary recursion `stage.go` and apply its successor
  -- equation `stage.go.eq_2`, whose index is the successor of `k.val`.
  -- The pivot index the recursion produces is the residue class of `k.val` in
  -- `Fin 96`, which is the canonical inclusion `Fin.castAdd 1 k`.
  simp only [stage, stage.go.eq_2, Fin.val_succ, Fin.val_castAdd, Nat.add_one, pivot,
    previousPivot, ofNat_val_castAdd_one]

/-- The denominator of the first elimination update is `1`. -/
theorem previousPivot_zero : previousPivot 0 = 1 := by
  -- The defining conditional of `previousPivot` is decided by its index branch.
  decide

/-- The denominator of a later elimination update is the preceding diagonal pivot. -/
theorem previousPivot_succ (k : Fin 94) :
    previousPivot k.succ = pivot (Fin.castAdd 2 k) := by
  -- The successor stage of the recursion never rewrites the diagonal entry it
  -- pivots on, so reading the next stage at that diagonal entry recovers the
  -- diagonal entry of the current stage.
  have hstep := stage_succ_apply (Fin.castAdd 1 k) (Fin.castAdd 2 k) (Fin.castAdd 2 k)
  have hcond : ¬ (Fin.castAdd 1 (Fin.castAdd 1 k) < Fin.castAdd 2 k) := by
    rw [Fin.lt_def]
    simp only [Fin.val_castAdd]
    omega
  simp only [hcond, false_and, if_false] at hstep
  simp only [previousPivot, Fin.val_succ, Nat.add_sub_cancel, ofNat_val_castAdd_two, pivot]
  exact hstep

/-- The k-th pivot is the diagonal entry `k` of the k-th elimination stage. -/
theorem pivot_apply (k : Fin 96) : pivot k = stage k k k := rfl

/-- The leading square submatrix is read off `2K - I₉₆` at its embedded coordinates. -/
theorem principal_apply (k : Fin 96) (i j : Fin (k.val + 1)) :
    principal k i j = j0 (Fin.castLE (Nat.succ_le_of_lt k.isLt) i)
      (Fin.castLE (Nat.succ_le_of_lt k.isLt) j) := rfl

/-- The index map that borders the leading `k` coordinates of `Fin 96` by the
coordinate `i`. -/
def insertIndex (k : Fin 96) (i : Fin 96) : Fin (k.val + 1) → Fin 96 :=
  fun m ↦ if m.val < k.val then ⟨m.val, by omega⟩ else i

/-- A bordered index below the border is the coordinate itself. -/
lemma insertIndex_apply_of_lt (k : Fin 96) (i : Fin 96) (m : Fin (k.val + 1))
    (h : m.val < k.val) : insertIndex k i m = ⟨m.val, by omega⟩ := by
  -- The defining conditional of `insertIndex` takes its first branch.
  simp only [insertIndex, if_pos h]

/-- A bordered index at or above the border is the border coordinate. -/
lemma insertIndex_apply_of_le (k : Fin 96) (i : Fin 96) (m : Fin (k.val + 1))
    (h : k.val ≤ m.val) : insertIndex k i m = i := by
  -- The defining conditional of `insertIndex` takes its second branch, since
  -- `m.val ≤ k.val` by the index bound.
  have hlt : ¬ m.val < k.val := by omega
  simp only [insertIndex, if_neg hlt]

/-- Bordering the leading coordinates by the border `k` itself is the canonical
inclusion of those coordinates into `Fin 96`. -/
lemma insertIndex_self (k : Fin 96) :
    insertIndex k k = Fin.castLE (Nat.succ_le_of_lt k.isLt) := by
  -- Compare the two index maps coordinatewise; at the last coordinate both
  -- return `k`, and below it both return the coordinate itself.
  funext m
  by_cases h : m.val < k.val
  · rw [insertIndex_apply_of_lt k k m h]
    rfl
  · rw [insertIndex_apply_of_le k k m (by omega)]
    exact Fin.ext (by simp only [Fin.val_castLE]; omega)

/-- The determinant of the submatrix of `2K - I₉₆` on the leading `k` coordinates
bordered by the row `i` and the column `j`. -/
def borderedMinor (k : Fin 96) (i j : Fin 96) : ℤ :=
  (j0.submatrix (insertIndex k i) (insertIndex k j)).det

/-- Evaluation of a bordered minor as the determinant of the corresponding
submatrix of `2K - I₉₆`. -/
lemma borderedMinor_apply (k : Fin 96) (i j : Fin 96) :
    borderedMinor k i j = (j0.submatrix (insertIndex k i) (insertIndex k j)).det := rfl

/-- The bordered minor whose border is the pivot coordinate itself is the
determinant of the leading principal submatrix through that coordinate. -/
lemma borderedMinor_self (k : Fin 96) : borderedMinor k k k = (principal k).det := by
  -- Bordering the leading coordinates by `k` is exactly the embedding used by
  -- `principal`, so both determinants are those of the same submatrix.
  rw [borderedMinor_apply, insertIndex_self]
  rfl

/-! ### Nonvanishing of the minors modulo two

The integer matrix `2K - I₉₆` is congruent to the negative identity matrix modulo `2`.
Consequently every square submatrix selected by an injective index family has odd
determinant, which supplies the nonvanishing of the leading principal minors used as
divisors by the fraction-free recursion.
-/

/-- Reducing twice an integer minus a residue class modulo `2` negates the residue. -/
lemma intCast_two_mul_sub_eq_neg (x y : ℤ) :
    ((2 * x - y : ℤ) : ZMod 2) = -(y : ZMod 2) := by
  -- Push the integer arithmetic into `ZMod 2`, where the coefficient `2` vanishes.
  push_cast
  simp only [CharTwo.two_eq_zero, zero_mul, zero_sub]

/-- Modulo `2` the integer matrix `2K - I₉₆` restricts to the negative identity matrix on
any square submatrix selected by an injective index family. -/
lemma j0_submatrix_map_two (n : ℕ) (e : Fin n → Fin 96) (he : Function.Injective e) :
    (j0.submatrix e e).map (Int.castRingHom (ZMod 2)) =
      -(1 : Matrix (Fin n) (Fin n) (ZMod 2)) := by
  -- Compare entries: the doubled part of `2K - I₉₆` vanishes mod `2`, and the remaining
  -- diagonal indicator is nonzero exactly when the selected coordinates agree.
  ext a b
  simp only [Matrix.submatrix_apply, Matrix.map_apply, Matrix.neg_apply, Matrix.one_apply]
  rw [j0_apply]
  by_cases hab : a = b
  · subst hab
    simp only [if_true]
    exact intCast_two_mul_sub_eq_neg _ _
  · have hne : e a ≠ e b := fun h ↦ hab (he h)
    rw [if_neg hne, if_neg hab]
    exact intCast_two_mul_sub_eq_neg _ _

/-- Every square submatrix of `2K - I₉₆` selected by an injective index family has nonzero
determinant, because its reduction modulo `2` is a unit-valued negative identity. -/
lemma j0_submatrix_det_ne_zero (n : ℕ) (e : Fin n → Fin 96) (he : Function.Injective e) :
    (j0.submatrix e e).det ≠ 0 := by
  -- A vanishing determinant would force the reduced determinant to vanish in `ZMod 2`,
  -- where it is a unit.
  intro h
  have hmap := j0_submatrix_map_two n e he
  have hunit :
      IsUnit (RingHom.mapMatrix (Int.castRingHom (ZMod 2)) (j0.submatrix e e)).det := by
    rw [RingHom.mapMatrix_apply, hmap]
    exact (Matrix.isUnit_iff_isUnit_det _).mp
      (IsUnit.neg (isUnit_one : IsUnit (1 : Matrix (Fin n) (Fin n) (ZMod 2))))
  rw [← RingHom.map_det (Int.castRingHom (ZMod 2)) (j0.submatrix e e), h] at hunit
  simp only [map_zero] at hunit
  exact IsUnit.ne_zero hunit rfl

/-- Every leading principal minor of `2K - I₉₆` is nonzero. -/
lemma principal_det_ne_zero (k : Fin 96) : (principal k).det ≠ 0 := by
  -- The leading `k + 1` coordinates are an injective index family.
  exact j0_submatrix_det_ne_zero (k.val + 1) (Fin.castLE (Nat.succ_le_of_lt k.isLt))
    (Fin.castLE_injective _)

/-- Every diagonal bordered minor of `2K - I₉₆` is nonzero. -/
lemma borderedMinor_self_ne_zero (k : Fin 96) : borderedMinor k k k ≠ 0 := by
  rw [borderedMinor_self]
  exact principal_det_ne_zero k

/-! ### The two-by-two determinant identity

The Desnanot–Jacobi identity is first proved for a matrix displayed as a two-by-two block
matrix with invertible leading block, and then specialized to the bordered minors of
`2K - I₉₆` over `ℚ`, where the leading block is invertible because its determinant is
nonzero.
-/

/-- The single column `k` of a two-column block, viewed as a one-column block. -/
def singleColumnBlock {R : Type*} {m : Type*} (B : Matrix m (Fin 2) R) (k : Fin 2) :
    Matrix m (Fin 1) R := fun a _ ↦ B a k

/-- The single row `k` of a two-row block, viewed as a one-row block. -/
def singleRowBlock {R : Type*} {m : Type*} (C : Matrix (Fin 2) m R) (k : Fin 2) :
    Matrix (Fin 1) m R := fun _ a ↦ C k a

/-- The `(k, l)` entry of a `2 × 2` block, viewed as a `1 × 1` block. -/
def singleEntryBlock {R : Type*} (D : Matrix (Fin 2) (Fin 2) R) (k l : Fin 2) :
    Matrix (Fin 1) (Fin 1) R := fun _ _ ↦ D k l

/-- The `1 × 1` Schur complement of a corner entry is the corresponding entry of the full
Schur complement. -/
lemma singleEntryBlock_sub_mul_invOf {R : Type*} [CommRing R] {m : Type*} [Fintype m]
    [DecidableEq m] (A : Matrix m m R) (B : Matrix m (Fin 2) R) (C : Matrix (Fin 2) m R)
    (D : Matrix (Fin 2) (Fin 2) R) (k l : Fin 2) [Invertible A] :
    (singleEntryBlock D k l - singleRowBlock C k * ⅟A * singleColumnBlock B l) 0 0 =
      (D - C * ⅟A * B) k l := by
  simp only [Matrix.sub_apply, singleEntryBlock, singleRowBlock, singleColumnBlock,
    Matrix.mul_apply]

/-- Desnanot–Jacobi determinant identity for a matrix displayed as a two-by-two block
matrix with invertible leading block: the determinant of the full matrix times the
determinant of its leading block equals the product of the two one-step cofactors minus the
product of the two corner cofactors. -/
theorem det_fromBlocks_jacobi {R : Type*} [CommRing R] {m : Type*} [Fintype m]
    [DecidableEq m] (A : Matrix m m R) (B : Matrix m (Fin 2) R) (C : Matrix (Fin 2) m R)
    (D : Matrix (Fin 2) (Fin 2) R) [Invertible A] :
    (Matrix.fromBlocks A B C D).det * A.det =
      (Matrix.fromBlocks A (singleColumnBlock B 1) (singleRowBlock C 1)
          (singleEntryBlock D 1 1)).det *
        (Matrix.fromBlocks A (singleColumnBlock B 0) (singleRowBlock C 0)
          (singleEntryBlock D 0 0)).det -
      (Matrix.fromBlocks A (singleColumnBlock B 0) (singleRowBlock C 1)
          (singleEntryBlock D 1 0)).det *
        (Matrix.fromBlocks A (singleColumnBlock B 1) (singleRowBlock C 0)
          (singleEntryBlock D 0 1)).det := by
  -- Expand all five block determinants through the Schur complement of the leading block.
  rw [Matrix.det_fromBlocks₁₁ A B C D,
    Matrix.det_fromBlocks₁₁ A (singleColumnBlock B 1) (singleRowBlock C 1)
      (singleEntryBlock D 1 1),
    Matrix.det_fromBlocks₁₁ A (singleColumnBlock B 0) (singleRowBlock C 0)
      (singleEntryBlock D 0 0),
    Matrix.det_fromBlocks₁₁ A (singleColumnBlock B 0) (singleRowBlock C 1)
      (singleEntryBlock D 1 0),
    Matrix.det_fromBlocks₁₁ A (singleColumnBlock B 1) (singleRowBlock C 0)
      (singleEntryBlock D 0 1)]
  -- Both sides are now polynomials in the four entries of the Schur complement.
  rw [Matrix.det_fin_two, Matrix.det_fin_one, Matrix.det_fin_one, Matrix.det_fin_one,
    Matrix.det_fin_one]
  rw [← singleEntryBlock_sub_mul_invOf A B C D 0 0, ← singleEntryBlock_sub_mul_invOf A B C D 1 1,
    ← singleEntryBlock_sub_mul_invOf A B C D 0 1, ← singleEntryBlock_sub_mul_invOf A B C D 1 0]
  ring

/-- The rational matrix underlying the integer matrix `2K - I₉₆`. -/
abbrev j0Q : Matrix (Fin 96) (Fin 96) ℚ := j0.map (Int.castRingHom ℚ)

/-- The rational value of an integer bordered minor. -/
def bmQ (k : Fin 96) (r c : Fin 96) : ℚ :=
  (j0Q.submatrix (insertIndex k r) (insertIndex k c)).det

/-- The leading `m` coordinates of `Fin 96`, as an index family. -/
def baseIndex (m : ℕ) (hm : m ≤ 96) : Fin m → Fin 96 := fun a => Fin.castLE hm a

/-- The index family on `Fin m ⊕ Fin 2` listing the leading `m` coordinates, then the
coordinate `m` and the border `r`. -/
def twoIndex (m : ℕ) (hm : m ≤ 96) (hm' : m < 96) (r : Fin 96) : Fin m ⊕ Fin 2 → Fin 96
  | Sum.inl a => Fin.castLE hm a
  | Sum.inr k => if k.val = 0 then ⟨m, hm'⟩ else r

/-- The index family on `Fin m ⊕ Fin 1` listing the leading `m` coordinates, then the
border `r`. -/
def oneIndex (m : ℕ) (hm : m ≤ 96) (r : Fin 96) : Fin m ⊕ Fin 1 → Fin 96
  | Sum.inl a => Fin.castLE hm a
  | Sum.inr _ => r

/-- Bordering the leading `m + 1` coordinates by `r` is the two-block index family
`twoIndex`. -/
lemma insertIndex_eq_twoIndex_comp (m : ℕ) (hm : m + 1 < 96) (r : Fin 96) :
    insertIndex ⟨m + 1, hm⟩ r =
      twoIndex m (by omega) (by omega) r ∘ (finSumFinEquiv (m := m) (n := 2)).symm := by
  have hcomp : insertIndex ⟨m + 1, hm⟩ r ∘ finSumFinEquiv (m := m) (n := 2) =
      twoIndex m (by omega) (by omega) r := by
    funext x
    rcases x with a | k
    · rw [Function.comp_apply, finSumFinEquiv_apply_left,
        insertIndex_apply_of_lt _ _ _ (by simp only [Fin.val_castAdd]; omega)]
      rfl
    · fin_cases k
      · rw [Function.comp_apply, finSumFinEquiv_apply_right,
          insertIndex_apply_of_lt _ _ _ (by simp only [Fin.val_natAdd]; omega)]
        rfl
      · rw [Function.comp_apply, finSumFinEquiv_apply_right,
          insertIndex_apply_of_le _ _ _ (by simp only [Fin.val_natAdd]; omega)]
        rfl
  funext p
  simpa using congrFun hcomp ((finSumFinEquiv (m := m) (n := 2)).symm p)

/-- Bordering the leading `m` coordinates by `r` is the one-block index family
`oneIndex`. -/
lemma insertIndex_eq_oneIndex_comp (m : ℕ) (hm : m < 96) (r : Fin 96) :
    insertIndex ⟨m, hm⟩ r =
      oneIndex m (by omega) r ∘ (finSumFinEquiv (m := m) (n := 1)).symm := by
  have hcomp : insertIndex ⟨m, hm⟩ r ∘ finSumFinEquiv (m := m) (n := 1) =
      oneIndex m (by omega) r := by
    funext x
    rcases x with a | k
    · rw [Function.comp_apply, finSumFinEquiv_apply_left,
        insertIndex_apply_of_lt _ _ _ (by simp only [Fin.val_castAdd]; omega)]
      rfl
    · rw [Function.comp_apply, finSumFinEquiv_apply_right,
        insertIndex_apply_of_le _ _ _ (by simp only [Fin.val_natAdd]; omega)]
      rfl
  funext p
  simpa using congrFun hcomp ((finSumFinEquiv (m := m) (n := 1)).symm p)

/-- Casting a determinant of an integer submatrix to `ℚ` is the determinant of the
corresponding rational submatrix. -/
lemma intCast_det_submatrix {n : ℕ} (e₁ e₂ : Fin n → Fin 96) :
    (((j0.submatrix e₁ e₂).det : ℤ) : ℚ) = (j0Q.submatrix e₁ e₂).det := by
  rw [show ((↑(j0.submatrix e₁ e₂).det : ℚ)) =
      (Int.castRingHom ℚ) (j0.submatrix e₁ e₂).det from rfl]
  rw [RingHom.map_det]
  rfl

/-- The rational value of an integer bordered minor. -/
lemma intCast_borderedMinor (k : Fin 96) (r c : Fin 96) :
    ((borderedMinor k r c : ℤ) : ℚ) = bmQ k r c := by
  rw [borderedMinor_apply, intCast_det_submatrix]
  rfl

/-- Determinant of the bordered submatrix at `m + 1` as a `twoIndex` determinant. -/
lemma det_borderedMinorQ_two (m : ℕ) (hm : m + 1 < 96) (r c : Fin 96) :
    bmQ ⟨m + 1, hm⟩ r c =
      (j0Q.submatrix (twoIndex m (by omega) (by omega) r)
        (twoIndex m (by omega) (by omega) c)).det := by
  rw [bmQ, insertIndex_eq_twoIndex_comp m hm r, insertIndex_eq_twoIndex_comp m hm c,
    ← Matrix.submatrix_submatrix, Matrix.det_submatrix_equiv_self]

/-- Determinant of the bordered submatrix at `m` as a `oneIndex` determinant. -/
lemma det_borderedMinorQ_one (m : ℕ) (hm : m < 96) (r c : Fin 96) :
    bmQ ⟨m, hm⟩ r c =
      (j0Q.submatrix (oneIndex m (by omega) r) (oneIndex m (by omega) c)).det := by
  rw [bmQ, insertIndex_eq_oneIndex_comp m hm r, insertIndex_eq_oneIndex_comp m hm c,
    ← Matrix.submatrix_submatrix, Matrix.det_submatrix_equiv_self]

/-- The first extra coordinate in the `twoIndex` family is the coordinate `m` itself. -/
lemma twoIndex_inr_zero (m : ℕ) (hm : m ≤ 96) (hm' : m < 96) (r : Fin 96) :
    twoIndex m hm hm' r (Sum.inr 0) = ⟨m, hm'⟩ := by
  simp only [twoIndex, Fin.val_zero, ↓reduceIte]

/-- The second extra coordinate in the `twoIndex` family is the border. -/
lemma twoIndex_inr_one (m : ℕ) (hm : m ≤ 96) (hm' : m < 96) (r : Fin 96) :
    twoIndex m hm hm' r (Sum.inr 1) = r := by
  simp only [twoIndex, Fin.val_one]
  rfl

/-- The leading block of `2K - I₉₆` of size `m`, the pivot block of the two-by-two Dodgson
decomposition. -/
def leadBlock (m : ℕ) (hm : m ≤ 96) : Matrix (Fin m) (Fin m) ℚ :=
  j0Q.submatrix (baseIndex m hm) (baseIndex m hm)

/-- The leading `m × m` minor is the bordered minor whose border is its own last
coordinate. -/
lemma det_leadBlock (m : ℕ) (hm1 : 1 ≤ m) (hm : m - 1 < 96) :
    bmQ ⟨m - 1, hm⟩ ⟨m - 1, hm⟩ ⟨m - 1, hm⟩ = (leadBlock m (by omega)).det := by
  have hfun : insertIndex ⟨m - 1, hm⟩ ⟨m - 1, hm⟩ =
      baseIndex m (by omega) ∘ finCongr (Nat.sub_add_cancel hm1) := by
    rw [insertIndex_self]
    funext p
    rfl
  rw [bmQ, hfun, ← Matrix.submatrix_submatrix, Matrix.det_submatrix_equiv_self]
  rfl

/-- The pivot block of the Dodgson decomposition, as a named matrix. -/
def blockA (m : ℕ) (hm : m ≤ 96) : Matrix (Fin m) (Fin m) ℚ := leadBlock m hm

/-- The border column block of the Dodgson decomposition. -/
def blockB (m : ℕ) (hm : m < 96) (r c : Fin 96) : Matrix (Fin m) (Fin 2) ℚ :=
  fun a k => j0Q (twoIndex m (by omega) hm r (Sum.inl a))
    (twoIndex m (by omega) hm c (Sum.inr k))

/-- The border row block of the Dodgson decomposition. -/
def blockC (m : ℕ) (hm : m < 96) (r c : Fin 96) : Matrix (Fin 2) (Fin m) ℚ :=
  fun k b => j0Q (twoIndex m (by omega) hm r (Sum.inr k))
    (twoIndex m (by omega) hm c (Sum.inl b))

/-- The corner block of the Dodgson decomposition. -/
def blockD (m : ℕ) (hm : m < 96) (r c : Fin 96) : Matrix (Fin 2) (Fin 2) ℚ :=
  fun k l => j0Q (twoIndex m (by omega) hm r (Sum.inr k))
    (twoIndex m (by omega) hm c (Sum.inr l))

/-- The bordered submatrix is the two-by-two block matrix of the Dodgson decomposition. -/
lemma fromBlocks_blocks (m : ℕ) (hm : m < 96) (r c : Fin 96) :
    Matrix.fromBlocks (blockA m (by omega)) (blockB m hm r c) (blockC m hm r c)
        (blockD m hm r c) =
      j0Q.submatrix (twoIndex m (by omega) hm r) (twoIndex m (by omega) hm c) := by
  ext x y
  rcases x with a | k <;> rcases y with b | l <;> rfl

/-- Keeping one pair of border coordinates of the block matrix leaves the bordered
submatrix with that single border in each direction. -/
lemma fromBlocks_cofactor (m : ℕ) (hm : m < 96) (r c : Fin 96) (l k : Fin 2) :
    Matrix.fromBlocks (blockA m (by omega)) (singleColumnBlock (blockB m hm r c) k)
        (singleRowBlock (blockC m hm r c) l) (singleEntryBlock (blockD m hm r c) l k) =
      j0Q.submatrix (oneIndex m (by omega) (twoIndex m (by omega) hm r (Sum.inr l)))
        (oneIndex m (by omega) (twoIndex m (by omega) hm c (Sum.inr k))) := by
  ext x y
  rcases x with a | k' <;> rcases y with b | l' <;> rfl

/-- The `oneIndex` determinant is the corresponding bordered minor, in the direction used to
rewrite the cofactors of the block decomposition. -/
lemma oneIndex_det_eq_bmQ (m : ℕ) (hm : m < 96) (X Y : Fin 96) :
    (j0Q.submatrix (oneIndex m (by omega) X) (oneIndex m (by omega) Y)).det = bmQ ⟨m, hm⟩ X Y :=
  (det_borderedMinorQ_one m hm X Y).symm

/-- Dodgson's condensation identity for the bordered minors of `2K - I₉₆`, over `ℚ`. -/
theorem borderedMinor_dodgson_q (m : ℕ) (hm1 : 1 ≤ m) (hm : m + 1 < 96) (i j : Fin 96)
    (_hi : m < i.val) (_hj : m < j.val) :
    bmQ ⟨m + 1, hm⟩ i j * bmQ ⟨m - 1, by omega⟩ ⟨m - 1, by omega⟩ ⟨m - 1, by omega⟩ =
      bmQ ⟨m, by omega⟩ ⟨m, by omega⟩ ⟨m, by omega⟩ * bmQ ⟨m, by omega⟩ i j -
        bmQ ⟨m, by omega⟩ i ⟨m, by omega⟩ * bmQ ⟨m, by omega⟩ ⟨m, by omega⟩ j := by
  -- The pivot block of the decomposition is the leading `m × m` minor, which is nonzero.
  have hdet : bmQ ⟨m - 1, by omega⟩ ⟨m - 1, by omega⟩ ⟨m - 1, by omega⟩ =
      (blockA m (by omega)).det := det_leadBlock m hm1 (by omega)
  have hne : bmQ ⟨m - 1, by omega⟩ ⟨m - 1, by omega⟩ ⟨m - 1, by omega⟩ ≠ 0 := by
    rw [← intCast_borderedMinor]
    intro h
    exact borderedMinor_self_ne_zero ⟨m - 1, by omega⟩ (Int.cast_injective h)
  have hunit : IsUnit (blockA m (by omega)).det := hdet ▸ isUnit_iff_ne_zero.mpr hne
  -- Local instance justification (Invertible): mathlib's block Desnanot-Jacobi identity is
  -- stated for a block matrix with an `Invertible` pivot block; over `ℚ` the nonzero
  -- determinant of the pivot block is exactly the instance needed to invoke it.
  letI : Invertible (blockA m (by omega)) :=
    Matrix.invertibleOfIsUnitDet (A := blockA m (by omega)) hunit
  have hm96 : m ≤ 96 := by omega
  have hJ := det_fromBlocks_jacobi (blockA m hm96) (blockB m (by omega) i j)
    (blockC m (by omega) i j) (blockD m (by omega) i j)
  -- Replace the block matrix and its four cofactors by their bordered-minor descriptions.
  rw [fromBlocks_blocks m (by omega) i j, fromBlocks_cofactor m (by omega) i j 1 1,
    fromBlocks_cofactor m (by omega) i j 0 0, fromBlocks_cofactor m (by omega) i j 1 0,
    fromBlocks_cofactor m (by omega) i j 0 1] at hJ
  rw [oneIndex_det_eq_bmQ m (by omega), oneIndex_det_eq_bmQ m (by omega),
    oneIndex_det_eq_bmQ m (by omega), oneIndex_det_eq_bmQ m (by omega)] at hJ
  -- Normalize the `twoIndex` incidences of the two border coordinates.
  simp only [twoIndex_inr_one, twoIndex_inr_zero] at hJ
  -- Identify the full block determinant with the bordered minor one level up.
  rw [← det_borderedMinorQ_two m hm i j, ← hdet] at hJ
  rw [mul_comm (bmQ ⟨m, by omega⟩ i j)] at hJ
  exact hJ


/-- Dodgson's condensation identity for the bordered minors of `2K - I₉₆`. -/
theorem borderedMinor_dodgson (m : ℕ) (hm1 : 1 ≤ m) (hm : m + 1 < 96) (i j : Fin 96)
    (hi : m < i.val) (hj : m < j.val) :
    borderedMinor ⟨m + 1, hm⟩ i j *
        borderedMinor ⟨m - 1, by omega⟩ ⟨m - 1, by omega⟩ ⟨m - 1, by omega⟩ =
      borderedMinor ⟨m, by omega⟩ ⟨m, by omega⟩ ⟨m, by omega⟩ * borderedMinor ⟨m, by omega⟩ i j -
        borderedMinor ⟨m, by omega⟩ i ⟨m, by omega⟩ *
          borderedMinor ⟨m, by omega⟩ ⟨m, by omega⟩ j := by
  -- Both sides are integers; it suffices to compare them after the cast to `ℚ`.
  apply Int.cast_injective (α := ℚ)
  push_cast
  simp only [intCast_borderedMinor]
  exact borderedMinor_dodgson_q m hm1 hm i j hi hj

/-- The bordered minor at level zero is the entry of `2K - I₉₆` itself. -/
lemma borderedMinor_zero (x y : Fin 96) : borderedMinor 0 x y = j0 x y := by
  -- The submatrix is one-by-one, so its determinant is the single entry selected by the
  -- constant index map `insertIndex 0`; mathlib's one-by-one determinant formula reduces
  -- that entry definitionally to `j0 x y`.
  rw [borderedMinor_apply]
  exact Matrix.det_fin_one _

/-- The bordered minor at level one is the leading `2 × 2` minor through the two entries. -/
lemma borderedMinor_one (x y : Fin 96) :
    borderedMinor 1 x y = j0 0 0 * j0 x y - j0 0 y * j0 x 0 := by
  -- The bordered indices are `{0, x}` and `{0, y}`; mathlib's two-by-two determinant formula
  -- expands the resulting submatrix definitionally into the four entries of `j0`.
  rw [borderedMinor_apply]
  exact Matrix.det_fin_two _

/-- One successor step of the fraction-free recursion, read at the canonical index `m + 1`:
the trailing entries are updated by the fraction-free rule with denominator the preceding
diagonal pivot (the level-`m` pivot for `m > 0`, and `1` at the first step). -/
lemma stage_succ_apply' (m : ℕ) (hm : m + 1 < 96) (i j : Fin 96) :
    stage (⟨m + 1, hm⟩ : Fin 96) i j =
      if (⟨m, by omega⟩ : Fin 96) < i ∧ (⟨m, by omega⟩ : Fin 96) < j then
        (pivot (⟨m, by omega⟩ : Fin 96) * stage (⟨m, by omega⟩ : Fin 96) i j -
            stage (⟨m, by omega⟩ : Fin 96) i (⟨m, by omega⟩ : Fin 96) *
              stage (⟨m, by omega⟩ : Fin 96) (⟨m, by omega⟩ : Fin 96) j) /
          previousPivot (⟨m, by omega⟩ : Fin 95)
      else stage (⟨m, by omega⟩ : Fin 96) i j := by
  -- Rewrite the canonical index `m + 1` as the successor of the residue class of `m` and
  -- apply the successor recursion rule in the spelling used by `stage_succ_apply`.
  change stage ((⟨m, by omega⟩ : Fin 95).succ) i j =
    if Fin.castAdd 1 (⟨m, by omega⟩ : Fin 95) < i ∧
        Fin.castAdd 1 (⟨m, by omega⟩ : Fin 95) < j then
      (pivot (Fin.castAdd 1 (⟨m, by omega⟩ : Fin 95)) *
          stage (Fin.castAdd 1 (⟨m, by omega⟩ : Fin 95)) i j -
        stage (Fin.castAdd 1 (⟨m, by omega⟩ : Fin 95)) i
            (Fin.castAdd 1 (⟨m, by omega⟩ : Fin 95)) *
          stage (Fin.castAdd 1 (⟨m, by omega⟩ : Fin 95))
            (Fin.castAdd 1 (⟨m, by omega⟩ : Fin 95)) j) /
        previousPivot (⟨m, by omega⟩ : Fin 95)
    else stage (Fin.castAdd 1 (⟨m, by omega⟩ : Fin 95)) i j
  exact stage_succ_apply (⟨m, by omega⟩ : Fin 95) i j

/-- The elimination stage at level `n` agrees with the bordered minors of `2K - I₉₆` on every
entry whose row and column lie at or beyond the pivot coordinate `n`. -/
theorem stage_eq_borderedMinor (n : ℕ) (hn : n < 96) (i j : Fin 96) (hi : n ≤ i.val)
    (hj : n ≤ j.val) : stage ⟨n, hn⟩ i j = borderedMinor ⟨n, hn⟩ i j := by
  -- Strong induction on the level.  The successor step rewrites the trailing update through
  -- Desnanot–Jacobi's identity for bordered minors and cancels the exact integer division by
  -- the preceding pivot, so the whole induction needs no evaluation of the recursion.
  revert hn i j
  induction n using Nat.strong_induction_on with
  | h n ih =>
    intro hn i j hi hj
    rcases n with _ | _ | m
    · -- Level zero: the stage is `2K - I₉₆` and the bordered minor is a `1 × 1` determinant.
      change stage (0 : Fin 96) i j = borderedMinor (0 : Fin 96) i j
      rw [borderedMinor_zero]
      rfl
    · -- Level one: the divisor is `1`, and the update is the leading `2 × 2` minor.
      have hstep := stage_succ_apply' 0 (by omega) i j
      have h0i : (⟨0, by omega⟩ : Fin 96) < i := by
        show (0 : ℕ) < i.val
        omega
      have h0j : (⟨0, by omega⟩ : Fin 96) < j := by
        show (0 : ℕ) < j.val
        omega
      rw [hstep, if_pos ⟨h0i, h0j⟩]
      -- Every stage entry of the update is a level-`0` bordered minor, by the induction
      -- hypothesis, and the divisor is the initial pivot `1`.
      rw [pivot_apply, ih 0 (by omega) (by omega) i j (by omega) (by omega),
        ih 0 (by omega) (by omega) i ⟨0, by omega⟩ (by omega) (Nat.zero_le _),
        ih 0 (by omega) (by omega) ⟨0, by omega⟩ j (Nat.zero_le _) (by omega),
        ih 0 (by omega) (by omega) ⟨0, by omega⟩ ⟨0, by omega⟩ (Nat.zero_le _)
          (Nat.zero_le _)]
      -- The divisor is the initial pivot `1`, and the level-`0` bordered minors are the
      -- entries of `2K - I₉₆`; the two index-`0` spellings are bridged by their lemmas.
      have hprev : previousPivot (⟨0, by omega⟩ : Fin 95) = 1 := previousPivot_zero
      have hb0 (x y : Fin 96) : borderedMinor (⟨0, by omega⟩ : Fin 96) x y = j0 x y :=
        borderedMinor_zero x y
      have hb1 : borderedMinor (⟨0 + 1, by omega⟩ : Fin 96) i j =
          j0 0 0 * j0 i j - j0 0 j * j0 i 0 := borderedMinor_one i j
      simp only [hprev, Int.ediv_one, hb1, hb0]
      -- Normalize the two spellings of the coordinate `0` before comparing the products.
      have hze : (⟨0, by omega⟩ : Fin 96) = (0 : Fin 96) := rfl
      simp only [hze]
      ring
    · -- Level `m + 2`: Desnanot–Jacobi at level `m + 1`, then exact integer division.
      have hstep := stage_succ_apply' (m + 1) (by omega) i j
      have hcond : (⟨m + 1, by omega⟩ : Fin 96) < i ∧ (⟨m + 1, by omega⟩ : Fin 96) < j := by
        constructor
        · show m + 1 < i.val
          omega
        · show m + 1 < j.val
          omega
      rw [hstep, if_pos hcond]
      -- Every stage entry of the update is a level-`m + 1` bordered minor, and the divisor is
      -- the level-`m` pivot, i.e. the leading principal minor of size `m + 1`.
      have hdiv : previousPivot (⟨m + 1, by omega⟩ : Fin 95) =
          borderedMinor ⟨m, by omega⟩ ⟨m, by omega⟩ ⟨m, by omega⟩ := by
        have hprev := previousPivot_succ (⟨m, by omega⟩ : Fin 94)
        change previousPivot ((⟨m, by omega⟩ : Fin 94).succ) =
          borderedMinor ⟨m, by omega⟩ ⟨m, by omega⟩ ⟨m, by omega⟩
        rw [hprev]
        change pivot (⟨m, by omega⟩ : Fin 96) =
          borderedMinor ⟨m, by omega⟩ ⟨m, by omega⟩ ⟨m, by omega⟩
        rw [pivot_apply,
          ih m (by omega) (by omega) ⟨m, by omega⟩ ⟨m, by omega⟩ (le_refl _) (le_refl _)]
      rw [pivot_apply, ih (m + 1) (by omega) (by omega) i j (by omega) (by omega),
        ih (m + 1) (by omega) (by omega) i ⟨m + 1, by omega⟩ (by omega) (le_refl _),
        ih (m + 1) (by omega) (by omega) ⟨m + 1, by omega⟩ j (le_refl _) (by omega),
        ih (m + 1) (by omega) (by omega) ⟨m + 1, by omega⟩ ⟨m + 1, by omega⟩
          (le_refl _) (le_refl _)]
      rw [hdiv]
      -- Desnanot–Jacobi turns the update numerator into the divisor times the next minor.
      rw [← borderedMinor_dodgson (m + 1) (by omega) (by omega) i j (by omega) (by omega)]
      exact Int.mul_ediv_cancel _ (borderedMinor_self_ne_zero ⟨m, by omega⟩)

/-- The denominator of the elimination update with pivot index `m + 1` is the leading
principal minor of size `m + 1`. -/
lemma previousPivot_succ_eq_principal_det (m : ℕ) (hm : m + 1 < 95) :
    previousPivot ⟨m + 1, hm⟩ = (principal ⟨m, by omega⟩).det := by
  -- The recursion never rewrites the diagonal entry it pivots on, so the divisor is the
  -- pivot `m` of the preceding stage, which `stage_eq_borderedMinor` identifies with the
  -- leading principal minor of size `m + 1`.
  have hprev := previousPivot_succ (⟨m, by omega⟩ : Fin 94)
  change previousPivot ((⟨m, by omega⟩ : Fin 94).succ) = (principal ⟨m, by omega⟩).det
  rw [hprev]
  change pivot (⟨m, by omega⟩ : Fin 96) = (principal ⟨m, by omega⟩).det
  rw [pivot_apply,
    stage_eq_borderedMinor m (by omega) ⟨m, by omega⟩ ⟨m, by omega⟩ (le_refl _) (le_refl _),
    borderedMinor_self]

/-- The fraction-free numerator of the update with pivot index `k` factors as the denominator
times the bordered minor one level higher. -/
lemma previousPivot_mul_borderedMinor_succ (k : Fin 95) (i j : Fin 96)
    (hi : Fin.castAdd 1 k < i) (hj : Fin.castAdd 1 k < j) :
    previousPivot k * borderedMinor k.succ i j =
      pivot (Fin.castAdd 1 k) * stage (Fin.castAdd 1 k) i j -
        stage (Fin.castAdd 1 k) i (Fin.castAdd 1 k) *
          stage (Fin.castAdd 1 k) (Fin.castAdd 1 k) j := by
  rcases k with ⟨n, hn⟩
  rcases n with _ | m
  · -- First update: the divisor is `1` and the numerator is the leading `2 × 2` minor.
    change previousPivot (0 : Fin 95) * borderedMinor (1 : Fin 96) i j =
      pivot (0 : Fin 96) * stage (0 : Fin 96) i j -
        stage (0 : Fin 96) i (0 : Fin 96) * stage (0 : Fin 96) (0 : Fin 96) j
    rw [previousPivot_zero, one_mul, pivot_apply, stage_zero, borderedMinor_one]
    ring
  · -- Later update: Desnanot–Jacobi at the preceding level `m + 1`.  The two index
    -- hypotheses are read in value form so that they drive the arithmetic side conditions.
    have hiv : m + 1 < i.val := hi
    have hjv : m + 1 < j.val := hj
    have hdod := borderedMinor_dodgson (m + 1) (by omega) (by omega) i j hiv hjv
    rw [previousPivot_succ_eq_principal_det m (by omega), ← borderedMinor_self]
    -- Replace the stages and the pivot of the update by bordered minors.
    change borderedMinor ⟨m, by omega⟩ ⟨m, by omega⟩ ⟨m, by omega⟩ *
        borderedMinor ⟨m + 1 + 1, by omega⟩ i j =
      pivot (⟨m + 1, by omega⟩ : Fin 96) * stage (⟨m + 1, by omega⟩ : Fin 96) i j -
        stage (⟨m + 1, by omega⟩ : Fin 96) i (⟨m + 1, by omega⟩ : Fin 96) *
          stage (⟨m + 1, by omega⟩ : Fin 96) (⟨m + 1, by omega⟩ : Fin 96) j
    rw [pivot_apply, stage_eq_borderedMinor (m + 1) (by omega) i j (by omega) (by omega),
      stage_eq_borderedMinor (m + 1) (by omega) i ⟨m + 1, by omega⟩ (by omega) (le_refl _),
      stage_eq_borderedMinor (m + 1) (by omega) ⟨m + 1, by omega⟩ j (le_refl _) (by omega),
      stage_eq_borderedMinor (m + 1) (by omega) ⟨m + 1, by omega⟩ ⟨m + 1, by omega⟩
        (le_refl _) (le_refl _)]
    rw [← hdod]
    -- Desnanot–Jacobi returns the leading minor at the index spelling `m + 1 - 1`; the two
    -- spellings agree, so the remaining comparison is a commutativity of the two factors.
    rw [show (⟨m + 1 - 1, by omega⟩ : Fin 96) = ⟨m, by omega⟩ from
      Fin.ext (show m + 1 - 1 = m from by omega)]
    ring

/-- Each fraction-free quotient is an exact integer division. -/
theorem previousPivot_dvd_update (k : Fin 95) (i j : Fin 96)
    (hi : Fin.castAdd 1 k < i) (hj : Fin.castAdd 1 k < j) :
    previousPivot k ∣
      pivot (Fin.castAdd 1 k) * stage (Fin.castAdd 1 k) i j -
        stage (Fin.castAdd 1 k) i (Fin.castAdd 1 k) *
          stage (Fin.castAdd 1 k) (Fin.castAdd 1 k) j := by
  -- Desnanot-Jacobi exhibits the update numerator as the divisor times the bordered minor
  -- one level higher, which is the exact-division statement.
  exact ⟨borderedMinor k.succ i j,
    (previousPivot_mul_borderedMinor_succ k i j hi hj).symm⟩

/-- The k-th pivot equals the determinant of the leading principal submatrix of
`2K - I₉₆` of size `k + 1`. -/
theorem pivot_eq_det (k : Fin 96) :
    pivot k = (principal k).det := by
  -- Specialize the elimination invariant at the pivot coordinate itself, where the
  -- bordered minor is the leading principal minor.
  have hbm : stage k k k = borderedMinor k k k :=
    stage_eq_borderedMinor k.val k.isLt k k (le_refl _) (le_refl _)
  rw [pivot_apply, hbm]
  exact borderedMinor_self k

/-! ### The recorded pivots of the fraction-free elimination

The appendix evaluates the fraction-free elimination of `2K - I₉₆` and records its
ninety-six diagonal pivots, each of them a positive integer.  The definitions below run
that elimination once and collect its diagonal pivots, and the kernel check
`pivotsComputed_eq` identifies the collected pivots with the recorded literals.  Every
later use of the numeric content of the certificate is then a consequence of those
literals, and no part of the elimination is evaluated a second time.
-/

/-- One step of the fraction-free elimination with pivot index `n`, applied to the matrix of
the preceding stage: the entries strictly beyond the pivot index are replaced by the
fraction-free Schur complement, whose denominator is the preceding diagonal pivot (`1` at
the first step). -/
def bareissStep (n : ℕ) (M : Matrix (Fin 96) (Fin 96) ℤ) : Matrix (Fin 96) (Fin 96) ℤ :=
  fun i j ↦
    if Fin.ofNat 96 n < i ∧ Fin.ofNat 96 n < j then
      (M (Fin.ofNat 96 n) (Fin.ofNat 96 n) * M i j -
          M i (Fin.ofNat 96 n) * M (Fin.ofNat 96 n) j) /
        (if n = 0 then 1 else M (Fin.ofNat 96 (n - 1)) (Fin.ofNat 96 (n - 1)))
    else M i j

/-- A run of the fraction-free elimination starting from a matrix `M` at step index `s`: step
`k` of the run performs the fraction-free update with pivot index `k + s` and records the
diagonal pivot it used. -/
def runFromAt (s : ℕ) (M : Matrix (Fin 96) (Fin 96) ℤ) :
    ℕ → Matrix (Fin 96) (Fin 96) ℤ × List ℤ
  | 0 => (M, [])
  | k + 1 =>
      let run := runFromAt s M k
      (bareissStep (k + s) run.1,
        run.2 ++ [run.1 (Fin.ofNat 96 (k + s)) (Fin.ofNat 96 (k + s))])

/-- The fraction-free elimination run from `2K - I₉₆`, paired with the list of diagonal
pivots it has produced so far. -/
def pivotsRun : ℕ → Matrix (Fin 96) (Fin 96) ℤ × List ℤ := runFromAt 0 j0

/-- A scalar-keyed version of the elimination, with the three recursion keys
explicit in each application rather than stored in nested matrix closures. -/
def keyedEntry (s : ℕ) (M : Matrix (Fin 96) (Fin 96) ℤ) :
    ℕ → ℕ → ℕ → ℤ
  | 0, i, j => M (Fin.ofNat 96 i) (Fin.ofNat 96 j)
  | k + 1, i, j =>
    let pivot := (k + s) % 96
    let previous := (k + s - 1) % 96
    if pivot < i ∧ pivot < j then
      (keyedEntry s M k pivot pivot * keyedEntry s M k i j -
        keyedEntry s M k i pivot * keyedEntry s M k pivot j) /
          (if k + s = 0 then 1 else keyedEntry s M k previous previous)
    else keyedEntry s M k i j

/-- The keyed recurrence agrees with the canonical matrix-valued elimination
at every valid matrix entry, for every starting index and initial matrix. -/
theorem keyedEntry_eq_runFromAt (s : ℕ) (M : Matrix (Fin 96) (Fin 96) ℤ)
    (n : ℕ) (i j : Fin 96) :
    keyedEntry s M n i.val j.val = (runFromAt s M n).1 i j := by
  induction n generalizing i j with
  | zero => simp [keyedEntry, runFromAt, Fin.ofNat_eq_cast]
  | succ n ih =>
    simp only [keyedEntry, runFromAt, bareissStep]
    have hp : (n + s) % 96 < 96 := Nat.mod_lt _ (by norm_num)
    have hq : (n + s - 1) % 96 < 96 := Nat.mod_lt _ (by norm_num)
    rw [ih i j, ih ⟨(n + s) % 96, hp⟩ ⟨(n + s) % 96, hp⟩,
      ih i ⟨(n + s) % 96, hp⟩, ih ⟨(n + s) % 96, hp⟩ j,
      ih ⟨(n + s - 1) % 96, hq⟩ ⟨(n + s - 1) % 96, hq⟩]
    rfl

/-- A scalar-keyed run records the same ordered list of pivots as the original
matrix-valued run, without requiring equality of matrix-valued closures. -/
def keyedPivots (s : ℕ) (M : Matrix (Fin 96) (Fin 96) ℤ) (n : ℕ) : List ℤ :=
  (List.range n).map fun k ↦ keyedEntry s M k ((k + s) % 96) ((k + s) % 96)

/-- Exact equivalence of the pivot lists, for every starting matrix and index. -/
theorem keyedPivots_eq_runFromAt (s : ℕ) (M : Matrix (Fin 96) (Fin 96) ℤ)
    (n : ℕ) : keyedPivots s M n = (runFromAt s M n).2 := by
  induction n with
  | zero => rfl
  | succ n ih =>
    simp only [keyedPivots, List.range_succ, List.map_append, List.map_singleton] at ih ⊢
    rw [ih]
    have hp : (n + s) % 96 < 96 := Nat.mod_lt _ (by norm_num)
    rw [keyedEntry_eq_runFromAt s M n ⟨(n + s) % 96, hp⟩ ⟨(n + s) % 96, hp⟩]
    rfl

/-- Whole-matrix form of the scalar-keyed equivalence, used to rewrite row certificates. -/
theorem runFromAt_fst_eq_keyed (s : ℕ) (M : Matrix (Fin 96) (Fin 96) ℤ)
    (n : ℕ) : (runFromAt s M n).1 =
      fun i j ↦ keyedEntry s M n i.val j.val := by
  ext i j
  exact (keyedEntry_eq_runFromAt s M n i j).symm


/-- An elimination run splits after `n` steps: the matrix reached by `n + k` steps is the
matrix reached by running the remaining `k` steps from the matrix reached after `n` steps. -/
lemma runFromAt_fst_add (s n k : ℕ) (M : Matrix (Fin 96) (Fin 96) ℤ) :
    (runFromAt s M (n + k)).1 =
      (runFromAt (n + s) (runFromAt s M n).1 k).1 := by
  -- Induction on the number of remaining steps; the successor step compares the two
  -- fraction-free updates, whose pivot indices agree after commuting the additions.
  induction k with
  | zero => rfl
  | succ k ih =>
      rw [Nat.add_succ,
        show runFromAt s M ((n + k) + 1) =
          (bareissStep ((n + k) + s) (runFromAt s M (n + k)).1,
            (runFromAt s M (n + k)).2 ++
              [(runFromAt s M (n + k)).1 (Fin.ofNat 96 ((n + k) + s))
                (Fin.ofNat 96 ((n + k) + s))]) from rfl,
        show runFromAt (n + s) (runFromAt s M n).1 (k + 1) =
          (bareissStep (k + (n + s)) (runFromAt (n + s) (runFromAt s M n).1 k).1,
            (runFromAt (n + s) (runFromAt s M n).1 k).2 ++
              [(runFromAt (n + s) (runFromAt s M n).1 k).1 (Fin.ofNat 96 (k + (n + s)))
                (Fin.ofNat 96 (k + (n + s)))]) from rfl,
        ih]
      rw [show (n + k) + s = k + (n + s) from by omega]

/-- The pivots recorded by a run of `n + k` elimination steps are the pivots recorded by the
first `n` steps followed by those recorded by the remaining `k` steps. -/
lemma runFromAt_snd_add (s n k : ℕ) (M : Matrix (Fin 96) (Fin 96) ℤ) :
    (runFromAt s M (n + k)).2 =
      (runFromAt s M n).2 ++ (runFromAt (n + s) (runFromAt s M n).1 k).2 := by
  -- Induction on the remaining steps.  In the successor step the two recorded pivot lists
  -- have the same initial segment by the induction hypothesis, so it remains to compare the
  -- two freshly recorded pivots: the matrices agree by `runFromAt_fst_add` and the indices
  -- agree after commuting the additions.
  induction k with
  | zero => simp only [Nat.add_zero, runFromAt, List.append_nil]
  | succ k ih =>
      rw [Nat.add_succ,
        show runFromAt s M ((n + k) + 1) =
          (bareissStep ((n + k) + s) (runFromAt s M (n + k)).1,
            (runFromAt s M (n + k)).2 ++
              [(runFromAt s M (n + k)).1 (Fin.ofNat 96 ((n + k) + s))
                (Fin.ofNat 96 ((n + k) + s))]) from rfl,
        show runFromAt (n + s) (runFromAt s M n).1 (k + 1) =
          (bareissStep (k + (n + s)) (runFromAt (n + s) (runFromAt s M n).1 k).1,
            (runFromAt (n + s) (runFromAt s M n).1 k).2 ++
              [(runFromAt (n + s) (runFromAt s M n).1 k).1 (Fin.ofNat 96 (k + (n + s)))
                (Fin.ofNat 96 (k + (n + s)))]) from rfl,
        ih, List.append_assoc]
      rw [runFromAt_fst_add s n k M]
      rw [show (n + k) + s = k + (n + s) from by omega]

