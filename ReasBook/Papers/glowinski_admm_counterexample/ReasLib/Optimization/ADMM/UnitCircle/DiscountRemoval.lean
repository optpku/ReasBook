module

public import Mathlib.Topology.Algebra.InfiniteSum.Real
public import Mathlib.Topology.Algebra.Monoid
public import Mathlib.Topology.Order.DenselyOrdered

@[expose] public section

open scoped BigOperators Topology
open Filter

namespace ADMM.UnitCircle

/-- Every finite undiscounted sum inherits a bound uniform as the time discount
tends to one. The limiting filter need not be generated by a monotone sequence. -/
theorem partialSum_le_of_discounted_partialSum_le {ι : Type*}
    {l : Filter ι} [l.NeBot] {α : ι → ℝ} {a : ℕ → ℝ} {C : ℝ}
    (hα : Tendsto α l (nhds 1))
    (hbound : ∀ N, ∀ᶠ t in l,
      ∑ k ∈ Finset.range N, α t ^ (2 * k) * a k ≤ C) (N : ℕ) :
    ∑ k ∈ Finset.range N, a k ≤ C := by
  have hlimit : Tendsto
      (fun t ↦ ∑ k ∈ Finset.range N, α t ^ (2 * k) * a k)
      l (nhds (∑ k ∈ Finset.range N, a k)) := by
    simpa using tendsto_finsetSum (Finset.range N)
      (fun k _ ↦ (hα.pow (2 * k)).mul_const (a k))
  exact le_of_tendsto hlimit (hbound N)

/-- Uniform discounted partial-sum bounds imply summability before the discount
is removed. No summability of the original sequence is assumed. -/
theorem summable_of_discounted_partialSum_le {ι : Type*}
    {l : Filter ι} [l.NeBot] {α : ι → ℝ} {a : ℕ → ℝ} {C : ℝ}
    (ha : ∀ k, 0 ≤ a k) (hα : Tendsto α l (nhds 1))
    (hbound : ∀ N, ∀ᶠ t in l,
      ∑ k ∈ Finset.range N, α t ^ (2 * k) * a k ≤ C) :
    Summable a := by
  exact summable_of_sum_range_le ha
    (partialSum_le_of_discounted_partialSum_le hα hbound)

/-- The uniform bound survives removal of the time discount. -/
theorem tsum_le_of_discounted_partialSum_le {ι : Type*}
    {l : Filter ι} [l.NeBot] {α : ι → ℝ} {a : ℕ → ℝ} {C : ℝ}
    (ha : ∀ k, 0 ≤ a k) (hα : Tendsto α l (nhds 1))
    (hbound : ∀ N, ∀ᶠ t in l,
      ∑ k ∈ Finset.range N, α t ^ (2 * k) * a k ≤ C) :
    ∑' k, a k ≤ C := by
  exact Real.tsum_le_of_sum_range_le ha
    (partialSum_le_of_discounted_partialSum_le hα hbound)

/-- Nonnegative discounted terms make every partial sum bounded by the
discounted total. This is the passage from a Parseval estimate to finite sums. -/
theorem discounted_partialSum_le_of_tsum_le {ι : Type*}
    {l : Filter ι} {α : ι → ℝ} {a : ℕ → ℝ} {C : ℝ}
    (ha : ∀ k, 0 ≤ a k)
    (hbound : ∀ᶠ t in l, Summable (fun k ↦ α t ^ (2 * k) * a k) ∧
      ∑' k, α t ^ (2 * k) * a k ≤ C) :
    ∀ N, ∀ᶠ t in l, ∑ k ∈ Finset.range N, α t ^ (2 * k) * a k ≤ C := by
  intro N
  filter_upwards [hbound] with t ht
  have hnonneg : ∀ k, 0 ≤ α t ^ (2 * k) * a k := by
    intro k
    rw [pow_mul]
    exact mul_nonneg (pow_nonneg (sq_nonneg _) _) (ha k)
  exact (ht.1.sum_le_tsum (Finset.range N) (fun k _ ↦ hnonneg k)).trans ht.2

/-- A uniform estimate for summable discounted dissipation yields summability
and the same total bound for the undiscounted dissipation. -/
theorem summable_tsum_le_of_discounted_tsum_le {ι : Type*}
    {l : Filter ι} [l.NeBot] {α : ι → ℝ} {a : ℕ → ℝ} {C : ℝ}
    (ha : ∀ k, 0 ≤ a k) (hα : Tendsto α l (nhds 1))
    (hbound : ∀ᶠ t in l, Summable (fun k ↦ α t ^ (2 * k) * a k) ∧
      ∑' k, α t ^ (2 * k) * a k ≤ C) :
    Summable a ∧ ∑' k, a k ≤ C := by
  have hfinite := discounted_partialSum_le_of_tsum_le ha hbound
  exact ⟨summable_of_discounted_partialSum_le ha hα hfinite,
    tsum_le_of_discounted_partialSum_le ha hα hfinite⟩

/-- The one-sided form used when the positive time discount approaches one
from below in Lemma C.1. -/
theorem remove_time_discount {a : ℕ → ℝ} {C : ℝ}
    (ha : ∀ k, 0 ≤ a k)
    (hbound : ∀ᶠ α : ℝ in 𝓝[<] (1 : ℝ),
      Summable (fun k ↦ α ^ (2 * k) * a k) ∧
      ∑' k, α ^ (2 * k) * a k ≤ C) :
    Summable a ∧ ∑' k, a k ≤ C := by
  exact summable_tsum_le_of_discounted_tsum_le ha
    (show Tendsto (fun α : ℝ ↦ α) (𝓝[<] (1 : ℝ)) (𝓝 1) from nhdsWithin_le_nhds)
    hbound

/-- Removing a discount separates a positive residual coefficient from a
positive merit coefficient. In Lemma C.1 these coefficients are `ε` and `ω/2`. -/
theorem two_dissipations_summable_of_discounted_tsum_le {ι : Type*}
    {l : Filter ι} [l.NeBot] {α : ι → ℝ} {R M : ℕ → ℝ} {C ε μ : ℝ}
    (hε : 0 < ε) (hμ : 0 < μ) (hR : ∀ k, 0 ≤ R k) (hM : ∀ k, 0 ≤ M k)
    (hα : Tendsto α l (nhds 1))
    (hbound : ∀ᶠ t in l,
      Summable (fun k ↦ α t ^ (2 * k) * (ε * R k + μ * M k)) ∧
      ∑' k, α t ^ (2 * k) * (ε * R k + μ * M k) ≤ C) :
    Summable R ∧ Summable M := by
  have hnonneg : ∀ k, 0 ≤ ε * R k + μ * M k := fun k ↦
    add_nonneg (mul_nonneg hε.le (hR k)) (mul_nonneg hμ.le (hM k))
  have hs := (summable_tsum_le_of_discounted_tsum_le hnonneg hα hbound).1
  have hsR : Summable (fun k ↦ ε * R k) :=
    Summable.of_nonneg_of_le (fun k ↦ mul_nonneg hε.le (hR k))
      (fun k ↦ le_add_of_nonneg_right (mul_nonneg hμ.le (hM k))) hs
  have hsM : Summable (fun k ↦ μ * M k) :=
    Summable.of_nonneg_of_le (fun k ↦ mul_nonneg hμ.le (hM k))
      (fun k ↦ le_add_of_nonneg_left (mul_nonneg hε.le (hR k))) hs
  constructor
  · simpa only [← mul_assoc, inv_mul_cancel₀ hε.ne', one_mul] using hsR.mul_left ε⁻¹
  · simpa only [← mul_assoc, inv_mul_cancel₀ hμ.ne', one_mul] using hsM.mul_left μ⁻¹

/-- A finite modification of the initial supply has an error bound independent
of the discount and the truncation horizon. This justifies the constant initial
boundary correction used before the discount is removed. -/
theorem discounted_prefix_error_le {a b : ℕ → ℝ} {α : ℝ}
    (hα0 : 0 ≤ α) (hα1 : α ≤ 1) (L : ℕ)
    (htail : ∀ k, L ≤ k → a k = b k) (N : ℕ) :
    |∑ k ∈ Finset.range N, α ^ (2 * k) * (a k - b k)| ≤
      ∑ k ∈ Finset.range L, |a k - b k| := by
  have hterm : ∀ k, |α ^ (2 * k) * (a k - b k)| ≤ |a k - b k| := by
    intro k
    rw [abs_mul, abs_of_nonneg (pow_nonneg hα0 _)]
    exact mul_le_of_le_one_left (abs_nonneg _) (pow_le_one₀ hα0 hα1)
  have hsum : ∑ k ∈ Finset.range N, |a k - b k| ≤
      ∑ k ∈ Finset.range L, |a k - b k| := by
    have heq : ∑ k ∈ Finset.range N ∩ Finset.range L, |a k - b k| =
        ∑ k ∈ Finset.range N, |a k - b k| := by
      apply Finset.sum_subset Finset.inter_subset_left
      intro k hk hnot
      have hkL : L ≤ k := by
        by_contra! h
        exact hnot (Finset.mem_inter.mpr ⟨hk, Finset.mem_range.mpr h⟩)
      rw [htail k hkL, sub_self, abs_zero]
    rw [← heq]
    exact Finset.sum_le_sum_of_subset_of_nonneg Finset.inter_subset_right
      (fun k _ _ ↦ abs_nonneg _)
  exact (Finset.abs_sum_le_sum_abs _ _).trans
    ((Finset.sum_le_sum fun k _ ↦ hterm k).trans hsum)

end ADMM.UnitCircle
