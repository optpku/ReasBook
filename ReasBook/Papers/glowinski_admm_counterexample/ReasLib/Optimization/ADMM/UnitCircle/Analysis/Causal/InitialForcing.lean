module

public import glowinski_admm_counterexample.ReasLib.Optimization.ADMM.UnitCircle.Analysis.Causal.Truncation
public import Mathlib.Analysis.SpecificLimits.Normed
public import Mathlib.Tactic.Linarith
public import Mathlib.Tactic.Module
public import Mathlib.Tactic.Ring

@[expose] public section

open scoped ENNReal

namespace ADMM.UnitCircle.Causal

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

/-- The geometrically discounted contribution of an arbitrary initial value. -/
def geometricTail (α : ℝ) (x : E) (k : ℕ) : E := α ^ (k + 1) • x

theorem geometricTail_memℓp {α : ℝ} (hα0 : 0 ≤ α) (hα1 : α < 1) (x : E) :
    Memℓp (geometricTail α x) 2 := by
  apply memℓp_gen
  have hα2 : α ^ 2 < 1 := by nlinarith
  have h := (summable_geometric_of_lt_one (sq_nonneg α) hα2).mul_left
    (α ^ 2 * ‖x‖ ^ 2)
  convert! h using 1
  funext k
  simp only [ENNReal.toReal_ofNat, Real.rpow_two, geometricTail, norm_smul,
    Real.norm_eq_abs, abs_pow, abs_of_nonneg hα0]
  rw [pow_succ, ← pow_mul, Nat.mul_comm 2 k, pow_mul]
  ring

/-- The explicit disturbance generated by the two arbitrary initial reduced
state vectors. The impulse is at index zero, manuscript step one. -/
noncomputable def initialForcing (α γ : ℝ) (η₀ w₀ : E) (k : ℕ) : Fin 2 → E :=
  let impulse : Fin 2 → E := fun b ↦ if b = 0 then η₀ else 0
  let drift : Fin 2 → E := fun b ↦ if b = 0 then (-γ) • w₀ else γ • w₀
  (if k = 0 then α • impulse else 0) + geometricTail α drift k

@[simp] theorem initialForcing_first (α γ : ℝ) (η₀ w₀ : E) (k : ℕ) :
    initialForcing α γ η₀ w₀ k 0 =
      (if k = 0 then α • η₀ else 0) + (-γ) • (α ^ (k + 1) • w₀) := by
  by_cases hk : k = 0 <;> simp [initialForcing, geometricTail, hk] <;> module

@[simp] theorem initialForcing_second (α γ : ℝ) (η₀ w₀ : E) (k : ℕ) :
    initialForcing α γ η₀ w₀ k 1 = γ • (α ^ (k + 1) • w₀) := by
  by_cases hk : k = 0 <;> simp [initialForcing, geometricTail, hk] <;> module

/-- The actual initial-state forcing belongs to `ℓ₂` for every fixed
strict discount. The initial state itself is unrestricted. -/
theorem initialForcing_memℓp {α : ℝ} (hα0 : 0 ≤ α) (hα1 : α < 1)
    (γ : ℝ) (η₀ w₀ : E) : Memℓp (initialForcing α γ η₀ w₀) 2 := by
  let impulse : Fin 2 → E := fun b ↦ if b = 0 then η₀ else 0
  let drift : Fin 2 → E := fun b ↦ if b = 0 then (-γ) • w₀ else γ • w₀
  have hi : Memℓp (fun k : ℕ ↦ if k = 0 then α • impulse else 0) 2 := by
    have heq : (fun k : ℕ ↦ if k = 0 then α • impulse else 0) =
        Pi.single 0 (α • impulse) := by
      funext k
      by_cases hk : k = 0
      · subst k
        simp
      · simp [hk, Pi.single_eq_of_ne hk]
    rw [heq]
    exact lp.memℓp (lp.single (E := fun _ : ℕ ↦ Fin 2 → E) 2 0 (α • impulse))
  exact hi.add (geometricTail_memℓp hα0 hα1 drift)

end ADMM.UnitCircle.Causal
