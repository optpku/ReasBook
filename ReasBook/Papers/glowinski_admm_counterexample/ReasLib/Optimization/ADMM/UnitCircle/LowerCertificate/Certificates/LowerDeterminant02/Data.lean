theorem powerS_correct (m : ℕ) : powerS m = (16) ^ m :=
  cachedPower_sound powersS_valid m

theorem coefficients_pos : ∀ i : Fin 513, 0 < bernsteinTree.get i := by
  decide +kernel

theorem bernsteinDenominator_pos : 0 < bernsteinDenominator := by decide +kernel

def leftCoefficient (j : ℕ) : ℤ := bernsteinDenominator *
  IntegerCoefficients.affineCoefficient Data.choose powerA (fun _ ↦ 1) powerS
    512 (fun k ↦ Data.IntegerPolynomials.LowerDeterminant.coefficients.get k) j

def rightCoefficient (j : ℕ) : ℤ := scaleFactor *
  IntegerCoefficients.directCoefficient Data.choose Data.signPower
    512 (fun k ↦ bernsteinTree.get k) j

