def diagonalPaired : Laurent :=
  pairedLaurent 256 ((diagonalQuotientIntegers.get 256 : ℚ) / Leaves.diagonalDenominator)
    (fun i ↦ (diagonalQuotientIntegers.get (i.val + 257) : ℚ) / Leaves.diagonalDenominator)
    (fun i ↦ (diagonalQuotientIntegers.get (255 - i.val) : ℚ) / Leaves.diagonalDenominator)

def diagonalWindowIndices : List ℤ := List.ofFn (fun i : Fin 513 ↦ (i.val : ℤ) - 256)

def diagonalPairedIndices : List ℤ :=
  0 :: (List.ofFn (fun i : Fin 256 ↦ [(i.val + 1 : ℤ), -(i.val + 1 : ℤ)])).flatten

def diagonalIndexToTerm (j : ℤ) : ℤ × ℚ :=
  (j, (diagonalQuotientIntegers.get (j + 256).toNat : ℚ) / Leaves.diagonalDenominator)

theorem diagonalSourceRoundtrip : Division.startDiagonalQuotient =
    diagonalWindowIndices.map diagonalIndexToTerm := by
  decide +kernel

theorem diagonalPairedRoundtrip :
    diagonalPairedIndices.map diagonalIndexToTerm = diagonalPaired := by
  decide +kernel

theorem diagonalIndexPerm : diagonalWindowIndices.Perm diagonalPairedIndices := by
  decide +kernel

theorem diagonalPaired_perm : Division.startDiagonalQuotient.Perm diagonalPaired := by
  rw [diagonalSourceRoundtrip, ← diagonalPairedRoundtrip]
  exact diagonalIndexPerm.map diagonalIndexToTerm

theorem diagonalChebWeights_zero :
    (diagonalChebWeights.get 0 : ℚ) / Leaves.diagonalDenominator =
      (diagonalQuotientIntegers.get 256 : ℚ) / Leaves.diagonalDenominator -
        ADMM.RefinedEndpoint.Data.kappa := by
  decide +kernel

theorem diagonalChebWeights_pair : ∀ i : Fin 256,
    diagonalChebWeights.get (i.val + 1) =
      diagonalQuotientIntegers.get (i.val + 257) + diagonalQuotientIntegers.get (255 - i.val) := by
  decide +kernel

def diagonalChebPolynomial : List ℤ :=
  IntegerCoefficients.chebyshevTransform chebyshevTree.get 256 (fun i ↦ diagonalChebWeights.get i)

theorem diagonalChebPolynomial_length : diagonalChebPolynomial.length = 257 := by
  decide +kernel

end ADMM.UnitCircle.LowerCertificate.Data
