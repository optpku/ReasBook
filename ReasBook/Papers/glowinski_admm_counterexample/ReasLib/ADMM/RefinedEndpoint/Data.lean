/-- Kernel-evaluated sign check, separate from all analytic claims. -/
theorem lagWeights_nonnegative :
    lagWeights.all (fun e ↦ decide (0 ≤ e.coefficient)) = true := by decide +kernel

/-- Kernel-evaluated finite lag range check. -/
theorem lagWeights_in_range :
    lagWeights.all (fun e ↦ decide (0 < e.lag.natAbs ∧ e.lag.natAbs ≤ historyLength)) = true := by
  decide

/-- Every Fourier mode lies in the prescribed half spectrum. -/
theorem fourierFactors_in_range :
    fourierFactors.all (fun e ↦ decide (1 ≤ e.mode ∧ e.mode ≤ period / 2)) = true := by
  decide

