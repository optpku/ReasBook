      "line": 242,
      "proofDependencies": [
        "lem-planar-degeneration"
      ],
      "section": "main",
      "statement": "For a globally strongly convex C² objective in two dimensions, a locally Lipschitz Hessian near the initial sublevel set ensures convergence to the unique minimizer under weak Wolfe conditions, from any positive-definite initial matrix. Strong Wolfe follows as a consequence.",
      "statementDependencies": [],
      "title": "A locally Lipschitz Hessian restores planar convergence",
      "type": "Theorem",
      "paperMapping": "Weak- and strong-Wolfe interfaces; finite stationary termination is represented by constant continuation.",
