    {
      "declaration": "DFP.main_planarWeakWolfeConvergence",
      "dependencies": [],
      "dependencyEvidence": "compiled",
      "file": "DFPWolfe/Main.lean",
      "id": "thm-planar-convergence",
      "label": "Theorem 3",
      "line": 198,
      "proofDependencies": [],
      "section": "main",
      "statement": "\\label{thm:planar-convergence}\nLet $f\\in C^2(\\R^2)$ satisfy $\\nabla^2f(x)\\succeq\\mu I$ for all\n$x\\in\\R^2$ and some $\\mu>0$. Let $x_0\\in\\R^2$ and $H_0\\succ0$\nbe arbitrary, and fix $0<c_1<c_2<1$. Suppose $\\nabla^2f$ is locally\nLipschitz continuous on a neighborhood of the initial level set\n$K=\\{x\\in\\R^2:f(x)\\le f(x_0)\\}$.\nThen classical DFP with update \\eqref{eq:dfp-update} and positive step\nlengths satisfying \\eqref{eq:armijo} and \\eqref{eq:weak-curvature}\neither reaches the unique minimizer $x_*$ in finitely many iterations or\ngenerates an infinite sequence satisfying\n$x_k\\longrightarrow x_*$ and $\\|\\nabla f(x_k)\\|\\longrightarrow0$.",
      "statementDependencies": [],
      "title": "A locally Lipschitz Hessian restores planar convergence",
      "type": "Theorem",
      "paperMapping": "The weak-Wolfe theorem and its strong-Wolfe consequence; finite stationary termination is represented by constant continuation.",
      "texLabel": "thm:planar-convergence",
      "relatedDeclarations": [
        {
          "declaration": "DFP.main_planarWeakWolfeConvergence",
