module

public import TR_LALM_theory.Corollary_3_8.StoppedScheduledAttempt
public import TR_LALM_theory.Theorem_3_6.CanonicalRun

public section

open MeasureTheory
open scoped BigOperators InnerProductSpace NNReal

namespace LALM.FiniteStopped

universe u

variable {n m : ℕ}
variable {Ξ : Type u} [MeasurableSpace Ξ] {ν : Measure Ξ} [IsProbabilityMeasure ν]
variable {f : EuclideanSpace ℝ (Fin n) → ℝ}
variable {c : EuclideanSpace ℝ (Fin n) → EuclideanSpace ℝ (Fin m)}
variable {x₀ : EuclideanSpace ℝ (Fin n)}
variable {multiplier₀ : EuclideanSpace ℝ (Fin m)}
variable {h : EqualityConstrained.Regularity f c}
variable {oracle : EqualityConstrained.StochasticOracle f h.region ν}
variable {params : LALM.Parameters h x₀ multiplier₀}
variable {Q B b : ℕ+}
variable {confidence : ℝ}

open LALM.StochasticRun.Localization

namespace CanonicalStoppedAttempt

/-- Helper for Theorem 3.7: the finite canonical history before batch `k`
contains exactly the preceding canonical sample rows. -/
def sampleHistory (k : ℕ) (omega : CanonicalSampleSpace Ξ) :
    Fin k → ℕ → Ξ :=
  fun t i ↦ CanonicalRun.sample t.1 i omega

/-- Helper for Theorem 3.7: the fresh canonical batch at iteration `k` is
the `k`-th coordinate row. -/
def sampleBatch (k : ℕ) (omega : CanonicalSampleSpace Ξ) : ℕ → Ξ :=
  fun i ↦ CanonicalRun.sample k i omega

/-- Helper for Theorem 3.7: every finite canonical sample history is
measurable. -/
theorem measurable_sampleHistory (k : ℕ) :
    Measurable (sampleHistory (Ξ := Ξ) k) := by
  apply measurable_pi_lambda
  intro t
  apply measurable_pi_lambda
  intro i
  exact CanonicalRun.measurable_sample t.1 i

/-- Helper for Theorem 3.7: every canonical fresh batch is measurable. -/
theorem measurable_sampleBatch (k : ℕ) :
    Measurable (sampleBatch (Ξ := Ξ) k) := by
  apply measurable_pi_lambda
  intro i
  exact CanonicalRun.measurable_sample k i

/-- Helper for Theorem 3.7: the sigma-algebra generated by a canonical
sample coordinate. -/
abbrev sampleCoordinateSigma (ki : ℕ × ℕ) :
    MeasurableSpace (CanonicalSampleSpace Ξ) :=
  MeasurableSpace.comap
    (CanonicalRun.sample (Ξ := Ξ) ki.1 ki.2) inferInstance

/-- Helper for Theorem 3.7: every canonical coordinate sigma-algebra lies
below the product sigma-algebra. -/
theorem sampleCoordinateSigma_le (ki : ℕ × ℕ) :
    sampleCoordinateSigma (Ξ := Ξ) ki ≤
      (inferInstance : MeasurableSpace (CanonicalSampleSpace Ξ)) := by
  unfold sampleCoordinateSigma
  exact (CanonicalRun.measurable_sample (Ξ := Ξ) ki.1 ki.2).comap_le

/-- Helper for Theorem 3.7: canonical sample-coordinate sigma-algebras are
mutually independent under the product law. -/
theorem iIndep_sampleCoordinateSigma :
    ProbabilityTheory.iIndep
      (fun ki : ℕ × ℕ ↦ sampleCoordinateSigma (Ξ := Ξ) ki)
      (canonicalProductMeasure ν) := by
  simpa only [sampleCoordinateSigma] using
    (CanonicalRun.sample_iIndepFun (Ξ := Ξ) (ν := ν)).iIndep

/-- Helper for Theorem 3.7: the past-coordinate set contains exactly rows
strictly before `k`. -/
def pastSampleIndexSet (k : ℕ) : Set (ℕ × ℕ) :=
  {ki | ki.1 < k}

/-- Helper for Theorem 3.7: the current-coordinate set is row `k`. -/
def currentSampleIndexSet (k : ℕ) : Set (ℕ × ℕ) :=
  {ki | ki.1 = k}

/-- Helper for Theorem 3.7: past and current canonical coordinate sets are
disjoint. -/
theorem pastSampleIndexSet_disjoint_currentSampleIndexSet (k : ℕ) :
    Disjoint (pastSampleIndexSet k) (currentSampleIndexSet k) := by
  rw [Set.disjoint_left]
  rintro ⟨t, i⟩ htPast htCurrent
  simp only [pastSampleIndexSet, Set.mem_setOf_eq] at htPast
  simp only [currentSampleIndexSet, Set.mem_setOf_eq] at htCurrent
  omega

/-- Helper for Theorem 3.7: the past-coordinate sigma-algebra. -/
abbrev pastSampleSigma (k : ℕ) :
    MeasurableSpace (CanonicalSampleSpace Ξ) :=
  ⨆ ki ∈ pastSampleIndexSet k, sampleCoordinateSigma (Ξ := Ξ) ki

/-- Helper for Theorem 3.7: the current-row sigma-algebra. -/
abbrev currentSampleSigma (k : ℕ) :
    MeasurableSpace (CanonicalSampleSpace Ξ) :=
  ⨆ ki ∈ currentSampleIndexSet k, sampleCoordinateSigma (Ξ := Ξ) ki

/-- Helper for Theorem 3.7: the finite canonical history is measurable with
respect to the past-coordinate sigma-algebra. -/
theorem measurable_sampleHistory_past (k : ℕ) :
    Measurable[pastSampleSigma (Ξ := Ξ) k]
      (sampleHistory (Ξ := Ξ) k) := by
  apply Measurable.of_comap_le
  rw [MeasurableSpace.comap_process_pi]
  apply iSup_le
  intro t
  rw [MeasurableSpace.comap_process_pi]
  apply iSup_le
  intro i
  have hmem : ((t.1 : ℕ), i) ∈ pastSampleIndexSet k := by
    simp only [pastSampleIndexSet, Set.mem_setOf_eq]
    exact t.isLt
  unfold sampleHistory pastSampleSigma sampleCoordinateSigma
  exact le_iSup_of_le (t.1, i) (le_iSup_of_le hmem le_rfl)

/-- Helper for Theorem 3.7: the current canonical row is measurable with
respect to the current-coordinate sigma-algebra. -/
theorem measurable_sampleBatch_current (k : ℕ) :
    Measurable[currentSampleSigma (Ξ := Ξ) k]
      (sampleBatch (Ξ := Ξ) k) := by
  apply Measurable.of_comap_le
  rw [MeasurableSpace.comap_process_pi]
  apply iSup_le
  intro i
  have hmem : (k, i) ∈ currentSampleIndexSet k := by
    simp only [currentSampleIndexSet, Set.mem_setOf_eq]
  unfold sampleBatch currentSampleSigma sampleCoordinateSigma
  exact le_iSup_of_le (k, i) (le_iSup_of_le hmem le_rfl)

/-- Helper for Theorem 3.7: a finite canonical history is independent of its
fresh row. -/
theorem indepFun_sampleHistory_sampleBatch (k : ℕ) :
    ProbabilityTheory.IndepFun
      (sampleHistory (Ξ := Ξ) k)
      (sampleBatch (Ξ := Ξ) k)
      (canonicalProductMeasure ν) := by
  have hgrouped : ProbabilityTheory.Indep
      (pastSampleSigma (Ξ := Ξ) k) (currentSampleSigma (Ξ := Ξ) k)
      (canonicalProductMeasure ν) := by
    unfold pastSampleSigma currentSampleSigma
    exact ProbabilityTheory.indep_iSup_of_disjoint
      (sampleCoordinateSigma_le (Ξ := Ξ))
      (iIndep_sampleCoordinateSigma (Ξ := Ξ) (ν := ν))
      (pastSampleIndexSet_disjoint_currentSampleIndexSet k)
  unfold ProbabilityTheory.IndepFun
  exact ProbabilityTheory.indep_of_indep_of_le hgrouped
    (measurable_sampleHistory_past (Ξ := Ξ) k).comap_le
    (measurable_sampleBatch_current (Ξ := Ξ) k).comap_le

/-- Helper for Theorem 3.7: the canonical finite stopped state is the local
finite-history recursion on the canonical product space. -/
noncomputable def state
    (X : Set (EuclideanSpace ℝ (Fin n))) (K : ℕ)
    (k : Fin (K + 1)) (omega : CanonicalSampleSpace Ξ) :
    PreBatchState n m :=
  LALM.FiniteStopped.state h oracle params Q B b X k.1
    (sampleHistory k.1 omega)

/-- Helper for Theorem 3.7: every canonical finite stopped state is
measurable. -/
theorem measurable_state
    (X : Set (EuclideanSpace ℝ (Fin n))) (hX : MeasurableSet X) (K : ℕ)
    (k : Fin (K + 1)) :
    Measurable (state (h := h) (oracle := oracle) (params := params)
      (Q := Q) (B := B) (b := b) X K k) := by
  exact (LALM.FiniteStopped.measurable_state (h := h) (oracle := oracle)
    (params := params) (Q := Q) (B := B) (b := b) X hX k.1).comp
      (measurable_sampleHistory k.1)

/-- Helper for Theorem 3.7: the canonical stopped state before iteration
`k` is independent of the fresh canonical row. -/
theorem independent_state_sample
    (X : Set (EuclideanSpace ℝ (Fin n))) (hX : MeasurableSet X) (K : ℕ)
    (k : Fin K) :
    ProbabilityTheory.IndepFun
      (state (h := h) (oracle := oracle) (params := params)
        (Q := Q) (B := B) (b := b) X K k.castSucc)
      (fun omega i ↦ CanonicalRun.sample k.1 i omega)
      (canonicalProductMeasure ν) := by
  have hindependent : ProbabilityTheory.IndepFun
      (LALM.FiniteStopped.state h oracle params Q B b X k.1 ∘
        sampleHistory k.1)
      (id ∘ sampleBatch k.1)
      (canonicalProductMeasure ν) :=
    (indepFun_sampleHistory_sampleBatch (Ξ := Ξ) (ν := ν) k.1).comp
      (LALM.FiniteStopped.measurable_state (h := h) (oracle := oracle)
        (params := params) (Q := Q) (B := B) (b := b) X hX k.1)
      measurable_id
  change ProbabilityTheory.IndepFun
    (LALM.FiniteStopped.state h oracle params Q B b X k.1 ∘
      sampleHistory k.1)
    (fun omega i ↦ CanonicalRun.sample k.1 i omega)
    (canonicalProductMeasure ν)
  have hbatchEq : (id ∘ sampleBatch (Ξ := Ξ) k.1) =
      (fun omega i ↦ CanonicalRun.sample k.1 i omega) := by
    funext omega i
    rfl
  rw [hbatchEq] at hindependent
  exact hindependent

/-- Helper for Theorem 3.7: the canonical stopped state starts from the
active initialized base package. -/
theorem state_zero
    (X : Set (EuclideanSpace ℝ (Fin n))) (K : ℕ)
    (omega : CanonicalSampleSpace Ξ) :
    state (h := h) (oracle := oracle) (params := params)
        (Q := Q) (B := B) (b := b) X K
        ⟨0, Nat.zero_lt_succ K⟩ omega = initialState x₀ multiplier₀ := by
  unfold state sampleHistory
  exact LALM.FiniteStopped.state_zero X _

/-- Helper for Theorem 3.7: every canonical successor is the absorbing
finite transition from its preceding state and fresh row. -/
theorem state_succ
    (X : Set (EuclideanSpace ℝ (Fin n))) (K : ℕ)
    (k : Fin K) (omega : CanonicalSampleSpace Ξ) :
    state (h := h) (oracle := oracle) (params := params)
        (Q := Q) (B := B) (b := b) X K k.succ omega =
      transition h oracle params Q B b X k.1
        (state (h := h) (oracle := oracle) (params := params)
          (Q := Q) (B := B) (b := b) X K k.castSucc omega,
          fun i ↦ CanonicalRun.sample k.1 i omega) := by
  have hhistory :
      (fun t : Fin k.1 ↦
        fun i ↦ sampleHistory (k.1 + 1) omega t.castSucc i) =
        sampleHistory k.1 omega := by
    funext t i
    rfl
  have hbatch : sampleHistory (k.1 + 1) omega (Fin.last k.1) =
      sampleBatch k.1 omega := by
    funext i
    rfl
  change LALM.FiniteStopped.state h oracle params Q B b X (k.1 + 1)
      (sampleHistory (k.1 + 1) omega) =
    transition h oracle params Q B b X k.1
      (LALM.FiniteStopped.state h oracle params Q B b X k.1
        (sampleHistory k.1 omega), sampleBatch k.1 omega)
  rw [LALM.FiniteStopped.state_succ, hhistory, hbatch]

/-- Theorem 3.7: the canonical product probability space supports a finite
absorbing stopped base attempt under only the local region condition. -/
noncomputable def attempt
    (X : Set (EuclideanSpace ℝ (Fin n))) (hX : MeasurableSet X)
    (initial_mem : x₀ ∈ X)
    (h_region : RegionCondition h oracle params confidence X) (K : ℕ) :
    StoppedAttempt h oracle (canonicalProductMeasure ν)
      x₀ multiplier₀ params Q B b confidence K X :=
  {
    measurableSet_localization := hX
    initial_mem := initial_mem
    region_condition := h_region
    sample := CanonicalRun.sample
    measurable_sample := CanonicalRun.measurable_sample
    hasLaw_sample := CanonicalRun.sample_hasLaw
    independent_sample := CanonicalRun.sample_iIndepFun
    state := state (h := h) (oracle := oracle) (params := params)
      (Q := Q) (B := B) (b := b) X K
    measurable_state := measurable_state X hX K
    independent_state_sample := independent_state_sample X hX K
    state_zero := state_zero X K
    state_succ := state_succ X K
  }

/-- Helper for Theorem 3.7: the canonical stopped attempt uses the
coordinate sample array exposed by `CanonicalRun`. -/
@[simp] theorem attempt_sample
    (X : Set (EuclideanSpace ℝ (Fin n))) (hX : MeasurableSet X)
    (initial_mem : x₀ ∈ X)
    (h_region : RegionCondition h oracle params confidence X) (K : ℕ) :
    (attempt (h := h) (oracle := oracle) (params := params)
      (Q := Q) (B := B) (b := b) X hX initial_mem h_region K).sample =
      CanonicalRun.sample := by
  rfl

/-- Helper for Theorem 3.7: the canonical attempt exposes the finite-history
state recursion defined above. -/
@[simp] theorem attempt_state
    (X : Set (EuclideanSpace ℝ (Fin n))) (hX : MeasurableSet X)
    (initial_mem : x₀ ∈ X)
    (h_region : RegionCondition h oracle params confidence X) (K : ℕ) :
    (attempt (h := h) (oracle := oracle) (params := params)
      (Q := Q) (B := B) (b := b) X hX initial_mem h_region K).state =
      state (h := h) (oracle := oracle) (params := params)
        (Q := Q) (B := B) (b := b) X K := by
  rfl

/-- Theorem 3.7: the canonical scheduled finite stopped attempt is
nonempty without a global `ContDiff c` assumption. -/
theorem nonempty
    (X : Set (EuclideanSpace ℝ (Fin n))) (hX : MeasurableSet X)
    (initial_mem : x₀ ∈ X)
    (h_region : RegionCondition h oracle params confidence X) (K : ℕ) :
    Nonempty (StoppedAttempt h oracle (canonicalProductMeasure ν)
      x₀ multiplier₀ params Q B b confidence K X) := by
  exact ⟨attempt X hX initial_mem h_region K⟩

end CanonicalStoppedAttempt

end LALM.FiniteStopped

namespace LALM

universe u

variable {n m : ℕ}
variable {Ξ : Type u} [MeasurableSpace Ξ] {ν : Measure Ξ} [IsProbabilityMeasure ν]
variable {f : EuclideanSpace ℝ (Fin n) → ℝ}
variable {c : EuclideanSpace ℝ (Fin n) → EuclideanSpace ℝ (Fin m)}
variable {x₀ : EuclideanSpace ℝ (Fin n)}
variable {multiplier₀ : EuclideanSpace ℝ (Fin m)}
variable {h : EqualityConstrained.Regularity f c}
variable {oracle : EqualityConstrained.StochasticOracle f h.region ν}
variable {params : LALM.Parameters h x₀ multiplier₀}

/-- Theorem 3.7: the theorem's prescribed schedule has a canonical finite
stopped attempt on the iid product space, without global smoothness. -/
theorem canonicalStoppedScheduledAttempt_nonempty
    (confidence : ℝ) (K : ℕ) (X : Set (EuclideanSpace ℝ (Fin n)))
    (hX : MeasurableSet X) (initial_mem : x₀ ∈ X)
    (h_region : StochasticRun.Localization.RegionCondition
      h oracle params confidence X) :
    Nonempty (SPIDER.StoppedScheduledAttempt h oracle
      (canonicalProductMeasure ν) x₀ multiplier₀ params confidence K X) := by
  exact LALM.FiniteStopped.CanonicalStoppedAttempt.nonempty
    X hX initial_mem h_region K

end LALM

end
