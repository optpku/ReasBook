module

public import TR_LALM_theory.Corollary_4_2.StoppedScheduledAttempt

public section

open MeasureTheory
open scoped NNReal

namespace LALM.Correction

open StochasticRun.Localization

universe u

variable {n m : ℕ}
variable {Ξ : Type u} [MeasurableSpace Ξ] {ν : Measure Ξ} [IsProbabilityMeasure ν]
variable {f : EuclideanSpace ℝ (Fin n) → ℝ}
variable {c : EuclideanSpace ℝ (Fin n) → EuclideanSpace ℝ (Fin m)}
variable {x₀ : EuclideanSpace ℝ (Fin n)}
variable {multiplier₀ : EuclideanSpace ℝ (Fin m)}
variable {h : EqualityConstrained.Regularity f c}
variable {oracle : EqualityConstrained.StochasticOracle f h.region ν}
variable {params : Parameters h x₀ multiplier₀}
variable {Q B b : ℕ+} {confidence : ℝ}

namespace CanonicalStoppedAttempt

/-- Helper for Corollary 4.2: the finite history before time `k` consists of
the canonical product coordinates in rows strictly below `k`. -/
def sampleHistory (k : ℕ) (omega : CanonicalSampleSpace Ξ) : Fin k → ℕ → Ξ :=
  fun t i ↦ CanonicalRun.sample t i omega

/-- Helper for Corollary 4.2: the fresh batch at time `k` is the corresponding
row of the canonical product sample array. -/
def sampleBatch (k : ℕ) (omega : CanonicalSampleSpace Ξ) : ℕ → Ξ :=
  fun i ↦ CanonicalRun.sample k i omega

/-- Helper for Corollary 4.2: the canonical finite sample history is
measurable. -/
theorem measurable_sampleHistory (k : ℕ) :
    Measurable (sampleHistory (Ξ := Ξ) k) := by
  apply measurable_pi_lambda
  intro t
  apply measurable_pi_lambda
  intro i
  exact CanonicalRun.measurable_sample t i

/-- Helper for Corollary 4.2: the canonical fresh batch is measurable. -/
theorem measurable_sampleBatch (k : ℕ) :
    Measurable (sampleBatch (Ξ := Ξ) k) := by
  apply measurable_pi_lambda
  intro i
  exact CanonicalRun.measurable_sample k i

/-- Helper for Corollary 4.2: the sigma-algebra generated by one canonical
sample coordinate. -/
abbrev sampleCoordinateSigma (ki : ℕ × ℕ) :
    MeasurableSpace (CanonicalSampleSpace Ξ) :=
  MeasurableSpace.comap
    (CanonicalRun.sample (Ξ := Ξ) ki.1 ki.2) inferInstance

/-- Helper for Corollary 4.2: every canonical coordinate sigma-algebra lies
below the product sigma-algebra. -/
theorem sampleCoordinateSigma_le (ki : ℕ × ℕ) :
    sampleCoordinateSigma (Ξ := Ξ) ki ≤
      (inferInstance : MeasurableSpace (CanonicalSampleSpace Ξ)) := by
  unfold sampleCoordinateSigma
  exact (CanonicalRun.measurable_sample (Ξ := Ξ) ki.1 ki.2).comap_le

/-- Helper for Corollary 4.2: the canonical coordinate sigma-algebras are
mutually independent. -/
theorem iIndep_sampleCoordinateSigma :
    ProbabilityTheory.iIndep
      (fun ki : ℕ × ℕ ↦ sampleCoordinateSigma (Ξ := Ξ) ki)
      (canonicalProductMeasure ν) := by
  simpa only [sampleCoordinateSigma] using
    (CanonicalRun.sample_iIndepFun (Ξ := Ξ) (ν := ν)).iIndep

/-- Helper for Corollary 4.2: the past-coordinate set contains exactly the
sample rows strictly before `k`. -/
def pastSampleIndexSet (k : ℕ) : Set (ℕ × ℕ) :=
  {ki | ki.1 < k}

/-- Helper for Corollary 4.2: the current-coordinate set is exactly row `k`. -/
def currentSampleIndexSet (k : ℕ) : Set (ℕ × ℕ) :=
  {ki | ki.1 = k}

/-- Helper for Corollary 4.2: past and current canonical sample coordinates
are disjoint. -/
theorem pastSampleIndexSet_disjoint_currentSampleIndexSet (k : ℕ) :
    Disjoint (pastSampleIndexSet k) (currentSampleIndexSet k) := by
  rw [Set.disjoint_left]
  rintro ⟨t, i⟩ htPast htCurrent
  simp only [pastSampleIndexSet, Set.mem_setOf_eq] at htPast
  simp only [currentSampleIndexSet, Set.mem_setOf_eq] at htCurrent
  omega

/-- Helper for Corollary 4.2: the past sigma-algebra is generated by sample
coordinates in rows below `k`. -/
abbrev pastSampleSigma (k : ℕ) :
    MeasurableSpace (CanonicalSampleSpace Ξ) :=
  ⨆ ki ∈ pastSampleIndexSet k, sampleCoordinateSigma (Ξ := Ξ) ki

/-- Helper for Corollary 4.2: the current sigma-algebra is generated by row
`k` of the canonical sample array. -/
abbrev currentSampleSigma (k : ℕ) :
    MeasurableSpace (CanonicalSampleSpace Ξ) :=
  ⨆ ki ∈ currentSampleIndexSet k, sampleCoordinateSigma (Ξ := Ξ) ki

/-- Helper for Corollary 4.2: the finite history is measurable with respect to
the past-coordinate sigma-algebra. -/
theorem measurable_sampleHistory_past (k : ℕ) :
    Measurable[pastSampleSigma (Ξ := Ξ) k]
      (sampleHistory (Ξ := Ξ) k) := by
  apply Measurable.of_comap_le
  rw [MeasurableSpace.comap_process_pi]
  apply iSup_le
  intro t
  rw [MeasurableSpace.comap_process_pi]
  apply iSup_le
  intro i
  have hmem : ((t : ℕ), i) ∈ pastSampleIndexSet k := by
    simp only [pastSampleIndexSet, Set.mem_setOf_eq]
    exact t.isLt
  unfold sampleHistory pastSampleSigma sampleCoordinateSigma
  exact le_iSup_of_le ((t : ℕ), i) (le_iSup_of_le hmem le_rfl)

/-- Helper for Corollary 4.2: the fresh row is measurable with respect to the
current-coordinate sigma-algebra. -/
theorem measurable_sampleBatch_current (k : ℕ) :
    Measurable[currentSampleSigma (Ξ := Ξ) k]
      (sampleBatch (Ξ := Ξ) k) := by
  apply Measurable.of_comap_le
  rw [MeasurableSpace.comap_process_pi]
  apply iSup_le
  intro i
  have hmem : (k, i) ∈ currentSampleIndexSet k := by
    simp only [currentSampleIndexSet, Set.mem_setOf_eq]
  unfold sampleBatch currentSampleSigma sampleCoordinateSigma
  exact le_iSup_of_le (k, i) (le_iSup_of_le hmem le_rfl)

/-- Helper for Corollary 4.2: the canonical finite past is independent of its
fresh sample row. -/
theorem indepFun_sampleHistory_sampleBatch (k : ℕ) :
    ProbabilityTheory.IndepFun (sampleHistory (Ξ := Ξ) k)
      (sampleBatch (Ξ := Ξ) k) (canonicalProductMeasure ν) := by
  have hgrouped : ProbabilityTheory.Indep
      (pastSampleSigma (Ξ := Ξ) k) (currentSampleSigma (Ξ := Ξ) k)
      (canonicalProductMeasure ν) := by
    unfold pastSampleSigma currentSampleSigma
    exact ProbabilityTheory.indep_iSup_of_disjoint
      (sampleCoordinateSigma_le (Ξ := Ξ))
      (iIndep_sampleCoordinateSigma (Ξ := Ξ) (ν := ν))
      (pastSampleIndexSet_disjoint_currentSampleIndexSet k)
  unfold ProbabilityTheory.IndepFun
  exact ProbabilityTheory.indep_of_indep_of_le hgrouped
    (measurable_sampleHistory_past (Ξ := Ξ) k).comap_le
    (measurable_sampleBatch_current (Ξ := Ξ) k).comap_le

/-- Helper for Corollary 4.2: the canonical stopped state applies the finite
localized recursion to the product sample history. -/
noncomputable def state
    (X : Set (EuclideanSpace ℝ (Fin n))) (initial_mem : x₀ ∈ X)
    (h_region : RegionCondition h oracle params confidence X) (K : ℕ)
    (k : Fin (K + 1)) (omega : CanonicalSampleSpace Ξ) :
    LocalizedPreBatchState h params X :=
  canonicalLocalizedPreBatchState h oracle params Q B b X initial_mem h_region
    k.1 (sampleHistory k.1 omega)

/-- Helper for Corollary 4.2: every finite canonical stopped state is
measurable. -/
theorem measurable_state
    (X : Set (EuclideanSpace ℝ (Fin n))) (hX : MeasurableSet X)
    (initial_mem : x₀ ∈ X)
    (h_region : RegionCondition h oracle params confidence X) (K : ℕ)
    (k : Fin (K + 1)) :
    Measurable (state (Q := Q) (B := B) (b := b) X initial_mem h_region K k) := by
  exact (measurable_canonicalLocalizedPreBatchState X hX initial_mem h_region k.1).comp
    (measurable_sampleHistory k.1)

/-- Helper for Corollary 4.2: the canonical stopped state before iteration
`k` is independent of the fresh sample row at `k`. -/
theorem independent_state_sample
    (X : Set (EuclideanSpace ℝ (Fin n))) (hX : MeasurableSet X)
    (initial_mem : x₀ ∈ X)
    (h_region : RegionCondition h oracle params confidence X) (K : ℕ)
    (k : Fin K) :
    ProbabilityTheory.IndepFun
      (state (Q := Q) (B := B) (b := b) X initial_mem h_region K k.castSucc)
      (fun omega i ↦ CanonicalRun.sample k.1 i omega)
      (canonicalProductMeasure ν) := by
  have hindependent : ProbabilityTheory.IndepFun
      (canonicalLocalizedPreBatchState h oracle params Q B b X initial_mem h_region
          k.1 ∘ sampleHistory k.1)
      (id ∘ sampleBatch k.1) (canonicalProductMeasure ν) :=
    (indepFun_sampleHistory_sampleBatch (Ξ := Ξ) (ν := ν) k.1).comp
      (measurable_canonicalLocalizedPreBatchState X hX initial_mem h_region k.1)
      measurable_id
  change ProbabilityTheory.IndepFun
    (canonicalLocalizedPreBatchState h oracle params Q B b X initial_mem h_region
      k.1 ∘ sampleHistory k.1)
    (fun omega i ↦ CanonicalRun.sample k.1 i omega)
    (canonicalProductMeasure ν)
  have hbatchEq : (id ∘ sampleBatch (Ξ := Ξ) k.1) =
      (fun omega i ↦ CanonicalRun.sample k.1 i omega) := by
    funext omega i
    rfl
  rw [hbatchEq] at hindependent
  exact hindependent

/-- Helper for Corollary 4.2: the canonical stopped state starts from the
active initialized package. -/
theorem state_zero
    (X : Set (EuclideanSpace ℝ (Fin n))) (initial_mem : x₀ ∈ X)
    (h_region : RegionCondition h oracle params confidence X) (K : ℕ)
    (omega : CanonicalSampleSpace Ξ) :
    state (Q := Q) (B := B) (b := b) X initial_mem h_region K
        ⟨0, Nat.zero_lt_succ K⟩ omega =
      Sum.inr (initialActivePreBatchState initial_mem h_region) := by
  unfold state
  exact canonicalLocalizedPreBatchState_zero X initial_mem h_region _

/-- Helper for Corollary 4.2: every canonical stopped successor is the
absorbing localized transition from the preceding finite state. -/
theorem state_succ
    (X : Set (EuclideanSpace ℝ (Fin n))) (initial_mem : x₀ ∈ X)
    (h_region : RegionCondition h oracle params confidence X) (K : ℕ)
    (k : Fin K) (omega : CanonicalSampleSpace Ξ) :
    state (Q := Q) (B := B) (b := b) X initial_mem h_region K k.succ omega =
      canonicalLocalizedTransition h oracle params Q B b X h_region k.1
        (state (Q := Q) (B := B) (b := b) X initial_mem h_region K
          k.castSucc omega, fun i ↦ CanonicalRun.sample k.1 i omega) := by
  have hhistory :
      (fun t : Fin k.1 ↦ fun i ↦ sampleHistory (k.1 + 1) omega t.castSucc i) =
        sampleHistory k.1 omega := by
    funext t i
    rfl
  have hbatch : sampleHistory (k.1 + 1) omega (Fin.last k.1) =
      sampleBatch k.1 omega := by
    funext i
    rfl
  change canonicalLocalizedPreBatchState h oracle params Q B b X initial_mem h_region
      (k.1 + 1) (sampleHistory (k.1 + 1) omega) =
    canonicalLocalizedTransition h oracle params Q B b X h_region k.1
      (canonicalLocalizedPreBatchState h oracle params Q B b X initial_mem h_region
        k.1 (sampleHistory k.1 omega), sampleBatch k.1 omega)
  rw [canonicalLocalizedPreBatchState_succ, hhistory, hbatch]

/-- Corollary 4.2: the explicit finite absorbing stopped attempt on the
canonical product probability space. -/
noncomputable def attempt
    (X : Set (EuclideanSpace ℝ (Fin n))) (hX : MeasurableSet X)
    (initial_mem : x₀ ∈ X)
    (h_region : RegionCondition h oracle params confidence X) (K : ℕ) :
    StoppedAttempt h oracle (canonicalProductMeasure ν)
      x₀ multiplier₀ params Q B b confidence K X :=
  {
    measurableSet_localization := hX
    initial_mem := initial_mem
    region_condition := h_region
    sample := CanonicalRun.sample
    measurable_sample := CanonicalRun.measurable_sample
    hasLaw_sample := CanonicalRun.sample_hasLaw
    independent_sample := CanonicalRun.sample_iIndepFun
    state := state (Q := Q) (B := B) (b := b) X initial_mem h_region K
    measurable_state := measurable_state X hX initial_mem h_region K
    independent_state_sample := independent_state_sample X hX initial_mem h_region K
    state_zero := state_zero X initial_mem h_region K
    state_succ := state_succ X initial_mem h_region K
  }

/-- Helper for Corollary 4.2: the explicit canonical stopped attempt reads the
canonical product coordinate array. -/
@[simp] theorem attempt_sample
    (X : Set (EuclideanSpace ℝ (Fin n))) (hX : MeasurableSet X)
    (initial_mem : x₀ ∈ X)
    (h_region : RegionCondition h oracle params confidence X) (K : ℕ) :
    (attempt (Q := Q) (B := B) (b := b) X hX initial_mem h_region K).sample =
      CanonicalRun.sample := by
  rfl

/-- Helper for Corollary 4.2: the state field of the explicit canonical stopped
attempt is the finite localized history recursion. -/
@[simp] theorem attempt_state
    (X : Set (EuclideanSpace ℝ (Fin n))) (hX : MeasurableSet X)
    (initial_mem : x₀ ∈ X)
    (h_region : RegionCondition h oracle params confidence X) (K : ℕ) :
    (attempt (Q := Q) (B := B) (b := b) X hX initial_mem h_region K).state =
      state (Q := Q) (B := B) (b := b) X initial_mem h_region K := by
  rfl

/-- Helper for Corollary 4.2: the canonical stopped state's opaque projection
is exactly the finite localized-history recursion on the preceding samples. -/
theorem state_eq_canonicalLocalizedPreBatchState
    (X : Set (EuclideanSpace ℝ (Fin n))) (initial_mem : x₀ ∈ X)
    (h_region : RegionCondition h oracle params confidence X) (K : ℕ)
    (k : Fin (K + 1)) (omega : CanonicalSampleSpace Ξ) :
    state (Q := Q) (B := B) (b := b) X initial_mem h_region K k omega =
      canonicalLocalizedPreBatchState h oracle params Q B b X initial_mem
        h_region k.1 (fun t i ↦ CanonicalRun.sample t.1 i omega) := by
  rfl

/-- Corollary 4.2: the canonical product probability space supports a finite
absorbing stopped attempt under only the local region condition. -/
theorem nonempty
    (X : Set (EuclideanSpace ℝ (Fin n))) (hX : MeasurableSet X)
    (initial_mem : x₀ ∈ X)
    (h_region : RegionCondition h oracle params confidence X) (K : ℕ) :
    Nonempty (StoppedAttempt h oracle (canonicalProductMeasure ν)
      x₀ multiplier₀ params Q B b confidence K X) := by
  exact ⟨attempt X hX initial_mem h_region K⟩

end CanonicalStoppedAttempt

end LALM.Correction

namespace SPIDER.Correction

universe u v

variable {n m : ℕ}
variable {Ξ : Type u} [MeasurableSpace Ξ] {ν : Measure Ξ} [IsProbabilityMeasure ν]
variable {Ω : Type v} [MeasurableSpace Ω]
variable {f : EuclideanSpace ℝ (Fin n) → ℝ}
variable {c : EuclideanSpace ℝ (Fin n) → EuclideanSpace ℝ (Fin m)}
variable {x₀ : EuclideanSpace ℝ (Fin n)}
variable {multiplier₀ : EuclideanSpace ℝ (Fin m)}

/-- Corollary 4.2: a stopped attempt with the prescribed horizon-dependent
SPIDER refresh period and batch sizes. -/
abbrev StoppedScheduledAttempt
    (h : EqualityConstrained.Regularity f c)
    (oracle : EqualityConstrained.StochasticOracle f h.region ν)
    (P : Measure Ω) [IsProbabilityMeasure P]
    (x₀ : EuclideanSpace ℝ (Fin n))
    (multiplier₀ : EuclideanSpace ℝ (Fin m))
    (params : LALM.Correction.Parameters h x₀ multiplier₀)
    (confidence : ℝ) (K : ℕ) (X : Set (EuclideanSpace ℝ (Fin n))) :=
  LALM.Correction.StoppedAttempt h oracle P x₀ multiplier₀ params
    (SPIDER.refreshPeriod K) (SPIDER.refreshBatchSize K)
    (innerBatchSize h oracle params K) confidence K X

end SPIDER.Correction

namespace LALM.Correction

open StochasticRun.Localization

universe u

variable {n m : ℕ}
variable {Ξ : Type u} [MeasurableSpace Ξ] {ν : Measure Ξ} [IsProbabilityMeasure ν]
variable {f : EuclideanSpace ℝ (Fin n) → ℝ}
variable {c : EuclideanSpace ℝ (Fin n) → EuclideanSpace ℝ (Fin m)}
variable {x₀ : EuclideanSpace ℝ (Fin n)}
variable {multiplier₀ : EuclideanSpace ℝ (Fin m)}
variable {h : EqualityConstrained.Regularity f c}
variable {oracle : EqualityConstrained.StochasticOracle f h.region ν}
variable {params : Parameters h x₀ multiplier₀}

/-- Corollary 4.2: the prescribed SPIDER schedule has a canonical finite
absorbing stopped attempt without a global smoothness assumption. -/
theorem canonicalStoppedScheduledAttempt_nonempty
    (confidence : ℝ) (K : ℕ) (X : Set (EuclideanSpace ℝ (Fin n)))
    (hX : MeasurableSet X) (initial_mem : x₀ ∈ X)
    (h_region : RegionCondition h oracle params confidence X) :
    Nonempty (SPIDER.Correction.StoppedScheduledAttempt h oracle
      (canonicalProductMeasure ν) x₀ multiplier₀ params confidence K X) := by
  exact CanonicalStoppedAttempt.nonempty X hX initial_mem h_region K

end LALM.Correction

end
