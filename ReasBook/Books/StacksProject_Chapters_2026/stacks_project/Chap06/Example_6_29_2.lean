    (tailPushforwardIntegerSheafModelStalkS2IsoToBasicSections i).hom ≫
      (tailPushforwardIntegerSheafModelMap h.down.down).hom.app (op twoClosedPointsS2BasicOpens) := by
  -- The same germ-cancellation argument identifies the `s2` stalk map with restriction to the
  -- minimal `s2` neighborhood.
  apply (cancel_epi (tailPushforwardIntegerSheafModelStalkS2IsoToBasicSections i).inv).1
  have htransport :
      (tailPushforwardIntegerSheafModelStalkS2IsoToBasicSections i).inv ≫
          ((TopCat.Sheaf.forget AddCommGrpCat twoClosedPointsSpace ⋙
                TopCat.Presheaf.stalkFunctor AddCommGrpCat twoClosedPointsS2Point).map
              (tailPushforwardIntegerSheafModelMap h.down.down)) ≫
            (tailPushforwardIntegerSheafModelStalkS2IsoToBasicSections j).hom =
        (tailPushforwardIntegerSheafModelMap h.down.down).hom.app
          (op twoClosedPointsS2BasicOpens) := by
    have hmap_germ :
        (tailPushforwardIntegerSheafModelStalkS2IsoToBasicSections i).inv ≫
            ((TopCat.Sheaf.forget AddCommGrpCat twoClosedPointsSpace ⋙
                  TopCat.Presheaf.stalkFunctor AddCommGrpCat twoClosedPointsS2Point).map
                (tailPushforwardIntegerSheafModelMap h.down.down)) ≫
              (tailPushforwardIntegerSheafModelStalkS2IsoToBasicSections j).hom =
          ((tailPushforwardIntegerSheafModelMap h.down.down).hom.app
              (op twoClosedPointsS2BasicOpens) ≫
            (tailPushforwardIntegerSheafModelStalkS2IsoToBasicSections j).inv) ≫
              (tailPushforwardIntegerSheafModelStalkS2IsoToBasicSections j).hom := by
      -- The `s2` branch is the same germ/stalk compatibility calculation.
      simpa [tailPushforwardIntegerSheafModelStalkS2IsoToBasicSections, Category.assoc] using
        congrArg
          (fun k ↦ k ≫ (tailPushforwardIntegerSheafModelStalkS2IsoToBasicSections j).hom)
          (TopCat.Presheaf.stalkFunctor_map_germ
            (C := AddCommGrpCat) (U := twoClosedPointsS2BasicOpens)
            (x := twoClosedPointsS2Point) (hx := twoClosedPointsS2Point_mem_s2_basic)
            (tailPushforwardIntegerSheafModelMap h.down.down).hom)
    have hpost :
        ((tailPushforwardIntegerSheafModelMap h.down.down).hom.app
            (op twoClosedPointsS2BasicOpens) ≫
          (tailPushforwardIntegerSheafModelStalkS2IsoToBasicSections j).inv) ≫
            (tailPushforwardIntegerSheafModelStalkS2IsoToBasicSections j).hom =
          (tailPushforwardIntegerSheafModelMap h.down.down).hom.app
            (op twoClosedPointsS2BasicOpens) := by
      simpa only [Category.assoc] using
        congrArg
          (fun k ↦
            (tailPushforwardIntegerSheafModelMap h.down.down).hom.app
              (op twoClosedPointsS2BasicOpens) ≫ k)
          (Iso.inv_hom_id (tailPushforwardIntegerSheafModelStalkS2IsoToBasicSections j))
    exact hmap_germ.trans hpost
  have hcancel :
      (tailPushforwardIntegerSheafModelMap h.down.down).hom.app (op twoClosedPointsS2BasicOpens) =
        (tailPushforwardIntegerSheafModelStalkS2IsoToBasicSections i).inv ≫
          (tailPushforwardIntegerSheafModelStalkS2IsoToBasicSections i).hom ≫
            (tailPushforwardIntegerSheafModelMap h.down.down).hom.app
              (op twoClosedPointsS2BasicOpens) := by
    symm
    simpa only [Category.assoc] using
      congrArg
        (fun k ↦
          k ≫ (tailPushforwardIntegerSheafModelMap h.down.down).hom.app
            (op twoClosedPointsS2BasicOpens))
        (Iso.inv_hom_id (tailPushforwardIntegerSheafModelStalkS2IsoToBasicSections i))
  exact htransport.trans hcancel

/-- Helper for Example 6.29.2: the `s1`-stalk of `j_{n,*}\underline{Z}` is canonically the tail
product `∏_{m ≥ n} ℤ`. -/
private noncomputable def tailPushforwardIntegerSheafStalkS1StageIso (n : ℕ) :
    (tailPushforwardIntegerSheafStalkS1Functor.obj n) ≅ tailIntegerProduct n :=
  ((TopCat.Sheaf.forget AddCommGrpCat twoClosedPointsSpace ⋙
      TopCat.Presheaf.stalkFunctor AddCommGrpCat twoClosedPointsS1Point).mapIso
        (tailPushforwardIntegerSheafModelIso n)) ≪≫
    tailPushforwardIntegerSheafModelStalkS1IsoToBasicSections n ≪≫
    tailSectionValueS1BasicIso n

/-- Helper for Example 6.29.2: the `s2`-stalk of `j_{n,*}\underline{Z}` is canonically the tail
product `∏_{m ≥ n} ℤ`. -/
private noncomputable def tailPushforwardIntegerSheafStalkS2StageIso (n : ℕ) :
    (tailPushforwardIntegerSheafStalkS2Functor.obj n) ≅ tailIntegerProduct n :=
  ((TopCat.Sheaf.forget AddCommGrpCat twoClosedPointsSpace ⋙
      TopCat.Presheaf.stalkFunctor AddCommGrpCat twoClosedPointsS2Point).mapIso
        (tailPushforwardIntegerSheafModelIso n)) ≪≫
    tailPushforwardIntegerSheafModelStalkS2IsoToBasicSections n ≪≫
    tailSectionValueS2BasicIso n

/-- Helper for Example 6.29.2: the stalked comparison
`j_{n,*}\underline{Z} ≅` explicit tail-function model is natural at the closed point `s1`. -/
private theorem tailPushforwardIntegerSheafStalkS1ModelIso_naturality {i j : ℕ}
    (h : i ⟶ j) :
    tailPushforwardIntegerSheafStalkS1Functor.map h ≫
      ((TopCat.Sheaf.forget AddCommGrpCat twoClosedPointsSpace ⋙
            TopCat.Presheaf.stalkFunctor AddCommGrpCat twoClosedPointsS1Point).mapIso
          (tailPushforwardIntegerSheafModelIso j)).hom =
    ((TopCat.Sheaf.forget AddCommGrpCat twoClosedPointsSpace ⋙
          TopCat.Presheaf.stalkFunctor AddCommGrpCat twoClosedPointsS1Point).mapIso
        (tailPushforwardIntegerSheafModelIso i)).hom ≫
      ((TopCat.Sheaf.forget AddCommGrpCat twoClosedPointsSpace ⋙
            TopCat.Presheaf.stalkFunctor AddCommGrpCat twoClosedPointsS1Point).map
          (tailPushforwardIntegerSheafModelMap h.down.down)) := by
  -- Transport the stage map through `tailPushforwardIntegerSheafToModel`; after applying the
  -- stalk functor, this becomes exactly the desired `mapIso` naturality square.
  have htransport :
      tailPushforwardIntegerSheafFunctor.map h ≫ tailPushforwardIntegerSheafToModel j =
        tailPushforwardIntegerSheafToModel i ≫ tailPushforwardIntegerSheafModelMap h.down.down := by
    simp [tailPushforwardIntegerSheafFunctor, tailPushforwardIntegerSheafMap, Category.assoc]
  simpa [tailPushforwardIntegerSheafStalkS1Functor, tailPushforwardIntegerSheafFunctor,
    Category.assoc] using
    congrArg
      ((TopCat.Sheaf.forget AddCommGrpCat twoClosedPointsSpace ⋙
          TopCat.Presheaf.stalkFunctor AddCommGrpCat twoClosedPointsS1Point).map)
      htransport

/-- Helper for Example 6.29.2: the stalked comparison
`j_{n,*}\underline{Z} ≅` explicit tail-function model is natural at the closed point `s2`. -/
private theorem tailPushforwardIntegerSheafStalkS2ModelIso_naturality {i j : ℕ}
