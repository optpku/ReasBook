-- Proof sketch: compute the stalks of `j_{n,*}\underline{Z}` at the points `xi_m`, `s1`, and `s2`,
-- identify the colimit stalkwise, and then use the skyscraper-sheaf description from Section 6.27
-- to recognize the resulting sheaf as the direct sum of the two skyscraper sheaves with value `M`.
private theorem tailPushforwardColimitComparison_isIso :
    IsIso tailPushforwardColimitComparison := by
  -- Stalkwise, the generic points are zero and the closed points are identified with the same
  -- filtered colimit `M`.
  refine (TopCat.Presheaf.isIso_iff_stalkFunctor_map_iso tailPushforwardColimitComparison).2 ?_
  intro x
  rcases x with _ | _ | m
  · change IsIso
        ((TopCat.Presheaf.stalkFunctor AddCommGrpCat twoClosedPointsS1Point).map
          tailPushforwardColimitComparison.hom)
    have hcomp :
        (preservesColimitIso
            (TopCat.Sheaf.forget AddCommGrpCat twoClosedPointsSpace ⋙
              TopCat.Presheaf.stalkFunctor AddCommGrpCat twoClosedPointsS1Point)
            tailPushforwardIntegerSheafFunctor).inv ≫
          ((TopCat.Presheaf.stalkFunctor AddCommGrpCat twoClosedPointsS1Point).map
            tailPushforwardColimitComparison.hom) ≫
          twoClosedPointsSkyscraperPairStalkS1IsoToColimit.hom =
        (HasColimit.isoOfNatIso tailPushforwardIntegerSheafStalkS1NatIsoToTailIntegerProduct).hom :=
      tailPushforwardColimitComparison_stalk_s1_eq_isoOfNatIso_hom
    have hcompIso :
        IsIso
          (((preservesColimitIso
                  (TopCat.Sheaf.forget AddCommGrpCat twoClosedPointsSpace ⋙
                    TopCat.Presheaf.stalkFunctor AddCommGrpCat twoClosedPointsS1Point)
                  tailPushforwardIntegerSheafFunctor).inv ≫
                ((TopCat.Presheaf.stalkFunctor AddCommGrpCat twoClosedPointsS1Point).map
                  tailPushforwardColimitComparison.hom)) ≫
              twoClosedPointsSkyscraperPairStalkS1IsoToColimit.hom) := by
      exact hcomp ▸
        (by
          infer_instance :
            IsIso (HasColimit.isoOfNatIso
              tailPushforwardIntegerSheafStalkS1NatIsoToTailIntegerProduct).hom)
    letI := hcompIso
    haveI :
        IsIso
          ((preservesColimitIso
                  (TopCat.Sheaf.forget AddCommGrpCat twoClosedPointsSpace ⋙
                    TopCat.Presheaf.stalkFunctor AddCommGrpCat twoClosedPointsS1Point)
                  tailPushforwardIntegerSheafFunctor).inv ≫
                ((TopCat.Presheaf.stalkFunctor AddCommGrpCat twoClosedPointsS1Point).map
                  tailPushforwardColimitComparison.hom)) :=
      IsIso.of_isIso_comp_right
        ((preservesColimitIso
              (TopCat.Sheaf.forget AddCommGrpCat twoClosedPointsSpace ⋙
                TopCat.Presheaf.stalkFunctor AddCommGrpCat twoClosedPointsS1Point)
              tailPushforwardIntegerSheafFunctor).inv ≫
            ((TopCat.Presheaf.stalkFunctor AddCommGrpCat twoClosedPointsS1Point).map
              tailPushforwardColimitComparison.hom))
        twoClosedPointsSkyscraperPairStalkS1IsoToColimit.hom
    exact
      IsIso.of_isIso_comp_left
        ((preservesColimitIso
            (TopCat.Sheaf.forget AddCommGrpCat twoClosedPointsSpace ⋙
              TopCat.Presheaf.stalkFunctor AddCommGrpCat twoClosedPointsS1Point)
            tailPushforwardIntegerSheafFunctor).inv)
        ((TopCat.Presheaf.stalkFunctor AddCommGrpCat twoClosedPointsS1Point).map
          tailPushforwardColimitComparison.hom)
  · change IsIso
        ((TopCat.Presheaf.stalkFunctor AddCommGrpCat twoClosedPointsS2Point).map
          tailPushforwardColimitComparison.hom)
    have hcomp :
        (preservesColimitIso
            (TopCat.Sheaf.forget AddCommGrpCat twoClosedPointsSpace ⋙
              TopCat.Presheaf.stalkFunctor AddCommGrpCat twoClosedPointsS2Point)
            tailPushforwardIntegerSheafFunctor).inv ≫
          ((TopCat.Presheaf.stalkFunctor AddCommGrpCat twoClosedPointsS2Point).map
            tailPushforwardColimitComparison.hom) ≫
          twoClosedPointsSkyscraperPairStalkS2IsoToColimit.hom =
        (HasColimit.isoOfNatIso tailPushforwardIntegerSheafStalkS2NatIsoToTailIntegerProduct).hom :=
      tailPushforwardColimitComparison_stalk_s2_eq_isoOfNatIso_hom
    have hcompIso :
        IsIso
          (((preservesColimitIso
                  (TopCat.Sheaf.forget AddCommGrpCat twoClosedPointsSpace ⋙
                    TopCat.Presheaf.stalkFunctor AddCommGrpCat twoClosedPointsS2Point)
                  tailPushforwardIntegerSheafFunctor).inv ≫
                ((TopCat.Presheaf.stalkFunctor AddCommGrpCat twoClosedPointsS2Point).map
                  tailPushforwardColimitComparison.hom)) ≫
              twoClosedPointsSkyscraperPairStalkS2IsoToColimit.hom) := by
      exact hcomp ▸
        (by
          infer_instance :
            IsIso (HasColimit.isoOfNatIso
              tailPushforwardIntegerSheafStalkS2NatIsoToTailIntegerProduct).hom)
    letI := hcompIso
    haveI :
        IsIso
          ((preservesColimitIso
                  (TopCat.Sheaf.forget AddCommGrpCat twoClosedPointsSpace ⋙
                    TopCat.Presheaf.stalkFunctor AddCommGrpCat twoClosedPointsS2Point)
                  tailPushforwardIntegerSheafFunctor).inv ≫
                ((TopCat.Presheaf.stalkFunctor AddCommGrpCat twoClosedPointsS2Point).map
                  tailPushforwardColimitComparison.hom)) :=
      IsIso.of_isIso_comp_right
        ((preservesColimitIso
              (TopCat.Sheaf.forget AddCommGrpCat twoClosedPointsSpace ⋙
                TopCat.Presheaf.stalkFunctor AddCommGrpCat twoClosedPointsS2Point)
              tailPushforwardIntegerSheafFunctor).inv ≫
            ((TopCat.Presheaf.stalkFunctor AddCommGrpCat twoClosedPointsS2Point).map
              tailPushforwardColimitComparison.hom))
        twoClosedPointsSkyscraperPairStalkS2IsoToColimit.hom
    exact
      IsIso.of_isIso_comp_left
        ((preservesColimitIso
            (TopCat.Sheaf.forget AddCommGrpCat twoClosedPointsSpace ⋙
              TopCat.Presheaf.stalkFunctor AddCommGrpCat twoClosedPointsS2Point)
            tailPushforwardIntegerSheafFunctor).inv)
        ((TopCat.Presheaf.stalkFunctor AddCommGrpCat twoClosedPointsS2Point).map
          tailPushforwardColimitComparison.hom)
  · change IsIso
        ((TopCat.Presheaf.stalkFunctor AddCommGrpCat (twoClosedPointsXiPoint m)).map
          tailPushforwardColimitComparison.hom)
    exact tailPushforwardColimitComparison_stalk_xi_isIso m

/-- Example 6.29.2 (1): the canonical comparison identifies
`\mathcal{F} = \operatorname{colim}_n j_{n,*}\underline{Z}` with the direct sum of the two
skyscraper sheaves with value `M`. -/
theorem tailPushforwardIntegerSheaf_exists_colimit_presentation :
    IsIso tailPushforwardColimitComparison :=
  tailPushforwardColimitComparison_isIso

/-- The canonical comparison from the global sections of
`\mathcal{F} = \operatorname{colim}_n j_{n,*}\underline{Z}` to the direct sum of its two
skyscraper values. -/
noncomputable def tailPushforwardColimitGlobalSectionsComparison :
    ((sheafSections JX AddCommGrpCat).obj (op ⊤)).obj tailPushforwardIntegerSheafColimit ⟶
      eventualIntegerSequenceColimit ⊞ eventualIntegerSequenceColimit :=
  ((sheafSections JX AddCommGrpCat).obj (op ⊤)).map tailPushforwardColimitComparison ≫
    twoClosedPointsSkyscraperPairGlobalSectionsComparison

/-- Helper for Example 6.29.2: the explicit model-global-sections map is inverted by reading a
global section on `⊤` as a function on the tail indices `m ≥ n`. -/
public theorem tailPushforwardIntegerSheafModelGlobalSectionsToProduct_isIso (n : ℕ) :
    IsIso (tailPushforwardIntegerSheafModelGlobalSectionsToProduct n) := by
  let inv :
      tailIntegerProduct n ⟶
        ((sheafSections JX AddCommGrpCat).obj (op ⊤)).obj (tailPushforwardIntegerSheafModel n) :=
    AddCommGrpCat.ofHom
      { toFun := fun f x ↦ f ⟨x.1, x.2.1⟩
        map_zero' := by
          ext x
          rfl
        map_add' := by
          intro a b
          ext x
          rfl }
  refine ⟨⟨inv, ?_, ?_⟩⟩
  · -- Sending a product element to a global section and evaluating it again does nothing.
    ext f x
    rfl
  · -- A global section on `⊤` is already determined by the tail indices `m ≥ n`.
    ext f x
    rfl

/-- Helper for Example 6.29.2: at every stage `n`, the global sections of `j_{n,*}\underline{Z}`
identify with the product `∏_{m ≥ n} ℤ`. -/
private theorem tailPushforwardIntegerSheafGlobalSectionsToProduct_stage_isIso (n : ℕ) :
    IsIso (tailPushforwardIntegerSheafGlobalSectionsToProduct n) := by
  -- Factor through the explicit model, where both comparison maps are already isomorphisms.
  change IsIso
    (((sheafSections JX AddCommGrpCat).obj (op ⊤)).map (tailPushforwardIntegerSheafToModel n) ≫
      tailPushforwardIntegerSheafModelGlobalSectionsToProduct n)
  haveI :
      IsIso (((sheafSections JX AddCommGrpCat).obj (op ⊤)).map
        (tailPushforwardIntegerSheafToModel n)) := by
    let e := ((sheafSections JX AddCommGrpCat).obj (op ⊤)).mapIso
      (tailPushforwardIntegerSheafModelIso n)
    exact ⟨⟨e.inv, e.hom_inv_id, e.inv_hom_id⟩⟩
  haveI : IsIso (tailPushforwardIntegerSheafModelGlobalSectionsToProduct n) :=
    tailPushforwardIntegerSheafModelGlobalSectionsToProduct_isIso n
  infer_instance

/-- Helper for Example 6.29.2: evaluating the two skyscraper summands on the top open identifies
their global sections with `M ⊞ M`. -/
public theorem twoClosedPointsSkyscraperPairGlobalSectionsComparison_isIso :
    IsIso twoClosedPointsSkyscraperPairGlobalSectionsComparison := by
  have hs1 :
      s1SkyscraperGlobalSectionsToValue =
        eqToHom
          (if_pos (show twoClosedPointsS1Point ∈ (⊤ : Opens twoClosedPointsSpace) from True.intro)) := by
    -- On the top open, the `s1` skyscraper germ is already the canonical identity transport.
    simpa [s1SkyscraperGlobalSectionsToValue] using
      (germ_skyscraperPresheafStalkOfSpecializes_hom
        (p₀ := twoClosedPointsS1Point) (A := eventualIntegerSequenceColimit)
        specializes_rfl ⊤ True.intro)
  have hs2 :
      s2SkyscraperGlobalSectionsToValue =
        eqToHom
          (if_pos (show twoClosedPointsS2Point ∈ (⊤ : Opens twoClosedPointsSpace) from True.intro)) := by
    -- The same normalization holds for the `s2` skyscraper summand.
    simpa [s2SkyscraperGlobalSectionsToValue] using
      (germ_skyscraperPresheafStalkOfSpecializes_hom
        (p₀ := twoClosedPointsS2Point) (A := eventualIntegerSequenceColimit)
        specializes_rfl ⊤ True.intro)
  let e1 :
      ((sheafSections JX AddCommGrpCat).obj (op ⊤)).obj
          (skyscraperSheaf twoClosedPointsS1Point eventualIntegerSequenceColimit) ≅
        eventualIntegerSequenceColimit :=
    eqToIso
      (if_pos (show twoClosedPointsS1Point ∈ (⊤ : Opens twoClosedPointsSpace) from True.intro))
  let e2 :
      ((sheafSections JX AddCommGrpCat).obj (op ⊤)).obj
          (skyscraperSheaf twoClosedPointsS2Point eventualIntegerSequenceColimit) ≅
        eventualIntegerSequenceColimit :=
    eqToIso
      (if_pos (show twoClosedPointsS2Point ∈ (⊤ : Opens twoClosedPointsSpace) from True.intro))
  have hIso :
      IsIso
        (Functor.biprodComparison
            ((sheafSections JX AddCommGrpCat).obj (op ⊤))
            (skyscraperSheaf twoClosedPointsS1Point eventualIntegerSequenceColimit)
            (skyscraperSheaf twoClosedPointsS2Point eventualIntegerSequenceColimit) ≫
          biprod.map e1.hom e2.hom) := by
    have hB :
        IsIso
          (Functor.biprodComparison
            ((sheafSections JX AddCommGrpCat).obj (op ⊤))
            (skyscraperSheaf twoClosedPointsS1Point eventualIntegerSequenceColimit)
            (skyscraperSheaf twoClosedPointsS2Point eventualIntegerSequenceColimit)) := by
      refine ⟨⟨Functor.biprodComparison'
          ((sheafSections JX AddCommGrpCat).obj (op ⊤))
          (skyscraperSheaf twoClosedPointsS1Point eventualIntegerSequenceColimit)
          (skyscraperSheaf twoClosedPointsS2Point eventualIntegerSequenceColimit), ?_, ?_⟩⟩
      · -- Evaluating the sheaf-level biproduct identity on `⊤` gives the first composite.
        rw [Functor.biprodComparison, Functor.biprodComparison', biprod.lift_desc]
        exact
          congrArg (((sheafSections JX AddCommGrpCat).obj (op ⊤)).map)
            (biprod.total :
              biprod.fst ≫ biprod.inl + biprod.snd ≫ biprod.inr =
                𝟙
                  ((skyscraperSheaf twoClosedPointsS1Point eventualIntegerSequenceColimit) ⊞
                    (skyscraperSheaf twoClosedPointsS2Point eventualIntegerSequenceColimit)))
      · -- The opposite composite is the universal split-id for `Functor.biprodComparison'`.
        simpa using
          (((sheafSections JX AddCommGrpCat).obj (op ⊤)).biprodComparison'_comp_biprodComparison
            (skyscraperSheaf twoClosedPointsS1Point eventualIntegerSequenceColimit)
            (skyscraperSheaf twoClosedPointsS2Point eventualIntegerSequenceColimit))
    have hM : IsIso (biprod.map e1.hom e2.hom) := by
      exact (biprod.mapIso e1 e2).isIso_hom
    letI : IsIso
        (Functor.biprodComparison
          ((sheafSections JX AddCommGrpCat).obj (op ⊤))
          (skyscraperSheaf twoClosedPointsS1Point eventualIntegerSequenceColimit)
          (skyscraperSheaf twoClosedPointsS2Point eventualIntegerSequenceColimit)) := hB
    letI : IsIso (biprod.map e1.hom e2.hom) := hM
    infer_instance
  -- After the two component evaluations are identities, only the canonical biproduct comparison
  -- remains.
  simpa [twoClosedPointsSkyscraperPairGlobalSectionsComparison, hs1, hs2, e1, e2] using hIso

-- Proof sketch: the global sections of a biproduct sheaf form the biproduct of the global sections, and
-- the global sections of each skyscraper sheaf at a closed point recover its value `M`.
private theorem tailPushforwardColimitGlobalSectionsComparison_isIso :
    IsIso tailPushforwardColimitGlobalSectionsComparison := by
  -- Map the sheaf-level comparison through global sections and then compose with the explicit
  -- top-open evaluation isomorphism for the skyscraper pair.
  haveI : IsIso twoClosedPointsSkyscraperPairGlobalSectionsComparison :=
    twoClosedPointsSkyscraperPairGlobalSectionsComparison_isIso
  haveI :
      IsIso (((sheafSections JX AddCommGrpCat).obj (op ⊤)).map tailPushforwardColimitComparison) := by
    let e := ((sheafSections JX AddCommGrpCat).obj (op ⊤)).mapIso
      (@asIso _ _ _ _ tailPushforwardColimitComparison tailPushforwardColimitComparison_isIso)
    change IsIso e.hom
    infer_instance
  exact IsIso.comp_isIso

/-- Example 6.29.2 (2): the sheaf
`\mathcal{F} = \operatorname{colim}_n j_{n,*}\underline{Z}` has global sections `M \oplus M`. -/
theorem tailPushforwardColimit_global_sections_comparison_isIso :
    IsIso tailPushforwardColimitGlobalSectionsComparison :=
  tailPushforwardColimitGlobalSectionsComparison_isIso

-- Proof sketch: evaluate the pushforward constant sheaves on the whole space `X`; this gives the
-- direct system `n ↦ \prod_{m \ge n} Z`, and taking the filtered colimit identifies the colimit
-- of the global sections with `M`.
/-- Helper for Example 6.29.2: each stagewise global-sections comparison is available as an actual
isomorphism, not just an `IsIso` instance. -/
private noncomputable def tailPushforwardIntegerSheafGlobalSectionsToProductStageIso (n : ℕ) :
    ((sheafSections JX AddCommGrpCat).obj (op ⊤)).obj (tailPushforwardIntegerSheaf n) ≅
      tailIntegerProduct n :=
  letI := tailPushforwardIntegerSheafGlobalSectionsToProduct_stage_isIso n
  asIso (tailPushforwardIntegerSheafGlobalSectionsToProduct n)

/-- Helper for Example 6.29.2: the stagewise identifications
`Γ(X, j_{n,*}\underline{Z}) ≅ \prod_{m \ge n} \mathbf{Z}` assemble to a natural isomorphism of
filtered diagrams. -/
private noncomputable def tailPushforwardIntegerSheafGlobalSectionsToProductNatIso :
    tailPushforwardIntegerSheafGlobalSectionsFunctor ≅ tailIntegerProductFunctor :=
  NatIso.ofComponents
    (fun n ↦ tailPushforwardIntegerSheafGlobalSectionsToProductStageIso n)
    (fun {_ _} h ↦ tailPushforwardIntegerSheafGlobalSectionsToProduct_naturality h)

/-- Helper for Example 6.29.2: the colimit comparison on global sections is the canonical colimit
map induced by the natural isomorphism to the tail-product diagram. -/
private theorem tailPushforwardIntegerSheafGlobalSectionsColimitComparison_eq_isoOfNatIso_hom :
    tailPushforwardIntegerSheafGlobalSectionsColimitComparison =
      (HasColimit.isoOfNatIso tailPushforwardIntegerSheafGlobalSectionsToProductNatIso).hom := by
  -- Compare the two colimit morphisms on each stage cocone leg of
  -- `tailPushforwardIntegerSheafGlobalSectionsFunctor`.
  apply colimit.hom_ext
  intro n
  -- Both composites are the stagewise product identification followed by the structure map into
  -- `M`; the right-hand side is normalized by `HasColimit.isoOfNatIso_ι_hom`.
  have hstage :
      colimit.ι tailPushforwardIntegerSheafGlobalSectionsFunctor n ≫
          tailPushforwardIntegerSheafGlobalSectionsColimitComparison =
        tailPushforwardIntegerSheafGlobalSectionsColimitCocone.ι.app n := by
    simpa [tailPushforwardIntegerSheafGlobalSectionsColimitComparison] using
      (colimit.ι_desc
        (F := tailPushforwardIntegerSheafGlobalSectionsFunctor)
        (c := tailPushforwardIntegerSheafGlobalSectionsColimitCocone) n)
  have hstage' :
      tailPushforwardIntegerSheafGlobalSectionsColimitCocone.ι.app n =
        tailPushforwardIntegerSheafGlobalSectionsToProduct n ≫
          colimit.ι tailIntegerProductFunctor n := by
    rfl
  have hiso :
      tailPushforwardIntegerSheafGlobalSectionsToProduct n ≫
          colimit.ι tailIntegerProductFunctor n =
        colimit.ι tailPushforwardIntegerSheafGlobalSectionsFunctor n ≫
          (HasColimit.isoOfNatIso tailPushforwardIntegerSheafGlobalSectionsToProductNatIso).hom := by
    simpa [tailPushforwardIntegerSheafGlobalSectionsToProductNatIso,
      tailPushforwardIntegerSheafGlobalSectionsToProductStageIso] using
      (HasColimit.isoOfNatIso_ι_hom
        (w := tailPushforwardIntegerSheafGlobalSectionsToProductNatIso) n).symm
  exact hstage.trans (hstage'.trans hiso)

private theorem tailPushforwardIntegerSheafGlobalSectionsColimitComparison_isIso :
    IsIso tailPushforwardIntegerSheafGlobalSectionsColimitComparison := by
  -- The filtered colimit comparison is exactly the canonical isomorphism induced by the stagewise
  -- natural isomorphism to the tail-product diagram.
  rw [tailPushforwardIntegerSheafGlobalSectionsColimitComparison_eq_isoOfNatIso_hom]
  infer_instance

/-- Example 6.29.2 (3): the colimit of the global sections of the system `j_{n,*}\underline{Z}` is
`M = \operatorname{colim}_n \prod_{m \ge n} \mathbf{Z}`. -/
theorem tailPushforwardIntegerSheaf_exists_global_sections_colimit :
    IsIso tailPushforwardIntegerSheafGlobalSectionsColimitComparison :=
  tailPushforwardIntegerSheafGlobalSectionsColimitComparison_isIso
