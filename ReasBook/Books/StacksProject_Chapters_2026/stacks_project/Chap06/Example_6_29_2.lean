/-- The points of the two-closed-points space from Example 6.29.2. -/
inductive TwoClosedPointsPoint where
  | s1
  | s2
  | xi (n : ℕ)

deriving DecidableEq

open TwoClosedPointsPoint

/-- The set of generic points `xi_n`. -/
def twoClosedPointsXiSet : Set TwoClosedPointsPoint :=
  {x | ∃ n : ℕ, x = xi n}

/-- The basic open containing `s1` and all generic points. -/
def twoClosedPointsS1BasicOpen : Set TwoClosedPointsPoint :=
  {s1} ∪ twoClosedPointsXiSet

/-- The basic open containing `s2` and all generic points. -/
def twoClosedPointsS2BasicOpen : Set TwoClosedPointsPoint :=
  {s2} ∪ twoClosedPointsXiSet

/-- The explicit topology used in Example 6.29.2. -/
instance : TopologicalSpace TwoClosedPointsPoint :=
  TopologicalSpace.generateFrom
    {U | (∃ n : ℕ, U = ({xi n} : Set TwoClosedPointsPoint)) ∨
        U = twoClosedPointsS1BasicOpen ∨ U = twoClosedPointsS2BasicOpen}

/-- The topological space with closed points `s1`, `s2` and generic points `xi_n`. -/
noncomputable abbrev twoClosedPointsSpace : TopCat :=
  TopCat.of TwoClosedPointsPoint

local notation "JX" => Opens.grothendieckTopology twoClosedPointsSpace

/-- The first closed point as a point of `twoClosedPointsSpace`. -/
noncomputable abbrev twoClosedPointsS1Point : twoClosedPointsSpace :=
  s1

/-- The second closed point as a point of `twoClosedPointsSpace`. -/
noncomputable abbrev twoClosedPointsS2Point : twoClosedPointsSpace :=
  s2

/-- The generic point `ξ_m` as a point of `twoClosedPointsSpace`. -/
noncomputable abbrev twoClosedPointsXiPoint (m : ℕ) : twoClosedPointsSpace :=
  xi m

/-- The tail subset `U_n = {xi_n, xi_{n+1}, ...}`. -/
def tailOpenSet (n : ℕ) : Set twoClosedPointsSpace :=
  {x | ∃ m : ℕ, n ≤ m ∧ x = xi m}

-- Proof sketch: `U_n` is the union of the singleton basic opens `{xi_m}` for `m ≥ n`, hence it is
-- open in the topology generated by those singleton opens together with the neighborhoods of `s1`
-- and `s2`.
/-- The tail subset `U_n` is open in the topology of the two-closed-points space. -/
theorem tailOpenSet_isOpen (n : ℕ) : IsOpen (tailOpenSet n) := by
  -- Rewrite `U_n` as the union of the singleton generating opens `{ξ_m}` for `m ≥ n`.
  have hUnion :
      tailOpenSet n = ⋃ m : {m : ℕ // n ≤ m}, ({xi m.1} : Set TwoClosedPointsPoint) := by
    ext x
    constructor
    · rintro ⟨m, hm, rfl⟩
      exact Set.mem_iUnion.2 ⟨⟨m, hm⟩, by simp⟩
    · intro hx
      rcases Set.mem_iUnion.1 hx with ⟨m, hx⟩
      simp only [Set.mem_singleton_iff] at hx
      exact ⟨m, m.2, hx⟩
  rw [hUnion]
  -- Each singleton `{ξ_m}` belongs to the generating family of the topology.
  refine isOpen_iUnion fun m ↦ ?_
  exact isOpen_generateFrom_of_mem <| Or.inl ⟨m.1, rfl⟩

/-- The open subset `U_n` of the two-closed-points space. -/
def tailOpen (n : ℕ) : Opens twoClosedPointsSpace :=
  ⟨tailOpenSet n, tailOpenSet_isOpen n⟩

/-- The open subspace attached to `U_n`. -/
noncomputable abbrev tailOpenSpace (n : ℕ) : TopCat :=
  (Opens.toTopCat twoClosedPointsSpace).obj (tailOpen n)

/-- Helper for Example 6.29.2: the tail subspace `U_n` is discrete because each point `ξ_m`
admits the ambient singleton `{ξ_m}` as an open neighborhood cutting out exactly that point in
`U_n`. -/
private theorem tailOpenSpace_discrete (n : ℕ) : DiscreteTopology (tailOpenSpace n) := by
  change DiscreteTopology (tailOpenSet n)
  refine (discreteTopology_subtype_iff').2 ?_
  intro y hy
  rcases hy with ⟨m, hm, rfl⟩
  refine ⟨({xi m} : Set TwoClosedPointsPoint), ?_, ?_⟩
  · exact isOpen_generateFrom_of_mem <| Or.inl ⟨m, rfl⟩
  · ext z
    constructor
    · rintro ⟨hz, _⟩
      simpa using hz
    · intro hz
      rcases Set.mem_singleton_iff.1 hz with rfl
      exact ⟨by simp, ⟨m, hm, rfl⟩⟩

/-- The inclusion `j_n : U_n -> X`. -/
noncomputable abbrev tailOpenInclusion (n : ℕ) :
    tailOpenSpace n ⟶ twoClosedPointsSpace :=
  Opens.inclusion' (tailOpen n)

/-- The constant `Z`-sheaf on the open subspace `U_n`. -/
noncomputable abbrev tailConstantIntegerSheaf (n : ℕ) :
    TopCat.Sheaf AddCommGrpCat (tailOpenSpace n) :=
  (constantSheaf (Opens.grothendieckTopology (tailOpenSpace n)) AddCommGrpCat).obj
    (AddCommGrpCat.of ℤ)

public abbrev tailSectionIndex (n : ℕ) (U : Opens twoClosedPointsSpace) :=
  {m : ℕ // n ≤ m ∧ xi m ∈ U}

public noncomputable abbrev tailSectionValue (n : ℕ) (U : Opens twoClosedPointsSpace) :
    AddCommGrpCat :=
  AddCommGrpCat.of (tailSectionIndex n U → ℤ)

/-- Helper for Example 6.29.2: a tail index determines the corresponding point of the preimage
open `(j_n)⁻¹(U)`. -/
public def tailOpenPreimagePointOfIndex (n : ℕ) {U : Opens twoClosedPointsSpace}
    (x : tailSectionIndex n U) :
    (Opens.map (tailOpenInclusion n)).obj U :=
  ⟨⟨xi x.1, ⟨x.1, x.2.1, rfl⟩⟩, x.2.2⟩

/-- Helper for Example 6.29.2: a point of `(j_n)⁻¹(U)` determines the corresponding tail index. -/
private noncomputable def tailSectionIndexOfMappedPoint (n : ℕ) {U : Opens twoClosedPointsSpace}
    (x : (Opens.map (tailOpenInclusion n)).obj U) :
    tailSectionIndex n U :=
  ⟨Classical.choose x.1.2, (Classical.choose_spec x.1.2).1,
    (Classical.choose_spec x.1.2).2 ▸ x.2⟩

/-- Helper for Example 6.29.2: converting a tail index to a point of `(j_n)⁻¹(U)` and back does
nothing. -/
private theorem tailSectionIndexOfMappedPoint_preimage (n : ℕ) {U : Opens twoClosedPointsSpace}
    (x : tailSectionIndex n U) :
    tailSectionIndexOfMappedPoint n (tailOpenPreimagePointOfIndex n x) = x := by
  cases x with
  | mk val property =>
      apply Subtype.ext
      let hx : ∃ m : ℕ, n ≤ m ∧ xi val = xi m :=
        Exists.intro val (And.intro property.1 rfl)
      change Classical.choose hx = val
      exact TwoClosedPointsPoint.xi.inj (Classical.choose_spec hx).2.symm

/-- Helper for Example 6.29.2: converting a point of `(j_n)⁻¹(U)` to an index and back does
nothing. -/
private theorem tailOpenPreimagePointOfIndex_sectionIndex (n : ℕ)
    {U : Opens twoClosedPointsSpace} (x : (Opens.map (tailOpenInclusion n)).obj U) :
    tailOpenPreimagePointOfIndex n (tailSectionIndexOfMappedPoint n x) = x := by
  rcases x with ⟨⟨x, hx⟩, hxU⟩
  apply Subtype.ext
  apply Subtype.ext
  exact (Classical.choose_spec hx).2.symm

public noncomputable def tailSectionRestriction (n : ℕ) {U V : Opens twoClosedPointsSpace}
    (i : U ≤ V) :
    tailSectionValue n V ⟶ tailSectionValue n U :=
  AddCommGrpCat.ofHom
    { toFun := fun f x ↦ f ⟨x.1, x.2.1, i x.2.2⟩
      map_zero' := by
        ext x
        rfl
      map_add' := by
        intro a b
        ext x
        rfl }

/-- An explicit internal model for `j_{n,*}\underline{Z}` whose sections over `U`
are functions on the indices `m ≥ n` with `ξ_m ∈ U`. -/
public noncomputable def tailPushforwardIntegerSheafModelPresheaf (n : ℕ) :
    TopCat.Presheaf AddCommGrpCat twoClosedPointsSpace where
  obj U := tailSectionValue n U.unop
  map {U V} i := tailSectionRestriction n i.unop.le
  map_id := by
    intro U
    ext f x
    rfl
  map_comp := by
    intro U V W i j
    ext f x
    rfl

/-- Helper for Example 6.29.2: after forgetting to types, the explicit pushforward model is the
ordinary pushforward of the presheaf of integer-valued functions on `U_n`, so it satisfies the
sheaf condition. -/
public theorem tailPushforwardIntegerSheafModelPresheaf_isSheaf (n : ℕ) :
    (tailPushforwardIntegerSheafModelPresheaf n).IsSheaf := by
  -- Check the sheaf condition after forgetting to types, where the model is the literal
  -- pushforward of the function presheaf along `j_n`.
  refine (TopCat.Presheaf.isSheaf_iff_isSheaf_comp (forget AddCommGrpCat) _).2 ?_
  let e :
      ((TopCat.Presheaf.pushforward (Type _) (tailOpenInclusion n)).obj
          (TopCat.presheafToType (tailOpenSpace n) ℤ)) ≅
        (tailPushforwardIntegerSheafModelPresheaf n ⋙ forget AddCommGrpCat) := by
    refine NatIso.ofComponents (fun U ↦ ?_) ?_
    · refine
        (show
          (((TopCat.Presheaf.pushforward (Type _) (tailOpenInclusion n)).obj
                (TopCat.presheafToType (tailOpenSpace n) ℤ)).obj U ≃
            ((tailPushforwardIntegerSheafModelPresheaf n ⋙ forget AddCommGrpCat).obj U)) from
          { toFun := fun f x ↦ f (tailOpenPreimagePointOfIndex n x)
            invFun := fun f x ↦ f (tailSectionIndexOfMappedPoint n x)
            left_inv := ?_
            right_inv := ?_ }).toIso
      · intro f
        funext x
        exact congrArg f (tailOpenPreimagePointOfIndex_sectionIndex n x)
      · intro f
        funext x
        exact congrArg f (tailSectionIndexOfMappedPoint_preimage n x)
    · intro U V i
      ext f x
      rfl
  refine TopCat.Presheaf.isSheaf_of_iso e ?_
  simpa using TopCat.Sheaf.pushforward_sheaf_of_sheaf (f := tailOpenInclusion n)
    (C := Type _) (F := TopCat.presheafToType (tailOpenSpace n) ℤ)
    (TopCat.Presheaf.toType_isSheaf (tailOpenSpace n) ℤ)

/-- The explicit internal sheaf model for `j_{n,*}\underline{Z}`. -/
public noncomputable def tailPushforwardIntegerSheafModel (n : ℕ) :
    TopCat.Sheaf AddCommGrpCat twoClosedPointsSpace :=
  ⟨tailPushforwardIntegerSheafModelPresheaf n,
    tailPushforwardIntegerSheafModelPresheaf_isSheaf n⟩

/-- The canonical pushforward sheaf `j_{n,*}\underline{Z}` from Example 6.29.2. -/
noncomputable abbrev tailPushforwardIntegerSheaf (n : ℕ) :
    TopCat.Sheaf AddCommGrpCat twoClosedPointsSpace :=
  (pushforward AddCommGrpCat (tailOpenInclusion n)).obj (tailConstantIntegerSheaf n)

public noncomputable abbrev tailOpenSectionValue (n : ℕ) (W : Opens (tailOpenSpace n)) :
    AddCommGrpCat :=
  AddCommGrpCat.of (W → ℤ)

public noncomputable def tailOpenSectionRestriction (n : ℕ)
    {U V : Opens (tailOpenSpace n)} (i : U ≤ V) :
    tailOpenSectionValue n V ⟶ tailOpenSectionValue n U :=
  AddCommGrpCat.ofHom
    { toFun := fun f x ↦ f ⟨x.1, i x.2⟩
      map_zero' := by
        ext x
        rfl
      map_add' := by
        intro a b
        ext x
        rfl }

public noncomputable def tailIntegerFunctionSheafPresheaf (n : ℕ) :
    TopCat.Presheaf AddCommGrpCat (tailOpenSpace n) where
  obj U := tailOpenSectionValue n U.unop
  map {U V} i := tailOpenSectionRestriction n i.unop.le
  map_id := by
    intro U
    ext f x
    rfl
  map_comp := by
    intro U V W i j
    ext f x
    rfl

/-- Helper for Example 6.29.2: the function-valued model on `U_n` becomes the ordinary
presheaf of integer-valued functions after forgetting to types, hence it is a sheaf. -/
public theorem tailIntegerFunctionSheafPresheaf_isSheaf (n : ℕ) :
    (tailIntegerFunctionSheafPresheaf n).IsSheaf := by
  -- Forget to types and identify the model with the standard presheaf of functions.
  refine (TopCat.Presheaf.isSheaf_iff_isSheaf_comp (forget AddCommGrpCat) _).2 ?_
  simpa [tailIntegerFunctionSheafPresheaf, tailOpenSectionValue, tailOpenSectionRestriction,
    TopCat.presheafToType] using
    (TopCat.Presheaf.toType_isSheaf (tailOpenSpace n) ℤ)

public noncomputable def tailIntegerFunctionSheaf (n : ℕ) :
    TopCat.Sheaf AddCommGrpCat (tailOpenSpace n) :=
  ⟨tailIntegerFunctionSheafPresheaf n, tailIntegerFunctionSheafPresheaf_isSheaf n⟩

public noncomputable def tailConstantIntegerSheafToFunctionSheafPresheafMap (n : ℕ) :
    (Functor.const (Opens (tailOpenSpace n))ᵒᵖ).obj (AddCommGrpCat.of ℤ) ⟶
      (tailIntegerFunctionSheaf n).presheaf where
  app W :=
    AddCommGrpCat.ofHom
      { toFun := fun z _ ↦ z
        map_zero' := by
          ext x
          rfl
        map_add' := by
          intro a b
          ext x
          rfl }
  naturality := by
    intro U V i
    ext z
    rfl

public noncomputable def tailConstantIntegerSheafToFunctionSheaf (n : ℕ) :
    tailConstantIntegerSheaf n ⟶ tailIntegerFunctionSheaf n :=
  ⟨sheafifyLift (Opens.grothendieckTopology (tailOpenSpace n))
      (tailConstantIntegerSheafToFunctionSheafPresheafMap n)
      (tailIntegerFunctionSheaf n).property⟩

/-- Helper for Example 6.29.2: the constant-to-function presheaf map on `U_n` is locally injective
because equality of two constant functions can be tested at any chosen point. -/
private theorem tailConstantIntegerSheafToFunctionSheafPresheaf_isLocallyInjective (n : ℕ) :
    CategoryTheory.Presheaf.IsLocallyInjective (Opens.grothendieckTopology (tailOpenSpace n))
      (tailConstantIntegerSheafToFunctionSheafPresheafMap n) := by
  constructor
  intro U a b h x hx
  -- Evaluate the equality of constant functions at the chosen point to identify the constants.
  have hab : a = b := by
    simpa [tailConstantIntegerSheafToFunctionSheafPresheafMap] using
      congrFun h ⟨x, hx⟩
  refine ⟨U.unop, 𝟙 _, ?_, hx⟩
  simp [CategoryTheory.Presheaf.equalizerSieve, hab]

/-- Helper for Example 6.29.2: the constant-to-function presheaf map on `U_n` is locally
surjective because every function is constant on the singleton neighborhood of any point in the
discrete tail space. -/
private theorem tailConstantIntegerSheafToFunctionSheafPresheaf_isLocallySurjective (n : ℕ) :
    CategoryTheory.Presheaf.IsLocallySurjective (Opens.grothendieckTopology (tailOpenSpace n))
      (tailConstantIntegerSheafToFunctionSheafPresheafMap n) := by
  letI := tailOpenSpace_discrete n
  constructor
  intro U s x hx
  let V : Opens (tailOpenSpace n) := ⟨({x} : Set (tailOpenSpace n)), by
    simpa using (discreteTopology_iff_isOpen_singleton.mp (tailOpenSpace_discrete n) x)⟩
  have hV : V ≤ U := by
    intro y hy
    have hyx : y = x := by
      simpa [V] using hy
    simpa [hyx] using hx
  have hxV : x ∈ V := by
    simp [V]
  refine ⟨V, homOfLE hV, ?_, hxV⟩
  refine ⟨s ⟨x, hx⟩, ?_⟩
  change (fun _ : V ↦ s ⟨x, hx⟩) = fun y : V ↦ s ⟨y.1, hV y.2⟩
  funext y
  have hyx : y.1 = x := by
    exact Set.mem_singleton_iff.mp y.2
  simp [hyx]

/-- Helper for Example 6.29.2: the sheaf-level constant-to-function comparison factors through the
sheafification of the explicit presheaf map, followed by the canonical identification of the target
sheaf with its sheafification. -/
private theorem tailConstantIntegerSheafToFunctionSheaf_hom_factorization (n : ℕ) :
    (tailConstantIntegerSheafToFunctionSheaf n).hom =
      ((presheafToSheaf (Opens.grothendieckTopology (tailOpenSpace n)) AddCommGrpCat).map
          (tailConstantIntegerSheafToFunctionSheafPresheafMap n)).hom ≫
        (sheafificationIso (tailIntegerFunctionSheaf n)).inv.hom := by
  let J := Opens.grothendieckTopology (tailOpenSpace n)
  let η := tailConstantIntegerSheafToFunctionSheafPresheafMap n
  -- Compare the concrete bridge with the sheafified presheaf map followed by the target inverse.
  simpa [J, η, tailConstantIntegerSheafToFunctionSheaf, CategoryTheory.sheafificationIso,
    CategoryTheory.isoSheafify_inv] using
    (CategoryTheory.sheafifyMap_sheafifyLift
      (J := J) η (𝟙 (tailIntegerFunctionSheafPresheaf n))
      (tailIntegerFunctionSheafPresheaf_isSheaf n))

public noncomputable def tailIntegerFunctionSheafPushforwardToModel (n : ℕ) :
    (pushforward AddCommGrpCat (tailOpenInclusion n)).obj (tailIntegerFunctionSheaf n) ⟶
      tailPushforwardIntegerSheafModel n :=
  ObjectProperty.homMk
    { app := fun U ↦
        AddCommGrpCat.ofHom
          { toFun := fun f x ↦ f (tailOpenPreimagePointOfIndex n x)
            map_zero' := by
              ext x
              rfl
            map_add' := by
              intro a b
              ext x
              rfl }
      naturality := by
        intro U V i
        ext f
        rfl }

/-- The comparison morphism from the pushforward sheaf `j_{n,*}\underline{Z}` to the explicit
index-function model. -/
public noncomputable def tailPushforwardIntegerSheafToModel (n : ℕ) :
    tailPushforwardIntegerSheaf n ⟶ tailPushforwardIntegerSheafModel n :=
  (pushforward AddCommGrpCat (tailOpenInclusion n)).map
      (tailConstantIntegerSheafToFunctionSheaf n) ≫
    tailIntegerFunctionSheafPushforwardToModel n

private instance tailConstantIntegerSheafToFunctionSheaf_isIso (n : ℕ) :
    IsIso (tailConstantIntegerSheafToFunctionSheaf n) := by
  let J := Opens.grothendieckTopology (tailOpenSpace n)
  let f :
      (constantSheaf J AddCommGrpCat).obj (AddCommGrpCat.of ℤ) ⟶
        (presheafToSheaf J AddCommGrpCat).obj (tailIntegerFunctionSheafPresheaf n) :=
    (presheafToSheaf J AddCommGrpCat).map (tailConstantIntegerSheafToFunctionSheafPresheafMap n)
  let g :
      (presheafToSheaf J AddCommGrpCat).obj (tailIntegerFunctionSheafPresheaf n) ⟶
        tailIntegerFunctionSheaf n :=
    (sheafificationIso (tailIntegerFunctionSheaf n)).inv
  have hf_inj : CategoryTheory.Sheaf.IsLocallyInjective f := by
    -- Transfer local injectivity from the explicit presheaf map to its sheafification.
    change CategoryTheory.Sheaf.IsLocallyInjective
      ((presheafToSheaf J AddCommGrpCat).map (tailConstantIntegerSheafToFunctionSheafPresheafMap n))
    exact
      (Presheaf.isLocallyInjective_presheafToSheaf_map_iff
        (J := J) (A := AddCommGrpCat)
        (φ := tailConstantIntegerSheafToFunctionSheafPresheafMap n)).2
        (tailConstantIntegerSheafToFunctionSheafPresheaf_isLocallyInjective n)
  have hf_surj : CategoryTheory.Sheaf.IsLocallySurjective f := by
    -- The same transport works for local surjectivity on singleton neighborhoods.
    change CategoryTheory.Sheaf.IsLocallySurjective
      ((presheafToSheaf J AddCommGrpCat).map (tailConstantIntegerSheafToFunctionSheafPresheafMap n))
    exact
      (Presheaf.isLocallySurjective_presheafToSheaf_map_iff
        (J := J) (A := AddCommGrpCat)
        (φ := tailConstantIntegerSheafToFunctionSheafPresheafMap n)).2
        (tailConstantIntegerSheafToFunctionSheafPresheaf_isLocallySurjective n)
  have hf_iso : IsIso f := by
    -- A locally bijective morphism of sheaves of abelian groups is an isomorphism.
    exact
      (CategoryTheory.Sheaf.isLocallyBijective_iff_isIso
        (J := J) (A := AddCommGrpCat) (f := f)).1 ⟨hf_inj, hf_surj⟩
  have hg_iso : IsIso g := by
    infer_instance
  have hfactor : tailConstantIntegerSheafToFunctionSheaf n = f ≫ g := by
    -- Replace the concrete morphism by its sheafification factorization.
    apply CategoryTheory.Sheaf.hom_ext
    exact tailConstantIntegerSheafToFunctionSheaf_hom_factorization n
  letI : IsIso f := hf_iso
  letI : IsIso g := hg_iso
  rw [hfactor]
  exact IsIso.comp_isIso' hf_iso hg_iso

private instance tailIntegerFunctionSheafPushforwardToModel_isIso (n : ℕ) :
    IsIso (tailIntegerFunctionSheafPushforwardToModel n) := by
  -- Construct the inverse by reading an index from a point of the preimage open.
  let inv :
      tailPushforwardIntegerSheafModel n ⟶
        (pushforward AddCommGrpCat (tailOpenInclusion n)).obj (tailIntegerFunctionSheaf n) :=
    ObjectProperty.homMk
      { app := fun U ↦
          AddCommGrpCat.ofHom
            { toFun := fun f x ↦
                f (tailSectionIndexOfMappedPoint n x)
              map_zero' := by
                ext x
                rfl
              map_add' := by
                intro a b
                ext x
                rfl }
        naturality := by
          intro U V i
          ext f
          funext x
          rfl }
  refine ⟨⟨inv, ?_, ?_⟩⟩
  · -- One composite immediately cancels on each tail index.
    apply Sheaf.hom_ext
    ext U f
    funext x
    simpa [inv, tailIntegerFunctionSheafPushforwardToModel] using
      congrArg f (tailOpenPreimagePointOfIndex_sectionIndex n x)
  · -- The other composite cancels after rewriting a point of the preimage open as `ξ_m`.
    apply Sheaf.hom_ext
    ext U f
    funext x
    simpa [inv, tailIntegerFunctionSheafPushforwardToModel] using
      congrArg f (tailSectionIndexOfMappedPoint_preimage n x)

public instance tailPushforwardIntegerSheafToModel_isIso (n : ℕ) :
    IsIso (tailPushforwardIntegerSheafToModel n) := by
  change IsIso
    ((pushforward AddCommGrpCat (tailOpenInclusion n)).map
        (tailConstantIntegerSheafToFunctionSheaf n) ≫
      tailIntegerFunctionSheafPushforwardToModel n)
  infer_instance

public noncomputable abbrev tailPushforwardIntegerSheafModelIso (n : ℕ) :
    tailPushforwardIntegerSheaf n ≅ tailPushforwardIntegerSheafModel n :=
  asIso (tailPushforwardIntegerSheafToModel n)

public noncomputable def tailPushforwardIntegerSheafModelMap {i j : ℕ} (h : i ≤ j) :
    tailPushforwardIntegerSheafModel i ⟶ tailPushforwardIntegerSheafModel j :=
  ObjectProperty.homMk
    { app := fun U ↦
        AddCommGrpCat.ofHom
          { toFun := fun f x ↦ f ⟨x.1, le_trans h x.2.1, x.2.2⟩
            map_zero' := by
              ext x
              rfl
            map_add' := by
              intro a b
              ext x
              rfl }
      naturality := by
        intro U V i
        ext f
        rfl }

public theorem tailPushforwardIntegerSheafModelMap_id (i : ℕ) :
    tailPushforwardIntegerSheafModelMap (le_rfl : i ≤ i) = 𝟙 (tailPushforwardIntegerSheafModel i) := by
  apply Sheaf.hom_ext
  ext U f
  rfl

public theorem tailPushforwardIntegerSheafModelMap_comp {i j k : ℕ}
    (hij : i ≤ j) (hjk : j ≤ k) :
    tailPushforwardIntegerSheafModelMap (le_trans hij hjk) =
      tailPushforwardIntegerSheafModelMap hij ≫ tailPushforwardIntegerSheafModelMap hjk := by
  apply Sheaf.hom_ext
  ext U s
  rfl

/-- The canonical transition morphisms `j_{i,*}\underline{Z} → j_{j,*}\underline{Z}` for `i ≤ j`,
given by restriction on the explicit index-function model. -/
noncomputable def tailPushforwardIntegerSheafMap {i j : ℕ} (h : i ≤ j) :
    tailPushforwardIntegerSheaf i ⟶ tailPushforwardIntegerSheaf j :=
  tailPushforwardIntegerSheafToModel i ≫
    tailPushforwardIntegerSheafModelMap h ≫
      (tailPushforwardIntegerSheafModelIso j).inv

@[simp] theorem tailPushforwardIntegerSheafMap_id (i : ℕ) :
    tailPushforwardIntegerSheafMap (le_rfl : i ≤ i) = 𝟙 (tailPushforwardIntegerSheaf i) := by
  simp [tailPushforwardIntegerSheafMap, tailPushforwardIntegerSheafModelMap_id]

theorem tailPushforwardIntegerSheafMap_comp {i j k : ℕ}
    (hij : i ≤ j) (hjk : j ≤ k) :
    tailPushforwardIntegerSheafMap (le_trans hij hjk) =
      tailPushforwardIntegerSheafMap hij ≫ tailPushforwardIntegerSheafMap hjk := by
  have hcomp :=
    congrArg
      (fun t ↦ tailPushforwardIntegerSheafToModel i ≫ t ≫
        (tailPushforwardIntegerSheafModelIso k).inv)
      (tailPushforwardIntegerSheafModelMap_comp hij hjk)
  simpa [tailPushforwardIntegerSheafMap, Category.assoc] using hcomp

/-- The product `\prod_{m \ge n} Z` appearing in Example 6.29.2. -/
noncomputable abbrev tailIntegerProduct (n : ℕ) : AddCommGrpCat :=
  AddCommGrpCat.of ({m : ℕ // n ≤ m} → ℤ)

/-- The restriction maps in the direct system `n ↦ \prod_{m \ge n} Z`. -/
noncomputable def tailIntegerProductMap {i j : ℕ} (h : i ≤ j) :
    tailIntegerProduct i ⟶ tailIntegerProduct j :=
  AddCommGrpCat.ofHom
    { toFun := fun f x ↦ f ⟨x.1, le_trans h x.2⟩
      map_zero' := by ext x; rfl
      map_add' := by
        intro a b
        ext x
        rfl }

/-- The direct system `n ↦ \prod_{m \ge n} Z`. -/
noncomputable def tailIntegerProductFunctor : ℕ ⥤ AddCommGrpCat where
  obj n := tailIntegerProduct n
  map h := tailIntegerProductMap h.down.down
  map_id i := by
    ext f x
    rfl
  map_comp f g := by
    ext x y
    rfl

/-- The colimit `M = colim_n \prod_{m \ge n} Z`. -/
noncomputable abbrev eventualIntegerSequenceColimit : AddCommGrpCat :=
  colimit tailIntegerProductFunctor

/-- The direct system `n ↦ j_{n,*}\underline{Z}` on the two-closed-points space. -/
noncomputable def tailPushforwardIntegerSheafFunctor :
    ℕ ⥤ TopCat.Sheaf AddCommGrpCat twoClosedPointsSpace where
  obj n := tailPushforwardIntegerSheaf n
  map h := tailPushforwardIntegerSheafMap h.down.down
  map_id := by
    intro i
    exact tailPushforwardIntegerSheafMap_id i
  map_comp := by
    intro i j k f g
    exact tailPushforwardIntegerSheafMap_comp f.down.down g.down.down

/-- The colimit sheaf `\mathcal{F} = \operatorname{colim}_n j_{n,*}\underline{Z}` from
Example 6.29.2. -/
noncomputable abbrev tailPushforwardIntegerSheafColimit :
    TopCat.Sheaf AddCommGrpCat twoClosedPointsSpace :=
  colimit tailPushforwardIntegerSheafFunctor

/-- The sheaf identified in Example 6.29.2 as the direct sum of the two skyscraper sheaves with
value `M` at `s1` and `s2`. In the sheaf category this direct sum is the binary biproduct. -/
noncomputable abbrev twoClosedPointsSkyscraperPairSheaf :
    TopCat.Sheaf AddCommGrpCat twoClosedPointsSpace :=
  biprod
    (skyscraperSheaf twoClosedPointsS1Point eventualIntegerSequenceColimit)
    (skyscraperSheaf twoClosedPointsS2Point eventualIntegerSequenceColimit)

/-- The canonical map from the global sections of the skyscraper sheaf at `s1` to its value `M`. -/
public noncomputable def s1SkyscraperGlobalSectionsToValue :
    (skyscraperPresheaf twoClosedPointsS1Point eventualIntegerSequenceColimit).obj (op ⊤) ⟶
      eventualIntegerSequenceColimit :=
  TopCat.Presheaf.Γgerm
      (skyscraperPresheaf twoClosedPointsS1Point eventualIntegerSequenceColimit)
        twoClosedPointsS1Point ≫
    (skyscraperPresheafStalkOfSpecializes twoClosedPointsS1Point eventualIntegerSequenceColimit
      specializes_rfl).hom

/-- The canonical map from the global sections of the skyscraper sheaf at `s2` to its value `M`. -/
public noncomputable def s2SkyscraperGlobalSectionsToValue :
    (skyscraperPresheaf twoClosedPointsS2Point eventualIntegerSequenceColimit).obj (op ⊤) ⟶
      eventualIntegerSequenceColimit :=
  TopCat.Presheaf.Γgerm
      (skyscraperPresheaf twoClosedPointsS2Point eventualIntegerSequenceColimit)
        twoClosedPointsS2Point ≫
    (skyscraperPresheafStalkOfSpecializes twoClosedPointsS2Point eventualIntegerSequenceColimit
      specializes_rfl).hom

public noncomputable def tailPushforwardIntegerSheafModelGlobalSectionsToProduct (n : ℕ) :
    ((sheafSections JX AddCommGrpCat).obj (op ⊤)).obj (tailPushforwardIntegerSheafModel n) ⟶
      tailIntegerProduct n :=
  AddCommGrpCat.ofHom
    { toFun := fun f x ↦ f ⟨x.1, x.2, by simp⟩
      map_zero' := by
        ext x
        rfl
      map_add' := by
        intro a b
        ext x
        rfl }

/-- The canonical identification of the global sections of `j_{n,*}\underline{Z}` with the product
`\prod_{m \ge n} \mathbf{Z}`. -/
noncomputable def tailPushforwardIntegerSheafGlobalSectionsToProduct (n : ℕ) :
    ((sheafSections JX AddCommGrpCat).obj (op ⊤)).obj (tailPushforwardIntegerSheaf n) ⟶
      tailIntegerProduct n :=
  ((sheafSections JX AddCommGrpCat).obj (op ⊤)).map (tailPushforwardIntegerSheafToModel n) ≫
    tailPushforwardIntegerSheafModelGlobalSectionsToProduct n

/-- Helper for Example 6.29.2: the explicit model identifies global sections naturally with the
tail products `∏_{m ≥ n} ℤ`. -/
public theorem tailPushforwardIntegerSheafModelGlobalSectionsToProduct_naturality {i j : ℕ}
    (h : i ⟶ j) :
    ((sheafSections JX AddCommGrpCat).obj (op ⊤)).map
        (tailPushforwardIntegerSheafModelMap h.down.down) ≫
      tailPushforwardIntegerSheafModelGlobalSectionsToProduct j =
    tailPushforwardIntegerSheafModelGlobalSectionsToProduct i ≫
      tailIntegerProductFunctor.map h := by
  -- Evaluate the comparison on one global section and one tail index.
  ext f x
  rfl

theorem tailPushforwardIntegerSheafGlobalSectionsToProduct_naturality {i j : ℕ}
    (h : i ⟶ j) :
    ((sheafSections JX AddCommGrpCat).obj (op ⊤)).map (tailPushforwardIntegerSheafFunctor.map h) ≫
        tailPushforwardIntegerSheafGlobalSectionsToProduct j =
      tailPushforwardIntegerSheafGlobalSectionsToProduct i ≫
        tailIntegerProductFunctor.map h := by
  -- Route correction: prove naturality on the explicit model first, then transport it back along
  -- `tailPushforwardIntegerSheafToModel`.
  have htransport :
      tailPushforwardIntegerSheafFunctor.map h ≫ tailPushforwardIntegerSheafToModel j =
        tailPushforwardIntegerSheafToModel i ≫ tailPushforwardIntegerSheafModelMap h.down.down := by
    -- Expand the transition map so the model comparison cancels on the nose.
    simp [tailPushforwardIntegerSheafFunctor, tailPushforwardIntegerSheafMap, Category.assoc]
  rw [tailPushforwardIntegerSheafGlobalSectionsToProduct]
  change
    ((((sheafSections JX AddCommGrpCat).obj (op ⊤)).map
          (tailPushforwardIntegerSheafFunctor.map h) ≫
        ((sheafSections JX AddCommGrpCat).obj (op ⊤)).map
          (tailPushforwardIntegerSheafToModel j)) ≫
        tailPushforwardIntegerSheafModelGlobalSectionsToProduct j) =
      tailPushforwardIntegerSheafGlobalSectionsToProduct i ≫ tailIntegerProductFunctor.map h
  rw [← Functor.map_comp]
  have hmap :
      ((sheafSections JX AddCommGrpCat).obj (op ⊤)).map
          (tailPushforwardIntegerSheafFunctor.map h ≫ tailPushforwardIntegerSheafToModel j) =
        ((sheafSections JX AddCommGrpCat).obj (op ⊤)).map
          (tailPushforwardIntegerSheafToModel i ≫ tailPushforwardIntegerSheafModelMap h.down.down) :=
    congrArg (((sheafSections JX AddCommGrpCat).obj (op ⊤)).map) htransport
  rw [hmap, Functor.map_comp]
  -- The remaining square is exactly the model-level naturality theorem.
  simpa [tailPushforwardIntegerSheafGlobalSectionsToProduct, Category.assoc] using
    congrArg
      (fun k ↦
        ((sheafSections JX AddCommGrpCat).obj (op ⊤)).map
          (tailPushforwardIntegerSheafToModel i) ≫ k)
      (tailPushforwardIntegerSheafModelGlobalSectionsToProduct_naturality h)

/-- The direct system of global sections `n ↦ Γ(X, j_{n,*}\underline{Z})`. -/
noncomputable abbrev tailPushforwardIntegerSheafGlobalSectionsFunctor : ℕ ⥤ AddCommGrpCat :=
  tailPushforwardIntegerSheafFunctor ⋙ (sheafSections JX AddCommGrpCat).obj (op ⊤)

/-- The canonical morphism of filtered systems from `n ↦ Γ(X, j_{n,*}\underline{Z})` to
`n ↦ \prod_{m \ge n} \mathbf{Z}`. -/
noncomputable def tailPushforwardIntegerSheafGlobalSectionsToProductNatTrans :
    tailPushforwardIntegerSheafGlobalSectionsFunctor ⟶ tailIntegerProductFunctor where
  app n := tailPushforwardIntegerSheafGlobalSectionsToProduct n
  naturality := by
    intro i j h
    exact tailPushforwardIntegerSheafGlobalSectionsToProduct_naturality h

public theorem tailPushforwardIntegerSheafGlobalSectionsColimitCocone_naturality {i j : ℕ}
    (h : i ⟶ j) :
    tailPushforwardIntegerSheafGlobalSectionsFunctor.map h ≫
        (tailPushforwardIntegerSheafGlobalSectionsToProduct j ≫
          colimit.ι tailIntegerProductFunctor j) =
      tailPushforwardIntegerSheafGlobalSectionsToProduct i ≫
        colimit.ι tailIntegerProductFunctor i := by
  -- Expand the diagram map so the stagewise naturality lemma applies literally.
  change
    ((sheafSections JX AddCommGrpCat).obj (op ⊤)).map
        (tailPushforwardIntegerSheafFunctor.map h) ≫
          (tailPushforwardIntegerSheafGlobalSectionsToProduct j ≫
            colimit.ι tailIntegerProductFunctor j) =
      tailPushforwardIntegerSheafGlobalSectionsToProduct i ≫
        colimit.ι tailIntegerProductFunctor i
  -- Reassociate so the stagewise naturality square rewrites the left-hand composite.
  rw [← Category.assoc]
  rw [tailPushforwardIntegerSheafGlobalSectionsToProduct_naturality]
  -- Postcompose the colimit cocone relation for the product diagram.
  simpa only [Category.assoc] using
    congrArg
      (fun k ↦ tailPushforwardIntegerSheafGlobalSectionsToProduct i ≫ k)
      (colimit.w tailIntegerProductFunctor h)

public noncomputable def tailPushforwardIntegerSheafGlobalSectionsColimitCocone :
    Cocone tailPushforwardIntegerSheafGlobalSectionsFunctor where
  pt := eventualIntegerSequenceColimit
  ι :=
    { app := fun n ↦
        (tailPushforwardIntegerSheafGlobalSectionsToProductNatTrans.app n) ≫
          colimit.ι tailIntegerProductFunctor n
      naturality := by
        intro i j h
        exact tailPushforwardIntegerSheafGlobalSectionsColimitCocone_naturality h }

/-- The colimit of the global sections of the system `j_{n,*}\underline{Z}`. -/
noncomputable abbrev tailPushforwardIntegerSheafGlobalSectionsColimit : AddCommGrpCat :=
  colimit tailPushforwardIntegerSheafGlobalSectionsFunctor

/-- The canonical comparison from the colimit of the global sections of the system
`j_{n,*}\underline{Z}` to `M = \operatorname{colim}_n \prod_{m \ge n} \mathbf{Z}`. -/
noncomputable def tailPushforwardIntegerSheafGlobalSectionsColimitComparison :
    tailPushforwardIntegerSheafGlobalSectionsColimit ⟶
      eventualIntegerSequenceColimit :=
  colimit.desc _ tailPushforwardIntegerSheafGlobalSectionsColimitCocone

/-- The canonical comparison from the global sections of the example sheaf to the direct sum of its
two skyscraper values. -/
public noncomputable def twoClosedPointsSkyscraperPairGlobalSectionsComparison :
    ((sheafSections JX AddCommGrpCat).obj (op ⊤)).obj twoClosedPointsSkyscraperPairSheaf ⟶
      eventualIntegerSequenceColimit ⊞ eventualIntegerSequenceColimit :=
  Functor.biprodComparison
      ((sheafSections JX AddCommGrpCat).obj (op ⊤))
      (skyscraperSheaf twoClosedPointsS1Point eventualIntegerSequenceColimit)
      (skyscraperSheaf twoClosedPointsS2Point eventualIntegerSequenceColimit) ≫
    biprod.map s1SkyscraperGlobalSectionsToValue s2SkyscraperGlobalSectionsToValue

public theorem tailAllGenericsMem_of_s1_mem {U : Opens twoClosedPointsSpace}
    (hU : twoClosedPointsS1Point ∈ U) :
    ∀ m : ℕ, xi m ∈ U := by
  change s1 ∈ (U : Set TwoClosedPointsPoint) at hU
  have hOpen :
      TopologicalSpace.GenerateOpen
        {V | (∃ n : ℕ, V = ({xi n} : Set TwoClosedPointsPoint)) ∨
            V = twoClosedPointsS1BasicOpen ∨ V = twoClosedPointsS2BasicOpen}
        (U : Set TwoClosedPointsPoint) := by
    change IsOpen (U : Set TwoClosedPointsPoint)
    exact U.2
  -- Induct on the generated-open proof; only the `s1`-basic generator can contain `s1`.
  have hs1_mem :
      ∀ {V : Set TwoClosedPointsPoint},
        TopologicalSpace.GenerateOpen
          {W | (∃ n : ℕ, W = ({xi n} : Set TwoClosedPointsPoint)) ∨
              W = twoClosedPointsS1BasicOpen ∨ W = twoClosedPointsS2BasicOpen}
          V →
        s1 ∈ V → ∀ m : ℕ, xi m ∈ V := by
    intro V hV
    induction hV with
    | basic W hW =>
        rcases hW with hW | hW
        · rcases hW with ⟨n, rfl⟩
          intro hS1 m
          have : False := by
            simp at hS1
          exact False.elim this
        · rcases hW with rfl | rfl
          · intro _ m
            exact Or.inr ⟨m, rfl⟩
          · intro hS1 m
            have : False := by
              simpa [twoClosedPointsS2BasicOpen, twoClosedPointsXiSet] using hS1
            exact False.elim this
    | univ =>
        intro _ m
        simp
    | inter S T hS hT ihS ihT =>
        intro hST m
        exact ⟨ihS hST.1 m, ihT hST.2 m⟩
    | sUnion 𝒰 h𝒰 ih =>
        intro hUnion m
        rcases Set.mem_sUnion.1 hUnion with ⟨V, hV, hMem⟩
        exact Set.mem_sUnion.2 ⟨V, hV, ih V hV hMem m⟩
  exact hs1_mem hOpen hU

public theorem tailAllGenericsMem_of_s2_mem {U : Opens twoClosedPointsSpace}
    (hU : twoClosedPointsS2Point ∈ U) :
    ∀ m : ℕ, xi m ∈ U := by
  change s2 ∈ (U : Set TwoClosedPointsPoint) at hU
  have hOpen :
      TopologicalSpace.GenerateOpen
        {V | (∃ n : ℕ, V = ({xi n} : Set TwoClosedPointsPoint)) ∨
            V = twoClosedPointsS1BasicOpen ∨ V = twoClosedPointsS2BasicOpen}
        (U : Set TwoClosedPointsPoint) := by
    change IsOpen (U : Set TwoClosedPointsPoint)
    exact U.2
  -- Induct on the generated-open proof; only the `s2`-basic generator can contain `s2`.
  have hs2_mem :
      ∀ {V : Set TwoClosedPointsPoint},
        TopologicalSpace.GenerateOpen
          {W | (∃ n : ℕ, W = ({xi n} : Set TwoClosedPointsPoint)) ∨
              W = twoClosedPointsS1BasicOpen ∨ W = twoClosedPointsS2BasicOpen}
          V →
        s2 ∈ V → ∀ m : ℕ, xi m ∈ V := by
    intro V hV
    induction hV with
    | basic W hW =>
        rcases hW with hW | hW
        · rcases hW with ⟨n, rfl⟩
          intro hS2 m
          have : False := by
            simp at hS2
          exact False.elim this
        · rcases hW with rfl | rfl
          · intro hS2 m
            have : False := by
              simpa [twoClosedPointsS1BasicOpen, twoClosedPointsXiSet] using hS2
            exact False.elim this
          · intro _ m
            exact Or.inr ⟨m, rfl⟩
    | univ =>
        intro _ m
        simp
    | inter S T hS hT ihS ihT =>
        intro hST m
        exact ⟨ihS hST.1 m, ihT hST.2 m⟩
    | sUnion 𝒰 h𝒰 ih =>
        intro hUnion m
        rcases Set.mem_sUnion.1 hUnion with ⟨V, hV, hMem⟩
        exact Set.mem_sUnion.2 ⟨V, hV, ih V hV hMem m⟩
  exact hs2_mem hOpen hU

public noncomputable def tailSectionValueToColimitOfS1Mem (n : ℕ)
    {U : Opens twoClosedPointsSpace} (hU : twoClosedPointsS1Point ∈ U) :
    tailSectionValue n U ⟶ eventualIntegerSequenceColimit :=
  AddCommGrpCat.ofHom
    { toFun := fun f ↦
        colimit.ι tailIntegerProductFunctor n
          (fun x ↦ f ⟨x.1, x.2, tailAllGenericsMem_of_s1_mem hU x.1⟩)
      map_zero' := by
        -- The zero section maps to the zero element of the colimit.
        change (colimit.ι tailIntegerProductFunctor n) 0 = 0
        exact (colimit.ι tailIntegerProductFunctor n).hom.map_zero
      map_add' := by
        intro a b
        -- Addition is computed pointwise before passing to the colimit cocone map.
        change
          (colimit.ι tailIntegerProductFunctor n)
              ((fun x ↦ a ⟨x.1, x.2, tailAllGenericsMem_of_s1_mem hU x.1⟩) +
                fun x ↦ b ⟨x.1, x.2, tailAllGenericsMem_of_s1_mem hU x.1⟩) =
            (colimit.ι tailIntegerProductFunctor n)
                (fun x ↦ a ⟨x.1, x.2, tailAllGenericsMem_of_s1_mem hU x.1⟩) +
              (colimit.ι tailIntegerProductFunctor n)
                (fun x ↦ b ⟨x.1, x.2, tailAllGenericsMem_of_s1_mem hU x.1⟩)
        exact
          (colimit.ι tailIntegerProductFunctor n).hom.map_add
            (fun x ↦ a ⟨x.1, x.2, tailAllGenericsMem_of_s1_mem hU x.1⟩)
            (fun x ↦ b ⟨x.1, x.2, tailAllGenericsMem_of_s1_mem hU x.1⟩) }

public noncomputable def tailSectionValueToColimitOfS2Mem (n : ℕ)
    {U : Opens twoClosedPointsSpace} (hU : twoClosedPointsS2Point ∈ U) :
    tailSectionValue n U ⟶ eventualIntegerSequenceColimit :=
  AddCommGrpCat.ofHom
    { toFun := fun f ↦
        colimit.ι tailIntegerProductFunctor n
          (fun x ↦ f ⟨x.1, x.2, tailAllGenericsMem_of_s2_mem hU x.1⟩)
      map_zero' := by
        -- The zero section maps to the zero element of the colimit.
        change (colimit.ι tailIntegerProductFunctor n) 0 = 0
        exact (colimit.ι tailIntegerProductFunctor n).hom.map_zero
      map_add' := by
        intro a b
        -- Addition is computed pointwise before passing to the colimit cocone map.
        change
          (colimit.ι tailIntegerProductFunctor n)
              ((fun x ↦ a ⟨x.1, x.2, tailAllGenericsMem_of_s2_mem hU x.1⟩) +
                fun x ↦ b ⟨x.1, x.2, tailAllGenericsMem_of_s2_mem hU x.1⟩) =
            (colimit.ι tailIntegerProductFunctor n)
                (fun x ↦ a ⟨x.1, x.2, tailAllGenericsMem_of_s2_mem hU x.1⟩) +
              (colimit.ι tailIntegerProductFunctor n)
                (fun x ↦ b ⟨x.1, x.2, tailAllGenericsMem_of_s2_mem hU x.1⟩)
        exact
