/-- Helper for Example 6.29.2: the stalk-to-basic-sections identification at `s1` is natural in
the stage `n`. -/
private theorem tailPushforwardIntegerSheafModelStalkS1IsoToBasicSections_naturality {i j : ℕ}
    (h : i ⟶ j) :
    ((TopCat.Sheaf.forget AddCommGrpCat twoClosedPointsSpace ⋙
          TopCat.Presheaf.stalkFunctor AddCommGrpCat twoClosedPointsS1Point).map
        (tailPushforwardIntegerSheafModelMap h.down.down)) ≫
      (tailPushforwardIntegerSheafModelStalkS1IsoToBasicSections j).hom =
    (tailPushforwardIntegerSheafModelStalkS1IsoToBasicSections i).hom ≫
      (tailPushforwardIntegerSheafModelMap h.down.down).hom.app (op twoClosedPointsS1BasicOpens) := by
  -- Cancel the source germ so the stalk map is compared directly with the section map on the
  -- minimal `s1` neighborhood.
  apply (cancel_epi (tailPushforwardIntegerSheafModelStalkS1IsoToBasicSections i).inv).1
  have htransport :
      (tailPushforwardIntegerSheafModelStalkS1IsoToBasicSections i).inv ≫
          ((TopCat.Sheaf.forget AddCommGrpCat twoClosedPointsSpace ⋙
                TopCat.Presheaf.stalkFunctor AddCommGrpCat twoClosedPointsS1Point).map
              (tailPushforwardIntegerSheafModelMap h.down.down)) ≫
            (tailPushforwardIntegerSheafModelStalkS1IsoToBasicSections j).hom =
        (tailPushforwardIntegerSheafModelMap h.down.down).hom.app
          (op twoClosedPointsS1BasicOpens) := by
    have hmap_germ :
        (tailPushforwardIntegerSheafModelStalkS1IsoToBasicSections i).inv ≫
            ((TopCat.Sheaf.forget AddCommGrpCat twoClosedPointsSpace ⋙
                  TopCat.Presheaf.stalkFunctor AddCommGrpCat twoClosedPointsS1Point).map
                (tailPushforwardIntegerSheafModelMap h.down.down)) ≫
              (tailPushforwardIntegerSheafModelStalkS1IsoToBasicSections j).hom =
          ((tailPushforwardIntegerSheafModelMap h.down.down).hom.app
              (op twoClosedPointsS1BasicOpens) ≫
            (tailPushforwardIntegerSheafModelStalkS1IsoToBasicSections j).inv) ≫
              (tailPushforwardIntegerSheafModelStalkS1IsoToBasicSections j).hom := by
      -- The germ/stalk compatibility theorem rewrites the stalk map into the section map followed
      -- by the target germ.
      simpa [tailPushforwardIntegerSheafModelStalkS1IsoToBasicSections, Category.assoc] using
        congrArg
          (fun k ↦ k ≫ (tailPushforwardIntegerSheafModelStalkS1IsoToBasicSections j).hom)
          (TopCat.Presheaf.stalkFunctor_map_germ
            (C := AddCommGrpCat) (U := twoClosedPointsS1BasicOpens)
            (x := twoClosedPointsS1Point) (hx := twoClosedPointsS1Point_mem_s1_basic)
            (tailPushforwardIntegerSheafModelMap h.down.down).hom)
    have hpost :
        ((tailPushforwardIntegerSheafModelMap h.down.down).hom.app
            (op twoClosedPointsS1BasicOpens) ≫
          (tailPushforwardIntegerSheafModelStalkS1IsoToBasicSections j).inv) ≫
            (tailPushforwardIntegerSheafModelStalkS1IsoToBasicSections j).hom =
          (tailPushforwardIntegerSheafModelMap h.down.down).hom.app
            (op twoClosedPointsS1BasicOpens) := by
      simpa only [Category.assoc] using
        congrArg
          (fun k ↦
            (tailPushforwardIntegerSheafModelMap h.down.down).hom.app
              (op twoClosedPointsS1BasicOpens) ≫ k)
          (Iso.inv_hom_id (tailPushforwardIntegerSheafModelStalkS1IsoToBasicSections j))
    exact hmap_germ.trans hpost
  have hcancel :
      (tailPushforwardIntegerSheafModelMap h.down.down).hom.app (op twoClosedPointsS1BasicOpens) =
        (tailPushforwardIntegerSheafModelStalkS1IsoToBasicSections i).inv ≫
          (tailPushforwardIntegerSheafModelStalkS1IsoToBasicSections i).hom ≫
            (tailPushforwardIntegerSheafModelMap h.down.down).hom.app
              (op twoClosedPointsS1BasicOpens) := by
    symm
    simpa only [Category.assoc] using
      congrArg
        (fun k ↦
          k ≫ (tailPushforwardIntegerSheafModelMap h.down.down).hom.app
            (op twoClosedPointsS1BasicOpens))
        (Iso.inv_hom_id (tailPushforwardIntegerSheafModelStalkS1IsoToBasicSections i))
  exact htransport.trans hcancel

/-- Helper for Example 6.29.2: the stalk-to-basic-sections identification at `s2` is natural in
the stage `n`. -/
private theorem tailPushforwardIntegerSheafModelStalkS2IsoToBasicSections_naturality {i j : ℕ}
    (h : i ⟶ j) :
    ((TopCat.Sheaf.forget AddCommGrpCat twoClosedPointsSpace ⋙
          TopCat.Presheaf.stalkFunctor AddCommGrpCat twoClosedPointsS2Point).map
        (tailPushforwardIntegerSheafModelMap h.down.down)) ≫
