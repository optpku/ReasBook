          rfl
        map_add' := by
          intro a b
          ext x
          rfl }
  let inv :
      tailIntegerProduct n ⟶ tailSectionValue n twoClosedPointsS2BasicOpens :=
    AddCommGrpCat.ofHom
      { toFun := fun f x ↦ f ⟨x.1, x.2.1⟩
        map_zero' := by
          ext x
          rfl
        map_add' := by
          intro a b
          ext x
          rfl }
  refine ⟨⟨hom, inv, ?_, ?_⟩⟩
  · -- The `s2`-basic neighborhood contains every generic point `ξ_m`, so the same tail-index
    -- normalization works verbatim.
    ext f x
    rfl
  · -- As for `s1`, the section data only remembers the tail index and its value.
    ext f x
    rfl

/-- Helper for Example 6.29.2: the minimal `s1`-neighborhood contains the closed point `s1`. -/
