      (fun k ↦
        k (fun x ↦ f ⟨x.1, x.2, tailAllGenericsMem_of_s2_mem hU x.1⟩))
      (colimit.w tailIntegerProductFunctor (homOfLE hij))

/-- Helper for Example 6.29.2: the stage maps of the explicit tail-function model commute with the
comparison to the `s1` skyscraper summand. -/
private theorem tailPushforwardIntegerSheafModelToS1Skyscraper_stage_naturality {i j : ℕ}
    (h : i ⟶ j) :
    tailPushforwardIntegerSheafModelMap h.down.down ≫
      tailPushforwardIntegerSheafModelToS1Skyscraper j =
      tailPushforwardIntegerSheafModelToS1Skyscraper i := by
  -- Route correction: first normalize the positive branch on each open to a raw colimit relation,
  -- then use terminal uniqueness for the negative branch.
  apply Sheaf.hom_ext
  apply NatTrans.ext
  funext U
  classical
  by_cases hU : twoClosedPointsS1Point ∈ U.unop
  · -- On opens containing `s1`, both skyscraper branches are the same `eqToHom` transport.
    change
      (tailPushforwardIntegerSheafModelMap h.down.down).hom.app U ≫
          (tailPushforwardIntegerSheafModelToS1Skyscraper j).hom.app U =
        (tailPushforwardIntegerSheafModelToS1Skyscraper i).hom.app U
    simpa [tailPushforwardIntegerSheafModelToS1Skyscraper, hU, Category.assoc] using
      congrArg
        (fun k ↦ k ≫ eqToHom (if_pos hU).symm)
        (tailSectionValueToColimitOfS1Mem_stage_comp (U := U.unop) h.down.down hU)
  · -- On opens avoiding `s1`, both maps factor through the terminal section object.
    change
      (tailPushforwardIntegerSheafModelMap h.down.down).hom.app U ≫
          (tailPushforwardIntegerSheafModelToS1Skyscraper j).hom.app U =
        (tailPushforwardIntegerSheafModelToS1Skyscraper i).hom.app U
    have hterminal :
        (tailPushforwardIntegerSheafModelMap h.down.down).hom.app U ≫ terminal.from _ =
          terminal.from _ := by
      exact terminalIsTerminal.hom_ext _ _
    simpa [tailPushforwardIntegerSheafModelToS1Skyscraper, hU, Category.assoc] using
      congrArg
        (fun k ↦ k ≫ eqToHom (if_neg hU).symm)
        hterminal

/-- Helper for Example 6.29.2: the stage maps of the explicit tail-function model commute with the
comparison to the `s2` skyscraper summand. -/
private theorem tailPushforwardIntegerSheafModelToS2Skyscraper_stage_naturality {i j : ℕ}
    (h : i ⟶ j) :
    tailPushforwardIntegerSheafModelMap h.down.down ≫
      tailPushforwardIntegerSheafModelToS2Skyscraper j =
      tailPushforwardIntegerSheafModelToS2Skyscraper i := by
  -- Repeat the normalized-open-set argument with `s2` in place of `s1`.
  apply Sheaf.hom_ext
  apply NatTrans.ext
  funext U
  classical
  by_cases hU : twoClosedPointsS2Point ∈ U.unop
  · -- The positive branch is the fixed-open colimit relation for the `s2` component.
    change
      (tailPushforwardIntegerSheafModelMap h.down.down).hom.app U ≫
          (tailPushforwardIntegerSheafModelToS2Skyscraper j).hom.app U =
        (tailPushforwardIntegerSheafModelToS2Skyscraper i).hom.app U
    simpa [tailPushforwardIntegerSheafModelToS2Skyscraper, hU, Category.assoc] using
      congrArg
        (fun k ↦ k ≫ eqToHom (if_pos hU).symm)
        (tailSectionValueToColimitOfS2Mem_stage_comp (U := U.unop) h.down.down hU)
  · -- The negative branch again lands in the terminal section object.
    change
      (tailPushforwardIntegerSheafModelMap h.down.down).hom.app U ≫
          (tailPushforwardIntegerSheafModelToS2Skyscraper j).hom.app U =
        (tailPushforwardIntegerSheafModelToS2Skyscraper i).hom.app U
    have hterminal :
        (tailPushforwardIntegerSheafModelMap h.down.down).hom.app U ≫ terminal.from _ =
          terminal.from _ := by
      exact terminalIsTerminal.hom_ext _ _
    simpa [tailPushforwardIntegerSheafModelToS2Skyscraper, hU, Category.assoc] using
      congrArg
        (fun k ↦ k ≫ eqToHom (if_neg hU).symm)
        hterminal

private theorem tailPushforwardIntegerSheafModelToSkyscraperPair_naturality {i j : ℕ}
    (h : i ⟶ j) :
    tailPushforwardIntegerSheafModelMap h.down.down ≫
      tailPushforwardIntegerSheafModelToSkyscraperPair j =
      tailPushforwardIntegerSheafModelToSkyscraperPair i := by
  -- Reassemble the two component cocone equations with the biproduct extensionality principle.
  apply biprod.hom_ext
  · simpa [tailPushforwardIntegerSheafModelToSkyscraperPair, Category.assoc] using
      tailPushforwardIntegerSheafModelToS1Skyscraper_stage_naturality h
  · simpa [tailPushforwardIntegerSheafModelToSkyscraperPair, Category.assoc] using
      tailPushforwardIntegerSheafModelToS2Skyscraper_stage_naturality h

public noncomputable def tailPushforwardColimitComparisonCocone :
    Cocone tailPushforwardIntegerSheafFunctor where
  pt := twoClosedPointsSkyscraperPairSheaf
  ι :=
    { app := fun n ↦
        tailPushforwardIntegerSheafToModel n ≫
          tailPushforwardIntegerSheafModelToSkyscraperPair n
      naturality := by
        intro i j h
        -- Reassociate the stage transition map and then use the model-pair naturality square.
        simpa [tailPushforwardIntegerSheafFunctor, tailPushforwardIntegerSheafMap, Category.assoc]
          using
            congrArg
              (fun k ↦ tailPushforwardIntegerSheafToModel i ≫ k)
              (tailPushforwardIntegerSheafModelToSkyscraperPair_naturality h) }

/-- The canonical comparison map from `\mathcal{F} = \operatorname{colim}_n j_{n,*}\underline{Z}`
to the skyscraper-pair sheaf of Example 6.29.2. -/
noncomputable def tailPushforwardColimitComparison :
    tailPushforwardIntegerSheafColimit ⟶ twoClosedPointsSkyscraperPairSheaf :=
  colimit.desc _ tailPushforwardColimitComparisonCocone

/-- Helper for Example 6.29.2: the basic open containing `s1` is an open subset of the
two-closed-points space. -/
private theorem twoClosedPointsS1BasicOpen_isOpen :
    IsOpen (twoClosedPointsS1BasicOpen : Set TwoClosedPointsPoint) := by
  exact isOpen_generateFrom_of_mem <| Or.inr <| Or.inl rfl

/-- Helper for Example 6.29.2: the basic open containing `s2` is an open subset of the
two-closed-points space. -/
private theorem twoClosedPointsS2BasicOpen_isOpen :
    IsOpen (twoClosedPointsS2BasicOpen : Set TwoClosedPointsPoint) := by
  exact isOpen_generateFrom_of_mem <| Or.inr <| Or.inr rfl

/-- The minimal open neighborhood of `s1`. -/
private def twoClosedPointsS1BasicOpens : Opens twoClosedPointsSpace :=
  ⟨twoClosedPointsS1BasicOpen, twoClosedPointsS1BasicOpen_isOpen⟩

/-- The minimal open neighborhood of `s2`. -/
private def twoClosedPointsS2BasicOpens : Opens twoClosedPointsSpace :=
  ⟨twoClosedPointsS2BasicOpen, twoClosedPointsS2BasicOpen_isOpen⟩

/-- The singleton open neighborhood of `xi_m`. -/
private def twoClosedPointsXiSingletonOpens (m : ℕ) : Opens twoClosedPointsSpace :=
  ⟨({xi m} : Set TwoClosedPointsPoint), isOpen_generateFrom_of_mem <| Or.inl ⟨m, rfl⟩⟩

/-- Helper for Example 6.29.2: every open neighborhood of `s1` contains the basic open
`S_1 ∪ {xi_m}`. -/
private theorem twoClosedPointsS1BasicOpens_le {U : Opens twoClosedPointsSpace}
    (hU : twoClosedPointsS1Point ∈ U) :
    twoClosedPointsS1BasicOpens ≤ U := by
  intro x hx
  rcases hx with hx | hx
  · cases hx
    exact hU
  · rcases hx with ⟨m, rfl⟩
    exact tailAllGenericsMem_of_s1_mem hU m

/-- Helper for Example 6.29.2: every open neighborhood of `s2` contains the basic open
`S_2 ∪ {xi_m}`. -/
private theorem twoClosedPointsS2BasicOpens_le {U : Opens twoClosedPointsSpace}
    (hU : twoClosedPointsS2Point ∈ U) :
    twoClosedPointsS2BasicOpens ≤ U := by
  intro x hx
  rcases hx with hx | hx
  · cases hx
    exact hU
  · rcases hx with ⟨m, rfl⟩
    exact tailAllGenericsMem_of_s2_mem hU m

/-- Helper for Example 6.29.2: the singleton `{xi_m}` is the minimal open neighborhood of
`xi_m`. -/
private theorem twoClosedPointsXiSingletonOpens_le (m : ℕ) {U : Opens twoClosedPointsSpace}
    (hU : xi m ∈ U) :
    twoClosedPointsXiSingletonOpens m ≤ U := by
  intro x hx
  cases Set.mem_singleton_iff.mp hx
  exact hU

/-- Helper for Example 6.29.2: on a minimal neighborhood, the germ map computes the stalk. -/
private theorem germ_isIso_of_minimal_open
    (F : TopCat.Presheaf AddCommGrpCat twoClosedPointsSpace)
    (x : twoClosedPointsSpace) (U : Opens twoClosedPointsSpace) (hx : x ∈ U)
    (hmin : ∀ V : OpenNhds x, (⟨U, hx⟩ : OpenNhds x) ≤ V) :
    IsIso (F.germ U x hx) := by
  let tU : IsTerminal (Opposite.op (⟨U, hx⟩ : OpenNhds x) : (OpenNhds x)ᵒᵖ) :=
    IsTerminal.ofUniqueHom
      (fun V ↦ (homOfLE (hmin V.unop)).op)
      (fun V m ↦ Subsingleton.elim _ _)
  -- The minimal neighborhood is terminal in the opposite neighborhood category, so its colimit
  -- leg is the germ isomorphism.
  simpa [TopCat.Presheaf.germ] using
    (IsColimit.isIso_ι_app_of_isTerminal
      (hc := colimit.isColimit (((OpenNhds.inclusion x).op) ⋙ F))
      (X := Opposite.op (⟨U, hx⟩ : OpenNhds x)) tU)

/-- Helper for Example 6.29.2: the `s1`-basic open computes stalks at `s1`. -/
private theorem germ_s1_basic_isIso
    (F : TopCat.Presheaf AddCommGrpCat twoClosedPointsSpace) :
    IsIso (F.germ twoClosedPointsS1BasicOpens twoClosedPointsS1Point (by
      change s1 ∈ twoClosedPointsS1BasicOpen
      exact Or.inl rfl)) := by
  -- The basic open around `s1` is the minimal neighborhood of `s1`.
  apply germ_isIso_of_minimal_open
  intro V
  exact twoClosedPointsS1BasicOpens_le V.2

/-- Helper for Example 6.29.2: the `s2`-basic open computes stalks at `s2`. -/
private theorem germ_s2_basic_isIso
    (F : TopCat.Presheaf AddCommGrpCat twoClosedPointsSpace) :
    IsIso (F.germ twoClosedPointsS2BasicOpens twoClosedPointsS2Point (by
      change s2 ∈ twoClosedPointsS2BasicOpen
      exact Or.inl rfl)) := by
  -- The basic open around `s2` is the minimal neighborhood of `s2`.
  apply germ_isIso_of_minimal_open
  intro V
  exact twoClosedPointsS2BasicOpens_le V.2

/-- Helper for Example 6.29.2: the singleton open `{xi_m}` computes stalks at `xi_m`. -/
private theorem germ_xi_singleton_isIso
    (F : TopCat.Presheaf AddCommGrpCat twoClosedPointsSpace) (m : ℕ) :
    IsIso (F.germ (twoClosedPointsXiSingletonOpens m) (xi m) (by
      change xi m ∈ ({xi m} : Set TwoClosedPointsPoint)
      simp)) := by
  -- The singleton `{xi_m}` is the minimal neighborhood of the generic point `xi_m`.
  apply germ_isIso_of_minimal_open
  intro V
  exact twoClosedPointsXiSingletonOpens_le m V.2

/-- Helper for Example 6.29.2: sections of the explicit tail-function model on the minimal
`s1`-neighborhood are exactly integer-valued functions on the tail indices `m ≥ n`. -/
private theorem tailSectionValue_s1_basic_nonempty_iso (n : ℕ) :
    Nonempty (tailSectionValue n twoClosedPointsS1BasicOpens ≅ tailIntegerProduct n) := by
  let hom :
      tailSectionValue n twoClosedPointsS1BasicOpens ⟶ tailIntegerProduct n :=
    AddCommGrpCat.ofHom
      { toFun := fun f x ↦ f ⟨x.1, x.2, Or.inr ⟨x.1, rfl⟩⟩
        map_zero' := by
          ext x
          rfl
        map_add' := by
          intro a b
          ext x
          rfl }
  let inv :
      tailIntegerProduct n ⟶ tailSectionValue n twoClosedPointsS1BasicOpens :=
    AddCommGrpCat.ofHom
      { toFun := fun f x ↦ f ⟨x.1, x.2.1⟩
        map_zero' := by
          ext x
          rfl
        map_add' := by
          intro a b
          ext x
          rfl }
  refine ⟨⟨hom, inv, ?_, ?_⟩⟩
  · -- Forgetting the redundant proof that `ξ_m` lies in the basic `s1`-neighborhood recovers the
    -- original tail-indexed sequence.
    ext f x
    rfl
  · -- Any section on the basic `s1`-neighborhood is determined by the underlying tail index.
    ext f x
    rfl

/-- Helper for Example 6.29.2: sections of the explicit tail-function model on the minimal
`s2`-neighborhood are exactly integer-valued functions on the tail indices `m ≥ n`. -/
private theorem tailSectionValue_s2_basic_nonempty_iso (n : ℕ) :
    Nonempty (tailSectionValue n twoClosedPointsS2BasicOpens ≅ tailIntegerProduct n) := by
  let hom :
      tailSectionValue n twoClosedPointsS2BasicOpens ⟶ tailIntegerProduct n :=
    AddCommGrpCat.ofHom
      { toFun := fun f x ↦ f ⟨x.1, x.2, Or.inr ⟨x.1, rfl⟩⟩
        map_zero' := by
