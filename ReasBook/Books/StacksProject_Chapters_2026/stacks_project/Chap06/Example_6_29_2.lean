/-- Helper for Example 6.29.2: transporting a stalk map across the inverse of a germ isomorphism on
a minimal neighborhood identifies the stalk map with the literal section map on that open. -/
private theorem minimal_neighborhood_stalk_inv_naturality
    {F G : TopCat.Presheaf AddCommGrpCat twoClosedPointsSpace}
    {x : twoClosedPointsSpace} {U : Opens twoClosedPointsSpace} (hx : x ∈ U)
    [IsIso (F.germ U x hx)] [IsIso (G.germ U x hx)] (φ : F ⟶ G) :
    ((TopCat.Presheaf.stalkFunctor AddCommGrpCat x).map φ) ≫ (asIso (G.germ U x hx)).inv =
      (asIso (F.germ U x hx)).inv ≫ φ.app (op U) := by
  -- Precompose with the source germ and use the standard compatibility of stalk maps with germs.
  apply (cancel_epi (asIso (F.germ U x hx)).hom).1
  simpa [Category.assoc] using
    congrArg
      (fun k ↦ k ≫ (asIso (G.germ U x hx)).inv)
      (TopCat.Presheaf.stalkFunctor_map_germ
        (C := AddCommGrpCat) (U := U) (x := x) (hx := hx) φ)

