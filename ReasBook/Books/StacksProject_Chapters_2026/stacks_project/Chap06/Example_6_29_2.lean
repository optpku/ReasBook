/-- Helper for Example 6.29.2: restricting the explicit model to the minimal `s1`-neighborhood
matches the tail-product transition maps. -/
private theorem tailSectionValueS1BasicIso_naturality {i j : ℕ} (h : i ⟶ j) :
    (tailPushforwardIntegerSheafModelMap h.down.down).hom.app (op twoClosedPointsS1BasicOpens) ≫
      (tailSectionValueS1BasicIso j).hom =
    (tailSectionValueS1BasicIso i).hom ≫ tailIntegerProductFunctor.map h := by
  -- On the minimal `s1`-neighborhood, both sides just forget the redundant membership proof.
  ext f x
  rfl

