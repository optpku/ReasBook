/-- Helper for Example 6.29.2: the closed point `s2` does not specialize to `s1`. -/
private theorem twoClosedPointsS2_not_specializes_s1 :
    ¬ twoClosedPointsS2Point ⤳ twoClosedPointsS1Point := by
  -- The minimal `s1`-neighborhood contains `s1` but excludes `s2`.
  intro hs
  have hs_mem : twoClosedPointsS2Point ∈ twoClosedPointsS1BasicOpens := by
    exact hs.mem_open twoClosedPointsS1BasicOpens.2 twoClosedPointsS1Point_mem_s1_basic
  change s2 ∈ twoClosedPointsS1BasicOpen at hs_mem
  simp [twoClosedPointsS1BasicOpen, twoClosedPointsXiSet] at hs_mem

/-- Helper for Example 6.29.2: the closed point `s1` does not specialize to `s2`. -/
private theorem twoClosedPointsS1_not_specializes_s2 :
    ¬ twoClosedPointsS1Point ⤳ twoClosedPointsS2Point := by
  -- The minimal `s2`-neighborhood contains `s2` but excludes `s1`.
  intro hs
  have hs_mem : twoClosedPointsS1Point ∈ twoClosedPointsS2BasicOpens := by
    exact hs.mem_open twoClosedPointsS2BasicOpens.2 twoClosedPointsS2Point_mem_s2_basic
  change s1 ∈ twoClosedPointsS2BasicOpen at hs_mem
  simp [twoClosedPointsS2BasicOpen, twoClosedPointsXiSet] at hs_mem

/-- Helper for Example 6.29.2: once the tail starts strictly after `ξ_m`, the singleton
neighborhood `{ξ_m}` supports only the zero section object. -/
private theorem tailSectionValue_xi_singleton_nonempty_iso_punit_of_lt {m n : ℕ} (h : m < n) :
    Nonempty (tailSectionValue n (twoClosedPointsXiSingletonOpens m) ≅ AddCommGrpCat.of PUnit) := by
  let hom :
      tailSectionValue n (twoClosedPointsXiSingletonOpens m) ⟶ AddCommGrpCat.of PUnit :=
    AddCommGrpCat.ofHom
      { toFun := fun _ ↦ PUnit.unit
        map_zero' := rfl
        map_add' := by
          intro a b
          rfl }
  let inv :
      AddCommGrpCat.of PUnit ⟶ tailSectionValue n (twoClosedPointsXiSingletonOpens m) :=
    AddCommGrpCat.ofHom
      { toFun := fun _ x ↦ nomatch (by
            rcases x with ⟨k, hkn, hkmem⟩
            have hk : k = m := by
              simpa [twoClosedPointsXiSingletonOpens] using hkmem
            exact h.not_ge (hk ▸ hkn) : False)
        map_zero' := by
          ext x
          exact False.elim (by
            rcases x with ⟨k, hkn, hkmem⟩
            have hk : k = m := by
              simpa [twoClosedPointsXiSingletonOpens] using hkmem
            exact h.not_ge (hk ▸ hkn))
        map_add' := by
          intro a b
          ext x
          exact False.elim (by
            rcases x with ⟨k, hkn, hkmem⟩
            have hk : k = m := by
              simpa [twoClosedPointsXiSingletonOpens] using hkmem
            exact h.not_ge (hk ▸ hkn)) }
  refine ⟨⟨hom, inv, ?_, ?_⟩⟩
  · -- The target is the terminal one-point group, so the round-trip is forced.
    ext u x
    exact False.elim (by
      rcases x with ⟨k, hkn, hkmem⟩
      have hk : k = m := by
        simpa [twoClosedPointsXiSingletonOpens] using hkmem
      exact h.not_ge (hk ▸ hkn))
  · -- There are no valid tail indices on `{ξ_m}` once `n > m`, so the source has a unique
    -- section and the inverse composite is trivial.
    ext u

/-- Helper for Example 6.29.2: the closed point `s1` does not specialize to any generic point
`ξ_m`. -/
private theorem twoClosedPointsS1_not_specializes_xi (m : ℕ) :
    ¬ twoClosedPointsS1Point ⤳ xi m := by
  -- The singleton neighborhood `{ξ_m}` contains `ξ_m` but excludes `s1`, so specialization fails.
  intro hs
  have hs_mem :
      twoClosedPointsS1Point ∈ twoClosedPointsXiSingletonOpens m := by
    exact hs.mem_open (twoClosedPointsXiSingletonOpens m).2 (by
      change xi m ∈ ({xi m} : Set TwoClosedPointsPoint)
      simp)
  change s1 ∈ ({xi m} : Set TwoClosedPointsPoint) at hs_mem
  simp at hs_mem

/-- Helper for Example 6.29.2: the closed point `s2` does not specialize to any generic point
`ξ_m`. -/
private theorem twoClosedPointsS2_not_specializes_xi (m : ℕ) :
    ¬ twoClosedPointsS2Point ⤳ xi m := by
  -- The same singleton-neighborhood argument rules out specialization from `s2` to `ξ_m`.
  intro hs
  have hs_mem :
      twoClosedPointsS2Point ∈ twoClosedPointsXiSingletonOpens m := by
    exact hs.mem_open (twoClosedPointsXiSingletonOpens m).2 (by
      change xi m ∈ ({xi m} : Set TwoClosedPointsPoint)
      simp)
  change s2 ∈ ({xi m} : Set TwoClosedPointsPoint) at hs_mem
  simp at hs_mem

/-- Helper for Example 6.29.2: the stalk diagram at `ξ_m` is the filtered system obtained by
applying the stalk functor at `ξ_m` to the tail pushforward sheaves. -/
private noncomputable abbrev tailPushforwardIntegerSheafStalkXiFunctor (m : ℕ) :
    ℕ ⥤ AddCommGrpCat :=
  tailPushforwardIntegerSheafFunctor ⋙
    TopCat.Sheaf.forget AddCommGrpCat twoClosedPointsSpace ⋙
      TopCat.Presheaf.stalkFunctor AddCommGrpCat (twoClosedPointsXiPoint m)

/-- Helper for Example 6.29.2: after stage `m + 1`, the `ξ_m`-stalk of `j_{n,*}\underline{Z}` is
zero. -/
private theorem tailPushforwardIntegerSheafStageStalkXi_isZero {m n : ℕ} (h : m + 1 ≤ n) :
    IsZero ((tailPushforwardIntegerSheafStalkXiFunctor m).obj n) := by
  let G :=
    TopCat.Sheaf.forget AddCommGrpCat twoClosedPointsSpace ⋙
      TopCat.Presheaf.stalkFunctor AddCommGrpCat (twoClosedPointsXiPoint m)
  let emodel : G.obj (tailPushforwardIntegerSheaf n) ≅
      G.obj (tailPushforwardIntegerSheafModel n) :=
    G.mapIso (tailPushforwardIntegerSheafModelIso n)
  let egerm :
      G.obj (tailPushforwardIntegerSheafModel n) ≅
        tailSectionValue n (twoClosedPointsXiSingletonOpens m) :=
    by
      let g :=
        (tailPushforwardIntegerSheafModel n).presheaf.germ
          (twoClosedPointsXiSingletonOpens m) (xi m) (by
            change xi m ∈ ({xi m} : Set TwoClosedPointsPoint)
            simp)
      haveI : IsIso g := germ_xi_singleton_isIso ((tailPushforwardIntegerSheafModel n).presheaf) m
      exact (asIso g).symm
  let esections :
      tailSectionValue n (twoClosedPointsXiSingletonOpens m) ≅ AddCommGrpCat.of PUnit :=
    Classical.choice
      (tailSectionValue_xi_singleton_nonempty_iso_punit_of_lt
        (lt_of_lt_of_le (Nat.lt_succ_self m) h))
  have hPUnit : IsZero (AddCommGrpCat.of PUnit) := AddCommGrpCat.isZero_of_subsingleton _
  -- The minimal singleton neighborhood computes the stalk, and that section object is terminal.
  simpa using hPUnit.of_iso (emodel ≪≫ egerm ≪≫ esections)

/-- Helper for Example 6.29.2: the eventual-zero `ξ_m`-stalk diagram has a canonical zero cocone. -/
private noncomputable def tailPushforwardIntegerSheafStalkXiZeroCocone (m : ℕ) :
    Cocone (tailPushforwardIntegerSheafStalkXiFunctor m) where
  pt := AddCommGrpCat.of PUnit
  ι :=
    { app := fun _ ↦ 0
      naturality := by
        intro i j h
        ext x
        rfl }

/-- Helper for Example 6.29.2: the zero cocone on the `ξ_m`-stalk diagram is colimiting because
every leg factors through the zero stage `m + 1`. -/
private noncomputable def tailPushforwardIntegerSheafStalkXiZeroCoconeIsColimit (m : ℕ) :
    IsColimit (tailPushforwardIntegerSheafStalkXiZeroCocone m) where
  desc s := 0
  fac s n := by
    -- Any cocone leg becomes zero after passing to the stage `max n (m + 1)`, whose source stalk
    -- already vanishes.
    have hzeroStage :
        s.ι.app (max n (m + 1)) = 0 := by
      let hzero :
          IsZero ((tailPushforwardIntegerSheafStalkXiFunctor m).obj (max n (m + 1))) :=
        tailPushforwardIntegerSheafStageStalkXi_isZero (m := m)
          (n := max n (m + 1)) (Nat.le_max_right n (m + 1))
      exact hzero.eq_of_src _ _
    have hleg :
        s.ι.app n = 0 := by
      calc
        s.ι.app n =
            (tailPushforwardIntegerSheafStalkXiFunctor m).map
                (homOfLE (Nat.le_max_left n (m + 1))) ≫
              s.ι.app (max n (m + 1)) := by
              simpa using (s.w (homOfLE (Nat.le_max_left n (m + 1)))).symm
        _ = 0 := by
          rw [hzeroStage]
          ext x
          rfl
    change (0 : (tailPushforwardIntegerSheafStalkXiFunctor m).obj n ⟶ AddCommGrpCat.of PUnit) ≫
        (0 : AddCommGrpCat.of PUnit ⟶ s.pt) =
      s.ι.app n
    rw [hleg]
    ext x
    rfl
  uniq s f hf := by
    -- The cocone point is the zero object in `AddCommGrpCat`, so every outgoing morphism is equal.
    let hPUnit : IsZero (AddCommGrpCat.of PUnit) := AddCommGrpCat.isZero_of_subsingleton _
    change f = (0 : AddCommGrpCat.of PUnit ⟶ s.pt)
    exact hPUnit.eq_of_src f 0

/-- Helper for Example 6.29.2: the source stalk of the colimit sheaf at `ξ_m` is zero. -/
private theorem tailPushforwardIntegerSheafColimitStalkXi_isZero (m : ℕ) :
    IsZero
      (((TopCat.Sheaf.forget AddCommGrpCat twoClosedPointsSpace ⋙
            TopCat.Presheaf.stalkFunctor AddCommGrpCat (twoClosedPointsXiPoint m)).obj
          tailPushforwardIntegerSheafColimit)) := by
  let G :=
    TopCat.Sheaf.forget AddCommGrpCat twoClosedPointsSpace ⋙
      TopCat.Presheaf.stalkFunctor AddCommGrpCat (twoClosedPointsXiPoint m)
  let e :
      G.obj tailPushforwardIntegerSheafColimit ≅ AddCommGrpCat.of PUnit :=
    preservesColimitIso G tailPushforwardIntegerSheafFunctor ≪≫
      colimit.isoColimitCocone
        ⟨tailPushforwardIntegerSheafStalkXiZeroCocone m,
          tailPushforwardIntegerSheafStalkXiZeroCoconeIsColimit m⟩
  have hPUnit : IsZero (AddCommGrpCat.of PUnit) := AddCommGrpCat.isZero_of_subsingleton _
  -- Transport the explicit zero colimit of the stalk diagram back to the stalk of the sheaf
  -- colimit.
  simpa [G] using hPUnit.of_iso e

/-- Helper for Example 6.29.2: the target skyscraper-pair stalk at `ξ_m` is zero because neither
closed point specializes to `ξ_m`. -/
private theorem twoClosedPointsSkyscraperPairStalkXi_isZero (m : ℕ) :
    IsZero
      (((TopCat.Sheaf.forget AddCommGrpCat twoClosedPointsSpace ⋙
            TopCat.Presheaf.stalkFunctor AddCommGrpCat (twoClosedPointsXiPoint m)).obj
          twoClosedPointsSkyscraperPairSheaf)) := by
  let G :=
    TopCat.Sheaf.forget AddCommGrpCat twoClosedPointsSpace ⋙
      TopCat.Presheaf.stalkFunctor AddCommGrpCat (twoClosedPointsXiPoint m)
  letI : PreservesBinaryBiproducts G :=
    preservesBinaryBiproducts_of_preservesBinaryCoproducts G
  have hs1Terminal :
      IsTerminal
        (G.obj (skyscraperSheaf twoClosedPointsS1Point eventualIntegerSequenceColimit)) := by
    -- The `s1` skyscraper has terminal stalk at `ξ_m` because `s1` does not specialize to `ξ_m`.
    simpa [G] using
      (skyscraperPresheafStalkOfNotSpecializesIsTerminal
        (p₀ := twoClosedPointsS1Point) (A := eventualIntegerSequenceColimit)
        (y := twoClosedPointsXiPoint m) (twoClosedPointsS1_not_specializes_xi m))
  have hs2Terminal :
      IsTerminal
        (G.obj (skyscraperSheaf twoClosedPointsS2Point eventualIntegerSequenceColimit)) := by
    -- The same non-specialization argument identifies the `s2` stalk with the terminal object.
    simpa [G] using
      (skyscraperPresheafStalkOfNotSpecializesIsTerminal
        (p₀ := twoClosedPointsS2Point) (A := eventualIntegerSequenceColimit)
        (y := twoClosedPointsXiPoint m) (twoClosedPointsS2_not_specializes_xi m))
  have hs1 :
      IsZero
        (G.obj (skyscraperSheaf twoClosedPointsS1Point eventualIntegerSequenceColimit)) :=
    hs1Terminal.isZero
  have hs2 :
      IsZero
        (G.obj (skyscraperSheaf twoClosedPointsS2Point eventualIntegerSequenceColimit)) :=
    hs2Terminal.isZero
  have hpair :
      IsZero
        (G.obj (skyscraperSheaf twoClosedPointsS1Point eventualIntegerSequenceColimit) ⊞
          G.obj (skyscraperSheaf twoClosedPointsS2Point eventualIntegerSequenceColimit)) :=
    (biprod_isZero_iff _ _).2 ⟨hs1, hs2⟩
  -- Rewrite the stalk of the sheaf biproduct as the biproduct of the two stalks, then use that
  -- both components are zero.
  simpa [G, twoClosedPointsSkyscraperPairSheaf] using
    (IsZero.of_iso hpair
      (G.mapBiprod
        (skyscraperSheaf twoClosedPointsS1Point eventualIntegerSequenceColimit)
        (skyscraperSheaf twoClosedPointsS2Point eventualIntegerSequenceColimit)))

/-- Helper for Example 6.29.2: the stalk comparison at `ξ_m` is an isomorphism because both the
source and target stalks vanish. -/
private theorem tailPushforwardColimitComparison_stalk_xi_isIso (m : ℕ) :
    IsIso
      ((TopCat.Presheaf.stalkFunctor AddCommGrpCat (twoClosedPointsXiPoint m)).map
        tailPushforwardColimitComparison.hom) := by
  have hsource :
      IsZero
        (((TopCat.Sheaf.forget AddCommGrpCat twoClosedPointsSpace ⋙
              TopCat.Presheaf.stalkFunctor AddCommGrpCat (twoClosedPointsXiPoint m)).obj
            tailPushforwardIntegerSheafColimit)) :=
    tailPushforwardIntegerSheafColimitStalkXi_isZero m
  have htarget :
      IsZero
        (((TopCat.Sheaf.forget AddCommGrpCat twoClosedPointsSpace ⋙
              TopCat.Presheaf.stalkFunctor AddCommGrpCat (twoClosedPointsXiPoint m)).obj
            twoClosedPointsSkyscraperPairSheaf)) :=
    twoClosedPointsSkyscraperPairStalkXi_isZero m
  -- A morphism between zero objects is automatically an isomorphism.
  exact isIso_of_source_target_iso_zero
    ((TopCat.Presheaf.stalkFunctor AddCommGrpCat (twoClosedPointsXiPoint m)).map
      tailPushforwardColimitComparison.hom)
    hsource.isoZero htarget.isoZero

/-- Helper for Example 6.29.2: in `AddCommGrpCat`, a biproduct with zero right summand collapses
onto the left summand. -/
private noncomputable def biprodFstIsoOfIsZero (X Y : AddCommGrpCat) [HasBinaryBiproduct X Y]
    (hY : IsZero Y) : X ⊞ Y ≅ X where
  hom := biprod.fst
  inv := biprod.inl
  hom_inv_id := by
    -- The second projection vanishes because the right summand is zero.
    apply biprod.hom_ext
    · simp
    · have hsnd : (biprod.snd : X ⊞ Y ⟶ Y) = 0 := by
        simpa using hY.eq_of_tgt (biprod.snd : X ⊞ Y ⟶ Y) 0
      simpa [Category.assoc, hsnd]
  inv_hom_id := by
    simp

/-- Helper for Example 6.29.2: in `AddCommGrpCat`, a biproduct with zero left summand collapses
onto the right summand. -/
private noncomputable def biprodSndIsoOfIsZero (X Y : AddCommGrpCat) [HasBinaryBiproduct X Y]
    (hX : IsZero X) : X ⊞ Y ≅ Y where
  hom := biprod.snd
  inv := biprod.inr
  hom_inv_id := by
    -- The first projection vanishes because the left summand is zero.
    apply biprod.hom_ext
    · have hfst : (biprod.fst : X ⊞ Y ⟶ X) = 0 := by
        simpa using hX.eq_of_tgt (biprod.fst : X ⊞ Y ⟶ X) 0
      simpa [Category.assoc, hfst]
    · simp
  inv_hom_id := by
    simp

