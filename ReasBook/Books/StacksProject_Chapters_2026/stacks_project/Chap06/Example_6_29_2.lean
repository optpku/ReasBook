/-- Helper for Example 6.29.2: after precomposing the `s2`-stalk map of the colimit comparison by
the stage `n` leg, the resulting morphism is the normalized `s2` stage isomorphism followed by the
canonical colimit inclusion. -/
private theorem tailPushforwardColimitComparison_stage_leg_s2_normal_form (n : ℕ) :
    colimit.ι tailPushforwardIntegerSheafStalkS2Functor n ≫
      (preservesColimitIso
          (TopCat.Sheaf.forget AddCommGrpCat twoClosedPointsSpace ⋙
            TopCat.Presheaf.stalkFunctor AddCommGrpCat twoClosedPointsS2Point)
          tailPushforwardIntegerSheafFunctor).inv ≫
      ((TopCat.Presheaf.stalkFunctor AddCommGrpCat twoClosedPointsS2Point).map
        tailPushforwardColimitComparison.hom) ≫
      twoClosedPointsSkyscraperPairStalkS2IsoToColimit.hom =
    (tailPushforwardIntegerSheafStalkS2StageIso n).hom ≫
      colimit.ι tailIntegerProductFunctor n := by
  let G :=
    TopCat.Sheaf.forget AddCommGrpCat twoClosedPointsSpace ⋙
      TopCat.Presheaf.stalkFunctor AddCommGrpCat twoClosedPointsS2Point
  -- Normalize the `s2` stage leg by the same colimit-desc and stalk-projection calculation.
  have hmain :
    colimit.ι tailPushforwardIntegerSheafStalkS2Functor n ≫
        (preservesColimitIso G tailPushforwardIntegerSheafFunctor).inv ≫
        G.map tailPushforwardColimitComparison ≫
        twoClosedPointsSkyscraperPairStalkS2IsoToColimit.hom =
      G.map
          (tailPushforwardIntegerSheafToModel n) ≫
        ((tailPushforwardIntegerSheafModelStalkS2IsoToBasicSections n).hom ≫
          tailSectionValueToColimitOfS2Mem n twoClosedPointsS2Point_mem_s2_basic) := by
    have hstart :
        colimit.ι tailPushforwardIntegerSheafStalkS2Functor n ≫
            (preservesColimitIso G tailPushforwardIntegerSheafFunctor).inv ≫
            G.map tailPushforwardColimitComparison ≫
            twoClosedPointsSkyscraperPairStalkS2IsoToColimit.hom =
          G.map (colimit.ι tailPushforwardIntegerSheafFunctor n) ≫
            G.map tailPushforwardColimitComparison ≫
              twoClosedPointsSkyscraperPairStalkS2IsoToColimit.hom :=
      ι_preservesColimitIso_inv_assoc
        G tailPushforwardIntegerSheafFunctor n
        (G.map tailPushforwardColimitComparison ≫
          twoClosedPointsSkyscraperPairStalkS2IsoToColimit.hom)
    have hmid :
        G.map (colimit.ι tailPushforwardIntegerSheafFunctor n) ≫
            G.map tailPushforwardColimitComparison ≫
              twoClosedPointsSkyscraperPairStalkS2IsoToColimit.hom =
          G.map (tailPushforwardIntegerSheafToModel n) ≫
            ((tailPushforwardIntegerSheafModelStalkS2IsoToBasicSections n).hom ≫
              tailSectionValueToColimitOfS2Mem n twoClosedPointsS2Point_mem_s2_basic) := by
      have hmapcomp :
          G.map (colimit.ι tailPushforwardIntegerSheafFunctor n) ≫
              G.map tailPushforwardColimitComparison =
            G.map
              (tailPushforwardIntegerSheafToModel n ≫
                tailPushforwardIntegerSheafModelToSkyscraperPair n) := by
        calc
          G.map (colimit.ι tailPushforwardIntegerSheafFunctor n) ≫
              G.map tailPushforwardColimitComparison =
            G.map (colimit.ι tailPushforwardIntegerSheafFunctor n ≫
              tailPushforwardColimitComparison) := by
                rw [← G.map_comp]
          _ =
            G.map
              (tailPushforwardIntegerSheafToModel n ≫
                tailPushforwardIntegerSheafModelToSkyscraperPair n) := by
                  have hdesc :
                      colimit.ι tailPushforwardIntegerSheafFunctor n ≫
                          tailPushforwardColimitComparison =
                        tailPushforwardColimitComparisonCocone.ι.app n := by
                    exact colimit.ι_desc
                      (F := tailPushforwardIntegerSheafFunctor)
                      (c := tailPushforwardColimitComparisonCocone) n
                  simpa [tailPushforwardColimitComparisonCocone] using congrArg G.map hdesc
      calc
        G.map (colimit.ι tailPushforwardIntegerSheafFunctor n) ≫
            G.map tailPushforwardColimitComparison ≫
              twoClosedPointsSkyscraperPairStalkS2IsoToColimit.hom =
          G.map
              (tailPushforwardIntegerSheafToModel n ≫
                tailPushforwardIntegerSheafModelToSkyscraperPair n) ≫
            twoClosedPointsSkyscraperPairStalkS2IsoToColimit.hom := by
              exact congrArg
                (fun k ↦ k ≫ twoClosedPointsSkyscraperPairStalkS2IsoToColimit.hom)
                hmapcomp
        _ =
        G.map (tailPushforwardIntegerSheafToModel n) ≫
          G.map (tailPushforwardIntegerSheafModelToSkyscraperPair n) ≫
            twoClosedPointsSkyscraperPairStalkS2IsoToColimit.hom := by
              simp [G, Category.assoc]
        _ =
        G.map (tailPushforwardIntegerSheafToModel n) ≫
          (((TopCat.Presheaf.stalkFunctor AddCommGrpCat twoClosedPointsS2Point).map
              (tailPushforwardIntegerSheafModelToS2Skyscraper n).hom) ≫
            (skyscraperPresheafStalkOfSpecializes twoClosedPointsS2Point
              eventualIntegerSequenceColimit specializes_rfl).hom) := by
              simpa [G, Category.assoc] using
                congrArg
                  (fun k ↦ G.map (tailPushforwardIntegerSheafToModel n) ≫ k)
                  (closed_point_skyscraper_projection_stalk_s2 n)
        _ =
        G.map (tailPushforwardIntegerSheafToModel n) ≫
          ((tailPushforwardIntegerSheafModelStalkS2IsoToBasicSections n).hom ≫
            tailSectionValueToColimitOfS2Mem n twoClosedPointsS2Point_mem_s2_basic) := by
              simpa [G, Category.assoc] using
                congrArg
                  (fun k ↦ G.map (tailPushforwardIntegerSheafToModel n) ≫ k)
                  (tailPushforwardIntegerSheafModelToS2Skyscraper_stalk_eq n)
    exact hstart.trans hmid
  have hfinal :
      G.map (tailPushforwardIntegerSheafToModel n) ≫
          ((tailPushforwardIntegerSheafModelStalkS2IsoToBasicSections n).hom ≫
            tailSectionValueToColimitOfS2Mem n twoClosedPointsS2Point_mem_s2_basic) =
        (tailPushforwardIntegerSheafStalkS2StageIso n).hom ≫
          colimit.ι tailIntegerProductFunctor n := by
    rw [tailSectionValueToColimitOfS2Mem_basic_eq]
    rfl
  exact hmain.trans hfinal

/-- Helper for Example 6.29.2: after transporting the source `s1`-stalk colimit through the
diagram normal form and postcomposing the target by its closed-point stalk identification, the
stalk map of `tailPushforwardColimitComparison` is the canonical `HasColimit.isoOfNatIso` map. -/
private theorem tailPushforwardColimitComparison_stalk_s1_eq_isoOfNatIso_hom :
