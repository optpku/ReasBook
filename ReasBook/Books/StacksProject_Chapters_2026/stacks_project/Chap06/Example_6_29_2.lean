            (fun x ↦ a ⟨x.1, x.2, tailAllGenericsMem_of_s2_mem hU x.1⟩)
            (fun x ↦ b ⟨x.1, x.2, tailAllGenericsMem_of_s2_mem hU x.1⟩) }

public noncomputable def tailPushforwardIntegerSheafModelToS1Skyscraper (n : ℕ) :
    tailPushforwardIntegerSheafModel n ⟶
      skyscraperSheaf twoClosedPointsS1Point eventualIntegerSequenceColimit :=
  ObjectProperty.homMk
    { app := fun U ↦ by
        classical
        by_cases hU : twoClosedPointsS1Point ∈ U.unop
        · exact tailSectionValueToColimitOfS1Mem n hU ≫ eqToHom (if_pos hU).symm
        · exact terminal.from _ ≫ eqToHom (if_neg hU).symm
      naturality := by
        -- Split on whether the larger open contains `s1`; the positive branch is the literal
        -- restriction compatibility of the colimit cocone, and the negative branch is terminal.
        intro U V i
        classical
        by_cases hV : twoClosedPointsS1Point ∈ V.unop
        · have hU : twoClosedPointsS1Point ∈ U.unop := i.unop.le hV
          simp [hV, hU, tailSectionValueToColimitOfS1Mem, tailPushforwardIntegerSheafModel,
            tailPushforwardIntegerSheafModelPresheaf, tailSectionRestriction, skyscraperSheaf,
            skyscraperPresheaf, Category.assoc]
          ext f x
          rfl
        · by_cases hU : twoClosedPointsS1Point ∈ U.unop
          · simpa [hV, hU, tailPushforwardIntegerSheafModel, tailPushforwardIntegerSheafModelPresheaf,
              tailSectionValueToColimitOfS1Mem, tailSectionRestriction, skyscraperSheaf,
              skyscraperPresheaf] using
              (((if_neg hV).symm.ndrec terminalIsTerminal).hom_ext _ _)
          · simpa [hV, hU, tailPushforwardIntegerSheafModel, tailPushforwardIntegerSheafModelPresheaf,
              skyscraperSheaf, skyscraperPresheaf] using
              (((if_neg hV).symm.ndrec terminalIsTerminal).hom_ext _ _) }

public noncomputable def tailPushforwardIntegerSheafModelToS2Skyscraper (n : ℕ) :
    tailPushforwardIntegerSheafModel n ⟶
      skyscraperSheaf twoClosedPointsS2Point eventualIntegerSequenceColimit :=
  ObjectProperty.homMk
    { app := fun U ↦ by
        classical
        by_cases hU : twoClosedPointsS2Point ∈ U.unop
        · exact tailSectionValueToColimitOfS2Mem n hU ≫ eqToHom (if_pos hU).symm
        · exact terminal.from _ ≫ eqToHom (if_neg hU).symm
      naturality := by
        -- The `s2` component is identical to the `s1` argument after swapping the special point.
        intro U V i
        classical
        by_cases hV : twoClosedPointsS2Point ∈ V.unop
        · have hU : twoClosedPointsS2Point ∈ U.unop := i.unop.le hV
          simp [hV, hU, tailSectionValueToColimitOfS2Mem, tailPushforwardIntegerSheafModel,
            tailPushforwardIntegerSheafModelPresheaf, tailSectionRestriction, skyscraperSheaf,
            skyscraperPresheaf, Category.assoc]
          ext f x
          rfl
        · by_cases hU : twoClosedPointsS2Point ∈ U.unop
          · simpa [hV, hU, tailPushforwardIntegerSheafModel, tailPushforwardIntegerSheafModelPresheaf,
              tailSectionValueToColimitOfS2Mem, tailSectionRestriction, skyscraperSheaf,
              skyscraperPresheaf] using
              (((if_neg hV).symm.ndrec terminalIsTerminal).hom_ext _ _)
          · simpa [hV, hU, tailPushforwardIntegerSheafModel, tailPushforwardIntegerSheafModelPresheaf,
              skyscraperSheaf, skyscraperPresheaf] using
              (((if_neg hV).symm.ndrec terminalIsTerminal).hom_ext _ _) }

public noncomputable def tailPushforwardIntegerSheafModelToSkyscraperPair (n : ℕ) :
    tailPushforwardIntegerSheafModel n ⟶ twoClosedPointsSkyscraperPairSheaf :=
  biprod.lift
    (tailPushforwardIntegerSheafModelToS1Skyscraper n)
    (tailPushforwardIntegerSheafModelToS2Skyscraper n)

/-- Helper for Example 6.29.2: on an open containing `s1`, the stage map of the explicit tail
model matches the transition morphism in the colimit `M`. -/
public theorem tailSectionValueToColimitOfS1Mem_stage_comp {i j : ℕ} (hij : i ≤ j)
    {U : Opens twoClosedPointsSpace} (hU : twoClosedPointsS1Point ∈ U) :
    (tailPushforwardIntegerSheafModelMap hij).hom.app (op U) ≫
        tailSectionValueToColimitOfS1Mem j hU =
      tailSectionValueToColimitOfS1Mem i hU := by
  -- Evaluate both composites on one section and rewrite them to the colimit cocone relation.
  ext f
  change
    (colimit.ι tailIntegerProductFunctor j)
        ((tailIntegerProductFunctor.map (homOfLE hij))
          (fun x ↦ f ⟨x.1, x.2, tailAllGenericsMem_of_s1_mem hU x.1⟩)) =
      (colimit.ι tailIntegerProductFunctor i)
        (fun x ↦ f ⟨x.1, x.2, tailAllGenericsMem_of_s1_mem hU x.1⟩)
  simpa [tailIntegerProductFunctor, tailIntegerProductMap, tailPushforwardIntegerSheafModelMap,
    tailSectionValueToColimitOfS1Mem] using
    congrArg
      (fun k ↦
        k (fun x ↦ f ⟨x.1, x.2, tailAllGenericsMem_of_s1_mem hU x.1⟩))
      (colimit.w tailIntegerProductFunctor (homOfLE hij))

/-- Helper for Example 6.29.2: on an open containing `s2`, the stage map of the explicit tail
model matches the transition morphism in the colimit `M`. -/
public theorem tailSectionValueToColimitOfS2Mem_stage_comp {i j : ℕ} (hij : i ≤ j)
    {U : Opens twoClosedPointsSpace} (hU : twoClosedPointsS2Point ∈ U) :
    (tailPushforwardIntegerSheafModelMap hij).hom.app (op U) ≫
