/-- Helper for Example 6.29.2: after taking the `s1`-stalk of the biproduct target, the
skyscraper-pair map keeps only the surviving `s1` component. -/
private theorem closed_point_skyscraper_projection_stalk_s1 (n : ℕ) :
    ((TopCat.Presheaf.stalkFunctor AddCommGrpCat twoClosedPointsS1Point).map
        (tailPushforwardIntegerSheafModelToSkyscraperPair n).hom) ≫
      twoClosedPointsSkyscraperPairStalkS1IsoToColimit.hom =
    ((TopCat.Presheaf.stalkFunctor AddCommGrpCat twoClosedPointsS1Point).map
        (tailPushforwardIntegerSheafModelToS1Skyscraper n).hom) ≫
      (skyscraperPresheafStalkOfSpecializes twoClosedPointsS1Point eventualIntegerSequenceColimit
        specializes_rfl).hom := by
  -- Transport the biproduct target across the stalk functor, then project away the terminal `s2`
  -- summand.
  let G :=
    TopCat.Sheaf.forget AddCommGrpCat twoClosedPointsSpace ⋙
      TopCat.Presheaf.stalkFunctor AddCommGrpCat twoClosedPointsS1Point
  letI : PreservesBinaryBiproducts G :=
    preservesBinaryBiproducts_of_preservesBinaryCoproducts G
  let e1 :
      G.obj (skyscraperSheaf twoClosedPointsS1Point eventualIntegerSequenceColimit) ≅
        eventualIntegerSequenceColimit := by
    simpa [G] using
      (skyscraperPresheafStalkOfSpecializes twoClosedPointsS1Point
        eventualIntegerSequenceColimit specializes_rfl)
  have h2terminal :
      IsTerminal
        (G.obj (skyscraperSheaf twoClosedPointsS2Point eventualIntegerSequenceColimit)) := by
    simpa [G] using
      (skyscraperPresheafStalkOfNotSpecializesIsTerminal
        (p₀ := twoClosedPointsS2Point) (A := eventualIntegerSequenceColimit)
        (y := twoClosedPointsS1Point) twoClosedPointsS2_not_specializes_s1)
  -- Rewrite the stalked biproduct map through `mapBiprod`; after the right summand is terminal,
  -- the `biprod.fst` projection leaves exactly the `s1` component.
  change
    G.map (tailPushforwardIntegerSheafModelToSkyscraperPair n) ≫
      twoClosedPointsSkyscraperPairStalkS1IsoToColimit.hom =
    G.map (tailPushforwardIntegerSheafModelToS1Skyscraper n) ≫
      (skyscraperPresheafStalkOfSpecializes twoClosedPointsS1Point eventualIntegerSequenceColimit
        specializes_rfl).hom
  calc
    G.map (tailPushforwardIntegerSheafModelToSkyscraperPair n) ≫
        twoClosedPointsSkyscraperPairStalkS1IsoToColimit.hom =
      G.map (biprod.lift (tailPushforwardIntegerSheafModelToS1Skyscraper n)
            (tailPushforwardIntegerSheafModelToS2Skyscraper n)) ≫
          (G.mapBiprod
              (skyscraperSheaf twoClosedPointsS1Point eventualIntegerSequenceColimit)
              (skyscraperSheaf twoClosedPointsS2Point eventualIntegerSequenceColimit)).hom ≫
            (biprodFstIsoOfIsZero
                (G.obj (skyscraperSheaf twoClosedPointsS1Point eventualIntegerSequenceColimit))
                (G.obj (skyscraperSheaf twoClosedPointsS2Point eventualIntegerSequenceColimit))
                h2terminal.isZero).hom ≫
              e1.hom := by
                rfl
    _ =
      biprod.lift
          (G.map (tailPushforwardIntegerSheafModelToS1Skyscraper n))
          (G.map (tailPushforwardIntegerSheafModelToS2Skyscraper n)) ≫
            (biprodFstIsoOfIsZero
                (G.obj (skyscraperSheaf twoClosedPointsS1Point eventualIntegerSequenceColimit))
                (G.obj (skyscraperSheaf twoClosedPointsS2Point eventualIntegerSequenceColimit))
                h2terminal.isZero).hom ≫
              e1.hom := by
                simpa [Category.assoc] using
                  congrArg
                    (fun k ↦
                      k ≫
                        (biprodFstIsoOfIsZero
                            (G.obj
                              (skyscraperSheaf twoClosedPointsS1Point eventualIntegerSequenceColimit))
                            (G.obj
                              (skyscraperSheaf twoClosedPointsS2Point eventualIntegerSequenceColimit))
                            h2terminal.isZero).hom ≫
                          e1.hom)
                    (biprod.map_lift_mapBiprod
                      (F := G)
                      (f := tailPushforwardIntegerSheafModelToS1Skyscraper n)
                      (g := tailPushforwardIntegerSheafModelToS2Skyscraper n))
    _ = G.map (tailPushforwardIntegerSheafModelToS1Skyscraper n) ≫ e1.hom := by
          simp [biprodFstIsoOfIsZero, Category.assoc]
    _ =
      G.map (tailPushforwardIntegerSheafModelToS1Skyscraper n) ≫
        (skyscraperPresheafStalkOfSpecializes twoClosedPointsS1Point eventualIntegerSequenceColimit
          specializes_rfl).hom := by
            rfl

/-- Helper for Example 6.29.2: after taking the `s2`-stalk of the biproduct target, the
skyscraper-pair map keeps only the surviving `s2` component. -/
private theorem closed_point_skyscraper_projection_stalk_s2 (n : ℕ) :
    ((TopCat.Presheaf.stalkFunctor AddCommGrpCat twoClosedPointsS2Point).map
        (tailPushforwardIntegerSheafModelToSkyscraperPair n).hom) ≫
      twoClosedPointsSkyscraperPairStalkS2IsoToColimit.hom =
    ((TopCat.Presheaf.stalkFunctor AddCommGrpCat twoClosedPointsS2Point).map
        (tailPushforwardIntegerSheafModelToS2Skyscraper n).hom) ≫
      (skyscraperPresheafStalkOfSpecializes twoClosedPointsS2Point eventualIntegerSequenceColimit
        specializes_rfl).hom := by
  -- The `s1` summand is terminal in the `s2` stalk, so only the `s2` component remains.
  let G :=
    TopCat.Sheaf.forget AddCommGrpCat twoClosedPointsSpace ⋙
      TopCat.Presheaf.stalkFunctor AddCommGrpCat twoClosedPointsS2Point
  letI : PreservesBinaryBiproducts G :=
    preservesBinaryBiproducts_of_preservesBinaryCoproducts G
  let e2 :
      G.obj (skyscraperSheaf twoClosedPointsS2Point eventualIntegerSequenceColimit) ≅
        eventualIntegerSequenceColimit := by
    simpa [G] using
      (skyscraperPresheafStalkOfSpecializes twoClosedPointsS2Point
        eventualIntegerSequenceColimit specializes_rfl)
  have h1terminal :
      IsTerminal
        (G.obj (skyscraperSheaf twoClosedPointsS1Point eventualIntegerSequenceColimit)) := by
    simpa [G] using
      (skyscraperPresheafStalkOfNotSpecializesIsTerminal
        (p₀ := twoClosedPointsS1Point) (A := eventualIntegerSequenceColimit)
        (y := twoClosedPointsS2Point) twoClosedPointsS1_not_specializes_s2)
  -- The `s2` proof is the same biproduct-collapse argument with `biprod.snd`.
  change
    G.map (tailPushforwardIntegerSheafModelToSkyscraperPair n) ≫
      twoClosedPointsSkyscraperPairStalkS2IsoToColimit.hom =
    G.map (tailPushforwardIntegerSheafModelToS2Skyscraper n) ≫
      (skyscraperPresheafStalkOfSpecializes twoClosedPointsS2Point eventualIntegerSequenceColimit
        specializes_rfl).hom
  calc
    G.map (tailPushforwardIntegerSheafModelToSkyscraperPair n) ≫
        twoClosedPointsSkyscraperPairStalkS2IsoToColimit.hom =
      G.map (biprod.lift (tailPushforwardIntegerSheafModelToS1Skyscraper n)
            (tailPushforwardIntegerSheafModelToS2Skyscraper n)) ≫
          (G.mapBiprod
              (skyscraperSheaf twoClosedPointsS1Point eventualIntegerSequenceColimit)
              (skyscraperSheaf twoClosedPointsS2Point eventualIntegerSequenceColimit)).hom ≫
            (biprodSndIsoOfIsZero
                (G.obj (skyscraperSheaf twoClosedPointsS1Point eventualIntegerSequenceColimit))
                (G.obj (skyscraperSheaf twoClosedPointsS2Point eventualIntegerSequenceColimit))
                h1terminal.isZero).hom ≫
              e2.hom := by
                rfl
    _ =
      biprod.lift
          (G.map (tailPushforwardIntegerSheafModelToS1Skyscraper n))
          (G.map (tailPushforwardIntegerSheafModelToS2Skyscraper n)) ≫
            (biprodSndIsoOfIsZero
                (G.obj (skyscraperSheaf twoClosedPointsS1Point eventualIntegerSequenceColimit))
                (G.obj (skyscraperSheaf twoClosedPointsS2Point eventualIntegerSequenceColimit))
                h1terminal.isZero).hom ≫
              e2.hom := by
                simpa [Category.assoc] using
                  congrArg
                    (fun k ↦
                      k ≫
                        (biprodSndIsoOfIsZero
                            (G.obj
                              (skyscraperSheaf twoClosedPointsS1Point eventualIntegerSequenceColimit))
                            (G.obj
                              (skyscraperSheaf twoClosedPointsS2Point eventualIntegerSequenceColimit))
                            h1terminal.isZero).hom ≫
                          e2.hom)
                    (biprod.map_lift_mapBiprod
                      (F := G)
                      (f := tailPushforwardIntegerSheafModelToS1Skyscraper n)
                      (g := tailPushforwardIntegerSheafModelToS2Skyscraper n))
    _ = G.map (tailPushforwardIntegerSheafModelToS2Skyscraper n) ≫ e2.hom := by
          simp [biprodSndIsoOfIsZero, Category.assoc]
    _ =
      G.map (tailPushforwardIntegerSheafModelToS2Skyscraper n) ≫
        (skyscraperPresheafStalkOfSpecializes twoClosedPointsS2Point eventualIntegerSequenceColimit
          specializes_rfl).hom := by
            rfl

/-- Helper for Example 6.29.2: after precomposing the `s1`-stalk map of the colimit comparison by
the stage `n` leg, the resulting morphism is the normalized `s1` stage isomorphism followed by the
canonical colimit inclusion. -/
private theorem tailPushforwardColimitComparison_stage_leg_s1_normal_form (n : ℕ) :
    colimit.ι tailPushforwardIntegerSheafStalkS1Functor n ≫
      (preservesColimitIso
          (TopCat.Sheaf.forget AddCommGrpCat twoClosedPointsSpace ⋙
            TopCat.Presheaf.stalkFunctor AddCommGrpCat twoClosedPointsS1Point)
          tailPushforwardIntegerSheafFunctor).inv ≫
      ((TopCat.Presheaf.stalkFunctor AddCommGrpCat twoClosedPointsS1Point).map
        tailPushforwardColimitComparison.hom) ≫
      twoClosedPointsSkyscraperPairStalkS1IsoToColimit.hom =
    (tailPushforwardIntegerSheafStalkS1StageIso n).hom ≫
      colimit.ι tailIntegerProductFunctor n := by
  let G :=
    TopCat.Sheaf.forget AddCommGrpCat twoClosedPointsSpace ⋙
      TopCat.Presheaf.stalkFunctor AddCommGrpCat twoClosedPointsS1Point
  -- Rewrite the stalked colimit comparison through the colimit-desc cocone.
  have hmain :
    colimit.ι tailPushforwardIntegerSheafStalkS1Functor n ≫
        (preservesColimitIso G tailPushforwardIntegerSheafFunctor).inv ≫
        G.map tailPushforwardColimitComparison ≫
        twoClosedPointsSkyscraperPairStalkS1IsoToColimit.hom =
      G.map
          (tailPushforwardIntegerSheafToModel n) ≫
        ((tailPushforwardIntegerSheafModelStalkS1IsoToBasicSections n).hom ≫
          tailSectionValueToColimitOfS1Mem n twoClosedPointsS1Point_mem_s1_basic) := by
    have hstart :
        colimit.ι tailPushforwardIntegerSheafStalkS1Functor n ≫
            (preservesColimitIso G tailPushforwardIntegerSheafFunctor).inv ≫
            G.map tailPushforwardColimitComparison ≫
            twoClosedPointsSkyscraperPairStalkS1IsoToColimit.hom =
          G.map (colimit.ι tailPushforwardIntegerSheafFunctor n) ≫
            G.map tailPushforwardColimitComparison ≫
              twoClosedPointsSkyscraperPairStalkS1IsoToColimit.hom :=
      ι_preservesColimitIso_inv_assoc
        G tailPushforwardIntegerSheafFunctor n
        (G.map tailPushforwardColimitComparison ≫
          twoClosedPointsSkyscraperPairStalkS1IsoToColimit.hom)
    have hmid :
        G.map (colimit.ι tailPushforwardIntegerSheafFunctor n) ≫
            G.map tailPushforwardColimitComparison ≫
              twoClosedPointsSkyscraperPairStalkS1IsoToColimit.hom =
          G.map (tailPushforwardIntegerSheafToModel n) ≫
            ((tailPushforwardIntegerSheafModelStalkS1IsoToBasicSections n).hom ≫
              tailSectionValueToColimitOfS1Mem n twoClosedPointsS1Point_mem_s1_basic) := by
      have hmapcomp :
          G.map (colimit.ι tailPushforwardIntegerSheafFunctor n) ≫
              G.map tailPushforwardColimitComparison =
            G.map
              (tailPushforwardIntegerSheafToModel n ≫
                tailPushforwardIntegerSheafModelToSkyscraperPair n) := by
        calc
          G.map (colimit.ι tailPushforwardIntegerSheafFunctor n) ≫
              G.map tailPushforwardColimitComparison =
            G.map (colimit.ι tailPushforwardIntegerSheafFunctor n ≫
              tailPushforwardColimitComparison) := by
                rw [← G.map_comp]
          _ =
            G.map
              (tailPushforwardIntegerSheafToModel n ≫
                tailPushforwardIntegerSheafModelToSkyscraperPair n) := by
                  have hdesc :
                      colimit.ι tailPushforwardIntegerSheafFunctor n ≫
                          tailPushforwardColimitComparison =
                        tailPushforwardColimitComparisonCocone.ι.app n := by
                    exact colimit.ι_desc
                      (F := tailPushforwardIntegerSheafFunctor)
                      (c := tailPushforwardColimitComparisonCocone) n
                  simpa [tailPushforwardColimitComparisonCocone] using congrArg G.map hdesc
      calc
        G.map (colimit.ι tailPushforwardIntegerSheafFunctor n) ≫
            G.map tailPushforwardColimitComparison ≫
              twoClosedPointsSkyscraperPairStalkS1IsoToColimit.hom =
          G.map
              (tailPushforwardIntegerSheafToModel n ≫
                tailPushforwardIntegerSheafModelToSkyscraperPair n) ≫
            twoClosedPointsSkyscraperPairStalkS1IsoToColimit.hom := by
              exact congrArg
                (fun k ↦ k ≫ twoClosedPointsSkyscraperPairStalkS1IsoToColimit.hom)
                hmapcomp
        _ =
        G.map (tailPushforwardIntegerSheafToModel n) ≫
          G.map (tailPushforwardIntegerSheafModelToSkyscraperPair n) ≫
            twoClosedPointsSkyscraperPairStalkS1IsoToColimit.hom := by
              simp [G, Category.assoc]
        _ =
        G.map (tailPushforwardIntegerSheafToModel n) ≫
          (((TopCat.Presheaf.stalkFunctor AddCommGrpCat twoClosedPointsS1Point).map
              (tailPushforwardIntegerSheafModelToS1Skyscraper n).hom) ≫
            (skyscraperPresheafStalkOfSpecializes twoClosedPointsS1Point
              eventualIntegerSequenceColimit specializes_rfl).hom) := by
              simpa [G, Category.assoc] using
