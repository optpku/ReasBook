/-- Helper for Example 6.29.2: the `s1` stage isomorphisms are compatible with the transition maps
of the stalk diagram. -/
private theorem tailPushforwardIntegerSheafStalkS1StageIso_naturality {i j : ℕ} (h : i ⟶ j) :
    tailPushforwardIntegerSheafStalkS1Functor.map h ≫
      (tailPushforwardIntegerSheafStalkS1StageIso j).hom =
    (tailPushforwardIntegerSheafStalkS1StageIso i).hom ≫ tailIntegerProductFunctor.map h := by
  -- Compose the three already-normalized comparison squares: from the original stalk to the model
  -- stalk, from the model stalk to minimal-basic sections, and from those sections to the tail
  -- product stage.
  let G :=
    TopCat.Sheaf.forget AddCommGrpCat twoClosedPointsSpace ⋙
      TopCat.Presheaf.stalkFunctor AddCommGrpCat twoClosedPointsS1Point
  have h1 :
      tailPushforwardIntegerSheafStalkS1Functor.map h ≫
          ((G.mapIso (tailPushforwardIntegerSheafModelIso j)).hom ≫
              (tailPushforwardIntegerSheafModelStalkS1IsoToBasicSections j).hom ≫
                (tailSectionValueS1BasicIso j).hom) =
        ((G.mapIso (tailPushforwardIntegerSheafModelIso i)).hom ≫
            G.map (tailPushforwardIntegerSheafModelMap h.down.down) ≫
              (tailPushforwardIntegerSheafModelStalkS1IsoToBasicSections j).hom) ≫
          (tailSectionValueS1BasicIso j).hom := by
    simpa [Category.assoc] using
      congrArg
        (fun k ↦ k ≫ (tailPushforwardIntegerSheafModelStalkS1IsoToBasicSections j).hom ≫
          (tailSectionValueS1BasicIso j).hom)
        (tailPushforwardIntegerSheafStalkS1ModelIso_naturality h)
  have h2 :
      ((G.mapIso (tailPushforwardIntegerSheafModelIso i)).hom ≫
            G.map (tailPushforwardIntegerSheafModelMap h.down.down) ≫
              (tailPushforwardIntegerSheafModelStalkS1IsoToBasicSections j).hom) ≫
          (tailSectionValueS1BasicIso j).hom =
        ((G.mapIso (tailPushforwardIntegerSheafModelIso i)).hom ≫
            (tailPushforwardIntegerSheafModelStalkS1IsoToBasicSections i).hom ≫
              (tailPushforwardIntegerSheafModelMap h.down.down).hom.app
                (op twoClosedPointsS1BasicOpens)) ≫
          (tailSectionValueS1BasicIso j).hom := by
    calc
      ((G.mapIso (tailPushforwardIntegerSheafModelIso i)).hom ≫
            G.map (tailPushforwardIntegerSheafModelMap h.down.down) ≫
              (tailPushforwardIntegerSheafModelStalkS1IsoToBasicSections j).hom) ≫
          (tailSectionValueS1BasicIso j).hom =
        (G.mapIso (tailPushforwardIntegerSheafModelIso i)).hom ≫
            (G.map (tailPushforwardIntegerSheafModelMap h.down.down) ≫
              (tailPushforwardIntegerSheafModelStalkS1IsoToBasicSections j).hom) ≫
          (tailSectionValueS1BasicIso j).hom := by
            simp [Category.assoc]
      _ =
        (G.mapIso (tailPushforwardIntegerSheafModelIso i)).hom ≫
            ((tailPushforwardIntegerSheafModelStalkS1IsoToBasicSections i).hom ≫
              (tailPushforwardIntegerSheafModelMap h.down.down).hom.app
                (op twoClosedPointsS1BasicOpens)) ≫
          (tailSectionValueS1BasicIso j).hom := by
            simpa [G, Category.assoc] using
              congrArg
                (fun k ↦
                  ((G.mapIso (tailPushforwardIntegerSheafModelIso i)).hom ≫ k) ≫
                    (tailSectionValueS1BasicIso j).hom)
                (tailPushforwardIntegerSheafModelStalkS1IsoToBasicSections_naturality (h := h))
      _ =
        ((G.mapIso (tailPushforwardIntegerSheafModelIso i)).hom ≫
              (tailPushforwardIntegerSheafModelStalkS1IsoToBasicSections i).hom ≫
                (tailPushforwardIntegerSheafModelMap h.down.down).hom.app
                  (op twoClosedPointsS1BasicOpens)) ≫
            (tailSectionValueS1BasicIso j).hom := by
              simp [Category.assoc]
  have h3 :
      ((G.mapIso (tailPushforwardIntegerSheafModelIso i)).hom ≫
            (tailPushforwardIntegerSheafModelStalkS1IsoToBasicSections i).hom ≫
              (tailPushforwardIntegerSheafModelMap h.down.down).hom.app
                (op twoClosedPointsS1BasicOpens)) ≫
          (tailSectionValueS1BasicIso j).hom =
        ((G.mapIso (tailPushforwardIntegerSheafModelIso i)).hom ≫
            (tailPushforwardIntegerSheafModelStalkS1IsoToBasicSections i).hom ≫
              (tailSectionValueS1BasicIso i).hom) ≫
          tailIntegerProductFunctor.map h := by
    simpa [Category.assoc] using
      congrArg
        (fun k ↦
          (G.mapIso (tailPushforwardIntegerSheafModelIso i)).hom ≫
            (tailPushforwardIntegerSheafModelStalkS1IsoToBasicSections i).hom ≫ k)
        (tailSectionValueS1BasicIso_naturality h)
  exact
    (by
      simpa [tailPushforwardIntegerSheafStalkS1StageIso, G, Category.assoc] using h1.trans (h2.trans h3))

/-- Helper for Example 6.29.2: the `s2` stage isomorphisms are compatible with the transition maps
of the stalk diagram. -/
private theorem tailPushforwardIntegerSheafStalkS2StageIso_naturality {i j : ℕ} (h : i ⟶ j) :
    tailPushforwardIntegerSheafStalkS2Functor.map h ≫
      (tailPushforwardIntegerSheafStalkS2StageIso j).hom =
    (tailPushforwardIntegerSheafStalkS2StageIso i).hom ≫ tailIntegerProductFunctor.map h := by
  -- The `s2` branch is the same three-square composition as the `s1` branch after swapping the
  -- distinguished closed point.
  let G :=
    TopCat.Sheaf.forget AddCommGrpCat twoClosedPointsSpace ⋙
      TopCat.Presheaf.stalkFunctor AddCommGrpCat twoClosedPointsS2Point
  have h1 :
      tailPushforwardIntegerSheafStalkS2Functor.map h ≫
          ((G.mapIso (tailPushforwardIntegerSheafModelIso j)).hom ≫
              (tailPushforwardIntegerSheafModelStalkS2IsoToBasicSections j).hom ≫
                (tailSectionValueS2BasicIso j).hom) =
        ((G.mapIso (tailPushforwardIntegerSheafModelIso i)).hom ≫
            G.map (tailPushforwardIntegerSheafModelMap h.down.down) ≫
              (tailPushforwardIntegerSheafModelStalkS2IsoToBasicSections j).hom) ≫
          (tailSectionValueS2BasicIso j).hom := by
    simpa [Category.assoc] using
      congrArg
        (fun k ↦ k ≫ (tailPushforwardIntegerSheafModelStalkS2IsoToBasicSections j).hom ≫
          (tailSectionValueS2BasicIso j).hom)
        (tailPushforwardIntegerSheafStalkS2ModelIso_naturality h)
  have h2 :
      ((G.mapIso (tailPushforwardIntegerSheafModelIso i)).hom ≫
            G.map (tailPushforwardIntegerSheafModelMap h.down.down) ≫
              (tailPushforwardIntegerSheafModelStalkS2IsoToBasicSections j).hom) ≫
          (tailSectionValueS2BasicIso j).hom =
        ((G.mapIso (tailPushforwardIntegerSheafModelIso i)).hom ≫
            (tailPushforwardIntegerSheafModelStalkS2IsoToBasicSections i).hom ≫
              (tailPushforwardIntegerSheafModelMap h.down.down).hom.app
                (op twoClosedPointsS2BasicOpens)) ≫
          (tailSectionValueS2BasicIso j).hom := by
    calc
      ((G.mapIso (tailPushforwardIntegerSheafModelIso i)).hom ≫
            G.map (tailPushforwardIntegerSheafModelMap h.down.down) ≫
              (tailPushforwardIntegerSheafModelStalkS2IsoToBasicSections j).hom) ≫
          (tailSectionValueS2BasicIso j).hom =
        (G.mapIso (tailPushforwardIntegerSheafModelIso i)).hom ≫
            (G.map (tailPushforwardIntegerSheafModelMap h.down.down) ≫
              (tailPushforwardIntegerSheafModelStalkS2IsoToBasicSections j).hom) ≫
          (tailSectionValueS2BasicIso j).hom := by
            simp [Category.assoc]
      _ =
        (G.mapIso (tailPushforwardIntegerSheafModelIso i)).hom ≫
            ((tailPushforwardIntegerSheafModelStalkS2IsoToBasicSections i).hom ≫
              (tailPushforwardIntegerSheafModelMap h.down.down).hom.app
                (op twoClosedPointsS2BasicOpens)) ≫
          (tailSectionValueS2BasicIso j).hom := by
            simpa [G, Category.assoc] using
              congrArg
                (fun k ↦
                  ((G.mapIso (tailPushforwardIntegerSheafModelIso i)).hom ≫ k) ≫
                    (tailSectionValueS2BasicIso j).hom)
                (tailPushforwardIntegerSheafModelStalkS2IsoToBasicSections_naturality (h := h))
      _ =
        ((G.mapIso (tailPushforwardIntegerSheafModelIso i)).hom ≫
              (tailPushforwardIntegerSheafModelStalkS2IsoToBasicSections i).hom ≫
                (tailPushforwardIntegerSheafModelMap h.down.down).hom.app
                  (op twoClosedPointsS2BasicOpens)) ≫
            (tailSectionValueS2BasicIso j).hom := by
              simp [Category.assoc]
  have h3 :
      ((G.mapIso (tailPushforwardIntegerSheafModelIso i)).hom ≫
            (tailPushforwardIntegerSheafModelStalkS2IsoToBasicSections i).hom ≫
              (tailPushforwardIntegerSheafModelMap h.down.down).hom.app
                (op twoClosedPointsS2BasicOpens)) ≫
          (tailSectionValueS2BasicIso j).hom =
        ((G.mapIso (tailPushforwardIntegerSheafModelIso i)).hom ≫
            (tailPushforwardIntegerSheafModelStalkS2IsoToBasicSections i).hom ≫
              (tailSectionValueS2BasicIso i).hom) ≫
          tailIntegerProductFunctor.map h := by
    simpa [Category.assoc] using
      congrArg
        (fun k ↦
          (G.mapIso (tailPushforwardIntegerSheafModelIso i)).hom ≫
            (tailPushforwardIntegerSheafModelStalkS2IsoToBasicSections i).hom ≫ k)
        (tailSectionValueS2BasicIso_naturality h)
  exact
    (by
      simpa [tailPushforwardIntegerSheafStalkS2StageIso, G, Category.assoc] using h1.trans (h2.trans h3))

/-- Helper for Example 6.29.2: the `s1`-stalk diagram of the system
`n ↦ j_{n,*}\underline{Z}` is naturally isomorphic to the tail-product diagram. -/
private noncomputable def tailPushforwardIntegerSheafStalkS1NatIsoToTailIntegerProduct :
    tailPushforwardIntegerSheafStalkS1Functor ≅ tailIntegerProductFunctor :=
  NatIso.ofComponents
    (fun n ↦ tailPushforwardIntegerSheafStalkS1StageIso n)
    (fun {_ _} h ↦ tailPushforwardIntegerSheafStalkS1StageIso_naturality h)

/-- Helper for Example 6.29.2: the `s2`-stalk diagram of the system
`n ↦ j_{n,*}\underline{Z}` is naturally isomorphic to the tail-product diagram. -/
private noncomputable def tailPushforwardIntegerSheafStalkS2NatIsoToTailIntegerProduct :
    tailPushforwardIntegerSheafStalkS2Functor ≅ tailIntegerProductFunctor :=
  NatIso.ofComponents
    (fun n ↦ tailPushforwardIntegerSheafStalkS2StageIso n)
    (fun {_ _} h ↦ tailPushforwardIntegerSheafStalkS2StageIso_naturality h)

/-- Helper for Example 6.29.2: on the minimal `s1`-open, the model-to-skyscraper map is exactly
the positive branch of the definition. -/
private theorem tailPushforwardIntegerSheafModelToS1Skyscraper_basic_app_eq (n : ℕ) :
    (tailPushforwardIntegerSheafModelToS1Skyscraper n).hom.app (op twoClosedPointsS1BasicOpens) =
      tailSectionValueToColimitOfS1Mem n twoClosedPointsS1Point_mem_s1_basic ≫
        eqToHom (if_pos twoClosedPointsS1Point_mem_s1_basic).symm := by
  -- Evaluating on the minimal `s1`-open lands in the positive `if` branch by definition.
  classical
  have h : twoClosedPointsS1Point ∈ twoClosedPointsS1BasicOpens := twoClosedPointsS1Point_mem_s1_basic
  cases Subsingleton.elim h twoClosedPointsS1Point_mem_s1_basic
  simpa using
    (show
      (if hU : twoClosedPointsS1Point ∈ twoClosedPointsS1BasicOpens then
          tailSectionValueToColimitOfS1Mem n hU ≫ eqToHom (if_pos hU).symm
        else
          terminal.from ((tailPushforwardIntegerSheafModel n).obj.obj (op twoClosedPointsS1BasicOpens)) ≫
            eqToHom (if_neg hU).symm) =
        tailSectionValueToColimitOfS1Mem n twoClosedPointsS1Point_mem_s1_basic ≫
          eqToHom (if_pos twoClosedPointsS1Point_mem_s1_basic).symm from by
        erw [dif_pos twoClosedPointsS1Point_mem_s1_basic])

/-- Helper for Example 6.29.2: on the minimal `s2`-open, the model-to-skyscraper map is exactly
the positive branch of the definition. -/
private theorem tailPushforwardIntegerSheafModelToS2Skyscraper_basic_app_eq (n : ℕ) :
