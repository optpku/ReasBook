/-- Helper for Example 6.29.2: the stalk of the skyscraper-pair sheaf at `s1` is canonically `M`. -/
private noncomputable def twoClosedPointsSkyscraperPairStalkS1IsoToColimit :
    ((TopCat.Sheaf.forget AddCommGrpCat twoClosedPointsSpace ⋙
          TopCat.Presheaf.stalkFunctor AddCommGrpCat twoClosedPointsS1Point).obj
        twoClosedPointsSkyscraperPairSheaf) ≅
      eventualIntegerSequenceColimit := by
  let G :=
    TopCat.Sheaf.forget AddCommGrpCat twoClosedPointsSpace ⋙
      TopCat.Presheaf.stalkFunctor AddCommGrpCat twoClosedPointsS1Point
  letI : PreservesBinaryBiproducts G :=
    preservesBinaryBiproducts_of_preservesBinaryCoproducts G
  let e1 :
      G.obj (skyscraperSheaf twoClosedPointsS1Point eventualIntegerSequenceColimit) ≅
        eventualIntegerSequenceColimit := by
    simpa [G] using
      (skyscraperPresheafStalkOfSpecializes twoClosedPointsS1Point
        eventualIntegerSequenceColimit specializes_rfl)
  have h2terminal :
      IsTerminal
        (G.obj (skyscraperSheaf twoClosedPointsS2Point eventualIntegerSequenceColimit)) := by
    -- The `s2` summand disappears in the `s1`-stalk because `s2` does not specialize to `s1`.
    simpa [G] using
      (skyscraperPresheafStalkOfNotSpecializesIsTerminal
        (p₀ := twoClosedPointsS2Point) (A := eventualIntegerSequenceColimit)
        (y := twoClosedPointsS1Point) twoClosedPointsS2_not_specializes_s1)
  exact G.mapBiprod
      (skyscraperSheaf twoClosedPointsS1Point eventualIntegerSequenceColimit)
      (skyscraperSheaf twoClosedPointsS2Point eventualIntegerSequenceColimit) ≪≫
    biprodFstIsoOfIsZero
      (G.obj (skyscraperSheaf twoClosedPointsS1Point eventualIntegerSequenceColimit))
      (G.obj (skyscraperSheaf twoClosedPointsS2Point eventualIntegerSequenceColimit))
      h2terminal.isZero ≪≫
    e1

