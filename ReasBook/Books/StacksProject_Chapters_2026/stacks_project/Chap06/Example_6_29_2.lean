      tailSectionValueToColimitOfS2Mem n twoClosedPointsS2Point_mem_s2_basic ≫
        eqToHom (if_pos twoClosedPointsS2Point_mem_s2_basic).symm := by
  -- The `s2` basic open likewise triggers the positive branch of the skyscraper map.
  classical
  have h : twoClosedPointsS2Point ∈ twoClosedPointsS2BasicOpens := twoClosedPointsS2Point_mem_s2_basic
  cases Subsingleton.elim h twoClosedPointsS2Point_mem_s2_basic
  simpa using
    (show
      (if hU : twoClosedPointsS2Point ∈ twoClosedPointsS2BasicOpens then
          tailSectionValueToColimitOfS2Mem n hU ≫ eqToHom (if_pos hU).symm
        else
          terminal.from ((tailPushforwardIntegerSheafModel n).obj.obj (op twoClosedPointsS2BasicOpens)) ≫
            eqToHom (if_neg hU).symm) =
        tailSectionValueToColimitOfS2Mem n twoClosedPointsS2Point_mem_s2_basic ≫
          eqToHom (if_pos twoClosedPointsS2Point_mem_s2_basic).symm from by
        erw [dif_pos twoClosedPointsS2Point_mem_s2_basic])

/-- Helper for Example 6.29.2: on the minimal `s1`-open, postcomposing the explicit `s1`
component with the positive-branch transport removes the `eqToHom` ambiguity. -/
private theorem twoClosedPointsS1_basic_mem_eq
    (h : twoClosedPointsS1Point ∈ twoClosedPointsS1BasicOpens) :
    h = twoClosedPointsS1Point_mem_s1_basic := by
  -- Membership proofs in a proposition are unique.
  exact Subsingleton.elim _ _

/-- Helper for Example 6.29.2: on the minimal `s1`-open, postcomposing the explicit `s1`
component with the positive-branch transport removes the `eqToHom` ambiguity. -/
private theorem tailPushforwardIntegerSheafModelToS1Skyscraper_basic_app_postcompose (n : ℕ) :
    ((tailPushforwardIntegerSheafModelToS1Skyscraper n).hom.app (op twoClosedPointsS1BasicOpens)) ≫
      eqToHom (if_pos twoClosedPointsS1Point_mem_s1_basic) =
    tailSectionValueToColimitOfS1Mem n twoClosedPointsS1Point_mem_s1_basic := by
  -- Rewrite to the explicit positive branch and then cancel the consecutive transports.
  rw [tailPushforwardIntegerSheafModelToS1Skyscraper_basic_app_eq]
  show tailSectionValueToColimitOfS1Mem n twoClosedPointsS1Point_mem_s1_basic ≫
      (eqToHom (if_pos twoClosedPointsS1Point_mem_s1_basic).symm ≫
        eqToHom (if_pos twoClosedPointsS1Point_mem_s1_basic)) =
    tailSectionValueToColimitOfS1Mem n twoClosedPointsS1Point_mem_s1_basic
  rw [eqToHom_trans, eqToHom_refl, Category.comp_id]

/-- Helper for Example 6.29.2: on the minimal `s2`-open, postcomposing the explicit `s2`
component with the positive-branch transport removes the `eqToHom` ambiguity. -/
private theorem twoClosedPointsS2_basic_mem_eq
    (h : twoClosedPointsS2Point ∈ twoClosedPointsS2BasicOpens) :
    h = twoClosedPointsS2Point_mem_s2_basic := by
  -- The same proof-irrelevance argument applies to the `s2` basic open.
  exact Subsingleton.elim _ _

/-- Helper for Example 6.29.2: on the minimal `s2`-open, postcomposing the explicit `s2`
component with the positive-branch transport removes the `eqToHom` ambiguity. -/
private theorem tailPushforwardIntegerSheafModelToS2Skyscraper_basic_app_postcompose (n : ℕ) :
    ((tailPushforwardIntegerSheafModelToS2Skyscraper n).hom.app (op twoClosedPointsS2BasicOpens)) ≫
      eqToHom (if_pos twoClosedPointsS2Point_mem_s2_basic) =
    tailSectionValueToColimitOfS2Mem n twoClosedPointsS2Point_mem_s2_basic := by
  -- The `s2` calculation is the same positive-branch transport cancellation.
  rw [tailPushforwardIntegerSheafModelToS2Skyscraper_basic_app_eq]
  show tailSectionValueToColimitOfS2Mem n twoClosedPointsS2Point_mem_s2_basic ≫
      (eqToHom (if_pos twoClosedPointsS2Point_mem_s2_basic).symm ≫
        eqToHom (if_pos twoClosedPointsS2Point_mem_s2_basic)) =
    tailSectionValueToColimitOfS2Mem n twoClosedPointsS2Point_mem_s2_basic
  rw [eqToHom_trans, eqToHom_refl, Category.comp_id]

/-- Helper for Example 6.29.2: on a minimal neighborhood of a closed point, the inverse germ
isomorphism for the skyscraper presheaf followed by the canonical stalk identification is the
obvious positive-branch transport. -/
private theorem minimal_basic_skyscraper_stalk_hom_eq
    (x : twoClosedPointsSpace) (U : Opens twoClosedPointsSpace) (hx : x ∈ U)
    [IsIso ((skyscraperPresheaf x eventualIntegerSequenceColimit).germ U x hx)] :
    (asIso ((skyscraperPresheaf x eventualIntegerSequenceColimit).germ U x hx)).inv ≫
        eqToHom (if_pos hx) =
      (skyscraperPresheafStalkOfSpecializes x eventualIntegerSequenceColimit
        specializes_rfl).hom := by
  -- Cancel the germ isomorphism and rewrite the composite by the standard skyscraper stalk
  -- computation on an open containing the support point.
  rw [← cancel_epi (asIso ((skyscraperPresheaf x eventualIntegerSequenceColimit).germ U x hx)).hom]
  simpa [Category.assoc] using
    (germ_skyscraperPresheafStalkOfSpecializes_hom
      (p₀ := x) (A := eventualIntegerSequenceColimit) specializes_rfl U hx).symm

/-- Helper for Example 6.29.2: after computing the stalk at `s1` on the minimal neighborhood, the
model-to-skyscraper map becomes the explicit tail-product leg into `M`. -/
private theorem tailPushforwardIntegerSheafModelToS1Skyscraper_stalk_eq (n : ℕ) :
    ((TopCat.Presheaf.stalkFunctor AddCommGrpCat twoClosedPointsS1Point).map
        (tailPushforwardIntegerSheafModelToS1Skyscraper n).hom) ≫
      (skyscraperPresheafStalkOfSpecializes twoClosedPointsS1Point eventualIntegerSequenceColimit
        specializes_rfl).hom =
    (tailPushforwardIntegerSheafModelStalkS1IsoToBasicSections n).hom ≫
      tailSectionValueToColimitOfS1Mem n twoClosedPointsS1Point_mem_s1_basic := by
  -- Compute the stalk map on the minimal neighborhood, then replace the basic-open component by
  -- the transport-free section-to-colimit map.
  let g :=
    (tailPushforwardIntegerSheafModel n).presheaf.germ
      twoClosedPointsS1BasicOpens twoClosedPointsS1Point
      twoClosedPointsS1Point_mem_s1_basic
  haveI : IsIso g := germ_s1_basic_isIso ((tailPushforwardIntegerSheafModel n).presheaf)
  let gSkyscraper :=
    (skyscraperSheaf twoClosedPointsS1Point eventualIntegerSequenceColimit).presheaf.germ
      twoClosedPointsS1BasicOpens twoClosedPointsS1Point
      twoClosedPointsS1Point_mem_s1_basic
  haveI : IsIso gSkyscraper := by
    simpa [gSkyscraper, skyscraperSheaf] using
      (germ_s1_basic_isIso
        (skyscraperPresheaf twoClosedPointsS1Point eventualIntegerSequenceColimit))
  haveI :
      IsIso
        ((skyscraperPresheaf twoClosedPointsS1Point eventualIntegerSequenceColimit).germ
          twoClosedPointsS1BasicOpens twoClosedPointsS1Point
          twoClosedPointsS1Point_mem_s1_basic) :=
    germ_s1_basic_isIso
      (skyscraperPresheaf twoClosedPointsS1Point eventualIntegerSequenceColimit)
  have hnat :=
    minimal_neighborhood_stalk_inv_naturality
      (x := twoClosedPointsS1Point) (U := twoClosedPointsS1BasicOpens)
      (hx := twoClosedPointsS1Point_mem_s1_basic)
      ((tailPushforwardIntegerSheafModelToS1Skyscraper n).hom)
  have hnat' :=
    congrArg
      (fun k ↦ k ≫ eqToHom (if_pos twoClosedPointsS1Point_mem_s1_basic))
      hnat
  have hsky :
      (asIso gSkyscraper).inv ≫ eqToHom (if_pos twoClosedPointsS1Point_mem_s1_basic) =
        (skyscraperPresheafStalkOfSpecializes twoClosedPointsS1Point eventualIntegerSequenceColimit
          specializes_rfl).hom := by
    simpa [gSkyscraper, skyscraperSheaf] using
      (minimal_basic_skyscraper_stalk_hom_eq
        twoClosedPointsS1Point twoClosedPointsS1BasicOpens
        twoClosedPointsS1Point_mem_s1_basic)
  have hsky_assoc :
      (((TopCat.Presheaf.stalkFunctor AddCommGrpCat twoClosedPointsS1Point).map
            (tailPushforwardIntegerSheafModelToS1Skyscraper n).hom) ≫
          (asIso gSkyscraper).inv) ≫
        eqToHom (if_pos twoClosedPointsS1Point_mem_s1_basic) =
      ((TopCat.Presheaf.stalkFunctor AddCommGrpCat twoClosedPointsS1Point).map
          (tailPushforwardIntegerSheafModelToS1Skyscraper n).hom) ≫
