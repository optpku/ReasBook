          symm
          simpa [tailPushforwardIntegerSheafStalkS1NatIsoToTailIntegerProduct, Category.assoc] using
            (HasColimit.isoOfNatIso_ι_hom
              (w := tailPushforwardIntegerSheafStalkS1NatIsoToTailIntegerProduct) n)

