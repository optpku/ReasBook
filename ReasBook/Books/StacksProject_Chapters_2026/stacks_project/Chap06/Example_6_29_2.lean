/-- Helper for Example 6.29.2: on the minimal `s1`-neighborhood, the section-to-colimit map is the
tail-product leg into `M`. -/
private theorem tailSectionValueToColimitOfS1Mem_basic_eq (n : ℕ) :
    tailSectionValueToColimitOfS1Mem n twoClosedPointsS1Point_mem_s1_basic =
      (tailSectionValueS1BasicIso n).hom ≫ colimit.ι tailIntegerProductFunctor n := by
  -- Both morphisms evaluate a section on the same tail index and then apply the colimit leg.
  ext f
  rfl

