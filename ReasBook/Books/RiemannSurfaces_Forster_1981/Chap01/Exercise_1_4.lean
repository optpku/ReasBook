/-- Exercise 1.4: two lattices in `ℂ` generated by period pairs are equal if and only if their
ordered generators differ by a unimodular change-of-basis matrix. -/
theorem periodPair_lattice_eq_iff_exists_gl2z (L L' : PeriodPair) :
    L.lattice = L'.lattice ↔
      ∃ A : GL (Fin 2) ℤ,
        ![L'.ω₁, L'.ω₂] =
          Matrix.mulVec ((A : Matrix (Fin 2) (Fin 2) ℤ).map (Int.castRingHom ℂ))
            ![L.ω₁, L.ω₂] :=
  sorry
