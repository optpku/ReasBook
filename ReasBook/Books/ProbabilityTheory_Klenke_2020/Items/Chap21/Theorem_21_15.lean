-- Declarations for this item will be appended below by the statement pipeline.

open MeasureTheory ProbabilityTheory
open scoped MeasureTheory

noncomputable section

universe u

namespace ProbabilityTheory

variable {Ω : Type u} [MeasurableSpace Ω]

section

variable {μ : Measure Ω} {B : NNReal → Ω → ℝ} (hB : IsBrownianMotion μ B)

local notation "ℱB" => Filtration.natural B hB.stronglyMeasurable
local notation "ℱB₊" => Filtration.rightCont ℱB

/-- Helper for Theorem 21.15: the dyadic time grid `2^{-n}` used to probe the Brownian path near
`0`. -/
private def dyadicTime (n : ℕ) : NNReal :=
  ((2 : NNReal)⁻¹) ^ n

/-- Helper for Theorem 21.15: the dyadic time grid decreases with `n`. -/
private lemma dyadicTime_antitone : Antitone dyadicTime := by
  -- Proof comment: powers of a number in `[0, 1]` decrease when the exponent increases.
  intro n m hnm
  dsimp [dyadicTime]
  rcases Nat.exists_eq_add_of_le hnm with ⟨k, rfl⟩
  calc
    ((2 : NNReal)⁻¹) ^ (n + k) = ((2 : NNReal)⁻¹) ^ n * ((2 : NNReal)⁻¹) ^ k := by
      rw [pow_add]
    _ ≤ ((2 : NNReal)⁻¹) ^ n * 1 := by
      gcongr
      exact pow_le_one₀ (by positivity) (by norm_num)
    _ = ((2 : NNReal)⁻¹) ^ n := by simp

/-- Helper for Theorem 21.15: two successive dyadic steps add back up to the previous one. -/
private lemma dyadicTime_succ_add (n : ℕ) :
    dyadicTime (n + 1) + dyadicTime (n + 1) = dyadicTime n := by
  -- Proof comment: factor out the common power `2⁻¹ ^ n` and collapse the remaining coefficient
  -- `(2⁻¹ + 2⁻¹)` to `1`.
  calc
    dyadicTime (n + 1) + dyadicTime (n + 1)
        = ((2 : NNReal)⁻¹) ^ n * (((2 : NNReal)⁻¹) + (2 : NNReal)⁻¹) := by
            simp [dyadicTime, pow_succ, mul_add, add_mul, mul_comm, mul_left_comm, mul_assoc]
    _ = ((2 : NNReal)⁻¹) ^ n := by
      norm_num
    _ = dyadicTime n := by
      simp [dyadicTime]

/-- Helper for Theorem 21.15: the `n`th dyadic block is indexed by the time offsets inside the
interval `[2^{-(n+1)}, 2^{-n}]`. -/
private abbrev dyadicBlockCoord (n : ℕ) :=
  Set.Icc (0 : NNReal) (dyadicTime (n + 1))

/-- Helper for Theorem 21.15: the `n`th dyadic Brownian increment block, viewed as a real-valued
process on the interval `[0, 2^{-(n+1)}]`. -/
private def dyadicBlock (n : ℕ) (ω : Ω) (u : dyadicBlockCoord n) : ℝ :=
  B (dyadicTime (n + 1) + u) ω - B (dyadicTime (n + 1)) ω

/-- Helper for Theorem 21.15: the `σ`-algebra generated by the `n`th dyadic increment block. -/
private abbrev dyadicBlockSigma (n : ℕ) : MeasurableSpace Ω :=
  MeasurableSpace.comap (dyadicBlock (B := B) n) MeasurableSpace.pi

/-- Helper for Theorem 21.15: each dyadic block map is measurable into the ambient product space. -/
private lemma measurable_dyadicBlock (_hB : IsBrownianMotion μ B) (n : ℕ) :
    Measurable (dyadicBlock (B := B) n) := by
  -- Proof comment: each coordinate of the block is a Brownian increment at a deterministic time,
  -- so the whole block map is measurable into the product space.
  refine measurable_pi_lambda _ fun u ↦ ?_
  exact
    (IsBrownianMotion.stronglyMeasurable _hB (dyadicTime (n + 1) + u)).measurable.sub
      (IsBrownianMotion.stronglyMeasurable _hB (dyadicTime (n + 1))).measurable

/-- Helper for Theorem 21.15: Brownian coordinates are square-integrable at every deterministic
time. -/
private lemma brownianEval_memLpTwoLocal (_hB : IsBrownianMotion μ B) (t : NNReal) :
    MemLp (B t) 2 μ := by
  letI : IsProbabilityMeasure μ := IsBrownianMotion.isProbabilityMeasure _hB
  by_cases ht : t = 0
  · -- Proof comment: the time-zero Brownian coordinate is identically zero.
    subst ht
    simp [_hB.zero]
  · -- Proof comment: every positive-time Brownian marginal is Gaussian, hence belongs to `L²`.
    exact (_hB.gaussian_marginal (pos_iff_ne_zero.mpr ht)).hasGaussianLaw.memLp_two

/-- Helper for Theorem 21.15: the past path up to time `s` generates the natural Brownian
filtration at time `s`. -/
private lemma naturalFiltration_eq_pastPath (s : NNReal) :
    ℱB s = MeasurableSpace.comap (fun ω (u : Set.Iic s) ↦ B u ω) MeasurableSpace.pi := by
  -- Proof comment: both sides are the supremum of the coordinate σ-algebras given by the
  -- evaluations `u ↦ B u` with `u ≤ s`, once written explicitly and once bundled as a path map.
  change (⨆ j, ⨆ (_ : j ≤ s), MeasurableSpace.comap (B j) Real.measurableSpace) =
    MeasurableSpace.comap (fun ω (u : Set.Iic s) ↦ B u ω) MeasurableSpace.pi
  rw [MeasurableSpace.pi, MeasurableSpace.comap_iSup]
  simp only [MeasurableSpace.comap_comp]
  refine le_antisymm ?_ ?_
  · refine iSup₂_le ?_
    intro j hj
    exact le_iSup_of_le ⟨j, hj⟩ le_rfl
  · refine iSup_le ?_
    intro u
    exact le_iSup_of_le (u : NNReal) <| le_iSup_of_le u.2 le_rfl

/-- Helper for Theorem 21.15: the bundled past path up to time `s`. -/
private abbrev pastPathSigma (s : NNReal) : MeasurableSpace Ω :=
  MeasurableSpace.comap (fun ω (u : Set.Iic s) ↦ B u ω) MeasurableSpace.pi

/-- Helper for Theorem 21.15: independence is monotone in the right σ-algebra argument. -/
private lemma indep_of_right_le {m₁ m₂ m₃ : MeasurableSpace Ω}
    (h : Indep m₁ m₂ μ) (h₃₂ : m₃ ≤ m₂) :
    Indep m₁ m₃ μ := by
  -- Proof comment: every `m₃`-measurable event is also `m₂`-measurable, so the defining
  -- independence identity for `m₁` versus `m₂` specializes immediately.
  rw [Indep_iff] at h ⊢
  intro s t hs ht
  exact h s t hs (show MeasurableSet[m₂] t from h₃₂ t ht)

/-- Helper for Theorem 21.15: every strictly later dyadic block is already measurable with
respect to the Brownian past path up to the earlier dyadic start time. -/
private lemma dyadicBlockSigma_le_pastPath_of_lt {n k : ℕ} (hnk : n < k) :
    dyadicBlockSigma (B := B) k ≤ pastPathSigma (B := B) (dyadicTime (n + 1)) := by
  -- Proof comment: every coordinate of the later block only uses the Brownian path at two times
  -- lying in `[0, 2^{-(n+1)}]`, so the whole block factors measurably through the bundled past
  -- path up to that earlier dyadic time.
  let s : NNReal := dyadicTime (n + 1)
  have hEval :
      ∀ {t : NNReal}, t ≤ s →
        Measurable[MeasurableSpace.comap (fun ω (v : Set.Iic s) ↦ B v ω) MeasurableSpace.pi]
          (fun ω ↦ B t ω) := by
    intro t ht
    let u : Set.Iic s := ⟨t, ht⟩
    -- Proof comment: a fixed past-time coordinate is just an evaluation map on the bundled past
    -- path.
    have hPath :
        Measurable[MeasurableSpace.comap (fun ω (v : Set.Iic s) ↦ B v ω) MeasurableSpace.pi]
          (fun ω ↦ fun v : Set.Iic s ↦ B v ω) :=
      Measurable.of_comap_le le_rfl
    simpa [u] using (measurable_pi_apply u).comp hPath
  have hMeas :
      Measurable[MeasurableSpace.comap (fun ω (v : Set.Iic s) ↦ B v ω) MeasurableSpace.pi]
        (dyadicBlock (B := B) k) := by
    let _ : MeasurableSpace Ω :=
      MeasurableSpace.comap (fun ω (v : Set.Iic s) ↦ B v ω) MeasurableSpace.pi
    change
      Measurable
        (fun ω (u : dyadicBlockCoord k) ↦
          B (dyadicTime (k + 1) + u) ω - B (dyadicTime (k + 1)) ω)
    refine measurable_pi_iff.mpr ?_
    intro u
    change
      Measurable (fun ω ↦ B (dyadicTime (k + 1) + u) ω - B (dyadicTime (k + 1)) ω)
    exact by
      have hStart_le : dyadicTime (k + 1) ≤ s := by
        simpa [s] using dyadicTime_antitone (Nat.succ_le_succ (Nat.le_of_lt hnk))
      have hEnd_le : dyadicTime (k + 1) + u ≤ s := by
        calc
          dyadicTime (k + 1) + u ≤ dyadicTime (k + 1) + dyadicTime (k + 1) := by
            gcongr
            exact u.2.2
          _ = dyadicTime k := by rw [dyadicTime_succ_add]
          _ ≤ s := by
            simpa [s] using dyadicTime_antitone (Nat.succ_le_of_lt hnk)
      -- Proof comment: the block coordinate is the difference of two past-path evaluations.
      exact (hEval hEnd_le).sub (hEval hStart_le)
  simpa [pastPathSigma, s] using hMeas.comap_le

/-- Helper for Theorem 21.15: the `n`th dyadic Brownian increment block is independent of the
entire Brownian past path up to its left endpoint `2^{-(n+1)}`. -/
private lemma dyadicBlock_indep_pastPath (_hB : IsBrownianMotion μ B) (n : ℕ) :
    Indep (dyadicBlockSigma (B := B) n) (pastPathSigma (B := B) (dyadicTime (n + 1))) μ := by
  letI : IsProbabilityMeasure μ := IsBrownianMotion.isProbabilityMeasure _hB
  let s : NNReal := dyadicTime (n + 1)
  let hGaussian : IsGaussianProcess B μ := brownianMotion_isGaussianProcess _hB
  have hJoint :
      IsGaussianProcess
        (Sum.elim
          (fun u : dyadicBlockCoord n => fun ω ↦ dyadicBlock (B := B) n ω u)
          (fun u : Set.Iic s => fun ω ↦ B u ω))
        μ := by
    -- Proof comment: both coordinates are continuous linear images of finitely many Brownian
    -- evaluations, so the joint family remains Gaussian.
    refine hGaussian.of_isGaussianProcess ?_
    intro z
    cases z with
    | inl u =>
        refine ⟨{s + u, s}, ?_, ?_⟩
        · -- Proof comment: use the canonical coordinate projections on the finite evaluation set.
          exact ContinuousLinearMap.proj ⟨s + u, by simp⟩ - ContinuousLinearMap.proj ⟨s, by simp⟩
        · -- Proof comment: evaluating this linear functional on the Brownian path vector recovers
          -- the dyadic block coordinate.
          intro ω
          simp [dyadicBlock, s]
    | inr u =>
        refine ⟨{(u : NNReal)}, ?_, ?_⟩
        · -- Proof comment: a past-path coordinate is itself the canonical projection.
          exact ContinuousLinearMap.proj ⟨(u : NNReal), by simp⟩
        · -- Proof comment: a past-path coordinate is just evaluation at the corresponding time.
          intro ω
          simp
  have hIndepFun :
      IndepFun
        (fun ω ↦ dyadicBlock (B := B) n ω)
        (fun ω (u : Set.Iic s) ↦ B u ω)
        μ := by
    -- Proof comment: once the joint family is Gaussian, vanishing covariance against every past
    -- coordinate upgrades directly to independence from the full past path.
    refine ProbabilityTheory.IsGaussianProcess.indepFun_of_covariance_eq_zero hJoint ?_ ?_ ?_
    · intro u
      exact
        (IsBrownianMotion.stronglyMeasurable _hB (s + u)).aemeasurable.sub
          (IsBrownianMotion.stronglyMeasurable _hB s).aemeasurable
    · intro u
      exact (IsBrownianMotion.stronglyMeasurable _hB u).aemeasurable
    · intro u v
      have hs_mem : MemLp (B s) 2 μ := brownianEval_memLpTwoLocal _hB s
      have hsu_mem : MemLp (B (s + u)) 2 μ := brownianEval_memLpTwoLocal _hB (s + u)
      have hv_mem : MemLp (B v) 2 μ := brownianEval_memLpTwoLocal _hB v
      have hv_le_s : (v : NNReal) ≤ s := v.2
      have hv_le_su : (v : NNReal) ≤ s + u := by
        exact le_trans hv_le_s (le_add_of_nonneg_right u.2.1)
      have hsu_cov : cov[B (s + u), B v; μ] = (v : ℝ) := by
        simpa [inf_eq_right.mpr hv_le_su] using brownianMotion_covariance_eq _hB (s + u) v
      have hs_cov : cov[B s, B v; μ] = (v : ℝ) := by
        simpa [inf_eq_right.mpr hv_le_s] using brownianMotion_covariance_eq _hB s v
      -- Proof comment: the increment covariance is the difference of two identical Brownian
      -- kernels.
      simpa [dyadicBlock, s] using
        (show cov[fun ω ↦ B (s + u) ω - B s ω, B v; μ] = 0 from by
          rw [covariance_fun_sub_left hsu_mem hs_mem hv_mem, hsu_cov, hs_cov]
          ring)
  simpa [dyadicBlockSigma, pastPathSigma, s] using
    (ProbabilityTheory.IndepFun_iff_Indep _ _ _).mp hIndepFun

/-- Helper for Theorem 21.15: the upper endpoint of the `n`th dyadic block interval. -/
private def dyadicUpperCoord (n : ℕ) : dyadicBlockCoord n :=
  ⟨dyadicTime (n + 1), by simp [dyadicBlockCoord]⟩

/-- Helper for Theorem 21.15: evaluating the `n`th dyadic block at its upper endpoint gives the
increment from time `2^{-(n+1)}` to time `2^{-n}`. -/
private lemma dyadicBlock_apply_upperCoord (n : ℕ) (ω : Ω) :
    dyadicBlock (B := B) n ω (dyadicUpperCoord n) =
      B (dyadicTime n) ω - B (dyadicTime (n + 1)) ω := by
  -- Proof comment: the upper block coordinate is exactly the missing dyadic half-interval length,
  -- so the block endpoint lands at time `2^{-n}`.
  simp [dyadicBlock, dyadicUpperCoord, dyadicTime_succ_add]

/-- Helper for Theorem 21.15: each adjacent dyadic endpoint increment is measurable with respect
to the corresponding dyadic block `σ`-algebra. -/
private lemma measurable_dyadicEndpointIncrement (n : ℕ) :
    Measurable[dyadicBlockSigma (B := B) n]
      (fun ω ↦ B (dyadicTime n) ω - B (dyadicTime (n + 1)) ω) := by
  -- Proof comment: this increment is just the coordinate projection of the block process at the
  -- block's upper endpoint.
  have hcoord :
      Measurable[dyadicBlockSigma (B := B) n]
        (fun ω ↦ dyadicBlock (B := B) n ω (dyadicUpperCoord n)) := by
    exact
      (show Measurable (fun z : dyadicBlockCoord n → ℝ ↦ z (dyadicUpperCoord n)) from
        measurable_pi_apply (dyadicUpperCoord n)).comp (Measurable.of_comap_le le_rfl)
  simpa [dyadicBlock_apply_upperCoord (B := B) n] using hcoord

/-- Helper for Theorem 21.15: finite tails of adjacent dyadic endpoint increments telescope to the
difference between the first and last dyadic endpoints. -/
private lemma sum_dyadicEndpointIncrements (n N : ℕ) (ω : Ω) :
    Finset.sum (Finset.range (N + 1))
        (fun k ↦ B (dyadicTime (n + k)) ω - B (dyadicTime (n + k + 1)) ω) =
      B (dyadicTime n) ω - B (dyadicTime (n + N + 1)) ω := by
  induction N with
  | zero =>
      -- Proof comment: the one-term sum is exactly the first adjacent dyadic increment.
      simp
  | succ N ih =>
      -- Proof comment: append one more adjacent increment and cancel the intermediate endpoint.
      rw [Finset.sum_range_succ, ih]
      ring_nf

/-- Helper for Theorem 21.15: the dyadic-tail `σ`-algebra starting from stage `n`. -/
private abbrev tailStage (n : ℕ) : MeasurableSpace Ω :=
  ⨆ j : Set.Ici n, dyadicBlockSigma (B := B) j.1

/-- Helper for Theorem 21.15: the dyadic tail stage is the pullback of the full tail-family map
into the ambient product space. -/
private lemma tailStage_eq_comap_tailFamily (n : ℕ) :
    tailStage (B := B) n =
      MeasurableSpace.comap
        (fun ω (j : Set.Ici n) ↦ dyadicBlock (B := B) j.1 ω)
        MeasurableSpace.pi := by
  -- Proof comment: the tail stage is the supremum of the dyadic-block coordinate pullbacks, and
  -- `MeasurableSpace.pi` packages exactly that supremum into one product-space comap.
  rw [tailStage, MeasurableSpace.pi, MeasurableSpace.comap_iSup]
  refine iSup_congr fun j ↦ ?_
  rw [MeasurableSpace.comap_comp]
  rw [dyadicBlockSigma]
  rfl

/-- Helper for Theorem 21.15: the adjacent dyadic endpoint increment at level `k` is already
measurable with respect to every earlier dyadic tail stage `n ≤ k`. -/
private lemma measurable_dyadicEndpointIncrement_tailStage {n k : ℕ} (hnk : n ≤ k) :
    Measurable[tailStage (B := B) n]
      (fun ω ↦ B (dyadicTime k) ω - B (dyadicTime (k + 1)) ω) := by
  -- Proof comment: the increment is measurable in its own block `σ`-algebra, and that block is one
  -- coordinate of the tail supremum.
  exact
    Measurable.mono
      (measurable_dyadicEndpointIncrement (B := B) k)
      (le_iSup_of_le ⟨k, hnk⟩ le_rfl)
      le_rfl

/-- Helper for Theorem 21.15: the finite telescoping sums used to reconstruct a dyadic endpoint
from the smaller dyadic blocks. -/
private def dyadicEndpointTailApprox (k N : ℕ) : Ω → ℝ :=
  fun ω ↦
    Finset.sum (Finset.range (N + 1))
      (fun r ↦ B (dyadicTime (k + r)) ω - B (dyadicTime (k + r + 1)) ω)

/-- Helper for Theorem 21.15: every finite endpoint-reconstruction partial sum is measurable in
the corresponding dyadic tail stage. -/
private lemma measurable_dyadicEndpointTailApprox_tailStage {n k : ℕ} (hnk : n ≤ k) (N : ℕ) :
    Measurable[tailStage (B := B) n] (dyadicEndpointTailApprox (B := B) k N) := by
  -- Proof comment: each summand comes from one dyadic block inside the same tail stage, so the
  -- finite sum stays measurable.
  unfold dyadicEndpointTailApprox
  refine Finset.measurable_sum _ fun r hr ↦ ?_
  exact
    measurable_dyadicEndpointIncrement_tailStage (B := B) (n := n) (k := k + r)
      (by omega)

/-- Helper for Theorem 21.15: every dyadic endpoint `B (2^{-k})` with `k ≥ n` admits a version
measurable with respect to the dyadic tail stage starting at `n`. -/
private lemma exists_tailEndpointVersion (_hB : IsBrownianMotion μ B) (n k : ℕ) (hnk : n ≤ k) :
    ∃ g : Ω → ℝ,
      StronglyMeasurable[tailStage (B := B) n] g ∧
        g =ᵐ[μ] fun ω ↦ B (dyadicTime k) ω := by
  let g : Ω → ℝ := fun ω ↦
    Filter.limsup (fun N ↦ dyadicEndpointTailApprox (B := B) k N ω) Filter.atTop
  refine ⟨g, ?_, ?_⟩
  · -- Proof comment: the limsup of tail-measurable partial sums stays measurable in the same tail
    -- `σ`-algebra.
    change StronglyMeasurable[tailStage (B := B) n]
      (fun ω ↦ Filter.limsup (fun N ↦ dyadicEndpointTailApprox (B := B) k N ω) Filter.atTop)
    exact
      (Measurable.limsup
        (fun N ↦ measurable_dyadicEndpointTailApprox_tailStage (B := B) hnk N)).stronglyMeasurable
  · have hcont_paths : ∀ᵐ ω ∂μ, Continuous (fun t : NNReal ↦ B t ω) := by
      simpa [HasAlmostSurelyContinuousPaths, processPath] using _hB.continuous_paths
    filter_upwards [hcont_paths] with ω hω
    have hdyadic_zero :
        Filter.Tendsto (fun N : ℕ ↦ dyadicTime (k + N + 1)) Filter.atTop (nhds 0) := by
      have hpow :
          Filter.Tendsto (fun N : ℕ ↦ ((2 : NNReal)⁻¹) ^ N) Filter.atTop (nhds 0) := by
        have hhalf : ((2 : NNReal)⁻¹) < 1 := by norm_num
        exact NNReal.tendsto_pow_atTop_nhds_zero_of_lt_one hhalf
      have hconstMul :
          Filter.Tendsto (fun N : ℕ ↦ dyadicTime (k + 1) * (((2 : NNReal)⁻¹) ^ N)) Filter.atTop
            (nhds (dyadicTime (k + 1) * 0)) :=
        hpow.const_mul (dyadicTime (k + 1))
      convert hconstMul using 1
      · ext N
        simp [dyadicTime, pow_add, add_assoc, add_left_comm, add_comm, mul_left_comm, mul_assoc,
          mul_comm]
      · simp
    have htail_zero :
        Filter.Tendsto (fun N : ℕ ↦ B (dyadicTime (k + N + 1)) ω) Filter.atTop
          (nhds (B 0 ω)) :=
      hω.continuousAt.tendsto.comp hdyadic_zero
    have happrox :
        Filter.Tendsto (fun N : ℕ ↦ dyadicEndpointTailApprox (B := B) k N ω) Filter.atTop
          (nhds (B (dyadicTime k) ω - B 0 ω)) := by
      refine Filter.Tendsto.congr' ?_ (htail_zero.const_sub (B (dyadicTime k) ω))
      exact Filter.Eventually.of_forall fun N ↦ by
        simp [dyadicEndpointTailApprox, sum_dyadicEndpointIncrements (B := B) k N]
    simpa [g, _hB.zero] using happrox.limsup_eq

/-- Helper for Theorem 21.15: a fixed point inside the `m`th dyadic annulus also admits a version
measurable with respect to any earlier dyadic tail stage `n ≤ m`. -/
private lemma exists_tailBlockPointVersion (_hB : IsBrownianMotion μ B)
    (n m : ℕ) (hnm : n ≤ m) (u : dyadicBlockCoord m) :
    ∃ g : Ω → ℝ,
      StronglyMeasurable[tailStage (B := B) n] g ∧
        g =ᵐ[μ] fun ω ↦ B (dyadicTime (m + 1) + u) ω := by
  rcases exists_tailEndpointVersion (B := B) _hB n (m + 1)
      (Nat.le_add_right_of_le hnm) with
    ⟨g₀, hg₀, hg₀_ae⟩
  let g : Ω → ℝ := fun ω ↦ g₀ ω + dyadicBlock (B := B) m ω u
  refine ⟨g, ?_, ?_⟩
  · -- Proof comment: add the recovered left endpoint to the tail-measurable block coordinate in
    -- the current annulus.
    refine hg₀.add ?_
    have hcoord :
        Measurable[dyadicBlockSigma (B := B) m] (fun ω ↦ dyadicBlock (B := B) m ω u) := by
      exact
        (show Measurable (fun z : dyadicBlockCoord m → ℝ ↦ z u) from
          measurable_pi_apply u).comp (Measurable.of_comap_le le_rfl)
    exact
      (Measurable.mono hcoord (le_iSup_of_le ⟨m, hnm⟩ le_rfl) le_rfl).stronglyMeasurable
  · filter_upwards [hg₀_ae] with ω hω
    simp [g, dyadicBlock, hω, sub_eq_add_neg, add_assoc, add_left_comm, add_comm]

/-- Helper for Theorem 21.15: every positive time `t ≤ 2^{-n}` lies in a unique dyadic annulus
`[2^{-(m+1)}, 2^{-m}]` with `m ≥ n`. -/
private lemma exists_dyadicAnnulus {n : ℕ} {t : NNReal}
    (ht : t ≤ dyadicTime n) (ht0 : t ≠ 0) :
    ∃ m ≥ n, dyadicTime (m + 1) < t ∧ t ≤ dyadicTime m := by
  have ht_le_one : t ≤ 1 := by
    calc
      t ≤ dyadicTime n := ht
      _ ≤ dyadicTime 0 := dyadicTime_antitone (Nat.zero_le n)
      _ = 1 := by simp [dyadicTime]
  have hex : ∃ p : ℕ, dyadicTime p < t := by
    rcases ENNReal.exists_inv_two_pow_lt (a := (t : ENNReal))
        (by simpa using ENNReal.coe_ne_zero.2 ht0) with ⟨p, hp⟩
    refine ⟨p, ?_⟩
    exact ENNReal.coe_lt_coe.mp (by simpa [dyadicTime, ← inv_pow] using hp)
  let p := Nat.find hex
  have hp : dyadicTime p < t := Nat.find_spec hex
  have hp_ne_zero : p ≠ 0 := by
    intro hp0
    have : (1 : NNReal) < t := by
      simpa [p, hp0, dyadicTime] using hp
    exact not_lt_of_ge ht_le_one this
  have hnp : n < p := by
    by_contra hnp
    have hp_le_n : p ≤ n := Nat.not_lt.mp hnp
    have htp : t ≤ dyadicTime p := by
      exact le_trans ht (dyadicTime_antitone hp_le_n)
    exact not_lt_of_ge htp hp
  refine ⟨p - 1, by omega, ?_, ?_⟩
  · simpa [Nat.sub_add_cancel (Nat.succ_le_of_lt (Nat.pos_of_ne_zero hp_ne_zero))] using hp
  · apply le_of_not_gt
    intro hlt
    have hp_min : p ≤ p - 1 := Nat.find_min' hex hlt
    omega

/-- Helper for Theorem 21.15: the dyadic tail stages decrease with the starting index. -/
private lemma tailStage_antitone : Antitone (tailStage (B := B)) := by
  -- Proof comment: increasing the starting index removes generators from the tail supremum.
  intro n m hnm
  refine iSup_le fun j ↦ ?_
  exact le_iSup_of_le ⟨j.1, le_trans hnm j.2⟩ le_rfl

/-- Helper for Theorem 21.15: every Brownian coordinate `B t` with `t ≤ 2^{-n}` admits a
`tailStage n`-measurable version. -/
private lemma exists_tailTimeVersion (_hB : IsBrownianMotion μ B)
    (n : ℕ) {t : NNReal} (ht : t ≤ dyadicTime n) :
    ∃ g : Ω → ℝ,
      StronglyMeasurable[tailStage (B := B) n] g ∧
        g =ᵐ[μ] fun ω ↦ B t ω := by
  by_cases ht0 : t = 0
  · subst ht0
    refine ⟨fun _ ↦ 0, stronglyMeasurable_const, ?_⟩
    simpa [_hB.zero]
  · rcases exists_dyadicAnnulus ht ht0 with ⟨m, hmn, hlower, hupper⟩
    let u : dyadicBlockCoord m :=
      ⟨t - dyadicTime (m + 1), by
        refine ⟨by positivity, ?_⟩
        have hsum : t ≤ dyadicTime (m + 1) + dyadicTime (m + 1) := by
          simpa [dyadicTime_succ_add] using hupper
        exact tsub_le_iff_right.mpr hsum⟩
    have hu : dyadicTime (m + 1) + (u : NNReal) = t := by
      simpa [u, add_comm] using tsub_add_cancel_of_le hlower.le
    rcases exists_tailBlockPointVersion (B := B) _hB n m hmn u with ⟨g, hg_meas, hg_ae⟩
    refine ⟨g, hg_meas, ?_⟩
    refine hg_ae.trans ?_
    filter_upwards with ω
    simpa [hu]

/-- Helper for Theorem 21.15: coordinatewise almost-everywhere equality on a finite tuple upgrades
to almost-everywhere equality of the whole tuple map. -/
private lemma tailTuple_ae_eq_brownianTuple (_hB : IsBrownianMotion μ B)
    (n : ℕ) {I : Finset (Set.Iic (dyadicTime n))} {g : I → Ω → ℝ}
    (hg : ∀ i : I, g i =ᵐ[μ] fun ω ↦ B (i : Set.Iic (dyadicTime n)) ω) :
    (fun ω i ↦ g i ω) =ᵐ[μ] (fun ω i ↦ B (i : Set.Iic (dyadicTime n)) ω) := by
  -- Proof comment: since the coordinate index type `I` is finite, the pointwise AE equalities
  -- combine into one AE statement for the whole tuple.
  have hall :
      ∀ᵐ ω ∂μ, ∀ i : I, g i ω = B (i : Set.Iic (dyadicTime n)) ω := by
    exact MeasureTheory.ae_all_iff.2 hg
  filter_upwards [hall] with ω hω
  ext i
  exact hω i

/-- Helper for Theorem 21.15: pulling a finite cylinder back along the full past-path map is the
same as pulling the cylinder set back along the corresponding finite Brownian tuple. -/
private lemma pastPath_preimage_cylinder_eq_tuplePreimage (n : ℕ)
    (I : Finset (Set.Iic (dyadicTime n))) (S : Set (∀ i : I, ℝ)) :
    (fun ω (u : Set.Iic (dyadicTime n)) ↦ B u ω) ⁻¹' MeasureTheory.cylinder I S =
      (fun ω ↦ fun i : I ↦ B (i : Set.Iic (dyadicTime n)) ω) ⁻¹' S := by
  -- Proof comment: both sides say exactly that the finite restriction of the Brownian past path
  -- belongs to the cylinder base set `S`.
  ext ω
  simp [MeasureTheory.cylinder]
  have hrestrict :
      I.restrict (fun u : Set.Iic (dyadicTime n) ↦ B u ω) =
        (fun i : I ↦ B (i : Set.Iic (dyadicTime n)) ω) := by
    funext i
    rfl
  simpa [hrestrict]

/-- Helper for Theorem 21.15: every measurable event of the product past-path space at dyadic
stage `n` admits a representative measurable with respect to the dyadic tail stage `n`. -/
private lemma exists_tailRepresentative_of_piMeasurable (_hB : IsBrownianMotion μ B)
    (n : ℕ) {T : Set (Set.Iic (dyadicTime n) → ℝ)} (hT : MeasurableSet[MeasurableSpace.pi] T) :
    ∃ C : Set Ω, MeasurableSet[tailStage (B := B) n] C ∧
      (fun ω (u : Set.Iic (dyadicTime n)) ↦ B u ω) ⁻¹' T =ᵐ[μ] C := by
  let past : Ω → Set.Iic (dyadicTime n) → ℝ := fun ω u ↦ B u ω
  -- Proof comment: induct on measurable subsets of the product path space, keeping only the tail
  -- representative on `Ω` as the induction payload.
  let Cprop :
      ∀ S : Set (Set.Iic (dyadicTime n) → ℝ), MeasurableSet[MeasurableSpace.pi] S → Prop :=
    fun S _ ↦
      ∃ C : Set Ω, MeasurableSet[tailStage (B := B) n] C ∧ past ⁻¹' S =ᵐ[μ] C
  have hAll :
      ∀ S : Set (Set.Iic (dyadicTime n) → ℝ), ∀ hS : MeasurableSet[MeasurableSpace.pi] S,
        Cprop S hS := by
    refine
      MeasurableSpace.induction_on_inter
        (m := MeasurableSpace.pi)
        (C := Cprop)
        (s := measurableCylinders fun _ : Set.Iic (dyadicTime n) ↦ ℝ)
        MeasureTheory.generateFrom_measurableCylinders.symm
        MeasureTheory.isPiSystem_measurableCylinders
        ?empty ?basic ?compl ?iUnion
    · -- Proof comment: the empty event is already tail measurable and agrees exactly with its
      -- own pullback.
      refine ⟨∅, ?_, ?_⟩
      · show MeasurableSet[tailStage (B := B) n] (∅ : Set Ω)
        simp
      · simp
    · intro S hS
      classical
      let I : Finset (Set.Iic (dyadicTime n)) := measurableCylinders.finset hS
      let U : Set (∀ i : I, ℝ) := measurableCylinders.set hS
      have hU : MeasurableSet U := measurableCylinders.measurableSet hS
      have hS_eq : S = MeasureTheory.cylinder I U := measurableCylinders.eq_cylinder hS
      choose g hg_meas hg_ae using
        (fun i : I ↦ exists_tailTimeVersion (B := B) _hB n (ht := (i : Set.Iic (dyadicTime n)).2))
      let tailTuple : Ω → I → ℝ := fun ω i ↦ g i ω
      have htailTuple_meas : Measurable[tailStage (B := B) n] tailTuple := by
        -- Proof comment: the representative tuple is measurable coordinatewise in the tail stage.
        let _ : MeasurableSpace Ω := tailStage (B := B) n
        change Measurable tailTuple
        refine measurable_pi_lambda _ fun i ↦ ?_
        exact (hg_meas i).measurable
      let C : Set Ω := tailTuple ⁻¹' U
      have hC_meas : MeasurableSet[tailStage (B := B) n] C := hU.preimage htailTuple_meas
      have htuple_ae :
          tailTuple =ᵐ[μ] fun ω i ↦ B (i : Set.Iic (dyadicTime n)) ω :=
        tailTuple_ae_eq_brownianTuple (B := B) _hB n hg_ae
      refine ⟨C, hC_meas, ?_⟩
      -- Proof comment: finite cylinders only see finitely many coordinates, so the tuple AE
      -- equality transfers directly to the pullback event.
      rw [hS_eq, pastPath_preimage_cylinder_eq_tuplePreimage (B := B) n I U]
      exact (htuple_ae.preimage U).symm
    · intro S hSm hS
      rcases hS with ⟨C, hC_meas, hC_eq⟩
      refine ⟨Cᶜ, hC_meas.compl, ?_⟩
      -- Proof comment: complements preserve eventual equality pointwise.
      filter_upwards [hC_eq] with ω hω
      exact propext (not_congr (show (past ⁻¹' S) ω ↔ C ω from by simpa using hω))
    · intro f _ hf_meas hf_rep
      choose C hC_meas hC_eq using hf_rep
      refine ⟨⋃ i, C i, MeasurableSet.iUnion hC_meas, ?_⟩
      -- Proof comment: countable unions preserve eventual equality through
      -- `EventuallyEq.countable_iUnion`.
      have hUnion : (⋃ i, past ⁻¹' f i) =ᵐ[μ] ⋃ i, C i :=
        Filter.EventuallyEq.countable_iUnion hC_eq
      filter_upwards [hUnion] with ω hω
      simpa [Set.mem_iUnion] using hω
  exact hAll T hT

/-- Helper for Theorem 21.15: every event in `ℱB (2^{-n})` has a representative measurable with
respect to the dyadic tail stage starting at `n`. -/
private lemma measurableSet_dyadicStage_hasTailRepresentative
    (n : ℕ) {A : Set Ω} (hA : MeasurableSet[ℱB (dyadicTime n)] A) :
    ∃ C : Set Ω, MeasurableSet[tailStage (B := B) n] C ∧ A =ᵐ[μ] C := by
  -- Route correction: instead of inducting on `Ω`-events in the pullback sigma-algebra, unpack
  -- the event as the pullback of a measurable set in path space and induct there.
  rw [naturalFiltration_eq_pastPath (B := B) (hB := hB) (dyadicTime n)] at hA
  rcases MeasurableSpace.measurableSet_comap.mp hA with ⟨T, hT, rfl⟩
  simpa using exists_tailRepresentative_of_piMeasurable (B := B) hB n hT

-- Proof sketch: form the dyadic increment process
-- `Yₙ(ω)(t) = B (2^{-n} + t) ω - B (2^{-n}) ω`. Brownian independent increments make the family
-- `(Yₙ)` independent, so Kolmogorov's 0--1 law shows that every event in its tail σ-algebra has
-- probability `0` or `1`. One then identifies that tail σ-algebra with the right limit at time
-- `0` of the natural filtration generated by `B`.
/-- Helper for Theorem 21.15: the initial right-limit of the natural Brownian filtration can be
computed along the dyadic times `2^{-n}`. -/
lemma brownianInitialSigma_eq_iInf_dyadicStages :
    ℱB₊ 0 = ⨅ n : ℕ, ℱB (dyadicTime n) := by
  -- Proof comment: the dyadic times `2⁻ⁿ` form a cofinal family in `(0, ∞)` near `0`, so the
  -- right-limit filtration can be computed by intersecting only these stages.
  rw [Filtration.rightCont_eq]
  ext A
  simp only [MeasurableSpace.measurableSet_iInf]
  constructor
  · intro hA n
    exact hA _ (by simp [dyadicTime])
  · intro hA t ht
    have ht_ne_zero : (t : ENNReal) ≠ 0 := by
      exact ENNReal.coe_ne_zero.2 ht.ne'
    rcases ENNReal.exists_inv_two_pow_lt (a := (t : ENNReal)) ht_ne_zero with ⟨n, hn⟩
    have hdyadic_lt : dyadicTime n < t := by
      exact ENNReal.coe_lt_coe.mp (by simpa [dyadicTime, ← inv_pow] using hn)
    exact (show ℱB (dyadicTime n) ≤ ℱB t from Filtration.mono (f := ℱB) hdyadic_lt.le) A (hA n)

/-- Helper for Theorem 21.15: the dyadic block `σ`-algebras form an independent family. -/
private lemma dyadicBlockSigma_iIndep (hB : IsBrownianMotion μ B) :
    iIndep (dyadicBlockSigma (B := B)) μ := by
  letI : IsProbabilityMeasure μ := IsBrownianMotion.isProbabilityMeasure hB
  rw [iIndep_iff]
  intro S s hs
  classical
  let P : Finset ℕ → Prop :=
    fun T =>
      ∀ ⦃t : ℕ → Set Ω⦄, (∀ i, i ∈ T → MeasurableSet[dyadicBlockSigma (B := B) i] (t i)) →
        μ (⋂ i ∈ T, t i) = ∏ i ∈ T, μ (t i)
  have hP : ∀ T : Finset ℕ, P T := by
    intro T
    refine Finset.strongInductionOn T ?_
    intro T hm
    by_cases hT : T.Nonempty
    · let n := T.min' hT
      let T' := T.erase n
      have hn_mem : n ∈ T := Finset.min'_mem T hT
      have hIH : P T' := by
        exact hm T' (by simpa [T'] using Finset.erase_ssubset hn_mem)
      intro t ht
      have hRest_meas :
          MeasurableSet[(⨆ j : T', dyadicBlockSigma (B := B) j.1)] (⋂ i ∈ T', t i) := by
        -- Proof comment: the intersection over the remaining indices is measurable in the supremum
        -- of their dyadic block `σ`-algebras.
        have hEq :
            (⋂ i ∈ T', t i) = ⋂ j : T', t j.1 := by
          ext ω
          simp [T']
        rw [hEq]
        refine MeasurableSet.iInter ?_
        intro j
        exact (show dyadicBlockSigma (B := B) j.1 ≤ ⨆ k : T', dyadicBlockSigma (B := B) k.1 from
          le_iSup (fun k : T' ↦ dyadicBlockSigma (B := B) k.1) j) _
            (ht j.1 (Finset.mem_erase.mp j.2).2)
      have hRest_le :
          (⨆ j : T', dyadicBlockSigma (B := B) j.1) ≤
            pastPathSigma (B := B) (dyadicTime (n + 1)) := by
        refine iSup_le fun j ↦ ?_
        have hj_mem : j.1 ∈ T := (Finset.mem_erase.mp j.2).2
        have hn_le_j : n ≤ j.1 := Finset.min'_le T j.1 hj_mem
        have hn_lt_j : n < j.1 := lt_of_le_of_ne hn_le_j (Ne.symm (Finset.mem_erase.mp j.2).1)
        exact dyadicBlockSigma_le_pastPath_of_lt (B := B) hn_lt_j
      have hIndepRest :
          Indep
            (dyadicBlockSigma (B := B) n)
            (⨆ j : T', dyadicBlockSigma (B := B) j.1)
            μ := indep_of_right_le (dyadicBlock_indep_pastPath (B := B) hB n) hRest_le
      have hInter :
          μ (t n ∩ ⋂ i ∈ T', t i) = μ (t n) * μ (⋂ i ∈ T', t i) := by
        have hIndepSet :
            IndepSet (t n) (⋂ i ∈ T', t i) μ :=
          hIndepRest.indepSet_of_measurableSet (ht n hn_mem) hRest_meas
        exact hIndepSet.measure_inter_eq_mul
      have hT_eq :
          (⋂ i ∈ T, t i) = t n ∩ ⋂ i ∈ T', t i := by
        rw [← Finset.insert_erase hn_mem, Finset.set_biInter_insert]
      have hProd :
          ∏ i ∈ T, μ (t i) = μ (t n) * ∏ i ∈ T', μ (t i) := by
        have hn_not_mem : n ∉ T' := by simp [T']
        rw [← Finset.insert_erase hn_mem, Finset.prod_insert hn_not_mem]
      rw [hT_eq, hInter, hProd, hIH]
      intro i hi
      exact ht i (Finset.mem_erase.mp hi).2
    · have hT_eq : T = ∅ := Finset.not_nonempty_iff_eq_empty.mp hT
      subst hT_eq
      intro t ht
      simp
  exact hP S hs

/-- Helper for Theorem 21.15: the tail `σ`-algebra of the dyadic block family is the intersection
of the dyadic tail stages. -/
private lemma dyadicBlockSigmaLimsup_eq_iInf_tailStage :
    Filter.limsup (dyadicBlockSigma (B := B)) Filter.atTop = ⨅ n : ℕ, tailStage (B := B) n := by
  -- Proof comment: for a sequence indexed by `ℕ`, `limsup` is the intersection of the tail
  -- suprema, and those tail suprema are exactly the `tailStage n`.
  rw [Filter.limsup_eq_iInf_iSup_of_nat]
  congr with n
  rw [tailStage, iSup_subtype]
  rfl

/-- Helper for Theorem 21.15: every event in `ℱB₊ 0` should agree almost everywhere with an event
in the tail `σ`-algebra of a sequence of independent dyadic Brownian increment blocks. -/
lemma brownianInitialSigma_hasTailRepresentative :
    ∃ ℱ : ℕ → MeasurableSpace Ω,
      (∀ n, ℱ n ≤ ‹MeasurableSpace Ω›) ∧
      iIndep ℱ μ ∧
      (∀ ⦃A : Set Ω⦄, MeasurableSet[ℱB₊ 0] A →
        ∃ C : Set Ω, MeasurableSet[Filter.limsup ℱ Filter.atTop] C ∧ A =ᵐ[μ] C) := by
  -- Proof comment: take the dyadic block family itself; stage representatives combine along the
  -- dyadic approximation of `ℱB₊ 0`, and the tail `σ`-algebra is the limsup of that family.
  let ℱ : ℕ → MeasurableSpace Ω := dyadicBlockSigma (B := B)
  refine ⟨ℱ, ?_, dyadicBlockSigma_iIndep (B := B) hB, ?_⟩
  · intro n
    change dyadicBlockSigma (B := B) n ≤ ‹MeasurableSpace Ω›
    exact (measurable_dyadicBlock (B := B) hB n).comap_le
  · intro A hA
    rw [brownianInitialSigma_eq_iInf_dyadicStages (B := B) (hB := hB),
      MeasurableSpace.measurableSet_iInf] at hA
    have hStage :
        ∀ n : ℕ, ∃ C : Set Ω, MeasurableSet[tailStage (B := B) n] C ∧ A =ᵐ[μ] C := by
      intro n
      let hTmp :
          MeasurableSet[ℱB (dyadicTime n)] A →
            ∃ C : Set Ω, MeasurableSet[tailStage (B := B) n] C ∧ A =ᵐ[μ] C :=
        measurableSet_dyadicStage_hasTailRepresentative (B := B) (hB := hB) (n := n) (A := A)
      exact hTmp (hA n)
    choose C hC_meas hC_eq using hStage
    let D : ℕ → Set Ω := fun n ↦ ⋂ m, ⋂ (_ : n ≤ m), C m
    have hD_meas : ∀ n : ℕ, MeasurableSet[tailStage (B := B) n] (D n) := by
      intro n
      -- Proof comment: every `C m` with `m ≥ n` is measurable in `tailStage n` because the tail
      -- stages decrease with the starting index.
      change MeasurableSet[tailStage (B := B) n] (⋂ m, ⋂ (_ : n ≤ m), C m)
      refine MeasurableSet.iInter fun m ↦ ?_
      refine MeasurableSet.iInter fun hnm ↦ ?_
      exact (tailStage_antitone (B := B) hnm) _ (hC_meas m)
    have hD_eq : ∀ n : ℕ, A =ᵐ[μ] D n := by
      intro n
      -- Proof comment: intersecting the tail representatives keeps the same AE value because each
      -- factor is AE-equal to `A`.
      have hInter :
          (⋂ m, ⋂ (_ : n ≤ m), A) =ᵐ[μ] ⋂ m, ⋂ (_ : n ≤ m), C m := by
        exact
          Filter.EventuallyEq.countable_iInter fun m ↦
            Filter.EventuallyEq.countable_iInter fun hnm : n ≤ m ↦ hC_eq m
      have hConst : (⋂ m, ⋂ (_ : n ≤ m), A) = A := by
        ext ω
        constructor
        · intro hω
          have hω' : ∀ i, n ≤ i → ω ∈ A := by
            simpa [Set.mem_iInter] using hω
          exact hω' n le_rfl
        · intro hω
          simp [Set.mem_iInter, hω]
      simpa [D, hConst] using hInter
    have hD_mono : Monotone D := by
      intro n m hnm ω hω
      simp [D] at hω ⊢
      intro k hmk
      exact hω k (le_trans hnm hmk)
    let Ctail : Set Ω := ⋃ n, D n
    refine ⟨Ctail, ?_, ?_⟩
    · -- Proof comment: the final representative is measurable in every tail stage, hence in
      -- their intersection, which is the limsup tail sigma-algebra.
      rw [dyadicBlockSigmaLimsup_eq_iInf_tailStage (B := B)]
      rw [MeasurableSpace.measurableSet_iInf]
      intro n
      have htailEq : Ctail = ⋃ m ≥ n, D m := by
        ext ω
        constructor
        · intro hω
          rcases Set.mem_iUnion.mp hω with ⟨k, hk⟩
          by_cases hnk : n ≤ k
          · exact Set.mem_iUnion.mpr ⟨k, Set.mem_iUnion.mpr ⟨hnk, hk⟩⟩
          · exact
              Set.mem_iUnion.mpr
                ⟨n, Set.mem_iUnion.mpr ⟨le_rfl, hD_mono (le_of_not_ge hnk) hk⟩⟩
        · intro hω
          rcases Set.mem_iUnion.mp hω with ⟨m, hm⟩
          rcases Set.mem_iUnion.mp hm with ⟨_, hm'⟩
          exact Set.mem_iUnion.mpr ⟨m, hm'⟩
      rw [htailEq]
      refine MeasurableSet.iUnion fun m ↦ ?_
      refine MeasurableSet.iUnion fun hnm ↦ ?_
      exact (tailStage_antitone (B := B) hnm) _ (hD_meas m)
    · -- Proof comment: the stage representatives all agree almost everywhere with `A`, so their
      -- increasing tail-union representative still agrees almost everywhere with `A`.
      change A =ᵐ[μ] ⋃ n, D n
      have hUnion : (⋃ n : ℕ, A) =ᵐ[μ] ⋃ n, D n :=
        Filter.EventuallyEq.countable_iUnion hD_eq
      have hConst : (⋃ n : ℕ, A) = A := by
        ext ω
        simp
      simpa [Ctail, hConst] using hUnion

/-- Theorem 21.15: Blumenthal's 0--1 law. If `B` is a Brownian motion and `𝓕 := σ(B)` is its
natural filtration, then the initial right-limit σ-algebra `𝓕₀⁺ = ⋂ t > 0, 𝓕_t` is `μ`-trivial,
i.e. it is the Chapter 20 owner `is_p_trivial`. -/
theorem brownian_initial_sigma_algebra_is_p_trivial
    : @is_p_trivial Ω _ μ (IsBrownianMotion.isProbabilityMeasure hB) (ℱB₊ 0) := by
  letI : IsProbabilityMeasure μ := IsBrownianMotion.isProbabilityMeasure hB
  -- Route correction: isolate the Brownian-specific reconstruction step and let the generic tail
  -- `0`-`1` mechanism handle the final `is_p_trivial` argument.
  rcases brownianInitialSigma_hasTailRepresentative (hB := hB) with ⟨ℱ, h_le, h_indep, h_rep⟩
  -- Proof comment: every initial-σ event admits a tail representative for the chosen independent
  -- family, so Kolmogorov's `0`-`1` law applies after one `measure_congr` transfer.
  dsimp [is_p_trivial]
  intro A hA
  rcases h_rep hA with ⟨C, hC, hAC⟩
  have hC_zero_one : μ C = 0 ∨ μ C = 1 := by
    exact measure_zero_or_one_of_measurableSet_tail_of_iIndep μ ℱ h_le h_indep hC
  have hAC_measure : μ A = μ C := measure_congr hAC
  rcases hC_zero_one with hC_zero | hC_one
  · left
    rw [hAC_measure, hC_zero]
  · right
    rw [hAC_measure, hC_one]

/-- Every event in the initial right-limit σ-algebra of the natural Brownian filtration has
probability `0` or `1`. -/
theorem measure_zero_or_one_of_mem_brownian_initial_sigma_algebra
    {A : Set Ω} (hA : MeasurableSet[ℱB₊ 0] A) :
    μ A = 0 ∨ μ A = 1 := by
  letI : IsProbabilityMeasure μ := IsBrownianMotion.isProbabilityMeasure hB
  simpa [is_p_trivial] using brownian_initial_sigma_algebra_is_p_trivial hB A hA

end

end ProbabilityTheory
