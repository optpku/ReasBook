import Mathlib
import Books.ProbabilityTheory_Klenke_2020.Items.Chap21.Theorem_21_30

-- Declarations for this item will be appended below by the statement pipeline.

open MeasureTheory
open scoped Topology NNReal

noncomputable section

/-- The measurable space on the continuous path space is its Borel `σ`-algebra. -/
local instance : MeasurableSpace BrownianPathSpace := borel _

/-- The continuous path space carries its canonical Borel-space structure. -/
local instance : BorelSpace BrownianPathSpace := ⟨rfl⟩

/-- Helper for Theorem 21.31: the nonnegative rationals are dense in `NNReal`. -/
lemma denseRange_nnratCast : DenseRange (fun q : ℚ≥0 ↦ (q : NNReal)) := by
  -- Every open interval in `NNReal` contains a nonnegative rational point.
  refine dense_of_exists_between fun a b hab ↦ ?_
  rcases (NNReal.lt_iff_exists_rat_btwn a b).mp hab with ⟨q, hq, haq, hqb⟩
  let q₀ : ℚ≥0 := ⟨q, hq⟩
  refine ⟨(q₀ : NNReal), ?_, ?_, ?_⟩
  · exact ⟨q₀, rfl⟩
  · have hq' : (0 : ℝ) ≤ q := Rat.cast_nonneg.mpr hq
    simpa [q₀, Real.toNNReal_of_nonneg hq'] using haq
  · have hq' : (0 : ℝ) ≤ q := Rat.cast_nonneg.mpr hq
    simpa [q₀, Real.toNNReal_of_nonneg hq'] using hqb

/-- Helper for Theorem 21.31: a continuous path is determined by its values on `ℚ≥0`. -/
lemma nnratRestriction_injective :
    Function.Injective (fun ω : BrownianPathSpace ↦ fun q : ℚ≥0 ↦ ω (q : NNReal)) := by
  intro ω₁ ω₂ hω
  ext t
  -- Equality on the dense subset `ℚ≥0 ⊆ ℝ≥0` extends to all times by continuity.
  have hEq :
      Set.EqOn (fun x : NNReal ↦ ω₁ x) (fun x : NNReal ↦ ω₂ x)
        (Set.range fun q : ℚ≥0 ↦ (q : NNReal)) := by
    rintro _ ⟨q, rfl⟩
    exact congrFun hω q
  have hDense : Dense (Set.range fun q : ℚ≥0 ↦ (q : NNReal)) := denseRange_nnratCast
  exact congrFun (Continuous.ext_on hDense ω₁.continuous ω₂.continuous hEq) t

-- Proof sketch: the compact-open topology on `C(NNReal, ℝ)` is the path-space topology used in
-- the chapter, and its Borel `σ`-algebra is generated by the time-evaluation maps. This
-- identifies the Borel `σ`-algebra with the restriction of the product Borel `σ`-algebra.
/-- Theorem 21.31: on the continuous path space `C(ℝ≥0, ℝ)`, the restriction of the product
Borel `σ`-algebra from `ℝ≥0 → ℝ` agrees with the Borel `σ`-algebra of the path-space topology. -/
theorem continuousPathSpace_comap_pi_eq_borel :
    MeasurableSpace.comap ((↑) : BrownianPathSpace → NNReal → ℝ) MeasurableSpace.pi =
      borel BrownianPathSpace := by
  let e : BrownianPathSpace → ℚ≥0 → ℝ := fun ω q ↦ ω (q : NNReal)
  have hRatBorel : MeasurableSpace.comap e MeasurableSpace.pi = borel BrownianPathSpace := by
    -- The rational-time restriction is a continuous injective map into a countable product.
    have hCont : Continuous e := by
      refine continuous_pi fun q ↦ ?_
      simpa [e] using (continuous_eval_const (q : NNReal))
    exact (hCont.measurableEmbedding nnratRestriction_injective).comap_eq
  have hRatLeFull :
      MeasurableSpace.comap e MeasurableSpace.pi ≤
        MeasurableSpace.comap ((↑) : BrownianPathSpace → NNReal → ℝ) MeasurableSpace.pi := by
    -- Each rational-time coordinate is one of the full time-evaluation coordinates.
    have hMeas :
        Measurable[
          MeasurableSpace.comap ((↑) : BrownianPathSpace → NNReal → ℝ) MeasurableSpace.pi
        ] e := by
      -- Under the pullback `σ`-algebra, each rational-time coordinate is measurable by definition.
      exact
        @measurable_pi_lambda BrownianPathSpace ℚ≥0 (fun _ : ℚ≥0 ↦ ℝ)
          (MeasurableSpace.comap ((↑) : BrownianPathSpace → NNReal → ℝ) MeasurableSpace.pi)
          (fun _ : ℚ≥0 ↦ borel ℝ) e
          (fun q ↦ by
            simpa [e] using
              (measurable_pi_apply (q : NNReal)).comp
                (comap_measurable ((↑) : BrownianPathSpace → NNReal → ℝ)))
    exact hMeas.comap_le
  have hFullLeBorel :
      MeasurableSpace.comap ((↑) : BrownianPathSpace → NNReal → ℝ) MeasurableSpace.pi ≤
        borel BrownianPathSpace := by
    -- The canonical coercion is continuous, so the full coordinate `σ`-algebra is Borel-measurable.
    exact
      (MeasurableSpace.comap_mono pi_le_borel_pi).trans
        continuous_coeFun.borel_measurable.comap_le
  refine le_antisymm hFullLeBorel ?_
  -- The Borel `σ`-algebra is already generated by the countable family of rational evaluations.
  rw [← hRatBorel]
  exact hRatLeFull
