import Mathlib
import Books.ProbabilityTheory_Klenke_2020.Items.Chap21.Definition_21_8
import Books.ProbabilityTheory_Klenke_2020.Items.Chap21.Example_21_13

-- Declarations for this item will be appended below by the statement pipeline.

open MeasureTheory ProbabilityTheory
open scoped ProbabilityTheory

noncomputable section

universe u

namespace ProbabilityTheory

variable {Ω : Type u} [MeasurableSpace Ω]
variable {μ : Measure Ω} {B : NNReal → Ω → ℝ}

namespace IsBrownianMotion

/-- Helper for Exercise 21.2.2: the Brownian covariance kernel is `s ∧ t`. -/
theorem covariance_eq
    {μ : Measure Ω} {B : NNReal → Ω → ℝ} (hB : IsBrownianMotion μ B) (s t : NNReal) :
    cov[B s, B t; μ] = ((s ⊓ t : NNReal) : ℝ) := by
  -- Proof comment: this is the stable Brownian covariance owner from Example 21.13.
  exact brownianMotion_covariance_eq hB s t

end IsBrownianMotion

/-- Helper for Exercise 21.2.2: Brownian increments over ordered times belong to `L²`. -/
lemma brownianIncrement_memLp_two
    (hB : IsBrownianMotion μ B) {s t : NNReal} (_hst : s ≤ t) :
    MemLp (fun ω ↦ B t ω - B s ω) 2 μ := by
  -- Proof comment: `L²` is stable under subtraction, so the increment inherits square
  -- integrability from the two Brownian marginals.
  exact (brownianEval_memLp_two_ofBrownianMotion hB t).sub
    (brownianEval_memLp_two_ofBrownianMotion hB s)

/-- Helper for Exercise 21.2.2: the time-`s` natural filtration is the σ-algebra generated by the
restricted path `u ↦ B u` on `Set.Iic s`. -/
lemma naturalFiltration_eq_pastPath
    (hB : IsBrownianMotion μ B) (s : NNReal) :
    Filtration.natural B hB.stronglyMeasurable s =
      MeasurableSpace.comap (fun ω (u : Set.Iic s) ↦ B u ω) MeasurableSpace.pi := by
  -- Proof comment: both sides are the supremum of the coordinate σ-algebras coming from the times
  -- `u ≤ s`, written once with explicit `j ≤ s` indices and once as a product-space pullback.
  change (⨆ j, ⨆ (_ : j ≤ s), MeasurableSpace.comap (B j) Real.measurableSpace) =
    MeasurableSpace.comap (fun ω (u : Set.Iic s) ↦ B u ω) MeasurableSpace.pi
  rw [MeasurableSpace.pi, MeasurableSpace.comap_iSup]
  simp only [MeasurableSpace.comap_comp]
  refine le_antisymm ?_ ?_
  · refine iSup₂_le ?_
    intro j hj
    exact le_iSup_of_le ⟨j, hj⟩ le_rfl
  · refine iSup_le ?_
    intro u
    exact le_iSup_of_le (u : NNReal) <| le_iSup_of_le u.2 le_rfl

/-- Helper for Exercise 21.2.2: the second moment of the Brownian increment over `[s,t]` equals
the time lag `t - s`. -/
lemma brownianIncrement_sq_integral_eq_timeLag
    (hB : IsBrownianMotion μ B) {s t : NNReal} (hst : s ≤ t) :
    ∫ ω, (B t ω - B s ω) ^ 2 ∂μ = ((t - s : NNReal) : ℝ) := by
  letI : IsProbabilityMeasure μ := hB.isProbabilityMeasure
  have hInc_mem : MemLp (fun ω ↦ B t ω - B s ω) 2 μ :=
    brownianIncrement_memLp_two hB hst
  have hInc_var :
      Var[fun ω ↦ B t ω - B s ω; μ] = ((t - s : NNReal) : ℝ) := by
    -- The increment law is centered Gaussian with variance `t - s`.
    simpa using (brownianIncrement_hasLaw_ofBrownianMotion hB hst).variance_eq
  have hInc_mean :
      ∫ ω, (B t ω - B s ω) ∂μ = 0 := by
    -- The same Gaussian law is centered, so the increment expectation vanishes.
    simpa using (brownianIncrement_hasLaw_ofBrownianMotion hB hst).integral_eq
  -- Rewrite the raw second moment through the variance identity and substitute the Gaussian data.
  have hSecondMoment :
      ∫ ω, (B t ω - B s ω) ^ 2 ∂μ =
        Var[fun ω ↦ B t ω - B s ω; μ] +
          (∫ ω, (B t ω - B s ω) ∂μ) ^ 2 := by
    have hVarEq :
        Var[fun ω ↦ B t ω - B s ω; μ] =
          ∫ ω, (B t ω - B s ω) ^ 2 ∂μ -
            (∫ ω, (B t ω - B s ω) ∂μ) ^ 2 := by
      simpa using (ProbabilityTheory.variance_eq_sub hInc_mem)
    linarith
  calc
    ∫ ω, (B t ω - B s ω) ^ 2 ∂μ
        = Var[fun ω ↦ B t ω - B s ω; μ] +
            (∫ ω, (B t ω - B s ω) ∂μ) ^ 2 := hSecondMoment
    _ = ((t - s : NNReal) : ℝ) := by
          rw [hInc_var, hInc_mean]
          ring

/-- Helper for Exercise 21.2.2: the future Brownian increment is independent of the natural
filtration up to the starting time. -/
lemma brownianIncrement_indep_naturalFiltration
    (hB : IsBrownianMotion μ B) {s t : NNReal} (hst : s ≤ t) :
    Indep
      (MeasurableSpace.comap (fun ω ↦ B t ω - B s ω) (borel ℝ))
      (Filtration.natural B hB.stronglyMeasurable s)
      μ := by
  letI : IsProbabilityMeasure μ := hB.isProbabilityMeasure
  let hGaussian : IsGaussianProcess B μ := brownianMotion_isGaussianProcess hB
  have hJoint :
      IsGaussianProcess
        (Sum.elim
          (fun _ : Unit => fun ω ↦ B t ω - B s ω)
          (fun u : Set.Iic s => fun ω ↦ B u ω))
        μ := by
    -- Proof comment: both coordinates are linear images of finitely many Brownian evaluations.
    refine hGaussian.of_isGaussianProcess ?_
    intro z
    cases z with
    | inl _ =>
        refine ⟨{t, s}, ?_, ?_⟩
        · refine
            { toFun := fun x ↦ x ⟨t, by simp⟩ - x ⟨s, by simp⟩
              map_add' := by
                intro x y
                calc
                  (x + y) ⟨t, by simp⟩ - (x + y) ⟨s, by simp⟩
                      = (x ⟨t, by simp⟩ + y ⟨t, by simp⟩) -
                          (x ⟨s, by simp⟩ + y ⟨s, by simp⟩) := by
                            rfl
                  _ = x ⟨t, by simp⟩ - x ⟨s, by simp⟩ + (y ⟨t, by simp⟩ - y ⟨s, by simp⟩) := by
                        ring
              map_smul' := by
                intro c x
                calc
                  (c • x) ⟨t, by simp⟩ - (c • x) ⟨s, by simp⟩
                      = c * x ⟨t, by simp⟩ - c * x ⟨s, by simp⟩ := by
                          rfl
                  _ = c * (x ⟨t, by simp⟩ - x ⟨s, by simp⟩) := by
                        ring
                  _ = (RingHom.id ℝ) c • (x ⟨t, by simp⟩ - x ⟨s, by simp⟩) := by
                        rfl
              cont := by
                fun_prop }
        · intro ω
          simp
    | inr u =>
        refine ⟨{(u : NNReal)}, ?_, ?_⟩
        · refine
            { toFun := fun x ↦ x ⟨(u : NNReal), by simp⟩
              map_add' := by
                intro x y
                simp
              map_smul' := by
                intro c x
                simp
              cont := by
                fun_prop }
        · intro ω
          simp
  have hIndepFun :
      IndepFun
        (fun ω (_ : Unit) ↦ B t ω - B s ω)
        (fun ω (u : Set.Iic s) ↦ B u ω)
        μ := by
    -- Proof comment: the joint Gaussian process splits because each future increment is
    -- uncorrelated with every past coordinate `B_u` for `u ≤ s`.
    refine ProbabilityTheory.IsGaussianProcess.indepFun_of_covariance_eq_zero hJoint ?_ ?_ ?_
    · intro _
      exact (hB.stronglyMeasurable t).aemeasurable.sub (hB.stronglyMeasurable s).aemeasurable
    · intro u
      exact (hB.stronglyMeasurable u).aemeasurable
    · intro _ u
      have hs_mem : MemLp (B s) 2 μ := brownianEval_memLp_two_ofBrownianMotion hB s
      have ht_mem : MemLp (B t) 2 μ := brownianEval_memLp_two_ofBrownianMotion hB t
      have hu_mem : MemLp (B u) 2 μ := brownianEval_memLp_two_ofBrownianMotion hB u
      have hu_le_s : (u : NNReal) ≤ s := u.2
      have hu_le_t : (u : NNReal) ≤ t := le_trans hu_le_s hst
      have ht_cov : cov[B t, B u; μ] = ((u : NNReal) : ℝ) := by
        simpa [inf_eq_right.mpr hu_le_t] using IsBrownianMotion.covariance_eq hB t u
      have hs_cov : cov[B s, B u; μ] = ((u : NNReal) : ℝ) := by
        simpa [inf_eq_right.mpr hu_le_s] using IsBrownianMotion.covariance_eq hB s u
      -- The covariance of the increment with `B_u` is the difference of two identical kernel
      -- values, hence zero.
      rw [covariance_fun_sub_left ht_mem hs_mem hu_mem, ht_cov, hs_cov]
      ring
  have hIndep :
      Indep
        (MeasurableSpace.comap (fun ω (_ : Unit) ↦ B t ω - B s ω) MeasurableSpace.pi)
        (MeasurableSpace.comap (fun ω (u : Set.Iic s) ↦ B u ω) MeasurableSpace.pi)
        μ :=
    (ProbabilityTheory.IndepFun_iff_Indep _ _ _).mp hIndepFun
  -- Rewrite the right σ-algebra as the natural filtration, and collapse the one-point product on
  -- the left back to the increment σ-algebra.
  simpa [naturalFiltration_eq_pastPath hB s, MeasurableSpace.pi]
    using hIndep

-- Proof sketch: for `s ≤ t`, write `B t = B s + (B t - B s)`. Brownian increments after time `s`
-- are independent of the natural filtration up to time `s`, centered, and have variance `t - s`.
-- Expanding the square and taking the conditional expectation therefore gives
-- `E[B_t^2 - t | 𝓕_s] = B_s^2 - s`.
/-- Exercise 21.2.2: for a Brownian motion `B`, the compensated squared process
`(B_t^2 - t)_{t ≥ 0}` is a martingale with respect to the natural filtration generated by `B`. -/
theorem brownian_sq_sub_time_martingale
    (hB : IsBrownianMotion μ B) :
    Martingale (fun t ω ↦ B t ω ^ 2 - (t : ℝ))
      (Filtration.natural B hB.stronglyMeasurable) μ := by
  letI : IsProbabilityMeasure μ := hB.isProbabilityMeasure
  let ℱB := Filtration.natural B hB.stronglyMeasurable
  have hAdapted :
      StronglyAdapted ℱB (fun t ω ↦ B t ω ^ 2 - (t : ℝ)) := by
    intro t
    -- Proof comment: each time slice is a quadratic polynomial in the Brownian evaluation `B t`.
    have hBt : StronglyMeasurable[ℱB t] (B t) :=
      Filtration.stronglyAdapted_natural (u := B) hB.stronglyMeasurable t
    exact (hBt.pow 2).sub stronglyMeasurable_const
  refine ⟨hAdapted, ?_⟩
  intro s t hst
  let inc : Ω → ℝ := fun ω ↦ B t ω - B s ω
  let incSqComp : Ω → ℝ := fun ω ↦ inc ω ^ 2 - ((t - s : NNReal) : ℝ)
  have hInc_meas : Measurable inc := by
    exact (hB.stronglyMeasurable t).measurable.sub (hB.stronglyMeasurable s).measurable
  have hBs_mem : MemLp (B s) 2 μ := brownianEval_memLp_two_ofBrownianMotion hB s
  have hInc_mem : MemLp inc 2 μ := brownianIncrement_memLp_two hB hst
  have hBase_int : Integrable (fun ω ↦ B s ω ^ 2 - (s : ℝ)) μ := by
    -- Proof comment: the time-`s` square is integrable because `B_s ∈ L²`.
    exact hBs_mem.integrable_sq.sub (integrable_const _)
  have hInc_int : Integrable inc μ :=
    hInc_mem.integrable (by norm_num)
  have hCross_int : Integrable (fun ω ↦ (2 * B s ω) * inc ω) μ := by
    -- Proof comment: the mixed term is in `L¹` by Hölder from the two `L²` factors.
    have hFactor_mem : MemLp (fun ω ↦ B s ω * 2) 2 μ := by
      simpa [mul_comm] using hBs_mem.const_mul (2 : ℝ)
    have hCross_int' : Integrable (fun ω ↦ inc ω * (B s ω * 2)) μ :=
      hInc_mem.integrable_mul hFactor_mem
    refine hCross_int'.congr ?_
    exact Filter.Eventually.of_forall fun ω ↦ by
      dsimp [inc]
      ring
  have hIncSqComp_int : Integrable incSqComp μ := by
    -- Proof comment: the centered square inherits integrability from the increment's `L²` bound.
    exact hInc_mem.integrable_sq.sub (integrable_const _)
  have hSplit :
      (fun ω ↦ B t ω ^ 2 - (t : ℝ)) =
        fun ω ↦ (B s ω ^ 2 - (s : ℝ)) + (((2 * B s ω) * inc ω) + incSqComp ω) := by
    -- Proof comment: this is the textbook square expansion of `B_t = B_s + (B_t - B_s)`.
    funext ω
    dsimp [inc, incSqComp]
    rw [NNReal.coe_sub hst]
    ring
  have hBs_sm : StronglyMeasurable[ℱB s] (B s) :=
    Filtration.stronglyAdapted_natural (u := B) hB.stronglyMeasurable s
  have hBase_sm :
      StronglyMeasurable[ℱB s] (fun ω ↦ B s ω ^ 2 - (s : ℝ)) :=
    (hBs_sm.pow 2).sub stronglyMeasurable_const
  have hCrossFactor_sm :
      StronglyMeasurable[ℱB s] (fun ω ↦ 2 * B s ω) :=
    hBs_sm.const_mul (2 : ℝ)
  have hInc_sm :
      StronglyMeasurable[MeasurableSpace.comap inc (borel ℝ)] inc :=
    (comap_measurable inc).stronglyMeasurable
  have hIncSqComp_sm :
      StronglyMeasurable[MeasurableSpace.comap inc (borel ℝ)] incSqComp :=
    (hInc_sm.pow 2).sub stronglyMeasurable_const
  have hInc_indep :
      Indep (MeasurableSpace.comap inc (borel ℝ)) (ℱB s) μ :=
    brownianIncrement_indep_naturalFiltration hB hst
  have hInc_mean_zero : ∫ ω, inc ω ∂μ = 0 := by
    -- Proof comment: a Brownian increment has centered Gaussian law.
    simpa [inc] using (brownianIncrement_hasLaw_ofBrownianMotion hB hst).integral_eq
  have hInc_condExp_zero :
      μ[inc | ℱB s] =ᵐ[μ] 0 := by
    -- Proof comment: independence from `ℱ_s` collapses the conditional expectation to the mean.
    refine (MeasureTheory.condExp_indep_eq
      (m₁ := MeasurableSpace.comap inc (borel ℝ))
      (m₂ := ℱB s)
      hInc_meas.comap_le
      (ℱB.le s)
      hInc_sm
      hInc_indep).trans ?_
    exact Filter.Eventually.of_forall fun _ ↦ hInc_mean_zero
  have hIncSqComp_mean_zero : ∫ ω, incSqComp ω ∂μ = 0 := by
    -- Proof comment: the compensator subtracts exactly the second moment `t - s`.
    rw [show incSqComp = fun ω ↦ inc ω ^ 2 - ((t - s : NNReal) : ℝ) by rfl]
    rw [integral_sub hInc_mem.integrable_sq (integrable_const _),
      brownianIncrement_sq_integral_eq_timeLag hB hst, integral_const, probReal_univ]
    simp
  have hIncSqComp_condExp_zero :
      μ[incSqComp | ℱB s] =ᵐ[μ] 0 := by
    -- Proof comment: the centered squared increment is also a measurable function of the future
    -- increment alone, so independence again reduces the conditional expectation to its mean `0`.
    refine (MeasureTheory.condExp_indep_eq
      (m₁ := MeasurableSpace.comap inc (borel ℝ))
      (m₂ := ℱB s)
      hInc_meas.comap_le
      (ℱB.le s)
      hIncSqComp_sm
      hInc_indep).trans ?_
    exact Filter.Eventually.of_forall fun _ ↦ hIncSqComp_mean_zero
  have hCross_condExp_zero :
      μ[(fun ω ↦ (2 * B s ω) * inc ω) | ℱB s] =ᵐ[μ] 0 := by
    -- Proof comment: pull the `ℱ_s`-measurable factor outside, then use the zero increment
    -- conditional expectation.
    calc
      μ[(fun ω ↦ (2 * B s ω) * inc ω) | ℱB s]
          =ᵐ[μ] (fun ω ↦ 2 * B s ω) * μ[inc | ℱB s] := by
              exact condExp_mul_of_stronglyMeasurable_left hCrossFactor_sm hCross_int hInc_int
      _ =ᵐ[μ] (fun ω ↦ 2 * B s ω) * 0 := by
            filter_upwards [hInc_condExp_zero] with ω hω
            simp [hω]
      _ =ᵐ[μ] 0 := by
            simp
  -- Proof comment: apply conditional expectation to the square expansion and kill the two future
  -- increment terms by the identities proved above.
  calc
    μ[(fun ω ↦ B t ω ^ 2 - (t : ℝ)) | ℱB s]
        =ᵐ[μ]
          μ[(fun ω ↦ (B s ω ^ 2 - (s : ℝ)) + (((2 * B s ω) * inc ω) + incSqComp ω)) | ℱB s] := by
            exact condExp_congr_ae (Filter.EventuallyEq.of_eq hSplit)
    _ =ᵐ[μ] μ[(fun ω ↦ B s ω ^ 2 - (s : ℝ)) | ℱB s] +
        μ[(fun ω ↦ (2 * B s ω) * inc ω) + incSqComp | ℱB s] := by
          exact condExp_add hBase_int (hCross_int.add hIncSqComp_int) (ℱB s)
    _ =ᵐ[μ] μ[(fun ω ↦ B s ω ^ 2 - (s : ℝ)) | ℱB s] +
        (μ[(fun ω ↦ (2 * B s ω) * inc ω) | ℱB s] + μ[incSqComp | ℱB s]) := by
          exact Filter.EventuallyEq.rfl.add (condExp_add hCross_int hIncSqComp_int (ℱB s))
    _ =ᵐ[μ] (fun ω ↦ B s ω ^ 2 - (s : ℝ)) + (0 + 0) := by
          filter_upwards
            [Filter.EventuallyEq.of_eq (condExp_of_stronglyMeasurable (ℱB.le s) hBase_sm hBase_int),
              hCross_condExp_zero, hIncSqComp_condExp_zero]
            with ω hωbase hωcross hωsq
          simp [hωbase, hωcross, hωsq]
    _ =ᵐ[μ] fun ω ↦ B s ω ^ 2 - (s : ℝ) := by
          simp

end ProbabilityTheory
