import Mathlib

-- Declarations for this item will be appended below by the statement pipeline.

open Set
open MeasureTheory

universe u

variable {Ω : Type u}

/-- The sets relevant for Exercise 1.3.2 are those that are either countable and avoid the marked
point, or contain the marked point and have countable complement. -/
def countableOrCocountableAtPoint (ω₀ : Ω) (s : Set Ω) : Prop :=
  (s.Countable ∧ ω₀ ∉ s) ∨ (ω₀ ∈ s ∧ sᶜ.Countable)

/-- The generating family in Exercise 1.3.2: all singletons away from the distinguished point. -/
def singletonsAwayFrom (ω₀ : Ω) : Set (Set Ω) :=
  {s | ∃ ω : Ω, ω ≠ ω₀ ∧ s = ({ω} : Set Ω)}

@[simp]
theorem mem_singletonsAwayFrom_iff {ω₀ : Ω} {s : Set Ω} :
    s ∈ singletonsAwayFrom ω₀ ↔ ∃ ω : Ω, ω ≠ ω₀ ∧ s = ({ω} : Set Ω) :=
  Iff.rfl

/-- Helper for Exercise 1.3.2: the predicate `countableOrCocountableAtPoint ω₀` is invariant
under taking complements. -/
lemma countableOrCocountableAtPoint_compl_iff (ω₀ : Ω) (s : Set Ω) :
    countableOrCocountableAtPoint ω₀ sᶜ ↔ countableOrCocountableAtPoint ω₀ s := by
  constructor
  · intro hs
    -- Unpack the complement description and flip the branch that records membership of `ω₀`.
    rcases hs with ⟨hs_countable, hω₀⟩ | ⟨hω₀, hs_countable⟩
    · right
      constructor
      · simpa using hω₀
      · simpa [compl_compl] using hs_countable
    · left
      constructor
      · simpa [compl_compl] using hs_countable
      · simpa using hω₀
  · intro hs
    -- The same case split gives the converse direction.
    rcases hs with ⟨hs_countable, hω₀⟩ | ⟨hω₀, hs_countable⟩
    · right
      constructor
      · simpa using hω₀
      · simpa [compl_compl] using hs_countable
    · left
      constructor
      · simpa [compl_compl] using hs_countable
      · simpa using hω₀

/-- Helper for Exercise 1.3.2: countable unions preserve the predicate
`countableOrCocountableAtPoint ω₀`. -/
lemma countableOrCocountableAtPoint_iUnion (ω₀ : Ω) (f : ℕ → Set Ω)
    (hf : ∀ n, countableOrCocountableAtPoint ω₀ (f n)) :
    countableOrCocountableAtPoint ω₀ (⋃ n, f n) := by
  by_cases hω₀ : ∃ n, ω₀ ∈ f n
  · rcases hω₀ with ⟨n, hmem⟩
    rcases hf n with hfn | hfn
    · exact (hfn.2 hmem).elim
    · -- Once one set contains `ω₀`, the whole union contains `ω₀`, and its complement sits
      -- inside that set's countable complement.
      right
      constructor
      · exact mem_iUnion.2 ⟨n, hmem⟩
      · refine Set.Countable.mono ?_ hfn.2
        intro x hx
        exact fun hxfn ↦ hx (mem_iUnion.2 ⟨n, hxfn⟩)
  · -- If no member contains `ω₀`, every member is in the countable-away branch, so the union is
    -- still countable and still avoids `ω₀`.
    left
    constructor
    · refine Set.countable_iUnion fun n ↦ ?_
      rcases hf n with hfn | hfn
      · exact hfn.1
      · exact (hω₀ ⟨n, hfn.1⟩).elim
    · simpa using hω₀

/-- Helper for Exercise 1.3.2: every countable set avoiding `ω₀` is measurable in the
`σ`-algebra generated by the singletons away from `ω₀`. -/
lemma measurableSet_generateFrom_singletonsAwayFrom_of_countable {ω₀ : Ω} {s : Set Ω}
    (hs : s.Countable) (hω₀ : ω₀ ∉ s) :
    MeasurableSet[MeasurableSpace.generateFrom (singletonsAwayFrom ω₀)] s := by
  -- Rewrite `s` as the countable union of its singleton subsets.
  have h_union : s = ⋃ ω ∈ s, ({ω} : Set Ω) := by
    ext x
    simp
  rw [h_union]
  -- Each singleton generator lies away from `ω₀`, so it belongs to the generating family.
  refine MeasurableSet.biUnion hs fun ω hω ↦ ?_
  have hne : ω ≠ ω₀ := by
    intro hωω₀
    exact hω₀ (hωω₀ ▸ hω)
  exact MeasurableSpace.measurableSet_generateFrom ⟨ω, hne, rfl⟩

-- Proof sketch: for the forward implication, use induction on `MeasurableSpace.generateFrom`,
-- observing that the target predicate defines a measurable space containing every singleton away
-- from `ω₀`; for the reverse implication, write countable subsets of `Ω \ {ω₀}` as countable
-- unions of generating singletons and obtain the cocountable-through-`ω₀` sets by taking
-- complements.
/-- Exercise 1.3.2 (1): a set is measurable in the `σ`-algebra generated by the singletons away
from `ω₀` if and only if it is countable and avoids `ω₀`, or it contains `ω₀` and has countable
complement. -/
theorem measurableSet_countable_or_countable_compl_at_point_iff
    (ω₀ : Ω) {s : Set Ω} :
    MeasurableSet[MeasurableSpace.generateFrom (singletonsAwayFrom ω₀)] s ↔
      countableOrCocountableAtPoint ω₀ s := by
  constructor
  · intro hs
    -- Induct over the generated measurable sets, using the closure API of the target predicate.
    refine MeasurableSpace.generateFrom_induction
      (C := singletonsAwayFrom ω₀)
      (p := fun t _ ↦ countableOrCocountableAtPoint ω₀ t)
      ?_ ?_ ?_ ?_ s hs
    · intro t ht _
      rcases ht with ⟨ω, hne, rfl⟩
      -- A generating singleton is countable and does not contain `ω₀`.
      left
      constructor
      · exact countable_singleton ω
      · simpa [eq_comm] using hne
    · -- The empty set is countable and avoids `ω₀`.
      simp [countableOrCocountableAtPoint]
    · intro t _ ht
      -- Complements stay inside the characterization predicate.
      exact (countableOrCocountableAtPoint_compl_iff ω₀ t).2 ht
    · intro f _ hf
      -- Countable unions preserve the characterization predicate.
      exact countableOrCocountableAtPoint_iUnion ω₀ f hf
  · intro hs
    rcases hs with ⟨hs_countable, hω₀⟩ | ⟨hω₀, hs_compl_countable⟩
    · -- Countable sets away from `ω₀` are countable unions of generating singletons.
      exact measurableSet_generateFrom_singletonsAwayFrom_of_countable hs_countable hω₀
    · -- Sets containing `ω₀` with countable complement are complements of measurable away-point
      -- countable sets.
      have hs_compl_meas :
          MeasurableSet[MeasurableSpace.generateFrom (singletonsAwayFrom ω₀)] sᶜ :=
        measurableSet_generateFrom_singletonsAwayFrom_of_countable hs_compl_countable
          (by simpa using hω₀)
      simpa [compl_compl] using hs_compl_meas.compl

-- Proof sketch: use `Measure.isComplete_iff`; if `δ_{ω₀} s = 0`, then `s` cannot contain `ω₀`,
-- and an uncountable set avoiding `ω₀` would force every measurable superset to contain `ω₀`,
-- hence have Dirac mass `1`; therefore every null set is countable and avoids `ω₀`, so it is
-- measurable by construction.
/-- Exercise 1.3.2 (2): with the σ-algebra generated by the singletons away from `ω₀`, the Dirac
measure `δ_{ω₀}` is complete. -/
theorem dirac_isComplete_countable_or_countable_compl_at_point
    (ω₀ : Ω) :
    let _ : MeasurableSpace Ω :=
      MeasurableSpace.generateFrom (singletonsAwayFrom ω₀)
    (Measure.dirac ω₀).IsComplete := by
  let _ : MeasurableSpace Ω :=
    MeasurableSpace.generateFrom (singletonsAwayFrom ω₀)
  -- Work in the generated measurable space from the theorem statement.
  rw [Measure.isComplete_iff]
  intro s hs_null
  -- Pass to the measurable hull so that part (i) can describe its shape.
  let t : Set Ω := toMeasurable (Measure.dirac ω₀) s
  have ht_meas : MeasurableSet t := measurableSet_toMeasurable _ _
  have ht_null : (Measure.dirac ω₀) t = 0 := by
    simpa [t] using (measure_toMeasurable (μ := Measure.dirac ω₀) s).trans hs_null
  have hω₀_not_mem_t : ω₀ ∉ t := by
    intro hmem
    exact one_ne_zero ((Measure.dirac_apply_of_mem hmem).symm.trans ht_null)
  have ht_countable : t.Countable := by
    have ht_shape :
        countableOrCocountableAtPoint ω₀ t :=
      (measurableSet_countable_or_countable_compl_at_point_iff (ω₀ := ω₀) (s := t)).1 ht_meas
    rcases ht_shape with ht_countable | ht_cocountable
    · exact ht_countable.1
    · exact (hω₀_not_mem_t ht_cocountable.1).elim
  have hs_countable : s.Countable := by
    exact Set.Countable.mono (subset_toMeasurable (Measure.dirac ω₀) s) ht_countable
  have hω₀_not_mem_s : ω₀ ∉ s := by
    intro hmem
    exact one_ne_zero ((Measure.dirac_apply_of_mem hmem).symm.trans hs_null)
  -- A null set is countable and avoids `ω₀`, so part (i) makes it measurable.
  exact (measurableSet_countable_or_countable_compl_at_point_iff (ω₀ := ω₀) (s := s)).2 <|
    Or.inl ⟨hs_countable, hω₀_not_mem_s⟩
