import Mathlib

-- Declarations for this item will be appended below by the statement pipeline.

open Set MeasureTheory MeasurableSpace

universe u

variable {Ω : Type u} [MeasurableSpace Ω]
variable {μ ν : Measure Ω} {E : Set (Set Ω)}

-- Proof sketch: This is exactly mathlib's measure extensionality theorem for a generating
-- `π`-system equipped with finite spanning sets in the generator, namely
-- `Measure.FiniteSpanningSetsIn.ext`.
/-- Lemma 1.42: If `E` is a `π`-system generating the measurable space and `μ` has finite spanning
sets contained in `E`, then `μ` is uniquely determined by its values on `E`. -/
theorem measure_ext_of_generateFrom_of_finiteSpanningSetsIn
    (hA : ‹MeasurableSpace Ω› = generateFrom E) (hE : IsPiSystem E)
    (hμ : μ.FiniteSpanningSetsIn E) (h_eq : ∀ s ∈ E, μ s = ν s) :
    μ = ν := by
  -- The sigma-finite uniqueness statement is exactly the packaged extensionality theorem for
  -- finite spanning sets inside the generating `π`-system.
  exact hμ.ext hA hE h_eq

-- Proof sketch: Probability measures are finite, and both assign mass `1` to `univ`; apply
-- `ext_of_generate_finite` to the generating `π`-system `E`.
/-- Probability measures on a σ-algebra generated by a `π`-system are determined by their values on
that generator. -/
theorem measure_ext_of_generateFrom_of_isProbabilityMeasure
    [IsProbabilityMeasure μ] [IsProbabilityMeasure ν]
    (hA : ‹MeasurableSpace Ω› = generateFrom E) (hE : IsPiSystem E)
    (h_eq : ∀ s ∈ E, μ s = ν s) :
    μ = ν := by
  -- Probability measures are finite, so it remains to match their total mass on `univ`.
  apply ext_of_generate_finite E hA hE h_eq
  -- Both total masses simplify to `1` from the probability-measure hypotheses.
  simp
