import Mathlib

-- Declarations for this item will be appended below by the statement pipeline.

open Set MeasureTheory MeasurableSpace

universe u

variable {Ω : Type u}

-- Proof sketch: the trace of `𝒜` on the subtype `A` is the family `Set.preimage Subtype.val '' 𝒜`.
-- Apply `MeasurableSpace.comap_generateFrom` to the inclusion `Subtype.val : A → Ω`.
/-- Corollary 1.83: For a nonempty subset `A`, the σ-algebra generated by the trace of `𝒜` on `A`
coincides with the trace measurable space on `A` induced by the σ-algebra generated by `𝒜`. -/
theorem generateFrom_trace_eq_comap_generateFrom (𝒜 : Set (Set Ω)) (A : Set Ω)
    (hA : A.Nonempty) :
    MeasurableSpace.generateFrom (Set.preimage (Subtype.val : A → Ω) '' 𝒜) =
      (MeasurableSpace.generateFrom 𝒜).comap (Subtype.val : A → Ω) := by
  -- The textbook proof uses the canonical inclusion `Subtype.val : A → Ω` as the governing map.
  -- Route correction: rather than unfolding traces, specialize the abstract pullback identity for
  -- generated σ-algebras to this inclusion.
  simpa using (MeasurableSpace.comap_generateFrom (f := (Subtype.val : A → Ω)) (s := 𝒜)).symm
