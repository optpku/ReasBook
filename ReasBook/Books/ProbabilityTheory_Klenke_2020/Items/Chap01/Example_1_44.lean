import Mathlib

-- Declarations for this item will be appended below by the statement pipeline.

open MeasureTheory MeasurableSpace Set Real Encodable

private theorem isCountablySpanning_Iic_rat : IsCountablySpanning (⋃ q : ℚ, {Iic (q : ℝ)}) := by
  classical
  cases nonempty_encodable ℚ
  let e : ℕ → ℚ := fun n ↦ (@Encodable.decode ℚ _ n).getD 0
  refine ⟨fun n ↦ Iic (e n : ℝ), ?_, ?_⟩
  · intro n
    exact mem_iUnion.2 ⟨e n, by simp⟩
  · simpa [Real.iUnion_Iic_rat, e] using
      (Encodable.surjective_decode_getD ℚ 0).iUnion_comp fun q ↦ Iic (q : ℝ)

private theorem measurableSpace_pi_eq_generateFrom_Iic (n : ℕ) :
    MeasurableSpace.pi = generateFrom (range (Iic : (Fin n → ℝ) → Set (Fin n → ℝ))) := by
  let C : Set (Set ℝ) := ⋃ q : ℚ, {Iic (q : ℝ)}
  refine le_antisymm ?_ ?_
  · have hpi :
        generateFrom (pi univ '' pi univ (fun _ : Fin n ↦ C)) = MeasurableSpace.pi := by
      simpa [C] using
        (generateFrom_eq_pi (α := fun _ : Fin n ↦ ℝ) (C := fun _ : Fin n ↦ C)
          (fun _ ↦ Real.borel_eq_generateFrom_Iic_rat.symm)
          (fun _ ↦ isCountablySpanning_Iic_rat))
    rw [← hpi]
    exact generateFrom_mono <| by
      rintro _ ⟨s, hs, rfl⟩
      have hs' : ∀ i : Fin n, ∃ q : ℚ, Iic (q : ℝ) = s i := by
        intro i
        simpa [C] using hs i (mem_univ i)
      choose q hq using hs'
      refine mem_range.2 ⟨fun i ↦ (q i : ℝ), ?_⟩
      ext x
      constructor
      · intro hx
        show x ∈ pi univ s
        intro i _
        rw [← hq i]
        exact hx i
      · intro hx i
        have hxi : x i ∈ s i := hx i (mem_univ i)
        rw [← hq i] at hxi
        exact hxi
  · refine generateFrom_le ?_
    rintro _ ⟨b, rfl⟩
    rw [← pi_univ_Iic]
    exact MeasurableSet.univ_pi fun _ ↦ measurableSet_Iic

private theorem iUnion_Iic_const_eq_univ (n : ℕ) :
    (⋃ m : ℕ, Iic (fun _ : Fin n ↦ (m : ℝ))) = univ := by
  ext x
  constructor
  · intro _
    simp
  · intro _
    rcases (Finite.bddAbove_range x) with ⟨a, ha⟩
    rcases exists_nat_ge a with ⟨m, hm⟩
    refine mem_iUnion.2 ⟨m, ?_⟩
    show x ≤ fun _ : Fin n ↦ (m : ℝ)
    intro i
    exact le_trans (ha ⟨i, rfl⟩) hm

-- Proof sketch: `borel_eq_generateFrom_euclideanBorelGeneratorClass` identifies the Borel
-- `σ`-algebra on `Fin n → ℝ` with the one generated by the closed lower orthants, and then
-- `measure_ext_of_generateFrom_of_isProbabilityMeasure` gives extensionality on that generating
-- `π`-system.
/-- Example 1.44: A probability measure on `ℝⁿ`, modeled as `Fin n → ℝ`, is uniquely determined
by its values on the closed lower orthants `(-∞, b] = Set.Iic b`. -/
theorem probabilityMeasure_eq_of_closedLowerOrthants
    {n : ℕ} {μ ν : Measure (Fin n → ℝ)} [IsProbabilityMeasure μ] [IsProbabilityMeasure ν]
    (h : ∀ b : Fin n → ℝ, μ (Set.Iic b) = ν (Set.Iic b)) :
    μ = ν := by
  have hIic : IsPiSystem (range (Iic : (Fin n → ℝ) → Set (Fin n → ℝ))) := by
    rintro _ ⟨a, rfl⟩ _ ⟨b, rfl⟩ -
    exact ⟨a ⊓ b, Iic_inter_Iic.symm⟩
  refine Measure.ext_of_generateFrom_of_cover_subset
    (measurableSpace_pi_eq_generateFrom_Iic n) hIic ?_
    (Set.countable_range fun m : ℕ ↦ Iic (fun _ : Fin n ↦ (m : ℝ)))
    (iUnion_Iic_const_eq_univ n) ?_ ?_
  · rintro _ ⟨m, rfl⟩
    exact mem_range_self _
  · rintro _ ⟨m, rfl⟩
    exact measure_ne_top μ (Iic (fun _ : Fin n ↦ (m : ℝ)))
  · rintro s ⟨b, rfl⟩
    exact h b

-- Proof sketch: apply `Measure.ext_of_Iic` to the two probability measures, using that
-- probability measures are finite and that `Set.Iic x = (-∞, x]` on `ℝ`.
/-- A real probability measure is uniquely determined by its distribution function
`x ↦ μ (Set.Iic x)`. -/
theorem probabilityMeasure_eq_of_distributionFunction
    {μ ν : Measure ℝ} [IsProbabilityMeasure μ] [IsProbabilityMeasure ν]
    (h : ∀ x : ℝ, μ (Set.Iic x) = ν (Set.Iic x)) :
    μ = ν :=
  Measure.ext_of_Iic μ ν h
