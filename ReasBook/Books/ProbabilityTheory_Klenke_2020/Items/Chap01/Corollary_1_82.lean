import Mathlib

-- Declarations for this item will be appended below by the statement pipeline.

universe u v w z

open MeasurableSpace

variable {I : Type u} [Nonempty I]
variable {Ω : Type v} {Ω' : Type w} {Ωi : I → Type z}
variable [MeasurableSpace Ω] [mΩ' : MeasurableSpace Ω'] [∀ i, MeasurableSpace (Ωi i)]

-- Proof sketch: for the forward implication, compose each measurable `X i` with `Y`, using that
-- `hA'` makes every `X i` measurable from `Ω'`. For the converse, rewrite measurability of `Y`
-- as a `comap` inequality and use `hA'`, `MeasurableSpace.comap_iSup`, `MeasurableSpace.comap_comp`,
-- and `iSup_le_iff` to reduce to the measurability of each composite `X i ∘ Y`.
/-- Corollary 1.82: If the measurable space on `Ω'` is generated by a nonempty family of maps
`X i : Ω' → Ωi i`, then a map `Y : Ω → Ω'` is measurable if and only if every composite
`X i ∘ Y` is measurable. -/
theorem measurable_iff_forall_measurable_comp_of_iSup_comap
    (X : ∀ i, Ω' → Ωi i)
    (hA' : mΩ' = ⨆ i, (inferInstance : MeasurableSpace (Ωi i)).comap (X i))
    {Y : Ω → Ω'} :
    Measurable Y ↔ ∀ i, Measurable (X i ∘ Y) := by
  constructor
  · intro hY i
    -- First recover measurability of each coordinate map `X i` from the generating description of `mΩ'`.
    have hXi : Measurable (X i) := by
      refine Measurable.of_comap_le ?_
      rw [hA']
      exact le_iSup (fun j => (inferInstance : MeasurableSpace (Ωi j)).comap (X j)) i
    -- Then the forward implication is just stability of measurability under composition.
    simpa only [Function.comp_def] using hXi.comp hY
  · intro hcomp
    -- For the converse, rewrite measurability of `Y` as a `comap` inequality and expand the codomain `iSup`.
    rw [measurable_iff_comap_le, hA', MeasurableSpace.comap_iSup, iSup_le_iff]
    intro i
    -- Each pointwise `comap` inequality is exactly the measurability of the composite `X i ∘ Y`.
    simpa only [measurable_iff_comap_le, MeasurableSpace.comap_comp, Function.comp_def] using
      hcomp i
