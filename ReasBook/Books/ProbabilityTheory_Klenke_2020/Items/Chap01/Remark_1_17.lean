import Mathlib
import Mathlib.MeasureTheory.PiSystem

-- Declarations for this item will be appended below by the statement pipeline.

universe u

open MeasurableSpace
open MeasurableSpace.DynkinSystem

variable {α : Type u}

/- Remark 1.17 (1): Every generating family is contained in the σ-algebra it generates. -/
recall measurableSet_generateFrom

/- Remark 1.17 (2): Enlarging the generating family enlarges the generated σ-algebra. -/
recall generateFrom_mono

-- Proof sketch: a family of sets is a σ-algebra exactly when it is already the family of
-- measurable sets of some measurable space, and then `generateFrom` recovers that measurable
-- space.
/-- Remark 1.17 (3): A family of sets is a σ-algebra exactly when σ-generation fixes it. -/
theorem exists_measurableSpace_iff_generateFrom_eq_self (A : Set (Set α)) :
    (∃ m : MeasurableSpace α, {s | @MeasurableSet α m s} = A) ↔
      {s | @MeasurableSet α (generateFrom A) s} = A := by
  constructor
  · rintro ⟨m, hm⟩
    have h_generate : generateFrom A = m := by
      refine le_antisymm ?_ ?_
      · exact MeasurableSpace.generateFrom_le fun t ht ↦ by
          change t ∈ {s | MeasurableSet s}
          rw [hm]
          exact ht
      · intro s hs
        have hsA : s ∈ A := by
          rw [← hm]
          exact hs
        exact measurableSet_generateFrom hsA
    ext s
    rw [h_generate, hm]
  · intro hA
    exact ⟨generateFrom A, hA⟩

/- Remark 1.17 (4): Every generating family is contained in the λ-system it generates. -/
recall GenerateHas.basic

-- Proof sketch: use the least-property of `DynkinSystem.generate` with target
-- `DynkinSystem.generate D₂`.
/-- Remark 1.17 (5): Enlarging the generating family enlarges the generated λ-system. -/
theorem dynkinSystem_generate_mono {D₁ D₂ : Set (Set α)} (h : D₁ ⊆ D₂) :
    generate D₁ ≤ generate D₂ :=
  (generate D₂).generate_le fun s hs ↦ GenerateHas.basic s (h hs)

-- Proof sketch: a family is a λ-system exactly when it is already the `Has`-predicate of some
-- Dynkin system, and then `DynkinSystem.generate` recovers that Dynkin system.
/-- Remark 1.17 (6): A family of sets is a λ-system exactly when λ-generation fixes it. -/
theorem exists_dynkinSystem_iff_generate_eq_self (D : Set (Set α)) :
    (∃ d : DynkinSystem α, d.Has = D) ↔ {s | (generate D).Has s} = D := by
  constructor
  · rintro ⟨d, hd⟩
    have h_generate : generate D = d := by
      refine le_antisymm ?_ ?_
      · exact d.generate_le fun t ht ↦ by
          rw [hd]
          exact ht
      · intro s hs
        have hsD : s ∈ D := by
          rw [← hd]
          exact hs
        exact GenerateHas.basic s hsD
    ext s
    rw [h_generate, hd]
    rfl
  · intro hD
    exact ⟨generate D, hD⟩

/- Remark 1.17 (7): The λ-system generated by `E` is contained in the σ-algebra generated by `E`.
This is the inclusion `δ(E) ⊆ σ(E)`. -/
recall generate_has_subset_generate_measurable
