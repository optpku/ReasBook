import Mathlib
import Books.ProbabilityTheory_Klenke_2020.Items.Chap01.Example_1_11

-- Declarations for this item will be appended below by the statement pipeline.

open Set
open MeasureTheory MeasurableSpace

universe u

/-- A set is measurable in the countable-co-countable measurable space exactly when it is
countable or cocountable. -/
-- Proof sketch: use Example 1.11 (16), which identifies the measurable sets of the canonical
-- generated sigma-algebra.
theorem measurableSet_countable_or_countable_compl_measurable_space_iff
    {Ω : Type u} [Nonempty Ω] {s : Set Ω} :
    MeasurableSet[generateFrom (countableOrCocountableFamily Ω)] s ↔
      s.Countable ∨ (sᶜ).Countable := by
  -- Translate measurability into membership in the fixed sigma-algebra from Example 1.11 (16).
  constructor
  · intro hs
    have hs' : s ∈ {t : Set Ω | MeasurableSet[generateFrom (countableOrCocountableFamily Ω)] t} :=
      hs
    rw [countableOrCocountableFamily_generatedSigma_eq Ω] at hs'
    simpa [countableOrCocountableFamily] using hs'
  · intro hs
    have hs' : s ∈ countableOrCocountableFamily Ω := by
      simpa [countableOrCocountableFamily] using hs
    rw [← countableOrCocountableFamily_generatedSigma_eq Ω] at hs'
    exact hs'

/-- Helper for Exercise 1.1.4: every countable subset is measurable in the σ-algebra generated by
all singletons. -/
lemma measurableSet_generateFromSingletons_of_countable {Ω : Type u} {s : Set Ω}
    (hs : s.Countable) :
    MeasurableSet[generateFrom (Set.range fun ω : Ω ↦ ({ω} : Set Ω))] s := by
  -- Rewrite a countable set as the union of the singleton generators indexed by its elements.
  have h_union : s = ⋃ ω ∈ s, ({ω} : Set Ω) := by
    ext x
    simp
  rw [h_union]
  -- Each singleton lies in the generating family, so the countable union remains measurable.
  refine MeasurableSet.biUnion hs fun ω hω => ?_
  exact MeasurableSpace.measurableSet_generateFrom (Set.mem_range_self ω)

/-- Exercise 1.1.4: the σ-algebra generated by all singletons is the countable-co-countable
measurable space. -/
-- Proof sketch: prove the forward inclusion by `generateFrom` induction, using that the
-- countable-or-co-countable sets form a measurable space; prove the reverse inclusion by writing
-- every countable set as a countable union of singletons and using complements for cocountable
-- sets.
theorem generateFrom_singletons_eq_countable_or_countable_compl (Ω : Type u) :
    MeasurableSpace.generateFrom (Set.range fun ω : Ω ↦ ({ω} : Set Ω)) =
      generateFrom (countableOrCocountableFamily Ω) := by
  -- Route correction: compare the two generated spaces via their generators instead of rebuilding
  -- the countable-or-cocountable sigma-algebra by induction.
  refine le_antisymm ?_ ?_
  · -- Every singleton generator is countable, hence belongs to the countable-or-cocountable
    -- generating family.
    refine MeasurableSpace.generateFrom_mono ?_
    rintro s ⟨ω, rfl⟩
    exact Or.inl (countable_singleton ω)
  · -- A countable generator is a countable union of singleton generators, and a cocountable
    -- generator is the complement of such a set.
    refine MeasurableSpace.generateFrom_le ?_
    intro s hs
    rcases hs with hs | hs
    · exact measurableSet_generateFromSingletons_of_countable hs
    · simpa using (measurableSet_generateFromSingletons_of_countable hs).compl
