import Mathlib

-- Declarations for this item will be appended below by the statement pipeline.

open Set
open scoped MeasureTheory

universe u v

/-- Theorem 1.81: Pulling back the σ-algebra generated by a class `E'` along `X` is the same as
generating the pullbacks of the sets in `E'`. -/
-- Proof sketch: rewrite the right-hand side as a comap and apply
-- `MeasurableSpace.comap_generateFrom`.
theorem preimage_generateFrom_eq_comap_generateFrom {α : Type u} {β : Type v} (X : α → β)
    (E' : Set (Set β)) :
    MeasurableSpace.generateFrom (preimage X '' E') =
      (MeasurableSpace.generateFrom E').comap X := by
  -- Rewrite the pulled-back generated σ-algebra into the generated family of pullbacks.
  rw [MeasurableSpace.comap_generateFrom]

/-- Measurability into a σ-algebra generated by `E'` can be checked on the generating class `E'`.
-/
-- Proof sketch: express measurability as a `comap ≤` statement, rewrite the comap of the generated
-- σ-algebra using `preimage_generateFrom_eq_comap_generateFrom`, and unfold `generateFrom_le_iff`.
theorem measurable_generateFrom_iff {α : Type u} {β : Type v} {m : MeasurableSpace α}
    {X : α → β} {E' : Set (Set β)} :
    @Measurable α β m (MeasurableSpace.generateFrom E') X ↔
      ∀ s ∈ E', MeasurableSet[m] (X ⁻¹' s) := by
  -- Translate measurability into the lattice condition on the pulled-back σ-algebra.
  rw [measurable_iff_comap_le]
  -- Replace the comap of the generated σ-algebra by the σ-algebra generated by pullbacks.
  rw [MeasurableSpace.comap_generateFrom]
  -- Reduce containment of a generated σ-algebra to measurability of its generators.
  rw [MeasurableSpace.generateFrom_le_iff]
  constructor
  · intro h s hs
    -- Each generator from `E'` gives a generator in the image family of pullbacks.
    exact h ⟨s, hs, rfl⟩
  · intro h t ht
    -- Any generator in the image family is the pullback of some set from `E'`.
    rcases ht with ⟨s, hs, rfl⟩
    exact h s hs

/-- If `E'` generates the codomain σ-algebra, measurability of `X` is equivalent to measurability
of the preimages of the sets in `E'`. -/
-- Proof sketch: transport `measurable_generateFrom_iff` across the identification
-- `MeasurableSpace.generateFrom E' = m'`.
theorem measurable_iff_of_generateFrom_eq {α : Type u} {β : Type v} {m : MeasurableSpace α}
    {m' : MeasurableSpace β} {X : α → β} {E' : Set (Set β)}
    (hE' : MeasurableSpace.generateFrom E' = m') :
    @Measurable α β m m' X ↔ ∀ s ∈ E', MeasurableSet[m] (X ⁻¹' s) := by
  -- Rewrite the codomain σ-algebra to the generated one and invoke the generator criterion.
  rw [← hE']
  exact measurable_generateFrom_iff
