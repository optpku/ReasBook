import Mathlib

-- Declarations for this item will be appended below by the statement pipeline.

open MeasureTheory

universe u v

-- Proof sketch: `mΩ'.comap X` makes `X` measurable by `MeasurableSpace.comap_measurable`. If `m`
-- is any measurable space on `Ω` for which `X` is measurable, then `Measurable.comap_le` gives
-- `mΩ'.comap X ≤ m`, proving minimality.
/-- Theorem 1.78: for a map `X : Ω → Ω'` into a measurable space `mΩ'`, the pullback
`σ`-algebra `mΩ'.comap X`, whose measurable sets are precisely the preimages `X ⁻¹' s'` of
`mΩ'`-measurable sets `s'`, is the smallest `σ`-algebra on `Ω` with respect to which `X` is
measurable. This is the `σ`-algebra generated by `X`. -/
theorem generatedSigmaAlgebra_isLeast {Ω : Type u} {Ω' : Type v} [Nonempty Ω]
    (mΩ' : MeasurableSpace Ω') (X : Ω → Ω') :
    IsLeast {m : MeasurableSpace Ω | Measurable[m, mΩ'] X} (mΩ'.comap X) := by
  refine ⟨?_, ?_⟩
  · -- The pullback `σ`-algebra is constructed precisely so that `X` is measurable from it.
    exact comap_measurable X
  · -- Any competing `σ`-algebra making `X` measurable must contain the pullback one.
    intro m hm
    exact hm.comap_le
