import Mathlib

-- Declarations for this item will be appended below by the statement pipeline.

universe u v w

open MeasurableSpace
open scoped MeasureTheory

variable {Ω : Type u} {I : Type v} {Ωi : I → Type w}
variable (m : ∀ i, MeasurableSpace (Ωi i)) (X : ∀ i, Ω → Ωi i)

/-- Definition 1.79: the `σ`-algebra on `Ω` generated by a family of maps
`X i : Ω → Ωi i` is canonically the pullback of the product measurable space along the bundled map
`ω ↦ fun i ↦ X i ω`; equivalently, it is the smallest measurable space on `Ω` for which all
coordinate maps `X i` are measurable. -/
theorem generatedSigmaAlgebraFamily_isLeast :
    IsLeast
      {mΩ : MeasurableSpace Ω |
        Measurable[mΩ, @MeasurableSpace.pi I Ωi m] (fun ω i ↦ X i ω)}
      ((@MeasurableSpace.pi I Ωi m).comap (fun ω i ↦ X i ω)) := by
  refine ⟨?_, ?_⟩
  · exact comap_measurable _
  · intro mΩ hmΩ
    exact hmΩ.comap_le

/-- The bundled-map formulation of Definition 1.79 is exactly the supremum of the coordinate
pullbacks `((m i).comap (X i))`. -/
theorem generatedSigmaAlgebraFamily_eq_iSup_comap :
    ((@MeasurableSpace.pi I Ωi m).comap (fun ω i ↦ X i ω)) =
      (⨆ i, (m i).comap (X i) : MeasurableSpace Ω) := by
  rw [MeasurableSpace.pi, MeasurableSpace.comap_iSup]
  refine iSup_congr ?_
  intro i
  rw [MeasurableSpace.comap_comp]
  rfl

/-- The coordinate formulation of Definition 1.79: `⨆ i, (m i).comap (X i)` is the smallest
measurable space on `Ω` for which every `X i` is measurable. -/
theorem generatedSigmaAlgebraFamily_isLeast_components :
    IsLeast {mΩ : MeasurableSpace Ω | ∀ i, Measurable[mΩ, m i] (X i)}
      (⨆ i, (m i).comap (X i) : MeasurableSpace Ω) := by
  simpa [generatedSigmaAlgebraFamily_eq_iSup_comap, measurable_pi_iff] using
    generatedSigmaAlgebraFamily_isLeast m X

-- Proof sketch: rewrite the supremum of the pulled-back measurable spaces as
-- `generateFrom` of the union of their measurable sets via
-- `generateFrom_iUnion_measurableSet`, then unfold `measurableSet_comap`.
/-- The measurable space generated by a family of maps is the `σ`-algebra generated by all
preimages `X i ⁻¹' t` of measurable sets `t` in the codomains. -/
theorem generated_by_maps_eq_generateFrom :
    (⨆ i, (m i).comap (X i) : MeasurableSpace Ω) =
      generateFrom
        { s | ∃ i : I, ∃ t : Set (Ωi i), MeasurableSet[m i] t ∧ X i ⁻¹' t = s } := by
  rw [← generateFrom_iUnion_measurableSet (fun i ↦ (m i).comap (X i))]
  congr 1
  ext s
  simp [measurableSet_comap]

-- Proof sketch: expand the generated measurable space as an `iSup`, rewrite `≤` with
-- `iSup_le_iff`, and use `measurable_iff_comap_le` on each component.
/-- A measurable space on `Ω` contains `⨆ i, (m i).comap (X i)` exactly when every `X i` is
measurable with respect to it. -/
theorem generated_by_maps_le_iff {mΩ : MeasurableSpace Ω} :
    (⨆ i, (m i).comap (X i) : MeasurableSpace Ω) ≤ mΩ ↔
      ∀ i, Measurable[mΩ, m i] (X i) := by
  simpa [generatedSigmaAlgebraFamily_eq_iSup_comap, measurable_pi_iff] using
    (measurable_iff_comap_le :
      Measurable[mΩ, @MeasurableSpace.pi I Ωi m] (fun ω i ↦ X i ω) ↔
        ((@MeasurableSpace.pi I Ωi m).comap (fun ω i ↦ X i ω) ≤ mΩ)).symm
