import Mathlib.MeasureTheory.SetSemiring
import Books.ProbabilityTheory_Klenke_2020.Items.Chap01.Theorem_1_4

-- Declarations for this item will be appended below by the statement pipeline.

open MeasureTheory Set
open scoped MeasureTheory

universe u v

variable {Ω : Type u}

/-- Helper for Exercise 1.1.1: atoms coming from finpartitions of pairwise disjoint carrier sets
are themselves pairwise disjoint. -/
lemma sigmaPartsPairwiseDisjoint {u : ℕ → Set Ω}
    (hu : Pairwise fun i j ↦ Disjoint (u i) (u j)) (P : ∀ n, Finpartition (u n)) :
    Pairwise fun a b : Σ n, (P n).parts ↦ Disjoint (a.2.1 : Set Ω) (b.2.1 : Set Ω) := by
  intro a b hab
  rcases a with ⟨i, a⟩
  rcases b with ⟨j, b⟩
  -- Split according to whether the two atoms come from the same partition fiber.
  by_cases hij : i = j
  · subst hij
    have hab' : a ≠ b := by
      intro habEq
      apply hab
      cases habEq
      rfl
    exact (P i).disjoint a.2 b.2 fun habSet ↦ hab' (Subtype.ext habSet)
  · exact (hu hij).mono ((P i).le a.2) ((P j).le b.2)

/-- Helper for Exercise 1.1.1: taking the union over all atoms of the chosen finpartitions
recovers the union of the original family. -/
lemma iUnion_sigmaParts_eq_iUnion {u : ℕ → Set Ω} (P : ∀ n, Finpartition (u n)) :
    (⋃ a : Σ n, (P n).parts, (a.2.1 : Set Ω)) = ⋃ n, u n := by
  ext x
  constructor
  · intro hx
    rcases mem_iUnion.mp hx with ⟨a, ha⟩
    exact mem_iUnion.mpr ⟨a.1, (P a.1).le a.2.2 ha⟩
  · intro hx
    rcases mem_iUnion.mp hx with ⟨n, hn⟩
    have hx' : x ∈ (P n).parts.sup id := by
      rw [(P n).sup_parts]
      exact hn
    have hx'' : x ∈ ⋃ s ∈ (P n).parts, s := by
      simpa [Finset.sup_set_eq_biUnion] using hx'
    rcases (by
        simpa [Set.mem_iUnion, Finset.mem_coe] using hx'' :
          ∃ s ∈ (P n).parts, x ∈ s) with ⟨s, hs, hxs⟩
    exact mem_iUnion.mpr ⟨⟨n, ⟨s, hs⟩⟩, hxs⟩

/-- Helper for Exercise 1.1.1: any pairwise disjoint encodable family of members of `A` can be
reindexed by `ℕ` using `Encodable.decode₂`. -/
lemma exists_natReindex_of_pairwiseDisjoint {A : Set (Set Ω)} {β : Type*} [Encodable β]
    (hEmpty : (∅ : Set Ω) ∈ A) (t : β → Set Ω) (ht_mem : ∀ b, t b ∈ A)
    (ht_disj : Pairwise fun a b ↦ Disjoint (t a) (t b)) :
    ∃ d : ℕ → Set Ω, (∀ n, d n ∈ A) ∧
      Pairwise (fun i j ↦ Disjoint (d i) (d j)) ∧ (⋃ n, d n) = ⋃ b, t b := by
  let d : ℕ → Set Ω := fun n ↦ ⋃ b ∈ Encodable.decode₂ β n, t b
  refine ⟨d, ?_, ?_, ?_⟩
  · intro n
    -- Each decoded layer is either empty or exactly one original atom.
    simpa [d] using
      (Encodable.iUnion_decode₂_cases (f := t) (C := fun s ↦ s ∈ A) hEmpty ht_mem (n := n))
  · -- Distinct codes decode to disjoint original atoms.
    have hd : Pairwise (Function.onFun Disjoint d) := by
      simpa [d] using Encodable.iUnion_decode₂_disjoint_on (f := t) ht_disj
    simpa [Function.onFun] using hd
  · -- The decoded `ℕ`-family covers exactly the original encodable family.
    simpa [d] using (Encodable.iUnion_decode₂ (f := t))

-- Proof sketch: disjointify the countable family by recursively removing the previously covered
-- part; each difference of one semiring set with a finite union of previous semiring sets can be
-- refined into a finite disjoint family in the semiring, and then these finite refinements are
-- reindexed by `ℕ`.
/-- Exercise 1.1.1: A countable union of members of a semiring of sets can be rewritten as a
countable pairwise disjoint union of members of the same semiring. -/
theorem exists_disjoint_iUnion_eq_iUnion_of_isSetSemiring {A : Set (Set Ω)}
    (hA : IsSetSemiring A) (s : ℕ → Set Ω) (hs : ∀ n, s n ∈ A) :
    ∃ d : ℕ → Set Ω, IsDisjointUnionDecomposition A s d := by
  classical
  have hs_supClosure : ∀ n, s n ∈ supClosure A := fun n ↦ subset_supClosure (hs n)
  have hSupDiff : IsDiffClosed (supClosure A) := by
    refine ⟨?_⟩
    intro t u ht hu
    exact hA.isSetRing_supClosure.diff_mem ht hu
  let u : ℕ → Set Ω := disjointed s
  have hu_decomp : IsDisjointUnionDecomposition (supClosure A) s u := by
    -- First disjointize inside the set ring generated by the semiring.
    simpa [u] using
      (disjointed_isDisjointUnionDecomposition_of_isDiffClosed hSupDiff hs_supClosure)
  choose P hP using fun n ↦ hA.mem_supClosure_iff.mp (hu_decomp.mem n)
  let t : (Σ n, (P n).parts) → Set Ω := fun a ↦ a.2.1
  have ht_mem : ∀ a : Σ n, (P n).parts, t a ∈ A := by
    intro a
    exact hP a.1 a.2.2
  have ht_disj : Pairwise fun a b : Σ n, (P n).parts ↦ Disjoint (t a) (t b) := by
    -- Atoms are disjoint within each fiber and across distinct disjointized fibers.
    simpa [t] using sigmaPartsPairwiseDisjoint hu_decomp.pairwiseDisjoint P
  have ht_iUnion : (⋃ a : Σ n, (P n).parts, t a) = ⋃ n, u n := by
    -- Reassemble the partition atoms fiberwise.
    simpa [t] using iUnion_sigmaParts_eq_iUnion P
  letI : Encodable (Σ n, (P n).parts) := Classical.choice (nonempty_encodable _)
  obtain ⟨d, hd_mem, hd_disj, hd_iUnion⟩ :=
    exists_natReindex_of_pairwiseDisjoint hA.empty_mem t ht_mem ht_disj
  refine ⟨d, ?_⟩
  refine { mem := hd_mem, pairwiseDisjoint := hd_disj, iUnion_eq := ?_ }
  -- Flatten the sigma-family to `ℕ`, then compare with the disjointized family.
  calc
    (⋃ n, d n) = ⋃ a : Σ n, (P n).parts, t a := hd_iUnion
    _ = ⋃ n, u n := ht_iUnion
    _ = ⋃ n, s n := hu_decomp.iUnion_eq

-- Proof sketch: refine the finite family into finitely many semiring pieces that are pairwise
-- disjoint and have the same union; in general this may require more pieces than the original
-- index set provides.
/-- A finite union of members of a semiring of sets can be rewritten as a finite pairwise disjoint
union of members of the same semiring. -/
theorem exists_disjoint_biUnion_eq_biUnion_of_isSetSemiring {A : Set (Set Ω)} {ι : Type v}
    (hA : IsSetSemiring A) (t : Finset ι) (s : ι → Set Ω) (hs : ∀ i ∈ t, s i ∈ A) :
    ∃ J : Finset (Set Ω), SetLike.coe J ⊆ A ∧ Set.PairwiseDisjoint (SetLike.coe J) id ∧
      ⋃₀ SetLike.coe J = ⋃ i ∈ t, s i := by
  classical
  let I : Finset (Set Ω) := t.image s
  have hI : (I : Set (Set Ω)) ⊆ A := by
    intro u hu
    rcases Finset.mem_image.mp hu with ⟨i, hi, rfl⟩
    exact hs i hi
  refine ⟨I.biUnion (hA.disjointOfUnion hI), ?_, ?_, ?_⟩
  · intro u hu
    rcases Finset.mem_biUnion.mp hu with ⟨v, hv, huv⟩
    exact hA.disjointOfUnion_subset hI hv huv
  · -- Mathlib already packages the flattened family as pairwise disjoint.
    simpa [I, Finset.coe_biUnion] using hA.pairwiseDisjoint_biUnion_disjointOfUnion hI
  · -- Rewrite the disjointized image family back to the original finite indexed union.
    calc
      ⋃₀ ((I.biUnion (hA.disjointOfUnion hI) : Finset (Set Ω)) : Set (Set Ω))
          = ⋃₀ ⋃ x ∈ I, (hA.disjointOfUnion hI x : Set (Set Ω)) := by
              simp [Finset.coe_biUnion]
      _ = ⋃₀ (I : Set (Set Ω)) := hA.sUnion_disjointOfUnion hI
      _ = ⋃ i ∈ t, s i := by
        ext x
        simp [I]
