import Mathlib.Analysis.Real.OfDigits
import Mathlib.Logic.Equiv.Defs
import Mathlib.MeasureTheory.Constructions.Pi
import Mathlib.MeasureTheory.Constructions.UnitInterval
import Mathlib.MeasureTheory.Function.Floor
import Mathlib.MeasureTheory.MeasurableSpace.Constructions
import Mathlib.Topology.MetricSpace.HausdorffAlexandroff

-- Declarations for this item will be appended below by the statement pipeline.

open MeasureTheory
open scoped Topology

/-- The Bernoulli sequence space `{0,1}^ℕ`, modeled as `ℕ → Bool`. -/
abbrev BernoulliSequence := ℕ → Bool

/-- Helper for Exercise 1.4.4: interpret a Boolean binary sequence as digits in `Fin 2`. -/
private def binaryDigitsFin (ω : BernoulliSequence) : ℕ → Fin 2 :=
  fun n ↦ cond (ω n) (1 : Fin 2) 0

/-- Helper for Exercise 1.4.4: `Real.fromBinary` is `Real.ofDigits` applied to the corresponding
`Fin 2` digit sequence. -/
private theorem fromBinary_eq_ofDigits_binaryDigitsFin (ω : BernoulliSequence) :
    ((Real.fromBinary ω : unitInterval) : ℝ) = Real.ofDigits (binaryDigitsFin ω) := by
  -- Proof comment: unfold the definition of `Real.fromBinary` and simplify the Bool-to-`Fin 2`
  -- conversion pointwise.
  unfold Real.fromBinary
  change
    Real.ofDigits
        ((Homeomorph.piCongrRight fun _ ↦ finTwoEquiv.toHomeomorphOfDiscrete.symm) ω) =
      Real.ofDigits (binaryDigitsFin ω)
  have hdigits :
      ((Homeomorph.piCongrRight fun _ ↦ finTwoEquiv.toHomeomorphOfDiscrete.symm) ω) =
        binaryDigitsFin ω := by
    funext n
    cases h : ω n <;>
      simp [Homeomorph.piCongrRight, Equiv.piCongrRight, binaryDigitsFin, h] <;> rfl
  rw [hdigits]

-- Proof sketch: the product measurable space on `ℕ → Bool` is defined as the supremum of the
-- pulled-back measurable spaces along the coordinate evaluations, so this is exactly the
-- `σ`-algebra generated by the coordinate maps.
/-- Part (1) of Exercise 1.4.4: the product `σ`-algebra on `{0,1}^ℕ` is the `σ`-algebra
generated by the coordinate maps `X_n`. -/
theorem bernoulliSigmaAlgebra_eq_iSup_coordinateComap :
    (inferInstance : MeasurableSpace BernoulliSequence) =
      ⨆ n : ℕ, MeasurableSpace.comap (Function.eval n)
        (inferInstance : MeasurableSpace Bool) :=
  rfl

/-- Part (2) of Exercise 1.4.4: the binary-expansion map `U`, formalized by `Real.fromBinary`, is
measurable from the Bernoulli sequence space to `[0,1]`. -/
theorem measurable_fromBinary :
    Measurable (Real.fromBinary : BernoulliSequence → unitInterval) :=
  Real.fromBinary_continuous.measurable

/-- The canonical binary digits of a point of `[0,1]`: greedy base-two digits on `[0,1)`, and the
constant-one expansion at the endpoint `1`. -/
noncomputable def canonicalBinaryDigits (x : unitInterval) : BernoulliSequence :=
  if (x : ℝ) = 1 then
    fun _ ↦ true
  else
    fun n ↦ finTwoEquiv (Real.digits (x : ℝ) 2 n)

/-- The canonical subset of binary sequences, characterized as the fixed points of decoding and
re-encoding via `canonicalBinaryDigits ∘ Real.fromBinary`. -/
def canonicalBinaryDomain : Set BernoulliSequence :=
  {ω | canonicalBinaryDigits (Real.fromBinary ω) = ω}

/-- Helper for Exercise 1.4.4: the canonical binary digits reconstruct the original point of
`[0,1]`. -/
private theorem fromBinary_canonicalBinaryDigits (x : unitInterval) :
    Real.fromBinary (canonicalBinaryDigits x) = x := by
  -- Proof comment: split between the endpoint `1`, where the canonical digits are all `true`,
  -- and the interior branch, where `Real.digits` already gives the greedy binary expansion.
  apply Subtype.ext
  rw [fromBinary_eq_ofDigits_binaryDigitsFin]
  by_cases hx : (x : ℝ) = 1
  · -- Proof comment: the endpoint branch is exactly the identity `0.111... = 1`.
    have hdigits :
        binaryDigitsFin (canonicalBinaryDigits x) = fun _ ↦ (1 : Fin 2) := by
      funext n
      simp [binaryDigitsFin, canonicalBinaryDigits, hx]
    rw [hdigits]
    simpa [hx] using Real.ofDigits_const_last_eq_one' (b := 2) (by norm_num)
  · -- Proof comment: away from `1`, the canonical digits agree with `Real.digits x 2`.
    have hxIco : (x : ℝ) ∈ Set.Ico 0 1 := by
      refine ⟨x.2.1, lt_of_le_of_ne x.2.2 hx⟩
    have hdigit : ∀ d : Fin 2, cond (finTwoEquiv d) (1 : Fin 2) 0 = d := by
      intro d
      fin_cases d <;> decide
    have hdigits :
        binaryDigitsFin (canonicalBinaryDigits x) = fun n ↦ Real.digits (x : ℝ) 2 n := by
      funext n
      simpa [binaryDigitsFin, canonicalBinaryDigits, hx] using hdigit (Real.digits (x : ℝ) 2 n)
    rw [hdigits]
    exact Real.ofDigits_digits (b := 2) (by norm_num) hxIco

/-- Helper for Exercise 1.4.4: each coordinate of the canonical digit map is measurable. -/
private theorem measurable_canonicalBinaryDigitsCoord (n : ℕ) :
    Measurable (fun x : unitInterval ↦ canonicalBinaryDigits x n) := by
  -- Proof comment: split the definition into the endpoint branch `x = 1` and the greedy-digit
  -- branch, then use measurability of the floor formula for `Real.digits`.
  have hs : MeasurableSet {x : unitInterval | (x : ℝ) = 1} := by
    exact (measurable_subtype_coe : Measurable fun x : unitInterval ↦ (x : ℝ))
      (measurableSet_singleton (1 : ℝ))
  have hfloor : Measurable (fun x : unitInterval ↦ ⌊(x : ℝ) * 2 ^ (n + 1)⌋₊) := by
    exact (measurable_subtype_coe.mul measurable_const).nat_floor
  have hdigitsFin : Measurable (fun x : unitInterval ↦ Real.digits (x : ℝ) 2 n) := by
    simpa [Real.digits] using (Measurable.of_discrete (f := Fin.ofNat 2)).comp hfloor
  have hdigitsBool :
      Measurable (fun x : unitInterval ↦ finTwoEquiv (Real.digits (x : ℝ) 2 n)) := by
    exact (Measurable.of_discrete (f := finTwoEquiv)).comp hdigitsFin
  have hcoord :
      (fun x : unitInterval ↦ canonicalBinaryDigits x n) =
        fun x : unitInterval ↦
          if (x : ℝ) = 1 then true else finTwoEquiv (Real.digits (x : ℝ) 2 n) := by
    funext x
    by_cases hx : (x : ℝ) = 1 <;> simp [canonicalBinaryDigits, hx]
  rw [hcoord]
  exact Measurable.ite hs measurable_const hdigitsBool

/-- Helper for Exercise 1.4.4: the canonical digit map is measurable because its coordinates are
measurable. -/
private theorem measurable_canonicalBinaryDigits :
    Measurable (canonicalBinaryDigits : unitInterval → BernoulliSequence) := by
  -- Proof comment: product measurability reduces to coordinatewise measurability.
  exact measurable_pi_lambda _ measurable_canonicalBinaryDigitsCoord

/-- The fair Bernoulli measure on `{0,1}^ℕ`, realized as the pushforward of `volume` under the
canonical binary-digit map. -/
noncomputable def fairBernoulliMeasure : Measure BernoulliSequence :=
  Measure.map canonicalBinaryDigits volume

/-- The canonical digit sequence of a point in `[0,1]` belongs to the chosen domain of canonical
binary expansions. -/
-- Proof sketch: for `x = 1` the digits are constantly `true`; for `x < 1`, the greedy base-two
-- expansion supplied by `Real.digits` is the terminating-zero expansion of dyadic rationals, hence
-- has infinitely many zeros.
theorem canonicalBinaryDigits_mem_domain (x : unitInterval) :
    canonicalBinaryDigits x ∈ canonicalBinaryDomain := by
  -- Proof comment: canonical digits are fixed by decoding and re-encoding.
  change canonicalBinaryDigits (Real.fromBinary (canonicalBinaryDigits x)) = canonicalBinaryDigits x
  rw [fromBinary_canonicalBinaryDigits]

/-- The inverse map from `[0,1]` to the chosen domain of canonical binary expansions. -/
noncomputable def canonicalBinaryInverse (x : unitInterval) : canonicalBinaryDomain :=
  ⟨canonicalBinaryDigits x, canonicalBinaryDigits_mem_domain x⟩

-- Proof sketch: prove measurability of `canonicalBinaryDomain` from its eventual-zero/eventual-one
-- description, then show that restricting `Real.fromBinary` to this subset removes exactly the
-- ambiguous eventually-one expansions while retaining the constant-one sequence for `1`.
/-- The chosen domain of canonical binary expansions is measurable. -/
theorem measurableSet_canonicalBinaryDomain :
    MeasurableSet canonicalBinaryDomain := by
  -- Proof comment: the fixed-point condition is a countable intersection of coordinatewise
  -- equality constraints in the discrete product space.
  let f : BernoulliSequence → BernoulliSequence := fun ω ↦ canonicalBinaryDigits (Real.fromBinary ω)
  have hf : Measurable f := measurable_canonicalBinaryDigits.comp measurable_fromBinary
  have hdomain :
      canonicalBinaryDomain = ⋂ n : ℕ, {ω : BernoulliSequence | f ω n = ω n} := by
    ext ω
    constructor
    · intro hω
      refine Set.mem_iInter.2 fun n ↦ ?_
      simpa [f] using congrArg (fun η : BernoulliSequence ↦ η n) hω
    · intro hω
      have hpointwise : ∀ n : ℕ, f ω n = ω n := by
        intro n
        exact Set.mem_iInter.1 hω n
      exact funext hpointwise
  rw [hdomain]
  refine MeasurableSet.iInter fun n ↦ ?_
  let g : BernoulliSequence → Bool × Bool := fun ω ↦ (f ω n, ω n)
  have hg : Measurable g := by
    exact Measurable.prodMk ((measurable_pi_apply n).comp hf) (measurable_pi_apply n)
  have hset :
      {ω : BernoulliSequence | f ω n = ω n} =
        g ⁻¹' ({(false, false), (true, true)} : Set (Bool × Bool)) := by
    ext ω
    cases h₁ : f ω n <;> cases h₂ : ω n <;> simp [g, h₁, h₂]
  rw [hset]
  exact hg (by simp)

/-- The restriction of the binary-expansion map to the chosen domain of canonical binary
expansions is bijective onto `[0,1]`. -/
theorem bijective_fromBinary_canonicalBinaryDomain :
    Function.Bijective (fun ω : canonicalBinaryDomain ↦ Real.fromBinary ω.1) := by
  -- Proof comment: the chosen domain consists exactly of the fixed points of
  -- `canonicalBinaryDigits ∘ Real.fromBinary`, so the canonical digit map is a two-sided inverse.
  constructor
  · intro ω η hEq
    apply Subtype.ext
    calc
      ω.1 = canonicalBinaryDigits (Real.fromBinary ω.1) := by
        simpa [canonicalBinaryDomain] using ω.2.symm
      _ = canonicalBinaryDigits (Real.fromBinary η.1) := by simp [hEq]
      _ = η.1 := η.2
  · intro x
    refine ⟨canonicalBinaryInverse x, ?_⟩
    exact fromBinary_canonicalBinaryDigits x

/-- Helper for Exercise 1.4.4: the canonical digit map pushes `volume` forward to the chosen
presentation of the fair Bernoulli measure. -/
private theorem map_canonicalBinaryDigits_volume :
    Measure.map canonicalBinaryDigits volume = fairBernoulliMeasure := by
  rfl

-- Proof sketch: first identify the fair Bernoulli measure as the pushforward of `volume` under
-- the canonical digit map, then compose with `Real.fromBinary`, which decodes those digits back to
-- the identity on `[0,1]`.
/-- Exercise 1.4.4 (3): the image measure of the fair Bernoulli product measure under the
binary-expansion map is the uniform measure on `[0,1]`. -/
theorem map_fromBinary_fairBernoulliMeasure :
    Measure.map (Real.fromBinary : BernoulliSequence → unitInterval) fairBernoulliMeasure =
      volume := by
  calc
    Measure.map (Real.fromBinary : BernoulliSequence → unitInterval) fairBernoulliMeasure =
        Measure.map (Real.fromBinary : BernoulliSequence → unitInterval)
          (Measure.map canonicalBinaryDigits volume) := by
            rw [map_canonicalBinaryDigits_volume]
    _ = Measure.map (Real.fromBinary ∘ canonicalBinaryDigits) volume := by
          rw [Measure.map_map measurable_fromBinary measurable_canonicalBinaryDigits]
    _ = Measure.map (fun x : unitInterval ↦ x) volume := by
          refine Measure.map_congr <| Filter.Eventually.of_forall ?_
          intro x
          exact fromBinary_canonicalBinaryDigits x
    _ = volume := by simp

/-- Part (4) of Exercise 1.4.4: the subset of canonical binary expansions is measurable, and the
restriction of the binary-expansion map to it is bijective onto `[0,1]`. -/
theorem canonicalBinaryDomain_measurableSet_and_fromBinary_bijective :
    MeasurableSet canonicalBinaryDomain ∧
      Function.Bijective (fun ω : canonicalBinaryDomain ↦ Real.fromBinary ω.1) :=
  ⟨measurableSet_canonicalBinaryDomain, bijective_fromBinary_canonicalBinaryDomain⟩

-- Proof sketch: use the explicit formula for `canonicalBinaryInverse`; measurability follows from
-- the measurability of the digit maps `x ↦ Real.digits x 2 n` on `[0,1)` together with the
-- measurable singleton `{1}`.
/-- Part (5) of Exercise 1.4.4: the inverse of the bijective restriction of the binary-expansion
map is measurable. -/
theorem measurable_canonicalBinaryInverse :
    Measurable canonicalBinaryInverse := by
  -- Proof comment: the inverse is the measurable canonical digit map with codomain restricted to
  -- the measurable canonical domain.
  change Measurable fun x : unitInterval ↦
    (⟨canonicalBinaryDigits x, canonicalBinaryDigits_mem_domain x⟩ : canonicalBinaryDomain)
  exact measurable_canonicalBinaryDigits.subtype_mk

-- Proof sketch: unfold `canonicalBinaryInverse` and read off the `n`th coordinate of the chosen
-- canonical digit sequence.
/-- The `n`th coordinate of the canonical inverse is the `n`th canonical binary digit. -/
@[simp] theorem canonicalBinaryInverse_apply (n : ℕ) (x : unitInterval) :
    (canonicalBinaryInverse x).1 n = canonicalBinaryDigits x n :=
  rfl

/-- Part (6) of Exercise 1.4.4: composing the `n`th coordinate map with the inverse of the
canonical binary-expansion bijection returns the `n`th binary digit of the canonical expansion of a
point in `[0,1]`. -/
theorem coordinateMap_canonicalBinaryInverse_eq_canonicalBinaryDigit (n : ℕ) :
    (fun x : unitInterval ↦ (canonicalBinaryInverse x).1 n) = fun x ↦ canonicalBinaryDigits x n :=
  rfl
