import Books.ProbabilityTheory_Klenke_2020.Items.Chap02.Definition_2_34
import Books.ProbabilityTheory_Klenke_2020.Items.Chap02.Corollary_2_39

-- Declarations for this item will be appended below by the statement pipeline.

open Filter MeasureTheory
open scoped BigOperators

universe u

variable {Ω : Type u} [MeasurableSpace Ω]

omit [MeasurableSpace Ω] in
/-- Helper for Example 2.36: the event `limsup A atTop` is measurable in the canonical tail
`σ`-algebra generated by the one-event `σ`-algebras `generateFrom {A n}`. -/
private theorem measurableSet_limsup_tailGenerateFrom (A : ℕ → Set Ω) :
    MeasurableSet[limsup (fun n ↦ MeasurableSpace.generateFrom {A n}) atTop] (limsup A atTop) := by
  -- Rewrite the tail `σ`-algebra as the intersection of tail stages indexed by `n`.
  rw [Filter.limsup_eq_iInf_iSup_of_nat', MeasurableSpace.measurableSet_iInf]
  intro n
  let m : MeasurableSpace Ω := ⨆ i, MeasurableSpace.generateFrom {A (i + n)}
  change MeasurableSet[m] (limsup A atTop)
  letI : MeasurableSpace Ω := m
  -- Every shifted event belongs to the `n`th tail stage.
  have hA : ∀ i, MeasurableSet (A (i + n)) := fun i ↦ by
    let h_le : MeasurableSpace.generateFrom {A (i + n)} ≤ m :=
      le_iSup (fun j ↦ MeasurableSpace.generateFrom {A (j + n)}) i
    exact h_le _ <| MeasurableSpace.measurableSet_generateFrom (Set.mem_singleton _)
  -- The limsup of measurable shifted events is measurable in that tail stage.
  simpa [m, Filter.limsup_nat_add] using MeasurableSet.measurableSet_limsup hA

omit [MeasurableSpace Ω] in
/-- Helper for Example 2.36: the event `liminf A atTop` is measurable in the canonical tail
`σ`-algebra generated by the one-event `σ`-algebras `generateFrom {A n}`. -/
private theorem measurableSet_liminf_tailGenerateFrom (A : ℕ → Set Ω) :
    MeasurableSet[limsup (fun n ↦ MeasurableSpace.generateFrom {A n}) atTop] (liminf A atTop) := by
  -- Rewrite the tail `σ`-algebra as the intersection of tail stages indexed by `n`.
  rw [Filter.limsup_eq_iInf_iSup_of_nat', MeasurableSpace.measurableSet_iInf]
  intro n
  let m : MeasurableSpace Ω := ⨆ i, MeasurableSpace.generateFrom {A (i + n)}
  change MeasurableSet[m] (liminf A atTop)
  letI : MeasurableSpace Ω := m
  -- Every shifted event belongs to the `n`th tail stage.
  have hA : ∀ i, MeasurableSet (A (i + n)) := fun i ↦ by
    let h_le : MeasurableSpace.generateFrom {A (i + n)} ≤ m :=
      le_iSup (fun j ↦ MeasurableSpace.generateFrom {A (j + n)}) i
    exact h_le _ <| MeasurableSpace.measurableSet_generateFrom (Set.mem_singleton _)
  -- The liminf of measurable shifted events is measurable in that tail stage.
  simpa [m, Filter.liminf_nat_add] using MeasurableSet.measurableSet_liminf hA

omit [MeasurableSpace Ω] in
-- Proof sketch: view `tailEventMeasurableSpace A` as the canonical tail `σ`-algebra generated by
-- the one-event `σ`-algebras `generateFrom {A n}`; then `liminf A atTop` and `limsup A atTop`
-- are measurable with respect to every tail stage `⨆ m ∈ Set.Ici N, MeasurableSpace.generateFrom
-- {A m}`, hence with respect to their intersection.
/-- Example 2.36 (1): The set-theoretic `liminf` and `limsup` of an event sequence are measurable
with respect to the tail σ-algebra generated by that sequence. -/
theorem measurableSet_liminf_limsup_tail_of_events (A : ℕ → Set Ω) :
    MeasurableSet[tailEventMeasurableSpace A] (liminf A atTop) ∧
      MeasurableSet[tailEventMeasurableSpace A] (limsup A atTop) :=
  by
  -- Rewrite the tail event `σ`-algebra from `cofinite` to `atTop` on `ℕ`.
  change
    MeasurableSet[limsup (fun n ↦ MeasurableSpace.generateFrom {A n}) cofinite] (liminf A atTop) ∧
      MeasurableSet[limsup (fun n ↦ MeasurableSpace.generateFrom {A n}) cofinite]
        (limsup A atTop)
  rw [Nat.cofinite_eq_atTop]
  -- The two helper lemmas provide the tail measurability of `liminf` and `limsup`.
  exact ⟨measurableSet_liminf_tailGenerateFrom A, measurableSet_limsup_tailGenerateFrom A⟩

omit [MeasurableSpace Ω] in
/-- Helper for Example 2.36: the pointwise `liminf` and `limsup` of a real-valued process are
measurable in the canonical tail `σ`-algebra `limsup (fun n ↦ comap (X n) (borel ℝ)) atTop`. -/
private theorem measurable_liminf_limsup_atTop_of_real_process (X : ℕ → Ω → ℝ) :
    Measurable[limsup (fun n ↦ MeasurableSpace.comap (X n) (borel ℝ)) atTop]
      (fun ω ↦ liminf (fun n ↦ X n ω) atTop) ∧
    Measurable[limsup (fun n ↦ MeasurableSpace.comap (X n) (borel ℝ)) atTop]
      (fun ω ↦ limsup (fun n ↦ X n ω) atTop) := by
  let tailSpace : ℕ → MeasurableSpace Ω :=
    fun N ↦ ⨆ n : ℕ, ⨆ _ : n ∈ Set.Ici N, MeasurableSpace.comap (X n) (borel ℝ)
  have h_liminf_tail : ∀ N,
      Measurable[tailSpace N] (fun ω ↦ liminf (fun n ↦ X (n + N) ω) atTop) := by
    intro N
    -- Each shifted coordinate is measurable in the `N`th tail stage.
    have h_shift : ∀ n, Measurable[tailSpace N] (fun ω ↦ X (n + N) ω) := by
      intro n
      refine Measurable.of_comap_le ?_
      exact le_iSup_of_le (n + N) <| le_iSup_of_le (by simp) le_rfl
    -- Closure under countable `liminf` gives the shifted tail limit.
    simpa using Measurable.liminf h_shift
  have h_limsup_tail : ∀ N,
      Measurable[tailSpace N] (fun ω ↦ limsup (fun n ↦ X (n + N) ω) atTop) := by
    intro N
    -- The same tail-stage argument works for `limsup`.
    have h_shift : ∀ n, Measurable[tailSpace N] (fun ω ↦ X (n + N) ω) := by
      intro n
      refine Measurable.of_comap_le ?_
      exact le_iSup_of_le (n + N) <| le_iSup_of_le (by simp) le_rfl
    simpa using Measurable.limsup h_shift
  constructor
  · -- The unshifted `liminf` agrees with every shifted tail `liminf`.
    refine Measurable.of_comap_le ?_
    rw [Filter.limsup_eq_iInf_iSup_of_nat]
    refine le_iInf fun N ↦ ?_
    have hN : Measurable[tailSpace N] (fun ω ↦ liminf (fun n ↦ X n ω) atTop) := by
      convert h_liminf_tail N using 1
      ext ω
      simpa using (Filter.liminf_nat_add (fun n ↦ X n ω) N).symm
    simpa [tailSpace] using hN.comap_le
  · -- The unshifted `limsup` is handled identically.
    refine Measurable.of_comap_le ?_
    rw [Filter.limsup_eq_iInf_iSup_of_nat]
    refine le_iInf fun N ↦ ?_
    have hN : Measurable[tailSpace N] (fun ω ↦ limsup (fun n ↦ X n ω) atTop) := by
      convert h_limsup_tail N using 1
      ext ω
      simpa using (Filter.limsup_nat_add (fun n ↦ X n ω) N).symm
    simpa [tailSpace] using hN.comap_le

omit [MeasurableSpace Ω] in
-- Proof sketch: for each tail stage of `tailRandomVariableMeasurableSpace X`, namely
-- `⨆ m ∈ Set.Ici N, MeasurableSpace.comap (X m) (borel ℝ)`, the tail infimum and tail supremum of
-- the shifted sequence are measurable by closure under countable `liminf` and `limsup`; taking
-- the intersection over `N` gives tail measurability.
/-- Helper for Example 2.36: the pointwise `liminf` and `limsup` of a real-valued process are
measurable with respect to the tail σ-algebra generated by the process. -/
private theorem measurable_liminf_limsup_tail_of_real_process (X : ℕ → Ω → ℝ) :
    Measurable[tailRandomVariableMeasurableSpace X] (fun ω ↦ liminf (fun n ↦ X n ω) atTop) ∧
      Measurable[tailRandomVariableMeasurableSpace X] (fun ω ↦ limsup (fun n ↦ X n ω) atTop) :=
  by
  -- Rewrite the tail random-variable `σ`-algebra from `cofinite` to `atTop` on `ℕ`.
  change
    Measurable[limsup (fun n ↦ MeasurableSpace.comap (X n) (borel ℝ)) cofinite]
      (fun ω ↦ liminf (fun n ↦ X n ω) atTop) ∧
    Measurable[limsup (fun n ↦ MeasurableSpace.comap (X n) (borel ℝ)) cofinite]
      (fun ω ↦ limsup (fun n ↦ X n ω) atTop)
  rw [Nat.cofinite_eq_atTop]
  -- The auxiliary atTop theorem is exactly the desired tail measurability statement.
  exact measurable_liminf_limsup_atTop_of_real_process X

-- Proof sketch: this is the `tailRandomVariableMeasurableSpace X` reformulation of the canonical
-- Cesàro-tail measurability theorem already established in `Corollary_2_39`. The only work is to
-- rewrite the tail `σ`-algebra from `cofinite` to `atTop` on `ℕ` and unfold `cesaroAverage`.
/-- Tail measurability result for Example 2.36 (3): the `liminf` and `limsup` of the Cesàro means
`n ↦ (∑ i ∈ Finset.Icc 1 (n + 1), X i ω) / (((n + 1 : ℕ) : ℝ))` of a real-valued process are
measurable with respect to the tail σ-algebra generated by the process. -/
theorem measurable_liminf_limsup_tail_of_cesaro_averages_tailRandomVariableMeasurableSpace
    (X : ℕ → Ω → ℝ) :
    Measurable[tailRandomVariableMeasurableSpace X]
      (fun ω ↦ liminf
        (fun n ↦ (∑ i ∈ Finset.Icc 1 (n + 1), X i ω) / ((n + 1 : ℕ) : ℝ)) atTop) ∧
    Measurable[tailRandomVariableMeasurableSpace X]
      (fun ω ↦ limsup
        (fun n ↦ (∑ i ∈ Finset.Icc 1 (n + 1), X i ω) / ((n + 1 : ℕ) : ℝ)) atTop) := by
  change
    Measurable[limsup (fun n ↦ MeasurableSpace.comap (X n) (borel ℝ)) cofinite]
      (fun ω ↦ liminf
        (fun n ↦ (∑ i ∈ Finset.Icc 1 (n + 1), X i ω) / ((n + 1 : ℕ) : ℝ)) atTop) ∧
    Measurable[limsup (fun n ↦ MeasurableSpace.comap (X n) (borel ℝ)) cofinite]
      (fun ω ↦ limsup
        (fun n ↦ (∑ i ∈ Finset.Icc 1 (n + 1), X i ω) / ((n + 1 : ℕ) : ℝ)) atTop)
  rw [Nat.cofinite_eq_atTop]
  simpa [cesaroAverage] using measurable_liminf_limsup_tail_of_cesaro_averages X
