import Mathlib

-- Declarations for this item will be appended below by the statement pipeline.

open Filter MeasureTheory

universe u v w

variable {Ω : Type u} {ι : Type v}

/-- Definition 2.34: The tail `σ`-algebra of a family `(m i)ᵢ` of `σ`-algebras on `Ω` is the
canonical `limsup` of the family along the cofinite filter, i.e. the intersection of the
`σ`-algebras generated by the coordinates outside a finite set of indices. -/
abbrev tailMeasurableSpace (m : ι → MeasurableSpace Ω) : MeasurableSpace Ω :=
  limsup m cofinite

/-- The tail measurable space is the infimum of the tail stages obtained by discarding finitely
many coordinates. -/
theorem tailMeasurableSpace_def (m : ι → MeasurableSpace Ω) :
    tailMeasurableSpace m =
      ⨅ s : {s : Set ι // s.Finite}, ⨆ i ∈ s.1ᶜ, m i := by
  simpa [tailMeasurableSpace, iInf_subtype'] using
    (hasBasis_cofinite.limsup_eq_iInf_iSup :
      limsup m cofinite = ⨅ s : Set ι, ⨅ _ : s.Finite, ⨆ i ∈ sᶜ, m i)

/-- The tail `σ`-algebra of a family of events is the tail measurable space of the `σ`-algebras
generated by the individual events. -/
abbrev tailEventMeasurableSpace (A : ι → Set Ω) : MeasurableSpace Ω :=
  tailMeasurableSpace (fun i ↦ MeasurableSpace.generateFrom {A i})

variable {β : ι → Type w} [mβ : ∀ i, MeasurableSpace (β i)]

/-- The tail `σ`-algebra of a family of random variables is the tail measurable space of the
generated `σ(X i)`, realized as the comap measurable spaces along the coordinate maps. -/
abbrev tailRandomVariableMeasurableSpace (X : ∀ i, Ω → β i) : MeasurableSpace Ω :=
  tailMeasurableSpace (fun i ↦ MeasurableSpace.comap (X i) (mβ i))
