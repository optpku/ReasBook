import Mathlib

-- Declarations for this item will be appended below by the statement pipeline.

open Filter MeasureTheory ProbabilityTheory
open scoped BigOperators

universe u

variable {Ω : Type u} [MeasurableSpace Ω]

/-- The Cesàro average of the first `n + 1` positive-index terms of a real-valued sequence of
random variables. -/
noncomputable def cesaroAverage (X : ℕ → Ω → ℝ) (n : ℕ) (ω : Ω) : ℝ :=
  (∑ i ∈ Finset.Icc 1 (n + 1), X i ω) / (n + 1 : ℝ)

-- Proof sketch: unfold the definition of `cesaroAverage`; the statement is the defining formula.
/-- The defining formula for `cesaroAverage`. -/
theorem cesaroAverage_def (X : ℕ → Ω → ℝ) (n : ℕ) (ω : Ω) :
    cesaroAverage X n ω = (∑ i ∈ Finset.Icc 1 (n + 1), X i ω) / (n + 1 : ℝ) := by
  -- This is just the defining equation of the local abbreviation.
  rfl

/-- Helper for Corollary 2.39: the pointwise `liminf` and `limsup` of an `EReal`-valued process
are measurable with respect to the tail `σ`-algebra generated by that process. -/
theorem measurable_liminf_limsup_tail_of_ereal_process (X : ℕ → Ω → EReal) :
    Measurable[limsup (fun n ↦ MeasurableSpace.comap (X n) (borel EReal)) atTop]
      (fun ω ↦ liminf (fun n ↦ X n ω) atTop) ∧
    Measurable[limsup (fun n ↦ MeasurableSpace.comap (X n) (borel EReal)) atTop]
      (fun ω ↦ limsup (fun n ↦ X n ω) atTop) := by
  let tailSpace : ℕ → MeasurableSpace Ω :=
    fun N ↦ ⨆ n : ℕ, ⨆ _ : n ∈ Set.Ici N, MeasurableSpace.comap (X n) (borel EReal)
  have h_liminf_tail : ∀ N,
      Measurable[tailSpace N] (fun ω ↦ liminf (fun n ↦ X (n + N) ω) atTop) := by
    intro N
    -- Each shifted coordinate is measurable in the `N`th tail `σ`-algebra.
    have h_shift : ∀ n, Measurable[tailSpace N] (fun ω ↦ X (n + N) ω) := by
      intro n
      refine Measurable.of_comap_le ?_
      exact le_iSup_of_le (n + N) <| le_iSup_of_le (by simp) le_rfl
    -- The `liminf` inherits measurability from the shifted coordinates.
    simpa using Measurable.liminf h_shift
  have h_limsup_tail : ∀ N,
      Measurable[tailSpace N] (fun ω ↦ limsup (fun n ↦ X (n + N) ω) atTop) := by
    intro N
    -- The same tail argument applies to the `limsup`.
    have h_shift : ∀ n, Measurable[tailSpace N] (fun ω ↦ X (n + N) ω) := by
      intro n
      refine Measurable.of_comap_le ?_
      exact le_iSup_of_le (n + N) <| le_iSup_of_le (by simp) le_rfl
    simpa using Measurable.limsup h_shift
  constructor
  · -- The unshifted `liminf` agrees with every shifted tail `liminf`, so it is measurable in the
    -- intersection of all tail `σ`-algebras.
    refine Measurable.of_comap_le ?_
    rw [Filter.limsup_eq_iInf_iSup_of_nat]
    refine le_iInf fun N ↦ ?_
    have hN : Measurable[tailSpace N] (fun ω ↦ liminf (fun n ↦ X n ω) atTop) := by
      convert h_liminf_tail N using 1
      ext ω
      simpa using (Filter.liminf_nat_add (fun n ↦ X n ω) N).symm
    simpa [tailSpace] using hN.comap_le
  · -- The same argument works verbatim for the `limsup`.
    refine Measurable.of_comap_le ?_
    rw [Filter.limsup_eq_iInf_iSup_of_nat]
    refine le_iInf fun N ↦ ?_
    have hN : Measurable[tailSpace N] (fun ω ↦ limsup (fun n ↦ X n ω) atTop) := by
      convert h_limsup_tail N using 1
      ext ω
      simpa using (Filter.limsup_nat_add (fun n ↦ X n ω) N).symm
    simpa [tailSpace] using hN.comap_le

/-- Helper for Corollary 2.39: every sublevel event of a tail-measurable `EReal` random variable
has probability `0` or `1` under Kolmogorov's `0`-`1` law. -/
theorem measure_preimage_Iic_zero_one_of_tail_measurable (μ : Measure Ω) [IsProbabilityMeasure μ]
    (X : ℕ → Ω → EReal) (hX_meas : ∀ n, Measurable (X n)) (hX_indep : iIndepFun X μ)
    {F : Ω → EReal}
    (hF_tail : Measurable[limsup (fun n ↦ MeasurableSpace.comap (X n) (borel EReal)) atTop] F) :
    ∀ x : EReal, μ (F ⁻¹' Set.Iic x) = 0 ∨ μ (F ⁻¹' Set.Iic x) = 1 := by
  intro x
  -- Tail measurability of `F` turns the threshold event into a tail event.
  have h_tail_set :
      MeasurableSet[limsup (fun n ↦ MeasurableSpace.comap (X n) (borel EReal)) atTop]
        (F ⁻¹' Set.Iic x) :=
    hF_tail measurableSet_Iic
  -- Kolmogorov's `0`-`1` law applies to the tail `σ`-algebra generated by the coordinates.
  refine ProbabilityTheory.measure_zero_or_one_of_measurableSet_limsup_atTop
    (fun n ↦ (hX_meas n).comap_le) hX_indep.iIndep h_tail_set

/-- Helper for Corollary 2.39: if every closed sublevel event of an `EReal` random variable has
probability `0` or `1`, then the random variable is almost surely constant. -/
theorem ae_eq_const_of_zero_one_Iic_ereal (μ : Measure Ω) [IsProbabilityMeasure μ] {F : Ω → EReal}
    (hF_meas : Measurable F)
    (h_zero_one : ∀ x : EReal, μ (F ⁻¹' Set.Iic x) = 0 ∨ μ (F ⁻¹' Set.Iic x) = 1) :
    ∃ c : EReal, F =ᵐ[μ] fun _ ↦ c := by
  classical
  let S : Set EReal := {x | μ (F ⁻¹' Set.Iic x) = 1}
  let c : EReal := sInf S
  have h_lower_null : ∀ q : {q : ℚ // (((q : ℝ) : EReal) < c)},
      μ (F ⁻¹' Set.Iic (((q : ℝ) : EReal))) = 0 := by
    intro q
    -- Any rational threshold strictly below `c` cannot already have probability `1`.
    rcases h_zero_one (((q : ℝ) : EReal)) with hq | hq
    · exact hq
    · exfalso
      have hq_mem : (((q : ℝ) : EReal)) ∈ S := by
        simpa [S] using hq
      have hc_le : c ≤ (((q : ℝ) : EReal)) := sInf_le hq_mem
      exact (not_le_of_gt q.2) hc_le
  have h_upper_null : ∀ q : {q : ℚ // c < (((q : ℝ) : EReal))},
      μ {ω | (((q : ℝ) : EReal)) < F ω} = 0 := by
    intro q
    -- A rational threshold strictly above `c` must dominate some threshold of probability `1`.
    have h_not_lower : ¬ ∀ y ∈ S, (((q : ℝ) : EReal)) ≤ y := by
      intro hq_lower
      have hq_le_c : (((q : ℝ) : EReal)) ≤ c := le_sInf hq_lower
      exact (not_le_of_gt q.2) hq_le_c
    obtain ⟨y, hyS, hylt⟩ : ∃ y ∈ S, y < (((q : ℝ) : EReal)) := by
      by_contra h_no
      apply h_not_lower
      intro y hyS'
      by_contra hyq
      exact h_no ⟨y, hyS', lt_of_not_ge hyq⟩
    have hy_one : μ (F ⁻¹' Set.Iic y) = 1 := by
      simpa [S] using hyS
    have hqy_mono : μ (F ⁻¹' Set.Iic y) ≤ μ (F ⁻¹' Set.Iic (((q : ℝ) : EReal))) := by
      exact MeasureTheory.measure_mono (μ := μ) <| by
        intro ω hω
        exact le_trans hω hylt.le
    have hq_one : μ (F ⁻¹' Set.Iic (((q : ℝ) : EReal))) = 1 := by
      refine le_antisymm ?_ ?_
      · simpa [IsProbabilityMeasure.measure_univ] using
          (MeasureTheory.measure_mono (μ := μ)
            (show F ⁻¹' Set.Iic (((q : ℝ) : EReal)) ⊆ Set.univ by
              intro ω
              simp))
      · simpa [hy_one] using hqy_mono
    have h_meas_q : MeasurableSet (F ⁻¹' Set.Iic (((q : ℝ) : EReal))) := by
      exact hF_meas measurableSet_Iic
    have h_fin_q : μ (F ⁻¹' Set.Iic (((q : ℝ) : EReal))) ≠ ⊤ := by
      rw [hq_one]
      simp
    have h_compl := measure_compl h_meas_q h_fin_q
    have h_set : {ω | (((q : ℝ) : EReal)) < F ω} =
        (F ⁻¹' Set.Iic (((q : ℝ) : EReal)))ᶜ := by
      ext ω
      simp [Set.mem_Iic, not_le]
    rw [h_set]
    simpa [hq_one, IsProbabilityMeasure.measure_univ] using h_compl
  have h_lower_union : {ω | F ω < c} =
      ⋃ q : {q : ℚ // (((q : ℝ) : EReal) < c)}, F ⁻¹' Set.Iic (((q : ℝ) : EReal)) := by
    ext ω
    constructor
    · intro hω
      -- Approximate a strict lower deviation by a rational threshold below `c`.
      rcases EReal.lt_iff_exists_rat_btwn.1 hω with ⟨q, hq_left, hq_right⟩
      refine Set.mem_iUnion.2 ?_
      exact ⟨⟨q, hq_right⟩, hq_left.le⟩
    · intro hω
      rcases Set.mem_iUnion.1 hω with ⟨q, hqω⟩
      exact lt_of_le_of_lt hqω q.2
  have h_upper_union : {ω | c < F ω} =
      ⋃ q : {q : ℚ // c < (((q : ℝ) : EReal))}, {ω | (((q : ℝ) : EReal)) < F ω} := by
    ext ω
    constructor
    · intro hω
      -- Approximate a strict upper deviation by a rational threshold above `c`.
      rcases EReal.lt_iff_exists_rat_btwn.1 hω with ⟨q, hq_left, hq_right⟩
      refine Set.mem_iUnion.2 ?_
      exact ⟨⟨q, hq_left⟩, hq_right⟩
    · intro hω
      rcases Set.mem_iUnion.1 hω with ⟨q, hqω⟩
      exact lt_trans q.2 hqω
  have h_lower_ae : ∀ᵐ ω ∂μ, ¬ F ω < c := by
    -- The lower tail is a countable union of null rational-threshold events.
    rw [ae_iff]
    have h_lower_measure : μ {ω | F ω < c} = 0 := by
      rw [h_lower_union]
      exact measure_iUnion_null h_lower_null
    simpa using h_lower_measure
  have h_upper_ae : ∀ᵐ ω ∂μ, ¬ c < F ω := by
    -- The upper tail is handled by the symmetric rational approximation from above.
    rw [ae_iff]
    have h_upper_measure : μ {ω | c < F ω} = 0 := by
      rw [h_upper_union]
      exact measure_iUnion_null h_upper_null
    simpa using h_upper_measure
  refine ⟨c, ?_⟩
  -- Outside a null set, neither strict inequality can hold, so the values must agree.
  filter_upwards [h_lower_ae, h_upper_ae] with ω hω_lower hω_upper
  exact le_antisymm (le_of_not_gt hω_upper) (le_of_not_gt hω_lower)

/-- Corollary 2.39: For an independent sequence of `EReal`-valued random variables on a
probability space, the pointwise `liminf` and `limsup` are almost surely constant. -/
-- Proof sketch: for each threshold `x : EReal`, the events
-- `{ω | liminf (fun n ↦ X n ω) atTop ≤ x}` and `{ω | limsup (fun n ↦ X n ω) atTop ≤ x}` are tail
-- events. Apply Kolmogorov's `0`-`1` law to their tail measurability, then recover almost sure
-- constancy from the induced `0`-`1` distribution functions on `EReal`.
theorem ae_eq_const_liminf_limsup_of_iIndepFun (μ : Measure Ω) [IsProbabilityMeasure μ]
    (X : ℕ → Ω → EReal) (hX_meas : ∀ n, Measurable (X n)) (hX_indep : iIndepFun X μ) :
    ∃ xInf xSup : EReal,
      ((fun ω ↦ liminf (fun n ↦ X n ω) atTop) =ᵐ[μ] fun _ ↦ xInf) ∧
        ((fun ω ↦ limsup (fun n ↦ X n ω) atTop) =ᵐ[μ] fun _ ↦ xSup) := by
  -- First place the tail limits in the tail `σ`-algebra of the independent family.
  let fInf : Ω → EReal := fun ω ↦ liminf (fun n ↦ X n ω) atTop
  let fSup : Ω → EReal := fun ω ↦ limsup (fun n ↦ X n ω) atTop
  have h_tail := measurable_liminf_limsup_tail_of_ereal_process X
  -- Then each threshold event has probability `0` or `1` by Kolmogorov's law.
  have h_zero_one_inf :
      ∀ x : EReal, μ (fInf ⁻¹' Set.Iic x) = 0 ∨ μ (fInf ⁻¹' Set.Iic x) = 1 :=
    measure_preimage_Iic_zero_one_of_tail_measurable μ X hX_meas hX_indep h_tail.1
  have h_zero_one_sup :
      ∀ x : EReal, μ (fSup ⁻¹' Set.Iic x) = 0 ∨ μ (fSup ⁻¹' Set.Iic x) = 1 :=
    measure_preimage_Iic_zero_one_of_tail_measurable μ X hX_meas hX_indep h_tail.2
  -- The measurable tail limits now fit the `EReal` zero-one Dirac argument.
  have h_meas_inf : Measurable fInf := by
    simpa [fInf] using Measurable.liminf hX_meas
  have h_meas_sup : Measurable fSup := by
    simpa [fSup] using Measurable.limsup hX_meas
  rcases ae_eq_const_of_zero_one_Iic_ereal μ h_meas_inf h_zero_one_inf with ⟨xInf, hxInf⟩
  rcases ae_eq_const_of_zero_one_Iic_ereal μ h_meas_sup h_zero_one_sup with ⟨xSup, hxSup⟩
  exact ⟨xInf, xSup, hxInf, hxSup⟩

/-- Helper for Corollary 2.39: each finite Cesàro average is measurable when the coordinates are
measurable. -/
theorem measurable_cesaroAverage (X : ℕ → Ω → ℝ) (hX_meas : ∀ n, Measurable (X n)) (n : ℕ) :
    Measurable (cesaroAverage X n) := by
  -- Finite sums of measurable coordinates stay measurable, and dividing by a constant preserves
  -- measurability.
  simpa [cesaroAverage] using
    ((Finset.measurable_sum (Finset.Icc 1 (n + 1)) fun i _ ↦ hX_meas i).div_const (n + 1 : ℝ))

/-- Helper for Corollary 2.39: the Cesàro average obtained by deleting the first `N` summands but
keeping the original denominator `n + 1`. -/
noncomputable def tailCesaroAverage (X : ℕ → Ω → ℝ) (N n : ℕ) (ω : Ω) : ℝ :=
  (∑ i ∈ Finset.Icc (N + 1) (n + 1), X i ω) / (n + 1 : ℝ)

/-- Helper for Corollary 2.39: the tail-truncated Cesàro averages are measurable in the tail
`σ`-algebra generated by the coordinates `X m` with `m ≥ N`. -/
theorem tailCesaroAverage_measurable (X : ℕ → Ω → ℝ) (N n : ℕ) :
    Measurable[⨆ m : ℕ, ⨆ _ : m ∈ Set.Ici N, MeasurableSpace.comap (X m) (borel ℝ)]
      (tailCesaroAverage X N n) := by
  let tailSpace : MeasurableSpace Ω :=
    ⨆ m : ℕ, ⨆ _ : m ∈ Set.Ici N, MeasurableSpace.comap (X m) (borel ℝ)
  -- Each summand only depends on a single tail coordinate, so the whole finite sum is
  -- measurable in the tail `σ`-algebra.
  have h_coord : ∀ i ∈ Finset.Icc (N + 1) (n + 1), Measurable[tailSpace] (fun ω ↦ X i ω) := by
    intro i hi
    refine Measurable.of_comap_le ?_
    exact le_iSup_of_le i <| le_iSup_of_le (by
      simpa [Set.mem_Ici] using Nat.le_of_succ_le (Finset.mem_Icc.mp hi).1) le_rfl
  -- Dividing by the fixed denominator preserves tail measurability.
  simpa [tailCesaroAverage, tailSpace] using
    ((Finset.measurable_sum (Finset.Icc (N + 1) (n + 1)) h_coord).div_const (n + 1 : ℝ))

/-- Helper for Corollary 2.39: after splitting off the fixed prefix, the Cesàro average differs
from the tail-truncated Cesàro average by a deterministic `prefixSum / (n + 1)` term. -/
theorem cesaro_prefix_difference_tendsto_zero (X : ℕ → Ω → ℝ) (N : ℕ) (ω : Ω) :
    Tendsto (fun n ↦ cesaroAverage X n ω - tailCesaroAverage X N n ω) atTop (nhds 0) := by
  set prefixSum := ∑ i ∈ Finset.Icc 1 N, X i ω with hprefix
  have h_event :
      (fun n ↦ cesaroAverage X n ω - tailCesaroAverage X N n ω) =ᶠ[atTop]
        fun n : ℕ ↦ prefixSum / (n + 1 : ℝ) := by
    refine Filter.eventually_atTop.2 ⟨N, fun n hn ↦ ?_⟩
    have hsum :
        (∑ i ∈ Finset.Icc 1 N, X i ω) + ∑ i ∈ Finset.Icc (N + 1) (n + 1), X i ω =
          ∑ i ∈ Finset.Icc 1 (n + 1), X i ω := by
      rw [← Finset.Ico_add_one_right_eq_Icc, ← Finset.Ico_add_one_right_eq_Icc,
        ← Finset.Ico_add_one_right_eq_Icc]
      simpa [Nat.add_assoc] using
        (Finset.sum_Ico_consecutive (fun i ↦ X i ω) (Nat.succ_le_succ (Nat.zero_le N))
          (le_trans (Nat.succ_le_succ hn) (Nat.le_succ (n + 1))))
    have hden : (n + 1 : ℝ) ≠ 0 := by positivity
    -- Once `n ≥ N`, the sum splits into the fixed prefix and the tail block with the same
    -- denominator.
    change cesaroAverage X n ω - tailCesaroAverage X N n ω = prefixSum / (n + 1 : ℝ)
    rw [cesaroAverage_def, tailCesaroAverage]
    field_simp [hden]
    linarith [hsum]
  have h_prefix_nat :
      Tendsto (fun n : ℕ ↦ prefixSum / (((n + 1 : ℕ) : ℝ))) atTop (nhds 0) := by
    exact (tendsto_const_div_atTop_nhds_zero_nat prefixSum).comp (Filter.tendsto_add_atTop_nat 1)
  have h_prefix :
      Tendsto (fun n : ℕ ↦ prefixSum / (n + 1 : ℝ)) atTop (nhds 0) := by
    simpa using h_prefix_nat
  exact h_prefix.congr' h_event.symm

/-- Helper for Corollary 2.39: adding a real-valued error term that tends to `0` does not change
the real `liminf` or `limsup` along `atTop`, even under mathlib's convention for unbounded
real-valued filters. -/
theorem liminf_limsup_add_tendsto_zero_real (u e : ℕ → ℝ)
    (he : Tendsto e atTop (nhds 0)) :
    liminf (fun n ↦ u n + e n) atTop = liminf u atTop ∧
      limsup (fun n ↦ u n + e n) atTop = limsup u atTop := by
  have he_bdd_ge : IsBoundedUnder (fun x1 x2 : ℝ ↦ x1 ≥ x2) atTop e := he.isBoundedUnder_ge
  have he_cob_ge : IsCoboundedUnder (fun x1 x2 : ℝ ↦ x1 ≥ x2) atTop e := he.isCoboundedUnder_ge
  have he_bdd_le : IsBoundedUnder (fun x1 x2 : ℝ ↦ x1 ≤ x2) atTop e := he.isBoundedUnder_le
  have he_cob_le : IsCoboundedUnder (fun x1 x2 : ℝ ↦ x1 ≤ x2) atTop e := he.isCoboundedUnder_le
  have hneg_bdd_ge : IsBoundedUnder (fun x1 x2 : ℝ ↦ x1 ≥ x2) atTop (fun n ↦ -e n) := by
    simpa using he.neg.isBoundedUnder_ge
  have hneg_bdd_le : IsBoundedUnder (fun x1 x2 : ℝ ↦ x1 ≤ x2) atTop (fun n ↦ -e n) := by
    simpa using he.neg.isBoundedUnder_le
  have he_liminf : liminf e atTop = 0 := he.liminf_eq
  have he_limsup : limsup e atTop = 0 := he.limsup_eq
  constructor
  · by_cases hu_cob : IsCoboundedUnder (fun x1 x2 : ℝ ↦ x1 ≥ x2) atTop u
    · by_cases hu_bdd : IsBoundedUnder (fun x1 x2 : ℝ ↦ x1 ≥ x2) atTop u
      · -- In the bounded/cobounded regime, the additive liminf inequalities apply directly.
        apply le_antisymm
        · calc
            liminf (fun n ↦ u n + e n) atTop = liminf (e + u) atTop := by
              apply Filter.liminf_congr
              exact Filter.Eventually.of_forall fun n ↦ by simp [Pi.add_apply, add_comm]
            _ ≤ limsup e atTop + liminf u atTop := by
              exact liminf_add_le he_bdd_ge he_bdd_le hu_bdd hu_cob
            _ = liminf u atTop := by simp [he_limsup]
        · calc
            liminf u atTop = liminf e atTop + liminf u atTop := by simp [he_liminf]
            _ ≤ liminf (e + u) atTop := by
              exact le_liminf_add he_bdd_ge he_bdd_le hu_bdd hu_cob
            _ = liminf (fun n ↦ u n + e n) atTop := by
              apply Filter.liminf_congr
              exact Filter.Eventually.of_forall fun n ↦ by simp [Pi.add_apply, add_comm]
      · -- If `u` has no eventual lower bound, the same remains true after adding a bounded error.
        have hsum : ¬ IsBoundedUnder (fun x1 x2 : ℝ ↦ x1 ≥ x2) atTop (fun n ↦ u n + e n) := by
          intro h
          have h' :
              IsBoundedUnder (fun x1 x2 : ℝ ↦ x1 ≥ x2) atTop
                (fun n ↦ -e n + (u n + e n)) :=
            Filter.isBoundedUnder_ge_add hneg_bdd_ge h
          have h'' : IsBoundedUnder (fun x1 x2 : ℝ ↦ x1 ≥ x2) atTop u := by
            simpa [add_assoc] using h'
          exact hu_bdd h''
        simp [Real.liminf_of_not_isBoundedUnder hu_bdd, Real.liminf_of_not_isBoundedUnder hsum]
    · -- If `u` is eventually bounded below, then adding a bounded perturbation cannot create
      -- coboundedness from below.
      have hsum : ¬ IsCoboundedUnder (fun x1 x2 : ℝ ↦ x1 ≥ x2) atTop (fun n ↦ u n + e n) := by
        intro h
        have h' :
            IsCoboundedUnder (fun x1 x2 : ℝ ↦ x1 ≥ x2) atTop
              (fun n ↦ -e n + (u n + e n)) :=
          Filter.isCoboundedUnder_ge_add hneg_bdd_le h
        have h'' : IsCoboundedUnder (fun x1 x2 : ℝ ↦ x1 ≥ x2) atTop u := by
          simpa [add_assoc] using h'
        exact hu_cob h''
      simp [Real.liminf_of_not_isCoboundedUnder hu_cob, Real.liminf_of_not_isCoboundedUnder hsum]
  · by_cases hu_cob : IsCoboundedUnder (fun x1 x2 : ℝ ↦ x1 ≤ x2) atTop u
    · by_cases hu_bdd : IsBoundedUnder (fun x1 x2 : ℝ ↦ x1 ≤ x2) atTop u
      · -- The bounded/cobounded `limsup` case is the dual argument.
        apply le_antisymm
        · calc
            limsup (fun n ↦ u n + e n) atTop = limsup (e + u) atTop := by
              apply Filter.limsup_congr
              exact Filter.Eventually.of_forall fun n ↦ by simp [Pi.add_apply, add_comm]
            _ ≤ limsup e atTop + limsup u atTop := by
              exact limsup_add_le he_bdd_ge he_bdd_le hu_cob hu_bdd
            _ = limsup u atTop := by simp [he_limsup]
        · calc
            limsup u atTop = limsup u atTop + liminf e atTop := by simp [he_liminf]
            _ ≤ limsup (u + e) atTop := by
              exact le_limsup_add hu_bdd hu_cob he_bdd_le he_bdd_ge
            _ = limsup (fun n ↦ u n + e n) atTop := rfl
      · -- The additive perturbation cannot restore eventual upper boundedness.
        have hsum : ¬ IsBoundedUnder (fun x1 x2 : ℝ ↦ x1 ≤ x2) atTop (fun n ↦ u n + e n) := by
          intro h
          have h' :
              IsBoundedUnder (fun x1 x2 : ℝ ↦ x1 ≤ x2) atTop
                (fun n ↦ -e n + (u n + e n)) :=
            Filter.isBoundedUnder_le_add hneg_bdd_le h
          have h'' : IsBoundedUnder (fun x1 x2 : ℝ ↦ x1 ≤ x2) atTop u := by
            simpa [add_assoc] using h'
          exact hu_bdd h''
        simp [Real.limsup_of_not_isBoundedUnder hu_bdd, Real.limsup_of_not_isBoundedUnder hsum]
    · -- The additive perturbation also preserves failure of coboundedness from above.
      have hsum : ¬ IsCoboundedUnder (fun x1 x2 : ℝ ↦ x1 ≤ x2) atTop (fun n ↦ u n + e n) := by
        intro h
        have h' :
            IsCoboundedUnder (fun x1 x2 : ℝ ↦ x1 ≤ x2) atTop
              (fun n ↦ -e n + (u n + e n)) :=
          Filter.isCoboundedUnder_le_add hneg_bdd_ge h
        have h'' : IsCoboundedUnder (fun x1 x2 : ℝ ↦ x1 ≤ x2) atTop u := by
          simpa [add_assoc] using h'
        exact hu_cob h''
      simp [Real.limsup_of_not_isCoboundedUnder hu_cob, Real.limsup_of_not_isCoboundedUnder hsum]

/-- Helper for Corollary 2.39: if two real sequences differ by a term tending to `0`, then their
`liminf` and `limsup` agree along `atTop`. -/
theorem liminf_limsup_eq_of_sub_tendsto_zero (u v : ℕ → ℝ)
    (h : Tendsto (fun n ↦ u n - v n) atTop (nhds 0)) :
    liminf u atTop = liminf v atTop ∧ limsup u atTop = limsup v atTop := by
  have h_add := liminf_limsup_add_tendsto_zero_real v (fun n ↦ u n - v n) h
  constructor
  · -- Rewrite `u` as `v + (u - v)` and invoke the additive stability lemma.
    calc
      liminf u atTop = liminf (fun n ↦ v n + (u n - v n)) atTop := by
        apply Filter.liminf_congr
        exact Filter.Eventually.of_forall fun n ↦ by ring
      _ = liminf v atTop := h_add.1
  · -- The same rewriting yields the `limsup` identity.
    calc
      limsup u atTop = limsup (fun n ↦ v n + (u n - v n)) atTop := by
        apply Filter.limsup_congr
        exact Filter.Eventually.of_forall fun n ↦ by ring
      _ = limsup v atTop := h_add.2

/-- Helper for Corollary 2.39: deleting finitely many summands from the numerator of the Cesàro
averages does not change their `liminf` or `limsup`. -/
theorem cesaro_liminf_limsup_eq_tailCesaro (X : ℕ → Ω → ℝ) (N : ℕ) (ω : Ω) :
    liminf (fun n ↦ cesaroAverage X n ω) atTop =
      liminf (fun n ↦ tailCesaroAverage X N n ω) atTop ∧
    limsup (fun n ↦ cesaroAverage X n ω) atTop =
      limsup (fun n ↦ tailCesaroAverage X N n ω) atTop := by
  -- The prefix discrepancy tends to zero, so the previous stability lemma applies.
  exact liminf_limsup_eq_of_sub_tendsto_zero
    (fun n ↦ cesaroAverage X n ω) (fun n ↦ tailCesaroAverage X N n ω)
    (cesaro_prefix_difference_tendsto_zero X N ω)

/-- Helper for Corollary 2.39: the `liminf` and `limsup` of the Cesàro averages are measurable
with respect to the tail `σ`-algebra generated by the original real process. -/
theorem measurable_liminf_limsup_tail_of_cesaro_averages (X : ℕ → Ω → ℝ) :
    Measurable[limsup (fun n ↦ MeasurableSpace.comap (X n) (borel ℝ)) atTop]
      (fun ω ↦ liminf (fun n ↦ cesaroAverage X n ω) atTop) ∧
    Measurable[limsup (fun n ↦ MeasurableSpace.comap (X n) (borel ℝ)) atTop]
      (fun ω ↦ limsup (fun n ↦ cesaroAverage X n ω) atTop) := by
  let tailSpace : ℕ → MeasurableSpace Ω :=
    fun N ↦ ⨆ m : ℕ, ⨆ _ : m ∈ Set.Ici N, MeasurableSpace.comap (X m) (borel ℝ)
  have h_liminf_tail :
      ∀ N, Measurable[tailSpace N] (fun ω ↦ liminf (fun n ↦ tailCesaroAverage X N n ω) atTop) := by
    intro N
    -- For fixed `N`, each truncated average already lives in the `N`th tail `σ`-algebra.
    simpa [tailSpace] using Measurable.liminf (fun n ↦ tailCesaroAverage_measurable X N n)
  have h_limsup_tail :
      ∀ N, Measurable[tailSpace N] (fun ω ↦ limsup (fun n ↦ tailCesaroAverage X N n ω) atTop) := by
    intro N
    simpa [tailSpace] using Measurable.limsup (fun n ↦ tailCesaroAverage_measurable X N n)
  constructor
  · -- The original Cesàro `liminf` agrees with the truncated tail `liminf` for every `N`.
    refine Measurable.of_comap_le ?_
    rw [Filter.limsup_eq_iInf_iSup_of_nat]
    refine le_iInf fun N ↦ ?_
    have hN :
        Measurable[tailSpace N] (fun ω ↦ liminf (fun n ↦ cesaroAverage X n ω) atTop) := by
      convert h_liminf_tail N using 1
      ext ω
      exact (cesaro_liminf_limsup_eq_tailCesaro X N ω).1
    simpa [tailSpace] using hN.comap_le
  · -- The same finite-prefix invariance yields tail measurability of the `limsup`.
    refine Measurable.of_comap_le ?_
    rw [Filter.limsup_eq_iInf_iSup_of_nat]
    refine le_iInf fun N ↦ ?_
    have hN :
        Measurable[tailSpace N] (fun ω ↦ limsup (fun n ↦ cesaroAverage X n ω) atTop) := by
      convert h_limsup_tail N using 1
      ext ω
      exact (cesaro_liminf_limsup_eq_tailCesaro X N ω).2
    simpa [tailSpace] using hN.comap_le

/-- Helper for Corollary 2.39: if every real closed sublevel set has probability `0` or `1`,
then the real-valued random variable is almost surely constant. -/
theorem ae_eq_const_of_zero_one_Iic_real (μ : Measure Ω) [IsProbabilityMeasure μ] {F : Ω → ℝ}
    (hF_meas : Measurable F)
    (h_zero_one : ∀ x : ℝ, μ (F ⁻¹' Set.Iic x) = 0 ∨ μ (F ⁻¹' Set.Iic x) = 1) :
    ∃ c : ℝ, F =ᵐ[μ] fun _ ↦ c := by
  let FE : Ω → EReal := fun ω ↦ (F ω : EReal)
  have hFE_meas : Measurable FE := by
    -- Coercing a measurable real map into `EReal` preserves measurability.
    simpa [FE] using measurable_coe_real_ereal.comp hF_meas
  have hFE_zero_one : ∀ x : EReal, μ (FE ⁻¹' Set.Iic x) = 0 ∨ μ (FE ⁻¹' Set.Iic x) = 1 := by
    intro x
    -- The only new thresholds are `⊥` and `⊤`; the real thresholds are exactly the hypothesis.
    refine EReal.rec ?_ ?_ ?_ x
    · left
      rw [show Set.Iic (⊥ : EReal) = {⊥} by ext y; simp]
      have hempty : FE ⁻¹' ({⊥} : Set EReal) = ∅ := by
        ext ω
        simp [FE]
      simp [hempty]
    · intro a
      have hpre : FE ⁻¹' Set.Iic (a : EReal) = F ⁻¹' Set.Iic a := by
        ext ω
        simp [FE]
      simpa [hpre] using h_zero_one a
    · right
      simp [IsProbabilityMeasure.measure_univ]
  rcases ae_eq_const_of_zero_one_Iic_ereal μ hFE_meas hFE_zero_one with ⟨cE, hcE⟩
  refine ⟨cE.toReal, ?_⟩
  -- Apply `EReal.toReal` to the almost-sure `EReal` equality to recover a real constant.
  filter_upwards [hcE] with ω hω
  simpa [FE] using congrArg EReal.toReal hω

-- Proof sketch: the Cesàro averages form a tail-measurable sequence because changing finitely many
-- coordinates does not affect the eventual `liminf` or `limsup` of the arithmetic means. Apply
-- the previous almost-sure constancy result to the tail events generated by these averages.
/-- The `liminf` and `limsup` of the Cesàro averages of an independent real-valued sequence are
almost surely constant. -/
theorem ae_eq_const_cesaro_liminf_limsup_of_iIndepFun (μ : Measure Ω) [IsProbabilityMeasure μ]
    (X : ℕ → Ω → ℝ) (hX_meas : ∀ n, Measurable (X n)) (hX_indep : iIndepFun X μ) :
    ∃ xInf xSup : ℝ,
      ((fun ω ↦ liminf (fun n ↦ cesaroAverage X n ω) atTop) =ᵐ[μ] fun _ ↦ xInf) ∧
        ((fun ω ↦ limsup (fun n ↦ cesaroAverage X n ω) atTop) =ᵐ[μ] fun _ ↦ xSup) := by
  -- Route correction: the Cesàro averages are not themselves independent, so we prove instead that
  -- their `liminf` and `limsup` are tail-measurable with respect to the original independent
  -- coordinates.
  let fInf : Ω → ℝ := fun ω ↦ liminf (fun n ↦ cesaroAverage X n ω) atTop
  let fSup : Ω → ℝ := fun ω ↦ limsup (fun n ↦ cesaroAverage X n ω) atTop
  have h_tail := measurable_liminf_limsup_tail_of_cesaro_averages X
  have h_zero_one_inf :
      ∀ x : ℝ, μ (fInf ⁻¹' Set.Iic x) = 0 ∨ μ (fInf ⁻¹' Set.Iic x) = 1 := by
    intro x
    -- Each real threshold event is a tail event, so Kolmogorov's `0`-`1` law applies directly.
    have h_tail_set :
        MeasurableSet[limsup (fun n ↦ MeasurableSpace.comap (X n) (borel ℝ)) atTop]
          (fInf ⁻¹' Set.Iic x) :=
      h_tail.1 measurableSet_Iic
    exact ProbabilityTheory.measure_zero_or_one_of_measurableSet_limsup_atTop
      (fun n ↦ (hX_meas n).comap_le) hX_indep.iIndep h_tail_set
  have h_zero_one_sup :
      ∀ x : ℝ, μ (fSup ⁻¹' Set.Iic x) = 0 ∨ μ (fSup ⁻¹' Set.Iic x) = 1 := by
    intro x
    have h_tail_set :
        MeasurableSet[limsup (fun n ↦ MeasurableSpace.comap (X n) (borel ℝ)) atTop]
          (fSup ⁻¹' Set.Iic x) :=
      h_tail.2 measurableSet_Iic
    exact ProbabilityTheory.measure_zero_or_one_of_measurableSet_limsup_atTop
      (fun n ↦ (hX_meas n).comap_le) hX_indep.iIndep h_tail_set
  have h_meas_inf : Measurable fInf := by
    -- The Cesàro `liminf` is measurable because each finite Cesàro average is measurable.
    simpa [fInf] using Measurable.liminf (fun n ↦ measurable_cesaroAverage X hX_meas n)
  have h_meas_sup : Measurable fSup := by
    simpa [fSup] using Measurable.limsup (fun n ↦ measurable_cesaroAverage X hX_meas n)
  rcases ae_eq_const_of_zero_one_Iic_real μ h_meas_inf h_zero_one_inf with ⟨xInf, hxInf⟩
  rcases ae_eq_const_of_zero_one_Iic_real μ h_meas_sup h_zero_one_sup with ⟨xSup, hxSup⟩
  exact ⟨xInf, xSup, hxInf, hxSup⟩
