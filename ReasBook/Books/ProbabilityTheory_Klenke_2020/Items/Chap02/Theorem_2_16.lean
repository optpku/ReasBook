import Mathlib

-- Declarations for this item will be appended below by the statement pipeline.

universe u v w

open Set MeasureTheory ProbabilityTheory

/-- Helper for Theorem 2.16: pulling back a generating π-system along `X i` preserves the
π-system property. -/
private lemma preimage_generators_is_pi_system {Ω : Type u} {ι : Type v} {β : ι → Type w}
    (X : ∀ i, Ω → β i) (ℰ : ∀ i, Set (Set (β i))) (hℰ_pi : ∀ i, IsPiSystem (ℰ i)) :
    ∀ i, IsPiSystem (Set.preimage (X i) '' ℰ i) := by
  -- This is exactly the comap-stability of π-systems.
  intro i
  simpa using IsPiSystem.comap (hℰ_pi i) (X i)

/-- Helper for Theorem 2.16: the σ-algebra generated by the pulled-back generators is the comap
σ-algebra of `X i`. -/
private lemma preimage_generators_generate_comap {Ω : Type u} {ι : Type v} {β : ι → Type w}
    [mβ : ∀ i, MeasurableSpace (β i)] (X : ∀ i, Ω → β i) (ℰ : ∀ i, Set (Set (β i)))
    (hℰ_generate : ∀ i, MeasurableSpace.generateFrom (ℰ i) = mβ i) :
    ∀ i, (mβ i).comap (X i) = MeasurableSpace.generateFrom (Set.preimage (X i) '' ℰ i) := by
  -- This is the standard `comap_generateFrom` identity after rewriting the codomain σ-algebra.
  intro i
  rw [← hℰ_generate i, MeasurableSpace.comap_generateFrom]

/-- Theorem 2.16: If for each index `i` the family `ℰ i` is a π-system generating the measurable
space on the codomain of the measurable map `X i`, and the preimage families `X i ⁻¹' ℰ i` are
independent, then the random variables `(X i)ᵢ` are independent. -/
theorem iIndepFun_of_iIndepSets_preimage_generators {Ω : Type u} {ι : Type v}
    {β : ι → Type w} [mΩ : MeasurableSpace Ω] [mβ : ∀ i, MeasurableSpace (β i)] (μ : Measure Ω)
    (X : ∀ i, Ω → β i) (hX : ∀ i, Measurable (X i)) (ℰ : ∀ i, Set (Set (β i)))
    (hℰ_pi : ∀ i, IsPiSystem (ℰ i))
    (hℰ_generate : ∀ i, MeasurableSpace.generateFrom (ℰ i) = mβ i)
    (h_indep : iIndepSets (fun i ↦ Set.preimage (X i) '' ℰ i) μ) :
    iIndepFun X μ := by
  rw [iIndepFun_iff_iIndep]
  exact iIndepSets.iIndep
    (fun i ↦ (hX i).comap_le)
    (fun i ↦ Set.preimage (X i) '' ℰ i)
    (preimage_generators_is_pi_system X ℰ hℰ_pi)
    (preimage_generators_generate_comap X ℰ hℰ_generate)
    h_indep
