import Books.ProbabilityTheory_Klenke_2020.Items.Chap02.Definition_2_34

-- Declarations for this item will be appended below by the statement pipeline.

open MeasureTheory Set

universe u v

variable {Ω : Type u} {ι : Type v}

/-- Helper for Theorem 2.35: a finite set of indices is eventually contained in a monotone
exhaustion whose union is all of `ι`. -/
lemma finite_subset_subset_exhaustion_stage {J : ℕ → Set ι} {s : Set ι} (hs : s.Finite)
    (hJ_mono : Monotone J) (hJ_iUnion : (⋃ n, J n) = Set.univ) : ∃ N : ℕ, s ⊆ J N := by
  classical
  -- Every point of the finite set belongs to some stage because the exhaustion covers `ι`.
  have hs_subset : s ⊆ ⋃ n, J n := by
    simp [hJ_iUnion]
  obtain ⟨I, hI_finite, hI_cover⟩ := Set.finite_subset_iUnion hs hs_subset
  let T : Finset ℕ := hI_finite.toFinset
  by_cases hT : T.Nonempty
  · refine ⟨T.max' hT, ?_⟩
    intro x hx
    have hx_mem : x ∈ ⋃ i ∈ (↑T : Set ℕ), J i := by
      simpa [T] using hI_cover hx
    rcases mem_iUnion.mp hx_mem with ⟨n, hx_mem⟩
    rcases mem_iUnion.mp hx_mem with ⟨hnT, hxn⟩
    exact hJ_mono (Finset.le_max' T n hnT) hxn
  · refine ⟨0, ?_⟩
    intro x hx
    have hx_mem : x ∈ ⋃ i ∈ (↑T : Set ℕ), J i := by
      simpa [T] using hI_cover hx
    have hT_empty : T = ∅ := Finset.not_nonempty_iff_eq_empty.mp hT
    simp [hT_empty] at hx_mem

/-- Helper for Theorem 2.35: enlarging the discarded finite set decreases the corresponding
supremum of measurable spaces. -/
lemma iSup_compl_antitone (𝒜 : ι → MeasurableSpace Ω) {s t : Set ι} (hst : s ⊆ t) :
    (⨆ i ∈ tᶜ, 𝒜 i) ≤ ⨆ i ∈ sᶜ, 𝒜 i := by
  -- Any index outside `t` is also outside `s`, so each summand on the left appears on the right.
  refine iSup_le fun i ↦ ?_
  refine iSup_le fun hit ↦ ?_
  refine le_iSup_of_le i ?_
  refine le_iSup_of_le ?_ le_rfl
  exact fun his ↦ hit (hst his)

/-- Helper for Theorem 2.35: the infimum over the exhaustion is bounded by every tail term coming
from a finite index set. -/
lemma iInf_exhaustion_le_tail_term_of_finite (𝒜 : ι → MeasurableSpace Ω) {J : ℕ → Set ι}
    {s : Set ι} (hs : s.Finite) (hJ_mono : Monotone J)
    (hJ_iUnion : (⋃ n, J n) = Set.univ) :
    (⨅ n : ℕ, ⨆ i ∈ (J n)ᶜ, 𝒜 i) ≤ ⨆ i ∈ sᶜ, 𝒜 i := by
  -- Choose a stage containing the whole finite set, then compare complements antitonically.
  obtain ⟨N, hsN⟩ := finite_subset_subset_exhaustion_stage hs hJ_mono hJ_iUnion
  refine le_trans (iInf_le_of_le N le_rfl) ?_
  exact iSup_compl_antitone 𝒜 hsN

-- Proof sketch: for each finite set `s`, the exhaustion hypothesis gives some `N` with
-- `s ⊆ J N`, hence `⨅ n, ⨆ i ∈ (J n)ᶜ, 𝒜 i ≤ ⨆ i ∈ sᶜ, 𝒜 i`. Taking the infimum over all finite
-- `s` gives the reverse inclusion, while the forward inclusion follows from `J n` being finite.
/-- Theorem 2.35: If `J n` is an increasing sequence of finite subsets whose union is all of `I`,
then the tail `σ`-algebra is the intersection of the `σ`-algebras generated by the complements
of the sets `J n`. -/
theorem tailMeasurableSpace_eq_iInf_of_monotone_exhaustion (𝒜 : ι → MeasurableSpace Ω)
    (J : ℕ → Set ι) (hJ_finite : ∀ n, (J n).Finite) (hJ_mono : Monotone J)
    (hJ_iUnion : (⋃ n, J n) = Set.univ) :
    tailMeasurableSpace 𝒜 = ⨅ n : ℕ, ⨆ i ∈ (J n)ᶜ, 𝒜 i := by
  -- Compare the two infima directly in the lattice of measurable spaces.
  rw [tailMeasurableSpace_def]
  refine le_antisymm ?_ ?_
  · -- Each finite stage `J n` already appears among the defining tail terms.
    refine le_iInf fun n ↦ ?_
    exact iInf_le_of_le ⟨J n, hJ_finite n⟩ le_rfl
  · -- Conversely, every finite tail term is dominated by some exhaustion stage.
    refine le_iInf fun s ↦ ?_
    exact iInf_exhaustion_le_tail_term_of_finite 𝒜 s.2 hJ_mono hJ_iUnion

-- Proof sketch: apply the general exhaustion theorem to the increasing finite sets
-- `J n = Set.Iio n`, whose complements are `Set.Ici n`.
/-- For a sequence indexed by `ℕ`, the tail `σ`-algebra is the intersection of the `σ`-algebras
generated by the tails `\{n, n + 1, n + 2, \ldots\}`. -/
theorem tailMeasurableSpace_nat_eq_iInf_iSup_Ici (𝒜 : ℕ → MeasurableSpace Ω) :
    tailMeasurableSpace 𝒜 = ⨅ n : ℕ, ⨆ i ∈ Set.Ici n, 𝒜 i := by
  -- Instantiate the general theorem with the canonical finite exhaustion `J n = Iio n`.
  simpa [Set.compl_Iio] using
    tailMeasurableSpace_eq_iInf_of_monotone_exhaustion 𝒜 Set.Iio Set.finite_Iio
      monotone_Iio Set.iUnion_Iio
