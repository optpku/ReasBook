import Mathlib

-- Declarations for this item will be appended below by the statement pipeline.

open MeasureTheory ProbabilityTheory
open scoped BigOperators

universe u

variable {Ω : Type u} [MeasurableSpace Ω]

/-- Definition 3.9: A process `Z` is a Galton--Watson process, or branching process, with
offspring distribution `p` if it is generated by an independent identically distributed offspring
array with common law `p`, starting from one ancestor. -/
def IsGaltonWatsonProcess (Z : ℕ → Ω → ℕ) (μ : Measure Ω) (p : PMF ℕ) : Prop :=
  ∃ offspring : ℕ → ℕ → Ω → ℕ,
    (∀ ω, Z 0 ω = 1) ∧
    (∀ n ω, Z (n + 1) ω = Finset.sum (Finset.range (Z n ω)) (fun i ↦ offspring n i ω)) ∧
    iIndepFun (fun ij : ℕ × ℕ ↦ offspring ij.1 ij.2) μ ∧
    ∀ n i, HasLaw (offspring n i) p.toMeasure μ

namespace IsGaltonWatsonProcess

variable {Z : ℕ → Ω → ℕ} {μ : Measure Ω} {p : PMF ℕ}

/-- Any Galton--Watson process starts with a single ancestor. -/
theorem initial (hZ : IsGaltonWatsonProcess Z μ p) : ∀ ω, Z 0 ω = 1 := by
  rcases hZ with ⟨_, hinitial, _, _, _⟩
  exact hinitial

/-- A Galton--Watson process satisfies the defining branching recursion for some offspring array
with common law `p`. -/
theorem exists_offspring (hZ : IsGaltonWatsonProcess Z μ p) :
    ∃ offspring : ℕ → ℕ → Ω → ℕ,
      (∀ n ω, Z (n + 1) ω = Finset.sum (Finset.range (Z n ω)) (fun i ↦ offspring n i ω)) ∧
      iIndepFun (fun ij : ℕ × ℕ ↦ offspring ij.1 ij.2) μ ∧
      ∀ n i, HasLaw (offspring n i) p.toMeasure μ := by
  rcases hZ with ⟨offspring, _, hrecursion, hoffspring_indep, hoffspring_hasLaw⟩
  exact ⟨offspring, hrecursion, hoffspring_indep, hoffspring_hasLaw⟩

end IsGaltonWatsonProcess
