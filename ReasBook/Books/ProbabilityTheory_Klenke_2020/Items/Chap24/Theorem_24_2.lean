import Books.ProbabilityTheory_Klenke_2020.Items.Chap24.Definition_24_1
import Mathlib.MeasureTheory.Measure.LevyProkhorovMetric
import Mathlib.MeasureTheory.Measure.Prokhorov

universe u

open MeasureTheory
open scoped CompactlySupported ENNReal Topology

variable {E : Type u} [PseudoMetricSpace E] [MeasurableSpace E]

namespace BoundedlyFiniteMeasure

/-- Integration against a compactly supported continuous real-valued test function. -/
noncomputable def vagueIntegral (f : C_c(E, ℝ)) : BoundedlyFiniteMeasure E → ℝ :=
  fun μ ↦ ∫ x, f x ∂(μ : Measure E)

/-- Integration against a compactly supported continuous nonnegative test function, viewed in
`ℝ`. -/
noncomputable def nonnegativeVagueIntegral (f : C_c(E, NNReal)) : BoundedlyFiniteMeasure E → ℝ :=
  fun μ ↦ ∫ x, (f x : ℝ) ∂(μ : Measure E)

@[simp] theorem vagueIntegral_apply (f : C_c(E, ℝ)) (μ : BoundedlyFiniteMeasure E) :
    vagueIntegral f μ = ∫ x, f x ∂(μ : Measure E) :=
  rfl

@[simp] theorem nonnegativeVagueIntegral_apply (f : C_c(E, NNReal))
    (μ : BoundedlyFiniteMeasure E) :
    nonnegativeVagueIntegral f μ = ∫ x, (f x : ℝ) ∂(μ : Measure E) :=
  rfl

/-- The vague topology on boundedly finite measures is the initial topology generated by
compactly supported continuous real-valued test integrals. -/
@[reducible] noncomputable def vagueTopology (E : Type u) [PseudoMetricSpace E] [MeasurableSpace E] :
    TopologicalSpace (BoundedlyFiniteMeasure E) :=
  ⨅ f : C_c(E, ℝ),
    TopologicalSpace.induced (vagueIntegral f) inferInstance

noncomputable instance instTopologicalSpace : TopologicalSpace (BoundedlyFiniteMeasure E) :=
  vagueTopology E

end BoundedlyFiniteMeasure

variable {E : Type u} [PseudoMetricSpace E] [MeasurableSpace E] [BorelSpace E]
  [LocallyCompactSpace E]

/-- The sigma-algebra generated by the vague integral maps `μ ↦ ∫ f dμ` for all compactly
supported continuous real-valued test functions `f : C_c(E, ℝ)`. -/
noncomputable abbrev compactlySupportedContinuousIntegralMeasurableSpace (E : Type u)
    [PseudoMetricSpace E] [MeasurableSpace E] [BorelSpace E] [LocallyCompactSpace E] :
    MeasurableSpace (BoundedlyFiniteMeasure E) :=
  ⨆ f : C_c(E, ℝ),
    MeasurableSpace.comap (BoundedlyFiniteMeasure.vagueIntegral f) (borel ℝ)

/-- The sigma-algebra generated by the vague integral maps `μ ↦ ∫ f dμ` for all nonnegative
compactly supported continuous test functions `f : C_c(E, NNReal)`. -/
noncomputable abbrev nonnegativeCompactlySupportedContinuousIntegralMeasurableSpace (E : Type u)
    [PseudoMetricSpace E] [MeasurableSpace E] [BorelSpace E] [LocallyCompactSpace E] :
    MeasurableSpace (BoundedlyFiniteMeasure E) :=
  ⨆ f : C_c(E, NNReal),
    MeasurableSpace.comap (BoundedlyFiniteMeasure.nonnegativeVagueIntegral f) (borel ℝ)

/-- Helper for Theorem 24.2: the full vague-evaluation map realizes the vague topology as the
induced product topology on all compactly supported continuous real-valued test integrals. -/
theorem vagueTopology_eq_inducedPi :
    (inferInstance : TopologicalSpace (BoundedlyFiniteMeasure E)) =
      TopologicalSpace.induced
        (fun μ : BoundedlyFiniteMeasure E ↦
          fun f : C_c(E, ℝ) ↦ BoundedlyFiniteMeasure.vagueIntegral f μ)
        inferInstance := by
  -- Proof comment: the product topology is the infimum of the coordinate induced topologies.
  rw [BoundedlyFiniteMeasure.instTopologicalSpace, BoundedlyFiniteMeasure.vagueTopology]
  simpa using
    (induced_to_pi
      (fun μ : BoundedlyFiniteMeasure E ↦
        fun f : C_c(E, ℝ) ↦ BoundedlyFiniteMeasure.vagueIntegral f μ)).symm

/-- Helper for Theorem 24.2: the sigma-algebra generated by the real-valued vague integral
coordinates is the comap of the product measurable space along the full coordinate map. -/
theorem compactlySupportedContinuousIntegralMeasurableSpace_eq_comap_vagueIntegralFamily :
    compactlySupportedContinuousIntegralMeasurableSpace E =
      MeasurableSpace.comap
        (fun μ : BoundedlyFiniteMeasure E ↦
          fun f : C_c(E, ℝ) ↦ BoundedlyFiniteMeasure.vagueIntegral f μ)
        (inferInstance : MeasurableSpace (∀ f : C_c(E, ℝ), ℝ)) := by
  -- Proof comment: the product measurable space is the supremum of the coordinate comaps, and
  -- each projection recovers the original vague integral coordinate.
  rw [compactlySupportedContinuousIntegralMeasurableSpace, MeasurableSpace.pi,
    MeasurableSpace.comap_iSup]
  refine iSup_congr fun f => ?_
  rw [MeasurableSpace.comap_comp]
  change MeasurableSpace.comap (BoundedlyFiniteMeasure.vagueIntegral f) (borel ℝ) =
    MeasurableSpace.comap
      (fun μ : BoundedlyFiniteMeasure E ↦ BoundedlyFiniteMeasure.vagueIntegral f μ)
      Real.measurableSpace
  rfl

/-- Helper for Theorem 24.2: every compactly supported continuous real-valued test function is
integrable against a boundedly finite measure. -/
theorem integrable_vagueTest (μ : BoundedlyFiniteMeasure E) (f : C_c(E, ℝ)) :
    Integrable f (μ : Measure E) := by
  -- Proof comment: Definition 24.1 already proves integrability from measurability, bounded
  -- range, and compact support, and a `C_c` function has exactly those properties.
  exact
    integrable_of_measurable_isBounded_range_hasCompactSupport
      μ f.continuous.measurable f.toBoundedContinuousFunction.isBounded_range f.hasCompactSupport

/-- Helper for Theorem 24.2: nonnegative vague integrals are ordinary vague integrals of the
real-valued coercion `f.toReal`. -/
theorem nonnegativeVagueIntegral_eq_vagueIntegral_toReal (f : C_c(E, NNReal)) :
    BoundedlyFiniteMeasure.nonnegativeVagueIntegral f =
      BoundedlyFiniteMeasure.vagueIntegral f.toReal := by
  -- Proof comment: both sides are the same integral once `f` is viewed as `ℝ`-valued.
  funext μ
  simp [BoundedlyFiniteMeasure.vagueIntegral, BoundedlyFiniteMeasure.nonnegativeVagueIntegral]

/-- Helper for Theorem 24.2: each real-valued vague integral coordinate is continuous for the
vague topology. -/
theorem continuous_vagueIntegral (f : C_c(E, ℝ)) :
    Continuous (BoundedlyFiniteMeasure.vagueIntegral f : BoundedlyFiniteMeasure E → ℝ) := by
  -- Proof comment: the vague topology is an infimum of induced coordinate topologies, so each
  -- coordinate map is continuous by construction.
  rw [BoundedlyFiniteMeasure.instTopologicalSpace, BoundedlyFiniteMeasure.vagueTopology]
  exact continuous_iInf_dom continuous_induced_dom

/-- Helper for Theorem 24.2: the sigma-algebra generated by real-valued vague integrals is
contained in the Borel sigma-algebra of the vague topology. -/
theorem compactlySupportedContinuousIntegralMeasurableSpace_le_borel :
    compactlySupportedContinuousIntegralMeasurableSpace E ≤
      borel (BoundedlyFiniteMeasure E) := by
  refine iSup_le ?_
  intro f
  -- Proof comment: each generator is Borel measurable because its coordinate map is continuous.
  exact (continuous_vagueIntegral f).borel_measurable.comap_le

/-- Helper for Theorem 24.2: restricting a boundedly finite measure to the compact support of a
nonnegative test function is measurable for the random-measure sigma-algebra `𝕄`. -/
theorem measurable_restrict_tsupport (f : C_c(E, NNReal)) :
    Measurable fun μ : BoundedlyFiniteMeasure E ↦ (μ : Measure E).restrict (tsupport f) := by
  -- Proof comment: restricted evaluations are evaluations of `μ` on bounded measurable
  -- intersections with the compact support of `f`.
  refine Measure.measurable_of_measurable_coe _ ?_
  intro s hs
  have htsupport_meas : MeasurableSet (tsupport f) := (isClosed_tsupport f).measurableSet
  have hinter_meas : MeasurableSet (s ∩ tsupport f) := hs.inter htsupport_meas
  have htsupport_compact : IsCompact (tsupport f) := f.hasCompactSupport.isCompact
  have htsupport_bdd : Bornology.IsBounded (tsupport f) := by
    exact htsupport_compact.isBounded
  have hinter_bdd : Bornology.IsBounded (s ∩ tsupport f) := by
    exact htsupport_bdd.subset Set.inter_subset_right
  simpa [Measure.restrict_apply hs, Set.inter_comm, Set.inter_left_comm, Set.inter_assoc] using
    (measurable_apply_of_isBounded (s ∩ tsupport f) hinter_meas hinter_bdd)

/-- Helper for Theorem 24.2: each nonnegative vague integral coordinate is measurable for the
random-measure sigma-algebra `𝕄`. -/
theorem measurable_nonnegativeVagueIntegral (f : C_c(E, NNReal)) :
    Measurable (BoundedlyFiniteMeasure.nonnegativeVagueIntegral f) := by
  -- Proof comment: rewrite the integral through the measurable restricted-measure map and the
  -- measurable `ℝ≥0∞`-valued `lintegral`.
  have hf_meas : Measurable fun x : E ↦ (f x : ENNReal) := by
    exact measurable_coe_nnreal_ennreal.comp f.continuous.measurable
  have hlintegral :
      Measurable fun μ : Measure E ↦ ∫⁻ x, (f x : ENNReal) ∂μ :=
    Measure.measurable_lintegral hf_meas
  have hlintegral_restrict := hlintegral.comp (measurable_restrict_tsupport f)
  have hrepr :
      BoundedlyFiniteMeasure.nonnegativeVagueIntegral f =
        fun μ : BoundedlyFiniteMeasure E ↦
          (∫⁻ x, (f x : ENNReal) ∂((μ : Measure E).restrict (tsupport f))).toReal := by
    funext μ
    have hsupport :
        Function.support (fun x : E ↦ (f x : ENNReal)) ⊆ tsupport f := by
      intro x hx
      have hx' : f x ≠ 0 := by
        simpa using hx
      exact subset_tsupport f hx'
    have hrestrict :
        ∫⁻ x, (f x : ENNReal) ∂((μ : Measure E).restrict (tsupport f)) =
          ∫⁻ x, (f x : ENNReal) ∂(μ : Measure E) := by
      simpa using
        (setLIntegral_eq_of_support_subset hsupport :
          ∫⁻ x in tsupport f, (f x : ENNReal) ∂(μ : Measure E) =
            ∫⁻ x, (f x : ENNReal) ∂(μ : Measure E))
    have hnonneg_toReal_point : ∀ x : E, 0 ≤ f.toReal x := by
      intro x
      simpa using NNReal.coe_nonneg (f x)
    have hnonneg_real_point : ∀ x : E, 0 ≤ (f x : ℝ) := by
      intro x
      exact NNReal.coe_nonneg (f x)
    have hnonneg : 0 ≤ᵐ[(μ : Measure E)] f.toReal := by
      exact Filter.Eventually.of_forall hnonneg_toReal_point
    have hofReal :
        ENNReal.ofReal (BoundedlyFiniteMeasure.nonnegativeVagueIntegral f μ) =
          ∫⁻ x, (f x : ENNReal) ∂(μ : Measure E) := by
      simpa [BoundedlyFiniteMeasure.nonnegativeVagueIntegral_apply] using
        (ofReal_integral_eq_lintegral_ofReal (integrable_vagueTest μ f.toReal) hnonneg)
    have hintegral_nonneg : 0 ≤ BoundedlyFiniteMeasure.nonnegativeVagueIntegral f μ := by
      rw [BoundedlyFiniteMeasure.nonnegativeVagueIntegral_apply]
      exact integral_nonneg hnonneg_real_point
    have htoReal :
        BoundedlyFiniteMeasure.nonnegativeVagueIntegral f μ =
          (∫⁻ x, (f x : ENNReal) ∂(μ : Measure E)).toReal := by
      calc
        BoundedlyFiniteMeasure.nonnegativeVagueIntegral f μ =
            (ENNReal.ofReal (BoundedlyFiniteMeasure.nonnegativeVagueIntegral f μ)).toReal := by
              rw [ENNReal.toReal_ofReal hintegral_nonneg]
        _ = (∫⁻ x, (f x : ENNReal) ∂(μ : Measure E)).toReal := by
              exact congrArg ENNReal.toReal hofReal
    rw [hrestrict]
    exact htoReal
  rw [hrepr]
  exact hlintegral_restrict.ennreal_toReal

/-- Helper for Theorem 24.2: the sigma-algebra generated by nonnegative vague integrals is
contained in the random-measure sigma-algebra `𝕄`. -/
theorem nonnegativeCompactlySupportedContinuousIntegralMeasurableSpace_le_randomMeasure :
    nonnegativeCompactlySupportedContinuousIntegralMeasurableSpace E ≤
      randomMeasureMeasurableSpace E := by
  refine iSup_le ?_
  intro f
  -- Proof comment: each generator is measurable after restricting to the bounded support of `f`.
  exact (measurable_nonnegativeVagueIntegral f).comap_le

/-- Helper for Theorem 24.2: every compact set admits a nonnegative compactly supported continuous
cutoff that is identically `1` on that set and bounded above by `1`. -/
theorem existsCompactlySupportedNonnegative_eqOneOnCompact [T2Space E] {K : Set E}
    (hK : IsCompact K) :
    ∃ g : C_c(E, NNReal), Set.EqOn g 1 K ∧ ∀ x, g x ≤ 1 := by
  rcases exists_continuousMap_one_of_isCompact_subset_isOpen hK isOpen_univ
      (by intro x hx; simp) with
    ⟨g, hgK, hgsupp, -, hgIcc⟩
  refine ⟨(⟨g, hgsupp⟩ : C_c(E, ℝ)).nnrealPart, ?_, ?_⟩
  · intro x hx
    simp [CompactlySupportedContinuousMap.nnrealPart_apply, hgK hx]
  · intro x
    exact Real.toNNReal_le_iff_le_coe.2 (hgIcc x).2

/-- Helper for Theorem 24.2: a nonnegative vague integral is the `toReal` of the corresponding
`ℝ≥0∞`-valued `lintegral`. -/
theorem nonnegativeVagueIntegral_eq_toReal_lintegral (f : C_c(E, NNReal))
    (μ : BoundedlyFiniteMeasure E) :
    BoundedlyFiniteMeasure.nonnegativeVagueIntegral f μ =
      (∫⁻ x, (f x : ENNReal) ∂(μ : Measure E)).toReal := by
  have hnonneg : 0 ≤ᵐ[(μ : Measure E)] f.toReal := by
    exact Filter.Eventually.of_forall fun x ↦ by simpa using NNReal.coe_nonneg (f x)
  have hofReal :
      ENNReal.ofReal (BoundedlyFiniteMeasure.nonnegativeVagueIntegral f μ) =
        ∫⁻ x, (f x : ENNReal) ∂(μ : Measure E) := by
    simpa [BoundedlyFiniteMeasure.nonnegativeVagueIntegral_apply] using
      (ofReal_integral_eq_lintegral_ofReal (integrable_vagueTest μ f.toReal) hnonneg)
  have hintegral_nonneg : 0 ≤ BoundedlyFiniteMeasure.nonnegativeVagueIntegral f μ := by
    rw [BoundedlyFiniteMeasure.nonnegativeVagueIntegral_apply]
    exact integral_nonneg fun x ↦ NNReal.coe_nonneg (f x)
  calc
    BoundedlyFiniteMeasure.nonnegativeVagueIntegral f μ =
        (ENNReal.ofReal (BoundedlyFiniteMeasure.nonnegativeVagueIntegral f μ)).toReal := by
          rw [ENNReal.toReal_ofReal hintegral_nonneg]
    _ = (∫⁻ x, (f x : ENNReal) ∂(μ : Measure E)).toReal := by
          exact congrArg ENNReal.toReal hofReal

/-- Helper for Theorem 24.2: multiplying the closed-set approximants by a compact cutoff keeps
the sequence inside `C_c(E, ℝ≥0)` and still recovers the compact evaluation in the limit. -/
theorem tendsto_nonnegativeVagueIntegral_cutoffApprSeq [T2Space E] {K : Set E}
    (hK : IsCompact K) {g : C_c(E, NNReal)} (hgK : Set.EqOn g 1 K) (hg_le : ∀ x, g x ≤ 1)
    (μ : BoundedlyFiniteMeasure E) :
    Filter.Tendsto
      (fun n ↦
        ENNReal.ofNNReal
          ((BoundedlyFiniteMeasure.nonnegativeVagueIntegral (hK.isClosed.apprSeq n • g) μ).toNNReal))
      Filter.atTop (𝓝 ((μ : Measure E) K)) := by
  let ν : Measure E := (μ : Measure E).restrict (tsupport g)
  let φ : ℕ → C_c(E, NNReal) := fun n ↦ hK.isClosed.apprSeq n • g
  have hK_subset_tsupport : K ⊆ tsupport g := by
    intro x hx
    refine subset_tsupport g ?_
    simpa [hgK hx] using (show (1 : NNReal) ≠ 0 by simp)
  have hν_finite : IsFiniteMeasure ν := by
    refine ⟨?_⟩
    simpa [ν, Measure.restrict_apply (isClosed_tsupport g).measurableSet] using
      μ.lt_top_of_isBounded (isClosed_tsupport g).measurableSet g.hasCompactSupport.isCompact.isBounded
  have hνK : ν K = (μ : Measure E) K := by
    simpa [ν, Set.inter_eq_left.mpr hK_subset_tsupport] using
      (Measure.restrict_apply (μ := (μ : Measure E)) (s := tsupport g) hK.measurableSet)
  have hupper_tend :
      Filter.Tendsto (fun n ↦ ∫⁻ x, hK.isClosed.apprSeq n x ∂ν) Filter.atTop
        (𝓝 ((μ : Measure E) K)) := by
    letI : IsFiniteMeasure ν := hν_finite
    simpa [hνK] using
      (HasOuterApproxClosed.tendsto_lintegral_apprSeq (hF := hK.isClosed) ν)
  have hterm :
      ∀ n,
        ENNReal.ofNNReal
            ((BoundedlyFiniteMeasure.nonnegativeVagueIntegral (φ n) μ).toNNReal) =
          ∫⁻ x, ((φ n x : NNReal) : ENNReal) ∂ν := by
    intro n
    have hsupport :
        Function.support (fun x : E ↦ ((φ n x : NNReal) : ENNReal)) ⊆ tsupport g := by
      intro x hx
      exact
        (tsupport_smul_subset_right (hK.isClosed.apprSeq n) g)
          (subset_tsupport (fun y : E ↦ hK.isClosed.apprSeq n y • g y) (by simpa [φ] using hx))
    have hlt_top :
        ∫⁻ x, ((φ n x : NNReal) : ENNReal) ∂ν < ∞ := by
      letI : IsFiniteMeasure ν := hν_finite
      simpa [φ] using ((φ n).toBoundedContinuousFunction.lintegral_lt_top_of_nnreal ν)
    have hrestrict :
        ∫⁻ x, ((φ n x : NNReal) : ENNReal) ∂(μ : Measure E) =
          ∫⁻ x, ((φ n x : NNReal) : ENNReal) ∂ν := by
      simpa [ν] using
        (setLIntegral_eq_of_support_subset
          (μ := (μ : Measure E)) (s := tsupport g)
          (f := fun x : E ↦ ((φ n x : NNReal) : ENNReal)) hsupport).symm
    -- Proof comment: rewrite the cutoff integral on the finite restricted measure carried by
    -- `tsupport g`, then convert the real-valued vague integral back to the corresponding
    -- `ℝ≥0∞`-valued `lintegral`.
    rw [nonnegativeVagueIntegral_eq_toReal_lintegral, hrestrict, ENNReal.ofNNReal_toNNReal,
      ENNReal.ofReal_toReal hlt_top.ne]
  have hlower :
      ∀ n,
        (μ : Measure E) K ≤
          ENNReal.ofNNReal
            ((BoundedlyFiniteMeasure.nonnegativeVagueIntegral (φ n) μ).toNNReal) := by
    intro n
    rw [hterm n]
    have hpoint :
        Set.indicator K (fun _ : E ↦ (1 : ENNReal)) ≤
          fun x : E ↦ ((φ n x : NNReal) : ENNReal) := by
      intro x
      by_cases hx : x ∈ K
      · have hone : ((φ n x : NNReal) : ENNReal) = 1 := by
          simp [φ, smul_eq_mul,
            HasOuterApproxClosed.apprSeq_apply_eq_one (hF := hK.isClosed) n hx, hgK hx]
        simpa [Set.indicator_of_mem hx] using le_of_eq hone.symm
      · rw [Set.indicator_of_notMem hx]
        exact zero_le _
    calc
      (μ : Measure E) K = ν K := hνK.symm
      _ = ∫⁻ x, Set.indicator K (fun _ : E ↦ (1 : ENNReal)) x ∂ν := by
            rw [lintegral_indicator hK.measurableSet]
            simp
      _ ≤ ∫⁻ x, ((φ n x : NNReal) : ENNReal) ∂ν := lintegral_mono hpoint
  have hupper :
      ∀ n,
        ENNReal.ofNNReal
          ((BoundedlyFiniteMeasure.nonnegativeVagueIntegral (φ n) μ).toNNReal) ≤
            ∫⁻ x, hK.isClosed.apprSeq n x ∂ν := by
    intro n
    rw [hterm n]
    refine lintegral_mono ?_
    intro x
    have hmul :
        (((hK.isClosed.apprSeq n x : NNReal) * g x : NNReal) : ENNReal) ≤
          ((hK.isClosed.apprSeq n x : NNReal) : ENNReal) := by
      exact_mod_cast
        (show ((hK.isClosed.apprSeq n x : NNReal) * g x : NNReal) ≤ hK.isClosed.apprSeq n x by
          simpa using mul_le_mul_left' (hg_le x) (hK.isClosed.apprSeq n x))
    simpa [φ, smul_eq_mul] using hmul
  -- Proof comment: the cutoff integrals equal the compact evaluation on `K` from below and are
  -- squeezed from above by the restricted approximating integrals, whose limit is already known.
  refine tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds hupper_tend hlower hupper

/-- Helper for Theorem 24.2: evaluation on a compact set is measurable for the sigma-algebra
generated by nonnegative vague integrals. -/
theorem measurable_compact_apply_nonnegative [T2Space E] {K : Set E} (hK : IsCompact K) :
    @Measurable (BoundedlyFiniteMeasure E) ENNReal
      (nonnegativeCompactlySupportedContinuousIntegralMeasurableSpace E) (borel ENNReal)
      (fun μ ↦ (μ : Measure E) K) := by
  rcases existsCompactlySupportedNonnegative_eqOneOnCompact hK with ⟨g, hgK, hg_le⟩
  let fn : ℕ → BoundedlyFiniteMeasure E → ENNReal := fun n μ ↦
    ENNReal.ofNNReal
      ((BoundedlyFiniteMeasure.nonnegativeVagueIntegral (hK.isClosed.apprSeq n • g) μ).toNNReal)
  have hfn_meas :
      ∀ n,
        @Measurable (BoundedlyFiniteMeasure E) ENNReal
          (nonnegativeCompactlySupportedContinuousIntegralMeasurableSpace E) (borel ENNReal) (fn n) := by
    intro n
    have hcoord :
        @Measurable (BoundedlyFiniteMeasure E) ℝ
          (nonnegativeCompactlySupportedContinuousIntegralMeasurableSpace E) (borel ℝ)
          (BoundedlyFiniteMeasure.nonnegativeVagueIntegral (hK.isClosed.apprSeq n • g)) := by
      exact Measurable.of_comap_le <| le_iSup_of_le (hK.isClosed.apprSeq n • g) le_rfl
    change
      @Measurable (BoundedlyFiniteMeasure E) ENNReal
        (nonnegativeCompactlySupportedContinuousIntegralMeasurableSpace E) (borel ENNReal)
        (fun μ : BoundedlyFiniteMeasure E ↦
          ENNReal.ofNNReal
            ((BoundedlyFiniteMeasure.nonnegativeVagueIntegral (hK.isClosed.apprSeq n • g) μ).toNNReal))
    exact measurable_coe_nnreal_ennreal.comp hcoord.real_toNNReal
  have hfn_lim :
      Filter.Tendsto fn Filter.atTop (𝓝 (fun μ : BoundedlyFiniteMeasure E ↦ (μ : Measure E) K)) := by
    rw [tendsto_pi_nhds]
    intro μ
    simpa [fn] using tendsto_nonnegativeVagueIntegral_cutoffApprSeq hK hgK hg_le μ
  exact ENNReal.measurable_of_tendsto hfn_meas hfn_lim

/-- Helper for Theorem 24.2: restricting a boundedly finite measure to a compact set is
measurable for the sigma-algebra generated by nonnegative vague integrals. -/
theorem measurableRestrictCompact [T2Space E] {K : Set E} (hK : IsCompact K) :
    @Measurable (BoundedlyFiniteMeasure E) (Measure E)
      (nonnegativeCompactlySupportedContinuousIntegralMeasurableSpace E)
      (inferInstance : MeasurableSpace (Measure E))
      (fun μ ↦ (μ : Measure E).restrict K) := by
  -- Proof comment: closed-set evaluations of the restricted measure reduce to compact
  -- evaluations of the original measure on intersections `s ∩ K`.
  letI : ∀ μ : BoundedlyFiniteMeasure E, IsFiniteMeasure ((μ : Measure E).restrict K) := fun μ ↦ by
    refine ⟨?_⟩
    simpa [Measure.restrict_apply hK.measurableSet] using (μ.2 hK.measurableSet hK.isBounded)
  have hgen :
      (inferInstance : MeasurableSpace E) = MeasurableSpace.generateFrom {s : Set E | IsClosed s} := by
    rw [BorelSpace.measurable_eq (α := E), borel_eq_generateFrom_isClosed]
  have hbasic :
      ∀ s ∈ ({s : Set E | IsClosed s} : Set (Set E)),
        @Measurable (BoundedlyFiniteMeasure E) ENNReal
          (nonnegativeCompactlySupportedContinuousIntegralMeasurableSpace E) (borel ENNReal)
          (fun μ : BoundedlyFiniteMeasure E ↦ ((μ : Measure E).restrict K) s) := by
    intro s hs
    have hsInterCompact : IsCompact (s ∩ K) := by
      simpa [Set.inter_comm] using hK.inter_right hs
    have hsEval :
        @Measurable (BoundedlyFiniteMeasure E) ENNReal
          (nonnegativeCompactlySupportedContinuousIntegralMeasurableSpace E) (borel ENNReal)
          (fun μ : BoundedlyFiniteMeasure E ↦ (μ : Measure E) (s ∩ K)) :=
      measurable_compact_apply_nonnegative hsInterCompact
    simpa [Measure.restrict_apply hs.measurableSet] using hsEval
  have h_univ :
      @Measurable (BoundedlyFiniteMeasure E) ENNReal
        (nonnegativeCompactlySupportedContinuousIntegralMeasurableSpace E) (borel ENNReal)
        (fun μ : BoundedlyFiniteMeasure E ↦ ((μ : Measure E).restrict K) Set.univ) := by
    simpa [Measure.restrict_apply hK.measurableSet] using measurable_compact_apply_nonnegative hK
  exact Measurable.measure_of_isPiSystem
    (μ := fun μ : BoundedlyFiniteMeasure E ↦ (μ : Measure E).restrict K) hgen isPiSystem_isClosed
    hbasic h_univ

/-- Helper for Theorem 24.2: the random-measure sigma-algebra is contained in the sigma-algebra
generated by nonnegative compactly supported vague integrals. -/
theorem randomMeasureMeasurableSpace_le_nonnegativeCompactlySupportedContinuousIntegralMeasurableSpace
    [T2Space E] [PolishSpace E] :
    randomMeasureMeasurableSpace E ≤
      nonnegativeCompactlySupportedContinuousIntegralMeasurableSpace E := by
  let K : CompactExhaustion E := CompactExhaustion.choice E
  rw [randomMeasureMeasurableSpace_def]
  refine iSup_le ?_
  intro A
  refine iSup_le ?_
  intro hA
  refine iSup_le ?_
  intro _hA_bdd
  have hrestrict_eval :
      ∀ n,
        @Measurable (BoundedlyFiniteMeasure E) ENNReal
          (nonnegativeCompactlySupportedContinuousIntegralMeasurableSpace E) (borel ENNReal)
          (fun μ : BoundedlyFiniteMeasure E ↦ ((μ : Measure E).restrict (K n)) A) := by
    intro n
    exact (Measure.measurable_coe hA).comp (measurableRestrictCompact (K.isCompact n))
  have h_eval_eq :
      (fun μ : BoundedlyFiniteMeasure E ↦ (μ : Measure E) A) =
        (fun μ : BoundedlyFiniteMeasure E ↦ ⨆ n, ((μ : Measure E).restrict (K n)) A) := by
    funext μ
    have hmono : Monotone fun n : ℕ ↦ A ∩ K n := fun m n hmn x hx ↦ ⟨hx.1, K.subset hmn hx.2⟩
    have hUnion : ⋃ n, A ∩ K n = A := by
      ext x
      constructor
      · intro hxU
        rcases Set.mem_iUnion.1 hxU with ⟨n, hx⟩
        exact hx.1
      · intro hxA
        rcases K.exists_mem x with ⟨n, hxK⟩
        exact Set.mem_iUnion.2 ⟨n, ⟨hxA, hxK⟩⟩
    calc
      (μ : Measure E) A = (μ : Measure E) (⋃ n, A ∩ K n) := by
        exact congrArg ((μ : Measure E) ·) hUnion.symm
      _ = ⨆ n, (μ : Measure E) (A ∩ K n) := by exact hmono.measure_iUnion
      _ = ⨆ n, ((μ : Measure E).restrict (K n)) A := by
            congr with n
            rw [Measure.restrict_apply hA]
  have h_eval_meas :
      @Measurable (BoundedlyFiniteMeasure E) ENNReal
        (nonnegativeCompactlySupportedContinuousIntegralMeasurableSpace E) (borel ENNReal)
        (fun μ : BoundedlyFiniteMeasure E ↦ ⨆ n, ((μ : Measure E).restrict (K n)) A) :=
    Measurable.iSup hrestrict_eval
  -- Proof comment: every bounded Borel evaluation is the supremum of its compact restrictions
  -- along a compact exhaustion, so it is measurable in the nonnegative vague sigma-algebra.
  have h_eval_meas' :
      @Measurable (BoundedlyFiniteMeasure E) ENNReal
        (nonnegativeCompactlySupportedContinuousIntegralMeasurableSpace E) (borel ENNReal)
        (fun μ : BoundedlyFiniteMeasure E ↦ (μ : Measure E) A) := by
    simpa [h_eval_eq] using h_eval_meas
  exact h_eval_meas'.comap_le

/-- Helper for Theorem 24.2: every nonnegative vague integral coordinate is already one of the
real-valued vague integral coordinates after composing with `toReal`. -/
theorem
    nonnegativeCompactlySupportedContinuousIntegralMeasurableSpace_le_compactlySupportedContinuousIntegralMeasurableSpace :
    nonnegativeCompactlySupportedContinuousIntegralMeasurableSpace E ≤
      compactlySupportedContinuousIntegralMeasurableSpace E := by
  refine iSup_le ?_
  intro f
  have hreal :
      @Measurable (BoundedlyFiniteMeasure E) ℝ
        (compactlySupportedContinuousIntegralMeasurableSpace E) (borel ℝ)
        (fun μ : BoundedlyFiniteMeasure E ↦
          BoundedlyFiniteMeasure.vagueIntegral f.toReal μ) := by
    -- Proof comment: the real-valued generator for `f.toReal` is one of the defining coordinates
    -- of `compactlySupportedContinuousIntegralMeasurableSpace`.
    exact Measurable.of_comap_le <| le_iSup_of_le f.toReal le_rfl
  have hnonnegative :
      @Measurable (BoundedlyFiniteMeasure E) ℝ
        (compactlySupportedContinuousIntegralMeasurableSpace E) (borel ℝ)
        (fun μ : BoundedlyFiniteMeasure E ↦
          BoundedlyFiniteMeasure.nonnegativeVagueIntegral f μ) := by
    -- Proof comment: rewrite the nonnegative coordinate as the real-valued coordinate of `f.toReal`.
    simpa [nonnegativeVagueIntegral_eq_vagueIntegral_toReal] using hreal
  exact hnonnegative.comap_le

/-- Helper for Theorem 24.2: once the random-measure sigma-algebra is identified with the
nonnegative vague sigma-algebra, it is automatically contained in the real-valued vague
sigma-algebra. -/
theorem randomMeasureMeasurableSpace_le_compactlySupportedContinuousIntegralMeasurableSpace
    [T2Space E] [PolishSpace E] :
    randomMeasureMeasurableSpace E ≤
      compactlySupportedContinuousIntegralMeasurableSpace E := by
  -- Proof comment: chain the already proved compact-exhaustion comparison with the `toReal`
  -- reduction from nonnegative to real-valued vague coordinates.
  exact
    (randomMeasureMeasurableSpace_le_nonnegativeCompactlySupportedContinuousIntegralMeasurableSpace
      (E := E)).trans
      nonnegativeCompactlySupportedContinuousIntegralMeasurableSpace_le_compactlySupportedContinuousIntegralMeasurableSpace

section FiniteMeasureMetrizable

open Topology

variable {E : Type u} [MetricSpace E] [MeasurableSpace E] [BorelSpace E]

local instance : MeasurableSpace (E ⊕ Unit) := borel (E ⊕ Unit)
local instance : BorelSpace (E ⊕ Unit) := ⟨rfl⟩

/-- Helper for Theorem 24.2: restrict a bounded continuous test on `E ⊕ Unit` to the
`Sum.inl` copy of `E`. -/
private def inlRestrictedTest (g : BoundedContinuousFunction (E ⊕ Unit) ℝ) :
    BoundedContinuousFunction E ℝ :=
  g.compContinuous ⟨Sum.inl, continuous_inl⟩

/-- Helper for Theorem 24.2: the cemetery extension of a bounded continuous test is uniformly
bounded on `E ⊕ Unit`. -/
private theorem cemeteryExtendedTest_bounded (f : BoundedContinuousFunction E ℝ) :
    ∃ C, ∀ x y : E ⊕ Unit,
      dist (Sum.elim f (fun _ : Unit ↦ 0) x) (Sum.elim f (fun _ : Unit ↦ 0) y) ≤ C := by
  refine ⟨2 * ‖f‖, ?_⟩
  intro x y
  rcases x with x | x <;> rcases y with y | y
  · simpa using f.dist_le_two_norm x y
  · have hxy : dist (f x) 0 ≤ 2 * ‖f‖ := by
      calc
        dist (f x) 0 = ‖f x‖ := by simp
        _ ≤ ‖f‖ := f.norm_coe_le_norm x
        _ ≤ 2 * ‖f‖ := by nlinarith [norm_nonneg f]
    simpa using hxy
  · have hyx : dist 0 (f y) ≤ 2 * ‖f‖ := by
      calc
        dist 0 (f y) = ‖f y‖ := by simp
        _ ≤ ‖f‖ := f.norm_coe_le_norm y
        _ ≤ 2 * ‖f‖ := by nlinarith [norm_nonneg f]
    simpa using hyx
  · simp

/-- Helper for Theorem 24.2: extend a bounded continuous test on `E` to `E ⊕ Unit` by sending
the cemetery point to `0`. -/
private noncomputable def cemeteryExtendedTest (f : BoundedContinuousFunction E ℝ) :
    BoundedContinuousFunction (E ⊕ Unit) ℝ :=
  let h : ∃ C, ∀ x y : E ⊕ Unit,
      dist (Sum.elim f (fun _ : Unit ↦ 0) x) (Sum.elim f (fun _ : Unit ↦ 0) y) ≤ C :=
    cemeteryExtendedTest_bounded f
  BoundedContinuousFunction.mkOfBound
    ⟨Sum.elim f (fun _ : Unit ↦ 0), Continuous.sumElim f.continuous continuous_const⟩
    (Classical.choose h) (Classical.choose_spec h)

/-- Helper for Theorem 24.2: the cemetery extension agrees with the original test on `E`. -/
@[simp] private theorem cemeteryExtendedTest_inl (f : BoundedContinuousFunction E ℝ) (x : E) :
    cemeteryExtendedTest f (Sum.inl x) = f x := by
  simp [cemeteryExtendedTest]

/-- Helper for Theorem 24.2: the cemetery extension vanishes at the added cemetery point. -/
@[simp] private theorem cemeteryExtendedTest_inr (f : BoundedContinuousFunction E ℝ) (u : Unit) :
    cemeteryExtendedTest f (Sum.inr u) = 0 := by
  simp [cemeteryExtendedTest]

/-- Helper for Theorem 24.2: restricting the cemetery extension back to `E` recovers the original
test. -/
@[simp] private theorem inlRestrictedTest_cemeteryExtendedTest
    (f : BoundedContinuousFunction E ℝ) :
    inlRestrictedTest (cemeteryExtendedTest f) = f := by
  ext x
  simp [inlRestrictedTest]

/-- Helper for Theorem 24.2: encode a finite measure as a probability measure on `E ⊕ Unit` by
adding a cemetery atom and renormalizing by `μ.mass + 1`. -/
private noncomputable def finiteMeasureCemeteryMeasure (μ : MeasureTheory.FiniteMeasure E) :
    Measure (E ⊕ Unit) :=
  ((ENNReal.ofNNReal (μ.mass + 1))⁻¹ • Measure.map Sum.inl (μ : Measure E)) +
    ((ENNReal.ofNNReal (μ.mass + 1))⁻¹ • Measure.dirac (Sum.inr ()))

/-- Helper for Theorem 24.2: `Sum.inl` is a measurable embedding for the local sum-space Borel
structure. -/
private theorem measurableEmbedding_sumInl : MeasurableEmbedding (Sum.inl : E → E ⊕ Unit) :=
  Topology.IsOpenEmbedding.inl.measurableEmbedding

/-- Helper for Theorem 24.2: the `Sum.inl` pushforward of a finite measure has the same total mass
as the original measure. -/
private theorem finiteMeasureCemeteryMapInl_univ (μ : MeasureTheory.FiniteMeasure E) :
    Measure.map (Sum.inl : E → E ⊕ Unit) (μ : Measure E) Set.univ = ENNReal.ofNNReal μ.mass := by
  -- Proof comment: evaluate the pushforward on `univ` by pulling `univ` back through `Sum.inl`.
  rw [MeasurableEmbedding.map_apply measurableEmbedding_sumInl (μ : Measure E) Set.univ]
  simp [FiniteMeasure.ennreal_mass]

/-- Helper for Theorem 24.2: bounded-continuous integrals transport across the cemetery inclusion
`Sum.inl`. -/
private theorem integral_map_sumInl_boundedContinuous
    (g : BoundedContinuousFunction (E ⊕ Unit) ℝ)
    (μ : MeasureTheory.FiniteMeasure E) :
    ∫ z, g z ∂(Measure.map (Sum.inl : E → E ⊕ Unit) (μ : Measure E)) =
      ∫ x, g (Sum.inl x) ∂((μ : Measure E)) := by
  -- Proof comment: this is the standard `integral_map` rewrite for the measurable inclusion.
  simpa using
    (MeasureTheory.integral_map measurableEmbedding_sumInl.measurable.aemeasurable
      (show AEStronglyMeasurable (fun z : E ⊕ Unit ↦ g z)
          (Measure.map (Sum.inl : E → E ⊕ Unit) (μ : Measure E)) from
        g.continuous.aestronglyMeasurable))

/-- Helper for Theorem 24.2: the cemetery encoding has total mass `1`. -/
private theorem finiteMeasureCemeteryMeasure_univ (μ : MeasureTheory.FiniteMeasure E) :
    finiteMeasureCemeteryMeasure μ Set.univ = 1 := by
  -- Proof comment: compute the two `univ` masses separately and cancel the normalization factor.
  let a : ℝ≥0∞ := ENNReal.ofNNReal (μ.mass + 1)
  have ha0 : a ≠ 0 := by
    simp [a]
  have haTop : a ≠ ∞ := by
    simp [a]
  rw [finiteMeasureCemeteryMeasure, Measure.add_apply, Measure.smul_apply, Measure.smul_apply,
    finiteMeasureCemeteryMapInl_univ]
  simp only [ENNReal.coe_add, FiniteMeasure.ennreal_mass, ENNReal.coe_one, smul_eq_mul,
    measure_univ, mul_one]
  have huniv : (μ : Measure E) Set.univ = ENNReal.ofNNReal μ.mass := by
    simp [FiniteMeasure.ennreal_mass]
  rw [huniv]
  have hsum : ENNReal.ofNNReal μ.mass + 1 = ENNReal.ofNNReal (μ.mass + 1) := by
    simp
  calc
    ((μ.mass : ℝ≥0∞) + 1)⁻¹ * (μ.mass : ℝ≥0∞) + ((μ.mass : ℝ≥0∞) + 1)⁻¹
        = ((μ.mass : ℝ≥0∞) + 1)⁻¹ * (μ.mass : ℝ≥0∞) + ((μ.mass : ℝ≥0∞) + 1)⁻¹ * 1 := by
          rw [mul_one (((μ.mass : ℝ≥0∞) + 1)⁻¹)]
    _ = ((μ.mass : ℝ≥0∞) + 1)⁻¹ * ((μ.mass : ℝ≥0∞) + 1) := by
          rw [← mul_add]
    _ = 1 := by
          rw [hsum, ENNReal.inv_mul_cancel ha0 haTop]

/-- Helper for Theorem 24.2: bundle the normalized cemetery measure as a probability measure. -/
private noncomputable def finiteMeasureCemeteryProbability (μ : MeasureTheory.FiniteMeasure E) :
    MeasureTheory.ProbabilityMeasure (E ⊕ Unit) :=
  ⟨finiteMeasureCemeteryMeasure μ,
    MeasureTheory.isProbabilityMeasure_iff.2 <| finiteMeasureCemeteryMeasure_univ μ⟩

/-- Helper for Theorem 24.2: the encoded probability integrates a bounded continuous test on
`E ⊕ Unit` as the normalized sum of the `E`-part integral and the cemetery-point value. -/
private theorem integral_finiteMeasureCemeteryProbability
    (g : BoundedContinuousFunction (E ⊕ Unit) ℝ)
    (μ : MeasureTheory.FiniteMeasure E) :
    ∫ z, g z ∂(finiteMeasureCemeteryProbability μ : Measure (E ⊕ Unit)) =
      (((μ.mass : ℝ) + 1)⁻¹) *
        (∫ x, inlRestrictedTest g x ∂((μ : Measure E)) + g (Sum.inr ())) := by
  -- Proof comment: expand the cemetery measure into the pushforward term and the cemetery atom.
  let a : ℝ≥0∞ := (ENNReal.ofNNReal (μ.mass + 1))⁻¹
  have ha :
      a.toReal = (((μ.mass : ℝ) + 1)⁻¹) := by
    have hunivToReal : (((μ : Measure E) Set.univ + 1).toReal) = ((μ.mass : ℝ) + 1) := by
      simpa [FiniteMeasure.ennreal_mass] using
        (ENNReal.toReal_add (measure_ne_top (μ : Measure E) Set.univ) ENNReal.one_ne_top)
    rw [show a = (((μ : Measure E) Set.univ + 1))⁻¹ by simp [a, FiniteMeasure.ennreal_mass],
      ENNReal.toReal_inv, hunivToReal]
  have haTop : a ≠ ∞ := by
    simp [a]
  have h_map0 :
      Integrable g (Measure.map (Sum.inl : E → E ⊕ Unit) (μ : Measure E)) := by
    simpa using g.integrable (Measure.map (Sum.inl : E → E ⊕ Unit) (μ : Measure E))
  have h_dirac0 :
      Integrable g (Measure.dirac (Sum.inr ())) := by
    simpa using g.integrable (Measure.dirac (Sum.inr ()))
  have h_map :
      Integrable g (a • Measure.map (Sum.inl : E → E ⊕ Unit) (μ : Measure E)) := by
    exact Integrable.of_measure_le_smul haTop (by intro s; simp [Measure.smul_apply]) h_map0
  have h_dirac :
      Integrable g (a • Measure.dirac (Sum.inr ())) := by
    exact Integrable.of_measure_le_smul haTop (by intro s; simp [Measure.smul_apply]) h_dirac0
  change
    ∫ z, g z ∂finiteMeasureCemeteryMeasure μ =
      (((μ.mass : ℝ) + 1)⁻¹) *
        (∫ x, inlRestrictedTest g x ∂((μ : Measure E)) + g (Sum.inr ()))
  rw [finiteMeasureCemeteryMeasure]
  rw [integral_add_measure h_map h_dirac, integral_smul_measure, integral_smul_measure,
    integral_map_sumInl_boundedContinuous, integral_dirac]
  rw [ha]
  have hinl :
      ∫ x, inlRestrictedTest g x ∂((μ : Measure E)) =
        ∫ x, g (Sum.inl x) ∂((μ : Measure E)) := by
    simp [inlRestrictedTest]
  rw [hinl]
  simpa [smul_eq_mul] using
    (mul_add (((μ.mass : ℝ) + 1)⁻¹) (∫ x, g (Sum.inl x) ∂((μ : Measure E))) (g (Sum.inr ()))).symm

/-- Helper for Theorem 24.2: bounded-continuous integrals against a finite measure can be
recovered from its cemetery encoding. -/
private theorem integral_eq_massAddOne_mul_cemeteryIntegral
    (f : BoundedContinuousFunction E ℝ)
    (μ : MeasureTheory.FiniteMeasure E) :
    ∫ x, f x ∂((μ : Measure E)) =
      (((μ.mass : ℝ) + 1)) *
        ∫ z, cemeteryExtendedTest f z
          ∂(finiteMeasureCemeteryProbability μ : Measure (E ⊕ Unit)) := by
  -- Proof comment: specialize the cemetery formula to the zero-at-cemetery extension of `f`.
  have hcem :
      ∫ z, cemeteryExtendedTest f z ∂(finiteMeasureCemeteryProbability μ : Measure (E ⊕ Unit)) =
        (((μ.mass : ℝ) + 1)⁻¹) * ∫ x, f x ∂((μ : Measure E)) := by
    simpa using
      (integral_finiteMeasureCemeteryProbability (cemeteryExtendedTest f) μ)
  have hmassPos : 0 < ((μ.mass : ℝ) + 1) := by
    positivity
  calc
    ∫ x, f x ∂((μ : Measure E))
        = ((((μ.mass : ℝ) + 1)) * (((μ.mass : ℝ) + 1)⁻¹)) * ∫ x, f x ∂((μ : Measure E)) := by
            rw [mul_inv_cancel₀ hmassPos.ne', one_mul]
    _ = (((μ.mass : ℝ) + 1)) * ((((μ.mass : ℝ) + 1)⁻¹) * ∫ x, f x ∂((μ : Measure E))) := by
          ring
    _ = (((μ.mass : ℝ) + 1)) *
          ∫ z, cemeteryExtendedTest f z
            ∂(finiteMeasureCemeteryProbability μ : Measure (E ⊕ Unit)) := by
          rw [hcem]

/-- Helper for Theorem 24.2: record both the total mass and the normalized cemetery encoding of a
finite measure. -/
private noncomputable def finiteMeasureCemeteryEmbedding (μ : MeasureTheory.FiniteMeasure E) :
    NNReal × MeasureTheory.ProbabilityMeasure (E ⊕ Unit) :=
  (μ.mass, finiteMeasureCemeteryProbability μ)

/-- Helper for Theorem 24.2: the cemetery embedding is injective because its two coordinates
recover every bounded-continuous integral of the original finite measure. -/
private theorem finiteMeasureCemeteryEmbedding_injective :
    Function.Injective
      (finiteMeasureCemeteryEmbedding :
        MeasureTheory.FiniteMeasure E →
          NNReal × MeasureTheory.ProbabilityMeasure (E ⊕ Unit)) := by
  intro μ ν hEmbedding
  have hmass : μ.mass = ν.mass := by
    simpa using congrArg Prod.fst hEmbedding
  have hprob :
      finiteMeasureCemeteryProbability μ = finiteMeasureCemeteryProbability ν := by
    simpa using congrArg Prod.snd hEmbedding
  -- Proof comment: the cemetery probability coordinate recovers every bounded-continuous integral
  -- once the mass coordinate is restored.
  refine FiniteMeasure.ext_of_forall_integral_eq ?_
  intro f
  calc
    ∫ x, f x ∂((μ : Measure E)) =
        (((μ.mass : ℝ) + 1)) *
          ∫ z, cemeteryExtendedTest f z
            ∂(finiteMeasureCemeteryProbability μ : Measure (E ⊕ Unit)) := by
          rw [integral_eq_massAddOne_mul_cemeteryIntegral]
    _ = (((ν.mass : ℝ) + 1)) *
          ∫ z, cemeteryExtendedTest f z
            ∂(finiteMeasureCemeteryProbability ν : Measure (E ⊕ Unit)) := by
          rw [hmass, hprob]
    _ = ∫ x, f x ∂((ν : Measure E)) := by
          rw [integral_eq_massAddOne_mul_cemeteryIntegral]

/-- Helper for Theorem 24.2: the cemetery embedding induces the finite-measure weak topology. -/
private theorem finiteMeasureCemeteryEmbedding_inducing :
    Topology.IsInducing
      (finiteMeasureCemeteryEmbedding :
        MeasureTheory.FiniteMeasure E →
          NNReal × MeasureTheory.ProbabilityMeasure (E ⊕ Unit)) := by
  let emb : MeasureTheory.FiniteMeasure E →
      NNReal × MeasureTheory.ProbabilityMeasure (E ⊕ Unit) :=
    finiteMeasureCemeteryEmbedding
  have hProbability :
      Continuous (fun μ : MeasureTheory.FiniteMeasure E ↦ finiteMeasureCemeteryProbability μ) := by
    rw [ProbabilityMeasure.continuous_iff_forall_continuous_integral]
    intro g
    -- Proof comment: the cemetery integral is an explicit continuous expression in the mass and
    -- the original finite-measure integral.
    have hMassInv :
        Continuous (fun μ : MeasureTheory.FiniteMeasure E ↦ (((μ.mass : ℝ) + 1)⁻¹)) := by
      refine ((NNReal.continuous_coe.comp FiniteMeasure.continuous_mass).add continuous_const).inv₀
        ?_
      intro μ
      have hmassPos : 0 < ((μ.mass : ℝ) + 1) := by
        positivity
      exact hmassPos.ne'
    have hIntegral :
        Continuous (fun μ : MeasureTheory.FiniteMeasure E ↦
          ∫ x, inlRestrictedTest g x ∂((μ : Measure E))) :=
      FiniteMeasure.continuous_integral_boundedContinuousFunction (inlRestrictedTest g)
    simpa [integral_finiteMeasureCemeteryProbability, Function.comp] using
      hMassInv.mul (hIntegral.add continuous_const)
  have hEmbeddingContinuous : Continuous emb := by
    -- Proof comment: continuity of the product map combines continuity of mass and probability
    -- coordinates.
    exact FiniteMeasure.continuous_mass.prodMk hProbability
  rw [Topology.isInducing_iff_nhds]
  intro μ
  refine le_antisymm (hEmbeddingContinuous.continuousAt : ContinuousAt emb μ).le_comap ?_
  -- Proof comment: convergence of cemetery coordinates recovers convergence of every bounded test
  -- integral, hence weak convergence of finite measures.
  change Filter.Tendsto (fun ν : MeasureTheory.FiniteMeasure E ↦ ν) (Filter.comap emb (𝓝 (emb μ)))
    (𝓝 μ)
  exact FiniteMeasure.tendsto_of_forall_integral_tendsto <| by
    intro f
    let recoveredIntegral :
        NNReal × MeasureTheory.ProbabilityMeasure (E ⊕ Unit) → ℝ :=
      fun y ↦ (((y.1 : ℝ) + 1)) *
        ∫ z, cemeteryExtendedTest f z ∂((y.2 : Measure (E ⊕ Unit)))
    have hRecoveredIntegral : Continuous recoveredIntegral := by
      have hMass :
          Continuous (fun y : NNReal × MeasureTheory.ProbabilityMeasure (E ⊕ Unit) ↦
            ((y.1 : ℝ) + 1)) :=
        (NNReal.continuous_coe.comp continuous_fst).add continuous_const
      have hIntegral :
          Continuous (fun y : NNReal × MeasureTheory.ProbabilityMeasure (E ⊕ Unit) ↦
            ∫ z, cemeteryExtendedTest f z ∂((y.2 : Measure (E ⊕ Unit)))) :=
        (ProbabilityMeasure.continuous_integral_boundedContinuousFunction
          (cemeteryExtendedTest f)).comp continuous_snd
      exact hMass.mul hIntegral
    have hFactor :
        (fun ν : MeasureTheory.FiniteMeasure E ↦ ∫ x, f x ∂((ν : Measure E))) =
          recoveredIntegral ∘ emb := by
      funext ν
      simpa [recoveredIntegral, emb] using
        (integral_eq_massAddOne_mul_cemeteryIntegral f ν)
    rw [hFactor]
    have hValue :
        recoveredIntegral (emb μ) = ∫ x, f x ∂((μ : Measure E)) := by
      simpa [recoveredIntegral, emb] using
        (integral_eq_massAddOne_mul_cemeteryIntegral f μ).symm
    simpa [hValue] using
      (hRecoveredIntegral.continuousAt : ContinuousAt recoveredIntegral (emb μ)).tendsto.comp
        Filter.tendsto_comap

/-- Helper for Theorem 24.2: on a separable metric space, the finite-measure weak topology is
metrizable via the cemetery embedding into `NNReal × ProbabilityMeasure (E ⊕ Unit)`. -/
theorem finiteMeasure_weakTopology_metrizable_of_separable [TopologicalSpace.SeparableSpace E] :
    TopologicalSpace.MetrizableSpace (MeasureTheory.FiniteMeasure E) := by
  letI : TopologicalSpace.PseudoMetrizableSpace (E ⊕ Unit) := by infer_instance
  exact Topology.IsEmbedding.metrizableSpace
    (show Topology.IsEmbedding
      (finiteMeasureCemeteryEmbedding :
        MeasureTheory.FiniteMeasure E →
          NNReal × MeasureTheory.ProbabilityMeasure (E ⊕ Unit)) from
      ⟨finiteMeasureCemeteryEmbedding_inducing, finiteMeasureCemeteryEmbedding_injective⟩)

end FiniteMeasureMetrizable

section ChapterAmbient

-- Semantic recall: `lean_leansearch` only surfaced general `borel`/`BorelSpace` owners here, so
-- Theorem 24.2 keeps the local vague-coordinate sigma-algebra API and packages the source chain.
-- Remark 24.11 fixes Chapter 24 in the locally compact Polish setting, and the Borel/vague
-- identification in Theorem 24.2 uses the resulting countable ambient structure.
variable [PolishSpace E]

/-- Helper for Theorem 24.2: a boundedly finite measure is finite on every compact set, hence it
is finite on compacts in the owner API. -/
theorem boundedlyFiniteMeasure_isFiniteMeasureOnCompacts
    (μ : BoundedlyFiniteMeasure E) :
    IsFiniteMeasureOnCompacts (μ : Measure E) := by
  -- Proof comment: compact sets are bounded in a pseudometric space, so bounded finiteness
  -- upgrades directly to the owner `IsFiniteMeasureOnCompacts` structure.
  refine ⟨fun K hK ↦ μ.lt_top_of_isBounded hK.measurableSet hK.isBounded⟩

/-- Helper for Theorem 24.2: the compact-piece pullback of a boundedly finite measure is finite. -/
theorem isFiniteMeasure_compactPieceComap
    (K : CompactExhaustion E) (μ : BoundedlyFiniteMeasure E) (n : ℕ) :
    IsFiniteMeasure (Measure.comap Subtype.val (μ : Measure E) : Measure ↥(K n)) := by
  -- Proof comment: once the ambient measure is finite on compacts, pulling it back to the compact
  -- subtype preserves finite-on-compacts, and compactness of the subtype upgrades this to a
  -- finite measure.
  letI : IsFiniteMeasureOnCompacts (μ : Measure E) :=
    boundedlyFiniteMeasure_isFiniteMeasureOnCompacts (E := E) μ
  haveI : CompactSpace ↥(K n) := isCompact_iff_compactSpace.mp (K.isCompact n)
  haveI :=
    IsFiniteMeasureOnCompacts.comap' (μ : Measure E) continuous_subtype_val
      (MeasurableEmbedding.subtype_coe (K.isCompact n).measurableSet)
  infer_instance

/-- Helper for Theorem 24.2: package the restriction to a compact exhaustion piece as a finite
measure on the compact subtype, keeping the `Subtype`/`comap` transport behind one owner. -/
noncomputable def compactPieceFiniteMeasure
    (K : CompactExhaustion E) (μ : BoundedlyFiniteMeasure E) (n : ℕ) :
    FiniteMeasure ↥(K n) :=
  ⟨Measure.comap Subtype.val (μ : Measure E), isFiniteMeasure_compactPieceComap (E := E) K μ n⟩

/-- Helper for Theorem 24.2: compact pieces of the finite-measure space are second countable. -/
theorem compactPieceFiniteMeasureSecondCountable [T2Space E] {K0 : Set E}
    (hK0 : IsCompact K0) :
    SecondCountableTopology (FiniteMeasure (↥K0)) := by
  -- Proof comment: compactness of `K0` gives separability of the subtype, Remark 13.14 supplies
  -- metrizability of the finite-measure weak topology, and the mass-bounded compact cover then
  -- upgrades this to second countability.
  letI : CompactSpace ↥K0 := isCompact_iff_compactSpace.mp hK0
  letI : MetricSpace ↥K0 := MetricSpace.ofT0PseudoMetricSpace ↥K0
  letI : TopologicalSpace.SeparableSpace ↥K0 := by infer_instance
  letI : TopologicalSpace.MetrizableSpace (FiniteMeasure (↥K0)) :=
    finiteMeasure_weakTopology_metrizable_of_separable (E := ↥K0)
  letI : PseudoMetricSpace (FiniteMeasure (↥K0)) :=
    TopologicalSpace.pseudoMetrizableSpacePseudoMetric (FiniteMeasure (↥K0))
  letI : SigmaCompactSpace (FiniteMeasure (↥K0)) := by
    let C : ℕ → Set (FiniteMeasure (↥K0)) :=
      fun m ↦ {ν : FiniteMeasure (↥K0) | FiniteMeasure.mass ν ≤ (m : NNReal)}
    rw [SigmaCompactSpace_iff_exists_compact_covering]
    refine ⟨C, ?_, ?_⟩
    · intro m
      simpa [C] using isCompact_setOf_finiteMeasure_le_of_compactSpace (↥K0) (m : NNReal)
    · ext ν
      constructor
      · intro _
        simp
      · intro _
        rcases exists_nat_ge ν.mass with ⟨m, hm⟩
        exact Set.mem_iUnion.2 ⟨m, by simpa [C] using hm⟩
  infer_instance

/-- Helper for Theorem 24.2: weak-dual coordinates on compact finite-measure pieces are measurable
for the inherited Giry sigma-algebra. -/
theorem compactPieceWeakDualCoordinateMeasurable [T2Space E] {K0 : Set E}
    (hK0 : IsCompact K0) (f : BoundedContinuousFunction ↥K0 NNReal) :
    @Measurable (FiniteMeasure (↥K0)) NNReal
      (inferInstance : MeasurableSpace (FiniteMeasure (↥K0))) inferInstance
      (fun ν ↦ ν.toWeakDualBCNN f) := by
  -- Proof comment: each weak-dual coordinate is the `toNNReal` of a measurable `lintegral`,
  -- composed with the measurable coercion from `FiniteMeasure` to `Measure`.
  simpa [FiniteMeasure.toWeakDualBCNN_apply] using
    ENNReal.measurable_toNNReal.comp
      ((Measure.measurable_lintegral
        (measurable_coe_nnreal_ennreal.comp f.continuous.measurable)).comp
        (comap_measurable (fun ν : FiniteMeasure (↥K0) ↦ (ν : Measure (↥K0)))))

/-- Helper for Theorem 24.2: the compact-piece weak topology is induced by the full weak-dual
coordinate map. -/
theorem compactPieceFiniteMeasureTopology_eq_inducedWeakDualCoordinates {K0 : Set E} :
    (inferInstance : TopologicalSpace (FiniteMeasure (↥K0))) =
      TopologicalSpace.induced
        (fun ν : FiniteMeasure (↥K0) ↦
          fun f : BoundedContinuousFunction (↥K0) NNReal ↦ ν.toWeakDualBCNN f)
        Pi.topologicalSpace := by
  -- Proof comment: unfold the finite-measure weak topology through `toWeakDualBCNN`, then expose
  -- the weak-dual topology itself as the induced product topology of coordinate evaluation.
  let g : FiniteMeasure (↥K0) → BoundedContinuousFunction (↥K0) NNReal → NNReal :=
    fun ν f ↦ ν.toWeakDualBCNN f
  calc
    (inferInstance : TopologicalSpace (FiniteMeasure (↥K0)))
      = TopologicalSpace.induced FiniteMeasure.toWeakDualBCNN inferInstance := by
          rfl
    _ = TopologicalSpace.induced FiniteMeasure.toWeakDualBCNN
          (TopologicalSpace.induced
            (fun φ : WeakDual NNReal (BoundedContinuousFunction (↥K0) NNReal) ↦
              fun f ↦ φ f)
            Pi.topologicalSpace) := by
          rfl
    _ = TopologicalSpace.induced g Pi.topologicalSpace := by
          rw [induced_compose]
          rfl

/-- Helper for Theorem 24.2: after supplying second countability on a compact piece, the Borel
sigma-algebra of `FiniteMeasure ↥K0` is generated by finite weak-dual cylinders, hence contained
in the inherited Giry sigma-algebra. -/
theorem compactPieceFiniteMeasure_borel_le_measurableSpace [T2Space E] {K0 : Set E}
    (hK0 : IsCompact K0) :
    borel (FiniteMeasure (↥K0)) ≤ (inferInstance : MeasurableSpace (FiniteMeasure (↥K0))) := by
  -- Proof comment: second countability upgrades the induced weak-dual coordinate topology to a
  -- Borel `generateFrom`, and each cylinder is measurable because all scalar coordinates are.
  letI : SecondCountableTopology (FiniteMeasure (↥K0)) :=
    compactPieceFiniteMeasureSecondCountable (E := E) hK0
  have hborel_coords :
      borel (FiniteMeasure (↥K0)) =
        MeasurableSpace.generateFrom
          ((fun t : Set (BoundedContinuousFunction (↥K0) NNReal → NNReal) ↦
              (fun ν : FiniteMeasure (↥K0) ↦ fun f ↦ ν.toWeakDualBCNN f) ⁻¹' t) ''
            { t | ∃ u : BoundedContinuousFunction (↥K0) NNReal → Set NNReal,
                ∃ i : Finset (BoundedContinuousFunction (↥K0) NNReal),
                  (∀ f ∈ i, IsOpen (u f)) ∧ t = Set.pi (↑i) u }) := by
    -- Proof comment: use the product subbasis description of the weak-dual coordinate map.
    simpa using
      (borel_eq_generateFrom_of_subbasis
        (s :=
          ((fun t : Set (BoundedContinuousFunction (↥K0) NNReal → NNReal) ↦
              (fun ν : FiniteMeasure (↥K0) ↦ fun f ↦ ν.toWeakDualBCNN f) ⁻¹' t) ''
            { t | ∃ u : BoundedContinuousFunction (↥K0) NNReal → Set NNReal,
                ∃ i : Finset (BoundedContinuousFunction (↥K0) NNReal),
                  (∀ f ∈ i, IsOpen (u f)) ∧ t = Set.pi (↑i) u }))
        (by
          simpa [compactPieceFiniteMeasureTopology_eq_inducedWeakDualCoordinates (K0 := K0)]
            using (by rw [pi_eq_generateFrom, induced_generateFrom_eq] :
              TopologicalSpace.induced
                  (fun ν : FiniteMeasure (↥K0) ↦
                    fun f : BoundedContinuousFunction (↥K0) NNReal ↦ ν.toWeakDualBCNN f)
                  Pi.topologicalSpace =
                TopologicalSpace.generateFrom
                  ((fun t :
                      Set (BoundedContinuousFunction (↥K0) NNReal → NNReal) ↦
                      (fun ν : FiniteMeasure (↥K0) ↦
                        fun f ↦ ν.toWeakDualBCNN f) ⁻¹' t) ''
                    { t | ∃ u : BoundedContinuousFunction (↥K0) NNReal → Set NNReal,
                        ∃ i : Finset (BoundedContinuousFunction (↥K0) NNReal),
                          (∀ f ∈ i, IsOpen (u f)) ∧ t = Set.pi (↑i) u }))))
  rw [hborel_coords]
  refine MeasurableSpace.generateFrom_le ?_
  rintro _ ⟨t, ⟨u, i, hi, rfl⟩, rfl⟩
  have hcoords :
      @Measurable (FiniteMeasure (↥K0))
        (BoundedContinuousFunction (↥K0) NNReal → NNReal)
        (inferInstance : MeasurableSpace (FiniteMeasure (↥K0))) inferInstance
        (fun ν ↦ fun f ↦ ν.toWeakDualBCNN f) := by
    -- Proof comment: measurability into the product space is equivalent to measurability of every
    -- scalar weak-dual coordinate, already isolated above.
    rw [measurable_pi_iff]
    intro f
    simpa using compactPieceWeakDualCoordinateMeasurable (E := E) hK0 f
  exact MeasurableSet.preimage
    (MeasurableSet.pi i.countable_toSet fun f hf ↦ (hi f hf).measurableSet)
    hcoords

/-- Helper for Theorem 24.2: every measurable-set evaluation map is random-measure measurable
after decomposing it along a compact exhaustion. -/
theorem measurable_apply_random [T2Space E] (A : Set E) (hA : MeasurableSet A) :
    @Measurable (BoundedlyFiniteMeasure E) ENNReal
      (randomMeasureMeasurableSpace E) (borel ENNReal)
      (fun μ ↦ (μ : Measure E) A) := by
  let K : CompactExhaustion E := CompactExhaustion.choice E
  have hpiece :
      ∀ n,
        @Measurable (BoundedlyFiniteMeasure E) ENNReal
          (randomMeasureMeasurableSpace E) (borel ENNReal)
          (fun μ : BoundedlyFiniteMeasure E ↦ (μ : Measure E) (A ∩ K n)) := by
    intro n
    exact
      measurable_apply_of_isBounded (A ∩ K n) (hA.inter (K.isCompact n).measurableSet)
        ((K.isCompact n).isBounded.subset Set.inter_subset_right)
  have h_eval_eq :
      (fun μ : BoundedlyFiniteMeasure E ↦ (μ : Measure E) A) =
        (fun μ : BoundedlyFiniteMeasure E ↦ ⨆ n, (μ : Measure E) (A ∩ K n)) := by
    funext μ
    have hmono : Monotone fun n : ℕ ↦ A ∩ K n := fun m n hmn x hx ↦ ⟨hx.1, K.subset hmn hx.2⟩
    have hUnion : ⋃ n, A ∩ K n = A := by
      ext x
      constructor
      · intro hxU
        rcases Set.mem_iUnion.1 hxU with ⟨n, hx⟩
        exact hx.1
      · intro hxA
        rcases K.exists_mem x with ⟨n, hxK⟩
        exact Set.mem_iUnion.2 ⟨n, ⟨hxA, hxK⟩⟩
    calc
      (μ : Measure E) A = (μ : Measure E) (⋃ n, A ∩ K n) := by
        exact congrArg ((μ : Measure E) ·) hUnion.symm
      _ = ⨆ n, (μ : Measure E) (A ∩ K n) := by
            exact hmono.measure_iUnion
  -- Proof comment: general evaluations are pointwise suprema of bounded evaluations on the
  -- compact exhaustion pieces, so the entire Giry coercion is already random-measure measurable.
  simpa [h_eval_eq] using Measurable.iSup hpiece

/-- Helper for Theorem 24.2: the compact-piece restriction map into `FiniteMeasure ↥(K n)` is
random-measure measurable. -/
theorem measurable_compactPieceFiniteMeasure [T2Space E]
    (K : CompactExhaustion E) (n : ℕ) :
    @Measurable (BoundedlyFiniteMeasure E) (FiniteMeasure ↥(K n))
      (randomMeasureMeasurableSpace E) (inferInstance : MeasurableSpace (FiniteMeasure ↥(K n)))
      (fun μ ↦ compactPieceFiniteMeasure (E := E) K μ n) := by
  have hmeasure :
      @Measurable (BoundedlyFiniteMeasure E) (Measure ↥(K n))
        (randomMeasureMeasurableSpace E) (inferInstance : MeasurableSpace (Measure ↥(K n)))
        (fun μ : BoundedlyFiniteMeasure E ↦
          (compactPieceFiniteMeasure (E := E) K μ n : Measure ↥(K n))) := by
    refine Measure.measurable_of_measurable_coe _ ?_
    intro s hs
    have hsImage :
        MeasurableSet (((↑) : ↥(K n) → E) '' s) := by
      exact
        (MeasurableEmbedding.subtype_coe (K.isCompact n).measurableSet).measurableSet_image' hs
    have hsBounded :
        Bornology.IsBounded (((↑) : ↥(K n) → E) '' s) := by
      exact
        (K.isCompact n).isBounded.subset
          (by
            intro x hx
            rcases hx with ⟨y, hy, rfl⟩
            exact y.property)
    have hEval :
        (fun μ : BoundedlyFiniteMeasure E ↦
          (compactPieceFiniteMeasure (E := E) K μ n : Measure ↥(K n)) s) =
          fun μ : BoundedlyFiniteMeasure E ↦ (μ : Measure E) (((↑) : ↥(K n) → E) '' s) := by
      funext μ
      rw [show
          (compactPieceFiniteMeasure (E := E) K μ n : Measure ↥(K n)) =
            Measure.comap Subtype.val (μ : Measure E) by
            rfl]
      rw [Measure.comap_apply _ Subtype.val_injective
        (fun t ht ↦
          (MeasurableEmbedding.subtype_coe (K.isCompact n).measurableSet).measurableSet_image' ht)
        _ hs]
    simpa [hEval] using measurable_apply_random (E := E) (((↑) : ↥(K n) → E) '' s) hsImage
  exact hmeasure.subtype_mk

-- Proof sketch: unfold `BoundedlyFiniteMeasure.vagueTopology` as the infimum of the induced
-- topologies from the maps
-- `μ ↦ ∫ f dμ`, use `borel_comap` for each induced topology, and identify the Borel sigma-algebra
-- of the initial topology with the sigma-algebra generated by those coordinate maps.
/-- The Borel sigma-algebra of the vague topology is generated by the real-valued vague integral
maps indexed by `C_c(E, ℝ)`. -/
theorem borel_vagueTopology_eq_compactlySupportedContinuousIntegralMeasurableSpace :
    borel (BoundedlyFiniteMeasure E) =
      compactlySupportedContinuousIntegralMeasurableSpace E := by
  refine le_antisymm ?_ compactlySupportedContinuousIntegralMeasurableSpace_le_borel
  have hborel_le_random :
      borel (BoundedlyFiniteMeasure E) ≤ randomMeasureMeasurableSpace E := by
    let K : CompactExhaustion E := CompactExhaustion.choice E
    let coordK : BoundedlyFiniteMeasure E → (n : ℕ) → FiniteMeasure ↥(K n) :=
      fun μ n ↦ compactPieceFiniteMeasure (E := E) K μ n
    have htop :
        TopologicalSpace.induced coordK inferInstance ≤
          (inferInstance : TopologicalSpace (BoundedlyFiniteMeasure E)) := by
      -- Route correction: instead of the failed uncountable product owner, use the countable
      -- compact-exhaustion restriction family. Each vague test factors through one compact piece,
      -- so the restriction-family topology is already finer than the vague topology.
      rw [BoundedlyFiniteMeasure.instTopologicalSpace, BoundedlyFiniteMeasure.vagueTopology]
      refine le_iInf ?_
      intro f
      rcases K.exists_superset_of_isCompact f.hasCompactSupport.isCompact with ⟨n, hfn⟩
      let g : C(↥(K n), ℝ) :=
        { toFun := fun x ↦ f x
          continuous_toFun := f.continuous.comp continuous_subtype_val }
      have hfactor :
          BoundedlyFiniteMeasure.vagueIntegral f =
            fun μ : BoundedlyFiniteMeasure E ↦
              ∫ x, g x ∂(coordK μ n) := by
        funext μ
        have hsupport : Function.support f ⊆ K n := by
          intro x hx
          exact hfn (subset_tsupport f hx)
        have hsubtype :
            ∫ x, g x ∂(coordK μ n) =
              ∫ x in K n, f x ∂(μ : Measure E) := by
          simpa [coordK, compactPieceFiniteMeasure, g] using
            (integral_subtype_comap (μ := (μ : Measure E)) (s := K n)
              (hs := (K.isCompact n).measurableSet) f)
        have hrestrict :
            ∫ x in K n, f x ∂(μ : Measure E) =
              ∫ x, f x ∂(μ : Measure E) := by
          calc
            ∫ x in K n, f x ∂(μ : Measure E) =
                ∫ x, Set.indicator (K n) f x ∂(μ : Measure E) := by
                  rw [integral_indicator ((K.isCompact n).measurableSet)]
            _ = ∫ x, f x ∂(μ : Measure E) := by
                  refine integral_congr_ae <| Filter.Eventually.of_forall fun x ↦ ?_
                  by_cases hx : x ∈ K n
                  · simp [hx]
                  · have hfx : f x = 0 := by
                      by_contra hne
                      exact hx (hsupport (by simpa [Function.support, hne]))
                    simp [hx, hfx]
        -- Proof comment: once the compact support of `f` sits inside one exhaustion piece, the
        -- ambient integral is exactly the compact-piece finite-measure integral on that subtype.
        calc
          BoundedlyFiniteMeasure.vagueIntegral f μ = ∫ x, f x ∂(μ : Measure E) := by
            rw [BoundedlyFiniteMeasure.vagueIntegral_apply]
          _ = ∫ x in K n, f x ∂(μ : Measure E) := hrestrict.symm
          _ = ∫ x, g x ∂(coordK μ n) := hsubtype.symm
      haveI : CompactSpace ↥(K n) := isCompact_iff_compactSpace.mp (K.isCompact n)
      letI : TopologicalSpace (BoundedlyFiniteMeasure E) :=
        TopologicalSpace.induced coordK inferInstance
      have hcoord : Continuous fun μ : BoundedlyFiniteMeasure E ↦ coordK μ n :=
        by
          simpa [Function.comp] using (continuous_apply n).comp (continuous_induced_dom : Continuous coordK)
      have hcont : Continuous fun μ : BoundedlyFiniteMeasure E ↦ ∫ x, g x ∂(coordK μ n) :=
        (FiniteMeasure.continuous_integral_continuousMap g).comp hcoord
      exact continuous_iff_le_induced.mp <| by
        simpa [hfactor] using hcont
    have hprod_borel :
        borel ((n : ℕ) → FiniteMeasure ↥(K n)) ≤
          (inferInstance : MeasurableSpace ((n : ℕ) → FiniteMeasure ↥(K n))) := by
      letI : ∀ n, SecondCountableTopology (FiniteMeasure ↥(K n)) :=
        fun n ↦ compactPieceFiniteMeasureSecondCountable (E := E) (K.isCompact n)
      letI : ∀ n, OpensMeasurableSpace (FiniteMeasure ↥(K n)) :=
        fun n ↦ ⟨compactPieceFiniteMeasure_borel_le_measurableSpace (E := E) (K.isCompact n)⟩
      exact OpensMeasurableSpace.borel_le
    have hcoord_meas :
        @Measurable (BoundedlyFiniteMeasure E) ((n : ℕ) → FiniteMeasure ↥(K n))
          (randomMeasureMeasurableSpace E)
          (inferInstance : MeasurableSpace ((n : ℕ) → FiniteMeasure ↥(K n)))
          coordK := by
      rw [measurable_pi_iff]
      intro n
      exact measurable_compactPieceFiniteMeasure (E := E) K n
    calc
      borel (BoundedlyFiniteMeasure E)
          ≤ MeasurableSpace.comap coordK (borel ((n : ℕ) → FiniteMeasure ↥(K n))) := by
            simpa [borel_comap] using
              (borel_anti htop :
                borel (BoundedlyFiniteMeasure E) ≤
                  @borel (BoundedlyFiniteMeasure E)
                    (TopologicalSpace.induced coordK inferInstance))
      _ ≤ MeasurableSpace.comap coordK
            (inferInstance : MeasurableSpace ((n : ℕ) → FiniteMeasure ↥(K n))) := by
            exact MeasurableSpace.comap_mono hprod_borel
      _ ≤ randomMeasureMeasurableSpace E := hcoord_meas.comap_le
  exact
    hborel_le_random.trans
      (randomMeasureMeasurableSpace_le_compactlySupportedContinuousIntegralMeasurableSpace
        (E := E))

end ChapterAmbient

-- Proof sketch: every real-valued compactly supported continuous function is the difference of two
-- nonnegative compactly supported continuous functions, so the sigma-algebra generated by all
-- real-valued test integrals agrees with the one generated by the nonnegative tests alone.
/-- The sigma-algebra generated by all compactly supported continuous real test integrals agrees
with the one generated by the nonnegative test integrals. -/
theorem compactlySupportedContinuousIntegralMeasurableSpace_eq_nonnegative :
    compactlySupportedContinuousIntegralMeasurableSpace E =
      nonnegativeCompactlySupportedContinuousIntegralMeasurableSpace E := by
  refine le_antisymm ?_ ?_
  · refine iSup_le ?_
    intro f
    -- Proof comment: write `f` as the difference of its positive and negative compactly
    -- supported parts, then use measurability of subtraction.
    have hpos :
        @Measurable (BoundedlyFiniteMeasure E) ℝ
          (nonnegativeCompactlySupportedContinuousIntegralMeasurableSpace E) (borel ℝ)
          (fun μ : BoundedlyFiniteMeasure E ↦
            BoundedlyFiniteMeasure.nonnegativeVagueIntegral f.nnrealPart μ) := by
      exact Measurable.of_comap_le <| le_iSup_of_le f.nnrealPart le_rfl
    have hneg :
        @Measurable (BoundedlyFiniteMeasure E) ℝ
          (nonnegativeCompactlySupportedContinuousIntegralMeasurableSpace E) (borel ℝ)
          (fun μ : BoundedlyFiniteMeasure E ↦
            BoundedlyFiniteMeasure.nonnegativeVagueIntegral (-f).nnrealPart μ) := by
      exact Measurable.of_comap_le <| le_iSup_of_le (-f).nnrealPart le_rfl
    have hvague :
        (fun μ : BoundedlyFiniteMeasure E ↦ BoundedlyFiniteMeasure.vagueIntegral f μ) =
          fun μ ↦
            BoundedlyFiniteMeasure.nonnegativeVagueIntegral f.nnrealPart μ -
              BoundedlyFiniteMeasure.nonnegativeVagueIntegral (-f).nnrealPart μ := by
      funext μ
      -- Proof comment: integrate the canonical `f = f⁺ - f⁻` identity from `nnrealPart`.
      rw [nonnegativeVagueIntegral_eq_vagueIntegral_toReal,
        nonnegativeVagueIntegral_eq_vagueIntegral_toReal,
        BoundedlyFiniteMeasure.vagueIntegral_apply,
        BoundedlyFiniteMeasure.vagueIntegral_apply,
        BoundedlyFiniteMeasure.vagueIntegral_apply,
        ← integral_sub (integrable_vagueTest μ f.nnrealPart.toReal)
          (integrable_vagueTest μ (-f).nnrealPart.toReal)]
      congr 1
      funext x
      simpa using
        congrArg (fun g : C_c(E, ℝ) ↦ g x)
          (CompactlySupportedContinuousMap.nnrealPart_sub_nnrealPart_neg f)
    simpa [hvague] using (hpos.sub hneg).comap_le
  · refine iSup_le ?_
    intro f
    -- Proof comment: a nonnegative test integral is already the real-valued integral of `f.toReal`.
    have hreal :
        @Measurable (BoundedlyFiniteMeasure E) ℝ
          (compactlySupportedContinuousIntegralMeasurableSpace E) (borel ℝ)
          (fun μ : BoundedlyFiniteMeasure E ↦
            BoundedlyFiniteMeasure.vagueIntegral f.toReal μ) := by
      exact Measurable.of_comap_le <| le_iSup_of_le f.toReal le_rfl
    have hnonnegative :
        @Measurable (BoundedlyFiniteMeasure E) ℝ
          (compactlySupportedContinuousIntegralMeasurableSpace E) (borel ℝ)
          (fun μ : BoundedlyFiniteMeasure E ↦
            BoundedlyFiniteMeasure.nonnegativeVagueIntegral f μ) := by
      -- Proof comment: rewrite the generator as the real-valued test integral of `f.toReal`.
      simpa [nonnegativeVagueIntegral_eq_vagueIntegral_toReal] using hreal
    exact hnonnegative.comap_le

section ChapterAmbient

variable [PolishSpace E] [T2Space E]

-- Proof sketch: first identify `𝕄` with the nonnegative-vague-integral sigma-algebra via compact
-- restrictions, then combine that with the already isolated Borel/vague-coordinate comparison and
-- the real/nonnegative generator equivalence.
/-- Theorem 24.2: on the chapter ambient locally compact Polish space `E`, the sigma-algebra `𝕄`
on boundedly finite measures agrees with the Borel sigma-algebra of the vague topology, with the
sigma-algebra generated by all compactly supported continuous real test integrals, and with the
sigma-algebra generated by the nonnegative compactly supported continuous test integrals. -/
theorem randomMeasureMeasurableSpace_eq_borel_vagueTopology :
    randomMeasureMeasurableSpace E =
      borel (BoundedlyFiniteMeasure E) ∧
    borel (BoundedlyFiniteMeasure E) =
      compactlySupportedContinuousIntegralMeasurableSpace E ∧
    compactlySupportedContinuousIntegralMeasurableSpace E =
      nonnegativeCompactlySupportedContinuousIntegralMeasurableSpace E := by
  have hRandomEqCompact :
      randomMeasureMeasurableSpace E =
        compactlySupportedContinuousIntegralMeasurableSpace E := by
    -- Proof comment: the reverse inclusion is isolated in the compact-exhaustion placeholder,
    -- while the forward inclusion and the real/nonnegative generator comparison are already proved.
    calc
      randomMeasureMeasurableSpace E =
          nonnegativeCompactlySupportedContinuousIntegralMeasurableSpace E := by
            exact le_antisymm
              randomMeasureMeasurableSpace_le_nonnegativeCompactlySupportedContinuousIntegralMeasurableSpace
              nonnegativeCompactlySupportedContinuousIntegralMeasurableSpace_le_randomMeasure
      _ = compactlySupportedContinuousIntegralMeasurableSpace E := by
            exact compactlySupportedContinuousIntegralMeasurableSpace_eq_nonnegative.symm
  refine ⟨?_, borel_vagueTopology_eq_compactlySupportedContinuousIntegralMeasurableSpace, ?_⟩
  · calc
      randomMeasureMeasurableSpace E =
          compactlySupportedContinuousIntegralMeasurableSpace E := hRandomEqCompact
      _ = borel (BoundedlyFiniteMeasure E) := by
            exact borel_vagueTopology_eq_compactlySupportedContinuousIntegralMeasurableSpace.symm
  · exact compactlySupportedContinuousIntegralMeasurableSpace_eq_nonnegative

end ChapterAmbient
