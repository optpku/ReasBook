import Mathlib
import Books.ProbabilityTheory_Klenke_2020.Items.Chap09.Remark_9_25

-- Declarations for this item will be appended below by the statement pipeline.

open MeasureTheory ProbabilityTheory
open scoped BigOperators Topology

namespace ProbabilityTheory

/-- The finite `d`-dimensional discrete torus of side length `L`, modeling the voter sites
`{0, ..., L - 1}^d` with periodic boundary conditions. The dimension is taken to be positive so
that the nearest-neighbor choice set is nonempty. -/
abbrev VoterSite (d : ℕ+) (L : ℕ+) := Fin d → ZMod L

/-- A voter configuration assigns one of the two opinions `false = 0` or `true = 1` to each site
of the finite torus. -/
abbrev VoterConfig (d : ℕ+) (L : ℕ+) := VoterSite d L → Bool

/-- A nearest-neighbor choice on the torus: pick one coordinate direction together with a sign,
where `true` means the positive step and `false` means the negative step. -/
abbrev VoterNeighborChoice (d : ℕ+) := Fin d × Bool

/-- The combined update choice `(I_n, N_n)` of the textbook voter model: a site to be updated and
one of its `2d` nearest-neighbor directions. -/
abbrev VoterUpdateChoice (d : ℕ+) (L : ℕ+) := VoterSite d L × VoterNeighborChoice d

/-- A trajectory of the finite voter model is a sequence of update choices, one for each discrete
time step. -/
abbrev VoterTrajectory (d : ℕ+) (L : ℕ+) := ℕ → VoterUpdateChoice d L

/-- The i.i.d. driving measure of the finite voter model: at each time step, the update choice is
uniform on the finite set of all site-direction pairs. -/
noncomputable abbrev voterTrajectoryMeasure (d : ℕ+) (L : ℕ+) : Measure (VoterTrajectory d L) :=
  Measure.infinitePi fun _ : ℕ ↦ (PMF.uniformOfFintype (VoterUpdateChoice d L)).toMeasure

/-- The unanimous voter configuration with common opinion `b` at every site. -/
def unanimousVoterConfig (d : ℕ+) (L : ℕ+) (b : Bool) : VoterConfig d L :=
  fun _ ↦ b

/-- The torus neighbor obtained from site `i` by moving one step in the chosen coordinate
direction, with addition taken modulo `L`. -/
def voterNeighbor {d : ℕ+} {L : ℕ+} (i : VoterSite d L)
    (u : VoterNeighborChoice d) : VoterSite d L :=
  Function.update i u.1 (if u.2 then i u.1 + 1 else i u.1 - 1)

/-- One discrete update of the voter model: only the chosen site changes, adopting the opinion of
the chosen nearest neighbor. -/
def voterModelStep {d : ℕ+} {L : ℕ+} (x : VoterConfig d L) (i : VoterSite d L)
    (u : VoterNeighborChoice d) : VoterConfig d L :=
  fun j ↦ if j = i then x (voterNeighbor i u) else x j

/-- The voter-model configuration process started from `x₀`, with `0`-based indexing of the
driving update choices. Thus the choice `ω n` produces the update from time `n` to time `n + 1`. -/
def voterModelProcess {d : ℕ+} {L : ℕ+} (x0 : VoterConfig d L) :
    ℕ → VoterTrajectory d L → VoterConfig d L
  | 0, _ => x0
  | n + 1, ω =>
      voterModelStep (voterModelProcess x0 n ω) (ω n).1 (ω n).2

/-- The total number of voters holding opinion `1` in a configuration, viewed as a real number. -/
def voterOpinionCount {d : ℕ+} {L : ℕ+} (x : VoterConfig d L) : ℝ :=
  ∑ i, if x i then (1 : ℝ) else 0

/-- The opinion-count process `M_n`, obtained by summing the current `1`-opinions of the voter
configuration. -/
def voterOpinionCountProcess {d : ℕ+} {L : ℕ+} (x0 : VoterConfig d L) :
    ℕ → VoterTrajectory d L → ℝ :=
  fun n ω ↦ voterOpinionCount (voterModelProcess x0 n ω)

/-- The event that the voter model eventually gets absorbed in the unanimous configuration with
common opinion `b`. -/
def eventuallyConstantOpinion {d : ℕ+} {L : ℕ+} (x0 : VoterConfig d L) (b : Bool) :
    Set (VoterTrajectory d L) :=
  {ω | ∃ n0 : ℕ, ∀ n ≥ n0, voterModelProcess x0 n ω = unanimousVoterConfig d L b}

/-- The event that the voter model eventually reaches consensus on one of the two opinions. -/
def eventuallyConsensus {d : ℕ+} {L : ℕ+} (x0 : VoterConfig d L) :
    Set (VoterTrajectory d L) :=
  {ω | ∃ b : Bool, ω ∈ eventuallyConstantOpinion x0 b}

/-- The lagged update-choice process whose natural filtration at time `n` is generated by the
textbook update choices `(I_k, N_k)` with `k < n`. The initial time `0` is represented by a
constant dummy value so that `Filtration.natural` has the correct one-step shift. -/
def voterUpdateHistory {d : ℕ+} {L : ℕ+} :
    ℕ → VoterTrajectory d L → VoterUpdateChoice d L
  | 0 => fun _ ↦ default
  | n + 1 => Function.eval n

/-- Each time coordinate of the lagged voter-model update history is strongly measurable. -/
theorem voterUpdateHistory_stronglyMeasurable {d : ℕ+} {L : ℕ+} (n : ℕ) :
    StronglyMeasurable (voterUpdateHistory n : VoterTrajectory d L → VoterUpdateChoice d L) := by
  cases n with
  | zero =>
      simpa [voterUpdateHistory] using
        (stronglyMeasurable_const :
          StronglyMeasurable
            (fun _ : VoterTrajectory d L ↦ (default : VoterUpdateChoice d L)))
  | succ n =>
      simpa [voterUpdateHistory] using
        (measurable_pi_apply n).stronglyMeasurable

/-- Helper for Example 11.16: each raw update coordinate evaluation `ω ↦ ω n` is strongly
measurable on the voter-trajectory space. -/
theorem voterTrajectoryEval_stronglyMeasurable {d : ℕ+} {L : ℕ+} (n : ℕ) :
    StronglyMeasurable (Function.eval n : VoterTrajectory d L → VoterUpdateChoice d L) := by
  simpa using (measurable_pi_apply n).stronglyMeasurable

/-- Helper for Example 11.16: updating site `i` changes the opinion count only through the old
opinion at `i` and the copied opinion at `voterNeighbor i u`. -/
theorem voterOpinionCount_voterModelStep {d : ℕ+} {L : ℕ+} (x : VoterConfig d L)
    (i : VoterSite d L) (u : VoterNeighborChoice d) :
    voterOpinionCount (voterModelStep x i u) =
      voterOpinionCount x - (if x i then (1 : ℝ) else 0) +
        (if x (voterNeighbor i u) then (1 : ℝ) else 0) := by
  classical
  have hErase :
      Finset.sum (Finset.univ.erase i) (fun j ↦ if x j then (1 : ℝ) else 0) =
        voterOpinionCount x - (if x i then (1 : ℝ) else 0) := by
    calc
      Finset.sum (Finset.univ.erase i) (fun j ↦ if x j then (1 : ℝ) else 0)
          = Finset.sum (Finset.univ.erase i) (fun j ↦ if x j then (1 : ℝ) else 0) +
              (if x i then (0 : ℝ) else 0) := by
              split_ifs <;> ring
      _ = Finset.sum (Finset.univ.erase i) (fun j ↦ if x j then (1 : ℝ) else 0) +
            (if x i then (1 : ℝ) else 0) - (if x i then (1 : ℝ) else 0) := by
            split_ifs <;> ring
      _ = voterOpinionCount x - (if x i then (1 : ℝ) else 0) := by
            rw [Finset.sum_erase_add _ _ (Finset.mem_univ i), voterOpinionCount]
  -- Proof comment: split the sum into the updated site `i` and the untouched sites.
  calc
    voterOpinionCount (voterModelStep x i u) =
        Finset.sum (Finset.univ.erase i)
            (fun j ↦ if voterModelStep x i u j then (1 : ℝ) else 0) +
          (if voterModelStep x i u i then (1 : ℝ) else 0) := by
      rw [voterOpinionCount, ← Finset.sum_erase_add _ _ (Finset.mem_univ i)]
    _ =
        Finset.sum (Finset.univ.erase i) (fun j ↦ if x j then (1 : ℝ) else 0) +
          (if x (voterNeighbor i u) then (1 : ℝ) else 0) := by
      have hSum :
          Finset.sum (Finset.univ.erase i) (fun j ↦ if voterModelStep x i u j then (1 : ℝ) else 0) =
            Finset.sum (Finset.univ.erase i) (fun j ↦ if x j then (1 : ℝ) else 0) := by
        refine Finset.sum_congr rfl ?_
        intro j hj
        have hji : j ≠ i := (Finset.mem_erase.mp hj).1
        simp [voterModelStep, hji]
      have hSite :
          (if voterModelStep x i u i then (1 : ℝ) else 0) =
            (if x (voterNeighbor i u) then (1 : ℝ) else 0) := by
        simp [voterModelStep]
      rw [hSum, hSite]
    _ =
        voterOpinionCount x - (if x i then (1 : ℝ) else 0) +
          (if x (voterNeighbor i u) then (1 : ℝ) else 0) := by
      rw [hErase]

/-- Helper for Example 11.16: for a fixed nearest-neighbor direction, the torus map
`i ↦ voterNeighbor i u` is a permutation of the voter sites. -/
theorem voterNeighbor_bijective {d : ℕ+} {L : ℕ+} (u : VoterNeighborChoice d) :
    Function.Bijective (fun i : VoterSite d L ↦ voterNeighbor i u) := by
  let uOpp : VoterNeighborChoice d := (u.1, !u.2)
  -- Proof comment: stepping once in direction `u` and then once in the opposite direction
  -- restores each coordinate of the torus site.
  have hLeft :
      Function.LeftInverse (fun i : VoterSite d L ↦ voterNeighbor i uOpp)
        (fun i : VoterSite d L ↦ voterNeighbor i u) := by
    intro i
    ext j
    by_cases hj : j = u.1
    · subst hj
      by_cases hu : u.2
      · simp [voterNeighbor, uOpp, hu]
      · simp [voterNeighbor, uOpp, hu]
    · simp [voterNeighbor, uOpp, hj]
  have hRight :
      Function.RightInverse (fun i : VoterSite d L ↦ voterNeighbor i uOpp)
        (fun i : VoterSite d L ↦ voterNeighbor i u) := by
    intro i
    ext j
    by_cases hj : j = u.1
    · subst hj
      by_cases hu : u.2
      · simp [voterNeighbor, uOpp, hu]
      · simp [voterNeighbor, uOpp, hu]
    · simp [voterNeighbor, uOpp, hj]
  exact ⟨hLeft.injective, hRight.surjective⟩

/-- Helper for Example 11.16: summing a configuration after a fixed torus shift gives the same
total number of opinion-`1` sites. -/
theorem voterOpinionCount_sum_voterNeighbor {d : ℕ+} {L : ℕ+} (x : VoterConfig d L)
    (u : VoterNeighborChoice d) :
    ∑ i : VoterSite d L, (if x (voterNeighbor i u) then (1 : ℝ) else 0) =
      voterOpinionCount x := by
  -- Proof comment: reindex the sum along the torus permutation `i ↦ voterNeighbor i u`.
  simpa [voterOpinionCount] using
    Fintype.sum_bijective
      (fun i : VoterSite d L ↦ voterNeighbor i u)
      (voterNeighbor_bijective u)
      (fun i : VoterSite d L ↦ if x (voterNeighbor i u) then (1 : ℝ) else 0)
      (fun i : VoterSite d L ↦ if x i then (1 : ℝ) else 0)
      (fun _ ↦ rfl)

/-- Helper for Example 11.16: averaging one voter-model update over all update choices preserves
the total opinion count. -/
theorem voterOpinionCountStepSum_eq_card_mul {d : ℕ+} {L : ℕ+} (x : VoterConfig d L) :
    ∑ c : VoterUpdateChoice d L, voterOpinionCount (voterModelStep x c.1 c.2) =
      Fintype.card (VoterUpdateChoice d L) * voterOpinionCount x := by
  classical
  -- Proof comment: sum first over the site index for a fixed direction, where the negative and
  -- shifted positive contributions cancel after reindexing by the torus permutation.
  have hDirection (u : VoterNeighborChoice d) :
      ∑ i : VoterSite d L, voterOpinionCount (voterModelStep x i u) =
        Fintype.card (VoterSite d L) * voterOpinionCount x := by
    calc
      ∑ i : VoterSite d L, voterOpinionCount (voterModelStep x i u)
          = ∑ i : VoterSite d L,
              (voterOpinionCount x - (if x i then (1 : ℝ) else 0) +
                (if x (voterNeighbor i u) then (1 : ℝ) else 0)) := by
            refine Finset.sum_congr rfl ?_
            intro i hi
            rw [voterOpinionCount_voterModelStep]
      _ = (∑ _i : VoterSite d L, voterOpinionCount x) -
            ∑ i : VoterSite d L, (if x i then (1 : ℝ) else 0) +
            ∑ i : VoterSite d L, (if x (voterNeighbor i u) then (1 : ℝ) else 0) := by
            rw [Finset.sum_add_distrib, Finset.sum_sub_distrib]
      _ = Fintype.card (VoterSite d L) * voterOpinionCount x - voterOpinionCount x +
            voterOpinionCount x := by
            rw [voterOpinionCount_sum_voterNeighbor]
            simp [voterOpinionCount]
      _ = Fintype.card (VoterSite d L) * voterOpinionCount x := by ring
  calc
    ∑ c : VoterUpdateChoice d L, voterOpinionCount (voterModelStep x c.1 c.2)
        = ∑ u : VoterNeighborChoice d, ∑ i : VoterSite d L,
            voterOpinionCount (voterModelStep x i u) := by
          rw [Fintype.sum_prod_type]
          exact Finset.sum_comm
    _ = ∑ _u : VoterNeighborChoice d, Fintype.card (VoterSite d L) * voterOpinionCount x := by
          refine Finset.sum_congr rfl ?_
          intro u hu
          exact hDirection u
    _ = Fintype.card (VoterUpdateChoice d L) * voterOpinionCount x := by
          simp [VoterUpdateChoice, mul_assoc, mul_comm]

/-- Helper for Example 11.16: every unanimous configuration is fixed by a single voter-model
update. -/
theorem voterModelStep_unanimous {d : ℕ+} {L : ℕ+} (b : Bool) (i : VoterSite d L)
    (u : VoterNeighborChoice d) :
    voterModelStep (unanimousVoterConfig d L b) i u = unanimousVoterConfig d L b := by
  -- A unanimous state already agrees with each chosen neighbor, so the update is trivial.
  ext j
  by_cases hji : j = i
  · simp [voterModelStep, unanimousVoterConfig, hji]
  · simp [voterModelStep, unanimousVoterConfig, hji]

/-- Helper for Example 11.16: the opinion count is bounded between `0` and the number of sites. -/
theorem voterOpinionCount_nonneg_le_card {d : ℕ+} {L : ℕ+} (x : VoterConfig d L) :
    0 ≤ voterOpinionCount x ∧ voterOpinionCount x ≤ Fintype.card (VoterSite d L) := by
  classical
  constructor
  · -- Each summand in the count is either `0` or `1`.
    refine Finset.sum_nonneg ?_
    intro i hi
    split <;> norm_num
  · -- Compare each summand with `1` and sum the pointwise bounds.
    calc
      voterOpinionCount x = ∑ i : VoterSite d L, if x i then (1 : ℝ) else 0 := rfl
      _ ≤ ∑ _i : VoterSite d L, (1 : ℝ) := by
        refine Finset.sum_le_sum ?_
        intro i hi
        split <;> norm_num
      _ = Fintype.card (VoterSite d L) := by simp

/-- Helper for Example 11.16: a unanimous opinion-`b` configuration has either `0` or the full
number of opinion-`1` sites, according to `b`. -/
theorem voterOpinionCount_unanimous {d : ℕ+} {L : ℕ+} (b : Bool) :
    voterOpinionCount (unanimousVoterConfig d L b) =
      if b then Fintype.card (VoterSite d L) else 0 := by
  -- All summands are identical in a unanimous configuration.
  by_cases hb : b
  · simp [unanimousVoterConfig, voterOpinionCount, hb]
  · simp [unanimousVoterConfig, voterOpinionCount, hb]

/-- Helper for Example 11.16: eventual consensus is exactly eventual absorption in one of the two
unanimous configurations. -/
theorem eventuallyConsensus_eq_union {d : ℕ+} {L : ℕ+} (x0 : VoterConfig d L) :
    eventuallyConsensus x0 =
      eventuallyConstantOpinion x0 false ∪ eventuallyConstantOpinion x0 true := by
  ext ω
  -- Expand the Boolean-valued consensus choice into its two possible values.
  simp [eventuallyConsensus, Set.mem_union]

/-- Helper for Example 11.16: the two unanimous absorption events are disjoint. -/
theorem disjoint_eventuallyConstantOpinion {d : ℕ+} {L : ℕ+} (x0 : VoterConfig d L) :
    Disjoint (eventuallyConstantOpinion x0 false) (eventuallyConstantOpinion x0 true) := by
  refine Set.disjoint_left.2 ?_
  intro ω hFalse hTrue
  rcases hFalse with ⟨nFalse, hnFalse⟩
  rcases hTrue with ⟨nTrue, hnTrue⟩
  -- Compare the two alleged eventual values at a common late time.
  have hEq :
      unanimousVoterConfig d L false = unanimousVoterConfig d L true := by
    let n := max nFalse nTrue
    exact (hnFalse n (le_max_left _ _)).symm.trans (hnTrue n (le_max_right _ _))
  have hBool : (false : Bool) = true := by
    simpa [unanimousVoterConfig] using
      congrArg (fun x => x (default : VoterSite d L)) hEq
  cases hBool

/-- Helper for Example 11.16: after discarding the dummy time-`0` coordinate, the natural
filtration of the lagged update history agrees with the natural filtration of the raw update
choices. -/
theorem voterUpdateHistoryNaturalFiltration_succ_eq_evalNatural {d : ℕ+} {L : ℕ+} (n : ℕ) :
    (Filtration.natural voterUpdateHistory voterUpdateHistory_stronglyMeasurable (n + 1) :
      MeasurableSpace (VoterTrajectory d L)) =
      Filtration.natural
        (Function.eval : ℕ → VoterTrajectory d L → VoterUpdateChoice d L)
        (fun k ↦ voterTrajectoryEval_stronglyMeasurable (d := d) (L := L) k) n := by
  -- Proof comment: unfold the two natural filtrations, split off the dummy time-`0` history
  -- coordinate, and simplify it to `⊥`.
  simp only [Filtration.natural]
  rw [← sup_iSup_nat_succ
    (fun j : ℕ ↦
      ⨆ _h : j ≤ n + 1,
        MeasurableSpace.comap
          (voterUpdateHistory j : VoterTrajectory d L → VoterUpdateChoice d L) inferInstance)]
  simp [voterUpdateHistory]

/-- Helper for Example 11.16: the time-`0` sigma-algebra of the lagged update history is trivial,
because the zeroth history coordinate is the constant dummy update choice. -/
theorem voterUpdateHistoryNaturalFiltration_zero_eq_bot {d : ℕ+} {L : ℕ+} :
    (Filtration.natural voterUpdateHistory voterUpdateHistory_stronglyMeasurable 0 :
      MeasurableSpace (VoterTrajectory d L)) = ⊥ := by
  -- Proof comment: at time `0`, the natural filtration is generated only by the constant dummy
  -- history coordinate, whose comap sigma-algebra is `⊥`.
  simp [Filtration.natural, voterUpdateHistory]

/-- Helper for Example 11.16: the cylinder event `{ω | ω n = c}` is measurable in the voter-model
trajectory space. -/
theorem measurableSet_updateChoiceEvent {d : ℕ+} {L : ℕ+} (c : VoterUpdateChoice d L) (n : ℕ) :
    MeasurableSet {ω : VoterTrajectory d L | ω n = c} := by
  -- Proof comment: fixing one coordinate in the product space gives a measurable cylinder set.
  change MeasurableSet ((Function.eval n : VoterTrajectory d L → VoterUpdateChoice d L) ⁻¹' {c})
  exact measurableSet_preimage (measurable_pi_apply n) (measurableSet_singleton c)

/-- Helper for Example 11.16: the coordinate cylinder events `{ω | ω n = c}` form an independent
family under the i.i.d. product law of update choices. -/
theorem iIndepSet_updateChoiceEvent {d : ℕ+} {L : ℕ+} (c : VoterUpdateChoice d L) :
    iIndepSet (fun n ↦ {ω : VoterTrajectory d L | ω n = c}) (voterTrajectoryMeasure d L) := by
  -- Proof comment: the coordinate evaluations on the infinite product space are independent, and
  -- each cylinder event `{ω | ω n = c}` is the preimage of a singleton under the `n`th
  -- coordinate map.
  rw [iIndepSet_iff_meas_biInter (measurableSet_updateChoiceEvent c)]
  intro s
  have hIndepFun :
      iIndepFun (fun n (ω : VoterTrajectory d L) => ω n) (voterTrajectoryMeasure d L) := by
    simpa [voterTrajectoryMeasure] using
      (iIndepFun_infinitePi
        (P := fun _ : ℕ ↦ (PMF.uniformOfFintype (VoterUpdateChoice d L)).toMeasure)
        (X := fun _ ↦ id)
        (mX := fun _ ↦ measurable_id))
  simpa using
    hIndepFun.measure_inter_preimage_eq_mul s (fun n _ ↦ measurableSet_singleton c)

/-- Helper for Example 11.16: the uniform product law gives each single update choice the same
one-step `ENNReal`-mass. -/
noncomputable def voterUpdateChoiceUniformMass (d : ℕ+) (L : ℕ+) : ENNReal :=
  (((Fintype.card (VoterUpdateChoice d L) : ℕ) : ENNReal)⁻¹)

/-- Helper for Example 11.16: the real-valued mass of a single update choice under the uniform
driving law. -/
noncomputable def voterUpdateChoiceUniformMassReal (d : ℕ+) (L : ℕ+) : ℝ :=
  (voterUpdateChoiceUniformMass d L).toReal

/-- Helper for Example 11.16: every fixed update choice has the same one-step probability under
the uniform voter-model driving law. -/
theorem measure_updateChoiceEvent_eq_uniform {d : ℕ+} {L : ℕ+} (c : VoterUpdateChoice d L)
    (n : ℕ) :
    voterTrajectoryMeasure d L {ω : VoterTrajectory d L | ω n = c} =
      voterUpdateChoiceUniformMass d L := by
  -- Proof comment: evaluate the cylinder event by pushing the product measure forward to the
  -- `n`th coordinate, where it becomes the uniform law on update choices.
  let μ : Measure (VoterTrajectory d L) := voterTrajectoryMeasure d L
  have h :
      MeasurePreserving (Function.eval n) μ
        ((PMF.uniformOfFintype (VoterUpdateChoice d L)).toMeasure) := by
    simpa [μ, voterTrajectoryMeasure] using
      measurePreserving_eval_infinitePi
        (fun _ : ℕ ↦ (PMF.uniformOfFintype (VoterUpdateChoice d L)).toMeasure) n
  calc
    μ {ω : VoterTrajectory d L | ω n = c}
        = ((PMF.uniformOfFintype (VoterUpdateChoice d L)).toMeasure) {c} := by
            rw [← h.map_eq]
            symm
            exact Measure.map_apply h.measurable (measurableSet_singleton c)
    _ = voterUpdateChoiceUniformMass d L := by
          rw [PMF.toMeasure_apply_singleton _ _ (measurableSet_singleton c)]
          simp [PMF.uniformOfFintype_apply, voterUpdateChoiceUniformMass]

/-- Helper for Example 11.16: the indicator of a fixed update choice has mean
`(card (VoterUpdateChoice d L))⁻¹`. -/
theorem updateChoiceIndicator_integral_eq_uniform {d : ℕ+} {L : ℕ+} (c : VoterUpdateChoice d L)
    (n : ℕ) :
    ∫ ω, (if ω n = c then (1 : ℝ) else 0) ∂ voterTrajectoryMeasure d L =
      voterUpdateChoiceUniformMassReal d L := by
  -- Proof comment: this is the integral of the indicator of the measurable cylinder event
  -- `{ω | ω n = c}`, hence it equals that event's probability.
  let s : Set (VoterTrajectory d L) := {ω : VoterTrajectory d L | ω n = c}
  have hIndicator :
      (fun ω : VoterTrajectory d L ↦ if ω n = c then (1 : ℝ) else 0) =
        s.indicator (fun _ ↦ (1 : ℝ)) := by
    funext ω
    by_cases hω : ω n = c
    · change (if ω ∈ s then (1 : ℝ) else 0) = s.indicator (fun _ ↦ (1 : ℝ)) ω
      simp [s, hω]
    · change (if ω ∈ s then (1 : ℝ) else 0) = s.indicator (fun _ ↦ (1 : ℝ)) ω
      simp [s, hω]
  calc
    ∫ ω, (if ω n = c then (1 : ℝ) else 0) ∂ voterTrajectoryMeasure d L
        = ∫ ω, s.indicator (fun _ ↦ (1 : ℝ)) ω ∂ voterTrajectoryMeasure d L := by
            rw [hIndicator]
    _ = (voterTrajectoryMeasure d L).real s := by
          simpa using integral_indicator_one (μ := voterTrajectoryMeasure d L)
            (hs := measurableSet_updateChoiceEvent c n)
    _ = (voterUpdateChoiceUniformMass d L).toReal := by
          rw [Measure.real_def, measure_updateChoiceEvent_eq_uniform]
    _ = voterUpdateChoiceUniformMassReal d L := by
          rfl

/-- Helper for Example 11.16: conditioning the next update-choice indicator on the raw past
coordinate filtration returns the uniform mean `(card (VoterUpdateChoice d L))⁻¹`. -/
theorem condExp_updateChoiceIndicator_evalNatural_ae_eq_uniform {d : ℕ+} {L : ℕ+} (n : ℕ)
    (c : VoterUpdateChoice d L) :
    (voterTrajectoryMeasure d L)[(fun ω ↦
      if ω (n + 1) = c then (1 : ℝ) else 0) |
      Filtration.natural
        (Function.eval : ℕ → VoterTrajectory d L → VoterUpdateChoice d L)
        (fun k ↦ voterTrajectoryEval_stronglyMeasurable (d := d) (L := L) k) n]
        =ᵐ[(voterTrajectoryMeasure d L)]
      fun _ ↦ voterUpdateChoiceUniformMassReal d L := by
  let f : VoterTrajectory d L → ℝ := fun ω ↦
    if ω (n + 1) = c then (1 : ℝ) else 0
  have hIndepFun :
      iIndepFun (fun k (ω : VoterTrajectory d L) => ω k) (voterTrajectoryMeasure d L) := by
    simpa [voterTrajectoryMeasure] using
      (iIndepFun_infinitePi
        (P := fun _ : ℕ ↦ (PMF.uniformOfFintype (VoterUpdateChoice d L)).toMeasure)
        (X := fun _ ↦ id)
        (mX := fun _ ↦ measurable_id))
  have hf :
      StronglyMeasurable[
        MeasurableSpace.comap
          (Function.eval (n + 1) : VoterTrajectory d L → VoterUpdateChoice d L)
          inferInstance] f := by
    -- Proof comment: `f` is a measurable function of the single fresh coordinate `ω (n + 1)`.
    have hIndicator :
        StronglyMeasurable (fun x : VoterUpdateChoice d L ↦ if x = c then (1 : ℝ) else 0) := by
      exact StronglyMeasurable.of_discrete
    simpa [f] using
      hIndicator.comp_measurable (measurable_iff_comap_le.mpr le_rfl)
  have hCond :
      (voterTrajectoryMeasure d L)[f |
        Filtration.natural
          (Function.eval : ℕ → VoterTrajectory d L → VoterUpdateChoice d L)
          (fun k ↦ voterTrajectoryEval_stronglyMeasurable (d := d) (L := L) k) n]
        =ᵐ[(voterTrajectoryMeasure d L)] fun _ ↦ ∫ ω, f ω ∂ voterTrajectoryMeasure d L := by
    have hIndep :
        Indep
          (MeasurableSpace.comap
            (Function.eval (n + 1) : VoterTrajectory d L → VoterUpdateChoice d L) inferInstance)
          (Filtration.natural
            (Function.eval : ℕ → VoterTrajectory d L → VoterUpdateChoice d L)
            (fun k ↦ voterTrajectoryEval_stronglyMeasurable (d := d) (L := L) k) n)
          (voterTrajectoryMeasure d L) := by
      suffices
          Indep
            (⨆ k ∈ ({n + 1} : Set ℕ),
              MeasurableSpace.comap
                (Function.eval k : VoterTrajectory d L → VoterUpdateChoice d L) inferInstance)
            (⨆ k ∈ {k : ℕ | k ≤ n},
              MeasurableSpace.comap
                (Function.eval k : VoterTrajectory d L → VoterUpdateChoice d L) inferInstance)
            (voterTrajectoryMeasure d L) by
        simpa [Filtration.natural, iSup_singleton] using this
      exact indep_iSup_of_disjoint
        (fun k ↦ (measurable_pi_apply k).comap_le)
        hIndepFun.iIndep
        (by simp)
    exact MeasureTheory.condExp_indep_eq
      (hle₁ := (measurable_pi_apply (n + 1)).comap_le)
      (hle₂ := Filtration.le _ _)
      hf
      hIndep
  -- Proof comment: the resulting integral is exactly the uniform mean of the indicator.
  have hInt :
      ∫ ω, f ω ∂ voterTrajectoryMeasure d L = voterUpdateChoiceUniformMassReal d L := by
    simpa [f] using
      updateChoiceIndicator_integral_eq_uniform (d := d) (L := L) (c := c) (n := n + 1)
  have hConst :
      (fun _ : VoterTrajectory d L ↦ ∫ ω, f ω ∂ voterTrajectoryMeasure d L) =
        fun _ ↦ voterUpdateChoiceUniformMassReal d L := by
    funext _
    exact hInt
  refine hCond.trans ?_
  exact Filter.EventuallyEq.of_eq hConst

/-- Helper for Example 11.16: conditioning the `n`th update-choice indicator on the textbook
history filtration also returns the uniform mean `(card (VoterUpdateChoice d L))⁻¹`. -/
theorem condExp_updateChoiceIndicator_history_ae_eq_uniform {d : ℕ+} {L : ℕ+} (n : ℕ)
    (c : VoterUpdateChoice d L) :
    (voterTrajectoryMeasure d L)[(fun ω ↦
      if ω n = c then (1 : ℝ) else 0) |
      Filtration.natural voterUpdateHistory voterUpdateHistory_stronglyMeasurable n]
        =ᵐ[(voterTrajectoryMeasure d L)] fun _ ↦
          voterUpdateChoiceUniformMassReal d L := by
  cases n with
  | zero =>
      rw [voterUpdateHistoryNaturalFiltration_zero_eq_bot]
      -- Proof comment: at time `0` the history filtration is trivial, so the conditional
      -- expectation is the constant mean of the time-`0` indicator.
      have hBot :
          (voterTrajectoryMeasure d L)[(fun ω : VoterTrajectory d L ↦
            if ω 0 = c then (1 : ℝ) else 0) | (⊥ : MeasurableSpace (VoterTrajectory d L))]
            =ᵐ[(voterTrajectoryMeasure d L)]
              fun _ ↦ ∫ ω : VoterTrajectory d L, (if ω 0 = c then (1 : ℝ) else 0)
                ∂ voterTrajectoryMeasure d L := by
        exact Filter.EventuallyEq.of_eq
          (MeasureTheory.condExp_bot (μ := voterTrajectoryMeasure d L)
            (f := fun ω : VoterTrajectory d L ↦ if ω 0 = c then (1 : ℝ) else 0))
      have hInt :
          ∫ ω : VoterTrajectory d L, (if ω 0 = c then (1 : ℝ) else 0)
              ∂ voterTrajectoryMeasure d L =
            voterUpdateChoiceUniformMassReal d L := by
        simpa using updateChoiceIndicator_integral_eq_uniform (d := d) (L := L) (c := c) (n := 0)
      have hConst :
          (fun _ : VoterTrajectory d L ↦
            ∫ ω : VoterTrajectory d L, (if ω 0 = c then (1 : ℝ) else 0)
              ∂ voterTrajectoryMeasure d L) =
            fun _ ↦ voterUpdateChoiceUniformMassReal d L := by
        funext _
        exact hInt
      refine hBot.trans ?_
      exact Filter.EventuallyEq.of_eq hConst
  | succ n =>
      rw [voterUpdateHistoryNaturalFiltration_succ_eq_evalNatural]
      simpa using condExp_updateChoiceIndicator_evalNatural_ae_eq_uniform (n := n) c

/-- Helper for Example 11.16: every fixed update choice occurs infinitely often almost surely
under the i.i.d. voter-model driving law. -/
theorem ae_mem_limsup_updateChoice_singleton {d : ℕ+} {L : ℕ+} (c : VoterUpdateChoice d L) :
    ∀ᵐ ω ∂ (voterTrajectoryMeasure d L),
      ω ∈ Filter.limsup (fun n ↦ {ω : VoterTrajectory d L | ω n = c}) Filter.atTop := by
  let μ : Measure (VoterTrajectory d L) := voterTrajectoryMeasure d L
  let p : ENNReal := voterUpdateChoiceUniformMass d L
  have hCardNeTop : (Fintype.card (VoterUpdateChoice d L) : ENNReal) ≠ ⊤ := by
    exact ENNReal.natCast_ne_top _
  have hp_ne_zero : p ≠ 0 := by
    simpa [p, voterUpdateChoiceUniformMass] using ENNReal.inv_ne_zero.mpr hCardNeTop
  have hSeries :
      (∑' n, μ ({ω : VoterTrajectory d L | ω n = c})) = ⊤ := by
    have hConst :
        ∀ n, μ ({ω : VoterTrajectory d L | ω n = c}) = p := by
      intro n
      simp [μ, p, measure_updateChoiceEvent_eq_uniform]
    simpa [hConst] using
      (ENNReal.tsum_const_eq_top_of_ne_zero (α := ℕ) (c := p) hp_ne_zero)
  -- Proof comment: the singleton cylinder events are independent and have a divergent total mass,
  -- so the second Borel-Cantelli lemma yields almost-sure membership in the limsup event.
  exact
    (MeasureTheory.mem_ae_iff_prob_eq_one
      (MeasurableSet.measurableSet_limsup (measurableSet_updateChoiceEvent c))).2
      (ProbabilityTheory.measure_limsup_eq_one
        (μ := μ)
        (s := fun n ↦ {ω : VoterTrajectory d L | ω n = c})
        (measurableSet_updateChoiceEvent c)
        (iIndepSet_updateChoiceEvent c)
        hSeries)

/-- Helper for Example 11.16: a one-step voter update preserves the total number of opinion-`1`
sites exactly when the update leaves the whole configuration unchanged. -/
theorem voterModelStep_eq_self_iff_opinionCount_eq {d : ℕ+} {L : ℕ+} (x : VoterConfig d L)
    (i : VoterSite d L) (u : VoterNeighborChoice d) :
    voterModelStep x i u = x ↔
      voterOpinionCount (voterModelStep x i u) = voterOpinionCount x := by
  constructor
  · intro hStep
    simp [hStep]
  · intro hCount
    -- Proof comment: the explicit one-step count formula forces the copied opinion to equal the
    -- old opinion at the updated site, so the whole update is the identity.
    have hFormula := voterOpinionCount_voterModelStep x i u
    rw [hCount] at hFormula
    have hCopied :
        x (voterNeighbor i u) = x i := by
      by_cases hi : x i
      · by_cases hNeighbor : x (voterNeighbor i u)
        · simp [hi, hNeighbor]
        · exfalso
          have : (1 : ℝ) = 0 := by
            simpa [hi, hNeighbor] using hFormula.symm
          norm_num at this
      · by_cases hNeighbor : x (voterNeighbor i u)
        · exfalso
          have : (0 : ℝ) = 1 := by
            simpa [hi, hNeighbor] using hFormula.symm
          norm_num at this
        · simp [hi, hNeighbor]
    ext j
    by_cases hji : j = i
    · subst hji
      simp [voterModelStep, hCopied]
    · simp [voterModelStep, hji]

/-- Helper for Example 11.16: after `n + 1` raw update coordinates are revealed, the voter-model
configuration at time `n + 1` is measurable with respect to that raw-coordinate natural
filtration. -/
theorem voterModelProcess_adapted_raw {d : ℕ+} {L : ℕ+} (x0 : VoterConfig d L) :
    Adapted
      (Filtration.natural
        (Function.eval : ℕ → VoterTrajectory d L → VoterUpdateChoice d L)
        (fun k ↦ voterTrajectoryEval_stronglyMeasurable (d := d) (L := L) k))
      (fun n ω ↦ voterModelProcess x0 (n + 1) ω) := by
  let ℱ : Filtration ℕ _ :=
    Filtration.natural
      (Function.eval : ℕ → VoterTrajectory d L → VoterUpdateChoice d L)
      (fun k ↦ voterTrajectoryEval_stronglyMeasurable (d := d) (L := L) k)
  let U : ℕ → VoterTrajectory d L → VoterUpdateChoice d L := Function.eval
  let hEvalAdapted :
      Adapted ℱ U :=
    (Filtration.stronglyAdapted_natural
      (u := U)
      (hum := fun k ↦ voterTrajectoryEval_stronglyMeasurable (d := d) (L := L) k)).adapted
  intro n
  induction n with
  | zero =>
      have hStep :
          Measurable
            (fun y : VoterUpdateChoice d L ↦ voterModelStep x0 y.1 y.2) :=
        measurable_of_finite _
      simpa [voterModelProcess] using hStep.comp (hEvalAdapted 0)
  | succ n ih =>
      have hStep :
          Measurable
            (fun y : VoterConfig d L × VoterUpdateChoice d L ↦
              voterModelStep y.1 y.2.1 y.2.2) :=
        measurable_of_finite _
      have ih' :
          Measurable[ℱ (n + 1)] (fun ω : VoterTrajectory d L ↦ voterModelProcess x0 (n + 1) ω) :=
        ih.mono (ℱ.mono (Nat.le_succ n)) le_rfl
      have hEvalMeas :
          Measurable[ℱ (n + 1)] (fun ω : VoterTrajectory d L ↦ ω (n + 1)) := by
        simpa [U] using hEvalAdapted (n + 1)
      have hPair :
          Measurable[ℱ (n + 1)]
            (fun ω : VoterTrajectory d L ↦ (voterModelProcess x0 (n + 1) ω, ω (n + 1))) :=
        by
          let _ : MeasurableSpace (VoterTrajectory d L) := ℱ (n + 1)
          exact measurable_to_countable'
            (f := fun ω : VoterTrajectory d L ↦ (voterModelProcess x0 (n + 1) ω, ω (n + 1)))
            (fun y ↦ by
              have hFiber :
                  ((fun ω : VoterTrajectory d L ↦ (voterModelProcess x0 (n + 1) ω, ω (n + 1)))
                    ⁻¹' {y}) =
                    ((fun ω : VoterTrajectory d L ↦ voterModelProcess x0 (n + 1) ω) ⁻¹' {y.1} ∩
                      (fun ω : VoterTrajectory d L ↦ ω (n + 1)) ⁻¹' {y.2}) := by
                rcases y with ⟨y₁, y₂⟩
                ext ω
                simp
              rw [hFiber]
              exact (ih' (measurableSet_singleton y.1)).inter
                (hEvalMeas (measurableSet_singleton y.2)))
      simpa [voterModelProcess] using hStep.comp hPair

/-- Helper for Example 11.16: the voter-model configuration process is adapted to the lagged
history filtration generated by the update choices seen so far. -/
theorem voterModelProcess_adapted {d : ℕ+} {L : ℕ+} (x0 : VoterConfig d L) :
    Adapted
      (Filtration.natural
        (voterUpdateHistory : ℕ → VoterTrajectory d L → VoterUpdateChoice d L)
        voterUpdateHistory_stronglyMeasurable)
      (voterModelProcess x0) := by
  intro n
  cases n with
  | zero =>
      change Measurable[(
        Filtration.natural
          (voterUpdateHistory : ℕ → VoterTrajectory d L → VoterUpdateChoice d L)
          voterUpdateHistory_stronglyMeasurable) 0]
        (fun _ : VoterTrajectory d L ↦ x0)
      exact measurable_const
  | succ n =>
      rw [voterUpdateHistoryNaturalFiltration_succ_eq_evalNatural]
      simpa using voterModelProcess_adapted_raw (x0 := x0) n

/-- Helper for Example 11.16: the opinion-count process is strongly adapted to the lagged history
filtration. -/
theorem voterOpinionCountProcess_stronglyAdapted {d : ℕ+} {L : ℕ+} (x0 : VoterConfig d L) :
    StronglyAdapted
      (Filtration.natural
        (voterUpdateHistory : ℕ → VoterTrajectory d L → VoterUpdateChoice d L)
        voterUpdateHistory_stronglyMeasurable)
      (voterOpinionCountProcess x0) := by
  let ℱ : Filtration ℕ _ :=
    Filtration.natural
      (voterUpdateHistory : ℕ → VoterTrajectory d L → VoterUpdateChoice d L)
      voterUpdateHistory_stronglyMeasurable
  have hCount : Measurable (voterOpinionCount : VoterConfig d L → ℝ) := Measurable.of_discrete
  -- Proof comment: the count process is the measurable image of the adapted configuration
  -- process under the finite-valued map `voterOpinionCount`.
  exact Adapted.stronglyAdapted (hf := ((fun n ↦
    hCount.comp (voterModelProcess_adapted (x0 := x0) n)) :
      Adapted ℱ (voterOpinionCountProcess x0)))

/-- Helper for Example 11.16: each time slice of the opinion-count process is integrable because
it is uniformly bounded by the finite number of voter sites. -/
theorem voterOpinionCountProcess_integrable {d : ℕ+} {L : ℕ+} (x0 : VoterConfig d L) :
    ∀ n, Integrable (voterOpinionCountProcess x0 n) (voterTrajectoryMeasure d L) := by
  let ℱ : Filtration ℕ _ :=
    Filtration.natural
      (voterUpdateHistory : ℕ → VoterTrajectory d L → VoterUpdateChoice d L)
      voterUpdateHistory_stronglyMeasurable
  intro n
  have hMeas :
      AEStronglyMeasurable (voterOpinionCountProcess x0 n) (voterTrajectoryMeasure d L) :=
    ((voterOpinionCountProcess_stronglyAdapted (x0 := x0) n).mono (ℱ.le n)).aestronglyMeasurable
  have hBound :
      ∀ᵐ ω ∂ voterTrajectoryMeasure d L,
        ‖voterOpinionCountProcess x0 n ω‖ ≤ Fintype.card (VoterSite d L) := by
    filter_upwards [Filter.Eventually.of_forall fun ω ↦
      voterOpinionCount_nonneg_le_card (voterModelProcess x0 n ω)] with ω hω
    have hnonneg :
        0 ≤ voterOpinionCount (voterModelProcess x0 n ω) := by
      simpa [voterOpinionCountProcess] using hω.1
    change ‖voterOpinionCount (voterModelProcess x0 n ω)‖ ≤ Fintype.card (VoterSite d L)
    simpa [Real.norm_of_nonneg hnonneg] using hω.2
  -- Proof comment: the finite site count provides an `L¹`-dominating constant.
  exact Integrable.mono' (integrable_const (Fintype.card (VoterSite d L) : ℝ)) hMeas hBound

/-- Helper for Example 11.16: the next opinion count is a finite sum over the unique fresh update
choice selected at time `n`. -/
theorem voterOpinionCountProcess_succ_eq_updateChoiceSum {d : ℕ+} {L : ℕ+}
    (x0 : VoterConfig d L) (n : ℕ) :
    voterOpinionCountProcess x0 (n + 1) =
      fun ω ↦
        ∑ c : VoterUpdateChoice d L,
          (if ω n = c then (1 : ℝ) else 0) *
            voterOpinionCount (voterModelStep (voterModelProcess x0 n ω) c.1 c.2) := by
  classical
  funext ω
  -- Proof comment: exactly one update choice contributes, namely the realized fresh choice `ω n`.
  symm
  rw [Finset.sum_eq_single (ω n)]
  · simp [voterOpinionCountProcess, voterModelProcess]
  · intro c _ hc
    simp [hc, eq_comm]
  · simp

/-- Helper for Example 11.16: conditioning the next opinion count on the lagged history
filtration returns the current count. -/
theorem condExp_voterOpinionCountProcess_succ_ae_eq {d : ℕ+} {L : ℕ+}
    (x0 : VoterConfig d L) :
    ∀ n,
      (voterTrajectoryMeasure d L)[voterOpinionCountProcess x0 (n + 1) |
        Filtration.natural
          (voterUpdateHistory : ℕ → VoterTrajectory d L → VoterUpdateChoice d L)
          voterUpdateHistory_stronglyMeasurable n]
        =ᵐ[voterTrajectoryMeasure d L] voterOpinionCountProcess x0 n := by
  let ℱ : Filtration ℕ _ :=
    Filtration.natural
      (voterUpdateHistory : ℕ → VoterTrajectory d L → VoterUpdateChoice d L)
      voterUpdateHistory_stronglyMeasurable
  intro n
  classical
  let coeff : VoterUpdateChoice d L → VoterTrajectory d L → ℝ := fun c ω ↦
    voterOpinionCount (voterModelStep (voterModelProcess x0 n ω) c.1 c.2)
  let ind : VoterUpdateChoice d L → VoterTrajectory d L → ℝ := fun c ω ↦
    if ω n = c then (1 : ℝ) else 0
  have hIndEq : ∀ c,
      ind c = {ω : VoterTrajectory d L | ω n = c}.indicator (fun _ ↦ (1 : ℝ)) := by
    intro c
    funext ω
    by_cases hω : ω n = c <;> simp [ind, hω]
  have hCoeffStrong : ∀ c, StronglyMeasurable[ℱ n] (coeff c) := by
    intro c
    have hCoeffMeas :
        Measurable[ℱ n] (coeff c) :=
      (Measurable.of_discrete :
        Measurable (fun x : VoterConfig d L ↦ voterOpinionCount (voterModelStep x c.1 c.2))).comp
        (voterModelProcess_adapted (x0 := x0) n)
    -- Proof comment: fixing the fresh update choice turns the coefficient into a measurable
    -- function of the current configuration alone.
    exact hCoeffMeas.stronglyMeasurable
  have hCoeffIntegrable : ∀ c, Integrable (coeff c) (voterTrajectoryMeasure d L) := by
    intro c
    have hMeas :
        AEStronglyMeasurable (coeff c) (voterTrajectoryMeasure d L) :=
      ((hCoeffStrong c).mono (ℱ.le n)).aestronglyMeasurable
    have hBound :
        ∀ᵐ ω ∂ voterTrajectoryMeasure d L,
          ‖coeff c ω‖ ≤ Fintype.card (VoterSite d L) := by
      filter_upwards [Filter.Eventually.of_forall fun ω ↦
        voterOpinionCount_nonneg_le_card
          (voterModelStep (voterModelProcess x0 n ω) c.1 c.2)] with ω hω
      have hnonneg : 0 ≤ coeff c ω := by
        simpa [coeff] using hω.1
      simpa [coeff, Real.norm_of_nonneg hnonneg] using hω.2
    exact Integrable.mono' (integrable_const (Fintype.card (VoterSite d L) : ℝ)) hMeas hBound
  have hIndIntegrable : ∀ c, Integrable (ind c) (voterTrajectoryMeasure d L) := by
    intro c
    rw [hIndEq c]
    exact ((integrable_const (1 : ℝ) : Integrable (fun _ : VoterTrajectory d L ↦ (1 : ℝ))
      (voterTrajectoryMeasure d L)).indicator (measurableSet_updateChoiceEvent c n))
  have hProdEqIndicator : ∀ c,
      (fun ω ↦ ind c ω * coeff c ω) =
        {ω : VoterTrajectory d L | ω n = c}.indicator (coeff c) := by
    intro c
    funext ω
    rw [hIndEq c]
    by_cases hω : ω n = c <;> simp [coeff, hω]
  have hSumRep :
      voterOpinionCountProcess x0 (n + 1) =
        ∑ c : VoterUpdateChoice d L, fun ω ↦ ind c ω * coeff c ω := by
    funext ω
    simp [ind, coeff, voterOpinionCountProcess_succ_eq_updateChoiceSum]
  have hProdIntegrable : ∀ c,
      Integrable (fun ω ↦ ind c ω * coeff c ω) (voterTrajectoryMeasure d L) := by
    intro c
    rw [hProdEqIndicator c]
    exact (hCoeffIntegrable c).indicator (measurableSet_updateChoiceEvent c n)
  calc
    (voterTrajectoryMeasure d L)[voterOpinionCountProcess x0 (n + 1) | ℱ n]
        =ᵐ[voterTrajectoryMeasure d L]
          (voterTrajectoryMeasure d L)[∑ c : VoterUpdateChoice d L,
            fun ω ↦ ind c ω * coeff c ω | ℱ n] := by
          refine condExp_congr_ae ?_
          exact Filter.EventuallyEq.of_eq hSumRep
    _ =ᵐ[voterTrajectoryMeasure d L]
          ∑ c : VoterUpdateChoice d L,
            (voterTrajectoryMeasure d L)[fun ω ↦ ind c ω * coeff c ω | ℱ n] := by
          simpa using
            (condExp_finset_sum
              (s := Finset.univ)
              (f := fun c ω ↦ ind c ω * coeff c ω)
              (fun c _ ↦ hProdIntegrable c) (ℱ n))
    _ =ᵐ[voterTrajectoryMeasure d L]
          ∑ c : VoterUpdateChoice d L,
            fun ω ↦ ((voterTrajectoryMeasure d L)[ind c | ℱ n] ω) * coeff c ω := by
          exact eventuallyEq_sum fun c _ =>
            condExp_mul_of_stronglyMeasurable_right
              (hCoeffStrong c) (hProdIntegrable c) (hIndIntegrable c)
    _ =ᵐ[voterTrajectoryMeasure d L]
          ∑ c : VoterUpdateChoice d L,
            fun ω ↦ voterUpdateChoiceUniformMassReal d L * coeff c ω := by
          exact eventuallyEq_sum fun c _ =>
            (condExp_updateChoiceIndicator_history_ae_eq_uniform (n := n) c).mul
              Filter.EventuallyEq.rfl
    _ =ᵐ[voterTrajectoryMeasure d L]
          fun ω ↦
            voterUpdateChoiceUniformMassReal d L *
              ∑ c : VoterUpdateChoice d L, coeff c ω := by
          refine Filter.EventuallyEq.of_eq ?_
          funext ω
          simp [Finset.mul_sum]
    _ =ᵐ[voterTrajectoryMeasure d L] voterOpinionCountProcess x0 n := by
          have hCardNe :
              (Fintype.card (VoterUpdateChoice d L) : ℝ) ≠ 0 := by
            exact_mod_cast (Fintype.card_ne_zero : Fintype.card (VoterUpdateChoice d L) ≠ 0)
          have hMass :
              voterUpdateChoiceUniformMassReal d L =
                (Fintype.card (VoterUpdateChoice d L) : ℝ)⁻¹ := by
            simp [voterUpdateChoiceUniformMassReal, voterUpdateChoiceUniformMass]
          refine Filter.EventuallyEq.of_eq ?_
          funext ω
          calc
            voterUpdateChoiceUniformMassReal d L *
                ∑ c : VoterUpdateChoice d L, coeff c ω
                =
                  (Fintype.card (VoterUpdateChoice d L) : ℝ)⁻¹ *
                    ((Fintype.card (VoterUpdateChoice d L) : ℝ) *
                      voterOpinionCount (voterModelProcess x0 n ω)) := by
                      simp [coeff, hMass, voterOpinionCountStepSum_eq_card_mul]
            _ = voterOpinionCount (voterModelProcess x0 n ω) := by
                  field_simp [hCardNe]
            _ = voterOpinionCountProcess x0 n ω := by rfl

-- Proof sketch: condition on the past update choices up to time `n - 1`, i.e. on
-- `σ((I_k, N_k) : k < n)`. The next update `(I_n, N_n)` is then independent of that past; exactly
-- one site changes, and the uniform choice of the updated site and neighbor keeps the conditional
-- expectation of the total number of `1`-opinions equal to its current value.
/-- The total number of opinion-`1` voters is a martingale for the natural filtration of the
driving update choices. -/
theorem voterOpinionCountProcess_martingale {d : ℕ+} {L : ℕ+} (x0 : VoterConfig d L) :
    Martingale (voterOpinionCountProcess x0)
      (Filtration.natural
        (voterUpdateHistory : ℕ → VoterTrajectory d L → VoterUpdateChoice d L)
        voterUpdateHistory_stronglyMeasurable)
      (voterTrajectoryMeasure d L) := by
  -- Route correction: reduce the martingale proof to a one-step kernel average instead of
  -- unfolding conditional expectation directly in the main theorem.
  refine martingale_nat (voterOpinionCountProcess_stronglyAdapted (x0 := x0))
    (voterOpinionCountProcess_integrable (x0 := x0)) ?_
  intro n
  -- Proof comment: the dedicated one-step conditional-expectation helper is exactly the
  -- martingale recursion required by `martingale_nat`.
  simpa using (condExp_voterOpinionCountProcess_succ_ae_eq (x0 := x0) n).symm

/-- Helper for Example 11.16: a real sequence whose values are all natural numbers is eventually
constant once it converges. -/
theorem tendsto_natValued_eventuallyConst {f : ℕ → ℝ} {l : ℝ}
    (hf_nat : ∀ n, ∃ k : ℕ, f n = k) (hf_tendsto : Filter.Tendsto f Filter.atTop (𝓝 l)) :
    Filter.EventuallyConst f Filter.atTop := by
  have hHalf :
      ∀ᶠ n in Filter.atTop, |f n - l| < (1 / 2 : ℝ) := by
    have hBall : ∀ᶠ n in Filter.atTop, f n ∈ Metric.ball l (1 / 2 : ℝ) :=
      hf_tendsto.eventually (Metric.ball_mem_nhds l (by norm_num))
    simpa [Metric.mem_ball, Real.dist_eq] using hBall
  rcases Filter.eventually_atTop.1 hHalf with ⟨n0, hn0⟩
  obtain ⟨k0, hk0⟩ := hf_nat n0
  rw [Filter.eventuallyConst_atTop]
  refine ⟨n0, ?_⟩
  intro n hn
  obtain ⟨kn, hkn⟩ := hf_nat n
  have hClose0 : |(k0 : ℝ) - l| < (1 / 2 : ℝ) := by simpa [hk0] using hn0 n0 le_rfl
  have hCloseN : |(kn : ℝ) - l| < (1 / 2 : ℝ) := by simpa [hkn] using hn0 n hn
  have hDiff : -1 < (kn : ℝ) - k0 ∧ (kn : ℝ) - k0 < 1 := by
    have hAbs :
        |(kn : ℝ) - k0| < 1 := by
      have hLe : |(kn : ℝ) - k0| ≤ |(kn : ℝ) - l| + |(k0 : ℝ) - l| := by
        simpa [abs_sub_comm, add_comm] using abs_sub_le (kn : ℝ) l k0
      have hLt : |(kn : ℝ) - l| + |(k0 : ℝ) - l| < 1 := by
        nlinarith [hCloseN, hClose0]
      exact lt_of_le_of_lt hLe hLt
    exact abs_lt.mp hAbs
  have hEqNat : kn = k0 := by
    by_contra hne
    rcases lt_or_gt_of_ne hne with hlt | hgt
    · have hStep : (kn : ℝ) - k0 ≤ -1 := by
        have hCast : (kn : ℝ) + 1 ≤ k0 := by
          exact_mod_cast Nat.succ_le_of_lt hlt
        linarith
      linarith
    · have hStep : (1 : ℝ) ≤ (kn : ℝ) - k0 := by
        have hCast : (k0 : ℝ) + 1 ≤ kn := by
          exact_mod_cast Nat.succ_le_of_lt hgt
        linarith
      linarith
  -- Proof comment: once two natural-valued terms lie within `1 / 2` of the same limit, they
  -- must coincide.
  rw [hkn, hk0, hEqNat]

/-- Helper for Example 11.16: the real-valued opinion count is always the cast of a natural
number. -/
theorem voterOpinionCount_natValued {d : ℕ+} {L : ℕ+} (x : VoterConfig d L) :
    ∃ k : ℕ, voterOpinionCount x = (k : ℝ) := by
  classical
  -- Proof comment: rewrite the Boolean sum in `ℕ` and then cast it to `ℝ`.
  refine ⟨∑ i : VoterSite d L, if x i then (1 : ℕ) else 0, ?_⟩
  simp [voterOpinionCount]

/-- Helper for Example 11.16: if every voter-model update fixes a configuration, then the
configuration is unanimous. -/
theorem existsChangingUpdateChoice_of_notUnanimous {d : ℕ+} {L : ℕ+} (x : VoterConfig d L)
    (hx : ¬ ∃ b : Bool, x = unanimousVoterConfig d L b) :
    ∃ c : VoterUpdateChoice d L, voterModelStep x c.1 c.2 ≠ x := by
  classical
  by_contra hNoChange
  have hFixed : ∀ i : VoterSite d L, ∀ u : VoterNeighborChoice d, voterModelStep x i u = x := by
    intro i u
    by_contra hStep
    exact hNoChange ⟨(i, u), hStep⟩
  have hNeighbor :
      ∀ i : VoterSite d L, ∀ u : VoterNeighborChoice d, x (voterNeighbor i u) = x i := by
    intro i u
    have hStep := hFixed i u
    simpa [voterModelStep] using congrArg (fun y : VoterConfig d L ↦ y i) hStep
  have hShift :
      ∀ (i : VoterSite d L) (k : Fin d) (m : ℕ),
        x (Function.update i k (i k + m)) = x i := by
    intro i k m
    induction m with
    | zero =>
        simp
    | succ m ihm =>
        let i' : VoterSite d L := Function.update i k (i k + m)
        have hStep : x (voterNeighbor i' (k, true)) = x i' := hNeighbor i' (k, true)
        have hCastUpdate :
            Function.update i k (i k + ((m + 1 : ℕ) : ZMod L)) =
              Function.update i k (i k + (m : ℕ) + 1) := by
          ext j
          by_cases hj : j = k
          · subst hj
            simp [Nat.cast_add, add_assoc]
          · simp [hj]
        have hNeighborForm :
            voterNeighbor i' (k, true) = Function.update i k (i k + m + 1) := by
          ext j
          by_cases hj : j = k
          · subst hj
            simp [voterNeighbor, i', add_assoc]
          · simp [voterNeighbor, i', hj]
        -- Proof comment: repeated positive neighbor moves along a fixed coordinate preserve the
        -- opinion if every one-step update is trivial.
        calc
          x (Function.update i k (i k + ((m + 1 : ℕ) : ZMod L))) =
              x (Function.update i k (i k + (m : ℕ) + 1)) := by
            rw [hCastUpdate]
          _ = x (voterNeighbor i' (k, true)) := by
            rw [hNeighborForm]
          _ = x i' := hStep
          _ = x i := ihm
  have hConstFromDefault :
      ∀ j : VoterSite d L, x j = x (default : VoterSite d L) := by
    intro j
    let partialSite : Finset (Fin d) → VoterSite d L := fun s k ↦ if k ∈ s then j k else 0
    have hPartial :
        ∀ s : Finset (Fin d), x (partialSite s) = x (default : VoterSite d L) := by
      intro s
      refine Finset.induction ?_ ?_ s
      · change x (fun _ ↦ (0 : ZMod L)) = x (default : VoterSite d L)
        rfl
      · intro a s ha hs
        let i : VoterSite d L := partialSite s
        have hAdvance := hShift i a (j a).val
        have hAdvanceForm :
            Function.update i a (i a + (j a).val) = partialSite (insert a s) := by
          ext k
          by_cases hk : k = a
          · subst hk
            simp [i, partialSite, ha, ZMod.natCast_val]
          · simp [i, partialSite, hk, ha]
        -- Proof comment: add one new coordinate of `j` at a time, using a positive torus step
        -- from the already constructed partial site.
        calc
          x (partialSite (insert a s)) = x (Function.update i a (i a + (j a).val)) := by
            rw [hAdvanceForm]
          _ = x i := hAdvance
          _ = x (default : VoterSite d L) := hs
    simpa [partialSite] using hPartial Finset.univ
  have hUnanimous : ∃ b : Bool, x = unanimousVoterConfig d L b := by
    refine ⟨x (default : VoterSite d L), ?_⟩
    ext j
    -- Proof comment: every site has the same opinion as the default torus site.
    simpa [unanimousVoterConfig] using hConstFromDefault j
  exact hx hUnanimous

/-- Helper for Example 11.16: if along one trajectory the opinion count eventually stops changing
and every update choice reappears arbitrarily late, then the trajectory eventually reaches one of
the two unanimous configurations. -/
theorem eventuallyConsensus_of_eventuallyConstCount_and_recurrentChoices
    {d : ℕ+} {L : ℕ+} (x0 : VoterConfig d L) (ω : VoterTrajectory d L)
    (hCount :
      Filter.EventuallyConst (fun n ↦ voterOpinionCountProcess x0 n ω) Filter.atTop)
    (hRecurrent :
      ∀ c : VoterUpdateChoice d L, ∀ N : ℕ, ∃ n ≥ N, ω n = c) :
    ω ∈ eventuallyConsensus x0 := by
  rw [Filter.eventuallyConst_atTop] at hCount
  rcases hCount with ⟨n0, hCount⟩
  let xTail := voterModelProcess x0 n0 ω
  have hFrozenStep :
      ∀ n ≥ n0, voterModelProcess x0 (n + 1) ω = voterModelProcess x0 n ω := by
    intro n hn
    have hEqCount :
        voterOpinionCountProcess x0 (n + 1) ω = voterOpinionCountProcess x0 n ω := by
      calc
        voterOpinionCountProcess x0 (n + 1) ω = voterOpinionCountProcess x0 n0 ω := by
          exact hCount (n + 1) (le_trans hn (Nat.le_succ n))
        _ = voterOpinionCountProcess x0 n ω := (hCount n hn).symm
    have hStepSelf :=
      (voterModelStep_eq_self_iff_opinionCount_eq
        (x := voterModelProcess x0 n ω) (i := (ω n).1) (u := (ω n).2)).2
        (by simpa [voterOpinionCountProcess, voterModelProcess] using hEqCount)
    -- Proof comment: a frozen count forces the realized update to be the identity step.
    simpa [voterModelProcess] using hStepSelf
  have hTailConst :
      ∀ n ≥ n0, voterModelProcess x0 n ω = xTail := by
    intro n hn
    have hShifted :
        voterModelProcess x0 (n0 + (n - n0)) ω = xTail := by
      induction (n - n0) with
      | zero =>
          simp [xTail]
      | succ k ih =>
          have hStep :
              voterModelProcess x0 (n0 + k + 1) ω = voterModelProcess x0 (n0 + k) ω := by
            simpa [Nat.add_assoc] using hFrozenStep (n0 + k) (Nat.le_add_right n0 k)
          calc
            voterModelProcess x0 (n0 + (k + 1)) ω = voterModelProcess x0 (n0 + k + 1) ω := by
              simp [Nat.add_assoc]
            _ = voterModelProcess x0 (n0 + k) ω := hStep
            _ = xTail := ih
    simpa [Nat.add_sub_of_le hn] using hShifted
  have hTailUnanimous : ∃ b : Bool, xTail = unanimousVoterConfig d L b := by
    by_contra hxTail
    obtain ⟨c, hc⟩ := existsChangingUpdateChoice_of_notUnanimous xTail hxTail
    obtain ⟨n, hn, hωn⟩ := hRecurrent c n0
    have hAtN : voterModelProcess x0 n ω = xTail := hTailConst n hn
    have hAtSucc : voterModelProcess x0 (n + 1) ω = xTail :=
      hTailConst (n + 1) (le_trans hn (Nat.le_succ n))
    have hChanged :
        voterModelProcess x0 (n + 1) ω = voterModelStep xTail c.1 c.2 := by
      -- Proof comment: at time `n`, the process is already frozen at `xTail`, and the realized
      -- update choice is exactly `c`.
      calc
        voterModelProcess x0 (n + 1) ω
            = voterModelStep (voterModelProcess x0 n ω) (ω n).1 (ω n).2 := by
              simp [voterModelProcess]
        _ = voterModelStep xTail c.1 c.2 := by simp [hAtN, hωn]
    exact hc (hChanged.symm.trans hAtSucc)
  rcases hTailUnanimous with ⟨b, hb⟩
  refine ⟨b, n0, ?_⟩
  intro n hn
  -- Proof comment: once the tail state is unanimous, the whole trajectory stays in that
  -- unanimous configuration.
  simpa [hb] using hTailConst n hn

/-- Helper for Example 11.16: the eventual absorption event in the unanimous opinion `b`
configuration is measurable. -/
theorem measurableSet_eventuallyConstantOpinion {d : ℕ+} {L : ℕ+} (x0 : VoterConfig d L)
    (b : Bool) :
    MeasurableSet (eventuallyConstantOpinion x0 b) := by
  let ℱ : Filtration ℕ _ :=
    Filtration.natural
      (voterUpdateHistory : ℕ → VoterTrajectory d L → VoterUpdateChoice d L)
      voterUpdateHistory_stronglyMeasurable
  have hEq :
      eventuallyConstantOpinion x0 b =
        ⋃ n0 : ℕ, ⋂ k : ℕ,
          {ω : VoterTrajectory d L |
            voterModelProcess x0 (n0 + k) ω = unanimousVoterConfig d L b} := by
    ext ω
    constructor
    · rintro ⟨n0, hn0⟩
      refine Set.mem_iUnion.2 ⟨n0, ?_⟩
      refine Set.mem_iInter.2 ?_
      intro k
      simpa using hn0 (n0 + k) (Nat.le_add_right n0 k)
    · intro hω
      rcases Set.mem_iUnion.1 hω with ⟨n0, hω⟩
      refine ⟨n0, ?_⟩
      intro n hn
      have hTail :
          voterModelProcess x0 (n0 + (n - n0)) ω = unanimousVoterConfig d L b :=
        Set.mem_iInter.1 hω (n - n0)
      simpa [Nat.add_sub_of_le hn] using hTail
  rw [hEq]
  refine MeasurableSet.iUnion ?_
  intro n0
  refine MeasurableSet.iInter ?_
  intro k
  have hProc : Measurable (voterModelProcess x0 (n0 + k)) :=
    Adapted.measurable (hf := voterModelProcess_adapted (x0 := x0)) (i := n0 + k)
  -- Proof comment: the absorption event is a countable union of countable intersections of
  -- measurable equality cylinders for the finite-valued configuration process.
  simpa [Set.preimage] using
    hProc (measurableSet_singleton (unanimousVoterConfig d L b))

-- Proof sketch: the opinion-count martingale is bounded by the finite number of sites, hence it
-- converges almost surely. Since it takes integer values, it can change only finitely many times
-- almost surely; any nonconstant configuration has a uniform positive probability to change at the
-- next step, so only the two unanimous configurations can be absorbing.
/-- The finite voter model reaches one of the two unanimous configurations almost surely. -/
theorem voterModel_ae_eventually_consensus {d : ℕ+} {L : ℕ+} (x0 : VoterConfig d L) :
    ∀ᵐ ω ∂ voterTrajectoryMeasure d L, ω ∈ eventuallyConsensus x0 := by
  -- Route correction: combine bounded martingale convergence for the opinion count with the
  -- exclusion of every non-unanimous frozen configuration.
  let μ : Measure (VoterTrajectory d L) := voterTrajectoryMeasure d L
  let ℱ : Filtration ℕ _ :=
    Filtration.natural
      (voterUpdateHistory : ℕ → VoterTrajectory d L → VoterUpdateChoice d L)
      voterUpdateHistory_stronglyMeasurable
  have hBound :
      ∀ n, eLpNorm (voterOpinionCountProcess x0 n) 1 μ ≤ Fintype.card (VoterSite d L) := by
    intro n
    refine (eLpNorm_le_of_ae_bound (μ := μ)
      (f := voterOpinionCountProcess x0 n) (C := Fintype.card (VoterSite d L)) ?_).trans ?_
    · filter_upwards [Filter.Eventually.of_forall fun ω ↦
        voterOpinionCount_nonneg_le_card (voterModelProcess x0 n ω)] with ω hω
      have hnonneg :
          0 ≤ voterOpinionCount (voterModelProcess x0 n ω) := by
        simpa [voterOpinionCountProcess] using hω.1
      change ‖voterOpinionCount (voterModelProcess x0 n ω)‖ ≤ Fintype.card (VoterSite d L)
      simpa [Real.norm_of_nonneg hnonneg] using hω.2
    · simp
  have hEventuallyConstCount :
      ∀ᵐ ω ∂ μ,
        Filter.EventuallyConst (fun n ↦ voterOpinionCountProcess x0 n ω) Filter.atTop := by
    filter_upwards
      [(voterOpinionCountProcess_martingale x0).submartingale.ae_tendsto_limitProcess hBound] with
      ω hω
    exact tendsto_natValued_eventuallyConst
      (fun n ↦ by
        obtain ⟨k, hk⟩ := voterOpinionCount_natValued (voterModelProcess x0 n ω)
        exact ⟨k, by simpa [voterOpinionCountProcess] using hk⟩)
      hω
  have hRecurrentChoices :
      ∀ᵐ ω ∂ μ, ∀ c : VoterUpdateChoice d L, ∀ N : ℕ, ∃ n ≥ N, ω n = c := by
    rw [Filter.eventually_all]
    intro c
    filter_upwards [ae_mem_limsup_updateChoice_singleton (c := c)] with ω hω
    -- Proof comment: membership in the limsup event means that the chosen update reappears after
    -- every time threshold.
    simpa [Filter.limsup_eq_iInf_iSup_of_nat] using hω
  filter_upwards [hEventuallyConstCount, hRecurrentChoices] with ω hCount hRecurrent
  exact eventuallyConsensus_of_eventuallyConstCount_and_recurrentChoices x0 ω hCount hRecurrent

/-- Helper for Example 11.16: almost surely, the opinion-count process converges to the indicator
of eventual `true` consensus multiplied by the number of voter sites. -/
theorem voterOpinionCountProcess_tendsto_trueConsensusIndicator_ae {d : ℕ+} {L : ℕ+}
    (x0 : VoterConfig d L) :
    ∀ᵐ ω ∂ voterTrajectoryMeasure d L,
      Filter.Tendsto (fun n ↦ voterOpinionCountProcess x0 n ω) Filter.atTop
        (𝓝 (Set.indicator (eventuallyConstantOpinion x0 true)
          (fun _ ↦ (Fintype.card (VoterSite d L) : ℝ)) ω)) := by
  filter_upwards [voterModel_ae_eventually_consensus (x0 := x0)] with ω hConsensus
  rcases hConsensus with ⟨q, n0, hq⟩
  have hEventually :
      ∀ n ≥ n0,
        voterOpinionCountProcess x0 n ω =
          Set.indicator (eventuallyConstantOpinion x0 true)
            (fun _ ↦ (Fintype.card (VoterSite d L) : ℝ)) ω := by
    intro n hn
    have hState : voterModelProcess x0 n ω = unanimousVoterConfig d L q := hq n hn
    by_cases hqTrue : q = true
    · have hEventTrue : ω ∈ eventuallyConstantOpinion x0 true := by
        refine ⟨n0, ?_⟩
        intro m hm
        simpa [hqTrue] using hq m hm
      have hCount :
          voterOpinionCountProcess x0 n ω = (Fintype.card (VoterSite d L) : ℝ) := by
        simpa [voterOpinionCountProcess, hState, hqTrue] using
          (voterOpinionCount_unanimous (d := d) (L := L) true)
      -- Proof comment: on the `true`-consensus branch, the limiting count is the full site
      -- cardinality and therefore matches the indicator-scaled target.
      simpa [Set.indicator_of_mem hEventTrue] using hCount
    · have hqFalse : q = false := by
        cases q <;> simp at hqTrue ⊢
      have hEventFalse : ω ∈ eventuallyConstantOpinion x0 false := by
        refine ⟨n0, ?_⟩
        intro m hm
        simpa [hqFalse] using hq m hm
      have hNotEventTrue : ω ∉ eventuallyConstantOpinion x0 true := by
        intro hEventTrue
        exact Set.disjoint_left.mp (disjoint_eventuallyConstantOpinion (x0 := x0))
          hEventFalse hEventTrue
      have hCount :
          voterOpinionCountProcess x0 n ω = 0 := by
        simpa [voterOpinionCountProcess, hState, hqFalse] using
          (voterOpinionCount_unanimous (d := d) (L := L) false)
      -- Proof comment: on the `false`-consensus branch, the indicator vanishes and the count is
      -- eventually `0`.
      simpa [Set.indicator_of_notMem hNotEventTrue] using hCount
  -- Proof comment: after the almost-sure consensus time, the count process is literally constant
  -- with the indicator-scaled value.
  exact tendsto_atTop_of_eventually_const hEventually

/-- Helper for Example 11.16: the indicator of eventual `true` consensus, scaled by the number
of sites, has expectation equal to the initial number of opinion-`1` voters. -/
theorem trueConsensusIndicator_integral_eq_initialCount {d : ℕ+} {L : ℕ+}
    (x0 : VoterConfig d L) :
    ∫ ω, Set.indicator (eventuallyConstantOpinion x0 true)
      (fun _ ↦ (Fintype.card (VoterSite d L) : ℝ)) ω ∂ voterTrajectoryMeasure d L =
      voterOpinionCount x0 := by
  let μ : Measure (VoterTrajectory d L) := voterTrajectoryMeasure d L
  let siteCard : ℝ := Fintype.card (VoterSite d L)
  have hBound :
      ∀ n, ∀ᵐ ω ∂ μ, ‖voterOpinionCountProcess x0 n ω‖ ≤ siteCard := by
    intro n
    filter_upwards [Filter.Eventually.of_forall fun ω ↦
      voterOpinionCount_nonneg_le_card (voterModelProcess x0 n ω)] with ω hω
    have hnonneg :
        0 ≤ voterOpinionCount (voterModelProcess x0 n ω) := by
      simpa [voterOpinionCountProcess] using hω.1
    change ‖voterOpinionCount (voterModelProcess x0 n ω)‖ ≤ siteCard
    simpa [siteCard, Real.norm_of_nonneg hnonneg] using hω.2
  have hIntegralTendsto :
      Filter.Tendsto (fun n ↦ ∫ ω, voterOpinionCountProcess x0 n ω ∂μ) Filter.atTop
        (𝓝 (∫ ω,
          Set.indicator (eventuallyConstantOpinion x0 true) (fun _ ↦ siteCard) ω ∂μ)) := by
    refine MeasureTheory.tendsto_integral_of_dominated_convergence (bound := fun _ ↦ siteCard)
      ?_ (integrable_const siteCard) hBound ?_
    · intro n
      exact (voterOpinionCountProcess_integrable (x0 := x0) n).aestronglyMeasurable
    · simpa [μ, siteCard] using
        voterOpinionCountProcess_tendsto_trueConsensusIndicator_ae (x0 := x0)
  have hExpectationConst :
      ∀ n, ∫ ω, voterOpinionCountProcess x0 n ω ∂μ = voterOpinionCount x0 := by
    intro n
    calc
      ∫ ω, voterOpinionCountProcess x0 n ω ∂μ
          = ∫ ω, voterOpinionCountProcess x0 0 ω ∂μ := by
              exact
                (martingale_expectation_eq (voterOpinionCountProcess_martingale x0)
                  (Nat.zero_le n)).symm
      _ = voterOpinionCount x0 := by
            simp [voterOpinionCountProcess, voterModelProcess]
  have hConstIntegral :
      Filter.Tendsto (fun n ↦ ∫ ω, voterOpinionCountProcess x0 n ω ∂μ) Filter.atTop
        (𝓝 (voterOpinionCount x0)) := by
    have hConst :
        (fun n ↦ ∫ ω, voterOpinionCountProcess x0 n ω ∂μ) =
          fun _ : ℕ ↦ voterOpinionCount x0 := by
      funext n
      exact hExpectationConst n
    rw [hConst]
    exact tendsto_const_nhds
  -- Proof comment: dominated convergence identifies the limit integral with the constant
  -- martingale expectation.
  exact tendsto_nhds_unique hIntegralTendsto hConstIntegral

/-- Helper for Example 11.16: the probability of eventual absorption in the unanimous `true`
configuration equals the initial frequency of opinion `1`. -/
theorem eventuallyConstantOpinion_true_probability {d : ℕ+} {L : ℕ+}
    (x0 : VoterConfig d L) :
    (voterTrajectoryMeasure d L (eventuallyConstantOpinion x0 true)).toReal =
      voterOpinionCount x0 / Fintype.card (VoterSite d L) := by
  let μ : Measure (VoterTrajectory d L) := voterTrajectoryMeasure d L
  let siteCard : ℝ := Fintype.card (VoterSite d L)
  have hMeasTrue : MeasurableSet (eventuallyConstantOpinion x0 true) :=
    measurableSet_eventuallyConstantOpinion (x0 := x0) true
  have hIntegralEq :
      ∫ ω, Set.indicator (eventuallyConstantOpinion x0 true) (fun _ ↦ siteCard) ω ∂μ =
        voterOpinionCount x0 := by
    simpa [μ, siteCard] using trueConsensusIndicator_integral_eq_initialCount (x0 := x0)
  have hIndicatorIntegral :
      ∫ ω, Set.indicator (eventuallyConstantOpinion x0 true) (fun _ ↦ siteCard) ω ∂μ =
        μ.real (eventuallyConstantOpinion x0 true) * siteCard := by
    simpa [smul_eq_mul] using
      (MeasureTheory.integral_indicator_const (μ := μ) siteCard hMeasTrue)
  have hCardNe : siteCard ≠ 0 := by
    have hCardPos : 0 < siteCard := by
      simp [siteCard]
    exact ne_of_gt hCardPos
  have hProbabilityReal :
      μ.real (eventuallyConstantOpinion x0 true) = voterOpinionCount x0 / siteCard := by
    apply (eq_div_iff hCardNe).2
    rw [← hIndicatorIntegral]
    exact hIntegralEq
  -- Proof comment: rewrite the indicator integral as the measure of the measurable event times
  -- the constant site cardinality, then divide by that nonzero cardinality.
  simpa [Measure.real, μ, siteCard] using hProbabilityReal

/-- Helper for Example 11.16: the probability of eventual absorption in the unanimous `false`
configuration equals the initial frequency of opinion `0`. -/
theorem eventuallyConstantOpinion_false_probability {d : ℕ+} {L : ℕ+}
    (x0 : VoterConfig d L) :
    (voterTrajectoryMeasure d L (eventuallyConstantOpinion x0 false)).toReal =
      1 - voterOpinionCount x0 / Fintype.card (VoterSite d L) := by
  let μ : Measure (VoterTrajectory d L) := voterTrajectoryMeasure d L
  have hMeasTrue : MeasurableSet (eventuallyConstantOpinion x0 true) :=
    measurableSet_eventuallyConstantOpinion (x0 := x0) true
  have hMeasFalse : MeasurableSet (eventuallyConstantOpinion x0 false) :=
    measurableSet_eventuallyConstantOpinion (x0 := x0) false
  have hTrueProbability :
      μ.real (eventuallyConstantOpinion x0 true) =
        voterOpinionCount x0 / Fintype.card (VoterSite d L) := by
    simpa [Measure.real, μ] using eventuallyConstantOpinion_true_probability (x0 := x0)
  have hConsensusMeas : MeasurableSet (eventuallyConsensus x0) := by
    rw [eventuallyConsensus_eq_union]
    exact hMeasFalse.union hMeasTrue
  have hConsensusProbability : μ.real (eventuallyConsensus x0) = 1 := by
    have hAeConsensus : eventuallyConsensus x0 ∈ ae μ :=
      voterModel_ae_eventually_consensus x0
    have hProbConsensus : μ (eventuallyConsensus x0) = 1 :=
      (MeasureTheory.mem_ae_iff_prob_eq_one hConsensusMeas).1 hAeConsensus
    simp [Measure.real, hProbConsensus]
  have hConsensusDecomp :
      μ.real (eventuallyConsensus x0) =
        μ.real (eventuallyConstantOpinion x0 false) +
          μ.real (eventuallyConstantOpinion x0 true) := by
    rw [eventuallyConsensus_eq_union]
    exact MeasureTheory.measureReal_union
      (disjoint_eventuallyConstantOpinion (x0 := x0)) hMeasTrue
  have hFalseProbability :
      μ.real (eventuallyConstantOpinion x0 false) =
        1 - voterOpinionCount x0 / Fintype.card (VoterSite d L) := by
    rw [hConsensusDecomp, hTrueProbability] at hConsensusProbability
    linarith
  -- Proof comment: the `false`-consensus event is the disjoint complement of the `true`-consensus
  -- event inside the almost-sure consensus event.
  simpa [Measure.real, μ] using hFalseProbability

/-- Helper for Example 11.16: the eventual-absorption probability for a prescribed consensus
opinion `b`. -/
theorem eventuallyConstantOpinion_probability {d : ℕ+} {L : ℕ+} (x0 : VoterConfig d L)
    (b : Bool) :
    (voterTrajectoryMeasure d L (eventuallyConstantOpinion x0 b)).toReal =
      if b then voterOpinionCount x0 / Fintype.card (VoterSite d L)
      else 1 - voterOpinionCount x0 / Fintype.card (VoterSite d L) := by
  -- Route correction: dispatch to the dedicated one-sided probability theorems instead of
  -- rebuilding the full stochastic endgame inside this Boolean-valued statement.
  cases b with
  | false =>
      simpa using eventuallyConstantOpinion_false_probability (x0 := x0)
  | true =>
      simpa using eventuallyConstantOpinion_true_probability (x0 := x0)

-- Proof sketch: use the almost-sure consensus event to identify eventual absorption in the
-- unanimous opinion-`0` state with the complement of absorption in the unanimous opinion-`1`
-- state, and then apply the probability formula for the surviving opinion `1`.
/-- The probability that the eventual consensus state is the unanimous opinion-`0` configuration
is the initial frequency of opinion `0`. -/
theorem voterModel_surviving_opinion_zero_probability {d : ℕ+} {L : ℕ+} (x0 : VoterConfig d L) :
    (voterTrajectoryMeasure d L (eventuallyConstantOpinion x0 false)).toReal =
      1 - voterOpinionCount x0 / Fintype.card (VoterSite d L) := by
  -- Reuse the dedicated `false`-consensus probability theorem.
  simpa using eventuallyConstantOpinion_false_probability (x0 := x0)

-- Proof sketch: use `voterOpinionCountProcess_martingale` and bounded martingale convergence to
-- identify the limit of the opinion-count process. The previous almost-sure absorption result
-- forces that limit to be either `0` or the total number of sites, and conservation of
-- expectation then yields the probability of absorption in the all-`1` state.
/-- Example 11.16: in the finite voter model on the `d`-dimensional torus, the probability that
the eventual consensus state is the unanimous opinion-`1` configuration equals the initial
frequency of opinion `1`. Together with `voterModel_ae_eventually_consensus`, this formalizes the
textbook conclusion that the finite voter model almost surely reaches consensus. -/
theorem voterModel_surviving_opinion_one_probability {d : ℕ+} {L : ℕ+} (x0 : VoterConfig d L) :
    (voterTrajectoryMeasure d L (eventuallyConstantOpinion x0 true)).toReal =
      voterOpinionCount x0 / Fintype.card (VoterSite d L) := by
  -- Reuse the dedicated `true`-consensus probability theorem.
  simpa using eventuallyConstantOpinion_true_probability (x0 := x0)

end ProbabilityTheory
