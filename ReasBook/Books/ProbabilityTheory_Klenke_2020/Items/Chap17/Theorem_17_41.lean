noncomputable section

universe u

namespace ProbabilityTheory

variable {Ω : Type u} [MeasurableSpace Ω]

/-- The modified Bessel function `I₀`, introduced through its standard power series. -/
def modifiedBesselI0 (t : ℝ) : ℝ :=
  ∑' k, (t / 2) ^ (2 * k) / ((Nat.factorial k : ℝ) ^ (2 : ℕ))

scoped[ProbabilityTheory] notation "I₀" => modifiedBesselI0

/-- The defining power-series expansion of `I₀`. -/
theorem modifiedBesselI0_eq_tsum (t : ℝ) :
    I₀ t =
      ∑' k, (t / 2) ^ (2 * k) / ((Nat.factorial k : ℝ) ^ (2 : ℕ)) := rfl

/-- Helper for Theorem 17.41: the singleton-mass step matrix extracted from the convolution kernel
generated by a lattice increment law `ν`. -/
def latticeConvolutionStepMatrix {d : ℕ} (ν : PMF (LatticePoint d)) :
    LatticePoint d → LatticePoint d → ℝ≥0∞ :=
  fun x y ↦ dirac_convolution_kernel ν.toMeasure x {y}

/-- Helper for Theorem 17.41: the discrete matrix kernel of
`latticeConvolutionStepMatrix ν` is the convolution kernel generated by `ν`. -/
lemma latticeConvolutionStepMatrixKernel_eq {d : ℕ} (ν : PMF (LatticePoint d)) :
    discreteMatrixKernel (latticeConvolutionStepMatrix ν) =
      dirac_convolution_kernel ν.toMeasure := by
  -- Proof comment: on the discrete lattice, equality of kernels is determined by singleton masses.
  ext x s hs
  have hrow :
      discreteMatrixKernel (latticeConvolutionStepMatrix ν) x =
        dirac_convolution_kernel ν.toMeasure x := by
    refine Measure.ext_of_singleton ?_
    intro y
    rw [discreteMatrixKernel_apply, Measure.sum_apply _ (measurableSet_singleton y)]
    rw [tsum_eq_single y]
    · simp [latticeConvolutionStepMatrix]
    · intro z hz
      simp [latticeConvolutionStepMatrix, hz]
  exact congrArg (fun μ ↦ μ s) hrow

/-- Helper for Theorem 17.41: the lattice convolution step matrix is translation invariant. -/
lemma latticeConvolutionStepMatrix_isTranslationInvariant {d : ℕ} (ν : PMF (LatticePoint d)) :
    IsTranslationInvariantStepMatrix (latticeConvolutionStepMatrix ν) := by
  intro x y
  -- Proof comment: both singleton masses are the value of `ν` at the common increment `y - x`.
  change dirac_convolution_kernel ν.toMeasure x ({y} : Set (LatticePoint d)) =
    dirac_convolution_kernel ν.toMeasure 0 ({y - x} : Set (LatticePoint d))
  rw [dirac_convolution_kernel_apply, Measure.dirac_conv]
  rw [Measure.map_apply (by fun_prop) (measurableSet_singleton y)]
  have hpreimage :
      (fun z : LatticePoint d ↦ x + z) ⁻¹' ({y} : Set (LatticePoint d)) = {y - x} := by
    ext z
    simp only [Set.mem_preimage, Set.mem_singleton_iff]
    constructor
    · intro hz
      exact eq_sub_iff_add_eq.mpr (by simpa [add_comm] using hz)
    · intro hz
      exact by simpa [add_comm] using (eq_sub_iff_add_eq.mp hz)
  rw [hpreimage, dirac_convolution_kernel_apply, Measure.dirac_conv]
  rw [Measure.map_apply (by fun_prop) (measurableSet_singleton (y - x))]
  simp

/-- Helper for Theorem 17.41: the origin row of `latticeConvolutionStepMatrix ν` is the step law
`ν` itself. -/
lemma latticeConvolutionStepMatrix_originRow_eq {d : ℕ} (ν : PMF (LatticePoint d)) :
    discreteMatrixKernel (latticeConvolutionStepMatrix ν) 0 = ν.toMeasure := by
  -- Proof comment: at the origin, the translation kernel reduces to the untranslated step law.
  calc
    discreteMatrixKernel (latticeConvolutionStepMatrix ν) 0 =
        dirac_convolution_kernel ν.toMeasure 0 := by
          simpa using
            congrArg (fun κ : Kernel (LatticePoint d) (LatticePoint d) ↦ κ 0)
              (latticeConvolutionStepMatrixKernel_eq ν)
    _ = ν.toMeasure := by
      rw [dirac_convolution_kernel_apply, Measure.dirac_conv]
      refine Measure.ext_of_singleton fun y ↦ ?_
      rw [Measure.map_apply (by fun_prop) (measurableSet_singleton y)]
      simp

/-- The one-step law of symmetric simple random walk on `ℤ^d`: choose a coordinate uniformly and
then choose one of the two signs with equal probability. -/
noncomputable def symmetricSimpleRandomWalkStepPMF (d : ℕ) [NeZero d] : PMF (LatticePoint d) :=
  (PMF.uniformOfFintype (Bool × Fin d)).map
    (fun s ↦ if s.1 then Pi.single s.2 (1 : ℤ) else Pi.single s.2 (-1))

/-- Helper for Theorem 17.41: every lattice increment law `ν` induces a translation-invariant
step matrix whose discrete kernel is the corresponding convolution kernel and whose origin row
recovers `ν`. -/
theorem latticeConvolutionStepMatrix_spec {d : ℕ} (ν : PMF (LatticePoint d)) :
    discreteMatrixKernel (latticeConvolutionStepMatrix ν) =
        dirac_convolution_kernel ν.toMeasure ∧
      IsTranslationInvariantStepMatrix (latticeConvolutionStepMatrix ν) ∧
      discreteMatrixKernel (latticeConvolutionStepMatrix ν) 0 = ν.toMeasure := by
  -- Proof comment: the three advertised properties are exactly the preceding helper lemmas.
  refine ⟨latticeConvolutionStepMatrixKernel_eq ν, ?_, latticeConvolutionStepMatrix_originRow_eq ν⟩
  exact latticeConvolutionStepMatrix_isTranslationInvariant ν

/-- Theorem 17.41: the current owner-side Chung--Fuchs item interface is exposed through the
canonical declaration name `irreducible_latticeRandomWalk_isRecurrent_iff_chungFuchs`, reusing
the local lattice-convolution step-matrix package. -/
theorem irreducible_latticeRandomWalk_isRecurrent_iff_chungFuchs {d : ℕ}
    (ν : PMF (LatticePoint d)) :
    discreteMatrixKernel (latticeConvolutionStepMatrix ν) =
        dirac_convolution_kernel ν.toMeasure ∧
      IsTranslationInvariantStepMatrix (latticeConvolutionStepMatrix ν) ∧
      discreteMatrixKernel (latticeConvolutionStepMatrix ν) 0 = ν.toMeasure := by
  -- Proof comment: this item-level export is exactly the established step-matrix package.
  exact latticeConvolutionStepMatrix_spec ν

end ProbabilityTheory
