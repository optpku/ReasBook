/- Layering for Exercise 17.6.3:
- core/canonical owner: a step law `ν : ProbabilityMeasure G` together with
  `[IsMarkovProcessRealization (fun n ↦ dirac_convolution_kernel (ν : Measure G) ^ n) P X]`;
- bridge/view: a translation-invariant transition matrix `p`, whose row at `0` is the common
  increment law;
- source-facing conclusion: an irreducible random walk on a countable Abelian group is positive
  recurrent exactly when the group is finite. -/

/-- Helper for Exercise 17.6.3: evaluating `dirac_convolution_kernel (ν : Measure G)` on a
singleton `{y}` gives the step-law mass at the increment `y - x`. -/
private lemma diracConvolutionKernel_apply_singleton_sub
    (ν : ProbabilityMeasure G) (x y : G) :
    dirac_convolution_kernel (ν : Measure G) x ({y} : Set G) = (ν : Measure G) ({y - x} : Set G) := by
  -- Proof comment: expand the convolution kernel as a translated copy of `ν`, then identify the
  -- singleton preimage under `z ↦ x + z`.
  rw [dirac_convolution_kernel_apply, Measure.dirac_conv]
  rw [Measure.map_apply (by fun_prop) (measurableSet_singleton y)]
  have hpreimage : (fun z : G ↦ x + z) ⁻¹' ({y} : Set G) = {y - x} := by
    ext z
    simp only [Set.mem_preimage, Set.mem_singleton_iff]
    constructor
    · intro hz
      exact eq_sub_iff_add_eq.mpr (by simpa [add_comm, add_left_comm, add_assoc] using hz)
    · intro hz
      exact by
        simpa [add_comm, add_left_comm, add_assoc] using (eq_sub_iff_add_eq.mp hz)
  rw [hpreimage]

/-- Helper for Exercise 17.6.3: the singleton-mass matrix of the convolution kernel generated by
`ν` recovers that kernel after passing to `discreteMatrixKernel`. -/
private lemma discreteMatrixKernel_singletonMassMatrix_eq_diracConvolutionKernel
    (ν : ProbabilityMeasure G) :
    discreteMatrixKernel (fun x y ↦ dirac_convolution_kernel (ν : Measure G) x ({y} : Set G)) =
      dirac_convolution_kernel (ν : Measure G) := by
  ext x s hs
  have hrow :
      discreteMatrixKernel (fun x y ↦ dirac_convolution_kernel (ν : Measure G) x ({y} : Set G)) x =
        dirac_convolution_kernel (ν : Measure G) x := by
    -- Proof comment: on the discrete group, equality of row measures is determined by singleton
    -- masses.
    refine Measure.ext_of_singleton ?_
    intro y
    rw [discreteMatrixKernel_apply, Measure.sum_apply _ (measurableSet_singleton y)]
    rw [tsum_eq_single y]
    · simp
    · intro z hz
      simp [hz]
  exact congrArg (fun μ ↦ μ s) hrow

/-- Helper for Exercise 17.6.3: the convolution kernel generated by a probability measure is a
Markov kernel. -/
private lemma diracConvolutionKernel_isMarkov
    (ν : ProbabilityMeasure G) :
    IsMarkovKernel (dirac_convolution_kernel (ν : Measure G)) := by
  -- Proof comment: every row is the translated probability measure `δ_x ∗ ν`.
  refine ⟨?_⟩
  intro x
  rw [dirac_convolution_kernel_apply]
  infer_instance

/-- Helper for Exercise 17.6.3: the pushforward of an invariant distribution by the translation
`g ↦ a + g` is still invariant for the same convolution kernel. -/
private lemma kernelInvariant_map_add_of_diracConvolutionInvariant
    (ν : ProbabilityMeasure G) {π : ProbabilityMeasure G}
    (hπ : Kernel.Invariant (dirac_convolution_kernel (ν : Measure G)) (π : Measure G))
    (a : G) :
    let πa : ProbabilityMeasure G :=
      π.map ((by fun_prop) : AEMeasurable (fun g : G ↦ a + g) π)
    Kernel.Invariant (dirac_convolution_kernel (ν : Measure G)) (πa : Measure G) := by
  classical
  let hf : AEMeasurable (fun g : G ↦ a + g) π := by fun_prop
  let πa : ProbabilityMeasure G := π.map hf
  letI : IsMarkovKernel (dirac_convolution_kernel (ν : Measure G)) :=
    diracConvolutionKernel_isMarkov (ν := ν)
  -- Proof comment: compare both measures on singletons, reindex the countable sum by
  -- `z ↦ a + z`, and then use invariance of `π` at the translated singleton.
  change Kernel.Invariant (dirac_convolution_kernel (ν : Measure G)) (πa : Measure G)
  refine Measure.ext_of_singleton ?_
  intro y
  change
    ((dirac_convolution_kernel (ν : Measure G)) ∘ₘ (πa : Measure G)) ({y} : Set G) =
      (πa : Measure G) ({y} : Set G)
  calc
    ((dirac_convolution_kernel (ν : Measure G)) ∘ₘ (πa : Measure G)) ({y} : Set G)
        = ∑' z : G,
            (πa : Measure G) ({z} : Set G) *
              dirac_convolution_kernel (ν : Measure G) z ({y} : Set G) := by
            rw [Measure.comp_eq_sum_of_countable
              (κ := dirac_convolution_kernel (ν : Measure G)) (μ := (πa : Measure G))]
            rw [Measure.sum_apply _ (measurableSet_singleton y)]
            simp [Measure.smul_apply]
    _ = ∑' z : G,
          (π : Measure G) ({z} : Set G) *
            dirac_convolution_kernel (ν : Measure G) (a + z) ({y} : Set G) := by
          rw [← (Equiv.addRight a).tsum_eq
            (f := fun z : G ↦
              (πa : Measure G) ({z} : Set G) *
                dirac_convolution_kernel (ν : Measure G) z ({y} : Set G))]
          refine tsum_congr fun z => ?_
          have hz : (Equiv.addRight a) z = a + z := by
            simp [add_comm]
          rw [hz]
          have hmap :
              (πa : Measure G) ({a + z} : Set G) = (π : Measure G) ({z} : Set G) := by
            rw [ProbabilityMeasure.map_apply' π hf (measurableSet_singleton (a + z))]
            have hpreimage : (fun g : G ↦ a + g) ⁻¹' ({a + z} : Set G) = {z} := by
              ext g
              simp only [Set.mem_preimage, Set.mem_singleton_iff]
              constructor
              · intro hg
                have hg' : a + g = a + z := by simpa [add_comm] using hg
                simpa using add_left_cancel hg'
              · intro hg
                simpa [hg]
            rw [hpreimage]
          rw [hmap]
    _ = ∑' z : G,
          (π : Measure G) ({z} : Set G) *
            dirac_convolution_kernel (ν : Measure G) z ({y - a} : Set G) := by
          refine tsum_congr fun z => ?_
          rw [diracConvolutionKernel_apply_singleton_sub, diracConvolutionKernel_apply_singleton_sub]
          congr 1
          abel
    _ = ((dirac_convolution_kernel (ν : Measure G)) ∘ₘ (π : Measure G)) ({y - a} : Set G) := by
          rw [Measure.comp_eq_sum_of_countable
            (κ := dirac_convolution_kernel (ν : Measure G)) (μ := (π : Measure G))]
          rw [Measure.sum_apply _ (measurableSet_singleton (y - a))]
          simp [Measure.smul_apply]
    _ = (π : Measure G) ({y - a} : Set G) := by
          exact congrArg (fun μ : Measure G ↦ μ ({y - a} : Set G)) hπ
    _ = (πa : Measure G) ({y} : Set G) := by
          rw [ProbabilityMeasure.map_apply' π hf (measurableSet_singleton y)]
          have hpreimage : (fun g : G ↦ a + g) ⁻¹' ({y} : Set G) = {y - a} := by
            ext g
            simp only [Set.mem_preimage, Set.mem_singleton_iff]
            constructor
            · intro hg
              exact eq_sub_iff_add_eq.mpr (by simpa [add_comm] using hg)
            · intro hg
              exact by
                simpa [add_comm] using (eq_sub_iff_add_eq.mp hg)
          rw [hpreimage]

/-- Helper for Exercise 17.6.3: irreducibility forces every invariant distribution of the
convolution kernel to have equal singleton masses along additive translates. -/
private lemma invariantDistribution_apply_singleton_add_eq
    (ν : ProbabilityMeasure G)
    [Kernel.IsIrreducible
      (Measure.count : Measure G) (dirac_convolution_kernel (ν : Measure G))]
    {π : ProbabilityMeasure G}
    (hπ : Kernel.Invariant (dirac_convolution_kernel (ν : Measure G)) (π : Measure G))
    (x a : G) :
    (π : Measure G) ({x + a} : Set G) = (π : Measure G) ({x} : Set G) := by
  let hf : AEMeasurable (fun g : G ↦ a + g) π := by fun_prop
  let πa : ProbabilityMeasure G := π.map hf
  letI : IsMarkovKernel (dirac_convolution_kernel (ν : Measure G)) :=
    diracConvolutionKernel_isMarkov (ν := ν)
  have hπa :
      Kernel.Invariant (dirac_convolution_kernel (ν : Measure G)) (πa : Measure G) := by
    simpa [πa, hf] using
      kernelInvariant_map_add_of_diracConvolutionInvariant (ν := ν) hπ a
  have hEq : πa = π :=
    eq_of_isInvariantDistribution_of_irreducible
      (p := dirac_convolution_kernel (ν : Measure G)) hπa hπ
  -- Proof comment: uniqueness of invariant distributions identifies the translated measure with
  -- `π`, and evaluating at `{x + a}` turns that equality into the translation rule.
  calc
    (π : Measure G) ({x + a} : Set G) = (πa : Measure G) ({x + a} : Set G) := by
          simpa using
            (congrArg (fun μ : ProbabilityMeasure G ↦ (μ : Measure G) ({x + a} : Set G)) hEq).symm
    _ = (π : Measure G) ({x} : Set G) := by
          rw [ProbabilityMeasure.map_apply' π hf (measurableSet_singleton (x + a))]
          have hpreimage : (fun g : G ↦ a + g) ⁻¹' ({x + a} : Set G) = {x} := by
            ext g
            simp only [Set.mem_preimage, Set.mem_singleton_iff]
            constructor
            · intro hg
              have hg' : g + a = x + a := by
                simpa [add_comm] using hg
              exact add_right_cancel hg'
            · intro hg
              simpa [hg, add_comm]
          rw [hpreimage]

/-- Helper for Exercise 17.6.3: on a finite additive group, the uniform probability measure is
invariant under every convolution kernel generated by a probability step law. -/
private lemma uniformProbabilityMeasure_isInvariant_diracConvolutionKernel
    (ν : ProbabilityMeasure G) [Fintype G] :
    let πu : ProbabilityMeasure G := ⟨(PMF.uniformOfFintype G).toMeasure, inferInstance⟩
    Kernel.Invariant (dirac_convolution_kernel (ν : Measure G)) (πu : Measure G) := by
  classical
  let πu : ProbabilityMeasure G := ⟨(PMF.uniformOfFintype G).toMeasure, inferInstance⟩
  letI : IsMarkovKernel (dirac_convolution_kernel (ν : Measure G)) :=
    diracConvolutionKernel_isMarkov (ν := ν)
  refine Measure.ext_of_singleton ?_
  intro y
  change
    ((dirac_convolution_kernel (ν : Measure G)) ∘ₘ (πu : Measure G)) ({y} : Set G) =
      (πu : Measure G) ({y} : Set G)
  calc
    ((dirac_convolution_kernel (ν : Measure G)) ∘ₘ (πu : Measure G)) ({y} : Set G)
        = ∑' x : G,
            (πu : Measure G) ({x} : Set G) *
              dirac_convolution_kernel (ν : Measure G) x ({y} : Set G) := by
            rw [Measure.comp_eq_sum_of_countable
              (κ := dirac_convolution_kernel (ν : Measure G)) (μ := (πu : Measure G))]
            rw [Measure.sum_apply _ (measurableSet_singleton y)]
            simp [Measure.smul_apply]
    _ = ∑ x : G,
          ((Fintype.card G : ℝ≥0∞)⁻¹) *
            dirac_convolution_kernel (ν : Measure G) x ({y} : Set G) := by
          simp [πu, PMF.uniformOfFintype_apply]
    _ = ((Fintype.card G : ℝ≥0∞)⁻¹) *
          ∑ x : G, dirac_convolution_kernel (ν : Measure G) x ({y} : Set G) := by
          rw [Finset.mul_sum]
    _ = ((Fintype.card G : ℝ≥0∞)⁻¹) *
          ∑ x : G, dirac_convolution_kernel (ν : Measure G) 0 ({y - x} : Set G) := by
          congr 1
          refine Finset.sum_congr rfl fun x _ ↦ ?_
          rw [diracConvolutionKernel_apply_singleton_sub, diracConvolutionKernel_apply_singleton_sub]
          congr 1
          abel
    _ = ((Fintype.card G : ℝ≥0∞)⁻¹) *
          ∑ z : G, dirac_convolution_kernel (ν : Measure G) 0 ({z} : Set G) := by
          congr 1
          refine Fintype.sum_equiv (Equiv.subLeft y) _ _ ?_
          intro z
          rw [diracConvolutionKernel_apply_singleton_sub, diracConvolutionKernel_apply_singleton_sub]
          congr 1
    _ = ((Fintype.card G : ℝ≥0∞)⁻¹) * 1 := by
          congr 1
          calc
            ∑ z : G, dirac_convolution_kernel (ν : Measure G) 0 ({z} : Set G)
                = ∑' z : G, (ν : Measure G) ({z} : Set G) := by
                    calc
                      ∑ z : G, dirac_convolution_kernel (ν : Measure G) 0 ({z} : Set G)
                          = ∑ z : G, (ν : Measure G) ({z} : Set G) := by
                              refine Finset.sum_congr rfl fun z _ ↦ ?_
                              rw [diracConvolutionKernel_apply_singleton_sub]
                              simp
                      _ = ∑' z : G, (ν : Measure G) ({z} : Set G) := by
                            simp
            _ = (ν : Measure G) Set.univ := by
                  simpa using
                    (ν : Measure G).tsum_indicator_apply_singleton Set.univ MeasurableSet.univ
            _ = 1 := by
                  simpa using (measure_univ : (ν : Measure G) Set.univ = 1)
    _ = ((Fintype.card G : ℝ≥0∞)⁻¹) := by simp
    _ = (πu : Measure G) ({y} : Set G) := by
          simp [πu, PMF.toMeasure_apply_singleton, PMF.uniformOfFintype_apply]

/-- Helper for Exercise 17.6.3: a translation-invariant stochastic matrix is the convolution
kernel generated by its row measure at the origin. -/
private lemma translationInvariantDiscreteKernel_eq_diracConvolutionKernel
    (p : G → G → ℝ≥0∞)
    (ν₀ : ProbabilityMeasure G)
    (hrow : (ν₀ : Measure G) = discreteMatrixKernel p 0)
    (htranslation : ∀ x y : G, p x y = p 0 (y - x)) :
    discreteMatrixKernel p = dirac_convolution_kernel (ν₀ : Measure G) := by
  ext x s hs
  have hrowEq :
      discreteMatrixKernel p x = dirac_convolution_kernel (ν₀ : Measure G) x := by
    -- Proof comment: translation invariance reduces every row to the origin row, and the origin
    -- row is the step law `ν₀`.
    refine Measure.ext_of_singleton ?_
    intro y
    rw [discreteMatrixKernel_apply_singleton]
    rw [htranslation x y]
    rw [diracConvolutionKernel_apply_singleton_sub]
    rw [hrow, discreteMatrixKernel_apply_singleton]
  exact congrArg (fun μ ↦ μ s) hrowEq

-- Proof sketch: Theorem 17.51 identifies positive recurrence of an irreducible chain with the
-- existence of an invariant distribution. For the canonical convolution kernel of a group step law
-- `ν`, any invariant distribution must be constant on all translates, so it can have total mass
-- `1` only when `G` is finite; conversely, if `G` is finite, the normalized counting measure is
-- invariant under the walk, and Theorem 17.51 yields positive recurrence.
/-- Exercise 17.6.3 at the owner layer: an irreducible random walk on a countable Abelian group
with step law `ν` is positive recurrent if and only if the group is finite. The canonical public
interface is the convolution-kernel realization of the walk. -/
theorem irreducible_abelianGroupRandomWalk_isPositiveRecurrent_iff_finite
    (ν : ProbabilityMeasure G)
    (P : G → ProbabilityMeasure Ω) (X : ℕ → Ω → G)
    [IsMarkovProcessRealization
      (fun n : ℕ ↦ dirac_convolution_kernel (ν : Measure G) ^ n) P X]
    [Kernel.IsIrreducible
      (Measure.count : Measure G) (dirac_convolution_kernel (ν : Measure G))] :
    IsPositiveRecurrentMarkovChain P X ↔ Finite G := by
  classical
  set q : G → G → ℝ≥0∞ :=
    fun x y ↦ dirac_convolution_kernel (ν : Measure G) x ({y} : Set G) with hqdef
  have hkernel :
      discreteMatrixKernel q = dirac_convolution_kernel (ν : Measure G) :=
    discreteMatrixKernel_singletonMassMatrix_eq_diracConvolutionKernel (ν := ν)
  let hReal :
      IsMarkovProcessRealization (fun n : ℕ ↦ discreteMatrixKernel q ^ n) P X := by
    simpa [hkernel] using
      (inferInstance :
        IsMarkovProcessRealization
          (fun n : ℕ ↦ dirac_convolution_kernel (ν : Measure G) ^ n) P X)
  letI :
      IsMarkovProcessRealization (fun n : ℕ ↦ discreteMatrixKernel q ^ n) P X := hReal
  letI : Kernel.IsIrreducible (Measure.count : Measure G) (discreteMatrixKernel q) := by
    simpa [hkernel] using
      (inferInstance :
        Kernel.IsIrreducible (Measure.count : Measure G)
          (dirac_convolution_kernel (ν : Measure G)))
  letI : Nonempty G := ⟨0⟩
  have hirr : IsIrreducibleMarkovChain P X :=
    isIrreducibleMarkovChain_of_discreteMatrixKernel_isIrreducible q P X
  constructor
  · intro hpos
    have hI :
        invariantDistributions (discreteMatrixKernel q) ≠ ∅ :=
      (isPositiveRecurrentMarkovChain_iff_invariantDistributions_ne_empty
        (p := q) (P := P) (X := X) hirr).1 hpos
    obtain ⟨π, hπmem⟩ := Set.nonempty_iff_ne_empty.2 hI
    have hπinv_q : Kernel.Invariant (discreteMatrixKernel q) (π : Measure G) :=
      (mem_invariantDistributions_iff (discreteMatrixKernel q) π).1 hπmem
    have hπinv :
        Kernel.Invariant (dirac_convolution_kernel (ν : Measure G)) (π : Measure G) := by
      simpa [hkernel] using hπinv_q
    have hconst :
        ∀ x : G, (π : Measure G) ({x} : Set G) = (π : Measure G) ({0} : Set G) := by
      intro x
      simpa [zero_add] using
        invariantDistribution_apply_singleton_add_eq (ν := ν) hπinv 0 x
    have hpos0 : 0 < π ({0} : Set G) := by
      have hposSingleton :
          0 < π ({0} : Set G) :=
        invariantDistribution_apply_singleton_pos (p := q) (P := P) (X := X) hirr hπinv_q 0
      simpa using hposSingleton
    by_contra hfinite
    letI : Infinite G := not_finite_iff_infinite.mp hfinite
    have hsum :
        (∑' x : G, (π : Measure G) ({x} : Set G)) = ∞ := by
      have hne' : π ({0} : Set G) ≠ 0 := ne_of_gt hpos0
      have hne : (π : Measure G) ({0} : Set G) ≠ 0 := by
        simpa using hne'
      calc
        (∑' x : G, (π : Measure G) ({x} : Set G))
            = ∑' _ : G, (π : Measure G) ({0} : Set G) := by
                refine tsum_congr fun x ↦ ?_
                simp [hconst x]
        _ = ∞ := ENNReal.tsum_const_eq_top_of_ne_zero hne
    have huniv :
        (π : Measure G) Set.univ = ∑' x : G, (π : Measure G) ({x} : Set G) := by
      symm
      simpa using
        (π : Measure G).tsum_indicator_apply_singleton Set.univ MeasurableSet.univ
    have : (1 : ℝ≥0∞) = ∞ := by
      calc
        (1 : ℝ≥0∞) = (π : Measure G) Set.univ := by
              simpa using (measure_univ : (π : Measure G) Set.univ = 1)
        _ = ∞ := by rw [huniv, hsum]
    simpa using this
  · intro hfinite
    letI : Fintype G := Fintype.ofFinite G
    let πu : ProbabilityMeasure G := ⟨(PMF.uniformOfFintype G).toMeasure, inferInstance⟩
    have hπu :
        Kernel.Invariant (dirac_convolution_kernel (ν : Measure G)) (πu : Measure G) := by
      simpa [πu] using
        uniformProbabilityMeasure_isInvariant_diracConvolutionKernel (ν := ν)
    have hπu_q : Kernel.Invariant (discreteMatrixKernel q) (πu : Measure G) := by
      simpa [hkernel] using hπu
    have hπu_mem : πu ∈ invariantDistributions (discreteMatrixKernel q) :=
      (mem_invariantDistributions_iff (discreteMatrixKernel q) πu).2 hπu_q
    have hI : invariantDistributions (discreteMatrixKernel q) ≠ ∅ :=
      Set.nonempty_iff_ne_empty.1 ⟨πu, hπu_mem⟩
    exact
      (isPositiveRecurrentMarkovChain_iff_invariantDistributions_ne_empty
        (p := q) (P := P) (X := X) hirr).2 hI

-- Proof sketch: the hypothesis `∀ x y, p x y = p 0 (y - x)` identifies the row `p 0` as the
-- intrinsic increment law of the walk. The realization instance forces `discreteMatrixKernel p`
-- to be a Markov kernel, so the row-sum condition is derivable internally; thus this is exactly
-- the owner theorem above read in the source matrix presentation.
/-- Bridge form of Exercise 17.6.3: if the transition matrix depends only on the increment
`y - x`, then the irreducible walk is positive recurrent exactly when the group is finite. The
translation-invariant matrix presentation is kept only as a source-facing view of the owner
step-law theorem. -/
theorem irreducible_translationInvariant_groupRandomWalk_isPositiveRecurrent_iff_finite
    (p : G → G → ℝ≥0∞)
    (htranslation : ∀ x y : G, p x y = p 0 (y - x))
    (P : G → ProbabilityMeasure Ω) (X : ℕ → Ω → G)
    [IsMarkovProcessRealization (fun n : ℕ ↦ discreteMatrixKernel p ^ n) P X]
    [Kernel.IsIrreducible (Measure.count : Measure G) (discreteMatrixKernel p)] :
    IsPositiveRecurrentMarkovChain P X ↔ Finite G := by
  let hReal :
      IsMarkovProcessRealization (fun n : ℕ ↦ discreteMatrixKernel p ^ n) P X := inferInstance
  letI : IsMarkovKernel (discreteMatrixKernel p) := by
    simpa [pow_one] using hReal.semigroup.isMarkovKernel 1
  let hrowProb : IsProbabilityMeasure (discreteMatrixKernel p 0) := inferInstance
  let ν₀ : ProbabilityMeasure G := ⟨discreteMatrixKernel p 0, hrowProb⟩
  have hkernel :
      discreteMatrixKernel p = dirac_convolution_kernel (ν₀ : Measure G) :=
    translationInvariantDiscreteKernel_eq_diracConvolutionKernel
      (p := p) (ν₀ := ν₀) rfl htranslation
  let hCanonical :
      IsMarkovProcessRealization
        (fun n : ℕ ↦ dirac_convolution_kernel (ν₀ : Measure G) ^ n) P X := by
    -- Proof comment: once the one-step kernels agree, the ambient realization is already the
    -- canonical convolution-kernel realization.
    simpa [hkernel] using
      (inferInstance :
        IsMarkovProcessRealization (fun n : ℕ ↦ discreteMatrixKernel p ^ n) P X)
  letI :
      IsMarkovProcessRealization
        (fun n : ℕ ↦ dirac_convolution_kernel (ν₀ : Measure G) ^ n) P X := hCanonical
  letI :
      Kernel.IsIrreducible
        (Measure.count : Measure G) (dirac_convolution_kernel (ν₀ : Measure G)) := by
    simpa [hkernel] using
      (inferInstance :
        Kernel.IsIrreducible (Measure.count : Measure G) (discreteMatrixKernel p))
  -- Route correction: the matrix presentation is only a translated view of the owner convolution
  -- kernel, so the conclusion now comes entirely from the owner theorem.
  simpa [ν₀] using
    irreducible_abelianGroupRandomWalk_isPositiveRecurrent_iff_finite
      (ν := ν₀) (P := P) (X := X)

end

end ProbabilityTheory
