-- Declarations for this item will be appended below by the statement pipeline.

open MeasureTheory ProbabilityTheory
open scoped ProbabilityTheory Topology

noncomputable section

universe u v w

variable {Ω : Type u} [MeasurableSpace Ω]
variable {T : Type v} [LinearOrder T]
variable {E : Type w} [MeasurableSpace E]

namespace ProbabilityTheory

/-- A process has the natural Markov property under `μ` if every coordinate is measurable and,
for each measurable one-time future event, conditioning on the whole past up to `s` agrees almost
surely with conditioning only on the present state `X s`. -/
def HasNaturalMarkovProperty
    (μ : Measure Ω) [IsProbabilityMeasure μ] (X : T → Ω → E) : Prop :=
  (∀ t : T, Measurable (X t)) ∧
    ∀ ⦃s u : T⦄, s ≤ u → ∀ ⦃A : Set E⦄, MeasurableSet A →
      μ⟦X u ⁻¹' A | generatedFiltrationSpace X s⟧ =ᵐ[μ]
        μ⟦X u ⁻¹' A | MeasurableSpace.comap (X s) ‹MeasurableSpace E›⟧

/-- The present-state sigma-algebra is contained in the history sigma-algebra at the same time. -/
lemma present_le_generatedFiltrationSpace (X : T → Ω → E) (t : T) :
    MeasurableSpace.comap (X t) ‹MeasurableSpace E› ≤ generatedFiltrationSpace X t := by
  -- Proof comment: the defining supremum for `generatedFiltrationSpace X t` already contains the
  -- generator coming from time `t` itself.
  exact le_iSup₂_of_le t le_rfl le_rfl

/-- If every coordinate is ambient-measurable, then the generated history sigma-algebra is an
ambient sub-sigma-algebra. -/
lemma generatedFiltrationSpace_le_ambient
    (X : T → Ω → E) (hX : ∀ t : T, Measurable (X t)) (t : T) :
    generatedFiltrationSpace X t ≤ ‹MeasurableSpace Ω› := by
  -- Proof comment: each coordinate sigma-algebra in the defining past supremum is already
  -- ambient because the corresponding coordinate map is measurable.
  refine iSup_le fun s ↦ iSup_le fun hs ↦ ?_
  exact (hX s).comap_le

/-- Helper for Exercise 17.1.1: the generated history `σ`-algebras are monotone in time. -/
lemma generatedFiltrationSpace_mono
    (X : T → Ω → E) {s t : T} (hst : s ≤ t) :
    generatedFiltrationSpace X s ≤ generatedFiltrationSpace X t := by
  -- Proof comment: every coordinate `σ(X r)` with `r ≤ s` also appears in the larger history
  -- at time `t`.
  refine iSup_le fun r ↦ iSup_le fun hrs ↦ ?_
  exact le_iSup_of_le r <| le_iSup_of_le (le_trans hrs hst) le_rfl

/-- The future `σ`-algebra of a process from time `t` onward, generated by the coordinates
`X r` with `t ≤ r`. -/
abbrev processFuture (X : T → Ω → E) (t : T) : MeasurableSpace Ω :=
  ⨆ r ≥ t, MeasurableSpace.comap (X r) ‹MeasurableSpace E›

/-- Helper for Exercise 17.1.1: every future coordinate `X u` with `s ≤ u` is measurable for the
future `σ`-algebra `processFuture X s`. -/
lemma measurable_processFuture_of_le (X : T → Ω → E) {s u : T} (hsu : s ≤ u) :
    Measurable[processFuture X s] (X u) := by
  -- Proof comment: the defining supremum for `processFuture X s` already contains the coordinate
  -- `σ`-algebra generated by `X u` once `s ≤ u`.
  refine Measurable.of_comap_le ?_
  exact le_iSup_of_le u <| le_iSup_of_le hsu le_rfl

/-- Helper for Exercise 17.1.1: every one-coordinate future event `{X u ∈ A}` with `s ≤ u`
is measurable for the future `σ`-algebra `processFuture X s`. -/
lemma measurableSet_processFuture_preimage (X : T → Ω → E) {s u : T} (hsu : s ≤ u)
    {A : Set E} (hA : MeasurableSet A) :
    MeasurableSet[processFuture X s] (X u ⁻¹' A) := by
  -- Proof comment: once the coordinate is measurable for `processFuture X s`, its measurable
  -- state events are measurable there as well.
  exact (measurable_processFuture_of_le X hsu) hA

/-- Helper for Exercise 17.1.1: if all coordinates are ambient-measurable, then the future
`σ`-algebra `processFuture X t` is a sub-`σ`-algebra of the ambient one. -/
lemma processFuture_le_ambient (X : T → Ω → E) (hX : ∀ r : T, Measurable (X r)) (t : T) :
    processFuture X t ≤ ‹MeasurableSpace Ω› := by
  -- Proof comment: every coordinate sigma-algebra occurring in the future supremum already lies
  -- in the ambient measurable space.
  refine iSup_le fun r ↦ ?_
  refine iSup_le fun hr ↦ ?_
  exact (hX r).comap_le

/-- Helper for Exercise 17.1.1: the future `σ`-algebra is the pullback of the product measurable
space along the future-path map indexed by times `u ≥ t`. -/
lemma processFuture_eq_futurePathComap (X : T → Ω → E) (t : T) :
    processFuture X t =
      MeasurableSpace.comap (fun ω : Ω ↦ fun u : {u : T // t ≤ u} ↦ X u.1 ω) inferInstance := by
  -- Proof comment: the product measurable space is the supremum of the coordinate pullbacks, and
  -- the subtype `{u // t ≤ u}` enumerates exactly the future coordinates appearing in
  -- `processFuture X t`.
  rw [processFuture, MeasurableSpace.pi, MeasurableSpace.comap_iSup, iSup_subtype]
  refine iSup_congr fun r ↦ iSup_congr fun hr ↦ ?_
  rw [MeasurableSpace.comap_comp]
  rfl

/-- Helper for Exercise 17.1.1: the future `σ`-algebra is generated by the one-coordinate future
events on `Ω`. -/
lemma processFuture_eq_generateFromFutureCoordinateEvents (X : T → Ω → E) (t : T) :
    processFuture X t =
      MeasurableSpace.generateFrom
        (⋃ u : {u : T // t ≤ u},
          {s : Set Ω | MeasurableSet[MeasurableSpace.comap (X u.1) ‹MeasurableSpace E›] s}) := by
  -- Proof comment: rewrite the future supremum as the subtype-indexed family of future
  -- coordinates, then apply the earlier generated-by-maps theorem to that family.
  let futureFamily : {u : T // t ≤ u} → Ω → E := fun u ↦ X u.1
  have hFutureSup :
      processFuture X t =
        (⨆ u : {u : T // t ≤ u}, MeasurableSpace.comap (futureFamily u) ‹MeasurableSpace E›) := by
    -- Proof comment: the subtype `{u // t ≤ u}` repackages the same future index set.
    simp [processFuture, futureFamily, iSup_subtype]
  have hGenerated :
      (⨆ u : {u : T // t ≤ u}, MeasurableSpace.comap (futureFamily u) ‹MeasurableSpace E›) =
        MeasurableSpace.generateFrom
          {s | ∃ u : {u : T // t ≤ u}, ∃ A : Set E, MeasurableSet A ∧ futureFamily u ⁻¹' A = s} := by
    -- Proof comment: this is exactly the Chapter 1 generated-by-maps theorem for the future
    -- coordinate family.
    exact
      (generated_by_maps_eq_generateFrom
        (m := fun _ : {u : T // t ≤ u} ↦ ‹MeasurableSpace E›)
        (X := futureFamily))
  have hSets :
      {s | ∃ u : {u : T // t ≤ u}, ∃ A : Set E, MeasurableSet A ∧ futureFamily u ⁻¹' A = s} =
        ⋃ u : {u : T // t ≤ u},
          {s : Set Ω | MeasurableSet[MeasurableSpace.comap (futureFamily u) ‹MeasurableSpace E›] s} := by
    -- Proof comment: an event lies in the generator iff it is the preimage of a measurable
    -- state event under one future coordinate.
    ext s
    constructor
    · rintro ⟨u, A, hA, rfl⟩
      refine Set.mem_iUnion.2 ⟨u, ?_⟩
      exact MeasurableSpace.measurableSet_comap.2 ⟨A, hA, rfl⟩
    · intro hs
      rcases Set.mem_iUnion.1 hs with ⟨u, hu⟩
      rcases MeasurableSpace.measurableSet_comap.1 hu with ⟨A, hA, rfl⟩
      exact ⟨u, A, hA, rfl⟩
  exact hFutureSup.trans <| hGenerated.trans <| congrArg MeasurableSpace.generateFrom hSets

/-- Helper for Exercise 17.1.1: replacing the future coordinate generator family by its generated
`π`-system does not change the future `σ`-algebra. -/
lemma processFuture_eq_generateFromFutureCoordinatePiSystem (X : T → Ω → E) (t : T) :
    processFuture X t =
      MeasurableSpace.generateFrom
        (generatePiSystem
          (⋃ u : {u : T // t ≤ u},
            {s : Set Ω | MeasurableSet[MeasurableSpace.comap (X u.1) ‹MeasurableSpace E›] s})) := by
  -- Proof comment: `generatePiSystem` is the right induction surface for future events, and it
  -- preserves the generated sigma-algebra.
  rw [processFuture_eq_generateFromFutureCoordinateEvents (X := X) (t := t)]
  symm
  exact generateFrom_generatePiSystem_eq

/-- Helper for Exercise 17.1.1: every event in the `π`-system generated by one-coordinate future
events is a finite intersection of coordinate-measurable future events. -/
lemma mem_futureCoordinatePiSystem_elim (X : T → Ω → E) (t : T) {D : Set Ω}
    (hD :
      D ∈ generatePiSystem
        (⋃ u : {u : T // t ≤ u},
          {s : Set Ω | MeasurableSet[MeasurableSpace.comap (X u.1) ‹MeasurableSpace E›] s})) :
    ∃ S : Finset {u : T // t ≤ u}, ∃ F : {u : T // t ≤ u} → Set Ω,
      D = ⋂ u ∈ S, F u ∧
        ∀ u ∈ S, MeasurableSet[MeasurableSpace.comap (X u.1) ‹MeasurableSpace E›] (F u) := by
  -- Proof comment: `generatePiSystem` reduces arbitrary future basic events to finite
  -- intersections indexed by finitely many future times.
  classical
  have hPi :
      ∀ u : {u : T // t ≤ u},
        IsPiSystem {s : Set Ω | MeasurableSet[MeasurableSpace.comap (X u.1) ‹MeasurableSpace E›] s} :=
    fun u ↦ by
      simpa using
        (@MeasurableSpace.isPiSystem_measurableSet Ω
          (MeasurableSpace.comap (X u.1) ‹MeasurableSpace E›))
  rcases
      mem_generatePiSystem_iUnion_elim
        (g := fun u : {u : T // t ≤ u} ↦
          {s : Set Ω | MeasurableSet[MeasurableSpace.comap (X u.1) ‹MeasurableSpace E›] s})
        hPi D hD with
    ⟨S, F, hEq, hF⟩
  exact ⟨S, F, hEq, hF⟩

/-- Helper for Exercise 17.1.1: every finite subset of `Bool` is one of the four canonical
cases `∅`, `{false}`, `{true}`, or `{false, true}`. -/
lemma finset_bool_cases (s : Finset Bool) :
    s = ∅ ∨ s = {false} ∨ s = {true} ∨ s = ({false, true} : Finset Bool) := by
  -- Proof comment: a finite subset of a two-point type is determined by membership of `false`
  -- and `true`.
  by_cases hfalse : false ∈ s
  · by_cases htrue : true ∈ s
    · right
      right
      right
      ext b
      cases b with
      | false =>
          simp [hfalse]
      | true =>
          simp [htrue]
    · right
      left
      ext b
      cases b with
      | false =>
          simp [hfalse]
      | true =>
          simp [htrue]
  · by_cases htrue : true ∈ s
    · right
      right
      left
      ext b
      cases b with
      | false =>
          simp [hfalse]
      | true =>
          simp [htrue]
    · left
      ext b
      cases b with
      | false =>
          simp [hfalse]
      | true =>
          simp [htrue]

/-- Helper for Exercise 17.1.1: intersecting a Bool-indexed family over `{false, true}` yields
the intersection of its two branches. -/
lemma biInter_bool_pair (A : Bool → Set Ω) :
    (⋂ i ∈ ({false, true} : Finset Bool), A i) = A false ∩ A true := by
  -- Proof comment: the two-element Bool finset contributes exactly the `false` and `true`
  -- branches.
  ext ω
  simp [Set.mem_inter_iff]

/-- Helper for Exercise 17.1.1: source-facing conditional independence of the Bool-indexed past
and future family yields the explicit pairwise factorization for one past event and one future
event. -/
lemma pastFutureBoolSource_pairFactorization
    (μ : Measure Ω) [IsProbabilityMeasure μ] (X : T → Ω → E) (t : T)
    (h :
      IsConditionallyIndependent
        (MeasurableSpace.comap (X t) ‹MeasurableSpace E›)
        (fun b : Bool ↦ if b then processFuture X t else generatedFiltrationSpace X t) μ)
    {S U : Set Ω}
    (hS : MeasurableSet[generatedFiltrationSpace X t] S)
    (hU : MeasurableSet[processFuture X t] U) :
    μ⟦S ∩ U | MeasurableSpace.comap (X t) ‹MeasurableSpace E›⟧ =ᵐ[μ]
      μ⟦S | MeasurableSpace.comap (X t) ‹MeasurableSpace E›⟧ *
        μ⟦U | MeasurableSpace.comap (X t) ‹MeasurableSpace E›⟧ := by
  -- Proof comment: specialize the source-facing Bool family to the finite set `{false, true}`
  -- with the past event on `false` and the future event on `true`.
  have hTwoSets :
      μ⟦⋂ i ∈ ({false, true} : Finset Bool), (if i then U else S)
        | MeasurableSpace.comap (X t) ‹MeasurableSpace E›⟧ =ᵐ[μ]
        ∏ i ∈ ({false, true} : Finset Bool),
          μ⟦if i then U else S | MeasurableSpace.comap (X t) ‹MeasurableSpace E›⟧ :=
    h.2.2 ({false, true} : Finset Bool)
      (A := fun b : Bool ↦ if b then U else S)
      (by
        intro b hb
        cases b with
        | false =>
            simpa using hS
        | true =>
            simpa using hU)
  have hInter :
      (⋂ i ∈ ({false, true} : Finset Bool), (if i then U else S)) = S ∩ U := by
    simpa using biInter_bool_pair (A := fun i ↦ if i then U else S)
  have hProd :
      (∏ i ∈ ({false, true} : Finset Bool),
          μ⟦if i then U else S | MeasurableSpace.comap (X t) ‹MeasurableSpace E›⟧) =
        μ⟦S | MeasurableSpace.comap (X t) ‹MeasurableSpace E›⟧ *
          μ⟦U | MeasurableSpace.comap (X t) ‹MeasurableSpace E›⟧ := by
    simp
  rw [hInter] at hTwoSets
  rw [hProd] at hTwoSets
  exact hTwoSets

/-- Helper for Exercise 17.1.1: the Bool-indexed family with branch `false` equal to the past and
branch `true` equal to the future at time `t`. -/
abbrev pastFutureBoolFamily (X : T → Ω → E) (t : T) : Bool → MeasurableSpace Ω :=
  fun b ↦ if b then processFuture X t else generatedFiltrationSpace X t

/-- Helper for Exercise 17.1.1: owner-side `iCondIndep` for the Bool past/future family implies
owner-side conditional independence of the past and future sigma-algebras. -/
lemma condIndepAtTime_of_iCondIndepBoolFamily [StandardBorelSpace Ω]
    (μ : Measure Ω) [IsProbabilityMeasure μ] (X : T → Ω → E) (t : T)
    (hXt : MeasurableSpace.comap (X t) ‹MeasurableSpace E› ≤ ‹MeasurableSpace Ω›)
    (hBool :
      iCondIndep (MeasurableSpace.comap (X t) ‹MeasurableSpace E›) hXt
        (pastFutureBoolFamily X t) μ) :
    CondIndep (MeasurableSpace.comap (X t) ‹MeasurableSpace E›)
      (generatedFiltrationSpace X t) (processFuture X t) hXt μ := by
  -- Proof comment: once the Bool family is named, the pairwise owner statement is just the
  -- specialization of `iCondIndep` to the two indices `false` and `true`.
  simpa [pastFutureBoolFamily] using hBool.condIndep (i := false) (j := true) (by simp)

/-- Helper for Exercise 17.1.1: the source-facing Bool past/future family already carries the
ambient branch inclusions needed by owner-side conditional-independence APIs. -/
lemma pastFutureBoolFamily_le_ambient_of_source
    (μ : Measure Ω) [IsProbabilityMeasure μ] (X : T → Ω → E) (t : T)
    (h :
      IsConditionallyIndependent
        (MeasurableSpace.comap (X t) ‹MeasurableSpace E›)
        (fun b : Bool ↦ if b then processFuture X t else generatedFiltrationSpace X t) μ) :
    ∀ b : Bool, pastFutureBoolFamily X t b ≤ ‹MeasurableSpace Ω› := by
  intro b
  -- Proof comment: the source-facing hypothesis already records ambient inclusion for each Bool
  -- branch, and naming `pastFutureBoolFamily` makes later specializations cheaper.
  cases b with
  | false =>
      simpa [pastFutureBoolFamily] using h.2.1 false
  | true =>
      simpa [pastFutureBoolFamily] using h.2.1 true

/-- Helper for Exercise 17.1.1: a past event measurable for `generatedFiltrationSpace X t` is
ambient-measurable when the process coordinates are ambient-measurable. -/
lemma measurableSet_generatedFiltrationSpace_ambient
    (X : T → Ω → E) (hX : ∀ r : T, Measurable (X r)) (t : T) {S : Set Ω}
    (hS : MeasurableSet[generatedFiltrationSpace X t] S) :
    MeasurableSet S := by
  -- Proof comment: the history sigma-algebra is a sub-sigma-algebra of the ambient one, so its
  -- measurable sets are ambient-measurable.
  exact generatedFiltrationSpace_le_ambient (X := X) hX t _ hS

/-- Helper for Exercise 17.1.1: a future event measurable for `processFuture X t` is
ambient-measurable when the process coordinates are ambient-measurable. -/
lemma measurableSet_processFuture_ambient
    (X : T → Ω → E) (hX : ∀ r : T, Measurable (X r)) (t : T) {S : Set Ω}
    (hS : MeasurableSet[processFuture X t] S) :
    MeasurableSet S := by
  -- Proof comment: the future sigma-algebra is also a sub-sigma-algebra of the ambient one.
  exact processFuture_le_ambient (X := X) hX t _ hS

/-- Helper for Exercise 17.1.1: conditional independence of past and future at a fixed time `s`
forces the Markov conditional-expectation identity for every one-coordinate future event
`{X u ∈ A}` with `s ≤ u`. -/
lemma markovIdentity_of_pastFutureConditionallyIndependentAtTime
    (μ : Measure Ω) [IsProbabilityMeasure μ] (X : T → Ω → E) {s u : T}
    (h : IsConditionallyIndependent
      (MeasurableSpace.comap (X s) ‹MeasurableSpace E›)
      (fun b : Bool ↦ if b then processFuture X s else generatedFiltrationSpace X s) μ)
    (hsu : s ≤ u) {A : Set E} (hA : MeasurableSet A) :
    μ⟦X u ⁻¹' A | generatedFiltrationSpace X s⟧ =ᵐ[μ]
      μ⟦X u ⁻¹' A | MeasurableSpace.comap (X s) ‹MeasurableSpace E›⟧ := by
  let B : Set Ω := X u ⁻¹' A
  have hmPresent : MeasurableSpace.comap (X s) ‹MeasurableSpace E› ≤ ‹MeasurableSpace Ω› := h.1
  have hmPast : generatedFiltrationSpace X s ≤ ‹MeasurableSpace Ω› := by
    simpa using h.2.1 false
  have hmPresentPast : MeasurableSpace.comap (X s) ‹MeasurableSpace E› ≤
      generatedFiltrationSpace X s :=
    present_le_generatedFiltrationSpace (X := X) s
  have hB_future : MeasurableSet[processFuture X s] B := by
    simpa [B] using measurableSet_processFuture_preimage X hsu hA
  have hmFuture : processFuture X s ≤ ‹MeasurableSpace Ω› := by
    simpa using h.2.1 true
  have hB : MeasurableSet B := hmFuture B hB_future
  have hIndicatorInt : Integrable (B.indicator (fun _ ↦ (1 : ℝ))) μ :=
    (integrable_const (1 : ℝ)).indicator hB
  have hCondInt :
      Integrable
        (μ⟦B | MeasurableSpace.comap (X s) ‹MeasurableSpace E›⟧) μ := by
    simpa [B] using
      (integrable_condExp :
        Integrable (μ⟦B | MeasurableSpace.comap (X s) ‹MeasurableSpace E›⟧) μ)
  -- Proof comment: identify the `generatedFiltrationSpace X s`-conditional expectation by
  -- testing the candidate `μ⟦B | σ(X s)⟧` against every history-measurable set.
  refine
    (MeasureTheory.ae_eq_condExp_of_forall_setIntegral_eq hmPast hIndicatorInt
      (fun C _ _ ↦ hCondInt.integrableOn)
      (fun C hC _ ↦ ?_) ?_).symm
  · -- Proof comment: integrate the past/future factorization over a history event `C`, then use
    -- the pull-out property to rewrite the product term as the integral of the candidate over `C`.
    have hC_ambient : MeasurableSet C := hmPast C hC
    have hCInt : Integrable (C.indicator (fun _ ↦ (1 : ℝ))) μ :=
      (integrable_const (1 : ℝ)).indicator hC_ambient
    have hProdInt :
        Integrable
          (fun ω ↦
            (C.indicator (fun _ ↦ (1 : ℝ)) ω) *
              (μ⟦B | MeasurableSpace.comap (X s) ‹MeasurableSpace E›⟧) ω) μ := by
      refine (integrable_congr ?_).2 (hCondInt.indicator hC_ambient)
      filter_upwards with ω
      by_cases hω : ω ∈ C <;> simp [Set.indicator, hω]
    have hPull :
        μ[fun ω ↦
            (C.indicator (fun _ ↦ (1 : ℝ)) ω) *
              (μ⟦B | MeasurableSpace.comap (X s) ‹MeasurableSpace E›⟧) ω
            | MeasurableSpace.comap (X s) ‹MeasurableSpace E›] =ᵐ[μ]
          μ⟦C | MeasurableSpace.comap (X s) ‹MeasurableSpace E›⟧ *
            μ⟦B | MeasurableSpace.comap (X s) ‹MeasurableSpace E›⟧ := by
      -- Proof comment: `μ⟦B | σ(X s)⟧` is already `σ(X s)`-measurable, so it pulls out of the
      -- conditional expectation over the present sigma-algebra.
      simpa [B] using
        (MeasureTheory.condExp_mul_of_aestronglyMeasurable_right
          (μ := μ) (m := MeasurableSpace.comap (X s) ‹MeasurableSpace E›)
          (g := μ⟦B | MeasurableSpace.comap (X s) ‹MeasurableSpace E›⟧)
          (f := C.indicator (fun _ ↦ (1 : ℝ)))
          stronglyMeasurable_condExp.aestronglyMeasurable hProdInt hCInt)
    have hFactor :
        μ⟦C ∩ B | MeasurableSpace.comap (X s) ‹MeasurableSpace E›⟧ =ᵐ[μ]
          μ⟦C | MeasurableSpace.comap (X s) ‹MeasurableSpace E›⟧ *
            μ⟦B | MeasurableSpace.comap (X s) ‹MeasurableSpace E›⟧ := by
      have hTwoSets :
          μ⟦⋂ i ∈ ({false, true} : Finset Bool), (if i then B else C)
            | MeasurableSpace.comap (X s) ‹MeasurableSpace E›⟧ =ᵐ[μ]
            ∏ i ∈ ({false, true} : Finset Bool),
              μ⟦if i then B else C | MeasurableSpace.comap (X s) ‹MeasurableSpace E›⟧ :=
        h.2.2 ({false, true} : Finset Bool)
          (A := fun b : Bool ↦ if b then B else C)
          (by
            intro b hb
            cases b with
            | false =>
                simpa using hC
            | true =>
                simpa using hB_future)
      have hInter :
          (⋂ i ∈ ({false, true} : Finset Bool), (if i then B else C)) = C ∩ B := by
        simpa using biInter_bool_pair (A := fun i ↦ if i then B else C)
      have hProd :
          (∏ i ∈ ({false, true} : Finset Bool),
              μ⟦if i then B else C | MeasurableSpace.comap (X s) ‹MeasurableSpace E›⟧) =
            μ⟦C | MeasurableSpace.comap (X s) ‹MeasurableSpace E›⟧ *
              μ⟦B | MeasurableSpace.comap (X s) ‹MeasurableSpace E›⟧ := by
        simp
      rw [hInter, hProd] at hTwoSets
      exact hTwoSets
    calc
      ∫ ω in C, (μ⟦B | MeasurableSpace.comap (X s) ‹MeasurableSpace E›⟧) ω ∂μ
          = ∫ ω,
              (C.indicator fun ω ↦
                (μ⟦B | MeasurableSpace.comap (X s) ‹MeasurableSpace E›⟧) ω) ω ∂μ := by
              rw [integral_indicator hC_ambient]
      _ = ∫ ω,
            (C.indicator (fun _ ↦ (1 : ℝ)) ω) *
              (μ⟦B | MeasurableSpace.comap (X s) ‹MeasurableSpace E›⟧) ω ∂μ := by
            refine integral_congr_ae ?_
            filter_upwards with ω
            by_cases hω : ω ∈ C <;> simp [Set.indicator, hω]
      _ = ∫ ω,
            (μ⟦C | MeasurableSpace.comap (X s) ‹MeasurableSpace E›⟧ *
              μ⟦B | MeasurableSpace.comap (X s) ‹MeasurableSpace E›⟧) ω ∂μ := by
            calc
              ∫ ω,
                  (C.indicator (fun _ ↦ (1 : ℝ)) ω) *
                    (μ⟦B | MeasurableSpace.comap (X s) ‹MeasurableSpace E›⟧) ω ∂μ
                  = ∫ ω, μ[fun ω ↦
                      (C.indicator (fun _ ↦ (1 : ℝ)) ω) *
                        (μ⟦B | MeasurableSpace.comap (X s) ‹MeasurableSpace E›⟧) ω
                      | MeasurableSpace.comap (X s) ‹MeasurableSpace E›] ω ∂μ := by
                        symm
                        exact integral_condExp hmPresent
              _ = ∫ ω,
                    (μ⟦C | MeasurableSpace.comap (X s) ‹MeasurableSpace E›⟧ *
                      μ⟦B | MeasurableSpace.comap (X s) ‹MeasurableSpace E›⟧) ω ∂μ := by
                    exact integral_congr_ae hPull
      _ = ∫ ω,
            (μ⟦C ∩ B | MeasurableSpace.comap (X s) ‹MeasurableSpace E›⟧) ω ∂μ := by
            exact integral_congr_ae hFactor.symm
      _ = ∫ ω, ((C ∩ B).indicator (fun _ ↦ (1 : ℝ))) ω ∂μ := by
            exact
              (integral_condExp
                (μ := μ)
                (m := MeasurableSpace.comap (X s) ‹MeasurableSpace E›)
                (f := (C ∩ B).indicator (fun _ ↦ (1 : ℝ))) hmPresent)
      _ = ∫ ω in C, (B.indicator (fun _ ↦ (1 : ℝ))) ω ∂μ := by
            calc
              ∫ ω, ((C ∩ B).indicator (fun _ ↦ (1 : ℝ))) ω ∂μ
                  = ∫ ω, (C.indicator fun ω ↦ (B.indicator (fun _ ↦ (1 : ℝ)) ω)) ω ∂μ := by
                      refine integral_congr_ae ?_
                      filter_upwards with ω
                      by_cases hωC : ω ∈ C <;> by_cases hωB : ω ∈ B <;>
                        simp [Set.indicator, hωC, hωB, Set.mem_inter_iff]
              _ = ∫ ω in C, (B.indicator (fun _ ↦ (1 : ℝ))) ω ∂μ := by
                    rw [integral_indicator hC_ambient]
  · -- Proof comment: measurability with respect to `σ(X s)` upgrades to the larger history
    -- sigma-algebra because `σ(X s) ≤ generatedFiltrationSpace X s`.
    exact (stronglyMeasurable_condExp.mono hmPresentPast).aestronglyMeasurable

/-- Helper for Exercise 17.1.1: the one-coordinate Markov identity extends from future events to
scalar multiples of one future event after integrating over a past event. -/
lemma pastSetIntegral_stateIndicator_eq_present
    (μ : Measure Ω) [IsProbabilityMeasure μ] (X : T → Ω → E)
    (hMarkov : HasNaturalMarkovProperty μ X) {t u : T} (htu : t ≤ u)
    {C : Set Ω} (hC : MeasurableSet[generatedFiltrationSpace X t] C)
    {A : Set E} (hA : MeasurableSet A) (c : ℝ) :
    ∫ ω in C,
        (μ[(X u ⁻¹' A).indicator (fun _ ↦ c) |
          MeasurableSpace.comap (X t) ‹MeasurableSpace E›]) ω ∂μ =
      ∫ ω in C, ((X u ⁻¹' A).indicator (fun _ ↦ c)) ω ∂μ := by
  let B : Set Ω := X u ⁻¹' A
  have hmPast : generatedFiltrationSpace X t ≤ ‹MeasurableSpace Ω› := by
    exact generatedFiltrationSpace_le_ambient (X := X) hMarkov.1 t
  have hB : MeasurableSet B := by
    simpa [B] using (hMarkov.1 u) hA
  have hIndicatorInt : Integrable (B.indicator (fun _ ↦ (1 : ℝ))) μ :=
    (integrable_const (1 : ℝ)).indicator hB
  have hIndicatorConst :
      B.indicator (fun _ ↦ c) = c • B.indicator (fun _ ↦ (1 : ℝ)) := by
    ext ω
    by_cases hω : ω ∈ B <;> simp [B, Set.indicator, hω]
  have hPresent_smul :
      μ[B.indicator (fun _ ↦ c) | MeasurableSpace.comap (X t) ‹MeasurableSpace E›] =ᵐ[μ]
        fun ω ↦ c * (μ⟦B | MeasurableSpace.comap (X t) ‹MeasurableSpace E›⟧) ω := by
    -- Proof comment: rewrite the indicator with value `c` as `c` times the event indicator, then
    -- use conditional-expectation linearity.
    calc
      μ[B.indicator (fun _ ↦ c) | MeasurableSpace.comap (X t) ‹MeasurableSpace E›]
          =ᵐ[μ] μ[c • B.indicator (fun _ ↦ (1 : ℝ)) |
            MeasurableSpace.comap (X t) ‹MeasurableSpace E›] := by
            simp [hIndicatorConst]
      _ =ᵐ[μ] c • μ[B.indicator (fun _ ↦ (1 : ℝ)) |
            MeasurableSpace.comap (X t) ‹MeasurableSpace E›] := by
            exact
              MeasureTheory.condExp_smul c (B.indicator (fun _ ↦ (1 : ℝ)))
                (MeasurableSpace.comap (X t) ‹MeasurableSpace E›)
      _ =ᵐ[μ] fun ω ↦ c * (μ⟦B | MeasurableSpace.comap (X t) ‹MeasurableSpace E›⟧) ω := by
            rfl
  have hPastEvent :
      μ⟦B | MeasurableSpace.comap (X t) ‹MeasurableSpace E›⟧ =ᵐ[μ]
        μ⟦B | generatedFiltrationSpace X t⟧ := by
    simpa [B] using
      (hMarkov.2 (s := t) (u := u) htu (A := A) hA).symm
  have hPastMul :
      (fun ω ↦ c * (μ⟦B | MeasurableSpace.comap (X t) ‹MeasurableSpace E›⟧) ω) =ᵐ[μ]
        fun ω ↦ c * (μ⟦B | generatedFiltrationSpace X t⟧) ω := by
    -- Proof comment: multiply the one-event Markov identity by the fixed scalar `c`.
    filter_upwards [hPastEvent] with ω hω
    simp [hω]
  have hPresent_smul_on :
      ∀ᵐ ω ∂μ,
        ω ∈ C →
          (μ[B.indicator (fun _ ↦ c) | MeasurableSpace.comap (X t) ‹MeasurableSpace E›]) ω =
            c * (μ⟦B | MeasurableSpace.comap (X t) ‹MeasurableSpace E›⟧) ω := by
    filter_upwards [hPresent_smul] with ω hω _
    exact hω
  have hPastMul_on :
      ∀ᵐ ω ∂μ,
        ω ∈ C →
          c * (μ⟦B | MeasurableSpace.comap (X t) ‹MeasurableSpace E›⟧) ω =
            c * (μ⟦B | generatedFiltrationSpace X t⟧) ω := by
    filter_upwards [hPastMul] with ω hω _
    exact hω
  calc
    ∫ ω in C,
        (μ[B.indicator (fun _ ↦ c) | MeasurableSpace.comap (X t) ‹MeasurableSpace E›]) ω ∂μ
        =
          ∫ ω in C,
            (c * (μ⟦B | MeasurableSpace.comap (X t) ‹MeasurableSpace E›⟧) ω) ∂μ := by
            exact setIntegral_congr_ae (hmPast C hC) hPresent_smul_on
    _ = ∫ ω in C, (c * (μ⟦B | generatedFiltrationSpace X t⟧) ω) ∂μ := by
          exact setIntegral_congr_ae (hmPast C hC) hPastMul_on
    _ = c * ∫ ω in C, (μ⟦B | generatedFiltrationSpace X t⟧) ω ∂μ := by
          rw [integral_const_mul]
    _ = c * ∫ ω in C, (B.indicator (fun _ ↦ (1 : ℝ))) ω ∂μ := by
          congr 1
          exact MeasureTheory.setIntegral_condExp hmPast hIndicatorInt hC
    _ = ∫ ω in C, (B.indicator (fun _ ↦ c)) ω ∂μ := by
          rw [← integral_const_mul]
          congr 1
          ext ω
          by_cases hω : ω ∈ B <;> simp [Set.indicator, hω]

/-- Helper for Exercise 17.1.1: the past-set integral identity for one future coordinate extends
from indicator observables to simple real-valued observables. -/
lemma pastSetIntegral_stateSimpleFunc_eq_present
    (μ : Measure Ω) [IsProbabilityMeasure μ] (X : T → Ω → E)
    (hMarkov : HasNaturalMarkovProperty μ X) {t u : T} (htu : t ≤ u)
    {C : Set Ω} (hC : MeasurableSet[generatedFiltrationSpace X t] C)
    (φ : MeasureTheory.SimpleFunc E ℝ) :
    ∫ ω in C,
        (μ[φ.comp (X u) (hMarkov.1 u) |
          MeasurableSpace.comap (X t) ‹MeasurableSpace E›]) ω ∂μ =
      ∫ ω in C, (φ.comp (X u) (hMarkov.1 u)) ω ∂μ := by
  have hmPast : generatedFiltrationSpace X t ≤ ‹MeasurableSpace Ω› := by
    exact generatedFiltrationSpace_le_ambient (X := X) hMarkov.1 t
  refine MeasureTheory.SimpleFunc.induction ?_ ?_ φ
  · intro c s hs
    -- Proof comment: the simple-function base case is exactly a scalar indicator of the event
    -- `{X u ∈ s}` over the past test set `C`.
    simpa [Function.comp, Set.indicator, SimpleFunc.coe_piecewise, SimpleFunc.coe_const,
      SimpleFunc.coe_zero] using
      pastSetIntegral_stateIndicator_eq_present
        (μ := μ) (X := X) hMarkov htu (C := C) hC (A := s) hs c
  · intro f g _ hf hg
    have hfInt : Integrable (f.comp (X u) (hMarkov.1 u)) μ :=
      MeasureTheory.SimpleFunc.integrable_of_isFiniteMeasure _
    have hgInt : Integrable (g.comp (X u) (hMarkov.1 u)) μ :=
      MeasureTheory.SimpleFunc.integrable_of_isFiniteMeasure _
    have hfCondInt :
        Integrable
          (μ[f.comp (X u) (hMarkov.1 u) | MeasurableSpace.comap (X t) ‹MeasurableSpace E›]) μ := by
      simpa using
        (integrable_condExp :
          Integrable
            (μ[f.comp (X u) (hMarkov.1 u) | MeasurableSpace.comap (X t) ‹MeasurableSpace E›]) μ)
    have hgCondInt :
        Integrable
          (μ[g.comp (X u) (hMarkov.1 u) | MeasurableSpace.comap (X t) ‹MeasurableSpace E›]) μ := by
      simpa using
        (integrable_condExp :
          Integrable
            (μ[g.comp (X u) (hMarkov.1 u) | MeasurableSpace.comap (X t) ‹MeasurableSpace E›]) μ)
    have hAdd_on :
        ∀ᵐ ω ∂μ,
          ω ∈ C →
            (μ[(f + g).comp (X u) (hMarkov.1 u) |
              MeasurableSpace.comap (X t) ‹MeasurableSpace E›]) ω =
              (μ[f.comp (X u) (hMarkov.1 u) |
                MeasurableSpace.comap (X t) ‹MeasurableSpace E›]) ω +
                (μ[g.comp (X u) (hMarkov.1 u) |
                  MeasurableSpace.comap (X t) ‹MeasurableSpace E›]) ω := by
      filter_upwards
        [MeasureTheory.condExp_add hfInt hgInt
          (MeasurableSpace.comap (X t) ‹MeasurableSpace E›)] with ω hω _
      simpa [Function.comp, SimpleFunc.coe_add] using hω
    -- Proof comment: the induction step uses linearity of conditional expectation and of the
    -- set integral; the disjoint-support side condition is part of the library induction API.
    calc
      ∫ ω in C,
          (μ[(f + g).comp (X u) (hMarkov.1 u) |
            MeasurableSpace.comap (X t) ‹MeasurableSpace E›]) ω ∂μ
          = ∫ ω in C,
              ((μ[f.comp (X u) (hMarkov.1 u) |
                MeasurableSpace.comap (X t) ‹MeasurableSpace E›]) ω +
                (μ[g.comp (X u) (hMarkov.1 u) |
                  MeasurableSpace.comap (X t) ‹MeasurableSpace E›]) ω) ∂μ := by
                  exact setIntegral_congr_ae (hmPast C hC) hAdd_on
      _ = ∫ ω in C,
            (μ[f.comp (X u) (hMarkov.1 u) |
              MeasurableSpace.comap (X t) ‹MeasurableSpace E›]) ω ∂μ +
            ∫ ω in C,
              (μ[g.comp (X u) (hMarkov.1 u) |
                MeasurableSpace.comap (X t) ‹MeasurableSpace E›]) ω ∂μ := by
              rw [integral_add hfCondInt.integrableOn hgCondInt.integrableOn]
      _ = ∫ ω in C, (f.comp (X u) (hMarkov.1 u)) ω ∂μ +
            ∫ ω in C, (g.comp (X u) (hMarkov.1 u)) ω ∂μ := by
              rw [hf, hg]
      _ = ∫ ω in C,
            ((f.comp (X u) (hMarkov.1 u)) ω + (g.comp (X u) (hMarkov.1 u)) ω) ∂μ := by
              rw [← integral_add hfInt.integrableOn hgInt.integrableOn]
      _ = ∫ ω in C, ((f + g).comp (X u) (hMarkov.1 u)) ω ∂μ := by
              simp [Function.comp, SimpleFunc.coe_add]

/-- Helper for Exercise 17.1.1: the one-coordinate Markov identity extends from future events to
simple real-valued observables of one future coordinate. -/
lemma condExp_simpleFutureObservable_eq_present
    (μ : Measure Ω) [IsProbabilityMeasure μ] (X : T → Ω → E)
    (hMarkov : HasNaturalMarkovProperty μ X) {t u : T} (htu : t ≤ u)
    (φ : MeasureTheory.SimpleFunc E ℝ) :
    μ[φ.comp (X u) (hMarkov.1 u) | generatedFiltrationSpace X t] =ᵐ[μ]
      μ[φ.comp (X u) (hMarkov.1 u) | MeasurableSpace.comap (X t) ‹MeasurableSpace E›] := by
  have hmPast : generatedFiltrationSpace X t ≤ ‹MeasurableSpace Ω› := by
    exact generatedFiltrationSpace_le_ambient (X := X) hMarkov.1 t
  have hmPresentPast :
      MeasurableSpace.comap (X t) ‹MeasurableSpace E› ≤ generatedFiltrationSpace X t :=
    present_le_generatedFiltrationSpace (X := X) t
  have hφInt : Integrable (φ.comp (X u) (hMarkov.1 u)) μ :=
    MeasureTheory.SimpleFunc.integrable_of_isFiniteMeasure _
  -- Route correction: the old direct theorem-level `SimpleFunc` proof was the wrong induction
  -- surface. The repaired route proves the set-integral identity on past events first, then uses
  -- uniqueness of conditional expectation once.
  exact
    (MeasureTheory.ae_eq_condExp_of_forall_setIntegral_eq hmPast hφInt
      (fun C _ _ ↦ by
        simpa using
          (integrable_condExp :
            Integrable
              (μ[φ.comp (X u) (hMarkov.1 u) |
                MeasurableSpace.comap (X t) ‹MeasurableSpace E›]) μ).integrableOn)
      (fun C hC _ ↦ by
        simpa using
          pastSetIntegral_stateSimpleFunc_eq_present
            (μ := μ) (X := X) hMarkov htu (C := C) hC φ)
      ((stronglyMeasurable_condExp.mono hmPresentPast).aestronglyMeasurable)).symm

/-- Helper for Exercise 17.1.1: approximants of a `[0, 1]`-valued observable remain
`[0, 1]`-valued. -/
lemma approxOn_mem_Icc_zero_one
    {φ : E → ℝ} (hφ_meas : Measurable φ)
    (hφ_unit : ∀ x, 0 ≤ φ x ∧ φ x ≤ 1) (n : ℕ) :
    ∀ x,
      0 ≤ (MeasureTheory.SimpleFunc.approxOn φ hφ_meas (Set.range φ ∪ {0}) 0 (by simp) n) x ∧
        (MeasureTheory.SimpleFunc.approxOn φ hφ_meas (Set.range φ ∪ {0}) 0 (by simp) n) x ≤ 1 := by
  -- Proof comment: every approximant value stays in `range φ ∪ {0}` by `approxOn_mem`, so it is
  -- either an actual value of `φ`, where the unit-interval bound is assumed, or the fallback
  -- value `0`.
  intro x
  have hx :
      (MeasureTheory.SimpleFunc.approxOn φ hφ_meas (Set.range φ ∪ {0}) 0 (by simp) n) x ∈
        Set.range φ ∪ ({0} : Set ℝ) :=
    MeasureTheory.SimpleFunc.approxOn_mem
      (f := φ) hφ_meas (s := Set.range φ ∪ {0}) (y₀ := 0) (h₀ := by simp) n x
  simp only [Set.mem_union, Set.mem_range, Set.mem_singleton_iff] at hx
  rcases hx with ⟨y, hy⟩ | hzero
  · rw [← hy]
    exact hφ_unit y
  · rw [hzero]
    constructor <;> norm_num

/-- Helper for Exercise 17.1.1: the present-state conditional expectation of a future event can
be factored through the present coordinate and clipped to `[0, 1]`. -/
lemma existsFutureTailFactorThroughPresent
    (μ : Measure Ω) [IsProbabilityMeasure μ] (X : T → Ω → E)
    (hX : ∀ r : T, Measurable (X r)) {u : T} {D : Set Ω}
    (hD : MeasurableSet[processFuture X u] D) :
    ∃ ψ : E → ℝ, Measurable ψ ∧ (∀ x, 0 ≤ ψ x ∧ ψ x ≤ 1) ∧
      μ⟦D | MeasurableSpace.comap (X u) ‹MeasurableSpace E›⟧ =ᵐ[μ] fun ω ↦ ψ (X u ω) := by
  have hmFuture : processFuture X u ≤ ‹MeasurableSpace Ω› :=
    processFuture_le_ambient (X := X) hX u
  have hD_ambient : MeasurableSet D := hmFuture D hD
  have hDint : Integrable (D.indicator fun _ ↦ (1 : ℝ)) μ :=
    (integrable_const (1 : ℝ)).indicator hD_ambient
  have hcondMeas :
      Measurable[MeasurableSpace.comap (X u) ‹MeasurableSpace E›]
        (μ⟦D | MeasurableSpace.comap (X u) ‹MeasurableSpace E›⟧) :=
    stronglyMeasurable_condExp.measurable
  obtain ⟨ψRaw, hψRaw_meas, hψRaw_eq⟩ := hcondMeas.exists_eq_measurable_comp
  let ψ : E → ℝ := fun x ↦ max 0 (min 1 (ψRaw x))
  have hψ_meas : Measurable ψ := by
    -- Proof comment: clipping a measurable real function to `[0, 1]` preserves measurability.
    exact measurable_const.max (measurable_const.min hψRaw_meas)
  have hψ_unit : ∀ x, 0 ≤ ψ x ∧ ψ x ≤ 1 := by
    -- Proof comment: the clipped representative is pointwise valued in `[0, 1]`.
    intro x
    constructor
    · exact le_max_left 0 (min 1 (ψRaw x))
    · exact max_le_iff.2 ⟨by norm_num, min_le_left _ _⟩
  have hIndicator_nonneg : 0 ≤ᵐ[μ] D.indicator (fun _ ↦ (1 : ℝ)) := by
    filter_upwards with ω
    by_cases hω : ω ∈ D <;> simp [Set.indicator, hω]
  have hIndicator_le_one : D.indicator (fun _ ↦ (1 : ℝ)) ≤ᵐ[μ] fun _ ↦ (1 : ℝ) := by
    filter_upwards with ω
    by_cases hω : ω ∈ D <;> simp [Set.indicator, hω]
  have hcond_nonneg :
      0 ≤ᵐ[μ] μ⟦D | MeasurableSpace.comap (X u) ‹MeasurableSpace E›⟧ :=
    MeasureTheory.condExp_nonneg (μ := μ) (m := MeasurableSpace.comap (X u) ‹MeasurableSpace E›)
      hIndicator_nonneg
  have hcond_le_one :
      μ⟦D | MeasurableSpace.comap (X u) ‹MeasurableSpace E›⟧ ≤ᵐ[μ] fun _ ↦ (1 : ℝ) := by
    have hmono :=
      MeasureTheory.condExp_mono
        (μ := μ) (m := MeasurableSpace.comap (X u) ‹MeasurableSpace E›)
        hDint (integrable_const (1 : ℝ)) hIndicator_le_one
    exact hmono.trans_eq <|
      Filter.EventuallyEq.of_eq
        (MeasureTheory.condExp_const (hX u).comap_le (1 : ℝ))
  have hclip :
      (fun ω ↦ ψRaw (X u ω)) =ᵐ[μ] fun ω ↦ ψ (X u ω) := by
    -- Proof comment: on the almost-sure set where the conditional probability is already in
    -- `[0, 1]`, clipping leaves the factorization unchanged.
    filter_upwards [hcond_nonneg, hcond_le_one] with ω hω_nonneg hω_le
    have hω_eq :
        (μ⟦D | MeasurableSpace.comap (X u) ‹MeasurableSpace E›⟧) ω = ψRaw (X u ω) := by
      simpa [Function.comp] using congrFun hψRaw_eq ω
    have hω_unit : 0 ≤ ψRaw (X u ω) ∧ ψRaw (X u ω) ≤ 1 := by
      constructor
      · simpa [hω_eq] using hω_nonneg
      · simpa [hω_eq] using hω_le
    simp [ψ, hω_unit.1, hω_unit.2]
  refine ⟨ψ, hψ_meas, hψ_unit, ?_⟩
  exact (Filter.EventuallyEq.of_eq hψRaw_eq).trans hclip

/-- Helper for Exercise 17.1.1: after composing with one process coordinate, the `[0,1]` bounds
on `SimpleFunc.approxOn` remain unchanged and give a uniform norm bound by `1`. -/
lemma approxOn_futureObservable_norm_le_one
    (X : T → Ω → E) {u : T} {φ : E → ℝ} (hφ_meas : Measurable φ)
    (hφ_unit : ∀ x, 0 ≤ φ x ∧ φ x ≤ 1) (n : ℕ) :
    ∀ ω,
      ‖(MeasureTheory.SimpleFunc.approxOn φ hφ_meas (Set.range φ ∪ {0}) 0 (by simp) n)
          (X u ω)‖ ≤ 1 := by
  intro ω
  -- Proof comment: `approxOn` stays in `[0,1]`, so the real norm equals the value itself.
  rcases approxOn_mem_Icc_zero_one hφ_meas hφ_unit n (X u ω) with ⟨h_nonneg, h_le_one⟩
  have hAbs :
      |(MeasureTheory.SimpleFunc.approxOn φ hφ_meas (Set.range φ ∪ {0}) 0 (by simp) n)
          (X u ω)| ≤ 1 := by
    rw [abs_of_nonneg h_nonneg]
    exact h_le_one
  simpa [Real.norm_eq_abs] using hAbs

/-- Helper for Exercise 17.1.1: the `approxOn` approximants of a measurable observable converge
pointwise after composing with a fixed process coordinate. -/
lemma tendsto_approxOn_futureObservable
    (X : T → Ω → E) {u : T} {φ : E → ℝ} (hφ_meas : Measurable φ) :
    ∀ ω,
      Filter.Tendsto
        (fun n ↦
          (MeasureTheory.SimpleFunc.approxOn φ hφ_meas (Set.range φ ∪ {0}) 0 (by simp) n)
            (X u ω))
        Filter.atTop (nhds (φ (X u ω))) := by
  intro ω
  -- Proof comment: the future observable takes values in `range φ`, hence in the closure of the
  -- approximation range `range φ ∪ {0}`.
  have hω :
      φ (X u ω) ∈ closure (Set.range φ ∪ ({0} : Set ℝ)) :=
    subset_closure <| by
      exact Or.inl ⟨X u ω, rfl⟩
  simpa using MeasureTheory.SimpleFunc.tendsto_approxOn hφ_meas (by simp) hω

/-- Helper for Exercise 17.1.1: the past-set testing identity extends from simple future
observables to bounded `[0, 1]`-valued observables of one future coordinate. -/
-- TODO: isolate the `approxOn`/`condExpL1` dominated-convergence package into a separate bridge
-- lemma; keeping the whole limit argument inline still exhausts the declaration budget here.
lemma pastSetIntegral_boundedStateObservable_eq_present
    (μ : Measure Ω) [IsProbabilityMeasure μ] (X : T → Ω → E)
    (hMarkov : HasNaturalMarkovProperty μ X) {t u : T} (htu : t ≤ u)
    {C : Set Ω} (hC : MeasurableSet[generatedFiltrationSpace X t] C)
    {φ : E → ℝ} (hφ_meas : Measurable φ)
    (hφ_unit : ∀ x, 0 ≤ φ x ∧ φ x ≤ 1) :
    ∫ ω in C,
        (μ[fun ω ↦ φ (X u ω) |
          MeasurableSpace.comap (X t) ‹MeasurableSpace E›]) ω ∂μ =
      ∫ ω in C, φ (X u ω) ∂μ := by
  let φₙ : ℕ → MeasureTheory.SimpleFunc E ℝ := fun n ↦
    MeasureTheory.SimpleFunc.approxOn φ hφ_meas (Set.range φ ∪ {0}) 0 (by simp) n
  let f : Ω → ℝ := fun ω ↦ φ (X u ω)
  let fₙ : ℕ → Ω → ℝ := fun n ω ↦ φₙ n (X u ω)
  have hmPast : generatedFiltrationSpace X t ≤ ‹MeasurableSpace Ω› := by
    exact generatedFiltrationSpace_le_ambient (X := X) hMarkov.1 t
  have hmPresent : MeasurableSpace.comap (X t) ‹MeasurableSpace E› ≤ ‹MeasurableSpace Ω› := by
    exact (hMarkov.1 t).comap_le
  have hC_ambient : MeasurableSet C := hmPast C hC
  have hf_int : Integrable f μ := by
    refine Integrable.of_bound ((hφ_meas.comp (hMarkov.1 u)).aestronglyMeasurable) 1 ?_
    filter_upwards with ω
    rcases hφ_unit (X u ω) with ⟨h_nonneg, h_le_one⟩
    simpa [f, Real.norm_eq_abs, abs_of_nonneg h_nonneg] using h_le_one
  have hfₙ_meas : ∀ n, Measurable (fₙ n) := by
    intro n
    exact (φₙ n).measurable.comp (hMarkov.1 u)
  have hfₙ_int : ∀ n, Integrable (fₙ n) μ := by
    intro n
    simpa [fₙ, φₙ] using
      (MeasureTheory.SimpleFunc.integrable_of_isFiniteMeasure
        ((φₙ n).comp (X u) (hMarkov.1 u)))
  have hfₙ_bound : ∀ n ω, ‖fₙ n ω‖ ≤ (1 : ℝ) := by
    intro n
    intro ω
    simpa [fₙ, φₙ] using
      approxOn_futureObservable_norm_le_one
        (X := X) (u := u) (φ := φ) hφ_meas hφ_unit n ω
  have hfₙ_tendsto : ∀ ω, Filter.Tendsto (fun n ↦ fₙ n ω) Filter.atTop (nhds (f ω)) := by
    intro ω
    simpa [f, fₙ, φₙ] using
      tendsto_approxOn_futureObservable (X := X) (u := u) (φ := φ) hφ_meas ω
  have hBoundInt : Integrable (fun _ : Ω ↦ (1 : ℝ)) μ :=
    integrable_const 1
  have hCondTendsto :
      Filter.Tendsto (fun n ↦ MeasureTheory.condExpL1 hmPresent μ (fₙ n)) Filter.atTop
        (nhds (MeasureTheory.condExpL1 hmPresent μ f)) := by
    exact
      MeasureTheory.tendsto_condExpL1_of_dominated_convergence
        hmPresent (bound_fs := fun _ : Ω ↦ (1 : ℝ))
        (hfs_meas := fun n ↦ (hfₙ_meas n).aestronglyMeasurable)
        hBoundInt
        (fun n ↦ Filter.Eventually.of_forall fun ω ↦ hfₙ_bound n ω)
        (Filter.Eventually.of_forall hfₙ_tendsto)
  have hLeftTendstoL1 :
      Filter.Tendsto
        (fun n ↦ ∫ ω in C, MeasureTheory.condExpL1 hmPresent μ (fₙ n) ω ∂μ)
        Filter.atTop
        (nhds (∫ ω in C, MeasureTheory.condExpL1 hmPresent μ f ω ∂μ)) := by
    simpa using
      ((MeasureTheory.continuous_setIntegral (μ := μ) C).tendsto
        (MeasureTheory.condExpL1 hmPresent μ f)).comp hCondTendsto
  have hLeftEq : ∀ n,
      ∫ ω in C, (μ[fₙ n | MeasurableSpace.comap (X t) ‹MeasurableSpace E›]) ω ∂μ =
        ∫ ω in C, MeasureTheory.condExpL1 hmPresent μ (fₙ n) ω ∂μ := by
    intro n
    have hAe :
        ∀ᵐ ω ∂μ,
          ω ∈ C →
            (μ[fₙ n | MeasurableSpace.comap (X t) ‹MeasurableSpace E›]) ω =
              MeasureTheory.condExpL1 hmPresent μ (fₙ n) ω := by
      filter_upwards [MeasureTheory.condExp_ae_eq_condExpL1 hmPresent (fₙ n)] with ω hω _
      exact hω
    exact setIntegral_congr_ae hC_ambient hAe
  have hLeftLimitEq :
      ∫ ω in C, (μ[f | MeasurableSpace.comap (X t) ‹MeasurableSpace E›]) ω ∂μ =
        ∫ ω in C, MeasureTheory.condExpL1 hmPresent μ f ω ∂μ := by
    have hAe :
        ∀ᵐ ω ∂μ,
          ω ∈ C →
            (μ[f | MeasurableSpace.comap (X t) ‹MeasurableSpace E›]) ω =
              MeasureTheory.condExpL1 hmPresent μ f ω := by
      filter_upwards [MeasureTheory.condExp_ae_eq_condExpL1 hmPresent f] with ω hω _
      exact hω
    exact setIntegral_congr_ae hC_ambient hAe
  have hLeftTendsto :
      Filter.Tendsto
        (fun n ↦ ∫ ω in C,
          (μ[fₙ n | MeasurableSpace.comap (X t) ‹MeasurableSpace E›]) ω ∂μ)
        Filter.atTop
        (nhds (∫ ω in C, (μ[f | MeasurableSpace.comap (X t) ‹MeasurableSpace E›]) ω ∂μ)) := by
    have hSeqEq :
        (fun n ↦ ∫ ω in C,
          (μ[fₙ n | MeasurableSpace.comap (X t) ‹MeasurableSpace E›]) ω ∂μ) =
          fun n ↦ ∫ ω in C, MeasureTheory.condExpL1 hmPresent μ (fₙ n) ω ∂μ := by
      funext n
      exact hLeftEq n
    rw [hSeqEq, hLeftLimitEq]
    exact hLeftTendstoL1
  have hRightTendsto :
      Filter.Tendsto (fun n ↦ ∫ ω in C, fₙ n ω ∂μ) Filter.atTop (nhds (∫ ω in C, f ω ∂μ)) := by
    simpa [Measure.restrict_apply, hC_ambient, f, fₙ] using
      (MeasureTheory.tendsto_integral_filter_of_dominated_convergence
        (μ := μ.restrict C) (bound := fun _ : Ω ↦ (1 : ℝ))
        (hF_meas := Filter.Eventually.of_forall fun n ↦ (hfₙ_meas n).aestronglyMeasurable)
        (h_bound := Filter.Eventually.of_forall fun n ↦
          Filter.Eventually.of_forall fun ω ↦ hfₙ_bound n ω)
        (bound_integrable := integrable_const 1)
        (h_lim := Filter.Eventually.of_forall hfₙ_tendsto))
  have hStep :
      ∀ n,
        ∫ ω in C, (μ[fₙ n | MeasurableSpace.comap (X t) ‹MeasurableSpace E›]) ω ∂μ =
          ∫ ω in C, fₙ n ω ∂μ := by
    intro n
    simpa [fₙ, φₙ] using
      pastSetIntegral_stateSimpleFunc_eq_present
        (μ := μ) (X := X) hMarkov htu (C := C) hC (φₙ n)
  have hRightFromLeft :
      Filter.Tendsto
        (fun n ↦ ∫ ω in C,
          (μ[fₙ n | MeasurableSpace.comap (X t) ‹MeasurableSpace E›]) ω ∂μ)
        Filter.atTop
        (nhds (∫ ω in C, f ω ∂μ)) := by
    have hSeqEq :
        (fun n ↦ ∫ ω in C,
          (μ[fₙ n | MeasurableSpace.comap (X t) ‹MeasurableSpace E›]) ω ∂μ) =
          fun n ↦ ∫ ω in C, fₙ n ω ∂μ := by
      funext n
      exact hStep n
    rw [hSeqEq]
    exact hRightTendsto
  exact tendsto_nhds_unique hLeftTendsto hRightFromLeft

/-- Helper for Exercise 17.1.1: the one-coordinate Markov identity extends from future events to
bounded `[0, 1]`-valued observables of one future coordinate. -/
lemma condExp_boundedStateObservable_eq_present
    (μ : Measure Ω) [IsProbabilityMeasure μ] (X : T → Ω → E)
    (hMarkov : HasNaturalMarkovProperty μ X) {t u : T} (htu : t ≤ u)
    {φ : E → ℝ} (hφ_meas : Measurable φ)
    (hφ_unit : ∀ x, 0 ≤ φ x ∧ φ x ≤ 1) :
    μ[fun ω ↦ φ (X u ω) | generatedFiltrationSpace X t] =ᵐ[μ]
      μ[fun ω ↦ φ (X u ω) | MeasurableSpace.comap (X t) ‹MeasurableSpace E›] := by
  have hmPast : generatedFiltrationSpace X t ≤ ‹MeasurableSpace Ω› := by
    exact generatedFiltrationSpace_le_ambient (X := X) hMarkov.1 t
  have hmPresentPast :
      MeasurableSpace.comap (X t) ‹MeasurableSpace E› ≤ generatedFiltrationSpace X t :=
    present_le_generatedFiltrationSpace (X := X) t
  have hObservable_int : Integrable (fun ω ↦ φ (X u ω)) μ := by
    -- Proof comment: bounded one-coordinate observables are integrable under a probability
    -- measure because their norm is uniformly bounded by `1`.
    refine Integrable.of_bound ((hφ_meas.comp (hMarkov.1 u)).aestronglyMeasurable) 1 ?_
    filter_upwards with ω
    rcases hφ_unit (X u ω) with ⟨h_nonneg, h_le_one⟩
    simpa [Real.norm_eq_abs, abs_of_nonneg h_nonneg] using h_le_one
  -- Proof comment: after the set-integral identity has been upgraded to bounded observables, the
  -- conditional expectations are identified once more by the standard uniqueness principle.
  exact
    (MeasureTheory.ae_eq_condExp_of_forall_setIntegral_eq hmPast hObservable_int
      (fun C _ _ ↦ by
        simpa using
          (MeasureTheory.integrable_condExp : Integrable
            (μ[fun ω ↦ φ (X u ω) | MeasurableSpace.comap (X t) ‹MeasurableSpace E›]) μ).integrableOn)
      (fun C hC _ ↦ by
        simpa using
          pastSetIntegral_boundedStateObservable_eq_present
            (μ := μ) (X := X) hMarkov htu (C := C) hC hφ_meas hφ_unit)
      ((MeasureTheory.stronglyMeasurable_condExp.mono hmPresentPast).aestronglyMeasurable)).symm

/-- Helper for Exercise 17.1.1: once a tail event factors through the present at time `u0`,
adjoining one state event at time `u0` preserves the history-versus-present conditional-expectation
identity back at any earlier time `t ≤ u0`. -/
lemma condExp_headTailInter_eq_present
    (μ : Measure Ω) [IsProbabilityMeasure μ] (X : T → Ω → E)
    (hMarkov : HasNaturalMarkovProperty μ X) {t u0 : T} (htu0 : t ≤ u0)
    {A0 : Set E} (hA0 : MeasurableSet A0) {D : Set Ω}
    (hD : MeasurableSet[processFuture X u0] D)
    (hTailDesc :
      μ⟦D | generatedFiltrationSpace X u0⟧ =ᵐ[μ]
        μ⟦D | MeasurableSpace.comap (X u0) ‹MeasurableSpace E›⟧) :
    μ⟦X u0 ⁻¹' A0 ∩ D | generatedFiltrationSpace X t⟧ =ᵐ[μ]
      μ⟦X u0 ⁻¹' A0 ∩ D | MeasurableSpace.comap (X t) ‹MeasurableSpace E›⟧ := by
  let B : Set Ω := X u0 ⁻¹' A0 ∩ D
  obtain ⟨ψ, hψ_meas, hψ_unit, hψ⟩ :=
    existsFutureTailFactorThroughPresent (μ := μ) (X := X) hMarkov.1 hD
  let φ : E → ℝ := Set.indicator A0 ψ
  let stateObservable : Ω → ℝ := fun ω ↦ φ (X u0 ω)
  let headIndicator : Ω → ℝ := (X u0 ⁻¹' A0).indicator (fun _ ↦ (1 : ℝ))
  have hmPast_t : generatedFiltrationSpace X t ≤ ‹MeasurableSpace Ω› := by
    exact generatedFiltrationSpace_le_ambient (X := X) hMarkov.1 t
  have hmPast_u0 : generatedFiltrationSpace X u0 ≤ ‹MeasurableSpace Ω› := by
    exact generatedFiltrationSpace_le_ambient (X := X) hMarkov.1 u0
  have hmPresent_t : MeasurableSpace.comap (X t) ‹MeasurableSpace E› ≤ ‹MeasurableSpace Ω› := by
    exact (hMarkov.1 t).comap_le
  have hmPresentPast_t :
      MeasurableSpace.comap (X t) ‹MeasurableSpace E› ≤ generatedFiltrationSpace X t := by
    exact present_le_generatedFiltrationSpace (X := X) t
  have hHeadAmbient : MeasurableSet (X u0 ⁻¹' A0) := by
    exact (hMarkov.1 u0) hA0
  have hDAmbient : MeasurableSet D :=
    measurableSet_processFuture_ambient (X := X) hMarkov.1 u0 hD
  have hBAmbient : MeasurableSet B := by
    exact hHeadAmbient.inter hDAmbient
  have hBInt : Integrable (B.indicator (fun _ ↦ (1 : ℝ))) μ :=
    (integrable_const (1 : ℝ)).indicator hBAmbient
  have hDInt : Integrable (D.indicator (fun _ ↦ (1 : ℝ))) μ :=
    (integrable_const (1 : ℝ)).indicator hDAmbient
  have hφ_meas : Measurable φ := by
    -- Proof comment: the clipped tail factor stays measurable after restricting to the head
    -- state event at time `u0`.
    exact hψ_meas.indicator hA0
  have hφ_unit : ∀ x, 0 ≤ φ x ∧ φ x ≤ 1 := by
    -- Proof comment: the indicator leaves the `[0,1]` bounds unchanged on `A0` and gives `0`
    -- off `A0`.
    intro x
    by_cases hx : x ∈ A0
    · simpa [φ, Set.indicator, hx] using hψ_unit x
    · constructor <;> simp [φ, Set.indicator, hx]
  have hStateInt : Integrable stateObservable μ := by
    -- Proof comment: the state observable is `[0,1]`-valued, so its norm is uniformly bounded by
    -- `1` under the probability measure `μ`.
    refine Integrable.of_bound ((hφ_meas.comp (hMarkov.1 u0)).aestronglyMeasurable) 1 ?_
    filter_upwards with ω
    rcases hφ_unit (X u0 ω) with ⟨h_nonneg, h_le_one⟩
    simpa [stateObservable, Real.norm_eq_abs, abs_of_nonneg h_nonneg] using h_le_one
  have hHeadHistory :
      MeasurableSet[generatedFiltrationSpace X u0] (X u0 ⁻¹' A0) := by
    -- Proof comment: the head event is present-measurable at time `u0`, hence also measurable in
    -- the history sigma-algebra at `u0`.
    exact
      present_le_generatedFiltrationSpace (X := X) u0 _ <|
        MeasurableSpace.measurableSet_comap.2 ⟨A0, hA0, rfl⟩
  have hHeadIndicatorSM :
      StronglyMeasurable[generatedFiltrationSpace X u0] headIndicator := by
    exact (Measurable.indicator measurable_const hHeadHistory).stronglyMeasurable
  have hInterIndicator :
      headIndicator * D.indicator (fun _ ↦ (1 : ℝ)) = B.indicator (fun _ ↦ (1 : ℝ)) := by
    -- Proof comment: multiplying the head and tail event indicators recovers the indicator of the
    -- head-tail intersection event.
    ext ω
    by_cases hωHead : ω ∈ X u0 ⁻¹' A0 <;> by_cases hωD : ω ∈ D <;>
      simp [headIndicator, B, Set.indicator, hωHead, hωD, Set.mem_inter_iff]
  have hStateEq :
      headIndicator * (fun ω ↦ ψ (X u0 ω)) = stateObservable := by
    -- Proof comment: the head indicator simply implements the same `Set.indicator A0`
    -- restriction after composing with `X u0`.
    ext ω
    by_cases hωHead : ω ∈ X u0 ⁻¹' A0
    · have hωA0 : X u0 ω ∈ A0 := hωHead
      simp [headIndicator, stateObservable, φ, Set.indicator, hωHead, hωA0]
    · have hωA0 : X u0 ω ∉ A0 := hωHead
      simp [headIndicator, stateObservable, φ, Set.indicator, hωHead, hωA0]
  have hBCond_u0 :
      μ⟦B | generatedFiltrationSpace X u0⟧ =ᵐ[μ] stateObservable := by
    -- Proof comment: pull the head indicator out of the `u0`-history conditional expectation,
    -- replace the tail conditional expectation by its present-state factor, and repackage the
    -- result as a bounded state observable of `X u0`.
    have hProductInt : Integrable (headIndicator * D.indicator (fun _ ↦ (1 : ℝ))) μ := by
      rw [hInterIndicator]
      exact hBInt
    calc
      μ⟦B | generatedFiltrationSpace X u0⟧ =ᵐ[μ]
          μ[headIndicator * D.indicator (fun _ ↦ (1 : ℝ)) | generatedFiltrationSpace X u0] := by
            exact MeasureTheory.condExp_congr_ae (Filter.EventuallyEq.of_eq hInterIndicator.symm)
      _ =ᵐ[μ] headIndicator * μ⟦D | generatedFiltrationSpace X u0⟧ := by
            exact
              MeasureTheory.condExp_mul_of_stronglyMeasurable_left
                hHeadIndicatorSM hProductInt hDInt
      _ =ᵐ[μ] headIndicator * μ⟦D | MeasurableSpace.comap (X u0) ‹MeasurableSpace E›⟧ := by
            exact (Filter.EventuallyEq.refl _ _).mul hTailDesc
      _ =ᵐ[μ] headIndicator * (fun ω ↦ ψ (X u0 ω)) := by
            exact (Filter.EventuallyEq.refl _ _).mul hψ
      _ =ᵐ[μ] stateObservable := by
            exact Filter.EventuallyEq.of_eq hStateEq
  have hStateIntegral_eq :
      ∀ ⦃C : Set Ω⦄, MeasurableSet[generatedFiltrationSpace X u0] C →
        ∫ ω in C, stateObservable ω ∂μ =
          ∫ ω in C, (B.indicator (fun _ ↦ (1 : ℝ))) ω ∂μ := by
    intro C hC
    have hBCond_u0_on :
        ∀ᵐ ω ∂μ,
          ω ∈ C → stateObservable ω = (μ⟦B | generatedFiltrationSpace X u0⟧) ω := by
      filter_upwards [hBCond_u0.symm] with ω hω _
      exact hω
    -- Proof comment: once the `u0`-history conditional expectation of `B` is identified with the
    -- state observable, their set integrals agree on every `u0`-history-measurable test set.
    calc
      ∫ ω in C, stateObservable ω ∂μ
          = ∫ ω in C, (μ⟦B | generatedFiltrationSpace X u0⟧) ω ∂μ := by
              exact setIntegral_congr_ae (hmPast_u0 C hC) hBCond_u0_on
      _ = ∫ ω in C, (B.indicator (fun _ ↦ (1 : ℝ))) ω ∂μ := by
            exact MeasureTheory.setIntegral_condExp hmPast_u0 hBInt hC
  have hHistoryEq :
      μ⟦B | generatedFiltrationSpace X t⟧ =ᵐ[μ]
        μ[stateObservable | generatedFiltrationSpace X t] := by
    -- Proof comment: every `t`-history test set is also a `u0`-history test set, so the same
    -- state observable identifies the `t`-history conditional expectation of `B`.
    exact
      (MeasureTheory.ae_eq_condExp_of_forall_setIntegral_eq hmPast_t hBInt
        (fun C _ _ ↦ by
          simpa using
            (MeasureTheory.integrable_condExp : Integrable
              (μ[stateObservable | generatedFiltrationSpace X t]) μ).integrableOn)
        (fun C hC _ ↦ by
          have hC_u0 : MeasurableSet[generatedFiltrationSpace X u0] C := by
            exact generatedFiltrationSpace_mono (X := X) htu0 _ hC
          calc
            ∫ ω in C, (μ[stateObservable | generatedFiltrationSpace X t]) ω ∂μ
                = ∫ ω in C, stateObservable ω ∂μ := by
                    exact MeasureTheory.setIntegral_condExp hmPast_t hStateInt hC
            _ = ∫ ω in C, (B.indicator (fun _ ↦ (1 : ℝ))) ω ∂μ := by
                  exact hStateIntegral_eq hC_u0)
        (MeasureTheory.stronglyMeasurable_condExp.aestronglyMeasurable)).symm
  have hPresentEq :
      μ⟦B | MeasurableSpace.comap (X t) ‹MeasurableSpace E›⟧ =ᵐ[μ]
        μ[stateObservable | MeasurableSpace.comap (X t) ‹MeasurableSpace E›] := by
    -- Proof comment: the same set-integral comparison also works for present-state test sets,
    -- because `σ(X t)` sits inside both `generatedFiltrationSpace X t` and
    -- `generatedFiltrationSpace X u0`.
    exact
      (MeasureTheory.ae_eq_condExp_of_forall_setIntegral_eq hmPresent_t hBInt
        (fun C _ _ ↦ by
          simpa using
            (MeasureTheory.integrable_condExp : Integrable
              (μ[stateObservable | MeasurableSpace.comap (X t) ‹MeasurableSpace E›]) μ).integrableOn)
        (fun C hC _ ↦ by
          have hC_hist_t : MeasurableSet[generatedFiltrationSpace X t] C := by
            exact hmPresentPast_t _ hC
          have hC_u0 : MeasurableSet[generatedFiltrationSpace X u0] C := by
            exact generatedFiltrationSpace_mono (X := X) htu0 _ hC_hist_t
          calc
            ∫ ω in C, (μ[stateObservable | MeasurableSpace.comap (X t) ‹MeasurableSpace E›]) ω ∂μ
                = ∫ ω in C, stateObservable ω ∂μ := by
                    exact MeasureTheory.setIntegral_condExp hmPresent_t hStateInt hC
            _ = ∫ ω in C, (B.indicator (fun _ ↦ (1 : ℝ))) ω ∂μ := by
                  exact hStateIntegral_eq hC_u0)
        (MeasureTheory.stronglyMeasurable_condExp.aestronglyMeasurable)).symm
  -- Proof comment: both conditional expectations of the head-tail event factor through the same
  -- bounded observable of `X u0`, and the one-coordinate bounded-observable lemma descends that
  -- common observable from the `t`-history to the present state `X t`.
  exact
    hHistoryEq.trans <|
      (condExp_boundedStateObservable_eq_present
        (μ := μ) (X := X) hMarkov htu0 hφ_meas hφ_unit).trans
        hPresentEq.symm

/-- Helper for Exercise 17.1.1: a future-coordinate `π`-system event can be rewritten as a finite
intersection of one-coordinate future events indexed directly by times in `T`. -/
lemma futureCoordinatePiSystem_elim_times
    (X : T → Ω → E) (t : T) {D : Set Ω}
    (hD :
      D ∈ generatePiSystem
        (⋃ u : {u : T // t ≤ u},
          {s : Set Ω | MeasurableSet[MeasurableSpace.comap (X u.1) ‹MeasurableSpace E›] s})) :
    ∃ S : Finset T, ∃ F : T → Set Ω,
      D = ⋂ u ∈ S, F u ∧
        (∀ u ∈ S, t ≤ u) ∧
        ∀ u ∈ S, MeasurableSet[MeasurableSpace.comap (X u) ‹MeasurableSpace E›] (F u) := by
  classical
  rcases mem_futureCoordinatePiSystem_elim (X := X) (t := t) hD with ⟨S', F', rfl, hF'⟩
  let S : Finset T := S'.image Subtype.val
  let F : T → Set Ω := fun u ↦ if htu : t ≤ u then F' ⟨u, htu⟩ else Set.univ
  refine ⟨S, F, ?_, ?_, ?_⟩
  · -- Proof comment: `Finset.image Subtype.val` is the plain-time view of the same finite future
    -- index set, so the finite intersection is unchanged after rewriting the factors through `F`.
    ext ω
    simp only [Set.mem_iInter]
    constructor
    · intro h u hu
      rcases Finset.mem_image.1 hu with ⟨v, hv, rfl⟩
      simpa [S, F, v.2] using h v hv
    · intro h u hu
      have hu' : u.1 ∈ S := Finset.mem_image.2 ⟨u, hu, rfl⟩
      simpa [S, F, u.2] using h u.1 hu'
  · -- Proof comment: every plain time in the image still comes from a genuine future index.
    intro u hu
    rcases Finset.mem_image.1 hu with ⟨v, hv, rfl⟩
    exact v.2
  · -- Proof comment: measurability is inherited from the original subtype-indexed factors.
    intro u hu
    rcases Finset.mem_image.1 hu with ⟨v, hv, rfl⟩
    simpa [S, F, v.2] using hF' v hv

/-- Helper for Exercise 17.1.1: a finite intersection of future coordinate events already satisfies
the present-state conditional-expectation identity. -/
-- TODO: replan around a dedicated split lemma for the nonempty finite future cylinder; the
-- current induction still rewrites the intersection against the wrong index surface.
lemma condExp_finiteFutureInter_eq_present
    (μ : Measure Ω) [IsProbabilityMeasure μ] (X : T → Ω → E)
    (hMarkov : HasNaturalMarkovProperty μ X) (S : Finset T) :
    ∀ t : T, (∀ u ∈ S, t ≤ u) → ∀ F : T → Set Ω,
      (∀ u ∈ S, MeasurableSet[MeasurableSpace.comap (X u) ‹MeasurableSpace E›] (F u)) →
        μ⟦⋂ u ∈ S, F u | generatedFiltrationSpace X t⟧ =ᵐ[μ]
          μ⟦⋂ u ∈ S, F u | MeasurableSpace.comap (X t) ‹MeasurableSpace E›⟧ := by
  classical
  induction S using Finset.induction_on_min with
  | empty =>
      intro t _ F _
      have hmPast : generatedFiltrationSpace X t ≤ ‹MeasurableSpace Ω› := by
        exact generatedFiltrationSpace_le_ambient (X := X) hMarkov.1 t
      have hmPresent : MeasurableSpace.comap (X t) ‹MeasurableSpace E› ≤ ‹MeasurableSpace Ω› := by
        exact (hMarkov.1 t).comap_le
      have hPastConst :
          μ⟦⋂ u ∈ (∅ : Finset T), F u | generatedFiltrationSpace X t⟧ =ᵐ[μ] (1 : Ω → ℝ) := by
        simpa using Filter.EventuallyEq.of_eq (MeasureTheory.condExp_const hmPast (1 : ℝ))
      have hPresentConst :
          μ⟦⋂ u ∈ (∅ : Finset T), F u |
              MeasurableSpace.comap (X t) ‹MeasurableSpace E›⟧ =ᵐ[μ] (1 : Ω → ℝ) := by
        simpa using Filter.EventuallyEq.of_eq (MeasureTheory.condExp_const hmPresent (1 : ℝ))
      exact hPastConst.trans hPresentConst.symm
  | insert a s hlt ih =>
      intro t ht F hF
      have hta : t ≤ a := ht a (by simp)
      have ha_not_mem : a ∉ s := by
        intro ha_mem
        exact (lt_irrefl a) (hlt a ha_mem)
      have hFa : MeasurableSet[MeasurableSpace.comap (X a) ‹MeasurableSpace E›] (F a) :=
        hF a (by simp)
      rcases MeasurableSpace.measurableSet_comap.1 hFa with ⟨A0, hA0, hA0eq⟩
      let D : Set Ω := ⋂ u ∈ s, F u
      have hD_future : MeasurableSet[processFuture X a] D := by
        refine s.measurableSet_biInter ?_
        intro u hu
        have hau : a ≤ u := le_of_lt (hlt u hu)
        have hle : MeasurableSpace.comap (X u) ‹MeasurableSpace E› ≤ processFuture X a :=
          le_iSup_of_le u <| le_iSup_of_le hau le_rfl
        exact hle _ <| hF u (by simp [hu])
      have hTailDesc :
          μ⟦D | generatedFiltrationSpace X a⟧ =ᵐ[μ]
            μ⟦D | MeasurableSpace.comap (X a) ‹MeasurableSpace E›⟧ := by
        exact
          ih a (fun u hu ↦ le_of_lt (hlt u hu)) F
            (fun u hu ↦ hF u (by simp [hu]))
      simpa [D, hA0eq, ha_not_mem, Set.inter_assoc] using
        condExp_headTailInter_eq_present
          (μ := μ) (X := X) hMarkov hta hA0 hD_future hTailDesc

/-- Helper for Exercise 17.1.1: the one-coordinate Markov identity must be extended from
coordinate future events to arbitrary events measurable for `processFuture X t`. -/
lemma pastFutureFactorization_of_condExp_eq_present
    (μ : Measure Ω) [IsProbabilityMeasure μ] (X : T → Ω → E)
    (hMarkov : HasNaturalMarkovProperty μ X) (t : T) {C B : Set Ω}
    (hC : MeasurableSet[generatedFiltrationSpace X t] C)
    (hB : MeasurableSet[processFuture X t] B)
    (hDesc :
      μ⟦B | generatedFiltrationSpace X t⟧ =ᵐ[μ]
        μ⟦B | MeasurableSpace.comap (X t) ‹MeasurableSpace E›⟧) :
    μ⟦C ∩ B | MeasurableSpace.comap (X t) ‹MeasurableSpace E›⟧ =ᵐ[μ]
      μ⟦C | MeasurableSpace.comap (X t) ‹MeasurableSpace E›⟧ *
        μ⟦B | MeasurableSpace.comap (X t) ‹MeasurableSpace E›⟧ := by
  let pastIndicator : Ω → ℝ := C.indicator (fun _ ↦ (1 : ℝ))
  let futureIndicator : Ω → ℝ := B.indicator (fun _ ↦ (1 : ℝ))
  have hmPresent : MeasurableSpace.comap (X t) ‹MeasurableSpace E› ≤ ‹MeasurableSpace Ω› := by
    exact (hMarkov.1 t).comap_le
  have hmPast : generatedFiltrationSpace X t ≤ ‹MeasurableSpace Ω› := by
    exact generatedFiltrationSpace_le_ambient (X := X) hMarkov.1 t
  have hmPresentPast :
      MeasurableSpace.comap (X t) ‹MeasurableSpace E› ≤ generatedFiltrationSpace X t := by
    exact present_le_generatedFiltrationSpace (X := X) t
  have hC_ambient : MeasurableSet C :=
    measurableSet_generatedFiltrationSpace_ambient (X := X) hMarkov.1 t hC
  have hB_ambient : MeasurableSet B :=
    measurableSet_processFuture_ambient (X := X) hMarkov.1 t hB
  have hPastIndicator_meas :
      Measurable[generatedFiltrationSpace X t] pastIndicator := by
    -- Proof comment: the past event indicator is measurable for the history sigma-algebra.
    exact Measurable.indicator measurable_const hC
  have hPastIndicator_int : Integrable pastIndicator μ :=
    (integrable_const (1 : ℝ)).indicator hC_ambient
  have hFutureIndicator_int : Integrable futureIndicator μ :=
    (integrable_const (1 : ℝ)).indicator hB_ambient
  have hInterIndicator :
      futureIndicator * pastIndicator = (C ∩ B).indicator (fun _ ↦ (1 : ℝ)) := by
    -- Proof comment: the product of the two event indicators is the indicator of the
    -- intersection event.
    ext ω
    by_cases hωC : ω ∈ C <;> by_cases hωB : ω ∈ B <;>
      simp [futureIndicator, pastIndicator, Set.indicator, hωC, hωB, Set.mem_inter_iff,
        mul_comm]
  have hInterIndicator' :
      pastIndicator * futureIndicator = (C ∩ B).indicator (fun _ ↦ (1 : ℝ)) := by
    -- Proof comment: the same indicator identity in the order needed for the pull-out theorem.
    simpa [mul_comm] using hInterIndicator
  have hInterIndicator_int : Integrable (pastIndicator * futureIndicator) μ := by
    rw [hInterIndicator']
    exact (integrable_const (1 : ℝ)).indicator (hC_ambient.inter hB_ambient)
  have hPastGenerated :
      μ[(C ∩ B).indicator (fun _ ↦ (1 : ℝ)) | generatedFiltrationSpace X t] =ᵐ[μ]
        pastIndicator * μ⟦B | generatedFiltrationSpace X t⟧ := by
    -- Proof comment: pull the history-measurable past indicator out of the conditional
    -- expectation over the whole history.
    calc
      μ[(C ∩ B).indicator (fun _ ↦ (1 : ℝ)) | generatedFiltrationSpace X t] =ᵐ[μ]
          μ[pastIndicator * futureIndicator | generatedFiltrationSpace X t] := by
            exact MeasureTheory.condExp_congr_ae (Filter.EventuallyEq.of_eq hInterIndicator'.symm)
      _ =ᵐ[μ] pastIndicator * μ[futureIndicator | generatedFiltrationSpace X t] := by
            exact
              MeasureTheory.condExp_mul_of_stronglyMeasurable_left
                hPastIndicator_meas.stronglyMeasurable hInterIndicator_int hFutureIndicator_int
      _ =ᵐ[μ] pastIndicator * μ⟦B | generatedFiltrationSpace X t⟧ := by
            rfl
  have hTower :
      μ⟦C ∩ B | MeasurableSpace.comap (X t) ‹MeasurableSpace E›⟧ =ᵐ[μ]
        μ[pastIndicator * μ⟦B | generatedFiltrationSpace X t⟧ |
          MeasurableSpace.comap (X t) ‹MeasurableSpace E›] := by
    -- Proof comment: first rewrite the history conditional expectation of the intersection, then
    -- collapse the tower from the history sigma-algebra down to the present one.
    calc
      μ⟦C ∩ B | MeasurableSpace.comap (X t) ‹MeasurableSpace E›⟧ =ᵐ[μ]
          μ[μ[(C ∩ B).indicator (fun _ ↦ (1 : ℝ)) | generatedFiltrationSpace X t] |
            MeasurableSpace.comap (X t) ‹MeasurableSpace E›] := by
            symm
            exact
              MeasureTheory.condExp_condExp_of_le
                (f := (C ∩ B).indicator (fun _ ↦ (1 : ℝ))) (μ := μ)
                (m₁ := MeasurableSpace.comap (X t) ‹MeasurableSpace E›)
                (m₂ := generatedFiltrationSpace X t) (m₀ := ‹MeasurableSpace Ω›)
                hmPresentPast hmPast
      _ =ᵐ[μ] μ[pastIndicator * μ⟦B | generatedFiltrationSpace X t⟧ |
            MeasurableSpace.comap (X t) ‹MeasurableSpace E›] := by
            exact MeasureTheory.condExp_congr_ae hPastGenerated
  have hPastFutureReplace :
      μ[pastIndicator * μ⟦B | generatedFiltrationSpace X t⟧ |
          MeasurableSpace.comap (X t) ‹MeasurableSpace E›] =ᵐ[μ]
        μ[pastIndicator * μ⟦B | MeasurableSpace.comap (X t) ‹MeasurableSpace E›⟧ |
          MeasurableSpace.comap (X t) ‹MeasurableSpace E›] := by
    -- Proof comment: replace the history-conditional future term by the present-conditional one
    -- using the assumed descent of the future event.
    refine MeasureTheory.condExp_congr_ae ?_
    filter_upwards [hDesc] with ω hω
    simp [hω]
  have hPresentProductEq :
      pastIndicator * μ⟦B | MeasurableSpace.comap (X t) ‹MeasurableSpace E›⟧ =
        C.indicator (μ⟦B | MeasurableSpace.comap (X t) ‹MeasurableSpace E›⟧) := by
    -- Proof comment: multiplying by the `{0,1}`-valued past indicator is the same as
    -- restricting the present conditional expectation to the past event.
    ext ω
    by_cases hω : ω ∈ C <;> simp [pastIndicator, Set.indicator, hω]
  have hPresentProduct_int :
      Integrable
        (pastIndicator * μ⟦B | MeasurableSpace.comap (X t) ‹MeasurableSpace E›⟧) μ := by
    rw [hPresentProductEq]
    exact
      (integrable_condExp :
        Integrable (μ⟦B | MeasurableSpace.comap (X t) ‹MeasurableSpace E›⟧) μ).indicator
        hC_ambient
  have hPresentPulled :
      μ[pastIndicator * μ⟦B | MeasurableSpace.comap (X t) ‹MeasurableSpace E›⟧ |
          MeasurableSpace.comap (X t) ‹MeasurableSpace E›] =ᵐ[μ]
        μ⟦C | MeasurableSpace.comap (X t) ‹MeasurableSpace E›⟧ *
          μ⟦B | MeasurableSpace.comap (X t) ‹MeasurableSpace E›⟧ := by
    -- Proof comment: now the future term is already present-measurable, so pull it out of the
    -- present-state conditional expectation.
    calc
      μ[pastIndicator * μ⟦B | MeasurableSpace.comap (X t) ‹MeasurableSpace E›⟧ |
          MeasurableSpace.comap (X t) ‹MeasurableSpace E›] =ᵐ[μ]
          μ[pastIndicator | MeasurableSpace.comap (X t) ‹MeasurableSpace E›] *
            μ⟦B | MeasurableSpace.comap (X t) ‹MeasurableSpace E›⟧ := by
            exact
              MeasureTheory.condExp_mul_of_aestronglyMeasurable_right
                stronglyMeasurable_condExp.aestronglyMeasurable
                hPresentProduct_int hPastIndicator_int
      _ =ᵐ[μ] μ⟦C | MeasurableSpace.comap (X t) ‹MeasurableSpace E›⟧ *
            μ⟦B | MeasurableSpace.comap (X t) ‹MeasurableSpace E›⟧ := by
            rfl
  -- Proof comment: chaining the tower step, the assumed future-event descent, and the pull-out
  -- identity yields the desired factorization over the present sigma-algebra.
  exact hTower.trans <| hPastFutureReplace.trans hPresentPulled

/-- Helper for Exercise 17.1.1: every future event measurable for `processFuture X t` has the
same past-set testing integrals against `σ(X t)` as against the full history once the future
`π`-system has been upgraded to owner-side conditional independence. -/
-- TODO: the next replan should derive this testing identity directly from the source-facing
-- future `π`-system closure, without importing owner-side `CondIndep` machinery that would force
-- a `StandardBorelSpace Ω` assumption not present in the target theorem.
lemma futureEvent_setIntegral_eq_present
    (μ : Measure Ω) [IsProbabilityMeasure μ] (X : T → Ω → E)
    (hMarkov : HasNaturalMarkovProperty μ X) (t : T) {C B : Set Ω}
    (hC : MeasurableSet[generatedFiltrationSpace X t] C)
    (hB : MeasurableSet[processFuture X t] B) :
    ∫ ω in C, (μ⟦B | MeasurableSpace.comap (X t) ‹MeasurableSpace E›⟧) ω ∂μ =
      ∫ ω in C, (B.indicator (fun _ ↦ (1 : ℝ))) ω ∂μ := by
  classical
  let futureGenerators : Set (Set Ω) :=
    ⋃ u : {u : T // t ≤ u},
      {s : Set Ω | MeasurableSet[MeasurableSpace.comap (X u.1) ‹MeasurableSpace E›] s}
  have hmPast : generatedFiltrationSpace X t ≤ ‹MeasurableSpace Ω› := by
    exact generatedFiltrationSpace_le_ambient (X := X) hMarkov.1 t
  have hmPresent : MeasurableSpace.comap (X t) ‹MeasurableSpace E› ≤ ‹MeasurableSpace Ω› := by
    exact (hMarkov.1 t).comap_le
  have hC_ambient : MeasurableSet C := hmPast C hC
  have hGenerated :
      processFuture X t = MeasurableSpace.generateFrom (generatePiSystem futureGenerators) := by
    simpa [futureGenerators] using
      processFuture_eq_generateFromFutureCoordinatePiSystem (X := X) (t := t)
  refine
    MeasurableSpace.induction_on_inter hGenerated
      (isPiSystem_generatePiSystem futureGenerators) ?_ ?_ ?_ ?_ B hB
  · have hZero :
        μ⟦(∅ : Set Ω) | MeasurableSpace.comap (X t) ‹MeasurableSpace E›⟧ =ᵐ[μ] (0 : Ω → ℝ) := by
      simpa using
        Filter.EventuallyEq.of_eq
          (MeasureTheory.condExp_const hmPresent (0 : ℝ))
    calc
      ∫ ω in C, (μ⟦(∅ : Set Ω) | MeasurableSpace.comap (X t) ‹MeasurableSpace E›⟧) ω ∂μ
          = ∫ ω in C, (0 : Ω → ℝ) ω ∂μ := by
              exact setIntegral_congr_ae hC_ambient <| by
                filter_upwards [hZero] with ω hω _
                exact hω
      _ = 0 := by simp
      _ = ∫ ω in C, ((∅ : Set Ω).indicator (fun _ ↦ (1 : ℝ))) ω ∂μ := by simp
  · intro D hD
    rcases futureCoordinatePiSystem_elim_times (X := X) (t := t) hD with
      ⟨S, F, rfl, hFutureTimes, hFutureMeas⟩
    have hFutureMeasSet :
        MeasurableSet[processFuture X t] (⋂ u ∈ S, F u) := by
      refine S.measurableSet_biInter ?_
      intro u hu
      have hle : MeasurableSpace.comap (X u) ‹MeasurableSpace E› ≤ processFuture X t := by
        exact le_iSup_of_le u <| le_iSup_of_le (hFutureTimes u hu) le_rfl
      exact hle _ (hFutureMeas u hu)
    have hFutureAmbient :
        MeasurableSet (⋂ u ∈ S, F u) :=
      measurableSet_processFuture_ambient (X := X) hMarkov.1 t hFutureMeasSet
    have hIndicatorInt :
        Integrable ((⋂ u ∈ S, F u).indicator (fun _ ↦ (1 : ℝ))) μ :=
      (integrable_const (1 : ℝ)).indicator hFutureAmbient
    have hDesc :
        μ⟦⋂ u ∈ S, F u | generatedFiltrationSpace X t⟧ =ᵐ[μ]
          μ⟦⋂ u ∈ S, F u | MeasurableSpace.comap (X t) ‹MeasurableSpace E›⟧ := by
      exact
        condExp_finiteFutureInter_eq_present
          (μ := μ) (X := X) hMarkov S t hFutureTimes F hFutureMeas
    have hDescOn :
        ∀ᵐ ω ∂μ,
          ω ∈ C →
            (μ⟦⋂ u ∈ S, F u | MeasurableSpace.comap (X t) ‹MeasurableSpace E›⟧) ω =
              (μ⟦⋂ u ∈ S, F u | generatedFiltrationSpace X t⟧) ω := by
      filter_upwards [hDesc.symm] with ω hω _
      exact hω
    calc
      ∫ ω in C, (μ⟦⋂ u ∈ S, F u | MeasurableSpace.comap (X t) ‹MeasurableSpace E›⟧) ω ∂μ
          = ∫ ω in C, (μ⟦⋂ u ∈ S, F u | generatedFiltrationSpace X t⟧) ω ∂μ := by
              exact setIntegral_congr_ae hC_ambient hDescOn
      _ = ∫ ω in C, ((⋂ u ∈ S, F u).indicator (fun _ ↦ (1 : ℝ))) ω ∂μ := by
            exact MeasureTheory.setIntegral_condExp hmPast hIndicatorInt hC
  · intro D hDm hInd
    have hDAmbient : MeasurableSet D :=
      measurableSet_processFuture_ambient (X := X) hMarkov.1 t hDm
    have hIndicatorInt : Integrable (D.indicator (fun _ ↦ (1 : ℝ))) μ :=
      (integrable_const (1 : ℝ)).indicator hDAmbient
    have hCompIndicator :
        (Dᶜ : Set Ω).indicator (fun _ ↦ (1 : ℝ)) =
          (fun _ : Ω ↦ (1 : ℝ)) - D.indicator (fun _ ↦ (1 : ℝ)) := by
      ext ω
      by_cases hω : ω ∈ D <;> simp [Set.indicator, hω]
    have hCompCond :
        μ⟦Dᶜ | MeasurableSpace.comap (X t) ‹MeasurableSpace E›⟧ =ᵐ[μ]
          fun ω ↦
            (1 : ℝ) - (μ⟦D | MeasurableSpace.comap (X t) ‹MeasurableSpace E›⟧) ω := by
      calc
        μ⟦Dᶜ | MeasurableSpace.comap (X t) ‹MeasurableSpace E›⟧ =ᵐ[μ]
            μ[(Dᶜ : Set Ω).indicator (fun _ ↦ (1 : ℝ)) |
              MeasurableSpace.comap (X t) ‹MeasurableSpace E›] := by
              rfl
        _ =ᵐ[μ] μ[(fun _ : Ω ↦ (1 : ℝ)) - D.indicator (fun _ ↦ (1 : ℝ)) |
              MeasurableSpace.comap (X t) ‹MeasurableSpace E›] := by
              exact MeasureTheory.condExp_congr_ae (Filter.EventuallyEq.of_eq hCompIndicator)
        _ =ᵐ[μ]
            μ[(fun _ : Ω ↦ (1 : ℝ)) | MeasurableSpace.comap (X t) ‹MeasurableSpace E›] -
              μ[D.indicator (fun _ ↦ (1 : ℝ)) |
                MeasurableSpace.comap (X t) ‹MeasurableSpace E›] := by
              exact
                MeasureTheory.condExp_sub (integrable_const (1 : ℝ)) hIndicatorInt
                  (MeasurableSpace.comap (X t) ‹MeasurableSpace E›)
        _ =ᵐ[μ] fun ω ↦
            (1 : ℝ) - (μ⟦D | MeasurableSpace.comap (X t) ‹MeasurableSpace E›⟧) ω := by
              have hConst :
                  μ[(fun _ : Ω ↦ (1 : ℝ)) | MeasurableSpace.comap (X t) ‹MeasurableSpace E›] =
                    fun _ : Ω ↦ (1 : ℝ) :=
                MeasureTheory.condExp_const hmPresent (1 : ℝ)
              filter_upwards
                [Filter.EventuallyEq.of_eq hConst] with ω hω
              simpa using hω
    calc
      ∫ ω in C, (μ⟦Dᶜ | MeasurableSpace.comap (X t) ‹MeasurableSpace E›⟧) ω ∂μ
          = ∫ ω in C,
              ((1 : ℝ) - (μ⟦D | MeasurableSpace.comap (X t) ‹MeasurableSpace E›⟧) ω) ∂μ := by
                exact setIntegral_congr_ae hC_ambient <| by
                  filter_upwards [hCompCond] with ω hω _
                  exact hω
      _ = ∫ ω in C, (1 : ℝ) ∂μ -
            ∫ ω in C, (μ⟦D | MeasurableSpace.comap (X t) ‹MeasurableSpace E›⟧) ω ∂μ := by
            simpa using
              (integral_sub
                ((integrable_const (1 : ℝ)).integrableOn)
                ((integrable_condExp : Integrable
                  (μ⟦D | MeasurableSpace.comap (X t) ‹MeasurableSpace E›⟧) μ).integrableOn))
      _ = ∫ ω in C, (1 : ℝ) ∂μ -
            ∫ ω in C, (D.indicator (fun _ ↦ (1 : ℝ))) ω ∂μ := by
            rw [hInd]
      _ = ∫ ω in C, ((Dᶜ : Set Ω).indicator (fun _ ↦ (1 : ℝ))) ω ∂μ := by
            symm
            simpa [hCompIndicator] using
              (integral_sub
                ((integrable_const (1 : ℝ)).integrableOn)
                hIndicatorInt.integrableOn)
  · intro f hfd hfm hf
    let U : ℕ → Set Ω := fun n ↦ ⋃ i ∈ Finset.range n, f i
    have hU_meas : ∀ n, MeasurableSet[processFuture X t] (U n) := by
      intro n
      refine (Finset.range n).measurableSet_biUnion ?_
      intro i hi
      exact hfm i
    have hUnionMeas : MeasurableSet[processFuture X t] (⋃ n, f n) := by
      exact MeasurableSet.iUnion hfm
    have hUnionAmbient : MeasurableSet (⋃ n, f n) :=
      measurableSet_processFuture_ambient (X := X) hMarkov.1 t hUnionMeas
    have hFinite : ∀ n,
        ∫ ω in C, (μ⟦U n | MeasurableSpace.comap (X t) ‹MeasurableSpace E›⟧) ω ∂μ =
          ∫ ω in C, (U n).indicator (fun _ ↦ (1 : ℝ)) ω ∂μ := by
      intro n
      induction n with
      | zero =>
          have hZero :
              μ⟦U 0 | MeasurableSpace.comap (X t) ‹MeasurableSpace E›⟧ =ᵐ[μ] (0 : Ω → ℝ) := by
            simpa [U] using
              Filter.EventuallyEq.of_eq
                (MeasureTheory.condExp_const hmPresent (0 : ℝ))
          calc
            ∫ ω in C, (μ⟦U 0 | MeasurableSpace.comap (X t) ‹MeasurableSpace E›⟧) ω ∂μ
                = ∫ ω in C, (0 : Ω → ℝ) ω ∂μ := by
                    exact setIntegral_congr_ae hC_ambient <| by
                      filter_upwards [hZero] with ω hω _
                      exact hω
            _ = 0 := by simp
            _ = ∫ ω in C, (U 0).indicator (fun _ ↦ (1 : ℝ)) ω ∂μ := by
                  simp [U]
      | succ n ihn =>
          have hDisj : Disjoint (U n) (f n) := by
            refine Set.disjoint_left.2 ?_
            intro ω hωU hωn
            rcases Set.mem_iUnion.1 hωU with ⟨i, hi⟩
            rcases Set.mem_iUnion.1 hi with ⟨hiRange, hωi⟩
            exact
              (Set.disjoint_left.1 <| hfd (ne_of_lt <| Finset.mem_range.1 hiRange)) hωi hωn
          have hUnionEq : U (n + 1) = U n ∪ f n := by
            ext ω
            constructor
            · intro hω
              rcases Set.mem_iUnion.1 hω with ⟨i, hi⟩
              rcases Set.mem_iUnion.1 hi with ⟨hiRange, hfi⟩
              rcases Nat.lt_succ_iff_lt_or_eq.mp (Finset.mem_range.1 hiRange) with hi | rfl
              · left
                exact Set.mem_iUnion.2 ⟨i, Set.mem_iUnion.2 ⟨Finset.mem_range.2 hi, hfi⟩⟩
              · right
                exact hfi
            · intro hω
              rcases hω with hω | hω
              · rcases Set.mem_iUnion.1 hω with ⟨i, hi⟩
                rcases Set.mem_iUnion.1 hi with ⟨hiRange, hfi⟩
                exact Set.mem_iUnion.2 ⟨i, Set.mem_iUnion.2 ⟨Finset.mem_range.2 (Nat.lt_succ_of_lt (Finset.mem_range.1 hiRange)), hfi⟩⟩
              · exact Set.mem_iUnion.2 ⟨n, Set.mem_iUnion.2 ⟨Finset.mem_range.2 (Nat.lt_succ_self n), hω⟩⟩
          have hUambient : MeasurableSet (U n) :=
            measurableSet_processFuture_ambient (X := X) hMarkov.1 t (hU_meas n)
          have hFnAmbient : MeasurableSet (f n) :=
            measurableSet_processFuture_ambient (X := X) hMarkov.1 t (hfm n)
          have hUInt :
              Integrable ((U n).indicator (fun _ ↦ (1 : ℝ))) μ :=
            (integrable_const (1 : ℝ)).indicator hUambient
          have hFnInt :
              Integrable ((f n).indicator (fun _ ↦ (1 : ℝ))) μ :=
            (integrable_const (1 : ℝ)).indicator hFnAmbient
          have hUnionIndicator :
              (U (n + 1)).indicator (fun _ ↦ (1 : ℝ)) =
                (U n).indicator (fun _ ↦ (1 : ℝ)) +
                  (f n).indicator (fun _ ↦ (1 : ℝ)) := by
            ext ω
            rw [hUnionEq, Set.indicator_union_of_disjoint hDisj]
            rfl
          have hCondAdd :
              μ⟦U (n + 1) | MeasurableSpace.comap (X t) ‹MeasurableSpace E›⟧ =ᵐ[μ]
                fun ω ↦
                  (μ⟦U n | MeasurableSpace.comap (X t) ‹MeasurableSpace E›⟧) ω +
                    (μ⟦f n | MeasurableSpace.comap (X t) ‹MeasurableSpace E›⟧) ω := by
            calc
              μ⟦U (n + 1) | MeasurableSpace.comap (X t) ‹MeasurableSpace E›⟧ =ᵐ[μ]
                  μ[(U (n + 1)).indicator (fun _ ↦ (1 : ℝ)) |
                    MeasurableSpace.comap (X t) ‹MeasurableSpace E›] := by
                    rfl
              _ =ᵐ[μ]
                  μ[(U n).indicator (fun _ ↦ (1 : ℝ)) + (f n).indicator (fun _ ↦ (1 : ℝ)) |
                    MeasurableSpace.comap (X t) ‹MeasurableSpace E›] := by
                    exact
                      MeasureTheory.condExp_congr_ae
                        (Filter.EventuallyEq.of_eq hUnionIndicator)
              _ =ᵐ[μ]
                  μ[(U n).indicator (fun _ ↦ (1 : ℝ)) |
                      MeasurableSpace.comap (X t) ‹MeasurableSpace E›] +
                    μ[(f n).indicator (fun _ ↦ (1 : ℝ)) |
                      MeasurableSpace.comap (X t) ‹MeasurableSpace E›] := by
                    exact
                      MeasureTheory.condExp_add hUInt hFnInt
                        (MeasurableSpace.comap (X t) ‹MeasurableSpace E›)
              _ =ᵐ[μ] fun ω ↦
                  (μ⟦U n | MeasurableSpace.comap (X t) ‹MeasurableSpace E›⟧) ω +
                    (μ⟦f n | MeasurableSpace.comap (X t) ‹MeasurableSpace E›⟧) ω := by
                    rfl
          calc
            ∫ ω in C, (μ⟦U (n + 1) | MeasurableSpace.comap (X t) ‹MeasurableSpace E›⟧) ω ∂μ
                = ∫ ω in C,
                    ((μ⟦U n | MeasurableSpace.comap (X t) ‹MeasurableSpace E›⟧) ω +
                      (μ⟦f n | MeasurableSpace.comap (X t) ‹MeasurableSpace E›⟧) ω) ∂μ := by
                        exact setIntegral_congr_ae hC_ambient <| by
                          filter_upwards [hCondAdd] with ω hω _
                          exact hω
            _ = ∫ ω in C, (μ⟦U n | MeasurableSpace.comap (X t) ‹MeasurableSpace E›⟧) ω ∂μ +
                  ∫ ω in C, (μ⟦f n | MeasurableSpace.comap (X t) ‹MeasurableSpace E›⟧) ω ∂μ := by
                    simpa using
                      (integral_add
                        ((integrable_condExp : Integrable
                          (μ⟦U n | MeasurableSpace.comap (X t) ‹MeasurableSpace E›⟧) μ).integrableOn)
                        ((integrable_condExp : Integrable
                          (μ⟦f n | MeasurableSpace.comap (X t) ‹MeasurableSpace E›⟧) μ).integrableOn))
            _ = ∫ ω in C, (U n).indicator (fun _ ↦ (1 : ℝ)) ω ∂μ +
                  ∫ ω in C, (f n).indicator (fun _ ↦ (1 : ℝ)) ω ∂μ := by
                    rw [ihn, hf n]
            _ = ∫ ω in C,
                  ((U n).indicator (fun _ ↦ (1 : ℝ)) ω +
                    (f n).indicator (fun _ ↦ (1 : ℝ)) ω) ∂μ := by
                    rw [← integral_add hUInt.integrableOn hFnInt.integrableOn]
            _ = ∫ ω in C, (U (n + 1)).indicator (fun _ ↦ (1 : ℝ)) ω ∂μ := by
                    simp [hUnionIndicator]
    let g : Ω → ℝ := (⋃ n, f n).indicator (fun _ ↦ (1 : ℝ))
    let gₙ : ℕ → Ω → ℝ := fun n ω ↦ (U n).indicator (fun _ ↦ (1 : ℝ)) ω
    have hgMeas : Measurable g := by
      exact measurable_const.indicator hUnionAmbient
    have hgInt : Integrable g μ :=
      (integrable_const (1 : ℝ)).indicator hUnionAmbient
    have hgₙMeas : ∀ n, Measurable (gₙ n) := by
      intro n
      exact measurable_const.indicator <|
        measurableSet_processFuture_ambient (X := X) hMarkov.1 t (hU_meas n)
    have hgₙBound : ∀ n ω, ‖gₙ n ω‖ ≤ (1 : ℝ) := by
      intro n ω
      by_cases hω : ω ∈ U n <;> simp [gₙ, Set.indicator, hω]
    have hgₙTendsto : ∀ ω, Filter.Tendsto (fun n ↦ gₙ n ω) Filter.atTop (nhds (g ω)) := by
      intro ω
      by_cases hω : ω ∈ ⋃ n, f n
      · rcases Set.mem_iUnion.1 hω with ⟨N, hN⟩
        have hEventually :
            (fun n ↦ gₙ n ω) =ᶠ[Filter.atTop] fun _ ↦ g ω := by
          refine Filter.eventually_atTop.2 ⟨N + 1, ?_⟩
          intro n hn
          have hRange : N ∈ Finset.range n := by
            exact Finset.mem_range.2 (lt_of_lt_of_le (Nat.lt_succ_self N) hn)
          have hUn : ω ∈ U n := by
            exact Set.mem_iUnion.2 ⟨N, Set.mem_iUnion.2 ⟨hRange, hN⟩⟩
          have hgₙOne : gₙ n ω = 1 := by simp [gₙ, hUn]
          have hgOne : g ω = 1 := by simp [g, hω]
          simpa [hgOne] using hgₙOne
        exact Filter.Tendsto.congr' hEventually.symm tendsto_const_nhds
      · have hNotMemU : ∀ n, ω ∉ U n := by
          intro n hUn
          apply hω
          rcases Set.mem_iUnion.1 hUn with ⟨i, hi⟩
          rcases Set.mem_iUnion.1 hi with ⟨_, hfi⟩
          exact Set.mem_iUnion.2 ⟨i, hfi⟩
        have hEventually :
            (fun n ↦ gₙ n ω) =ᶠ[Filter.atTop] fun _ ↦ g ω :=
          Filter.Eventually.of_forall fun n ↦ by
            have hgₙZero : gₙ n ω = 0 := by simp [gₙ, hNotMemU n]
            have hgZero : g ω = 0 := by simp [g, hω]
            simpa [hgZero] using hgₙZero
        exact Filter.Tendsto.congr' hEventually.symm tendsto_const_nhds
    have hCondTendsto :
        Filter.Tendsto (fun n ↦ MeasureTheory.condExpL1 hmPresent μ (gₙ n)) Filter.atTop
          (nhds (MeasureTheory.condExpL1 hmPresent μ g)) := by
      exact
        MeasureTheory.tendsto_condExpL1_of_dominated_convergence
          hmPresent (bound_fs := fun _ : Ω ↦ (1 : ℝ))
          (hfs_meas := fun n ↦ (hgₙMeas n).aestronglyMeasurable)
          (integrable_const 1)
          (fun n ↦ Filter.Eventually.of_forall fun ω ↦ hgₙBound n ω)
          (Filter.Eventually.of_forall hgₙTendsto)
    have hLeftTendstoL1 :
        Filter.Tendsto
          (fun n ↦ ∫ ω in C, MeasureTheory.condExpL1 hmPresent μ (gₙ n) ω ∂μ)
          Filter.atTop
          (nhds (∫ ω in C, MeasureTheory.condExpL1 hmPresent μ g ω ∂μ)) := by
      simpa using
        ((MeasureTheory.continuous_setIntegral (μ := μ) C).tendsto
          (MeasureTheory.condExpL1 hmPresent μ g)).comp hCondTendsto
    have hLeftEq : ∀ n,
        ∫ ω in C, (μ[gₙ n | MeasurableSpace.comap (X t) ‹MeasurableSpace E›]) ω ∂μ =
          ∫ ω in C, MeasureTheory.condExpL1 hmPresent μ (gₙ n) ω ∂μ := by
      intro n
      have hAe :
          ∀ᵐ ω ∂μ,
            ω ∈ C →
              (μ[gₙ n | MeasurableSpace.comap (X t) ‹MeasurableSpace E›]) ω =
                MeasureTheory.condExpL1 hmPresent μ (gₙ n) ω := by
        filter_upwards [MeasureTheory.condExp_ae_eq_condExpL1 hmPresent (gₙ n)] with ω hω _
        exact hω
      exact setIntegral_congr_ae hC_ambient hAe
    have hLeftLimitEq :
        ∫ ω in C, (μ[g | MeasurableSpace.comap (X t) ‹MeasurableSpace E›]) ω ∂μ =
          ∫ ω in C, MeasureTheory.condExpL1 hmPresent μ g ω ∂μ := by
      have hAe :
          ∀ᵐ ω ∂μ,
            ω ∈ C →
              (μ[g | MeasurableSpace.comap (X t) ‹MeasurableSpace E›]) ω =
                MeasureTheory.condExpL1 hmPresent μ g ω := by
        filter_upwards [MeasureTheory.condExp_ae_eq_condExpL1 hmPresent g] with ω hω _
        exact hω
      exact setIntegral_congr_ae hC_ambient hAe
    have hLeftTendsto :
        Filter.Tendsto
          (fun n ↦ ∫ ω in C,
            (μ[gₙ n | MeasurableSpace.comap (X t) ‹MeasurableSpace E›]) ω ∂μ)
          Filter.atTop
          (nhds (∫ ω in C, (μ[g | MeasurableSpace.comap (X t) ‹MeasurableSpace E›]) ω ∂μ)) := by
      have hSeqEq :
          (fun n ↦ ∫ ω in C,
            (μ[gₙ n | MeasurableSpace.comap (X t) ‹MeasurableSpace E›]) ω ∂μ) =
            fun n ↦ ∫ ω in C, MeasureTheory.condExpL1 hmPresent μ (gₙ n) ω ∂μ := by
        funext n
        exact hLeftEq n
      rw [hSeqEq, hLeftLimitEq]
      exact hLeftTendstoL1
    have hRightTendsto :
        Filter.Tendsto (fun n ↦ ∫ ω in C, gₙ n ω ∂μ) Filter.atTop (nhds (∫ ω in C, g ω ∂μ)) := by
      simpa [Measure.restrict_apply, hC_ambient, g, gₙ] using
        (MeasureTheory.tendsto_integral_filter_of_dominated_convergence
          (μ := μ.restrict C) (bound := fun _ : Ω ↦ (1 : ℝ))
          (hF_meas := Filter.Eventually.of_forall fun n ↦ (hgₙMeas n).aestronglyMeasurable)
          (h_bound := Filter.Eventually.of_forall fun n ↦
            Filter.Eventually.of_forall fun ω ↦ hgₙBound n ω)
          (bound_integrable := integrable_const 1)
          (h_lim := Filter.Eventually.of_forall hgₙTendsto))
    have hRightFromLeft :
        Filter.Tendsto
          (fun n ↦ ∫ ω in C,
            (μ[gₙ n | MeasurableSpace.comap (X t) ‹MeasurableSpace E›]) ω ∂μ)
          Filter.atTop
          (nhds (∫ ω in C, g ω ∂μ)) := by
      have hSeqEq :
          (fun n ↦ ∫ ω in C,
            (μ[gₙ n | MeasurableSpace.comap (X t) ‹MeasurableSpace E›]) ω ∂μ) =
            fun n ↦ ∫ ω in C, gₙ n ω ∂μ := by
        funext n
        simpa [gₙ, U] using hFinite n
      rw [hSeqEq]
      exact hRightTendsto
    exact tendsto_nhds_unique hLeftTendsto hRightFromLeft

/-- Helper for Exercise 17.1.1: the one-coordinate Markov identity must be extended from
coordinate future events to arbitrary events measurable for `processFuture X t`. -/
lemma condExp_processFutureEvent_eq_present
    (μ : Measure Ω) [IsProbabilityMeasure μ] (X : T → Ω → E)
    (hMarkov : HasNaturalMarkovProperty μ X) (t : T) {B : Set Ω}
    (hB : MeasurableSet[processFuture X t] B) :
    μ⟦B | generatedFiltrationSpace X t⟧ =ᵐ[μ]
      μ⟦B | MeasurableSpace.comap (X t) ‹MeasurableSpace E›⟧ := by
  have hmPast : generatedFiltrationSpace X t ≤ ‹MeasurableSpace Ω› := by
    exact generatedFiltrationSpace_le_ambient (X := X) hMarkov.1 t
  have hmPresentPast :
      MeasurableSpace.comap (X t) ‹MeasurableSpace E› ≤ generatedFiltrationSpace X t := by
    exact present_le_generatedFiltrationSpace (X := X) t
  have hB_ambient : MeasurableSet B :=
    measurableSet_processFuture_ambient (X := X) hMarkov.1 t hB
  have hIndicatorInt : Integrable (B.indicator (fun _ ↦ (1 : ℝ))) μ :=
    (integrable_const (1 : ℝ)).indicator hB_ambient
  -- Proof comment: once the future-vs-present testing identity is available for every past set,
  -- the standard uniqueness theorem identifies the history conditional expectation with the
  -- present conditional expectation.
  exact
    (MeasureTheory.ae_eq_condExp_of_forall_setIntegral_eq hmPast hIndicatorInt
      (fun C _ _ ↦ by
        simpa using
          (integrable_condExp :
            Integrable (μ⟦B | MeasurableSpace.comap (X t) ‹MeasurableSpace E›⟧) μ).integrableOn)
      (fun C hC _ ↦ by
        simpa using
          futureEvent_setIntegral_eq_present
            (μ := μ) (X := X) hMarkov t (C := C) hC hB)
      ((MeasureTheory.stronglyMeasurable_condExp.mono hmPresentPast).aestronglyMeasurable)).symm

/-- Helper for Exercise 17.1.1: once the future conditional expectation descends from the history
to the present, any past event and any future event factor over `σ(X t)`. -/
lemma pastFutureFactorizationAtTime
    (μ : Measure Ω) [IsProbabilityMeasure μ] (X : T → Ω → E)
    (hMarkov : HasNaturalMarkovProperty μ X) (t : T) {C B : Set Ω}
    (hC : MeasurableSet[generatedFiltrationSpace X t] C)
    (hB : MeasurableSet[processFuture X t] B) :
    μ⟦C ∩ B | MeasurableSpace.comap (X t) ‹MeasurableSpace E›⟧ =ᵐ[μ]
      μ⟦C | MeasurableSpace.comap (X t) ‹MeasurableSpace E›⟧ *
        μ⟦B | MeasurableSpace.comap (X t) ‹MeasurableSpace E›⟧ := by
  have hFutureDesc :
      μ⟦B | generatedFiltrationSpace X t⟧ =ᵐ[μ]
        μ⟦B | MeasurableSpace.comap (X t) ‹MeasurableSpace E›⟧ :=
    condExp_processFutureEvent_eq_present (μ := μ) (X := X) hMarkov t hB
  -- Proof comment: once the future event has been shown to descend from the full history to the
  -- present, the general factorization helper applies verbatim.
  exact
    pastFutureFactorization_of_condExp_eq_present
      (μ := μ) (X := X) hMarkov t hC hB hFutureDesc

-- Proof sketch: for the forward implication, use the natural-history Markov property on future
-- cylinder events and extend from the generating future coordinates to the full future
-- `σ`-algebra. For the reverse implication, test the conditional-independence statement on the
-- future events `{ω | X u ω ∈ A}` with `t ≤ u`.
/-- Exercise 17.1.1: on a linearly ordered time set, a process has the natural Markov property
exactly when, for every time `t`, the history `σ`-algebra up to `t` and the future `σ`-algebra
from `t` onward are conditionally independent given the present state `X t`. This is stated in
the chapter's source-facing conditional-independence API. -/
theorem hasNaturalMarkovProperty_iff_pastFutureConditionallyIndependentGivenPresent
    (μ : Measure Ω) [IsProbabilityMeasure μ] (X : T → Ω → E) :
    HasNaturalMarkovProperty μ X ↔
      ∀ t : T,
        IsConditionallyIndependent
          (MeasurableSpace.comap (X t) ‹MeasurableSpace E›)
          (fun b : Bool ↦ if b then processFuture X t else generatedFiltrationSpace X t) μ := by
  constructor
  · intro hMarkov
    intro t
    have hX := hMarkov.1
    have hmPast : generatedFiltrationSpace X t ≤ ‹MeasurableSpace Ω› :=
      generatedFiltrationSpace_le_ambient (X := X) hX t
    have hmFuture : processFuture X t ≤ ‹MeasurableSpace Ω› :=
      processFuture_le_ambient (X := X) hX t
    refine ⟨(hX t).comap_le, ?_, ?_⟩
    · -- Proof comment: both the past and future `σ`-algebras sit inside the ambient one because
      -- all coordinates of the Markov process are measurable.
      intro b
      cases b with
      | false =>
          simpa using hmPast
      | true =>
          simpa using hmFuture
    · intro s A hA
      have hs_cases := finset_bool_cases s
      rcases hs_cases with rfl | rfl | rfl | rfl
      · -- Proof comment: the empty family contributes the constant-one identity.
        simpa using Filter.EventuallyEq.of_eq (MeasureTheory.condExp_const ((hX t).comap_le) (1 : ℝ))
      · -- Proof comment: a singleton past family factors trivially.
        simp
      · -- Proof comment: a singleton future family factors trivially.
        simp
      · have hFalse : MeasurableSet[generatedFiltrationSpace X t] (A false) := by
          simpa using hA false (by simp)
        have hTrue : MeasurableSet[processFuture X t] (A true) := by
          simpa using hA true (by simp)
        -- Route correction: the Bool packaging and measurability prefix are now settled. The
        -- remaining forward blocker is exactly the event-level future step extending the one-time
        -- Markov identity to arbitrary `processFuture X t`-measurable events.
        -- TODO: prove
        -- `μ⟦A true | generatedFiltrationSpace X t⟧ =ᵐ[μ]
        --    μ⟦A true | MeasurableSpace.comap (X t) ‹MeasurableSpace E›⟧`
        -- for all `MeasurableSet[processFuture X t] (A true)`, then combine it with the
        -- pull-out/tower-property argument already used in the reverse implication.
        have hPair :
            μ⟦A false ∩ A true | MeasurableSpace.comap (X t) ‹MeasurableSpace E›⟧ =ᵐ[μ]
              μ⟦A false | MeasurableSpace.comap (X t) ‹MeasurableSpace E›⟧ *
                μ⟦A true | MeasurableSpace.comap (X t) ‹MeasurableSpace E›⟧ := by
          simpa using
            pastFutureFactorizationAtTime
              (μ := μ) (X := X) hMarkov t hFalse hTrue
        have hInter :
            (⋂ i ∈ ({false, true} : Finset Bool), A i) = A false ∩ A true := by
          simpa using biInter_bool_pair A
        have hProd :
            (∏ i ∈ ({false, true} : Finset Bool),
                μ⟦A i | MeasurableSpace.comap (X t) ‹MeasurableSpace E›⟧) =
              μ⟦A false | MeasurableSpace.comap (X t) ‹MeasurableSpace E›⟧ *
                μ⟦A true | MeasurableSpace.comap (X t) ‹MeasurableSpace E›⟧ := by
          simp
        rw [hInter, hProd]
        exact hPair
  · intro hPastFuture
    refine ⟨?_, ?_⟩
    · -- Each fixed-time source-facing conditional independence hypothesis includes measurability
      -- of the present coordinate.
      intro t
      exact Measurable.of_comap_le (hPastFuture t).1
    · -- The fixed-time past/future conditional independence recovers the defining Markov identity.
      intro s u hsu A hA
      simpa using
        markovIdentity_of_pastFutureConditionallyIndependentAtTime
          (μ := μ) (X := X) (h := hPastFuture s) hsu hA

end ProbabilityTheory
