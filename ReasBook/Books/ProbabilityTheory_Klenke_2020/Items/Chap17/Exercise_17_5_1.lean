noncomputable section

namespace ProbabilityTheory

/-- Helper for Exercise 17.5.1: the coordinatewise lattice embedding sends the additive origin to
the Euclidean origin. -/
private lemma latticeEmbedding_zero (d : ℕ) :
    latticeEmbedding (0 : LatticePoint d) = (0 : EuclideanSpace ℝ (Fin d)) := by
  -- Proof comment: every coordinate of the embedded origin is zero.
  ext i
  simp

/-- Helper for Exercise 17.5.1: the coordinatewise lattice embedding preserves addition. -/
private lemma latticeEmbedding_add {d : ℕ} (x y : LatticePoint d) :
    latticeEmbedding (x + y) = latticeEmbedding x + latticeEmbedding y := by
  -- Proof comment: the embedding acts coordinatewise, so addition is checked coordinatewise.
  ext i
  simp

/-- Helper for Exercise 17.5.1: the lattice embedding is available as an additive homomorphism for
convolution-to-characteristic-function rewrites. -/
private def latticeEmbeddingAddMonoidHom (d : ℕ) :
    LatticePoint d →+ EuclideanSpace ℝ (Fin d) :=
  { toFun := latticeEmbedding
    map_zero' := latticeEmbedding_zero d
    map_add' := latticeEmbedding_add }

/-- Helper for Exercise 17.5.1: composing the translation convolution kernel generated by `ν`
with a measure `μ` is exactly convolution by `ν`. -/
private lemma diracConvolutionKernel_comp_measure_eq_conv
    {d : ℕ} (μ ν : Measure (LatticePoint d)) [SFinite μ] [SFinite ν] :
    dirac_convolution_kernel ν ∘ₘ μ = μ ∗ ν := by
  have hconst :=
    congrArg
      (fun κ : Kernel (LatticePoint d) (LatticePoint d) ↦ κ (0 : LatticePoint d))
      (dirac_convolution_kernel_comp_const_eq_const_conv (μ := μ) (ν := ν))
  -- Proof comment: evaluate the kernel identity at the origin to recover the corresponding
  -- measure-level convolution formula.
  simpa [Kernel.comp_apply] using hconst

/-- Helper for Exercise 17.5.1: the translation kernel generated by a lattice PMF is Markov. -/
private lemma diracConvolutionKernel_isMarkov
    {d : ℕ} (ν : PMF (LatticePoint d)) :
    IsMarkovKernel (dirac_convolution_kernel ν.toMeasure) := by
  -- Proof comment: each kernel row is `δ_x ∗ ν`, hence a probability measure because `ν` is.
  refine ⟨?_⟩
  intro x
  rw [dirac_convolution_kernel_apply]
  infer_instance

/-- Helper for Exercise 17.5.1: every power of the translation kernel generated by a lattice PMF
is again Markov. -/
private lemma diracConvolutionKernel_pow_isMarkov
    {d n : ℕ} (ν : PMF (LatticePoint d)) :
    IsMarkovKernel (dirac_convolution_kernel ν.toMeasure ^ n) := by
  -- Proof comment: the zero power is the identity kernel, and the successor power is a kernel
  -- composition of two Markov kernels.
  induction n with
  | zero =>
      simpa using
        (inferInstance :
          IsMarkovKernel (Kernel.id : Kernel (LatticePoint d) (LatticePoint d)))
  | succ n hn =>
      letI : IsMarkovKernel (dirac_convolution_kernel ν.toMeasure ^ n) := hn
      letI : IsMarkovKernel (dirac_convolution_kernel ν.toMeasure) :=
        diracConvolutionKernel_isMarkov ν
      simpa [pow_succ] using
        (inferInstance :
          IsMarkovKernel ((dirac_convolution_kernel ν.toMeasure ^ n) ∘ₖ
            dirac_convolution_kernel ν.toMeasure))

/-- Helper for Exercise 17.5.1: the characteristic function of the `n`-step origin law is the
`n`th power of the one-step characteristic function. -/
private lemma latticeOriginLaw_charFunPow
    {d n : ℕ} (ν : PMF (LatticePoint d)) (t : EuclideanSpace ℝ (Fin d)) :
    charFun ((((dirac_convolution_kernel ν.toMeasure ^ n) (0 : LatticePoint d)).map
      latticeEmbedding)) t =
      charFun (ν.toMeasure.map latticeEmbedding) t ^ n := by
  letI : IsMarkovKernel (dirac_convolution_kernel ν.toMeasure) := diracConvolutionKernel_isMarkov ν
  induction n with
  | zero =>
      -- Proof comment: the zero-step origin law is the Dirac mass at `0`, so its characteristic
      -- function is constantly `1`.
      change charFun (Measure.map latticeEmbedding
        (((Kernel.id : Kernel (LatticePoint d) (LatticePoint d))) (0 : LatticePoint d))) t = 1
      rw [Kernel.id_apply, Measure.map_dirac]
      simp [MeasureTheory.charFun_dirac, latticeEmbedding_zero]
  | succ n hn =>
      let κ : Kernel (LatticePoint d) (LatticePoint d) := dirac_convolution_kernel ν.toMeasure
      have hpow : κ ^ (n + 1) = κ ∘ₖ (κ ^ n) := by
        simpa [pow_one, Nat.one_add] using (ProbabilityTheory.Kernel.pow_add κ 1 n)
      -- Proof comment: rewrite the successor row as one more convolution by `ν`, map that
      -- convolution through the additive embedding, and then use multiplicativity of `charFun`.
      calc
        charFun ((((κ ^ (n + 1)) (0 : LatticePoint d)).map latticeEmbedding)) t
            = charFun (((κ ∘ₘ ((κ ^ n) (0 : LatticePoint d))).map latticeEmbedding)) t := by
                rw [hpow, Kernel.comp_apply]
        _ = charFun (((((κ ^ n) (0 : LatticePoint d)) ∗ ν.toMeasure).map latticeEmbedding)) t := by
              rw [show κ ∘ₘ ((κ ^ n) (0 : LatticePoint d)) =
                (((κ ^ n) (0 : LatticePoint d)) ∗ ν.toMeasure) by
                  simpa [κ] using
                    (diracConvolutionKernel_comp_measure_eq_conv
                      (μ := ((κ ^ n) (0 : LatticePoint d))) (ν := ν.toMeasure))]
        _ = charFun ((((κ ^ n) (0 : LatticePoint d)).map latticeEmbedding)) t *
              charFun (ν.toMeasure.map latticeEmbedding) t := by
                letI : IsMarkovKernel (κ ^ n) := by
                  simpa [κ] using diracConvolutionKernel_pow_isMarkov (ν := ν) (n := n)
                letI : IsFiniteMeasure (((κ ^ n) (0 : LatticePoint d))) := by infer_instance
                letI :
                    IsFiniteMeasure
                      (Measure.map latticeEmbedding (((κ ^ n) (0 : LatticePoint d)))) :=
                  by infer_instance
                rw [show
                    Measure.map latticeEmbedding ((((κ ^ n) (0 : LatticePoint d)) ∗ ν.toMeasure)) =
                      (Measure.map latticeEmbedding (((κ ^ n) (0 : LatticePoint d)))) ∗
                        Measure.map latticeEmbedding ν.toMeasure by
                      simpa using
                        (Measure.map_conv_addMonoidHom
                          (μ := ((κ ^ n) (0 : LatticePoint d)))
                          (ν := ν.toMeasure)
                          (latticeEmbeddingAddMonoidHom d) (by fun_prop))]
                rw [MeasureTheory.charFun_conv]
        _ = charFun (ν.toMeasure.map latticeEmbedding) t ^ n *
              charFun (ν.toMeasure.map latticeEmbedding) t := by
                rw [hn]
        _ = charFun (ν.toMeasure.map latticeEmbedding) t ^ (n + 1) := by
              simp [pow_succ]

/-- Helper for Exercise 17.5.1: the even return probability at the origin is the normalized
Fourier-cube integral of the `2n`th power of the one-step characteristic function. -/
lemma symmetricSimpleRandomWalkOriginMass_eq_fourierIntegral
    {D n : ℕ} [NeZero D] :
    ((((dirac_convolution_kernel ((symmetricSimpleRandomWalkStepPMF D).toMeasure) ^ (2 * n))
        (0 : LatticePoint D)).real ({0} : Set (LatticePoint D)) : ℂ)) =
      (((2 * Real.pi : ℝ) ^ D)⁻¹ : ℂ) *
        ∫ t in latticeFrequencyCube D,
          charFun (((symmetricSimpleRandomWalkStepPMF D).toMeasure).map latticeEmbedding) t ^
            (2 * n) ∂volume := by
  let κ : Kernel (LatticePoint D) (LatticePoint D) :=
    dirac_convolution_kernel ((symmetricSimpleRandomWalkStepPMF D).toMeasure)
  letI : IsMarkovKernel κ := by
    simpa [κ] using diracConvolutionKernel_isMarkov (ν := symmetricSimpleRandomWalkStepPMF D)
  letI : IsMarkovKernel (κ ^ (2 * n)) := by
    simpa [κ] using diracConvolutionKernel_pow_isMarkov (ν := symmetricSimpleRandomWalkStepPMF D)
      (n := 2 * n)
  letI : IsFiniteMeasure ((κ ^ (2 * n)) (0 : LatticePoint D)) := by infer_instance
  have hFourier :=
    _root_.discreteFourierInversionFormula
      (d := D)
      (μ := ((κ ^ (2 * n)) (0 : LatticePoint D)))
      (x := (0 : LatticePoint D))
  -- Proof comment: at the origin the oscillatory Fourier phase is trivial, so the inversion
  -- formula collapses directly to the integral of the `2n`-step symbol.
  simpa
    [κ, latticeEmbedding_zero,
      latticeOriginLaw_charFunPow (ν := symmetricSimpleRandomWalkStepPMF D) (n := 2 * n)]
    using hFourier

/-- Helper for Exercise 17.5.1: the Fourier phase of a signed coordinate step is the
corresponding signed coordinate of `t`. -/
private lemma inner_latticeEmbedding_signedUnitStep
    {D : ℕ} (t : EuclideanSpace ℝ (Fin D)) (b : Bool) (i : Fin D) :
    (inner ℝ (latticeEmbedding ((if b then Pi.single i (1 : ℤ) else Pi.single i (-1)) :
      LatticePoint D)) t : ℝ) =
      if b then t i else -t i := by
  -- Proof comment: expand the Euclidean inner product coordinatewise; only the chosen coordinate
  -- contributes, with sign determined by `b`.
  cases b
  · have hsingle :
        (WithLp.toLp 2 fun j : Fin D ↦ if j = i then (-1 : ℝ) else 0) =
          EuclideanSpace.single i (-1 : ℝ) := by
      ext j
      simp [PiLp.single_apply]
    simp only [Bool.false_eq_true, ↓reduceIte]
    rw [show latticeEmbedding ((Pi.single i (-1 : ℤ) : LatticePoint D)) =
        WithLp.toLp 2 (fun j : Fin D ↦ if j = i then (-1 : ℝ) else 0) by
          ext j
          simp [Pi.single_apply]
      , hsingle]
    simpa using (EuclideanSpace.inner_single_left (𝕜 := ℝ) i (-1 : ℝ) t)
  · have hsingle :
        (WithLp.toLp 2 fun j : Fin D ↦ if j = i then (1 : ℝ) else 0) =
          EuclideanSpace.single i (1 : ℝ) := by
      ext j
      simp [PiLp.single_apply]
    simp only [↓reduceIte]
    rw [show latticeEmbedding ((Pi.single i (1 : ℤ) : LatticePoint D)) =
        WithLp.toLp 2 (fun j : Fin D ↦ if j = i then (1 : ℝ) else 0) by
          ext j
          simp [Pi.single_apply]
      , hsingle]
    simpa using (EuclideanSpace.inner_single_left (𝕜 := ℝ) i (1 : ℝ) t)

/-- Helper for Exercise 17.5.1: pairing the two Boolean signs at each coordinate collapses the
phase sum to twice the cosine sum. -/
private lemma signedUnitStepPhaseSum_eq_twoCosineSum
    {D : ℕ} (t : EuclideanSpace ℝ (Fin D)) :
    ∑ s : Bool × Fin D,
      Complex.exp (((inner ℝ (latticeEmbedding ((if s.1 then Pi.single s.2 (1 : ℤ) else
        Pi.single s.2 (-1)) : LatticePoint D)) t : ℝ) * Complex.I)) =
      (((2 : ℝ) : ℂ) * ∑ i : Fin D, (Real.cos (t i) : ℂ)) := by
  -- Proof comment: split the product index into coordinates and the two sign choices, then use
  -- `Complex.two_cos` on each Boolean fiber.
  rw [Fintype.sum_prod_type, Fintype.sum_bool, ← Finset.sum_add_distrib]
  calc
    ∑ i : Fin D,
        (Complex.exp
            (((inner ℝ (latticeEmbedding ((Pi.single i (1 : ℤ)) : LatticePoint D)) t : ℝ) *
              Complex.I)) +
          Complex.exp
            (((inner ℝ (latticeEmbedding ((Pi.single i (-1 : ℤ)) : LatticePoint D)) t : ℝ) *
              Complex.I)))
        = ∑ i : Fin D, (Complex.exp ((t i) * Complex.I) + Complex.exp (-(t i) * Complex.I)) := by
            refine Finset.sum_congr rfl ?_
            intro i hi
            rw [show (inner ℝ (latticeEmbedding ((Pi.single i (1 : ℤ)) : LatticePoint D)) t : ℝ) =
                t i by
                  simpa using (inner_latticeEmbedding_signedUnitStep (D := D) t true i)]
            rw [show (inner ℝ (latticeEmbedding ((Pi.single i (-1 : ℤ)) : LatticePoint D)) t : ℝ) =
                -t i by
                  simpa using (inner_latticeEmbedding_signedUnitStep (D := D) t false i)]
            simp [neg_mul]
    _ = ∑ i : Fin D, (((2 : ℝ) : ℂ) * (Real.cos (t i) : ℂ)) := by
          refine Finset.sum_congr rfl ?_
          intro i hi
          simpa [Complex.ofReal_cos, two_mul] using (Complex.two_cos (t i)).symm
    _ = (((2 : ℝ) : ℂ) * ∑ i : Fin D, (Real.cos (t i) : ℂ)) := by
          rw [Finset.mul_sum]

/-- Helper for Exercise 17.5.1: the complex-valued simple-walk symbol is the complexification of
its real cosine-average formula. -/
private lemma simpleWalkSymbolComplex_eq_ofReal
    {D : ℕ} (t : EuclideanSpace ℝ (Fin D)) :
    (((D : ℝ)⁻¹ : ℂ) * ∑ i : Fin D, (Real.cos (t i) : ℂ)) =
      ((((D : ℝ)⁻¹ * ∑ i : Fin D, Real.cos (t i)) : ℝ) : ℂ) := by
  -- Proof comment: every term in the symbol is already real, so the complex formula is just the
  -- `Complex.ofReal` image of the real cosine average.
  simp [Complex.ofReal_sum]

/-- Helper for Exercise 17.5.1: the one-step characteristic function of the symmetric simple walk
is the normalized sum of the coordinate cosines. -/
private lemma symmetricSimpleRandomWalkStep_charFun_eq_cosineAverage
    {D : ℕ} [NeZero D] (t : EuclideanSpace ℝ (Fin D)) :
    charFun (((symmetricSimpleRandomWalkStepPMF D).toMeasure).map latticeEmbedding) t =
      (((D : ℝ)⁻¹ : ℂ) * ∑ i : Fin D, (Real.cos (t i) : ℂ)) := by
  let step : Bool × Fin D → LatticePoint D :=
    fun s ↦ if s.1 then Pi.single s.2 (1 : ℤ) else Pi.single s.2 (-1)
  have hmap :
      (((symmetricSimpleRandomWalkStepPMF D).toMeasure).map latticeEmbedding) =
        ((PMF.uniformOfFintype (Bool × Fin D)).toMeasure).map
          (fun s ↦ latticeEmbedding (step s)) := by
    change Measure.map latticeEmbedding
        ((PMF.map step (PMF.uniformOfFintype (Bool × Fin D))).toMeasure) =
      ((PMF.uniformOfFintype (Bool × Fin D)).toMeasure).map
        (fun s ↦ latticeEmbedding (step s))
    rw [← PMF.toMeasure_map (p := PMF.uniformOfFintype (Bool × Fin D))
      (f := step) (hf := measurable_of_finite step)]
    rw [Measure.map_map]
    · rfl
    · exact measurable_of_countable latticeEmbedding
    · exact measurable_of_finite step
  rw [MeasureTheory.charFun_apply]
  rw [hmap]
  have hExpMeas :
      Measurable (fun x : EuclideanSpace ℝ (Fin D) ↦
        Complex.exp (((inner ℝ x t : ℝ) * Complex.I))) := by
    fun_prop
  rw [MeasureTheory.integral_map (measurable_of_finite _).aemeasurable
    hExpMeas.stronglyMeasurable.aestronglyMeasurable]
  rw [PMF.integral_eq_sum]
  -- Proof comment: expand the uniform step law on `Bool × Fin D`, collapse the phase sum with
  -- the earlier signed-step lemma, and simplify the uniform weight `1 / (2D)`.
  calc
    ∑ s : Bool × Fin D,
        ((((PMF.uniformOfFintype (Bool × Fin D)) s).toReal : ℂ) *
          Complex.exp (((inner ℝ (latticeEmbedding (step s)) t : ℝ) * Complex.I)))
      = ((((Fintype.card (Bool × Fin D) : ℕ) : ℝ)⁻¹ : ℂ) *
          ∑ s : Bool × Fin D,
            Complex.exp (((inner ℝ (latticeEmbedding (step s)) t : ℝ) * Complex.I))) := by
            simp [PMF.uniformOfFintype_apply, ENNReal.toReal_inv, ENNReal.toReal_natCast,
              ← Finset.mul_sum]
    _ = ((((2 * D : ℕ) : ℝ)⁻¹ : ℂ) *
          (((2 : ℝ) : ℂ) * ∑ i : Fin D, (Real.cos (t i) : ℂ))) := by
            rw [signedUnitStepPhaseSum_eq_twoCosineSum]
            simp [Fintype.card_prod, Fintype.card_bool]
    _ = (((D : ℝ)⁻¹ : ℂ) * ∑ i : Fin D, (Real.cos (t i) : ℂ)) := by
          have hD0 : (D : ℝ) ≠ 0 := by
            exact_mod_cast (NeZero.ne D)
          have hscalar : (((2 * D : ℕ) : ℝ)⁻¹ * 2 : ℝ) = (D : ℝ)⁻¹ := by
            have htwo : (((2 * D : ℕ) : ℝ)) = 2 * (D : ℝ) := by
              norm_num
            rw [htwo]
            field_simp [hD0]
          let S : ℂ := ∑ i : Fin D, (Real.cos (t i) : ℂ)
          calc
            ((((2 * D : ℕ) : ℝ)⁻¹ : ℂ) * (((2 : ℝ) : ℂ) * S))
              = ((((((2 * D : ℕ) : ℝ)⁻¹) * 2 : ℝ) : ℂ) * S) := by
                  rw [← mul_assoc]
                  simp [Complex.ofReal_mul]
            _ = (((D : ℝ)⁻¹ : ℂ) * S) := by
                  have hscalarC : ((((((2 * D : ℕ) : ℝ)⁻¹) * 2 : ℝ) : ℂ)) = (((D : ℝ)⁻¹ : ℂ)) := by
                    exact_mod_cast hscalar
                  rw [hscalarC]
            _ = (((D : ℝ)⁻¹ : ℂ) * ∑ i : Fin D, (Real.cos (t i) : ℂ)) := by
                  rfl

/-- Helper for Exercise 17.5.1: the even return probability at the origin is the normalized cube
integral of the simple-walk symbol `D⁻¹ ∑ᵢ cos(tᵢ)` raised to the `2n`th power. -/
lemma symmetricSimpleRandomWalkOriginMass_eq_cubeIntegral
    {D n : ℕ} [NeZero D] :
    ((((dirac_convolution_kernel ((symmetricSimpleRandomWalkStepPMF D).toMeasure) ^ (2 * n))
        (0 : LatticePoint D)).real ({0} : Set (LatticePoint D)))) =
      ((2 * Real.pi) ^ D)⁻¹ *
        ∫ t in latticeFrequencyCube D,
          (((D : ℝ)⁻¹) * ∑ i : Fin D, Real.cos (t i)) ^ (2 * n) ∂volume := by
  have hFourier :
      (((((dirac_convolution_kernel ((symmetricSimpleRandomWalkStepPMF D).toMeasure) ^ (2 * n))
          (0 : LatticePoint D)).real ({0} : Set (LatticePoint D)) : ℝ) : ℂ)) =
        (((2 * Real.pi : ℝ) ^ D)⁻¹ : ℂ) *
          ∫ t in latticeFrequencyCube D,
            charFun (((symmetricSimpleRandomWalkStepPMF D).toMeasure).map latticeEmbedding) t ^
              (2 * n) ∂volume := by
    simpa using symmetricSimpleRandomWalkOriginMass_eq_fourierIntegral (D := D) (n := n)
  have hIntegral :
      (∫ t in latticeFrequencyCube D,
          ((((D : ℝ)⁻¹ : ℂ) * ∑ i : Fin D, (Real.cos (t i) : ℂ)) ^ (2 * n)) ∂volume) =
        ∫ t in latticeFrequencyCube D,
          ((((D : ℝ)⁻¹ * ∑ i : Fin D, Real.cos (t i)) ^ (2 * n) : ℝ) : ℂ) ∂volume := by
    refine integral_congr_ae ?_
    filter_upwards with t
    rw [simpleWalkSymbolComplex_eq_ofReal, Complex.ofReal_pow]
  have hIntegralReal :
      (∫ t in latticeFrequencyCube D,
          ((((D : ℝ)⁻¹ * ∑ i : Fin D, Real.cos (t i)) ^ (2 * n) : ℝ) : ℂ) ∂volume) =
        ((∫ t in latticeFrequencyCube D,
            (((D : ℝ)⁻¹ * ∑ i : Fin D, Real.cos (t i)) ^ (2 * n)) ∂volume : ℝ) : ℂ) := by
    simpa using
      (integral_complex_ofReal
        (μ := volume.restrict (latticeFrequencyCube D))
        (f := fun t : EuclideanSpace ℝ (Fin D) ↦
          (((D : ℝ)⁻¹ * ∑ i : Fin D, Real.cos (t i)) ^ (2 * n))))
  have hComplex :
      (((((dirac_convolution_kernel ((symmetricSimpleRandomWalkStepPMF D).toMeasure) ^ (2 * n))
          (0 : LatticePoint D)).real ({0} : Set (LatticePoint D)) : ℝ) : ℂ)) =
        ((((2 * Real.pi) ^ D)⁻¹ *
            ∫ t in latticeFrequencyCube D,
              (((D : ℝ)⁻¹ * ∑ i : Fin D, Real.cos (t i)) ^ (2 * n)) ∂volume : ℝ) : ℂ) := by
    calc
      (((((dirac_convolution_kernel ((symmetricSimpleRandomWalkStepPMF D).toMeasure) ^ (2 * n))
          (0 : LatticePoint D)).real ({0} : Set (LatticePoint D)) : ℝ) : ℂ))
        = (((2 * Real.pi : ℝ) ^ D)⁻¹ : ℂ) *
            ∫ t in latticeFrequencyCube D,
              charFun (((symmetricSimpleRandomWalkStepPMF D).toMeasure).map latticeEmbedding) t ^
                (2 * n) ∂volume := hFourier
      _ = (((2 * Real.pi : ℝ) ^ D)⁻¹ : ℂ) *
            ∫ t in latticeFrequencyCube D,
              ((((D : ℝ)⁻¹ : ℂ) * ∑ i : Fin D, (Real.cos (t i) : ℂ)) ^ (2 * n)) ∂volume := by
              congr 1
              refine integral_congr_ae ?_
              filter_upwards with t
              rw [symmetricSimpleRandomWalkStep_charFun_eq_cosineAverage]
      _ = ((((2 * Real.pi) ^ D)⁻¹ *
              ∫ t in latticeFrequencyCube D,
                (((D : ℝ)⁻¹ * ∑ i : Fin D, Real.cos (t i)) ^ (2 * n)) ∂volume : ℝ) : ℂ) := by
              rw [hIntegral, hIntegralReal]
              simp [Complex.ofReal_mul]
  exact Complex.ofReal_injective hComplex

/-- Helper for Exercise 17.5.1: the real Fourier symbol of the simple symmetric walk on `ℤ^D`. -/
private def simpleWalkSymbol (D : ℕ) (t : EuclideanSpace ℝ (Fin D)) : ℝ :=
  (D : ℝ)⁻¹ * ∑ i : Fin D, Real.cos (t i)

/-- Helper for Exercise 17.5.1: the return-probability formula from
`symmetricSimpleRandomWalkOriginMass_eq_cubeIntegral` rewrites through the local symbol API. -/
private lemma symmetricSimpleRandomWalkOriginMass_eq_symbolIntegral
    {D n : ℕ} [NeZero D] :
    ((((dirac_convolution_kernel ((symmetricSimpleRandomWalkStepPMF D).toMeasure) ^ (2 * n))
        (0 : LatticePoint D)).real ({0} : Set (LatticePoint D)))) =
      ((2 * Real.pi) ^ D)⁻¹ *
        ∫ t in latticeFrequencyCube D, simpleWalkSymbol D t ^ (2 * n) ∂volume := by
  -- Proof comment: this is only a notational repackaging of the established cube-integral formula.
  simpa [simpleWalkSymbol] using
    symmetricSimpleRandomWalkOriginMass_eq_cubeIntegral (D := D) (n := n)

/-- Helper for Exercise 17.5.1: the cosine-average symbol is globally bounded by `1` in absolute
value. -/
private lemma simpleWalkSymbol_abs_le_one
    {D : ℕ} [NeZero D] (t : EuclideanSpace ℝ (Fin D)) :
    |simpleWalkSymbol D t| ≤ 1 := by
  have hD0 : (D : ℝ) ≠ 0 := by
    exact_mod_cast (NeZero.ne D)
  have hDinv_nonneg : 0 ≤ (D : ℝ)⁻¹ := by
    positivity
  -- Proof comment: bound the average by the average of the coordinatewise absolute values, and
  -- then use `|cos| ≤ 1` at each coordinate.
  calc
    |simpleWalkSymbol D t|
      = (D : ℝ)⁻¹ * |∑ i : Fin D, Real.cos (t i)| := by
          rw [simpleWalkSymbol, abs_mul, abs_of_nonneg hDinv_nonneg]
    _ ≤ (D : ℝ)⁻¹ * ∑ i : Fin D, |Real.cos (t i)| := by
          refine mul_le_mul_of_nonneg_left ?_ hDinv_nonneg
          simpa using
            (Finset.abs_sum_le_sum_abs (s := Finset.univ) (f := fun i : Fin D ↦ Real.cos (t i)))
    _ ≤ (D : ℝ)⁻¹ * ∑ _i : Fin D, (1 : ℝ) := by
          refine mul_le_mul_of_nonneg_left ?_ hDinv_nonneg
          exact Finset.sum_le_sum fun i _ ↦ Real.abs_cos_le_one (t i)
    _ = 1 := by
          simp [hD0]

/-- Helper for Exercise 17.5.1: the origin is one of the two points where the symbol reaches its
maximal absolute value. -/
private lemma simpleWalkSymbol_zero
    {D : ℕ} [NeZero D] :
    simpleWalkSymbol D (0 : EuclideanSpace ℝ (Fin D)) = 1 := by
  have hD0 : (D : ℝ) ≠ 0 := by
    exact_mod_cast (NeZero.ne D)
  -- Proof comment: every cosine equals `1` at the origin, so the average stays `1`.
  simp [simpleWalkSymbol, hD0]

/-- Helper for Exercise 17.5.1: the translated peak `(-π, …, -π)` is the other extremal point of
the symbol on the frequency cube. -/
private lemma simpleWalkSymbol_negPi
    {D : ℕ} [NeZero D] :
    simpleWalkSymbol D (WithLp.toLp 2 (fun _ : Fin D ↦ -Real.pi)) = -1 := by
  have hD0 : (D : ℝ) ≠ 0 := by
    exact_mod_cast (NeZero.ne D)
  -- Proof comment: every cosine equals `-1` at `-π`, so the average is exactly `-1`.
  simp [simpleWalkSymbol, hD0]

/-- Helper for Exercise 17.5.1: shifting every coordinate by `π` flips the sign of the simple-walk
symbol. -/
private lemma simpleWalkSymbol_sub_pi
    {D : ℕ} [NeZero D] (t : EuclideanSpace ℝ (Fin D)) :
    simpleWalkSymbol D (WithLp.toLp 2 (fun i : Fin D ↦ t i - Real.pi)) = -simpleWalkSymbol D t := by
  -- Proof comment: the identity is coordinatewise `cos (x - π) = - cos x`.
  rw [simpleWalkSymbol, simpleWalkSymbol]
  simp_rw [Real.cos_sub_pi]
  calc
    (D : ℝ)⁻¹ * ∑ x : Fin D, -Real.cos (t x)
      = (D : ℝ)⁻¹ * (-(∑ x : Fin D, Real.cos (t x))) := by simp
    _ = -((D : ℝ)⁻¹ * ∑ x : Fin D, Real.cos (t x)) := by ring

/-- Helper for Exercise 17.5.1: the even powers of the symbol agree on the two peak charts related
by the `π`-translation. -/
private lemma simpleWalkSymbol_sub_pi_evenPow
    {D n : ℕ} [NeZero D] (t : EuclideanSpace ℝ (Fin D)) :
    simpleWalkSymbol D (WithLp.toLp 2 (fun i : Fin D ↦ t i - Real.pi)) ^ (2 * n) =
      simpleWalkSymbol D t ^ (2 * n) := by
  -- Proof comment: the shift only changes the sign, and the exponent `2 * n` is even.
  rw [simpleWalkSymbol_sub_pi]
  simp

/-- Helper for Exercise 17.5.1: the Gaussian exponent arising after the rescaling step is the
standard squared-norm exponent on `ℝ^D`. -/
private lemma simpleWalkGaussianExponent_eq_norm
    {D : ℕ} (u : EuclideanSpace ℝ (Fin D)) :
    -((∑ i : Fin D, u i ^ 2) / D) = -(1 / (D : ℝ)) * ‖u‖ ^ 2 := by
  have hnorm : ‖u‖ ^ 2 = ∑ i : Fin D, u i ^ 2 := by
    -- Proof comment: on Euclidean space, the squared norm is the sum of the squared coordinates.
    simpa [sq_abs] using (EuclideanSpace.norm_sq_eq u)
  -- Proof comment: once the norm-square identity is in place, the exponent is a direct algebraic
  -- rewrite from division to multiplication by `D⁻¹`.
  rw [div_eq_mul_inv, ← hnorm]
  ring

/-- Helper for Exercise 17.5.1: the Gaussian limit profile integrates to the expected
`(π D)^(D/2)` mass on `ℝ^D`. -/
private lemma simpleWalkGaussianIntegral_eq
    {D : ℕ} [NeZero D] :
    ∫ u : EuclideanSpace ℝ (Fin D), Real.exp (-((∑ i : Fin D, u i ^ 2) / D)) =
      (Real.pi * D) ^ ((D : ℝ) / 2) := by
  have hD0 : (D : ℝ) ≠ 0 := by
    exact_mod_cast (NeZero.ne D)
  have hb : 0 < (1 / (D : ℝ)) := by
    positivity
  calc
    ∫ u : EuclideanSpace ℝ (Fin D), Real.exp (-((∑ i : Fin D, u i ^ 2) / D))
      = ∫ u : EuclideanSpace ℝ (Fin D), Real.exp (-(1 / (D : ℝ)) * ‖u‖ ^ 2) := by
          refine integral_congr_ae ?_
          filter_upwards with u
          rw [simpleWalkGaussianExponent_eq_norm]
    _ = (Real.pi / (1 / (D : ℝ))) ^
          ((Module.finrank ℝ (EuclideanSpace ℝ (Fin D)) : ℝ) / 2) := by
          -- Proof comment: this is the standard multivariate Gaussian integral in Euclidean
          -- space with variance parameter `D`.
          simpa using
            (GaussianFourier.integral_rexp_neg_mul_sq_norm
              (V := EuclideanSpace ℝ (Fin D)) hb)
    _ = (Real.pi * D) ^ ((Module.finrank ℝ (EuclideanSpace ℝ (Fin D)) : ℝ) / 2) := by
          congr 1
          field_simp [hD0]
    _ = (Real.pi * D) ^ ((D : ℝ) / 2) := by
          simp

/-- Helper for Exercise 17.5.1: the coordinate model of the frequency cube `[-π, π)^D`. -/
private def coordinateFrequencyCube (D : ℕ) : Set (Fin D → ℝ) :=
  {x : Fin D → ℝ | ∀ i, x i ∈ Set.Ico (-Real.pi) Real.pi}

/-- Helper for Exercise 17.5.1: the coordinate frequency cube is measurable. -/
private lemma measurableSet_coordinateFrequencyCube (D : ℕ) :
    MeasurableSet (coordinateFrequencyCube D) := by
  have hPi :
      coordinateFrequencyCube D =
        Set.pi Set.univ (fun _ : Fin D ↦ Set.Ico (-Real.pi) Real.pi) := by
    ext x
    simp [coordinateFrequencyCube, Set.mem_pi]
  rw [hPi]
  refine (measurableSet_pi (s := (Set.univ : Set (Fin D)))
    (t := fun _ : Fin D ↦ Set.Ico (-Real.pi) Real.pi)
    (Set.to_countable (s := (Set.univ : Set (Fin D))))).2 <| Or.inl ?_
  intro i hi
  exact measurableSet_Ico

/-- Helper for Exercise 17.5.1: the coordinate symbol obtained by composing the Euclidean symbol
with `WithLp.toLp`. -/
private def coordinateSimpleWalkSymbol (D : ℕ) (x : Fin D → ℝ) : ℝ :=
  simpleWalkSymbol D (WithLp.toLp 2 x)

/-- Helper for Exercise 17.5.1: the coordinate simple-walk symbol is continuous on `ℝ^D`. -/
private lemma continuous_coordinateSimpleWalkSymbol (D : ℕ) :
    Continuous (coordinateSimpleWalkSymbol D) := by
  -- Proof comment: the coordinate symbol is a constant multiple of a finite sum of coordinatewise
  -- cosine terms.
  have hsum : Continuous fun x : Fin D → ℝ ↦ ∑ i : Fin D, Real.cos (x i) := by
    exact continuous_finset_sum Finset.univ fun i _ ↦
      Real.continuous_cos.comp (continuous_apply i)
  simpa [coordinateSimpleWalkSymbol, simpleWalkSymbol] using hsum.const_mul ((D : ℝ)⁻¹)

/-- Helper for Exercise 17.5.1: the closed coordinate cube `[-π, π]^D` is a finite-volume
bounding region for all peak charts used below. -/
private def closedCoordinateFrequencyCube (D : ℕ) : Set (Fin D → ℝ) :=
  Set.Icc (fun _ : Fin D ↦ -Real.pi) fun _ : Fin D ↦ Real.pi

/-- Helper for Exercise 17.5.1: the closed coordinate cube `[-π, π]^D` has finite Lebesgue
volume. -/
private lemma volume_closedCoordinateFrequencyCube_lt_top (D : ℕ) :
    volume (closedCoordinateFrequencyCube D) < ⊤ := by
  -- Proof comment: the closed cube is a finite product of bounded one-dimensional intervals.
  simpa [closedCoordinateFrequencyCube] using
    (measure_Icc_lt_top
      (μ := (volume : Measure (Fin D → ℝ)))
      (a := fun _ : Fin D ↦ -Real.pi) (b := fun _ : Fin D ↦ Real.pi))

/-- Helper for Exercise 17.5.1: the half-open coordinate cube sits inside the corresponding closed
cube. -/
private lemma coordinateFrequencyCube_subset_closedCoordinateFrequencyCube (D : ℕ) :
    coordinateFrequencyCube D ⊆ closedCoordinateFrequencyCube D := by
  intro x hx
  change (fun _ : Fin D ↦ -Real.pi) ≤ x ∧ x ≤ fun _ : Fin D ↦ Real.pi
  constructor
  · intro i
    exact (hx i).1
  · intro i
    exact (hx i).2.le

/-- Helper for Exercise 17.5.1: any subset of the closed coordinate cube supports an integrable
`2n`-th power of the coordinate symbol because the symbol is uniformly bounded by `1`. -/
private lemma integrableOn_coordinateSimpleWalkSymbol_pow_of_subset_closedCube
    {D n : ℕ} [NeZero D] {s : Set (Fin D → ℝ)}
    (hs : s ⊆ closedCoordinateFrequencyCube D) :
    IntegrableOn (fun x : Fin D → ℝ ↦ coordinateSimpleWalkSymbol D x ^ (2 * n)) s volume := by
  have hsFinite : volume s < ⊤ := by
    exact
      lt_of_le_of_lt (measure_mono hs) (volume_closedCoordinateFrequencyCube_lt_top D)
  have hsm :
      AEStronglyMeasurable (fun x : Fin D → ℝ ↦ coordinateSimpleWalkSymbol D x ^ (2 * n))
        volume := by
    exact (continuous_coordinateSimpleWalkSymbol D).pow (2 * n) |>.aestronglyMeasurable
  have hbound :
      ∀ᵐ x ∂volume.restrict s,
        ‖coordinateSimpleWalkSymbol D x ^ (2 * n)‖ ≤ (1 : ℝ) := by
    refine Filter.Eventually.of_forall fun x ↦ ?_
    rw [Real.norm_eq_abs, abs_pow]
    have hsymb : |coordinateSimpleWalkSymbol D x| ≤ 1 := by
      simpa [coordinateSimpleWalkSymbol] using
        (simpleWalkSymbol_abs_le_one (D := D) (t := WithLp.toLp 2 x))
    simpa using (pow_le_one₀ (n := 2 * n) (abs_nonneg _) hsymb)
  -- Proof comment: bounded measurable functions are integrable on finite-measure sets.
  exact Measure.integrableOn_of_bounded (μ := volume) (s := s) hsFinite.ne hsm hbound

/-- Helper for Exercise 17.5.1: the small box around the zero peak in coordinate form. -/
private def zeroPeakBox (D : ℕ) (δ : ℝ) : Set (Fin D → ℝ) :=
  {x : Fin D → ℝ | ∀ i, |x i| ≤ δ}

/-- Helper for Exercise 17.5.1: the negative/positive half-interval used in a zero-peak sign
chart. -/
private def zeroPeakSignInterval (δ : ℝ) (b : Bool) : Set ℝ :=
  if b then Set.Ioc (-δ) 0 else Set.Ico 0 δ

/-- Helper for Exercise 17.5.1: the sign-refined zero-peak chart indexed by one Boolean choice
per coordinate. -/
private def zeroPeakSignBox (D : ℕ) (δ : ℝ) (ε : Fin D → Bool) : Set (Fin D → ℝ) :=
  Set.pi Set.univ fun i ↦ zeroPeakSignInterval δ (ε i)

/-- Helper for Exercise 17.5.1: the wrapped boundary chart around the `(-π, …, -π)` peak. -/
private def wrappedPeakBox (D : ℕ) (δ : ℝ) : Set (Fin D → ℝ) :=
  {x : Fin D → ℝ |
    ∀ i, x i ∈ Set.Ico (-Real.pi) (-Real.pi + δ) ∨ x i ∈ Set.Ioc (Real.pi - δ) Real.pi}

/-- Helper for Exercise 17.5.1: the negative/positive boundary-strip interval used in a wrapped
peak sign chart. -/
private def wrappedPeakSignInterval (δ : ℝ) (b : Bool) : Set ℝ :=
  if b then Set.Ioc (Real.pi - δ) Real.pi else Set.Ico (-Real.pi) (-Real.pi + δ)

/-- Helper for Exercise 17.5.1: the sign-refined wrapped peak chart indexed by one Boolean choice
per coordinate. -/
private def wrappedPeakSignBox (D : ℕ) (δ : ℝ) (ε : Fin D → Bool) : Set (Fin D → ℝ) :=
  Set.pi Set.univ fun i ↦ wrappedPeakSignInterval δ (ε i)

/-- Helper for Exercise 17.5.1: the constant `±π` translation vector attached to a sign chart. -/
private def peakSignShift {D : ℕ} (ε : Fin D → Bool) : Fin D → ℝ :=
  fun i ↦ if ε i then -Real.pi else Real.pi

/-- Helper for Exercise 17.5.1: the compact remainder after removing the two peak charts from the
coordinate cube. -/
private def wrappedRemainderBox (D : ℕ) (δ : ℝ) : Set (Fin D → ℝ) :=
  coordinateFrequencyCube D \ (zeroPeakBox D δ ∪ wrappedPeakBox D δ)

/-- Helper for Exercise 17.5.1: the full wrapped peak chart is measurable. -/
private lemma measurableSet_wrappedPeakBox (D : ℕ) (δ : ℝ) :
    MeasurableSet (wrappedPeakBox D δ) := by
  have hPi :
      wrappedPeakBox D δ =
        Set.pi Set.univ
          (fun _ : Fin D ↦ Set.Ico (-Real.pi) (-Real.pi + δ) ∪ Set.Ioc (Real.pi - δ) Real.pi) := by
    ext x
    simp [wrappedPeakBox, Set.mem_pi]
  rw [hPi]
  refine (measurableSet_pi (s := (Set.univ : Set (Fin D)))
    (t := fun _ : Fin D ↦ Set.Ico (-Real.pi) (-Real.pi + δ) ∪ Set.Ioc (Real.pi - δ) Real.pi)
    (Set.to_countable (s := (Set.univ : Set (Fin D))))).2 <| Or.inl ?_
  intro i hi
  exact measurableSet_Ico.union measurableSet_Ioc

/-- Helper for Exercise 17.5.1: each zero-peak sign box is measurable. -/
private lemma measurableSet_zeroPeakSignBox (D : ℕ) (δ : ℝ) (ε : Fin D → Bool) :
    MeasurableSet (zeroPeakSignBox D δ ε) := by
  -- Proof comment: each coordinate section is a measurable interval, and the index set is finite.
  refine (measurableSet_pi (s := (Set.univ : Set (Fin D)))
    (t := fun i ↦ zeroPeakSignInterval δ (ε i))
    (Set.to_countable (s := (Set.univ : Set (Fin D))))).2 <| Or.inl ?_
  intro i hi
  by_cases h : ε i <;> simp [zeroPeakSignInterval, h]

/-- Helper for Exercise 17.5.1: each wrapped-peak sign box is measurable. -/
private lemma measurableSet_wrappedPeakSignBox (D : ℕ) (δ : ℝ) (ε : Fin D → Bool) :
    MeasurableSet (wrappedPeakSignBox D δ ε) := by
  -- Proof comment: the wrapped sign boxes are also finite products of measurable intervals.
  refine (measurableSet_pi (s := (Set.univ : Set (Fin D)))
    (t := fun i ↦ wrappedPeakSignInterval δ (ε i))
    (Set.to_countable (s := (Set.univ : Set (Fin D))))).2 <| Or.inl ?_
  intro i hi
  by_cases h : ε i <;> simp [wrappedPeakSignInterval, h]

/-- Helper for Exercise 17.5.1: opposite zero-peak sign intervals can only meet at the origin. -/
private lemma zeroPeakSignInterval_inter_subset_zero {δ : ℝ} {b c : Bool} (hbc : b ≠ c) :
    zeroPeakSignInterval δ b ∩ zeroPeakSignInterval δ c ⊆ ({0} : Set ℝ) := by
  -- Route correction: the current half-open convention makes the two sign intervals overlap at
  -- `0`, so the usable statement is intersection control rather than literal disjointness.
  intro x hx
  cases b <;> cases c
  · cases (hbc rfl)
  · rcases hx with ⟨hx₁, hx₂⟩
    simp [zeroPeakSignInterval] at hx₁ hx₂
    simp [hx₁.1.antisymm hx₂.2]
  · rcases hx with ⟨hx₁, hx₂⟩
    simp [zeroPeakSignInterval] at hx₁ hx₂
    simp [hx₂.1.antisymm hx₁.2]
  · cases (hbc rfl)

/-- Helper for Exercise 17.5.1: different zero-peak sign boxes are disjoint up to the coordinate
hyperplanes where some coordinate equals `0`. -/
private lemma zeroPeakSignBox_pairwiseAEDisjoint (D : ℕ) (δ : ℝ) :
    Pairwise fun ε η ↦ AEDisjoint volume (zeroPeakSignBox D δ ε) (zeroPeakSignBox D δ η) := by
  classical
  intro ε η hεη
  obtain ⟨i, hi⟩ : ∃ i : Fin D, ε i ≠ η i := by
    by_contra h
    apply hεη
    ext j
    exact by_contra fun hj ↦ h ⟨j, hj⟩
  rw [AEDisjoint]
  refine measure_mono_null (t := Function.eval i ⁻¹' ({0} : Set ℝ)) ?_ ?_
  · intro x hx
    have hxε : ∀ j : Fin D, x j ∈ zeroPeakSignInterval δ (ε j) := by
      simpa [zeroPeakSignBox, Set.mem_pi] using hx.1
    have hxη : ∀ j : Fin D, x j ∈ zeroPeakSignInterval δ (η j) := by
      simpa [zeroPeakSignBox, Set.mem_pi] using hx.2
    have hx0 : x i = 0 := by
      have hsubset := zeroPeakSignInterval_inter_subset_zero (δ := δ) hi ⟨hxε i, hxη i⟩
      simpa using hsubset
    simp [hx0]
  · simpa [MeasureTheory.volume_pi] using
      (Measure.pi_eval_preimage_null (μ := fun _ : Fin D ↦ (volume : Measure ℝ)) (i := i)
        (s := ({0} : Set ℝ)) (by simp))

/-- Helper for Exercise 17.5.1: the wrapped sign intervals for opposite signs are disjoint as
soon as the two peak charts do not overlap. -/
private lemma wrappedPeakSignInterval_disjoint {δ : ℝ} (hδpi : 2 * δ < Real.pi)
    {b c : Bool} (hbc : b ≠ c) :
    Disjoint (wrappedPeakSignInterval δ b) (wrappedPeakSignInterval δ c) := by
  -- Proof comment: opposite boundary strips lie near `-π` and `π`, so `2 * δ < π` separates
  -- them.
  rw [Set.disjoint_left]
  intro x hx hx'
  cases b <;> cases c
  · cases (hbc rfl)
  · simp [wrappedPeakSignInterval] at hx hx'
    linarith
  · simp [wrappedPeakSignInterval] at hx hx'
    linarith
  · cases (hbc rfl)

/-- Helper for Exercise 17.5.1: different wrapped-peak sign boxes are disjoint when the two peak
charts are separated. -/
private lemma wrappedPeakSignBox_pairwiseDisjoint (D : ℕ) (δ : ℝ) (hδpi : 2 * δ < Real.pi) :
    Pairwise fun ε η ↦ Disjoint (wrappedPeakSignBox D δ ε) (wrappedPeakSignBox D δ η) := by
  classical
  intro ε η hεη
  obtain ⟨i, hi⟩ : ∃ i : Fin D, ε i ≠ η i := by
    by_contra h
    apply hεη
    ext j
    exact by_contra fun hj ↦ h ⟨j, hj⟩
  rw [Set.disjoint_left]
  intro x hxε hxη
  rw [wrappedPeakSignBox, Set.mem_pi] at hxε hxη
  have hxεi : x i ∈ wrappedPeakSignInterval δ (ε i) := hxε i (by simp)
  have hxηi : x i ∈ wrappedPeakSignInterval δ (η i) := hxη i (by simp)
  have hdisj := wrappedPeakSignInterval_disjoint (δ := δ) hδpi hi
  rw [Set.disjoint_left] at hdisj
  exact hdisj hxεi hxηi

/-- Helper for Exercise 17.5.1: the zero box is the closed product interval `[-δ, δ]^D`. -/
private lemma zeroPeakBox_eq_piIcc (D : ℕ) (δ : ℝ) :
    zeroPeakBox D δ = Set.Icc (fun _ : Fin D ↦ -δ) (fun _ : Fin D ↦ δ) := by
  -- Proof comment: both descriptions are coordinatewise `-δ ≤ x i ≤ δ`.
  ext x
  constructor
  · intro hx
    constructor <;> intro i
    · exact (abs_le.mp (hx i)).1
    · exact (abs_le.mp (hx i)).2
  · intro hx i
    exact abs_le.mpr ⟨hx.1 i, hx.2 i⟩

/-- Helper for Exercise 17.5.1: the zero peak box lies in the coordinate frequency cube when the
peak width is smaller than `π`. -/
private lemma zeroPeakBox_subset_coordinateFrequencyCube
    {D : ℕ} {δ : ℝ} (hδpi : 2 * δ < Real.pi) :
    zeroPeakBox D δ ⊆ coordinateFrequencyCube D := by
  have hδltPi : δ < Real.pi := by
    linarith [hδpi, Real.pi_pos]
  intro x hx i
  have hxi : |x i| ≤ δ := hx i
  refine ⟨?_, ?_⟩
  · have hxlow : -δ ≤ x i := (abs_le.mp hxi).1
    linarith
  · have hxupp : x i ≤ δ := (abs_le.mp hxi).2
    linarith

/-- Helper for Exercise 17.5.1: the union of the zero-peak sign boxes is the open product chart
`(-δ, δ)^D` determined by the chosen half-open conventions. -/
private lemma iUnion_zeroPeakSignBox_eq_piIoc (D : ℕ) (δ : ℝ) :
    (⋃ ε : Fin D → Bool, zeroPeakSignBox D δ ε) =
      {x : Fin D → ℝ | ∀ i, x i ∈ Set.Ioo (-δ) δ} := by
  classical
  -- Route correction: with the current `Ioc/Ico` sign charts, the exact coordinatewise union is
  -- `(-δ, δ)`, and the later AE step is where the endpoint closure is restored.
  ext x
  constructor
  · intro hx
    rcases Set.mem_iUnion.1 hx with ⟨ε, hε⟩
    -- Proof comment: a point in one sign chart lies in the open interval `(-δ, δ)` in every
    -- coordinate, regardless of the chart sign.
    intro i
    have hxi : x i ∈ zeroPeakSignInterval δ (ε i) := by
      simpa [zeroPeakSignBox, Set.mem_pi] using hε i (by simp)
    by_cases h : ε i
    · have hmem : x i ∈ Set.Ioc (-δ) 0 := by
        simpa [zeroPeakSignInterval, h] using hxi
      have hδpos : 0 < δ := by
        linarith [hmem.1, hmem.2]
      exact ⟨hmem.1, by linarith [hmem.2, hδpos]⟩
    · have hmem : x i ∈ Set.Ico 0 δ := by
        simpa [zeroPeakSignInterval, h] using hxi
      have hδpos : 0 < δ := by
        linarith [hmem.1, hmem.2]
      exact ⟨by linarith [hmem.1, hδpos], hmem.2⟩
  · intro hx
    let ε : Fin D → Bool := fun i ↦ decide (x i ≤ 0)
    -- Proof comment: choose the sign coordinatewise from the sign of `x i`, then each coordinate
    -- lands in the corresponding half-open interval.
    refine Set.mem_iUnion.2 ⟨ε, ?_⟩
    rw [zeroPeakSignBox, Set.mem_pi]
    intro i hi
    by_cases hxi0 : x i ≤ 0
    · have hε : ε i = true := by
        simp [ε, hxi0]
      have hxi : x i ∈ Set.Ioc (-δ) 0 := ⟨(hx i).1, hxi0⟩
      simpa [zeroPeakSignInterval, hε] using hxi
    · have hε : ε i = false := by
        simp [ε, hxi0]
      have hxi : x i ∈ Set.Ico 0 δ := ⟨(lt_of_not_ge hxi0).le, (hx i).2⟩
      simpa [zeroPeakSignInterval, hε] using hxi

/-- Helper for Exercise 17.5.1: the zero-peak sign-box union agrees almost everywhere with the
closed zero-peak box. -/
private lemma iUnion_zeroPeakSignBox_ae_eq_zeroPeakBox (D : ℕ) (δ : ℝ) :
    (⋃ ε : Fin D → Bool, zeroPeakSignBox D δ ε) =ᵐ[volume] zeroPeakBox D δ := by
  -- Proof comment: rewrite both sides into product-box normal form and use the standard
  -- almost-everywhere replacement of `Ioo` by `Icc` in each coordinate.
  rw [iUnion_zeroPeakSignBox_eq_piIoc, zeroPeakBox_eq_piIcc]
  have hPi :
      {x : Fin D → ℝ | ∀ i, x i ∈ Set.Ioo (-δ) δ} =
        Set.pi Set.univ (fun i : Fin D => Set.Ioo (-δ) δ) := by
    ext x
    simp [Set.mem_setOf_eq]
  rw [hPi]
  simpa using
    (Measure.univ_pi_Ioo_ae_eq_Icc
      (μ := fun _ : Fin D ↦ (volume : Measure ℝ))
      (f := fun _ : Fin D ↦ -δ) (g := fun _ : Fin D ↦ δ))

/-- Helper for Exercise 17.5.1: the wrapped-peak sign boxes exactly partition the wrapped peak
chart. -/
private lemma iUnion_wrappedPeakSignBox_eq_wrappedPeakBox (D : ℕ) (δ : ℝ) :
    (⋃ ε : Fin D → Bool, wrappedPeakSignBox D δ ε) = wrappedPeakBox D δ := by
  classical
  ext x
  constructor
  · intro hx
    rcases Set.mem_iUnion.1 hx with ⟨ε, hε⟩
    -- Proof comment: membership in a single wrapped sign chart gives the corresponding boundary
    -- strip alternative in every coordinate.
    intro i
    have hxi : x i ∈ wrappedPeakSignInterval δ (ε i) := by
      simpa [wrappedPeakSignBox, Set.mem_pi] using hε i (by simp)
    by_cases h : ε i
    · exact Or.inr (by simpa [wrappedPeakSignInterval, h] using hxi)
    · exact Or.inl (by simpa [wrappedPeakSignInterval, h] using hxi)
  · intro hx
    let ε : Fin D → Bool := fun i ↦ if x i ∈ Set.Ioc (Real.pi - δ) Real.pi then true else false
    -- Proof comment: choose the sign from whether the coordinate lies in the right boundary strip.
    refine Set.mem_iUnion.2 ⟨ε, ?_⟩
    rw [wrappedPeakSignBox, Set.mem_pi]
    intro i hi
    by_cases hright : x i ∈ Set.Ioc (Real.pi - δ) Real.pi
    · have hε : ε i = true := by
        unfold ε
        simp [hright]
      rw [hε, wrappedPeakSignInterval]
      exact hright
    · have hleft : x i ∈ Set.Ico (-Real.pi) (-Real.pi + δ) := by
        rcases hx i with hleft | hright'
        · exact hleft
        · exact False.elim (hright hright')
      have hε : ε i = false := by
        unfold ε
        simp [hright]
      rw [hε, wrappedPeakSignInterval]
      exact hleft

/-- Helper for Exercise 17.5.1: the `±π` translation attached to a sign chart flips the sign of
the coordinate symbol, so its even powers are unchanged. -/
private lemma coordinateSimpleWalkSymbol_peakSignShift_evenPow
    {D n : ℕ} [NeZero D] (ε : Fin D → Bool) (x : Fin D → ℝ) :
    coordinateSimpleWalkSymbol D (peakSignShift ε + x) ^ (2 * n) =
      coordinateSimpleWalkSymbol D x ^ (2 * n) := by
  have hshift :
      coordinateSimpleWalkSymbol D (peakSignShift ε + x) = -coordinateSimpleWalkSymbol D x := by
    rw [coordinateSimpleWalkSymbol, coordinateSimpleWalkSymbol, simpleWalkSymbol, simpleWalkSymbol]
    calc
      (D : ℝ)⁻¹ * ∑ i : Fin D, Real.cos ((peakSignShift ε + x) i)
          = (D : ℝ)⁻¹ * ∑ i : Fin D, Real.cos ((if ε i then -Real.pi else Real.pi) + x i) := by
              simp only [peakSignShift, Pi.add_apply]
      _ = (D : ℝ)⁻¹ * ∑ i : Fin D, -(Real.cos (x i)) := by
              congr 1
              refine Finset.sum_congr rfl fun i hi ↦ ?_
              by_cases h : ε i
              · rw [h]
                simpa [sub_eq_add_neg, add_comm, add_left_comm, add_assoc] using
                  (Real.cos_sub_pi (x i))
              · rw [if_neg h]
                simpa [add_comm, add_left_comm, add_assoc] using (Real.cos_add_pi (x i))
      _ = (D : ℝ)⁻¹ * (-(∑ i : Fin D, Real.cos (x i))) := by
            have hsumneg :
                (∑ i : Fin D, -Real.cos (x i)) = -(∑ i : Fin D, Real.cos (x i)) := by
              rw [Finset.sum_neg_distrib]
            exact congrArg (fun r : ℝ ↦ (D : ℝ)⁻¹ * r) hsumneg
      _ = -((D : ℝ)⁻¹ * ∑ i : Fin D, Real.cos (x i)) := by ring
    -- Proof comment: shifting each coordinate by `±π` flips every cosine term.
  rw [hshift]
  simp

/-- Helper for Exercise 17.5.1: translating a wrapped sign box by its constant `±π` shift lands
exactly on the corresponding zero sign box. -/
private lemma wrappedPeakSignBox_image_eq_zeroPeakSignBox
    {D : ℕ} (δ : ℝ) (ε : Fin D → Bool) :
    (fun x : Fin D → ℝ ↦ peakSignShift ε + x) '' wrappedPeakSignBox D δ ε =
      zeroPeakSignBox D δ ε := by
  ext y
  constructor
  · rintro ⟨x, hx, rfl⟩
    have hx' : ∀ i : Fin D, x i ∈ wrappedPeakSignInterval δ (ε i) := by
      simpa [wrappedPeakSignBox, Set.mem_pi] using hx
    rw [zeroPeakSignBox, Set.mem_pi]
    intro i
    by_cases h : ε i
    · have hmem : x i - Real.pi ∈ Set.Ioc (-δ) 0 := by
        have hxi : x i ∈ Set.Ioc (Real.pi - δ) Real.pi := by
          simpa [wrappedPeakSignInterval, h] using hx' i
        exact ⟨by linarith [hxi.1], by linarith [hxi.2]⟩
      simpa [peakSignShift, zeroPeakSignInterval, h, sub_eq_add_neg, add_comm, add_left_comm,
        add_assoc] using hmem
    · have hmem : Real.pi + x i ∈ Set.Ico 0 δ := by
        have hxi : x i ∈ Set.Ico (-Real.pi) (-Real.pi + δ) := by
          simpa [wrappedPeakSignInterval, h] using hx' i
        exact ⟨by linarith [hxi.1], by linarith [hxi.2]⟩
      simpa [peakSignShift, zeroPeakSignInterval, h, add_comm, add_left_comm, add_assoc] using hmem
  · intro hy
    refine ⟨fun i ↦ y i - peakSignShift ε i, ?_, ?_⟩
    · have hy' : ∀ i : Fin D, y i ∈ zeroPeakSignInterval δ (ε i) := by
        simpa [zeroPeakSignBox, Set.mem_pi] using hy
      rw [wrappedPeakSignBox, Set.mem_pi]
      intro i
      by_cases h : ε i
      · have hmem : y i + Real.pi ∈ Set.Ioc (Real.pi - δ) Real.pi := by
          have hyi : y i ∈ Set.Ioc (-δ) 0 := by
            simpa [zeroPeakSignInterval, h] using hy' i
          exact ⟨by linarith [hyi.1], by linarith [hyi.2]⟩
        simpa [peakSignShift, wrappedPeakSignInterval, h, sub_eq_add_neg, add_comm, add_left_comm,
          add_assoc] using hmem
      · have hmem : y i - Real.pi ∈ Set.Ico (-Real.pi) (-Real.pi + δ) := by
          have hyi : y i ∈ Set.Ico 0 δ := by
            simpa [zeroPeakSignInterval, h] using hy' i
          exact ⟨by linarith [hyi.1], by linarith [hyi.2]⟩
        simpa [peakSignShift, wrappedPeakSignInterval, h, sub_eq_add_neg, add_comm, add_left_comm,
          add_assoc] using hmem
    · ext i
      by_cases h : ε i <;> simp [peakSignShift, h]

/-- Helper for Exercise 17.5.1: each sign-refined wrapped peak integral transports to the
corresponding sign-refined zero peak integral. -/
private lemma wrappedPeakSignBoxIntegral_eq_zeroPeakSignBoxIntegral
    {D n : ℕ} [NeZero D] (δ : ℝ) (ε : Fin D → Bool) :
    ∫ x in wrappedPeakSignBox D δ ε, coordinateSimpleWalkSymbol D x ^ (2 * n) ∂volume =
      ∫ x in zeroPeakSignBox D δ ε, coordinateSimpleWalkSymbol D x ^ (2 * n) ∂volume := by
  let τ : (Fin D → ℝ) → (Fin D → ℝ) := fun x ↦ peakSignShift ε + x
  let g : (Fin D → ℝ) → ℝ := fun x ↦ coordinateSimpleWalkSymbol D x ^ (2 * n)
  have hmp : MeasurePreserving τ volume volume := by
    simpa [τ] using (measurePreserving_add_left volume (peakSignShift ε))
  have hme : MeasurableEmbedding τ := by
    simpa [τ] using (measurableEmbedding_addLeft (peakSignShift ε))
  calc
    ∫ x in wrappedPeakSignBox D δ ε, g x ∂volume
        = ∫ x in wrappedPeakSignBox D δ ε, g (τ x) ∂volume := by
            refine integral_congr_ae ?_
            filter_upwards with x
            simp [g, τ, coordinateSimpleWalkSymbol_peakSignShift_evenPow]
    _ = ∫ y in τ '' wrappedPeakSignBox D δ ε, g y ∂volume := by
          symm
          exact MeasurePreserving.setIntegral_image_emb hmp hme g (wrappedPeakSignBox D δ ε)
    _ = ∫ y in zeroPeakSignBox D δ ε, g y ∂volume := by
          rw [wrappedPeakSignBox_image_eq_zeroPeakSignBox]

/-- Helper for Exercise 17.5.1: every zero-peak sign box sits inside the closed frequency cube
once `δ < π`. -/
private lemma zeroPeakSignBox_subset_closedCoordinateFrequencyCube
    {D : ℕ} {δ : ℝ} (hδpi : 2 * δ < Real.pi) (ε : Fin D → Bool) :
    zeroPeakSignBox D δ ε ⊆ closedCoordinateFrequencyCube D := by
  have hδltPi : δ < Real.pi := by
    linarith [hδpi, Real.pi_pos]
  intro x hx
  -- Proof comment: each sign interval lies inside `[-π, π]` because `δ < π`.
  change (fun _ : Fin D ↦ -Real.pi) ≤ x ∧ x ≤ fun _ : Fin D ↦ Real.pi
  constructor
  · intro i
    have hxi : x i ∈ zeroPeakSignInterval δ (ε i) := by
      simpa [zeroPeakSignBox, Set.mem_pi] using hx i (by simp)
    by_cases h : ε i
    · have hmem : x i ∈ Set.Ioc (-δ) 0 := by
        simpa [zeroPeakSignInterval, h] using hxi
      linarith [hmem.1, hδltPi]
    · have hmem : x i ∈ Set.Ico 0 δ := by
        simpa [zeroPeakSignInterval, h] using hxi
      exact le_trans (by linarith [Real.pi_pos] : -Real.pi ≤ 0) hmem.1
  · intro i
    have hxi : x i ∈ zeroPeakSignInterval δ (ε i) := by
      simpa [zeroPeakSignBox, Set.mem_pi] using hx i (by simp)
    by_cases h : ε i
    · have hmem : x i ∈ Set.Ioc (-δ) 0 := by
        simpa [zeroPeakSignInterval, h] using hxi
      linarith [hmem.2, Real.pi_pos]
    · have hmem : x i ∈ Set.Ico 0 δ := by
        simpa [zeroPeakSignInterval, h] using hxi
      exact (le_of_lt hmem.2).trans (le_of_lt hδltPi)

/-- Helper for Exercise 17.5.1: every wrapped-peak sign box lies in the closed frequency cube. -/
private lemma wrappedPeakSignBox_subset_closedCoordinateFrequencyCube
    {D : ℕ} {δ : ℝ} (hδpi : 2 * δ < Real.pi) (ε : Fin D → Bool) :
    wrappedPeakSignBox D δ ε ⊆ closedCoordinateFrequencyCube D := by
  have hδltTwoPi : δ < 2 * Real.pi := by
    linarith [hδpi, Real.pi_pos]
  intro x hx
  -- Proof comment: the boundary-strip intervals stay in `[-π, π]` once `δ < 2π`, which follows
  -- from the standing separation hypothesis `2δ < π`.
  change (fun _ : Fin D ↦ -Real.pi) ≤ x ∧ x ≤ fun _ : Fin D ↦ Real.pi
  constructor
  · intro i
    have hxi : x i ∈ wrappedPeakSignInterval δ (ε i) := by
      simpa [wrappedPeakSignBox, Set.mem_pi] using hx i (by simp)
    by_cases h : ε i
    · have hmem : x i ∈ Set.Ioc (Real.pi - δ) Real.pi := by
        simpa [wrappedPeakSignInterval, h] using hxi
      linarith [hmem.1, hδltTwoPi]
    · have hmem : x i ∈ Set.Ico (-Real.pi) (-Real.pi + δ) := by
        simpa [wrappedPeakSignInterval, h] using hxi
      exact hmem.1
  · intro i
    have hxi : x i ∈ wrappedPeakSignInterval δ (ε i) := by
      simpa [wrappedPeakSignBox, Set.mem_pi] using hx i (by simp)
    by_cases h : ε i
    · have hmem : x i ∈ Set.Ioc (Real.pi - δ) Real.pi := by
        simpa [wrappedPeakSignInterval, h] using hxi
      exact hmem.2
    · have hmem : x i ∈ Set.Ico (-Real.pi) (-Real.pi + δ) := by
        simpa [wrappedPeakSignInterval, h] using hxi
      exact (le_of_lt hmem.2).trans <| by linarith [hδltTwoPi]

/-- Helper for Exercise 17.5.1: the full wrapped peak integral equals the zero peak integral after
reassembling the sign-box transports. -/
private lemma wrappedPeakBoxIntegral_eq_zeroPeakBoxIntegral
    {D n : ℕ} [NeZero D] {δ : ℝ} (hδpi : 2 * δ < Real.pi) :
    ∫ x in wrappedPeakBox D δ, coordinateSimpleWalkSymbol D x ^ (2 * n) ∂volume =
      ∫ x in zeroPeakBox D δ, coordinateSimpleWalkSymbol D x ^ (2 * n) ∂volume := by
  let f : (Fin D → ℝ) → ℝ := fun x ↦ coordinateSimpleWalkSymbol D x ^ (2 * n)
  have hWrapInt :
      ∀ ε : Fin D → Bool, IntegrableOn f (wrappedPeakSignBox D δ ε) volume := by
    intro ε
    -- Proof comment: every wrapped sign box sits in the closed cube, where the symbol is bounded.
    refine integrableOn_coordinateSimpleWalkSymbol_pow_of_subset_closedCube
      (D := D) (n := n) ?_
    exact wrappedPeakSignBox_subset_closedCoordinateFrequencyCube (hδpi := hδpi) ε
  have hZeroUnionInt :
      IntegrableOn f (⋃ ε : Fin D → Bool, zeroPeakSignBox D δ ε) volume := by
    have hδltPi : δ < Real.pi := by
      linarith [hδpi, Real.pi_pos]
    -- Proof comment: after rewriting the union to `(-δ, δ)^D`, the same bounded closed-cube
    -- integrability argument applies.
    refine integrableOn_coordinateSimpleWalkSymbol_pow_of_subset_closedCube
      (D := D) (n := n) ?_
    rw [iUnion_zeroPeakSignBox_eq_piIoc]
    intro x hx
    change (fun _ : Fin D ↦ -Real.pi) ≤ x ∧ x ≤ fun _ : Fin D ↦ Real.pi
    constructor <;> intro i
    · have hxi : x i ∈ Set.Ioo (-δ) δ := hx i
      linarith [hxi.1, hδltPi]
    · have hxi : x i ∈ Set.Ioo (-δ) δ := hx i
      linarith [hxi.2, hδltPi]
  have hWrappedUnion :
      ∫ x in wrappedPeakBox D δ, f x ∂volume =
        ∑ ε : Fin D → Bool, ∫ x in wrappedPeakSignBox D δ ε, f x ∂volume := by
    -- Proof comment: the wrapped sign charts form an exact finite disjoint partition.
    rw [← iUnion_wrappedPeakSignBox_eq_wrappedPeakBox]
    simpa [f] using
      (MeasureTheory.integral_iUnion_fintype
        (f := f) (μ := volume) (s := fun ε : Fin D → Bool ↦ wrappedPeakSignBox D δ ε)
        (hs := fun ε ↦ measurableSet_wrappedPeakSignBox D δ ε)
        (h's := wrappedPeakSignBox_pairwiseDisjoint D δ hδpi)
        (hf := hWrapInt))
  have hZeroUnion :
      ∫ x in ⋃ ε : Fin D → Bool, zeroPeakSignBox D δ ε, f x ∂volume =
        ∑ ε : Fin D → Bool, ∫ x in zeroPeakSignBox D δ ε, f x ∂volume := by
    -- Proof comment: on the zero side the sign charts are only pairwise `AEDisjoint`, so the
    -- countable-union theorem is the right reassembly tool.
    calc
      ∫ x in ⋃ ε : Fin D → Bool, zeroPeakSignBox D δ ε, f x ∂volume
          = ∑' ε : Fin D → Bool, ∫ x in zeroPeakSignBox D δ ε, f x ∂volume := by
              exact MeasureTheory.integral_iUnion_ae
                (f := f) (μ := volume) (s := fun ε : Fin D → Bool ↦ zeroPeakSignBox D δ ε)
                (hm := fun ε ↦ (measurableSet_zeroPeakSignBox D δ ε).nullMeasurableSet)
                (hd := zeroPeakSignBox_pairwiseAEDisjoint D δ)
                (hfi := hZeroUnionInt)
      _ = ∑ ε : Fin D → Bool, ∫ x in zeroPeakSignBox D δ ε, f x ∂volume := by
            exact
              (tsum_fintype
                (fun ε : Fin D → Bool ↦ ∫ x in zeroPeakSignBox D δ ε, f x ∂volume))
  have hTransportSum :
      (∑ ε : Fin D → Bool, ∫ x in wrappedPeakSignBox D δ ε, f x ∂volume) =
        ∑ ε : Fin D → Bool, ∫ x in zeroPeakSignBox D δ ε, f x ∂volume := by
    -- Proof comment: each wrapped chart transports to its zero chart by the constant `±π`
    -- translation.
    refine Finset.sum_congr rfl ?_
    intro ε hε
    exact wrappedPeakSignBoxIntegral_eq_zeroPeakSignBoxIntegral (D := D) (n := n) δ ε
  calc
    ∫ x in wrappedPeakBox D δ, coordinateSimpleWalkSymbol D x ^ (2 * n) ∂volume
        = ∑ ε : Fin D → Bool, ∫ x in wrappedPeakSignBox D δ ε, f x ∂volume := by
            simpa [f] using hWrappedUnion
    _ = ∑ ε : Fin D → Bool, ∫ x in zeroPeakSignBox D δ ε, f x ∂volume := hTransportSum
    _ = ∫ x in ⋃ ε : Fin D → Bool, zeroPeakSignBox D δ ε, f x ∂volume := by
          symm
          exact hZeroUnion
    _ = ∫ x in zeroPeakBox D δ, f x ∂volume := by
          exact MeasureTheory.setIntegral_congr_set
            (μ := volume) (f := f) (iUnion_zeroPeakSignBox_ae_eq_zeroPeakBox D δ)
    _ = ∫ x in zeroPeakBox D δ, coordinateSimpleWalkSymbol D x ^ (2 * n) ∂volume := by
          rfl

/-- Helper for Exercise 17.5.1: inside the wrapped peak, the only points missing from the
half-open coordinate cube are the coordinate hyperplanes `x i = π`, which have zero volume. -/
private lemma wrappedPeakBox_ae_eq_wrappedPeakBox_inter_coordinateFrequencyCube
    {D : ℕ} {δ : ℝ} (hδpi : 2 * δ < Real.pi) :
    (wrappedPeakBox D δ : Set (Fin D → ℝ)) =ᵐ[(volume : Measure (Fin D → ℝ))]
      ((wrappedPeakBox D δ ∩ coordinateFrequencyCube D) : Set (Fin D → ℝ)) := by
  let bad : Set (Fin D → ℝ) := ⋃ i : Fin D, Function.eval i ⁻¹' ({Real.pi} : Set ℝ)
  have hbad_zero : volume bad = 0 := by
    refine measure_iUnion_null fun i ↦ ?_
    simpa [MeasureTheory.volume_pi] using
      (Measure.pi_eval_preimage_null (μ := fun _ : Fin D ↦ (volume : Measure ℝ)) (i := i)
        (s := ({Real.pi} : Set ℝ)) (by simp))
  have hδltTwoPi : δ < 2 * Real.pi := by
    linarith [hδpi, Real.pi_pos]
  filter_upwards [compl_mem_ae_iff.2 hbad_zero] with x hxbad
  apply propext
  constructor
  · intro hxWrap
    refine ⟨hxWrap, ?_⟩
    intro i
    rcases hxWrap i with hleft | hright
    · refine ⟨hleft.1, ?_⟩
      linarith [hleft.2, hδpi, Real.pi_pos]
    · have hne : x i ≠ Real.pi := by
        intro hEq
        apply hxbad
        refine Set.mem_iUnion.2 ⟨i, ?_⟩
        simp [hEq]
      refine ⟨?_, lt_of_le_of_ne hright.2 hne⟩
      linarith [hright.1, hδltTwoPi]
  · intro hx
    exact hx.1

/-- Helper for Exercise 17.5.1: when the two peaks are separated, the zero peak and the wrapped
peak are disjoint. -/
private lemma zeroPeakBox_disjoint_wrappedPeakBox
    {D : ℕ} [NeZero D] {δ : ℝ} (hδpi : 2 * δ < Real.pi) :
    Disjoint (zeroPeakBox D δ) (wrappedPeakBox D δ) := by
  rw [Set.disjoint_left]
  intro x hxZero hxWrap
  let i : Fin D := ⟨0, Nat.pos_of_ne_zero (NeZero.ne D)⟩
  have hAbs : |x i| ≤ δ := hxZero i
  rcases hxWrap i with hleft | hright
  · have hxlow : -δ ≤ x i := (abs_le.mp hAbs).1
    linarith [hxlow, hleft.2]
  · have hxupp : x i ≤ δ := (abs_le.mp hAbs).2
    linarith [hxupp, hright.1]

/-- Helper for Exercise 17.5.1: the coordinate cube has the same volume as the Euclidean
frequency cube `[-π, π)^D`. -/
private lemma volume_coordinateFrequencyCube
    (D : ℕ) :
    volume (coordinateFrequencyCube D) = ENNReal.ofReal ((2 * Real.pi : ℝ) ^ D) := by
  -- Proof comment: transport the coordinate cube through the volume-preserving `WithLp.toLp`
  -- equivalence and reuse the owner-side Euclidean cube volume formula from Theorem 15.10.
  calc
    volume (coordinateFrequencyCube D)
      = volume ((WithLp.toLp 2) ⁻¹' latticeFrequencyCube D) := by
          simp [coordinateFrequencyCube, latticeFrequencyCube]
    _ = volume (latticeFrequencyCube D) := by
          rw [(PiLp.volume_preserving_toLp (ι := Fin D)).measure_preimage
            (s := latticeFrequencyCube D) (measurableSet_latticeFrequencyCube D).nullMeasurableSet]
    _ = ENNReal.ofReal ((2 * Real.pi : ℝ) ^ D) := by
          simpa using volume_latticeFrequencyCube D

/-- Helper for Exercise 17.5.1: points in the wrapped remainder have at least one coordinate
outside the zero peak box. -/
private lemma exists_abs_gt_of_mem_wrappedRemainder
    {D : ℕ} {δ : ℝ} {x : Fin D → ℝ}
    (hx : x ∈ wrappedRemainderBox D δ) :
    ∃ i : Fin D, δ < |x i| := by
  classical
  have hxZero : x ∉ zeroPeakBox D δ := by
    exact fun hx0 ↦ hx.2 (Or.inl hx0)
  -- Proof comment: failure of zero-box membership means that some coordinate exceeds the
  -- threshold `δ` in absolute value.
  have hxZero' : ¬ ∀ i, |x i| ≤ δ := by
    simpa [zeroPeakBox] using hxZero
  rw [not_forall] at hxZero'
  rcases hxZero' with ⟨i, hi⟩
  exact ⟨i, lt_of_not_ge hi⟩

/-- Helper for Exercise 17.5.1: points in the wrapped remainder also have a coordinate staying
away from the wrapped `±π` boundary strips. -/
private lemma exists_mem_centeredStrip_of_mem_wrappedRemainder
    {D : ℕ} {δ : ℝ} {x : Fin D → ℝ}
    (hx : x ∈ wrappedRemainderBox D δ) :
    ∃ i : Fin D, -Real.pi + δ ≤ x i ∧ x i ≤ Real.pi - δ := by
  classical
  have hxWrap :
      ¬ ∀ i, x i ∈ Set.Ico (-Real.pi) (-Real.pi + δ) ∨ x i ∈ Set.Ioc (Real.pi - δ) Real.pi := by
    simpa [wrappedPeakBox] using (fun hx0 ↦ hx.2 (Or.inr hx0) : x ∈ wrappedPeakBox D δ → False)
  push Not at hxWrap
  rcases hxWrap with ⟨i, hi⟩
  have hCube : x i ∈ Set.Ico (-Real.pi) Real.pi := hx.1 i
  have hnotLeft : x i ∉ Set.Ico (-Real.pi) (-Real.pi + δ) := by
    exact hi.1
  have hnotRight : x i ∉ Set.Ioc (Real.pi - δ) Real.pi := by
    exact hi.2
  have hlowCube : -Real.pi ≤ x i := hCube.1
  have huppCube : x i < Real.pi := hCube.2
  have hlow : -Real.pi + δ ≤ x i := by
    by_contra hlow
    exact hnotLeft ⟨hlowCube, lt_of_not_ge hlow⟩
  have hupp : x i ≤ Real.pi - δ := by
    by_contra hupp
    exact hnotRight ⟨lt_of_not_ge hupp, huppCube.le⟩
  -- Proof comment: one coordinate avoids both boundary strips, so it lies in the centered strip
  -- `[−π + δ, π − δ]`.
  exact ⟨i, hlow, hupp⟩

/-- Helper for Exercise 17.5.1: on the wrapped remainder, the coordinate simple-walk symbol is
uniformly bounded by some explicit `ρ < 1`. -/
private lemma coordinateSimpleWalkSymbol_abs_le_rho_of_mem_wrappedRemainder
    {D : ℕ} [NeZero D] {δ : ℝ}
    (hδ : 0 < δ) (hδpi : 2 * δ < Real.pi) :
    ∃ ρ : ℝ, 0 < ρ ∧ ρ < 1 ∧
      ∀ x ∈ wrappedRemainderBox D δ, |coordinateSimpleWalkSymbol D x| ≤ ρ := by
  let ρ : ℝ := ((((D - 1 : ℕ) : ℝ) + Real.cos δ) / (D : ℝ))
  have hD0 : (D : ℝ) ≠ 0 := by
    exact_mod_cast (NeZero.ne D)
  have hDposNat : 0 < D := Nat.pos_of_ne_zero (NeZero.ne D)
  have hDpos : 0 < (D : ℝ) := by
    exact_mod_cast hDposNat
  have hδltPiDivTwo : δ < Real.pi / 2 := by
    linarith [hδpi]
  have hcosPos : 0 < Real.cos δ := by
    exact Real.cos_pos_of_mem_Ioo ⟨by linarith, hδltPiDivTwo⟩
  have hcosNe : Real.cos δ ≠ 1 := by
    intro hcos
    have hltTwoPi : δ < 2 * Real.pi := by
      linarith [hδpi, Real.pi_pos]
    have hδzero : δ = 0 := by
      exact (Real.cos_eq_one_iff_of_lt_of_lt (x := δ) (by linarith [Real.pi_pos]) hltTwoPi).1 hcos
    exact hδ.ne' hδzero
  have hcosLtOne : Real.cos δ < 1 := by
    exact lt_of_le_of_ne (Real.cos_le_one δ) hcosNe
  have hcastPred : (((D - 1 : ℕ) : ℝ)) = (D : ℝ) - 1 := by
    have hcastPredNat : D - 1 + 1 = D := Nat.sub_add_cancel (Nat.succ_le_of_lt hDposNat)
    have hcastPredReal : (((D - 1 : ℕ) : ℝ) + 1) = (D : ℝ) := by
      exact_mod_cast hcastPredNat
    linarith
  have hρpos : 0 < ρ := by
    -- Proof comment: the explicit numerator is positive because `cos δ > 0`.
    have hnumPos : 0 < (((D - 1 : ℕ) : ℝ) + Real.cos δ) := by
      positivity
    exact div_pos hnumPos hDpos
  have hρlt : ρ < 1 := by
    -- Proof comment: the numerator is strictly smaller than `D` because the exceptional
    -- coordinate contributes at most `cos δ < 1`.
    have hnumLt : (((D - 1 : ℕ) : ℝ) + Real.cos δ) < (D : ℝ) := by
      rw [hcastPred]
      linarith
    exact (div_lt_one hDpos).2 hnumLt
  refine ⟨ρ, hρpos, hρlt, ?_⟩
  intro x hx
  rcases exists_abs_gt_of_mem_wrappedRemainder hx with ⟨i, hi⟩
  rcases exists_mem_centeredStrip_of_mem_wrappedRemainder hx with ⟨j, hjlow, hjupp⟩
  have habsi : δ ≤ |x i| := hi.le
  have hcosUpper : Real.cos (x i) ≤ Real.cos δ := by
    have habsi_le_pi : |x i| ≤ Real.pi := by
      have hCube : x i ∈ Set.Ico (-Real.pi) Real.pi := hx.1 i
      rw [abs_le]
      constructor <;> linarith [hCube.1, hCube.2]
    have := Real.cos_le_cos_of_nonneg_of_le_pi hδ.le habsi_le_pi habsi
    simpa [Real.cos_abs] using this
  have hcosLower : -Real.cos δ ≤ Real.cos (x j) := by
    have habsj : |x j| ≤ Real.pi - δ := by
      rw [abs_le]
      constructor <;> linarith
    have hpiSub : Real.pi - δ ≤ Real.pi := by
      linarith
    have hcosAbs :
        Real.cos (Real.pi - δ) ≤ Real.cos |x j| := by
      exact Real.cos_le_cos_of_nonneg_of_le_pi (abs_nonneg _) hpiSub habsj
    simpa [Real.cos_abs, Real.cos_pi_sub] using hcosAbs
  have hsumUpper :
      ∑ k : Fin D, Real.cos (x k) ≤ (((D - 1 : ℕ) : ℝ) + Real.cos δ) := by
    -- Proof comment: one coordinate is bounded by `cos δ`, while every other coordinate is at
    -- most `1`.
    have hspliti :
        ∑ k : Fin D, Real.cos (x k) =
          Real.cos (x i) +
            Finset.sum (Finset.univ.erase i) (fun k : Fin D ↦ Real.cos (x k)) := by
      rw [Finset.sum_eq_add_sum_diff_singleton_of_mem
        (s := Finset.univ) (i := i) (f := fun k : Fin D ↦ Real.cos (x k)) (Finset.mem_univ i)]
      simp
    calc
      ∑ k : Fin D, Real.cos (x k)
          = Real.cos (x i) +
              Finset.sum (Finset.univ.erase i) (fun k : Fin D ↦ Real.cos (x k)) := hspliti
      _ ≤ Real.cos δ + Finset.sum (Finset.univ.erase i) (fun k : Fin D ↦ Real.cos (x k)) := by
            exact add_le_add hcosUpper le_rfl
      _ ≤ Real.cos δ + Finset.sum (Finset.univ.erase i) (fun _ : Fin D ↦ (1 : ℝ)) := by
            exact add_le_add le_rfl (Finset.sum_le_sum fun k hk ↦ Real.cos_le_one (x k))
      _ = (((D - 1 : ℕ) : ℝ) + Real.cos δ) := by
            simp [add_comm]
  have hsumLower :
      -((((D - 1 : ℕ) : ℝ) + Real.cos δ)) ≤ ∑ k : Fin D, Real.cos (x k) := by
    -- Proof comment: one coordinate is bounded below by `-cos δ`, while every other coordinate is
    -- at least `-1`.
    have hsplitj :
        ∑ k : Fin D, Real.cos (x k) =
          Real.cos (x j) +
            Finset.sum (Finset.univ.erase j) (fun k : Fin D ↦ Real.cos (x k)) := by
      rw [Finset.sum_eq_add_sum_diff_singleton_of_mem
        (s := Finset.univ) (i := j) (f := fun k : Fin D ↦ Real.cos (x k)) (Finset.mem_univ j)]
      simp
    calc
      -((((D - 1 : ℕ) : ℝ) + Real.cos δ))
          = (-Real.cos δ) + Finset.sum (Finset.univ.erase j) (fun _ : Fin D ↦ (-1 : ℝ)) := by
              simp [add_comm]
      _ ≤ Real.cos (x j) + Finset.sum (Finset.univ.erase j) (fun _ : Fin D ↦ (-1 : ℝ)) := by
            exact add_le_add hcosLower le_rfl
      _ ≤ Real.cos (x j) +
            Finset.sum (Finset.univ.erase j) (fun k : Fin D ↦ Real.cos (x k)) := by
            exact add_le_add le_rfl (Finset.sum_le_sum fun k hk ↦ Real.neg_one_le_cos (x k))
      _ = ∑ k : Fin D, Real.cos (x k) := by
            rw [hsplitj]
  have hupperAvg : coordinateSimpleWalkSymbol D x ≤ ρ := by
    -- Proof comment: divide the upper sum estimate by the positive dimension factor `D`.
    have hInvNonneg : 0 ≤ (D : ℝ)⁻¹ := by positivity
    have hmul :
        (D : ℝ)⁻¹ * (∑ k : Fin D, Real.cos (x k))
          ≤ (D : ℝ)⁻¹ * ((((D - 1 : ℕ) : ℝ) + Real.cos δ)) :=
      mul_le_mul_of_nonneg_left hsumUpper hInvNonneg
    simpa [coordinateSimpleWalkSymbol, simpleWalkSymbol, ρ, div_eq_mul_inv,
      mul_comm, mul_left_comm, mul_assoc] using hmul
  have hlowerAvg : -ρ ≤ coordinateSimpleWalkSymbol D x := by
    -- Proof comment: divide the lower sum estimate by the same positive factor.
    have hInvNonneg : 0 ≤ (D : ℝ)⁻¹ := by positivity
    have hmul :
        (D : ℝ)⁻¹ * (-((((D - 1 : ℕ) : ℝ) + Real.cos δ)))
          ≤ (D : ℝ)⁻¹ * (∑ k : Fin D, Real.cos (x k)) :=
      mul_le_mul_of_nonneg_left hsumLower hInvNonneg
    simpa [coordinateSimpleWalkSymbol, simpleWalkSymbol, ρ, div_eq_mul_inv,
      mul_add, mul_comm, mul_left_comm, mul_assoc] using hmul
  exact abs_le.mpr ⟨hlowerAvg, hupperAvg⟩

/-- Helper for Exercise 17.5.1: the Euclidean cube integral rewrites to the coordinate cube
integral without changing the simple-walk symbol. -/
private lemma symbolIntegral_eq_coordinateIntegral
    {D n : ℕ} [NeZero D] :
    ∫ t in latticeFrequencyCube D, simpleWalkSymbol D t ^ (2 * n) ∂volume =
      ∫ x in coordinateFrequencyCube D, coordinateSimpleWalkSymbol D x ^ (2 * n) ∂volume := by
  -- Proof comment: this is exactly the owner-level cube transport from Theorem 15.10 specialized
  -- to the real simple-walk symbol.
  simpa [coordinateFrequencyCube, coordinateSimpleWalkSymbol] using
    (coordinateIcoIntegralEqLatticeFrequencyCubeIntegral
      (d := D)
      (G := fun t : EuclideanSpace ℝ (Fin D) ↦ simpleWalkSymbol D t ^ (2 * n))).symm

/-- Helper for Exercise 17.5.1: on the coordinate cube, the `2n`-th power of the symbol splits
into the two peak charts and the compact wrapped remainder. -/
private lemma simpleWalkSymbol_wrappedBoundarySplit
    {D : ℕ} [NeZero D] {δ : ℝ}
    (hδpi : 2 * δ < Real.pi) (n : ℕ) :
    ∫ x in coordinateFrequencyCube D, coordinateSimpleWalkSymbol D x ^ (2 * n) ∂volume =
      2 * ∫ x in zeroPeakBox D δ, coordinateSimpleWalkSymbol D x ^ (2 * n) ∂volume +
        ∫ x in wrappedRemainderBox D δ, coordinateSimpleWalkSymbol D x ^ (2 * n) ∂volume := by
  -- Route correction: the peak split is now stated entirely on the coordinate cube, so the main
  -- theorem no longer mixes `WithLp` transport with the two-peak geometry.
  let f : (Fin D → ℝ) → ℝ := fun x ↦ coordinateSimpleWalkSymbol D x ^ (2 * n)
  let splitSet : Set (Fin D → ℝ) :=
    zeroPeakBox D δ ∪ ((wrappedPeakBox D δ ∩ coordinateFrequencyCube D) ∪ wrappedRemainderBox D δ)
  have hZeroMeas : MeasurableSet (zeroPeakBox D δ) := by
    rw [zeroPeakBox_eq_piIcc]
    exact measurableSet_Icc
  have hCubeMeas : MeasurableSet (coordinateFrequencyCube D) :=
    measurableSet_coordinateFrequencyCube D
  have hWrappedMeas : MeasurableSet (wrappedPeakBox D δ) :=
    measurableSet_wrappedPeakBox D δ
  have hWrappedCubeMeas : MeasurableSet (wrappedPeakBox D δ ∩ coordinateFrequencyCube D) :=
    hWrappedMeas.inter hCubeMeas
  have hRemainderMeas : MeasurableSet (wrappedRemainderBox D δ) := by
    simpa [wrappedRemainderBox] using hCubeMeas.diff (hZeroMeas.union hWrappedMeas)
  have hZeroSubsetCube : zeroPeakBox D δ ⊆ coordinateFrequencyCube D :=
    zeroPeakBox_subset_coordinateFrequencyCube (hδpi := hδpi)
  have hZeroInt : IntegrableOn f (zeroPeakBox D δ) volume := by
    refine integrableOn_coordinateSimpleWalkSymbol_pow_of_subset_closedCube
      (D := D) (n := n) ?_
    exact Set.Subset.trans hZeroSubsetCube
      (coordinateFrequencyCube_subset_closedCoordinateFrequencyCube D)
  have hWrappedCubeInt :
      IntegrableOn f (wrappedPeakBox D δ ∩ coordinateFrequencyCube D) volume := by
    refine integrableOn_coordinateSimpleWalkSymbol_pow_of_subset_closedCube
      (D := D) (n := n) ?_
    intro x hx
    exact coordinateFrequencyCube_subset_closedCoordinateFrequencyCube D hx.2
  have hRemainderInt : IntegrableOn f (wrappedRemainderBox D δ) volume := by
    refine integrableOn_coordinateSimpleWalkSymbol_pow_of_subset_closedCube
      (D := D) (n := n) ?_
    intro x hx
    exact coordinateFrequencyCube_subset_closedCoordinateFrequencyCube D hx.1
  have hRestInt :
      IntegrableOn f ((wrappedPeakBox D δ ∩ coordinateFrequencyCube D) ∪ wrappedRemainderBox D δ)
        volume := by
    refine integrableOn_coordinateSimpleWalkSymbol_pow_of_subset_closedCube
      (D := D) (n := n) ?_
    intro x hx
    rcases hx with hxWrap | hxRem
    · exact coordinateFrequencyCube_subset_closedCoordinateFrequencyCube D hxWrap.2
    · exact coordinateFrequencyCube_subset_closedCoordinateFrequencyCube D hxRem.1
  have hZeroWrap :
      Disjoint (zeroPeakBox D δ) (wrappedPeakBox D δ ∩ coordinateFrequencyCube D) :=
    (zeroPeakBox_disjoint_wrappedPeakBox (D := D) (hδpi := hδpi)).mono_right
      (by intro x hx; exact hx.1)
  have hZeroRemainder : Disjoint (zeroPeakBox D δ) (wrappedRemainderBox D δ) := by
    rw [Set.disjoint_left]
    intro x hxZero hxRem
    exact hxRem.2 (Or.inl hxZero)
  have hWrapRemainder : Disjoint (wrappedPeakBox D δ ∩ coordinateFrequencyCube D)
      (wrappedRemainderBox D δ) := by
    rw [Set.disjoint_left]
    intro x hxWrap hxRem
    exact hxRem.2 (Or.inr hxWrap.1)
  have hZeroRest :
      Disjoint (zeroPeakBox D δ)
        ((wrappedPeakBox D δ ∩ coordinateFrequencyCube D) ∪ wrappedRemainderBox D δ) := by
    have hZeroWrap' : ∀ ⦃x : Fin D → ℝ⦄,
        x ∈ zeroPeakBox D δ →
          x ∈ wrappedPeakBox D δ ∩ coordinateFrequencyCube D → False := by
      rw [Set.disjoint_left] at hZeroWrap
      exact hZeroWrap
    have hZeroRemainder' : ∀ ⦃x : Fin D → ℝ⦄,
        x ∈ zeroPeakBox D δ → x ∈ wrappedRemainderBox D δ → False := by
      rw [Set.disjoint_left] at hZeroRemainder
      exact hZeroRemainder
    rw [Set.disjoint_left]
    intro x hxZero hxRest
    rcases hxRest with hxWrap | hxRem
    · exact hZeroWrap' hxZero hxWrap
    · exact hZeroRemainder' hxZero hxRem
  have hPartition :
      coordinateFrequencyCube D = splitSet := by
    ext x
    constructor
    · intro hxCube
      by_cases hxZero : x ∈ zeroPeakBox D δ
      · exact Or.inl hxZero
      · by_cases hxWrap : x ∈ wrappedPeakBox D δ
        · exact Or.inr (Or.inl ⟨hxWrap, hxCube⟩)
        · exact Or.inr (Or.inr ⟨hxCube, by simp [hxZero, hxWrap]⟩)
    · intro hx
      rcases hx with hxZero | hxRest
      · exact hZeroSubsetCube hxZero
      · rcases hxRest with hxWrap | hxRem
        · exact hxWrap.2
        · exact hxRem.1
  have hWrappedCubeIntegral :
      ∫ x in wrappedPeakBox D δ ∩ coordinateFrequencyCube D, f x ∂volume =
        ∫ x in wrappedPeakBox D δ, f x ∂volume := by
    exact MeasureTheory.setIntegral_congr_set
      (μ := volume) (f := f)
      (wrappedPeakBox_ae_eq_wrappedPeakBox_inter_coordinateFrequencyCube
        (D := D) (δ := δ) hδpi).symm
  have hWrappedToZero :
      ∫ x in wrappedPeakBox D δ, f x ∂volume =
        ∫ x in zeroPeakBox D δ, f x ∂volume := by
    simpa [f] using
      (wrappedPeakBoxIntegral_eq_zeroPeakBoxIntegral
        (D := D) (n := n) (δ := δ) hδpi)
  have hCubeToPartition :
      ∫ x in coordinateFrequencyCube D, coordinateSimpleWalkSymbol D x ^ (2 * n) ∂volume =
        ∫ x in splitSet, coordinateSimpleWalkSymbol D x ^ (2 * n) ∂volume := by
    rw [hPartition]
  calc
    ∫ x in coordinateFrequencyCube D, coordinateSimpleWalkSymbol D x ^ (2 * n) ∂volume
        = ∫ x in splitSet, coordinateSimpleWalkSymbol D x ^ (2 * n) ∂volume := hCubeToPartition
    _ = ∫ x in splitSet, f x ∂volume := by
          rfl
    _ = ∫ x in zeroPeakBox D δ, f x ∂volume +
          ∫ x in ((wrappedPeakBox D δ ∩ coordinateFrequencyCube D) ∪ wrappedRemainderBox D δ),
            f x ∂volume := by
          dsimp [splitSet]
          exact MeasureTheory.setIntegral_union hZeroRest (hWrappedCubeMeas.union hRemainderMeas)
            hZeroInt
            hRestInt
    _ = ∫ x in zeroPeakBox D δ, f x ∂volume +
          (∫ x in wrappedPeakBox D δ ∩ coordinateFrequencyCube D, f x ∂volume +
            ∫ x in wrappedRemainderBox D δ, f x ∂volume) := by
            congr 1
            exact MeasureTheory.setIntegral_union hWrapRemainder hRemainderMeas
              hWrappedCubeInt
              hRemainderInt
    _ = ∫ x in zeroPeakBox D δ, f x ∂volume +
          (∫ x in zeroPeakBox D δ, f x ∂volume +
            ∫ x in wrappedRemainderBox D δ, f x ∂volume) := by
            rw [hWrappedCubeIntegral, hWrappedToZero]
    _ = 2 * ∫ x in zeroPeakBox D δ, coordinateSimpleWalkSymbol D x ^ (2 * n) ∂volume +
          ∫ x in wrappedRemainderBox D δ, coordinateSimpleWalkSymbol D x ^ (2 * n) ∂volume := by
            simp [f]
            ring

/-- Helper for Exercise 17.5.1: after scaling by `n^(D/2)`, the wrapped remainder contribution
vanishes because the symbol is uniformly strictly smaller than `1` there. -/
private lemma simpleWalkSymbol_wrappedRemainder_tendsto_zero
    {D : ℕ} [NeZero D] {δ : ℝ}
    (hδ : 0 < δ) (hδpi : 2 * δ < Real.pi) :
    Tendsto
      (fun n : Nat =>
        (n : ℝ) ^ ((D : ℝ) / 2) *
          (((2 * Real.pi) ^ D)⁻¹ *
            ∫ x in wrappedRemainderBox D δ, coordinateSimpleWalkSymbol D x ^ (2 * n) ∂volume))
      atTop
      (nhds 0) := by
  rcases coordinateSimpleWalkSymbol_abs_le_rho_of_mem_wrappedRemainder
      (D := D) hδ hδpi with
    ⟨ρ, hρpos, hρlt, hρbound⟩
  have hCubeVol : volume (coordinateFrequencyCube D) = ENNReal.ofReal ((2 * Real.pi : ℝ) ^ D) := by
    -- Proof comment: the coordinate cube volume is the same `(2π)^D` normalization constant as
    -- in the Euclidean Fourier formula.
    simpa using volume_coordinateFrequencyCube D
  have hCubeFinite : volume (coordinateFrequencyCube D) < ⊤ := by
    rw [hCubeVol]
    exact ENNReal.ofReal_lt_top
  have hRemainderFinite : volume (wrappedRemainderBox D δ) < ⊤ := by
    -- Proof comment: the remainder sits inside the frequency cube, so it inherits finite volume.
    exact lt_of_le_of_lt (measure_mono fun _ hx ↦ hx.1) hCubeFinite
  have hCubeReal : volume.real (coordinateFrequencyCube D) = (2 * Real.pi : ℝ) ^ D := by
    rw [Measure.real, hCubeVol]
    rw [ENNReal.toReal_ofReal]
    positivity
  have hDecay :
      Tendsto (fun n : ℕ => (n : ℝ) ^ ((D : ℝ) / 2) * (ρ ^ 2) ^ n) atTop (nhds 0) := by
    let b : ℝ := -Real.log (ρ ^ 2)
    have hb : 0 < b := by
      have hρsqPos : 0 < ρ ^ 2 := by positivity
      have hρsqLt : ρ ^ 2 < 1 := by nlinarith
      have hlogNeg : Real.log (ρ ^ 2) < 0 := Real.log_neg hρsqPos hρsqLt
      simpa [b] using neg_pos.mpr hlogNeg
    have hExp :=
      (tendsto_rpow_mul_exp_neg_mul_atTop_nhds_zero ((D : ℝ) / 2) b hb).comp
        tendsto_natCast_atTop_atTop
    refine hExp.congr' ?_
    filter_upwards with n
    calc
      (n : ℝ) ^ ((D : ℝ) / 2) * Real.exp (-b * (n : ℝ))
          = (n : ℝ) ^ ((D : ℝ) / 2) * (ρ ^ 2) ^ n := by
              congr 1
              calc
                Real.exp (-b * (n : ℝ))
                    = Real.exp ((n : ℝ) * Real.log (ρ ^ 2)) := by
                        congr 1
                        ring
                _ = Real.exp (Real.log (ρ ^ 2) * (n : ℝ)) := by rw [mul_comm]
                _ = (ρ ^ 2) ^ (n : ℝ) := by
                      rw [Real.rpow_def_of_pos (by positivity)]
                _ = (ρ ^ 2) ^ n := by
                      rw [Real.rpow_natCast]
      _ = (n : ℝ) ^ ((D : ℝ) / 2) * (ρ ^ 2) ^ n := by rfl
  refine squeeze_zero_norm ?_ hDecay
  intro n
  have hNormBound :
      ‖∫ x in wrappedRemainderBox D δ, coordinateSimpleWalkSymbol D x ^ (2 * n) ∂volume‖
        ≤ (ρ ^ (2 * n)) * volume.real (wrappedRemainderBox D δ) := by
    -- Proof comment: the explicit `ρ < 1` estimate bounds the restricted integral by a constant
    -- times the real volume of the remainder box.
    refine MeasureTheory.norm_setIntegral_le_of_norm_le_const hRemainderFinite ?_
    intro x hx
    calc
      ‖coordinateSimpleWalkSymbol D x ^ (2 * n)‖
          = |coordinateSimpleWalkSymbol D x| ^ (2 * n) := by
              simp [Real.norm_eq_abs]
      _ ≤ ρ ^ (2 * n) := by
            exact pow_le_pow_left₀ (abs_nonneg _) (hρbound x hx) _
  have hNormalized :
      ‖((2 * Real.pi) ^ D)⁻¹ *
          ∫ x in wrappedRemainderBox D δ, coordinateSimpleWalkSymbol D x ^ (2 * n) ∂volume‖
        ≤ ρ ^ (2 * n) := by
    have hConstNonneg : 0 ≤ ((2 * Real.pi : ℝ) ^ D)⁻¹ := by positivity
    have hMeasureMono :
        volume.real (wrappedRemainderBox D δ) ≤ volume.real (coordinateFrequencyCube D) := by
      exact measureReal_mono (fun _ hx ↦ hx.1) hCubeFinite.ne
    calc
      ‖((2 * Real.pi) ^ D)⁻¹ *
          ∫ x in wrappedRemainderBox D δ, coordinateSimpleWalkSymbol D x ^ (2 * n) ∂volume‖
          = ((2 * Real.pi : ℝ) ^ D)⁻¹ *
              ‖∫ x in wrappedRemainderBox D δ, coordinateSimpleWalkSymbol D x ^ (2 * n)
                ∂volume‖ := by
                  rw [norm_mul, Real.norm_of_nonneg hConstNonneg]
      _ ≤ ((2 * Real.pi : ℝ) ^ D)⁻¹ *
            ((ρ ^ (2 * n)) * volume.real (wrappedRemainderBox D δ)) := by
            gcongr
      _ ≤ ((2 * Real.pi : ℝ) ^ D)⁻¹ *
            ((ρ ^ (2 * n)) * volume.real (coordinateFrequencyCube D)) := by
            gcongr
      _ = ρ ^ (2 * n) := by
            rw [hCubeReal]
            field_simp [show ((2 * Real.pi : ℝ) ^ D) ≠ 0 by positivity]
  have hNonneg : 0 ≤ (n : ℝ) ^ ((D : ℝ) / 2) := by
    exact Real.rpow_nonneg (Nat.cast_nonneg n) _
  calc
    ‖(n : ℝ) ^ ((D : ℝ) / 2) *
        (((2 * Real.pi) ^ D)⁻¹ *
          ∫ x in wrappedRemainderBox D δ, coordinateSimpleWalkSymbol D x ^ (2 * n) ∂volume)‖
      = (n : ℝ) ^ ((D : ℝ) / 2) *
          ‖((2 * Real.pi) ^ D)⁻¹ *
            ∫ x in wrappedRemainderBox D δ, coordinateSimpleWalkSymbol D x ^ (2 * n) ∂volume‖ := by
              rw [norm_mul, Real.norm_of_nonneg hNonneg]
    _ ≤ (n : ℝ) ^ ((D : ℝ) / 2) * (ρ ^ (2 * n)) := by
          gcongr
    _ = (n : ℝ) ^ ((D : ℝ) / 2) * (ρ ^ 2) ^ n := by
          rw [pow_mul]

/-- Helper for Exercise 17.5.1: the rescaled zero-peak integrand on the whole coordinate space. -/
private def rescaledZeroPeakIntegrand (D n : ℕ) (δ : ℝ) (u : Fin D → ℝ) : ℝ :=
  Set.indicator ((Real.sqrt n) • zeroPeakBox D δ)
    (fun v ↦ coordinateSimpleWalkSymbol D ((Real.sqrt n)⁻¹ • v) ^ (2 * n)) u

/-- Helper for Exercise 17.5.1: the zero-peak box is measurable. -/
private lemma measurableSet_zeroPeakBox (D : ℕ) (δ : ℝ) :
    MeasurableSet (zeroPeakBox D δ) := by
  -- Proof comment: the zero-peak box is the finite coordinate cube `[-δ, δ]^D`.
  rw [zeroPeakBox_eq_piIcc]
  exact measurableSet_Icc

/-- Helper for Exercise 17.5.1: the rescaling `u = √n • x` rewrites the small-box contribution as
an integral of the rescaled indicator integrand. -/
private lemma zeroPeakScaledIndicatorIntegral_eq
    {D n : ℕ} [NeZero D] {δ : ℝ} (hn : 1 ≤ n) :
    (n : ℝ) ^ ((D : ℝ) / 2) *
        (((2 * Real.pi) ^ D)⁻¹ *
          ∫ x in zeroPeakBox D δ, coordinateSimpleWalkSymbol D x ^ (2 * n) ∂volume) =
      ((2 * Real.pi) ^ D)⁻¹ *
        ∫ u, rescaledZeroPeakIntegrand D n δ u ∂volume := by
  have hsqrt_pos : 0 < Real.sqrt n := by
    exact Real.sqrt_pos.2 (Nat.cast_pos.2 (Nat.succ_le_iff.mp hn))
  have hsqrt_nonneg : 0 ≤ Real.sqrt n := hsqrt_pos.le
  have hsqrt_ne : (Real.sqrt n : ℝ) ≠ 0 := hsqrt_pos.ne'
  let f : (Fin D → ℝ) → ℝ :=
    fun x ↦ coordinateSimpleWalkSymbol D x ^ (2 * n)
  let g : (Fin D → ℝ) → ℝ := fun u ↦ f ((Real.sqrt n)⁻¹ • u)
  have hset0 :
      ∫ x in zeroPeakBox D δ, f x ∂volume =
        ((Real.sqrt n) ^ D)⁻¹ *
          ∫ u in (Real.sqrt n) • zeroPeakBox D δ, f ((Real.sqrt n)⁻¹ • u) ∂volume := by
    -- Proof comment: apply the set-integral scaling formula to the rescaled integrand `g`.
    simpa [f, g, hsqrt_ne, smul_smul] using
      (Measure.setIntegral_comp_smul_of_pos
        (μ := (volume : Measure (Fin D → ℝ)))
        (f := g) (s := zeroPeakBox D δ) (hR := hsqrt_pos))
  have hset :
      ∫ u in (Real.sqrt n) • zeroPeakBox D δ, f ((Real.sqrt n)⁻¹ • u) ∂volume =
        (Real.sqrt n) ^ D * ∫ x in zeroPeakBox D δ, f x ∂volume := by
    have hc : ((Real.sqrt n) ^ D : ℝ) ≠ 0 := by positivity
    calc
      ∫ u in (Real.sqrt n) • zeroPeakBox D δ, f ((Real.sqrt n)⁻¹ • u) ∂volume
          = (Real.sqrt n) ^ D *
              (((Real.sqrt n) ^ D)⁻¹ *
                ∫ u in (Real.sqrt n) • zeroPeakBox D δ, f ((Real.sqrt n)⁻¹ • u) ∂volume) := by
                  field_simp [hc]
      _ = (Real.sqrt n) ^ D * ∫ x in zeroPeakBox D δ, f x ∂volume := by
            rw [← hset0]
  have hpow :
      (Real.sqrt n) ^ D = (n : ℝ) ^ ((D : ℝ) / 2) := by
    rw [← Real.rpow_natCast]
    calc
      (Real.sqrt n) ^ (D : ℝ)
          = (Real.sqrt n) ^ ((2 : ℝ) * ((D : ℝ) / 2)) := by
              congr 2
              ring
      _ = ((Real.sqrt n) ^ (2 : ℕ)) ^ ((D : ℝ) / 2) := by
            simpa using (Real.rpow_natCast_mul hsqrt_nonneg 2 ((D : ℝ) / 2))
      _ = (n : ℝ) ^ ((D : ℝ) / 2) := by
            simp [Real.sq_sqrt (Nat.cast_nonneg n)]
  have hindicator :
      ∫ u, rescaledZeroPeakIntegrand D n δ u ∂volume =
        ∫ u in (Real.sqrt n) • zeroPeakBox D δ,
          coordinateSimpleWalkSymbol D ((Real.sqrt n)⁻¹ • u) ^ (2 * n) ∂volume := by
    -- Proof comment: rewrite the whole-space integral of the indicator as the set integral.
    simpa [rescaledZeroPeakIntegrand] using
      (integral_indicator
        (μ := (volume : Measure (Fin D → ℝ)))
        (f := fun v : Fin D → ℝ ↦
          coordinateSimpleWalkSymbol D ((Real.sqrt n)⁻¹ • v) ^ (2 * n))
        (((measurableSet_zeroPeakBox D δ).const_smul_of_ne_zero hsqrt_ne)))
  calc
    (n : ℝ) ^ ((D : ℝ) / 2) *
        (((2 * Real.pi) ^ D)⁻¹ *
          ∫ x in zeroPeakBox D δ, coordinateSimpleWalkSymbol D x ^ (2 * n) ∂volume)
      = ((2 * Real.pi) ^ D)⁻¹ *
          ((Real.sqrt n) ^ D *
            ∫ x in zeroPeakBox D δ, coordinateSimpleWalkSymbol D x ^ (2 * n) ∂volume) := by
            rw [hpow]
            ring
    _ = ((2 * Real.pi) ^ D)⁻¹ *
          ∫ u in (Real.sqrt n) • zeroPeakBox D δ,
            coordinateSimpleWalkSymbol D ((Real.sqrt n)⁻¹ • u) ^ (2 * n) ∂volume := by
            simpa [smul_eq_mul] using congrArg (((2 * Real.pi) ^ D)⁻¹ * ·) hset.symm
    _ = ((2 * Real.pi) ^ D)⁻¹ * ∫ u, rescaledZeroPeakIntegrand D n δ u ∂volume := by
            rw [hindicator]

/-- Helper for Exercise 17.5.1: the quadratic cosine defect is exactly the square of the sinc
profile. -/
private lemma two_mul_cos_sub_one_eq_neg_sq_mul_sinc_sq
    (x : ℝ) :
    2 * (Real.cos x - 1) = -(x ^ (2 : ℕ) * (Real.sinc (x / 2)) ^ (2 : ℕ)) := by
  -- Proof comment: rewrite `1 - cos x` through the half-angle identity and then package the
  -- quotient with `Real.sinc`.
  by_cases hx : x = 0
  · simp [hx]
  have hx2 : x / 2 ≠ 0 := by
    exact div_ne_zero hx two_ne_zero
  have hsin :
      Real.sin (x / 2) ^ (2 : ℕ) = (1 - Real.cos x) / 2 := by
    have hsin' : Real.sin (x / 2) ^ (2 : ℕ) = 1 / 2 - Real.cos x / 2 := by
      simpa [two_mul] using (Real.sin_sq_eq_half_sub (x / 2))
    linarith
  calc
    2 * (Real.cos x - 1) = -(4 * Real.sin (x / 2) ^ (2 : ℕ)) := by
      rw [hsin]
      ring
    _ = -(x ^ (2 : ℕ) * (Real.sin (x / 2) / (x / 2)) ^ (2 : ℕ)) := by
      field_simp [hx2]
      ring
    _ = -(x ^ (2 : ℕ) * (Real.sinc (x / 2)) ^ (2 : ℕ)) := by
      rw [Real.sinc_of_ne_zero hx2]

/-- Helper for Exercise 17.5.1: after the `√n` rescaling, the coordinate symbol converges
pointwise to its peak value `1`. -/
private lemma coordinateSimpleWalkSymbol_rescaled_tendsto_one
    {D : ℕ} [NeZero D] (u : Fin D → ℝ) :
    Tendsto (fun n : ℕ ↦ coordinateSimpleWalkSymbol D ((Real.sqrt n)⁻¹ • u))
      atTop
      (nhds 1) := by
  have hInvSqrt : Tendsto (fun n : ℕ ↦ (Real.sqrt n : ℝ)⁻¹) atTop (nhds 0) := by
    simpa [one_div] using
      (tendsto_inv_atTop_zero.comp
        (Real.tendsto_sqrt_atTop.comp tendsto_natCast_atTop_atTop))
  have hArg :
      Tendsto (fun n : ℕ ↦ ((Real.sqrt n)⁻¹ : ℝ) • u) atTop (nhds (0 : Fin D → ℝ)) := by
    rw [tendsto_pi_nhds]
    intro i
    simpa [Pi.smul_apply, mul_comm] using (hInvSqrt.const_mul (u i))
  have hZero : coordinateSimpleWalkSymbol D (0 : Fin D → ℝ) = 1 := by
    simp [coordinateSimpleWalkSymbol, simpleWalkSymbol]
  -- Proof comment: the rescaled argument tends to the origin coordinatewise, and the symbol is
  -- continuous there.
  simpa [hZero] using
    ((continuous_coordinateSimpleWalkSymbol D).continuousAt.tendsto.comp hArg)

/-- Helper for Exercise 17.5.1: the first-order logarithmic exponent of the rescaled coordinate
symbol converges to the Gaussian quadratic form. -/
private lemma coordinateSimpleWalkSymbol_rescaledLinearTerm_tendsto
    {D : ℕ} [NeZero D] (u : Fin D → ℝ) :
    Tendsto
      (fun n : ℕ ↦
        (2 * n : ℝ) * (coordinateSimpleWalkSymbol D ((Real.sqrt n)⁻¹ • u) - 1))
      atTop
      (nhds (-((∑ i : Fin D, u i ^ (2 : ℕ)) / D))) := by
  have hInvSqrt : Tendsto (fun n : ℕ ↦ (Real.sqrt n : ℝ)⁻¹) atTop (nhds 0) := by
    simpa [one_div] using
      (tendsto_inv_atTop_zero.comp
        (Real.tendsto_sqrt_atTop.comp tendsto_natCast_atTop_atTop))
  have hCoord :
      ∀ i : Fin D,
        Tendsto
          (fun n : ℕ ↦
            (2 * n : ℝ) * (Real.cos (((Real.sqrt n)⁻¹ : ℝ) * u i) - 1))
          atTop
          (nhds (-(u i ^ (2 : ℕ)))) := by
    intro i
    let g : ℕ → ℝ :=
      fun n ↦ (Real.sinc ((((Real.sqrt n)⁻¹ : ℝ) * u i) / 2)) ^ (2 : ℕ)
    have hg : Tendsto g atTop (nhds 1) := by
      have hz :
          Tendsto
            (fun n : ℕ ↦ ((((Real.sqrt n)⁻¹ : ℝ) * u i) / 2))
            atTop
            (nhds 0) := by
        have hmul : Tendsto
            (fun n : ℕ ↦ (((Real.sqrt n)⁻¹ : ℝ) * u i))
            atTop
            (nhds 0) := by
          simpa [mul_comm] using (hInvSqrt.const_mul (u i))
        simpa [div_eq_mul_inv, mul_assoc, mul_comm, mul_left_comm] using
          (hmul.const_mul ((2 : ℝ)⁻¹))
      simpa [g] using
        ((((Real.continuous_sinc.continuousAt).pow 2).tendsto.comp hz))
    have hEq :
        (fun n : ℕ ↦
          (2 * n : ℝ) * (Real.cos (((Real.sqrt n)⁻¹ : ℝ) * u i) - 1)) =ᶠ[atTop]
          fun n ↦ -(u i ^ (2 : ℕ)) * g n := by
      filter_upwards [eventually_ge_atTop 1] with n hn
      have hn0 : (n : ℝ) ≠ 0 := by
        exact_mod_cast (Nat.succ_le_iff.mp hn).ne'
      have hnpos : 0 < (n : ℝ) := by
        exact Nat.cast_pos.mpr (Nat.succ_le_iff.mp hn)
      have hsqrt_ne : (Real.sqrt n : ℝ) ≠ 0 := by
        exact Real.sqrt_ne_zero'.2 hnpos
      have hsq :
          (n : ℝ) * ((((Real.sqrt n)⁻¹ : ℝ) * u i) ^ (2 : ℕ)) = u i ^ (2 : ℕ) := by
        field_simp [pow_two, hsqrt_ne]
        rw [Real.sq_sqrt (Nat.cast_nonneg n)]
      calc
        (2 * n : ℝ) * (Real.cos (((Real.sqrt n)⁻¹ : ℝ) * u i) - 1)
            = (n : ℝ) * (2 * (Real.cos (((Real.sqrt n)⁻¹ : ℝ) * u i) - 1)) := by
                ring
        _ = (n : ℝ) *
              (-
                ((((Real.sqrt n)⁻¹ : ℝ) * u i) ^ (2 : ℕ) *
                  (Real.sinc ((((Real.sqrt n)⁻¹ : ℝ) * u i) / 2)) ^ (2 : ℕ))) := by
                rw [two_mul_cos_sub_one_eq_neg_sq_mul_sinc_sq]
        _ = -((n : ℝ) * ((((Real.sqrt n)⁻¹ : ℝ) * u i) ^ (2 : ℕ))) * g n := by
              simp [g, mul_assoc]
        _ = -(u i ^ (2 : ℕ)) * g n := by
              rw [hsq]
    -- Proof comment: the sinc factor tends to `1`, so the scaled cosine defect tends to `-u_i^2`.
    have hLimit :
        Tendsto (fun n : ℕ ↦ -(u i ^ (2 : ℕ)) * g n) atTop (nhds (-(u i ^ (2 : ℕ)))) := by
      simpa using (hg.const_mul (-(u i ^ (2 : ℕ))))
    exact hLimit.congr' hEq.symm
  have hD0 : (D : ℝ) ≠ 0 := by
    exact_mod_cast (NeZero.ne D)
  have hRewrite :
      (fun n : ℕ ↦
        (2 * n : ℝ) * (coordinateSimpleWalkSymbol D ((Real.sqrt n)⁻¹ • u) - 1)) =
        fun n : ℕ ↦
          (D : ℝ)⁻¹ *
            ∑ i : Fin D, (2 * n : ℝ) * (Real.cos (((Real.sqrt n)⁻¹ : ℝ) * u i) - 1) := by
    funext n
    calc
      (2 * n : ℝ) * (coordinateSimpleWalkSymbol D ((Real.sqrt n)⁻¹ • u) - 1)
          = (2 * n : ℝ) *
              ((D : ℝ)⁻¹ * ∑ i : Fin D, Real.cos (((Real.sqrt n)⁻¹ : ℝ) * u i) - 1) := by
                simp [coordinateSimpleWalkSymbol, simpleWalkSymbol, Pi.smul_apply]
      _ = (D : ℝ)⁻¹ *
            ((2 * n : ℝ) * ∑ i : Fin D, Real.cos (((Real.sqrt n)⁻¹ : ℝ) * u i) -
              (2 * n : ℝ) * D) := by
              field_simp [hD0]
      _ = (D : ℝ)⁻¹ *
            ((2 * n : ℝ) * ∑ i : Fin D, Real.cos (((Real.sqrt n)⁻¹ : ℝ) * u i) -
              ∑ _i : Fin D, (2 * n : ℝ)) := by
              congr 1
              simp [Finset.sum_const, Fintype.card_fin]
              ring
      _ = (D : ℝ)⁻¹ *
            ∑ i : Fin D, ((2 * n : ℝ) * Real.cos (((Real.sqrt n)⁻¹ : ℝ) * u i) - (2 * n : ℝ)) := by
              congr 1
              rw [Finset.mul_sum, ← Finset.sum_sub_distrib]
      _ = (D : ℝ)⁻¹ *
            ∑ i : Fin D, (2 * n : ℝ) * (Real.cos (((Real.sqrt n)⁻¹ : ℝ) * u i) - 1) := by
              refine congrArg ((D : ℝ)⁻¹ * ·) ?_
              refine Finset.sum_congr rfl ?_
              intro i hi
              ring
  have hSum :
      Tendsto
        (fun n : ℕ ↦
          (D : ℝ)⁻¹ *
            ∑ i : Fin D, (2 * n : ℝ) * (Real.cos (((Real.sqrt n)⁻¹ : ℝ) * u i) - 1))
        atTop
        (nhds ((D : ℝ)⁻¹ * ∑ i : Fin D, -(u i ^ (2 : ℕ)))) := by
    exact
      (tendsto_finset_sum Finset.univ fun i _ ↦ hCoord i).const_mul ((D : ℝ)⁻¹)
  have hTarget :
      (D : ℝ)⁻¹ * ∑ i : Fin D, -(u i ^ (2 : ℕ)) =
        -((D : ℝ)⁻¹ * ∑ i : Fin D, u i ^ (2 : ℕ)) := by
    have hsumneg :
        ∑ i : Fin D, -(u i ^ (2 : ℕ)) = -∑ i : Fin D, u i ^ (2 : ℕ) := by
      rw [Finset.sum_neg_distrib]
    rw [hsumneg]
    ring
  -- Proof comment: after expanding the coordinate average, the limit is the average of the
  -- coordinatewise quadratic defects.
  rw [hRewrite]
  simpa [div_eq_mul_inv, hTarget, mul_comm, mul_left_comm, mul_assoc] using hSum

/-- Helper for Exercise 17.5.1: every fixed vector eventually lies inside the expanding scaled
zero-peak box. -/
private lemma eventually_mem_scaledZeroPeakBox
    {D : ℕ} {δ : ℝ} (hδ : 0 < δ) (u : Fin D → ℝ) :
    ∀ᶠ n : ℕ in atTop, u ∈ (Real.sqrt n) • zeroPeakBox D δ := by
  let M : ℝ := ∑ i : Fin D, |u i|
  have hM : ∀ i : Fin D, |u i| ≤ M := by
    intro i
    dsimp [M]
    simpa using
      (Finset.single_le_sum (fun j _ ↦ abs_nonneg (u j)) (by simp : i ∈ Finset.univ))
  have hsqrt :
      Tendsto (fun n : ℕ ↦ δ * Real.sqrt n) atTop atTop := by
    exact Tendsto.const_mul_atTop hδ
      (Real.tendsto_sqrt_atTop.comp tendsto_natCast_atTop_atTop)
  have hEvent : ∀ᶠ n : ℕ in atTop, M ≤ δ * Real.sqrt n := by
    exact (tendsto_atTop.1 hsqrt) M
  filter_upwards [eventually_ge_atTop 1, hEvent] with n hn hnM
  have hsqrt_pos : 0 < (Real.sqrt n : ℝ) := by
    exact Real.sqrt_pos.2 (Nat.cast_pos.2 (Nat.succ_le_iff.mp hn))
  refine ⟨(Real.sqrt n)⁻¹ • u, ?_, ?_⟩
  · intro i
    have hcoord : |u i| ≤ δ * Real.sqrt n := le_trans (hM i) hnM
    change |((Real.sqrt n)⁻¹ : ℝ) * u i| ≤ δ
    rw [abs_mul, abs_inv, abs_of_pos hsqrt_pos]
    simpa [div_eq_mul_inv, mul_comm, mul_left_comm, mul_assoc] using
      ((div_le_iff₀ hsqrt_pos).2 hcoord : |u i| / Real.sqrt n ≤ δ)
  · ext i
    simp [Pi.smul_apply, hsqrt_pos.ne']

/-- Helper for Exercise 17.5.1: the square-normalized exponent has the Gaussian limit compatible
with `Real.tendsto_one_add_pow_exp_of_tendsto`. -/
private lemma coordinateSimpleWalkSymbol_rescaledSquareTerm_tendsto
    {D : ℕ} [NeZero D] (u : Fin D → ℝ) :
    Tendsto
      (fun n : ℕ ↦
        (n : ℝ) * (coordinateSimpleWalkSymbol D ((Real.sqrt n)⁻¹ • u) ^ 2 - 1))
      atTop
      (nhds (-((∑ i : Fin D, u i ^ (2 : ℕ)) / D))) := by
  let a : ℕ → ℝ := fun n ↦ coordinateSimpleWalkSymbol D ((Real.sqrt n)⁻¹ • u)
  have hOne : Tendsto a atTop (nhds 1) :=
    coordinateSimpleWalkSymbol_rescaled_tendsto_one (D := D) u
  have hHalf :
      Tendsto (fun n : ℕ ↦ (a n + 1) / 2) atTop (nhds 1) := by
    -- Proof comment: the prefactor `(aₙ + 1) / 2` tends to `1` because `aₙ → 1`.
    have hAdd : Tendsto (fun n : ℕ ↦ a n + 1) atTop (nhds 2) := by
      have hConst : Tendsto (fun _ : ℕ ↦ (1 : ℝ)) atTop (nhds 1) := tendsto_const_nhds
      convert hOne.add hConst using 1
      norm_num
    simpa [div_eq_mul_inv, mul_comm, mul_left_comm, mul_assoc] using
      hAdd.const_mul ((2 : ℝ)⁻¹)
  have hEq :
      (fun n : ℕ ↦ (n : ℝ) * (a n ^ 2 - 1)) =
        fun n : ℕ ↦ ((a n + 1) / 2) * ((2 * n : ℝ) * (a n - 1)) := by
    funext n
    ring
  -- Proof comment: factor `aₙ² - 1` as `(aₙ + 1)(aₙ - 1)` and reuse the already proved linear
  -- limit for `(2n)(aₙ - 1)`.
  rw [hEq]
  simpa using hHalf.mul (coordinateSimpleWalkSymbol_rescaledLinearTerm_tendsto (D := D) u)

/-- Helper for Exercise 17.5.1: the rescaled indicator integrand converges pointwise to the
Gaussian profile on `ℝ^D`. -/
private lemma rescaledZeroPeakIntegrand_tendsto_gaussian
    {D : ℕ} [NeZero D] {δ : ℝ} (hδ : 0 < δ) (u : Fin D → ℝ) :
    Tendsto
      (fun n : ℕ ↦ rescaledZeroPeakIntegrand D n δ u)
      atTop
      (nhds (Real.exp (-((∑ i : Fin D, u i ^ (2 : ℕ)) / D)))) := by
  let a : ℕ → ℝ := fun n ↦ coordinateSimpleWalkSymbol D ((Real.sqrt n)⁻¹ • u)
  have hSupport :
      (fun n : ℕ ↦ rescaledZeroPeakIntegrand D n δ u) =ᶠ[atTop]
        fun n : ℕ ↦ a n ^ (2 * n) := by
    filter_upwards [eventually_mem_scaledZeroPeakBox (D := D) hδ u] with n hn
    -- Proof comment: once `u` is inside the scaled box, the indicator disappears.
    simp [rescaledZeroPeakIntegrand, a, hn]
  have hPow :
      (fun n : ℕ ↦ a n ^ (2 * n)) =
        fun n : ℕ ↦ (1 + (a n ^ 2 - 1)) ^ n := by
    funext n
    calc
      a n ^ (2 * n) = (a n ^ 2) ^ n := by rw [pow_mul]
      _ = (1 + (a n ^ 2 - 1)) ^ n := by
            congr 1
            ring
  have hMain :
      Tendsto
        (fun n : ℕ ↦ a n ^ (2 * n))
        atTop
        (nhds (Real.exp (-((∑ i : Fin D, u i ^ (2 : ℕ)) / D)))) := by
    -- Proof comment: the square-normalized exponent is exactly the input expected by the
    -- standard `exp` limit for `(1 + gₙ)^n`.
    rw [hPow]
    exact Real.tendsto_one_add_pow_exp_of_tendsto
      (coordinateSimpleWalkSymbol_rescaledSquareTerm_tendsto (D := D) u)
  exact hMain.congr' hSupport.symm

/-- Helper for Exercise 17.5.1: the rescaled zero-peak integrand is dominated by an explicit
integrable Gaussian. -/
private lemma rescaledZeroPeakIntegrand_norm_le_expGaussian
    {D : ℕ} [NeZero D] {δ : ℝ} (hδ : 0 < δ) (hδle : δ ≤ 1) {n : ℕ} (hn : 1 ≤ n)
    (u : Fin D → ℝ) :
    ‖rescaledZeroPeakIntegrand D n δ u‖ ≤
      Real.exp (-((2 / (Real.pi ^ 2 * D : ℝ)) * ∑ i : Fin D, u i ^ (2 : ℕ))) := by
  by_cases hu : u ∈ (Real.sqrt n) • zeroPeakBox D δ
  · rcases hu with ⟨x, hx, rfl⟩
    have hsqrt_pos : 0 < (Real.sqrt n : ℝ) := by
      exact Real.sqrt_pos.2 (Nat.cast_pos.2 (Nat.succ_le_iff.mp hn))
    let a : ℝ := coordinateSimpleWalkSymbol D x
    let s : ℝ := (2 / (Real.pi ^ 2 * D : ℝ)) * ∑ i : Fin D, x i ^ (2 : ℕ)
    have hx_one : ∀ i : Fin D, |x i| ≤ 1 := by
      intro i
      exact le_trans (hx i) hδle
    have hcos_nonneg : ∀ i : Fin D, 0 ≤ Real.cos (x i) := by
      intro i
      exact (Real.cos_pos_of_le_one (hx_one i)).le
    have ha_nonneg : 0 ≤ a := by
      -- Proof comment: every cosine term is nonnegative on the small box, so their average is.
      dsimp [a, coordinateSimpleWalkSymbol, simpleWalkSymbol]
      exact mul_nonneg (by positivity) (Finset.sum_nonneg fun i _ ↦ hcos_nonneg i)
    have ha_le_one : a ≤ 1 := by
      have habs := simpleWalkSymbol_abs_le_one (D := D) (t := WithLp.toLp 2 x)
      have habs' : |a| ≤ 1 := by
        simpa [a, coordinateSimpleWalkSymbol] using habs
      simpa [abs_of_nonneg ha_nonneg] using habs'
    have hcos_bound : ∀ i : Fin D, Real.cos (x i) ≤ 1 - (2 / Real.pi ^ 2) * x i ^ (2 : ℕ) := by
      intro i
      have hpi : |x i| ≤ Real.pi := by
        linarith [hx_one i, Real.pi_gt_three]
      simpa using Real.cos_le_one_sub_mul_cos_sq hpi
    have hsum_bound :
        ∑ i : Fin D, Real.cos (x i) ≤
          ∑ i : Fin D, (1 - (2 / Real.pi ^ 2) * x i ^ (2 : ℕ)) := by
      exact Finset.sum_le_sum fun i _ ↦ hcos_bound i
    have hD0 : (D : ℝ) ≠ 0 := by
      exact_mod_cast (NeZero.ne D)
    have hsum_eval :
        ∑ i : Fin D, (1 - (2 / Real.pi ^ 2) * x i ^ (2 : ℕ)) =
          (D : ℝ) - (2 / Real.pi ^ 2) * ∑ i : Fin D, x i ^ (2 : ℕ) := by
      rw [Finset.sum_sub_distrib, Finset.mul_sum]
      simp [Finset.sum_const, Fintype.card_fin, mul_comm]
    have ha_bound : a ≤ 1 - s := by
      -- Proof comment: averaging the coordinatewise cosine inequality gives the explicit
      -- quadratic defect bound for the full symbol.
      calc
        a = (D : ℝ)⁻¹ * ∑ i : Fin D, Real.cos (x i) := by
              rfl
        _ ≤ (D : ℝ)⁻¹ * ∑ i : Fin D, (1 - (2 / Real.pi ^ 2) * x i ^ (2 : ℕ)) := by
              refine mul_le_mul_of_nonneg_left hsum_bound ?_
              positivity
        _ = (D : ℝ)⁻¹ * ((D : ℝ) - (2 / Real.pi ^ 2) * ∑ i : Fin D, x i ^ (2 : ℕ)) := by
              rw [hsum_eval]
        _ = 1 - s := by
              dsimp [s]
              field_simp [hD0]
    have hsum_sq_le : ∑ i : Fin D, x i ^ (2 : ℕ) ≤ (D : ℝ) * δ ^ (2 : ℕ) := by
      calc
        ∑ i : Fin D, x i ^ (2 : ℕ) ≤ ∑ i : Fin D, δ ^ (2 : ℕ) := by
              refine Finset.sum_le_sum fun i _ ↦ ?_
              have hxlo : -δ ≤ x i := (abs_le.mp (hx i)).1
              have hxhi : x i ≤ δ := (abs_le.mp (hx i)).2
              nlinarith
        _ = (D : ℝ) * δ ^ (2 : ℕ) := by
              simp [Finset.sum_const, Fintype.card_fin]
    have hs_le_one : s ≤ 1 := by
      have hs_nonneg : 0 ≤ (2 / (Real.pi ^ 2 * D : ℝ)) := by positivity
      calc
        s ≤ (2 / (Real.pi ^ 2 * D : ℝ)) * ((D : ℝ) * δ ^ (2 : ℕ)) := by
              dsimp [s]
              exact mul_le_mul_of_nonneg_left hsum_sq_le hs_nonneg
        _ = (2 / Real.pi ^ 2) * δ ^ (2 : ℕ) := by
              field_simp [hD0]
        _ ≤ (2 / Real.pi ^ 2) * 1 := by
              gcongr
              nlinarith [hδ.le, hδle]
        _ ≤ 1 := by
              have hpi_sq_pos : 0 < Real.pi ^ (2 : ℕ) := by positivity
              have hdiv : (2 : ℝ) / Real.pi ^ (2 : ℕ) ≤ 1 := by
                rw [div_le_iff₀ hpi_sq_pos]
                nlinarith [Real.pi_gt_three]
              simpa using hdiv
    have ha_pow_le : a ^ (2 * n) ≤ a ^ n := by
      calc
        a ^ (2 * n) = (a ^ 2) ^ n := by rw [pow_mul]
        _ ≤ a ^ n := by
              have ha2le : a ^ 2 ≤ a := by
                nlinarith [ha_nonneg, ha_le_one]
              simpa using pow_le_pow_left₀ (sq_nonneg a) ha2le n
    have hPowExp : a ^ n ≤ Real.exp (-((n : ℝ) * s)) := by
      have hn0 : (n : ℝ) ≠ 0 := by
        exact_mod_cast (Nat.succ_le_iff.mp hn).ne'
      have hpow :
          a ^ n ≤ (1 - ((n : ℝ) * s) / n) ^ n := by
        have hrewrite : 1 - ((n : ℝ) * s) / n = 1 - s := by
          field_simp [hn0]
        rw [hrewrite]
        exact pow_le_pow_left₀ ha_nonneg ha_bound n
      have ht : (n : ℝ) * s ≤ n := by
        calc
          (n : ℝ) * s ≤ (n : ℝ) * 1 := by
                exact mul_le_mul_of_nonneg_left hs_le_one (Nat.cast_nonneg n)
          _ = n := by ring
      exact hpow.trans (Real.one_sub_div_pow_le_exp_neg ht)
    have hsum_scale :
        ∑ i : Fin D, (((Real.sqrt n : ℝ) * x i) ^ (2 : ℕ)) =
          (n : ℝ) * ∑ i : Fin D, x i ^ (2 : ℕ) := by
      calc
        ∑ i : Fin D, (((Real.sqrt n : ℝ) * x i) ^ (2 : ℕ))
            = ∑ i : Fin D, ((Real.sqrt n : ℝ) ^ (2 : ℕ) * x i ^ (2 : ℕ)) := by
                refine Finset.sum_congr rfl ?_
                intro i hi
                rw [pow_two, pow_two]
                ring
        _ = (Real.sqrt n : ℝ) ^ (2 : ℕ) * ∑ i : Fin D, x i ^ (2 : ℕ) := by
              rw [Finset.mul_sum]
        _ = (n : ℝ) * ∑ i : Fin D, x i ^ (2 : ℕ) := by
              rw [Real.sq_sqrt (Nat.cast_nonneg n)]
    have hmem : (Real.sqrt n) • x ∈ (Real.sqrt n) • zeroPeakBox D δ := ⟨x, hx, rfl⟩
    have hArg :
        (((Real.sqrt n)⁻¹ : ℝ) • ((Real.sqrt n : ℝ) • x) : Fin D → ℝ) = x := by
      ext i
      simp [Pi.smul_apply, hsqrt_pos.ne']
    have hsum_scale' :
        ∑ i : Fin D, (((Real.sqrt n : ℝ) • x) i) ^ (2 : ℕ) =
          (n : ℝ) * ∑ i : Fin D, x i ^ (2 : ℕ) := by
      simpa [Pi.smul_apply] using hsum_scale
    have hIntegrand :
        rescaledZeroPeakIntegrand D n δ ((Real.sqrt n : ℝ) • x) = a ^ (2 * n) := by
      rw [rescaledZeroPeakIntegrand, Set.indicator_of_mem hmem, hArg]
    calc
      ‖rescaledZeroPeakIntegrand D n δ ((Real.sqrt n : ℝ) • x)‖ = a ^ (2 * n) := by
            rw [hIntegrand, Real.norm_eq_abs, abs_of_nonneg (pow_nonneg ha_nonneg _)]
      _ ≤ a ^ n := ha_pow_le
      _ ≤ Real.exp (-((n : ℝ) * s)) := hPowExp
      _ = Real.exp
            (-((2 / (Real.pi ^ 2 * D : ℝ)) *
              ∑ i : Fin D, (((Real.sqrt n : ℝ) • x) i) ^ (2 : ℕ))) := by
              have hscaled :
                  (n : ℝ) * ((2 / (Real.pi ^ 2 * D : ℝ)) * ∑ i : Fin D, x i ^ (2 : ℕ)) =
                    (2 / (Real.pi ^ 2 * D : ℝ)) *
                      ∑ i : Fin D, (((Real.sqrt n : ℝ) • x) i) ^ (2 : ℕ) := by
                rw [hsum_scale']
                ring
              simpa [s] using congrArg Neg.neg hscaled
  · -- Proof comment: away from the scaled box the integrand vanishes, so the Gaussian bound is
    -- immediate.
    simp [rescaledZeroPeakIntegrand, hu, le_of_lt (Real.exp_pos _)]

/-- Helper for Exercise 17.5.1: the explicit Gaussian majorant used in the dominated-convergence
step is integrable on the coordinate model `Fin D → ℝ`. -/
private lemma integrable_coordinateGaussianMajorant
    {D : ℕ} [NeZero D] :
    Integrable (fun u : Fin D → ℝ ↦
      Real.exp (-((2 / (Real.pi ^ 2 * D : ℝ)) * ∑ i : Fin D, u i ^ (2 : ℕ)))) := by
  let b : ℝ := 2 / (Real.pi ^ 2 * D : ℝ)
  have hb : 0 < b := by
    -- Proof comment: the Gaussian coefficient is positive because `D ≠ 0`.
    dsimp [b]
    have hDpos : 0 < (D : ℝ) := by
      exact_mod_cast Nat.pos_of_ne_zero (NeZero.ne D)
    have hden : 0 < (Real.pi ^ 2 * D : ℝ) := by
      positivity
    exact div_pos two_pos hden
  have hComplex :
      Integrable (fun u : Fin D → ℝ ↦
        Complex.exp (-((b : ℂ) * ∑ i : Fin D, (u i : ℂ) ^ (2 : ℕ)))) := by
    -- Proof comment: this is the coordinate-space complex Gaussian integrability theorem with
    -- zero linear term.
    simpa [b, Finset.mul_sum, neg_mul, add_comm, add_left_comm, add_assoc] using
      (GaussianFourier.integrable_cexp_neg_mul_sum_add (ι := Fin D) (b := (b : ℂ))
        (c := fun _ : Fin D ↦ (0 : ℂ)) (show 0 < (b : ℂ).re by simpa using hb))
  -- Proof comment: the norm of the complex Gaussian is exactly the real-valued majorant.
  convert hComplex.norm using 1 with u
  ext u
  rw [Complex.norm_exp]
  dsimp [b]
  simp [pow_two]

/-- Helper for Exercise 17.5.1: each rescaled zero-peak integrand is a measurable indicator of a
continuous symbol profile. -/
private lemma aestronglyMeasurable_rescaledZeroPeakIntegrand
    {D n : ℕ} {δ : ℝ} :
    AEStronglyMeasurable (rescaledZeroPeakIntegrand D n δ) volume := by
  have hBase :
      AEStronglyMeasurable
        (fun u : Fin D → ℝ ↦ coordinateSimpleWalkSymbol D ((Real.sqrt n)⁻¹ • u) ^ (2 * n)) := by
    -- Proof comment: scalar multiplication by the fixed factor `(√n)⁻¹` preserves measurability,
    -- and the symbol itself is continuous.
    exact
      ((continuous_coordinateSimpleWalkSymbol D).comp
        (continuous_id.const_smul ((Real.sqrt n)⁻¹))).pow (2 * n) |>.aestronglyMeasurable
  -- Proof comment: the rescaled integrand is the indicator of the measurable scaled box applied
  -- to that measurable profile.
  simpa [rescaledZeroPeakIntegrand] using
    (hBase.indicator ((measurableSet_zeroPeakBox D δ).const_smul₀ (Real.sqrt n)))

/-- Helper for Exercise 17.5.1: the Gaussian limit profile has the expected total mass on the
coordinate model `Fin D → ℝ`. -/
private lemma coordinateGaussianIntegral_eq
    {D : ℕ} [NeZero D] :
    ∫ u : Fin D → ℝ, Real.exp (-((∑ i : Fin D, u i ^ (2 : ℕ)) / D)) ∂volume =
      (Real.pi * D) ^ ((D : ℝ) / 2) := by
  have hMap :
      Measure.map (MeasurableEquiv.toLp 2 (Fin D → ℝ)) (volume : Measure (Fin D → ℝ)) =
        (volume : Measure (EuclideanSpace ℝ (Fin D))) := by
    simpa using (PiLp.volume_preserving_toLp (ι := Fin D)).map_eq
  have hTransport :=
    integral_map_equiv
      (μ := (volume : Measure (Fin D → ℝ)))
      (MeasurableEquiv.toLp 2 (Fin D → ℝ))
      (fun v : EuclideanSpace ℝ (Fin D) ↦
        Real.exp (-((∑ i : Fin D, v i ^ (2 : ℕ)) / D)))
  -- Proof comment: `PiLp.volume_preserving_toLp` transports the coordinate integral to the
  -- Euclidean-space Gaussian integral already proved above.
  rw [hMap] at hTransport
  calc
    ∫ u : Fin D → ℝ, Real.exp (-((∑ i : Fin D, u i ^ (2 : ℕ)) / D)) ∂volume
        = ∫ v : EuclideanSpace ℝ (Fin D),
            Real.exp (-((∑ i : Fin D, v i ^ (2 : ℕ)) / D)) ∂volume := by
              simpa [Function.comp_def] using hTransport.symm
    _ = (Real.pi * D) ^ ((D : ℝ) / 2) := simpleWalkGaussianIntegral_eq (D := D)

/-- Helper for Exercise 17.5.1: dominated convergence upgrades the rescaled zero-peak integral to
the Gaussian integral on the coordinate model. -/
private lemma rescaledZeroPeakIntegral_tendsto_gaussian
    {D : ℕ} [NeZero D] {δ : ℝ} (hδ : 0 < δ) (hδle : δ ≤ 1) :
    Tendsto
      (fun n : Nat ↦ ∫ u, rescaledZeroPeakIntegrand D n δ u ∂volume)
      atTop
      (nhds (∫ u : Fin D → ℝ, Real.exp (-((∑ i : Fin D, u i ^ (2 : ℕ)) / D)) ∂volume)) := by
  -- Proof comment: the pointwise Gaussian limit and the explicit integrable majorant are already
  -- available, so the remaining step is a standard dominated-convergence application.
  refine MeasureTheory.tendsto_integral_filter_of_dominated_convergence
    (μ := volume)
    (F := fun n : Nat ↦ rescaledZeroPeakIntegrand D n δ)
    (f := fun u : Fin D → ℝ ↦ Real.exp (-((∑ i : Fin D, u i ^ (2 : ℕ)) / D)))
    (fun u : Fin D → ℝ ↦
      Real.exp (-((2 / (Real.pi ^ 2 * D : ℝ)) * ∑ i : Fin D, u i ^ (2 : ℕ)))) ?_ ?_ ?_ ?_
  · exact Eventually.of_forall fun n ↦
      aestronglyMeasurable_rescaledZeroPeakIntegrand (D := D) (n := n) (δ := δ)
  · filter_upwards [eventually_ge_atTop 1] with n hn
    exact Filter.Eventually.of_forall fun u ↦
      rescaledZeroPeakIntegrand_norm_le_expGaussian (D := D) hδ hδle hn u
  · exact integrable_coordinateGaussianMajorant (D := D)
  · exact Eventually.of_forall fun u ↦
      rescaledZeroPeakIntegrand_tendsto_gaussian (D := D) hδ u

/-- Helper for Exercise 17.5.1: after inserting the Gaussian mass, the remaining normalization
constant simplifies to the local-limit constant `(4π / D)^(-D/2)`. -/
private lemma scaledCoordinateGaussianIntegral_eq
    {D : ℕ} [NeZero D] :
    ((2 * Real.pi : ℝ) ^ D)⁻¹ *
        (∫ u : Fin D → ℝ, Real.exp (-((∑ i : Fin D, u i ^ (2 : ℕ)) / D)) ∂volume) =
      (4 * Real.pi / D) ^ (-(D : ℝ) / 2) := by
  have hD0 : (D : ℝ) ≠ 0 := by
    exact_mod_cast (NeZero.ne D)
  let α : ℝ := (D : ℝ) / 2
  let base : ℝ := 4 * Real.pi ^ (2 : ℕ)
  have hbase_nonneg : 0 ≤ base := by
    dsimp [base]
    positivity
  have hpiD_nonneg : 0 ≤ (Real.pi * D : ℝ) := by
    positivity
  have hbaseInv_nonneg : 0 ≤ base⁻¹ := by
    positivity
  have hTwoPiPow : ((2 * Real.pi : ℝ) ^ D) = base ^ α := by
    -- Proof comment: rewrite the integer power `(2π)^D` as an `rpow` with exponent `D / 2`.
    calc
      ((2 * Real.pi : ℝ) ^ D) = (2 * Real.pi : ℝ) ^ (D : ℝ) := by
        rw [Real.rpow_natCast]
      _ = (2 * Real.pi : ℝ) ^ (2 * α) := by
        congr 2
        dsimp [α]
        ring
      _ = ((2 * Real.pi : ℝ) ^ (2 : ℕ)) ^ α := by
        simpa using
          (Real.rpow_natCast_mul (show 0 ≤ (2 * Real.pi : ℝ) by positivity) 2 α)
      _ = base ^ α := by
        dsimp [base]
        congr 1
        ring
  rw [coordinateGaussianIntegral_eq (D := D)]
  calc
    (((2 * Real.pi : ℝ) ^ D)⁻¹) * (Real.pi * D) ^ α
        = ((base ^ α)⁻¹) * (Real.pi * D) ^ α := by
            rw [hTwoPiPow]
    _ = (base ^ (-α)) * (Real.pi * D) ^ α := by
          rw [Real.rpow_neg hbase_nonneg]
    _ = ((base⁻¹) ^ α) * (Real.pi * D) ^ α := by
          rw [Real.rpow_neg_eq_inv_rpow]
    _ = (base⁻¹ * (Real.pi * D)) ^ α := by
          rw [← Real.mul_rpow hbaseInv_nonneg hpiD_nonneg]
    _ = (D / (4 * Real.pi)) ^ α := by
          dsimp [base]
          congr 1
          field_simp [show (Real.pi : ℝ) ≠ 0 by positivity]
    _ = ((4 * Real.pi / D)⁻¹) ^ α := by
          congr 1
          field_simp [hD0, show (Real.pi : ℝ) ≠ 0 by positivity]
    _ = (4 * Real.pi / D) ^ (-α) := by
          rw [← Real.rpow_neg_eq_inv_rpow]
    _ = (4 * Real.pi / D) ^ (-(D : ℝ) / 2) := by
          congr 1
          dsimp [α]
          ring

/-- Helper for Exercise 17.5.1: the zero-peak chart contributes exactly one copy of the Gaussian
local-limit constant after the rescaling step. -/
private lemma simpleWalkSymbol_zeroPeakContribution_tendsto
    {D : ℕ} [NeZero D] {δ : ℝ}
    (hδ : 0 < δ) (hδle : δ ≤ 1) :
    Tendsto
      (fun n : Nat =>
        (n : ℝ) ^ ((D : ℝ) / 2) *
          (((2 * Real.pi) ^ D)⁻¹ *
            ∫ x in zeroPeakBox D δ, coordinateSimpleWalkSymbol D x ^ (2 * n) ∂volume))
      atTop
      (nhds ((4 * Real.pi / D) ^ (-(D : ℝ) / 2))) := by
  -- Route correction: previous attempts mixed the eventual tail rewrite, dominated convergence,
  -- and the `PiLp` Gaussian transport in one proof. The helper lemmas above separate those roles.
  have hRewrite :
      (fun n : Nat =>
        (n : ℝ) ^ ((D : ℝ) / 2) *
          (((2 * Real.pi) ^ D)⁻¹ *
            ∫ x in zeroPeakBox D δ, coordinateSimpleWalkSymbol D x ^ (2 * n) ∂volume)) =ᶠ[atTop]
        fun n : Nat =>
          ((2 * Real.pi : ℝ) ^ D)⁻¹ *
            ∫ u, rescaledZeroPeakIntegrand D n δ u ∂volume := by
    filter_upwards [eventually_ge_atTop 1] with n hn
    -- Proof comment: on the tail `n ≥ 1`, the scaling identity rewrites the small-box integral
    -- into the whole-space integral of the rescaled indicator integrand.
    simpa using zeroPeakScaledIndicatorIntegral_eq (D := D) (δ := δ) (n := n) hn
  have hRescaled :
      Tendsto
        (fun n : Nat =>
          ((2 * Real.pi : ℝ) ^ D)⁻¹ *
            ∫ u, rescaledZeroPeakIntegrand D n δ u ∂volume)
        atTop
        (nhds
          (((2 * Real.pi : ℝ) ^ D)⁻¹ *
            ∫ u : Fin D → ℝ, Real.exp (-((∑ i : Fin D, u i ^ (2 : ℕ)) / D)) ∂volume)) := by
    -- Proof comment: dominated convergence computes the rescaled integral limit, and the outer
    -- Fourier normalization factor is constant.
    exact
      (rescaledZeroPeakIntegral_tendsto_gaussian (D := D) hδ hδle).const_mul
        (((2 * Real.pi : ℝ) ^ D)⁻¹)
  have hLimitValue :
      (((2 * Real.pi : ℝ) ^ D)⁻¹ *
        ∫ u : Fin D → ℝ, Real.exp (-((∑ i : Fin D, u i ^ (2 : ℕ)) / D)) ∂volume) =
        (4 * Real.pi / D) ^ (-(D : ℝ) / 2) :=
    scaledCoordinateGaussianIntegral_eq (D := D)
  -- Proof comment: after the tail rewrite, the main theorem is exactly the normalized Gaussian
  -- integral limit.
  have hRescaled' :
      Tendsto
        (fun n : Nat =>
          ((2 * Real.pi : ℝ) ^ D)⁻¹ *
            ∫ u, rescaledZeroPeakIntegrand D n δ u ∂volume)
        atTop
        (nhds ((4 * Real.pi / D) ^ (-(D : ℝ) / 2))) := by
    simpa [hLimitValue] using hRescaled
  exact hRescaled'.congr' hRewrite.symm

/-- Exercise 17.5.1: the scaled even return probability of the symmetric simple random walk on
`ℤ^D` converges to the local-limit constant `2 * (4π / D)^(-D/2)`. -/
theorem tendsto_scaled_simpleSymmetricRandomWalk_returnProbability
    {D : Nat} [NeZero D] :
    Tendsto
      (fun n : Nat =>
        (n : ℝ) ^ ((D : ℝ) / 2) *
          ((((dirac_convolution_kernel ((symmetricSimpleRandomWalkStepPMF D).toMeasure) ^
            (2 * n)) (0 : LatticePoint D)).real ({0} : Set (LatticePoint D)))))
      atTop
      (nhds ((2 : ℝ) * (4 * Real.pi / D) ^ (-(D : ℝ) / 2))) := by
  let δ : ℝ := min (Real.pi / 8) 1
  let zeroTerm : Nat → ℝ := fun n =>
    (n : ℝ) ^ ((D : ℝ) / 2) *
      (((2 * Real.pi) ^ D)⁻¹ *
        ∫ x in zeroPeakBox D δ, coordinateSimpleWalkSymbol D x ^ (2 * n) ∂volume)
  let remainderTerm : Nat → ℝ := fun n =>
    (n : ℝ) ^ ((D : ℝ) / 2) *
      (((2 * Real.pi) ^ D)⁻¹ *
        ∫ x in wrappedRemainderBox D δ, coordinateSimpleWalkSymbol D x ^ (2 * n) ∂volume)
  let symbolTerm : Nat → ℝ := fun n =>
    (n : ℝ) ^ ((D : ℝ) / 2) *
      (((2 * Real.pi) ^ D)⁻¹ *
        ∫ t in latticeFrequencyCube D, simpleWalkSymbol D t ^ (2 * n) ∂volume)
  have hδ : 0 < δ := by
    -- Proof comment: the chosen peak width is a positive minimum of two positive numbers.
    dsimp [δ]
    exact lt_min (by positivity) zero_lt_one
  have hδle : δ ≤ 1 := by
    -- Proof comment: `δ` was chosen as a minimum with `1`, so this bound is immediate.
    dsimp [δ]
    exact min_le_right _ _
  have hδpi : 2 * δ < Real.pi := by
    -- Proof comment: `δ ≤ π/8` forces `2δ ≤ π/4`, and `π/4 < π`.
    dsimp [δ]
    calc
      2 * min (Real.pi / 8) 1 ≤ 2 * (Real.pi / 8) := by
        gcongr
        exact min_le_left _ _
      _ = Real.pi / 4 := by ring
      _ < Real.pi := by
        nlinarith [Real.pi_pos]
  have hCoordSplit :
      ∀ n : Nat,
        symbolTerm n = 2 * zeroTerm n + remainderTerm n := by
    intro n
    -- Proof comment: first transport the integral to the coordinate cube, then apply the wrapped
    -- peak decomposition there.
    have hSplit := simpleWalkSymbol_wrappedBoundarySplit (D := D) hδpi n
    calc
      symbolTerm n
          = (n : ℝ) ^ ((D : ℝ) / 2) *
              (((2 * Real.pi) ^ D)⁻¹ *
                ∫ x in coordinateFrequencyCube D,
                  coordinateSimpleWalkSymbol D x ^ (2 * n) ∂volume) := by
              dsimp [symbolTerm]
              rw [symbolIntegral_eq_coordinateIntegral (D := D) (n := n)]
      _ = (n : ℝ) ^ ((D : ℝ) / 2) *
            (((2 * Real.pi) ^ D)⁻¹ *
              (2 * ∫ x in zeroPeakBox D δ, coordinateSimpleWalkSymbol D x ^ (2 * n) ∂volume +
                ∫ x in wrappedRemainderBox D δ,
                  coordinateSimpleWalkSymbol D x ^ (2 * n) ∂volume)) := by
            rw [hSplit]
      _ = 2 * zeroTerm n + remainderTerm n := by
            dsimp [zeroTerm, remainderTerm]
            ring
  have hSmall :
      Tendsto zeroTerm atTop (nhds ((4 * Real.pi / D) ^ (-(D : ℝ) / 2))) := by
    simpa [zeroTerm] using simpleWalkSymbol_zeroPeakContribution_tendsto (D := D) hδ hδle
  have hRemainder :
      Tendsto remainderTerm atTop (nhds 0) := by
    simpa [remainderTerm] using simpleWalkSymbol_wrappedRemainder_tendsto_zero (D := D) hδ hδpi
  have hMain :
      Tendsto symbolTerm atTop (nhds ((2 : ℝ) * (4 * Real.pi / D) ^ (-(D : ℝ) / 2))) := by
    -- Proof comment: after the coordinate-cube split, the main term is the sum of two identical
    -- peak contributions and a negligible remainder.
    have hAsymptotic :
        Tendsto (fun n : Nat => 2 * zeroTerm n + remainderTerm n) atTop
          (nhds ((2 : ℝ) * (4 * Real.pi / D) ^ (-(D : ℝ) / 2) + 0)) := by
      exact (hSmall.const_mul 2).add hRemainder
    have hRewrite :
        symbolTerm = fun n : Nat => 2 * zeroTerm n + remainderTerm n := by
      funext n
      exact hCoordSplit n
    rw [hRewrite]
    simpa using hAsymptotic
  -- Proof comment: once the analytic limit for the symbol integral is proved, the theorem follows
  -- by rewriting the return mass with the cube-integral identity.
  simpa [symbolTerm, symmetricSimpleRandomWalkOriginMass_eq_symbolIntegral (D := D)] using hMain

end ProbabilityTheory
