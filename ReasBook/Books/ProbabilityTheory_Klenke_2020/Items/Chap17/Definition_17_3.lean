noncomputable section

universe u v w

namespace ProbabilityTheory

variable {I : Type u}
variable {Ω : Type v} [mΩ : MeasurableSpace Ω]
variable {E : Type w} [mE : MeasurableSpace E]

/-- The time-`t` transition kernel induced by a path-space kernel `κ : Kernel E (I → E)`. -/
abbrev transitionKernel (κ : Kernel E (I → E)) (t : I) : Kernel E E :=
  κ.map fun y ↦ y t

-- Proof sketch: unfold `transitionKernel`; it is defined as `Kernel.map` of `κ` along the
-- coordinate-evaluation map `y ↦ y t`, so the resulting fiber at `x` is exactly `(κ x).map`.
/-- Evaluating `transitionKernel κ t` at a state `x` pushes the path law `κ x` forward by the
time-`t` coordinate projection. -/
theorem transitionKernel_apply (κ : Kernel E (I → E)) (t : I) (x : E) :
    transitionKernel κ t x = (κ x).map (fun y ↦ y t) := by
  -- Proof comment: `transitionKernel` is defined by mapping the path kernel along evaluation.
  simpa [transitionKernel] using Kernel.map_apply κ (measurable_pi_apply t) x

-- Proof sketch: `transitionKernel κ t` is `Kernel.map` of the Markov kernel `κ` along the
-- measurable evaluation map at time `t`; `IsMarkovKernel.map` preserves the Markov-kernel property.
/-- A Markov path kernel yields a Markov state-transition kernel at each time `t`. -/
instance (κ : Kernel E (I → E)) [IsMarkovKernel κ] (t : I) :
    IsMarkovKernel (transitionKernel κ t) := by
  -- Proof comment: mapping a Markov kernel along a measurable coordinate projection preserves
  -- the Markov-kernel property.
  simpa [transitionKernel] using Kernel.IsMarkovKernel.map κ (measurable_pi_apply t)

variable [AddMonoid I] [Preorder I]

/-- A process satisfying Definition 17.3 is time-homogeneous with transition probabilities `κ`
if each coordinate is measurable, `X 0 = x` almost surely under `P x`, the path law of `X` under
`P x` is the path-space kernel `κ x`, and the natural filtration satisfies
`P_x[X_{t+s} ∈ A | 𝓕_s] = κ_t(X_s, A)` almost surely for all measurable `A`. The countable-state
case is the discrete Markov-process case, and `I = ℕ` gives the Markov-chain case. -/
class IsTimeHomogeneousMarkovProcess
    (X : I → Ω → E) (P : outParam (E → ProbabilityMeasure Ω))
    (κ : outParam (Kernel E (I → E))) : Prop where
  /-- Each time slice `X t` is measurable on the ambient measurable space `(Ω, 𝓐)`. -/
  measurable_process : ∀ t, Measurable (X t)
  /-- Under `P x`, the process starts from the state `x` almost surely. -/
  initial_state : ∀ x, (P x : Measure Ω) (X 0 ⁻¹' {x}) = 1
  /-- The canonical path law of `X` under `P x` is the stochastic kernel `κ x` on `E^I`. -/
  path_law : ∀ x, κ x = (P x : Measure Ω).map (fun ω ↦ fun t : I ↦ X t ω)
  /-- The natural filtration generated by the past coordinates of `X` satisfies the
  time-homogeneous Markov property with transition kernel `κ_t`. -/
  markov_property :
    ∀ x ⦃A : Set E⦄, MeasurableSet A → ∀ s t : I,
      (P x)⟦X (t + s) ⁻¹' A | ⨆ r ≤ s, MeasurableSpace.comap (X r) mE⟧ =ᵐ[(P x : Measure Ω)]
        fun ω ↦ ((transitionKernel κ t) (X s ω)).real A

/-- Every time slice of a time-homogeneous Markov process is measurable. -/
instance (t : I) (X : I → Ω → E) {P : outParam (E → ProbabilityMeasure Ω)}
    {κ : outParam (Kernel E (I → E))} [h : IsTimeHomogeneousMarkovProcess X P κ] :
    Measurable (X t) :=
  h.measurable_process t

namespace IsTimeHomogeneousMarkovProcess

-- Proof sketch: `path_law` identifies each row of `κ` with the pushforward of the probability
-- measure `P x` along the full-path map `ω ↦ (t ↦ X t ω)`, so every row is again a probability
-- measure.
/-- Any time-homogeneous Markov process carries a Markov path kernel as derived data. -/
theorem isMarkovKernel
    (X : I → Ω → E) {P : outParam (E → ProbabilityMeasure Ω)}
    {κ : outParam (Kernel E (I → E))} [h : IsTimeHomogeneousMarkovProcess X P κ] :
    IsMarkovKernel κ := by
  refine ⟨fun x ↦ ⟨?_⟩⟩
  let pathMap : Ω → I → E := fun ω t ↦ X t ω
  have hpathMapMeas : Measurable pathMap := by
    -- Proof comment: the full path map is measurable because each coordinate is measurable.
    refine measurable_pi_lambda _ fun t ↦ ?_
    exact h.measurable_process t
  -- Proof comment: the path-law field identifies `κ x` with a pushforward probability measure.
  rw [h.path_law x, Measure.map_apply hpathMapMeas MeasurableSet.univ]
  simp

/-- Helper for Definition 17.3: the one-time marginal of `X_t` under `P x` is the row of the
induced transition kernel at time `t`. -/
lemma timeMarginal_eq_transitionKernel
    (X : I → Ω → E) {P : outParam (E → ProbabilityMeasure Ω)}
    {κ : outParam (Kernel E (I → E))} [h : IsTimeHomogeneousMarkovProcess X P κ]
    (x : E) (t : I) :
    (P x : Measure Ω).map (X t) = transitionKernel κ t x := by
  let pathMap : Ω → I → E := fun ω t' ↦ X t' ω
  have hpathMapMeas : Measurable pathMap := by
    -- Proof comment: the full path map is measurable because every coordinate is measurable.
    refine measurable_pi_lambda _ fun t' ↦ ?_
    exact h.measurable_process t'
  have hcomp : (fun y : I → E ↦ y t) ∘ pathMap = X t := by
    funext ω
    rfl
  -- Proof comment: push the path law forward once more along the time-`t` evaluation map.
  calc
    (P x : Measure Ω).map (X t)
        = ((P x : Measure Ω).map pathMap).map (fun y : I → E ↦ y t) := by
            simpa [hcomp] using
              (Measure.map_map (μ := (P x : Measure Ω))
                (measurable_pi_apply t) hpathMapMeas).symm
    _ = transitionKernel κ t x := by
          rw [← h.path_law x, transitionKernel_apply]

/-- Helper for Definition 17.3: the time-zero marginal under `P x` is the Dirac law at `x`. -/
lemma initialLaw_eq_dirac
    (X : I → Ω → E) {P : outParam (E → ProbabilityMeasure Ω)}
    {κ : outParam (Kernel E (I → E))} [h : IsTimeHomogeneousMarkovProcess X P κ]
    (x : E) :
    (P x : Measure Ω).map (X 0) = Measure.dirac x := by
  refine Measure.ext fun A hA ↦ ?_
  rw [Measure.map_apply (h.measurable_process 0) hA, Measure.dirac_apply' _ hA]
  by_cases hxA : x ∈ A
  · -- Proof comment: the almost-sure identity `X 0 = x` forces every measurable set containing
    -- `x` to have full time-zero mass.
    have hsubset : X 0 ⁻¹' ({x} : Set E) ⊆ X 0 ⁻¹' A := by
      intro ω hω
      have hxω : X 0 ω = x := by
        simpa using hω
      simpa [hxω] using hxA
    have hone_le : 1 ≤ (P x : Measure Ω) (X 0 ⁻¹' A) := by
      have hmono :
          (P x : Measure Ω) (X 0 ⁻¹' ({x} : Set E)) ≤ (P x : Measure Ω) (X 0 ⁻¹' A) :=
        measure_mono hsubset
      simpa [h.initial_state x] using hmono
    simpa [hxA] using (le_antisymm prob_le_one hone_le)
  · -- Proof comment: if `x ∉ A`, then the complement contains the sure event `{X 0 = x}`,
    -- so `{X 0 ∈ A}` has probability zero.
    have hxAc : x ∈ Aᶜ := by
      simpa using hxA
    have hsubset : X 0 ⁻¹' ({x} : Set E) ⊆ X 0 ⁻¹' Aᶜ := by
      intro ω hω
      have hxω : X 0 ω = x := by
        simpa using hω
      simpa [hxω] using hxAc
    have hcompl_one : (P x : Measure Ω) (X 0 ⁻¹' Aᶜ) = 1 := by
      have hone_le : 1 ≤ (P x : Measure Ω) (X 0 ⁻¹' Aᶜ) := by
        have hmono :
            (P x : Measure Ω) (X 0 ⁻¹' ({x} : Set E)) ≤ (P x : Measure Ω) (X 0 ⁻¹' Aᶜ) :=
          measure_mono hsubset
        simpa [h.initial_state x] using hmono
      exact le_antisymm prob_le_one hone_le
    have hpreimage_meas : MeasurableSet (X 0 ⁻¹' A) := (h.measurable_process 0) hA
    simpa [hxA] using
      (prob_compl_eq_one_iff hpreimage_meas).mp <|
        by simpa [Set.preimage_compl] using hcompl_one

/-- Helper for Definition 17.3: the induced transition kernel at time `0` is the identity
kernel. -/
lemma transitionKernel_zero_eq
    (X : I → Ω → E) {P : outParam (E → ProbabilityMeasure Ω)}
    {κ : outParam (Kernel E (I → E))} [h : IsTimeHomogeneousMarkovProcess X P κ] :
    transitionKernel κ 0 = Kernel.id := by
  -- Proof comment: compare the time-zero marginal with the Dirac initial law pointwise on
  -- measurable sets.
  ext x A hA
  rw [Kernel.id_apply, ← timeMarginal_eq_transitionKernel (X := X) (P := P) (κ := κ) x 0,
    initialLaw_eq_dirac (X := X) (P := P) (κ := κ) x]

section

variable {I : Type u} [AddCommMonoid I] [PartialOrder I]
variable {Ω : Type v} [mΩ : MeasurableSpace Ω]
variable {E : Type w} [mE : MeasurableSpace E]

/-- Helper for Definition 17.3: the history σ-algebra generated by a measurable process is
contained in the ambient measurable space. -/
lemma generatedFiltrationSpace_le_ambient
    (X : I → Ω → E) {P : outParam (E → ProbabilityMeasure Ω)}
    {κ : outParam (Kernel E (I → E))} [h : IsTimeHomogeneousMarkovProcess X P κ]
    (s : I) :
    generatedFiltrationSpace X s ≤ mΩ := by
  -- Proof comment: every coordinate sigma-algebra in the defining supremum is already ambient.
  rw [generatedFiltrationSpace]
  refine iSup_le fun r ↦ ?_
  refine iSup_le fun hr ↦ ?_
  exact (h.measurable_process r).comap_le

/-- Helper for Definition 17.3: the induced transition kernels satisfy the
Chapman--Kolmogorov equation. -/
lemma transitionKernel_comp_eq
    (X : I → Ω → E) {P : outParam (E → ProbabilityMeasure Ω)}
    {κ : outParam (Kernel E (I → E))} [h : IsTimeHomogeneousMarkovProcess X P κ]
    (s t : I) :
    transitionKernel κ t ∘ₖ transitionKernel κ s = transitionKernel κ (s + t) := by
  ext x A hA
  let _ : IsMarkovKernel κ := isMarkovKernel (X := X) (P := P) (κ := κ)
  let μ : Measure Ω := (P x : Measure Ω)
  let g : Ω → ℝ := fun ω ↦ ((transitionKernel κ t) (X s ω)).real A
  have hEvent :
      Set.indicator (X (s + t) ⁻¹' A) (fun _ ↦ (1 : ℝ)) =
        Set.indicator (X (t + s) ⁻¹' A) (fun _ ↦ (1 : ℝ)) := by
    funext ω
    simp [add_comm]
  have hmarkov :
      μ⟦X (s + t) ⁻¹' A | generatedFiltrationSpace X s⟧ =ᵐ[μ] g := by
    -- Proof comment: this is exactly the source Markov property, rewritten onto the local names.
    simpa [μ, g, generatedFiltrationSpace, hEvent] using h.markov_property x hA s t
  have hcomp_real :
      ((transitionKernel κ t ∘ₖ transitionKernel κ s) x).real A =
        ∫ y, ((transitionKernel κ t) y).real A ∂transitionKernel κ s x := by
    -- Proof comment: kernel composition integrates the time-`t` masses against the time-`s`
    -- marginal.
    rw [Measure.real_def, Kernel.comp_apply' _ _ _ hA]
    simpa [Measure.real_def] using
      (integral_toReal
        ((Kernel.measurable_coe (transitionKernel κ t) hA).aemeasurable)
        (Filter.Eventually.of_forall fun y ↦
          lt_of_le_of_lt (prob_le_one : (transitionKernel κ t y) A ≤ 1) ENNReal.one_lt_top)).symm
  have hmap_real :
      ∫ y, ((transitionKernel κ t) y).real A ∂transitionKernel κ s x =
        ∫ ω, g ω ∂μ := by
    -- Proof comment: replace the time-`s` marginal by the pushforward law of `X s` under `P x`.
    rw [← timeMarginal_eq_transitionKernel (X := X) (P := P) (κ := κ) x s]
    exact
      integral_map (h.measurable_process s).aemeasurable
        ((Kernel.measurable_coe (transitionKernel κ t) hA).ennreal_toReal.aestronglyMeasurable)
  have hfuture_real :
      ∫ ω, g ω ∂μ = (transitionKernel κ (s + t) x).real A := by
    -- Proof comment: integrate the Markov-property identity over the whole space, then identify
    -- the resulting future marginal with the time-`s + t` transition row.
    calc
      ∫ ω, g ω ∂μ
          = ∫ ω, (μ⟦X (s + t) ⁻¹' A | generatedFiltrationSpace X s⟧) ω ∂μ := by
              exact integral_congr_ae hmarkov.symm
      _ = ∫ ω, Set.indicator (X (s + t) ⁻¹' A) (fun _ ↦ (1 : ℝ)) ω ∂μ := by
            exact
              integral_condExp
                (μ := μ)
                (m := generatedFiltrationSpace X s)
                (f := Set.indicator (X (s + t) ⁻¹' A) fun _ ↦ (1 : ℝ))
                (generatedFiltrationSpace_le_ambient (X := X) (P := P) (κ := κ) s)
      _ = μ.real (X (s + t) ⁻¹' A) := by
            rw [integral_indicator ((h.measurable_process (s + t)) hA)]
            rw [MeasureTheory.setIntegral_const, smul_eq_mul, mul_one, Measure.real_def]
      _ = (transitionKernel κ (s + t) x).real A := by
            rw [← timeMarginal_eq_transitionKernel (X := X) (P := P) (κ := κ) x (s + t)]
            symm
            exact
              MeasureTheory.map_measureReal_apply
                (μ := μ) (f := X (s + t)) (h.measurable_process (s + t)) hA
  exact
    (MeasureTheory.measureReal_eq_measureReal_iff
      (μ := (transitionKernel κ t ∘ₖ transitionKernel κ s) x)
      (ν := transitionKernel κ (s + t) x)
      (s := A) (t := A)).mp <|
      hcomp_real.trans <| hmap_real.trans hfuture_real

-- Proof sketch: package the source fields directly into the owner structure. The initial law and
-- one-time marginals are the two pushforward lemmas above, the owner Markov property is the
-- source field rewritten via `generatedFiltrationSpace`, and the semigroup law comes from
-- integrating the source Markov identity over the full space.
/-- Definition 17.3: the source-facing path-kernel formulation induces the canonical state-kernel
realization `t ↦ transitionKernel κ t` from Theorem 17.8. -/
theorem toIsMarkovProcessRealization
    (X : I → Ω → E) {P : outParam (E → ProbabilityMeasure Ω)}
    {κ : outParam (Kernel E (I → E))} [h : IsTimeHomogeneousMarkovProcess X P κ] :
    IsMarkovProcessRealization (transitionKernel κ) P X := by
  -- Route correction: `Theorem_17_8.isMarkovSemigroup_of_naturalMarkovProcess` is specialized to
  -- `AddSubmonoid NNReal`, so in this general time index we build the semigroup fields directly.
  refine
    { semigroup := ?_
      measurable_process := h.measurable_process
      initial_eq := initialLaw_eq_dirac (X := X) (P := P) (κ := κ)
      transition_eq := timeMarginal_eq_transitionKernel (X := X) (P := P) (κ := κ)
      markov_property := ?_ }
  · -- Proof comment: the source fields supply the zero-time law, Markov kernels, and
    -- Chapman--Kolmogorov identity for the induced state kernels.
    refine
      { isMarkovKernel := fun t ↦ by
          let _ : IsMarkovKernel κ := isMarkovKernel (X := X) (P := P) (κ := κ)
          infer_instance
        zero_eq := transitionKernel_zero_eq (X := X) (P := P) (κ := κ)
        comp_eq := transitionKernel_comp_eq (X := X) (P := P) (κ := κ) }
  · intro x A hA s t
    -- Proof comment: the owner Markov-property field is exactly the source field after unfolding
    -- the generated-history notation used in this chapter.
    simpa [generatedFiltrationSpace] using h.markov_property x hA s t

-- Proof sketch: transport the owner-level consequences of
-- `toIsMarkovProcessRealization` through Theorem 17.8, which packages the initial-state law,
-- zero-time identity, and Chapman--Kolmogorov equation as `IsMarkovSemigroup`.
/-- The state kernels induced by a time-homogeneous Markov process form the canonical Markov
semigroup attached to the process. -/
theorem transitionKernel_isMarkovSemigroup
    (X : I → Ω → E) {P : outParam (E → ProbabilityMeasure Ω)}
    {κ : outParam (Kernel E (I → E))} [IsTimeHomogeneousMarkovProcess X P κ] :
    _root_.IsMarkovSemigroup (transitionKernel κ) :=
  (toIsMarkovProcessRealization (X := X) (P := P) (κ := κ)).semigroup

end

end IsTimeHomogeneousMarkovProcess

section

variable {I : Type u} [AddCommMonoid I] [PartialOrder I] [ExistsAddOfLE I] [AddLeftMono I]
variable [Sub I] [OrderedSub I]
variable {Ω : Type v} [mΩ : MeasurableSpace Ω]
variable {E : Type w} [mE : MeasurableSpace E]

/-- The source-facing class of Definition 17.3 automatically supplies the canonical owner
abstraction `IsMarkovProcessRealization` for its induced state kernels. -/
instance (X : I → Ω → E) {P : outParam (E → ProbabilityMeasure Ω)}
    {κ : outParam (Kernel E (I → E))} [h : IsTimeHomogeneousMarkovProcess X P κ] :
    IsMarkovProcessRealization (transitionKernel κ) P X :=
  IsTimeHomogeneousMarkovProcess.toIsMarkovProcessRealization X

end

end ProbabilityTheory
