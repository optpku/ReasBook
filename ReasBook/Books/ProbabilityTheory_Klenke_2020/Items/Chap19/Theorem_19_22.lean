import Books.ProbabilityTheory_Klenke_2020.Items.Chap19.Definition_19_21
import Books.ProbabilityTheory_Klenke_2020.Items.Chap19.Theorem_19_20

open scoped BigOperators ProbabilityTheory

universe u

attribute [local instance] Classical.propDecidable

noncomputable section

namespace ProbabilityTheory

variable {E : Type u}

/- Domain-style sampling for Theorem 19.22:
- `source-facing`: Thomson's variational principle for unit flows/current flows from `A1` to
  `A0`.
- `core/canonical`: `IsCurrentFlow R A I` from Definition 19.14 and `ℒ(I; R)` from
  Definition 19.21.
- `bridge/view`: `ohmicCurrent R u` is the canonical concrete realization of a current flow from a
  potential `u`; Theorem 19.20 supplies the boundary-energy identity used in the variational
  argument.

Primitive data versus derived API:
- primitive data: a resistance function `R`, a flow `I`, and the unit-flow boundary condition.
- derived API: the current-flow owner `IsCurrentFlow R (A0 ∪ A1) I` is reconstructed from the
  source-facing unit-flow hypothesis together with an Ohm-law potential witness, so the public
  theorem headers should not repeat both pieces of data. -/

section

variable [Fintype E]

/-- A unit flow from `A1` to `A0` is a flow on `E \ (A0 ∪ A1)` whose total net flux through the
source set `A1` is `1`. -/
def IsUnitFlowFromTo (A1 A0 : Set E) (I : E → E → ℝ) : Prop :=
  IsFlowOutside (A0 ∪ A1) I ∧ netFlowOnSet I A1 = 1

/-- A map is a unit flow from `A1` to `A0` exactly when it is a flow outside `A0 ∪ A1` and has
unit flux through `A1`. -/
theorem isUnitFlowFromTo_iff (A1 A0 : Set E) (I : E → E → ℝ) :
    IsUnitFlowFromTo A1 A0 I ↔
      IsFlowOutside (A0 ∪ A1) I ∧ netFlowOnSet I A1 = 1 := Iff.rfl

/-- A unit flow from `A1` to `A0` is, in particular, a flow on `E \ (A0 ∪ A1)`. -/
theorem IsUnitFlowFromTo.isFlowOutside {A1 A0 : Set E} {I : E → E → ℝ}
    (hI : IsUnitFlowFromTo A1 A0 I) :
    IsFlowOutside (A0 ∪ A1) I :=
  hI.1

/-- A unit flow from `A1` to `A0` has unit total net flux through `A1`. -/
theorem IsUnitFlowFromTo.netFlowOnSet_eq_one {A1 A0 : Set E} {I : E → E → ℝ}
    (hI : IsUnitFlowFromTo A1 A0 I) :
    netFlowOnSet I A1 = 1 :=
  hI.2

/-- A unit flow from `A1` to `A0` becomes a current flow once it is generated by a potential
satisfying Ohm's law on distinct vertices. -/
theorem IsUnitFlowFromTo.isCurrentFlow {A1 A0 : Set E} {R : E → E → ℝ} {I : E → E → ℝ}
    (hI : IsUnitFlowFromTo A1 A0 I) {u : E → ℝ}
    (hOhm : ∀ ⦃x y : E⦄, x ≠ y → I x y = (u x - u y) / R x y) :
    IsCurrentFlow R (A0 ∪ A1) I :=
  IsFlowOutside.isCurrentFlow_of_ohmicCurrent_apply hI.isFlowOutside hOhm

variable {A1 A0 : Set E} {R : E → E → ℝ} {I J : E → E → ℝ}

omit [Fintype E] in
/-- Helper for Theorem 19.22: an antisymmetric flow vanishes on the diagonal. -/
private theorem flow_self_eq_zero {F : E → E → ℝ}
    (hantisymm : ∀ x y : E, F x y = -F y x) (x : E) :
    F x x = 0 := by
  -- Antisymmetry at `(x, x)` forces the value to be its own negation.
  have hxx : F x x = -F x x := hantisymm x x
  linarith

/-- Helper for Theorem 19.22: the difference of two unit flows is still a flow outside the
boundary set `A0 ∪ A1`. -/
private theorem sub_unitFlow_isFlowOutside
    (hI : IsUnitFlowFromTo A1 A0 I) (hJ : IsUnitFlowFromTo A1 A0 J) :
    IsFlowOutside (A0 ∪ A1) (fun x y ↦ J x y - I x y) := by
  refine ⟨?_, ?_⟩
  · -- Antisymmetry is preserved by subtraction.
    intro x y
    rw [hJ.isFlowOutside.antisymm x y, hI.isFlowOutside.antisymm x y]
    ring
  · -- Kirchhoff's rule is linear in the flow.
    intro x hx
    calc
      netFlowAt (fun x y ↦ J x y - I x y) x = netFlowAt J x - netFlowAt I x := by
        simp [netFlowAt, Finset.sum_sub_distrib]
      _ = 0 := by
        rw [hJ.isFlowOutside.netFlowAt_eq_zero hx, hI.isFlowOutside.netFlowAt_eq_zero hx]
        ring

/-- Helper for Theorem 19.22: the difference of two unit flows has zero total flux through
`A1`. -/
private theorem sub_unitFlow_netFlowOnSet_eq_zero
    (hI : IsUnitFlowFromTo A1 A0 I) (hJ : IsUnitFlowFromTo A1 A0 J) :
    netFlowOnSet (fun x y ↦ J x y - I x y) A1 = 0 := by
  -- The boundary flux is linear, and both unit flows carry flux `1` through `A1`.
  calc
    netFlowOnSet (fun x y ↦ J x y - I x y) A1 = netFlowOnSet J A1 - netFlowOnSet I A1 := by
      simp [netFlowOnSet, netFlowAt, Finset.sum_sub_distrib]
    _ = 1 - 1 := by rw [hJ.netFlowOnSet_eq_one, hI.netFlowOnSet_eq_one]
    _ = 0 := by ring

/-- Helper for Theorem 19.22: the mixed potential term attached to the difference of two unit
flows vanishes. -/
private theorem sub_unitFlow_mixed_term_eq_zero
    (hI : IsUnitFlowFromTo A1 A0 I) (hJ : IsUnitFlowFromTo A1 A0 J)
    {u : E → ℝ} {u0 u1 : ℝ}
    (hu0 : Set.EqOn u (fun _ : E ↦ u0) A0)
    (hu1 : Set.EqOn u (fun _ : E ↦ u1) A1) :
    ∑ x : E, ∑ y : E, (u x - u y) * (J x y - I x y) = 0 := by
  -- Theorem 19.20 turns the mixed sum into the boundary flux of the difference flow.
  have hhalf :
      (1 / 2 : ℝ) * ∑ x : E, ∑ y : E, (u x - u y) * (J x y - I x y) = 0 := by
    simpa [sub_unitFlow_netFlowOnSet_eq_zero (hI := hI) (hJ := hJ)] using
      (conservation_of_energy_of_boundary_constant_potential
        (A0 := A0) (A1 := A1)
        (I := fun x y ↦ J x y - I x y)
        (w := u) (w0 := u0) (w1 := u1)
        (sub_unitFlow_isFlowOutside (hI := hI) (hJ := hJ)) hu0 hu1).symm
  -- Clearing the harmless factor `1 / 2` gives the desired vanishing.
  nlinarith

omit [Fintype E] in
/-- Helper for Theorem 19.22: pointwise expansion of the quadratic energy term around the
difference `J - I`. -/
private theorem energySubExpansionSummand (R I J : E → E → ℝ) (x y : E) :
    J x y ^ 2 * R x y = I x y ^ 2 * R x y + (J x y - I x y) ^ 2 * R x y +
      2 * (I x y * (J x y - I x y) * R x y) := by
  -- Rewrite `J x y` as `I x y + (J x y - I x y)` and expand the square.
  have hsplit : J x y = I x y + (J x y - I x y) := by ring
  rw [hsplit]
  ring

/-- Helper for Theorem 19.22: the current-flow cross term is the potential-difference term. -/
private theorem currentCrossTerm_eq_potentialTerm
    (hR : ∀ ⦃x y : E⦄, x ≠ y → 0 < R x y)
    (hI : IsUnitFlowFromTo A1 A0 I)
    {u : E → ℝ}
    (hOhm : ∀ ⦃x y : E⦄, x ≠ y → I x y = (u x - u y) / R x y)
    (K : E → E → ℝ) (x y : E) :
    I x y * K x y * R x y = (u x - u y) * K x y := by
  -- Off the diagonal this is just Ohm's law; on the diagonal `I x x = 0`.
  by_cases hxy : x = y
  · subst y
    have hdiag : I x x = 0 := flow_self_eq_zero hI.isFlowOutside.antisymm x
    simp [hdiag]
  · have hOhmxy : I x y = (u x - u y) / R x y := hOhm hxy
    have hRne : R x y ≠ 0 := ne_of_gt (hR hxy)
    have hcancel : ((u x - u y) / R x y) * R x y = u x - u y := by
      field_simp [hRne]
    calc
      I x y * K x y * R x y = ((u x - u y) / R x y) * K x y * R x y := by
        conv_lhs => rw [hOhmxy]
      _ = (((u x - u y) / R x y) * R x y) * K x y := by ring
      _ = (u x - u y) * K x y := by rw [hcancel]

/-- Helper for Theorem 19.22: the factor `(1 / 2)` cancels the doubled double sum. -/
private theorem half_double_sum_eq_sum (f : E → E → ℝ) :
    (1 / 2 : ℝ) * ∑ x : E, ∑ y : E, 2 * f x y = ∑ x : E, ∑ y : E, f x y := by
  -- Expanding `2 * f x y` as `f x y + f x y` leaves one copy after multiplying by `1 / 2`.
  simp_rw [two_mul, Finset.sum_add_distrib]
  ring

/-- Helper for Theorem 19.22: expanding the energy of `J` around the current flow `I` isolates
the quadratic error term and the mixed potential term. -/
private theorem energyDissipation_sub_decomposition
    (hR : ∀ ⦃x y : E⦄, x ≠ y → 0 < R x y)
    (hI : IsUnitFlowFromTo A1 A0 I)
    {u : E → ℝ}
    (hOhm : ∀ ⦃x y : E⦄, x ≠ y → I x y = (u x - u y) / R x y)
    (J : E → E → ℝ) :
    ℒ(J; R) = ℒ(I; R) + ℒ((fun x y ↦ J x y - I x y); R) +
      ∑ x : E, ∑ y : E, (u x - u y) * (J x y - I x y) := by
  have hexpand :
      ∑ x : E, ∑ y : E, J x y ^ 2 * R x y =
        ∑ x : E, ∑ y : E,
          ((I x y) ^ 2 * R x y + (J x y - I x y) ^ 2 * R x y +
            2 * (I x y * (J x y - I x y) * R x y)) := by
    -- Expand the quadratic term pointwise and then sum the identity.
    refine Finset.sum_congr rfl fun x _ ↦ ?_
    refine Finset.sum_congr rfl fun y _ ↦ ?_
    exact energySubExpansionSummand R I J x y
  have hcross :
      ∑ x : E, ∑ y : E, I x y * (J x y - I x y) * R x y =
        ∑ x : E, ∑ y : E, (u x - u y) * (J x y - I x y) := by
    -- Rewrite the cross term pointwise by Ohm's law away from the diagonal.
    refine Finset.sum_congr rfl fun x _ ↦ ?_
    refine Finset.sum_congr rfl fun y _ ↦ ?_
    exact currentCrossTerm_eq_potentialTerm
      (hR := hR) (hI := hI) (hOhm := hOhm) (fun x y ↦ J x y - I x y) x y
  -- Expand `(I + (J - I))^2` pointwise and then rewrite the cross term via `hcross`.
  calc
    ℒ(J; R)
        = (1 / 2 : ℝ) * ∑ x : E, ∑ y : E,
            ((I x y) ^ 2 * R x y + (J x y - I x y) ^ 2 * R x y +
              2 * (I x y * (J x y - I x y) * R x y)) := by
          rw [energyDissipation_def, hexpand]
    _ = (1 / 2 : ℝ) * ∑ x : E, ∑ y : E, (I x y) ^ 2 * R x y
          + (1 / 2 : ℝ) * ∑ x : E, ∑ y : E, (J x y - I x y) ^ 2 * R x y
          + (1 / 2 : ℝ) * ∑ x : E, ∑ y : E, 2 * (I x y * (J x y - I x y) * R x y) := by
            simp_rw [Finset.sum_add_distrib]
            ring
    _ = (1 / 2 : ℝ) * ∑ x : E, ∑ y : E, (I x y) ^ 2 * R x y
          + (1 / 2 : ℝ) * ∑ x : E, ∑ y : E, (J x y - I x y) ^ 2 * R x y
          + ∑ x : E, ∑ y : E, I x y * (J x y - I x y) * R x y := by
            have hdouble :
                (1 / 2 : ℝ) * ∑ x : E, ∑ y : E, 2 * (I x y * (J x y - I x y) * R x y) =
                  ∑ x : E, ∑ y : E, I x y * (J x y - I x y) * R x y := by
              simp_rw [two_mul, Finset.sum_add_distrib]
              ring
            rw [hdouble]
    _ = ℒ(I; R) + ℒ((fun x y ↦ J x y - I x y); R) +
          ∑ x : E, ∑ y : E, I x y * (J x y - I x y) * R x y := by
            rw [energyDissipation_def, energyDissipation_def]
    _ = ℒ(I; R) + ℒ((fun x y ↦ J x y - I x y); R) +
          ∑ x : E, ∑ y : E, (u x - u y) * (J x y - I x y) := by
            rw [hcross]

/-- Helper for Theorem 19.22: every strictly positive resistance network has nonnegative energy
for a flow that is antisymmetric and vanishes on the diagonal. -/
private theorem energyDissipation_nonneg_of_flow
    {A : Set E} {F : E → E → ℝ}
    (hR : ∀ ⦃x y : E⦄, x ≠ y → 0 < R x y)
    (hF : IsFlowOutside A F) :
    0 ≤ ℒ(F; R) := by
  -- Each summand is nonnegative, so the whole energy is nonnegative.
  rw [energyDissipation_def]
  have hsum_nonneg : 0 ≤ ∑ x : E, ∑ y : E, F x y ^ 2 * R x y := by
    refine Finset.sum_nonneg fun x _ ↦ ?_
    refine Finset.sum_nonneg fun y _ ↦ ?_
    by_cases hxy : x = y
    · subst y
      have hdiag : F x x = 0 := flow_self_eq_zero hF.antisymm x
      simp [hdiag]
    · exact mul_nonneg (sq_nonneg _) (le_of_lt (hR hxy))
  nlinarith

/-- Helper for Theorem 19.22: if a flow has zero energy in a strictly positive resistance
network, then the flow itself is zero. -/
private theorem flow_eq_zero_of_energyDissipation_eq_zero
    {A : Set E} {D : E → E → ℝ}
    (hR : ∀ ⦃x y : E⦄, x ≠ y → 0 < R x y)
    (hD : IsFlowOutside A D)
    (hEnergy : ℒ(D; R) = 0) :
    D = 0 := by
  classical
  have hterm_nonneg : ∀ x y : E, 0 ≤ D x y ^ 2 * R x y := by
    intro x y
    by_cases hxy : x = y
    · subst y
      have hdiag : D x x = 0 := flow_self_eq_zero hD.antisymm x
      simp [hdiag]
    · exact mul_nonneg (sq_nonneg _) (le_of_lt (hR hxy))
  have hsum_nonneg : 0 ≤ ∑ x : E, ∑ y : E, D x y ^ 2 * R x y := by
    refine Finset.sum_nonneg fun x _ ↦ ?_
    exact Finset.sum_nonneg fun y _ ↦ hterm_nonneg x y
  -- Zero energy forces the whole quadratic sum to vanish.
  have hsum_zero : ∑ x : E, ∑ y : E, D x y ^ 2 * R x y = 0 := by
    rw [energyDissipation_def] at hEnergy
    nlinarith
  -- A nonzero coefficient would contribute a strictly positive summand.
  -- That is impossible when the total quadratic sum is zero.
  by_contra hDzero
  have hexists : ∃ x y : E, D x y ≠ 0 := by
    by_contra hnone
    apply hDzero
    funext x y
    by_contra hxy
    exact hnone ⟨x, y, hxy⟩
  rcases hexists with ⟨x, y, hxy0⟩
  have hxy : x ≠ y := by
    intro hxy_eq
    subst y
    exact hxy0 (flow_self_eq_zero hD.antisymm x)
  have hterm_pos : 0 < D x y ^ 2 * R x y := by
    exact mul_pos (sq_pos_of_ne_zero hxy0) (hR hxy)
  have hinner_le :
      D x y ^ 2 * R x y ≤ ∑ y' : E, D x y' ^ 2 * R x y' := by
    simpa using
      (Finset.single_le_sum (fun y' _ ↦ hterm_nonneg x y') (Finset.mem_univ y))
  have houter_le :
      ∑ y' : E, D x y' ^ 2 * R x y' ≤ ∑ x' : E, ∑ y' : E, D x' y' ^ 2 * R x' y' := by
    simpa using
      (Finset.single_le_sum
        (fun x' _ ↦ Finset.sum_nonneg fun y' _ ↦ hterm_nonneg x' y')
        (Finset.mem_univ x))
  have hsum_pos : 0 < ∑ x' : E, ∑ y' : E, D x' y' ^ 2 * R x' y' :=
    lt_of_lt_of_le hterm_pos (le_trans hinner_le houter_le)
  linarith

-- Proof sketch: let `D = J - I`. Expanding `ℒ(J; R)` gives the energy of the unit current flow
-- `I`, the error term `(1 / 2) * ∑ x, ∑ y, D x y ^ 2 * R x y`, and a mixed term. The positivity
-- hypothesis on `R` makes the error term nonnegative, while Theorem 19.20 applied to the unit
-- flow `D`, together with the boundary-constant potential witness for `I`, shows that the mixed
-- term vanishes.
/-- Theorem 19.22: among all unit flows from `A1` to `A0`, a unit current flow `I` with a
boundary-constant potential witness minimizes the energy dissipation `ℒ(I; R)` for a strictly
positive resistance network. -/
theorem unit_current_flow_minimizes_energyDissipation
    (hR : ∀ ⦃x y : E⦄, x ≠ y → 0 < R x y)
    (hI : IsUnitFlowFromTo A1 A0 I)
    {u : E → ℝ}
    (hOhm : ∀ ⦃x y : E⦄, x ≠ y → I x y = (u x - u y) / R x y)
    {u0 u1 : ℝ}
    (hu0 : Set.EqOn u (fun _ : E ↦ u0) A0)
    (hu1 : Set.EqOn u (fun _ : E ↦ u1) A1)
    (hJ : IsUnitFlowFromTo A1 A0 J) :
    ℒ(I; R) ≤ ℒ(J; R) := by
  -- Route correction: the proof is organized around the difference flow `J - I` so that
  -- Theorem 19.20 removes the mixed term and leaves a nonnegative quadratic remainder.
  have hdecomp := energyDissipation_sub_decomposition
    (hR := hR) (hI := hI) (hOhm := hOhm) J
  have hmixed :
      ∑ x : E, ∑ y : E, (u x - u y) * (J x y - I x y) = 0 :=
    sub_unitFlow_mixed_term_eq_zero (hI := hI) (hJ := hJ) hu0 hu1
  have hdiff_nonneg :
      0 ≤ ℒ((fun x y ↦ J x y - I x y); R) :=
    energyDissipation_nonneg_of_flow (hR := hR)
      (sub_unitFlow_isFlowOutside (hI := hI) (hJ := hJ))
  -- After the mixed term vanishes, only the nonnegative error energy remains.
  linarith [hdecomp, hmixed, hdiff_nonneg]

-- Proof sketch: combine the minimizing inequality with the quadratic expansion from the proof of
-- Theorem 19.22. Equality of the energies forces the nonnegative error term `ℒ(J - I; R)` to
-- vanish, hence `J = I`; the converse is immediate.
/-- Equality in Thomson's variational principle for a strictly positive resistance network occurs
exactly when the competing unit flow agrees with the minimizing unit current flow `I`. -/
theorem unit_current_flow_energyDissipation_eq_iff
    (hR : ∀ ⦃x y : E⦄, x ≠ y → 0 < R x y)
    (hI : IsUnitFlowFromTo A1 A0 I)
    {u : E → ℝ}
    (hOhm : ∀ ⦃x y : E⦄, x ≠ y → I x y = (u x - u y) / R x y)
    {u0 u1 : ℝ}
    (hu0 : Set.EqOn u (fun _ : E ↦ u0) A0)
    (hu1 : Set.EqOn u (fun _ : E ↦ u1) A1)
    (hJ : IsUnitFlowFromTo A1 A0 J) :
    ℒ(I; R) = ℒ(J; R) ↔ I = J := by
  constructor
  · intro hEq
    have hdecomp := energyDissipation_sub_decomposition
      (hR := hR) (hI := hI) (hOhm := hOhm) J
    have hmixed :
        ∑ x : E, ∑ y : E, (u x - u y) * (J x y - I x y) = 0 :=
      sub_unitFlow_mixed_term_eq_zero (hI := hI) (hJ := hJ) hu0 hu1
    -- Equality of energies forces the quadratic error term to vanish.
    have hdiff_zero : ℒ((fun x y ↦ J x y - I x y); R) = 0 := by
      linarith [hEq, hdecomp, hmixed]
    have hzero :
        (fun x y ↦ J x y - I x y) = 0 :=
      flow_eq_zero_of_energyDissipation_eq_zero (hR := hR)
        (hD := sub_unitFlow_isFlowOutside (hI := hI) (hJ := hJ))
        hdiff_zero
    -- A vanishing difference flow means that `I` and `J` agree pointwise.
    funext x y
    have hxy : J x y - I x y = 0 := by
      simpa using congrFun (congrFun hzero x) y
    linarith
  · intro hIJ
    subst J
    rfl

-- Proof sketch: apply `unit_current_flow_minimizes_energyDissipation` once with minimizer `I` and
-- competitor `J`, and once with minimizer `J` and competitor `I`. The two inequalities force
-- equality of the energies, and
-- `unit_current_flow_energyDissipation_eq_iff` then identifies the flows.
/-- Any two unit current flows between the same boundary sets in the same strictly positive
resistance network coincide. -/
theorem unit_current_flow_unique
    (hR : ∀ ⦃x y : E⦄, x ≠ y → 0 < R x y)
    (hI : IsUnitFlowFromTo A1 A0 I)
    {u : E → ℝ}
    (hOhmI : ∀ ⦃x y : E⦄, x ≠ y → I x y = (u x - u y) / R x y)
    {u0 u1 : ℝ}
    (hu0 : Set.EqOn u (fun _ : E ↦ u0) A0)
    (hu1 : Set.EqOn u (fun _ : E ↦ u1) A1)
    (hJ : IsUnitFlowFromTo A1 A0 J)
    {v : E → ℝ}
    (hOhmJ : ∀ ⦃x y : E⦄, x ≠ y → J x y = (v x - v y) / R x y)
    {v0 v1 : ℝ}
    (hv0 : Set.EqOn v (fun _ : E ↦ v0) A0)
    (hv1 : Set.EqOn v (fun _ : E ↦ v1) A1) :
    I = J := by
  -- Each current flow minimizes the same energy, so the two energies must coincide.
  have hIJ : ℒ(I; R) ≤ ℒ(J; R) :=
    unit_current_flow_minimizes_energyDissipation
      (hR := hR) (hI := hI) (hOhm := hOhmI) (hu0 := hu0) (hu1 := hu1) (hJ := hJ)
  have hJI : ℒ(J; R) ≤ ℒ(I; R) :=
    unit_current_flow_minimizes_energyDissipation
      (hR := hR) (hI := hJ) (hOhm := hOhmJ) (hu0 := hv0) (hu1 := hv1) (hJ := hI)
  have hEq : ℒ(I; R) = ℒ(J; R) := le_antisymm hIJ hJI
  -- Equality in the minimizing principle identifies the two flows.
  exact (unit_current_flow_energyDissipation_eq_iff
    (hR := hR) (hI := hI) (hOhm := hOhmI) (hu0 := hu0) (hu1 := hu1) (hJ := hJ)).mp hEq

end

end ProbabilityTheory
