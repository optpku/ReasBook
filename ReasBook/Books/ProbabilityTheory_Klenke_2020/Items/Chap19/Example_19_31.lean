/-- Helper for Example 19.31: the geometric resistance series in the dyadic-tree sketch has the
closed form `3`. -/
private theorem geometricResistanceClosedForm :
    ∑' k : ℕ, (((2 : ℝ≥0∞) / 3) ^ k) = 3 := by
  -- Proof comment: this is the ENNReal geometric series with ratio `2 / 3`.
  rw [ENNReal.tsum_geometric]
  have hone_sub : 1 - ((2 : ℝ≥0∞) / 3) = (1 / 3 : ℝ≥0∞) := by
    have hone_sub' : (1 / 3 : ℝ≥0∞) = 1 - ((2 : ℝ≥0∞) / 3) := by
      refine ENNReal.eq_sub_of_add_eq ?_ ?_
      ·
        exact ENNReal.div_ne_top (by simp) (by norm_num)
      ·
        calc
          (1 / (3 : ℝ≥0∞)) + 2 / 3
              = (1 : ℝ≥0∞) * (3 : ℝ≥0∞)⁻¹ + 2 * (3 : ℝ≥0∞)⁻¹ := by
                  rw [show (1 / (3 : ℝ≥0∞)) = (1 : ℝ≥0∞) * (3 : ℝ≥0∞)⁻¹ by
                        simp [one_div],
                      show ((2 : ℝ≥0∞) / 3) = 2 * (3 : ℝ≥0∞)⁻¹ by
                        simp [div_eq_mul_inv]]
          _ = ((1 : ℝ≥0∞) + 2) * (3 : ℝ≥0∞)⁻¹ := by rw [add_mul]
          _ = 3 * (3 : ℝ≥0∞)⁻¹ := by norm_num
          _ = 1 := by
              rw [ENNReal.mul_inv_cancel]
              · simp
              · norm_num
    exact hone_sub'.symm
  rw [hone_sub]
  rw [show (1 / (3 : ℝ≥0∞)) = (3 : ℝ≥0∞)⁻¹ by norm_num]
  simp

/-- Helper for Example 19.31: a translation-invariant lattice step matrix is the convolution
kernel generated by its row at the origin. -/
private theorem translationInvariantKernel_eq_originRowKernel
    (p : (Fin 3 → ℤ) → (Fin 3 → ℤ) → ℝ≥0∞)
    (hp : IsTranslationInvariantStepMatrix p)
    [IsMarkovKernel (discreteMatrixKernel p)] :
    discreteMatrixKernel p = dirac_convolution_kernel ((discreteMatrixKernel p 0).toPMF.toMeasure) := by
  ext x s hs
  have hrow :
      discreteMatrixKernel p x =
        dirac_convolution_kernel ((discreteMatrixKernel p 0).toPMF.toMeasure) x := by
    refine Measure.ext_of_singleton ?_
    intro y
    -- Proof comment: translation invariance says every singleton mass is the translated origin-row
    -- mass at `y - x`.
    rw [discreteMatrixKernel_apply, Measure.sum_apply _ (measurableSet_singleton y)]
    rw [tsum_eq_single y]
    · rw [dirac_convolution_kernel_apply, Measure.dirac_conv]
      rw [Measure.map_apply (by fun_prop) (measurableSet_singleton y)]
      have hpreimage :
          (fun z : Fin 3 → ℤ ↦ x + z) ⁻¹' ({y} : Set (Fin 3 → ℤ)) = {y - x} := by
        ext z
        simp only [Set.mem_preimage, Set.mem_singleton_iff]
        constructor
        · intro hz
          exact eq_sub_iff_add_eq.mpr (by simpa [add_comm] using hz)
        · intro hz
          exact by simpa [add_comm] using (eq_sub_iff_add_eq.mp hz)
      rw [hpreimage, Measure.toPMF_toMeasure]
      rw [discreteMatrixKernel_apply, Measure.sum_apply _ (measurableSet_singleton (y - x))]
      rw [tsum_eq_single (y - x)]
      · simp [hp x y]
      · intro z hz
        simp [Measure.smul_apply, Measure.dirac_apply', hz]
    · intro z hz
      simp [Measure.smul_apply, Measure.dirac_apply', hz]
  exact congrArg (fun μ ↦ μ s) hrow

/-- Helper for Example 19.31: evaluating the origin-row PMF identity at a state gives the
pointwise step-law equality required by Theorem 17.39. -/
private theorem originRow_eq_symmetricSimpleRandomWalkStepPMF_apply
    (p : (Fin 3 → ℤ) → PMF (Fin 3 → ℤ))
    (hstep : p 0 = symmetricSimpleRandomWalkStepPMF 3) :
    ∀ y : Fin 3 → ℤ, p 0 y = symmetricSimpleRandomWalkStepPMF 3 y := by
  intro y
  -- Proof comment: evaluate the PMF equality `hstep` at the specific lattice state `y`.
  simpa using congrArg (fun q ↦ q y) hstep

/-- Helper for Example 19.31: the discrete kernel attached to a PMF-valued step matrix has row
measure `(p x).toMeasure` at the state `x`. -/
private theorem discreteMatrixKernel_row_eq_toMeasure
    (p : (Fin 3 → ℤ) → PMF (Fin 3 → ℤ)) (x : Fin 3 → ℤ) :
    discreteMatrixKernel (fun a b ↦ p a b) x = (p x).toMeasure := by
  refine Measure.ext_of_singleton ?_
  intro y
  -- Proof comment: on the discrete lattice, equality of row measures is determined by singleton
  -- masses, and only the `y`-summand survives on `{y}`.
  rw [discreteMatrixKernel_apply, Measure.sum_apply _ (measurableSet_singleton y)]
  rw [tsum_eq_single y]
  · rw [PMF.toMeasure_apply_singleton _ _ (measurableSet_singleton y)]
    simp [Measure.smul_apply]
  · intro z hz
    simp [Measure.smul_apply, Measure.dirac_apply', hz]

/-- Helper for Example 19.31: the current translation-invariant step matrix already equals the
canonical convolution kernel generated by `symmetricSimpleRandomWalkStepPMF 3`. -/
private theorem currentStepKernel_eq_symmetricSimpleRandomWalkKernel
    (p : (Fin 3 → ℤ) → PMF (Fin 3 → ℤ))
    (hp : IsTranslationInvariantStepMatrix (fun x y ↦ p x y))
    (hstep : p 0 = symmetricSimpleRandomWalkStepPMF 3) :
    discreteMatrixKernel (fun x y ↦ p x y) =
      dirac_convolution_kernel (symmetricSimpleRandomWalkStepPMF 3).toMeasure := by
  have hstep_apply := originRow_eq_symmetricSimpleRandomWalkStepPMF_apply p hstep
  -- Proof comment: translation invariance rewrites the mass at `(x,y)` to the origin-row mass at
  -- `y - x`, and the origin row is exactly the canonical symmetric nearest-neighbor step law.
  ext x s hs
  have hrow :
      discreteMatrixKernel (fun x y ↦ p x y) x =
        dirac_convolution_kernel (symmetricSimpleRandomWalkStepPMF 3).toMeasure x := by
    refine Measure.ext_of_singleton ?_
    intro y
    rw [discreteMatrixKernel_apply, Measure.sum_apply _ (measurableSet_singleton y)]
    rw [tsum_eq_single y]
    · rw [dirac_convolution_kernel_apply, Measure.dirac_conv]
      rw [Measure.map_apply (by fun_prop) (measurableSet_singleton y)]
      have hpreimage :
          (fun z : Fin 3 → ℤ ↦ x + z) ⁻¹' ({y} : Set (Fin 3 → ℤ)) = {y - x} := by
        ext z
        simp only [Set.mem_preimage, Set.mem_singleton_iff]
        constructor
        · intro hz
          exact eq_sub_iff_add_eq.mpr (by simpa [add_comm] using hz)
        · intro hz
          exact by simpa [add_comm] using (eq_sub_iff_add_eq.mp hz)
      rw [hpreimage, PMF.toMeasure_apply_singleton _ _ (measurableSet_singleton (y - x))]
      simpa [hp x y] using hstep_apply (y - x)
    · intro z hz
      simp [Measure.smul_apply, Measure.dirac_apply', hz]
  exact congrArg (fun μ ↦ μ s) hrow

/-- Helper for Example 19.31: `latticeConvolutionStepMatrix ν` records the singleton masses of
the convolution kernel generated by `ν`. -/
private def latticeConvolutionStepMatrix {d : ℕ} (ν : PMF (LatticePoint d)) :
    LatticePoint d → LatticePoint d → ℝ≥0∞ :=
  fun x y ↦ dirac_convolution_kernel ν.toMeasure x {y}

/-- Helper for Example 19.31: the lattice convolution step matrix is translation invariant. -/
private theorem latticeConvolutionStepMatrix_isTranslationInvariant {d : ℕ}
    (ν : PMF (LatticePoint d)) :
    IsTranslationInvariantStepMatrix (latticeConvolutionStepMatrix ν) := by
  intro x y
  -- Proof comment: both singleton masses are evaluations of the same step law at the translated
  -- increment `y - x`.
  change dirac_convolution_kernel ν.toMeasure x ({y} : Set (LatticePoint d)) =
    dirac_convolution_kernel ν.toMeasure 0 ({y - x} : Set (LatticePoint d))
  rw [dirac_convolution_kernel_apply, Measure.dirac_conv]
  rw [Measure.map_apply (by fun_prop) (measurableSet_singleton y)]
  have hpreimage :
      (fun z : LatticePoint d ↦ x + z) ⁻¹' ({y} : Set (LatticePoint d)) = {y - x} := by
    ext z
    simp only [Set.mem_preimage, Set.mem_singleton_iff]
    constructor
    · intro hz
      exact eq_sub_iff_add_eq.mpr (by simpa [add_comm] using hz)
    · intro hz
      exact by simpa [add_comm] using (eq_sub_iff_add_eq.mp hz)
  rw [hpreimage, dirac_convolution_kernel_apply, Measure.dirac_conv]
  rw [Measure.map_apply (by fun_prop) (measurableSet_singleton (y - x))]
  simp

/-- Helper for Example 19.31: once the origin row is fixed to
`symmetricSimpleRandomWalkStepPMF 3`, the whole current matrix is the canonical lattice
convolution step matrix. -/
private theorem currentStepMatrix_eq_latticeConvolutionStepMatrix
    (p : (Fin 3 → ℤ) → PMF (Fin 3 → ℤ))
    (hp : IsTranslationInvariantStepMatrix (fun x y ↦ p x y))
    (hstep : p 0 = symmetricSimpleRandomWalkStepPMF 3) :
    (fun x y : Fin 3 → ℤ ↦ p x y) =
      latticeConvolutionStepMatrix (symmetricSimpleRandomWalkStepPMF 3) := by
  funext x y
  have hrow :=
    congrArg
      (fun κ : Kernel (Fin 3 → ℤ) (Fin 3 → ℤ) ↦ κ x)
      (currentStepKernel_eq_symmetricSimpleRandomWalkKernel (p := p) hp hstep)
  have hxy := congrArg (fun μ : Measure (Fin 3 → ℤ) ↦ μ ({y} : Set (Fin 3 → ℤ))) hrow
  -- Proof comment: equality of the one-step rows on the singleton `{y}` recovers the pointwise
  -- transition-matrix equality.
  simpa [discreteMatrixKernel_row_eq_toMeasure (p := p) (x := x),
    PMF.toMeasure_apply_singleton _ _ (measurableSet_singleton y), latticeConvolutionStepMatrix]
    using hxy

-- Proof sketch: sum the geometric series with ratio `2 / 3`; the sum is `3`, and the prefactor
-- `1 / 3` reduces the value to `1`.
/-- The resistance series of the dyadically branching subtree used in the `ℤ^3` transience
argument has value `1`. -/
theorem dyadicTreeResistanceSeries_eq_one :
    (1 / (3 : ℝ≥0∞)) * ∑' k : ℕ, (((2 : ℝ≥0∞) / 3) ^ k) = 1 := by
  -- Proof comment: substitute the closed form of the geometric series and simplify the scalar
  -- factor.
  rw [geometricResistanceClosedForm]
  rw [show (1 / (3 : ℝ≥0∞)) = (3 : ℝ≥0∞)⁻¹ by norm_num]
  rw [ENNReal.inv_mul_cancel]
  · simp
  · norm_num

/-- Helper for Example 19.31: the conductance walk on the cubic lattice is the normalized unit
nearest-neighbor walk. -/
private abbrev cubicLatticeTransitionMatrix : LatticePoint 3 → LatticePoint 3 → ℝ≥0∞ :=
  conductanceTransitionMatrix (simpleGraphWeights (latticeGraph 3))

/-- Helper for Example 19.31: cubic-lattice adjacency depends only on the increment `y - x`. -/
private theorem cubicLattice_adj_sub_iff (x y : LatticePoint 3) :
    (latticeGraph 3).Adj x y ↔ (latticeGraph 3).Adj 0 (y - x) := by
  rw [latticeGraph_adj_iff, latticeGraph_adj_iff]
  constructor
  · rintro ⟨i, hi, hsame⟩
    refine ⟨i, ?_, ?_⟩
    · -- Proof comment: translating the edge to the origin preserves the distinguished
      -- coordinate difference.
      change Int.natAbs (0 - (y i - x i)) = 1
      have hdiff : (0 : ℤ) - (y i - x i) = x i - y i := by
        omega
      rw [hdiff]
      exact hi
    · intro j hj
      -- Proof comment: the nondistinguished coordinates agree before and after translation.
      change (0 : ℤ) = y j - x j
      have hxy : x j = y j := hsame j hj
      have hzero : y j - x j = 0 := by
        omega
      simpa using hzero.symm
  · rintro ⟨i, hi, hsame⟩
    refine ⟨i, ?_, ?_⟩
    · -- Proof comment: translating the origin-based increment back to `x` recovers the original
      -- edge difference.
      change Int.natAbs (x i - y i) = 1
      have hdiff : x i - y i = (0 : ℤ) - (y i - x i) := by
        omega
      rw [hdiff]
      exact hi
    · intro j hj
      -- Proof comment: a zero translated increment away from `i` forces coordinate equality.
      have hzero : (0 : ℤ) = y j - x j := by
        change (0 : ℤ) = (y - x) j
        simpa using hsame j hj
      omega

/-- Helper for Example 19.31: unit cubic-lattice weights are translation invariant. -/
private theorem cubicLatticeWeight_translationInvariant (x y : LatticePoint 3) :
    simpleGraphWeights (latticeGraph 3) x y =
      simpleGraphWeights (latticeGraph 3) 0 (y - x) := by
  -- Proof comment: unit edge weights are adjacency indicators, and adjacency only depends on
  -- the translated increment.
  simp [simpleGraphWeights, cubicLattice_adj_sub_iff]

/-- Helper for Example 19.31: from the origin, cubic-lattice adjacency is exactly one of the six
cardinal unit steps. -/
private theorem cubicLattice_adj_zero_iff (y : LatticePoint 3) :
    (latticeGraph 3).Adj 0 y ↔
      y = Pi.single 0 (1 : ℤ) ∨
        y = Pi.single 0 (-1 : ℤ) ∨
          y = Pi.single 1 (1 : ℤ) ∨
            y = Pi.single 1 (-1 : ℤ) ∨
              y = Pi.single 2 (1 : ℤ) ∨
                y = Pi.single 2 (-1 : ℤ) := by
  rw [latticeGraph_adj_iff]
  constructor
  · rintro ⟨i, hi, hsame⟩
    rcases Int.natAbs_eq_iff.mp hi with hdiff | hdiff
    · have hy : y = Pi.single i (-1 : ℤ) := by
        ext j
        by_cases hj : j = i
        · subst hj
          simp at hdiff ⊢
          omega
        · have hcoord : y j = 0 := by simpa using (hsame j hj).symm
          simp [hj, hcoord]
      fin_cases i
      · exact Or.inr <| Or.inl hy
      · exact Or.inr <| Or.inr <| Or.inr <| Or.inl hy
      · exact Or.inr <| Or.inr <| Or.inr <| Or.inr <| Or.inr hy
    · have hy : y = Pi.single i (1 : ℤ) := by
        ext j
        by_cases hj : j = i
        · subst hj
          simp at hdiff ⊢
          omega
        · have hcoord : y j = 0 := by simpa using (hsame j hj).symm
          simp [hj, hcoord]
      fin_cases i
      · exact Or.inl hy
      · exact Or.inr <| Or.inr <| Or.inl hy
      · exact Or.inr <| Or.inr <| Or.inr <| Or.inr <| Or.inl hy
  · rintro (rfl | rfl | rfl | rfl | rfl | rfl)
    · refine ⟨0, by simp, ?_⟩
      intro j hj
      fin_cases j
      · exact (hj rfl).elim
      · simp
      · simp
    · refine ⟨0, by simp, ?_⟩
      intro j hj
      fin_cases j
      · exact (hj rfl).elim
      · simp
      · simp
    · refine ⟨1, by simp, ?_⟩
      intro j hj
      fin_cases j
      · simp
      · exact (hj rfl).elim
      · simp
    · refine ⟨1, by simp, ?_⟩
      intro j hj
      fin_cases j
      · simp
      · exact (hj rfl).elim
      · simp
    · refine ⟨2, by simp, ?_⟩
      intro j hj
      fin_cases j
      · simp
      · simp
      · exact (hj rfl).elim
    · refine ⟨2, by simp, ?_⟩
      intro j hj
      fin_cases j
      · simp
      · simp
      · exact (hj rfl).elim

/-- Helper for Example 19.31: the origin of the cubic lattice has total unit conductance `6`. -/
private theorem cubicLatticeConductance_zero :
    conductance (simpleGraphWeights (latticeGraph 3)) 0 = 6 := by
  let dirs : Finset (LatticePoint 3) :=
    {Pi.single 0 (1 : ℤ), Pi.single 0 (-1 : ℤ), Pi.single 1 (1 : ℤ), Pi.single 1 (-1 : ℤ),
      Pi.single 2 (1 : ℤ), Pi.single 2 (-1 : ℤ)}
  have hzero :
      ∀ y : LatticePoint 3, y ∉ dirs → simpleGraphWeights (latticeGraph 3) 0 y = 0 := by
    intro y hy
    have hNotAdj : ¬ (latticeGraph 3).Adj 0 y := by
      intro hadj
      rcases (cubicLattice_adj_zero_iff y).1 hadj with hy' | hy' | hy' | hy' | hy' | hy'
      · exact hy (by simp [dirs, hy'])
      · exact hy (by simp [dirs, hy'])
      · exact hy (by simp [dirs, hy'])
      · exact hy (by simp [dirs, hy'])
      · exact hy (by simp [dirs, hy'])
      · exact hy (by simp [dirs, hy'])
    -- Proof comment: outside the six cardinal directions, the unit edge weight vanishes.
    simp [simpleGraphWeights, hNotAdj]
  have hadjPos0 : (latticeGraph 3).Adj 0 (Pi.single 0 (1 : ℤ)) := by
    exact (cubicLattice_adj_zero_iff _).2 (by left; rfl)
  have hadjNeg0 : (latticeGraph 3).Adj 0 (Pi.single 0 (-1 : ℤ)) := by
    exact (cubicLattice_adj_zero_iff _).2 (by right; left; rfl)
  have hadjPos1 : (latticeGraph 3).Adj 0 (Pi.single 1 (1 : ℤ)) := by
    exact (cubicLattice_adj_zero_iff _).2 (by right; right; left; rfl)
  have hadjNeg1 : (latticeGraph 3).Adj 0 (Pi.single 1 (-1 : ℤ)) := by
    exact (cubicLattice_adj_zero_iff _).2 (by right; right; right; left; rfl)
  have hadjPos2 : (latticeGraph 3).Adj 0 (Pi.single 2 (1 : ℤ)) := by
    exact (cubicLattice_adj_zero_iff _).2 (by right; right; right; right; left; rfl)
  have hadjNeg2 : (latticeGraph 3).Adj 0 (Pi.single 2 (-1 : ℤ)) := by
    exact (cubicLattice_adj_zero_iff _).2 (by right; right; right; right; right; rfl)
  -- Proof comment: only the six cardinal neighbors contribute, and each contributing weight is
  -- exactly `1`.
  rw [conductance, tsum_eq_sum (s := dirs) hzero]
  have hadjDir : ∀ z : LatticePoint 3, z ∈ dirs → (latticeGraph 3).Adj 0 z := by
    intro z hz
    rcases Finset.mem_insert.1 hz with rfl | hz
    · exact hadjPos0
    rcases Finset.mem_insert.1 hz with rfl | hz
    · exact hadjNeg0
    rcases Finset.mem_insert.1 hz with rfl | hz
    · exact hadjPos1
    rcases Finset.mem_insert.1 hz with rfl | hz
    · exact hadjNeg1
    rcases Finset.mem_insert.1 hz with rfl | hz
    · exact hadjPos2
    rcases Finset.mem_singleton.1 hz with rfl
    exact hadjNeg2
  have hdirs : dirs.card = 6 := by
    decide
  have hsumSimple :
      dirs.sum (fun b ↦ simpleGraphWeights (latticeGraph 3) 0 b) =
        dirs.sum (fun _ ↦ (1 : ℝ≥0∞)) := by
    refine Finset.sum_congr rfl ?_
    intro b hb
    simp [simpleGraphWeights, hadjDir b hb]
  have hsumCard : dirs.sum (fun _ ↦ (1 : ℝ≥0∞)) = dirs.card := by
    simp
  simpa using hsumSimple.trans <| hsumCard.trans <| by
    exact_mod_cast hdirs

/-- Helper for Example 19.31: every cubic-lattice vertex has total unit conductance `6`. -/
private theorem cubicLatticeConductance_eq_six (x : LatticePoint 3) :
    conductance (simpleGraphWeights (latticeGraph 3)) x = 6 := by
  rw [conductance]
  have hshift :
      ∑' y : LatticePoint 3, simpleGraphWeights (latticeGraph 3) x y =
        ∑' y : LatticePoint 3, simpleGraphWeights (latticeGraph 3) x (y + x) := by
    simpa [Equiv.coe_addRight] using
      ((Equiv.addRight x).tsum_eq
        (f := fun y : LatticePoint 3 ↦ simpleGraphWeights (latticeGraph 3) x y)).symm
  rw [hshift]
  -- Proof comment: translating the whole row by `x` reduces it to the already computed origin
  -- row.
  have hpoint :
      (fun y : LatticePoint 3 ↦ simpleGraphWeights (latticeGraph 3) x (y + x)) =
        fun y : LatticePoint 3 ↦ simpleGraphWeights (latticeGraph 3) 0 y := by
    funext y
    rw [cubicLatticeWeight_translationInvariant]
    simp [sub_eq_add_neg, add_assoc, add_comm]
  rw [hpoint]
  exact cubicLatticeConductance_zero

/-- Helper for Example 19.31: the cubic-lattice conductance walk is translation invariant. -/
private theorem cubicLatticeKernel_translationInvariant :
    IsTranslationInvariantStepMatrix cubicLatticeTransitionMatrix := by
  intro x y
  -- Proof comment: the normalized transition entry depends only on the translated unit weight,
  -- and every row has the same conductance `6`.
  change
    conductanceTransitionMatrix (simpleGraphWeights (latticeGraph 3)) x y =
      conductanceTransitionMatrix (simpleGraphWeights (latticeGraph 3)) 0 (y - x)
  rw [conductanceTransitionMatrix_apply, conductanceTransitionMatrix_apply,
    cubicLatticeConductance_eq_six x, cubicLatticeConductance_eq_six 0,
    cubicLatticeWeight_translationInvariant]

/-- Helper for Example 19.31: at the origin, the cubic-lattice conductance walk is the adjacency
indicator normalized by `6`. -/
private theorem cubicLatticeKernel_row_zero (y : LatticePoint 3) :
    cubicLatticeTransitionMatrix 0 y =
      if (latticeGraph 3).Adj 0 y then 1 / 6 else 0 := by
  -- Proof comment: the origin row is the unit adjacency indicator divided by the total
  -- conductance `6`.
  change
    conductanceTransitionMatrix (simpleGraphWeights (latticeGraph 3)) 0 y =
      if (latticeGraph 3).Adj 0 y then 1 / 6 else 0
  rw [conductanceTransitionMatrix_apply, cubicLatticeConductance_eq_six 0]
  by_cases hy : (latticeGraph 3).Adj 0 y
  · simp [simpleGraphWeights, hy]
  · simp [simpleGraphWeights, hy]

/-- Helper for Example 19.31: the cubic-lattice origin row vanishes away from the six cardinal
unit vectors. -/
private theorem cubicLatticeKernel_row_zero_eq_zero_of_not_cardinal
    (y : LatticePoint 3)
    (hy :
      y ∉ ({Pi.single 0 (1 : ℤ), Pi.single 0 (-1 : ℤ), Pi.single 1 (1 : ℤ),
        Pi.single 1 (-1 : ℤ), Pi.single 2 (1 : ℤ), Pi.single 2 (-1 : ℤ)} :
          Finset (LatticePoint 3))) :
    cubicLatticeTransitionMatrix 0 y = 0 := by
  have hNotAdj : ¬ (latticeGraph 3).Adj 0 y := by
    intro hadj
    rcases (cubicLattice_adj_zero_iff y).1 hadj with hy' | hy' | hy' | hy' | hy' | hy'
    · exact hy (by simp [hy'])
    · exact hy (by simp [hy'])
    · exact hy (by simp [hy'])
    · exact hy (by simp [hy'])
    · exact hy (by simp [hy'])
    · exact hy (by simp [hy'])
  -- Proof comment: away from the six allowed increments, the normalized adjacency indicator is
  -- zero.
  rw [cubicLatticeKernel_row_zero]
  simp [hNotAdj]

/-- Helper for Example 19.31: each of the six cardinal neighbors of the origin has transition
mass `1 / 6` for the cubic-lattice conductance walk. -/
private theorem cubicLatticeKernel_row_zero_eq_sixth_of_cardinal
    (y : LatticePoint 3)
    (hy :
      y = Pi.single 0 (1 : ℤ) ∨
        y = Pi.single 0 (-1 : ℤ) ∨
          y = Pi.single 1 (1 : ℤ) ∨
            y = Pi.single 1 (-1 : ℤ) ∨
              y = Pi.single 2 (1 : ℤ) ∨
                y = Pi.single 2 (-1 : ℤ)) :
    cubicLatticeTransitionMatrix 0 y = 1 / 6 := by
  have hadj : (latticeGraph 3).Adj 0 y := (cubicLattice_adj_zero_iff y).2 hy
  -- Proof comment: the direct origin-row formula specializes to `1 / 6` on each cardinal step.
  rw [cubicLatticeKernel_row_zero]
  simp [hadj]

/-- Helper for Example 19.31: nonzero single-coordinate steps on different coordinates are
distinct. -/
private theorem cubicLattice_single_ne_single_of_ne
    {i j : Fin 3} (hij : i ≠ j) {m n : ℤ} (hm : m ≠ 0) :
    (Pi.single i m : LatticePoint 3) ≠ Pi.single j n := by
  intro hEq
  have hcoord : (Pi.single i m : LatticePoint 3) i = (Pi.single j n : LatticePoint 3) i :=
    congrArg (fun z : LatticePoint 3 ↦ z i) hEq
  simp [hij, hm] at hcoord

/-- Helper for Example 19.31: the symmetric simple random-walk step law on `ℤ^3` assigns mass
`1 / 6` to each cardinal unit step. -/
private theorem symmetricSimpleRandomWalkStepPMF_apply_cardinal
    (y : LatticePoint 3)
    (hy :
      y = Pi.single 0 (1 : ℤ) ∨
        y = Pi.single 0 (-1 : ℤ) ∨
          y = Pi.single 1 (1 : ℤ) ∨
            y = Pi.single 1 (-1 : ℤ) ∨
              y = Pi.single 2 (1 : ℤ) ∨
                y = Pi.single 2 (-1 : ℤ)) :
    symmetricSimpleRandomWalkStepPMF 3 y = 1 / 6 := by
  rcases hy with rfl | rfl | rfl | rfl | rfl | rfl
  · -- Proof comment: only the witness `(true, 0)` contributes to the positive first-coordinate
    -- step under the uniform `Bool × Fin 3` law.
    rw [symmetricSimpleRandomWalkStepPMF, PMF.map_apply, tsum_fintype, Fintype.sum_prod_type,
      Fintype.sum_bool]
    rw [Fin.sum_univ_three, Fin.sum_univ_three]
    have h01 : (Pi.single 0 (1 : ℤ) : LatticePoint 3) ≠ Pi.single 1 (1 : ℤ) :=
      cubicLattice_single_ne_single_of_ne (i := 0) (j := 1) (by decide) (m := 1) (n := 1)
        (by norm_num)
    have h0n1 : (Pi.single 0 (1 : ℤ) : LatticePoint 3) ≠ Pi.single 1 (-1 : ℤ) :=
      cubicLattice_single_ne_single_of_ne (i := 0) (j := 1) (by decide) (m := 1) (n := -1)
        (by norm_num)
    have h02 : (Pi.single 0 (1 : ℤ) : LatticePoint 3) ≠ Pi.single 2 (1 : ℤ) :=
      cubicLattice_single_ne_single_of_ne (i := 0) (j := 2) (by decide) (m := 1) (n := 1)
        (by norm_num)
    have h0n2 : (Pi.single 0 (1 : ℤ) : LatticePoint 3) ≠ Pi.single 2 (-1 : ℤ) :=
      cubicLattice_single_ne_single_of_ne (i := 0) (j := 2) (by decide) (m := 1) (n := -1)
        (by norm_num)
    simp [PMF.uniformOfFintype_apply, h01, h0n1, h02, h0n2]
  · -- Proof comment: only the witness `(false, 0)` contributes to the negative first-coordinate
    -- step.
    rw [symmetricSimpleRandomWalkStepPMF, PMF.map_apply, tsum_fintype, Fintype.sum_prod_type,
      Fintype.sum_bool]
    rw [Fin.sum_univ_three, Fin.sum_univ_three]
    have h01 : (Pi.single 0 (-1 : ℤ) : LatticePoint 3) ≠ Pi.single 1 (1 : ℤ) :=
      cubicLattice_single_ne_single_of_ne (i := 0) (j := 1) (by decide) (m := -1) (n := 1)
        (by norm_num)
    have h0n1 : (Pi.single 0 (-1 : ℤ) : LatticePoint 3) ≠ Pi.single 1 (-1 : ℤ) :=
      cubicLattice_single_ne_single_of_ne (i := 0) (j := 1) (by decide) (m := -1) (n := -1)
        (by norm_num)
    have h02 : (Pi.single 0 (-1 : ℤ) : LatticePoint 3) ≠ Pi.single 2 (1 : ℤ) :=
      cubicLattice_single_ne_single_of_ne (i := 0) (j := 2) (by decide) (m := -1) (n := 1)
        (by norm_num)
    have h0n2 : (Pi.single 0 (-1 : ℤ) : LatticePoint 3) ≠ Pi.single 2 (-1 : ℤ) :=
      cubicLattice_single_ne_single_of_ne (i := 0) (j := 2) (by decide) (m := -1) (n := -1)
        (by norm_num)
    simp [PMF.uniformOfFintype_apply, h01, h0n1, h02, h0n2]
  · -- Proof comment: only the witness `(true, 1)` contributes to the positive second-coordinate
    -- step.
    rw [symmetricSimpleRandomWalkStepPMF, PMF.map_apply, tsum_fintype, Fintype.sum_prod_type,
      Fintype.sum_bool]
    rw [Fin.sum_univ_three, Fin.sum_univ_three]
    have h10 : (Pi.single 1 (1 : ℤ) : LatticePoint 3) ≠ Pi.single 0 (1 : ℤ) :=
      cubicLattice_single_ne_single_of_ne (i := 1) (j := 0) (by decide) (m := 1) (n := 1)
        (by norm_num)
    have h1n0 : (Pi.single 1 (1 : ℤ) : LatticePoint 3) ≠ Pi.single 0 (-1 : ℤ) :=
      cubicLattice_single_ne_single_of_ne (i := 1) (j := 0) (by decide) (m := 1) (n := -1)
        (by norm_num)
    have h12 : (Pi.single 1 (1 : ℤ) : LatticePoint 3) ≠ Pi.single 2 (1 : ℤ) :=
      cubicLattice_single_ne_single_of_ne (i := 1) (j := 2) (by decide) (m := 1) (n := 1)
        (by norm_num)
    have h1n2 : (Pi.single 1 (1 : ℤ) : LatticePoint 3) ≠ Pi.single 2 (-1 : ℤ) :=
      cubicLattice_single_ne_single_of_ne (i := 1) (j := 2) (by decide) (m := 1) (n := -1)
        (by norm_num)
    simp [PMF.uniformOfFintype_apply, h10, h1n0, h12, h1n2]
  · -- Proof comment: only the witness `(false, 1)` contributes to the negative second-coordinate
    -- step.
    rw [symmetricSimpleRandomWalkStepPMF, PMF.map_apply, tsum_fintype, Fintype.sum_prod_type,
      Fintype.sum_bool]
    rw [Fin.sum_univ_three, Fin.sum_univ_three]
    have h10 : (Pi.single 1 (-1 : ℤ) : LatticePoint 3) ≠ Pi.single 0 (1 : ℤ) :=
      cubicLattice_single_ne_single_of_ne (i := 1) (j := 0) (by decide) (m := -1) (n := 1)
        (by norm_num)
    have h1n0 : (Pi.single 1 (-1 : ℤ) : LatticePoint 3) ≠ Pi.single 0 (-1 : ℤ) :=
      cubicLattice_single_ne_single_of_ne (i := 1) (j := 0) (by decide) (m := -1) (n := -1)
        (by norm_num)
    have h12 : (Pi.single 1 (-1 : ℤ) : LatticePoint 3) ≠ Pi.single 2 (1 : ℤ) :=
      cubicLattice_single_ne_single_of_ne (i := 1) (j := 2) (by decide) (m := -1) (n := 1)
        (by norm_num)
    have h1n2 : (Pi.single 1 (-1 : ℤ) : LatticePoint 3) ≠ Pi.single 2 (-1 : ℤ) :=
      cubicLattice_single_ne_single_of_ne (i := 1) (j := 2) (by decide) (m := -1) (n := -1)
        (by norm_num)
    simp [PMF.uniformOfFintype_apply, h10, h1n0, h12, h1n2]
  · -- Proof comment: only the witness `(true, 2)` contributes to the positive third-coordinate
    -- step.
    rw [symmetricSimpleRandomWalkStepPMF, PMF.map_apply, tsum_fintype, Fintype.sum_prod_type,
      Fintype.sum_bool]
    rw [Fin.sum_univ_three, Fin.sum_univ_three]
    have h20 : (Pi.single 2 (1 : ℤ) : LatticePoint 3) ≠ Pi.single 0 (1 : ℤ) :=
      cubicLattice_single_ne_single_of_ne (i := 2) (j := 0) (by decide) (m := 1) (n := 1)
        (by norm_num)
    have h2n0 : (Pi.single 2 (1 : ℤ) : LatticePoint 3) ≠ Pi.single 0 (-1 : ℤ) :=
      cubicLattice_single_ne_single_of_ne (i := 2) (j := 0) (by decide) (m := 1) (n := -1)
        (by norm_num)
    have h21 : (Pi.single 2 (1 : ℤ) : LatticePoint 3) ≠ Pi.single 1 (1 : ℤ) :=
      cubicLattice_single_ne_single_of_ne (i := 2) (j := 1) (by decide) (m := 1) (n := 1)
        (by norm_num)
    have h2n1 : (Pi.single 2 (1 : ℤ) : LatticePoint 3) ≠ Pi.single 1 (-1 : ℤ) :=
      cubicLattice_single_ne_single_of_ne (i := 2) (j := 1) (by decide) (m := 1) (n := -1)
        (by norm_num)
    simp [PMF.uniformOfFintype_apply, h20, h2n0, h21, h2n1]
  · -- Proof comment: only the witness `(false, 2)` contributes to the negative third-coordinate
    -- step.
    rw [symmetricSimpleRandomWalkStepPMF, PMF.map_apply, tsum_fintype, Fintype.sum_prod_type,
      Fintype.sum_bool]
    rw [Fin.sum_univ_three, Fin.sum_univ_three]
    have h20 : (Pi.single 2 (-1 : ℤ) : LatticePoint 3) ≠ Pi.single 0 (1 : ℤ) :=
      cubicLattice_single_ne_single_of_ne (i := 2) (j := 0) (by decide) (m := -1) (n := 1)
        (by norm_num)
    have h2n0 : (Pi.single 2 (-1 : ℤ) : LatticePoint 3) ≠ Pi.single 0 (-1 : ℤ) :=
      cubicLattice_single_ne_single_of_ne (i := 2) (j := 0) (by decide) (m := -1) (n := -1)
        (by norm_num)
    have h21 : (Pi.single 2 (-1 : ℤ) : LatticePoint 3) ≠ Pi.single 1 (1 : ℤ) :=
      cubicLattice_single_ne_single_of_ne (i := 2) (j := 1) (by decide) (m := -1) (n := 1)
        (by norm_num)
    have h2n1 : (Pi.single 2 (-1 : ℤ) : LatticePoint 3) ≠ Pi.single 1 (-1 : ℤ) :=
      cubicLattice_single_ne_single_of_ne (i := 2) (j := 1) (by decide) (m := -1) (n := -1)
        (by norm_num)
    simp [PMF.uniformOfFintype_apply, h20, h2n0, h21, h2n1]

/-- Helper for Example 19.31: the symmetric simple random-walk step law on `ℤ^3` vanishes away
from the six cardinal unit steps. -/
private theorem symmetricSimpleRandomWalkStepPMF_apply_zero_of_not_cardinal
    (y : LatticePoint 3)
    (hy :
      y ∉ ({Pi.single 0 (1 : ℤ), Pi.single 0 (-1 : ℤ), Pi.single 1 (1 : ℤ),
        Pi.single 1 (-1 : ℤ), Pi.single 2 (1 : ℤ), Pi.single 2 (-1 : ℤ)} :
          Finset (LatticePoint 3))) :
    symmetricSimpleRandomWalkStepPMF 3 y = 0 := by
  rw [symmetricSimpleRandomWalkStepPMF, PMF.map_apply]
  have hnone :
      ∀ a : Bool × Fin 3,
        y ≠ if a.1 then Pi.single a.2 (1 : ℤ) else Pi.single a.2 (-1) := by
    intro a
    rcases a with ⟨b, i⟩
    fin_cases i <;> cases b
    · intro hEq
      exact hy (by simp [hEq])
    · intro hEq
      exact hy (by simp [hEq])
    · intro hEq
      exact hy (by simp [hEq])
    · intro hEq
      exact hy (by simp [hEq])
    · intro hEq
      exact hy (by simp [hEq])
    · intro hEq
      exact hy (by simp [hEq])
  -- Proof comment: every summand in the pushforward formula is zero because no sample point lands
  -- at `y`.
  simp [hnone]

/-- Helper for Example 19.31: the origin row of the cubic-lattice conductance walk equals the
canonical symmetric nearest-neighbor step law on `ℤ^3`. -/
private theorem cubicLatticeKernel_originRow_eq_symmetricSimpleRandomWalkStepPMF
    (y : LatticePoint 3) :
    cubicLatticeTransitionMatrix 0 y = symmetricSimpleRandomWalkStepPMF 3 y := by
  by_cases hy :
      y = Pi.single 0 (1 : ℤ) ∨
        y = Pi.single 0 (-1 : ℤ) ∨
          y = Pi.single 1 (1 : ℤ) ∨
            y = Pi.single 1 (-1 : ℤ) ∨
              y = Pi.single 2 (1 : ℤ) ∨
                y = Pi.single 2 (-1 : ℤ)
  · -- Proof comment: on the six cardinal unit vectors, both one-step laws assign mass `1 / 6`.
    rw [cubicLatticeKernel_row_zero_eq_sixth_of_cardinal y hy,
      symmetricSimpleRandomWalkStepPMF_apply_cardinal y hy]
  · have hy_notmem :
        y ∉ ({Pi.single 0 (1 : ℤ), Pi.single 0 (-1 : ℤ), Pi.single 1 (1 : ℤ),
          Pi.single 1 (-1 : ℤ), Pi.single 2 (1 : ℤ), Pi.single 2 (-1 : ℤ)} :
            Finset (LatticePoint 3)) := by
      simpa [Finset.mem_insert, Finset.mem_singleton] using hy
    -- Proof comment: away from the six allowed increments, both laws vanish.
    rw [cubicLatticeKernel_row_zero_eq_zero_of_not_cardinal y hy_notmem,
      symmetricSimpleRandomWalkStepPMF_apply_zero_of_not_cardinal y hy_notmem]

/-- Helper for Example 19.31: the origin row of the lattice-convolution model is the step law
itself. -/
private theorem latticeConvolutionStepMatrix_row_zero_eq_stepLaw
    (y : LatticePoint 3) :
    latticeConvolutionStepMatrix (symmetricSimpleRandomWalkStepPMF 3) 0 y =
      symmetricSimpleRandomWalkStepPMF 3 y := by
  -- Proof comment: at the origin, the convolution kernel applies no translation, so singleton
  -- masses agree with the step law directly.
  rw [latticeConvolutionStepMatrix, dirac_convolution_kernel_apply, Measure.dirac_conv]
  rw [Measure.map_apply (by fun_prop) (measurableSet_singleton y)]
  have hpreimage :
      (fun z : LatticePoint 3 ↦ (0 : LatticePoint 3) + z) ⁻¹' ({y} : Set (LatticePoint 3)) = {y} := by
    ext z
    simp
  rw [hpreimage, PMF.toMeasure_apply_singleton _ _ (measurableSet_singleton y)]

/-- Helper for Example 19.31: the canonical convolution model of symmetric simple random walk on
`ℤ^3` agrees with the cubic-lattice conductance walk. -/
private theorem symmetricSimpleRandomWalkLatticeConvolution_eq_cubicLatticeTransitionMatrix :
    latticeConvolutionStepMatrix (symmetricSimpleRandomWalkStepPMF 3) =
      cubicLatticeTransitionMatrix := by
  funext x y
  -- Proof comment: both matrices are translation invariant, so equality reduces to comparing the
  -- origin rows at the common increment `y - x`.
  rw [latticeConvolutionStepMatrix_isTranslationInvariant (ν := symmetricSimpleRandomWalkStepPMF 3)
      x y,
    cubicLatticeKernel_translationInvariant x y,
    latticeConvolutionStepMatrix_row_zero_eq_stepLaw (y - x),
    cubicLatticeKernel_originRow_eq_symmetricSimpleRandomWalkStepPMF (y - x)]

/-- Helper for Example 19.31: the cubic-lattice conductance kernel is the simple random walk on
`latticeGraph 3`. -/
private theorem cubicLatticeKernel_isSimpleRandomWalk :
    IsSimpleRandomWalk cubicLatticeTransitionMatrix (latticeGraph 3) := by
  -- Proof comment: Example 19.10 packages the conductance-normalized unit-edge walk as the
  -- canonical simple random walk once symmetry, finiteness, and positivity of the conductances
  -- are established.
  exact
    conductanceTransitionMatrix_isRandomWalkWithWeights
      (C := simpleGraphWeights (latticeGraph 3))
      (simpleGraphWeights_symmetric (latticeGraph 3))
      (fun x ↦ by
        rw [cubicLatticeConductance_eq_six x]
        norm_num)
      (fun x ↦ by
        rw [cubicLatticeConductance_eq_six x]
        norm_num)

/-- Helper for Example 19.31: the current translation-invariant walk with origin row
`symmetricSimpleRandomWalkStepPMF 3` already is the cubic-lattice conductance walk. -/
private theorem currentStepMatrix_eq_cubicLatticeTransitionMatrix
    (p : (Fin 3 → ℤ) → PMF (Fin 3 → ℤ))
    (hp : IsTranslationInvariantStepMatrix (fun x y ↦ p x y))
    (hstep : p 0 = symmetricSimpleRandomWalkStepPMF 3) :
    (fun x y : Fin 3 → ℤ ↦ p x y) = cubicLatticeTransitionMatrix := by
  -- Proof comment: first normalize the given translation-invariant kernel to the canonical
  -- lattice-convolution model, then identify that model with the cubic-lattice conductance walk.
  calc
    (fun x y : Fin 3 → ℤ ↦ p x y)
        = latticeConvolutionStepMatrix (symmetricSimpleRandomWalkStepPMF 3) :=
          currentStepMatrix_eq_latticeConvolutionStepMatrix (p := p) hp hstep
    _ = cubicLatticeTransitionMatrix :=
          symmetricSimpleRandomWalkLatticeConvolution_eq_cubicLatticeTransitionMatrix

/-- Helper for Example 19.31: a nonrecurrent state is transient because its self-hit probability
is strictly smaller than `1`. -/
private theorem transientStateOfNotRecurrentState
    {E : Type*} [MeasurableSpace E] [DiscreteMeasurableSpace E]
    {P : E → ProbabilityMeasure Ω} {X : ℕ → Ω → E}
    {x : E} (hx : ¬ IsRecurrentState P X x) :
    IsTransientState P X x := by
  have hxx_le_one : (F[P, X]) x x ≤ 1 := by
    rw [everHitsProbability_def]
    exact measureReal_le_one
  -- Proof comment: the return probability is always at most `1`, so failing the recurrent
  -- identity forces the strict inequality required for transience.
  rw [IsTransientState]
  by_contra hnot_transient
  have hxx_ge_one : 1 ≤ (F[P, X]) x x := le_of_not_gt hnot_transient
  have hxx_eq_one : (F[P, X]) x x = 1 := le_antisymm hxx_le_one hxx_ge_one
  exact hx <| by simpa [IsRecurrentState] using hxx_eq_one

/-- Helper for Example 19.31: the full diagonal Green value splits into the deterministic
time-`0` visit and the positive-time tail. -/
private theorem greenFunctionSelfEqOneAddGreenFunctionFromOneSelfGeneral
    {E : Type*} [MeasurableSpace E] [MeasurableSingletonClass E] [Countable E]
    {κ : ℕ → Kernel E E}
    {P : E → ProbabilityMeasure Ω} {X : ℕ → Ω → E}
    [IsMarkovProcessRealization κ P X] (x : E) :
    (G[P, X]) x x = 1 + (G[P, X; 1]) x x := by
  let hReal : IsMarkovProcessRealization κ P X := inferInstance
  let hX : IsStochasticProcess X := fun n ↦ hReal.measurable_process n
  have hzero :
      (P x : Measure Ω) {ω | X 0 ω = x} = 1 := by
    have hpreimage : {ω | X 0 ω = x} = X 0 ⁻¹' ({x} : Set E) := by
      ext ω
      simp
    -- Proof comment: under `P x`, the process starts from `x` at time `0`.
    calc
      (P x : Measure Ω) {ω | X 0 ω = x}
        = ((P x : Measure Ω).map (X 0)) ({x} : Set E) := by
            rw [hpreimage]
            rw [← Measure.map_apply (hReal.measurable_process 0) (MeasurableSet.singleton x)]
      _ = Measure.dirac x ({x} : Set E) := by
            rw [hReal.initial_eq x]
      _ = 1 := by
            simp
  -- Proof comment: split off the time-`0` summand in the Green series and rewrite the remaining
  -- terms as the positive-time Green tail.
  calc
    (G[P, X]) x x = ∑' n : ℕ, (P x : Measure Ω) {ω | X n ω = x} := by
      rw [greenFunction_eq_tsum_stateProbabilities P X hX x x]
    _ = (P x : Measure Ω) {ω | X 0 ω = x} +
        ∑' n : ℕ, ite (n = 0) 0 ((P x : Measure Ω) {ω | X n ω = x}) := by
          classical
          simpa [eq_comm] using
            (ENNReal.tsum_eq_add_tsum_ite
              (f := fun n : ℕ ↦ (P x : Measure Ω) {ω | X n ω = x}) 0)
    _ = 1 + ∑' n : ℕ, ite (n = 0) 0 ((P x : Measure Ω) {ω | X n ω = x}) := by
          simp [hzero]
    _ = 1 + ∑' n : ℕ, (P x : Measure Ω) {ω | 0 < n ∧ X n ω = x} := by
          congr 1
          refine tsum_congr fun n ↦ ?_
          by_cases hn : n = 0
          · subst hn
            simp
          · have hnpos : 0 < n := Nat.pos_of_ne_zero hn
            simp [hn, hnpos]
    _ = 1 + (G[P, X; 1]) x x := by
          rw [greenFunctionFrom_one_eq_tsum_positiveStateProbabilities P X hX x x]

/-- Helper for Example 19.31: a shifted geometric series of `ℝ≥0∞` casts stays finite when the
ratio lies in `[0, 1)`. -/
private theorem ennrealOfRealTsumGeometricSucc_lt_topGeneral {q : ℝ}
    (hq_nonneg : 0 ≤ q) (hq_lt_one : q < 1) :
    ∑' n : ℕ, ENNReal.ofReal (q ^ (n + 1)) < ⊤ := by
  have hsum : Summable (fun n : ℕ ↦ q ^ (n + 1)) :=
    (_root_.summable_nat_add_iff 1).2 (summable_geometric_of_lt_one hq_nonneg hq_lt_one)
  -- Proof comment: summability in `ℝ` keeps the nonnegative `ℝ≥0∞` casts finite.
  calc
    ∑' n : ℕ, ENNReal.ofReal (q ^ (n + 1))
      = ENNReal.ofReal (∑' n : ℕ, q ^ (n + 1)) := by
          rw [ENNReal.ofReal_tsum_of_nonneg]
          · intro n
            exact pow_nonneg hq_nonneg _
          · exact hsum
    _ < ⊤ := by
          simp

/-- Helper for Example 19.31: Theorem 17.29 turns the iterated entrance probabilities at a state
into the shifted power series of its return probability. -/
private theorem iteratedEntranceProbabilitySeriesEqSelfPowerSeriesGeneral
    {E : Type*} [MeasurableSpace E] [MeasurableSingletonClass E] [Countable E]
    {κ : ℕ → Kernel E E}
    {P : E → ProbabilityMeasure Ω} {X : ℕ → Ω → E}
    [IsMarkovProcessRealization κ P X] (x : E) :
    (∑' k : ℕ+, ENNReal.ofReal ((P x : Measure Ω).real {ω | (τ_[X, x]^k) ω < ⊤})) =
      ∑' n : ℕ, ENNReal.ofReal (((F[P, X]) x x) ^ (n + 1)) := by
  -- Proof comment: rewrite each entrance-time probability by Theorem 17.29 and reindex the
  -- resulting `ℕ+`-series to `ℕ`.
  calc
    (∑' k : ℕ+, ENNReal.ofReal ((P x : Measure Ω).real {ω | (τ_[X, x]^k) ω < ⊤})) =
        ∑' k : ℕ+, ENNReal.ofReal ((F[P, X]) x x * (F[P, X]) x x ^ k.natPred) := by
          refine tsum_congr fun k ↦ ?_
          simpa using congrArg ENNReal.ofReal
            (iteratedEntranceTime_finite_probability_eq_everHitsProbability_mul_selfPow
              (κ := κ) (P := P) (X := X) x x k)
    _ = ∑' n : ℕ, ENNReal.ofReal ((F[P, X]) x x * (F[P, X]) x x ^ n) := by
          simpa using
            (Equiv.tsum_eq Equiv.pnatEquivNat
              (fun n : ℕ ↦ ENNReal.ofReal ((F[P, X]) x x * (F[P, X]) x x ^ n)))
    _ = ∑' n : ℕ, ENNReal.ofReal (((F[P, X]) x x) ^ (n + 1)) := by
          refine tsum_congr fun n ↦ ?_
          rw [pow_succ, mul_comm]

/-- Helper for Example 19.31: the positive-time diagonal Green function is the shifted power
series of the return probability. -/
private theorem greenFunctionFromOneSelfEqTsumSelfPowersGeneral
    {E : Type*} [MeasurableSpace E] [MeasurableSingletonClass E] [Countable E]
    {κ : ℕ → Kernel E E}
    {P : E → ProbabilityMeasure Ω} {X : ℕ → Ω → E}
    [IsMarkovProcessRealization κ P X] (x : E) :
    (G[P, X; 1]) x x =
      ∑' n : ℕ, ENNReal.ofReal (((F[P, X]) x x) ^ (n + 1)) := by
  -- Proof comment: rewrite the positive-time Green tail through the iterated entrance-time
  -- expansion and then normalize the index.
  exact
    (greenFunctionFromOneSelf_eq_tsum_iteratedEntranceProbabilities
      (κ := κ) (P := P) (X := X) x).trans
      (iteratedEntranceProbabilitySeriesEqSelfPowerSeriesGeneral
        (κ := κ) (P := P) (X := X) x)

/-- Helper for Example 19.31: an infinite diagonal Green value forces recurrence of that state. -/
private theorem isRecurrentStateOfGreenFunctionSelfEqTopGeneral
    {E : Type*} [MeasurableSpace E] [MeasurableSingletonClass E] [Countable E]
    {κ : ℕ → Kernel E E}
    {P : E → ProbabilityMeasure Ω} {X : ℕ → Ω → E}
    [IsMarkovProcessRealization κ P X] (x : E) (hx : (G[P, X]) x x = ⊤) :
    IsRecurrentState P X x := by
  have hq_nonneg : 0 ≤ (F[P, X]) x x := measureReal_nonneg
  have hq_le_one : (F[P, X]) x x ≤ 1 := by
    rw [everHitsProbability_def]
    exact measureReal_le_one
  -- Proof comment: if the return probability were strictly below `1`, the shifted geometric
  -- series for the positive-time Green tail would stay finite, contradicting the Green blow-up.
  by_contra htrans
  have hq_lt_one : (F[P, X]) x x < 1 := by
    rw [IsRecurrentState] at htrans
    exact lt_of_le_of_ne hq_le_one (by simpa [eq_comm] using htrans)
  have htail_lt_top :
      ∑' n : ℕ, ENNReal.ofReal (((F[P, X]) x x) ^ (n + 1)) < ⊤ :=
    ennrealOfRealTsumGeometricSucc_lt_topGeneral hq_nonneg hq_lt_one
  have hgreen_lt_top : (G[P, X]) x x < ⊤ := by
    calc
      (G[P, X]) x x = 1 + (G[P, X; 1]) x x := by
        rw [greenFunctionSelfEqOneAddGreenFunctionFromOneSelfGeneral
          (κ := κ) (P := P) (X := X)]
      _ = 1 + ∑' n : ℕ, ENNReal.ofReal (((F[P, X]) x x) ^ (n + 1)) := by
        rw [greenFunctionFromOneSelfEqTsumSelfPowersGeneral
          (κ := κ) (P := P) (X := X)]
      _ < ⊤ := by
        exact ENNReal.add_lt_top.2 ⟨by simp, htail_lt_top⟩
  exact (ne_of_lt hgreen_lt_top) hx

/-- Helper for Example 19.31: recurrence of a state forces its diagonal Green value to be
infinite. -/
private theorem greenFunctionSelfEqTopOfIsRecurrentStateGeneral
    {E : Type*} [MeasurableSpace E] [MeasurableSingletonClass E] [Countable E]
    {κ : ℕ → Kernel E E}
    {P : E → ProbabilityMeasure Ω} {X : ℕ → Ω → E}
    [IsMarkovProcessRealization κ P X] (x : E) (hx : IsRecurrentState P X x) :
    (G[P, X]) x x = ⊤ := by
  -- Proof comment: recurrence makes every return-probability power equal to `1`, so the
  -- positive-time Green tail is already the divergent series of ones.
  calc
    (G[P, X]) x x = 1 + (G[P, X; 1]) x x := by
      rw [greenFunctionSelfEqOneAddGreenFunctionFromOneSelfGeneral
        (κ := κ) (P := P) (X := X)]
    _ = 1 + ∑' n : ℕ, ENNReal.ofReal (1 ^ (n + 1 : ℕ)) := by
          rw [greenFunctionFromOneSelfEqTsumSelfPowersGeneral
            (κ := κ) (P := P) (X := X)]
          rw [IsRecurrentState] at hx
          simpa [hx]
    _ = ⊤ := by
          simp

/-- Helper for Example 19.31: a positive two-step communication pattern composes to a lower bound
on the longer-step singleton mass. -/
private theorem singletonStepMass_mul_singletonStepMass_le_stepMass
    {E : Type*} [MeasurableSpace E] [MeasurableSingletonClass E] [Countable E]
    {κ : ℕ → Kernel E E}
    {P : E → ProbabilityMeasure Ω} {X : ℕ → Ω → E}
    [IsMarkovProcessRealization κ P X]
    (a b c : E) (m n : ℕ) :
    ((κ m) a ({b} : Set E)) * ((κ n) b ({c} : Set E)) ≤
      ((κ (m + n)) a) ({c} : Set E) := by
  let hReal : IsMarkovProcessRealization κ P X := inferInstance
  -- Proof comment: expand the composed kernel at the singleton `{c}` and keep only the
  -- intermediate state `b` in the resulting countable sum.
  calc
    ((κ m) a ({b} : Set E)) * ((κ n) b ({c} : Set E))
      = ((κ n) b ({c} : Set E)) * ((κ m) a ({b} : Set E)) := by
            rw [mul_comm]
    _ ≤ ∑' z : E, ((κ n) z ({c} : Set E)) * ((κ m) a ({z} : Set E)) := by
            exact ENNReal.le_tsum b
    _ = ((κ (m + n)) a) ({c} : Set E) := by
          rw [← hReal.semigroup.comp_eq m n]
          rw [Kernel.comp_apply' _ _ _ (MeasurableSet.singleton c)]
          simpa [MeasureTheory.lintegral_countable', mul_comm]

/-- Helper for Example 19.31: a positive step mass into a state with infinite diagonal Green mass
forces the corresponding cross Green value to be infinite. -/
private theorem greenFunctionTopOfGreenFunctionSelfTopAndStepMass
    {E : Type*} [MeasurableSpace E] [MeasurableSingletonClass E] [Countable E]
    {κ : ℕ → Kernel E E}
    {P : E → ProbabilityMeasure Ω} {X : ℕ → Ω → E}
    [IsMarkovProcessRealization κ P X]
    (x y : E) {k : ℕ}
    (hxx_top : (G[P, X]) x x = ⊤)
    (hstep : 0 < (κ k) y ({x} : Set E)) :
    (G[P, X]) y x = ⊤ := by
  let hReal : IsMarkovProcessRealization κ P X := inferInstance
  let hX : IsStochasticProcess X := fun n ↦ hReal.measurable_process n
  let c : ℝ≥0∞ := (κ k) y ({x} : Set E)
  have hc_ne_zero : c ≠ 0 := hstep.ne'
  have hxx_series :
      ∑' n : ℕ, (P x : Measure Ω) {ω | X n ω = x} = ⊤ := by
    simpa [greenFunction_eq_tsum_stateProbabilities P X hX x x] using hxx_top
  have hterm_le :
      ∀ n : ℕ,
        (P x : Measure Ω) {ω | X n ω = x} * c ≤
          (P y : Measure Ω) {ω | X (k + n) ω = x} := by
    intro n
    have hpreimage_xn : {ω | X n ω = x} = X n ⁻¹' ({x} : Set E) := by
      ext ω
      simp
    have hpreimage_ykn : {ω | X (k + n) ω = x} = X (k + n) ⁻¹' ({x} : Set E) := by
      ext ω
      simp
    -- Proof comment: a positive `k`-step path from `y` to `x` followed by an `n`-step return at
    -- `x` lower-bounds the `(k + n)`-step mass from `y` back to `x`.
    calc
      (P x : Measure Ω) {ω | X n ω = x} * c
        = ((κ n) x ({x} : Set E)) * c := by
            rw [hpreimage_xn]
            rw [← Measure.map_apply (hReal.measurable_process n) (MeasurableSet.singleton x)]
            rw [hReal.transition_eq x n]
      _ = ((κ n) x ({x} : Set E)) * ((κ k) y ({x} : Set E)) := by
            simp [c]
      _ = ((κ k) y ({x} : Set E)) * ((κ n) x ({x} : Set E)) := by
            rw [mul_comm]
      _ ≤ ((κ (k + n)) y) ({x} : Set E) := by
            simpa [add_comm] using
              singletonStepMass_mul_singletonStepMass_le_stepMass
                (κ := κ) (P := P) (X := X) y x x k n
      _ = (P y : Measure Ω) {ω | X (k + n) ω = x} := by
            rw [hpreimage_ykn]
            rw [← Measure.map_apply (hReal.measurable_process (k + n))
              (MeasurableSet.singleton x)]
            rw [hReal.transition_eq y (k + n)]
  have hscaled_top :
      ∑' n : ℕ, (P x : Measure Ω) {ω | X n ω = x} * c = ⊤ := by
    calc
      ∑' n : ℕ, (P x : Measure Ω) {ω | X n ω = x} * c
        = (∑' n : ℕ, (P x : Measure Ω) {ω | X n ω = x}) * c := by
            rw [ENNReal.tsum_mul_right]
      _ = ⊤ := by
            simpa [hxx_series, hc_ne_zero] using
              congrArg (fun t : ℝ≥0∞ ↦ t * c) hxx_series
  have htail_top :
      ∑' n : ℕ, (P y : Measure Ω) {ω | X (k + n) ω = x} = ⊤ := by
    apply top_unique
    rw [← hscaled_top]
    exact ENNReal.tsum_le_tsum hterm_le
  have htail_le :
      ∑' n : ℕ, (P y : Measure Ω) {ω | X (k + n) ω = x} ≤
        ∑' n : ℕ, (P y : Measure Ω) {ω | X n ω = x} := by
    exact
      (ENNReal.summable.tsum_le_tsum_of_inj (fun n : ℕ ↦ k + n)
        (by
          intro a b hab
          exact Nat.add_left_cancel hab)
        (fun _ _ ↦ zero_le _) (fun _ ↦ le_rfl)) ENNReal.summable
  have hyx_series_top :
      ∑' n : ℕ, (P y : Measure Ω) {ω | X n ω = x} = ⊤ := by
    apply top_unique
    rw [← htail_top]
    exact htail_le
  simpa [greenFunction_eq_tsum_stateProbabilities P X hX y x] using hyx_series_top

/-- Helper for Example 19.31: a positive step mass back to the start state upgrades an infinite
cross Green value to an infinite diagonal Green value. -/
private theorem greenFunctionSelfEqTopOfGreenFunctionTopAndStepMass
    {E : Type*} [MeasurableSpace E] [MeasurableSingletonClass E] [Countable E]
    (p : E → E → ℝ≥0∞)
    (P : E → ProbabilityMeasure Ω) (X : ℕ → Ω → E)
    [IsMarkovProcessRealization (fun n ↦ discreteMatrixKernel p ^ n) P X]
    (x y : E) {k : ℕ}
    (hxy_top : (G[P, X]) x y = ⊤)
    (hkx : 0 < ((discreteMatrixKernel p ^ k) y) ({x} : Set E)) :
    (G[P, X]) x x = ⊤ := by
  let hReal : IsMarkovProcessRealization (fun n ↦ discreteMatrixKernel p ^ n) P X := inferInstance
  let hX : IsStochasticProcess X := fun n ↦ hReal.measurable_process n
  let c : ℝ≥0∞ := ((discreteMatrixKernel p ^ k) y) ({x} : Set E)
  have hc_ne_zero : c ≠ 0 := hkx.ne'
  have hy_series :
      ∑' n : ℕ, (P x : Measure Ω) {ω | X n ω = y} = ⊤ := by
    simpa [greenFunction_eq_tsum_stateProbabilities P X hX x y] using hxy_top
  have hterm_le :
      ∀ n : ℕ,
        (P x : Measure Ω) {ω | X n ω = y} * c ≤
          (P x : Measure Ω) {ω | X (n + k) ω = x} := by
    intro n
    have hpreimage_y : {ω | X n ω = y} = X n ⁻¹' ({y} : Set E) := by
      ext ω
      simp
    have hpreimage_x : {ω | X (n + k) ω = x} = X (n + k) ⁻¹' ({x} : Set E) := by
      ext ω
      simp
    -- Proof comment: the cross mass at time `n` followed by the positive `k`-step path from `y`
    -- back to `x` yields a lower bound on the diagonal mass at time `n + k`.
    calc
      (P x : Measure Ω) {ω | X n ω = y} * c
        = (((discreteMatrixKernel p ^ n) x) ({y} : Set E)) * c := by
            rw [hpreimage_y]
            rw [← Measure.map_apply (hReal.measurable_process n) (MeasurableSet.singleton y)]
            rw [hReal.transition_eq x n]
      _ = (((discreteMatrixKernel p ^ n) x) ({y} : Set E)) *
          (((discreteMatrixKernel p ^ k) y) ({x} : Set E)) := by
            simp [c]
      _ ≤ (((discreteMatrixKernel p ^ (n + k)) x) ({x} : Set E)) := by
            exact singletonStepMass_mul_singletonStepMass_le_stepMass
              (κ := fun j ↦ discreteMatrixKernel p ^ j) (P := P) (X := X) x y x n k
      _ = (P x : Measure Ω) {ω | X (n + k) ω = x} := by
            rw [hpreimage_x]
            rw [← Measure.map_apply (hReal.measurable_process (n + k))
              (MeasurableSet.singleton x)]
            rw [hReal.transition_eq x (n + k)]
  have hscaled_top :
      ∑' n : ℕ, (P x : Measure Ω) {ω | X n ω = y} * c = ⊤ := by
    calc
      ∑' n : ℕ, (P x : Measure Ω) {ω | X n ω = y} * c
        = (∑' n : ℕ, (P x : Measure Ω) {ω | X n ω = y}) * c := by
            rw [ENNReal.tsum_mul_right]
      _ = ⊤ := by
            simpa [hy_series, hc_ne_zero] using
              congrArg (fun t : ℝ≥0∞ ↦ t * c) hy_series
  have htail_top :
      ∑' n : ℕ, (P x : Measure Ω) {ω | X (n + k) ω = x} = ⊤ := by
    apply top_unique
    rw [← hscaled_top]
    exact ENNReal.tsum_le_tsum hterm_le
  have htail_le :
      ∑' n : ℕ, (P x : Measure Ω) {ω | X (n + k) ω = x} ≤
        ∑' n : ℕ, (P x : Measure Ω) {ω | X n ω = x} := by
    exact
      (ENNReal.summable.tsum_le_tsum_of_inj (fun n : ℕ ↦ n + k)
        (by
          intro a b hab
          exact Nat.add_right_cancel hab)
        (fun _ _ ↦ zero_le _) (fun _ ↦ le_rfl)) ENNReal.summable
  have hdiag_series_top :
      ∑' n : ℕ, (P x : Measure Ω) {ω | X n ω = x} = ⊤ := by
    apply top_unique
    rw [← htail_top]
    exact htail_le
  simpa [greenFunction_eq_tsum_stateProbabilities P X hX x x] using hdiag_series_top

/-- Helper for Example 19.31: a recurrent state propagates across a pair of positive transition
paths in opposite directions. -/
private theorem recurrentStateOfTwoWayPositiveStepMass
    {E : Type*} [MeasurableSpace E] [MeasurableSingletonClass E] [Countable E]
    (p : E → E → ℝ≥0∞)
    (P : E → ProbabilityMeasure Ω) (X : ℕ → Ω → E)
    [IsMarkovProcessRealization (fun n ↦ discreteMatrixKernel p ^ n) P X]
    {x y : E} (hx : IsRecurrentState P X x)
    {m n : ℕ}
    (hxy : 0 < ((discreteMatrixKernel p ^ m) x) ({y} : Set E))
    (hyx : 0 < ((discreteMatrixKernel p ^ n) y) ({x} : Set E)) :
    IsRecurrentState P X y := by
  have hgreen_xx : (G[P, X]) x x = ⊤ :=
    greenFunctionSelfEqTopOfIsRecurrentStateGeneral
      (κ := fun k ↦ discreteMatrixKernel p ^ k) (P := P) (X := X) x hx
  have hgreen_yx : (G[P, X]) y x = ⊤ :=
    greenFunctionTopOfGreenFunctionSelfTopAndStepMass
      (κ := fun k ↦ discreteMatrixKernel p ^ k) (P := P) (X := X) x y hgreen_xx hyx
  have hgreen_yy : (G[P, X]) y y = ⊤ :=
    greenFunctionSelfEqTopOfGreenFunctionTopAndStepMass
      (p := p) (P := P) (X := X) y x hgreen_yx hxy
  -- Proof comment: once the diagonal Green value at `y` is infinite, recurrence follows from the
  -- standard Green-versus-return bridge.
  exact
    isRecurrentStateOfGreenFunctionSelfEqTopGeneral
      (κ := fun k ↦ discreteMatrixKernel p ^ k) (P := P) (X := X) y hgreen_yy

/-- Helper for Example 19.31: once the current walk is rewritten as the simple random walk on
`latticeGraph 3`, the remaining work is the Chapter 19 dyadic-subgraph contradiction. -/
private theorem cubicLattice_notRecurrent
    (P : LatticePoint 3 → ProbabilityMeasure Ω) (X : ℕ → Ω → LatticePoint 3)
    [IsMarkovProcessRealization
      (fun n ↦ discreteMatrixKernel cubicLatticeTransitionMatrix ^ n) P X] :
    ¬ IsRecurrentMarkovChain P X := by
  intro hrec
  -- Route correction: the current kernel has already been normalized to the canonical symmetric
  -- nearest-neighbor walk on `ℤ^3`, so Theorem 17.39 reduces recurrence to the false inequality
  -- `3 ≤ 2`.
  have hdim :
      3 ≤ 2 :=
    (symmetricSimpleRandomWalk_lattice_recurrent_iff_dimension_le_two
        (D := 3) (P := P) (X := X) (p := cubicLatticeTransitionMatrix)
        cubicLatticeKernel_translationInvariant
        cubicLatticeKernel_originRow_eq_symmetricSimpleRandomWalkStepPMF).mp hrec
  exact (by decide : ¬ 3 ≤ 2) hdim

/-- Helper for Example 19.31: an irreducible translation-invariant random walk on `ℤ^3` is
not recurrent. -/
private theorem z3NotRecurrent
    (p : (Fin 3 → ℤ) → PMF (Fin 3 → ℤ))
    (P : (Fin 3 → ℤ) → ProbabilityMeasure Ω) (X : ℕ → Ω → (Fin 3 → ℤ))
    [IsMarkovProcessRealization (fun n ↦ discreteMatrixKernel (fun x y ↦ p x y) ^ n) P X]
    [Kernel.IsIrreducible
      (Measure.count : Measure (Fin 3 → ℤ)) (discreteMatrixKernel (fun x y ↦ p x y))]
    (hp : IsTranslationInvariantStepMatrix (fun x y ↦ p x y))
    (hstep : p 0 = symmetricSimpleRandomWalkStepPMF 3) :
    ¬ IsRecurrentMarkovChain P X := by
  -- Route correction: rather than waiting on the missing Chapter 17 `.olean`, rewrite the given
  -- walk directly to the cubic-lattice simple random walk and isolate the remaining Chapter 19
  -- dyadic-subgraph contradiction there.
  letI :
      IsMarkovProcessRealization
        (fun n ↦ discreteMatrixKernel cubicLatticeTransitionMatrix ^ n)
        P X := by
    -- Proof comment: the realization depends only on the one-step kernel, and the current
    -- translation-invariant matrix already matches the cubic-lattice conductance walk.
    simpa [currentStepMatrix_eq_cubicLatticeTransitionMatrix (p := p) hp hstep] using
      (inferInstance :
        IsMarkovProcessRealization
          (fun n ↦ discreteMatrixKernel (fun x y ↦ p x y) ^ n) P X)
  -- Proof comment: after the matrix identification, the only remaining blocker is the Chapter 19
  -- finite-resistance subtree argument on the cubic lattice.
  exact cubicLattice_notRecurrent P X

/-- Helper for Example 19.31: for an irreducible discrete-matrix chain, excluding the recurrent
branch of Theorem 17.37 forces every state to be transient. -/
private theorem allStatesTransient_of_notRecurrent
    (p : (Fin 3 → ℤ) → (Fin 3 → ℤ) → ℝ≥0∞)
    (P : (Fin 3 → ℤ) → ProbabilityMeasure Ω) (X : ℕ → Ω → (Fin 3 → ℤ))
    [IsMarkovProcessRealization (fun n ↦ discreteMatrixKernel p ^ n) P X]
    [Kernel.IsIrreducible
      (Measure.count : Measure (Fin 3 → ℤ)) (discreteMatrixKernel p)]
    (hnotRec : ¬ IsRecurrentMarkovChain P X) :
    ∀ x : Fin 3 → ℤ, IsTransientState P X x := by
  intro x
  apply transientStateOfNotRecurrentState
  intro hx
  apply hnotRec
  intro y
  by_cases hxy : x = y
  · subst hxy
    exact hx
  · have hy_pos : 0 < (Measure.count : Measure (Fin 3 → ℤ)) ({y} : Set (Fin 3 → ℤ)) := by
      simp
    have hx_pos : 0 < (Measure.count : Measure (Fin 3 → ℤ)) ({x} : Set (Fin 3 → ℤ)) := by
      simp
    rcases (inferInstance :
        Kernel.IsIrreducible (Measure.count : Measure (Fin 3 → ℤ))
          (discreteMatrixKernel p)).irreducible
          (A := ({y} : Set (Fin 3 → ℤ))) (MeasurableSet.singleton y) hy_pos x with
      ⟨n, hn⟩
    have hnpos : 0 < n := by
      by_contra hnpos
      have hnzero : n = 0 := Nat.eq_zero_of_not_pos hnpos
      subst hnzero
      have hzero : ((discreteMatrixKernel p ^ 0) x) ({y} : Set (Fin 3 → ℤ)) = 0 := by
        change (Kernel.id x) ({y} : Set (Fin 3 → ℤ)) = 0
        simp [Kernel.id_apply, hxy]
      rw [hzero] at hn
      exact lt_irrefl _ hn
    rcases (inferInstance :
        Kernel.IsIrreducible (Measure.count : Measure (Fin 3 → ℤ))
          (discreteMatrixKernel p)).irreducible
          (A := ({x} : Set (Fin 3 → ℤ))) (MeasurableSet.singleton x) hx_pos y with
      ⟨m, hm⟩
    have hmpos : 0 < m := by
      by_contra hmpos
      have hmzero : m = 0 := Nat.eq_zero_of_not_pos hmpos
      subst hmzero
      have hzero : ((discreteMatrixKernel p ^ 0) y) ({x} : Set (Fin 3 → ℤ)) = 0 := by
        change (Kernel.id y) ({x} : Set (Fin 3 → ℤ)) = 0
        simp [Kernel.id_apply, hxy]
      rw [hzero] at hm
      exact lt_irrefl _ hm
    -- Proof comment: irreducibility supplies positive step-mass paths in both directions, so
    -- recurrence at `x` transports to every other state.
    exact recurrentStateOfTwoWayPositiveStepMass (p := p) (P := P) (X := X) hx hn hm

/-- Helper for Example 19.31: an irreducible translation-invariant random walk on `ℤ^3` is
transient at every state. -/
private theorem z3AllStatesTransient
    (p : (Fin 3 → ℤ) → PMF (Fin 3 → ℤ))
    (P : (Fin 3 → ℤ) → ProbabilityMeasure Ω) (X : ℕ → Ω → (Fin 3 → ℤ))
    [IsMarkovProcessRealization (fun n ↦ discreteMatrixKernel (fun x y ↦ p x y) ^ n) P X]
    [Kernel.IsIrreducible
      (Measure.count : Measure (Fin 3 → ℤ)) (discreteMatrixKernel (fun x y ↦ p x y))]
    (hp : IsTranslationInvariantStepMatrix (fun x y ↦ p x y))
    (hstep : p 0 = symmetricSimpleRandomWalkStepPMF 3) :
    ∀ x : Fin 3 → ℤ, IsTransientState P X x := by
  have hnotRec : ¬ IsRecurrentMarkovChain P X := z3NotRecurrent p P X hp hstep
  -- Proof comment: once recurrence is excluded, the irreducible dichotomy immediately yields the
  -- advertised statewise transience conclusion.
  exact
    allStatesTransient_of_notRecurrent
      (p := fun x y ↦ p x y) (P := P) (X := X) hnotRec

-- Proof sketch: combine the `d = 3` case of
-- `symmetricSimpleRandomWalk_isRecurrent_iff_dimension_le_two` with irreducibility of the
-- symmetric simple walk on `ℤ^3`; the irreducible dichotomy then gives transience of every
-- state, while the chapter text computes the needed transience input through the finite-resistance
-- subtree encoded by `dyadicTreeResistanceSeries_eq_one`.
/-- Example 19.31: every state of the symmetric simple random walk on `ℤ^3`, modeled by the
translation-invariant step law `symmetricSimpleRandomWalkStepPMF 3`, is transient; equivalently,
its positive-time return probability at each state is strictly smaller than `1`. -/
theorem symmetricSimpleRandomWalkOnZ3_allStatesTransient
    (p : (Fin 3 → ℤ) → PMF (Fin 3 → ℤ))
    (P : (Fin 3 → ℤ) → ProbabilityMeasure Ω) (X : ℕ → Ω → (Fin 3 → ℤ))
    [IsMarkovProcessRealization (fun n ↦ discreteMatrixKernel (fun x y ↦ p x y) ^ n) P X]
    [Kernel.IsIrreducible
      (Measure.count : Measure (Fin 3 → ℤ)) (discreteMatrixKernel (fun x y ↦ p x y))]
    (hp : IsTranslationInvariantStepMatrix (fun x y ↦ p x y))
    (hstep : p 0 = symmetricSimpleRandomWalkStepPMF 3)
    :
    ∀ x : Fin 3 → ℤ, everHitsProbability P X x x < 1 := by
  -- Proof comment: the Chapter 17 transience theorem already gives the statewise conclusion on
  -- `ℤ^3`, so we only rewrite its predicate back to the return-probability form.
  intro x
  simpa [IsTransientState] using z3AllStatesTransient p P X hp hstep x

end ProbabilityTheory
