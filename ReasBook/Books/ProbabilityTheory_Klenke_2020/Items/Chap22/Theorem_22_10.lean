open Filter MeasureTheory ProbabilityTheory
open scoped NNReal ProbabilityTheory Topology

universe u

namespace ProbabilityTheory

variable {Ω : Type u} [mΩ : MeasurableSpace Ω]

variable {μ : Measure Ω} [IsProbabilityMeasure μ]

/-- Helper for Theorem 22.10: on a probability space, a square-integrable real random variable is
integrable. -/
private lemma squareIntegrable_integrable {X : Ω → ℝ} (hX_sq : MemLp X 2 μ) :
    Integrable X μ := by
  -- Proof comment: `L²` control is stronger than `L¹` control on a probability space.
  exact hX_sq.integrable (by norm_num)

/-- Helper for Theorem 22.10: if `X` has mean zero, then conditioning `X` on the trivial
σ-algebra gives the zero random variable. -/
private lemma condExp_bot_ae_eq_zero_of_mean_zero {X : Ω → ℝ} (hX_int : Integrable X μ)
    (hX_mean_zero : ∫ ω, X ω ∂μ = 0) :
    μ[X | (⊥ : MeasurableSpace Ω)] =ᵐ[μ] 0 := by
  -- Proof comment: on the trivial σ-algebra, conditional expectation is the constant mean.
  refine (EventuallyEq.of_eq (MeasureTheory.condExp_bot (μ := μ) (f := X))).trans ?_
  exact Filter.Eventually.of_forall fun ω ↦ by simp [hX_mean_zero]

/-- Helper for Theorem 22.10: the natural filtration generated by a process whose finite
truncations are binary models. -/
private def binaryNaturalFiltration (Y : ℕ → Ω → ℝ)
    (hY_binary : ∀ T, IsBinaryModel (fun i : Fin (T + 1) ↦ Y i.1)) :
    Filtration ℕ ‹MeasurableSpace Ω› :=
  Filtration.natural Y (ProbabilityTheory.binaryModelTruncations_stronglyMeasurable hY_binary)

/-- Helper for Theorem 22.10: the `p = 2` bridge from Chapter 11 uses the canonical
`ENNReal.ofReal` spelling. -/
private theorem fact_one_le_ofReal_two : Fact (1 ≤ ENNReal.ofReal 2) := by
  exact ⟨by norm_num⟩

/-- Helper for Theorem 22.10: a process identified with the conditional expectations of `X`
along its own natural filtration is a martingale. -/
private theorem binarySplitting_condExp_martingale
    {X : Ω → ℝ} {Y : ℕ → Ω → ℝ}
    (hY_binary : ∀ T, IsBinaryModel (fun i : Fin (T + 1) ↦ Y i.1))
    (hY_condExp : ∀ n,
      let ℱY := binaryNaturalFiltration Y hY_binary
      Y n =ᵐ[μ] μ[X | ℱY n]) :
    let ℱY := binaryNaturalFiltration Y hY_binary
    Martingale Y ℱY μ := by
  let ℱY := binaryNaturalFiltration Y hY_binary
  have hY_condExp' (n : ℕ) : Y n =ᵐ[μ] μ[X | ℱY n] := by
    simpa [ℱY, binaryNaturalFiltration] using hY_condExp n
  have hY_adapted : StronglyAdapted ℱY Y :=
    Filtration.stronglyAdapted_natural
      (ProbabilityTheory.binaryModelTruncations_stronglyMeasurable hY_binary)
  have hY_int : ∀ n, Integrable (Y n) μ := by
    intro n
    -- Proof comment: each stage is a version of the corresponding conditional expectation of `X`.
    exact integrable_condExp.congr (hY_condExp' n).symm
  -- Proof comment: the tower property turns the conditional-expectation identification into the
  -- one-step martingale recursion.
  refine MeasureTheory.martingale_nat hY_adapted hY_int fun n ↦ ?_
  have hsucc :
      μ[Y (n + 1) | ℱY n] =ᵐ[μ] μ[X | ℱY n] := by
    calc
      μ[Y (n + 1) | ℱY n] =ᵐ[μ] μ[μ[X | ℱY (n + 1)] | ℱY n] := by
        exact condExp_congr_ae (hY_condExp' (n + 1))
      _ =ᵐ[μ] μ[X | ℱY n] :=
        condExp_condExp_of_le (ℱY.mono n.le_succ) (ℱY.le (n + 1))
  exact (hY_condExp' n).trans hsucc.symm

/-- Helper for Theorem 22.10: the conditional-expectation realization of the binary process is
uniformly bounded in `L²` by the `L²` norm of `X`. -/
private theorem binarySplitting_condExp_l2Bound
    {X : Ω → ℝ} (hX_sq : MemLp X 2 μ) {Y : ℕ → Ω → ℝ}
    (hY_binary : ∀ T, IsBinaryModel (fun i : Fin (T + 1) ↦ Y i.1))
    (hY_condExp : ∀ n,
      let ℱY := binaryNaturalFiltration Y hY_binary
      Y n =ᵐ[μ] μ[X | ℱY n]) :
    ∃ C : NNReal, ∀ n, eLpNorm (Y n) (ENNReal.ofReal 2) μ ≤ C := by
  let ℱY := binaryNaturalFiltration Y hY_binary
  have hY_condExp' (n : ℕ) : Y n =ᵐ[μ] μ[X | ℱY n] := by
    simpa [ℱY, binaryNaturalFiltration] using hY_condExp n
  refine ⟨(eLpNorm X (ENNReal.ofReal 2) μ).toNNReal, fun n ↦ ?_⟩
  -- Proof comment: conditional expectation is contractive on `L²`.
  calc
    eLpNorm (Y n) (ENNReal.ofReal 2) μ =
        eLpNorm (μ[X | ℱY n]) (ENNReal.ofReal 2) μ := by
          rw [eLpNorm_congr_ae (hY_condExp' n)]
    _ ≤ eLpNorm X (ENNReal.ofReal 2) μ := by
          simpa using (eLpNorm_condExp_le (μ := μ) (m := ℱY n) (f := X))
    _ = (eLpNorm X (ENNReal.ofReal 2) μ).toNNReal := by
          rw [ENNReal.coe_toNNReal (by simpa using hX_sq.eLpNorm_lt_top.ne)]

/-- Helper for Theorem 22.10: expose the same conditional-expectation `L²` bound in the literal
exponent spelling `2`. -/
private theorem binarySplitting_condExp_l2Bound_two
    {X : Ω → ℝ} (hX_sq : MemLp X 2 μ) {Y : ℕ → Ω → ℝ}
    (hY_binary : ∀ T, IsBinaryModel (fun i : Fin (T + 1) ↦ Y i.1))
    (hY_condExp : ∀ n,
      let ℱY := binaryNaturalFiltration Y hY_binary
      Y n =ᵐ[μ] μ[X | ℱY n]) :
    ∃ C : NNReal, ∀ n, eLpNorm (Y n) 2 μ ≤ C := by
  -- Proof comment: this is only a normal-form bridge from `ENNReal.ofReal 2` to the literal
  -- exponent spelling used by the later analytic estimates.
  simpa using
    binarySplitting_condExp_l2Bound
      (μ := μ) (X := X) hX_sq (Y := Y) hY_binary hY_condExp

/-- Helper for Theorem 22.10: once an exact binary process is identified with the conditional
expectations of `X` along its own natural filtration, and its paths are already known to converge
almost surely to `X`, the martingale and `L²` convergence clauses follow from the Chapter 11 owner
theorem. -/
private theorem binarySplittingMartingale_of_condExpBridge
    {X : Ω → ℝ} (hX_sq : MemLp X 2 μ) {Y : ℕ → Ω → ℝ}
    (hY_binary : ∀ T, IsBinaryModel (fun i : Fin (T + 1) ↦ Y i.1)) (hY0 : Y 0 = 0)
    (hY_condExp : ∀ n,
      let ℱY := binaryNaturalFiltration Y hY_binary
      Y n =ᵐ[μ] μ[X | ℱY n])
    (hY_tendsto_ae : ∀ᵐ ω ∂μ, Tendsto (fun n ↦ Y n ω) atTop (𝓝 (X ω))) :
    let ℱY := binaryNaturalFiltration Y hY_binary
    Martingale Y ℱY μ ∧
      Y 0 = 0 ∧
      (∀ᵐ ω ∂μ, Tendsto (fun n ↦ Y n ω) atTop (𝓝 (X ω))) ∧
      TendstoInLp 2 μ Y X := by
  let ℱY := binaryNaturalFiltration Y hY_binary
  have hY_mart : Martingale Y ℱY μ := by
    simpa [ℱY, binaryNaturalFiltration] using
      binarySplitting_condExp_martingale (μ := μ) (X := X) (Y := Y) hY_binary hY_condExp
  have hY_l2_bdd' : ∃ C : NNReal, ∀ n, eLpNorm (Y n) (ENNReal.ofReal 2) μ ≤ C := by
    simpa [ℱY, binaryNaturalFiltration] using
      binarySplitting_condExp_l2Bound (μ := μ) (X := X) hX_sq (Y := Y) hY_binary hY_condExp
  obtain ⟨_, _, hY_tendsto_ae_limit, hY_tendsto_lp_limit⟩ :=
    MeasureTheory.martingale_convergence_to_memLp_limitProcess_of_lp_bounded
      (X := Y) (ℱ := ℱY) (μ := μ) (p := 2) hY_mart (by norm_num) hY_l2_bdd'
  have hY_limit' : Filtration.limitProcess Y ℱY μ =ᵐ[μ] X := by
    -- Proof comment: almost-sure convergence to the canonical martingale limit and to `X`
    -- forces those two terminal random variables to agree almost everywhere.
    filter_upwards [hY_tendsto_ae_limit, hY_tendsto_ae] with ω hω_limit hω_X
    exact tendsto_nhds_unique hω_limit hω_X
  have hY_tendsto_ae_X : ∀ᵐ ω ∂μ, Tendsto (fun n ↦ Y n ω) atTop (𝓝 (X ω)) := by
    -- Proof comment: keep the source-side almost-sure convergence as part of the final package.
    simpa using hY_tendsto_ae
  have hY_tendsto_eLpNorm_X :
      Tendsto (fun n ↦ eLpNorm (Y n - X) 2 μ) atTop (𝓝 0) := by
    letI : Fact (1 ≤ ENNReal.ofReal 2) := fact_one_le_ofReal_two
    have hnorm_eq :
        (fun n ↦ eLpNorm (Y n - Filtration.limitProcess Y ℱY μ) (ENNReal.ofReal 2) μ) =
          fun n ↦ eLpNorm (Y n - X) (ENNReal.ofReal 2) μ := by
      funext n
      rw [eLpNorm_congr_ae (EventuallyEq.sub EventuallyEq.rfl hY_limit')]
    have hlimit_norm :
        Tendsto
          (fun n ↦ eLpNorm (Y n - Filtration.limitProcess Y ℱY μ) (ENNReal.ofReal 2) μ)
          atTop (𝓝 0) := by
      simpa using hY_tendsto_lp_limit.tendsto_eLpNorm
    rw [hnorm_eq] at hlimit_norm
    simpa using hlimit_norm
  have hY_tendsto_lp_X : TendstoInLp 2 μ Y X := by
    -- Proof comment: Chapter 7 packages `L²` convergence as convergence of the `eLpNorm` errors.
    letI : Fact (1 ≤ ENNReal.ofReal 2) := fact_one_le_ofReal_two
    have hY_tendsto_lp_X' : TendstoInLp (ENNReal.ofReal 2) μ Y X := by
      exact tendstoInLp_iff_tendsto_eLpNorm.mpr
        ⟨hY_tendsto_lp_limit.memLpSeq, by simpa using hX_sq, by simpa using hY_tendsto_eLpNorm_X⟩
    simpa using hY_tendsto_lp_X'
  dsimp [ℱY]
  exact ⟨hY_mart, hY0, hY_tendsto_ae_X, hY_tendsto_lp_X⟩

/-- Helper for Theorem 22.10: the two-valued innovation alphabet used in the sign-splitting
construction. -/
private abbrev splitSignValue := {x : ℝ // x = -1 ∨ x = 1}

/-- Helper for Theorem 22.10: the positive branch innovation. -/
private def splitSignPlus : splitSignValue := ⟨1, Or.inr rfl⟩

/-- Helper for Theorem 22.10: the negative branch innovation. -/
private def splitSignMinus : splitSignValue := ⟨-1, Or.inl rfl⟩

/-- Helper for Theorem 22.10: compare two consecutive stages and record whether the process moved
up or down. -/
private noncomputable def splitSignOfStep (prev curr : ℝ) : splitSignValue :=
  if prev ≤ curr then splitSignPlus else splitSignMinus

/-- Helper for Theorem 22.10: coercing a split sign to `ℝ` always gives either `-1` or `1`. -/
private lemma splitSignValue_coe_eq (s : splitSignValue) : (s : ℝ) = -1 ∨ (s : ℝ) = 1 := by
  -- Proof comment: `splitSignValue` is exactly the subtype of reals with the two allowed values.
  simpa using s.2

/-- Helper for Theorem 22.10: every split sign has absolute value `1`. -/
private lemma abs_coe_splitSignValue (s : splitSignValue) : |(s : ℝ)| = 1 := by
  -- Proof comment: the innovation alphabet is `{ -1, 1 }`, so both branches have unit modulus.
  rcases splitSignValue_coe_eq s with hs | hs
  · rw [hs]
    norm_num
  · rw [hs]
    norm_num

/-- Helper for Theorem 22.10: the negative and positive split signs are distinct. -/
private lemma splitSignMinus_ne_splitSignPlus : splitSignMinus ≠ splitSignPlus := by
  -- Proof comment: the two subtype points have different real values `-1` and `1`.
  intro h
  have hval : ((splitSignMinus : splitSignValue) : ℝ) = (splitSignPlus : ℝ) :=
    congrArg (fun s : splitSignValue ↦ (s : ℝ)) h
  norm_num [splitSignMinus, splitSignPlus] at hval

/-- Helper for Theorem 22.10: every split sign is either the negative or the positive branch. -/
private lemma splitSign_eq_minus_or_eq_plus (s : splitSignValue) :
    s = splitSignMinus ∨ s = splitSignPlus := by
  -- Proof comment: the subtype definition leaves only the two sign values.
  rcases splitSignValue_coe_eq s with hs | hs
  · left
    apply Subtype.ext
    simpa [splitSignMinus] using hs
  · right
    apply Subtype.ext
    simpa [splitSignPlus] using hs

/-- Helper for Theorem 22.10: the split-sign alphabet is a canonical two-point finite type. -/
private noncomputable instance instFintypeSplitSignValue : Fintype splitSignValue where
  elems := {splitSignMinus, splitSignPlus}
  complete s := by
    rcases splitSign_eq_minus_or_eq_plus s with rfl | rfl <;> simp

/-- Helper for Theorem 22.10: moving one unit upward from `x` yields the positive comparison
sign. -/
private lemma splitSignOfStep_self_add_one (x : ℝ) :
    splitSignOfStep x (x + 1) = splitSignPlus := by
  -- Proof comment: after adding `1`, the next stage is certainly above the previous one.
  have hx : x ≤ x + 1 := by linarith
  simp [splitSignOfStep, hx]

/-- Helper for Theorem 22.10: moving one unit downward from `x` yields the negative comparison
sign. -/
private lemma splitSignOfStep_self_sub_one (x : ℝ) :
    splitSignOfStep x (x - 1) = splitSignMinus := by
  -- Proof comment: after subtracting `1`, the next stage is strictly below the previous one.
  have hx : ¬ x ≤ x - 1 := by linarith
  simp [splitSignOfStep, hx]

/-- Helper for Theorem 22.10: comparing two real-valued stages and then coercing the sign back to
`ℝ` is a measurable operation. -/
private lemma measurable_splitSignOfStep
    {m : MeasurableSpace Ω} {f g : Ω → ℝ}
    (hf : Measurable[m] f) (hg : Measurable[m] g) :
    Measurable[m] fun ω ↦ splitSignOfStep (f ω) (g ω) := by
  -- Proof comment: the comparison event `{ω | f ω ≤ g ω}` is measurable, and both sign branches
  -- are constant.
  refine Measurable.ite ?_ measurable_const measurable_const
  exact measurableSet_le hf hg

/-- Helper for Theorem 22.10: comparing two real-valued stages and then coercing the sign back to
`ℝ` is a measurable operation. -/
private lemma measurable_coe_splitSignOfStep
    {m : MeasurableSpace Ω} {f g : Ω → ℝ}
    (hf : Measurable[m] f) (hg : Measurable[m] g) :
    Measurable[m] fun ω ↦ ((splitSignOfStep (f ω) (g ω) : splitSignValue) : ℝ) := by
  -- Proof comment: the two output branches are constant, and the branch event is the measurable
  -- comparison set `{ω | f ω ≤ g ω}`.
  exact measurable_subtype_coe.comp (measurable_splitSignOfStep hf hg)

/-- Helper for Theorem 22.10: the length-`n` innovation history attached to a sign process. -/
private def splitSignHistory (D : ℕ → Ω → splitSignValue) (n : ℕ) (ω : Ω) :
    Fin n → splitSignValue :=
  fun i ↦ D i.1 ω

/-- Helper for Theorem 22.10: a measurable sign process has measurable finite histories. -/
private lemma splitSignHistory_measurable
    {D : ℕ → Ω → splitSignValue} (hD_meas : ∀ n, Measurable (D n)) (n : ℕ) :
    Measurable (splitSignHistory (Ω := Ω) D n) := by
  -- Proof comment: finite-coordinate measurability reduces to coordinatewise measurability.
  simpa [splitSignHistory] using
    measurable_pi_lambda (splitSignHistory (Ω := Ω) D n) fun i ↦ hD_meas i.1

/-- Helper for Theorem 22.10: append the latest sign to the shorter innovation history. -/
@[simp] private lemma splitSignHistory_succ
    (D : ℕ → Ω → splitSignValue) (n : ℕ) (ω : Ω) :
    splitSignHistory (Ω := Ω) D (n + 1) ω =
      Fin.snoc (splitSignHistory (Ω := Ω) D n ω) (D n ω) := by
  -- Proof comment: the first `n` coordinates are unchanged and the last coordinate is `D n`.
  funext i
  obtain ⟨j, rfl⟩ | rfl := Fin.eq_castSucc_or_eq_last i
  · simp [splitSignHistory]
  · simp [splitSignHistory]

/-- Helper for Theorem 22.10: any recursively defined finite-history process with the same
successor step as `splitSignHistory` is exactly the canonical split-sign history. -/
private lemma prefixHistory_eq_splitSignHistory
    {D : ℕ → Ω → splitSignValue} {H : (n : ℕ) → Ω → Fin n → splitSignValue}
    (hSucc : ∀ n ω, H (n + 1) ω = Fin.snoc (H n ω) (D n ω)) :
    ∀ n, H n = splitSignHistory (Ω := Ω) D n := by
  intro n
  induction n with
  | zero =>
      funext ω i
      exact nomatch i
  | succ n ih =>
      funext ω
      -- Proof comment: both histories are obtained by appending the same last sign to the same
      -- length-`n` prefix, so the induction hypothesis identifies the full successor stage.
      rw [hSucc n ω, splitSignHistory_succ]
      have hsnoc :
          (Fin.snoc (H n ω) (D n ω) : Fin (n + 1) → splitSignValue) =
            Fin.snoc (splitSignHistory (Ω := Ω) D n ω) (D n ω) := by
        simpa using
          congrArg
            (fun h : Fin n → splitSignValue ↦
              (Fin.snoc h (D n ω) : Fin (n + 1) → splitSignValue))
            (congrFun ih ω)
      exact hsnoc

/-- Helper for Theorem 22.10: one stage of the finite-history recursion stores the current
history map, its representative, and the stage conditional-expectation identity. -/
private structure RecursiveSplitSignStage
    (μ : Measure Ω) [IsProbabilityMeasure μ] (Xm : Ω → ℝ) (n : ℕ) where
  H : Ω → Fin n → splitSignValue
  g : (Fin n → splitSignValue) → ℝ
  hH_meas : Measurable H
  hg_meas : Measurable g
  hCondExp :
    g ∘ H =ᵐ[μ] μ[Xm | MeasurableSpace.comap H inferInstance]

/-- Helper for Theorem 22.10: the stage-`n` split-sign σ-algebra is the pullback along the
length-`n` innovation history. -/
private abbrev splitSignFiltrationStage (D : ℕ → Ω → splitSignValue) (n : ℕ) : MeasurableSpace Ω :=
  MeasurableSpace.comap (splitSignHistory (Ω := Ω) D n) inferInstance

/-- Helper for Theorem 22.10: forgetting the last `n - k` innovations turns a length-`n` history
into its length-`k` prefix. -/
private def restrictSplitSignHistory {k n : ℕ} (hkn : k ≤ n) :
    (Fin n → splitSignValue) → (Fin k → splitSignValue) :=
  fun hist i ↦ hist ⟨i.1, lt_of_lt_of_le i.2 hkn⟩

/-- Helper for Theorem 22.10: the deterministic prefix map on sign histories is measurable. -/
private lemma restrictSplitSignHistory_measurable {k n : ℕ} (hkn : k ≤ n) :
    Measurable (restrictSplitSignHistory (k := k) (n := n) hkn) := by
  -- Proof comment: measurability on a finite product is checked coordinatewise.
  classical
  exact measurable_of_finite _

/-- Helper for Theorem 22.10: the shorter sign history factors through any longer history by the
deterministic prefix map. -/
private lemma splitSignHistory_factor_through_prefix
    (D : ℕ → Ω → splitSignValue) {k n : ℕ} (hkn : k ≤ n) :
    splitSignHistory (Ω := Ω) D k =
      restrictSplitSignHistory (k := k) (n := n) hkn ∘ splitSignHistory (Ω := Ω) D n := by
  -- Proof comment: both sides read exactly the first `k` coordinates of the same sign process.
  funext ω
  funext i
  rfl

/-- Helper for Theorem 22.10: any real random variable measurable with respect to the stage-`n`
split-sign σ-algebra factors exactly through the length-`n` sign history. -/
private theorem exists_splitSignFiltrationStage_factorization
    {D : ℕ → Ω → splitSignValue} {f : Ω → ℝ} {n : ℕ}
    (hf : Measurable[splitSignFiltrationStage (Ω := Ω) D n] f) :
    ∃ g : (Fin n → splitSignValue) → ℝ,
      Measurable g ∧
      f = g ∘ splitSignHistory (Ω := Ω) D n := by
  -- Proof comment: `splitSignFiltrationStage D n` is the pullback along the length-`n`
  -- sign-history map, so the Doob-Dynkin lemma provides an exact measurable factorization.
  simpa [splitSignFiltrationStage] using hf.exists_eq_measurable_comp

/-- Helper for Theorem 22.10: the stagewise conditional expectation of `X` with respect to the
split-sign filtration admits an exact finite-history representative. -/
private theorem splitStage_condExp_factorization
    {X : Ω → ℝ} {D : ℕ → Ω → splitSignValue} (n : ℕ) :
    ∃ g : (Fin n → splitSignValue) → ℝ,
      Measurable g ∧
      μ[X | splitSignFiltrationStage (Ω := Ω) D n] =
        g ∘ splitSignHistory (Ω := Ω) D n := by
  -- Proof comment: conditional expectation is measurable with respect to the conditioning
  -- σ-algebra, so the previous factorization lemma turns it into a literal history function.
  exact exists_splitSignFiltrationStage_factorization (Ω := Ω) (D := D)
    (f := μ[X | splitSignFiltrationStage (Ω := Ω) D n])
    (n := n) stronglyMeasurable_condExp.measurable

/-- Helper for Theorem 22.10: conditional expectation with respect to any finite split-sign
history admits an exact deterministic representative on that history space. -/
private theorem prefixCondExp_factorization
    {X : Ω → ℝ} {n : ℕ} (H : Ω → Fin n → splitSignValue) :
    ∃ g : (Fin n → splitSignValue) → ℝ,
      Measurable g ∧
      μ[X | MeasurableSpace.comap H inferInstance] = g ∘ H := by
  -- Proof comment: conditioning on the pullback along `H` already makes the conditional
  -- expectation measurable with respect to that pullback, so the Doob-Dynkin lemma yields an
  -- exact representative on the finite history space.
  have hcond_meas :
      Measurable[MeasurableSpace.comap H inferInstance]
        (μ[X | MeasurableSpace.comap H inferInstance]) :=
    stronglyMeasurable_condExp.measurable
  simpa using hcond_meas.exists_eq_measurable_comp

/-- Helper for Theorem 22.10: if a conditional expectation is constant on one measurable history
atom, then integrating over that atom collapses to the atom mass times the frozen value. -/
private theorem atomwiseSetIntegral_of_condExp_const
    {m : MeasurableSpace Ω} (hm : m ≤ mΩ) [SigmaFinite (μ.trim hm)]
    {A : Set Ω} (hA : MeasurableSet[m] A) {f g : Ω → ℝ} (hf : Integrable f μ)
    (hfg : μ[f | m] =ᵐ[μ] g) {c : ℝ} (hgconst : Set.EqOn g (fun _ ↦ c) A) :
    ∫ ω in A, f ω ∂μ = μ.real A * c := by
  have hA_meas : @MeasurableSet Ω mΩ A := hm _ hA
  -- Proof comment: first replace `f` by its conditional expectation on the atom.
  calc
    ∫ ω in A, f ω ∂μ = ∫ ω in A, (μ[f | m]) ω ∂μ := by
      symm
      exact MeasureTheory.setIntegral_condExp hm hf hA
    _ = ∫ ω in A, g ω ∂μ := by
      refine setIntegral_congr_ae hA_meas ?_
      exact hfg.mono fun _ h _ ↦ h
    _ = ∫ ω in A, c ∂μ := by
      exact setIntegral_congr_fun hA_meas hgconst
    _ = μ.real A * c := by
      rw [MeasureTheory.setIntegral_const]
      simp [smul_eq_mul]

/-- Helper for Theorem 22.10: appending the comparison sign to a measurable finite history
produces another measurable finite history. -/
private lemma prefixHistory_snoc_measurable
    {X : Ω → ℝ} {n : ℕ} {H : Ω → Fin n → splitSignValue}
    {g : (Fin n → splitSignValue) → ℝ}
    (hH : Measurable H) (hg : Measurable g) (hX : Measurable X) :
    Measurable fun ω ↦
      (Fin.snoc (H ω)
        ((if g (H ω) ≤ X ω then splitSignPlus else splitSignMinus) : splitSignValue) :
        Fin (n + 1) → splitSignValue) := by
  -- Proof comment: the existing coordinates come from `H`; the new last coordinate is a
  -- piecewise constant sign on the measurable comparison event.
  refine measurable_pi_lambda _ fun i ↦ ?_
  obtain ⟨j, rfl⟩ | rfl := Fin.eq_castSucc_or_eq_last i
  · simpa using (measurable_pi_apply j).comp hH
  · simpa using
      (Measurable.ite (measurableSet_le (hg.comp hH) hX)
        measurable_const measurable_const)

/-- Helper for Theorem 22.10: append the source comparison sign against `Xm` to a finite split
history. -/
private noncomputable def nextSplitSignHistory
    {Xm : Ω → ℝ} {n : ℕ} (H : Ω → Fin n → splitSignValue)
    (g : (Fin n → splitSignValue) → ℝ) (ω : Ω) :
    Fin (n + 1) → splitSignValue :=
  Fin.snoc (H ω) (splitSignOfStep (g (H ω)) (Xm ω))

/-- Helper for Theorem 22.10: restricting a successor split history to its first `n` coordinates
recovers the original prefix. -/
@[simp] private lemma restrictSplitSignHistory_succ_snoc
    {n : ℕ} (hist : Fin n → splitSignValue) (s : splitSignValue) :
    restrictSplitSignHistory (k := n) (n := n + 1) (Nat.le_succ n) (Fin.snoc hist s) = hist := by
  -- Proof comment: the prefix map simply forgets the appended last sign.
  funext i
  have hi :
      (⟨i.1, lt_of_lt_of_le i.2 (Nat.le_succ n)⟩ : Fin (n + 1)) = i.castSucc := by
    apply Fin.ext
    simp
  rw [restrictSplitSignHistory, hi, Fin.snoc_castSucc]

/-- Helper for Theorem 22.10: explicit null-fiber patch of a raw next-stage representative on the
finite successor history space. -/
private noncomputable def patchedNextRepresentative
    {Xm : Ω → ℝ} {n : ℕ} (H : Ω → Fin n → splitSignValue)
    (g : (Fin n → splitSignValue) → ℝ)
    (gNext0 : (Fin (n + 1) → splitSignValue) → ℝ) :
    (Fin (n + 1) → splitSignValue) → ℝ :=
  fun z ↦
    let hist := restrictSplitSignHistory (k := n) (n := n + 1) (Nat.le_succ n) z
    if hμz :
        μ (nextSplitSignHistory (Ω := Ω) (Xm := Xm) H g ⁻¹' {z}) = 0 then
      if z (Fin.last n) = splitSignPlus then
        g hist + 1
      else
        g hist - 1
    else
      gNext0 z

/-- Helper for Theorem 22.10: the explicit null-fiber patch is measurable because the successor
history space is finite. -/
private lemma measurable_patchedNextRepresentative
    {Xm : Ω → ℝ} {n : ℕ} (H : Ω → Fin n → splitSignValue)
    (g : (Fin n → splitSignValue) → ℝ)
    (gNext0 : (Fin (n + 1) → splitSignValue) → ℝ) :
    Measurable (patchedNextRepresentative (Ω := Ω) (μ := μ) (Xm := Xm) H g gNext0) := by
  -- Proof comment: any function on the finite discrete successor-history space is measurable.
  classical
  exact measurable_of_finite _

/-- Helper for Theorem 22.10: if the raw next-stage representative already has the correct sign
on every non-null successor fiber, then the explicit null-fiber patch keeps that sign relation on
all successor histories and only changes the representative on a null set. -/
private theorem patchedNextRepresentative_of_rawRepresentative
    {Xm : Ω → ℝ} {n : ℕ} {H : Ω → Fin n → splitSignValue}
    {g : (Fin n → splitSignValue) → ℝ}
    {gNext0 : (Fin (n + 1) → splitSignValue) → ℝ}
    (hRaw :
      ∀ hist s,
        μ (nextSplitSignHistory (Ω := Ω) (Xm := Xm) H g ⁻¹' {Fin.snoc hist s}) ≠ 0 →
          splitSignOfStep (g hist) (gNext0 (Fin.snoc hist s)) = s) :
    ∃ gNext : (Fin (n + 1) → splitSignValue) → ℝ,
      Measurable gNext ∧
      (∀ hist s, splitSignOfStep (g hist) (gNext (Fin.snoc hist s)) = s) ∧
      (gNext ∘ nextSplitSignHistory (Ω := Ω) (Xm := Xm) H g) =ᵐ[μ]
      (gNext0 ∘ nextSplitSignHistory (Ω := Ω) (Xm := Xm) H g) := by
  refine ⟨patchedNextRepresentative (Ω := Ω) (μ := μ) (Xm := Xm) H g gNext0,
    measurable_patchedNextRepresentative (Ω := Ω) (μ := μ) (Xm := Xm) H g gNext0, ?_, ?_⟩
  · intro hist s
    -- Proof comment: on null fibers the patch uses `g hist ± 1`, and on non-null fibers it
    -- delegates to the raw comparison hypothesis.
    by_cases hμ :
        μ (nextSplitSignHistory (Ω := Ω) (Xm := Xm) H g ⁻¹' {Fin.snoc hist s}) = 0
    · rcases splitSign_eq_minus_or_eq_plus s with rfl | rfl
      · simp [patchedNextRepresentative, hμ, splitSignMinus_ne_splitSignPlus,
          restrictSplitSignHistory_succ_snoc, splitSignOfStep_self_sub_one]
      · simp [patchedNextRepresentative, hμ, restrictSplitSignHistory_succ_snoc,
          splitSignOfStep_self_add_one]
    · simp [patchedNextRepresentative, hμ, hRaw hist s hμ, restrictSplitSignHistory_succ_snoc]
  · let Hnext : Ω → Fin (n + 1) → splitSignValue :=
      nextSplitSignHistory (Ω := Ω) (Xm := Xm) H g
    let badFibers : (Fin (n + 1) → splitSignValue) → Set Ω :=
      fun z ↦ if μ (Hnext ⁻¹' {z}) = 0 then Hnext ⁻¹' {z} else ∅
    have hBadNull : μ (⋃ z, badFibers z) = 0 := by
      -- Proof comment: the disagreement set is a countable union of null fibers.
      refine MeasureTheory.measure_iUnion_null fun z ↦ ?_
      by_cases hz : μ (Hnext ⁻¹' {z}) = 0
      · simp [badFibers, hz]
      · simp [badFibers, hz]
    have hBadAE : ∀ᵐ ω ∂μ, ω ∉ ⋃ z, badFibers z :=
      (MeasureTheory.measure_eq_zero_iff_ae_notMem).mp hBadNull
    filter_upwards [hBadAE] with ω hω
    have hωnonnull : μ (Hnext ⁻¹' {Hnext ω}) ≠ 0 := by
      intro hzero
      have hmem : ω ∈ ⋃ z, badFibers z := by
        refine Set.mem_iUnion.2 ⟨Hnext ω, ?_⟩
        simp [badFibers, hzero]
      exact hω hmem
    -- Proof comment: outside the union of null fibers, the patch uses the raw representative.
    simp [Function.comp, patchedNextRepresentative, Hnext, hωnonnull]

/-- Helper for Theorem 22.10: on every non-null successor history atom, the raw conditional-
expectation representative already chooses the correct comparison sign. -/
private lemma mem_nextSplitSignHistoryAtom_iff
    {Xm : Ω → ℝ} {n : ℕ} {H : Ω → Fin n → splitSignValue}
    {g : (Fin n → splitSignValue) → ℝ} {ω : Ω}
    (hist : Fin n → splitSignValue) (s : splitSignValue) :
    ω ∈ nextSplitSignHistory (Ω := Ω) (Xm := Xm) H g ⁻¹' {Fin.snoc hist s} ↔
      H ω = hist ∧ splitSignOfStep (g hist) (Xm ω) = s := by
  constructor
  · intro hω
    have hEq :
        nextSplitSignHistory (Ω := Ω) (Xm := Xm) H g ω = Fin.snoc hist s := by
      simpa using hω
    have hPrefixEq :=
      congrArg
        (restrictSplitSignHistory (k := n) (n := n + 1) (Nat.le_succ n))
        hEq
    have hPrefix : H ω = hist := by
      simpa [nextSplitSignHistory, restrictSplitSignHistory_succ_snoc] using hPrefixEq
    have hLast := congrFun hEq (Fin.last n)
    have hStep : splitSignOfStep (g hist) (Xm ω) = s := by
      simpa [nextSplitSignHistory, hPrefix] using hLast
    exact ⟨hPrefix, hStep⟩
  · rintro ⟨hPrefix, hStep⟩
    simp [nextSplitSignHistory, hPrefix, hStep]

/-- Helper for Theorem 22.10: on every non-null successor history atom, the raw conditional-
expectation representative already chooses the correct comparison sign. -/
private theorem rawRepresentative_sign_on_nonnullNextFiber
    {Xm : Ω → ℝ} (hXm_meas : Measurable Xm) (hXm_int : Integrable Xm μ)
    {n : ℕ} {H : Ω → Fin n → splitSignValue} {g : (Fin n → splitSignValue) → ℝ}
    (hH : Measurable H) (hg : Measurable g)
    {gNext0 : (Fin (n + 1) → splitSignValue) → ℝ}
    (hNextEq :
      μ[Xm | MeasurableSpace.comap (nextSplitSignHistory (Ω := Ω) (Xm := Xm) H g) inferInstance] =
        gNext0 ∘ nextSplitSignHistory (Ω := Ω) (Xm := Xm) H g)
    (hist : Fin n → splitSignValue) (s : splitSignValue)
    (hμ :
      μ (nextSplitSignHistory (Ω := Ω) (Xm := Xm) H g ⁻¹' {Fin.snoc hist s}) ≠ 0) :
    splitSignOfStep (g hist) (gNext0 (Fin.snoc hist s)) = s := by
  let Hnext : Ω → Fin (n + 1) → splitSignValue :=
    nextSplitSignHistory (Ω := Ω) (Xm := Xm) H g
  let A : Set Ω := Hnext ⁻¹' {Fin.snoc hist s}
  let c : ℝ := gNext0 (Fin.snoc hist s)
  have hHnext_meas : Measurable Hnext := by
    -- Proof comment: the successor history is obtained by appending one measurable comparison
    -- sign to the measurable prefix history.
    simpa [Hnext] using prefixHistory_snoc_measurable
      (Ω := Ω) (X := Xm) (H := H) (g := g) hH hg hXm_meas
  have hm : MeasurableSpace.comap Hnext inferInstance ≤ mΩ := hHnext_meas.comap_le
  have hA_meas_comap : MeasurableSet[MeasurableSpace.comap Hnext inferInstance] A := by
    -- Proof comment: each successor fiber is measurable in the pullback σ-algebra by
    -- construction.
    refine MeasurableSpace.measurableSet_comap.2 ?_
    let z : Fin (n + 1) → splitSignValue := Fin.snoc hist s
    refine ⟨({z} : Set (Fin (n + 1) → splitSignValue)), ?_, ?_⟩
    · simpa [z] using
        (measurableSet_singleton z : MeasurableSet ({z} : Set (Fin (n + 1) → splitSignValue)))
    · simp [A, z]
  have hA_meas : MeasurableSet A := hm _ hA_meas_comap
  have hμreal_pos : 0 < μ.real A := by
    -- Proof comment: the active fiber has positive measure, so its real mass is strictly
    -- positive as well.
    simpa [A] using ENNReal.toReal_pos hμ (by finiteness)
  have hAtomIntegral :
      ∫ ω in A, Xm ω ∂μ = μ.real A * c := by
    -- Proof comment: on a fixed successor fiber, the conditional expectation is literally the
    -- constant representative `c`.
    refine atomwiseSetIntegral_of_condExp_const
      (μ := μ) (m := MeasurableSpace.comap Hnext inferInstance) hm hA_meas_comap hXm_int
      (EventuallyEq.of_eq hNextEq) ?_
    intro ω hω
    have hω' : Hnext ω = Fin.snoc hist s := by
      simpa [A] using hω
    simpa [Hnext, Function.comp, c] using congrArg gNext0 hω'
  rcases splitSign_eq_minus_or_eq_plus s with rfl | rfl
  · let u : Ω → ℝ := fun ω ↦ g hist - Xm ω
    have hu_integrableOn : IntegrableOn u A μ := by
      -- Proof comment: the negative-branch comparison function is a constant minus the
      -- integrable target.
      exact (integrableOn_const (μ := μ) (s := A)).sub hXm_int.integrableOn
    have hu_nonneg : 0 ≤ᵐ[μ.restrict A] u := by
      -- Proof comment: on the negative branch atom, every source value lies strictly below
      -- `g hist`, hence `g hist - Xm` is nonnegative there.
      rw [Filter.EventuallyLE, MeasureTheory.ae_restrict_iff' hA_meas]
      exact Filter.Eventually.of_forall fun ω hω ↦ by
        rcases (mem_nextSplitSignHistoryAtom_iff
          (Ω := Ω) (Xm := Xm) (H := H) (g := g) hist splitSignMinus).1 hω with
          ⟨-, hStep⟩
        have hnotle : ¬ g hist ≤ Xm ω := by
          intro hle
          have : splitSignPlus = splitSignMinus := by
            simpa [splitSignOfStep, hle] using hStep
          exact splitSignMinus_ne_splitSignPlus this.symm
        exact sub_nonneg.mpr (le_of_lt (lt_of_not_ge hnotle))
    have hSupportPos : 0 < μ (Function.support u ∩ A) := by
      -- Proof comment: on this atom, `u = g hist - Xm` is pointwise strictly positive, so the
      -- whole atom lies inside the support.
      have hsubset : A ⊆ Function.support u ∩ A := by
        intro ω hω
        rcases (mem_nextSplitSignHistoryAtom_iff
          (Ω := Ω) (Xm := Xm) (H := H) (g := g) hist splitSignMinus).1 hω with
          ⟨-, hStep⟩
        have hnotle : ¬ g hist ≤ Xm ω := by
          intro hle
          have : splitSignPlus = splitSignMinus := by
            simpa [splitSignOfStep, hle] using hStep
          exact splitSignMinus_ne_splitSignPlus this.symm
        have hlt : Xm ω < g hist := lt_of_not_ge hnotle
        refine ⟨?_, hω⟩
        simp [u, sub_eq_zero, ne_of_gt (sub_pos.mpr hlt)]
      exact lt_of_lt_of_le (show 0 < μ A by exact pos_iff_ne_zero.2 hμ) (measure_mono hsubset)
    have hu_integral_pos : 0 < ∫ ω in A, u ω ∂μ := by
      -- Proof comment: a nonnegative integrable function that is strictly positive on a set of
      -- positive measure has strictly positive integral.
      exact (MeasureTheory.setIntegral_pos_iff_support_of_nonneg_ae hu_nonneg hu_integrableOn).2
        hSupportPos
    have hu_integral :
        ∫ ω in A, u ω ∂μ = μ.real A * (g hist - c) := by
      -- Proof comment: subtract the frozen atom average `c` from the integral identity for `Xm`.
      calc
        ∫ ω in A, u ω ∂μ = ∫ ω in A, g hist - Xm ω ∂μ := by rfl
        _ = ∫ ω in A, g hist ∂μ - ∫ ω in A, Xm ω ∂μ := by
          exact integral_sub (integrableOn_const (μ := μ) (s := A)) hXm_int.integrableOn
        _ = μ.real A * g hist - μ.real A * c := by
          simp [MeasureTheory.setIntegral_const, hAtomIntegral, smul_eq_mul]
        _ = μ.real A * (g hist - c) := by ring
    have hlt : c < g hist := by
      have hscaled : 0 < μ.real A * (g hist - c) := by
        simpa [hu_integral] using hu_integral_pos
      nlinarith
    have hnotle : ¬ g hist ≤ c := not_le.mpr hlt
    -- Proof comment: strict negativity of the averaged increment forces the recovered sign to be
    -- the negative branch.
    simpa [splitSignOfStep, c, hnotle]
  · have hIntegralNonneg : 0 ≤ ∫ ω in A, (Xm ω - g hist) ∂μ := by
      -- Proof comment: on the positive branch atom, every source value lies at or above
      -- `g hist`.
      exact MeasureTheory.setIntegral_nonneg hA_meas fun ω hω ↦ by
        rcases (mem_nextSplitSignHistoryAtom_iff
          (Ω := Ω) (Xm := Xm) (H := H) (g := g) hist splitSignPlus).1 hω with
          ⟨-, hStep⟩
        by_cases hle : g hist ≤ Xm ω
        · exact sub_nonneg.mpr hle
        · have : splitSignMinus = splitSignPlus := by
            simpa [splitSignOfStep, hle] using hStep
          exact False.elim (splitSignMinus_ne_splitSignPlus this)
    have hIntegralDiff :
        ∫ ω in A, (Xm ω - g hist) ∂μ = μ.real A * (c - g hist) := by
      -- Proof comment: the atomwise integral of `Xm - g hist` is the atom mass times the same
      -- difference for the frozen representative.
      calc
        ∫ ω in A, (Xm ω - g hist) ∂μ = ∫ ω in A, Xm ω ∂μ - ∫ ω in A, g hist ∂μ := by
          exact integral_sub hXm_int.integrableOn (integrableOn_const (μ := μ) (s := A))
        _ = μ.real A * c - μ.real A * g hist := by
          simp [hAtomIntegral, MeasureTheory.setIntegral_const, smul_eq_mul]
        _ = μ.real A * (c - g hist) := by ring
    have hle : g hist ≤ c := by
      have hscaled : 0 ≤ μ.real A * (c - g hist) := by
        simpa [hIntegralDiff] using hIntegralNonneg
      nlinarith
    -- Proof comment: nonnegativity of the averaged increment forces the recovered sign to be the
    -- positive branch.
    simpa [splitSignOfStep, c, hle]

/-- Helper for Theorem 22.10: one finite split-sign history step extends to the next stage while
preserving the exact sign recursion and the conditional-expectation factorization up to
almost-everywhere equality. -/
private theorem exists_nextSplitSignFactorization
    {Xm : Ω → ℝ} (hXm_meas : Measurable Xm) (hXm_int : Integrable Xm μ)
    {n : ℕ} {H : Ω → Fin n → splitSignValue} {g : (Fin n → splitSignValue) → ℝ}
    (hH : Measurable H) (hg : Measurable g) :
    ∃ gNext : (Fin (n + 1) → splitSignValue) → ℝ,
      Measurable gNext ∧
      (∀ hist s, splitSignOfStep (g hist) (gNext (Fin.snoc hist s)) = s) ∧
      (gNext ∘ nextSplitSignHistory (Ω := Ω) (Xm := Xm) H g) =ᵐ[μ]
        μ[Xm | MeasurableSpace.comap (nextSplitSignHistory (Ω := Ω) (Xm := Xm) H g) inferInstance] := by
  let Hnext : Ω → Fin (n + 1) → splitSignValue :=
    nextSplitSignHistory (Ω := Ω) (Xm := Xm) H g
  obtain ⟨gNext0, hgNext0, hNextEq⟩ := prefixCondExp_factorization (Ω := Ω) (μ := μ) (X := Xm) Hnext
  have hRaw :
      ∀ hist s,
        μ (Hnext ⁻¹' {Fin.snoc hist s}) ≠ 0 →
          splitSignOfStep (g hist) (gNext0 (Fin.snoc hist s)) = s := by
    intro hist s hμ
    simpa [Hnext] using
      rawRepresentative_sign_on_nonnullNextFiber
        (Ω := Ω) (μ := μ) (Xm := Xm) hXm_meas hXm_int hH hg hNextEq hist s hμ
  obtain ⟨gNext, hgNext, hSign, hPatchAe⟩ :=
    patchedNextRepresentative_of_rawRepresentative
      (Ω := Ω) (μ := μ) (Xm := Xm) (H := H) (g := g) (gNext0 := gNext0) hRaw
  refine ⟨gNext, hgNext, hSign, ?_⟩
  exact hPatchAe.trans (EventuallyEq.of_eq hNextEq).symm

/-- Helper for Theorem 22.10: the previous stage value read from a positive-time history. -/
private def previousPriceInHistory (x0 : ℝ) {n : ℕ} (hist : Fin n → ℝ) (i : Fin n) : ℝ :=
  if h : i.1 = 0 then
    x0
  else
    hist ⟨i.1 - 1, lt_trans (Nat.sub_lt (Nat.pos_of_ne_zero h) (by norm_num)) i.2⟩

/-- Helper for Theorem 22.10: recover the innovation history from a realized price history by
comparing consecutive values, starting from the deterministic value `x0` at time `0`. -/
private noncomputable def recoveredSplitSignHistory (x0 : ℝ) {n : ℕ} (hist : Fin n → ℝ) :
    Fin n → splitSignValue :=
  fun i ↦ splitSignOfStep (previousPriceInHistory x0 hist i) (hist i)

/-- Helper for Theorem 22.10: if the sign at each step is recovered by comparing consecutive
process values, then the whole innovation history can be reconstructed from the positive-time
price history. -/
private lemma recoveredSplitSignHistory_eq_actual
    {x0 : ℝ} {Y : ℕ → Ω → ℝ} {D : ℕ → Ω → splitSignValue}
    (hY0 : Y 0 = fun _ ↦ x0)
    (hRecover : ∀ n ω, D n ω = splitSignOfStep (Y n ω) (Y (n + 1) ω))
    (n : ℕ) (ω : Ω) :
    recoveredSplitSignHistory x0 (fun i : Fin n ↦ Y (i.1 + 1) ω) =
      splitSignHistory (Ω := Ω) D n ω := by
  -- Proof comment: proceed by extending the shorter recovered history with the final comparison.
  induction n with
  | zero =>
      funext i
      exact nomatch i
  | succ n ih =>
      funext i
      obtain ⟨j, rfl⟩ | rfl := Fin.eq_castSucc_or_eq_last i
      · have hPrevCast :
            previousPriceInHistory x0 (fun k : Fin (n + 1) ↦ Y (k.1 + 1) ω) j.castSucc =
              previousPriceInHistory x0 (fun k : Fin n ↦ Y (k.1 + 1) ω) j := by
          -- Proof comment: earlier coordinates use the same predecessor inside the prefix history.
          by_cases h : j.1 = 0 <;> simp [previousPriceInHistory, h]
        have hCurrCast :
            (fun k : Fin (n + 1) ↦ Y (k.1 + 1) ω) j.castSucc =
              (fun k : Fin n ↦ Y (k.1 + 1) ω) j := rfl
        have hPrefix := congrFun ih j
        simpa [recoveredSplitSignHistory, splitSignHistory, hPrevCast, hCurrCast] using hPrefix
      · have hBase : Y 0 ω = x0 := by simpa using congrFun hY0 ω
        have hPrevLast :
            previousPriceInHistory x0 (fun k : Fin (n + 1) ↦ Y (k.1 + 1) ω) (Fin.last n) =
              Y n ω := by
          cases n with
          | zero =>
              simp [previousPriceInHistory, hBase]
          | succ n =>
              simp [previousPriceInHistory]
        have hCurrLast :
            (fun k : Fin (n + 1) ↦ Y (k.1 + 1) ω) (Fin.last n) = Y (n + 1) ω := by
          simp
        simpa [recoveredSplitSignHistory, splitSignHistory, hPrevLast, hCurrLast] using
          (hRecover n ω).symm

/-- Helper for Theorem 22.10: exact finite-history factorization plus pointwise sign recovery is
enough to package the truncations of a process as Chapter 9 binary models. -/
private theorem binaryTruncation_isBinaryModel_of_factorization
    {x0 : ℝ} {Y : ℕ → Ω → ℝ} {D : ℕ → Ω → splitSignValue}
    (hY0 : Y 0 = fun _ ↦ x0)
    (hD_meas : ∀ n, Measurable (D n))
    (hFactor :
      ∀ n, ∃ g : (Fin n → splitSignValue) → ℝ,
        Measurable g ∧ Y n = fun ω ↦ g (splitSignHistory (Ω := Ω) D n ω))
    (hRecover : ∀ n ω, D n ω = splitSignOfStep (Y n ω) (Y (n + 1) ω)) :
    ∀ T, IsBinaryModel (fun i : Fin (T + 1) ↦ Y i.1) := by
  classical
  choose g hg_meas hg_eq using hFactor
  intro T
  refine ⟨?_, x0, ?_, ?_⟩
  · intro i
    -- Proof comment: each stage is a measurable function of the finite sign history.
    simpa [hg_eq i.1] using
      (hg_meas i.1).comp (splitSignHistory_measurable (Ω := Ω) hD_meas i.1)
  · simpa using hY0
  · refine ⟨fun n : Fin T ↦ D n.1, ?_, ?_⟩
    · intro n
      exact hD_meas n.1
    · refine ⟨fun n hist s ↦ g (n.1 + 1) (Fin.snoc (recoveredSplitSignHistory x0 hist) s), ?_⟩
      intro n
      funext ω
      -- Proof comment: reconstruct the prior signs from the observed history, append the current
      -- innovation, and then evaluate the exact factorization map for stage `n + 1`.
      have hRec :
          recoveredSplitSignHistory x0
              (ProbabilityTheory.binaryModelHistory (fun i : Fin (T + 1) ↦ Y i.1) n ω) =
            splitSignHistory (Ω := Ω) D n.1 ω := by
        simpa [ProbabilityTheory.binaryModelHistory] using
          recoveredSplitSignHistory_eq_actual (Ω := Ω) hY0 hRecover n.1 ω
      simpa [hg_eq (n.1 + 1), splitSignHistory_succ, hRec]

/-- Helper for Theorem 22.10: if each stage `Y k` factors through the first `k` split signs, then
the natural filtration of `Y` up to time `n` is contained in the split-sign filtration at time
`n`. -/
private theorem naturalFiltration_le_splitSignFiltrationStage
    {Y : ℕ → Ω → ℝ} {D : ℕ → Ω → splitSignValue}
    (hY_meas : ∀ n, StronglyMeasurable (Y n))
    (hFactor :
      ∀ n, ∃ g : (Fin n → splitSignValue) → ℝ,
        Measurable g ∧ Y n = fun ω ↦ g (splitSignHistory (Ω := Ω) D n ω))
    (n : ℕ) :
    Filtration.natural Y hY_meas n ≤ splitSignFiltrationStage (Ω := Ω) D n := by
  -- Proof comment: every generator `Y k` with `k ≤ n` is already a measurable function of the
  -- length-`n` innovation history via the deterministic prefix map.
  rw [Filtration.natural]
  refine iSup₂_le fun k hk ↦ ?_
  rcases hFactor k with ⟨gk, hgk_meas, hgk_eq⟩
  have hYk_meas : Measurable[splitSignFiltrationStage (Ω := Ω) D n] (Y k) := by
    rw [hgk_eq, splitSignHistory_factor_through_prefix (Ω := Ω) D hk]
    exact hgk_meas.comp
      ((restrictSplitSignHistory_measurable (k := k) (n := n) hk).comp (comap_measurable _))
  exact hYk_meas.comap_le

/-- Helper for Theorem 22.10: once each stage agrees with `μ[X | 𝒢 n]` for the split-sign
filtration and the stages factor through the corresponding finite sign histories, the same stages
also agree with the conditional expectations of `X` along the natural filtration of `Y`. -/
private theorem splitStage_condExp_natural
    {X : Ω → ℝ} {Y : ℕ → Ω → ℝ} {D : ℕ → Ω → splitSignValue}
    (hY_binary : ∀ T, IsBinaryModel (fun i : Fin (T + 1) ↦ Y i.1))
    (hD_meas : ∀ n, Measurable (D n))
    (hFactor :
      ∀ n, ∃ g : (Fin n → splitSignValue) → ℝ,
        Measurable g ∧ Y n = fun ω ↦ g (splitSignHistory (Ω := Ω) D n ω))
    (hStageCondExp :
      ∀ n, Y n =ᵐ[μ] μ[X | splitSignFiltrationStage (Ω := Ω) D n]) :
    ∀ n,
      let ℱY := Filtration.natural Y
        (ProbabilityTheory.binaryModelTruncations_stronglyMeasurable hY_binary)
      Y n =ᵐ[μ] μ[X | ℱY n] := by
  intro n
  let ℱY := Filtration.natural Y
    (ProbabilityTheory.binaryModelTruncations_stronglyMeasurable hY_binary)
  have hY_adapted : StronglyAdapted ℱY Y :=
    Filtration.stronglyAdapted_natural
      (ProbabilityTheory.binaryModelTruncations_stronglyMeasurable hY_binary)
  have hY_int : Integrable (Y n) μ := by
    -- Proof comment: each stage is a version of the split-filtration conditional expectation.
    exact integrable_condExp.congr (hStageCondExp n).symm
  have hNatLeSplit :
      ℱY n ≤ splitSignFiltrationStage (Ω := Ω) D n :=
    naturalFiltration_le_splitSignFiltrationStage
      (Ω := Ω)
      (hY_meas := ProbabilityTheory.binaryModelTruncations_stronglyMeasurable hY_binary)
      (D := D) hFactor n
  have hSplitLe : splitSignFiltrationStage (Ω := Ω) D n ≤ mΩ :=
    (splitSignHistory_measurable (Ω := Ω) hD_meas n).comap_le
  -- Proof comment: first rewrite `Y n` as its own conditional expectation on `ℱY n`, then apply
  -- the tower property through the larger split-sign σ-algebra.
  calc
    Y n =ᵐ[μ] μ[Y n | ℱY n] := by
      exact (condExp_of_aestronglyMeasurable' (ℱY.le n) (hY_adapted n).aestronglyMeasurable hY_int).symm
    _ =ᵐ[μ] μ[μ[X | splitSignFiltrationStage (Ω := Ω) D n] | ℱY n] := by
          exact condExp_congr_ae (hStageCondExp n)
    _ =ᵐ[μ] μ[X | ℱY n] :=
      condExp_condExp_of_le hNatLeSplit hSplitLe

/-- Helper for Theorem 22.10: if the innovation at stage `n` is recovered by comparing
`Y n` and `Y (n + 1)`, then its real-valued version is strongly measurable with respect to the
next stage of the natural filtration. -/
private lemma recoverSign_stronglyMeasurable_natSucc
    {Y : ℕ → Ω → ℝ} {D : ℕ → Ω → splitSignValue}
    (hY_binary : ∀ T, IsBinaryModel (fun i : Fin (T + 1) ↦ Y i.1))
    (hRecover : ∀ n ω, D n ω = splitSignOfStep (Y n ω) (Y (n + 1) ω))
    (n : ℕ) :
    let ℱY := Filtration.natural Y
      (ProbabilityTheory.binaryModelTruncations_stronglyMeasurable hY_binary)
    StronglyMeasurable[ℱY (n + 1)] (fun ω ↦ (D n ω : ℝ)) := by
  let ℱY := Filtration.natural Y
    (ProbabilityTheory.binaryModelTruncations_stronglyMeasurable hY_binary)
  have hY_adapted : StronglyAdapted ℱY Y :=
    Filtration.stronglyAdapted_natural
      (ProbabilityTheory.binaryModelTruncations_stronglyMeasurable hY_binary)
  have hYn : StronglyMeasurable[ℱY (n + 1)] (Y n) :=
    hY_adapted.stronglyMeasurable_le n.le_succ
  have hYn_succ : StronglyMeasurable[ℱY (n + 1)] (Y (n + 1)) :=
    hY_adapted (n + 1)
  have hStep :
      StronglyMeasurable[ℱY (n + 1)]
        (fun ω ↦ ((splitSignOfStep (Y n ω) (Y (n + 1) ω) : splitSignValue) : ℝ)) := by
    -- Proof comment: the recovered sign is a measurable comparison of the two consecutive
    -- natural-filtration coordinates.
    exact
      (measurable_coe_splitSignOfStep hYn.measurable hYn_succ.measurable).stronglyMeasurable
  have hEq :
      (fun ω ↦ (D n ω : ℝ)) =
        fun ω ↦ ((splitSignOfStep (Y n ω) (Y (n + 1) ω) : splitSignValue) : ℝ) := by
    funext ω
    simp [hRecover n ω]
  -- Proof comment: the pointwise recovery identity rewrites the abstract sign process to the
  -- concrete measurable comparison function.
  simpa [ℱY, hEq] using hStep

/-- Helper for Theorem 22.10: the shifted signed error has zero integral because the recovered
sign is measurable in the next natural filtration and the corresponding stage error has
conditional expectation zero there. -/
private theorem signedError_integral_eq_zero
    {Xm : Ω → ℝ} (hXm_int : Integrable Xm μ)
    {Y : ℕ → Ω → ℝ} {D : ℕ → Ω → splitSignValue}
    (hY_binary : ∀ T, IsBinaryModel (fun i : Fin (T + 1) ↦ Y i.1))
    (hY_condExp :
      ∀ n,
        let ℱY := Filtration.natural Y
          (ProbabilityTheory.binaryModelTruncations_stronglyMeasurable hY_binary)
        Y n =ᵐ[μ] μ[Xm | ℱY n])
    (hRecover : ∀ n ω, D n ω = splitSignOfStep (Y n ω) (Y (n + 1) ω))
    (n : ℕ) :
    ∫ ω, (D n ω : ℝ) * (Xm ω - Y (n + 1) ω) ∂μ = 0 := by
  let ℱY := binaryNaturalFiltration Y hY_binary
  have hY_condExp' (k : ℕ) : Y k =ᵐ[μ] μ[Xm | ℱY k] := by
    simpa [ℱY, binaryNaturalFiltration] using hY_condExp k
  have hY_adapted : StronglyAdapted ℱY Y :=
    Filtration.stronglyAdapted_natural
      (ProbabilityTheory.binaryModelTruncations_stronglyMeasurable hY_binary)
  have hYn_int : Integrable (Y (n + 1)) μ := by
    -- Proof comment: each stage is a version of the corresponding conditional expectation.
    exact integrable_condExp.congr (hY_condExp' (n + 1)).symm
  have hDiff_int : Integrable (fun ω ↦ Xm ω - Y (n + 1) ω) μ := hXm_int.sub hYn_int
  have hSign_sm :
      StronglyMeasurable[ℱY (n + 1)] (fun ω ↦ (D n ω : ℝ)) := by
    simpa [ℱY, binaryNaturalFiltration] using
      recoverSign_stronglyMeasurable_natSucc
        (Ω := Ω) (Y := Y) (D := D) hY_binary hRecover n
  have hSign_bound : ∀ᵐ ω ∂μ, ‖(D n ω : ℝ)‖ ≤ 1 := by
    exact Filter.Eventually.of_forall fun ω ↦ by
      rw [Real.norm_eq_abs, abs_coe_splitSignValue]
  have hDiff_cond_zero :
      μ[(fun ω ↦ Xm ω - Y (n + 1) ω) | ℱY (n + 1)] =ᵐ[μ] 0 := by
    calc
      μ[(fun ω ↦ Xm ω - Y (n + 1) ω) | ℱY (n + 1)] =ᵐ[μ]
          μ[Xm | ℱY (n + 1)] - μ[Y (n + 1) | ℱY (n + 1)] := by
            exact condExp_sub hXm_int hYn_int (ℱY (n + 1))
      _ =ᵐ[μ] Y (n + 1) - Y (n + 1) := by
            refine EventuallyEq.sub (hY_condExp' (n + 1)).symm ?_
            exact condExp_of_aestronglyMeasurable'
              (ℱY.le (n + 1)) (hY_adapted (n + 1)).aestronglyMeasurable hYn_int
      _ =ᵐ[μ] 0 := by
            exact Filter.Eventually.of_forall fun ω ↦ by simp
  have hProd_int :
      Integrable (fun ω ↦ (D n ω : ℝ) * (Xm ω - Y (n + 1) ω)) μ := by
    exact hDiff_int.bdd_mul ((hSign_sm.mono (ℱY.le (n + 1))).aestronglyMeasurable) hSign_bound
  have hProd_cond_zero :
      μ[(fun ω ↦ (D n ω : ℝ) * (Xm ω - Y (n + 1) ω)) | ℱY (n + 1)] =ᵐ[μ] 0 := by
    calc
      μ[(fun ω ↦ (D n ω : ℝ) * (Xm ω - Y (n + 1) ω)) | ℱY (n + 1)] =ᵐ[μ]
          fun ω ↦
            (D n ω : ℝ) *
              (μ[(fun ω ↦ Xm ω - Y (n + 1) ω) | ℱY (n + 1)] ω) := by
            exact condExp_stronglyMeasurable_mul_of_bound
              (ℱY.le (n + 1)) hSign_sm hDiff_int 1 hSign_bound
      _ =ᵐ[μ] 0 := by
            filter_upwards [hDiff_cond_zero] with ω hω
            simp [hω]
  -- Proof comment: integrating the pulled-out zero conditional expectation gives the vanishing
  -- mean of the signed stage error.
  calc
    ∫ ω, (D n ω : ℝ) * (Xm ω - Y (n + 1) ω) ∂μ =
        ∫ ω, (μ[(fun ω ↦ (D n ω : ℝ) * (Xm ω - Y (n + 1) ω)) | ℱY (n + 1)]) ω ∂μ := by
          symm
          simpa using
            (integral_condExp
              (μ := μ) (m := ℱY (n + 1))
              (f := fun ω ↦ (D n ω : ℝ) * (Xm ω - Y (n + 1) ω))
              (ℱY.le (n + 1)))
    _ = ∫ ω, (0 : ℝ) ∂μ := integral_congr_ae hProd_cond_zero
    _ = 0 := by simp

/- Theorem 22.10 is `source-facing`: it asserts that a centered square-integrable random variable
arises as the almost-sure and `L²` limit of a martingale whose finite truncations are Chapter 9
binary models. The owner abstraction for the `L²` convergence clause is the Chapter 7 notion
`TendstoInLp 2`; the raw `eLpNorm` formulation is only the derived `bridge/view`. The primitive
data here are the process `Y`, the finite-horizon binary-model property on its truncations, and
the martingale structure for its natural filtration; the `eLpNorm` limit is derived API. -/

/-- Helper for Theorem 22.10: almost-sure convergence to a measurable modification transports back
to the original target along an almost-everywhere equality. -/
private lemma aeTendsto_congr_target
    {Y : ℕ → Ω → ℝ} {X Xm : Ω → ℝ}
    (hXm_ae : Xm =ᵐ[μ] X)
    (hY_tendsto_Xm : ∀ᵐ ω ∂μ, Tendsto (fun n ↦ Y n ω) atTop (𝓝 (Xm ω))) :
    ∀ᵐ ω ∂μ, Tendsto (fun n ↦ Y n ω) atTop (𝓝 (X ω)) := by
  -- Proof comment: on the full-measure set where `Xm = X`, the target neighborhoods coincide.
  filter_upwards [hXm_ae, hY_tendsto_Xm] with ω hω_eq hω_tendsto
  simpa [hω_eq] using hω_tendsto

/-- Helper for Theorem 22.10: a measurable centered target admits a split-sign realization whose
stages are exact finite-history factorizations of the corresponding conditional expectations. -/
private theorem stageFamily_of_measurableTarget
    {Xm : Ω → ℝ} (hXm_meas : Measurable Xm) (hXm_sq : MemLp Xm 2 μ)
    (hXm_mean_zero : ∫ ω, Xm ω ∂μ = 0) :
    ∃ stage : (n : ℕ) → RecursiveSplitSignStage μ Xm n,
      (stage 0).g = (fun _ ↦ (0 : ℝ)) ∧
        (∀ n,
          (stage (n + 1)).H =
            nextSplitSignHistory (Ω := Ω) (Xm := Xm) (stage n).H (stage n).g) ∧
        (∀ n hist s,
          splitSignOfStep ((stage n).g hist) ((stage (n + 1)).g (Fin.snoc hist s)) = s) := by
  classical
  let hXm_int : Integrable Xm μ := squareIntegrable_integrable (μ := μ) hXm_sq
  let base : RecursiveSplitSignStage μ Xm 0 :=
    { H := fun _ ↦ (fun i : Fin 0 ↦ nomatch i)
      g := fun _ ↦ 0
      hH_meas := by
        -- Proof comment: the empty-history map is constant, hence measurable.
        exact measurable_const
      hg_meas := measurable_const
      hCondExp := by
        -- Proof comment: conditioning on the empty history is conditioning on the trivial
        -- σ-algebra, so the centered target has zero stage-zero representative.
        simpa [Function.comp] using
          (condExp_bot_ae_eq_zero_of_mean_zero
            (μ := μ) (X := Xm) hXm_int hXm_mean_zero).symm }
  let succ :
      ∀ {n : ℕ}, RecursiveSplitSignStage μ Xm n → RecursiveSplitSignStage μ Xm (n + 1)
    | n, prev =>
        let hNext :=
          exists_nextSplitSignFactorization
            (Ω := Ω) (μ := μ) (Xm := Xm) hXm_meas hXm_int
            (H := prev.H) (g := prev.g) prev.hH_meas prev.hg_meas
        { H := nextSplitSignHistory (Ω := Ω) (Xm := Xm) prev.H prev.g
          g := Classical.choose hNext
          hH_meas := by
            -- Proof comment: the successor history appends one measurable comparison sign to the
            -- measurable prefix history.
            simpa [nextSplitSignHistory] using
              prefixHistory_snoc_measurable
                (Ω := Ω) (X := Xm) (H := prev.H) (g := prev.g)
                prev.hH_meas prev.hg_meas hXm_meas
          hg_meas := (Classical.choose_spec hNext).1
          hCondExp := (Classical.choose_spec hNext).2.2 }
  let stage : (n : ℕ) → RecursiveSplitSignStage μ Xm n :=
    Nat.rec base (fun _ prev ↦ succ prev)
  have hSuccSign :
      ∀ {n : ℕ} (prev : RecursiveSplitSignStage μ Xm n) hist s,
        splitSignOfStep (prev.g hist) ((succ prev).g (Fin.snoc hist s)) = s := by
    intro n prev hist s
    -- Proof comment: the one-step extension inherits the exact sign specification from the
    -- chosen successor factorization.
    simpa [succ] using
      (Classical.choose_spec
        (exists_nextSplitSignFactorization
          (Ω := Ω) (μ := μ) (Xm := Xm) hXm_meas hXm_int
          (H := prev.H) (g := prev.g) prev.hH_meas prev.hg_meas)).2.1 hist s
  refine ⟨stage, ?_, ?_, ?_⟩
  · simpa [stage, base]
  · intro n
    simpa [stage, succ]
  · intro n hist s
    -- Proof comment: apply the one-step sign specification to the stage obtained after `n`
    -- recursive extensions.
    simpa [stage, succ] using hSuccSign (prev := stage n) hist s

/-- Helper for Theorem 22.10: a measurable centered target admits a split-sign realization whose
stages are exact finite-history factorizations of the corresponding conditional expectations. -/
private theorem exists_splitSignData_of_measurableTarget
    {Xm : Ω → ℝ} (hXm_meas : Measurable Xm) (hXm_sq : MemLp Xm 2 μ)
    (hXm_mean_zero : ∫ ω, Xm ω ∂μ = 0) :
    ∃ Y : ℕ → Ω → ℝ,
      ∃ D : ℕ → Ω → splitSignValue,
        Y 0 = (fun _ ↦ 0) ∧
          (∀ n, Measurable (D n)) ∧
          (∀ n,
            ∃ g : (Fin n → splitSignValue) → ℝ,
              Measurable g ∧
              Y n = fun ω ↦ g (splitSignHistory (Ω := Ω) D n ω)) ∧
          (∀ n ω, D n ω = splitSignOfStep (Y n ω) (Xm ω)) ∧
          (∀ n ω, D n ω = splitSignOfStep (Y n ω) (Y (n + 1) ω)) ∧
          (∀ n, Y n =ᵐ[μ] μ[Xm | splitSignFiltrationStage (Ω := Ω) D n]) := by
  obtain ⟨stage, hStageZero, hStageSucc, hStageSign⟩ :=
    stageFamily_of_measurableTarget
      (Ω := Ω) (μ := μ) (Xm := Xm) hXm_meas hXm_sq hXm_mean_zero
  let Y : ℕ → Ω → ℝ := fun n ω ↦ (stage n).g ((stage n).H ω)
  let D : ℕ → Ω → splitSignValue := fun n ω ↦ splitSignOfStep (Y n ω) (Xm ω)
  have hY0 : Y 0 = fun _ ↦ 0 := by
    -- Proof comment: the recursive stage family is normalized so that the initial deterministic
    -- history representative is the constant zero function.
    funext ω
    simp [Y, hStageZero]
  have hY_meas : ∀ n, Measurable (Y n) := by
    intro n
    -- Proof comment: each stage is a measurable finite-history representative evaluated on a
    -- measurable history map.
    exact (stage n).hg_meas.comp (stage n).hH_meas
  have hD_meas : ∀ n, Measurable (D n) := by
    intro n
    -- Proof comment: the split sign is a measurable comparison of the measurable stage value and
    -- the measurable target.
    exact measurable_splitSignOfStep (hY_meas n) hXm_meas
  have hHistSucc :
      ∀ n ω, (stage (n + 1)).H ω = Fin.snoc ((stage n).H ω) (D n ω) := by
    intro n ω
    -- Proof comment: after one recursive step, the successor history is obtained by appending
    -- exactly the current source comparison sign.
    rw [hStageSucc n]
    simp [nextSplitSignHistory, D, Y]
  have hStageHist :
      ∀ n, (stage n).H = splitSignHistory (Ω := Ω) D n :=
    prefixHistory_eq_splitSignHistory
      (Ω := Ω) (D := D) (H := fun n ↦ (stage n).H) hHistSucc
  have hFactor :
      ∀ n,
        ∃ g : (Fin n → splitSignValue) → ℝ,
          Measurable g ∧
          Y n = fun ω ↦ g (splitSignHistory (Ω := Ω) D n ω) := by
    intro n
    refine ⟨(stage n).g, (stage n).hg_meas, ?_⟩
    -- Proof comment: once the theorem-local histories are rewritten to the canonical
    -- `splitSignHistory` spelling, each stage is exactly the chosen finite-history
    -- representative.
    funext ω
    simp [Y, hStageHist n]
  have hTargetCompare : ∀ n ω, D n ω = splitSignOfStep (Y n ω) (Xm ω) := by
    intro n ω
    rfl
  have hRecover : ∀ n ω, D n ω = splitSignOfStep (Y n ω) (Y (n + 1) ω) := by
    intro n ω
    -- Proof comment: the successor representative was chosen so that appending the current sign
    -- recovers that sign from the consecutive stage values.
    simpa [D, Y, hHistSucc n ω] using
      (hStageSign n ((stage n).H ω) (D n ω)).symm
  have hStageCondExp :
      ∀ n, Y n =ᵐ[μ] μ[Xm | splitSignFiltrationStage (Ω := Ω) D n] := by
    intro n
    -- Proof comment: after the same history normalization, the recursive stage identity is
    -- already the desired conditional-expectation representation on the canonical split-sign
    -- filtration.
    simpa [Y, splitSignFiltrationStage, hStageHist n] using (stage n).hCondExp
  exact ⟨Y, D, hY0, hD_meas, hFactor, hTargetCompare, hRecover, hStageCondExp⟩

/-- Helper for Theorem 22.10: exact split-sign data already suffice to recover the binary-model
package and the natural-filtration conditional-expectation identities. -/
private theorem measurableTarget_process_package_of_splitSignData
    {Xm : Ω → ℝ} {Y : ℕ → Ω → ℝ} {D : ℕ → Ω → splitSignValue}
    (hY0 : Y 0 = (fun _ ↦ 0))
    (hD_meas : ∀ n, Measurable (D n))
    (hFactor :
      ∀ n,
        ∃ g : (Fin n → splitSignValue) → ℝ,
          Measurable g ∧
          Y n = fun ω ↦ g (splitSignHistory (Ω := Ω) D n ω))
    (hRecover : ∀ n ω, D n ω = splitSignOfStep (Y n ω) (Y (n + 1) ω))
    (hStageCondExp :
      ∀ n, Y n =ᵐ[μ] μ[Xm | splitSignFiltrationStage (Ω := Ω) D n]) :
    ∃ hY_binary : ∀ T, IsBinaryModel (fun i : Fin (T + 1) ↦ Y i.1),
      Y 0 = 0 ∧
        (∀ n,
          let ℱY := Filtration.natural Y
            (ProbabilityTheory.binaryModelTruncations_stronglyMeasurable hY_binary)
          Y n =ᵐ[μ] μ[Xm | ℱY n]) := by
  let hY_binary : ∀ T, IsBinaryModel (fun i : Fin (T + 1) ↦ Y i.1) :=
    binaryTruncation_isBinaryModel_of_factorization
      (Ω := Ω) (x0 := 0) hY0 hD_meas hFactor hRecover
  refine ⟨hY_binary, ?_, ?_⟩
  · -- Proof comment: the split-sign package is normalized to start from the deterministic value
    -- `0`, exactly matching the source theorem's centered martingale.
    simpa using hY0
  · intro n
    -- Proof comment: once the truncations are binary models, the natural filtration is already a
    -- subfiltration of the split-sign history filtration, so the owner conditional-expectation
    -- transport lemma applies directly.
    simpa using
      splitStage_condExp_natural
        (Ω := Ω) (μ := μ) (X := Xm) (Y := Y) (D := D)
        hY_binary hD_meas hFactor hStageCondExp n

/-- Helper for Theorem 22.10: once the binary martingale limit exists, the signed stage errors
converge almost surely to the absolute terminal error. -/
private lemma signedError_tendsto_absLimit
    {Xm : Ω → ℝ} {Y : ℕ → Ω → ℝ} {D : ℕ → Ω → splitSignValue} {L : Ω → ℝ}
    (hY_tendsto : ∀ᵐ ω ∂μ, Tendsto (fun n ↦ Y n ω) atTop (𝓝 (L ω)))
    (hTargetCompare : ∀ n ω, D n ω = splitSignOfStep (Y n ω) (Xm ω)) :
    ∀ᵐ ω ∂μ,
      Tendsto (fun n ↦ (D n ω : ℝ) * (Xm ω - Y (n + 1) ω)) atTop
        (𝓝 |Xm ω - L ω|) := by
  filter_upwards [hY_tendsto] with ω hω_tendsto
  have hω_tendsto_succ : Tendsto (fun n ↦ Y (n + 1) ω) atTop (𝓝 (L ω)) := by
    simpa using hω_tendsto.comp (tendsto_add_atTop_nat 1)
  by_cases hEq : Xm ω = L ω
  · have hSub :
        Tendsto (fun n ↦ Xm ω - Y (n + 1) ω) atTop (𝓝 0) := by
      simpa [hEq] using Tendsto.const_sub (Xm ω) hω_tendsto_succ
    have hNorm :
        Tendsto (fun n ↦ ‖(D n ω : ℝ) * (Xm ω - Y (n + 1) ω)‖) atTop (𝓝 0) := by
      simpa [Real.norm_eq_abs, abs_mul, abs_coe_splitSignValue] using hSub.norm
    -- Proof comment: if the target already equals the limit, the signed errors vanish because
    -- the sign multiplier has modulus `1`.
    simpa [hEq] using tendsto_zero_iff_norm_tendsto_zero.mpr hNorm
  · rcases lt_or_gt_of_ne hEq with hlt | hgt
    · have hEventuallyEq :
          (fun n ↦ (D n ω : ℝ) * (Xm ω - Y (n + 1) ω)) =ᶠ[atTop]
            fun n ↦ Y (n + 1) ω - Xm ω := by
        filter_upwards [hω_tendsto.eventually (Ioi_mem_nhds hlt)] with n hn
        have hD : D n ω = splitSignMinus := by
          have hnotle : ¬ Y n ω ≤ Xm ω := not_le.mpr hn
          simpa [hTargetCompare n ω, splitSignOfStep, hnotle]
        simp [hD, splitSignMinus]
      have hSub :
          Tendsto (fun n ↦ Y (n + 1) ω - Xm ω) atTop (𝓝 (L ω - Xm ω)) :=
        Tendsto.sub_const hω_tendsto_succ (Xm ω)
      -- Proof comment: once `Y n ω` stays above `Xm ω`, the source sign is constantly `-1`.
      refine Tendsto.congr' hEventuallyEq.symm ?_
      simpa [abs_of_neg (sub_neg.mpr hlt)] using hSub
    · have hEventuallyEq :
          (fun n ↦ (D n ω : ℝ) * (Xm ω - Y (n + 1) ω)) =ᶠ[atTop]
            fun n ↦ Xm ω - Y (n + 1) ω := by
        filter_upwards [hω_tendsto.eventually (Iio_mem_nhds hgt)] with n hn
        have hD : D n ω = splitSignPlus := by
          have hle : Y n ω ≤ Xm ω := le_of_lt hn
          simpa [hTargetCompare n ω, splitSignOfStep, hle]
        simp [hD, splitSignPlus]
      have hSub :
          Tendsto (fun n ↦ Xm ω - Y (n + 1) ω) atTop (𝓝 (Xm ω - L ω)) :=
        Tendsto.const_sub (Xm ω) hω_tendsto_succ
      -- Proof comment: once `Y n ω` stays below `Xm ω`, the source sign is constantly `1`.
      refine Tendsto.congr' hEventuallyEq.symm ?_
      simpa [abs_of_pos (sub_pos.mpr hgt)] using hSub

/-- Helper for Theorem 22.10: every conditional-expectation stage of the binary process belongs to
`L²`. -/
private theorem binarySplitting_stageMemLp_two
    {Xm : Ω → ℝ} (hXm_sq : MemLp Xm 2 μ)
    {Y : ℕ → Ω → ℝ}
    (hY_binary : ∀ T, IsBinaryModel (fun i : Fin (T + 1) ↦ Y i.1))
    (hY_condExp :
      ∀ n,
        let ℱY := Filtration.natural Y
          (ProbabilityTheory.binaryModelTruncations_stronglyMeasurable hY_binary)
        Y n =ᵐ[μ] μ[Xm | ℱY n]) :
    ∀ n, MemLp (Y n) 2 μ := by
  let ℱY := binaryNaturalFiltration Y hY_binary
  have hY_condExp_nat :
      ∀ n, Y n =ᵐ[μ] μ[Xm | ℱY n] := by
    intro n
    -- Proof comment: normalize the filtration spelling once before using the `L²` owner lemma.
    simpa [ℱY, binaryNaturalFiltration] using hY_condExp n
  obtain ⟨C, hC⟩ :=
    binarySplitting_condExp_l2Bound_two
      (μ := μ) (X := Xm) hXm_sq (Y := Y) hY_binary hY_condExp_nat
  intro n
  -- Proof comment: the stage bound gives the finite `eLpNorm`, while binary truncations already
  -- provide the required measurability.
  exact ⟨
    (ProbabilityTheory.binaryModelTruncations_stronglyMeasurable hY_binary n).aestronglyMeasurable,
    lt_of_le_of_lt (hC n) ENNReal.coe_lt_top
  ⟩

/-- Helper for Theorem 22.10: multiplying by a split sign does not change the `L²` norm. -/
private theorem signedError_eLpNorm_eq_diff_two
    {Xm : Ω → ℝ} {Y : ℕ → Ω → ℝ} {D : ℕ → Ω → splitSignValue}
    (n : ℕ) :
    eLpNorm (fun ω ↦ (D n ω : ℝ) * (Xm ω - Y (n + 1) ω)) 2 μ =
      eLpNorm (fun ω ↦ Xm ω - Y (n + 1) ω) 2 μ := by
  -- Proof comment: every split sign has absolute value `1`, so the signed and unsigned errors
  -- agree pointwise in norm.
  refine eLpNorm_congr_norm_ae ?_
  exact Filter.Eventually.of_forall fun ω ↦ by
    rw [Real.norm_eq_abs, Real.norm_eq_abs, abs_mul, abs_coe_splitSignValue, one_mul]

/-- Helper for Theorem 22.10: the `L²` triangle estimate can be closed against an `NNReal`
witness without repeating the ENNReal-to-NNReal coercion step in the consumer theorem. -/
  private theorem eLpNorm_sub_le_toNNReal_add
    {f g : Ω → ℝ} (hf : MemLp f 2 μ) (hg : MemLp g 2 μ) {C : NNReal}
    (hC : eLpNorm g 2 μ ≤ C) :
    eLpNorm (fun ω ↦ f ω - g ω) 2 μ ≤ (eLpNorm f 2 μ).toNNReal + C := by
  let Cf : NNReal := (eLpNorm f 2 μ).toNNReal
  have hCf : (Cf : ENNReal) = eLpNorm f 2 μ := by
    simpa [Cf] using ENNReal.coe_toNNReal hf.eLpNorm_lt_top.ne
  -- Proof comment: first use the owner `L²` triangle inequality, then rewrite the finite
  -- `eLpNorm f` term once into the NNReal witness spelling expected downstream.
  calc
    eLpNorm (fun ω ↦ f ω - g ω) 2 μ ≤ eLpNorm f 2 μ + eLpNorm g 2 μ := by
      exact eLpNorm_sub_le hf.aestronglyMeasurable hg.aestronglyMeasurable (by norm_num)
    _ ≤ eLpNorm f 2 μ + C := by
      exact add_le_add_right hC (eLpNorm f 2 μ)
    _ = ((Cf + C : NNReal) : ENNReal) := by
      simp [Cf, hCf]

/-- Helper for Theorem 22.10: the signed stage-error family is uniformly `L²`-bounded. -/
private theorem signedError_l2Bound_two
    {Xm : Ω → ℝ} (hXm_sq : MemLp Xm 2 μ)
    {Y : ℕ → Ω → ℝ} {D : ℕ → Ω → splitSignValue}
    (hY_binary : ∀ T, IsBinaryModel (fun i : Fin (T + 1) ↦ Y i.1))
    (hY_condExp :
      ∀ n,
        let ℱY := Filtration.natural Y
          (ProbabilityTheory.binaryModelTruncations_stronglyMeasurable hY_binary)
        Y n =ᵐ[μ] μ[Xm | ℱY n])
    (hRecover : ∀ n ω, D n ω = splitSignOfStep (Y n ω) (Y (n + 1) ω)) :
    ∃ C : NNReal, ∀ n,
      eLpNorm (fun ω ↦ (D n ω : ℝ) * (Xm ω - Y (n + 1) ω)) 2 μ ≤ C := by
  let ℱY := binaryNaturalFiltration Y hY_binary
  have hY_condExp_nat :
      ∀ n, Y n =ᵐ[μ] μ[Xm | ℱY n] := by
    intro n
    -- Proof comment: normalize the filtration spelling once so the later owner lemmas all see
    -- the same natural-filtration alias.
    simpa [ℱY, binaryNaturalFiltration] using hY_condExp n
  obtain ⟨CY, hCY⟩ :=
    binarySplitting_condExp_l2Bound_two
      (μ := μ) (X := Xm) hXm_sq (Y := Y) hY_binary hY_condExp_nat
  have hY_memLp : ∀ n, MemLp (Y n) 2 μ :=
    binarySplitting_stageMemLp_two
      (μ := μ) (Xm := Xm) hXm_sq (Y := Y) hY_binary hY_condExp
  -- Route correction: keep the sign rewrite and the ENNReal-to-NNReal closure separate; the
  -- consumer theorem now only packages the stage bound and applies the cached bridge lemma.
  refine ⟨(eLpNorm Xm 2 μ).toNNReal + CY, ?_⟩
  intro n
  rw [signedError_eLpNorm_eq_diff_two (μ := μ) (Xm := Xm) (Y := Y) (D := D) n]
  -- Proof comment: after removing the unit sign, the error is just the difference between the
  -- target and the next conditional-expectation stage, so the bridge lemma applies directly.
  exact eLpNorm_sub_le_toNNReal_add
    (μ := μ) (f := Xm) (g := Y (n + 1)) hXm_sq (hY_memLp (n + 1)) (hCY (n + 1))

/-- Helper for Theorem 22.10: the signed stage-error family is uniformly `L²`-bounded. -/
private theorem signedError_l2Bound
    {Xm : Ω → ℝ} (hXm_sq : MemLp Xm 2 μ)
    {Y : ℕ → Ω → ℝ} {D : ℕ → Ω → splitSignValue}
    (hY_binary : ∀ T, IsBinaryModel (fun i : Fin (T + 1) ↦ Y i.1))
    (hY_condExp :
      ∀ n,
        let ℱY := Filtration.natural Y
          (ProbabilityTheory.binaryModelTruncations_stronglyMeasurable hY_binary)
        Y n =ᵐ[μ] μ[Xm | ℱY n])
    (hRecover : ∀ n ω, D n ω = splitSignOfStep (Y n ω) (Y (n + 1) ω)) :
    ∃ C : NNReal, ∀ n,
      eLpNorm (fun ω ↦ (D n ω : ℝ) * (Xm ω - Y (n + 1) ω)) (ENNReal.ofReal 2) μ ≤ C := by
  -- Proof comment: keep the analytic owner proof in exponent `2`, then expose the public
  -- `ENNReal.ofReal 2` spelling by a final simplification.
  simpa using signedError_l2Bound_two
    (μ := μ) (Xm := Xm) hXm_sq (Y := Y) (D := D) hY_binary hY_condExp hRecover

/-- Helper for Theorem 22.10: a real family with uniformly bounded `L²` norm is uniformly
integrable in `L¹`. -/
private theorem uniformIntegrable_of_aestronglyMeasurable_l2Bounded
    {Z : ℕ → Ω → ℝ}
    (hZ_aeStronglyMeasurable : ∀ n, AEStronglyMeasurable (Z n) μ)
    (hZ_l2Bound : ∃ C : NNReal, ∀ n, eLpNorm (Z n) 2 μ ≤ C) :
    UniformIntegrable Z 1 μ := by
  rcases hZ_l2Bound with ⟨C, hC⟩
  have hZ_memLp : ∀ n, MemLp (Z n) 2 μ := by
    intro n
    -- Proof comment: the uniform `L²` bound packages each stage as an owner `MemLp` element.
    exact ⟨hZ_aeStronglyMeasurable n, lt_of_le_of_lt (hC n) ENNReal.coe_lt_top⟩
  letI : Fact ((1 : ENNReal) ≤ ENNReal.ofReal (2 : ℝ)) := fact_one_le_ofReal_two
  have hZ_memLp_ofReal : ∀ n, MemLp (Z n) (ENNReal.ofReal (2 : ℝ)) μ := by
    intro n
    -- Proof comment: normalize the exponent spelling once before entering the owner `Lp` API.
    simpa using hZ_memLp n
  let F : Set (Lp ℝ (ENNReal.ofReal (2 : ℝ)) μ) :=
    Set.range fun n ↦ (hZ_memLp_ofReal n).toLp (Z n)
  have hF_bdd : Bornology.IsBounded F := by
    -- Proof comment: the `L²` bounds become a uniform norm bound in the ambient `Lp` space.
    refine isBounded_iff_forall_norm_le.2 ⟨(C : ℝ), ?_⟩
    intro f hfF
    rcases hfF with ⟨n, rfl⟩
    rw [Lp.norm_toLp]
    exact ENNReal.toReal_mono ENNReal.coe_ne_top (by simpa using hC n)
  have hUI_F : UniformIntegrable ((↑) : F → Ω → ℝ) 1 μ :=
    uniformIntegrable_of_bounded_memLp_of_one_lt
      (p := 2) (F := F) μ (show 1 < (2 : ℝ) by norm_num) hF_bdd
  let Zsub : ℕ → F := fun n ↦ ⟨(hZ_memLp_ofReal n).toLp (Z n), ⟨n, rfl⟩⟩
  have hUI_Zsub : UniformIntegrable (fun n ↦ ((Zsub n : F) : Ω → ℝ)) 1 μ := by
    refine ⟨fun n ↦ hUI_F.1 (Zsub n), ?_, ?_⟩
    · -- Proof comment: reindex the owner-space uniform-integrability estimate along the sequence.
      intro ε hε
      obtain ⟨δ, hδ, hδ_bound⟩ := hUI_F.2.1 hε
      exact ⟨δ, hδ, fun n s hs hμs ↦ hδ_bound (Zsub n) s hs hμs⟩
    · obtain ⟨B, hB⟩ := hUI_F.2.2
      exact ⟨B, fun n ↦ hB (Zsub n)⟩
  -- Proof comment: the `Lp` representatives agree almost everywhere with the raw family.
  refine hUI_Zsub.ae_eq ?_
  intro n
  simpa [Zsub] using MemLp.coeFn_toLp (hZ_memLp_ofReal n)

/-- Helper for Theorem 22.10: the signed stage-error family is uniformly integrable in `L¹`. -/
private theorem signedError_uniformIntegrable
    {Xm : Ω → ℝ} (hXm_sq : MemLp Xm 2 μ)
    {Y : ℕ → Ω → ℝ} {D : ℕ → Ω → splitSignValue}
    (hY_binary : ∀ T, IsBinaryModel (fun i : Fin (T + 1) ↦ Y i.1))
    (hY_condExp :
      ∀ n,
        let ℱY := Filtration.natural Y
          (ProbabilityTheory.binaryModelTruncations_stronglyMeasurable hY_binary)
        Y n =ᵐ[μ] μ[Xm | ℱY n])
    (hRecover : ∀ n ω, D n ω = splitSignOfStep (Y n ω) (Y (n + 1) ω)) :
    UniformIntegrable (fun n ω ↦ (D n ω : ℝ) * (Xm ω - Y (n + 1) ω)) 1 μ := by
  let ℱY := binaryNaturalFiltration Y hY_binary
  let Z : ℕ → Ω → ℝ := fun n ω ↦ (D n ω : ℝ) * (Xm ω - Y (n + 1) ω)
  have hY_memLp : ∀ n, MemLp (Y n) 2 μ :=
    binarySplitting_stageMemLp_two
      (μ := μ) (Xm := Xm) hXm_sq (Y := Y) hY_binary hY_condExp
  have hZ_aeStronglyMeasurable : ∀ n, AEStronglyMeasurable (Z n) μ := by
    intro n
    have hSign_sm_nat :
        StronglyMeasurable[ℱY (n + 1)] (fun ω ↦ (D n ω : ℝ)) := by
      -- Route correction: isolate the sign measurability in the normalized filtration alias
      -- before forming the product with the stage error.
      simpa [ℱY, binaryNaturalFiltration] using
        recoverSign_stronglyMeasurable_natSucc
          (Ω := Ω) (Y := Y) (D := D) hY_binary hRecover n
    have hSign_sm : StronglyMeasurable (fun ω ↦ (D n ω : ℝ)) :=
      hSign_sm_nat.mono (ℱY.le (n + 1))
    have hDiff_aeStronglyMeasurable :
        AEStronglyMeasurable (fun ω ↦ Xm ω - Y (n + 1) ω) μ :=
      hXm_sq.aestronglyMeasurable.sub (hY_memLp (n + 1)).aestronglyMeasurable
    -- Proof comment: the signed error is the product of a strongly measurable sign and an
    -- `L²` stage difference.
    exact hSign_sm.aestronglyMeasurable.mul hDiff_aeStronglyMeasurable
  have hZ_l2Bound : ∃ C : NNReal, ∀ n, eLpNorm (Z n) 2 μ ≤ C := by
    simpa [Z] using
      signedError_l2Bound_two
        (μ := μ) (Xm := Xm) hXm_sq (Y := Y) (D := D)
        hY_binary hY_condExp hRecover
  -- Proof comment: once the signed-error family is packaged as an `L²`-bounded real family, the
  -- generic owner-space bridge yields uniform integrability in `L¹`.
  simpa [Z] using
    uniformIntegrable_of_aestronglyMeasurable_l2Bounded
      (μ := μ) (Z := Z) hZ_aeStronglyMeasurable hZ_l2Bound

/-- Helper for Theorem 22.10: after the split-sign process is packaged as a binary martingale,
the remaining analytic step is to identify its canonical limit with the measurable target. -/
private theorem splitSign_limitProcess_ae_eq_target
    {Xm : Ω → ℝ} (hXm_sq : MemLp Xm 2 μ)
    {Y : ℕ → Ω → ℝ} {D : ℕ → Ω → splitSignValue}
    (hY_binary : ∀ T, IsBinaryModel (fun i : Fin (T + 1) ↦ Y i.1))
    (hY_condExp :
      ∀ n,
        let ℱY := Filtration.natural Y
          (ProbabilityTheory.binaryModelTruncations_stronglyMeasurable hY_binary)
        Y n =ᵐ[μ] μ[Xm | ℱY n])
    (hTargetCompare : ∀ n ω, D n ω = splitSignOfStep (Y n ω) (Xm ω))
    (hRecover : ∀ n ω, D n ω = splitSignOfStep (Y n ω) (Y (n + 1) ω)) :
    let ℱY := Filtration.natural Y
      (ProbabilityTheory.binaryModelTruncations_stronglyMeasurable hY_binary)
    Filtration.limitProcess Y ℱY μ =ᵐ[μ] Xm := by
  -- Route correction: the source sign comparison against `Xm` is the missing hypothesis that
  -- identifies the canonical martingale limit with the target after the Chapter 11 convergence
  -- theorem has produced the limit process.
  let ℱY := binaryNaturalFiltration Y hY_binary
  let L : Ω → ℝ := Filtration.limitProcess Y ℱY μ
  have hXm_int : Integrable Xm μ := squareIntegrable_integrable (μ := μ) hXm_sq
  have hY_mart : Martingale Y ℱY μ := by
    -- Proof comment: the natural-filtration conditional-expectation realization already gives
    -- the martingale structure.
    simpa [ℱY, binaryNaturalFiltration] using
      binarySplitting_condExp_martingale
        (μ := μ) (X := Xm) (Y := Y) hY_binary hY_condExp
  have hY_l2_bdd : ∃ C : NNReal, ∀ n, eLpNorm (Y n) (ENNReal.ofReal 2) μ ≤ C := by
    -- Proof comment: the same conditional-expectation package yields the `L²` bounds needed for
    -- Chapter 11 convergence.
    simpa [ℱY, binaryNaturalFiltration] using
      binarySplitting_condExp_l2Bound
        (μ := μ) (X := Xm) hXm_sq (Y := Y) hY_binary hY_condExp
  obtain ⟨_, _, hY_tendsto_ae_limit, _⟩ :=
    MeasureTheory.martingale_convergence_to_memLp_limitProcess_of_lp_bounded
      (X := Y) (ℱ := ℱY) (μ := μ) (p := 2) hY_mart (by norm_num) hY_l2_bdd
  let Z : ℕ → Ω → ℝ := fun n ω ↦ (D n ω : ℝ) * (Xm ω - Y (n + 1) ω)
  have hZ_tendsto :
      ∀ᵐ ω ∂μ, Tendsto (fun n ↦ Z n ω) atTop (𝓝 |Xm ω - L ω|) := by
    -- Proof comment: the source sign comparison stabilizes the signed errors to the absolute
    -- terminal error.
    simpa [Z, L] using
      signedError_tendsto_absLimit
        (μ := μ) (Xm := Xm) (Y := Y) (D := D) (L := L)
        hY_tendsto_ae_limit hTargetCompare
  have hZ_UI : UniformIntegrable Z 1 μ := by
    -- Proof comment: the `L²` bounds upgrade the signed error family to uniform integrability in
    -- `L¹`.
    simpa [Z] using
      signedError_uniformIntegrable
        (μ := μ) (Xm := Xm) hXm_sq (Y := Y) (D := D)
        hY_binary hY_condExp hRecover
  have hAbs_int : Integrable (fun ω ↦ |Xm ω - L ω|) μ :=
    hZ_UI.integrable_of_ae_tendsto hZ_tendsto
  have hAbs_memLp : MemLp (fun ω ↦ |Xm ω - L ω|) 1 μ :=
    memLp_one_iff_integrable.mpr hAbs_int
  have hZ_aestronglyMeasurable : ∀ n, AEStronglyMeasurable (Z n) μ :=
    hZ_UI.aestronglyMeasurable
  have hZ_tendsto_L1 :
      Tendsto
        (fun n ↦ eLpNorm (Z n - fun ω ↦ |Xm ω - L ω|) 1 μ)
        atTop (𝓝 0) := by
    exact MeasureTheory.tendsto_Lp_finite_of_tendsto_ae le_rfl (by simp)
      hZ_aestronglyMeasurable hAbs_memLp hZ_UI.unifIntegrable hZ_tendsto
  have hIntegral_tendsto :
      Tendsto (fun n ↦ ∫ ω, Z n ω ∂μ) atTop
        (𝓝 (∫ ω, |Xm ω - L ω| ∂μ)) := by
    have hZ_int : ∀ᶠ n in atTop, Integrable (Z n) μ := by
      obtain ⟨CZ, hCZ⟩ := hZ_UI.2.2
      exact Filter.Eventually.of_forall fun n ↦
        memLp_one_iff_integrable.mp
          ⟨hZ_UI.aestronglyMeasurable n, lt_of_le_of_lt (hCZ n) ENNReal.coe_lt_top⟩
    exact tendsto_integral_of_L1'
      (fun ω ↦ |Xm ω - L ω|) hAbs_int hZ_int hZ_tendsto_L1
  have hIntegral_zero : ∫ ω, |Xm ω - L ω| ∂μ = 0 := by
    have hZeroSeq : Tendsto (fun n ↦ ∫ ω, Z n ω ∂μ) atTop (𝓝 0) := by
      refine Tendsto.congr' ?_ tendsto_const_nhds
      exact Filter.Eventually.of_forall fun n ↦ by
        simp [Z, signedError_integral_eq_zero
          (μ := μ) (Xm := Xm) hXm_int (Y := Y) (D := D)
          hY_binary hY_condExp hRecover n]
    exact tendsto_nhds_unique hIntegral_tendsto hZeroSeq
  have hAbs_ae_zero : (fun ω ↦ |Xm ω - L ω|) =ᵐ[μ] 0 := by
    refine (MeasureTheory.integral_eq_zero_iff_of_nonneg_ae
      (Filter.Eventually.of_forall fun ω ↦ abs_nonneg _) hAbs_int).1 hIntegral_zero
  -- Proof comment: a nonnegative integrable limit with zero integral must vanish almost
  -- everywhere, so the canonical martingale limit agrees with `Xm`.
  filter_upwards [hAbs_ae_zero] with ω hω
  exact (sub_eq_zero.mp (abs_eq_zero.mp hω)).symm

/-- Helper for Theorem 22.10: after the split-sign process is packaged as a binary martingale,
the remaining analytic step is to identify its canonical limit with the measurable target. -/
private theorem aeTendsto_measurableTarget_of_splitSignData
    {Xm : Ω → ℝ} (hXm_sq : MemLp Xm 2 μ)
    {Y : ℕ → Ω → ℝ} {D : ℕ → Ω → splitSignValue}
    (hY_binary : ∀ T, IsBinaryModel (fun i : Fin (T + 1) ↦ Y i.1))
    (hY_condExp :
      ∀ n,
        let ℱY := Filtration.natural Y
          (ProbabilityTheory.binaryModelTruncations_stronglyMeasurable hY_binary)
        Y n =ᵐ[μ] μ[Xm | ℱY n])
    (hTargetCompare : ∀ n ω, D n ω = splitSignOfStep (Y n ω) (Xm ω))
    (hRecover : ∀ n ω, D n ω = splitSignOfStep (Y n ω) (Y (n + 1) ω)) :
    ∀ᵐ ω ∂μ, Tendsto (fun n ↦ Y n ω) atTop (𝓝 (Xm ω)) := by
  let ℱY := binaryNaturalFiltration Y hY_binary
  have hY_mart : Martingale Y ℱY μ := by
    -- Proof comment: the natural-filtration conditional-expectation identities already package
    -- the process as a martingale.
    simpa [ℱY, binaryNaturalFiltration] using
      binarySplitting_condExp_martingale
        (μ := μ) (X := Xm) (Y := Y) hY_binary hY_condExp
  have hY_l2_bdd : ∃ C : NNReal, ∀ n, eLpNorm (Y n) (ENNReal.ofReal 2) μ ≤ C := by
    -- Proof comment: the same conditional-expectation realization gives the uniform `L²` bound
    -- required by the martingale convergence theorem.
    simpa [ℱY, binaryNaturalFiltration] using
      binarySplitting_condExp_l2Bound
        (μ := μ) (X := Xm) hXm_sq (Y := Y) hY_binary hY_condExp
  obtain ⟨_, _, hY_tendsto_ae_limit, _⟩ :=
    MeasureTheory.martingale_convergence_to_memLp_limitProcess_of_lp_bounded
      (X := Y) (ℱ := ℱY) (μ := μ) (p := 2) hY_mart (by norm_num) hY_l2_bdd
  have hLimitEq : Filtration.limitProcess Y ℱY μ =ᵐ[μ] Xm := by
    -- Proof comment: the remaining source-specific analytic step is isolated in the dedicated
    -- limit-identification theorem.
    simpa [ℱY, binaryNaturalFiltration] using
      splitSign_limitProcess_ae_eq_target
        (μ := μ) (Xm := Xm) hXm_sq hY_binary hY_condExp hTargetCompare hRecover
  -- Proof comment: once the canonical limit agrees a.e. with `Xm`, the almost-sure convergence
  -- to `Xm` is just an `ae` target transport from the Chapter 11 limit theorem.
  exact aeTendsto_congr_target
    (μ := μ) (Xm := Filtration.limitProcess Y ℱY μ) hLimitEq hY_tendsto_ae_limit

/-- Helper for Theorem 22.10: the only remaining source construction can be reduced to the case of
a measurable target. -/
private theorem exists_binarySplitting_condExp_limit_data_of_measurableTarget
    {Xm : Ω → ℝ} (hXm_meas : Measurable Xm) (hXm_sq : MemLp Xm 2 μ)
    (hXm_mean_zero : ∫ ω, Xm ω ∂μ = 0) :
    ∃ Y : ℕ → Ω → ℝ,
      ∃ hY_binary : ∀ T, IsBinaryModel (fun i : Fin (T + 1) ↦ Y i.1),
        Y 0 = 0 ∧
          (∀ n,
            let ℱY := Filtration.natural Y
              (ProbabilityTheory.binaryModelTruncations_stronglyMeasurable hY_binary)
            Y n =ᵐ[μ] μ[Xm | ℱY n]) ∧
          (∀ᵐ ω ∂μ, Tendsto (fun n ↦ Y n ω) atTop (𝓝 (Xm ω))) := by
  obtain ⟨Y, D, hY0, hD_meas, hFactor, hTargetCompare, hRecover, hStageCondExp⟩ :=
    exists_splitSignData_of_measurableTarget
      (Ω := Ω) (μ := μ) (Xm := Xm) hXm_meas hXm_sq hXm_mean_zero
  obtain ⟨hY_binary, hY0_zero, hY_condExp⟩ :=
    measurableTarget_process_package_of_splitSignData
      (Ω := Ω) (μ := μ) (Xm := Xm) (Y := Y) (D := D)
      hY0 hD_meas hFactor hRecover hStageCondExp
  refine ⟨Y, hY_binary, hY0_zero, hY_condExp, ?_⟩
  -- Proof comment: once the exact split-sign recursion is assembled, the only remaining source
  -- endgame is the almost-sure identification of the martingale limit with `Xm`.
  exact aeTendsto_measurableTarget_of_splitSignData
    (μ := μ) (Xm := Xm) hXm_sq hY_binary hY_condExp hTargetCompare hRecover

/-- Helper for Theorem 22.10: a source-facing exact binary process whose stages are versions of
the conditional expectations of `X` along its own natural filtration and whose canonical terminal
value converges almost surely to `X`. -/
private theorem exists_binarySplitting_condExp_limit_data
    {X : Ω → ℝ} (hX_sq : MemLp X 2 μ) (hX_mean_zero : ∫ ω, X ω ∂μ = 0) :
    ∃ Y : ℕ → Ω → ℝ,
      ∃ hY_binary : ∀ T, IsBinaryModel (fun i : Fin (T + 1) ↦ Y i.1),
        Y 0 = 0 ∧
          (∀ n,
            let ℱY := Filtration.natural Y
              (ProbabilityTheory.binaryModelTruncations_stronglyMeasurable hY_binary)
            Y n =ᵐ[μ] μ[X | ℱY n]) ∧
          (∀ᵐ ω ∂μ, Tendsto (fun n ↦ Y n ω) atTop (𝓝 (X ω))) := by
  let Xm : Ω → ℝ := hX_sq.aestronglyMeasurable.mk X
  have hXm_meas : Measurable Xm := by
    -- Proof comment: run the source recursion on a measurable representative of `X`.
    simpa [Xm] using hX_sq.aestronglyMeasurable.measurable_mk
  have hXm_ae : Xm =ᵐ[μ] X := by
    -- Proof comment: the measurable representative agrees with the original target almost
    -- everywhere, which is enough for both conditional expectations and almost-sure limits.
    simpa [Xm] using hX_sq.aestronglyMeasurable.ae_eq_mk.symm
  have hXm_sq : MemLp Xm 2 μ := by
    have hnorm : ∀ᵐ ω ∂μ, ‖X ω‖ = ‖Xm ω‖ := by
      filter_upwards [hXm_ae] with ω hω_eq
      simp [hω_eq]
    exact hX_sq.congr_norm hXm_meas.aestronglyMeasurable hnorm
  have hXm_mean_zero : ∫ ω, Xm ω ∂μ = 0 := by
    -- Proof comment: centering is invariant under almost-everywhere equal replacement.
    calc
      ∫ ω, Xm ω ∂μ = ∫ ω, X ω ∂μ := integral_congr_ae hXm_ae
      _ = 0 := hX_mean_zero
  obtain ⟨Y, hY_binary, hY0, hY_condExp_Xm, hY_tendsto_ae_Xm⟩ :=
    exists_binarySplitting_condExp_limit_data_of_measurableTarget
      (Ω := Ω) (μ := μ) (Xm := Xm) hXm_meas hXm_sq hXm_mean_zero
  refine ⟨Y, hY_binary, hY0, ?_, ?_⟩
  · intro n
    let ℱY := binaryNaturalFiltration Y hY_binary
    -- Proof comment: conditional expectations along the natural filtration transport across the
    -- measurable representative by `condExp_congr_ae`.
    calc
      Y n =ᵐ[μ] μ[Xm | ℱY n] := by
        simpa [ℱY, binaryNaturalFiltration] using hY_condExp_Xm n
      _ =ᵐ[μ] μ[X | ℱY n] := condExp_congr_ae hXm_ae
  · -- Proof comment: almost-sure convergence transports across the same full-measure equality
    -- set.
    exact aeTendsto_congr_target (μ := μ) hXm_ae hY_tendsto_ae_Xm

-- Proof sketch: use the dyadic sign process built from the comparisons between `X` and the
-- successive conditional expectations `E[X | σ(D₁, …, Dₙ)]`. These conditional expectations form a
-- square-integrable martingale starting at `0`; martingale convergence in `L²` and almost surely
-- yields a limit, and the sign argument identifies that limit with `X`.
/-- Theorem 22.10: every centered square-integrable real random variable is the almost-sure and
`L²` limit of a martingale starting from `0` whose finite truncations are Chapter 9 binary
models. The canonical owner for the `L²` convergence clause is `TendstoInLp 2`. -/
theorem exists_binarySplittingMartingale_tendsto_ae_and_tendstoInLp_two
    {X : Ω → ℝ} (hX_sq : MemLp X 2 μ) (hX_mean_zero : ∫ ω, X ω ∂μ = 0) :
      ∃ Y : ℕ → Ω → ℝ,
      ∃ hY_binary : ∀ T, IsBinaryModel (fun i : Fin (T + 1) ↦ Y i.1),
        let ℱY := Filtration.natural Y
          (ProbabilityTheory.binaryModelTruncations_stronglyMeasurable hY_binary)
        Martingale Y ℱY μ ∧
          Y 0 = 0 ∧
          (∀ᵐ ω ∂μ, Tendsto (fun n ↦ Y n ω) atTop (𝓝 (X ω))) ∧
          TendstoInLp 2 μ Y X := by
  obtain ⟨Y, hY_binary, hY0, hY_condExp, hY_tendsto_ae⟩ :=
    exists_binarySplitting_condExp_limit_data hX_sq hX_mean_zero
  -- Proof comment: once the exact source process package is available, the martingale and
  -- convergence claims are exactly the owner-level bridge proved above.
  refine ⟨Y, hY_binary, ?_⟩
  simpa using
    binarySplittingMartingale_of_condExpBridge
      (μ := μ) (X := X) hX_sq hY_binary hY0 hY_condExp hY_tendsto_ae

/-- Bridge companion to Theorem 22.10: the owner-level `TendstoInLp 2` conclusion rewritten as
convergence of the corresponding `eLpNorm` errors. -/
theorem exists_binarySplittingMartingale_tendsto_ae_and_eLpNorm_two
    {X : Ω → ℝ} (hX_sq : MemLp X 2 μ) (hX_mean_zero : ∫ ω, X ω ∂μ = 0) :
      ∃ Y : ℕ → Ω → ℝ,
      ∃ hY_binary : ∀ T, IsBinaryModel (fun i : Fin (T + 1) ↦ Y i.1),
        let ℱY := Filtration.natural Y
          (ProbabilityTheory.binaryModelTruncations_stronglyMeasurable hY_binary)
        Martingale Y ℱY μ ∧
          Y 0 = 0 ∧
          (∀ᵐ ω ∂μ, Tendsto (fun n ↦ Y n ω) atTop (𝓝 (X ω))) ∧
          Tendsto (fun n ↦ eLpNorm (Y n - X) 2 μ) atTop (𝓝 0) := by
  rcases exists_binarySplittingMartingale_tendsto_ae_and_tendstoInLp_two hX_sq hX_mean_zero with
    ⟨Y, hY_binary, hrest⟩
  dsimp at hrest ⊢
  rcases hrest with ⟨hY_mart, hY0, hY_tendsto_ae, hY_tendsto_l2⟩
  exact ⟨Y, hY_binary, hY_mart, hY0, hY_tendsto_ae, hY_tendsto_l2.tendsto_eLpNorm⟩

end ProbabilityTheory
