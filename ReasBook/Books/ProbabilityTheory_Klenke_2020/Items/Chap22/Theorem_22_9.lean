import Mathlib
import Books.ProbabilityTheory_Klenke_2020.Items.Chap09.Definition_9_42
import Books.ProbabilityTheory_Klenke_2020.Items.Chap11.Theorem_11_10

open Filter MeasureTheory ProbabilityTheory
open scoped NNReal ProbabilityTheory Topology

noncomputable section

universe u

namespace ProbabilityTheory

/-- Helper for Theorem 22.9: the natural filtration generated by a binary splitting martingale. -/
def binaryNaturalFiltration {Ω : Type u} [MeasurableSpace Ω] (X : ℕ → Ω → ℝ)
    (hX_binary : ∀ T, IsBinaryModel (fun i : Fin (T + 1) ↦ X i.1)) :
    Filtration ℕ ‹MeasurableSpace Ω› :=
  Filtration.natural X (ProbabilityTheory.binaryModelTruncations_stronglyMeasurable hX_binary)

/-- Helper for Theorem 22.9: the canonical almost-sure limit attached to a binary splitting
martingale. -/
def binaryLimitProcess {Ω : Type u} [MeasurableSpace Ω] (law : Measure Ω) (X : ℕ → Ω → ℝ)
    (hX_binary : ∀ T, IsBinaryModel (fun i : Fin (T + 1) ↦ X i.1)) : Ω → ℝ :=
  Filtration.limitProcess X (binaryNaturalFiltration X hX_binary) law

/-- Helper for Theorem 22.9: an `L²`-bounded binary splitting martingale converges to its
canonical limit process with mean `0`. -/
theorem binarySplittingMartingale_converges_to_limitProcess_two
    {Ω : Type u} [MeasurableSpace Ω] (law : ProbabilityMeasure Ω) {X : ℕ → Ω → ℝ}
    (hX_binary : ∀ T, IsBinaryModel (fun i : Fin (T + 1) ↦ X i.1))
    (hX_mart : Martingale X (binaryNaturalFiltration X hX_binary) (law : Measure Ω))
    (hX0 : X 0 = 0)
    (hX_l2_bdd : ∃ C : NNReal, ∀ n, eLpNorm (X n) 2 (law : Measure Ω) ≤ C) :
    StronglyMeasurable[⨆ n, (binaryNaturalFiltration X hX_binary) n]
        (binaryLimitProcess (law : Measure Ω) X hX_binary) ∧
      MemLp (binaryLimitProcess (law : Measure Ω) X hX_binary) 2 (law : Measure Ω) ∧
      (∀ᵐ ω ∂(law : Measure Ω),
        Tendsto (fun n ↦ X n ω) atTop
          (𝓝 (binaryLimitProcess (law : Measure Ω) X hX_binary ω))) ∧
      TendstoInLp 2 (law : Measure Ω) X (binaryLimitProcess (law : Measure Ω) X hX_binary) ∧
      ((∫ ω, binaryLimitProcess (law : Measure Ω) X hX_binary ω ∂(law : Measure Ω)) = 0) := by
  let ℱ := binaryNaturalFiltration X hX_binary
  let L : Ω → ℝ := binaryLimitProcess (law : Measure Ω) X hX_binary
  have hX_l2_bdd' :
      ∃ C : NNReal, ∀ n, eLpNorm (X n) (ENNReal.ofReal 2) (law : Measure Ω) ≤ C := by
    simpa using hX_l2_bdd
  obtain ⟨hL_meas, hL_memLp, hX_tendsto_ae, hX_tendsto_lp⟩ :=
    MeasureTheory.martingale_convergence_to_memLp_limitProcess_of_lp_bounded
      (X := X) (ℱ := ℱ) (μ := (law : Measure Ω)) (p := 2)
      (by simpa [ℱ, binaryNaturalFiltration] using hX_mart) (by norm_num) hX_l2_bdd'
  have hL_integrable : Integrable L (law : Measure Ω) := by
    simpa [L] using hL_memLp.integrable (by norm_num)
  have hX_tendsto_l1 :
      Tendsto (fun n ↦ eLpNorm (X n - L) 1 (law : Measure Ω)) atTop (𝓝 0) := by
    letI : Fact (1 ≤ ENNReal.ofReal 2) := ⟨by norm_num⟩
    have hX_tendsto_l2 :
        Tendsto (fun n ↦ eLpNorm (X n - L) (ENNReal.ofReal 2) (law : Measure Ω)) atTop (𝓝 0) := by
      simpa [L] using hX_tendsto_lp.tendsto_eLpNorm
    have hCompare :
        ∀ n,
          eLpNorm (X n - L) 1 (law : Measure Ω) ≤
            eLpNorm (X n - L) (ENNReal.ofReal 2) (law : Measure Ω) :=
      fun n ↦ by
        have hXn_ae : AEStronglyMeasurable (X n) (law : Measure Ω) := by
          exact
            StronglyMeasurable.aestronglyMeasurable
              ((ProbabilityTheory.binaryModelTruncations_stronglyMeasurable hX_binary) n)
        exact
          MeasureTheory.eLpNorm_le_eLpNorm_of_exponent_le
            (μ := (law : Measure Ω)) (f := X n - L) (by norm_num)
            (hXn_ae.sub hL_memLp.aestronglyMeasurable)
    exact
      tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds hX_tendsto_l2
        (fun _ ↦ zero_le _) hCompare
  have hIntegral_tendsto :
      Tendsto (fun n ↦ ∫ ω, X n ω ∂(law : Measure Ω)) atTop
        (𝓝 (∫ ω, L ω ∂(law : Measure Ω))) := by
    exact
      MeasureTheory.tendsto_integral_of_L1' L hL_integrable
        (Filter.Eventually.of_forall fun n ↦ hX_mart.integrable n) hX_tendsto_l1
  have hIntegral_zero (n : ℕ) : ∫ ω, X n ω ∂(law : Measure Ω) = 0 := by
    simpa [hX0] using
      (hX_mart.setIntegral_eq (i := 0) (j := n) (Nat.zero_le n) MeasurableSet.univ).symm
  have hL_mean_zero : ∫ ω, L ω ∂(law : Measure Ω) = 0 := by
    have hConst :
        Tendsto (fun n ↦ ∫ ω, X n ω ∂(law : Measure Ω)) atTop (𝓝 (0 : ℝ)) :=
      tendsto_const_nhds.congr' <| Filter.Eventually.of_forall fun n ↦ (hIntegral_zero n).symm
    exact tendsto_nhds_unique hIntegral_tendsto hConst
  exact
    ⟨by simpa [L] using hL_meas, by simpa [L] using hL_memLp,
      by simpa [L] using hX_tendsto_ae, by simpa [L] using hX_tendsto_lp, hL_mean_zero⟩

/-- Theorem 22.9: the `L²`-bounded convergence package for a binary splitting martingale under the
planned owner declaration. -/
theorem successorStageTimePackage
    {Ω : Type u} [MeasurableSpace Ω] (law : ProbabilityMeasure Ω) {X : ℕ → Ω → ℝ}
    (hX_binary : ∀ T, IsBinaryModel (fun i : Fin (T + 1) ↦ X i.1))
    (hX_mart : Martingale X (binaryNaturalFiltration X hX_binary) (law : Measure Ω))
    (hX0 : X 0 = 0)
    (hX_l2_bdd : ∃ C : NNReal, ∀ n, eLpNorm (X n) 2 (law : Measure Ω) ≤ C) :
    StronglyMeasurable[⨆ n, (binaryNaturalFiltration X hX_binary) n]
        (binaryLimitProcess (law : Measure Ω) X hX_binary) ∧
      MemLp (binaryLimitProcess (law : Measure Ω) X hX_binary) 2 (law : Measure Ω) ∧
      (∀ᵐ ω ∂(law : Measure Ω),
        Tendsto (fun n ↦ X n ω) atTop
          (𝓝 (binaryLimitProcess (law : Measure Ω) X hX_binary ω))) ∧
      TendstoInLp 2 (law : Measure Ω) X (binaryLimitProcess (law : Measure Ω) X hX_binary) ∧
      ((∫ ω, binaryLimitProcess (law : Measure Ω) X hX_binary ω ∂(law : Measure Ω)) = 0) :=
  binarySplittingMartingale_converges_to_limitProcess_two law hX_binary hX_mart hX0 hX_l2_bdd

end ProbabilityTheory
