open MeasureTheory TopologicalSpace
open scoped BoundedContinuousFunction

universe u v

variable {Ω : Type u} [TopologicalSpace Ω]

/-- An open neighborhood admits a bounded continuous real-valued
separator that is `1` at the chosen point and vanishes off the open set. -/
lemma existsBoundedContinuousOneZeroOffOfMemOpen [CompletelyRegularSpace Ω]
    {U : Set Ω} (hU : IsOpen U) {x : Ω} (hx : x ∈ U) :
    ∃ f : Ω →ᵇ ℝ, f x = 1 ∧ ∀ y ∉ U, f y = 0 := by
  -- Start from the completely regular separator into the unit interval.
  obtain ⟨g, hg, hgx, hgU⟩ := CompletelyRegularSpace.completely_regular_isOpen x U hU hx
  let f0 : Ω → ℝ := fun y ↦ 1 - (g y : ℝ)
  have hf0 : Continuous f0 := by
    -- The flipped separator is still continuous after composing with the coercion `I → ℝ`.
    exact continuous_const.sub (continuous_subtype_val.comp hg)
  have hbound : ∀ y, ‖f0 y‖ ≤ 1 := by
    -- Unit-interval bounds keep the flipped separator uniformly bounded by `1`.
    intro y
    have hy0 : 0 ≤ (g y : ℝ) := (g y).2.1
    have hy1 : (g y : ℝ) ≤ 1 := (g y).2.2
    have hy_nonneg : 0 ≤ f0 y := by
      dsimp [f0]
      linarith
    rw [show ‖f0 y‖ = f0 y by exact abs_of_nonneg hy_nonneg]
    dsimp [f0]
    linarith
  refine ⟨BoundedContinuousFunction.ofNormedAddCommGroup f0 hf0 1 hbound, ?_, ?_⟩
  · -- The flip turns the value `0` at `x` into the value `1`.
    change f0 x = 1
    have hgx' : (g x : ℝ) = 0 := by
      simpa using congrArg (fun t : Set.Icc (0 : ℝ) 1 ↦ (t : ℝ)) hgx
    dsimp [f0]
    linarith
  · -- Off `U`, the original separator is `1`, so the flipped one vanishes.
    intro y hyU
    change f0 y = 0
    have hgy : (g y : ℝ) = 1 := by
      simpa using congrArg (fun t : Set.Icc (0 : ℝ) 1 ↦ (t : ℝ)) (hgU hyU)
    dsimp [f0]
    linarith

/-- Threshold sets of bounded continuous real-valued functions are
measurable in the `σ`-algebra generated by all bounded continuous real-valued maps. -/
lemma measurableSet_Ici_of_mem_iSupComapBoundedContinuous (f : Ω →ᵇ ℝ) :
    MeasurableSet[⨆ g : Ω →ᵇ ℝ, MeasurableSpace.comap g (borel ℝ)] {x | (1 / 2 : ℝ) ≤ f x} := by
  -- First view the threshold set inside the single generator `comap f`.
  have hIci : MeasurableSet[MeasurableSpace.comap f (borel ℝ)] {x | (1 / 2 : ℝ) ≤ f x} := by
    refine MeasurableSpace.measurableSet_comap.2 ?_
    refine ⟨Set.Ici (1 / 2 : ℝ), ?_, rfl⟩
    simp
  -- Then transport measurability along the lattice inequality `comap f ≤ ⨆ g, comap g`.
  exact (le_iSup (fun g : Ω →ᵇ ℝ ↦ MeasurableSpace.comap g (borel ℝ)) f) _ hIci

/-- The Borel `σ`-algebra is contained in the `σ`-algebra generated by bounded continuous
real-valued functions because strict half-level sets of such functions form a subbasis for the
topology. -/
lemma borel_le_iSupComap_boundedContinuous [CompletelyRegularSpace Ω] [SecondCountableTopology Ω] :
    borel Ω ≤ ⨆ f : Ω →ᵇ ℝ, MeasurableSpace.comap f (borel ℝ) := by
  let m : MeasurableSpace Ω := ⨆ f : Ω →ᵇ ℝ, MeasurableSpace.comap f (borel ℝ)
  refine MeasurableSpace.generateFrom_le fun U hU ↦ ?_
  -- For each point of `U`, choose a bounded continuous separator whose strict half-level set
  -- stays inside `U`.
  choose f hf_one hf_zero using
    fun z : U ↦ existsBoundedContinuousOneZeroOffOfMemOpen hU z.2
  let V : U → Set Ω := fun z ↦ {y | (1 / 2 : ℝ) < f z y}
  have hV_open : ∀ z : U, IsOpen (V z) := by
    intro z
    -- Strict half-level sets of a continuous real-valued function are open.
    simpa [V] using isOpen_lt continuous_const (f z).continuous
  have hz_mem : ∀ z : U, z.1 ∈ V z := by
    intro z
    -- The chosen point lands at value `1`, hence in the strict half-level set.
    have hz_one : f z z = 1 := hf_one z
    have hhalf : (1 / 2 : ℝ) < 1 := by norm_num
    simpa [V, hz_one] using hhalf
  have hV_subset : ∀ z : U, V z ⊆ U := by
    intro z y hyV
    by_contra hyU
    -- Outside `U` the separator vanishes, contradicting membership in the strict half-level set.
    have hy_zero : f z y = 0 := hf_zero z y hyU
    have : ¬ ((1 / 2 : ℝ) < f z y) := by simp [hy_zero]
    exact this hyV
  have hcover : U = ⋃ z : U, V z := by
    ext y
    constructor
    · intro hy
      exact Set.mem_iUnion.2 ⟨⟨y, hy⟩, hz_mem ⟨y, hy⟩⟩
    · intro hy
      rcases Set.mem_iUnion.1 hy with ⟨z, hz⟩
      exact hV_subset z hz
  obtain ⟨T, hT_countable, hT_cover⟩ :=
    TopologicalSpace.isOpen_iUnion_countable V hV_open
  have hV_meas : ∀ z : U, MeasurableSet[m] (V z) := by
    intro z
    have hz_meas : MeasurableSet[MeasurableSpace.comap (f z) (borel ℝ)] (V z) := by
      refine MeasurableSpace.measurableSet_comap.2 ?_
      refine ⟨Set.Ioi (1 / 2 : ℝ), ?_, rfl⟩
      simp
    exact (le_iSup (fun g : Ω →ᵇ ℝ ↦ MeasurableSpace.comap g (borel ℝ)) (f z)) _ hz_meas
  have hcountable_meas' : MeasurableSet[m] (⋃ z : T, V z.1) := by
    -- Reduce to a countable subtype and take a countable union of measurable threshold sets.
    -- Local instance justification (proof-local temporary data): this subtype-countability
    -- instance is used only for the measurable countable union in the current proof.
    letI : Countable T := hT_countable.to_subtype
    exact MeasurableSet.iUnion fun z : T ↦ hV_meas z.1
  have hcountable_meas : MeasurableSet[m] (⋃ z ∈ T, V z) := by
    simpa [Set.iUnion_subtype] using hcountable_meas'
  -- Replace the full open cover by the countable subcover and conclude measurability of `U`.
  rw [hcover, ← hT_cover]
  exact hcountable_meas

/-- Open sets are measurable in the `σ`-algebra generated by
bounded continuous real-valued maps. -/
lemma isOpen_measurable_iSupComapBoundedContinuous
    [CompletelyRegularSpace Ω] [SecondCountableTopology Ω]
    {U : Set Ω} (hU : IsOpen U) :
    MeasurableSet[⨆ f : Ω →ᵇ ℝ, MeasurableSpace.comap f (borel ℝ)] U := by
  -- Apply the Borel inclusion to the open-set measurability fact in `borel Ω`.
  exact borel_le_iSupComap_boundedContinuous U (MeasurableSpace.measurableSet_generateFrom hU)

/-- Helper for Exercise 15.1.7: if `Ω` is completely regular and second countable, then the
Borel `σ`-algebra on `Ω` is generated by the bounded continuous real-valued functions on `Ω`.
This is the corrected usable theorem behind the printed exercise. -/
theorem borel_eq_iSupComap_boundedContinuous_of_secondCountable [CompletelyRegularSpace Ω]
    [SecondCountableTopology Ω] :
    borel Ω = ⨆ f : Ω →ᵇ ℝ, MeasurableSpace.comap f (borel ℝ) := by
  refine le_antisymm borel_le_iSupComap_boundedContinuous ?_
  -- Each bounded continuous generator is Borel measurable, so every `comap` sits below `borel Ω`.
  refine iSup_le fun f ↦ ?_
  exact MeasurableSpace.comap_le_iff_le_map.2 (Continuous.borel_measurable f.continuous)

/-- Helper for Exercise 15.1.7: the `σ`-algebra generated by a chosen subfamily of bounded
continuous real-valued functions. -/
private abbrev measurableSpaceFromBoundedContinuous (T : Set (Ω →ᵇ ℝ)) : MeasurableSpace Ω :=
  ⨆ f : T, MeasurableSpace.comap f.1 (borel ℝ)

/-- Helper for Exercise 15.1.7: enlarging the family of bounded continuous generators can only
enlarge the generated `σ`-algebra. -/
private lemma measurableSpaceFromBoundedContinuous_mono
    {S T : Set (Ω →ᵇ ℝ)} (hST : S ⊆ T) :
    measurableSpaceFromBoundedContinuous S ≤
      measurableSpaceFromBoundedContinuous T := by
  -- Each generator from `S` also appears in the larger family `T`.
  refine iSup_le fun f ↦ ?_
  exact le_iSup_of_le ⟨f.1, hST f.2⟩ le_rfl

/-- Helper for Exercise 15.1.7: every measurable set in the `σ`-algebra generated by all bounded
continuous real-valued functions already depends on a countable subfamily of generators. -/
private lemma exists_countable_boundedContinuousFamily_of_measurableSet
    {s : Set Ω}
    (hs : MeasurableSet[⨆ f : Ω →ᵇ ℝ, MeasurableSpace.comap f (borel ℝ)] s) :
    ∃ T : Set (Ω →ᵇ ℝ), T.Countable ∧
      MeasurableSet[measurableSpaceFromBoundedContinuous T] s := by
  let C : Set (Set Ω) :=
    {t | ∃ f : Ω →ᵇ ℝ, MeasurableSet[MeasurableSpace.comap f (borel ℝ)] t}
  have hgen :
      (⨆ f : Ω →ᵇ ℝ, MeasurableSpace.comap f (borel ℝ)) = MeasurableSpace.generateFrom C := by
    -- Rewrite the global `iSup` as a `generateFrom` so that `generateFrom_induction` can track
    -- which generators are actually used.
    simpa [C] using
      (MeasurableSpace.measurableSpace_iSup_eq
        (fun f : Ω →ᵇ ℝ ↦ MeasurableSpace.comap f (borel ℝ)))
  have hs' : MeasurableSet[MeasurableSpace.generateFrom C] s := by
    rw [← hgen]
    exact hs
  -- Induct over the measurable-set construction and collect the generators used at each step.
  refine MeasurableSpace.generateFrom_induction C
      (fun t _ ↦ ∃ T : Set (Ω →ᵇ ℝ), T.Countable ∧
        MeasurableSet[measurableSpaceFromBoundedContinuous T] t)
      ?_ ?_ ?_ ?_ s hs'
  · intro t ht _
    rcases ht with ⟨f, hf⟩
    refine ⟨{f}, Set.countable_singleton _, ?_⟩
    -- A basic generator only uses the singleton family containing its own function.
    exact
      (le_iSup (fun g : {g // g ∈ ({f} : Set (Ω →ᵇ ℝ))} ↦
        MeasurableSpace.comap g.1 (borel ℝ)) ⟨f, by simp⟩) _ hf
  · refine ⟨∅, Set.to_countable ∅, by
      simp⟩
  · intro t _ ⟨T, hT_count, hT_meas⟩
    refine ⟨T, hT_count, hT_meas.compl⟩
  · intro u hu hcount
    choose T hT_count hT_meas using hcount
    refine ⟨⋃ n, T n, Set.countable_iUnion hT_count, ?_⟩
    -- Countable unions stay measurable after enlarging to the union of all used generators.
    refine MeasurableSet.iUnion fun n ↦ ?_
    exact (measurableSpaceFromBoundedContinuous_mono (Set.subset_iUnion T n)) _ (hT_meas n)

/-- Helper for Exercise 15.1.7: if every bounded continuous generator in a family takes the same
value at two points, then that family cannot distinguish the points measurably. -/
private lemma mem_iff_of_forall_eq_boundedContinuousFamily
    {T : Set (Ω →ᵇ ℝ)} {x y : Ω}
    (hxy : ∀ f ∈ T, f x = f y) :
    ∀ s, MeasurableSet[measurableSpaceFromBoundedContinuous T] s → (x ∈ s ↔ y ∈ s) := by
  let C : Set (Set Ω) :=
    {t | ∃ f : T, MeasurableSet[MeasurableSpace.comap f.1 (borel ℝ)] t}
  have hgen :
      measurableSpaceFromBoundedContinuous T = MeasurableSpace.generateFrom C := by
    simpa [C, measurableSpaceFromBoundedContinuous] using
      (MeasurableSpace.measurableSpace_iSup_eq
        (fun f : T ↦ MeasurableSpace.comap f.1 (borel ℝ)))
  have hall : ∀ s, MeasurableSet[MeasurableSpace.generateFrom C] s → (x ∈ s ↔ y ∈ s) := by
    -- It is enough to check the basic preimages from the chosen family.
    rw [MeasurableSpace.forall_generateFrom_mem_iff_mem_iff]
    intro s hs
    rcases hs with ⟨f, hf⟩
    rcases MeasurableSpace.measurableSet_comap.1 hf with ⟨u, hu, rfl⟩
    change f.1 x ∈ u ↔ f.1 y ∈ u
    rw [hxy f.1 f.2]
  intro s hs
  -- Rewrite the measurable structure back to `generateFrom C` and apply the generator test.
  rw [hgen] at hs
  exact hall s hs

/-- Helper for Exercise 15.1.7: on a countable `T₁` space, the printed equality would force a
countable family of bounded continuous functions that separates points. -/
private lemma exists_countable_separating_boundedContinuousFamily_of_borel_eq
    [Countable Ω] [T1Space Ω]
    (hΩ : borel Ω = ⨆ f : Ω →ᵇ ℝ, MeasurableSpace.comap f (borel ℝ)) :
    ∃ T : Set (Ω →ᵇ ℝ), T.Countable ∧
      Pairwise fun x y ↦ ∃ f ∈ T, f x ≠ f y := by
  choose Tx hTx_count hTx_meas using
    fun x : Ω ↦ by
      -- Singletons are Borel on a countable `T₁` space, so they must come from countably many
      -- bounded continuous generators under the printed equality.
      let _ : MeasurableSpace Ω := borel Ω
      let _ : BorelSpace Ω := ⟨rfl⟩
      have hxMeas : MeasurableSet ({x} : Set Ω) := by
        simp
      have hxMeas' :
          MeasurableSet[⨆ f : Ω →ᵇ ℝ, MeasurableSpace.comap f (borel ℝ)] ({x} : Set Ω) := by
        rw [← hΩ]
        exact hxMeas
      exact exists_countable_boundedContinuousFamily_of_measurableSet hxMeas'
  refine ⟨⋃ x, Tx x, Set.countable_iUnion hTx_count, ?_⟩
  intro x y hxy
  by_contra hsep
  have hEq : ∀ f ∈ Tx x, f x = f y := by
    intro f hf
    by_contra hneq
    exact hsep ⟨f, Set.mem_iUnion.2 ⟨x, hf⟩, hneq⟩
  have hmem := mem_iff_of_forall_eq_boundedContinuousFamily hEq
    ({x} : Set Ω) (hTx_meas x)
  have : y ∈ ({x} : Set Ω) := hmem.mp (by simp)
  exact hxy this.symm

section SplitIntervalWitness

instance splitIntervalAmbientTopologicalSpace : TopologicalSpace (ℝ ×ₗ Bool) :=
  Preorder.topology (ℝ ×ₗ Bool)

instance splitIntervalAmbientOrderTopology : OrderTopology (ℝ ×ₗ Bool) :=
  ⟨rfl⟩

/-- Helper for Exercise 15.1.7: the parameter interval `[0, 1]` indexing the split pairs. -/
private abbrev splitCoordinate : Type :=
  Set.Icc (0 : ℝ) 1

/-- Helper for Exercise 15.1.7: the split interval witness inside the lexicographically ordered
`ℝ ×ₗ Bool`. -/
abbrev splitInterval : Type :=
  Set.Icc (toLex ((0 : ℝ), false)) (toLex ((1 : ℝ), true))

/-- Helper for Exercise 15.1.7: use the Borel `σ`-algebra on the split-coordinate interval. -/
private instance splitCoordinateMeasurableSpace : MeasurableSpace splitCoordinate :=
  borel splitCoordinate

/-- Helper for Exercise 15.1.7: the split-coordinate interval carries its canonical Borel space
structure. -/
private instance splitCoordinateBorelSpace : BorelSpace splitCoordinate := ⟨rfl⟩

/-- Helper for Exercise 15.1.7: use the Borel `σ`-algebra on the split interval. -/
private instance splitIntervalMeasurableSpace : MeasurableSpace splitInterval :=
  borel splitInterval

/-- Helper for Exercise 15.1.7: the split interval carries its canonical Borel space structure. -/
private instance splitIntervalBorelSpace : BorelSpace splitInterval := ⟨rfl⟩

/-- Helper for Exercise 15.1.7: the lower copy of a coordinate stays inside the split interval. -/
private lemma lowerPoint_mem_splitInterval (x : splitCoordinate) :
    toLex (x.1, false) ∈
      (Set.Icc (toLex ((0 : ℝ), false)) (toLex ((1 : ℝ), true)) :
        Set (ℝ ×ₗ Bool)) := by
  -- The lower copy preserves the first coordinate, so only the interval bounds on `x` matter.
  refine ⟨?_, ?_⟩
  · rw [Prod.Lex.toLex_le_toLex']
    refine ⟨x.2.1, ?_⟩
    intro _
    simp
  · rw [Prod.Lex.toLex_le_toLex']
    refine ⟨x.2.2, ?_⟩
    intro _
    simp

/-- Helper for Exercise 15.1.7: the upper copy of a coordinate stays inside the split interval. -/
private lemma upperPoint_mem_splitInterval (x : splitCoordinate) :
    toLex (x.1, true) ∈
      (Set.Icc (toLex ((0 : ℝ), false)) (toLex ((1 : ℝ), true)) :
        Set (ℝ ×ₗ Bool)) := by
  -- The upper copy satisfies the same first-coordinate bounds, and the endpoint booleans align.
  refine ⟨?_, ?_⟩
  · rw [Prod.Lex.toLex_le_toLex']
    refine ⟨x.2.1, ?_⟩
    intro _
    simp
  · rw [Prod.Lex.toLex_le_toLex']
    refine ⟨x.2.2, ?_⟩
    intro _
    simp

/-- Helper for Exercise 15.1.7: the lower point at `x` in the split interval witness. -/
private def lowerPoint (x : splitCoordinate) : splitInterval :=
  ⟨toLex (x.1, false), lowerPoint_mem_splitInterval x⟩

/-- Helper for Exercise 15.1.7: the upper point at `x` in the split interval witness. -/
private def upperPoint (x : splitCoordinate) : splitInterval :=
  ⟨toLex (x.1, true), upperPoint_mem_splitInterval x⟩

/-- Helper for Exercise 15.1.7: the Borel witness set formed by the upper copy of `[0, 1]`. -/
private def upperCopy : Set splitInterval :=
  {z | (ofLex z.1).2 = true}

/-- Helper for Exercise 15.1.7: the lower and upper copies of the same coordinate form a split
pair in the witness order. -/
private lemma lowerPoint_lt_upperPoint (x : splitCoordinate) :
    lowerPoint x < upperPoint x := by
  -- The first coordinates agree, so the strict inequality comes from `false < true`.
  change toLex (x.1, false) < toLex (x.1, true)
  rw [Prod.Lex.toLex_lt_toLex']
  refine ⟨le_rfl, ?_⟩
  intro _
  simp

/-- Helper for Exercise 15.1.7: the lower and upper copies are adjacent in the split interval. -/
private lemma lowerPoint_covBy_upperPoint (x : splitCoordinate) :
    lowerPoint x ⋖ upperPoint x := by
  -- The lexicographic cover relation on a fixed first coordinate reduces to the Boolean cover.
  have hAmbient : toLex (x.1, false) ⋖ toLex (x.1, true) := by
    rw [Prod.Lex.toLex_covBy_toLex_iff]
    left
    refine ⟨rfl, ?_⟩
    decide
  -- The split interval is an order-connected interval, so cover relations agree with the ambient
  -- lexicographic order after coercion.
  let e : splitInterval ↪o (ℝ ×ₗ Bool) :=
    OrderEmbedding.subtype
      (fun c : ℝ ×ₗ Bool ↦
        c ∈ Set.Icc (toLex ((0 : ℝ), false)) (toLex ((1 : ℝ), true)))
  have hRangeOrd : (Set.range e).OrdConnected := by
    simpa [e, splitInterval] using
      (show Set.OrdConnected
        (Set.Icc (toLex ((0 : ℝ), false)) (toLex ((1 : ℝ), true)) ) by infer_instance)
  exact
    ((Set.OrdConnected.apply_covBy_apply_iff e hRangeOrd).1 hAmbient)

/-- Helper for Exercise 15.1.7: upper points belong to the upper-copy witness set. -/
private lemma upperPoint_mem_upperCopy (x : splitCoordinate) :
    upperPoint x ∈ upperCopy := by
  -- Unfolding the definition shows that the second lexicographic coordinate is `true`.
  simp [upperCopy, upperPoint]

/-- Helper for Exercise 15.1.7: lower points do not belong to the upper-copy witness set. -/
private lemma lowerPoint_not_mem_upperCopy (x : splitCoordinate) :
    lowerPoint x ∉ upperCopy := by
  -- Unfolding the definition shows that the second lexicographic coordinate is `false`.
  simp [upperCopy, lowerPoint]

/-- Helper for Exercise 15.1.7: the lower-copy embedding of `[0, 1]` into the split interval is
injective. -/
private lemma lowerPoint_injective : Function.Injective lowerPoint := by
  intro x y hxy
  -- Comparing first coordinates recovers the original split parameter.
  apply Subtype.ext
  simpa [lowerPoint] using
    congrArg (fun z : splitInterval ↦ (ofLex z.1).1) hxy

/-- Helper for Exercise 15.1.7: every split-interval point has first coordinate in `[0, 1]`. -/
private lemma splitInterval_first_mem_Icc (z : splitInterval) :
    (ofLex z.1).1 ∈ Set.Icc (0 : ℝ) 1 := by
  -- Read the interval bounds on the subtype point back on the real coordinate.
  refine ⟨?_, ?_⟩
  · have hz0 : toLex ((0 : ℝ), false) ≤ z.1 := z.2.1
    rw [show z.1 = toLex ((ofLex z.1).1, (ofLex z.1).2) by simp,
      Prod.Lex.toLex_le_toLex'] at hz0
    exact hz0.1
  · have hz1 : z.1 ≤ toLex ((1 : ℝ), true) := z.2.2
    rw [show z.1 = toLex ((ofLex z.1).1, (ofLex z.1).2) by simp,
      Prod.Lex.toLex_le_toLex'] at hz1
    exact hz1.1

/-- Helper for Exercise 15.1.7: different split coordinates are separated in lexicographic order by
their upper and lower copies. -/
private lemma upperPoint_lt_lowerPoint {x y : splitCoordinate} (hxy : x < y) :
    upperPoint x < lowerPoint y := by
  -- A strict increase in the real coordinate already forces the lexicographic inequality.
  change toLex (x.1, true) < toLex (y.1, false)
  rw [Prod.Lex.toLex_lt_toLex']
  refine ⟨le_of_lt hxy, ?_⟩
  intro hEq
  exact False.elim (ne_of_lt hxy (Subtype.ext hEq))

/-- Helper for Exercise 15.1.7: the split-coordinate projection on the split interval. -/
private def splitCoord (z : splitInterval) : splitCoordinate :=
  ⟨(ofLex z.1).1, splitInterval_first_mem_Icc z⟩

/-- Helper for Exercise 15.1.7: projecting the lower copy recovers the original split coordinate. -/
private lemma splitCoord_lowerPoint (x : splitCoordinate) :
    splitCoord (lowerPoint x) = x := by
  -- The lower copy only changes the Boolean coordinate, so the first coordinate is unchanged.
  apply Subtype.ext
  simp [splitCoord, lowerPoint]

/-- Helper for Exercise 15.1.7: projecting the upper copy recovers the original split coordinate. -/
private lemma splitCoord_upperPoint (x : splitCoordinate) :
    splitCoord (upperPoint x) = x := by
  -- The upper copy has the same first coordinate as the original split parameter.
  apply Subtype.ext
  simp [splitCoord, upperPoint]

/-- Helper for Exercise 15.1.7: projecting to the first coordinate is monotone on the split
interval. -/
private lemma splitCoord_monotone : Monotone splitCoord := by
  intro z w hzw
  -- The lexicographic order can only increase the first coordinate.
  change (ofLex z.1).1 ≤ (ofLex w.1).1
  have hzw' : z.1 ≤ w.1 := hzw
  rw [show z.1 = toLex ((ofLex z.1).1, (ofLex z.1).2) by simp,
    show w.1 = toLex ((ofLex w.1).1, (ofLex w.1).2) by simp,
    Prod.Lex.toLex_le_toLex'] at hzw'
  exact hzw'.1

/-- Helper for Exercise 15.1.7: the split-coordinate projection is Borel measurable. -/
private lemma splitCoord_measurable : Measurable splitCoord := by
  -- Monotonicity is enough for measurability on a linear order with the Borel structure.
  exact splitCoord_monotone.measurable

/-- Helper for Exercise 15.1.7: the upper-copy embedding is strictly monotone in the split
parameter. -/
private lemma upperPoint_strictMono : StrictMono upperPoint := by
  intro x y hxy
  -- Move from `upperPoint x` to `upperPoint y` through the lower copy at `y`.
  exact lt_trans (upperPoint_lt_lowerPoint hxy) (lowerPoint_lt_upperPoint y)

/-- Helper for Exercise 15.1.7: the upper-copy witness set is exactly the range of the upper-copy
embedding. -/
private lemma upperCopy_eq_range_upperPoint :
    (upperCopy : Set splitInterval) = Set.range upperPoint := by
  ext z
  constructor
  · intro hz
    -- A point on the upper copy is the upper point of its first coordinate.
    refine ⟨splitCoord z, ?_⟩
    apply Subtype.ext
    cases hBool : (ofLex z.1).2 with
    | false =>
        simp [upperCopy, hBool] at hz
    | true =>
        change toLex ((splitCoord z).1, true) = z.1
        rw [show z.1 = toLex ((ofLex z.1).1, (ofLex z.1).2) by simp, hBool]
        rfl
  · rintro ⟨x, rfl⟩
    -- Every image point of `upperPoint` lies in the upper copy by definition.
    exact upperPoint_mem_upperCopy x

/-- Helper for Exercise 15.1.7: the lower-copy map is monotone in the split parameter. -/
private lemma lowerPoint_monotone : Monotone lowerPoint := by
  intro x y hxy
  -- Preserving the first coordinate order preserves the lexicographic order on the lower copy.
  change toLex (x.1, false) ≤ toLex (y.1, false)
  rw [Prod.Lex.toLex_le_toLex']
  refine ⟨hxy, ?_⟩
  intro _
  simp

/-- Helper for Exercise 15.1.7: the complement of the upper copy is exactly the range of the
lower-copy embedding. -/
private lemma lowerCopy_eq_range_lowerPoint :
    ((upperCopy : Set splitInterval)ᶜ : Set splitInterval) = Set.range lowerPoint := by
  ext z
  constructor
  · intro hz
    -- A point off the upper copy must lie on the lower copy at its split coordinate.
    refine ⟨splitCoord z, ?_⟩
    apply Subtype.ext
    cases hBool : (ofLex z.1).2 with
    | false =>
        change toLex ((splitCoord z).1, false) = z.1
        rw [show z.1 = toLex ((ofLex z.1).1, (ofLex z.1).2) by simp, hBool]
        rfl
    | true =>
        simp [upperCopy, hBool] at hz
  · rintro ⟨x, rfl⟩
    -- Lower points are excluded from the upper copy by definition.
    exact lowerPoint_not_mem_upperCopy x

/-- Helper for Exercise 15.1.7: the lower-copy embedding identifies `[0, 1]` with its range in the
split interval. -/
private def lowerPointRangeOrderIso : splitCoordinate ≃o Set.range lowerPoint where
  toFun := fun x ↦ ⟨lowerPoint x, ⟨x, rfl⟩⟩
  invFun := fun z ↦ splitCoord z.1
  left_inv := splitCoord_lowerPoint
  right_inv := by
    rintro ⟨z, x, rfl⟩
    simp [splitCoord_lowerPoint]
  map_rel_iff' := by
    intro x y
    constructor
    · intro h
      simpa [splitCoord_lowerPoint] using splitCoord_monotone h
    · intro h
      exact lowerPoint_monotone h

/-- Helper for Exercise 15.1.7: the upper-copy embedding identifies `[0, 1]` with its range in the
split interval. -/
private def upperPointRangeOrderIso : splitCoordinate ≃o Set.range upperPoint where
  toFun := fun x ↦ ⟨upperPoint x, ⟨x, rfl⟩⟩
  invFun := fun z ↦ splitCoord z.1
  left_inv := splitCoord_upperPoint
  right_inv := by
    rintro ⟨z, x, rfl⟩
    simp [splitCoord_upperPoint]
  map_rel_iff' := by
    intro x y
    constructor
    · intro h
      simpa [splitCoord_upperPoint] using splitCoord_monotone h
    · intro h
      exact upperPoint_strictMono.monotone h

/-- Helper for Exercise 15.1.7: strict first-coordinate inequality places a split point below a
lower copy. -/
private lemma splitInterval_lt_lowerPoint_of_first_lt {z : splitInterval} {x : splitCoordinate}
    (hzx : (ofLex z.1).1 < x.1) :
    z < lowerPoint x := by
  -- A strict inequality on the first coordinate already decides the lexicographic comparison.
  change z.1 < toLex (x.1, false)
  rw [show z.1 = toLex ((ofLex z.1).1, (ofLex z.1).2) by simp, Prod.Lex.toLex_lt_toLex']
  refine ⟨le_of_lt hzx, ?_⟩
  intro hEq
  exact False.elim (ne_of_lt hzx hEq)

/-- Helper for Exercise 15.1.7: a split point lies below a lower copy exactly when its first
coordinate is strictly smaller. -/
private lemma splitInterval_lt_lowerPoint_iff_first_lt {z : splitInterval} {x : splitCoordinate} :
    z < lowerPoint x ↔ (ofLex z.1).1 < x.1 := by
  constructor
  · intro hz
    -- Equality of first coordinates would force a Boolean contradiction in the lex order.
    change z.1 < toLex (x.1, false) at hz
    rw [show z.1 = toLex ((ofLex z.1).1, (ofLex z.1).2) by simp,
      Prod.Lex.toLex_lt_toLex'] at hz
    refine lt_of_le_of_ne hz.1 ?_
    intro hEq
    have : ¬ ((ofLex z.1).2 < false) := by simp
    exact False.elim (this (hz.2 hEq))
  · -- The converse is the direct lexicographic comparison.
    exact splitInterval_lt_lowerPoint_of_first_lt

/-- Helper for Exercise 15.1.7: strict first-coordinate inequality places a lower copy below a
split point. -/
private lemma lowerPoint_lt_splitInterval_of_first_lt {x : splitCoordinate} {z : splitInterval}
    (hxz : x.1 < (ofLex z.1).1) :
    lowerPoint x < z := by
  -- A strict increase in the first coordinate dominates the Boolean tie-breaker.
  change toLex (x.1, false) < z.1
  rw [show z.1 = toLex ((ofLex z.1).1, (ofLex z.1).2) by simp, Prod.Lex.toLex_lt_toLex']
  refine ⟨le_of_lt hxz, ?_⟩
  intro hEq
  exact False.elim (ne_of_lt hxz hEq)

/-- Helper for Exercise 15.1.7: an upper copy lies below a split point exactly when the first
coordinate strictly increases. -/
private lemma upperPoint_lt_splitInterval_iff_first_lt {x : splitCoordinate} {z : splitInterval} :
    upperPoint x < z ↔ x.1 < (ofLex z.1).1 := by
  constructor
  · intro hz
    -- The upper copy is already maximal among points with the same first coordinate.
    change toLex (x.1, true) < z.1 at hz
    rw [show z.1 = toLex ((ofLex z.1).1, (ofLex z.1).2) by simp,
      Prod.Lex.toLex_lt_toLex'] at hz
    refine lt_of_le_of_ne hz.1 ?_
    intro hEq
    have : ¬ (true < (ofLex z.1).2) := by simp
    exact False.elim (this (hz.2 hEq))
  · -- A strict increase in the first coordinate decides the lexicographic comparison.
    intro hxz
    change toLex (x.1, true) < z.1
    rw [show z.1 = toLex ((ofLex z.1).1, (ofLex z.1).2) by simp,
      Prod.Lex.toLex_lt_toLex']
    refine ⟨le_of_lt hxz, ?_⟩
    intro hEq
    exact False.elim (ne_of_lt hxz hEq)

/-- Helper for Exercise 15.1.7: the split-coordinate projection is continuous for the split-order
topology. -/
private lemma splitCoord_continuous : Continuous splitCoord := by
  -- The order-topology subbasis pulls back to the obvious rays cut out by the lower and upper
  -- copies at the same coordinate.
  rw [OrderTopology.continuous_iff]
  intro x
  constructor
  · have hpre : splitCoord ⁻¹' Set.Ioi x = Set.Ioi (upperPoint x) := by
      ext z
      constructor
      · intro hz
        rw [Set.mem_preimage, Set.mem_Ioi] at hz
        rw [Set.mem_Ioi]
        exact
          (upperPoint_lt_splitInterval_iff_first_lt :
            upperPoint x < z ↔ x.1 < (ofLex z.1).1).2 hz
      · intro hz
        rw [Set.mem_preimage, Set.mem_Ioi]
        exact
          (upperPoint_lt_splitInterval_iff_first_lt :
            upperPoint x < z ↔ x.1 < (ofLex z.1).1).1 hz
    rw [hpre]
    exact isOpen_Ioi
  · have hpre : splitCoord ⁻¹' Set.Iio x = Set.Iio (lowerPoint x) := by
      ext z
      constructor
      · intro hz
        rw [Set.mem_preimage, Set.mem_Iio] at hz
        rw [Set.mem_Iio]
        exact
          (splitInterval_lt_lowerPoint_iff_first_lt :
            z < lowerPoint x ↔ (ofLex z.1).1 < x.1).2 hz
      · intro hz
        rw [Set.mem_preimage, Set.mem_Iio]
        exact
          (splitInterval_lt_lowerPoint_iff_first_lt :
            z < lowerPoint x ↔ (ofLex z.1).1 < x.1).1 hz
    rw [hpre]
    exact isOpen_Iio

/-- Helper for Exercise 15.1.7: the upper-copy predicate is the same as lying above the lower copy
with the same first coordinate. -/
private lemma upperCopy_iff_lowerPoint_splitCoord_lt (z : splitInterval) :
    z ∈ upperCopy ↔ lowerPoint (splitCoord z) < z := by
  -- Route correction: the measurable proof works after rewriting `upperCopy` as a plain strict
  -- order predicate, rather than through a neighborhood-generation argument.
  cases hBool : (ofLex z.1).2 with
  | false =>
      have hzEq : z = lowerPoint (splitCoord z) := by
        -- On the lower copy, the split point agrees with its lower representative.
        apply Subtype.ext
        calc
          z.1 = toLex ((ofLex z.1).1, (ofLex z.1).2) := by simp
          _ = toLex ((ofLex z.1).1, false) := by rw [hBool]
          _ = (lowerPoint (splitCoord z)).1 := by simp [splitCoord, lowerPoint]
      constructor
      · intro hzUpper
        simp [upperCopy, hBool] at hzUpper
      · intro hzLt
        exact False.elim (hzLt.ne hzEq.symm)
  | true =>
      have hzEq : z = upperPoint (splitCoord z) := by
        -- On the upper copy, the split point agrees with its upper representative.
        apply Subtype.ext
        calc
          z.1 = toLex ((ofLex z.1).1, (ofLex z.1).2) := by simp
          _ = toLex ((ofLex z.1).1, true) := by rw [hBool]
          _ = (upperPoint (splitCoord z)).1 := by simp [splitCoord, upperPoint]
      constructor
      · intro _
        rw [hzEq]
        exact lowerPoint_lt_upperPoint (splitCoord z)
      · intro _
        simp [upperCopy, hBool]

/-- Helper for Exercise 15.1.7: a lower-copy point lies below `z` exactly when either its
coordinate is strictly smaller than the coordinate of `z`, or `z` is the matching upper copy. -/
private lemma lowerPoint_lt_splitInterval_iff_lt_or_eq_upperPoint
    {x : splitCoordinate} {z : splitInterval} :
    lowerPoint x < z ↔ x < splitCoord z ∨ z = upperPoint x := by
  cases hBool : (ofLex z.1).2 with
  | false =>
      have hzEq : z = lowerPoint (splitCoord z) := by
        -- On the lower copy, the split point agrees with its lower representative.
        apply Subtype.ext
        calc
          z.1 = toLex ((ofLex z.1).1, (ofLex z.1).2) := by simp
          _ = toLex ((ofLex z.1).1, false) := by rw [hBool]
          _ = (lowerPoint (splitCoord z)).1 := by simp [splitCoord, lowerPoint]
      constructor
      · intro hz
        -- Two lower-copy points are ordered exactly by their coordinates.
        have hxz : x.1 < (splitCoord z).1 :=
          (splitInterval_lt_lowerPoint_iff_first_lt :
            lowerPoint x < lowerPoint (splitCoord z) ↔
              (ofLex (lowerPoint x).1).1 < (splitCoord z).1).1
            (hzEq ▸ hz)
        left
        exact hxz
      · rintro (hxz | hzUpper)
        · exact lowerPoint_lt_splitInterval_of_first_lt hxz
        · have : ¬ z ∈ upperCopy := by simp [upperCopy, hBool]
          exact False.elim (this (hzUpper ▸ upperPoint_mem_upperCopy x))
  | true =>
      have hzEq : z = upperPoint (splitCoord z) := by
        -- On the upper copy, the split point agrees with its upper representative.
        apply Subtype.ext
        calc
          z.1 = toLex ((ofLex z.1).1, (ofLex z.1).2) := by simp
          _ = toLex ((ofLex z.1).1, true) := by rw [hBool]
          _ = (upperPoint (splitCoord z)).1 := by simp [splitCoord, upperPoint]
      constructor
      · intro hz
        have hxc : x ≤ splitCoord z := by
          by_contra hxc
          have hzx : z < lowerPoint x := by
            have hzx' : upperPoint (splitCoord z) < lowerPoint x :=
              upperPoint_lt_lowerPoint (lt_of_not_ge hxc)
            rw [hzEq]
            exact hzx'
          exact (not_le_of_gt hzx) hz.le
        rcases eq_or_lt_of_le hxc with hEq | hLt
        · right
          calc
            z = upperPoint (splitCoord z) := hzEq
            _ = upperPoint x := by simpa using congrArg upperPoint hEq.symm
        · left
          exact hLt
      · rintro (hxz | rfl)
        · exact lowerPoint_lt_splitInterval_of_first_lt hxz
        · exact lowerPoint_lt_upperPoint x

/-- Helper for Exercise 15.1.7: lower-copy points have no immediate predecessor in the split
interval. -/
private lemma lowerPoint_isSuccPrelimit (x : splitCoordinate) :
    Order.IsSuccPrelimit (lowerPoint x) := by
  -- Any point strictly below a lower copy can be separated from it by a higher upper copy.
  intro b hb
  have hbCoord : (ofLex b.1).1 < x.1 :=
    (splitInterval_lt_lowerPoint_iff_first_lt).1 hb.lt
  by_cases hx0 : x.1 = 0
  · -- At the left endpoint, the lower copy is the minimum point of the split interval.
    have hmin : IsMin (lowerPoint x) := by
      intro z hz
      change toLex (x.1, false) ≤ z.1
      rw [hx0, show z.1 = toLex ((ofLex z.1).1, (ofLex z.1).2) by simp,
        Prod.Lex.toLex_le_toLex']
      refine ⟨(splitInterval_first_mem_Icc z).1, ?_⟩
      intro hzEq
      simp
    exact (hmin.not_lt hb.lt).elim
  · obtain ⟨c, hbc, hcx⟩ := exists_between hbCoord
    have hcMem : c ∈ Set.Icc (0 : ℝ) 1 := by
      refine ⟨le_trans (splitInterval_first_mem_Icc b).1 (le_of_lt hbc),
        le_trans (le_of_lt hcx) x.2.2⟩
    let y : splitCoordinate := ⟨c, hcMem⟩
    have hbMid : b < upperPoint y := by
      have hbLower : b < lowerPoint y := splitInterval_lt_lowerPoint_of_first_lt hbc
      exact lt_trans hbLower (lowerPoint_lt_upperPoint y)
    have hMidx : upperPoint y < lowerPoint x := upperPoint_lt_lowerPoint hcx
    exact ((not_covBy_iff hb.lt).2 ⟨upperPoint y, hbMid, hMidx⟩) hb

/-- Helper for Exercise 15.1.7: the upper copy is exactly the set of points with an immediate
predecessor. -/
private lemma upperCopy_iff_not_isSuccPrelimit (z : splitInterval) :
    z ∈ upperCopy ↔ ¬ Order.IsSuccPrelimit z := by
  constructor
  · intro hz
    -- The lower and upper copies of the same coordinate form a cover pair.
    rw [Order.not_isSuccPrelimit_iff_exists_covBy]
    have hzEq : z = upperPoint (splitCoord z) := by
      cases hBool : (ofLex z.1).2 with
      | false =>
          simp [upperCopy, hBool] at hz
      | true =>
          apply Subtype.ext
          calc
            z.1 = toLex ((ofLex z.1).1, (ofLex z.1).2) := by simp
            _ = toLex ((ofLex z.1).1, true) := by rw [hBool]
            _ = (upperPoint (splitCoord z)).1 := by simp [splitCoord, upperPoint]
    refine ⟨lowerPoint (splitCoord z), ?_⟩
    rw [hzEq, splitCoord_upperPoint]
    exact lowerPoint_covBy_upperPoint (splitCoord z)
  · intro hz
    -- On the lower copy, the absence of a predecessor forces the Boolean coordinate to be `false`.
    cases hBool : (ofLex z.1).2 with
    | false =>
        have hzEq : z = lowerPoint (splitCoord z) := by
          apply Subtype.ext
          calc
            z.1 = toLex ((ofLex z.1).1, (ofLex z.1).2) := by simp
            _ = toLex ((ofLex z.1).1, false) := by rw [hBool]
            _ = (lowerPoint (splitCoord z)).1 := by simp [splitCoord, lowerPoint]
        have hpre : Order.IsSuccPrelimit z := by
          rw [hzEq]
          exact lowerPoint_isSuccPrelimit (splitCoord z)
        exact False.elim (hz hpre)
    | true =>
        simp [upperCopy, hBool]

/-- Helper for Exercise 15.1.7: upper-copy points have no immediate successor in the split
interval. -/
private lemma upperPoint_isPredPrelimit (x : splitCoordinate) :
    Order.IsPredPrelimit (upperPoint x) := by
  intro b hb
  by_cases hx1 : x.1 = 1
  · -- At the top endpoint, every split-interval point lies below `upperPoint x`.
    have hbTop : b ≤ upperPoint x := by
      change b.1 ≤ toLex (x.1, true)
      rw [hx1]
      simpa [upperPoint] using b.2.2
    exact (not_lt_of_ge hbTop hb.lt).elim
  · -- Away from the top endpoint, insert a lower point at an intermediate coordinate.
    have hbCoord : x.1 < (ofLex b.1).1 :=
      (upperPoint_lt_splitInterval_iff_first_lt).1 hb.lt
    obtain ⟨c, hxc, hcb⟩ := exists_between hbCoord
    have hcMem : c ∈ Set.Icc (0 : ℝ) 1 := by
      refine ⟨le_trans x.2.1 (le_of_lt hxc),
        le_trans (le_of_lt hcb) (splitInterval_first_mem_Icc b).2⟩
    let y : splitCoordinate := ⟨c, hcMem⟩
    have hMidLeft : upperPoint x < lowerPoint y := by
      simpa [y] using upperPoint_lt_lowerPoint hxc
    have hMidRight : lowerPoint y < b := lowerPoint_lt_splitInterval_of_first_lt hcb
    exact ((not_covBy_iff hb.lt).2 ⟨lowerPoint y, hMidLeft, hMidRight⟩) hb

/-- Helper for Exercise 15.1.7: the upper copy is exactly the set of points with no immediate
successor. -/
private lemma upperCopy_iff_isPredPrelimit (z : splitInterval) :
    z ∈ upperCopy ↔ Order.IsPredPrelimit z := by
  cases hBool : (ofLex z.1).2 with
  | false =>
      have hzEq : z = lowerPoint (splitCoord z) := by
        -- On the lower copy, the split point agrees with its lower representative.
        apply Subtype.ext
        calc
          z.1 = toLex ((ofLex z.1).1, (ofLex z.1).2) := by simp
          _ = toLex ((ofLex z.1).1, false) := by rw [hBool]
          _ = (lowerPoint (splitCoord z)).1 := by simp [splitCoord, lowerPoint]
      constructor
      · intro hz
        simp [upperCopy, hBool] at hz
      · intro hz
        have hsucc : z ⋖ upperPoint (splitCoord z) := by
          rw [hzEq]
          exact lowerPoint_covBy_upperPoint (splitCoord z)
        exact False.elim (hz _ hsucc)
  | true =>
      have hzEq : z = upperPoint (splitCoord z) := by
        -- On the upper copy, the split point agrees with its upper representative.
        apply Subtype.ext
        calc
          z.1 = toLex ((ofLex z.1).1, (ofLex z.1).2) := by simp
          _ = toLex ((ofLex z.1).1, true) := by rw [hBool]
          _ = (upperPoint (splitCoord z)).1 := by simp [splitCoord, upperPoint]
      constructor
      · intro _
        rw [hzEq]
        exact upperPoint_isPredPrelimit (splitCoord z)
      · intro _
        simp [upperCopy, hBool]

/-- Helper for Exercise 15.1.7: a point lies in the upper copy exactly when its matching lower
copy covers it. -/
private lemma upperCopy_iff_lowerPoint_splitCoord_covBy (z : splitInterval) :
    z ∈ upperCopy ↔ lowerPoint (splitCoord z) ⋖ z := by
  cases hBool : (ofLex z.1).2 with
  | false =>
      have hzEq : z = lowerPoint (splitCoord z) := by
        -- On the lower copy, the split point agrees with its lower representative.
        apply Subtype.ext
        calc
          z.1 = toLex ((ofLex z.1).1, (ofLex z.1).2) := by simp
          _ = toLex ((ofLex z.1).1, false) := by rw [hBool]
          _ = (lowerPoint (splitCoord z)).1 := by simp [splitCoord, lowerPoint]
      constructor
      · intro hz
        simp [upperCopy, hBool] at hz
      · intro hz
        have hzSelf : lowerPoint (splitCoord z) = z := hzEq.symm
        have : ¬ lowerPoint (splitCoord z) < z := by
          rw [hzSelf]
          exact lt_irrefl z
        exact False.elim (this hz.lt)
  | true =>
      have hzEq : z = upperPoint (splitCoord z) := by
        -- On the upper copy, the split point agrees with its upper representative.
        apply Subtype.ext
        calc
          z.1 = toLex ((ofLex z.1).1, (ofLex z.1).2) := by simp
          _ = toLex ((ofLex z.1).1, true) := by rw [hBool]
          _ = (upperPoint (splitCoord z)).1 := by simp [splitCoord, upperPoint]
      constructor
      · intro _
        rw [hzEq, splitCoord_upperPoint]
        exact lowerPoint_covBy_upperPoint (splitCoord z)
      · intro _
        simp [upperCopy, hBool]

/-- Helper for Exercise 15.1.7: the preimage of a lower ray under `upperPoint` only depends on the
first coordinate. -/
private lemma preimage_Iio_upperPoint (z : splitInterval) :
    upperPoint ⁻¹' Set.Iio z = Set.Iio (splitCoord z) := by
  -- Comparing an upper copy with `z` reduces to comparing the first coordinates.
  ext x
  change upperPoint x < z ↔ x < splitCoord z
  rw [upperPoint_lt_splitInterval_iff_first_lt]
  rfl

/-- Helper for Exercise 15.1.7: the preimage of an upper ray under `upperPoint` is an order
interval on the coordinate copy. -/
private lemma preimage_Ioi_upperPoint (z : splitInterval) :
    upperPoint ⁻¹' Set.Ioi z =
      if (ofLex z.1).2 then Set.Ioi (splitCoord z) else Set.Ici (splitCoord z) := by
  cases hBool : (ofLex z.1).2 with
  | false =>
      have hzEq : z = lowerPoint (splitCoord z) := by
        -- On the lower copy, the split point agrees with its lower representative.
        apply Subtype.ext
        calc
          z.1 = toLex ((ofLex z.1).1, (ofLex z.1).2) := by simp
          _ = toLex ((ofLex z.1).1, false) := by rw [hBool]
          _ = (lowerPoint (splitCoord z)).1 := by simp [splitCoord, lowerPoint]
      ext x
      change z < upperPoint x ↔ splitCoord z ≤ x
      rw [hzEq]
      constructor
      · intro hx
        by_contra hzx
        have hxz : x < splitCoord z := lt_of_not_ge hzx
        exact (upperPoint_lt_lowerPoint hxz).not_ge hx.le
      · intro hx
        rcases eq_or_lt_of_le hx with rfl | hxz
        · exact lowerPoint_lt_upperPoint (splitCoord z)
        · exact lowerPoint_lt_splitInterval_of_first_lt hxz
  | true =>
      have hzEq : z = upperPoint (splitCoord z) := by
        -- On the upper copy, the split point agrees with its upper representative.
        apply Subtype.ext
        calc
          z.1 = toLex ((ofLex z.1).1, (ofLex z.1).2) := by simp
          _ = toLex ((ofLex z.1).1, true) := by rw [hBool]
          _ = (upperPoint (splitCoord z)).1 := by simp [splitCoord, upperPoint]
      ext x
      change z < upperPoint x ↔ splitCoord z < x
      rw [hzEq]
      exact upperPoint_strictMono.lt_iff_lt

/-- Helper for Exercise 15.1.7: lower rays in `splitInterval` pull back to Borel sets under the
upper-copy section. -/
private lemma preimage_Iio_upperPoint_measurableSet (z : splitInterval) :
    MeasurableSet (upperPoint ⁻¹' Set.Iio z) := by
  -- The explicit interval formula reduces the preimage to a lower ray in `[0, 1]`.
  rw [preimage_Iio_upperPoint]
  exact (isOpen_Iio : IsOpen (Set.Iio (splitCoord z))).measurableSet

/-- Helper for Exercise 15.1.7: upper rays in `splitInterval` pull back to Borel sets under the
upper-copy section. -/
private lemma preimage_Ioi_upperPoint_measurableSet (z : splitInterval) :
    MeasurableSet (upperPoint ⁻¹' Set.Ioi z) := by
  -- The explicit interval formula leaves either an open or a closed upper ray in `[0, 1]`.
  rw [preimage_Ioi_upperPoint]
  split_ifs with hBool
  · exact (isOpen_Ioi : IsOpen (Set.Ioi (splitCoord z))).measurableSet
  · exact (isClosed_Ici : IsClosed (Set.Ici (splitCoord z))).measurableSet

/-- Helper for Exercise 15.1.7: every lower-copy point has a right neighborhood contained in the
lower copy, witnessed by its matching upper copy. -/
private lemma lowerCopy_mem_nhdsGT
    {z : splitInterval} (hz : z ∈ (upperCopy : Set splitInterval)ᶜ) :
    ((upperCopy : Set splitInterval)ᶜ) ∈ nhdsWithin z (Set.Ioi z) := by
  rw [lowerCopy_eq_range_lowerPoint] at hz ⊢
  rcases hz with ⟨x, rfl⟩
  -- The cover pair `lowerPoint x ⋖ upperPoint x` makes the intervening open interval empty.
  refine (mem_nhdsGT_iff_exists_Ioo_subset' (lowerPoint_lt_upperPoint x)).2
    ⟨upperPoint x, lowerPoint_lt_upperPoint x, ?_⟩
  simp [(lowerPoint_covBy_upperPoint x).Ioo_eq]

/-- Helper for Exercise 15.1.7: the rational split parameters in `[0,1]`. -/
private abbrev splitRationalCoordinate : Type :=
  {q : ℚ // (0 : ℝ) ≤ q ∧ (q : ℝ) ≤ 1}

/-- Helper for Exercise 15.1.7: the countable dense family of lower rational points together with
the isolated top endpoint of the split interval. -/
private def lowerRationalOrTop : Option splitRationalCoordinate → splitInterval
  | none => upperPoint ⟨1, by simp⟩
  | some q => lowerPoint ⟨(q : ℝ), q.2⟩

/-- Helper for Exercise 15.1.7: the lower rational points alone miss the isolated top endpoint, so
the dense range must include that endpoint explicitly. -/
private lemma denseRange_lowerRationalOrTop : DenseRange lowerRationalOrTop := by
  rw [DenseRange, dense_iff_inter_open]
  intro U hU hU_nonempty
  let topCoord : splitCoordinate := ⟨1, by simp⟩
  by_cases hTop : upperPoint topCoord ∈ U
  · -- If the isolated top point already lies in the open set, the added endpoint closes the case.
    refine ⟨upperPoint topCoord, hTop, ?_⟩
    exact ⟨none, rfl⟩
  obtain ⟨z, hzU⟩ := hU_nonempty
  have hzNeTop : z ≠ upperPoint topCoord := by
    intro hzEq
    exact hTop (hzEq ▸ hzU)
  let x : splitCoordinate := splitCoord z
  cases hBool : (ofLex z.1).2 with
  | false =>
      have hzEq : z = lowerPoint x := by
        -- On the lower copy, the split point is exactly the lower point of its coordinate.
        apply Subtype.ext
        calc
          z.1 = toLex ((ofLex z.1).1, (ofLex z.1).2) := by simp
          _ = toLex ((ofLex z.1).1, false) := by rw [hBool]
          _ = (lowerPoint x).1 := by simp [x, splitCoord, lowerPoint]
      by_cases hx0 : x.1 = 0
      · -- The isolated minimum point is itself a rational lower point.
        refine ⟨lowerPoint ⟨0, by simp⟩, ?_, ?_⟩
        · have hz0 : z = lowerPoint ⟨0, by simp⟩ := by
            have hx : x = ⟨0, by simp⟩ := by
              apply Subtype.ext
              exact hx0
            simpa [hx] using hzEq
          exact hz0 ▸ hzU
        · refine ⟨some ⟨0, by simp⟩, ?_⟩
          simp [lowerRationalOrTop]
      · have h0x : 0 < x.1 := lt_of_le_of_ne x.2.1 (Ne.symm hx0)
        obtain ⟨w, hw0, hwx⟩ := exists_between h0x
        let l0 : splitCoordinate := ⟨w, ⟨le_of_lt hw0, le_trans (le_of_lt hwx) x.2.2⟩⟩
        have hl0 : upperPoint l0 < z := by
          -- Moving to a strictly smaller split coordinate places its upper copy below `z`.
          have hlx : l0 < x := hwx
          simpa [hzEq] using upperPoint_lt_lowerPoint hlx
        have hu0 : z < upperPoint x := by
          -- The matching upper copy lies strictly above the lower copy at the same coordinate.
          simpa [hzEq] using lowerPoint_lt_upperPoint x
        rcases (mem_nhds_iff_exists_Ioo_subset'
            ⟨upperPoint l0, hl0⟩ ⟨upperPoint x, hu0⟩).1 (hU.mem_nhds hzU) with
          ⟨l, u, hzIoo, hIooSub⟩
        have hlx : (ofLex l.1).1 < x.1 :=
          (splitInterval_lt_lowerPoint_iff_first_lt).1 (by simpa [hzEq] using hzIoo.1)
        obtain ⟨q, hql, hqx⟩ := exists_rat_btwn hlx
        have hlNonneg : 0 ≤ (ofLex l.1).1 := (splitInterval_first_mem_Icc l).1
        let qr : splitRationalCoordinate := ⟨q, by
          refine ⟨?_, ?_⟩ <;> linarith [x.2.2]⟩
        have hlq : l < lowerPoint ⟨(q : ℝ), qr.2⟩ :=
          splitInterval_lt_lowerPoint_of_first_lt hql
        have hqz : lowerPoint ⟨(q : ℝ), qr.2⟩ < z := by
          -- The chosen rational lower point still lies below the target lower copy.
          have hqxx : (⟨(q : ℝ), qr.2⟩ : splitCoordinate) < x := hqx
          exact lt_trans (lowerPoint_lt_upperPoint _) <|
            by simpa [hzEq] using upperPoint_lt_lowerPoint hqxx
        refine ⟨lowerPoint ⟨(q : ℝ), qr.2⟩, hIooSub ⟨hlq, lt_trans hqz hzIoo.2⟩, ?_⟩
        refine ⟨some qr, ?_⟩
        simp [qr, lowerRationalOrTop]
  | true =>
      have hzEq : z = upperPoint x := by
        -- On the upper copy, the split point is exactly the upper point of its coordinate.
        apply Subtype.ext
        calc
          z.1 = toLex ((ofLex z.1).1, (ofLex z.1).2) := by simp
          _ = toLex ((ofLex z.1).1, true) := by rw [hBool]
          _ = (upperPoint x).1 := by simp [x, splitCoord, upperPoint]
      have hx1 : x.1 < 1 := by
        -- The only upper point with first coordinate `1` is the isolated top endpoint excluded
        -- above.
        refine lt_of_le_of_ne x.2.2 ?_
        intro hxEq
        apply hzNeTop
        apply Subtype.ext
        calc
          z.1 = (upperPoint x).1 := by simp [hzEq]
          _ = toLex (x.1, true) := by simp [upperPoint]
          _ = toLex (1, true) := by rw [hxEq]
          _ = (upperPoint topCoord).1 := by simp [topCoord, upperPoint]
      obtain ⟨w, hxw, hw1⟩ := exists_between hx1
      let u0 : splitCoordinate := ⟨w, ⟨le_trans x.2.1 (le_of_lt hxw), le_of_lt hw1⟩⟩
      have hl0 : lowerPoint x < z := by
        -- The matching lower copy lies strictly below the upper copy at the same coordinate.
        simpa [hzEq] using lowerPoint_lt_upperPoint x
      have hu0 : z < lowerPoint u0 := by
        -- A strictly larger split coordinate moves the lower copy strictly above `z`.
        have hxu : x < u0 := hxw
        simpa [hzEq] using upperPoint_lt_lowerPoint hxu
      rcases (mem_nhds_iff_exists_Ioo_subset'
          ⟨lowerPoint x, hl0⟩ ⟨lowerPoint u0, hu0⟩).1 (hU.mem_nhds hzU) with
        ⟨l, u, hzIoo, hIooSub⟩
      have hxu : x.1 < (ofLex u.1).1 :=
        (upperPoint_lt_splitInterval_iff_first_lt).1 (by simpa [hzEq] using hzIoo.2)
      obtain ⟨q, hxq, hqu⟩ := exists_rat_btwn hxu
      have huLeOne : (ofLex u.1).1 ≤ 1 := (splitInterval_first_mem_Icc u).2
      let qr : splitRationalCoordinate := ⟨q, by
        refine ⟨?_, ?_⟩ <;> linarith [x.2.1, huLeOne]⟩
      have hzq : z < lowerPoint ⟨(q : ℝ), qr.2⟩ := by
        -- Moving to a strictly larger split coordinate puts its lower copy above `z`.
        have hxqq : x < (⟨(q : ℝ), qr.2⟩ : splitCoordinate) := hxq
        simpa [hzEq] using upperPoint_lt_lowerPoint hxqq
      have hqu' : lowerPoint ⟨(q : ℝ), qr.2⟩ < u :=
        lowerPoint_lt_splitInterval_of_first_lt hqu
      refine ⟨lowerPoint ⟨(q : ℝ), qr.2⟩, hIooSub ⟨lt_trans hzIoo.1 hzq, hqu'⟩, ?_⟩
      refine ⟨some qr, ?_⟩
      simp [qr, lowerRationalOrTop]

/-- Helper for Exercise 15.1.7: the split interval witness is separable. -/
private instance splitInterval_separable : SeparableSpace splitInterval :=
  SeparableSpace.of_denseRange lowerRationalOrTop denseRange_lowerRationalOrTop

/-- Helper for Exercise 15.1.7: a split point lies on the upper sheet exactly when it differs from
its matching lower copy. -/
private lemma upperCopy_iff_lowerPoint_splitCoord_ne (z : splitInterval) :
    z ∈ upperCopy ↔ lowerPoint (splitCoord z) ≠ z := by
  cases hBool : (ofLex z.1).2 with
  | false =>
      have hzEq : z = lowerPoint (splitCoord z) := by
        -- On the lower copy, the split point agrees with its lower representative.
        apply Subtype.ext
        calc
          z.1 = toLex ((ofLex z.1).1, (ofLex z.1).2) := by simp
          _ = toLex ((ofLex z.1).1, false) := by rw [hBool]
          _ = (lowerPoint (splitCoord z)).1 := by simp [splitCoord, lowerPoint]
      constructor
      · intro hz
        simp [upperCopy, hBool] at hz
      · intro hzNe
        exact False.elim (hzNe hzEq.symm)
  | true =>
      have hzEq : z = upperPoint (splitCoord z) := by
        -- On the upper copy, the split point agrees with its upper representative.
        apply Subtype.ext
        calc
          z.1 = toLex ((ofLex z.1).1, (ofLex z.1).2) := by simp
          _ = toLex ((ofLex z.1).1, true) := by rw [hBool]
          _ = (upperPoint (splitCoord z)).1 := by simp [splitCoord, upperPoint]
      constructor
      · intro _ hzLower
        -- The lower and upper representatives at the same coordinate are distinct.
        have hzLt : lowerPoint (splitCoord z) < z := by
          rw [hzEq]
          exact lowerPoint_lt_upperPoint (splitCoord z)
        exact hzLt.ne hzLower
      · intro _
        simp [upperCopy, hBool]

/-- Helper for Exercise 15.1.7: the upper copy is exactly the strict part of the comparison
between a point and the matching lower copy at its coordinate. -/
private lemma upperCopy_iff_not_le_lowerPoint_splitCoord (z : splitInterval) :
    z ∈ upperCopy ↔ ¬ z ≤ lowerPoint (splitCoord z) := by
  -- Re-express the upper-sheet predicate using `not_le` so the remaining blocker is purely about
  -- measurability of an order relation.
  simpa [not_le] using upperCopy_iff_lowerPoint_splitCoord_lt z

/-- Helper for Exercise 15.1.7: pairs with the same split coordinate form a closed subset of the
product split interval. -/
private lemma isClosed_sameSplitCoord :
    IsClosed {p : splitInterval × splitInterval | splitCoord p.1 = splitCoord p.2} := by
  -- Equality of the continuous split-coordinate projection is closed in the Hausdorff coordinate
  -- interval.
  exact
    isClosed_eq (splitCoord_continuous.comp continuous_fst)
      (splitCoord_continuous.comp continuous_snd)

/-- Helper for Exercise 15.1.7: the strict same-coordinate relation is Borel in the product split
interval. -/
private lemma splitPairRelation_measurableSet :
    MeasurableSet[borel (splitInterval × splitInterval)]
      {p : splitInterval × splitInterval | splitCoord p.1 = splitCoord p.2 ∧ p.1 < p.2} := by
  -- This isolates the real blocker: the witness copies are coordinate projections of a Borel
  -- relation whose sections are singletons.
  have hSame :
      MeasurableSet[borel (splitInterval × splitInterval)]
        {p : splitInterval × splitInterval | splitCoord p.1 = splitCoord p.2} := by
    -- Closed sets are Borel after passing through the explicit `borel` measurable structure.
    simpa using
      (MeasurableSpace.measurableSet_generateFrom isClosed_sameSplitCoord.isOpen_compl).compl
  have hLt :
      MeasurableSet[borel (splitInterval × splitInterval)]
        {p : splitInterval × splitInterval | p.1 < p.2} := by
    -- The strict order relation is open in the product order topology, hence Borel.
    exact MeasurableSpace.measurableSet_generateFrom (isOpen_lt continuous_fst continuous_snd)
  exact hSame.inter hLt

/-- Helper for Exercise 15.1.7: the preimage of a lower ray under `lowerPoint` is an interval in
`[0,1]`, with the endpoint included exactly on the upper copy. -/
private lemma preimage_Iio_lowerPoint (z : splitInterval) :
    lowerPoint ⁻¹' Set.Iio z =
      if (ofLex z.1).2 then Set.Iic (splitCoord z) else Set.Iio (splitCoord z) := by
  cases hBool : (ofLex z.1).2 with
  | false =>
      ext x
      constructor
      · intro hx
        rcases
            (lowerPoint_lt_splitInterval_iff_lt_or_eq_upperPoint :
              lowerPoint x < z ↔ x < splitCoord z ∨ z = upperPoint x).1 hx with
          hlt | hzUpper
        · simpa [hBool] using hlt
        · have : z ∈ upperCopy := hzUpper.symm ▸ upperPoint_mem_upperCopy x
          simp [upperCopy, hBool] at this
      · intro hx
        have hlt : x < splitCoord z := by
          simpa [hBool] using hx
        exact
          (lowerPoint_lt_splitInterval_iff_lt_or_eq_upperPoint :
            lowerPoint x < z ↔ x < splitCoord z ∨ z = upperPoint x).2 (Or.inl hlt)
  | true =>
      have hzEq : z = upperPoint (splitCoord z) := by
        -- On the upper copy, the split point agrees with its upper representative.
        apply Subtype.ext
        calc
          z.1 = toLex ((ofLex z.1).1, (ofLex z.1).2) := by simp
          _ = toLex ((ofLex z.1).1, true) := by rw [hBool]
          _ = (upperPoint (splitCoord z)).1 := by simp [splitCoord, upperPoint]
      ext x
      constructor
      · intro hx
        rcases
            (lowerPoint_lt_splitInterval_iff_lt_or_eq_upperPoint :
              lowerPoint x < z ↔ x < splitCoord z ∨ z = upperPoint x).1 hx with
          hlt | hzUpper
        · exact le_of_lt hlt
        · have hEq : splitCoord z = x := by
            simpa [splitCoord_upperPoint] using congrArg splitCoord hzUpper
          simp [hEq.symm]
      · intro hx
        have hx' : x ≤ splitCoord z := by
          simpa [hBool] using hx
        rcases eq_or_lt_of_le hx' with hEq | hlt
        · have hzUpper : z = upperPoint x := by
            calc
              z = upperPoint (splitCoord z) := hzEq
              _ = upperPoint x := by simpa using congrArg upperPoint hEq.symm
          exact
            (lowerPoint_lt_splitInterval_iff_lt_or_eq_upperPoint :
              lowerPoint x < z ↔ x < splitCoord z ∨ z = upperPoint x).2
              (Or.inr hzUpper)
        · exact
            (lowerPoint_lt_splitInterval_iff_lt_or_eq_upperPoint :
              lowerPoint x < z ↔ x < splitCoord z ∨ z = upperPoint x).2 (Or.inl hlt)

/-- Helper for Exercise 15.1.7: upper rays pull back to upper rays under the lower-copy section. -/
private lemma preimage_Ioi_lowerPoint (z : splitInterval) :
    lowerPoint ⁻¹' Set.Ioi z = Set.Ioi (splitCoord z) := by
  -- A split point lies below a lower copy exactly when the first coordinate strictly increases.
  ext x
  change z < lowerPoint x ↔ splitCoord z < x
  simpa [splitCoord] using
    (splitInterval_lt_lowerPoint_iff_first_lt : z < lowerPoint x ↔ (ofLex z.1).1 < x.1)

/-- Helper for Exercise 15.1.7: lower rays in `splitInterval` pull back to Borel sets under the
lower-copy section. -/
private lemma preimage_Iio_lowerPoint_measurableSet (z : splitInterval) :
    MeasurableSet (lowerPoint ⁻¹' Set.Iio z) := by
  -- The explicit interval formula leaves either an open or a closed lower ray in `[0,1]`.
  rw [preimage_Iio_lowerPoint]
  split_ifs with hBool
  · exact (isClosed_Iic : IsClosed (Set.Iic (splitCoord z))).measurableSet
  · exact (isOpen_Iio : IsOpen (Set.Iio (splitCoord z))).measurableSet

/-- Helper for Exercise 15.1.7: upper rays in `splitInterval` pull back to Borel sets under the
lower-copy section. -/
private lemma preimage_Ioi_lowerPoint_measurableSet (z : splitInterval) :
    MeasurableSet (lowerPoint ⁻¹' Set.Ioi z) := by
  -- The pullback is exactly an open upper ray in the split-coordinate interval.
  rw [preimage_Ioi_lowerPoint]
  exact (isOpen_Ioi : IsOpen (Set.Ioi (splitCoord z))).measurableSet

/-- Helper for Exercise 15.1.7: a split point lies on the upper sheet exactly when rebuilding it
from its split coordinate via `upperPoint` gives the point back. -/
private lemma upperCopy_iff_upperPoint_splitCoord_eq (z : splitInterval) :
    z ∈ upperCopy ↔ upperPoint (splitCoord z) = z := by
  constructor
  · intro hz
    have hzRange : z ∈ Set.range upperPoint := by
      simpa [upperCopy_eq_range_upperPoint] using hz
    rcases hzRange with ⟨x, rfl⟩
    -- Points on the upper sheet are exactly the image of `upperPoint`.
    simp [splitCoord_upperPoint]
  · intro hz
    -- The fixed-point identity gives an explicit witness in the range characterization.
    have hRange : z ∈ Set.range upperPoint := ⟨splitCoord z, hz⟩
    simpa [upperCopy_eq_range_upperPoint] using hRange

/-- Helper for Exercise 15.1.7: approaching a split coordinate from the right along the lower copy
converges to the corresponding upper point. -/
private lemma lowerPoint_tendsto_upperPoint_right (x : splitCoordinate) :
    Filter.Tendsto lowerPoint (nhdsWithin x (Set.Ioi x)) (nhds (upperPoint x)) := by
  -- Use the order-topology characterization of convergence to control both sides of `upperPoint x`.
  refine tendsto_order.2 ⟨?_, ?_⟩
  · intro a ha
    filter_upwards [self_mem_nhdsWithin] with y hy
    exact lt_trans ha (upperPoint_lt_lowerPoint hy)
  · intro b hb
    have hbCoordMem : (ofLex b.1).1 ∈ Set.Icc (0 : ℝ) 1 := splitInterval_first_mem_Icc b
    have hbCoordGt : x.1 < (ofLex b.1).1 := by
      have hb' : toLex (x.1, true) < toLex ((ofLex b.1).1, (ofLex b.1).2) := by
        simpa [upperPoint] using hb
      rw [Prod.Lex.toLex_lt_toLex'] at hb'
      refine lt_of_le_of_ne hb'.1 ?_
      intro hEq
      cases hBool : (ofLex b.1).2 with
      | false =>
          have hImpossible : true < false := by
            simpa [hBool] using hb'.2 hEq
          cases hImpossible
      | true =>
          simpa [hBool] using hb'.2 hEq
    obtain ⟨uCoord, hxu, huB⟩ := exists_between hbCoordGt
    have hu0 : 0 ≤ uCoord := by
      linarith [x.2.1, hxu]
    have hu1 : uCoord ≤ 1 := by
      linarith [hbCoordMem.2, huB]
    let u : splitCoordinate := ⟨uCoord, ⟨hu0, hu1⟩⟩
    have hxu' : x < u := hxu
    have huB' : u < ⟨(ofLex b.1).1, hbCoordMem⟩ := huB
    refine (mem_nhdsGT_iff_exists_Ioo_subset' hxu').2 ⟨u, hxu', ?_⟩
    intro y hy
    have hyCoord : y.1 < (ofLex b.1).1 := lt_trans hy.2 huB
    have hyb : toLex (y.1, false) < toLex ((ofLex b.1).1, (ofLex b.1).2) := by
      rw [Prod.Lex.toLex_lt_toLex']
      refine ⟨le_of_lt hyCoord, ?_⟩
      intro hEq
      exact False.elim (ne_of_lt hyCoord hEq)
    simpa [lowerPoint] using hyb

/-- Helper for Exercise 15.1.7: the coordinate interval `[0, 1]` is uncountable. -/
private lemma splitCoordinate_not_countable :
    ¬ (Set.univ : Set splitCoordinate).Countable := by
  intro hCoordCount
  have hRangeCount : (Set.range (fun x : splitCoordinate ↦ x.1)).Countable := by
    simpa [Set.image_univ] using hCoordCount.image (fun x : splitCoordinate ↦ x.1)
  have hRangeEq : Set.range (fun x : splitCoordinate ↦ x.1) = Set.Icc (0 : ℝ) 1 := by
    ext r
    constructor
    · rintro ⟨x, rfl⟩
      exact x.2
    · intro hr
      exact ⟨⟨r, hr⟩, rfl⟩
  have hIccCount : (Set.Icc (0 : ℝ) 1 : Set ℝ).Countable := by
    rw [← hRangeEq]
    exact hRangeCount
  have hle : Cardinal.mk (Set.Icc (0 : ℝ) 1) ≤ Cardinal.aleph0 := by
    rwa [Cardinal.le_aleph0_iff_set_countable]
  have hlt : Cardinal.aleph0 < Cardinal.mk (Set.Icc (0 : ℝ) 1) := by
    rw [Cardinal.mk_Icc_real (by norm_num)]
    exact Cardinal.aleph0_lt_continuum
  exact not_le_of_gt hlt hle

/-- Helper for Exercise 15.1.7: a bounded continuous function can split only countably many lower
and upper copies. -/
private lemma countableSplitCoordinates_ofBoundedContinuous
    (f : splitInterval →ᵇ ℝ) :
    {x : splitCoordinate | f (lowerPoint x) ≠ f (upperPoint x)}.Countable := by
  let g : splitCoordinate → ℝ := fun x ↦ f (lowerPoint x)
  let topCoord : splitCoordinate := ⟨1, by simp⟩
  let Q : Type := {q : ℚ // (0 : ℝ) ≤ q ∧ (q : ℝ) ≤ 1}
  let qCoord : Q → splitCoordinate := fun q ↦ ⟨(q : ℝ), q.2⟩
  let upperWitness : Q → Set splitCoordinate := fun q ↦
    {x ∈ Set.Iic (qCoord q) | ∃ z, g x < z ∧
      ∀ y ∈ Set.Iic (qCoord q), x < y → z ≤ g y}
  let lowerWitness : Q → Set splitCoordinate := fun q ↦
    {x ∈ Set.Iic (qCoord q) | ∃ z, z < g x ∧
      ∀ y ∈ Set.Iic (qCoord q), x < y → g y ≤ z}
  have hUpperWitnessCountable : ∀ q : Q, (upperWitness q).Countable := by
    intro q
    simpa [upperWitness] using
      countable_image_lt_image_Ioi_within (Set.Iic (qCoord q)) g
  have hLowerWitnessCountable : ∀ q : Q, (lowerWitness q).Countable := by
    intro q
    simpa [lowerWitness] using
      countable_image_gt_image_Ioi_within (Set.Iic (qCoord q)) g
  have hUpperUnion : (⋃ q : Q, upperWitness q).Countable := by
    simpa [upperWitness] using
      (Set.to_countable (Set.univ : Set Q)).biUnion (fun q _ ↦ hUpperWitnessCountable q)
  have hLowerUnion : (⋃ q : Q, lowerWitness q).Countable := by
    simpa [lowerWitness] using
      (Set.to_countable (Set.univ : Set Q)).biUnion (fun q _ ↦ hLowerWitnessCountable q)
  have hJumpUp :
      {x : splitCoordinate | f (lowerPoint x) < f (upperPoint x)}.Countable := by
    refine (hUpperUnion.union (Set.countable_singleton topCoord)).mono ?_
    intro x hx
    by_cases hxtop : x = topCoord
    · exact Or.inr (by simp [hxtop])
    · left
      have hxTop : x < topCoord := lt_of_le_of_ne x.2.2 (by simpa using hxtop)
      let z : ℝ := (f (lowerPoint x) + f (upperPoint x)) / 2
      have hx' : g x < f (upperPoint x) := by
        simpa [g] using hx
      have hzx : g x < z := by
        dsimp [g, z]
        linarith
      have hzUpper : z < f (upperPoint x) := by
        dsimp [z]
        linarith
      have hUpperContinuousAt : ContinuousAt f (upperPoint x) := f.continuous.continuousAt
      have hT : Filter.Tendsto g (nhdsWithin x (Set.Ioi x)) (nhds (f (upperPoint x))) := by
        simpa [g] using
          hUpperContinuousAt.tendsto.comp (lowerPoint_tendsto_upperPoint_right x)
      have hEventually : {y : splitCoordinate | z < g y} ∈ nhdsWithin x (Set.Ioi x) :=
        (tendsto_order.1 hT).1 z hzUpper
      obtain ⟨u, hxu, huz⟩ :=
        (mem_nhdsGT_iff_exists_Ioo_subset' hxTop).1 hEventually
      have hxu' : x < u := hxu
      have hxuReal : x.1 < u.1 := hxu'
      obtain ⟨q, hqx, hqu⟩ := exists_rat_btwn hxuReal
      let qr : Q := ⟨q, by
        refine ⟨?_, ?_⟩
        · linarith [x.2.1, hqx]
        · linarith [u.2.2, hqu]⟩
      exact Set.mem_iUnion.2 ⟨qr, by
        refine ⟨show x ∈ Set.Iic (qCoord qr) by exact le_of_lt hqx, z, hzx, ?_⟩
        intro y hyIic hyx
        have hyu : y < u := lt_of_le_of_lt hyIic hqu
        exact le_of_lt (huz ⟨hyx, hyu⟩)⟩
  have hJumpDown :
      {x : splitCoordinate | f (upperPoint x) < f (lowerPoint x)}.Countable := by
    refine (hLowerUnion.union (Set.countable_singleton topCoord)).mono ?_
    intro x hx
    by_cases hxtop : x = topCoord
    · exact Or.inr (by simp [hxtop])
    · left
      have hxTop : x < topCoord := lt_of_le_of_ne x.2.2 (by simpa using hxtop)
      let z : ℝ := (f (lowerPoint x) + f (upperPoint x)) / 2
      have hx' : f (upperPoint x) < g x := by
        simpa [g] using hx
      have hzx : z < g x := by
        dsimp [g, z]
        linarith
      have hzUpper : f (upperPoint x) < z := by
        dsimp [z]
        linarith
      have hUpperContinuousAt : ContinuousAt f (upperPoint x) := f.continuous.continuousAt
      have hT : Filter.Tendsto g (nhdsWithin x (Set.Ioi x)) (nhds (f (upperPoint x))) := by
        simpa [g] using
          hUpperContinuousAt.tendsto.comp (lowerPoint_tendsto_upperPoint_right x)
      have hEventually : {y : splitCoordinate | g y < z} ∈ nhdsWithin x (Set.Ioi x) :=
        (tendsto_order.1 hT).2 z hzUpper
      obtain ⟨u, hxu, huz⟩ :=
        (mem_nhdsGT_iff_exists_Ioo_subset' hxTop).1 hEventually
      have hxu' : x < u := hxu
      have hxuReal : x.1 < u.1 := hxu'
      obtain ⟨q, hqx, hqu⟩ := exists_rat_btwn hxuReal
      let qr : Q := ⟨q, by
        refine ⟨?_, ?_⟩
        · linarith [x.2.1, hqx]
        · linarith [u.2.2, hqu]⟩
      exact Set.mem_iUnion.2 ⟨qr, by
        refine ⟨show x ∈ Set.Iic (qCoord qr) by exact le_of_lt hqx, z, hzx, ?_⟩
        intro y hyIic hyx
        have hyu : y < u := lt_of_le_of_lt hyIic hqu
        exact le_of_lt (huz ⟨hyx, hyu⟩)⟩
  refine (hJumpUp.union hJumpDown).mono ?_
  intro x hx
  exact (lt_or_gt_of_ne hx).elim Or.inl Or.inr

/-- Helper for Exercise 15.1.7: no countable family of bounded continuous functions can measure
the upper-copy witness set, because some split pair is invisible to the whole family. -/
private lemma upperCopy_not_measurableSpaceFromBoundedContinuous
    {T : Set (splitInterval →ᵇ ℝ)} (hT : T.Countable) :
    ¬ MeasurableSet[measurableSpaceFromBoundedContinuous T] upperCopy := by
  intro hUpper
  let bad : Set splitCoordinate := ⋃ f, ⋃ hf : f ∈ T,
    {x : splitCoordinate | f (lowerPoint x) ≠ f (upperPoint x)}
  have hBadCount : bad.Countable := by
    simpa [bad] using
      hT.biUnion (fun f hf ↦ countableSplitCoordinates_ofBoundedContinuous f)
  have hxExists : ∃ x : splitCoordinate, x ∉ bad := by
    by_contra hNo
    have hNo : ∀ x : splitCoordinate, x ∈ bad := by
      simpa using hNo
    have hBadUniv : bad = Set.univ := by
      ext x
      simp [hNo x]
    exact splitCoordinate_not_countable (hBadUniv ▸ hBadCount)
  rcases hxExists with ⟨x, hxBad⟩
  have hEq : ∀ f ∈ T, f (lowerPoint x) = f (upperPoint x) := by
    intro f hf
    by_contra hneq
    exact hxBad <| Set.mem_iUnion.2 ⟨f, Set.mem_iUnion.2 ⟨hf, hneq⟩⟩
  have hMemEq :
      lowerPoint x ∈ upperCopy ↔ upperPoint x ∈ upperCopy :=
    mem_iff_of_forall_eq_boundedContinuousFamily hEq upperCopy hUpper
  exact lowerPoint_not_mem_upperCopy x (hMemEq.mpr (upperPoint_mem_upperCopy x))

/-- Helper for Exercise 15.1.7: the split interval witness cannot be second countable, because
each split coordinate contributes an isolated-on-the-right point. -/
private lemma splitInterval_not_secondCountable :
    ¬ SecondCountableTopology splitInterval := by
  intro hSecond
  -- Local instance justification (proof-local temporary data): this temporary instance is only
  -- used to invoke second-countable order lemmas inside this contradiction proof.
  letI : SecondCountableTopology splitInterval := hSecond
  have hLowerCount : (lowerPoint '' (Set.univ : Set splitCoordinate)).Countable := by
    -- Every lower point is followed by its upper partner, so the image lies in the countable
    -- set of right-isolated points of a second-countable linear order.
    refine countable_setOf_covBy_right.mono ?_
    rintro z ⟨x, -, rfl⟩
    exact ⟨upperPoint x, lowerPoint_covBy_upperPoint x⟩
  have hCoordCount : (Set.univ : Set splitCoordinate).Countable := by
    -- Injectivity transfers countability back to the parameter interval `[0, 1]`.
    exact Set.countable_of_injective_of_countable_image
      (Set.injOn_univ.2 lowerPoint_injective) hLowerCount
  have hRangeCount : (Set.range (fun x : splitCoordinate ↦ x.1)).Countable := by
    -- The image of the subtype coordinate map is countable because the subtype itself is.
    simpa [Set.image_univ] using hCoordCount.image (fun x : splitCoordinate ↦ x.1)
  have hRangeEq : Set.range (fun x : splitCoordinate ↦ x.1) = Set.Icc (0 : ℝ) 1 := by
    -- Forgetting the subtype proof identifies the coordinate map range with the interval itself.
    ext r
    constructor
    · rintro ⟨x, rfl⟩
      exact x.2
    · intro hr
      exact ⟨⟨r, hr⟩, rfl⟩
  have hIccCount : (Set.Icc (0 : ℝ) 1 : Set ℝ).Countable := by
    -- The subtype coordinate map has range exactly `Set.Icc 0 1`.
    rw [← hRangeEq]
    exact hRangeCount
  have hNotCount : ¬ (Set.Icc (0 : ℝ) 1 : Set ℝ).Countable := by
    intro hcount
    have hle : Cardinal.mk (Set.Icc (0 : ℝ) 1) ≤ Cardinal.aleph0 := by
      rwa [Cardinal.le_aleph0_iff_set_countable]
    have hlt : Cardinal.aleph0 < Cardinal.mk (Set.Icc (0 : ℝ) 1) := by
      rw [Cardinal.mk_Icc_real (by norm_num)]
      exact Cardinal.aleph0_lt_continuum
    exact not_le_of_gt hlt hle
  exact hNotCount hIccCount

end SplitIntervalWitness

/-- Helper for Exercise 15.1.7: the split interval witness is separable but not second countable,
so it lies outside the corrected theorem proved in this file. -/
private theorem splitInterval_counterexample :
    ¬ SecondCountableTopology splitInterval :=
  splitInterval_not_secondCountable

