import Books.ProbabilityTheory_Klenke_2020.Items.Chap12.Exercise_12_1_1

-- Declarations for this item will be appended below by the statement pipeline.

universe u v

variable {Ω : Type u} [MeasurableSpace Ω]
variable {E : Type v} [MeasurableSpace E] [MeasurableSpace.SeparatesPoints E]

/- Source/core/bridge triage: this remark is a `bridge/view` item for the first `n` coordinates of
a process. The owner abstraction lives one level up in
`symmetricFiniteFamilySigmaAlgebra_eq_sigma_empiricalDistribution`, which is the finite-tuple
statement from Exercise 12.1.1. The present file is only the process-prefix bridge from that
owner theorem to the textbook notation `X₁, …, Xₙ`. -/

-- Proof sketch: specialize the finite-family owner theorem from Exercise 12.1.1 to the first `n`
-- coordinates `i ↦ X i` of the process.
/-- Remark 12.8: if `Ξₙ` denotes the empirical distribution of the first `n` coordinates of the
process `X`, then the `σ`-algebra generated by measurable symmetric functions of `X₁, …, Xₙ` is
exactly `σ(Ξₙ)`. -/
theorem symmetricPrefixSigmaAlgebra_eq_sigma_empiricalDistribution
    (X : ℕ → Ω → E) (n : ℕ+) :
    (⨆ F : {F : (Fin n → E) → ℝ // Measurable F ∧ IsSymmetricMap F},
      MeasurableSpace.comap (fun ω ↦ F.1 (fun i ↦ X i ω)) inferInstance) =
      MeasurableSpace.comap (empiricalDistribution n (fun i ↦ X i)) inferInstance := by
  sorry
