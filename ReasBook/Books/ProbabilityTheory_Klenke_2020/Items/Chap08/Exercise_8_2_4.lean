import Mathlib

open MeasureTheory ProbabilityTheory
open scoped ProbabilityTheory

noncomputable section

local notation "Ω₃" => Fin 3

/-- The σ-algebra generated by the partition `{0} | {1, 2}` on the three-point space. -/
abbrev threePointSubalgebra₀ : MeasurableSpace Ω₃ :=
  MeasurableSpace.generateFrom {({0} : Set Ω₃)}

/-- The σ-algebra generated by the partition `{0, 1} | {2}` on the three-point space. -/
abbrev threePointSubalgebra₂ : MeasurableSpace Ω₃ :=
  MeasurableSpace.generateFrom {({2} : Set Ω₃)}

/-- The uniform probability measure on the three-point space. -/
def threePointUniformMeasure : Measure Ω₃ :=
  uniformOn (Set.univ : Set Ω₃)

/-- The random variable taking the value `1` at `0` and `0` elsewhere. -/
def threePointIndicatorAtZero : Ω₃ → ℝ :=
  Set.indicator ({0} : Set Ω₃) (fun _ ↦ (1 : ℝ))

/-- Condition first on `{0} | {1, 2}`, then on `{0, 1} | {2}`. -/
def threePointLeftThenRight : Ω₃ → ℝ :=
  threePointUniformMeasure[
    threePointUniformMeasure[threePointIndicatorAtZero | threePointSubalgebra₀] |
      threePointSubalgebra₂]

/-- Condition first on `{0, 1} | {2}`, then on `{0} | {1, 2}`. -/
def threePointRightThenLeft : Ω₃ → ℝ :=
  threePointUniformMeasure[
    threePointUniformMeasure[threePointIndicatorAtZero | threePointSubalgebra₂] |
      threePointSubalgebra₀]

/-- Helper for Exercise 8.2.4: `threePointUniformMeasure` is a probability measure. -/
private instance : IsProbabilityMeasure threePointUniformMeasure := by
  dsimp [threePointUniformMeasure]
  infer_instance

private theorem threePointUniformMeasure_singleton_one_ne_zero :
    threePointUniformMeasure ({1} : Set Ω₃) ≠ 0 := by
  norm_num [threePointUniformMeasure, uniformOn_univ]

/-- Helper for Exercise 8.2.4: the set `{0, 1}` is measurable in the ambient space. -/
private lemma threePointMeasurableSet_pair01 : MeasurableSet ({0, 1} : Set Ω₃) := by
  exact (measurableSet_singleton (0 : Ω₃)).union (measurableSet_singleton (1 : Ω₃))

/-- Helper for Exercise 8.2.4: the set `{1, 2}` is measurable in the ambient space. -/
private lemma threePointMeasurableSet_pair12 : MeasurableSet ({1, 2} : Set Ω₃) := by
  exact (measurableSet_singleton (1 : Ω₃)).union (measurableSet_singleton (2 : Ω₃))

/-- Helper for Exercise 8.2.4: inside the atom `{0, 1}`, the point `{0}` has conditional
probability `1 / 2`. -/
private lemma threePointCondProb_zero_on_pair01 :
    (threePointUniformMeasure[|({0, 1} : Set Ω₃)]).real ({0} : Set Ω₃) = (1 / 2 : ℝ) := by
  have hEval :
      (ProbabilityTheory.cond threePointUniformMeasure ({0, 1} : Set Ω₃) ({0} : Set Ω₃)) =
        ENNReal.ofReal (1 / 2 : ℝ) := by
    rw [threePointUniformMeasure, uniformOn,
      ProbabilityTheory.cond_cond_eq_cond_inter (μ := Measure.count) MeasurableSet.univ
        threePointMeasurableSet_pair01]
    simpa [Set.univ_inter] using
      (ProbabilityTheory.uniformOn_apply_finset (s := ({0, 1} : Finset Ω₃))
        (t := ({0} : Finset Ω₃)))
  rw [MeasureTheory.measureReal_def, hEval]
  norm_num

/-- Helper for Exercise 8.2.4: inside the atom `{2}`, the point `{0}` has conditional
probability `0`. -/
private lemma threePointCondProb_zero_on_two :
    (threePointUniformMeasure[|({2} : Set Ω₃)]).real ({0} : Set Ω₃) = 0 := by
  have hEval :
      (ProbabilityTheory.cond threePointUniformMeasure ({2} : Set Ω₃) ({0} : Set Ω₃)) = 0 := by
    rw [threePointUniformMeasure, uniformOn,
      ProbabilityTheory.cond_cond_eq_cond_inter (μ := Measure.count) MeasurableSet.univ
        (measurableSet_singleton (2 : Ω₃))]
    simpa [Set.univ_inter] using
      (ProbabilityTheory.uniformOn_apply_finset (s := ({2} : Finset Ω₃))
        (t := ({0} : Finset Ω₃)))
  rw [MeasureTheory.measureReal_def, hEval]
  norm_num

/-- Helper for Exercise 8.2.4: the σ-algebra generated by `{2}` agrees with the one generated by
the complementary atom `{0, 1}`. -/
private lemma threePointSubalgebra₂_eq_generateFrom_pair01 :
    threePointSubalgebra₂ = MeasurableSpace.generateFrom {({0, 1} : Set Ω₃)} := by
  -- Replace the generator by its complement on each side.
  refine le_antisymm ?_ ?_
  · refine MeasurableSpace.generateFrom_le ?_
    intro t ht
    rw [Set.mem_singleton_iff] at ht
    subst ht
    have hMeas :
        @MeasurableSet Ω₃ (MeasurableSpace.generateFrom {({0, 1} : Set Ω₃)}) ({0, 1} : Set Ω₃) :=
      MeasurableSpace.measurableSet_generateFrom (Set.mem_singleton ({0, 1} : Set Ω₃))
    simpa [show ({0, 1} : Set Ω₃)ᶜ = ({2} : Set Ω₃) by
      ext i
      fin_cases i <;> simp] using hMeas.compl
  · refine MeasurableSpace.generateFrom_le ?_
    intro t ht
    rw [Set.mem_singleton_iff] at ht
    subst ht
    have hMeas :
        @MeasurableSet Ω₃ (MeasurableSpace.generateFrom {({2} : Set Ω₃)}) ({2} : Set Ω₃) :=
      MeasurableSpace.measurableSet_generateFrom (Set.mem_singleton ({2} : Set Ω₃))
    simpa [show ({2} : Set Ω₃)ᶜ = ({0, 1} : Set Ω₃) by
      ext i
      fin_cases i <;> simp] using hMeas.compl

/-- Helper for Exercise 8.2.4: the σ-algebra generated by `{0}` agrees with the one generated by
the complementary atom `{1, 2}`. -/
private lemma threePointSubalgebra₀_eq_generateFrom_pair12 :
    threePointSubalgebra₀ = MeasurableSpace.generateFrom {({1, 2} : Set Ω₃)} := by
  -- Replace the generator by its complement on each side.
  refine le_antisymm ?_ ?_
  · refine MeasurableSpace.generateFrom_le ?_
    intro t ht
    rw [Set.mem_singleton_iff] at ht
    subst ht
    have hMeas :
        @MeasurableSet Ω₃ (MeasurableSpace.generateFrom {({1, 2} : Set Ω₃)}) ({1, 2} : Set Ω₃) :=
      MeasurableSpace.measurableSet_generateFrom (Set.mem_singleton ({1, 2} : Set Ω₃))
    simpa [show ({1, 2} : Set Ω₃)ᶜ = ({0} : Set Ω₃) by
      ext i
      fin_cases i <;> simp] using hMeas.compl
  · refine MeasurableSpace.generateFrom_le ?_
    intro t ht
    rw [Set.mem_singleton_iff] at ht
    subst ht
    have hMeas :
        @MeasurableSet Ω₃ (MeasurableSpace.generateFrom {({0} : Set Ω₃)}) ({0} : Set Ω₃) :=
      MeasurableSpace.measurableSet_generateFrom (Set.mem_singleton ({0} : Set Ω₃))
    simpa [show ({0} : Set Ω₃)ᶜ = ({1, 2} : Set Ω₃) by
      ext i
      fin_cases i <;> simp] using hMeas.compl

/-- Helper for Exercise 8.2.4: the conditional expectation of `threePointIndicatorAtZero` on the
partition `{0, 1} | {2}` takes the values `1 / 2`, `1 / 2`, and `0` at `0`, `1`, and `2`. -/
private lemma threePointCondExpIndicatorAtZero_values :
    threePointUniformMeasure[threePointIndicatorAtZero | threePointSubalgebra₂] 0 =
      (1 / 2 : ℝ) ∧
    threePointUniformMeasure[threePointIndicatorAtZero | threePointSubalgebra₂] 1 =
      (1 / 2 : ℝ) ∧
    threePointUniformMeasure[threePointIndicatorAtZero | threePointSubalgebra₂] 2 = 0 := by
  -- Recover the values on the atom `{0, 1}` from the singleton-generated conditional expectation.
  have hLeftAE :
      threePointUniformMeasure[threePointIndicatorAtZero | threePointSubalgebra₂] =ᵐ[
        threePointUniformMeasure.restrict ({0, 1} : Set Ω₃)]
        fun _ ↦ (threePointUniformMeasure[|({0, 1} : Set Ω₃)]).real ({0} : Set Ω₃) := by
    rw [threePointSubalgebra₂_eq_generateFrom_pair01]
    simpa [threePointIndicatorAtZero] using
      (ProbabilityTheory.condExp_set_generateFrom_singleton
        (μ := threePointUniformMeasure) (s := ({0, 1} : Set Ω₃)) (t := ({0} : Set Ω₃))
        threePointMeasurableSet_pair01 (measurableSet_singleton (0 : Ω₃)))
  -- Recover the value on the atom `{2}` by the same singleton-generated formula.
  have hRightAE :
      threePointUniformMeasure[threePointIndicatorAtZero | threePointSubalgebra₂] =ᵐ[
        threePointUniformMeasure.restrict ({2} : Set Ω₃)]
        fun _ ↦ (threePointUniformMeasure[|({2} : Set Ω₃)]).real ({0} : Set Ω₃) := by
    simpa [threePointSubalgebra₂, threePointIndicatorAtZero] using
      (ProbabilityTheory.condExp_set_generateFrom_singleton
        (μ := threePointUniformMeasure) (s := ({2} : Set Ω₃)) (t := ({0} : Set Ω₃))
        (measurableSet_singleton (2 : Ω₃)) (measurableSet_singleton (0 : Ω₃)))
  have hPoint0 := (ae_iff_of_countable.mp hLeftAE) 0
  have hPoint1 := (ae_iff_of_countable.mp hLeftAE) 1
  have hPoint2 := (ae_iff_of_countable.mp hRightAE) 2
  have hMass0 : threePointUniformMeasure.restrict ({0, 1} : Set Ω₃) ({0} : Set Ω₃) ≠ 0 := by
    norm_num [threePointUniformMeasure, uniformOn_univ, Measure.restrict_apply]
  have hMass1 : threePointUniformMeasure.restrict ({0, 1} : Set Ω₃) ({1} : Set Ω₃) ≠ 0 := by
    norm_num [threePointUniformMeasure, uniformOn_univ, Measure.restrict_apply]
  have hMass2 : threePointUniformMeasure.restrict ({2} : Set Ω₃) ({2} : Set Ω₃) ≠ 0 := by
    norm_num [threePointUniformMeasure, uniformOn_univ, Measure.restrict_apply]
  constructor
  · calc
      threePointUniformMeasure[threePointIndicatorAtZero | threePointSubalgebra₂] 0
          = (threePointUniformMeasure[|({0, 1} : Set Ω₃)]).real ({0} : Set Ω₃) := hPoint0 hMass0
      _ = (1 / 2 : ℝ) := by
        simpa using threePointCondProb_zero_on_pair01
  constructor
  · calc
      threePointUniformMeasure[threePointIndicatorAtZero | threePointSubalgebra₂] 1
          = (threePointUniformMeasure[|({0, 1} : Set Ω₃)]).real ({0} : Set Ω₃) := hPoint1 hMass1
      _ = (1 / 2 : ℝ) := by
        simpa using threePointCondProb_zero_on_pair01
  · calc
      threePointUniformMeasure[threePointIndicatorAtZero | threePointSubalgebra₂] 2
          = (threePointUniformMeasure[|({2} : Set Ω₃)]).real ({0} : Set Ω₃) := hPoint2 hMass2
      _ = 0 := by
        simpa using threePointCondProb_zero_on_two

/-- Helper for Exercise 8.2.4: conditioning the indicator of `{0}` on the partition
`{0, 1} | {2}` gives the value `1 / 2` on `{0, 1}` and `0` on `{2}`. -/
private lemma condExpIndicatorAtZero_subalgebra₂ :
    threePointUniformMeasure[threePointIndicatorAtZero | threePointSubalgebra₂] =
      fun i ↦ ({0, 1} : Set Ω₃).indicator (fun _ ↦ (1 / 2 : ℝ)) i := by
  -- First turn the restricted almost-everywhere equalities into exact values at `0`, `1`, and `2`.
  rcases threePointCondExpIndicatorAtZero_values with ⟨h0, h1, h2⟩
  -- Then the desired indicator formula is a pointwise check on the three-element space.
  ext i
  fin_cases i
  · simpa [threePointSubalgebra₂] using h0
  · simpa [threePointSubalgebra₂] using h1
  · simpa [threePointSubalgebra₂] using h2

/-- Helper for Exercise 8.2.4: the left-to-right iterated conditional expectation takes the value
`1 / 2` at `1`. -/
private lemma threePointLeftThenRight_at_one :
    threePointLeftThenRight 1 = (1 / 2 : ℝ) := by
  -- The inner conditional expectation is already measurable for `threePointSubalgebra₀`.
  have hSubalgebra₀_le : threePointSubalgebra₀ ≤ (inferInstance : MeasurableSpace Ω₃) := by
    refine MeasurableSpace.generateFrom_le ?_
    intro t ht
    rw [Set.mem_singleton_iff] at ht
    subst ht
    exact measurableSet_singleton (0 : Ω₃)
  have hIndicatorMeasurable : Measurable[threePointSubalgebra₀] threePointIndicatorAtZero := by
    exact Measurable.indicator measurable_const
      (MeasurableSpace.measurableSet_generateFrom (Set.mem_singleton ({0} : Set Ω₃)))
  have hIndicatorStronglyMeasurable :
      StronglyMeasurable[threePointSubalgebra₀] threePointIndicatorAtZero :=
    hIndicatorMeasurable.stronglyMeasurable
  have hIndicatorIntegrable : Integrable threePointIndicatorAtZero threePointUniformMeasure := by
    refine Integrable.indicator (integrable_const 1) ?_
    exact measurableSet_singleton (0 : Ω₃)
  -- After rewriting the inner term, the outer conditioning is the same singleton-generated case.
  rw [threePointLeftThenRight,
    condExp_of_stronglyMeasurable hSubalgebra₀_le hIndicatorStronglyMeasurable hIndicatorIntegrable]
  have hLeftAE :
      threePointUniformMeasure[threePointIndicatorAtZero | threePointSubalgebra₂] =ᵐ[
        threePointUniformMeasure.restrict ({0, 1} : Set Ω₃)]
        fun _ ↦ (threePointUniformMeasure[|({0, 1} : Set Ω₃)]).real ({0} : Set Ω₃) := by
    rw [threePointSubalgebra₂_eq_generateFrom_pair01]
    simpa [threePointIndicatorAtZero] using
      (ProbabilityTheory.condExp_set_generateFrom_singleton
        (μ := threePointUniformMeasure) (s := ({0, 1} : Set Ω₃)) (t := ({0} : Set Ω₃))
        threePointMeasurableSet_pair01 (measurableSet_singleton (0 : Ω₃)))
  have hPoint := (ae_iff_of_countable.mp hLeftAE) 1
  have hMass : threePointUniformMeasure.restrict ({0, 1} : Set Ω₃) ({1} : Set Ω₃) ≠ 0 := by
    norm_num [threePointUniformMeasure, uniformOn_univ, Measure.restrict_apply]
  calc
    threePointUniformMeasure[threePointIndicatorAtZero | threePointSubalgebra₂] 1
        = (threePointUniformMeasure[|({0, 1} : Set Ω₃)]).real ({0} : Set Ω₃) := hPoint hMass
    _ = (1 / 2 : ℝ) := by
      simpa using threePointCondProb_zero_on_pair01

/-- Helper for Exercise 8.2.4: inside the atom `{1, 2}`, the event `{0, 1}` has conditional
probability `1 / 2`. -/
private lemma threePointCondProb_pair01_on_pair12 :
    (threePointUniformMeasure[|({1, 2} : Set Ω₃)]).real ({0, 1} : Set Ω₃) = (1 / 2 : ℝ) := by
  -- Evaluate the conditional probability by intersecting with the ambient uniform support.
  have hEval :
      (ProbabilityTheory.cond threePointUniformMeasure ({1, 2} : Set Ω₃) ({0, 1} : Set Ω₃)) =
        ENNReal.ofReal (1 / 2 : ℝ) := by
    rw [threePointUniformMeasure, uniformOn,
      ProbabilityTheory.cond_cond_eq_cond_inter (μ := Measure.count) MeasurableSet.univ
        threePointMeasurableSet_pair12]
    simpa [Set.univ_inter] using
      (ProbabilityTheory.uniformOn_apply_finset (s := ({1, 2} : Finset Ω₃))
        (t := ({0, 1} : Finset Ω₃)))
  rw [MeasureTheory.measureReal_def, hEval]
  norm_num

/-- Helper for Exercise 8.2.4: the right-to-left iterated conditional expectation takes the value
`1 / 4` at `1`. -/
private lemma threePointRightThenLeft_at_one :
    threePointRightThenLeft 1 = (1 / 4 : ℝ) := by
  have hIntegrable :
      Integrable (fun i ↦ ({0, 1} : Set Ω₃).indicator (fun _ ↦ (1 / 2 : ℝ)) i)
        threePointUniformMeasure := by
    -- The indicator of a constant function is integrable on the finite probability space.
    exact Integrable.indicator (integrable_const (1 / 2 : ℝ)) threePointMeasurableSet_pair01
  rw [threePointRightThenLeft, condExpIndicatorAtZero_subalgebra₂,
    threePointSubalgebra₀_eq_generateFrom_pair12]
  -- On the atom `{1, 2}`, conditioning onto the singleton-generated σ-algebra is constant.
  have hAE :
      threePointUniformMeasure[
          (fun i ↦ ({0, 1} : Set Ω₃).indicator (fun _ ↦ (1 / 2 : ℝ)) i) |
          MeasurableSpace.generateFrom {({1, 2} : Set Ω₃)}] =ᵐ[
            threePointUniformMeasure.restrict ({1, 2} : Set Ω₃)]
          fun _ ↦ ∫ x, ({0, 1} : Set Ω₃).indicator (fun _ ↦ (1 / 2 : ℝ)) x ∂
            threePointUniformMeasure[|({1, 2} : Set Ω₃)] := by
    exact ProbabilityTheory.condExp_generateFrom_singleton threePointMeasurableSet_pair12
      hIntegrable
  have hPoint := (ae_iff_of_countable.mp hAE) 1
  have hMass : threePointUniformMeasure.restrict ({1, 2} : Set Ω₃) ({1} : Set Ω₃) ≠ 0 := by
    norm_num [threePointUniformMeasure, uniformOn_univ, Measure.restrict_apply]
  calc
    threePointUniformMeasure[
        (fun i ↦ ({0, 1} : Set Ω₃).indicator (fun _ ↦ (1 / 2 : ℝ)) i) |
        MeasurableSpace.generateFrom {({1, 2} : Set Ω₃)}] 1
        = ∫ x, ({0, 1} : Set Ω₃).indicator (fun _ ↦ (1 / 2 : ℝ)) x ∂
            threePointUniformMeasure[|({1, 2} : Set Ω₃)] := hPoint hMass
    _ = (threePointUniformMeasure[|({1, 2} : Set Ω₃)]).real ({0, 1} : Set Ω₃) * (1 / 2 : ℝ) := by
      rw [integral_indicator_const (μ := threePointUniformMeasure[|({1, 2} : Set Ω₃)])
        (e := (1 / 2 : ℝ)) threePointMeasurableSet_pair01]
      simp [smul_eq_mul]
    _ = (1 / 4 : ℝ) := by
      rw [threePointCondProb_pair01_on_pair12]
      norm_num

/-- Exercise 8.2.4: the two iterated conditional expectations in the three-point model already
disagree at `1`. -/
-- Proof sketch: evaluate each conditional expectation with
-- `condExp_generateFrom_singleton`. Since `threePointIndicatorAtZero` is already
-- `threePointSubalgebra₀`-measurable, `threePointLeftThenRight 1` equals `1 / 2`; the other
-- order first averages over `{0, 1}` and then over `{1, 2}`, producing
-- `threePointRightThenLeft 1 = 1 / 4`.
theorem iterated_condExp_order_ne_at_one :
    threePointLeftThenRight 1 ≠ threePointRightThenLeft 1 := by
  -- Route correction: compute each iterated conditional expectation on the atom containing `1`
  -- before comparing the resulting rational values.
  rw [threePointLeftThenRight_at_one, threePointRightThenLeft_at_one]
  norm_num

/-- Helper for Exercise 8.2.4: on the uniform probability space on three points, with the
partitions
`{0} | {1, 2}` and `{0, 1} | {2}`, iterating conditional expectation in the two possible orders
need not give almost surely equal random variables. -/
-- Proof sketch: a pointwise almost-everywhere equality on the countable three-point space holds at
-- every point of nonzero measure; apply this at `1`, where the singleton has positive
-- `threePointUniformMeasure`, and then use `iterated_condExp_order_ne_at_one`.
theorem iterated_condExp_order_ne :
    ¬ threePointLeftThenRight =ᵐ[threePointUniformMeasure] threePointRightThenLeft := by
  intro h
  exact iterated_condExp_order_ne_at_one <|
    ae_iff_of_countable.mp h 1 threePointUniformMeasure_singleton_one_ne_zero

/-- The same three-point model also yields genuinely different functions, not just distinct
almost-everywhere classes. -/
theorem iterated_condExp_order_pointwise_ne :
    threePointLeftThenRight ≠ threePointRightThenLeft := by
  intro h
  exact iterated_condExp_order_ne_at_one (congrArg (fun f : Ω₃ → ℝ ↦ f 1) h)
