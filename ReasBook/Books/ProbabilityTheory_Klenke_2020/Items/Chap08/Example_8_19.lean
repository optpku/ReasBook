import Books.ProbabilityTheory_Klenke_2020.Items.Chap05.Theorem_5_28

-- Declarations for this item will be appended below by the statement pipeline.

open MeasureTheory ProbabilityTheory
open scoped ProbabilityTheory

universe u

variable {Ω : Type u} [mΩ : MeasurableSpace Ω]
variable {P : Measure Ω} [IsProbabilityMeasure P]

section

variable {X : ℕ → Ω → ℝ}
variable (hX_meas : ∀ i, Measurable (X i)) (hX_int : ∀ i, Integrable (X i) P)
variable (hX_mean_zero : ∀ i, ∫ ω, X i ω ∂P = 0) (hX_indep : iIndepFun X P)
variable {m n : ℕ}

/-- Helper for Example 8.19: the σ-algebra generated by the prefix `X 0, ..., X (m - 1)`. -/
private abbrev prefixSigma (X : ℕ → Ω → ℝ) (m : ℕ) : MeasurableSpace Ω :=
  ⨆ i ∈ Finset.range m, MeasurableSpace.comap (X i) (borel ℝ)

/-- Helper for Example 8.19: the generated prefix σ-algebra is a sub-σ-algebra of the ambient one.
-/
private lemma prefixSigma_le (hX_meas : ∀ i, Measurable (X i)) (m : ℕ) :
    prefixSigma X m ≤ mΩ := by
  -- Each coordinate σ-algebra sits inside the ambient σ-algebra by measurability of `X i`.
  refine iSup₂_le fun i hi ↦ ?_
  exact (hX_meas i).comap_le

/-- Helper for Example 8.19: enlarging the prefix enlarges the generated σ-algebra. -/
private lemma prefixSigma_mono {m n : ℕ} (hmn : m ≤ n) :
    prefixSigma X m ≤ prefixSigma X n := by
  -- Every generator from the shorter prefix also appears in the longer prefix.
  refine iSup₂_le fun i hi ↦ ?_
  exact le_iSup_of_le i <| le_iSup_of_le
    (Finset.mem_range.mpr <| lt_of_lt_of_le (Finset.mem_range.mp hi) hmn) le_rfl

/-- Helper for Example 8.19: finite partial sums of the integrable coordinates are integrable. -/
private lemma partialSumIntegrable (hX_int : ∀ i, Integrable (X i) P) (r : ℕ) :
    Integrable (partialSum X r) P := by
  -- Expand the partial sum into a finite sum and use integrability termwise.
  simpa [partialSum] using
    (integrable_finset_sum (Finset.range r) fun i _ ↦ hX_int i)

/-- Helper for Example 8.19: `partialSum X m` is measurable with respect to the prefix
σ-algebra generated by `X 0, ..., X (m - 1)`. -/
private lemma partialSumMeasurablePrefixSigma (m : ℕ) :
    Measurable[prefixSigma X m] (partialSum X m) := by
  induction m with
  | zero =>
      -- The empty partial sum is the zero function, hence measurable for the trivial prefix.
      change Measurable[prefixSigma X 0] (fun _ ↦ (0 : ℝ))
      exact measurable_const
  | succ m ih =>
      have hprefix :
          Measurable[prefixSigma X (m + 1)] (partialSum X m) :=
        Measurable.of_comap_le <|
          (ih.comap_le).trans <| prefixSigma_mono (X := X) (Nat.le_succ m)
      have hcoord : Measurable[prefixSigma X (m + 1)] (X m) := by
        -- The newest coordinate is measurable for the enlarged prefix σ-algebra.
        exact Measurable.of_comap_le <|
          le_iSup_of_le m <| le_iSup_of_le (by simp) le_rfl
      have hadd : Measurable[prefixSigma X (m + 1)] (fun ω ↦ partialSum X m ω + X m ω) :=
        hprefix.add hcoord
      -- The next partial sum is the previous one plus the new coordinate.
      change Measurable[prefixSigma X (m + 1)] (fun ω ↦ ∑ i ∈ Finset.range (m + 1), X i ω)
      simpa [partialSum, Finset.sum_range_succ] using hadd

/-- Helper for Example 8.19: the long partial sum splits into the past prefix plus the future tail
over `Finset.Ico m n`. -/
private lemma partialSum_eq_prefix_addTail (hmn : m ≤ n) :
    partialSum X n = partialSum X m + ∑ i ∈ Finset.Ico m n, X i := by
  -- Rearrange the difference formula for partial sums into an additive decomposition.
  funext ω
  have htail := partialSum_sub_eq_sum_Ico X hmn ω
  rw [sub_eq_iff_eq_add] at htail
  simpa [add_comm, add_left_comm, add_assoc] using htail

/-- Helper for Example 8.19: conditioning a future coordinate on the past prefix σ-algebra returns
its expectation. -/
private lemma condExp_coordinate_given_prefixSigma_ae_eq_expectation
    (hX_meas : ∀ i, Measurable (X i)) (hX_indep : iIndepFun X P) {k m : ℕ} (hmk : m ≤ k) :
    P[X k | prefixSigma X m] =ᵐ[P] fun _ ↦ P[X k] := by
  let hX_strong : ∀ i, StronglyMeasurable (X i) := fun i ↦ (hX_meas i).stronglyMeasurable
  cases m with
  | zero =>
      -- Conditioning on the empty prefix means conditioning on the trivial σ-algebra.
      simpa [prefixSigma] using
        (Filter.EventuallyEq.of_eq (MeasureTheory.condExp_bot (μ := P) (f := X k)) :
          P[X k | prefixSigma X 0] =ᵐ[P] fun _ ↦ P[X k])
  | succ r =>
      have hlt : r < k := lt_of_lt_of_le (Nat.lt_succ_self r) hmk
      have hnat :
          P[X k | Filtration.natural X hX_strong r] =ᵐ[P] fun _ ↦ P[X k] := by
        -- The future coordinate is independent of the natural filtration of the past.
        simpa [hX_strong] using
          (ProbabilityTheory.iIndepFun.condExp_natural_ae_eq_of_lt
            (f := X) hX_strong hX_indep hlt)
      -- The prefix σ-algebra for `range (r + 1)` is exactly that natural filtration.
      simpa [prefixSigma, Filtration.natural, Finset.mem_range, Nat.lt_succ_iff] using hnat

-- Proof sketch: split `partialSum X n` into the past sum `partialSum X m` and the tail sum from
-- `m` to `n - 1`; use `condExp_finset_sum`, `condExp_of_measurable_ae_eq`, and
-- `condExp_indep_eq`, then the zero-mean assumptions kill the tail terms.
/-- Example 8.19: if `X 1, X 2, ...` are independent centered integrable real random variables,
`S_n = ∑_{i=1}^n X_i`, and `ℱ_m = σ(X_1, ..., X_m)`, then for `m ≤ n` the conditional expectation
of `S_n` given `ℱ_m` is `S_m` almost surely. This is the canonical `0`-based Lean version for a
sequence `X 0, X 1, …`; for the textbook sequence `X₁, X₂, …`, apply it to `fun k ↦ X (k + 1)`.
-/
theorem condExp_partialSums_given_generated_prefix_ae_eq
    (hX_meas : ∀ i, Measurable (X i)) (hX_int : ∀ i, Integrable (X i) P)
    (hX_mean_zero : ∀ i, ∫ ω, X i ω ∂P = 0) (hX_indep : iIndepFun X P) (hmn : m ≤ n) :
    P[partialSum X n | ⨆ i ∈ Finset.range m, MeasurableSpace.comap (X i) (borel ℝ)] =ᵐ[P]
      partialSum X m := by
  have h𝓕m_le : prefixSigma X m ≤ mΩ := prefixSigma_le (X := X) hX_meas m
  have hSm_int : Integrable (partialSum X m) P :=
    partialSumIntegrable (X := X) (P := P) hX_int m
  have hSm_meas : Measurable[prefixSigma X m] (partialSum X m) :=
    partialSumMeasurablePrefixSigma (X := X) m
  have htail_int : Integrable (∑ i ∈ Finset.Ico m n, X i) P := by
    -- The tail block is another finite sum of integrable coordinates.
    convert (integrable_finset_sum (Finset.Ico m n) fun i _ ↦ hX_int i) using 1
    ext ω
    simp [Finset.sum_apply]
  have htail_zero :
      P[∑ i ∈ Finset.Ico m n, X i | prefixSigma X m] =ᵐ[P] 0 := by
    -- Evaluate the conditional expectation of the future tail termwise and use the centered
    -- assumptions to collapse every coordinate expectation to `0`.
    calc
      P[∑ i ∈ Finset.Ico m n, X i | prefixSigma X m] =ᵐ[P]
          ∑ i ∈ Finset.Ico m n, P[X i | prefixSigma X m] := by
            exact condExp_finset_sum (μ := P) (s := Finset.Ico m n) (f := X)
              (fun i _ ↦ hX_int i) (prefixSigma X m)
      _ =ᵐ[P] ∑ i ∈ Finset.Ico m n, fun _ ↦ P[X i] := by
            exact eventuallyEq_sum fun i hi ↦
              condExp_coordinate_given_prefixSigma_ae_eq_expectation
                (X := X) (P := P) hX_meas hX_indep (m := m) (k := i)
                (Finset.mem_Ico.mp hi).1
      _ =ᵐ[P] ∑ i ∈ Finset.Ico m n, fun _ ↦ (0 : ℝ) := by
            exact eventuallyEq_sum fun i hi ↦
              Filter.Eventually.of_forall fun _ ↦ by simpa using hX_mean_zero i
      _ =ᵐ[P] 0 := by
            exact Filter.Eventually.of_forall fun _ ↦ by simp
  -- Split `S_n` into the known prefix `S_m` and the future tail, then kill the tail.
  calc
    P[partialSum X n | prefixSigma X m] =ᵐ[P]
        P[partialSum X m + ∑ i ∈ Finset.Ico m n, X i | prefixSigma X m] := by
          refine condExp_congr_ae ?_
          exact Filter.Eventually.of_forall fun ω ↦ by
            simpa using
              congrFun (partialSum_eq_prefix_addTail (X := X) (m := m) (n := n) hmn) ω
    _ =ᵐ[P]
        P[partialSum X m | prefixSigma X m] +
          P[∑ i ∈ Finset.Ico m n, X i | prefixSigma X m] := by
          exact condExp_add hSm_int htail_int (prefixSigma X m)
    _ =ᵐ[P] partialSum X m + P[∑ i ∈ Finset.Ico m n, X i | prefixSigma X m] := by
          rw [MeasureTheory.condExp_of_stronglyMeasurable
            (μ := P) (m := prefixSigma X m) h𝓕m_le hSm_meas.stronglyMeasurable hSm_int]
    _ =ᵐ[P] partialSum X m + 0 := by
          exact (Filter.EventuallyEq.rfl.add htail_zero)
    _ =ᵐ[P] partialSum X m := by
          simp

-- Proof sketch: the random variable `partialSum X m` is measurable with respect to the σ-algebra
-- generated by `X 0, …, X (m - 1)`, so `σ(partialSum X m)` is contained in that σ-algebra; apply
-- the tower property to `condExp_partialSums_given_generated_prefix_ae_eq` and then use that
-- conditioning `partialSum X m` on its own σ-algebra is almost surely equal to itself.
/-- Companion corollary to Example 8.19: conditioning the partial sum `S_n` on the single random
variable `S_m` still returns `S_m` almost surely. This follows from the source-facing statement for
the past σ-algebra generated by `X 1, ..., X_m`. -/
theorem condExp_partialSums_given_partialSum_ae_eq
    (hX_meas : ∀ i, Measurable (X i)) (hX_int : ∀ i, Integrable (X i) P)
    (hX_mean_zero : ∀ i, ∫ ω, X i ω ∂P = 0) (hX_indep : iIndepFun X P) (hmn : m ≤ n) :
    P[partialSum X n | MeasurableSpace.comap (partialSum X m) (borel ℝ)] =ᵐ[P] partialSum X m :=
  by
  have h𝓕m_le : prefixSigma X m ≤ mΩ := prefixSigma_le (X := X) hX_meas m
  have hSm_int : Integrable (partialSum X m) P :=
    partialSumIntegrable (X := X) (P := P) hX_int m
  have hSm_comap_le :
      MeasurableSpace.comap (partialSum X m) (borel ℝ) ≤ prefixSigma X m := by
    -- The prefix sum is `𝓕m`-measurable, so its generated σ-algebra is contained in `𝓕m`.
    exact (partialSumMeasurablePrefixSigma (X := X) m).comap_le
  have hSm_comap_le_mΩ :
      MeasurableSpace.comap (partialSum X m) (borel ℝ) ≤ mΩ :=
    hSm_comap_le.trans h𝓕m_le
  -- Insert the larger past σ-algebra using the tower property and then use the main source-facing
  -- conditional-expectation identity.
  calc
    P[partialSum X n | MeasurableSpace.comap (partialSum X m) (borel ℝ)] =ᵐ[P]
        P[P[partialSum X n | prefixSigma X m] |
          MeasurableSpace.comap (partialSum X m) (borel ℝ)] := by
          exact (condExp_condExp_of_le (μ := P) (f := partialSum X n) hSm_comap_le h𝓕m_le).symm
    _ =ᵐ[P] P[partialSum X m | MeasurableSpace.comap (partialSum X m) (borel ℝ)] := by
          exact condExp_congr_ae <|
            condExp_partialSums_given_generated_prefix_ae_eq
              (X := X) (P := P) hX_meas hX_int hX_mean_zero hX_indep hmn
    _ =ᵐ[P] partialSum X m := by
          exact Filter.EventuallyEq.of_eq <|
            MeasureTheory.condExp_of_stronglyMeasurable
              (μ := P) (m := MeasurableSpace.comap (partialSum X m) (borel ℝ)) hSm_comap_le_mΩ
              (comap_measurable (partialSum X m)).stronglyMeasurable hSm_int

end
