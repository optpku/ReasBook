import Mathlib

-- Declarations for this item will be appended below by the statement pipeline.

open Filter MeasureTheory ProbabilityTheory
open scoped ProbabilityTheory

universe u

variable {Ω : Type u} [mΩ : MeasurableSpace Ω]
variable {P : Measure Ω} [IsProbabilityMeasure P]

-- Proof sketch: use `MeasureTheory.condExp_add` for `X + Y`.
-- Identify the `X`-term with the constant expectation via
-- `MeasureTheory.condExp_indep_eq` and `ProbabilityTheory.IndepFun_iff_Indep`.
-- Identify the `Y`-term with `Y` via `MeasureTheory.condExp_of_aestronglyMeasurable'`.
/-- Example 8.18: if integrable real random variables `X` and `Y` are independent, then the
conditional expectation of `X + Y` with respect to the σ-algebra generated by `Y` is almost surely
the constant expectation of `X` plus `Y`. -/
theorem condExp_add_given_right_ae_eq_of_indepFun {X Y : Ω → ℝ} (hX : Integrable X P)
    (hY : Integrable Y P) (h_indep : X ⟂ᵢ[P] Y) (hY_meas : Measurable Y) :
    P[X + Y | MeasurableSpace.comap Y (borel ℝ)] =ᵐ[P] (fun _ ↦ P[X]) + Y := by
  let mY : MeasurableSpace Ω := MeasurableSpace.comap Y (borel ℝ)
  let X' : Ω → ℝ := hX.aestronglyMeasurable.mk X
  have hX_ae : X =ᵐ[P] X' := hX.aestronglyMeasurable.ae_eq_mk
  have hX'_int : Integrable X' P := hX.congr hX_ae
  have hX'_indep : X' ⟂ᵢ[P] Y := h_indep.congr hX_ae EventuallyEq.rfl
  have hX'_meas : Measurable[mΩ] X' := hX.aestronglyMeasurable.measurable_mk
  have hmY : mY ≤ mΩ := hY_meas.comap_le
  have hX'_cond : P[X' | mY] =ᵐ[P] fun _ ↦ P[X'] :=
    condExp_indep_eq hX'_meas.comap_le hmY
      (comap_measurable X').stronglyMeasurable ((IndepFun_iff_Indep _ _ _).mp hX'_indep)
  have hY_cond : P[Y | mY] =ᵐ[P] Y :=
    condExp_of_aestronglyMeasurable' hmY (comap_measurable Y).aestronglyMeasurable hY
  have hEX : P[X'] = P[X] := integral_congr_ae hX_ae.symm
  calc
    P[X + Y | mY] =ᵐ[P] P[X' + Y | mY] := by
          exact condExp_congr_ae (hX_ae.add EventuallyEq.rfl)
    _ =ᵐ[P] P[X' | mY] + P[Y | mY] := condExp_add hX'_int hY _
    _ =ᵐ[P] (fun _ ↦ P[X']) + Y := hX'_cond.add hY_cond
    _ =ᵐ[P] (fun _ ↦ P[X]) + Y := by simp [hEX]
