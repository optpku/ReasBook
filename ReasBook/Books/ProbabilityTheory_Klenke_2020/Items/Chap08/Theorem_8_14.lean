import Mathlib

-- Declarations for this item will be appended below by the statement pipeline.

open Filter MeasureTheory ProbabilityTheory
open scoped ENNReal ProbabilityTheory Topology

universe u

variable {Ω : Type u} [mΩ : MeasurableSpace Ω]
variable {P : Measure Ω}

-- Proof sketch: combine `MeasureTheory.condExp_smul` with `MeasureTheory.condExp_add`,
-- then rewrite the right-hand side pointwise.
/-- Theorem 8.14 (1): (i) Linearity. For integrable real random variables `X` and `Y`, the
conditional expectation of `λ • X + Y` with respect to `ℱ` is `λ • P[X | ℱ] + P[Y | ℱ]`. -/
theorem condExp_add_smul_ae_eq {ℱ : MeasurableSpace Ω} {X Y : Ω → ℝ}
    (c : ℝ) (hX : Integrable X P) (hY : Integrable Y P) :
    P[c • X + Y | ℱ] =ᵐ[P] c • P[X | ℱ] + P[Y | ℱ] := by
  calc
    P[c • X + Y | ℱ] =ᵐ[P] P[c • X | ℱ] + P[Y | ℱ] := condExp_add (hX.smul c) hY ℱ
    _ =ᵐ[P] c • P[X | ℱ] + P[Y | ℱ] := (condExp_smul c X ℱ).add EventuallyEq.rfl

/- Theorem 8.14 (2): (ii) Monotonicity. If `Y ≤ X` almost surely, then
`P[Y | ℱ] ≤ P[X | ℱ]` almost surely. This is exactly `MeasureTheory.condExp_mono`. -/
recall condExp_mono

-- Proof sketch: apply the pull-out theorem
-- `MeasureTheory.condExp_mul_of_stronglyMeasurable_right` to the `ℱ`-measurable factor `Y`.
/-- Theorem 8.14 (3): (iii) If `Y` is `ℱ`-measurable and `XY ∈ L¹(P)`, then
`P[XY | ℱ] = P[X | ℱ] Y` almost surely. This is the canonical right pull-out form in mathlib. -/
theorem condExp_mul_of_measurable_right_ae_eq {ℱ : MeasurableSpace Ω} {X Y : Ω → ℝ}
    (hX : Integrable X P) (hXY : Integrable (X * Y) P)
    (hY_meas : Measurable[ℱ] Y) :
    P[X * Y | ℱ] =ᵐ[P] P[X | ℱ] * Y :=
  condExp_mul_of_stronglyMeasurable_right hY_meas.stronglyMeasurable hXY hX

-- Proof sketch: use `MeasureTheory.condExp_of_stronglyMeasurable` for the
-- `ℱ`-measurable integrable function `Y`.
/-- Theorem 8.14 (4): (iii) If `Y` is integrable and `ℱ`-measurable, then
`P[Y | ℱ] = Y` almost surely. -/
theorem condExp_of_measurable_ae_eq {ℱ : MeasurableSpace Ω} (hℱ : ℱ ≤ mΩ) {Y : Ω → ℝ}
    [SigmaFinite (P.trim hℱ)] (hY : Integrable Y P) (hY_meas : Measurable[ℱ] Y) :
    P[Y | ℱ] =ᵐ[P] Y :=
  EventuallyEq.of_eq <| condExp_of_stronglyMeasurable hℱ hY_meas.stronglyMeasurable hY

-- Proof sketch: view `σ(Y)` as `MeasurableSpace.comap Y borel` and apply
-- `MeasureTheory.condExp_of_stronglyMeasurable` to `Y`.
/-- Theorem 8.14 (5): (iii) If `Y` is integrable, then conditioning `Y` on the σ-algebra
generated by `Y` returns `Y` almost surely. -/
theorem condExp_self_ae_eq {Y : Ω → ℝ} (hY : Integrable Y P) (hY_meas : Measurable[mΩ] Y)
    [SigmaFinite (P.trim hY_meas.comap_le)] :
    P[Y | MeasurableSpace.comap Y (borel ℝ)] =ᵐ[P] Y :=
  EventuallyEq.of_eq <|
    condExp_of_stronglyMeasurable hY_meas.comap_le (comap_measurable Y).stronglyMeasurable hY

/- Theorem 8.14 (6): (iv) Tower property, first equality. If `𝒢 ≤ ℱ`, then conditioning
`P[X | ℱ]` further on `𝒢` gives `P[X | 𝒢]` almost surely. This is exactly
`MeasureTheory.condExp_condExp_of_le`. -/
recall condExp_condExp_of_le

-- Proof sketch: first note that `P[X | 𝒢]` is `𝒢`-measurable, hence also `ℱ`-measurable because
-- `𝒢 ≤ ℱ`; then apply `MeasureTheory.condExp_of_stronglyMeasurable`.
/-- Theorem 8.14 (7): (iv) Tower property, second equality. If `𝒢 ≤ ℱ`, then
`P[P[X | 𝒢] | ℱ] = P[X | 𝒢]` almost surely. -/
theorem condExp_tower_right_ae_eq {ℱ 𝒢 : MeasurableSpace Ω} (hℱ : ℱ ≤ mΩ) (h𝒢ℱ : 𝒢 ≤ ℱ)
    [SigmaFinite (P.trim hℱ)] {X : Ω → ℝ} :
    P[P[X | 𝒢] | ℱ] =ᵐ[P] P[X | 𝒢] := by
  refine EventuallyEq.of_eq ?_
  exact condExp_of_stronglyMeasurable hℱ (stronglyMeasurable_condExp.mono h𝒢ℱ)
    integrable_condExp

-- Proof sketch: apply the real-valued conditional Jensen inequality
-- `MeasureTheory.integral_abs_condExp_le` pointwise in conditional-expectation form.
/-- Theorem 8.14 (8): (v) Triangle inequality. The absolute value of the conditional expectation
is bounded almost surely by the conditional expectation of the absolute value. -/
theorem abs_condExp_ae_le_condExp_abs {ℱ : MeasurableSpace Ω} {X : Ω → ℝ} (hX : Integrable X P) :
    |P[X | ℱ]| ≤ᵐ[P] P[fun ω ↦ |X ω| | ℱ] := by
  have h₁ : P[X | ℱ] ≤ᵐ[P] P[fun ω ↦ |X ω| | ℱ] :=
    condExp_mono hX hX.abs <| Filter.Eventually.of_forall fun ω ↦ le_abs_self (X ω)
  have h₂ : -P[X | ℱ] ≤ᵐ[P] P[fun ω ↦ |X ω| | ℱ] :=
    (condExp_neg X ℱ).symm.le.trans <|
      condExp_mono hX.neg hX.abs <| Filter.Eventually.of_forall fun ω ↦ neg_le_abs (X ω)
  filter_upwards [h₁, h₂] with ω hω₁ hω₂
  have hω₂' : -P[fun ω ↦ |X ω| | ℱ] ω ≤ P[X | ℱ] ω := by
    simpa using neg_le_neg hω₂
  exact abs_le.2 ⟨hω₂', hω₁⟩

section Probability

variable [IsProbabilityMeasure P]

/- Theorem 8.14 (9): (vi) If the σ-algebra generated by `X` is independent of `ℱ`, then
`P[X | ℱ]` is almost surely equal to the expectation of `X`. The canonical theorem is
`MeasureTheory.condExp_indep_eq`, applied with `m₁ = MeasurableSpace.comap X (borel ℝ)`. -/
recall condExp_indep_eq

-- Proof sketch: show that every `ℱ`-measurable event has probability `0` or `1`, deduce that
-- `ℱ` is independent of the σ-algebra generated by `X`, and invoke the previous independence
-- statement.
/-- Theorem 8.14 (10): (vii) If every `ℱ`-measurable event has probability `0` or `1`, then
`P[X | ℱ]` is almost surely equal to the expectation of `X`. -/
theorem condExp_zero_one_subalgebra_ae_eq {ℱ : MeasurableSpace Ω} (hℱ : ℱ ≤ mΩ) {X : Ω → ℝ}
    (hX_meas : Measurable[mΩ] X)
    (h_zero_one : ∀ A : Set Ω, MeasurableSet[ℱ] A → P A = 0 ∨ P A = 1) :
    P[X | ℱ] =ᵐ[P] fun _ ↦ P[X] := by
  -- First show that `ℱ` is independent of every ambient measurable event by the zero-one rule.
  have h_indep_full : Indep ℱ mΩ P := by
    rw [indep_iff_forall_indepSet]
    intro s t hs ht
    refine (indepSet_iff_measure_inter_eq_mul (hℱ _ hs) ht P).2 ?_
    rcases h_zero_one s hs with hs_zero | hs_one
    · rw [hs_zero, zero_mul]
      exact measure_mono_null Set.inter_subset_left hs_zero
    · have hs_compl_zero : P sᶜ = 0 := by
        have hs_compl_eq : P sᶜ = 1 - P s := by
          exact prob_compl_eq_one_sub (hℱ _ hs)
        simpa [hs_one] using hs_compl_eq
      calc
        P (s ∩ t) = P t := by
          rw [Set.inter_comm]
          exact measure_inter_conull hs_compl_zero
        _ = P s * P t := by rw [hs_one, one_mul]
  -- Then restrict the second σ-algebra to `σ(X)` and apply the independence theorem
  -- for conditional expectation.
  have h_indep_X : Indep (MeasurableSpace.comap X (borel ℝ)) ℱ P :=
    (indep_of_indep_of_le_right h_indep_full hX_meas.comap_le).symm
  simpa using
    condExp_indep_eq hX_meas.comap_le hℱ (comap_measurable X).stronglyMeasurable h_indep_X

end Probability

-- Helper for Theorem 8.14: the almost-sure limit of a dominated sequence inherits the same
-- pointwise domination.
private theorem ae_abs_limit_le_of_dominated_convergence {XSeq : ℕ → Ω → ℝ} {X Y : Ω → ℝ}
    (h_bound : ∀ n, ∀ᵐ ω ∂P, |XSeq n ω| ≤ Y ω)
    (h_lim : ∀ᵐ ω ∂P, Tendsto (fun n ↦ XSeq n ω) atTop (𝓝 (X ω))) :
    ∀ᵐ ω ∂P, |X ω| ≤ Y ω := by
  have hY_nonneg : 0 ≤ᵐ[P] Y := (h_bound 0).mono fun ω hω ↦ le_trans (abs_nonneg _) hω
  have hnorm :
      ∀ᵐ ω ∂P, ENNReal.ofReal ‖X ω‖ ≤ ENNReal.ofReal (Y ω) :=
    ae_norm_ofReal_f_le_bound
      (fun n ↦ by simpa [Real.norm_eq_abs] using h_bound n) h_lim
  filter_upwards [hnorm, hY_nonneg] with ω hω hω_nonneg
  exact (ENNReal.ofReal_le_ofReal_iff hω_nonneg).mp <| by
    simpa [Real.norm_eq_abs] using hω

-- Helper for Theorem 8.14: the almost-sure limit of an `L¹`-dominated sequence is integrable.
private theorem integrable_limit_of_dominated_convergence {XSeq : ℕ → Ω → ℝ} {X Y : Ω → ℝ}
    (hXSeq_meas : ∀ n, AEStronglyMeasurable[mΩ] (XSeq n) P)
    (hY : Integrable Y P) (h_bound : ∀ n, ∀ᵐ ω ∂P, |XSeq n ω| ≤ Y ω)
    (h_lim : ∀ᵐ ω ∂P, Tendsto (fun n ↦ XSeq n ω) atTop (𝓝 (X ω))) :
    Integrable X P := by
  -- The limit is a.e.-strongly measurable as an a.e. limit of a.e.-strongly measurable functions.
  have hX_meas : AEStronglyMeasurable[mΩ] X P :=
    aestronglyMeasurable_of_tendsto_ae _ hXSeq_meas h_lim
  -- The inherited domination by `Y` converts measurability into integrability.
  refine Integrable.mono' hY hX_meas ?_
  simpa [Real.norm_eq_abs] using ae_abs_limit_le_of_dominated_convergence h_bound h_lim

/-- Theorem 8.14 (11): (viii) Dominated convergence for conditional expectation, almost-sure
clause. If each `Xₙ` is a.e.-strongly measurable, `|Xₙ| ≤ Y` almost surely with `Y ∈ L¹(P)`, and
`Xₙ → X` almost surely, then the conditional expectations converge almost surely to `P[X | ℱ]`. -/
theorem tendsto_ae_condExp_of_dominated_convergence {ℱ : MeasurableSpace Ω}
    (hℱ : ℱ ≤ mΩ) [SigmaFinite (P.trim hℱ)] {XSeq : ℕ → Ω → ℝ} {X Y : Ω → ℝ}
    (hXSeq_meas : ∀ n, AEStronglyMeasurable[mΩ] (XSeq n) P)
    (hY : Integrable Y P) (h_bound : ∀ n, ∀ᵐ ω ∂P, |XSeq n ω| ≤ Y ω)
    (h_lim : ∀ᵐ ω ∂P, Tendsto (fun n ↦ XSeq n ω) atTop (𝓝 (X ω))) :
    ∀ᵐ ω ∂P, Tendsto (fun n ↦ P[XSeq n | ℱ] ω) atTop (𝓝 (P[X | ℱ] ω)) := by
  letI : MeasurableSpace Ω := mΩ
  have hY_nonneg : 0 ≤ᵐ[P] Y := (h_bound 0).mono fun ω hω ↦ le_trans (abs_nonneg _) hω
  -- The source-proof route starts by recording that the pointwise limit is still dominated by `Y`,
  -- hence integrable, before introducing the tail envelope that controls the conditional
  -- expectations.
  have hX_dom : ∀ᵐ ω ∂P, |X ω| ≤ Y ω :=
    ae_abs_limit_le_of_dominated_convergence h_bound h_lim
  have hX : Integrable X P :=
    integrable_limit_of_dominated_convergence hXSeq_meas hY h_bound h_lim
  -- Route correction: we now build one measurable representative sequence and run the textbook
  -- tail-envelope argument on that common version instead of trying to compare the raw functions
  -- pointwise across different null sets.
  let X0 : Ω → ℝ := hX.1.mk X
  have hX0_meas : Measurable[mΩ] X0 := by
    dsimp [X0]
    exact hX.1.measurable_mk
  have hX_eq_X0 : X =ᵐ[P] X0 := by
    dsimp [X0]
    exact hX.1.ae_eq_mk
  have hX0_dom : ∀ᵐ ω ∂P, |X0 ω| ≤ Y ω := by
    filter_upwards [hX_dom, hX_eq_X0] with ω hω_dom hω_eq
    simpa [hω_eq] using hω_dom
  -- We package the convergence and domination hypotheses into one property for `aeSeq`.
  have hX0_lim : ∀ᵐ ω ∂P, Tendsto (fun n ↦ XSeq n ω) atTop (𝓝 (X0 ω)) := by
    filter_upwards [h_lim, hX_eq_X0] with ω hω_lim hω_eq
    simpa [hω_eq] using hω_lim
  have h_bound_all : ∀ᵐ ω ∂P, ∀ n, |XSeq n ω| ≤ Y ω := by
    rw [ae_all_iff]
    exact h_bound
  let hf : ∀ n, AEMeasurable[mΩ] (XSeq n) P := fun n ↦ (hXSeq_meas n).aemeasurable
  let p : Ω → (ℕ → ℝ) → Prop := fun ω f ↦
    Tendsto (fun n ↦ f n) atTop (𝓝 (X0 ω)) ∧ ∀ n, |f n| ≤ Y ω
  have hp : ∀ᵐ ω ∂P, p ω (fun n ↦ XSeq n ω) := by
    filter_upwards [hX0_lim, h_bound_all] with ω hω_lim hω_bound
    exact ⟨hω_lim, hω_bound⟩
  let Xrep : ℕ → Ω → ℝ := aeSeq hf p
  have hXrep_meas : ∀ n, Measurable[mΩ] (Xrep n) := by
    intro n
    simpa [Xrep] using aeSeq.measurable hf p n
  have hXrep_eq : ∀ n, Xrep n =ᵐ[P] XSeq n := by
    intro n
    simpa [Xrep] using aeSeq.aeSeq_n_eq_fun_n_ae hf hp n
  have hXrep_prop : ∀ᵐ ω ∂P,
      Tendsto (fun n ↦ Xrep n ω) atTop (𝓝 (X0 ω)) ∧ ∀ n, |Xrep n ω| ≤ Y ω := by
    have hmem : ∀ᵐ ω ∂P, ω ∈ aeSeqSet hf p := by
      exact ae_iff.2 (aeSeq.measure_compl_aeSeqSet_eq_zero hf hp)
    filter_upwards [hmem] with ω hω
    simpa [Xrep] using aeSeq.prop_of_mem_aeSeqSet hf hω
  -- Each original term is integrable because it is dominated by the same `L¹` function `Y`.
  have hXSeq_int : ∀ n, Integrable (XSeq n) P := by
    intro n
    refine Integrable.mono' hY (hXSeq_meas n) ?_
    simpa [Real.norm_eq_abs] using h_bound n
  have h2Y : Integrable (fun ω ↦ 2 * Y ω) P := by
    simpa using hY.const_mul (2 : ℝ)
  let Z : ℕ → Ω → ℝ := fun n ω ↦ ⨆ k : ℕ, |Xrep (n + k) ω - X0 ω|
  have hZ_meas : ∀ n, Measurable[mΩ] (Z n) := by
    intro n
    have hterm_meas : ∀ k : ℕ, Measurable[mΩ] (fun ω ↦ |Xrep (n + k) ω - X0 ω|) := by
      intro k
      have hsub_meas : Measurable[mΩ] (fun ω ↦ Xrep (n + k) ω - X0 ω) := by
        exact (hXrep_meas (n + k)).sub hX0_meas
      show Measurable[mΩ] (fun ω ↦ |Xrep (n + k) ω - X0 ω|)
      exact hsub_meas.abs
    show Measurable[mΩ] (fun ω ↦ ⨆ k : ℕ, |Xrep (n + k) ω - X0 ω|)
    exact Measurable.iSup hterm_meas
  -- On the common good set, the tail envelope is nonnegative, bounded by `2Y`, and antitone.
  have hZ_nonneg : ∀ n, 0 ≤ᵐ[P] Z n := by
    intro n
    filter_upwards [hXrep_prop, hX0_dom] with ω hω_prop hω_X0dom
    have hterm_bound : ∀ k, |Xrep (n + k) ω - X0 ω| ≤ 2 * Y ω := by
      intro k
      calc
        |Xrep (n + k) ω - X0 ω| ≤ |Xrep (n + k) ω| + |X0 ω| := by
          simpa using abs_sub (Xrep (n + k) ω) (X0 ω)
        _ ≤ Y ω + Y ω := add_le_add (hω_prop.2 (n + k)) hω_X0dom
        _ = 2 * Y ω := by ring
    have hbd : BddAbove (Set.range fun k : ℕ ↦ |Xrep (n + k) ω - X0 ω|) :=
      ⟨2 * Y ω, by
        rintro _ ⟨k, rfl⟩
        exact hterm_bound k⟩
    dsimp [Z]
    exact le_ciSup_of_le hbd 0 (by simp)
  have hZ_le : ∀ n, Z n ≤ᵐ[P] fun ω ↦ 2 * Y ω := by
    intro n
    filter_upwards [hXrep_prop, hX0_dom] with ω hω_prop hω_X0dom
    have hterm_bound : ∀ k, |Xrep (n + k) ω - X0 ω| ≤ 2 * Y ω := by
      intro k
      calc
        |Xrep (n + k) ω - X0 ω| ≤ |Xrep (n + k) ω| + |X0 ω| := by
          simpa using abs_sub (Xrep (n + k) ω) (X0 ω)
        _ ≤ Y ω + Y ω := add_le_add (hω_prop.2 (n + k)) hω_X0dom
        _ = 2 * Y ω := by ring
    have hbd : BddAbove (Set.range fun k : ℕ ↦ |Xrep (n + k) ω - X0 ω|) :=
      ⟨2 * Y ω, by
        rintro _ ⟨k, rfl⟩
        exact hterm_bound k⟩
    dsimp [Z]
    exact (ciSup_le_iff hbd).2 hterm_bound
  have hZ_int : ∀ n, Integrable (Z n) P := by
    intro n
    refine Integrable.mono' h2Y (hZ_meas n).aestronglyMeasurable ?_
    filter_upwards [hZ_nonneg n, hZ_le n] with ω hω_nonneg hω_le
    simpa [Real.norm_eq_abs, abs_of_nonneg hω_nonneg] using hω_le
  have hZ_antitone : ∀ᵐ ω ∂P, ∀ n m, n ≤ m → Z m ω ≤ Z n ω := by
    filter_upwards [hXrep_prop, hX0_dom] with ω hω_prop hω_X0dom
    intro n m hnm
    have hterm_bound : ∀ k, |Xrep (n + k) ω - X0 ω| ≤ 2 * Y ω := by
      intro k
      calc
        |Xrep (n + k) ω - X0 ω| ≤ |Xrep (n + k) ω| + |X0 ω| := by
          simpa using abs_sub (Xrep (n + k) ω) (X0 ω)
        _ ≤ Y ω + Y ω := add_le_add (hω_prop.2 (n + k)) hω_X0dom
        _ = 2 * Y ω := by ring
    have hbd : BddAbove (Set.range fun k : ℕ ↦ |Xrep (n + k) ω - X0 ω|) :=
      ⟨2 * Y ω, by
        rintro _ ⟨k, rfl⟩
        exact hterm_bound k⟩
    dsimp [Z]
    refine ciSup_le ?_
    intro k
    refine le_ciSup_of_le hbd (m - n + k) ?_
    have hk : m + k = n + (m - n + k) := by
      omega
    simp [hk]
  -- The tail envelope tends to zero pointwise on the same good set because the original sequence
  -- converges to `X0`.
  have hZ_tendsto_zero : ∀ᵐ ω ∂P, Tendsto (fun n ↦ Z n ω) atTop (𝓝 0) := by
    filter_upwards [hXrep_prop, hX0_dom] with ω hω_prop hω_X0dom
    let u : ℕ → ℝ := fun n ↦ |Xrep n ω - X0 ω|
    have hu_nonneg : ∀ n, 0 ≤ u n := by
      intro n
      exact abs_nonneg _
    have hu_bound : ∀ n, u n ≤ 2 * Y ω := by
      intro n
      calc
        u n = |Xrep n ω - X0 ω| := rfl
        _ ≤ |Xrep n ω| + |X0 ω| := by
          simpa using abs_sub (Xrep n ω) (X0 ω)
        _ ≤ Y ω + Y ω := add_le_add (hω_prop.2 n) hω_X0dom
        _ = 2 * Y ω := by ring
    have hu_tendsto : Tendsto u atTop (𝓝 0) := by
      have hsub : Tendsto (fun n ↦ Xrep n ω - X0 ω) atTop (𝓝 0) := by
        simpa using hω_prop.1.sub
          (tendsto_const_nhds : Tendsto (fun _ : ℕ ↦ X0 ω) atTop (𝓝 (X0 ω)))
      simpa [u] using hsub.abs
    refine Metric.tendsto_atTop.2 ?_
    intro ε hε
    obtain ⟨N, hN⟩ := (Metric.tendsto_atTop.1 hu_tendsto) (ε / 2) (by positivity)
    refine ⟨N, fun n hn ↦ ?_⟩
    have htail_lt : ∀ k : ℕ, u (n + k) < ε / 2 := by
      intro k
      have hk := hN (n + k) (le_trans hn (Nat.le_add_right _ _))
      simpa [Real.dist_eq, abs_of_nonneg (hu_nonneg (n + k))] using hk
    have hbd : BddAbove (Set.range fun k : ℕ ↦ u (n + k)) :=
      ⟨ε / 2, by
        rintro _ ⟨k, rfl⟩
        exact le_of_lt (htail_lt k)⟩
    have hsup_le : (⨆ k : ℕ, u (n + k) : ℝ) ≤ ε / 2 := (ciSup_le_iff hbd).2 fun k ↦
      le_of_lt (htail_lt k)
    have hsup_nonneg : 0 ≤ (⨆ k : ℕ, u (n + k) : ℝ) := by
      exact le_ciSup_of_le hbd 0 (by simpa using hu_nonneg n)
    have hsup_lt : (⨆ k : ℕ, u (n + k) : ℝ) < ε := by
      linarith
    simpa [Z, u, Real.dist_eq, abs_of_nonneg hsup_nonneg] using hsup_lt
  -- The conditional expectations of the tail envelopes also converge to `0` almost surely.
  have hcondZ_nonneg : ∀ᵐ ω ∂P, ∀ n, 0 ≤ P[Z n | ℱ] ω := by
    rw [ae_all_iff]
    intro n
    exact condExp_nonneg (hZ_nonneg n)
  have hcondZ_antitone : ∀ᵐ ω ∂P, Antitone (fun n ↦ P[Z n | ℱ] ω) := by
    have hstep : ∀ᵐ ω ∂P, ∀ n m, n ≤ m → P[Z m | ℱ] ω ≤ P[Z n | ℱ] ω := by
      rw [ae_all_iff]
      intro n
      rw [ae_all_iff]
      intro m
      by_cases hnm : n ≤ m
      · exact (condExp_mono (hZ_int m) (hZ_int n) <|
            hZ_antitone.mono fun ω hω ↦ hω n m hnm).mono fun ω hω _ ↦ hω
      · exact Filter.Eventually.of_forall fun ω hω ↦ False.elim (hnm hω)
    exact hstep.mono fun ω hω n m hnm ↦ hω n m hnm
  have hZ_integral_tendsto : Tendsto (fun n ↦ ∫ ω, Z n ω ∂P) atTop (𝓝 0) := by
    have hZ_norm_bound : ∀ n, ∀ᵐ ω ∂P, ‖Z n ω‖ ≤ 2 * Y ω := by
      intro n
      filter_upwards [hZ_nonneg n, hZ_le n] with ω hω_nonneg hω_le
      simpa [Real.norm_eq_abs, abs_of_nonneg hω_nonneg] using hω_le
    simpa using
      (tendsto_integral_of_dominated_convergence (fun ω ↦ 2 * Y ω)
        (fun n ↦ (hZ_meas n).aestronglyMeasurable) h2Y hZ_norm_bound hZ_tendsto_zero)
  have hcondZ_integral_tendsto :
      Tendsto (fun n ↦ ∫ ω, P[Z n | ℱ] ω ∂P) atTop (𝓝 0) := by
    convert hZ_integral_tendsto using 1
    ext n
    rw [integral_condExp hℱ]
  have hcondZ_tendsto_zero : ∀ᵐ ω ∂P, Tendsto (fun n ↦ P[Z n | ℱ] ω) atTop (𝓝 0) := by
    have hcondZ_integral_tendsto' :
        Tendsto (fun n ↦ ∫ ω, P[Z n | ℱ] ω ∂P) atTop (𝓝 (∫ ω, (0 : ℝ) ∂P)) := by
      simpa using hcondZ_integral_tendsto
    exact tendsto_of_integral_tendsto_of_antitone
      (fun n ↦ integrable_condExp)
      (integrable_zero _ _ P)
      hcondZ_integral_tendsto'
      hcondZ_antitone hcondZ_nonneg
  -- The conditional expectation difference is squeezed by the conditional expectation of `Z n`.
  have hcond_diff_le : ∀ n, |P[XSeq n | ℱ] - P[X | ℱ]| ≤ᵐ[P] P[Z n | ℱ] := by
    intro n
    have hdiff_bound : ∀ᵐ ω ∂P, |XSeq n ω - X ω| ≤ Z n ω := by
      filter_upwards [hXrep_prop, hX0_dom, hXrep_eq n, hX_eq_X0] with ω hω_prop hω_X0dom hω_rep hω_X0
      have hterm_bound : ∀ k, |Xrep (n + k) ω - X0 ω| ≤ 2 * Y ω := by
        intro k
        calc
          |Xrep (n + k) ω - X0 ω| ≤ |Xrep (n + k) ω| + |X0 ω| := by
            simpa using abs_sub (Xrep (n + k) ω) (X0 ω)
          _ ≤ Y ω + Y ω := add_le_add (hω_prop.2 (n + k)) hω_X0dom
          _ = 2 * Y ω := by ring
      have hbd : BddAbove (Set.range fun k : ℕ ↦ |Xrep (n + k) ω - X0 ω|) :=
        ⟨2 * Y ω, by
          rintro _ ⟨k, rfl⟩
          exact hterm_bound k⟩
      calc
        |XSeq n ω - X ω| = |Xrep n ω - X0 ω| := by simp [hω_rep, hω_X0]
        _ ≤ Z n ω := by
          dsimp [Z]
          exact le_ciSup_of_le hbd 0 (by simp)
    have hsub := condExp_sub (hXSeq_int n) hX ℱ
    have habs :
        |P[fun ω ↦ XSeq n ω - X ω | ℱ]| ≤ᵐ[P] P[fun ω ↦ |XSeq n ω - X ω| | ℱ] :=
      abs_condExp_ae_le_condExp_abs ((hXSeq_int n).sub hX)
    have hmono : P[fun ω ↦ |XSeq n ω - X ω| | ℱ] ≤ᵐ[P] P[Z n | ℱ] :=
      condExp_mono (((hXSeq_int n).sub hX).abs) (hZ_int n) hdiff_bound
    filter_upwards [hsub, habs, hmono] with ω hω_sub hω_abs hω_mono
    calc
      |P[XSeq n | ℱ] ω - P[X | ℱ] ω| = |P[XSeq n - X | ℱ] ω| := by simp [hω_sub]
      _ ≤ P[fun ω ↦ |XSeq n ω - X ω| | ℱ] ω := by simpa using hω_abs
      _ ≤ P[Z n | ℱ] ω := hω_mono
  -- Finally, squeeze the conditional-expectation difference by the vanishing tail envelope.
  have hcond_diff_all : ∀ᵐ ω ∂P, ∀ n, |P[XSeq n | ℱ] ω - P[X | ℱ] ω| ≤ P[Z n | ℱ] ω := by
    rw [ae_all_iff]
    exact hcond_diff_le
  filter_upwards [hcond_diff_all, hcondZ_tendsto_zero] with ω hω_diff hω_Z
  have habs_tendsto :
      Tendsto (fun n ↦ |P[XSeq n | ℱ] ω - P[X | ℱ] ω|) atTop (𝓝 0) :=
    squeeze_zero (fun n ↦ abs_nonneg _) (fun n ↦ hω_diff n) hω_Z
  have hsub_tendsto :
      Tendsto (fun n ↦ P[XSeq n | ℱ] ω - P[X | ℱ] ω) atTop (𝓝 0) :=
    (tendsto_iff_dist_tendsto_zero.2 <| by simpa [Real.dist_eq] using habs_tendsto)
  have hadd_tendsto :
      Tendsto (fun n ↦ (P[XSeq n | ℱ] ω - P[X | ℱ] ω) + P[X | ℱ] ω)
        atTop (𝓝 (0 + P[X | ℱ] ω)) :=
    hsub_tendsto.add tendsto_const_nhds
  simpa using hadd_tendsto

/-- Theorem 8.14 (12): (viii) Dominated convergence for conditional expectation, `L¹(P)` clause.
If each `Xₙ` is a.e.-strongly measurable, `|Xₙ| ≤ Y` almost surely with `Y ∈ L¹(P)`, and
`Xₙ → X` almost surely, then the conditional expectations converge in `L¹(P)`. This is the
real-valued pointwise-conditional-expectation form of mathlib's canonical
`MeasureTheory.tendsto_condExpL1_of_dominated_convergence`. -/
theorem tendsto_eLpNorm_condExp_of_dominated_convergence {ℱ : MeasurableSpace Ω}
    (hℱ : ℱ ≤ mΩ) [SigmaFinite (P.trim hℱ)] {XSeq : ℕ → Ω → ℝ} {X Y : Ω → ℝ}
    (hXSeq_meas : ∀ n, AEStronglyMeasurable[mΩ] (XSeq n) P)
    (hY : Integrable Y P) (h_bound : ∀ n, ∀ᵐ ω ∂P, |XSeq n ω| ≤ Y ω)
    (h_lim : ∀ᵐ ω ∂P, Tendsto (fun n ↦ XSeq n ω) atTop (𝓝 (X ω))) :
    Tendsto (fun n ↦ eLpNorm (P[XSeq n | ℱ] - P[X | ℱ]) 1 P) atTop (𝓝 0) := by
  have hcond :
      Tendsto (fun n ↦ condExpL1 hℱ P (XSeq n)) atTop (𝓝 (condExpL1 hℱ P X)) :=
    tendsto_condExpL1_of_dominated_convergence hℱ Y hXSeq_meas hY
      (fun n ↦ (h_bound n).mono fun ω hω ↦ by simpa [Real.norm_eq_abs] using hω) h_lim
  have hnorm :
      Tendsto
        (fun n ↦ eLpNorm (⇑(condExpL1 hℱ P (XSeq n)) - ⇑(condExpL1 hℱ P X)) 1 P)
        atTop (𝓝 0) :=
    (MeasureTheory.Lp.tendsto_Lp_iff_tendsto_eLpNorm'
      (fun n ↦ condExpL1 hℱ P (XSeq n)) (condExpL1 hℱ P X)).mp hcond
  have h_eq :
      (fun n ↦ eLpNorm (⇑(condExpL1 hℱ P (XSeq n)) - ⇑(condExpL1 hℱ P X)) 1 P) =
        fun n ↦ eLpNorm (P[XSeq n | ℱ] - P[X | ℱ]) 1 P := by
    funext n
    apply eLpNorm_congr_ae
    exact ((condExp_ae_eq_condExpL1 hℱ (XSeq n)).symm.sub (condExp_ae_eq_condExpL1 hℱ X).symm)
  simpa [h_eq] using hnorm
