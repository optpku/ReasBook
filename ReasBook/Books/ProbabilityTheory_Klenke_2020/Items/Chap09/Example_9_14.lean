import Mathlib

-- Declarations for this item will be appended below by the statement pipeline.

open MeasureTheory

universe u

namespace ProbabilityTheory

variable {Ω : Type u} [MeasurableSpace Ω]

/-- The first `n` outcomes of a coin-toss process, viewed as a history indexed by `Fin n`. -/
def coinTossHistory (D : ℕ → Ω → Bool) (n : ℕ) : Ω → Fin n → Bool :=
  fun ω i ↦ D i.1 ω

section

variable {D : ℕ → Ω → Bool} (hD : ∀ n, Measurable (D n))

/-- The length-`n` coin-toss history is measurable whenever each single toss is measurable. -/
theorem coinTossHistory_measurable (hD : ∀ n, Measurable (D n)) (n : ℕ) :
    Measurable (coinTossHistory D n) := by
  simpa [coinTossHistory] using measurable_pi_lambda (coinTossHistory D n) fun i ↦ hD (i.1)

omit [MeasurableSpace Ω] in
private lemma coinTossHistory_prefix_factorsThrough {m n : ℕ} (hmn : m ≤ n) :
    (coinTossHistory D m).FactorsThrough (coinTossHistory D n) := by
  intro ω ω' hω
  ext i
  exact congr_fun hω ⟨i.1, lt_of_lt_of_le i.2 hmn⟩

/-- The filtration generated by the finite-history process
`ω ↦ (D₀(ω), ..., D_{n-1}(ω))`. -/
def coinTossHistoryFiltration : Filtration ℕ ‹MeasurableSpace Ω› :=
  Filtration.natural (coinTossHistory D) fun n ↦
    Measurable.stronglyMeasurable (coinTossHistory_measurable hD n)

/-- The time-`n` σ-algebra of `coinTossHistoryFiltration D hD` is the pullback along the
length-`n` history map. -/
theorem coinTossHistoryFiltration_apply (n : ℕ) :
    coinTossHistoryFiltration hD n =
      MeasurableSpace.comap (coinTossHistory D n) inferInstance := by
  change (⨆ m ≤ n, MeasurableSpace.comap (coinTossHistory D m) inferInstance) =
    MeasurableSpace.comap (coinTossHistory D n) inferInstance
  apply le_antisymm
  · refine iSup₂_le fun m hmn ↦ ?_
    rcases (Function.factorsThrough_iff (coinTossHistory D m)).1
        (coinTossHistory_prefix_factorsThrough hmn) with ⟨e, he⟩
    rw [he]
    exact ((measurable_of_finite e).comp (comap_measurable (coinTossHistory D n))).comap_le
  · exact le_iSup_of_le n <| le_iSup_of_le le_rfl le_rfl

/- Example 9.14: in the `0`-based Lean indexing, the filtration recording the past coin tosses up
to time `n` is the natural filtration of the finite-history process `n ↦ coinTossHistory D n`. A
betting strategy is predictable for this shifted history filtration exactly when the initial stake
is constant and each later stake `H (n + 1)` depends only on the first `n` tosses. The canonical
owner abstraction for the history-dependence clause is `Function.FactorsThrough`. -/
-- Proof sketch: apply Mathlib's discrete characterization
-- `isPredictable_iff_measurable_add_one` to the natural filtration of the history process. The
-- time-`n` σ-algebra of that filtration is exactly `MeasurableSpace.comap (coinTossHistory D n)`,
-- so the measurable clauses are equivalent to factorization through the length-`n` history.
theorem predictable_iff_factorsThrough_coinTossHistory {H : ℕ → Ω → ℕ} :
    IsPredictable (coinTossHistoryFiltration hD) H ↔
      (H 0).FactorsThrough (coinTossHistory D 0) ∧
        ∀ n, (H (n + 1)).FactorsThrough (coinTossHistory D n) := by
  rw [isPredictable_iff_measurable_add_one]
  constructor
  · rintro ⟨h0, hsucc⟩
    refine ⟨?_, ?_⟩
    · rw [coinTossHistoryFiltration_apply hD 0] at h0
      exact h0.factorsThrough
    · intro n
      have hsucc' := hsucc n
      rw [coinTossHistoryFiltration_apply hD n] at hsucc'
      exact hsucc'.factorsThrough
  · intro h
    refine ⟨?_, ?_⟩
    · rw [coinTossHistoryFiltration_apply hD 0]
      rcases (Function.factorsThrough_iff (H 0)).1 h.1 with ⟨e, he⟩
      rw [he]
      simpa using (measurable_of_finite e).comp (comap_measurable (coinTossHistory D 0))
    · intro n
      rw [coinTossHistoryFiltration_apply hD n]
      rcases (Function.factorsThrough_iff (H (n + 1))).1 (h.2 n) with ⟨e, he⟩
      rw [he]
      simpa using (measurable_of_finite e).comp (comap_measurable (coinTossHistory D n))

end

end ProbabilityTheory
