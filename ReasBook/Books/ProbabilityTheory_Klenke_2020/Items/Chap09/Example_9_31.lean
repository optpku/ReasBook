import Mathlib
import Books.ProbabilityTheory_Klenke_2020.Items.Chap10.Example_10_7

-- Declarations for this item will be appended below by the statement pipeline.

open MeasureTheory ProbabilityTheory
open scoped BigOperators ProbabilityTheory

universe u

variable {Ω : Type u} [MeasurableSpace Ω]

/- The source-facing factor process generating the textbook filtration
`σ(Y₁, ..., Y_t)`, written in Lean by adjoining the constant `1` at time `0`. -/
def multiplicativeFactorProcess (Y : ℕ → Ω → ℝ) : ℕ → Ω → ℝ
  | 0 => fun _ ↦ 1
  | n + 1 => Y (n + 1)

/-- If the factors `Y₁, Y₂, ...` are measurable, then the source-facing factor process
`1, Y₁, Y₂, ...` is strongly measurable. -/
theorem stronglyMeasurable_multiplicativeFactorProcess {Y : ℕ → Ω → ℝ}
    (hY : ∀ n, Measurable (Y (n + 1))) :
    ∀ n, StronglyMeasurable (multiplicativeFactorProcess Y n)
  | 0 => by simpa [multiplicativeFactorProcess] using stronglyMeasurable_const
  | n + 1 => by
      simpa [multiplicativeFactorProcess] using (hY n).stronglyMeasurable

-- Proof sketch: induct on `n`; the recursive step rewrites `X (n + 1)` using
-- `multiplicativeProcess_succ` and then expands the product over `Finset.range (n + 1)`.
/-- The multiplicative process agrees with the textbook formula
`X_t = ∏_{s=1}^t Y_s`, encoded in Lean as a product over `Finset.range t`. -/
theorem multiplicativeProcess_eq_prod {Y : ℕ → Ω → ℝ} (n : ℕ) (ω : Ω) :
    multiplicativeProcess Y n ω =
      Finset.prod (Finset.range n) (fun s ↦ Y (s + 1) ω) := by
  induction n with
  | zero =>
      -- At time `0`, both the recursive process and the empty product equal `1`.
      simp [multiplicativeProcess]
  | succ n ih =>
      -- The recursive step appends the new factor `Y (n + 1)` to the prefix product.
      simp [multiplicativeProcess_succ, ih, Finset.prod_range_succ]

/-- Helper for Example 9.31: the multiplicative process is strongly adapted to the natural
filtration generated by the prefixed factor process `1, Y₁, Y₂, ...`. -/
lemma multiplicativeProcess_stronglyAdapted_factorNatural {Y : ℕ → Ω → ℝ}
    (hY_meas : ∀ n, Measurable (Y (n + 1))) :
    StronglyAdapted
      (Filtration.natural (multiplicativeFactorProcess Y)
        (stronglyMeasurable_multiplicativeFactorProcess hY_meas))
      (multiplicativeProcess Y) := by
  let ℱ : Filtration ℕ ‹MeasurableSpace Ω› :=
    Filtration.natural (multiplicativeFactorProcess Y)
      (stronglyMeasurable_multiplicativeFactorProcess hY_meas)
  have hFactor : StronglyAdapted ℱ (multiplicativeFactorProcess Y) := by
    simpa [ℱ] using
      (Filtration.stronglyAdapted_natural
        (stronglyMeasurable_multiplicativeFactorProcess hY_meas))
  intro n
  induction n with
  | zero =>
      -- The initial stage is the constant process `1`.
      simpa [ℱ, multiplicativeProcess] using
        (stronglyMeasurable_const : StronglyMeasurable[ℱ 0] (fun _ : Ω ↦ (1 : ℝ)))
  | succ n ih =>
      have hPrev : StronglyMeasurable[ℱ (n + 1)] (multiplicativeProcess Y n) :=
        ih.mono (ℱ.mono (Nat.le_succ n))
      have hNextFactor : StronglyMeasurable[ℱ (n + 1)] (multiplicativeFactorProcess Y (n + 1)) :=
        hFactor (n + 1)
      -- Move the previous stage forward along the filtration and multiply by the new factor.
      simpa [multiplicativeProcess_succ, multiplicativeFactorProcess] using
        hPrev.mul hNextFactor

/-- Helper for Example 9.31: if the independent factors have mean `1`, then every multiplicative
partial product is integrable. -/
lemma multiplicativeProcess_integrable_of_mean_one
    {μ : Measure Ω} [IsProbabilityMeasure μ] {Y : ℕ → Ω → ℝ}
    (hY_meas : ∀ n, Measurable (Y (n + 1)))
    (hY_indep : iIndepFun (fun n ↦ Y (n + 1)) μ)
    (hY_mean_one : ∀ n, μ[(Y (n + 1))] = 1) :
    ∀ n, Integrable (multiplicativeProcess Y n) μ := by
  intro n
  induction n with
  | zero =>
      -- The initial value is the integrable constant `1`.
      simpa [multiplicativeProcess] using (integrable_const (1 : ℝ))
  | succ n ih =>
      have hFactorInt : Integrable (Y (n + 1)) μ := by
        exact integrable_of_integral_eq_one (hY_mean_one n)
      have hIndep :
          IndepFun (multiplicativeProcess Y n) (Y (n + 1)) μ := by
        -- Rewrite the past product into the canonical finite-product form used by the
        -- independence API for independent families.
        refine (hY_indep.indepFun_prod_range_succ hY_meas n).congr ?_ Filter.EventuallyEq.rfl
        exact Filter.Eventually.of_forall fun ω ↦ by
          simpa using (multiplicativeProcess_eq_prod (Y := Y) n ω).symm
      -- The next stage is a product of independent integrable factors.
      simpa [multiplicativeProcess_succ] using
        ProbabilityTheory.IndepFun.integrable_mul hIndep ih hFactorInt

/-- Helper for Example 9.31: the next factor has conditional expectation `1` with respect to the
filtration generated by the previous factors. -/
lemma condExp_nextFactor_factorNatural_ae_eq_one
    {μ : Measure Ω} [IsProbabilityMeasure μ] {Y : ℕ → Ω → ℝ}
    (hY_meas : ∀ n, Measurable (Y (n + 1)))
    (hY_indep : iIndepFun (fun n ↦ Y (n + 1)) μ)
    (hY_mean_one : ∀ n, μ[(Y (n + 1))] = 1) :
    ∀ n,
      μ[Y (n + 1) |
          Filtration.natural (multiplicativeFactorProcess Y)
            (stronglyMeasurable_multiplicativeFactorProcess hY_meas) n] =ᵐ[μ]
        fun _ ↦ 1 := by
  let ℱ : Filtration ℕ ‹MeasurableSpace Ω› :=
    Filtration.natural (multiplicativeFactorProcess Y)
      (stronglyMeasurable_multiplicativeFactorProcess hY_meas)
  let 𝒢 : Filtration ℕ ‹MeasurableSpace Ω› :=
    Filtration.natural (fun k ↦ Y (k + 1)) fun k ↦ (hY_meas k).stronglyMeasurable
  intro n
  cases n with
  | zero =>
      have hℱzero : ℱ 0 = ⊥ := by
        -- At time `0`, the factor filtration only sees the constant coordinate `1`.
        change (⨆ j ≤ 0, MeasurableSpace.comap (multiplicativeFactorProcess Y j) (borel ℝ)) = ⊥
        simp [multiplicativeFactorProcess, MeasurableSpace.comap_const]
      have hbot : μ[Y 1 | ℱ 0] =ᵐ[μ] fun _ ↦ μ[Y 1] := by
        simpa [ℱ, hℱzero] using
          (EventuallyEq.of_eq (MeasureTheory.condExp_bot (μ := μ) (f := Y 1)))
      -- Conditioning on the trivial sigma-algebra returns the mean of `Y₁`.
      exact hbot.trans <| Filter.Eventually.of_forall fun _ ↦ hY_mean_one 0
  | succ n =>
      have hℱsucc : ℱ (n + 1) = 𝒢 n := by
        -- Discard the constant zeroth coordinate; the remaining generators are `Y₁, ..., Yₙ₊₁`.
        change (⨆ j ≤ n + 1, MeasurableSpace.comap (multiplicativeFactorProcess Y j) (borel ℝ)) =
            ⨆ j ≤ n, MeasurableSpace.comap (Y (j + 1)) (borel ℝ)
        refine le_antisymm ?_ ?_
        · refine iSup₂_le ?_
          intro j hj
          cases j with
          | zero =>
              simpa [multiplicativeFactorProcess, MeasurableSpace.comap_const]
          | succ k =>
              have hk : k ≤ n := Nat.succ_le_succ_iff.mp hj
              simpa [multiplicativeFactorProcess] using
                (le_iSup_of_le k <| le_iSup_of_le hk le_rfl :
                  MeasurableSpace.comap (Y (k + 1)) (borel ℝ) ≤
                    ⨆ j ≤ n, MeasurableSpace.comap (Y (j + 1)) (borel ℝ))
        · refine iSup₂_le ?_
          intro j hj
          simpa [multiplicativeFactorProcess] using
            (le_iSup_of_le (j + 1) <| le_iSup_of_le (Nat.succ_le_succ hj) le_rfl :
              MeasurableSpace.comap (multiplicativeFactorProcess Y (j + 1)) (borel ℝ) ≤
                ⨆ i ≤ n + 1, MeasurableSpace.comap (multiplicativeFactorProcess Y i) (borel ℝ))
      -- After removing the constant zeroth coordinate, the standard independence lemma applies.
      have hnat :
          μ[Y (n + 2) | 𝒢 n] =ᵐ[μ] fun _ ↦ μ[Y (n + 2)] := by
        simpa [𝒢] using
          (ProbabilityTheory.iIndepFun.condExp_natural_ae_eq_of_lt
            (f := fun k ↦ Y (k + 1))
            (fun k ↦ (hY_meas k).stronglyMeasurable) hY_indep (Nat.lt_succ_self n))
      have hlift : μ[Y (n + 2) | ℱ (n + 1)] =ᵐ[μ] fun _ ↦ μ[Y (n + 2)] := by
        simpa [ℱ, hℱsucc] using hnat
      exact hlift.trans <| Filter.Eventually.of_forall fun _ ↦ hY_mean_one (n + 1)

-- Proof sketch: derive `Integrable (Y (n + 1)) μ` from `μ[Y (n + 1)] = 1` via
-- `MeasureTheory.integrable_of_integral_eq_one`, observe that the product process is adapted to
-- the natural filtration generated by `1, Y_1, ..., Y_t`, and then apply
-- `MeasureTheory.martingale_nat` to the one-step identity
-- `μ[X (n + 1) | 𝓕 n] = X n * μ[Y (n + 1) | 𝓕 n] = X n`.
/-- Example 9.31: if `(Y_{n+1})` is an independent sequence of real random variables with
expectation `1` (hence integrable), then the multiplicative partial-product process
`X_t = ∏_{s=1}^t Y_s` is a martingale with respect to the filtration generated by
`Y_1, ..., Y_t`. -/
theorem multiplicativeProcess_martingale_of_iIndepFun_mean_one
    {μ : Measure Ω} [IsProbabilityMeasure μ] {Y : ℕ → Ω → ℝ}
    (hY_meas : ∀ n, Measurable (Y (n + 1)))
    (hY_indep : iIndepFun (fun n ↦ Y (n + 1)) μ)
    (hY_mean_one : ∀ n, μ[(Y (n + 1))] = 1) :
    Martingale (multiplicativeProcess Y)
      (Filtration.natural (multiplicativeFactorProcess Y)
        (stronglyMeasurable_multiplicativeFactorProcess hY_meas))
      μ := by
  let ℱ : Filtration ℕ ‹MeasurableSpace Ω› :=
    Filtration.natural (multiplicativeFactorProcess Y)
      (stronglyMeasurable_multiplicativeFactorProcess hY_meas)
  have hXadapt : StronglyAdapted ℱ (multiplicativeProcess Y) := by
    simpa [ℱ] using
      multiplicativeProcess_stronglyAdapted_factorNatural (Y := Y) hY_meas
  have hXint : ∀ n, Integrable (multiplicativeProcess Y n) μ :=
    multiplicativeProcess_integrable_of_mean_one
      (μ := μ) (Y := Y) hY_meas hY_indep hY_mean_one
  have hCondFactor : ∀ n, μ[Y (n + 1) | ℱ n] =ᵐ[μ] fun _ ↦ 1 := by
    simpa [ℱ] using
      condExp_nextFactor_factorNatural_ae_eq_one
        (μ := μ) (Y := Y) hY_meas hY_indep hY_mean_one
  have hMartingale : Martingale (multiplicativeProcess Y) ℱ μ := by
    -- The nat-index martingale criterion reduces the proof to the one-step conditional
    -- expectation identity `E[Xₙ₊₁ | ℱₙ] = Xₙ`.
    refine martingale_nat hXadapt hXint ?_
    intro n
    have hFactorInt : Integrable (Y (n + 1)) μ := by
      exact integrable_of_integral_eq_one (hY_mean_one n)
    have hProdInt : Integrable (fun ω ↦ Y (n + 1) ω * multiplicativeProcess Y n ω) μ := by
      -- Rewrite the pulled-out product as the next process value `Xₙ₊₁`.
      simpa [multiplicativeProcess_succ, mul_comm] using hXint (n + 1)
    -- Pull the past product out of the conditional expectation and replace the next factor by
    -- its conditional mean `1`.
    calc
      multiplicativeProcess Y n =ᵐ[μ] (fun _ ↦ (1 : ℝ)) * multiplicativeProcess Y n := by
        exact Filter.Eventually.of_forall fun _ ↦ by simp
      _ =ᵐ[μ] μ[(fun ω ↦ Y (n + 1) ω) | ℱ n] * multiplicativeProcess Y n := by
        exact (hCondFactor n).symm.mul Filter.EventuallyEq.rfl
      _ =ᵐ[μ] μ[(fun ω ↦ Y (n + 1) ω * multiplicativeProcess Y n ω) | ℱ n] := by
        symm
        exact condExp_mul_of_stronglyMeasurable_right (hXadapt n) hProdInt hFactorInt
      _ =ᵐ[μ] μ[multiplicativeProcess Y (n + 1) | ℱ n] := by
        refine condExp_congr_ae ?_
        exact Filter.Eventually.of_forall fun ω ↦ by
          simp [multiplicativeProcess_succ, mul_comm]
  simpa [ℱ] using hMartingale
