import Mathlib
import Books.ProbabilityTheory_Klenke_2020.Items.Chap05.Theorem_5_28

-- Declarations for this item will be appended below by the statement pipeline.

open MeasureTheory ProbabilityTheory
open scoped BigOperators

universe u

variable {Ω : Type u} [MeasurableSpace Ω] {μ : Measure Ω}

section

variable {Y : ℕ → Ω → ℝ}
variable (hY_meas : ∀ n, Measurable (Y n))

/-- Helper for Example 9.30: the shifted partial-sum process associated with the increments
`Y`. -/
abbrev shiftedPartialSumProcess : ℕ → Ω → ℝ :=
  fun n ↦ partialSum Y (n + 1)

/-- Helper for Example 9.30: the natural filtration generated by the increment process `Y`. -/
abbrev incrementFiltration : Filtration ℕ ‹MeasurableSpace Ω› :=
  Filtration.natural Y fun n ↦ (hY_meas n).stronglyMeasurable

local notation "S" => shiftedPartialSumProcess (Y := Y)
local notation "ℱY" => incrementFiltration (Y := Y) hY_meas

/-- Helper for Example 9.30: the shifted partial-sum process is adapted to the natural filtration
generated by the increments. -/
lemma shiftedPartialSum_adapted_natural :
    Adapted ℱY S := by
  intro n
  -- Each summand up to time `n` is measurable with respect to the filtration at time `n`.
  simpa [shiftedPartialSumProcess, partialSum_apply] using
    (Finset.measurable_sum (Finset.range (n + 1)) fun i hi ↦
      Measurable.of_comap_le <|
        le_iSup_of_le i <| le_iSup_of_le (Finset.mem_range_succ_iff.mp hi) le_rfl)

/-- Helper for Example 9.30: finite partial sums of integrable increments remain integrable. -/
lemma shiftedPartialSum_integrable
    (hY_int : ∀ n, Integrable (Y n) μ) :
    ∀ n, Integrable (S n) μ := by
  intro n
  -- Integrability is stable under finite sums.
  simpa [shiftedPartialSumProcess, partialSum_apply] using
    (integrable_finset_sum (Finset.range (n + 1)) fun i _ ↦ hY_int i)

/-- Helper for Example 9.30: the next increment of the shifted partial-sum process is exactly the
next coordinate `Y (n + 1)`. -/
lemma shiftedPartialSum_succ_sub (n : ℕ) (ω : Ω) :
    S (n + 1) ω - S n ω = Y (n + 1) ω := by
  -- The tail between consecutive shifted partial sums is the singleton `Ico` block.
  simpa [shiftedPartialSumProcess] using partialSum_sub_eq_sum_Ico Y (Nat.le_succ (n + 1)) ω

/-- Helper for Example 9.30: conditioning the next shifted partial-sum increment on the natural
filtration gives the mean of the next increment. -/
lemma condExp_shiftedPartialSum_increment
    (hY_indep : iIndepFun Y μ) :
    ∀ n, μ[S (n + 1) - S n | ℱY n] =ᵐ[μ] fun _ ↦ ∫ ω, Y (n + 1) ω ∂μ := by
  haveI : IsProbabilityMeasure μ := hY_indep.isProbabilityMeasure
  intro n
  -- Rewrite the increment as the next independent coordinate before applying the independence API.
  refine (condExp_congr_ae (Filter.Eventually.of_forall fun ω ↦
    shiftedPartialSum_succ_sub (Y := Y) n ω)).trans ?_
  exact ProbabilityTheory.iIndepFun.condExp_natural_ae_eq_of_lt
    (f := Y) (fun i ↦ (hY_meas i).stronglyMeasurable) hY_indep (Nat.lt_succ_self n)

-- Proof sketch: use the natural filtration generated by `Y`; write `X_t` as `X_s` plus the tail
-- sum from `s + 1` to `t`; each tail increment has conditional expectation equal to its mean by
-- independence from the past, and the mean-zero assumption kills the tail.
/-- Example 9.30 (1): the cumulative-sum process of an independent integrable centered real
increment sequence is a martingale with respect to the natural filtration generated by the
increments. This is the canonical `0`-based Lean formulation of the textbook process
`X_t = ∑_{s=1}^t Y_s`, namely `X n = partialSum Y (n + 1)`. -/
theorem cumulativeSumProcess_martingale_of_mean_zero
    (hY_int : ∀ n, Integrable (Y n) μ)
    (hY_mean_zero : ∀ n, ∫ ω, Y n ω ∂μ = 0)
    (hY_indep : iIndepFun Y μ) :
    Martingale S ℱY μ := by
  haveI : IsProbabilityMeasure μ := hY_indep.isProbabilityMeasure
  have hS_adapted : Adapted ℱY S :=
    shiftedPartialSum_adapted_natural (Y := Y) (hY_meas := hY_meas)
  have hS_int : ∀ n, Integrable (S n) μ :=
    shiftedPartialSum_integrable (Y := Y) (μ := μ) hY_int
  have hcond_inc :
      ∀ n, μ[S (n + 1) - S n | ℱY n] =ᵐ[μ] fun _ ↦ ∫ ω, Y (n + 1) ω ∂μ :=
    condExp_shiftedPartialSum_increment (Y := Y) (μ := μ) (hY_meas := hY_meas) hY_indep
  have hcond_zero : ∀ n, μ[S (n + 1) - S n | ℱY n] =ᵐ[μ] 0 := by
    intro n
    -- Centered increments give the zero one-step conditional expectation.
    refine (hcond_inc n).trans ?_
    exact Filter.Eventually.of_forall fun _ ↦ hY_mean_zero (n + 1)
  -- The nat-index martingale constructor turns the one-step identity into the full martingale law.
  exact martingale_of_condExp_sub_eq_zero_nat hS_adapted.stronglyAdapted hS_int hcond_zero

-- Proof sketch: the same decomposition `X_t = X_s + (X_t - X_s)` shows that the conditional
-- expectation of the future tail is the sum of the means of the future increments; the
-- nonnegative-mean assumption yields the required almost-everywhere inequality.
/-- Example 9.30 (2): if each increment has nonnegative expectation, then the cumulative-sum
process is a submartingale for the natural filtration generated by the increments. This is the
canonical `0`-based Lean formulation of the textbook statement. -/
theorem cumulativeSumProcess_submartingale_of_nonneg_mean
    (hY_int : ∀ n, Integrable (Y n) μ)
    (hY_mean_nonneg : ∀ n, 0 ≤ ∫ ω, Y n ω ∂μ)
    (hY_indep : iIndepFun Y μ) :
    Submartingale S ℱY μ := by
  haveI : IsProbabilityMeasure μ := hY_indep.isProbabilityMeasure
  have hS_adapted : Adapted ℱY S :=
    shiftedPartialSum_adapted_natural (Y := Y) (hY_meas := hY_meas)
  have hS_int : ∀ n, Integrable (S n) μ :=
    shiftedPartialSum_integrable (Y := Y) (μ := μ) hY_int
  have hcond_inc :
      ∀ n, μ[S (n + 1) - S n | ℱY n] =ᵐ[μ] fun _ ↦ ∫ ω, Y (n + 1) ω ∂μ :=
    condExp_shiftedPartialSum_increment (Y := Y) (μ := μ) (hY_meas := hY_meas) hY_indep
  have hcond_nonneg : ∀ n, 0 ≤ᵐ[μ] μ[S (n + 1) - S n | ℱY n] := by
    intro n
    -- The constant conditional expectation is nonnegative because the increment mean is.
    exact Filter.EventuallyLE.trans
      (Filter.Eventually.of_forall fun _ ↦ hY_mean_nonneg (n + 1))
      (hcond_inc n).symm.le
  -- Assemble the submartingale from the one-step nonnegative conditional increments.
  exact submartingale_of_condExp_sub_nonneg_nat hS_adapted.stronglyAdapted hS_int hcond_nonneg

-- Proof sketch: as in the martingale and submartingale cases, identify the conditional
-- expectation of the future tail with the sum of the means of the future increments; the
-- nonpositive-mean assumption gives the supermartingale inequality.
/-- Example 9.30 (3): if each increment has nonpositive expectation, then the cumulative-sum
process is a supermartingale for the natural filtration generated by the increments. This is the
canonical `0`-based Lean formulation of the textbook statement. -/
theorem cumulativeSumProcess_supermartingale_of_nonpos_mean
    (hY_int : ∀ n, Integrable (Y n) μ)
    (hY_mean_nonpos : ∀ n, ∫ ω, Y n ω ∂μ ≤ 0)
    (hY_indep : iIndepFun Y μ) :
    Supermartingale S ℱY μ := by
  haveI : IsProbabilityMeasure μ := hY_indep.isProbabilityMeasure
  have hS_adapted : Adapted ℱY S :=
    shiftedPartialSum_adapted_natural (Y := Y) (hY_meas := hY_meas)
  have hS_int : ∀ n, Integrable (S n) μ :=
    shiftedPartialSum_integrable (Y := Y) (μ := μ) hY_int
  have hcond_inc :
      ∀ n, μ[S (n + 1) - S n | ℱY n] =ᵐ[μ] fun _ ↦ ∫ ω, Y (n + 1) ω ∂μ :=
    condExp_shiftedPartialSum_increment (Y := Y) (μ := μ) (hY_meas := hY_meas) hY_indep
  have hcond_rev :
      ∀ n, μ[S n - S (n + 1) | ℱY n] =ᵐ[μ] fun _ ↦ -∫ ω, Y (n + 1) ω ∂μ := by
    intro n
    -- Reverse the increment, then push the sign through conditional expectation.
    have hneg_eq : S n - S (n + 1) = -(S (n + 1) - S n) := by
      ext ω
      simp only [Pi.sub_apply, Pi.neg_apply]
      ring
    refine (condExp_congr_ae (Filter.Eventually.of_forall fun ω ↦ congrFun hneg_eq ω)).trans ?_
    refine (condExp_neg (S (n + 1) - S n) (ℱY n)).trans ?_
    exact (hcond_inc n).neg
  have hcond_nonneg : ∀ n, 0 ≤ᵐ[μ] μ[S n - S (n + 1) | ℱY n] := by
    intro n
    have hmean_nonneg : 0 ≤ -∫ ω, Y (n + 1) ω ∂μ := by
      simpa using neg_nonneg.mpr (hY_mean_nonpos (n + 1))
    -- The reversed increment has nonnegative conditional expectation.
    exact Filter.EventuallyLE.trans
      (Filter.Eventually.of_forall fun _ ↦ hmean_nonneg)
      (hcond_rev n).symm.le
  -- Apply the supermartingale one-step criterion to the reversed increments.
  exact supermartingale_of_condExp_sub_nonneg_nat hS_adapted.stronglyAdapted hS_int hcond_nonneg

end
