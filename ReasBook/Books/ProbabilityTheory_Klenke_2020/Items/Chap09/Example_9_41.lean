import Mathlib

-- Declarations for this item will be appended below by the statement pipeline.

open MeasureTheory ProbabilityTheory

noncomputable section

/-- The three-point sample space underlying the martingale representation counterexample. -/
abbrev representationCounterexampleState := Fin 3

/-- The uniform probability measure on the three counterexample states. -/
abbrev representationCounterexampleMeasure : Measure representationCounterexampleState :=
  (PMF.uniformOfFintype representationCounterexampleState).toMeasure

/-- The two-step process `X` with `X₀ = 0` and terminal values `-1`, `0`, and `1`. -/
def representationCounterexampleX : Fin 2 → representationCounterexampleState → ℝ
  | 0, _ => 0
  | 1, ω =>
      if (ω : ℕ) = 0 then -1 else if (ω : ℕ) = 1 then 0 else 1

/-- The companion process `Y` with `Y₀ = 0` and `Y₁ = 2` exactly on the branch where `X₁ = 1`. -/
def representationCounterexampleY : Fin 2 → representationCounterexampleState → ℝ
  | 0, _ => 0
  | 1, ω => if representationCounterexampleX 1 ω = 1 then 2 else -1

-- Proof sketch: the state space is finite, so every coordinate map of `representationCounterexampleX`
-- is a finite-valued measurable function and therefore strongly measurable.
private theorem representationCounterexampleX_stronglyMeasurable :
    ∀ n, StronglyMeasurable (representationCounterexampleX n) :=
  fun _ ↦ StronglyMeasurable.of_discrete

local notation "ℱX" =>
  Filtration.natural representationCounterexampleX
    representationCounterexampleX_stronglyMeasurable

/-- The terminal value `representationCounterexampleY 1` is not a scalar multiple of
`representationCounterexampleX 1`. -/
theorem representationCounterexampleY_not_scalar_multiple :
    ¬ ∃ H₁ : ℝ, H₁ • representationCounterexampleX 1 = representationCounterexampleY 1 := by
  rintro ⟨H₁, hH₁⟩
  have hEval := congr_fun hH₁ 1
  simp [representationCounterexampleX, representationCounterexampleY] at hEval

/-- Helper for Example 9.41: each coordinate of `representationCounterexampleY` is integrable under
the uniform three-point law. -/
lemma representationCounterexampleY_integrable (n : Fin 2) :
    Integrable (representationCounterexampleY n) representationCounterexampleMeasure := by
  -- The sample space is finite, so every real-valued function on it is integrable.
  simpa using
    (Integrable.of_finite (μ := representationCounterexampleMeasure)
      (f := representationCounterexampleY n))

/-- Helper for Example 9.41: `representationCounterexampleY` is strongly adapted to the natural
filtration generated by `representationCounterexampleX`. -/
lemma representationCounterexampleY_stronglyAdapted :
    StronglyAdapted ℱX representationCounterexampleY := by
  -- It is enough to prove ordinary measurability and then upgrade on `ℝ`.
  refine (Adapted.stronglyAdapted ?_)
  intro n
  fin_cases n
  · -- At time `0`, the process is constant.
    simpa only [representationCounterexampleY] using
      (measurable_const : Measurable[ℱX _] (fun _ : representationCounterexampleState ↦ (0 : ℝ)))
  · -- At time `1`, `Y₁` is a measurable function of `X₁`.
    have hX : Measurable[ℱX 1] (representationCounterexampleX 1) :=
      (Filtration.stronglyAdapted_natural representationCounterexampleX_stronglyMeasurable 1).measurable
    simpa [representationCounterexampleY] using
      (Measurable.ite (p := fun a => representationCounterexampleX 1 a = 1)
        (hX (measurableSet_singleton 1)) measurable_const measurable_const)

/-- Helper for Example 9.41: the natural filtration at time `0` is trivial because `X₀` is
constant. -/
lemma representationCounterexampleInitialFiltration_eq_bot :
    ℱX 0 = ⊥ := by
  -- Only the constant coordinate `X₀` contributes to the natural filtration at time `0`.
  have hFiltration :
      ℱX 0 = MeasurableSpace.comap (representationCounterexampleX 0) Real.measurableSpace := by
    simp [Filtration.natural]
  rw [hFiltration]
  rw [show representationCounterexampleX 0 = fun _ : representationCounterexampleState ↦ (0 : ℝ) by
    funext ω
    simp [representationCounterexampleX]]
  exact MeasurableSpace.comap_const (m := Real.measurableSpace) (b := (0 : ℝ))

/-- Helper for Example 9.41: the terminal value `Y₁` has mean zero under the uniform three-point
law. -/
lemma representationCounterexampleY_one_integral_zero :
    ∫ ω, representationCounterexampleY 1 ω ∂representationCounterexampleMeasure = 0 := by
  -- Compute the expectation by averaging the three explicit values `-1`, `-1`, and `2`.
  rw [show representationCounterexampleMeasure =
      (PMF.uniformOfFintype representationCounterexampleState).toMeasure by rfl]
  rw [PMF.integral_eq_sum, Fin.sum_univ_three]
  norm_num [representationCounterexampleY, representationCounterexampleX]

/-- Helper for Example 9.41: conditioning `Y₁` on the initial sigma-algebra yields zero. -/
lemma representationCounterexampleY_one_condExp_eq_zero :
    representationCounterexampleMeasure[representationCounterexampleY 1 | ℱX 0] =ᵐ[representationCounterexampleMeasure] 0 := by
  -- Rewrite to the trivial sigma-algebra, then use the mean-zero computation.
  rw [representationCounterexampleInitialFiltration_eq_bot, condExp_bot]
  filter_upwards with ω
  simp [representationCounterexampleY_one_integral_zero]

-- Proof sketch: for the martingale part, `Y₀` is constant, `Y₁` is measurable with respect to
-- the `σ`-algebra generated by `X₁`, and under the uniform law on the three states one has
-- `E[Y₁] = (-1 - 1 + 2) / 3 = 0 = Y₀`. For the non-representability part, the equality
-- `H₁ • X₁ = Y₁` would force `0 = -1` on the state where `X₁ = 0`.
/-- Example 9.41: for the explicit two-step process `representationCounterexampleY` on the uniform
three-point space, `Y` is a martingale with respect to the natural filtration generated by
`representationCounterexampleX`, but `Y₁` is not a scalar multiple of `X₁`. -/
theorem explicit_sigma_martingale_not_scalar_multiple :
    Martingale representationCounterexampleY ℱX
      representationCounterexampleMeasure ∧
      ¬ ∃ H₁ : ℝ, H₁ • representationCounterexampleX 1 = representationCounterexampleY 1 := by
  -- Route correction: the martingale proof is shorter in this file by verifying the
  -- conditional-expectation identities directly on the three valid `Fin 2` index pairs.
  refine ⟨?_, representationCounterexampleY_not_scalar_multiple⟩
  refine ⟨representationCounterexampleY_stronglyAdapted, ?_⟩
  intro i j hij
  fin_cases i <;> fin_cases j
  · -- The diagonal time-`0` case reduces to the conditional expectation of a constant.
    exact Filter.EventuallyEq.of_eq <|
      condExp_of_stronglyMeasurable
        ((Filtration.natural representationCounterexampleX
          representationCounterexampleX_stronglyMeasurable).le 0)
        (representationCounterexampleY_stronglyAdapted 0)
        (representationCounterexampleY_integrable 0)
  · -- The only off-diagonal case is exactly the mean-zero conditional expectation lemma.
    simpa [representationCounterexampleY] using representationCounterexampleY_one_condExp_eq_zero
  · -- There is no branch with `1 ≤ 0`.
    cases hij
  · -- The diagonal time-`1` case is again the conditional expectation of a measurable function.
    exact Filter.EventuallyEq.of_eq <|
      condExp_of_stronglyMeasurable
        ((Filtration.natural representationCounterexampleX
          representationCounterexampleX_stronglyMeasurable).le 1)
        (representationCounterexampleY_stronglyAdapted 1)
        (representationCounterexampleY_integrable 1)

end
