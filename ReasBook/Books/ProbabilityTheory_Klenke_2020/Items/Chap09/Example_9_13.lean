import Mathlib
import Books.ProbabilityTheory_Klenke_2020.Items.Chap05.Theorem_5_28
import Books.ProbabilityTheory_Klenke_2020.Items.Chap09.Definition_9_10

-- Declarations for this item will be appended below by the statement pipeline.

open MeasureTheory ProbabilityTheory
open scoped BigOperators

universe u

variable {Ω : Type u} [MeasurableSpace Ω]

noncomputable section

/-- The process obtained by counting how many of the first `n` increments are nonnegative. -/
def nonnegativeCountProcess (Y : ℕ → Ω → ℝ) : ℕ → Ω → ℝ :=
  fun n ω ↦ ∑ i ∈ Finset.range n, if 0 ≤ Y i ω then 1 else 0

-- Proof sketch: unfold `nonnegativeCountProcess`; it is exactly the finite sum of the indicators
-- of the half-line `[0, ∞)` evaluated on the first `n` increments.
/-- The nonnegative-count process evaluates as the finite sum of the indicators of the events
`{Y_i ≥ 0}` over the first `n` coordinates. -/
theorem nonnegativeCountProcess_apply (Y : ℕ → Ω → ℝ) (n : ℕ) (ω : Ω) :
    nonnegativeCountProcess Y n ω = ∑ i ∈ Finset.range n, if 0 ≤ Y i ω then 1 else 0 := by
  -- This is exactly the defining finite sum.
  rfl

/-- Helper for Example 9.13: every coordinate `U i` with `i ≤ n` is measurable with respect to the
time-`n` σ-algebra of the filtration generated by `U`. -/
private lemma measurable_processInGeneratedFiltration {E : Type*} [MeasurableSpace E]
    (U : ℕ → Ω → E) (hU : ∀ n, Measurable (U n)) {n i : ℕ} (hi : i ≤ n) :
    Measurable[generatedFiltration U hU n] (U i) := by
  -- Insert the `i`th generator into the defining supremum of the generated filtration.
  rw [generatedFiltration_apply]
  exact Measurable.of_comap_le <| le_iSup_of_le i <| le_iSup_of_le hi le_rfl

/-- Helper for Example 9.13: every partial sum over indices `< m` is measurable with respect to
the time-`n` increment filtration as soon as `m ≤ n + 1`. -/
private lemma partialSum_measurableInGeneratedFiltration
    (Y : ℕ → Ω → ℝ) (hY : ∀ n, Measurable (Y n)) {m n : ℕ} (hmn : m ≤ n + 1) :
    Measurable[generatedFiltration Y hY n] (partialSum Y m) := by
  -- Expand the finite sum and show each increment belongs to the time-`n` generator family.
  unfold partialSum
  refine Finset.measurable_sum (Finset.range m) ?_
  intro i hi
  exact measurable_processInGeneratedFiltration Y hY
    (Nat.le_of_lt_succ <| lt_of_lt_of_le (Finset.mem_range.mp hi) hmn)

/-- Helper for Example 9.13: every nonnegative-count partial sum over indices `< m` is measurable
with respect to the time-`n` increment filtration as soon as `m ≤ n + 1`. -/
private lemma nonnegativeCountProcess_measurableInGeneratedFiltration
    (Y : ℕ → Ω → ℝ) (hY : ∀ n, Measurable (Y n)) {m n : ℕ} (hmn : m ≤ n + 1) :
    Measurable[generatedFiltration Y hY n] (nonnegativeCountProcess Y m) := by
  -- Expand the finite sum and treat each threshold indicator as a measurable `ite`.
  unfold nonnegativeCountProcess
  refine Finset.measurable_sum (Finset.range m) ?_
  intro i hi
  have hYi : Measurable[generatedFiltration Y hY n] (Y i) :=
    measurable_processInGeneratedFiltration Y hY
      (Nat.le_of_lt_succ <| lt_of_lt_of_le (Finset.mem_range.mp hi) hmn)
  have hNonneg : MeasurableSet[generatedFiltration Y hY n] {ω | 0 ≤ Y i ω} :=
    measurableSet_le measurable_const hYi
  exact Measurable.ite hNonneg measurable_const measurable_const

-- Proof sketch: each increment `Y i` is measurable, and finite sums of measurable real-valued
-- functions are measurable.
/-- If the increments are measurable, then every partial sum is measurable. -/
theorem partialSum_measurable (Y : ℕ → Ω → ℝ) (hY : ∀ n, Measurable (Y n)) :
    ∀ n, Measurable (partialSum Y n) := by
  intro n
  -- First place the partial sum in the time-`n` generated filtration, then forget to `Ω`.
  exact
    (partialSum_measurableInGeneratedFiltration Y hY (m := n) (n := n) (Nat.le_succ n)).mono
      ((generatedFiltration Y hY).le n) le_rfl

-- Proof sketch: each summand `if 0 ≤ Y i ω then 1 else 0` is a measurable real-valued function of
-- `Y i`, and finite sums preserve measurability.
/-- If the increments are measurable, then every nonnegative-count partial sum is measurable. -/
theorem nonnegativeCountProcess_measurable (Y : ℕ → Ω → ℝ) (hY : ∀ n, Measurable (Y n)) :
    ∀ n, Measurable (nonnegativeCountProcess Y n) := by
  intro n
  -- First place the count process in the time-`n` generated filtration, then forget to `Ω`.
  exact
    (nonnegativeCountProcess_measurableInGeneratedFiltration Y hY
      (m := n) (n := n) (Nat.le_succ n)).mono
      ((generatedFiltration Y hY).le n) le_rfl

-- Proof sketch: each summand `Y j` with `j ≤ n` is measurable with respect to its own pullback
-- `σ`-algebra `MeasurableSpace.comap (Y j) (borel ℝ)`, hence also with respect to the supremum
-- over `j ≤ n`; finite sums preserve measurability.
/-- If the increments are measurable, then the partial-sum process is adapted to their generated
filtration. -/
theorem partialSum_measurable_prefix_sigma (Y : ℕ → Ω → ℝ) (hY : ∀ n, Measurable (Y n)) :
    Adapted (generatedFiltration Y hY) (partialSum Y) := by
  intro n
  -- The time-`n` partial sum only depends on increments with indices `< n`.
  exact partialSum_measurableInGeneratedFiltration Y hY (m := n) (n := n) (Nat.le_succ n)

/-- Helper for Example 9.13: every increment `Y k` with `k ≤ n` is measurable with respect to the
time-`n` filtration generated by the shifted partial sums `m ↦ partialSum Y (m + 1)`. -/
private lemma incrementMeasurableInShiftedPartialSumFiltration
    (Y : ℕ → Ω → ℝ) (hY : ∀ n, Measurable (Y n)) {n k : ℕ} (hk : k ≤ n) :
    Measurable[generatedFiltration (fun m ↦ partialSum Y (m + 1))
      (fun m ↦ partialSum_measurable Y hY (m + 1)) n] (Y k) := by
  by_cases hk0 : k = 0
  · subst hk0
    -- Recover the first increment as the first shifted partial sum.
    have hS0 :
        Measurable[generatedFiltration (fun m ↦ partialSum Y (m + 1))
          (fun m ↦ partialSum_measurable Y hY (m + 1)) n] (partialSum Y 1) :=
      measurable_processInGeneratedFiltration
        (fun m ↦ partialSum Y (m + 1)) (fun m ↦ partialSum_measurable Y hY (m + 1))
        (Nat.zero_le n)
    have hEq : partialSum Y 1 = Y 0 := by
      funext ω
      simp [partialSum]
    simpa [hEq] using hS0
  · obtain ⟨j, rfl⟩ := Nat.exists_eq_succ_of_ne_zero hk0
    -- Recover later increments as differences of successive shifted partial sums.
    have hSsucc :
        Measurable[generatedFiltration (fun m ↦ partialSum Y (m + 1))
          (fun m ↦ partialSum_measurable Y hY (m + 1)) n] (partialSum Y (j + 2)) :=
      measurable_processInGeneratedFiltration
        (fun m ↦ partialSum Y (m + 1)) (fun m ↦ partialSum_measurable Y hY (m + 1)) hk
    have hSprev :
        Measurable[generatedFiltration (fun m ↦ partialSum Y (m + 1))
          (fun m ↦ partialSum_measurable Y hY (m + 1)) n] (partialSum Y (j + 1)) :=
      measurable_processInGeneratedFiltration
        (fun m ↦ partialSum Y (m + 1)) (fun m ↦ partialSum_measurable Y hY (m + 1))
        (Nat.le_trans (Nat.le_succ j) hk)
    have hDiff :
        Measurable[generatedFiltration (fun m ↦ partialSum Y (m + 1))
          (fun m ↦ partialSum_measurable Y hY (m + 1)) n]
          (fun ω ↦ partialSum Y (j + 2) ω - partialSum Y (j + 1) ω) :=
      hSsucc.sub hSprev
    have hEq :
        (fun ω ↦ partialSum Y (j + 2) ω - partialSum Y (j + 1) ω) = Y (j + 1) := by
      funext ω
      simpa using (partialSum_sub_eq_sum_Ico Y (Nat.le_succ (j + 1)) ω)
    simpa [hEq] using hDiff

-- Proof sketch: for each `n`, the prefix vector `(Y 0, ..., Y n)` determines the shifted partial
-- sums `(partialSum Y 1, ..., partialSum Y (n + 1))` by finite summation, so the left-hand side is
-- contained in the right-hand side; conversely, `Y 0 = partialSum Y 1` and each later increment is
-- the difference of two successive shifted partial sums, so the right-hand side is contained in the
-- left-hand side.
/-- Example 9.13: for a real-valued increment process `Y 0, Y 1, ...`, the prefix `σ`-algebra
generated by the shifted partial sums `n ↦ partialSum Y (n + 1)` coincides with the generated
filtration of the increments. This is the canonical `0`-based Lean formulation of the textbook
example `X_n = Y_1 + ⋯ + Y_n`. -/
theorem partialSum_prefix_sigma_eq_increment_prefix_sigma
    (Y : ℕ → Ω → ℝ) (hY : ∀ n, Measurable (Y n)) :
    generatedFiltration (fun n ↦ partialSum Y (n + 1))
        (fun n ↦ partialSum_measurable Y hY (n + 1)) =
      generatedFiltration Y hY := by
  apply Filtration.ext
  funext n
  apply le_antisymm
  · -- Every shifted partial sum up to time `n` is measurable in the increment filtration at time `n`.
    rw [generatedFiltration_apply]
    refine iSup₂_le fun k hk ↦ ?_
    exact
      (partialSum_measurableInGeneratedFiltration Y hY (m := k + 1) (n := n)
        (Nat.succ_le_succ hk)).comap_le
  · -- Every increment up to time `n` is recovered from the shifted partial sums up to time `n`.
    rw [generatedFiltration_apply]
    refine iSup₂_le fun k hk ↦ ?_
    exact (incrementMeasurableInShiftedPartialSumFiltration Y hY hk).comap_le

-- Proof sketch: each summand `if 0 ≤ Y i ω then 1 else 0` is a measurable function of `Y i`,
-- hence measurable with respect to the prefix `σ`-algebra generated by `Y 0, ..., Y n`; finite
-- sums preserve measurability.
/-- If the increments are measurable, then the nonnegative-count process is adapted to their
generated filtration. -/
theorem nonnegativeCountProcess_measurable_prefix_sigma
    (Y : ℕ → Ω → ℝ) (hY : ∀ n, Measurable (Y n)) :
    Adapted (generatedFiltration Y hY) (nonnegativeCountProcess Y) := by
  intro n
  -- The time-`n` count only depends on increments with indices `< n`.
  exact nonnegativeCountProcess_measurableInGeneratedFiltration Y hY
    (m := n) (n := n) (Nat.le_succ n)

/-- Helper for Example 9.13: the sign-count map generates exactly the σ-algebra generated by
the half-line `Set.Ici 0`. -/
private lemma signMapComap_eq_generateFromIci :
    MeasurableSpace.comap (fun x : ℝ ↦ if 0 ≤ x then (1 : ℝ) else 0) inferInstance =
      MeasurableSpace.generateFrom {Set.Ici (0 : ℝ)} := by
  apply le_antisymm
  · -- The sign-count map is measurable from the singleton-generated σ-algebra.
    rw [← measurable_iff_comap_le]
    have hIci : MeasurableSet[MeasurableSpace.generateFrom {Set.Ici (0 : ℝ)}] (Set.Ici (0 : ℝ)) :=
      MeasurableSpace.measurableSet_generateFrom (by simp)
    exact Measurable.ite hIci measurable_const measurable_const
  · -- The generator `Set.Ici 0` is recovered as the preimage of `{1}` under the sign-count map.
    refine MeasurableSpace.generateFrom_singleton_le ?_
    have hPreimage :
        (fun x : ℝ ↦ if 0 ≤ x then (1 : ℝ) else 0) ⁻¹' ({1} : Set ℝ) = Set.Ici (0 : ℝ) := by
      ext x
      by_cases hx : 0 ≤ x <;> simp [hx]
    have hSingleton :
        MeasurableSet[MeasurableSpace.comap (fun x : ℝ ↦ if 0 ≤ x then (1 : ℝ) else 0)
          inferInstance]
          ((fun x : ℝ ↦ if 0 ≤ x then (1 : ℝ) else 0) ⁻¹' ({1} : Set ℝ)) :=
      (comap_measurable (fun x : ℝ ↦ if 0 ≤ x then (1 : ℝ) else 0))
        (measurableSet_singleton (1 : ℝ))
    simpa [hPreimage] using hSingleton

-- Proof sketch: take the concrete increment process `Y n x = x` on `Ω = ℝ`. Then the prefix
-- `σ`-algebra generated by `Y` at time `1` is the full Borel `σ`-algebra, while the count process
-- at time `1` is just the sign indicator `x ↦ if 0 ≤ x then 1 else 0`, whose generated
-- `σ`-algebra only distinguishes the two half-lines and is therefore strictly smaller.
/-- A concrete counterexample showing that the generated filtration of the nonnegative-count
process can be strictly smaller than the one generated by the original increments. -/
theorem nonnegativeCountProcess_prefix_sigma_strict_at_one_for_identity :
    generatedFiltration (nonnegativeCountProcess (fun (_ : ℕ) (x : ℝ) ↦ x))
        (nonnegativeCountProcess_measurable (fun (_ : ℕ) (x : ℝ) ↦ x) fun _ ↦ measurable_id) 1 <
      generatedFiltration (fun (_ : ℕ) (x : ℝ) ↦ x) (fun _ ↦ measurable_id) 1 := by
  let Z : ℕ → ℝ → ℝ := nonnegativeCountProcess (fun (_ : ℕ) (x : ℝ) ↦ x)
  let I : ℕ → ℝ → ℝ := fun (_ : ℕ) (x : ℝ) ↦ x
  have hZ : ∀ n, Measurable (Z n) :=
    nonnegativeCountProcess_measurable (fun (_ : ℕ) (x : ℝ) ↦ x) fun _ ↦ measurable_id
  have hCount :
      generatedFiltration Z hZ 1 = MeasurableSpace.generateFrom {Set.Ici (0 : ℝ)} := by
    apply le_antisymm
    · -- At time `1`, only the constant coordinate and the sign-count coordinate appear.
      rw [generatedFiltration_apply]
      refine iSup₂_le fun s hs ↦ ?_
      interval_cases s
      · have hZ0eq : Z 0 = fun _ : ℝ ↦ (0 : ℝ) := by
          funext x
          simp [Z, nonnegativeCountProcess]
        have hConst : Measurable[MeasurableSpace.generateFrom {Set.Ici (0 : ℝ)}] (Z 0) := by
          rw [hZ0eq]
          exact measurable_const
        exact hConst.comap_le
      · have hZ1eq :
            Z 1 = fun x : ℝ ↦ if 0 ≤ x then (1 : ℝ) else 0 := by
          funext x
          simp [Z, nonnegativeCountProcess]
        simpa [hZ1eq] using
          (show MeasurableSpace.comap (Z 1) inferInstance ≤
              MeasurableSpace.generateFrom {Set.Ici (0 : ℝ)} by
            rw [hZ1eq, signMapComap_eq_generateFromIci])
    · -- The time-`1` count coordinate already generates `Set.Ici 0`.
      have hZ1 : Measurable[generatedFiltration Z hZ 1] (Z 1) :=
        measurable_processInGeneratedFiltration Z hZ (show 1 ≤ 1 by simp)
      have hZ1eq : Z 1 = fun x : ℝ ↦ if 0 ≤ x then (1 : ℝ) else 0 := by
        funext x
        simp [Z, nonnegativeCountProcess]
      calc
        MeasurableSpace.generateFrom {Set.Ici (0 : ℝ)}
            = MeasurableSpace.comap (fun x : ℝ ↦ if 0 ≤ x then (1 : ℝ) else 0) inferInstance := by
                symm
                exact signMapComap_eq_generateFromIci
        _ = MeasurableSpace.comap (Z 1) inferInstance := by rw [hZ1eq]
        _ ≤ generatedFiltration Z hZ 1 := hZ1.comap_le
  have hIncrement :
      generatedFiltration I (fun _ ↦ measurable_id) 1 = borel ℝ := by
    apply le_antisymm
    · exact (generatedFiltration I (fun _ ↦ measurable_id)).le 1
    · have hIdEq : MeasurableSpace.comap (I 0) inferInstance = borel ℝ := by
        dsimp [I]
        exact MeasurableSpace.comap_id
      calc
        borel ℝ = MeasurableSpace.comap (I 0) inferInstance := hIdEq.symm
        _ ≤ generatedFiltration I (fun _ ↦ measurable_id) 1 := by
          rw [generatedFiltration_apply]
          exact le_iSup_of_le 0 <| le_iSup_of_le (show 0 ≤ 1 by simp) le_rfl
  refine lt_of_le_of_ne ?_ ?_
  · -- The sign-count σ-algebra is generated by a single Borel set.
    rw [hCount, hIncrement]
    exact MeasurableSpace.generateFrom_singleton_le measurableSet_Ici
  · intro hEq
    -- Route correction: strictness is witnessed by `Set.Ioi 0`, which is Borel but not measurable
    -- in the singleton-generated σ-algebra of `Set.Ici 0`.
    have hIoi : MeasurableSet[MeasurableSpace.generateFrom {Set.Ici (0 : ℝ)}] (Set.Ioi (0 : ℝ)) := by
      rw [← hCount, hEq, hIncrement]
      exact measurableSet_Ioi
    rcases MeasureTheory.measurableSet_generateFrom_singleton_iff.mp hIoi with
      hEmpty | hIci | hCompl | hUniv
    · have : (1 : ℝ) ∈ Set.Ioi (0 : ℝ) := by norm_num
      simpa [hEmpty] using this
    · have hZero : (0 : ℝ) ∈ Set.Ici (0 : ℝ) := by simp
      have : (0 : ℝ) ∈ Set.Ioi (0 : ℝ) := by simpa [hIci] using hZero
      simpa using this
    · have hOne : (1 : ℝ) ∈ Set.Ioi (0 : ℝ) := by norm_num
      have : (1 : ℝ) ∈ (Set.Ici (0 : ℝ))ᶜ := by simpa [hCompl] using hOne
      have hNot : ¬ ((1 : ℝ) ∈ (Set.Ici (0 : ℝ))ᶜ) := by simp
      exact hNot this
    · have hZero : (0 : ℝ) ∈ (Set.univ : Set ℝ) := by simp
      have : (0 : ℝ) ∈ Set.Ioi (0 : ℝ) := by simpa [hUniv] using hZero
      simpa using this
