import Mathlib

-- Declarations for this item will be appended below by the statement pipeline.

open MeasureTheory TopologicalSpace

universe u v w

/- The canonical mathlib notion of an adapted stochastic process is
`MeasureTheory.Adapted`, namely each time marginal `X t` is measurable with respect to the
time-`t` σ-algebra. -/
recall MeasureTheory.Adapted

variable {ι : Type u} [Preorder ι] {Ω : Type v} [mΩ : MeasurableSpace Ω]
variable {E : Type w} [MeasurableSpace E]

/-- The time-`t` σ-algebra generated by the coordinates `X s` with `s ≤ t`. -/
abbrev generatedFiltrationSpace (X : ι → Ω → E) (t : ι) : MeasurableSpace Ω :=
  ⨆ s ≤ t, MeasurableSpace.comap (X s) inferInstance

/-- Definition 9.10: the filtration generated by a process `X` has time-`t` σ-algebra
`σ(X_s, s ≤ t)`. -/
def generatedFiltration (X : ι → Ω → E) (hX : ∀ t, Measurable (X t)) : Filtration ι mΩ where
  seq := generatedFiltrationSpace X
  mono' := by
    intro i j hij
    exact biSup_mono fun _ ↦ ge_trans hij
  le' t := by
    refine iSup₂_le fun s hs ↦ ?_
    exact (hX s).comap_le

/-- At time `t`, the filtration generated by `X` is the `σ`-algebra generated by all coordinates
`X s` with `s ≤ t`. -/
theorem generatedFiltration_apply (X : ι → Ω → E) (hX : ∀ t, Measurable (X t)) (t : ι) :
    generatedFiltration X hX t = generatedFiltrationSpace X t := rfl

/-- Under the usual Borel regularity assumptions, the source-facing generated filtration agrees
with mathlib's natural filtration. -/
theorem generatedFiltration_eq_natural [TopologicalSpace E] [MetrizableSpace E] [BorelSpace E]
    (X : ι → Ω → E) (hX : ∀ t, StronglyMeasurable (X t)) :
    generatedFiltration X (fun t ↦ (hX t).measurable) = Filtration.natural X hX := by
  ext t
  rfl
