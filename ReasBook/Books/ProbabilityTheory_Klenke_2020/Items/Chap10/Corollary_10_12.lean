import Mathlib
import Books.ProbabilityTheory_Klenke_2020.Items.Chap10.Theorem_10_11

-- Declarations for this item will be appended below by the statement pipeline.

open scoped ENNReal MeasureTheory

universe u

open MeasureTheory

section

variable {Ω : Type u} {mΩ : MeasurableSpace Ω} {μ : Measure Ω} {ℱ : Filtration ℕ mΩ}
variable [SigmaFiniteFiltration μ ℱ]

/-- The filtration obtained from an increasing sequence of stopping times by taking the associated
stopping-time σ-algebras. -/
def stoppingTimeSequenceFiltration (ℱ : Filtration ℕ mΩ) (τ : ℕ → Ω → ℕ∞)
    (hτ : ∀ n, IsStoppingTime ℱ (τ n)) (hmono : Monotone τ) : Filtration ℕ mΩ :=
  { seq := fun n ↦ (hτ n).measurableSpace
    mono' := fun i j hij ↦ (hτ i).measurableSpace_mono (hτ j) (hmono hij)
    le' := fun n ↦ (hτ n).measurableSpace_le }

/-- At time `n`, the stopping-time-sequence filtration is the σ-algebra generated by `τ n`. -/
@[simp] theorem stoppingTimeSequenceFiltration_apply (τ : ℕ → Ω → ℕ∞)
    (hτ : ∀ n, IsStoppingTime ℱ (τ n)) (hmono : Monotone τ) (n : ℕ) :
    stoppingTimeSequenceFiltration ℱ τ hτ hmono n = (hτ n).measurableSpace :=
  rfl

/-- Helper for Corollary 10.12: the sampled stopped-value sequence is strongly adapted to the
filtration `n ↦ 𝓕_(τ n)`. -/
lemma stronglyAdapted_stoppedValueSequence {X : ℕ → Ω → ℝ} (hX : StronglyAdapted ℱ X)
    {τ : ℕ → Ω → ℕ∞} (hτ : ∀ n, IsStoppingTime ℱ (τ n)) (hmono : Monotone τ) :
    StronglyAdapted (stoppingTimeSequenceFiltration ℱ τ hτ hmono)
      (fun n ↦ stoppedValue X (τ n)) := by
  intro n
  -- Rewrite the target σ-algebra as the stopping-time σ-algebra attached to `τ n`.
  rw [stoppingTimeSequenceFiltration_apply]
  -- Progressive measurability of `X` turns the stopped value into an `𝓕_(τ n)`-measurable random
  -- variable.
  exact
    (measurable_stoppedValue (hX.progMeasurable_of_discrete) (hτ n)).stronglyMeasurable

/-- Helper for Corollary 10.12: sampling a supermartingale along a monotone increasing sequence of
bounded stopping times produces a supermartingale for the induced stopping-time filtration. -/
lemma stoppedValue_supermartingale_of_monotone_stopping_times {X : ℕ → Ω → ℝ}
    (hX : Supermartingale X ℱ μ) {τ : ℕ → Ω → ℕ∞} (hτ : ∀ n, IsStoppingTime ℱ (τ n))
    (hmono : Monotone τ) (hbdd : ∀ n, ∃ T : ℕ, ∀ ω, τ n ω ≤ T) :
    Supermartingale (fun n ↦ stoppedValue X (τ n))
      (stoppingTimeSequenceFiltration ℱ τ hτ hmono) μ := by
  refine ⟨stronglyAdapted_stoppedValueSequence hX.stronglyAdapted hτ hmono, ?_, ?_⟩
  · intro m n hmn
    obtain ⟨T, hT⟩ := hbdd n
    -- Route correction: use the bounded optional-sampling inequality from Theorem 10.11 directly
    -- after rewriting the filtration component at time `m`.
    simpa [stoppingTimeSequenceFiltration_apply] using
      (supermartingale_condExp_stoppedValue_le_of_le_of_bounded
        (X := X) (μ := μ) (ℱ := ℱ) hX (hτ m) (hτ n) (fun ω ↦ hmono hmn ω) (N := T) hT)
  · intro n
    obtain ⟨T, hT⟩ := hbdd n
    -- Bounded stopping times preserve integrability of the sampled value.
    exact integrable_stoppedValue ℕ (hτ n) hX.integrable hT

/-- Corollary 10.12 (1): sampling a martingale along a monotone increasing sequence of bounded
stopping times yields a martingale with respect to the filtration formed by the corresponding
stopping-time σ-algebras. -/
-- Proof sketch: use optional sampling in the form of Theorem 10.11 to identify, for `m ≤ n`, the
-- conditional expectation of `X` stopped at `τ n` with respect to `𝓕_(τ m)` with `X` stopped at
-- `τ m`; monotonicity of the stopping times makes the σ-algebras `𝓕_(τ n)` into a filtration.
theorem stoppedValue_martingale_of_monotone_stopping_times {X : ℕ → Ω → ℝ}
    (hX : Martingale X ℱ μ) {τ : ℕ → Ω → ℕ∞} (hτ : ∀ n, IsStoppingTime ℱ (τ n))
    (hmono : Monotone τ) (hbdd : ∀ n, ∃ T : ℕ, ∀ ω, τ n ω ≤ T) :
    Martingale (fun n ↦ stoppedValue X (τ n)) (stoppingTimeSequenceFiltration ℱ τ hτ hmono) μ :=
  by
  refine ⟨stronglyAdapted_stoppedValueSequence hX.stronglyAdapted hτ hmono, ?_⟩
  intro m n hmn
  obtain ⟨T, hT⟩ := hbdd n
  -- Rewrite the induced filtration at time `m`, then apply the owner optional-sampling identity
  -- to the stopping times `τ m ≤ τ n`.
  simpa [stoppingTimeSequenceFiltration_apply] using
    (hX.stoppedValue_ae_eq_condExp_of_le
      (hτ n) (hτ m) (fun ω ↦ hmono hmn ω) (n := T) hT).symm

/-- Corollary 10.12 (2): sampling a submartingale along a monotone increasing sequence of bounded
stopping times yields a submartingale with respect to the filtration formed by the corresponding
stopping-time σ-algebras. -/
-- Proof sketch: apply Theorem 10.11 to the bounded stopping times `τ m ≤ τ n` to obtain the
-- conditional-expectation inequality for the sampled process, and use the monotonicity of `τ` to
-- view the stopping-time σ-algebras as an increasing filtration.
theorem stoppedValue_submartingale_of_monotone_stopping_times {X : ℕ → Ω → ℝ}
    (hX : Submartingale X ℱ μ) {τ : ℕ → Ω → ℕ∞} (hτ : ∀ n, IsStoppingTime ℱ (τ n))
    (hmono : Monotone τ) (hbdd : ∀ n, ∃ T : ℕ, ∀ ω, τ n ω ≤ T) :
    Submartingale (fun n ↦ stoppedValue X (τ n))
      (stoppingTimeSequenceFiltration ℱ τ hτ hmono) μ :=
  by
  have hneg :
      Supermartingale (fun n ↦ stoppedValue (-X) (τ n))
        (stoppingTimeSequenceFiltration ℱ τ hτ hmono) μ :=
    stoppedValue_supermartingale_of_monotone_stopping_times
      (X := -X) (μ := μ) (ℱ := ℱ) hX.neg hτ hmono hbdd
  have hprocess :
      (-fun n ↦ stoppedValue (-X) (τ n)) = fun n ↦ stoppedValue X (τ n) := by
    ext n ω
    simp [stoppedValue, Pi.neg_apply]
  -- Negating the sampled supermartingale for `-X` recovers the sampled submartingale for `X`.
  simpa [hprocess] using hneg.neg

end
