import Mathlib
import Books.ProbabilityTheory_Klenke_2020.Items.Chap09.Remark_9_11
import Books.ProbabilityTheory_Klenke_2020.Items.Chap10.Definition_10_3
import Books.ProbabilityTheory_Klenke_2020.Items.Chap10.Theorem_10_4

-- Declarations for this item will be appended below by the statement pipeline.

open MeasureTheory ProbabilityTheory
open scoped BigOperators ProbabilityTheory

universe u

variable {Ω : Type u} [MeasurableSpace Ω] {μ : Measure Ω}

/-- The multiplicative process associated with a sequence `(Y_n)` of real random variables,
with `X₀ = 1` and `X_{n+1} = X_n Y_{n+1}`. -/
def multiplicativeProcess (Y : ℕ → Ω → ℝ) : ℕ → Ω → ℝ
  | 0 => fun _ ↦ 1
  | n + 1 => fun ω ↦ multiplicativeProcess Y n ω * Y (n + 1) ω

-- Proof sketch: unfold the recursive definition at time `0`.
/-- The multiplicative process starts from the constant value `1`. -/
@[simp] theorem multiplicativeProcess_zero (Y : ℕ → Ω → ℝ) :
    multiplicativeProcess Y 0 = fun _ ↦ 1 := by
  -- The initial value is the defining base case of the recursion.
  rfl

-- Proof sketch: unfold the recursive definition at time `n + 1`.
/-- The multiplicative process satisfies the one-step recursion `X_{n+1} = X_n Y_{n+1}`. -/
@[simp] theorem multiplicativeProcess_succ (Y : ℕ → Ω → ℝ) (n : ℕ) :
    multiplicativeProcess Y (n + 1) =
      fun ω ↦ multiplicativeProcess Y n ω * Y (n + 1) ω := by
  -- The successor step is the recursive clause of `multiplicativeProcess`.
  rfl

-- Proof sketch: prove by induction on `n`, using that products of measurable real-valued
-- random variables are measurable.
/-- If the factors `Y₁, Y₂, …` are measurable, then every stage of the multiplicative process is
measurable. -/
theorem measurable_multiplicativeProcess {Y : ℕ → Ω → ℝ}
    (hY : ∀ n, Measurable (Y (n + 1))) :
    ∀ n, Measurable (multiplicativeProcess Y n)
  | 0 => by
      -- The initial stage is the constant map `1`.
      simpa [multiplicativeProcess_zero] using measurable_const
  | n + 1 => by
      -- The recursive step multiplies two measurable real-valued functions.
      simpa [multiplicativeProcess_succ] using
        (measurable_multiplicativeProcess hY n).mul (hY n)

-- Proof sketch: combine `measurable_multiplicativeProcess` with the standard fact that measurable
-- real-valued maps are strongly measurable.
/-- If the factors `Y₁, Y₂, …` are measurable, then every stage of the multiplicative process is
strongly measurable. This is the bridge from the source-facing process recursion to the canonical
owner filtration `Filtration.natural`. -/
theorem stronglyMeasurable_multiplicativeProcess {Y : ℕ → Ω → ℝ}
    (hY : ∀ n, Measurable (Y (n + 1))) :
    ∀ n, StronglyMeasurable (multiplicativeProcess Y n) := by
  intro n
  -- Real-valued measurable maps are strongly measurable.
  exact (measurable_multiplicativeProcess hY n).stronglyMeasurable

/-- Helper for Example 10.7: the multiplicative process agrees with the finite product
`∏ i ∈ range n, Y (i + 1)`. -/
private theorem multiplicativeProcess_eq_prod_range {Y : ℕ → Ω → ℝ} (n : ℕ) (ω : Ω) :
    multiplicativeProcess Y n ω =
      ∏ i ∈ Finset.range n, Y (i + 1) ω := by
  induction n with
  | zero =>
      -- At time `0`, the process and the empty product both equal `1`.
      simp [multiplicativeProcess]
  | succ n ih =>
      -- The recursive step appends the new factor to the prefix product.
      simp [multiplicativeProcess_succ, ih, Finset.prod_range_succ]

/-- Helper for Example 10.7: adjoining the constant initial coordinate `1` turns the factor
sequence into a natural filtration whose time-`n` sigma-algebra records exactly `Y₁, ..., Yₙ`. -/
private def prefixedFactorProcess (Y : ℕ → Ω → ℝ) : ℕ → Ω → ℝ
  | 0 => fun _ ↦ 1
  | n + 1 => Y (n + 1)

/-- Helper for Example 10.7: the prefixed factor process is strongly measurable when the factors
`Y₁, Y₂, …` are measurable. -/
private theorem stronglyMeasurable_prefixedFactorProcess {Y : ℕ → Ω → ℝ}
    (hY : ∀ n, Measurable (Y (n + 1))) :
    ∀ n, StronglyMeasurable (prefixedFactorProcess Y n)
  | 0 => by
      -- The prefixed zeroth coordinate is the constant map `1`.
      simpa [prefixedFactorProcess] using stronglyMeasurable_const
  | n + 1 => by
      -- All positive coordinates are just the original measurable factors.
      simpa [prefixedFactorProcess] using (hY n).stronglyMeasurable

/-- Helper for Example 10.7: the multiplicative process is strongly adapted to the natural
filtration generated by `1, Y₁, Y₂, …`. -/
private theorem multiplicativeProcess_stronglyAdapted_prefixedFactorNatural {Y : ℕ → Ω → ℝ}
    (hY : ∀ n, Measurable (Y (n + 1))) :
    StronglyAdapted
      (Filtration.natural (prefixedFactorProcess Y)
        (stronglyMeasurable_prefixedFactorProcess hY))
      (multiplicativeProcess Y) := by
  let 𝒢 : Filtration ℕ ‹MeasurableSpace Ω› :=
    Filtration.natural (prefixedFactorProcess Y)
      (stronglyMeasurable_prefixedFactorProcess hY)
  have hFactor : StronglyAdapted 𝒢 (prefixedFactorProcess Y) := by
    simpa [𝒢] using
      (Filtration.stronglyAdapted_natural
        (stronglyMeasurable_prefixedFactorProcess hY))
  intro n
  induction n with
  | zero =>
      -- The zeroth stage is the constant process `1`.
      simpa [𝒢, multiplicativeProcess] using
        (stronglyMeasurable_const : StronglyMeasurable[𝒢 0] (fun _ : Ω ↦ (1 : ℝ)))
  | succ n ih =>
      have hPrev : StronglyMeasurable[𝒢 (n + 1)] (multiplicativeProcess Y n) :=
        ih.mono (𝒢.mono (Nat.le_succ n))
      have hNext : StronglyMeasurable[𝒢 (n + 1)] (prefixedFactorProcess Y (n + 1)) :=
        hFactor (n + 1)
      -- Move the previous stage forward and multiply by the new factor.
      simpa [multiplicativeProcess_succ, prefixedFactorProcess] using hPrev.mul hNext

/-- Helper for Example 10.7: at time `0`, the prefixed factor filtration is trivial because only
the constant coordinate `1` is visible. -/
private theorem prefixedFactorNatural_zero {Y : ℕ → Ω → ℝ}
    (hY : ∀ n, Measurable (Y (n + 1))) :
    Filtration.natural (prefixedFactorProcess Y)
      (stronglyMeasurable_prefixedFactorProcess hY) 0 = ⊥ := by
  -- The only generator at time `0` is the constant coordinate.
  change (⨆ j ≤ 0, MeasurableSpace.comap (prefixedFactorProcess Y j) (borel ℝ)) = ⊥
  simp [prefixedFactorProcess, MeasurableSpace.comap_const]

/-- Helper for Example 10.7: after time `0`, the prefixed factor filtration agrees with the
natural filtration of the shifted factor sequence `Y₁, Y₂, …`. -/
private theorem prefixedFactorNatural_succ_eq_shiftedNatural {Y : ℕ → Ω → ℝ}
    (hY : ∀ n, Measurable (Y (n + 1))) (n : ℕ) :
    Filtration.natural (prefixedFactorProcess Y)
      (stronglyMeasurable_prefixedFactorProcess hY) (n + 1) =
      Filtration.natural (fun k ↦ Y (k + 1)) (fun k ↦ (hY k).stronglyMeasurable) n := by
  -- Dropping the constant zeroth coordinate leaves the shifted factor filtration.
  change (⨆ j ≤ n + 1, MeasurableSpace.comap (prefixedFactorProcess Y j) (borel ℝ)) =
      ⨆ j ≤ n, MeasurableSpace.comap (Y (j + 1)) (borel ℝ)
  refine le_antisymm ?_ ?_
  · refine iSup₂_le ?_
    intro j hj
    cases j with
    | zero =>
        simpa [prefixedFactorProcess, MeasurableSpace.comap_const]
    | succ k =>
        have hk : k ≤ n := Nat.succ_le_succ_iff.mp hj
        simpa [prefixedFactorProcess] using
          (le_iSup_of_le k <| le_iSup_of_le hk le_rfl :
            MeasurableSpace.comap (Y (k + 1)) (borel ℝ) ≤
              ⨆ j ≤ n, MeasurableSpace.comap (Y (j + 1)) (borel ℝ))
  · refine iSup₂_le ?_
    intro j hj
    simpa [prefixedFactorProcess] using
      (le_iSup_of_le (j + 1) <| le_iSup_of_le (Nat.succ_le_succ hj) le_rfl :
        MeasurableSpace.comap (prefixedFactorProcess Y (j + 1)) (borel ℝ) ≤
          ⨆ i ≤ n + 1, MeasurableSpace.comap (prefixedFactorProcess Y i) (borel ℝ))

/-- The textbook square-variation process from Example 10.7 for the multiplicative martingale
`X_n = ∏_{i=1}^n Y_i`, namely
`⟨X⟩_n = ∑_{i=0}^{n-1} Var[Y_{i+1}; μ] X_i^2`. -/
noncomputable def multiplicativeProcessSquareVariation (Y : ℕ → Ω → ℝ) (μ : Measure Ω) :
    ℕ → Ω → ℝ :=
  fun n ω ↦ ∑ i ∈ Finset.range n, Var[Y (i + 1); μ] * (multiplicativeProcess Y i ω) ^ 2

@[simp] theorem multiplicativeProcessSquareVariation_zero (Y : ℕ → Ω → ℝ) (μ : Measure Ω) :
    multiplicativeProcessSquareVariation Y μ 0 = fun _ ↦ 0 := by
  ext ω
  simp [multiplicativeProcessSquareVariation]

section

variable [IsProbabilityMeasure μ]
variable {Y : ℕ → Ω → ℝ} (hY : ∀ n, Measurable (Y (n + 1)))

local notation "X" => multiplicativeProcess Y
local notation "ℱ" => Filtration.natural X (stronglyMeasurable_multiplicativeProcess hY)
local notation "𝒢" =>
  Filtration.natural (prefixedFactorProcess Y) (stronglyMeasurable_prefixedFactorProcess hY)

/-- Helper for Example 10.7: the natural filtration of the multiplicative process is contained in
the natural filtration generated by the prefixed factor sequence `1, Y₁, Y₂, …`. -/
private theorem multiplicativeProcess_naturalLe_prefixedFactorNatural :
    ℱ ≤ 𝒢 := by
  -- The multiplicative process is adapted to the prefixed factor filtration, so its own natural
  -- filtration is smaller.
  exact (adapted_iff_natural_le (stronglyMeasurable_multiplicativeProcess hY)).mp
    (multiplicativeProcess_stronglyAdapted_prefixedFactorNatural hY).adapted

/-- Helper for Example 10.7: the fresh factor `Y_{n+1}` is independent of the past natural
filtration of the multiplicative process. -/
private theorem nextFactor_indep_natural
    (hYind : iIndepFun (fun n ↦ Y (n + 1)) μ) (n : ℕ) :
    Indep (MeasurableSpace.comap (Y (n + 1)) (borel ℝ)) (ℱ n) μ := by
  have hℱ𝒢 : ℱ ≤ 𝒢 := multiplicativeProcess_naturalLe_prefixedFactorNatural hY
  cases n with
  | zero =>
      have hIndep𝒢 :
          Indep (MeasurableSpace.comap (Y 1) (borel ℝ)) (𝒢 0) μ := by
        simpa [prefixedFactorNatural_zero (Y := Y) hY] using
          (ProbabilityTheory.indep_bot_right
            (MeasurableSpace.comap (Y 1) (borel ℝ)))
      exact ProbabilityTheory.indep_of_indep_of_le_right hIndep𝒢 (hℱ𝒢 0)
  | succ k =>
      have hIndep𝒢 :
          Indep (MeasurableSpace.comap (Y (k + 2)) (borel ℝ)) (𝒢 (k + 1)) μ := by
        simpa [prefixedFactorNatural_succ_eq_shiftedNatural (Y := Y) hY k] using
          (ProbabilityTheory.iIndepFun.indep_comap_natural_of_lt
            (f := fun j ↦ Y (j + 1))
            (fun j ↦ (hY j).stronglyMeasurable) hYind (Nat.lt_succ_self k))
      exact ProbabilityTheory.indep_of_indep_of_le_right hIndep𝒢 (hℱ𝒢 (k + 1))

/-- Helper for Example 10.7: the centered squared fresh factor `(Y_{n+1} - 1)^2` is independent
of the past natural filtration of the multiplicative process. -/
private theorem centeredFactorSq_indep_natural
    (hYind : iIndepFun (fun n ↦ Y (n + 1)) μ) (n : ℕ) :
    Indep (MeasurableSpace.comap (fun ω ↦ (Y (n + 1) ω - 1) ^ 2) (borel ℝ)) (ℱ n) μ := by
  have hBase :
      Indep (MeasurableSpace.comap (Y (n + 1)) (borel ℝ)) (ℱ n) μ :=
    nextFactor_indep_natural hY hYind n
  have hComapLe :
      MeasurableSpace.comap (fun ω ↦ (Y (n + 1) ω - 1) ^ 2) (borel ℝ) ≤
        MeasurableSpace.comap (Y (n + 1)) (borel ℝ) := by
    -- The centered-square transform is measurable as a function of the fresh factor alone.
    simpa [Function.comp] using
      ((by
          fun_prop : Measurable fun x : ℝ ↦ (x - 1) ^ 2).comp
        (comap_measurable (Y (n + 1)))).comap_le
  exact ProbabilityTheory.indep_of_indep_of_le_left hBase hComapLe

/-- Helper for Example 10.7: conditioning the fresh factor on the past natural filtration gives
its mean `1`. -/
private theorem condExp_nextFactor_natural_ae_eq_one
    (hYind : iIndepFun (fun n ↦ Y (n + 1)) μ)
    (hYmean : ∀ n, μ[Y (n + 1)] = 1) (n : ℕ) :
    μ[Y (n + 1) | ℱ n] =ᵐ[μ] fun _ ↦ 1 := by
  have hCond :
      μ[Y (n + 1) | ℱ n] =ᵐ[μ] fun _ ↦ μ[Y (n + 1)] := by
    exact MeasureTheory.condExp_indep_eq
      (hY n).comap_le (Filtration.le _ _) (comap_measurable (Y (n + 1))).stronglyMeasurable
      (nextFactor_indep_natural hY hYind n)
  -- Replace the scalar expectation by the source hypothesis `μ[Y_{n+1}] = 1`.
  exact hCond.trans <| Filter.Eventually.of_forall fun _ ↦ hYmean n

/-- Helper for Example 10.7: conditioning the centered square `(Y_{n+1} - 1)^2` on the past
natural filtration gives the variance `Var[Y_{n+1}; μ]`. -/
private theorem centeredFactorSq_condExp_natural_ae_eq_variance
    (hYind : iIndepFun (fun n ↦ Y (n + 1)) μ)
    (hYmean : ∀ n, μ[Y (n + 1)] = 1) (hY2 : ∀ n, MemLp (Y (n + 1)) 2 μ) (n : ℕ) :
    μ[(fun ω ↦ (Y (n + 1) ω - 1) ^ 2) | ℱ n] =ᵐ[μ]
      fun _ ↦ Var[Y (n + 1); μ] := by
  let Z : Ω → ℝ := fun ω ↦ (Y (n + 1) ω - 1) ^ 2
  have hZMeas : Measurable Z := by
    fun_prop
  have hCond : μ[Z | ℱ n] =ᵐ[μ] fun _ ↦ μ[Z] := by
    exact MeasureTheory.condExp_indep_eq
      hZMeas.comap_le
      (Filtration.le _ _)
      (comap_measurable Z).stronglyMeasurable
      (centeredFactorSq_indep_natural hY hYind n)
  have hYint : Integrable (Y (n + 1)) μ := (hY2 n).integrable (by norm_num)
  have hMeanZero : μ[fun ω ↦ Y (n + 1) ω - 1] = 0 := by
    -- Centering by the unit mean makes the transformed factor have expectation zero.
    simpa [integral_sub hYint (integrable_const (1 : ℝ)), hYmean n]
  have hCenteredVar :
      Var[fun ω ↦ Y (n + 1) ω - 1; μ] = μ[Z] := by
    -- A centered square has variance equal to its second moment.
    simpa [Z] using
      (ProbabilityTheory.variance_of_integral_eq_zero
        ((hY n).aemeasurable.sub aemeasurable_const) hMeanZero)
  have hShift :
      Var[fun ω ↦ Y (n + 1) ω - 1; μ] = Var[Y (n + 1); μ] := by
    -- Subtracting a constant does not change the variance.
    simpa using
      (ProbabilityTheory.variance_sub_const
        (μ := μ) ((hY2 n).aestronglyMeasurable) (1 : ℝ))
  have hMoment : μ[Z] = Var[Y (n + 1); μ] := by
    calc
      μ[Z] = Var[fun ω ↦ Y (n + 1) ω - 1; μ] := hCenteredVar.symm
      _ = Var[Y (n + 1); μ] := hShift
  -- Turn the deterministic scalar identity into the final conditional-expectation formula.
  simpa [Z] using hCond.trans <| Filter.Eventually.of_forall fun _ ↦ hMoment

-- Proof sketch: use the natural filtration of `X`, identify `X_n` as `ℱ n`-measurable by
-- construction, and combine independence of `Y_{n+1}` from the past with
-- `μ[Y_{n+1}] = 1` and the recursion `X_{n+1} = X_n Y_{n+1}`.
/-- Under independence and unit mean, the multiplicative process is a martingale with respect to
the natural filtration `σ(X)` of the process itself. The hypotheses are imposed only on the
actual factor sequence `Y₁, Y₂, …` used in the recursion. -/
-- Route correction: the helper theorem needs square-integrability of the factors so that the
-- integrability side conditions in the martingale criterion are actually available.
theorem multiplicativeProcess_martingale (hYind : iIndepFun (fun n ↦ Y (n + 1)) μ)
    (hYmean : ∀ n, μ[Y (n + 1)] = 1) (hY2 : ∀ n, MemLp (Y (n + 1)) 2 μ) :
    Martingale X ℱ μ := by
  have hXad : StronglyAdapted ℱ X :=
    Filtration.stronglyAdapted_natural (stronglyMeasurable_multiplicativeProcess hY)
  have hXint : ∀ n, Integrable (X n) μ := by
    intro n
    induction n with
    | zero =>
        -- The initial stage is the constant random variable `1`.
        simpa [multiplicativeProcess_zero] using (integrable_const (1 : ℝ))
    | succ n ih =>
        have hIndep :
            IndepFun (X n) (Y (n + 1)) μ := by
          -- The past product uses only `Y₁, …, Yₙ`, so it is independent of the fresh factor.
          have hXeq : X n = fun ω ↦ ∏ j ∈ Finset.range n, Y (j + 1) ω := by
            funext ω
            exact multiplicativeProcess_eq_prod_range (Y := Y) n ω
          have hprod :
              IndepFun (∏ j ∈ Finset.range n, Y (j + 1)) (Y (n + 1)) μ := by
            exact ProbabilityTheory.iIndepFun.indepFun_prod_range_succ₀
              (f := fun j ↦ Y (j + 1)) hYind (fun j ↦ (hY2 j).aemeasurable) n
          simpa only [hXeq, ← Finset.prod_apply] using hprod
        have hYint : Integrable (Y (n + 1)) μ := (hY2 n).integrable (by norm_num)
        -- The product recursion preserves integrability because the two factors are independent.
        simpa [multiplicativeProcess_succ] using hIndep.integrable_mul ih hYint
  have hcondZero : ∀ n, μ[X (n + 1) - X n | ℱ n] =ᵐ[μ] 0 := by
    intro n
    let C : Ω → ℝ := fun ω ↦ Y (n + 1) ω - 1
    have hCint : Integrable C μ := by
      -- The centered fresh factor is integrable because it lies in `L²`.
      exact ((hY2 n).integrable (by norm_num)).sub (integrable_const (1 : ℝ))
    have hCindep :
        IndepFun C (X n) μ := by
      -- Centering by a constant preserves independence from the past product.
      have hIndep :
          IndepFun (Y (n + 1)) (X n) μ := by
        have hXeq : X n = fun ω ↦ ∏ j ∈ Finset.range n, Y (j + 1) ω := by
          funext ω
          exact multiplicativeProcess_eq_prod_range (Y := Y) n ω
        have hprod :
            IndepFun (∏ j ∈ Finset.range n, Y (j + 1)) (Y (n + 1)) μ := by
          exact ProbabilityTheory.iIndepFun.indepFun_prod_range_succ₀
            (f := fun j ↦ Y (j + 1)) hYind (fun j ↦ (hY2 j).aemeasurable) n
        simpa only [hXeq, ← Finset.prod_apply] using hprod.symm
      simpa [C, Function.comp] using
        hIndep.comp (measurable_sub_const (c := (1 : ℝ))) measurable_id
    have hProdInt : Integrable (fun ω ↦ C ω * X n ω) μ := hCindep.integrable_mul hCint (hXint n)
    have hCondC : μ[C | ℱ n] =ᵐ[μ] 0 := by
      have hOne :
          μ[(fun _ : Ω ↦ (1 : ℝ)) | ℱ n] =ᵐ[μ] fun _ ↦ 1 := by
        exact Filter.EventuallyEq.of_eq
          (MeasureTheory.condExp_of_stronglyMeasurable
            (Filtration.le _ _) stronglyMeasurable_const
            (integrable_const (1 : ℝ)))
      -- Conditioning the centered factor is the same as conditioning `Y_{n+1}` and subtracting `1`.
      calc
        μ[C | ℱ n] =ᵐ[μ] μ[Y (n + 1) | ℱ n] - μ[(fun _ : Ω ↦ (1 : ℝ)) | ℱ n] := by
          exact condExp_sub ((hY2 n).integrable (by norm_num)) (integrable_const (1 : ℝ)) (ℱ n)
        _ =ᵐ[μ] (fun _ ↦ 1) - fun _ ↦ 1 := by
          exact (condExp_nextFactor_natural_ae_eq_one hY hYind hYmean n).sub hOne
        _ =ᵐ[μ] 0 := by
          simp
    -- Rewrite the martingale increment as the centered fresh factor times the past product.
    calc
      μ[X (n + 1) - X n | ℱ n] =ᵐ[μ]
          μ[(fun ω ↦ C ω * X n ω) | ℱ n] := by
        refine condExp_congr_ae (Filter.Eventually.of_forall fun ω ↦ ?_)
        simp [C, multiplicativeProcess_succ]
        ring
      _ =ᵐ[μ] μ[C | ℱ n] * X n := by
        filter_upwards
          [condExp_mul_of_stronglyMeasurable_right (hXad n) hProdInt hCint] with ω hω
        simpa [C] using hω
      _ =ᵐ[μ] 0 * X n := hCondC.mul Filter.EventuallyEq.rfl
      _ =ᵐ[μ] 0 := by
        simp
  -- The one-step martingale criterion finishes once the centered increment has conditional mean
  -- zero.
  exact martingale_of_condExp_sub_eq_zero_nat hXad hXint hcondZero

end

-- Proof sketch: use induction on `n` and the multiplicative recursion, combining independence on a
-- probability space with the product formula for second moments of independent nonnegative random
-- variables.
/-- If the factors `Y₁, Y₂, …` are independent and square integrable on a probability space, then
every stage of the multiplicative process is square integrable. -/
-- TODO: use `iIndepFun.indepFun_prod_range_succ₀` together with
-- `multiplicativeProcess_eq_prod_range` to prove independence of the past product and the fresh
-- factor, then convert the square-integrability step to integrability of a product of squares.
theorem multiplicativeProcess_memLp_two {Y : ℕ → Ω → ℝ}
    [IsProbabilityMeasure μ] (hYind : iIndepFun (fun n ↦ Y (n + 1)) μ)
    (hY2 : ∀ n, MemLp (Y (n + 1)) 2 μ) :
    ∀ n, MemLp (multiplicativeProcess Y n) 2 μ
  | 0 => by
      -- The initial stage is the constant random variable `1`.
      have hConstSq : Integrable (fun _ : Ω ↦ ((1 : ℝ) ^ 2)) μ := integrable_const _
      have hConst :
          MemLp (fun _ : Ω ↦ (1 : ℝ)) 2 μ := by
        exact (memLp_two_iff_integrable_sq stronglyMeasurable_const.aestronglyMeasurable).2 <| by
          simpa using hConstSq
      simpa [multiplicativeProcess_zero] using hConst
  | n + 1 => by
      have hXn : MemLp (multiplicativeProcess Y n) 2 μ := multiplicativeProcess_memLp_two hYind hY2 n
      have hIndep :
          IndepFun (multiplicativeProcess Y n) (Y (n + 1)) μ := by
        -- The past product and the fresh factor are independent.
        have hXeq : multiplicativeProcess Y n = fun ω ↦ ∏ j ∈ Finset.range n, Y (j + 1) ω := by
          funext ω
          exact multiplicativeProcess_eq_prod_range (Y := Y) n ω
        have hprod :
            IndepFun (∏ j ∈ Finset.range n, Y (j + 1)) (Y (n + 1)) μ := by
          exact ProbabilityTheory.iIndepFun.indepFun_prod_range_succ₀
            (f := fun j ↦ Y (j + 1)) hYind (fun j ↦ (hY2 j).aemeasurable) n
        simpa only [hXeq, ← Finset.prod_apply] using hprod
      have hSqIndep :
          IndepFun (fun ω ↦ (multiplicativeProcess Y n ω) ^ 2)
            (fun ω ↦ (Y (n + 1) ω) ^ 2) μ := by
        -- Squaring both independent factors preserves independence.
        simpa using hIndep.comp₀ hXn.aemeasurable (hY2 n).aemeasurable
          ((measurable_id.pow_const 2).aemeasurable)
          ((measurable_id.pow_const 2).aemeasurable)
      have hSqInt :
          Integrable (fun ω ↦ (multiplicativeProcess Y n ω) ^ 2 * (Y (n + 1) ω) ^ 2) μ :=
        hSqIndep.integrable_mul hXn.integrable_sq (hY2 n).integrable_sq
      have hSuccSqInt : Integrable (fun ω ↦ (multiplicativeProcess Y (n + 1) ω) ^ 2) μ := by
        -- Rewrite the next stage square as the product of the squared past stage and the squared
        -- fresh factor.
        refine hSqInt.congr ?_
        filter_upwards with ω
        simp [multiplicativeProcess_succ, pow_two]
        ring
      have hSuccAEStronglyMeasurable :
          AEStronglyMeasurable (multiplicativeProcess Y (n + 1)) μ := by
        simpa [multiplicativeProcess_succ] using hXn.aestronglyMeasurable.mul
          (hY2 n).aestronglyMeasurable
      -- Convert the square-integrability of the square into membership in `L²`.
      exact (memLp_two_iff_integrable_sq hSuccAEStronglyMeasurable).2 hSuccSqInt

section

variable [IsProbabilityMeasure μ]
variable {Y : ℕ → Ω → ℝ} (hY : ∀ n, Measurable (Y (n + 1)))

local notation "X" => multiplicativeProcess Y
local notation "ℱ" => Filtration.natural X (stronglyMeasurable_multiplicativeProcess hY)
local notation "A" => multiplicativeProcessSquareVariation Y μ

-- Proof sketch: rewrite `X_{n+1} - X_n` as `(Y_{n+1} - 1) X_n`, pull out the
-- `ℱ_n`-measurable factor `X_n^2` from the conditional expectation, and identify the remaining
-- scalar with `Var[Y_{n+1}; μ]` using independence and `μ[Y_{n+1}] = 1`.
/-- The conditional second moment of the increment of the multiplicative martingale is the variance
of the new factor times the square of the previous stage. -/
-- TODO: compute the conditional expectation against the prefixed factor filtration first, using
-- independence of the fresh factor from the past plus a variance rewrite for `(Yₙ₊₁ - 1)^2`,
-- and then descend to `σ(X)` by the tower property.
theorem multiplicativeProcess_condExp_sq_increment
    (hYind : iIndepFun (fun n ↦ Y (n + 1)) μ)
    (hYmean : ∀ n, μ[Y (n + 1)] = 1) (hY2 : ∀ n, MemLp (Y (n + 1)) 2 μ) (n : ℕ) :
    μ[(fun ω ↦
        (X (n + 1) ω - X n ω) ^ 2) | ℱ n] =ᵐ[μ]
      fun ω ↦ Var[Y (n + 1); μ] * (X n ω) ^ 2 := by
  let CSq : Ω → ℝ := fun ω ↦ (Y (n + 1) ω - 1) ^ 2
  have hXad : StronglyAdapted ℱ X :=
    Filtration.stronglyAdapted_natural (stronglyMeasurable_multiplicativeProcess hY)
  have hXnLp : MemLp (X n) 2 μ := multiplicativeProcess_memLp_two hYind hY2 n
  have hXsuccLp : MemLp (X (n + 1)) 2 μ := multiplicativeProcess_memLp_two hYind hY2 (n + 1)
  have hIncLp : MemLp (fun ω ↦ X (n + 1) ω - X n ω) 2 μ := by
    simpa using hXsuccLp.sub hXnLp
  have hCSqInt : Integrable CSq μ := by
    -- The centered square is integrable because the centered factor lies in `L²`.
    have hYint : Integrable (Y (n + 1)) μ := (hY2 n).integrable (by norm_num)
    have hDecomp :
        CSq = fun ω ↦ (Y (n + 1) ω) ^ 2 - 2 * Y (n + 1) ω + 1 := by
      funext ω
      simp [CSq]
      ring
    rw [hDecomp]
    exact ((hY2 n).integrable_sq.sub (hYint.const_mul 2)).add (integrable_const 1)
  have hProdInt : Integrable (fun ω ↦ CSq ω * (X n ω) ^ 2) μ := by
    -- This product is the squared increment, hence integrable.
    refine hIncLp.integrable_sq.congr ?_
    filter_upwards with ω
    simp [CSq, multiplicativeProcess_succ, pow_two]
    ring
  have hXnSqMeas : StronglyMeasurable[ℱ n] (fun ω ↦ (X n ω) ^ 2) := by
    -- The square of the past stage is still measurable with respect to the past filtration.
    simpa [pow_two] using (hXad n).mul (hXad n)
  have hCSqCond :
      μ[CSq | ℱ n] =ᵐ[μ] fun _ ↦ Var[Y (n + 1); μ] :=
    centeredFactorSq_condExp_natural_ae_eq_variance hY hYind hYmean hY2 n
  -- Rewrite the squared increment into the product `CSq * X_n^2` and pull out the past factor.
  calc
    μ[(fun ω ↦ (X (n + 1) ω - X n ω) ^ 2) | ℱ n] =ᵐ[μ]
        μ[(fun ω ↦ CSq ω * (X n ω) ^ 2) | ℱ n] := by
          refine condExp_congr_ae (Filter.Eventually.of_forall fun ω ↦ ?_)
          simp [CSq, multiplicativeProcess_succ, pow_two]
          ring
    _ =ᵐ[μ] μ[CSq | ℱ n] * fun ω ↦ (X n ω) ^ 2 := by
          filter_upwards
            [condExp_mul_of_stronglyMeasurable_right hXnSqMeas hProdInt hCSqInt] with ω hω
          simpa [CSq] using hω
    _ =ᵐ[μ] (fun _ ↦ Var[Y (n + 1); μ]) * fun ω ↦ (X n ω) ^ 2 := by
          exact hCSqCond.mul Filter.EventuallyEq.rfl
    _ =ᵐ[μ] fun ω ↦ Var[Y (n + 1); μ] * (X n ω) ^ 2 := by
          rfl

-- Proof sketch: combine the martingale statement for `X`, square integrability of each `X n`,
-- and the explicit conditional-increment formula to verify the chapter's
-- `IsSquareVariationProcess` axioms for the source-facing process `A`.
/-- Example 10.7: if `(Y_n)` is an independent sequence of square-integrable real random variables
with `μ[Y_n] = 1`, then the explicit process
`⟨X⟩_n = ∑_{i=0}^{n-1} Var[Y_{i+1}; μ] X_i^2` is a square variation process of the multiplicative
martingale `X_n = ∏_{i=1}^n Y_i` with respect to the natural filtration `σ(X)`. -/
-- TODO: combine the martingale proof, the `L²` integrability proof, and the explicit
-- conditional square-increment identity to show that `X² - A` is a martingale and `A` is
-- predictable.
theorem multiplicativeProcessSquareVariation_isSquareVariationProcess
    (hYind : iIndepFun (fun n ↦ Y (n + 1)) μ)
    (hYmean : ∀ n, μ[Y (n + 1)] = 1) (hY2 : ∀ n, MemLp (Y (n + 1)) 2 μ) :
    IsSquareVariationProcess ℱ μ X A := by
  have hXmart : Martingale X ℱ μ :=
    multiplicativeProcess_martingale hY hYind hYmean hY2
  have hXsq : ∀ n, Integrable (fun ω ↦ (X n ω) ^ 2) μ := fun n ↦
    (multiplicativeProcess_memLp_two hYind hY2 n).integrable_sq
  have hXad : StronglyAdapted ℱ X :=
    Filtration.stronglyAdapted_natural (stronglyMeasurable_multiplicativeProcess hY)
  have hSquareAd : StronglyAdapted ℱ (fun n ω ↦ (X n ω) ^ 2) := by
    -- Squaring preserves strong adaptedness.
    simpa [pow_two] using hXad.mul hXad
  have hATimeStrong : ∀ n, StronglyMeasurable[ℱ n] (A n) := by
    intro n
    induction n with
    | zero =>
        -- The compensator starts from the zero process.
        simpa [multiplicativeProcessSquareVariation] using
          (stronglyMeasurable_const : StronglyMeasurable[ℱ 0] (fun _ : Ω ↦ (0 : ℝ)))
    | succ n ih =>
        have hPrev : StronglyMeasurable[ℱ (n + 1)] (A n) := by
          exact ih.mono (Filtration.mono ℱ (Nat.le_succ n))
        have hXi : StronglyMeasurable[ℱ (n + 1)] (X n) := hXad.stronglyMeasurable_le (Nat.le_succ n)
        have hXiSq : StronglyMeasurable[ℱ (n + 1)] (fun ω ↦ (X n ω) ^ 2) := by
          simpa [pow_two] using hXi.mul hXi
        have hTerm :
            StronglyMeasurable[ℱ (n + 1)] (fun ω ↦ Var[Y (n + 1); μ] * (X n ω) ^ 2) := by
          exact stronglyMeasurable_const.mul hXiSq
        have hStep :
            A (n + 1) = A n + fun ω ↦ Var[Y (n + 1); μ] * (X n ω) ^ 2 := by
          ext ω
          simp [multiplicativeProcessSquareVariation, Finset.sum_range_succ]
        -- Split the compensator at the last summand and keep both pieces measurable.
        simpa [hStep] using hPrev.add hTerm
  have hATimeMeas : ∀ n, Measurable[ℱ n] (A n) := fun n ↦ (hATimeStrong n).measurable
  have hAAddOneMeas : ∀ n, Measurable[ℱ n] (A (n + 1)) := by
    intro n
    -- The predictable step only depends on the first `n + 1` factors of the product process.
    have hXiSq : StronglyMeasurable[ℱ n] (fun ω ↦ (X n ω) ^ 2) := by
      simpa [pow_two] using (hXad n).mul (hXad n)
    have hTerm : StronglyMeasurable[ℱ n] (fun ω ↦ Var[Y (n + 1); μ] * (X n ω) ^ 2) := by
      exact stronglyMeasurable_const.mul hXiSq
    have hStep :
        A (n + 1) = A n + fun ω ↦ Var[Y (n + 1); μ] * (X n ω) ^ 2 := by
      ext ω
      simp [multiplicativeProcessSquareVariation, Finset.sum_range_succ]
    simpa [hStep] using ((hATimeStrong n).add hTerm).measurable
  have hAPredictable : IsPredictable ℱ A := by
    refine isPredictable_of_measurable_add_one measurable_const ?_
    exact hAAddOneMeas
  have hAad : StronglyAdapted ℱ A := by
    exact hATimeStrong
  have hMint : ∀ n, Integrable (fun ω ↦ (X n ω) ^ 2 - A n ω) μ := by
    intro n
    have hAint : Integrable (A n) μ := by
      -- Finite sums of integrable square terms remain integrable.
      change Integrable
        (fun ω ↦ ∑ i ∈ Finset.range n, Var[Y (i + 1); μ] * (X i ω) ^ 2) μ
      refine integrable_finset_sum (Finset.range n) ?_
      intro i hi
      exact (hXsq i).const_mul _
    exact (hXsq n).sub hAint
  have hMad : StronglyAdapted ℱ (fun n ω ↦ (X n ω) ^ 2 - A n ω) := by
    intro n
    exact (hSquareAd n).sub (hAad n)
  have hCondZero :
      ∀ n, μ[(fun ω ↦ (X (n + 1) ω) ^ 2 - A (n + 1) ω -
          ((X n ω) ^ 2 - A n ω)) | ℱ n] =ᵐ[μ] 0 := by
    intro n
    have hAdiff :
        A (n + 1) - A n = fun ω ↦ Var[Y (n + 1); μ] * (X n ω) ^ 2 := by
      -- The explicit compensator gains exactly the new variance term at each step.
      funext ω
      change
        (∑ i ∈ Finset.range (n + 1), Var[Y (i + 1); μ] * (X i ω) ^ 2) -
            (∑ i ∈ Finset.range n, Var[Y (i + 1); μ] * (X i ω) ^ 2) =
          Var[Y (n + 1); μ] * (X n ω) ^ 2
      simp [Finset.sum_range_succ]
    have hSqDiffInt : Integrable (fun ω ↦ (X (n + 1) ω) ^ 2 - (X n ω) ^ 2) μ :=
      (hXsq (n + 1)).sub (hXsq n)
    have hAdiffInt : Integrable (A (n + 1) - A n) μ := by
      rw [hAdiff]
      exact (hXsq n).const_mul _
    have hAdiffIntRhs :
        Integrable (fun ω ↦ Var[Y (n + 1); μ] * (X n ω) ^ 2) μ := by
      exact (hXsq n).const_mul _
    have hAdiffMeas :
        StronglyMeasurable[ℱ n] (fun ω ↦ Var[Y (n + 1); μ] * (X n ω) ^ 2) := by
      have hXiSq : StronglyMeasurable[ℱ n] (fun ω ↦ (X n ω) ^ 2) := by
        simpa [pow_two] using (hXad n).mul (hXad n)
      simpa using stronglyMeasurable_const.mul hXiSq
    -- Route correction: identify the compensated-square increment with the square increment minus
    -- the explicit compensator step, then replace the conditional square increment by the formula
    -- proved above.
    calc
      μ[(fun ω ↦ (X (n + 1) ω) ^ 2 - A (n + 1) ω -
          ((X n ω) ^ 2 - A n ω)) | ℱ n] =ᵐ[μ]
          μ[(fun ω ↦ ((X (n + 1) ω) ^ 2 - (X n ω) ^ 2) - (A (n + 1) ω - A n ω)) | ℱ n] := by
            refine condExp_congr_ae (Filter.Eventually.of_forall fun ω ↦ ?_)
            ring
      _ =ᵐ[μ] μ[(fun ω ↦ (X (n + 1) ω) ^ 2 - (X n ω) ^ 2) | ℱ n] -
            μ[A (n + 1) - A n | ℱ n] := by
            exact condExp_sub hSqDiffInt hAdiffInt (ℱ n)
      _ =ᵐ[μ] μ[(fun ω ↦ (X (n + 1) ω - X n ω) ^ 2) | ℱ n] -
            μ[A (n + 1) - A n | ℱ n] := by
            exact (condExp_sqMomentDiff_eq_condExp_sqIncrement hXmart hXsq n).sub
              Filter.EventuallyEq.rfl
      _ =ᵐ[μ] (fun ω ↦ Var[Y (n + 1); μ] * (X n ω) ^ 2) -
            μ[A (n + 1) - A n | ℱ n] := by
            exact (multiplicativeProcess_condExp_sq_increment hY hYind hYmean hY2 n).sub
              Filter.EventuallyEq.rfl
      _ =ᵐ[μ] (fun ω ↦ Var[Y (n + 1); μ] * (X n ω) ^ 2) -
            fun ω ↦ Var[Y (n + 1); μ] * (X n ω) ^ 2 := by
            rw [hAdiff]
            refine Filter.EventuallyEq.rfl.sub ?_
            exact Filter.EventuallyEq.of_eq
              (MeasureTheory.condExp_of_stronglyMeasurable
                (Filtration.le _ _) hAdiffMeas hAdiffIntRhs)
      _ =ᵐ[μ] 0 := by
            simp
  -- Assemble the explicit compensator from the initial value, predictability, and the
  -- compensated-square martingale.
  refine ⟨?_, hAPredictable, martingale_of_condExp_sub_eq_zero_nat hMad hMint hCondZero⟩
  ext ω
  simp [multiplicativeProcessSquareVariation_zero]

-- Proof sketch: apply the generic bridge from any square-variation process to the canonical
-- predictable part of the squared process.
/-- At each fixed time, the canonical predictable part of the squared multiplicative martingale
agrees almost everywhere with the explicit textbook square-variation process from Example 10.7. -/
theorem multiplicativeProcess_predictablePart_ae_eq_squareVariation
    (hYind : iIndepFun (fun n ↦ Y (n + 1)) μ)
    (hYmean : ∀ n, μ[Y (n + 1)] = 1) (hY2 : ∀ n, MemLp (Y (n + 1)) 2 μ) (n : ℕ) :
    ⟨X⟩[ℱ, μ] n =ᵐ[μ] A n :=
  IsSquareVariationProcess.predictablePart_sq_ae_eq
    (multiplicativeProcessSquareVariation_isSquareVariationProcess hY hYind hYmean hY2)
    (fun k ↦ (multiplicativeProcess_memLp_two hYind hY2 k).integrable_sq)
    n

end
