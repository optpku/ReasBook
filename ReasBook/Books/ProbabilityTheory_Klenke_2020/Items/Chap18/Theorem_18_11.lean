noncomputable section

universe u v

namespace ProbabilityTheory

variable {E : Type u} [MeasurableSpace E] [DiscreteMeasurableSpace E] [Countable E]
variable {Ω : Type v} [MeasurableSpace Ω]

/-- Helper for Theorem 18.11: the base one-step kernel attached to the transition matrix `p`. -/
private abbrev baseKernel (p : E → E → ℝ≥0∞) : Kernel E E :=
  discreteMatrixKernel p

/-- Helper for Theorem 18.11: the coalescent one-step kernel attached to
`independentCoalescentMatrix p`. -/
private abbrev coalescentKernel (p : E → E → ℝ≥0∞) : Kernel (E × E) (E × E) :=
  discreteMatrixKernel (independentCoalescentMatrix p)

/-- Helper for Theorem 18.11: the coalescent semigroup generated by the one-step coalescent
kernel. -/
private abbrev coalescentSemigroup (p : E → E → ℝ≥0∞) : ℕ → Kernel (E × E) (E × E) :=
  fun n ↦ coalescentKernel p ^ n

/-- Helper for Theorem 18.11: applying a measurable state map pointwise can only shrink the
generated history filtration. -/
private lemma generatedFiltrationSpace_comp_le {Ω' α β : Type*}
    [MeasurableSpace Ω'] [MeasurableSpace α] [MeasurableSpace β]
    (X : ℕ → Ω' → α) (f : α → β) (hf : Measurable f) (s : ℕ) :
    generatedFiltrationSpace (fun n ω ↦ f (X n ω)) s ≤ generatedFiltrationSpace X s := by
  -- Proof comment: each transformed coordinate is measurable with respect to the corresponding
  -- original coordinate sigma-algebra, so the generated filtration can only decrease.
  rw [generatedFiltrationSpace]
  refine iSup_le fun n ↦ ?_
  refine iSup_le fun hn ↦ ?_
  have hXn : Measurable[generatedFiltrationSpace X s] (X n) := by
    exact Measurable.of_comap_le <| le_iSup_of_le n <| le_iSup_of_le hn le_rfl
  exact (hf.comp hXn).comap_le

/-- Helper for Theorem 18.11: the present coordinate sigma-algebra sits inside the generated
history filtration. -/
private lemma present_le_generatedHistory {Ω' α : Type*}
    [MeasurableSpace Ω'] [MeasurableSpace α] (X : ℕ → Ω' → α) (s : ℕ) :
    MeasurableSpace.comap (X s) ‹MeasurableSpace α› ≤ generatedFiltrationSpace X s := by
  -- Proof comment: this is the generic Chapter 17 present-state inclusion specialized to the
  -- current process.
  exact le_iSup_of_le s <| le_iSup_of_le le_rfl le_rfl

/-- Helper for Theorem 18.11: a measurable process has generated history filtration contained in
the ambient measurable space. -/
private lemma generatedHistory_le_ambient {Ω' α : Type*}
    [MeasurableSpace Ω'] [MeasurableSpace α]
    (X : ℕ → Ω' → α) (hX : ∀ n : ℕ, Measurable (X n)) (s : ℕ) :
    generatedFiltrationSpace X s ≤ ‹MeasurableSpace Ω'› := by
  -- Proof comment: each coordinate sigma-algebra in the defining supremum already lies in the
  -- ambient measurable space.
  exact generatedFiltrationSpace_le_ambient (X := X) hX s

/-- Helper for Theorem 18.11: summing an independent-coalescent row over the second coordinate
recovers the first-coordinate transition probability. -/
private lemma tsum_independentCoalescentMatrix_fst
    {p : E → E → ℝ≥0∞} (hp : IsStochasticMatrix p) (x y z : E) :
    ∑' w : E, independentCoalescentMatrix p (x, y) (z, w) = p x z := by
  classical
  by_cases hxy : x = y
  · subst hxy
    rw [tsum_eq_single z]
    · rw [independentCoalescentMatrix_apply_diag]
    · intro w hw
      rw [independentCoalescentMatrix_apply_diag_of_ne (p := p)]
      exact fun hzw ↦ hw hzw.symm
  · calc
      ∑' w : E, independentCoalescentMatrix p (x, y) (z, w)
          = ∑' w : E, p x z * p y w := by
              refine tsum_congr fun w ↦ ?_
              rw [independentCoalescentMatrix_apply_of_ne (p := p) hxy]
      _ = p x z * ∑' w : E, p y w := by
            rw [ENNReal.tsum_mul_left]
      _ = p x z := by
            simp [hp y]

/-- Helper for Theorem 18.11: summing an independent-coalescent row over the first coordinate
recovers the second-coordinate transition probability. -/
private lemma tsum_independentCoalescentMatrix_snd
    {p : E → E → ℝ≥0∞} (hp : IsStochasticMatrix p) (x y w : E) :
    ∑' z : E, independentCoalescentMatrix p (x, y) (z, w) = p y w := by
  classical
  by_cases hxy : x = y
  · subst hxy
    rw [tsum_eq_single w]
    · rw [independentCoalescentMatrix_apply_diag]
    · intro z hz
      rw [independentCoalescentMatrix_apply_diag_of_ne (p := p)]
      exact fun hzw ↦ hz hzw
  · calc
      ∑' z : E, independentCoalescentMatrix p (x, y) (z, w)
          = ∑' z : E, p x z * p y w := by
              refine tsum_congr fun z ↦ ?_
              rw [independentCoalescentMatrix_apply_of_ne (p := p) hxy]
      _ = (∑' z : E, p x z) * p y w := by
            rw [ENNReal.tsum_mul_right]
      _ = p y w := by
            simp [hp x]

/-- Helper for Theorem 18.11: any realization of the coalescent kernel forces the base matrix `p`
to be stochastic. -/
private lemma baseMatrix_isStochastic_of_coalescentRealization
    {p : E → E → ℝ≥0∞}
    (P : E × E → ProbabilityMeasure Ω) (Z : ℕ → Ω → E × E)
    [DiscreteMeasurableSpace (E × E)]
    [IsMarkovProcessRealization (coalescentSemigroup p) P Z] :
    IsStochasticMatrix p := by
  classical
  let hreal : IsMarkovProcessRealization (coalescentSemigroup p) P Z := inferInstance
  let _ : IsMarkovKernel (coalescentKernel p) := by
    simpa [coalescentSemigroup, coalescentKernel] using hreal.semigroup.isMarkovKernel 1
  intro x
  have hslice : ∀ z : E, ∑' w : E, independentCoalescentMatrix p (x, x) (z, w) = p x z := by
    intro z
    rw [tsum_eq_single z]
    · rw [independentCoalescentMatrix_apply_diag]
    · intro w hw
      rw [independentCoalescentMatrix_apply_diag_of_ne (p := p)]
      exact fun hzw ↦ hw hzw.symm
  have huniv : coalescentKernel p (x, x) Set.univ = 1 := by
    let hprob : IsProbabilityMeasure ((coalescentKernel p) (x, x)) :=
      (inferInstance : IsMarkovKernel (coalescentKernel p)).isProbabilityMeasure (x, x)
    exact hprob.measure_univ
  calc
    ∑' z : E, p x z = ∑' z : E, ∑' w : E, independentCoalescentMatrix p (x, x) (z, w) := by
      refine tsum_congr fun z ↦ (hslice z).symm
    _ = ∑' s : E × E, independentCoalescentMatrix p (x, x) s := by
      simpa using
        (ENNReal.tsum_prod' (f := fun s : E × E ↦ independentCoalescentMatrix p (x, x) s)).symm
    _ = 1 := by
      simpa [coalescentKernel, discreteMatrixKernel_univ] using huniv

/-- Helper for Theorem 18.11: the first marginal of the coalescent one-step kernel is the base
kernel `discreteMatrixKernel p`. -/
private lemma independentCoalescentKernel_fst {p : E → E → ℝ≥0∞}
    (hp : IsStochasticMatrix p) :
    Kernel.fst (coalescentKernel p) =
      Kernel.comap (baseKernel p) Prod.fst measurable_fst := by
  classical
  refine Kernel.ext fun a => ?_
  rcases a with ⟨x, y⟩
  refine Measure.ext fun s hs ↦ ?_
  rw [Kernel.fst_apply' _ _ hs, Kernel.comap_apply', coalescentKernel, baseKernel,
    discreteMatrixKernel_apply, discreteMatrixKernel_apply, Measure.sum_apply _ hs]
  calc
    (Measure.sum fun j ↦ independentCoalescentMatrix p (x, y) j • Measure.dirac j) (Prod.fst ⁻¹' s)
        = ∑' b : E × E,
            (independentCoalescentMatrix p (x, y) b • Measure.dirac b) (Prod.fst ⁻¹' s) := by
              rw [Measure.sum_apply _ (measurable_fst hs)]
    _ = ∑' b : E × E, independentCoalescentMatrix p (x, y) b * s.indicator 1 b.1 := by
          refine tsum_congr fun b ↦ ?_
          simp [Set.indicator, Measure.smul_apply, mul_comm]
    _ = ∑' z : E, ∑' w : E,
          independentCoalescentMatrix p (x, y) (z, w) * s.indicator 1 z := by
            simpa using
              (ENNReal.tsum_prod'
                (f := fun b : E × E ↦ independentCoalescentMatrix p (x, y) b * s.indicator 1 b.1))
    _ = ∑' z : E,
          (∑' w : E, independentCoalescentMatrix p (x, y) (z, w)) * s.indicator 1 z := by
          refine tsum_congr fun z ↦ ?_
          rw [ENNReal.tsum_mul_right]
    _ = ∑' z : E, p x z * s.indicator 1 z := by
          refine tsum_congr fun z ↦ ?_
          rw [tsum_independentCoalescentMatrix_fst hp x y z]
    _ = ∑' z : E, (p x z • Measure.dirac z) s := by
          refine tsum_congr fun z ↦ ?_
          simp [Measure.smul_apply]

/-- Helper for Theorem 18.11: the second marginal of the coalescent one-step kernel is the base
kernel `discreteMatrixKernel p`. -/
private lemma independentCoalescentKernel_snd {p : E → E → ℝ≥0∞}
    (hp : IsStochasticMatrix p) :
    Kernel.snd (coalescentKernel p) =
      Kernel.comap (baseKernel p) Prod.snd measurable_snd := by
  classical
  refine Kernel.ext fun a => ?_
  rcases a with ⟨x, y⟩
  refine Measure.ext fun s hs ↦ ?_
  rw [Kernel.snd_apply' _ _ hs, Kernel.comap_apply', coalescentKernel, baseKernel,
    discreteMatrixKernel_apply, discreteMatrixKernel_apply, Measure.sum_apply _ hs]
  calc
    (Measure.sum fun j ↦ independentCoalescentMatrix p (x, y) j • Measure.dirac j) (Prod.snd ⁻¹' s)
        = ∑' b : E × E,
            (independentCoalescentMatrix p (x, y) b • Measure.dirac b) (Prod.snd ⁻¹' s) := by
              rw [Measure.sum_apply _ (measurable_snd hs)]
    _ = ∑' b : E × E, independentCoalescentMatrix p (x, y) b * s.indicator 1 b.2 := by
          refine tsum_congr fun b ↦ ?_
          simp [Set.indicator, Measure.smul_apply, mul_comm]
    _ = ∑' z : E, ∑' w : E,
          independentCoalescentMatrix p (x, y) (z, w) * s.indicator 1 w := by
            simpa using
              (ENNReal.tsum_prod'
                (f := fun b : E × E ↦ independentCoalescentMatrix p (x, y) b * s.indicator 1 b.2))
    _ = ∑' w : E, ∑' z : E,
          independentCoalescentMatrix p (x, y) (z, w) * s.indicator 1 w := by
            rw [ENNReal.tsum_comm]
    _ = ∑' w : E,
          (∑' z : E, independentCoalescentMatrix p (x, y) (z, w)) * s.indicator 1 w := by
          refine tsum_congr fun w ↦ ?_
          rw [ENNReal.tsum_mul_right]
    _ = ∑' w : E, p y w * s.indicator 1 w := by
          refine tsum_congr fun w ↦ ?_
          rw [tsum_independentCoalescentMatrix_snd hp x y w]
    _ = ∑' w : E, (p y w • Measure.dirac w) s := by
          refine tsum_congr fun w ↦ ?_
          simp [Measure.smul_apply]

/-- Helper for Theorem 18.11: on a history slice where the time-`n` state is fixed at `y`, the
next-step singleton event has the expected kernel mass. -/
private lemma measureInter_eq_mul_stepMass_of_stateEvent
    {S Ω' : Type*} [MeasurableSpace S] [DiscreteMeasurableSpace S] [MeasurableSpace Ω']
    {q : S → S → ℝ≥0∞} {Pq : S → ProbabilityMeasure Ω'} {Xq : ℕ → Ω' → S}
    [IsMarkovProcessRealization (fun n ↦ discreteMatrixKernel q ^ n) Pq Xq]
    (x y w : S) (n : ℕ) (A : Set Ω') (hA_meas : MeasurableSet A)
    (hA_measFiltration : MeasurableSet[generatedFiltrationSpace Xq n] A)
    (hA_state : ∀ ⦃ω : Ω'⦄, ω ∈ A → Xq n ω = y) :
    (Pq x : Measure Ω') (A ∩ {ω | Xq (n + 1) ω = w}) =
      (discreteMatrixKernel q y ({w} : Set S)) * (Pq x : Measure Ω') A := by
  let μ : Measure Ω' := (Pq x : Measure Ω')
  let hReal : IsMarkovProcessRealization (fun n ↦ discreteMatrixKernel q ^ n) Pq Xq := inferInstance
  letI : IsMarkovKernel (discreteMatrixKernel q) := by
    simpa using hReal.semigroup.isMarkovKernel 1
  have hstep :
      ∀ x' : S, ∀ ⦃B : Set S⦄, MeasurableSet B → ∀ s : ℕ,
        (Pq x')⟦Xq (s + 1) ⁻¹' B | generatedFiltrationSpace Xq s⟧ =ᵐ[(Pq x' : Measure Ω')]
          fun ω ↦ ((discreteMatrixKernel q) (Xq s ω)).real B := by
    intro x' B hB s
    simpa [Nat.add_comm] using hReal.markov_property x' (A := B) hB s 1
  have hnext_meas : MeasurableSet (Xq (n + 1) ⁻¹' ({w} : Set S)) := by
    exact (hReal.measurable_process (n + 1)) (measurableSet_singleton w)
  have hslice_real :
      μ.real (A ∩ {ω | Xq (n + 1) ω = w}) =
        (discreteMatrixKernel q y ({w} : Set S)).toReal * μ.real A := by
    calc
      μ.real (A ∩ {ω | Xq (n + 1) ω = w}) =
          ∫ ω in A, Set.indicator (Xq (n + 1) ⁻¹' ({w} : Set S)) (fun _ ↦ (1 : ℝ)) ω ∂μ := by
            rw [← MeasureTheory.integral_indicator hA_meas]
            simpa [Set.indicator_indicator, Set.inter_assoc, Set.inter_left_comm,
              Set.inter_comm, smul_eq_mul] using
              (MeasureTheory.integral_indicator_const (μ := μ) (1 : ℝ)
                (hA_meas.inter hnext_meas)).symm
      _ = ∫ ω in A, ((discreteMatrixKernel q ^ 1) (Xq n ω)).real ({w} : Set S) ∂μ := by
            symm
            simpa [Nat.add_comm] using
              kernelPow_setIntegral_eq_on_history
                (κ₁ := discreteMatrixKernel q) (P := Pq) (X := Xq)
                hReal.measurable_process hstep x (A := ({w} : Set S))
                (measurableSet_singleton w) n 1 (B := A) hA_measFiltration
      _ = ∫ ω in A, (discreteMatrixKernel q y).real ({w} : Set S) ∂μ := by
            refine integral_congr_ae ?_
            filter_upwards [ae_restrict_mem hA_meas] with ω hω
            rw [hA_state hω]
            simp [pow_one]
      _ = (discreteMatrixKernel q y ({w} : Set S)).toReal * μ.real A := by
            rw [show ((discreteMatrixKernel q) y).real ({w} : Set S) =
                (((discreteMatrixKernel q) y) ({w} : Set S)).toReal by rfl]
            rw [MeasureTheory.setIntegral_const, Measure.real_def, smul_eq_mul, mul_comm]
  have hslice_enn :
      μ (A ∩ {ω | Xq (n + 1) ω = w}) =
        (discreteMatrixKernel q y ({w} : Set S)) * μ A := by
    refine
      (ENNReal.toReal_eq_toReal_iff'
        (measure_lt_top μ _).ne
        (ENNReal.mul_ne_top
          (by exact (measure_lt_top (discreteMatrixKernel q y) ({w} : Set S)).ne)
          (by exact (measure_lt_top μ A).ne))).mp ?_
    simpa [μ, Measure.real_def, ENNReal.toReal_mul, mul_comm] using hslice_real
  simpa [μ] using hslice_enn

/-- Helper for Theorem 18.11: on a history event fixing `Xq n = y`, the future singleton mass
after `t` additional steps factors through the `t`-step kernel row from `y`. -/
private lemma measureInter_eq_mul_kernelPowMass_of_stateEvent
    {S Ω' : Type*} [MeasurableSpace S] [DiscreteMeasurableSpace S] [MeasurableSpace Ω']
    {q : S → S → ℝ≥0∞} {Pq : S → ProbabilityMeasure Ω'} {Xq : ℕ → Ω' → S}
    [IsMarkovProcessRealization (fun n ↦ discreteMatrixKernel q ^ n) Pq Xq]
    (x y w : S) (n t : ℕ) (A : Set Ω') (hA_meas : MeasurableSet A)
    (hA_measFiltration : MeasurableSet[generatedFiltrationSpace Xq n] A)
    (hA_state : ∀ ⦃ω : Ω'⦄, ω ∈ A → Xq n ω = y) :
    (Pq x : Measure Ω') (A ∩ {ω | Xq (n + t) ω = w}) =
      ((discreteMatrixKernel q ^ t) y ({w} : Set S)) * (Pq x : Measure Ω') A := by
  let μ : Measure Ω' := (Pq x : Measure Ω')
  let hReal : IsMarkovProcessRealization (fun n ↦ discreteMatrixKernel q ^ n) Pq Xq :=
    inferInstance
  letI : IsMarkovKernel (discreteMatrixKernel q) := by
    simpa using hReal.semigroup.isMarkovKernel 1
  have hstep :
      ∀ x' : S, ∀ ⦃B : Set S⦄, MeasurableSet B → ∀ s : ℕ,
        (Pq x')⟦Xq (s + 1) ⁻¹' B | generatedFiltrationSpace Xq s⟧ =ᵐ[(Pq x' : Measure Ω')]
          fun ω ↦ ((discreteMatrixKernel q) (Xq s ω)).real B := by
    intro x' B hB s
    simpa [Nat.add_comm] using hReal.markov_property x' (A := B) hB s 1
  have hfuture_meas : MeasurableSet (Xq (n + t) ⁻¹' ({w} : Set S)) := by
    exact (hReal.measurable_process (n + t)) (measurableSet_singleton w)
  have hslice_real :
      μ.real (A ∩ {ω | Xq (n + t) ω = w}) =
        (((discreteMatrixKernel q ^ t) y) ({w} : Set S)).toReal * μ.real A := by
    calc
      μ.real (A ∩ {ω | Xq (n + t) ω = w}) =
          ∫ ω in A, Set.indicator (Xq (n + t) ⁻¹' ({w} : Set S)) (fun _ ↦ (1 : ℝ)) ω ∂μ := by
            rw [← MeasureTheory.integral_indicator hA_meas]
            simpa [Set.indicator_indicator, Set.inter_assoc, Set.inter_left_comm,
              Set.inter_comm, smul_eq_mul] using
              (MeasureTheory.integral_indicator_const (μ := μ) (1 : ℝ)
                (hA_meas.inter hfuture_meas)).symm
      _ = ∫ ω in A, ((discreteMatrixKernel q ^ t) (Xq n ω)).real ({w} : Set S) ∂μ := by
            symm
            simpa [Nat.add_comm] using
              kernelPow_setIntegral_eq_on_history
                (κ₁ := discreteMatrixKernel q) (P := Pq) (X := Xq)
                hReal.measurable_process hstep x (A := ({w} : Set S))
                (measurableSet_singleton w) n t (B := A) hA_measFiltration
      _ = ∫ ω in A, ((discreteMatrixKernel q ^ t) y).real ({w} : Set S) ∂μ := by
            refine integral_congr_ae ?_
            filter_upwards [ae_restrict_mem hA_meas] with ω hω
            rw [hA_state hω]
      _ = (((discreteMatrixKernel q ^ t) y) ({w} : Set S)).toReal * μ.real A := by
            rw [show ((discreteMatrixKernel q ^ t) y).real ({w} : Set S) =
                (((discreteMatrixKernel q ^ t) y) ({w} : Set S)).toReal by rfl]
            rw [MeasureTheory.setIntegral_const, Measure.real_def, smul_eq_mul, mul_comm]
  have hslice_enn :
      μ (A ∩ {ω | Xq (n + t) ω = w}) =
        ((discreteMatrixKernel q ^ t) y ({w} : Set S)) * μ A := by
    refine
      (ENNReal.toReal_eq_toReal_iff'
        (measure_lt_top μ _).ne
        (ENNReal.mul_ne_top
          (by exact (measure_lt_top ((discreteMatrixKernel q ^ t) y) ({w} : Set S)).ne)
          (by exact (measure_lt_top μ A).ne))).mp ?_
    simpa [μ, Measure.real_def, ENNReal.toReal_mul, mul_comm] using hslice_real
  simpa [μ] using hslice_enn

/-- Helper for Theorem 18.11: the first coordinate of the coalescent realization satisfies the
one-step base-kernel Markov property. -/
private lemma fst_oneStep_conditional
    {p : E → E → ℝ≥0∞}
    {P : E × E → ProbabilityMeasure Ω} {Z : ℕ → Ω → E × E}
    [DiscreteMeasurableSpace (E × E)]
    [IsMarkovProcessRealization (coalescentSemigroup p) P Z]
    (hp : IsStochasticMatrix p) (y x : E) (s : ℕ) {A : Set E} (hA : MeasurableSet A) :
    (P (x, y))⟦(fun ω ↦ (Z (s + 1) ω).1) ⁻¹' A |
      generatedFiltrationSpace (fun n ω ↦ (Z n ω).1) s⟧ =ᵐ[(P (x, y) : Measure Ω)]
        fun ω ↦ (baseKernel p ((Z s ω).1)).real A := by
  let μ : Measure Ω := (P (x, y) : Measure Ω)
  let hpair : IsMarkovProcessRealization (coalescentSemigroup p) P Z := inferInstance
  let g : Ω → ℝ := fun ω ↦ (baseKernel p ((Z s ω).1)).real A
  have hsmall_le :
      generatedFiltrationSpace (fun n ω ↦ (Z n ω).1) s ≤ generatedFiltrationSpace Z s := by
    exact generatedFiltrationSpace_comp_le Z Prod.fst measurable_fst s
  have hlarge_le : generatedFiltrationSpace Z s ≤ ‹MeasurableSpace Ω› := by
    exact generatedHistory_le_ambient Z hpair.measurable_process s
  have hstate :
      Measurable[generatedFiltrationSpace (fun n ω ↦ (Z n ω).1) s] fun ω ↦ (Z s ω).1 := by
    exact Measurable.of_comap_le <| present_le_generatedHistory (fun n ω ↦ (Z n ω).1) s
  have hg :
      AEStronglyMeasurable[generatedFiltrationSpace (fun n ω ↦ (Z n ω).1) s] g μ := by
    have hg_measurable :
        Measurable[generatedFiltrationSpace (fun n ω ↦ (Z n ω).1) s] g := by
      exact ((Kernel.measurable_coe (baseKernel p) hA).ennreal_toReal).comp hstate
    exact Measurable.aestronglyMeasurable hg_measurable
  have hpair_step :
      μ⟦(fun ω ↦ (Z (s + 1) ω).1) ⁻¹' A | generatedFiltrationSpace Z s⟧ =ᵐ[μ] g := by
    have hpair_raw :
        μ⟦(fun ω ↦ (Z (s + 1) ω).1) ⁻¹' A | generatedFiltrationSpace Z s⟧ =ᵐ[μ]
          fun ω ↦ ((discreteMatrixKernel (independentCoalescentMatrix p)) (Z s ω)).real
            (Prod.fst ⁻¹' A) := by
      simpa [Function.comp, pow_one, coalescentSemigroup, coalescentKernel, add_comm] using
        hpair.markov_property (x, y) (A := Prod.fst ⁻¹' A) (measurable_fst hA) s 1
    have hkernel :
        ∀ ω : Ω,
          ((discreteMatrixKernel (independentCoalescentMatrix p)) (Z s ω)).real (Prod.fst ⁻¹' A) =
            (baseKernel p ((Z s ω).1)).real A := by
      intro ω
      calc
        ((discreteMatrixKernel (independentCoalescentMatrix p)) (Z s ω)).real (Prod.fst ⁻¹' A)
            = ((Kernel.fst (coalescentKernel p)) (Z s ω)).real A := by
                simpa [coalescentKernel] using
                  (Kernel.fst_real_apply (coalescentKernel p) (Z s ω) (s := A) hA).symm
        _ = (baseKernel p ((Z s ω).1)).real A := by
              simpa [baseKernel, Kernel.comap_apply] using
                congrArg (fun κ : Kernel (E × E) E => (κ (Z s ω)).real A)
                  (independentCoalescentKernel_fst (p := p) hp)
    exact hpair_raw.trans <| Filter.Eventually.of_forall hkernel
  have hg_int : Integrable g μ := by
    exact (integrable_congr hpair_step).1 integrable_condExp
  calc
    μ⟦(fun ω ↦ (Z (s + 1) ω).1) ⁻¹' A | generatedFiltrationSpace (fun n ω ↦ (Z n ω).1) s⟧
        =ᵐ[μ]
          MeasureTheory.condExp
            (μ := μ)
            (m := generatedFiltrationSpace (fun n ω ↦ (Z n ω).1) s)
            (MeasureTheory.condExp
              (μ := μ)
              (m := generatedFiltrationSpace Z s)
              (((fun ω ↦ (Z (s + 1) ω).1) ⁻¹' A).indicator fun _ ↦ (1 : ℝ))) := by
              symm
              exact condExp_condExp_of_le hsmall_le hlarge_le
    _ =ᵐ[μ]
          (MeasureTheory.condExp
            (μ := μ)
            (m := generatedFiltrationSpace (fun n ω ↦ (Z n ω).1) s)
            g) := by
          exact condExp_congr_ae hpair_step
    _ =ᵐ[μ] g := by
          exact condExp_of_aestronglyMeasurable' (hsmall_le.trans hlarge_le) hg hg_int

/-- Helper for Theorem 18.11: the second coordinate of the coalescent realization satisfies the
one-step base-kernel Markov property. -/
private lemma snd_oneStep_conditional
    {p : E → E → ℝ≥0∞}
    {P : E × E → ProbabilityMeasure Ω} {Z : ℕ → Ω → E × E}
    [DiscreteMeasurableSpace (E × E)]
    [IsMarkovProcessRealization (coalescentSemigroup p) P Z]
    (hp : IsStochasticMatrix p) (x y : E) (s : ℕ) {A : Set E} (hA : MeasurableSet A) :
    (P (x, y))⟦(fun ω ↦ (Z (s + 1) ω).2) ⁻¹' A |
      generatedFiltrationSpace (fun n ω ↦ (Z n ω).2) s⟧ =ᵐ[(P (x, y) : Measure Ω)]
        fun ω ↦ (baseKernel p ((Z s ω).2)).real A := by
  let μ : Measure Ω := (P (x, y) : Measure Ω)
  let hpair : IsMarkovProcessRealization (coalescentSemigroup p) P Z := inferInstance
  let g : Ω → ℝ := fun ω ↦ (baseKernel p ((Z s ω).2)).real A
  have hsmall_le :
      generatedFiltrationSpace (fun n ω ↦ (Z n ω).2) s ≤ generatedFiltrationSpace Z s := by
    exact generatedFiltrationSpace_comp_le Z Prod.snd measurable_snd s
  have hlarge_le : generatedFiltrationSpace Z s ≤ ‹MeasurableSpace Ω› := by
    exact generatedHistory_le_ambient Z hpair.measurable_process s
  have hstate :
      Measurable[generatedFiltrationSpace (fun n ω ↦ (Z n ω).2) s] fun ω ↦ (Z s ω).2 := by
    exact Measurable.of_comap_le <| present_le_generatedHistory (fun n ω ↦ (Z n ω).2) s
  have hg :
      AEStronglyMeasurable[generatedFiltrationSpace (fun n ω ↦ (Z n ω).2) s] g μ := by
    have hg_measurable :
        Measurable[generatedFiltrationSpace (fun n ω ↦ (Z n ω).2) s] g := by
      exact ((Kernel.measurable_coe (baseKernel p) hA).ennreal_toReal).comp hstate
    exact Measurable.aestronglyMeasurable hg_measurable
  have hpair_step :
      μ⟦(fun ω ↦ (Z (s + 1) ω).2) ⁻¹' A | generatedFiltrationSpace Z s⟧ =ᵐ[μ] g := by
    have hpair_raw :
        μ⟦(fun ω ↦ (Z (s + 1) ω).2) ⁻¹' A | generatedFiltrationSpace Z s⟧ =ᵐ[μ]
          fun ω ↦ ((discreteMatrixKernel (independentCoalescentMatrix p)) (Z s ω)).real
            (Prod.snd ⁻¹' A) := by
      simpa [Function.comp, pow_one, coalescentSemigroup, coalescentKernel, add_comm] using
        hpair.markov_property (x, y) (A := Prod.snd ⁻¹' A) (measurable_snd hA) s 1
    have hkernel :
        ∀ ω : Ω,
          ((discreteMatrixKernel (independentCoalescentMatrix p)) (Z s ω)).real (Prod.snd ⁻¹' A) =
            (baseKernel p ((Z s ω).2)).real A := by
      intro ω
      calc
        ((discreteMatrixKernel (independentCoalescentMatrix p)) (Z s ω)).real (Prod.snd ⁻¹' A)
            = ((Kernel.snd (coalescentKernel p)) (Z s ω)).real A := by
                simpa [coalescentKernel, measureReal_def] using
                  congrArg ENNReal.toReal
                    (Kernel.snd_apply' (coalescentKernel p) (Z s ω) hA).symm
        _ = (baseKernel p ((Z s ω).2)).real A := by
              simpa [baseKernel, Kernel.comap_apply'] using
                congrArg (fun κ : Kernel (E × E) E => (κ (Z s ω)).real A)
                  (independentCoalescentKernel_snd (p := p) hp)
    exact hpair_raw.trans <| Filter.Eventually.of_forall hkernel
  have hg_int : Integrable g μ := by
    exact (integrable_congr hpair_step).1 integrable_condExp
  calc
    μ⟦(fun ω ↦ (Z (s + 1) ω).2) ⁻¹' A | generatedFiltrationSpace (fun n ω ↦ (Z n ω).2) s⟧
        =ᵐ[μ]
          MeasureTheory.condExp
            (μ := μ)
            (m := generatedFiltrationSpace (fun n ω ↦ (Z n ω).2) s)
            (MeasureTheory.condExp
              (μ := μ)
              (m := generatedFiltrationSpace Z s)
              (((fun ω ↦ (Z (s + 1) ω).2) ⁻¹' A).indicator fun _ ↦ (1 : ℝ))) := by
              symm
              exact condExp_condExp_of_le hsmall_le hlarge_le
    _ =ᵐ[μ]
          (MeasureTheory.condExp
            (μ := μ)
            (m := generatedFiltrationSpace (fun n ω ↦ (Z n ω).2) s)
            g) := by
          exact condExp_congr_ae hpair_step
    _ =ᵐ[μ] g := by
          exact condExp_of_aestronglyMeasurable' (hsmall_le.trans hlarge_le) hg hg_int

/-- Helper for Theorem 18.11: the coalescent realization already determines the coordinate-chain
part of successful coupling. -/
lemma independentCoalescentChain_isMarkovCoupling_of_realization
    {p : E → E → ℝ≥0∞}
    {P : E × E → ProbabilityMeasure Ω} {Z : ℕ → Ω → E × E}
    [DiscreteMeasurableSpace (E × E)]
    (hrealization :
      IsMarkovProcessRealization
        (fun n : ℕ ↦ discreteMatrixKernel (independentCoalescentMatrix p) ^ n) P Z) :
    IsMarkovCoupling p P Z := by
  letI : IsMarkovProcessRealization (coalescentSemigroup p) P Z := by
    simpa [coalescentSemigroup, coalescentKernel] using hrealization
  let hpair : IsMarkovProcessRealization (coalescentSemigroup p) P Z := inferInstance
  let hp : IsStochasticMatrix p := baseMatrix_isStochastic_of_coalescentRealization (p := p) P Z
  letI : IsMarkovKernel (baseKernel p) := discreteMatrixKernel_isMarkovKernel p hp
  refine
    { fst_realization := ?_
      snd_realization := ?_ }
  · intro y
    refine ProbabilityTheory.isMarkovProcessRealization_of_oneStepKernel
      (κ₁ := baseKernel p)
      (P := fun x ↦ P (x, y))
      (X := fun n ω ↦ (Z n ω).1)
      (hmeas := fun n ↦ measurable_fst.comp (hpair.measurable_process n))
      (hstart := ?_)
      (hstep := ?_)
    · intro x
      let μ : Measure Ω := (P (x, y) : Measure Ω)
      have hmap :
          (μ.map (Z 0)).map Prod.fst = μ.map (fun ω ↦ (Z 0 ω).1) := by
        simpa [Function.comp] using
          (Measure.map_map (μ := μ) (f := Z 0) (g := Prod.fst)
            (hf := hpair.measurable_process 0) (hg := measurable_fst))
      calc
        μ.map (fun ω ↦ (Z 0 ω).1) = (μ.map (Z 0)).map Prod.fst := hmap.symm
        _ = (Measure.dirac (x, y)).map Prod.fst := by
          rw [hpair.initial_eq (x, y)]
        _ = Measure.dirac x := by
          simp
    · intro x A hA s
      simpa using fst_oneStep_conditional (p := p) (P := P) (Z := Z) hp y x s hA
  · intro x
    refine ProbabilityTheory.isMarkovProcessRealization_of_oneStepKernel
      (κ₁ := baseKernel p)
      (P := fun y ↦ P (x, y))
      (X := fun n ω ↦ (Z n ω).2)
      (hmeas := fun n ↦ measurable_snd.comp (hpair.measurable_process n))
      (hstart := ?_)
      (hstep := ?_)
    · intro y
      let μ : Measure Ω := (P (x, y) : Measure Ω)
      have hmap :
          (μ.map (Z 0)).map Prod.snd = μ.map (fun ω ↦ (Z 0 ω).2) := by
        simpa [Function.comp] using
          (Measure.map_map (μ := μ) (f := Z 0) (g := Prod.snd)
            (hf := hpair.measurable_process 0) (hg := measurable_snd))
      calc
        μ.map (fun ω ↦ (Z 0 ω).2) = (μ.map (Z 0)).map Prod.snd := hmap.symm
        _ = (Measure.dirac (x, y)).map Prod.snd := by
          rw [hpair.initial_eq (x, y)]
        _ = Measure.dirac y := by
          simp
    · intro y A hA s
      simpa using snd_oneStep_conditional (p := p) (P := P) (Z := Z) hp x y s hA

/-- Helper for Theorem 18.11: once the coalescent chain starts on the diagonal, the next step has
zero mass on the off-diagonal. -/
private lemma coalescentDiagonal_offDiagonalMass_eq_zero
    {P : E × E → ProbabilityMeasure Ω} {Z : ℕ → Ω → E × E}
    {p : E → E → ℝ≥0∞}
    [DiscreteMeasurableSpace (E × E)]
    [IsMarkovProcessRealization
      (fun n : ℕ ↦ discreteMatrixKernel (independentCoalescentMatrix p) ^ n) P Z]
    (hp : IsStochasticMatrix p) (x : E) :
    discreteMatrixKernel (independentCoalescentMatrix p) (x, x)
      {s : E × E | s.1 ≠ s.2} = 0 := by
  let κ : Kernel (E × E) (E × E) := discreteMatrixKernel (independentCoalescentMatrix p)
  let offDiag : Set (E × E) := {s | s.1 ≠ s.2}
  have hstochastic : IsStochasticMatrix (independentCoalescentMatrix p) := by
    exact independentCoalescentMatrix_isStochasticMatrix (p := p) hp
  letI : IsMarkovKernel κ := discreteMatrixKernel_isMarkovKernel
    (independentCoalescentMatrix p) hstochastic
  calc
    κ (x, x) offDiag
        = ∑' s : E × E, offDiag.indicator (fun s ↦ κ (x, x) ({s} : Set (E × E))) s := by
            simpa using
              (Measure.tsum_indicator_apply_singleton (κ (x, x)) offDiag
                (show MeasurableSet offDiag from MeasurableSet.of_discrete)).symm
    _ = 0 := by
          refine ENNReal.tsum_eq_zero.mpr ?_
          intro s
          by_cases hs : s.1 ≠ s.2
          · rcases s with ⟨z, w⟩
            have hsOff : (z, w) ∈ offDiag := by
              simpa [offDiag] using hs
            rw [Set.indicator_of_mem hsOff]
            rw [discreteMatrixKernel_apply_singleton]
            simpa using independentCoalescentMatrix_apply_diag_of_ne (p := p) (x := x) hs
          · have hsNotOff : s ∉ offDiag := by
              simpa [offDiag] using hs
            rw [Set.indicator_of_notMem hsNotOff]

/-- Helper for Theorem 18.11: once the coalescent chain reaches the diagonal, every later
off-diagonal mass vanishes. -/
private theorem coalescentDiagonal_offDiagonalMass_pow_eq_zero
    {P : E × E → ProbabilityMeasure Ω} {Z : ℕ → Ω → E × E}
    {p : E → E → ℝ≥0∞}
    [DiscreteMeasurableSpace (E × E)]
    [IsMarkovProcessRealization
      (fun n : ℕ ↦ discreteMatrixKernel (independentCoalescentMatrix p) ^ n) P Z]
    (hp : IsStochasticMatrix p) (x : E) :
    ∀ n : ℕ, 0 < n →
      ((discreteMatrixKernel (independentCoalescentMatrix p) ^ n) (x, x))
        {s : E × E | s.1 ≠ s.2} = 0 := by
  let κ : Kernel (E × E) (E × E) := discreteMatrixKernel (independentCoalescentMatrix p)
  let offDiag : Set (E × E) := {s | s.1 ≠ s.2}
  have hstochastic : IsStochasticMatrix (independentCoalescentMatrix p) := by
    exact independentCoalescentMatrix_isStochasticMatrix (p := p) hp
  letI : IsMarkovKernel κ := discreteMatrixKernel_isMarkovKernel
    (independentCoalescentMatrix p) hstochastic
  have hoffDiag_meas : MeasurableSet offDiag := MeasurableSet.of_discrete
  have hstep_le :
      ∀ z : E × E,
        κ z offDiag ≤ Set.indicator offDiag (fun _ ↦ (1 : ℝ≥0∞)) z := by
    intro z
    by_cases hz : z.1 ≠ z.2
    · have hzOff : z ∈ offDiag := by
        simpa [offDiag] using hz
      rw [Set.indicator_of_mem hzOff]
      calc
        κ z offDiag ≤ κ z Set.univ := measure_mono (Set.subset_univ _)
        _ = 1 := by
            simpa [κ, discreteMatrixKernel_univ] using hstochastic z
    · have hzNotOff : z ∉ offDiag := by
        simpa [offDiag] using hz
      rw [Set.indicator_of_notMem hzNotOff]
      rcases z with ⟨a, b⟩
      have hab : a = b := by
        simpa using hz
      subst b
      simpa [κ, offDiag] using coalescentDiagonal_offDiagonalMass_eq_zero
        (P := P) (Z := Z) (p := p) hp a
  intro n hn
  obtain ⟨m, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.ne_of_gt hn)
  induction m with
  | zero =>
      simpa [κ, offDiag] using
        coalescentDiagonal_offDiagonalMass_eq_zero (P := P) (Z := Z) (p := p) hp x
  | succ m ih =>
      rw [Kernel.pow_succ_apply_eq_lintegral κ (m + 1) (x, x) hoffDiag_meas]
      refine le_antisymm ?_ bot_le
      calc
        ∫⁻ z, κ z offDiag ∂((κ ^ (m + 1)) (x, x)) ≤
            ∫⁻ z, Set.indicator offDiag (fun _ ↦ (1 : ℝ≥0∞)) z ∂((κ ^ (m + 1)) (x, x)) := by
              refine lintegral_mono ?_
              intro z
              exact hstep_le z
        _ = ((κ ^ (m + 1)) (x, x)) offDiag := by
            simp [offDiag, hoffDiag_meas]
        _ = 0 := ih (Nat.succ_pos _)

/-- Helper for Theorem 18.11: after time `n`, any later disagreement was already present at time
`n`, because the coalescent cannot leave the diagonal once it has entered it. -/
private theorem coalescentTailDisagreement_le_currentDisagreement
    {P : E × E → ProbabilityMeasure Ω} {Z : ℕ → Ω → E × E}
    {p : E → E → ℝ≥0∞}
    [DiscreteMeasurableSpace (E × E)]
    [IsMarkovProcessRealization
      (fun n : ℕ ↦ discreteMatrixKernel (independentCoalescentMatrix p) ^ n) P Z]
    (hp : IsStochasticMatrix p) (x y : E) :
    ∀ n : ℕ,
      (P (x, y) : Measure Ω) (⋃ m ≥ n, {ω | (Z m ω).1 ≠ (Z m ω).2}) ≤
        (P (x, y) : Measure Ω) {ω | (Z n ω).1 ≠ (Z n ω).2} := by
  let μ : Measure Ω := P (x, y)
  let disagree : ℕ → Set Ω := fun n ↦ {ω | (Z n ω).1 ≠ (Z n ω).2}
  let hrealization :
      IsMarkovProcessRealization
        (fun n : ℕ ↦ discreteMatrixKernel (independentCoalescentMatrix p) ^ n) P Z :=
    inferInstance
  intro n
  have hfuture_null :
      μ ({ω | (Z n ω).1 = (Z n ω).2} ∩ ⋃ k : ℕ, disagree (n + (k + 1))) = 0 := by
    have hslice_zero :
        ∀ k : ℕ, μ ({ω | (Z n ω).1 = (Z n ω).2} ∩ disagree (n + (k + 1))) = 0 := by
      intro k
      have hcover :
          {ω | (Z n ω).1 = (Z n ω).2} ∩ disagree (n + (k + 1)) ⊆
            ⋃ z : E, ⋃ s : {t : E × E // t.1 ≠ t.2},
              ({ω | Z n ω = (z, z)} ∩ {ω | Z (n + (k + 1)) ω = s}) := by
        intro ω hω
        rcases hω with ⟨hdiag, hdis⟩
        refine Set.mem_iUnion.2 ⟨(Z n ω).1, ?_⟩
        have hpair : Z n ω = ((Z n ω).1, (Z n ω).1) := by
          exact Prod.ext rfl hdiag.symm
        refine Set.mem_iUnion.2 ?_
        refine ⟨⟨Z (n + (k + 1)) ω, hdis⟩, ?_⟩
        constructor
        · exact hpair
        · rfl
      refine measure_mono_null hcover ?_
      refine measure_iUnion_null fun z ↦ ?_
      refine measure_iUnion_null fun s ↦ ?_
      have hslice_zero :
          μ ({ω | Z n ω = (z, z)} ∩ {ω | Z (n + (k + 1)) ω = s}) = 0 := by
        have hState_meas : MeasurableSet ({ω | Z n ω = (z, z)} : Set Ω) := by
          rw [show ({ω | Z n ω = (z, z)} : Set Ω) = Z n ⁻¹' ({(z, z)} : Set (E × E)) by
            ext ω
            simp]
          exact hrealization.measurable_process n (measurableSet_singleton (z, z))
        have hState_hist :
            MeasurableSet[generatedFiltrationSpace Z n] ({ω | Z n ω = (z, z)} : Set Ω) := by
          have hZn : Measurable[generatedFiltrationSpace Z n] (Z n) := by
            exact Measurable.of_comap_le <| present_le_generatedHistory (X := Z) n
          rw [show ({ω | Z n ω = (z, z)} : Set Ω) = Z n ⁻¹' ({(z, z)} : Set (E × E)) by
            ext ω
            simp]
          exact hZn (measurableSet_singleton (z, z))
        have hState_eq :
            ∀ ⦃ω : Ω⦄, ω ∈ ({ω | Z n ω = (z, z)} : Set Ω) → Z n ω = (z, z) := by
          intro ω hω
          simpa using hω
        rw [measureInter_eq_mul_kernelPowMass_of_stateEvent
          (q := independentCoalescentMatrix p)
          (Pq := P) (Xq := Z) (x := (x, y)) (y := (z, z))
          (w := (s : E × E)) (n := n) (t := k + 1)
          ({ω | Z n ω = (z, z)}) hState_meas hState_hist hState_eq]
        have hmass_zero :
            ((discreteMatrixKernel (independentCoalescentMatrix p) ^ (k + 1))
              (z, z)) ({(s : E × E)} : Set (E × E)) = 0 := by
          have hOff :
              ((discreteMatrixKernel (independentCoalescentMatrix p) ^ (k + 1))
                (z, z)) {t : E × E | t.1 ≠ t.2} = 0 :=
            coalescentDiagonal_offDiagonalMass_pow_eq_zero
              (P := P) (Z := Z) (p := p) hp z (k + 1) (Nat.succ_pos _)
          refine le_antisymm ?_ bot_le
          calc
            ((discreteMatrixKernel (independentCoalescentMatrix p) ^ (k + 1))
              (z, z)) ({(s : E × E)} : Set (E × E))
                ≤
              ((discreteMatrixKernel (independentCoalescentMatrix p) ^ (k + 1))
                (z, z)) {t : E × E | t.1 ≠ t.2} := by
                  exact measure_mono (Set.singleton_subset_iff.mpr s.property)
            _ = 0 := hOff
        rw [hmass_zero]
        simp
      exact hslice_zero
    have hinter :
        {ω | (Z n ω).1 = (Z n ω).2} ∩ ⋃ k : ℕ, disagree (n + (k + 1)) =
          ⋃ k : ℕ, ({ω | (Z n ω).1 = (Z n ω).2} ∩ disagree (n + (k + 1))) := by
      ext ω
      simp
    rw [hinter]
    exact measure_iUnion_null hslice_zero
  have hUnion :
      (⋃ m ≥ n, disagree m) = disagree n ∪ ⋃ k : ℕ, disagree (n + (k + 1)) := by
    ext ω
    constructor
    · intro hω
      rcases Set.mem_iUnion.1 hω with ⟨m, hm⟩
      rcases Set.mem_iUnion.1 hm with ⟨hmn, hdis⟩
      rcases Nat.eq_or_lt_of_le hmn with rfl | hlt
      · exact Or.inl hdis
      · obtain ⟨k, hk⟩ : ∃ k : ℕ, n + (k + 1) = m := ⟨m - n - 1, by omega⟩
        exact Or.inr <| Set.mem_iUnion.2 ⟨k, hk ▸ hdis⟩
    · intro hω
      rcases hω with hω | hω
      · exact Set.mem_iUnion.2 ⟨n, Set.mem_iUnion.2 ⟨le_rfl, hω⟩⟩
      · rcases Set.mem_iUnion.1 hω with ⟨k, hk⟩
        exact Set.mem_iUnion.2 ⟨n + (k + 1), Set.mem_iUnion.2 ⟨by omega, hk⟩⟩
  have hsubset :
      ⋃ k : ℕ, disagree (n + (k + 1)) ⊆
        disagree n ∪ ({ω | (Z n ω).1 = (Z n ω).2} ∩ ⋃ k : ℕ, disagree (n + (k + 1))) := by
    intro ω hω
    by_cases hdis : (Z n ω).1 ≠ (Z n ω).2
    · exact Or.inl hdis
    · have hEq : (Z n ω).1 = (Z n ω).2 := by
        by_contra hneq
        exact hdis hneq
      exact Or.inr ⟨hEq, hω⟩
  calc
    μ (⋃ m ≥ n, disagree m) = μ (disagree n ∪ ⋃ k : ℕ, disagree (n + (k + 1))) := by
      rw [hUnion]
    _ ≤ μ (disagree n) + μ ({ω | (Z n ω).1 = (Z n ω).2} ∩ ⋃ k : ℕ, disagree (n + (k + 1))) := by
      refine le_trans (measure_mono ?_) (measure_union_le _ _)
      intro ω hω
      rcases hω with hω | hω
      · exact Or.inl hω
      · exact hsubset hω
    _ = μ (disagree n) := by
      rw [hfuture_null, add_zero]

/-- Helper for Theorem 18.11: discrete-kernel irreducibility lifts to any realization of the
same chain. -/
private theorem realizationIsIrreducibleMarkovChain_of_discreteMatrixKernelIsIrreducible
    {S Ω' : Type*} [MeasurableSpace S] [DiscreteMeasurableSpace S] [MeasurableSpace Ω']
    {q : S → S → ℝ≥0∞}
    {Pq : S → ProbabilityMeasure Ω'} {Xq : ℕ → Ω' → S}
    [IsMarkovProcessRealization (fun n : ℕ ↦ discreteMatrixKernel q ^ n) Pq Xq]
    [Kernel.IsIrreducible (Measure.count : Measure S) (discreteMatrixKernel q)] :
    IsIrreducibleMarkovChain Pq Xq := by
  have hgreen :
      ∀ ⦃x y : S⦄, x ≠ y → 0 < (G[Pq, Xq; 1]) x y := by
    intro x y hxy
    have hy_pos : 0 < (Measure.count : Measure S) ({y} : Set S) := by
      simp
    -- Proof comment: irreducibility of the discrete kernel gives a positive singleton mass at a
    -- positive time, and the positive-time Green function records exactly those visits.
    rcases (inferInstance : Kernel.IsIrreducible (Measure.count : Measure S)
        (discreteMatrixKernel q)).irreducible
        (A := ({y} : Set S)) (MeasurableSet.singleton y) hy_pos x with ⟨n, hn⟩
    have hnpos : 0 < n := by
      by_contra hnpos
      have hnzero : n = 0 := Nat.eq_zero_of_not_pos hnpos
      subst hnzero
      have hzero : ((discreteMatrixKernel q ^ 0) x) ({y} : Set S) = 0 := by
        change (Kernel.id x) ({y} : Set S) = 0
        simp [Kernel.id_apply, hxy]
      rw [hzero] at hn
      exact lt_irrefl _ hn
    exact
      greenFunctionFrom_one_pos_of_posStepMass
        (κ := fun m : ℕ ↦ discreteMatrixKernel q ^ m) Pq Xq hnpos hn
  -- Proof comment: Chapter 17 packages irreducibility as positivity of the positive-time Green
  -- function on off-diagonal state pairs.
  exact
    (isIrreducibleMarkovChain_iff_greenFunctionFrom_one_pos_offDiagonal
      (κ := fun n : ℕ ↦ discreteMatrixKernel q ^ n) Pq Xq).2 hgreen

/-- Helper for Theorem 18.11: the event that the first positive return time to `x` is finite is
measurable. -/
private lemma measurableSet_firstReturnTimeFinite
    {S Ω' : Type*} [MeasurableSpace S] [DiscreteMeasurableSpace S] [Countable S]
    [MeasurableSpace Ω']
    {κ : ℕ → Kernel S S} {Pq : S → ProbabilityMeasure Ω'} {Xq : ℕ → Ω' → S}
    [IsMarkovProcessRealization κ Pq Xq] (x : S) :
    MeasurableSet {ω | (τ_[Xq, x]^1) ω < ⊤} := by
  let hreal : IsMarkovProcessRealization κ Pq Xq := inferInstance
  have hrepr :
      {ω | (τ_[Xq, x]^1) ω < ⊤} = {ω | ∃ n : ℕ, 0 < n ∧ Xq n ω = x} := by
    ext ω
    simpa [iteratedEntranceTime_one] using hittingAfter_singleton_lt_top_iff Xq x ω
  rw [hrepr]
  have hunion :
      {ω : Ω' | ∃ n : ℕ, 0 < n ∧ Xq n ω = x} =
        ⋃ n : ℕ, {ω : Ω' | 0 < n ∧ Xq n ω = x} := by
    ext ω
    simp
  rw [hunion]
  refine MeasurableSet.iUnion fun n : ℕ ↦ ?_
  by_cases hn : 0 < n
  · rw [show ({ω : Ω' | 0 < n ∧ Xq n ω = x} : Set Ω') = Xq n ⁻¹' ({x} : Set S) by
        ext ω
        simp [hn]]
    exact (hreal.measurable_process n) (measurableSet_singleton x)
  · simp [hn]

/-- Helper for Theorem 18.11: finite expected first return time implies recurrence. -/
private lemma recurrentState_of_positiveRecurrentState
    {S Ω' : Type*} [MeasurableSpace S] [DiscreteMeasurableSpace S] [Countable S]
    [MeasurableSpace Ω']
    {κ : ℕ → Kernel S S} {Pq : S → ProbabilityMeasure Ω'} {Xq : ℕ → Ω' → S}
    [IsMarkovProcessRealization κ Pq Xq] (x : S)
    (hx : IsPositiveRecurrentState Pq Xq x) :
    IsRecurrentState Pq Xq x := by
  let A : Set Ω' := {ω | (τ_[Xq, x]^1) ω < ⊤}
  have hA_meas : MeasurableSet A := by
    simpa [A] using measurableSet_firstReturnTimeFinite (κ := κ) (Pq := Pq) (Xq := Xq) x
  have hAc_zero : (Pq x : Measure Ω') Aᶜ = 0 := by
    by_contra hAc_zero
    have hindicator_top :
        ∫⁻ ω,
          Set.indicator Aᶜ (fun _ ↦ (∞ : ℝ≥0∞)) ω ∂(Pq x : Measure Ω') = ∞ := by
      have hmeas :
          AEMeasurable (Set.indicator Aᶜ (fun _ ↦ (∞ : ℝ≥0∞))) (Pq x : Measure Ω') :=
        (measurable_const.indicator hA_meas.compl).aemeasurable
      have hset :
          (Pq x : Measure Ω')
            {ω | Set.indicator Aᶜ (fun _ ↦ (∞ : ℝ≥0∞)) ω = ∞} ≠ 0 := by
        have hEq :
            {ω | Set.indicator Aᶜ (fun _ ↦ (∞ : ℝ≥0∞)) ω = ∞} = Aᶜ := by
          ext ω
          by_cases hω : ω ∈ Aᶜ
          · have hnotA : ω ∉ A := hω
            simp [Set.indicator, hω, hnotA]
          · have hA : ω ∈ A := by simpa using hω
            simp [Set.indicator, hω, hA]
        simpa [hEq] using hAc_zero
      exact lintegral_eq_top_of_measure_eq_top_ne_zero hmeas hset
    have hdom :
        ∫⁻ ω, Set.indicator Aᶜ (fun _ ↦ (∞ : ℝ≥0∞)) ω ∂(Pq x : Measure Ω') ≤
          expectedFirstReturnTime Pq Xq x := by
      rw [expectedFirstReturnTime]
      refine lintegral_mono fun ω ↦ ?_
      by_cases hω : ω ∈ Aᶜ
      · have hτ : (τ_[Xq, x]^1) ω = ⊤ := by
          have hτne : ¬ (τ_[Xq, x]^1) ω ≠ ⊤ := by
            simpa [A, Set.mem_setOf_eq, lt_top_iff_ne_top] using hω
          exact not_not.mp hτne
        simp [Set.indicator, hω, hτ]
      · simp [Set.indicator, hω]
    have htop : expectedFirstReturnTime Pq Xq x = ∞ := by
      simpa [hindicator_top] using hdom
    exact (ne_of_lt hx) htop
  have hA_prob : (Pq x : Measure Ω') A = 1 := by
    have hA_le : (Pq x : Measure Ω') A ≤ 1 := by
      have hA_le_univ : (Pq x : Measure Ω') A ≤ (Pq x : Measure Ω') Set.univ :=
        measure_mono (show A ⊆ Set.univ by intro ω _; simp)
      simpa using hA_le_univ
    have hA_ge : 1 ≤ (Pq x : Measure Ω') A := by
      have hunion : A ∪ Aᶜ = Set.univ := by
        ext ω
        simp [A]
      have hUnion_le :
          (Pq x : Measure Ω') (A ∪ Aᶜ) ≤ (Pq x : Measure Ω') A + (Pq x : Measure Ω') Aᶜ :=
        measure_union_le A Aᶜ
      calc
        1 = (Pq x : Measure Ω') Set.univ := by simp
        _ ≤ (Pq x : Measure Ω') A + (Pq x : Measure Ω') Aᶜ := by
              simpa [hunion] using hUnion_le
        _ = (Pq x : Measure Ω') A := by rw [hAc_zero, add_zero]
    exact le_antisymm hA_le hA_ge
  have hhit :
      (Pq x : Measure Ω') {ω | ∃ n : ℕ, 0 < n ∧ Xq n ω = x} = 1 := by
    have hEq : {ω | ∃ n : ℕ, 0 < n ∧ Xq n ω = x} = A := by
      ext ω
      simpa [A, iteratedEntranceTime_one] using (hittingAfter_singleton_lt_top_iff Xq x ω).symm
    rw [hEq]
    exact hA_prob
  rw [IsRecurrentState, everHitsProbability_def]
  exact (ENNReal.toReal_eq_one_iff _).2 hhit

/-- Helper for Theorem 18.11: in an irreducible chain, positive singleton mass under an invariant
distribution forces positive recurrence of that state. -/
private lemma positiveRecurrentState_of_irreducible_invariantSingletonMass
    {S Ω' : Type*} [MeasurableSpace S] [DiscreteMeasurableSpace S] [Countable S]
    [MeasurableSpace Ω']
    {q : S → S → ℝ≥0∞} {Pq : S → ProbabilityMeasure Ω'} {Xq : ℕ → Ω' → S}
    [IsMarkovProcessRealization (fun n : ℕ ↦ discreteMatrixKernel q ^ n) Pq Xq]
    (hirr : IsIrreducibleMarkovChain Pq Xq)
    {π : ProbabilityMeasure S}
    (hπ : Kernel.Invariant (discreteMatrixKernel q) (π : Measure S))
    {x : S} (hx : 0 < (π : Measure S) ({x} : Set S)) :
    IsPositiveRecurrentState Pq Xq x := by
  have hmass :
      0 < 1 / expectedFirstReturnTime Pq Xq x := by
    rw [← invariantDistribution_apply_singleton_eq_one_div_expectedFirstReturnTime
      (p := q) (P := Pq) (X := Xq) hirr hπ x]
    simpa using hx
  by_contra hpos
  have htop : expectedFirstReturnTime Pq Xq x = ∞ := by
    exact top_le_iff.mp (le_of_not_gt hpos)
  simpa [htop] using hmass

/-- Helper for Theorem 18.11: the independent product-pair matrix evolves two coordinates by
independent `p`-steps. -/
private def independentProductPairMatrix (p : E → E → ℝ≥0∞) :
    E × E → E × E → ℝ≥0∞
  | (x₁, y₁), (x₂, y₂) => p x₁ x₂ * p y₁ y₂

/-- Helper for Theorem 18.11: the diagonal-absorbed product-pair matrix freezes every diagonal
state and otherwise follows the free independent product-pair step. -/
private def independentProductPairAbsorbDiagonalMatrix (p : E → E → ℝ≥0∞) :
    E × E → E × E → ℝ≥0∞ :=
  let _ : DecidableEq E := Classical.decEq E
  fun s t ↦
    if hs : s.1 = s.2 then
      if t = s then 1 else 0
    else
      independentProductPairMatrix p s t

/-- Helper for Theorem 18.11: absorbing a step matrix at a single state keeps that state fixed
and leaves every other row unchanged. -/
private def absorbAtStateStepMatrix {S : Type*}
    (q : S → S → ℝ≥0∞) (b : S) :
    S → S → ℝ≥0∞ :=
  let _ : DecidableEq S := Classical.decEq S
  fun x y ↦ if x = b then if y = b then 1 else 0 else q x y

/-- Helper for Theorem 18.11: bounded avoidance with a prescribed endpoint is the natural
endpoint refinement of the finite-horizon avoidance event. -/
private def avoidStateUntilWithEndpoint {S Ω' : Type*}
    [MeasurableSpace Ω'] (X : ℕ → Ω' → S) (b : S) (n : ℕ) (w : S) : Set Ω' :=
  {ω | X n ω = w ∧ ∀ m ≤ n, X m ω ≠ b}

/-- Helper for Theorem 18.11: bounded diagonal-avoidance with a prescribed endpoint records that
the pair chain stays off the diagonal through time `n` and ends at `w`. -/
private def avoidDiagonalUntilWithEndpoint {Ω' : Type*}
    [MeasurableSpace Ω'] (X : ℕ → Ω' → E × E) (n : ℕ) (w : E × E) : Set Ω' :=
  {ω | X n ω = w ∧ ∀ m ≤ n, (X m ω).1 ≠ (X m ω).2}

/-- Helper for Theorem 18.11: the bounded endpoint-refined avoidance event is measurable with
respect to the time-`n` history filtration. -/
private lemma avoidStateUntilWithEndpoint_measurableSet
    {S Ω' : Type*} [MeasurableSpace S] [DiscreteMeasurableSpace S]
    [MeasurableSpace Ω'] {X : ℕ → Ω' → S}
    (hX : ∀ n : ℕ, Measurable (X n)) (b : S) (n : ℕ) (w : S) :
    MeasurableSet[generatedFiltrationSpace X n] (avoidStateUntilWithEndpoint X b n w) := by
  have hState :
      MeasurableSet[generatedFiltrationSpace X n] {ω | X n ω = w} := by
    have hXn : Measurable[generatedFiltrationSpace X n] (X n) := by
      exact Measurable.of_comap_le <| present_le_generatedHistory (X := X) n
    rw [show ({ω | X n ω = w} : Set Ω') = X n ⁻¹' ({w} : Set S) by
      ext ω
      simp]
    exact hXn (measurableSet_singleton w)
  have hAvoid :
      MeasurableSet[generatedFiltrationSpace X n] {ω | ∀ m ≤ n, X m ω ≠ b} := by
    have hrepr :
        {ω | ∀ m ≤ n, X m ω ≠ b} =
          ⋂ m : ℕ, if m ≤ n then {ω | X m ω ≠ b} else Set.univ := by
      ext ω
      simp
    rw [hrepr]
    refine MeasurableSet.iInter fun m ↦ ?_
    by_cases hm : m ≤ n
    · have hXm : Measurable[generatedFiltrationSpace X n] (X m) := by
        exact Measurable.of_comap_le <|
          le_iSup_of_le m <| le_iSup_of_le hm le_rfl
      have hEq :
          ({ω : Ω' | X m ω ≠ b} : Set Ω') = (X m ⁻¹' ({b} : Set S))ᶜ := by
        ext ω
        simp
      rw [hEq]
      simpa [hm] using (hXm (measurableSet_singleton b)).compl
    · simp [hm]
  -- Proof comment: the endpoint event and the bounded avoidance event live in the same
  -- time-`n` history, so the intersection stays history measurable.
  change
    MeasurableSet[generatedFiltrationSpace X n]
      ({ω : Ω' | X n ω = w} ∩ {ω | ∀ m ≤ n, X m ω ≠ b})
  exact hState.inter hAvoid

/-- Helper for Theorem 18.11: if the endpoint equals the forbidden state, the endpoint-refined
avoidance event is empty. -/
private lemma avoidStateUntilWithEndpoint_eq_empty
    {S Ω' : Type*} [MeasurableSpace Ω'] {X : ℕ → Ω' → S}
    (b : S) (n : ℕ) :
    avoidStateUntilWithEndpoint X b n b = (∅ : Set Ω') := by
  ext ω
  constructor
  · intro hω
    exact False.elim <| (hω.2 n le_rfl) hω.1
  · simp [avoidStateUntilWithEndpoint]

/-- Helper for Theorem 18.11: the bounded endpoint-refined diagonal-avoidance event is measurable
with respect to the time-`n` history filtration. -/
private lemma avoidDiagonalUntilWithEndpoint_measurableSet
    {Ω' : Type*} [MeasurableSpace Ω'] {X : ℕ → Ω' → E × E}
    (hX : ∀ n : ℕ, Measurable (X n)) (n : ℕ) (w : E × E) :
    MeasurableSet[generatedFiltrationSpace X n] (avoidDiagonalUntilWithEndpoint X n w) := by
  have hState :
      MeasurableSet[generatedFiltrationSpace X n] {ω | X n ω = w} := by
    have hXn : Measurable[generatedFiltrationSpace X n] (X n) := by
      exact Measurable.of_comap_le <| present_le_generatedHistory (X := X) n
    rw [show ({ω | X n ω = w} : Set Ω') = X n ⁻¹' ({w} : Set (E × E)) by
      ext ω
      simp]
    exact hXn (measurableSet_singleton w)
  have hAvoid :
      MeasurableSet[generatedFiltrationSpace X n] {ω | ∀ m ≤ n, (X m ω).1 ≠ (X m ω).2} := by
    have hrepr :
        {ω | ∀ m ≤ n, (X m ω).1 ≠ (X m ω).2} =
          ⋂ m : ℕ, if m ≤ n then {ω | (X m ω).1 ≠ (X m ω).2} else Set.univ := by
      ext ω
      simp
    rw [hrepr]
    refine MeasurableSet.iInter fun m ↦ ?_
    by_cases hm : m ≤ n
    · have hXm : Measurable[generatedFiltrationSpace X n] (X m) := by
        exact Measurable.of_comap_le <|
          le_iSup_of_le m <| le_iSup_of_le hm le_rfl
      have hDiag : MeasurableSet {s : E × E | s.1 = s.2} := by
        exact MeasurableSet.of_discrete
      have hEq :
          ({ω : Ω' | (X m ω).1 ≠ (X m ω).2} : Set Ω') =
            (X m ⁻¹' ({s : E × E | s.1 = s.2} : Set (E × E)))ᶜ := by
        ext ω
        simp
      rw [hEq]
      simpa [hm] using (hXm hDiag).compl
    · simp [hm]
  -- Proof comment: the endpoint event and the bounded diagonal-avoidance event are both
  -- determined by the time-`n` history, so their intersection is history measurable.
  change
    MeasurableSet[generatedFiltrationSpace X n]
      ({ω : Ω' | X n ω = w} ∩ {ω | ∀ m ≤ n, (X m ω).1 ≠ (X m ω).2})
  exact hState.inter hAvoid

/-- Helper for Theorem 18.11: if the prescribed endpoint is diagonal, then bounded diagonal
avoidance with that endpoint is impossible. -/
private lemma avoidDiagonalUntilWithEndpoint_eq_empty_of_diag
    {Ω' : Type*} [MeasurableSpace Ω'] {X : ℕ → Ω' → E × E}
    (n : ℕ) {w : E × E} (hw : w.1 = w.2) :
    avoidDiagonalUntilWithEndpoint X n w = (∅ : Set Ω') := by
  ext ω
  constructor
  · intro hω
    exact False.elim <| (hω.2 n le_rfl) (by simpa [hω.1] using hw)
  · simp [avoidDiagonalUntilWithEndpoint]

/-- Helper for Theorem 18.11: on a countable discrete state space, integrating singleton rows of a
kernel is the same as summing the singleton masses against the source measure. -/
private lemma lintegral_kernel_apply_singleton_eq_tsum
    {S : Type*} [MeasurableSpace S] [DiscreteMeasurableSpace S] [Countable S]
    (κ : Kernel S S) (μ : Measure S) (w : S) :
    ∫⁻ c, κ c ({w} : Set S) ∂μ =
      ∑' c : S, κ c ({w} : Set S) * μ ({c} : Set S) := by
  -- Proof comment: `lintegral_countable'` is the standard discrete-space bridge from a kernel
  -- integral to the corresponding countable singleton sum.
  simpa [mul_comm] using
    (MeasureTheory.lintegral_countable' (μ := μ)
      (f := fun c : S ↦ κ c ({w} : Set S)))

/-- Helper for Theorem 18.11: the absorbed-at-state matrix has the Dirac row at the absorbing
state. -/
private lemma absorbAtStateStepMatrix_apply_eq
    {S : Type*} [DecidableEq S] (q : S → S → ℝ≥0∞) (b w : S) :
    absorbAtStateStepMatrix q b b w = if w = b then 1 else 0 := by
  -- Proof comment: at the absorbing state, the definition collapses to the single diagonal mass.
  simp [absorbAtStateStepMatrix]

/-- Helper for Theorem 18.11: away from the absorbing state, the absorbed matrix agrees with the
original step matrix. -/
private lemma absorbAtStateStepMatrix_apply_of_ne
    {S : Type*} (q : S → S → ℝ≥0∞) {b x w : S} (hx : x ≠ b) :
    absorbAtStateStepMatrix q b x w = q x w := by
  -- Proof comment: only the distinguished row is modified by the absorption construction.
  classical
  simp [absorbAtStateStepMatrix, hx]

/-- Helper for Theorem 18.11: stochasticity survives when one row is replaced by the Dirac mass at
the absorbing state. -/
private lemma absorbAtStateStepMatrix_isStochastic
    {S : Type*} [Countable S] (q : S → S → ℝ≥0∞) (b : S)
    (hq : IsStochasticMatrix q) :
    IsStochasticMatrix (absorbAtStateStepMatrix q b) := by
  classical
  intro x
  by_cases hx : x = b
  · subst x
    rw [tsum_eq_single b]
    · simp [absorbAtStateStepMatrix]
    · intro w hw
      simp [absorbAtStateStepMatrix, hw]
  · simp [absorbAtStateStepMatrix, hx, hq x]

/-- Helper for Theorem 18.11: a probability measure on a countable discrete state space charges
some singleton positively. -/
private lemma exists_singletonMass_pos (μ : ProbabilityMeasure E) :
    ∃ x : E, 0 < (μ : Measure E) ({x} : Set E) := by
  -- Proof comment: if every singleton had mass `0`, the countable singleton decomposition of
  -- `Set.univ` would force the total mass of `μ` to vanish.
  by_contra hmass
  have hzero : ∀ x : E, (μ : Measure E) ({x} : Set E) = 0 := by
    intro x
    by_contra hx
    exact hmass ⟨x, bot_lt_iff_ne_bot.mpr hx⟩
  have huniv_zero : (μ : Measure E) Set.univ = 0 := by
    calc
      (μ : Measure E) Set.univ = ∑' x : E, (μ : Measure E) ({x} : Set E) := by
        symm
        simpa using
          (μ : Measure E).tsum_indicator_apply_singleton Set.univ MeasurableSet.univ
      _ = 0 := by
        rw [ENNReal.tsum_eq_zero]
        exact hzero
  have hone : (1 : ℝ≥0∞) = 0 := by
    simp at huniv_zero
  exact one_ne_zero hone

/-- Helper for Theorem 18.11: the product invariant law has positive mass on at least one diagonal
singleton. -/
private lemma exists_pos_diagonalSingletonMass_prod_of_invariant
    (π : ProbabilityMeasure E) :
    ∃ x₀ : E, 0 < (((π : Measure E).prod π) ({(x₀, x₀)} : Set (E × E))) := by
  obtain ⟨x₀, hx₀⟩ := exists_singletonMass_pos π
  refine ⟨x₀, ?_⟩
  -- Proof comment: the diagonal singleton is the product of the same positive singleton mass with
  -- itself.
  calc
    0 < (π : Measure E) ({x₀} : Set E) * (π : Measure E) ({x₀} : Set E) := by
          exact ENNReal.mul_pos hx₀.ne' hx₀.ne'
    _ = (((π : Measure E).prod π) ({(x₀, x₀)} : Set (E × E))) := by
          have hprod :
              (((π : Measure E).prod π) ({(x₀, x₀)} : Set (E × E))) =
                (π : Measure E) ({x₀} : Set E) * (π : Measure E) ({x₀} : Set E) := by
            simpa [Set.singleton_prod_singleton] using
              (Measure.prod_prod (μ := (π : Measure E)) (ν := (π : Measure E))
                ({x₀} : Set E) ({x₀} : Set E))
          exact hprod.symm

/-- Helper for Theorem 18.11: the `n`-step singleton masses of the free product-pair kernel
factor into the corresponding singleton masses of the two coordinates. -/
private lemma independentProductPairKernelPow_apply_singleton
    {p : E → E → ℝ≥0∞} (hp : IsStochasticMatrix p) (n : ℕ)
    (x₁ y₁ x₂ y₂ : E) :
    (((baseKernel p ∥ₖ baseKernel p) ^ n) (x₁, y₁))
        ({(x₂, y₂)} : Set (E × E)) =
      ((baseKernel p ^ n) x₁) ({x₂} : Set E) *
        ((baseKernel p ^ n) y₁) ({y₂} : Set E) := by
  let κ : Kernel E E := baseKernel p
  let κq : Kernel (E × E) (E × E) := κ ∥ₖ κ
  letI : IsMarkovKernel κ := discreteMatrixKernel_isMarkovKernel p hp
  have hpow : ∀ m : ℕ, κq ^ m = (κ ^ m) ∥ₖ (κ ^ m) := by
    intro m
    induction m with
    | zero =>
        -- Proof comment: at time `0`, both sides are the identity kernel on the product state
        -- space.
        change (Kernel.id : Kernel (E × E) (E × E)) =
          (Kernel.id : Kernel E E) ∥ₖ Kernel.id
        exact Kernel.id_parallelComp_id.symm
    | succ m ihm =>
        -- Proof comment: powers of a parallel kernel remain parallel because composition
        -- distributes across `∥ₖ`.
        calc
          κq ^ (m + 1) = κq ∘ₖ (κq ^ m) := by
            simpa [pow_one, Nat.one_add] using (ProbabilityTheory.Kernel.pow_add κq 1 m)
          _ = (κ ∥ₖ κ) ∘ₖ ((κ ^ m) ∥ₖ (κ ^ m)) := by
            rw [ihm]
          _ = (κ ∘ₖ (κ ^ m)) ∥ₖ (κ ∘ₖ (κ ^ m)) := by
            rw [Kernel.parallelComp_comp_parallelComp]
          _ = (κ ^ (m + 1)) ∥ₖ (κ ^ (m + 1)) := by
            congr 1 <;> symm <;>
              simpa [pow_one, Nat.one_add] using (ProbabilityTheory.Kernel.pow_add κ 1 m)
  have hsingleton :
      ({((x₂, y₂) : E × E)} : Set (E × E)) =
        ({x₂} : Set E) ×ˢ ({y₂} : Set E) := by
    ext t
    simp
  -- Proof comment: once the product kernel power is normalized, the singleton target is a product
  -- set and `parallelComp_apply_prod` yields the factorization.
  rw [hpow n, hsingleton, Kernel.parallelComp_apply_prod]

/-- Helper for Theorem 18.11: the free product-pair kernel is irreducible when the base kernel is
irreducible and aperiodic. -/
private theorem independentProductPairKernel_isIrreducible
    {p : E → E → ℝ≥0∞} (hp : IsStochasticMatrix p)
    [Kernel.IsIrreducible (Measure.count : Measure E) (baseKernel p)]
    (haper : IsAperiodic (baseKernel p)) :
    Kernel.IsIrreducible (Measure.count : Measure (E × E)) (baseKernel p ∥ₖ baseKernel p) := by
  let κ : Kernel E E := baseKernel p
  let κq : Kernel (E × E) (E × E) := κ ∥ₖ κ
  letI : IsMarkovKernel κ := discreteMatrixKernel_isMarkovKernel p hp
  refine ⟨?_⟩
  intro A hA hcount a
  obtain ⟨b, hbA⟩ :=
    MeasureTheory.nonempty_of_measure_ne_zero (μ := (Measure.count : Measure (E × E)))
      (ne_of_lt hcount).symm
  rcases a with ⟨x₁, y₁⟩
  rcases b with ⟨x₂, y₂⟩
  rcases exists_eventual_period_residue (κ := κ) x₁ x₂ with ⟨L₁, hL₁lt, ⟨N₁, hN₁⟩⟩
  rcases exists_eventual_period_residue (κ := κ) y₁ y₂ with ⟨L₂, hL₂lt, ⟨N₂, hN₂⟩⟩
  have hxperiod : statePeriod κ x₁ = 1 := haper x₁
  have hyperiod : statePeriod κ y₁ = 1 := haper y₁
  rw [hxperiod] at hL₁lt
  rw [hyperiod] at hL₂lt
  have hL₁zero : L₁ = 0 := by
    omega
  have hL₂zero : L₂ = 0 := by
    omega
  let N := max N₁ N₂
  refine ⟨N, ?_⟩
  have hx₂ :
      0 < ((κ ^ N) x₁) ({x₂} : Set E) := by
    have hmem :
        N * statePeriod κ x₁ + L₁ ∈ positiveTransitionStepSet κ x₁ x₂ :=
      hN₁ N (le_max_left N₁ N₂)
    simpa [hxperiod, hL₁zero, mem_positiveTransitionStepSet_iff] using hmem
  have hy₂ :
      0 < ((κ ^ N) y₁) ({y₂} : Set E) := by
    have hmem :
        N * statePeriod κ y₁ + L₂ ∈ positiveTransitionStepSet κ y₁ y₂ :=
      hN₂ N (le_max_right N₁ N₂)
    simpa [hyperiod, hL₂zero, mem_positiveTransitionStepSet_iff] using hmem
  have hsingleton_pos :
      0 < ((κq ^ N) (x₁, y₁)) ({(x₂, y₂)} : Set (E × E)) := by
    rw [independentProductPairKernelPow_apply_singleton (p := p) hp N x₁ y₁ x₂ y₂]
    exact ENNReal.mul_pos hx₂.ne' hy₂.ne'
  -- Proof comment: a positive singleton mass at one point of `A` suffices for irreducibility of
  -- the whole measurable target set `A`.
  exact lt_of_lt_of_le hsingleton_pos (measure_mono (Set.singleton_subset_iff.mpr hbA))

/-- Helper for Theorem 18.11: the product of an invariant distribution with itself is invariant
for the free product-pair kernel. -/
private theorem independentProductPairKernel_invariantProd
    {p : E → E → ℝ≥0∞} (hp : IsStochasticMatrix p) (π : ProbabilityMeasure E)
    (hπ : Kernel.Invariant (baseKernel p) (π : Measure E)) :
    Kernel.Invariant (baseKernel p ∥ₖ baseKernel p) ((π : Measure E).prod π) := by
  let κ : Kernel E E := baseKernel p
  let κq : Kernel (E × E) (E × E) := κ ∥ₖ κ
  letI : IsMarkovKernel κ := discreteMatrixKernel_isMarkovKernel p hp
  have hstepRight :
      (Kernel.id ∥ₖ κ) ∘ₘ ((π : Measure E).prod π) =
        (π : Measure E).prod (κ ∘ₘ (π : Measure E)) := by
    symm
    exact Measure.prod_comp_right (μ := (π : Measure E)) (ν := (π : Measure E))
  have hstepLeft :
      (κ ∥ₖ Kernel.id) ∘ₘ ((π : Measure E).prod (κ ∘ₘ (π : Measure E))) =
        (κ ∘ₘ (π : Measure E)).prod (κ ∘ₘ (π : Measure E)) := by
    symm
    exact Measure.prod_comp_left (μ := (π : Measure E)) (ν := (κ ∘ₘ (π : Measure E)))
  -- Proof comment: push the product measure through the second coordinate, then the first
  -- coordinate, and finally use invariance of `π` for the one-dimensional kernel.
  have hdecomp : κq = (κ ∥ₖ Kernel.id) ∘ₖ (Kernel.id ∥ₖ κ) := by
    rw [Kernel.parallelComp_comp_parallelComp, Kernel.comp_id, Kernel.id_comp]
  change κq ∘ₘ ((π : Measure E).prod π) = ((π : Measure E).prod π)
  calc
    κq ∘ₘ ((π : Measure E).prod π)
        = (((κ ∥ₖ Kernel.id) ∘ₖ (Kernel.id ∥ₖ κ)) ∘ₘ ((π : Measure E).prod π)) := by
            rw [hdecomp]
    _ = ((κ ∥ₖ Kernel.id) ∘ₘ ((Kernel.id ∥ₖ κ) ∘ₘ ((π : Measure E).prod π))) := by
          rw [Measure.comp_assoc]
    _ = (κ ∥ₖ Kernel.id) ∘ₘ ((π : Measure E).prod (κ ∘ₘ (π : Measure E))) := by
          rw [hstepRight]
    _ = (κ ∘ₘ (π : Measure E)).prod (κ ∘ₘ (π : Measure E)) := by
          rw [hstepLeft]
    _ = ((π : Measure E).prod π) := by
          simpa using congrArg₂ Measure.prod hπ.def hπ.def

/-- Helper for Theorem 18.11: the free product-pair matrix is stochastic whenever the base
matrix is stochastic. -/
private theorem independentProductPairMatrix_isStochastic
    {p : E → E → ℝ≥0∞} (hp : IsStochasticMatrix p) :
    IsStochasticMatrix (independentProductPairMatrix p) := by
  intro s
  rcases s with ⟨x, y⟩
  -- Proof comment: the free pair row is the product of the two base rows, so its total mass
  -- factors into the two one-dimensional row sums.
  calc
    ∑' t : E × E, independentProductPairMatrix p (x, y) t
        = ∑' z : E, ∑' w : E, independentProductPairMatrix p (x, y) (z, w) := by
            simpa using
              (ENNReal.tsum_prod'
                (f := fun t : E × E ↦ independentProductPairMatrix p (x, y) t))
    _ = ∑' z : E, ∑' w : E, p x z * p y w := by
          rfl
    _ = ∑' z : E, p x z * ∑' w : E, p y w := by
          refine tsum_congr fun z ↦ ?_
          rw [ENNReal.tsum_mul_left]
    _ = ∑' z : E, p x z * 1 := by
          simp [hp y]
    _ = (∑' z : E, p x z) * 1 := by
          rw [ENNReal.tsum_mul_right]
    _ = 1 := by
          simp [hp x]

/-- Helper for Theorem 18.11: absorbing the diagonal preserves stochasticity of the free
product-pair matrix. -/
private theorem independentProductPairAbsorbDiagonalMatrix_isStochastic
    {p : E → E → ℝ≥0∞} (hp : IsStochasticMatrix p) :
    IsStochasticMatrix (independentProductPairAbsorbDiagonalMatrix p) := by
  classical
  intro s
  by_cases hs : s.1 = s.2
  · rw [tsum_eq_single s]
    · simp [independentProductPairAbsorbDiagonalMatrix, hs]
    · intro t ht
      simp [independentProductPairAbsorbDiagonalMatrix, hs, ht]
  · simp [independentProductPairAbsorbDiagonalMatrix, hs,
      independentProductPairMatrix_isStochastic (p := p) hp s]

/-- Helper for Theorem 18.11: the free product-pair matrix kernel is the parallel composition of
the two base kernels. -/
private lemma discreteMatrixKernel_independentProductPairMatrix_eq_parallel
    {p : E → E → ℝ≥0∞} (hp : IsStochasticMatrix p) :
    discreteMatrixKernel (independentProductPairMatrix p) = baseKernel p ∥ₖ baseKernel p := by
  letI : IsMarkovKernel (baseKernel p) := discreteMatrixKernel_isMarkovKernel p hp
  refine Kernel.ext fun a ↦ ?_
  rcases a with ⟨x, y⟩
  refine Measure.ext_of_singleton ?_
  intro b
  rcases b with ⟨z, w⟩
  -- Proof comment: on singleton targets, both kernels evaluate to the same product of the two
  -- one-dimensional singleton masses.
  have hsingleton :
      ({((z, w) : E × E)} : Set (E × E)) = ({z} : Set E) ×ˢ ({w} : Set E) := by
    ext t
    simp
  rw [discreteMatrixKernel_apply_singleton, hsingleton, Kernel.parallelComp_apply_prod,
    discreteMatrixKernel_apply_singleton, discreteMatrixKernel_apply_singleton]
  rfl

section IndependentProductPairAvoidance

variable {Ωq : Type*} [MeasurableSpace Ωq]
variable {p : E → E → ℝ≥0∞}
variable {Pq : E × E → ProbabilityMeasure Ωq}
variable {Xq : ℕ → Ωq → E × E}
variable [IsMarkovProcessRealization
  (fun n : ℕ ↦ discreteMatrixKernel (independentProductPairMatrix p) ^ n) Pq Xq]

/-- Helper for Theorem 18.11: bounded diagonal avoidance with an off-diagonal endpoint equals the
corresponding singleton mass of the absorbed free product-pair chain. -/
private theorem freeAvoidDiagonalEndpointProb_eq_absorbedDiagonalEndpointMass
    (hp : IsStochasticMatrix p) :
    ∀ n : ℕ, ∀ a : E × E, ∀ {w : E × E}, w.1 ≠ w.2 →
      (Pq a : Measure Ωq) (avoidDiagonalUntilWithEndpoint Xq n w) =
        ((discreteMatrixKernel (independentProductPairAbsorbDiagonalMatrix p) ^ n) a)
          ({w} : Set (E × E)) := by
  let κAbs : Kernel (E × E) (E × E) :=
    discreteMatrixKernel (independentProductPairAbsorbDiagonalMatrix p)
  letI : IsMarkovKernel κAbs :=
    discreteMatrixKernel_isMarkovKernel
      (independentProductPairAbsorbDiagonalMatrix p)
      (independentProductPairAbsorbDiagonalMatrix_isStochastic (p := p) hp)
  let hqreal :
      IsMarkovProcessRealization
        (fun n : ℕ ↦ discreteMatrixKernel (independentProductPairMatrix p) ^ n) Pq Xq :=
    inferInstance
  intro n
  induction n with
  | zero =>
      intro a w hw
      have hset :
          avoidDiagonalUntilWithEndpoint Xq 0 w = {ω | Xq 0 ω = w} := by
        ext ω
        constructor
        · intro hω
          exact hω.1
        · intro hω
          refine ⟨hω, ?_⟩
          intro m hm
          have hmzero : m = 0 := Nat.eq_zero_of_le_zero hm
          subst hmzero
          cases hω
          exact hw
      -- Proof comment: at time `0`, the endpoint already forces diagonal avoidance.
      rw [hset]
      rw [show ({ω | Xq 0 ω = w} : Set Ωq) = Xq 0 ⁻¹' ({w} : Set (E × E)) by
        ext ω
        simp]
      rw [← Measure.map_apply (hqreal.measurable_process 0) (measurableSet_singleton w)]
      rw [hqreal.transition_eq a 0]
      simp [κAbs, Kernel.id_apply, hw]
  | succ n ih =>
      intro a w hw
      let μ : Measure Ωq := (Pq a : Measure Ωq)
      have hUnion :
          avoidDiagonalUntilWithEndpoint Xq (n + 1) w =
            ⋃ c : E × E, avoidDiagonalUntilWithEndpoint Xq n c ∩ {ω | Xq (n + 1) ω = w} := by
          ext ω
          constructor
          · intro hω
            refine Set.mem_iUnion.2 ⟨Xq n ω, ?_⟩
            refine ⟨?_, hω.1⟩
            refine ⟨rfl, ?_⟩
            intro m hm
            exact hω.2 m (Nat.le_trans hm (Nat.le_succ _))
          · intro hω
            rcases Set.mem_iUnion.1 hω with ⟨c, hcω⟩
            refine ⟨hcω.2, ?_⟩
            intro m hm
            rcases Nat.eq_or_lt_of_le hm with rfl | hm_lt
            · cases hcω.2
              exact hw
            · exact hcω.1.2 m (Nat.le_of_lt_succ hm_lt)
      have hPairwise :
          Pairwise fun c d : E × E ↦
            Disjoint
              (avoidDiagonalUntilWithEndpoint Xq n c ∩ {ω | Xq (n + 1) ω = w})
              (avoidDiagonalUntilWithEndpoint Xq n d ∩ {ω | Xq (n + 1) ω = w}) := by
          intro c d hcd
          refine Set.disjoint_left.2 ?_
          intro ω hc hd
          apply hcd
          exact hc.1.1.symm.trans hd.1.1
      have hMeas :
          ∀ c : E × E,
            MeasurableSet
              (avoidDiagonalUntilWithEndpoint Xq n c ∩ {ω | Xq (n + 1) ω = w}) := by
          intro c
          have hAvoid :
              MeasurableSet (avoidDiagonalUntilWithEndpoint Xq n c) := by
            have hAvoid_hist :
                MeasurableSet[generatedFiltrationSpace Xq n]
                  (avoidDiagonalUntilWithEndpoint Xq n c) :=
              avoidDiagonalUntilWithEndpoint_measurableSet hqreal.measurable_process n c
            exact
              (generatedHistory_le_ambient Xq hqreal.measurable_process n) _
                hAvoid_hist
          have hState :
              MeasurableSet ({ω | Xq (n + 1) ω = w} : Set Ωq) := by
            rw [show ({ω | Xq (n + 1) ω = w} : Set Ωq) =
                Xq (n + 1) ⁻¹' ({w} : Set (E × E)) by
              ext ω
              simp]
            exact (hqreal.measurable_process (n + 1)) (measurableSet_singleton w)
          exact hAvoid.inter hState
      -- Proof comment: decompose by the time-`n` endpoint, factor each history slice through the
      -- free one-step row, and replace that row by the absorbed row away from the diagonal.
      calc
        μ (avoidDiagonalUntilWithEndpoint Xq (n + 1) w) =
            ∑' c : E × E,
              μ (avoidDiagonalUntilWithEndpoint Xq n c ∩ {ω | Xq (n + 1) ω = w}) := by
                rw [hUnion]
                exact MeasureTheory.measure_iUnion hPairwise hMeas
        _ =
            ∑' c : E × E,
              (discreteMatrixKernel (independentProductPairAbsorbDiagonalMatrix p) c
                  ({w} : Set (E × E))) *
                ((κAbs ^ n) a) ({c} : Set (E × E)) := by
                  refine tsum_congr fun c ↦ ?_
                  by_cases hc : c.1 ≠ c.2
                  · have hAvoid_meas :
                        MeasurableSet (avoidDiagonalUntilWithEndpoint Xq n c) := by
                      have hAvoid_hist :
                          MeasurableSet[generatedFiltrationSpace Xq n]
                            (avoidDiagonalUntilWithEndpoint Xq n c) :=
                        avoidDiagonalUntilWithEndpoint_measurableSet hqreal.measurable_process n c
                      exact
                        (generatedHistory_le_ambient Xq hqreal.measurable_process n) _
                          hAvoid_hist
                    have hAvoid_hist :
                        MeasurableSet[generatedFiltrationSpace Xq n]
                          (avoidDiagonalUntilWithEndpoint Xq n c) :=
                      avoidDiagonalUntilWithEndpoint_measurableSet hqreal.measurable_process n c
                    have hAvoid_state :
                        ∀ ⦃ω : Ωq⦄, ω ∈ avoidDiagonalUntilWithEndpoint Xq n c → Xq n ω = c := by
                      intro ω hω
                      exact hω.1
                    rw [measureInter_eq_mul_stepMass_of_stateEvent
                      (q := independentProductPairMatrix p) (Pq := Pq) (Xq := Xq) a c w n
                      (avoidDiagonalUntilWithEndpoint Xq n c)
                      hAvoid_meas hAvoid_hist hAvoid_state]
                    rw [discreteMatrixKernel_apply_singleton, discreteMatrixKernel_apply_singleton]
                    have hmass := ih a (w := c) hc
                    simpa [independentProductPairAbsorbDiagonalMatrix, independentProductPairMatrix,
                      hc, mul_assoc, mul_left_comm, mul_comm] using
                      congrArg (fun t ↦ independentProductPairMatrix p c w * t) hmass
                  · have hcdiag : c.1 = c.2 := by
                      simpa using hc
                    rw [avoidDiagonalUntilWithEndpoint_eq_empty_of_diag (X := Xq) n hcdiag]
                    have hcw : w ≠ c := by
                      intro hEq
                      apply hw
                      simpa [hEq] using hcdiag
                    have hstep_zero :
                        discreteMatrixKernel (independentProductPairAbsorbDiagonalMatrix p) c
                          ({w} : Set (E × E)) = 0 := by
                      rw [discreteMatrixKernel_apply_singleton]
                      simp [independentProductPairAbsorbDiagonalMatrix, hcdiag, hcw]
                    rw [hstep_zero]
                    simp
        _ = ((κAbs ^ (n + 1)) a) ({w} : Set (E × E)) := by
              rw [Kernel.pow_succ_apply_eq_lintegral κAbs n a (measurableSet_singleton w)]
              rw [MeasureTheory.lintegral_countable']

/-- Helper for Theorem 18.11: the absorbed free product-pair chain's off-diagonal mass is exactly
the bounded diagonal-avoidance probability of the free product-pair chain. -/
private theorem independentProductPairAbsorbDiagonal_offDiagonalMass_eq_freeAvoidDiagonalProb
    (hp : IsStochasticMatrix p) (a : E × E) (n : ℕ) :
    ((discreteMatrixKernel (independentProductPairAbsorbDiagonalMatrix p) ^ n) a)
        {s : E × E | s.1 ≠ s.2} =
      (Pq a : Measure Ωq) {ω | ∀ m ≤ n, (Xq m ω).1 ≠ (Xq m ω).2} := by
  let κAbs : Kernel (E × E) (E × E) :=
    discreteMatrixKernel (independentProductPairAbsorbDiagonalMatrix p)
  letI : IsMarkovKernel κAbs :=
    discreteMatrixKernel_isMarkovKernel
      (independentProductPairAbsorbDiagonalMatrix p)
      (independentProductPairAbsorbDiagonalMatrix_isStochastic (p := p) hp)
  let offDiag : Set (E × E) := {s : E × E | s.1 ≠ s.2}
  let μ : Measure Ωq := (Pq a : Measure Ωq)
  let hqreal :
      IsMarkovProcessRealization
        (fun n : ℕ ↦ discreteMatrixKernel (independentProductPairMatrix p) ^ n) Pq Xq :=
    inferInstance
  have hMass :
      ((κAbs ^ n) a) offDiag =
        ∑' w : {u : E × E // u ∈ offDiag},
          ((κAbs ^ n) a) ({(w : E × E)} : Set (E × E)) := by
    calc
      ((κAbs ^ n) a) offDiag =
          ∑' w : E × E,
            offDiag.indicator (fun w ↦ ((κAbs ^ n) a) ({w} : Set (E × E))) w := by
                simpa using
                  (Measure.tsum_indicator_apply_singleton ((κAbs ^ n) a) offDiag
                    (show MeasurableSet offDiag from MeasurableSet.of_discrete)).symm
      _ =
          ∑' w : {u : E × E // u ∈ offDiag},
            ((κAbs ^ n) a) ({(w : E × E)} : Set (E × E)) := by
              rw [← tsum_subtype offDiag
                (fun w : E × E ↦ ((κAbs ^ n) a) ({w} : Set (E × E)))]
  have hUnion :
      {ω | ∀ m ≤ n, (Xq m ω).1 ≠ (Xq m ω).2} =
        ⋃ w : {u : E × E // u ∈ offDiag}, avoidDiagonalUntilWithEndpoint Xq n w := by
    ext ω
    constructor
    · intro hω
      refine Set.mem_iUnion.2 ⟨⟨Xq n ω, hω n le_rfl⟩, ?_⟩
      exact ⟨rfl, hω⟩
    · intro hω
      rcases Set.mem_iUnion.1 hω with ⟨w, hw⟩
      exact hw.2
  have hAvoid :
      μ {ω | ∀ m ≤ n, (Xq m ω).1 ≠ (Xq m ω).2} =
        ∑' w : {u : E × E // u ∈ offDiag}, μ (avoidDiagonalUntilWithEndpoint Xq n w) := by
    rw [hUnion]
    refine MeasureTheory.measure_iUnion ?_ ?_
    · intro w₁ w₂ hw
      refine Set.disjoint_left.2 ?_
      intro ω h₁ h₂
      apply hw
      exact Subtype.ext <| h₁.1.symm.trans h₂.1
    · intro w
      exact
        (generatedHistory_le_ambient Xq hqreal.measurable_process n) _
          (avoidDiagonalUntilWithEndpoint_measurableSet hqreal.measurable_process n w)
  -- Proof comment: sum the endpoint identity over all off-diagonal endpoints to pass from point
  -- masses to the full bounded diagonal-avoidance event.
  calc
    ((κAbs ^ n) a) offDiag =
        ∑' w : {u : E × E // u ∈ offDiag},
          ((κAbs ^ n) a) ({(w : E × E)} : Set (E × E)) := hMass
    _ =
        ∑' w : {u : E × E // u ∈ offDiag},
          μ (avoidDiagonalUntilWithEndpoint Xq n w) := by
            refine tsum_congr fun w ↦ ?_
            symm
            simpa [μ, offDiag] using
              freeAvoidDiagonalEndpointProb_eq_absorbedDiagonalEndpointMass
                (Pq := Pq) (Xq := Xq) (p := p) hp n a (w := (w : E × E)) w.2
    _ = μ {ω | ∀ m ≤ n, (Xq m ω).1 ≠ (Xq m ω).2} := hAvoid.symm

/-- Helper for Theorem 18.11: bounded free-pair diagonal-avoidance probabilities tend to `0`
because the free pair hits one recurrent diagonal state almost surely. -/
private lemma freePairChosenDiagonalHitsAlmostSurely
    (hp : IsStochasticMatrix p)
    [Kernel.IsIrreducible (Measure.count : Measure E) (baseKernel p)]
    (haper : IsAperiodic (baseKernel p))
    {π : ProbabilityMeasure E}
    (hπ : Kernel.Invariant (baseKernel p) (π : Measure E))
    {x₀ : E}
    (hx₀ :
      0 < (((π : Measure E).prod π) ({(x₀, x₀)} : Set (E × E)))) :
    ∀ a : E × E, (F[Pq, Xq]) a (x₀, x₀) = 1 := by
  letI : IsMarkovKernel (discreteMatrixKernel (independentProductPairMatrix p)) :=
    discreteMatrixKernel_isMarkovKernel
      (independentProductPairMatrix p)
      (independentProductPairMatrix_isStochastic (p := p) hp)
  let hqreal :
      IsMarkovProcessRealization
        (fun n : ℕ ↦ discreteMatrixKernel (independentProductPairMatrix p) ^ n) Pq Xq :=
    inferInstance
  let d : E × E := (x₀, x₀)
  let πq : ProbabilityMeasure (E × E) := π.prod π
  have hπq :
      Kernel.Invariant (discreteMatrixKernel (independentProductPairMatrix p))
        (πq : Measure (E × E)) := by
    -- Proof comment: normalize the free pair kernel to the parallel-kernel spelling once, then
    -- reuse the product-invariance lemma proved earlier.
    simpa [πq, pow_one,
      discreteMatrixKernel_independentProductPairMatrix_eq_parallel (p := p) hp] using
      independentProductPairKernel_invariantProd (p := p) hp π hπ
  have hKernelIrr :
      Kernel.IsIrreducible
        (Measure.count : Measure (E × E))
        (discreteMatrixKernel (independentProductPairMatrix p)) := by
    -- Proof comment: the matrix realization uses the discrete-kernel spelling, so transport the
    -- earlier parallel-kernel irreducibility result into that spelling.
    simpa [discreteMatrixKernel_independentProductPairMatrix_eq_parallel (p := p) hp] using
      independentProductPairKernel_isIrreducible (p := p) hp haper
  letI :
      Kernel.IsIrreducible
        (Measure.count : Measure (E × E))
        (discreteMatrixKernel (independentProductPairMatrix p)) := hKernelIrr
  have hirr : IsIrreducibleMarkovChain Pq Xq :=
    realizationIsIrreducibleMarkovChain_of_discreteMatrixKernelIsIrreducible
      (q := independentProductPairMatrix p) (Pq := Pq) (Xq := Xq)
  have hdPosRec : IsPositiveRecurrentState Pq Xq d := by
    -- Proof comment: positive singleton mass of the product invariant law makes the chosen
    -- diagonal state positive recurrent in the realized free pair chain.
    exact positiveRecurrentState_of_irreducible_invariantSingletonMass
      (q := independentProductPairMatrix p) (Pq := Pq) (Xq := Xq) hirr hπq
      (by simpa [πq, d] using hx₀)
  have hdRec : IsRecurrentState Pq Xq d :=
    recurrentState_of_positiveRecurrentState
      (κ := fun n : ℕ ↦ discreteMatrixKernel (independentProductPairMatrix p) ^ n)
      (Pq := Pq) (Xq := Xq) d hdPosRec
  intro a
  have hcomm : 0 < (F[Pq, Xq]) d a := hirr d a
  -- Proof comment: recurrence of the chosen diagonal state plus positive communication to every
  -- target state forces every start state to hit that diagonal state almost surely.
  simpa [d] using
    (everHitsProbability_swap_eq_one_of_isRecurrentState_of_everHitsProbability_pos
      (P := Pq) (X := Xq)
      (κ := fun n : ℕ ↦ discreteMatrixKernel (independentProductPairMatrix p) ^ n)
      (x := d) (y := a) hdRec hcomm)

/-- Helper for Theorem 18.11: if one diagonal state is hit almost surely from every start, then
infinite diagonal avoidance has probability `0`. -/
private lemma freePairInfiniteDiagonalAvoidance_measure_zero
    {p : E → E → ℝ≥0∞}
    {x₀ : E}
    [IsMarkovProcessRealization
      (fun n : ℕ ↦ discreteMatrixKernel (independentProductPairMatrix p) ^ n) Pq Xq]
    (hhit : ∀ a : E × E, (F[Pq, Xq]) a (x₀, x₀) = 1) :
    ∀ a : E × E,
      (Pq a : Measure Ωq) {ω | ∀ n : ℕ, (Xq n ω).1 ≠ (Xq n ω).2} = 0 := by
  intro a
  let μ : Measure Ωq := (Pq a : Measure Ωq)
  let noDiag : Set Ωq := {ω | ∀ n : ℕ, (Xq n ω).1 ≠ (Xq n ω).2}
  let noPositiveHit : Set Ωq := {ω | ∀ m : ℕ, 0 < m → Xq m ω ≠ (x₀, x₀)}
  let hitDiagonalState : Set Ωq := {ω | ∃ m : ℕ, 0 < m ∧ Xq m ω = (x₀, x₀)}
  let hqreal :
      IsMarkovProcessRealization
        (fun n : ℕ ↦ discreteMatrixKernel (independentProductPairMatrix p) ^ n) Pq Xq :=
    inferInstance
  have hNoPositiveHit_meas : MeasurableSet noPositiveHit := by
    have hrepr :
        noPositiveHit =
          ⋂ m : ℕ, if 0 < m then {ω | Xq m ω ≠ (x₀, x₀)} else Set.univ := by
      ext ω
      simp [noPositiveHit]
    rw [hrepr]
    refine MeasurableSet.iInter fun m ↦ ?_
    by_cases hm : 0 < m
    · have hEq :
          MeasurableSet ({ω : Ωq | Xq m ω = (x₀, x₀)} : Set Ωq) := by
        rw [show ({ω : Ωq | Xq m ω = (x₀, x₀)} : Set Ωq) =
            Xq m ⁻¹' ({(x₀, x₀)} : Set (E × E)) by
          ext ω
          simp]
        exact (hqreal.measurable_process m) (measurableSet_singleton (x₀, x₀))
      have hNe :
          MeasurableSet ({ω : Ωq | Xq m ω ≠ (x₀, x₀)} : Set Ωq) := by
        rw [show ({ω : Ωq | Xq m ω ≠ (x₀, x₀)} : Set Ωq) =
            ({ω : Ωq | Xq m ω = (x₀, x₀)} : Set Ωq)ᶜ by
          ext ω
          simp]
        exact hEq.compl
      simpa [hm] using hNe
    · simp [hm]
  have hHit_compl : hitDiagonalState = noPositiveHitᶜ := by
    ext ω
    simp [hitDiagonalState, noPositiveHit]
  have hNoDiag_subset : noDiag ⊆ noPositiveHit := by
    intro ω hω m hm hHitm
    have hOff : (Xq m ω).1 ≠ (Xq m ω).2 := hω m
    simpa [hHitm] using hOff
  have hHit_real : μ.real hitDiagonalState = 1 := by
    simpa [μ, hitDiagonalState, everHitsProbability_def] using hhit a
  have hNoPositiveHit_real : μ.real noPositiveHit = 0 := by
    have hsum :
        μ.real noPositiveHit + μ.real hitDiagonalState = μ.real Set.univ := by
      rw [hHit_compl]
      simpa using measureReal_add_measureReal_compl (μ := μ) hNoPositiveHit_meas
    have huniv : μ.real Set.univ = 1 := by
      simp [μ]
    linarith
  have hNoPositiveHit_zero : μ noPositiveHit = 0 := by
    exact (measureReal_eq_zero_iff (μ := μ) (s := noPositiveHit)).1 hNoPositiveHit_real
  -- Proof comment: infinite diagonal avoidance is contained in the event of never hitting the
  -- chosen diagonal state at positive times, and the latter event has zero measure.
  exact le_antisymm
    (le_trans (measure_mono hNoDiag_subset) hNoPositiveHit_zero.le)
    bot_le

private theorem freePairAvoidsDiagonalProb_tendsto_zero
    (hp : IsStochasticMatrix p)
    [Kernel.IsIrreducible (Measure.count : Measure E) (baseKernel p)]
    (hinv : ∃ π : ProbabilityMeasure E, Kernel.Invariant (baseKernel p) (π : Measure E))
    (haper : IsAperiodic (baseKernel p)) :
    ∀ a : E × E,
      Tendsto
        (fun n ↦ (Pq a : Measure Ωq) {ω | ∀ m ≤ n, (Xq m ω).1 ≠ (Xq m ω).2})
        atTop (nhds 0) := by
  -- Route correction: the transport block is now separated from the asymptotic argument. The
  -- remaining work is to realize the free pair chain, choose a positive-mass diagonal state under
  -- the product invariant law, prove every start hits that state almost surely, and then apply
  -- continuity from above to the bounded diagonal-avoidance events.
  obtain ⟨π, hπ⟩ := hinv
  obtain ⟨x₀, hx₀⟩ := exists_pos_diagonalSingletonMass_prod_of_invariant π
  have hhit :
      ∀ a : E × E, (F[Pq, Xq]) a (x₀, x₀) = 1 :=
    freePairChosenDiagonalHitsAlmostSurely
      (p := p) (Pq := Pq) (Xq := Xq) hp haper hπ hx₀
  intro a
  let μ : Measure Ωq := (Pq a : Measure Ωq)
  let offDiag : Set (E × E) := {s : E × E | s.1 ≠ s.2}
  let avoidUpTo : ℕ → Set Ωq := fun n ↦ {ω | ∀ m ≤ n, (Xq m ω).1 ≠ (Xq m ω).2}
  let noDiag : Set Ωq := {ω | ∀ n : ℕ, (Xq n ω).1 ≠ (Xq n ω).2}
  let hqreal :
      IsMarkovProcessRealization
        (fun n : ℕ ↦ discreteMatrixKernel (independentProductPairMatrix p) ^ n) Pq Xq :=
    inferInstance
  have hoffDiag_meas : MeasurableSet offDiag := by
    exact MeasurableSet.of_discrete
  have hAvoid_meas : ∀ n : ℕ, MeasurableSet (avoidUpTo n) := by
    intro n
    have hrepr :
        avoidUpTo n = ⋂ m : ℕ, if m ≤ n then Xq m ⁻¹' offDiag else Set.univ := by
      ext ω
      simp [avoidUpTo, offDiag]
    rw [hrepr]
    refine MeasurableSet.iInter fun m ↦ ?_
    by_cases hm : m ≤ n
    · simpa [hm] using (hqreal.measurable_process m) hoffDiag_meas
    · simp [hm]
  have hAntitone : Antitone avoidUpTo := by
    intro n m hnm ω hω k hk
    exact hω k (le_trans hk hnm)
  have hInter : (⋂ n : ℕ, avoidUpTo n) = noDiag := by
    ext ω
    constructor
    · intro hω m
      exact (Set.mem_iInter.1 hω) m m le_rfl
    · intro hω
      refine Set.mem_iInter.2 ?_
      intro n
      exact fun m _ ↦ hω m
  have hAvoid_tendsto :
      Tendsto (fun n ↦ μ (avoidUpTo n)) atTop (nhds (μ (⋂ n : ℕ, avoidUpTo n))) := by
    exact
      tendsto_measure_iInter_atTop
        (μ := μ)
        (s := avoidUpTo)
        (fun n ↦ (hAvoid_meas n).nullMeasurableSet)
        hAntitone
        ⟨0, measure_ne_top _ _⟩
  have hNoDiag_zero : μ noDiag = 0 := by
    simpa [μ, noDiag] using
      freePairInfiniteDiagonalAvoidance_measure_zero
        (p := p) (Pq := Pq) (Xq := Xq) (x₀ := x₀) hhit a
  -- Proof comment: continuity from above reduces the bounded avoidance probabilities to the
  -- infinite diagonal-avoidance event, which is null by the almost-sure hitting helper.
  simpa [μ, hInter, hNoDiag_zero] using hAvoid_tendsto

end IndependentProductPairAvoidance

/-- Helper for Theorem 18.11: every off-diagonal endpoint mass of the coalescent equals the
corresponding endpoint mass of the diagonal-absorbed free product-pair chain. -/
private theorem coalescentOffDiagonalEndpointMass_eq_absorbedProductPairEndpointMass
    {p : E → E → ℝ≥0∞} (hp : IsStochasticMatrix p) :
    ∀ n : ℕ, ∀ a : E × E, ∀ {w : E × E}, w.1 ≠ w.2 →
      ((discreteMatrixKernel (independentCoalescentMatrix p) ^ n) a) ({w} : Set (E × E)) =
        ((discreteMatrixKernel (independentProductPairAbsorbDiagonalMatrix p) ^ n) a)
          ({w} : Set (E × E)) := by
  let κc : Kernel (E × E) (E × E) := discreteMatrixKernel (independentCoalescentMatrix p)
  let κAbs : Kernel (E × E) (E × E) :=
    discreteMatrixKernel (independentProductPairAbsorbDiagonalMatrix p)
  letI : IsMarkovKernel κc :=
    discreteMatrixKernel_isMarkovKernel
      (independentCoalescentMatrix p)
      (independentCoalescentMatrix_isStochasticMatrix (p := p) hp)
  letI : IsMarkovKernel κAbs :=
    discreteMatrixKernel_isMarkovKernel
      (independentProductPairAbsorbDiagonalMatrix p)
      (independentProductPairAbsorbDiagonalMatrix_isStochastic (p := p) hp)
  intro n
  induction n with
  | zero =>
      intro a w hw
      simp [κc, κAbs, Kernel.id_apply, hw]
  | succ n ih =>
      intro a w hw
      rw [Kernel.pow_succ_apply_eq_lintegral κc n a (measurableSet_singleton w),
        Kernel.pow_succ_apply_eq_lintegral κAbs n a (measurableSet_singleton w)]
      rw [lintegral_kernel_apply_singleton_eq_tsum (κ := κc) ((κc ^ n) a) w,
        lintegral_kernel_apply_singleton_eq_tsum (κ := κAbs) ((κAbs ^ n) a) w]
      refine tsum_congr fun c ↦ ?_
      rcases c with ⟨u, v⟩
      by_cases hc : u ≠ v
      · rw [discreteMatrixKernel_apply_singleton, discreteMatrixKernel_apply_singleton]
        rw [independentCoalescentMatrix_apply_of_ne (p := p) hc]
        have hmass := ih a (w := (u, v)) hc
        simpa [κAbs, independentProductPairAbsorbDiagonalMatrix, independentProductPairMatrix, hc,
          mul_assoc, mul_left_comm, mul_comm] using
          congrArg (fun t ↦ p u w.1 * p v w.2 * t) hmass
      · have hdiag : u = v := by
          simpa using hc
        have hcoalescent_zero : κc (u, v) ({w} : Set (E × E)) = 0 := by
          subst hdiag
          rw [discreteMatrixKernel_apply_singleton]
          simpa using independentCoalescentMatrix_apply_diag_of_ne (p := p) (x := u) (h := hw)
        have habs_zero : κAbs (u, v) ({w} : Set (E × E)) = 0 := by
          have hws : w ≠ (v, v) := by
            intro hEq
            have hwdiag : w.1 = w.2 := by
              simpa [hEq] using hdiag
            exact hw hwdiag
          rw [discreteMatrixKernel_apply_singleton]
          simp [κAbs, independentProductPairAbsorbDiagonalMatrix, hdiag, hws]
        rw [hcoalescent_zero, habs_zero]
        simp

/-- Helper for Theorem 18.11: summing the endpoint transport over all off-diagonal targets gives
equality of the full off-diagonal masses. -/
private theorem coalescentOffDiagonalMass_eq_absorbedProductPairOffDiagonalMass
    {p : E → E → ℝ≥0∞} (hp : IsStochasticMatrix p) (a : E × E) (n : ℕ) :
    ((discreteMatrixKernel (independentCoalescentMatrix p) ^ n) a)
      {s : E × E | s.1 ≠ s.2} =
      ((discreteMatrixKernel (independentProductPairAbsorbDiagonalMatrix p) ^ n) a)
        {s : E × E | s.1 ≠ s.2} := by
  let κc : Kernel (E × E) (E × E) := discreteMatrixKernel (independentCoalescentMatrix p)
  let κAbs : Kernel (E × E) (E × E) :=
    discreteMatrixKernel (independentProductPairAbsorbDiagonalMatrix p)
  let offDiag : Set (E × E) := {s : E × E | s.1 ≠ s.2}
  have hMassC :
      ((κc ^ n) a) offDiag =
        ∑' w : {u : E × E // u ∈ offDiag},
          ((κc ^ n) a) ({(w : E × E)} : Set (E × E)) := by
    calc
      ((κc ^ n) a) offDiag =
          ∑' w : E × E,
            offDiag.indicator (fun w ↦ ((κc ^ n) a) ({w} : Set (E × E))) w := by
                simpa using
                  (Measure.tsum_indicator_apply_singleton ((κc ^ n) a) offDiag
                    (show MeasurableSet offDiag from MeasurableSet.of_discrete)).symm
      _ =
          ∑' w : {u : E × E // u ∈ offDiag},
            ((κc ^ n) a) ({(w : E × E)} : Set (E × E)) := by
              rw [← tsum_subtype offDiag
                (fun w : E × E ↦ ((κc ^ n) a) ({w} : Set (E × E)))]
  have hMassAbs :
      ((κAbs ^ n) a) offDiag =
        ∑' w : {u : E × E // u ∈ offDiag},
          ((κAbs ^ n) a) ({(w : E × E)} : Set (E × E)) := by
    calc
      ((κAbs ^ n) a) offDiag =
          ∑' w : E × E,
            offDiag.indicator (fun w ↦ ((κAbs ^ n) a) ({w} : Set (E × E))) w := by
                simpa using
                  (Measure.tsum_indicator_apply_singleton ((κAbs ^ n) a) offDiag
                    (show MeasurableSet offDiag from MeasurableSet.of_discrete)).symm
      _ =
          ∑' w : {u : E × E // u ∈ offDiag},
            ((κAbs ^ n) a) ({(w : E × E)} : Set (E × E)) := by
              rw [← tsum_subtype offDiag
                (fun w : E × E ↦ ((κAbs ^ n) a) ({w} : Set (E × E)))]
  -- Proof comment: after expanding both off-diagonal masses into singleton sums, the endpoint
  -- transport applies term-by-term.
  rw [hMassC, hMassAbs]
  refine tsum_congr fun w ↦ ?_
  exact
    coalescentOffDiagonalEndpointMass_eq_absorbedProductPairEndpointMass
      (p := p) hp n a (w := (w : E × E)) w.2

/-- Helper for Theorem 18.11: every stochastic matrix on a countable discrete space admits the
canonical path-space realization given by `Kernel.trajMeasure`. -/
private theorem existsCanonicalDiscreteMatrixRealization
    {S : Type*} [MeasurableSpace S] [DiscreteMeasurableSpace S] [Countable S]
    (q : S → S → ℝ≥0∞) (hq : IsStochasticMatrix q) :
    ∃ P : S → ProbabilityMeasure (ℕ → S),
      IsMarkovProcessRealization (fun n : ℕ ↦ discreteMatrixKernel q ^ n) P Function.eval := by
  let κ : Kernel S S := discreteMatrixKernel q
  letI : IsMarkovKernel κ := discreteMatrixKernel_isMarkovKernel q hq
  let η : (n : ℕ) → Kernel (Π i : Finset.Iic n, S) S :=
    fun n ↦
      Kernel.comap κ
        (fun z : Π i : Finset.Iic n, S ↦ z ⟨n, Finset.mem_Iic.2 le_rfl⟩)
        (by fun_prop)
  have hη : ∀ n : ℕ, IsMarkovKernel (η n) := by
    intro n
    dsimp [η]
    infer_instance
  let μ : S → Measure (ℕ → S) :=
    fun x ↦
      letI : ∀ n : ℕ, IsMarkovKernel (η n) := hη
      Kernel.trajMeasure (X := fun _ : ℕ ↦ S) (Measure.dirac x) η
  have hμ : ∀ x : S, IsProbabilityMeasure (μ x) := by
    intro x
    dsimp [μ]
    infer_instance
  let P : S → ProbabilityMeasure (ℕ → S) := fun x ↦ ⟨μ x, hμ x⟩
  refine ⟨P, ?_⟩
  refine ProbabilityTheory.isMarkovProcessRealization_of_oneStepKernel
    (κ₁ := κ)
    (P := P)
    (X := Function.eval)
    (hmeas := fun n ↦ measurable_pi_apply n)
    ?_ ?_
  · intro x
    have hprefix :
        (μ x).map (Preorder.frestrictLe 0) = Measure.dirac (fun _ : Finset.Iic 0 ↦ x) := by
      letI : ∀ n : ℕ, IsMarkovKernel (η n) := hη
      simpa [μ, η, Kernel.partialTraj_self] using
        (Kernel.trajMeasure_map_frestrictLe
          (X := fun _ : ℕ ↦ S) (μ₀ := Measure.dirac x) (κ := η) 0)
    calc
      (P x : Measure (ℕ → S)).map (Function.eval 0)
          = ((μ x).map (Preorder.frestrictLe 0)).map
              (fun z : Finset.Iic 0 → S ↦ z ⟨0, Finset.mem_Iic.2 le_rfl⟩) := by
                rw [Measure.map_map (by fun_prop) (by fun_prop)]
                rfl
      _ = Measure.dirac x := by
            rw [hprefix]
            simp
  · intro x A hA s
    letI : Nonempty S := ⟨x⟩
    let H : (ℕ → S) → Finset.Iic s → S := Preorder.frestrictLe s
    have hH_meas : Measurable H := Preorder.measurable_frestrictLe s
    have hnext_meas : Measurable (Function.eval (s + 1) : (ℕ → S) → S) :=
      measurable_pi_apply (s + 1)
    have hcond :
        condDistrib (Function.eval (s + 1)) H (μ x) =ᵐ[(μ x).map H] η s := by
      letI : ∀ n : ℕ, IsMarkovKernel (η n) := hη
      simpa [μ, H, η] using
        (Kernel.condDistrib_trajMeasure
          (X := fun _ : ℕ ↦ S) (μ₀ := Measure.dirac x) (κ := η) (a := s))
    have hcondexp :
        (μ x)⟦(Function.eval (s + 1)) ⁻¹' A | MeasurableSpace.comap H inferInstance⟧ =ᵐ[μ x]
          fun ξ ↦ (condDistrib (Function.eval (s + 1)) H (μ x) (H ξ)).real A := by
      simpa using
        (condDistrib_ae_eq_condExp (μ := μ x) (X := H) (Y := Function.eval (s + 1))
          hH_meas hnext_meas hA).symm
    have hcond_comp :
        (fun ξ ↦ (condDistrib (Function.eval (s + 1)) H (μ x) (H ξ)).real A) =ᵐ[μ x]
          fun ξ ↦ (η s (H ξ)).real A := by
      filter_upwards [ae_eq_comp hH_meas.aemeasurable hcond] with ξ hξ
      simpa [Function.comp] using congrArg (fun ν : Measure S ↦ ν.real A) hξ
    have hgen :
        generatedFiltrationSpace (Function.eval : ℕ → (ℕ → S) → S) s =
          MeasurableSpace.comap (Preorder.frestrictLe s) inferInstance := by
      refine le_antisymm ?_ ?_
      · rw [generatedFiltrationSpace]
        refine iSup₂_le fun t ht ↦ ?_
        let i : Finset.Iic s := ⟨t, Finset.mem_Iic.2 ht⟩
        have hCoord :
            Measurable[
              MeasurableSpace.comap (Preorder.frestrictLe s) inferInstance]
              (Function.eval t : (ℕ → S) → S) := by
          simpa [Function.eval, Preorder.frestrictLe_apply, i] using
            (measurable_pi_apply i).comp (comap_measurable (Preorder.frestrictLe s))
        exact hCoord.comap_le
      · have hPrefix :
          Measurable[
            generatedFiltrationSpace (Function.eval : ℕ → (ℕ → S) → S) s]
            (Preorder.frestrictLe s : (ℕ → S) → Finset.Iic s → S) := by
          rw [@measurable_pi_iff]
          intro i
          refine Measurable.of_comap_le ?_
          exact le_iSup_of_le i.1 <| le_iSup_of_le (Finset.mem_Iic.1 i.2) le_rfl
        exact hPrefix.comap_le
    rw [hgen]
    exact hcondexp.trans <|
      hcond_comp.trans <|
        Filter.Eventually.of_forall fun ξ ↦ by
          simpa [η, H, Preorder.frestrictLe_apply] using
            congrArg (fun ν : Measure S ↦ ν.real A) rfl

/-- Helper for Theorem 18.11: the absorbed free product-pair chain should lose all off-diagonal
mass because the free pair chain hits the diagonal almost surely. -/
private theorem absorbedProductPair_offDiagonalMass_tendsto_zero
    {p : E → E → ℝ≥0∞} (hp : IsStochasticMatrix p)
    [Kernel.IsIrreducible (Measure.count : Measure E) (baseKernel p)]
    (hinv : ∃ π : ProbabilityMeasure E, Kernel.Invariant (baseKernel p) (π : Measure E))
    (haper : IsAperiodic (baseKernel p)) :
    ∀ a : E × E,
      Tendsto
        (fun n ↦
          ((discreteMatrixKernel (independentProductPairAbsorbDiagonalMatrix p) ^ n) a)
            {s : E × E | s.1 ≠ s.2})
        atTop (nhds 0) := by
  letI : IsMarkovKernel (discreteMatrixKernel (independentProductPairMatrix p)) :=
    discreteMatrixKernel_isMarkovKernel
      (independentProductPairMatrix p)
      (independentProductPairMatrix_isStochastic (p := p) hp)
  obtain ⟨Pq, hqreal⟩ :=
    existsCanonicalDiscreteMatrixRealization
      (q := independentProductPairMatrix p)
      (hq := independentProductPairMatrix_isStochastic (p := p) hp)
  letI : IsMarkovProcessRealization
      (fun n : ℕ ↦ discreteMatrixKernel (independentProductPairMatrix p) ^ n)
      Pq Function.eval := hqreal
  intro a
  have havoid :
      Tendsto
        (fun n ↦ (Pq a : Measure (ℕ → E × E)) {ω | ∀ m ≤ n, (Function.eval m ω).1 ≠
          (Function.eval m ω).2})
        atTop (nhds 0) :=
    freePairAvoidsDiagonalProb_tendsto_zero
      (p := p) (Pq := Pq) (Xq := Function.eval) hp hinv haper a
  have hrewrite :
      (fun n ↦
        ((discreteMatrixKernel (independentProductPairAbsorbDiagonalMatrix p) ^ n) a)
          {s : E × E | s.1 ≠ s.2}) =
        (fun n ↦
          (Pq a : Measure (ℕ → E × E)) {ω | ∀ m ≤ n, (Function.eval m ω).1 ≠
            (Function.eval m ω).2}) := by
          funext n
          exact
            independentProductPairAbsorbDiagonal_offDiagonalMass_eq_freeAvoidDiagonalProb
              (p := p) (Pq := Pq) (Xq := Function.eval) hp a n
  -- Proof comment: rewrite absorbed off-diagonal mass as bounded diagonal-avoidance probability
  -- for the realized free pair chain, and then apply the almost-sure hitting limit.
  simpa [hrewrite] using havoid

/-- Helper for Theorem 18.11: the current disagreement probability of the coalescent equals the
off-diagonal mass of the diagonal-absorbed free product-pair chain. -/
private theorem coalescentCurrentDisagreement_eq_absorbedProductPairOffDiagonalMass
    {p : E → E → ℝ≥0∞}
    {P : E × E → ProbabilityMeasure Ω} {Z : ℕ → Ω → E × E}
    (hrealization :
      IsMarkovProcessRealization
        (fun n : ℕ ↦ discreteMatrixKernel (independentCoalescentMatrix p) ^ n) P Z)
    (hp : IsStochasticMatrix p) (a : E × E) (n : ℕ) :
    (P a : Measure Ω) {ω | (Z n ω).1 ≠ (Z n ω).2} =
      ((discreteMatrixKernel (independentProductPairAbsorbDiagonalMatrix p) ^ n) a)
        {s : E × E | s.1 ≠ s.2} := by
  let _ := hrealization
  let offDiag : Set (E × E) := {s : E × E | s.1 ≠ s.2}
  have hoffDiag_meas : MeasurableSet offDiag := by
    exact MeasurableSet.of_discrete
  have hpreimage :
      {ω | (Z n ω).1 ≠ (Z n ω).2} = Z n ⁻¹' offDiag := by
    ext ω
    simp [offDiag]
  -- Proof comment: rewrite the current disagreement event through the realized coalescent law,
  -- then invoke the off-diagonal mass transport to the absorbed free pair chain.
  calc
    (P a : Measure Ω) {ω | (Z n ω).1 ≠ (Z n ω).2}
        = ((discreteMatrixKernel (independentCoalescentMatrix p) ^ n) a) offDiag := by
            rw [hpreimage,
              ← Measure.map_apply (hrealization.measurable_process n) hoffDiag_meas,
              hrealization.transition_eq a n]
    _ =
        ((discreteMatrixKernel (independentProductPairAbsorbDiagonalMatrix p) ^ n) a) offDiag := by
          exact coalescentOffDiagonalMass_eq_absorbedProductPairOffDiagonalMass
            (p := p) hp a n

-- Proof sketch: the coordinate-chain half of Definition 18.5 is already provided by
-- `independentCoalescentChain_isMarkovCoupling_of_realization`. The remaining work is to compare
-- current disagreement with the absorbed free product-pair chain and then show that the absorbed
-- off-diagonal mass tends to `0` because the free pair chain hits a positive-mass diagonal state
-- almost surely.
/-- Theorem 18.11: if `p` is irreducible, positive recurrent, and aperiodic, then every
realization of its independent coalescent chain is a successful Markov coupling. -/
theorem independentCoalescentChain_isSuccessfulMarkovCoupling
    {p : E → E → ℝ≥0∞}
    {P : E × E → ProbabilityMeasure Ω} {Z : ℕ → Ω → E × E}
    [Kernel.IsIrreducible (Measure.count : Measure E) (discreteMatrixKernel p)]
    (hinv : ∃ π : ProbabilityMeasure E, Kernel.Invariant (discreteMatrixKernel p) (π : Measure E))
    (haper : IsAperiodic (discreteMatrixKernel p))
    (hrealization :
      IsMarkovProcessRealization
        (fun n : ℕ ↦ discreteMatrixKernel (independentCoalescentMatrix p) ^ n) P Z) :
    IsSuccessfulMarkovCoupling p P Z := by
  letI : IsMarkovProcessRealization
      (fun n : ℕ ↦ discreteMatrixKernel (independentCoalescentMatrix p) ^ n) P Z := hrealization
  letI : DiscreteMeasurableSpace (E × E) := inferInstance
  let hp : IsStochasticMatrix p :=
    baseMatrix_isStochastic_of_coalescentRealization (p := p) P Z
  refine
    { toIsMarkovCoupling :=
        independentCoalescentChain_isMarkovCoupling_of_realization
          (p := p) (P := P) (Z := Z) hrealization
      tail_disagreement_tendsto_zero := ?_ }
  intro x y
  have hcurrent :
      Tendsto
        (fun n ↦ (P (x, y) : Measure Ω) {ω | (Z n ω).1 ≠ (Z n ω).2})
        atTop (nhds 0) := by
          have habsorbed :=
            absorbedProductPair_offDiagonalMass_tendsto_zero
              (p := p) hp hinv haper (x, y)
          have hrewrite :
              (fun n ↦ (P (x, y) : Measure Ω) {ω | (Z n ω).1 ≠ (Z n ω).2}) =
                (fun n ↦
                  ((discreteMatrixKernel (independentProductPairAbsorbDiagonalMatrix p) ^ n) (x, y))
                    {s : E × E | s.1 ≠ s.2}) := by
                      funext n
                      exact
                        coalescentCurrentDisagreement_eq_absorbedProductPairOffDiagonalMass
                          (p := p) (P := P) (Z := Z) hrealization hp (x, y) n
          simpa [hrewrite] using habsorbed
  -- Proof comment: squeeze the tail disagreement between `0` and the current disagreement
  -- probability, using that once the coalescent meets it can never separate again.
  exact
    tendsto_of_tendsto_of_tendsto_of_le_of_le
      tendsto_const_nhds hcurrent (fun n ↦ zero_le _)
      (coalescentTailDisagreement_le_currentDisagreement
        (p := p) (P := P) (Z := Z) hp x y)

end ProbabilityTheory
