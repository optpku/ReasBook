        _ = κ₁ ∘ₘ ((κ₁ ^ t) ∘ₘ (((P x : Measure Ω).restrict B).map (X s))) := by
              rw [ih]
        _ = (κ₁ ∘ₖ (κ₁ ^ t)) ∘ₘ (((P x : Measure Ω).restrict B).map (X s)) := by
