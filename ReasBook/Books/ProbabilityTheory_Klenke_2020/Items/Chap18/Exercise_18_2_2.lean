lemma snd_oneStep_conditional
    (hp : IsStochasticMatrix p) (x y : E) (s : ℕ) {A : Set E} (hA : MeasurableSet A) :
    (P (x, y))⟦(fun ω ↦ (Z (s + 1) ω).2) ⁻¹' A |
      generatedFiltrationSpace (fun n ω ↦ (Z n ω).2) s⟧ =ᵐ[(P (x, y) : Measure Ω)]
