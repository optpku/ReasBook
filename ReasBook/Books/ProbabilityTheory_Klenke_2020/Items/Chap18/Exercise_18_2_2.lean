    simpa [coalescentSemigroup, coalescentKernel] using
      (inferInstance : IsMarkovProcessRealization (coalescentSemigroup p) P Z)
  let g : Ω → ℝ := fun ω ↦ (baseKernel p ((Z s ω).2)).real A
  have hsmall_le :
