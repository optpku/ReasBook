      intro ω
      calc
        ((discreteMatrixKernel (independentCoalescentMatrix p)) (Z s ω)).real (Prod.snd ⁻¹' A)
            = ((Kernel.snd (coalescentKernel p)) (Z s ω)).real A := by
                simpa [coalescentKernel, measureReal_def] using
