/-- Helper for Example 20.36: the union of all atoms of a measurable finite partition is the whole
space. -/
private theorem biUnion_parts_eq_univ {Ω : Type*} [MeasurableSpace Ω]
    (part : MeasurableFinpartition Ω) :
    (⋃ s ∈ part.parts, ((s : Subtype (MeasurableSet : Set Ω → Prop)) : Set Ω)) = Set.univ := by
  simpa [Finset.sup_measurableSetSubtype_eq_biUnion] using
    congrArg (fun s : Subtype (MeasurableSet : Set Ω → Prop) ↦ (s : Set Ω)) part.sup_parts

/-- Helper for Example 20.36: take the union of the atoms indexed by a finite set of partition
labels. -/
private def blockPartsUnion {Ω : Type*} [MeasurableSpace Ω] (part : MeasurableFinpartition Ω)
    (U : Finset part.parts) : Set Ω :=
  ⋃ A ∈ U, (((A.1 : Subtype (MeasurableSet : Set Ω → Prop)) : Set Ω))

/-- Helper for Example 20.36: a finite union of atoms of a measurable finite partition is
measurable. -/
private theorem measurableSet_blockPartsUnionLive {Ω : Type*} [MeasurableSpace Ω]
    (part : MeasurableFinpartition Ω) (U : Finset part.parts) :
    MeasurableSet (blockPartsUnion part U) := by
  -- Proof comment: each selected block atom is measurable, and there are finitely many of them.
  classical
  unfold blockPartsUnion
  exact MeasurableSet.iUnion fun A ↦ MeasurableSet.iUnion fun _ ↦ A.1.2

/-- Helper for Example 20.36: a finite union of atoms of a measurable finite partition is
measurable. -/
private theorem measurableSet_blockPartsUnion {Ω : Type*} [MeasurableSpace Ω]
    (part : MeasurableFinpartition Ω) (U : Finset part.parts) :
    MeasurableSet (blockPartsUnion part U) := by
  -- Proof comment: each atom is measurable, and only finitely many atoms are selected.
  classical
  unfold blockPartsUnion
  exact MeasurableSet.iUnion fun A ↦ MeasurableSet.iUnion fun _ ↦ A.1.2

/-- Helper for Example 20.36: a finite union of atoms of a measurable finite partition is
measurable. -/
private theorem measurableSet_blockPartsUnion {Ω : Type*} [MeasurableSpace Ω]
    (part : MeasurableFinpartition Ω) (U : Finset part.parts) :
    MeasurableSet (blockPartsUnion part U) := by
  -- Proof comment: each atom is measurable, and only finitely many atoms are selected.
  classical
  unfold blockPartsUnion
  exact MeasurableSet.iUnion fun A ↦ MeasurableSet.iUnion fun _ ↦ A.1.2

/-- Helper for Example 20.36: a candidate long-block approximation is encoded by its block length
and the finite family of block atoms used in the approximation. -/
private structure BlockApproximationData {Ω : Type*} [MeasurableSpace Ω] {τ : Ω → Ω}
    (hτ : Measurable τ) (part : MeasurableFinpartition Ω) where
  length : ℕ+
  atoms : Finset ((part.block τ hτ length).parts)
  carrier : Set Ω

/-- Helper for Example 20.36: a block approximation is good if its carrier set is within the
prescribed symmetric-difference error budget. -/
private def BlockApproximationGood {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω)
    {τ : Ω → Ω} (hτ : Measurable τ) (part : MeasurableFinpartition Ω)
    (s : Set Ω) (ε : ℝ) (approx : BlockApproximationData hτ part) : Prop :=
  approx.carrier = blockPartsUnion (part.block τ hτ approx.length) approx.atoms ∧
    P ((s \ approx.carrier) ∪ (approx.carrier \ s)) < ENNReal.ofReal ε

/-- Helper for Example 20.36: choose the unique atom of a measurable finite partition containing
each point. -/
private noncomputable def indexedPart {Ω : Type*} [MeasurableSpace Ω]
    (part : MeasurableFinpartition Ω) :
    IndexedPartition fun s : part.parts ↦
      ((s.1 : Subtype (MeasurableSet : Set Ω → Prop)) : Set Ω) := by
  classical
  refine IndexedPartition.mk' _ ?_ ?_ ?_
  · intro s t hst
    have hdisj :
        Disjoint (s.1 : Subtype (MeasurableSet : Set Ω → Prop)) t.1 :=
      part.disjoint s.2 t.2 (by simpa using hst)
    exact (disjoint_subtype_iff (fun {_ _} hx hy ↦ hx.inter hy) MeasurableSet.empty).1 hdisj
  · intro s
    rw [Set.nonempty_iff_ne_empty]
    intro hs
    apply part.ne_bot s.2
    ext ω
    simp [hs]
  · intro ω
    have :
        ω ∈ ⋃ s ∈ part.parts, ((s : Subtype (MeasurableSet : Set Ω → Prop)) : Set Ω) := by
      rw [biUnion_parts_eq_univ part]
      simp
    simpa [Set.mem_iUnion] using this

/-- Helper for Example 20.36: a point belongs to the atom selected by the canonical coding of a
measurable finite partition. -/
private theorem mem_toSimpleFunc_atom {Ω : Type*} [MeasurableSpace Ω]
    (part : MeasurableFinpartition Ω) (ω : Ω) :
    ω ∈ (((part.toSimpleFunc ω).1 : Subtype (MeasurableSet : Set Ω → Prop)) : Set Ω) := by
  -- Proof comment: unfold the indexed partition model so the selected atom contains `ω` by
  -- construction.
  change ω ∈ ((indexedPart part).index ω)
  exact (indexedPart part).mem_index ω

/-- Helper for Example 20.36: membership in a partition atom is equivalent to selecting that atom
under the canonical coding. -/
private theorem mem_atom_iff_toSimpleFunc_eq {Ω : Type*} [MeasurableSpace Ω]
    (part : MeasurableFinpartition Ω) {A : part.parts} {ω : Ω} :
    ω ∈ (((A.1 : Subtype (MeasurableSet : Set Ω → Prop)) : Set Ω)) ↔ part.toSimpleFunc ω = A := by
  -- Proof comment: after rewriting through the indexed partition, atom membership is exactly the
  -- statement that the index map chooses `A`.
  change ω ∈ ((A.1 : Subtype (MeasurableSet : Set Ω → Prop)) : Set Ω) ↔
    (indexedPart part).index ω = A
  rw [← (indexedPart part).mem_iff_index_eq]

/-- Helper for Example 20.36: two points in the same atom of a measurable finite partition have
the same canonical partition code. -/
private theorem toSimpleFunc_eq_of_mem_atom {Ω : Type*} [MeasurableSpace Ω]
    (part : MeasurableFinpartition Ω) {A : part.parts} {ω ω' : Ω}
    (hω : ω ∈ (((A.1 : Subtype (MeasurableSet : Set Ω → Prop)) : Set Ω)))
    (hω' : ω' ∈ (((A.1 : Subtype (MeasurableSet : Set Ω → Prop)) : Set Ω))) :
    part.toSimpleFunc ω = part.toSimpleFunc ω' := by
  -- Proof comment: both points are coded by the unique atom `A` containing them.
  rw [(mem_atom_iff_toSimpleFunc_eq part).mp hω, (mem_atom_iff_toSimpleFunc_eq part).mp hω']

/-- Helper for Example 20.36: every nonempty fiber of a simple function is one of the atoms of
the partition built from that simple function. -/
private theorem fiber_mem_parts_of_ofSimpleFunc {Ω : Type*} [MeasurableSpace Ω] {α : Type*}
    (f : SimpleFunc Ω α) {a : α} (ha : a ∈ f.range) :
    (⟨f ⁻¹' ({a} : Set α), f.measurableSet_fiber a⟩ :
      Subtype (MeasurableSet : Set Ω → Prop)) ∈
      (MeasurableFinpartition.ofSimpleFunc f).parts := by
  classical
  -- Proof comment: `ofSimpleFunc` keeps exactly the nonempty singleton fibers of `f`.
  simpa [MeasurableFinpartition.ofSimpleFunc] using
    (Finset.mem_image.mpr ⟨a, ha, rfl⟩ :
      f ⁻¹' ({a} : Set α) ∈ f.range.image (fun b ↦ f ⁻¹' ({b} : Set α)))

/-- Helper for Example 20.36: a finite-valued code that is constant on each atom of a partition
factors through the canonical partition code. -/
private theorem ofSimpleFunc_factorsThroughPartitionOfMonochromatic
    {Ω : Type*} [MeasurableSpace Ω] {α : Type*} (r : MeasurableFinpartition Ω)
    (g : SimpleFunc Ω α)
    (hmono :
      ∀ {A : r.parts} {ω ω' : Ω},
        ω ∈ (((A.1 : Subtype (MeasurableSet : Set Ω → Prop)) : Set Ω)) →
        ω' ∈ (((A.1 : Subtype (MeasurableSet : Set Ω → Prop)) : Set Ω)) →
        g ω = g ω') :
    ∃ Φ : r.parts → (MeasurableFinpartition.ofSimpleFunc g).parts,
      ((MeasurableFinpartition.ofSimpleFunc g).toSimpleFunc :
          Ω → (MeasurableFinpartition.ofSimpleFunc g).parts) =
        fun ω ↦ Φ (r.toSimpleFunc ω) := by
  classical
  have hreps :
      ∀ A : r.parts,
        ∃ ω : Ω, ω ∈ (((A.1 : Subtype (MeasurableSet : Set Ω → Prop)) : Set Ω)) := by
    intro A
    have hA_nonempty :
        ((((A.1 : Subtype (MeasurableSet : Set Ω → Prop)) : Set Ω)) : Set Ω).Nonempty := by
      by_contra hA_nonempty
      apply r.ne_bot A.2
      ext ω
      simp [Set.not_nonempty_iff_eq_empty.mp hA_nonempty]
    exact hA_nonempty
  choose rep hrep using hreps
  let Φ : r.parts → (MeasurableFinpartition.ofSimpleFunc g).parts := fun A ↦
    ⟨⟨g ⁻¹' ({g (rep A)} : Set α), g.measurableSet_fiber (g (rep A))⟩,
      fiber_mem_parts_of_ofSimpleFunc g (g.mem_range_self (rep A))⟩
  refine ⟨Φ, funext ?_⟩
  intro ω
  -- Proof comment: the point `ω` lies in the atom selected by `r.toSimpleFunc ω`, so
  -- monochromaticity identifies its `g`-value with the representative used to define `Φ`.
  apply (mem_atom_iff_toSimpleFunc_eq (MeasurableFinpartition.ofSimpleFunc g)).mp
  change g ω = g (rep (r.toSimpleFunc ω))
  exact hmono (mem_toSimpleFunc_atom r ω) (hrep (r.toSimpleFunc ω))

/-- Helper for Example 20.36: equality of atoms in an `ofSimpleFunc` partition forces equality of
the underlying simple-function values. -/
private theorem eq_of_toSimpleFunc_eq_of_ofSimpleFunc
    {Ω : Type*} [MeasurableSpace Ω] {α : Type*} (g : SimpleFunc Ω α) {ω ω' : Ω}
    (h :
      (MeasurableFinpartition.ofSimpleFunc g).toSimpleFunc ω =
        (MeasurableFinpartition.ofSimpleFunc g).toSimpleFunc ω') :
    g ω = g ω' := by
  let B : (MeasurableFinpartition.ofSimpleFunc g).parts :=
    (MeasurableFinpartition.ofSimpleFunc g).toSimpleFunc ω
  have hω : ω ∈ (((B.1 : Subtype (MeasurableSet : Set Ω → Prop)) : Set Ω)) := by
    simpa [B] using mem_toSimpleFunc_atom (MeasurableFinpartition.ofSimpleFunc g) ω
  have hω' : ω' ∈ (((B.1 : Subtype (MeasurableSet : Set Ω → Prop)) : Set Ω)) := by
    simpa [B] using h ▸ mem_toSimpleFunc_atom (MeasurableFinpartition.ofSimpleFunc g) ω'
  have hB :
      (((B.1 : Subtype (MeasurableSet : Set Ω → Prop)) : Set Ω)) ∈
        g.range.image (fun a ↦ g ⁻¹' ({a} : Set α)) := by
    simpa [MeasurableFinpartition.ofSimpleFunc] using B.2
  rcases Finset.mem_image.mp hB with ⟨a, ha, hBa⟩
  have hga : g ω = a := by
    simpa [hBa] using hω
  have hg'a : g ω' = a := by
    simpa [hBa] using hω'
  exact hga.trans hg'a.symm

/-- Helper for Example 20.36: each fiber of the transparent block code is measurable. -/
private theorem measurableSet_prefixBlockCode_fiber {Ω : Type*} [MeasurableSpace Ω]
    (τ : Ω → Ω) (hτ : Measurable τ) (part : MeasurableFinpartition Ω) (n : ℕ+)
    (s : Fin n → part.parts) :
    MeasurableSet ((fun ω : Ω ↦ fun i : Fin n ↦ part.toSimpleFunc ((τ^[i]) ω)) ⁻¹' {s}) := by
  have hmeas : Measurable (fun ω : Ω ↦ fun i : Fin n ↦ part.toSimpleFunc ((τ^[i]) ω)) := by
    -- Proof comment: each coordinate of the transparent block code is measurable.
    refine measurable_pi_lambda _ fun i ↦ ?_
    exact (part.toSimpleFunc).measurable.comp (Measurable.iterate hτ i)
  exact hmeas (measurableSet_singleton s)

/-- Helper for Example 20.36: the transparent block code records the first `n` visited atoms of
`part`. -/
private noncomputable def prefixBlockCode {Ω : Type*} [MeasurableSpace Ω]
    (τ : Ω → Ω) (hτ : Measurable τ) (part : MeasurableFinpartition Ω) (n : ℕ+) :
    SimpleFunc Ω (Fin n → part.parts) where
  toFun := fun ω : Ω ↦ fun i : Fin n ↦ part.toSimpleFunc ((τ^[i]) ω)
  measurableSet_fiber' := measurableSet_prefixBlockCode_fiber τ hτ part n
  finite_range' := Set.toFinite _

/-- Helper for Example 20.36: truncate a long block word to its initial shorter prefix. -/
private def prefixRestriction {α : Type*} {N M : ℕ+} (hNM : N ≤ M) :
    (Fin M → α) → (Fin N → α) :=
  fun w i ↦ w (Fin.castLE ((PNat.coe_le_coe N M).2 hNM) i)

/-- Helper for Example 20.36: the short transparent block code is the truncation of any longer
transparent block code. -/
private theorem prefixBlockCode_eq_prefixRestriction {Ω : Type*} [MeasurableSpace Ω]
    {τ : Ω → Ω} (hτ : Measurable τ) (part : MeasurableFinpartition Ω) {N M : ℕ+} (hNM : N ≤ M) :
    prefixBlockCode τ hτ part N =
      fun ω ↦ prefixRestriction hNM (prefixBlockCode τ hτ part M ω) := by
  -- Proof comment: both sides read off the same first `N` iterates of `τ`.
  funext ω i
  simp [prefixRestriction, prefixBlockCode]

/-- Helper for Example 20.36: the measurable sets determined by one finite prefix code form a
member of the reusable prefix-code approximation family. -/
private def prefixBlockPreimageFamily {Ω : Type*} [MeasurableSpace Ω] {τ : Ω → Ω}
    (hτ : Measurable τ) (part : MeasurableFinpartition Ω) : Set (Set Ω) :=
  Set.range fun p : Σ n : ℕ+, Set (Fin n → part.parts) ↦
    (prefixBlockCode τ hτ part p.1) ⁻¹' p.2

/-- Helper for Example 20.36: every member of the prefix-code approximation family is measurable.
-/
private theorem measurableSet_of_mem_prefixBlockPreimageFamily {Ω : Type*} [MeasurableSpace Ω]
    {τ : Ω → Ω} (hτ : Measurable τ) (part : MeasurableFinpartition Ω) {s : Set Ω}
    (hs : s ∈ prefixBlockPreimageFamily hτ part) :
    MeasurableSet s := by
  rcases hs with ⟨⟨N, S⟩, rfl⟩
  -- Proof comment: every family member is a prefix-code preimage of a discrete subset.
  exact (prefixBlockCode τ hτ part N).measurable (MeasurableSet.of_discrete (s := S))

/-- Helper for Example 20.36: the prefix-code approximation family is an algebra of sets. -/
private theorem isSetAlgebra_prefixBlockPreimageFamily {Ω : Type*} [MeasurableSpace Ω]
    {τ : Ω → Ω} (hτ : Measurable τ) (part : MeasurableFinpartition Ω) :
    IsSetAlgebra (prefixBlockPreimageFamily hτ part) := by
  classical
  refine ⟨?_, ?_, ?_⟩
  · -- Proof comment: the empty set is the preimage of the empty subset of a one-step code space.
    refine Set.mem_range.mpr ⟨⟨(1 : ℕ+), (∅ : Set (Fin (1 : ℕ+) → part.parts))⟩, ?_⟩
    ext ω
    rfl
  · rintro s ⟨⟨N, S⟩, rfl⟩
    -- Proof comment: complements stay at the same block length by complementing the code subset.
    refine Set.mem_range.mpr ⟨⟨N, Sᶜ⟩, ?_⟩
    ext ω
    simp
  · rintro s t ⟨⟨N, S⟩, rfl⟩ ⟨⟨M, T⟩, rfl⟩
    let K : ℕ+ := max N M
    let S' : Set (Fin K → part.parts) :=
      {w | prefixRestriction (show N ≤ K from le_max_left N M) w ∈ S}
    let T' : Set (Fin K → part.parts) :=
      {w | prefixRestriction (show M ≤ K from le_max_right N M) w ∈ T}
    -- Proof comment: raise both prefix constraints to one common block length, then take the
    -- union there.
    refine Set.mem_range.mpr ⟨⟨K, S' ∪ T'⟩, ?_⟩
    ext ω
    simp [S', T',
      prefixBlockCode_eq_prefixRestriction (hτ := hτ) (part := part)
        (hNM := show N ≤ K from le_max_left N M),
      prefixBlockCode_eq_prefixRestriction (hτ := hτ) (part := part)
        (hNM := show M ≤ K from le_max_right N M)]

/-- Helper for Example 20.36: each generator atom already belongs to the reusable prefix-code
approximation family. -/
private theorem iterateAtom_mem_prefixBlockPreimageFamily {Ω : Type*} [MeasurableSpace Ω]
    {τ : Ω → Ω} (hτ : Measurable τ) (part : MeasurableFinpartition Ω) (k : ℕ)
    (A : part.parts) :
    (τ^[k]) ⁻¹' (((A.1 : Subtype (MeasurableSet : Set Ω → Prop)) : Set Ω)) ∈
      prefixBlockPreimageFamily hτ part := by
  -- Proof comment: the `k`-th iterate atom is the event that the `k`-th coordinate of the
  -- length-`k+1` prefix word equals `A`.
  refine Set.mem_range.mpr ⟨⟨⟨k + 1, Nat.succ_pos _⟩, {w | w ⟨k, Nat.lt_succ_self k⟩ = A}⟩, ?_⟩
  ext ω
  change part.toSimpleFunc ((τ^[k]) ω) = A ↔ ((τ^[k]) ω) ∈
    (((A.1 : Subtype (MeasurableSet : Set Ω → Prop)) : Set Ω))
  simpa using (mem_atom_iff_toSimpleFunc_eq part (A := A) (ω := (τ^[k]) ω)).symm

/-- Helper for Example 20.36: the owner block partition is definitionally the partition built from
the transparent block code. -/
private theorem block_eq_ofSimpleFunc_prefixBlockCode {Ω : Type*} [MeasurableSpace Ω]
    {τ : Ω → Ω} (hτ : Measurable τ) (part : MeasurableFinpartition Ω) (n : ℕ+) :
    part.block τ hτ n = MeasurableFinpartition.ofSimpleFunc (prefixBlockCode τ hτ part n) := by
  -- Proof comment: both sides unfold to the same `ofSimpleFunc` presentation of the block code.
  rfl

/-- Helper for Example 20.36: points in the same atom of a block partition have identical
transparent prefix codes. -/
private theorem sameBlockAtom_samePrefixCoordinates {Ω : Type*} [MeasurableSpace Ω]
    {τ : Ω → Ω} (hτ : Measurable τ) (part : MeasurableFinpartition Ω) (n : ℕ+)
    {ω ω' : Ω}
    (h :
      (part.block τ hτ n).toSimpleFunc ω =
        (part.block τ hτ n).toSimpleFunc ω') :
    prefixBlockCode τ hτ part n ω = prefixBlockCode τ hτ part n ω' := by
  have h' :
      (MeasurableFinpartition.ofSimpleFunc (prefixBlockCode τ hτ part n)).toSimpleFunc ω =
        (MeasurableFinpartition.ofSimpleFunc (prefixBlockCode τ hτ part n)).toSimpleFunc ω' := by
    -- Proof comment: first rewrite the owner block partition to its transparent `ofSimpleFunc`
    -- presentation.
    simpa [block_eq_ofSimpleFunc_prefixBlockCode hτ part n] using h
  -- Proof comment: equality of atoms in an `ofSimpleFunc` partition is exactly equality of the
  -- underlying simple-function values.
  exact eq_of_toSimpleFunc_eq_of_ofSimpleFunc (prefixBlockCode τ hτ part n) h'

/-- Helper for Example 20.36: if the coding of `q` factors through the coding of `r`, then the pmf
induced by `q` is the pushforward of the pmf induced by `r` along the same factor map. -/
private theorem toPMF_eq_map_of_toSimpleFuncFactor
    {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
    {q r : MeasurableFinpartition Ω}
    (Φ : r.parts → q.parts)
    (hΦ : (q.toSimpleFunc : Ω → q.parts) = fun ω ↦ Φ (r.toSimpleFunc ω)) :
    q.toPMF P = PMF.map Φ (r.toPMF P) := by
  let μq : Measure q.parts := P.map q.toSimpleFunc
  let μr : Measure r.parts := P.map r.toSimpleFunc
  letI : IsProbabilityMeasure μq :=
    Measure.isProbabilityMeasure_map q.toSimpleFunc.aemeasurable
  letI : IsProbabilityMeasure μr :=
    Measure.isProbabilityMeasure_map r.toSimpleFunc.aemeasurable
  change μq.toPMF = PMF.map Φ μr.toPMF
  apply PMF.toMeasure_injective
  -- Proof comment: compare both pmfs by rewriting them back to the corresponding pushforward
  -- measures.
  rw [Measure.toPMF_toMeasure]
  rw [← PMF.toMeasure_map]
  · rw [Measure.toPMF_toMeasure]
    dsimp [μq, μr]
    rw [Measure.map_map (μ := P) (g := Φ) (f := r.toSimpleFunc)
      (Measurable.of_discrete (f := Φ)) r.toSimpleFunc.measurable]
    rw [hΦ]
    rfl
  · exact Measurable.of_discrete (f := Φ)

/-- Helper for Example 20.36: if the coding of `q` factors through the coding of `r`, then the
partition entropy of `q` is the entropy of the pushforward law of `r`. -/
private theorem partitionEntropy_eq_entropy_map_of_toSimpleFuncFactor
    {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
    {q r : MeasurableFinpartition Ω}
    (Φ : r.parts → q.parts)
    (hΦ : (q.toSimpleFunc : Ω → q.parts) = fun ω ↦ Φ (r.toSimpleFunc ω)) :
    q.partitionEntropy P = entropy (PMF.map Φ (r.toPMF P)) := by
  -- Proof comment: rewrite partition entropy to the entropy of the induced pmf and substitute the
  -- factorized law.
  rw [MeasurableFinpartition.partitionEntropy_def, toPMF_eq_map_of_toSimpleFuncFactor P Φ hΦ]

/-- Helper for Example 20.36: deterministic coding on a finite alphabet cannot increase Shannon
entropy. -/
private theorem negMulLog_add_le
    {x y : ℝ} (hx : 0 ≤ x) (hy : 0 ≤ y) :
    Real.negMulLog (x + y) ≤ Real.negMulLog x + Real.negMulLog y := by
  by_cases hxy : x + y = 0
  · -- Proof comment: if the total mass is zero, both summands already vanish.
    have hx0 : x = 0 := by linarith
    have hy0 : y = 0 := by linarith
    simp [hx0, hy0]
  · -- Proof comment: normalize by the total mass and use the multiplicative `negMulLog` formula.
    set s : ℝ := x + y
    have hxy' : x + y ≠ 0 := by
      simpa [s] using hxy
    have hs : 0 < s := by
      dsimp [s]
      exact lt_of_le_of_ne (add_nonneg hx hy) (by simpa [ne_comm] using hxy')
    have hs_nonneg : 0 ≤ s := le_of_lt hs
    have hs_ne : s ≠ 0 := ne_of_gt hs
    have hxs : x = s * (x / s) := by
      field_simp [s, hs_ne]
    have hys : y = s * (y / s) := by
      field_simp [s, hs_ne]
    have hx_div_nonneg : 0 ≤ x / s := by positivity
    have hy_div_nonneg : 0 ≤ y / s := by positivity
    have hx_div_le_one : x / s ≤ 1 := by
      have hle : x ≤ s := by
        dsimp [s]
        linarith
      field_simp [hs_ne]
      linarith
    have hy_div_le_one : y / s ≤ 1 := by
      have hle : y ≤ s := by
        dsimp [s]
        linarith
      field_simp [hs_ne]
      linarith
    have hsum_div : x / s + y / s = 1 := by
      field_simp [s, hs_ne]
      ring
    have hx_term_nonneg : 0 ≤ s * Real.negMulLog (x / s) := by
      exact mul_nonneg hs_nonneg (Real.negMulLog_nonneg hx_div_nonneg hx_div_le_one)
    have hy_term_nonneg : 0 ≤ s * Real.negMulLog (y / s) := by
      exact mul_nonneg hs_nonneg (Real.negMulLog_nonneg hy_div_nonneg hy_div_le_one)
    have hsplit :
        Real.negMulLog s + (s * Real.negMulLog (x / s) + s * Real.negMulLog (y / s)) =
          ((x / s) * Real.negMulLog s + s * Real.negMulLog (x / s)) +
            ((y / s) * Real.negMulLog s + s * Real.negMulLog (y / s)) := by
      calc
        Real.negMulLog s + (s * Real.negMulLog (x / s) + s * Real.negMulLog (y / s)) =
            ((x / s + y / s) * Real.negMulLog s) +
              (s * Real.negMulLog (x / s) + s * Real.negMulLog (y / s)) := by
          rw [hsum_div]
          ring
        _ =
            ((x / s) * Real.negMulLog s + s * Real.negMulLog (x / s)) +
              ((y / s) * Real.negMulLog s + s * Real.negMulLog (y / s)) := by
          ring
    have hnegMulLog_x :
        Real.negMulLog x = (x / s) * Real.negMulLog s + s * Real.negMulLog (x / s) := by
      calc
        Real.negMulLog x = Real.negMulLog (s * (x / s)) := by
          exact congrArg Real.negMulLog hxs
        _ = (x / s) * Real.negMulLog s + s * Real.negMulLog (x / s) := by
          rw [Real.negMulLog_mul]
    have hnegMulLog_y :
        Real.negMulLog y = (y / s) * Real.negMulLog s + s * Real.negMulLog (y / s) := by
      calc
        Real.negMulLog y = Real.negMulLog (s * (y / s)) := by
          exact congrArg Real.negMulLog hys
        _ = (y / s) * Real.negMulLog s + s * Real.negMulLog (y / s) := by
          rw [Real.negMulLog_mul]
    calc
      Real.negMulLog (x + y) = Real.negMulLog s := by simp [s]
      _ ≤ Real.negMulLog s + (s * Real.negMulLog (x / s) + s * Real.negMulLog (y / s)) := by
        have htail_nonneg :
            0 ≤ s * Real.negMulLog (x / s) + s * Real.negMulLog (y / s) := by
          linarith
        linarith
      _ =
          ((x / s) * Real.negMulLog s + s * Real.negMulLog (x / s)) +
            ((y / s) * Real.negMulLog s + s * Real.negMulLog (y / s)) := by
        exact hsplit
      _ = Real.negMulLog x + Real.negMulLog y := by
        rw [hnegMulLog_x, hnegMulLog_y]

/-- Helper for Example 20.36: the Shannon contribution of a finite sum of nonnegative masses is
bounded by the sum of the individual contributions. -/
private theorem negMulLog_sum_le_sum_negMulLog
    {ι : Type*} (s : Finset ι) (w : ι → ℝ)
    (hw : ∀ i ∈ s, 0 ≤ w i) :
    Real.negMulLog (Finset.sum s w) ≤ Finset.sum s (fun i ↦ Real.negMulLog (w i)) := by
  induction s using Finset.cons_induction with
  | empty =>
      -- Proof comment: the empty sum has zero Shannon contribution.
      simp [Real.negMulLog_zero]
  | @cons a s ha ih =>
      -- Proof comment: split off one mass and apply the two-point superadditivity step.
      have hwa : 0 ≤ w a := hw a (by simp)
      have hws : ∀ i ∈ s, 0 ≤ w i := by
        intro i hi
        exact hw i (by simp [hi])
      have hsum_nonneg : 0 ≤ Finset.sum s w := Finset.sum_nonneg hws
      calc
        Real.negMulLog (Finset.sum (Finset.cons a s ha) w) =
            Real.negMulLog (w a + Finset.sum s w) := by
          simp
        _ ≤ Real.negMulLog (w a) + Real.negMulLog (Finset.sum s w) :=
          negMulLog_add_le hwa hsum_nonneg
        _ ≤ Real.negMulLog (w a) + Finset.sum s (fun i ↦ Real.negMulLog (w i)) := by
          gcongr
          exact ih hws
        _ = Finset.sum (Finset.cons a s ha) (fun i ↦ Real.negMulLog (w i)) := by
          simp

/-- Helper for Example 20.36: deterministic coding on a finite alphabet cannot increase Shannon
entropy. -/
private theorem entropy_map_le {α β : Type*} [Finite α] [Finite β] (p : PMF α) (Φ : α → β) :
    entropy (PMF.map Φ p) ≤ entropy p := by
  classical
  letI : Fintype α := Fintype.ofFinite α
  letI : Fintype β := Fintype.ofFinite β
  have hmap_apply (b : β) :
      ((PMF.map Φ p) b).toReal =
        Finset.sum (Finset.univ.filter (fun a : α ↦ Φ a = b)) fun a ↦ (p a).toReal := by
    calc
      ((PMF.map Φ p) b).toReal =
          (∑' a : α, if b = Φ a then p a else 0).toReal := by
        rw [PMF.map_apply]
      _ = (∑ a : α, if b = Φ a then p a else 0).toReal := by
        rw [tsum_fintype]
      _ = ∑ a : α, (if b = Φ a then p a else 0).toReal := by
        refine ENNReal.toReal_sum ?_
        intro a ha
        by_cases hab : b = Φ a
        · simp [hab, p.apply_ne_top a]
        · simp [hab]
      _ = ∑ a in Finset.univ.filter (fun a : α ↦ Φ a = b), (p a).toReal := by
        simp [Finset.sum_filter]
  have hfiber :
      ∀ b : β,
        Real.negMulLog ((PMF.map Φ p) b).toReal ≤
          ∑ a in Finset.univ.filter (fun a : α ↦ Φ a = b),
            Real.negMulLog ((p a).toReal) := by
    intro b
    rw [hmap_apply b]
    exact negMulLog_sum_le_sum_negMulLog _ _ fun a ha ↦ ENNReal.toReal_nonneg
  have hfiberwise :
      ∑ b : β, ∑ a in Finset.univ.filter (fun a : α ↦ Φ a = b),
          Real.negMulLog ((p a).toReal) =
        ∑ a : α, Real.negMulLog ((p a).toReal) := by
    simpa using
      (Finset.sum_fiberwise (s := Finset.univ) (g := Φ)
        (f := fun a : α ↦ Real.negMulLog ((p a).toReal)))
  rw [entropy_eq_sum, entropy_eq_sum]
  apply EReal.coe_le_coe
  calc
    (-∑ b : β, ((PMF.map Φ p) b).toReal * Real.log (((PMF.map Φ p) b).toReal) : ℝ) =
        ∑ b : β, Real.negMulLog (((PMF.map Φ p) b).toReal) := by
      simp [Real.negMulLog_def]
    _ ≤ ∑ b : β, ∑ a in Finset.univ.filter (fun a : α ↦ Φ a = b),
          Real.negMulLog ((p a).toReal) := by
            exact Finset.sum_le_sum hfiber
    _ = ∑ a : α, Real.negMulLog ((p a).toReal) := hfiberwise
    _ = (-∑ a : α, (p a).toReal * Real.log ((p a).toReal) : ℝ) := by
      simp [Real.negMulLog_def]

/-- Helper for Example 20.36: a deterministic factor of a finite measurable partition cannot have
larger one-step entropy than the original partition. -/
private theorem partitionEntropy_le_of_factor
    {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
    {q r : MeasurableFinpartition Ω}
    (Φ : r.parts → q.parts)
    (hΦ : (q.toSimpleFunc : Ω → q.parts) = fun ω ↦ Φ (r.toSimpleFunc ω)) :
    q.partitionEntropy P ≤ r.partitionEntropy P := by
  -- Proof comment: pass to the induced pmfs and use entropy monotonicity under deterministic
  -- pushforward.
  calc
    q.partitionEntropy P = entropy (PMF.map Φ (r.toPMF P)) := by
      exact partitionEntropy_eq_entropy_map_of_toSimpleFuncFactor P Φ hΦ
    _ ≤ entropy (r.toPMF P) := entropy_map_le (r.toPMF P) Φ
    _ = r.partitionEntropy P := by
      rw [MeasurableFinpartition.partitionEntropy_def]

-/

/-- The half-circle corresponding to the interval `[1 / 2, 1)` in the `[0,1)` model. -/
noncomputable def unitAddCircleRightHalf : Set UnitAddCircle :=
  (fun x : UnitAddCircle ↦ (AddCircle.equivIco (1 : ℝ) 0 x : ℝ)) ⁻¹' Set.Ico (1 / 2 : ℝ) 1

private theorem measurableSet_unitAddCircleRightHalf : MeasurableSet unitAddCircleRightHalf := by
  simpa [unitAddCircleRightHalf] using
    (MeasurableSet.preimage measurableSet_Ico
      (measurable_subtype_coe.comp (AddCircle.measurableEquivIco (1 : ℝ) 0).measurable))

private noncomputable def unitAddCircleRightHalfSet :
    Subtype (MeasurableSet : Set UnitAddCircle → Prop) :=
  ⟨unitAddCircleRightHalf, measurableSet_unitAddCircleRightHalf⟩

private noncomputable def unitAddCircleLeftHalfSet :
    Subtype (MeasurableSet : Set UnitAddCircle → Prop) :=
  ⟨unitAddCircleRightHalfᶜ, measurableSet_unitAddCircleRightHalf.compl⟩

/-- The two-atom partition of `AddCircle 1` into the left and right half-circles. -/
noncomputable def unitAddCircleHalfPartition : MeasurableFinpartition UnitAddCircle := by
  classical
  refine Finpartition.ofErase {unitAddCircleRightHalfSet, unitAddCircleLeftHalfSet} ?_ ?_
  · refine Finset.supIndep_iff_pairwiseDisjoint.mpr ?_
    intro a ha b hb hab
    simp at ha hb
    rcases ha with rfl | rfl <;> rcases hb with rfl | rfl
    · exact (hab rfl).elim
    · intro s hs_right hs_left x hx
      exact (hs_left hx) (hs_right hx)
    · intro s hs_left hs_right x hx
      exact (hs_left hx) (hs_right hx)
    · exact (hab rfl).elim
  · ext x
    simp [unitAddCircleRightHalfSet, unitAddCircleLeftHalfSet, Finset.sup_insert,
      Finset.sup_singleton]

/-- Helper for Example 20.36: the right half-circle contains the chart point `3 / 4`. -/
private theorem unitAddCircleRightHalf_nonempty : unitAddCircleRightHalf.Nonempty := by
  let x : Set.Ico (0 : ℝ) 1 := ⟨3 / 4, by constructor <;> norm_num⟩
  refine ⟨((x : ℝ) : UnitAddCircle), ?_⟩
  -- Proof comment: in the `[0,1)` chart, `3 / 4` lands inside the right half-interval.
  rw [unitAddCircleRightHalf, Set.mem_preimage, AddCircle.coe_equivIco_mk_apply]
  rw [div_one, Int.fract_eq_self.mpr x.2, mul_one]
  simpa [x] using (show ((x : ℝ) : ℝ) ∈ Set.Ico (1 / 2 : ℝ) 1 by constructor <;> norm_num)

/-- Helper for Example 20.36: the left half-circle contains the chart point `1 / 4`. -/
private theorem unitAddCircleLeftHalf_nonempty : (unitAddCircleRightHalfᶜ : Set UnitAddCircle).Nonempty := by
  let x : Set.Ico (0 : ℝ) 1 := ⟨1 / 4, by constructor <;> norm_num⟩
  refine ⟨((x : ℝ) : UnitAddCircle), ?_⟩
  -- Proof comment: in the same chart, `1 / 4` stays outside the right half-interval.
  rw [Set.mem_compl_iff, unitAddCircleRightHalf, Set.mem_preimage, AddCircle.coe_equivIco_mk_apply]
  rw [div_one, Int.fract_eq_self.mpr x.2, mul_one]
  simpa [x] using (show ((x : ℝ) : ℝ) ∉ Set.Ico (1 / 2 : ℝ) 1 by
    intro hx
    linarith [hx.1, hx.2])

/-- Helper for Example 20.36: the right-half atom survives the `ofErase` construction. -/
private theorem unitAddCircleRightHalfSet_ne_bot :
    unitAddCircleRightHalfSet ≠ (⊥ : Subtype (MeasurableSet : Set UnitAddCircle → Prop)) := by
  intro hEq
  rcases unitAddCircleRightHalf_nonempty with ⟨x, hx⟩
  have hset : unitAddCircleRightHalf = (∅ : Set UnitAddCircle) := by
    simpa [unitAddCircleRightHalfSet] using congrArg Subtype.val hEq
  simpa [hset] using hx

/-- Helper for Example 20.36: the left-half atom also survives the `ofErase` construction. -/
private theorem unitAddCircleLeftHalfSet_ne_bot :
    unitAddCircleLeftHalfSet ≠ (⊥ : Subtype (MeasurableSet : Set UnitAddCircle → Prop)) := by
  intro hEq
  rcases unitAddCircleLeftHalf_nonempty with ⟨x, hx⟩
  have hset : unitAddCircleRightHalfᶜ = (∅ : Set UnitAddCircle) := by
    simpa [unitAddCircleLeftHalfSet] using congrArg Subtype.val hEq
  simpa [hset] using hx

/-- Helper for Example 20.36: the left and right half atoms are distinct. -/
private theorem unitAddCircleLeftHalfSet_ne_rightHalfSet :
    unitAddCircleLeftHalfSet ≠ unitAddCircleRightHalfSet := by
  intro hEq
  have hcompl : unitAddCircleRightHalfᶜ = unitAddCircleRightHalf := by
    simpa [unitAddCircleLeftHalfSet, unitAddCircleRightHalfSet] using congrArg Subtype.val hEq
  rcases unitAddCircleRightHalf_nonempty with ⟨x, hx⟩
  have hxCompl : x ∈ unitAddCircleRightHalfᶜ := by
    simpa [hcompl] using hx
  exact hxCompl hx

/-- Helper for Example 20.36: the right-half atom appears among the parts of the canonical
two-piece partition. -/
private theorem unitAddCircleRightHalf_mem_parts :
    unitAddCircleRightHalfSet ∈ unitAddCircleHalfPartition.parts := by
  -- Proof comment: `Finpartition.ofErase` keeps the right half because it is not empty.
  simp [unitAddCircleHalfPartition, unitAddCircleRightHalfSet_ne_bot]

/-- Helper for Example 20.36: the left-half atom also appears among the parts of the canonical
two-piece partition. -/
private theorem unitAddCircleLeftHalf_mem_parts :
    unitAddCircleLeftHalfSet ∈ unitAddCircleHalfPartition.parts := by
  -- Proof comment: the complementary half survives for the same reason.
  simp [unitAddCircleHalfPartition, unitAddCircleRightHalfSet_ne_bot,
    unitAddCircleLeftHalfSet_ne_bot]

/-- Helper for Example 20.36: every atom of the half partition is either the right or the left
half-circle. -/
private theorem eq_right_or_left_of_mem_unitAddCircleHalfPartition_parts
    {A : Subtype (MeasurableSet : Set UnitAddCircle → Prop)}
    (hA : A ∈ unitAddCircleHalfPartition.parts) :
    A = unitAddCircleRightHalfSet ∨ A = unitAddCircleLeftHalfSet := by
  -- Proof comment: `unitAddCircleHalfPartition` is exactly the two surviving halves after
  -- erasing the empty set.
  have hA' :
      A ≠ (⊥ : Subtype (MeasurableSet : Set UnitAddCircle → Prop)) ∧
        (A = unitAddCircleRightHalfSet ∨ A = unitAddCircleLeftHalfSet) := by
    simpa [unitAddCircleHalfPartition, unitAddCircleRightHalfSet_ne_bot,
      unitAddCircleLeftHalfSet_ne_bot] using hA
  exact hA'.2

/-- Helper for Example 20.36: label the two half-partition atoms by `Bool`, with `true` for the
right half and `false` for the left half. -/
private noncomputable def unitAddCircleHalfPartitionAtomToBool
    (A : unitAddCircleHalfPartition.parts) : Bool :=
  if (A : Subtype (MeasurableSet : Set UnitAddCircle → Prop)) = unitAddCircleRightHalfSet
    then true
    else false

/-- Helper for Example 20.36: the right-half atom is labeled by `true`. -/
private theorem unitAddCircleHalfPartitionAtomToBool_right :
    unitAddCircleHalfPartitionAtomToBool
        ⟨unitAddCircleRightHalfSet, unitAddCircleRightHalf_mem_parts⟩ = true := by
  -- Proof comment: the defining `if` takes the right-half branch on the right-half atom itself.
  simp [unitAddCircleHalfPartitionAtomToBool]

/-- Helper for Example 20.36: the left-half atom is labeled by `false`. -/
private theorem unitAddCircleHalfPartitionAtomToBool_left :
    unitAddCircleHalfPartitionAtomToBool
        ⟨unitAddCircleLeftHalfSet, unitAddCircleLeftHalf_mem_parts⟩ = false := by
  -- Proof comment: the left-half atom is distinct from the right-half atom.
  simp [unitAddCircleHalfPartitionAtomToBool, unitAddCircleLeftHalfSet_ne_rightHalfSet]

/-- Helper for Example 20.36: the Boolean atom label is injective on the two-half partition. -/
private theorem unitAddCircleHalfPartitionAtomToBool_injective :
    Function.Injective unitAddCircleHalfPartitionAtomToBool := by
  intro A B hAB
  rcases eq_right_or_left_of_mem_unitAddCircleHalfPartition_parts A.2 with hA | hA
  · rcases eq_right_or_left_of_mem_unitAddCircleHalfPartition_parts B.2 with hB | hB
    · exact Subtype.ext (hA.trans hB.symm)
    · have : true = false := by
        simpa [hA, hB, unitAddCircleHalfPartitionAtomToBool,
          unitAddCircleLeftHalfSet_ne_rightHalfSet] using hAB
      cases this
  · rcases eq_right_or_left_of_mem_unitAddCircleHalfPartition_parts B.2 with hB | hB
    · have : false = true := by
        simpa [hA, hB, unitAddCircleHalfPartitionAtomToBool,
          unitAddCircleLeftHalfSet_ne_rightHalfSet] using hAB
      cases this
    · exact Subtype.ext (hA.trans hB.symm)

/-- Helper for Example 20.36: relabel a block word over half-partition atoms coordinatewise by
the corresponding Boolean word. -/
private def unitAddCircleHalfPartitionWordLabel (n : ℕ+) :
    (Fin n → unitAddCircleHalfPartition.parts) → (Fin n → Bool) :=
  fun w i ↦ unitAddCircleHalfPartitionAtomToBool (w i)

/-- Helper for Example 20.36: coordinatewise Boolean relabeling of half-partition words is
injective. -/
private theorem unitAddCircleHalfPartitionWordLabel_injective (n : ℕ+) :
    Function.Injective (unitAddCircleHalfPartitionWordLabel n) := by
  intro u v huv
  funext i
  exact unitAddCircleHalfPartitionAtomToBool_injective (congrFun huv i)

private noncomputable def unitAddCircleHalfBlockCode
    (r : ℝ) (n : ℕ+) (x : UnitAddCircle) : Fin n → Bool :=
  letI : DecidablePred fun y : UnitAddCircle ↦ y ∈ unitAddCircleRightHalf := Classical.decPred _
  fun i ↦ if ((((· + (r : UnitAddCircle)))^[i]) x ∈ unitAddCircleRightHalf) then true else false

/-- Helper for Example 20.36: a chart point `t ∈ [0, 1)` lies in the right half-circle exactly
when `t ∈ [1 / 2, 1)`. -/
private theorem unitAddCircle_mk_mem_rightHalf_iff
    {t : ℝ} (ht : t ∈ Set.Ico (0 : ℝ) 1) :
    (((t : ℝ) : UnitAddCircle) ∈ unitAddCircleRightHalf) ↔ t ∈ Set.Ico (1 / 2 : ℝ) 1 := by
  -- Proof comment: on the concrete `[0, 1)` chart, `AddCircle.equivIco` returns `t` itself.
  rw [unitAddCircleRightHalf, Set.mem_preimage, AddCircle.coe_equivIco_mk_apply]
  simpa [Int.fract_eq_self.mpr ht]

/-- Helper for Example 20.36: the `[0,1)` chart of the `i`th iterate of the rotation starting at
`x` is the fractional part of `x + i * r`. -/
private theorem unitAddCircleRotation_iterate_eq_chartFract
    (r : ℝ) (i : ℕ) (x : Set.Ico (0 : ℝ) 1) :
    (AddCircle.equivIco (1 : ℝ) 0 ((((fun y : UnitAddCircle ↦ y + (r : UnitAddCircle))^[i])
      ((x : ℝ) : UnitAddCircle)) : UnitAddCircle) : ℝ) =
      Int.fract ((x : ℝ) + i * r) := by
  have hiter :
      ((((fun y : UnitAddCircle ↦ y + (r : UnitAddCircle))^[i]) ((x : ℝ) : UnitAddCircle))) =
        (((x : ℝ) : UnitAddCircle) + i • (r : UnitAddCircle)) := by
    -- Proof comment: collapse the `i`th iterate of a translation to translation by `i • r`.
    simpa using congrFun (add_right_iterate (r : UnitAddCircle) i) (((x : ℝ) : UnitAddCircle))
  have hmul :
      (((x : ℝ) : UnitAddCircle) + i • (r : UnitAddCircle)) =
        ((((x : ℝ) + i * r : ℝ) : UnitAddCircle)) := by
    have hmul' : ((((i : ℝ) * r : ℝ) : UnitAddCircle)) = i • (r : UnitAddCircle) := by
      simpa [nsmul_eq_mul, mul_comm] using
        (AddCircle.coe_zsmul (p := (1 : ℝ)) (n := (i : ℤ)) (x := r))
    -- Proof comment: rewrite the iterate amount `i • r` back to the corresponding real scalar.
    rw [← hmul']
    rfl
  -- Proof comment: after normalizing the iterate on the circle, the standard `equivIco` formula
  -- turns the chart coordinate into an `Int.fract`.
  rw [hiter, hmul]
  simpa using (AddCircle.coe_equivIco_mk_apply (p := (1 : ℝ)) (x := ((x : ℝ) + i * r)))

/-- Helper for Example 20.36: the `i`th Boolean bit of the half-partition itinerary records
whether the chart fractional part of `x + i * r` lies in `[1/2, 1)`. -/
private theorem unitAddCircleHalfBlockCode_eq_chartFractCode
    (r : ℝ) (n : ℕ+) (x : Set.Ico (0 : ℝ) 1) (i : Fin n) :
    unitAddCircleHalfBlockCode r n (((x : ℝ) : UnitAddCircle)) i = true ↔
      Int.fract ((x : ℝ) + (i : ℕ) * r) ∈ Set.Ico (1 / 2 : ℝ) 1 := by
  letI : DecidablePred fun y : UnitAddCircle ↦ y ∈ unitAddCircleRightHalf := Classical.decPred _
  -- Proof comment: unfold the Boolean itinerary and rewrite right-half membership through the
  -- chart formula for the rotated point.
  simp [unitAddCircleHalfBlockCode]
  have hchart :
      (AddCircle.equivIco (1 : ℝ) 0
        ((((x : ℝ) : UnitAddCircle) + (i : ℕ) • (r : UnitAddCircle)) : UnitAddCircle) : ℝ) =
        Int.fract ((x : ℝ) + (i : ℕ) * r) := by
    -- Proof comment: this is the iterate chart formula rewritten after `simp` normalizes the
    -- iterate to translation by `i • r`.
    simpa using unitAddCircleRotation_iterate_eq_chartFract r (i : ℕ) x
  simpa [unitAddCircleRightHalf, Set.mem_preimage] using
    congrArg (fun t : ℝ ↦ t ∈ Set.Ico (1 / 2 : ℝ) 1) hchart

/-- Helper for Example 20.36: the union of all atoms of a measurable finite partition is the whole
space. -/
private theorem biUnion_parts_eq_univ {Ω : Type*} [MeasurableSpace Ω]
    (part : MeasurableFinpartition Ω) :
    (⋃ s ∈ part.parts, ((s : Subtype (MeasurableSet : Set Ω → Prop)) : Set Ω)) = Set.univ := by
  simpa [MeasureTheory.preVariation.Finset.sup_measurableSetSubtype_eq_biUnion] using
    congrArg (fun s : Subtype (MeasurableSet : Set Ω → Prop) ↦ (s : Set Ω)) part.sup_parts

/-- Helper for Example 20.36: take the union of the atoms indexed by a finite set of partition
labels. -/
private def blockPartsUnion {Ω : Type*} [MeasurableSpace Ω] (part : MeasurableFinpartition Ω)
    (U : Finset part.parts) : Set Ω :=
  ⋃ A ∈ U, (((A.1 : Subtype (MeasurableSet : Set Ω → Prop)) : Set Ω))

/-- Helper for Example 20.36: a finite union of atoms of a measurable finite partition is
measurable. -/
private theorem measurableSet_blockPartsUnionCurrent {Ω : Type*} [MeasurableSpace Ω]
    (part : MeasurableFinpartition Ω) (U : Finset part.parts) :
    MeasurableSet (blockPartsUnion part U) := by
  -- Proof comment: each selected block atom is measurable, and there are finitely many of them.
  classical
  unfold blockPartsUnion
  exact MeasurableSet.iUnion fun A ↦ MeasurableSet.iUnion fun _ ↦ A.1.2

/-- Helper for Example 20.36: a candidate long-block approximation is encoded by its block length
and the finite family of block atoms used in the approximation. -/
private structure BlockApproximationData {Ω : Type*} [MeasurableSpace Ω] {τ : Ω → Ω}
    (hτ : Measurable τ) (part : MeasurableFinpartition Ω) where
  length : ℕ+
  atoms : Finset ((part.block τ hτ length).parts)
  carrier : Set Ω

/-- Helper for Example 20.36: a block approximation is good if its carrier set is within the
prescribed symmetric-difference error budget. -/
private def BlockApproximationGood {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω)
    {τ : Ω → Ω} (hτ : Measurable τ) (part : MeasurableFinpartition Ω)
    (s : Set Ω) (ε : ℝ) (approx : BlockApproximationData hτ part) : Prop :=
  approx.carrier = blockPartsUnion (part.block τ hτ approx.length) approx.atoms ∧
    P ((s \ approx.carrier) ∪ (approx.carrier \ s)) < ENNReal.ofReal ε

/-- Helper for Example 20.36: choose the unique atom of a measurable finite partition containing
each point. -/
private noncomputable def indexedPart {Ω : Type*} [MeasurableSpace Ω]
    (part : MeasurableFinpartition Ω) :
    IndexedPartition fun s : part.parts ↦
      ((s.1 : Subtype (MeasurableSet : Set Ω → Prop)) : Set Ω) := by
  classical
  refine IndexedPartition.mk' _ ?_ ?_ ?_
  · intro s t hst
    have hdisj :
        Disjoint (s.1 : Subtype (MeasurableSet : Set Ω → Prop)) t.1 :=
      part.disjoint s.2 t.2 (by simpa using hst)
    exact (disjoint_subtype_iff (fun {_ _} hx hy ↦ hx.inter hy) MeasurableSet.empty).1 hdisj
  · intro s
    rw [Set.nonempty_iff_ne_empty]
    intro hs
    apply part.ne_bot s.2
    ext ω
    simp [hs]
  · intro ω
    have :
        ω ∈ ⋃ s ∈ part.parts, ((s : Subtype (MeasurableSet : Set Ω → Prop)) : Set Ω) := by
      rw [biUnion_parts_eq_univ part]
      simp
    simpa [Set.mem_iUnion] using this

/-- Helper for Example 20.36: a point belongs to the atom selected by the canonical coding of a
measurable finite partition. -/
private theorem mem_toSimpleFunc_atom {Ω : Type*} [MeasurableSpace Ω]
    (part : MeasurableFinpartition Ω) (ω : Ω) :
    ω ∈ (((part.toSimpleFunc ω).1 : Subtype (MeasurableSet : Set Ω → Prop)) : Set Ω) := by
  -- Proof comment: unfold the indexed partition model so the selected atom contains `ω` by
  -- construction.
  change ω ∈ (((indexedPart part).index ω : part.parts).1 : Set Ω)
  exact (indexedPart part).mem_index ω

/-- Helper for Example 20.36: membership in a partition atom is equivalent to selecting that atom
under the canonical coding. -/
private theorem mem_atom_iff_toSimpleFunc_eq {Ω : Type*} [MeasurableSpace Ω]
    (part : MeasurableFinpartition Ω) {A : part.parts} {ω : Ω} :
    ω ∈ (((A.1 : Subtype (MeasurableSet : Set Ω → Prop)) : Set Ω)) ↔ part.toSimpleFunc ω = A := by
  -- Proof comment: after rewriting through the indexed partition, atom membership is exactly the
  -- statement that the index map chooses `A`.
  change ω ∈ ((A.1 : Subtype (MeasurableSet : Set Ω → Prop)) : Set Ω) ↔
    (indexedPart part).index ω = A
  rw [← (indexedPart part).mem_iff_index_eq]

/-- Helper for Example 20.36: every nonempty fiber of a simple function is one of the atoms of
the partition built from that simple function. -/
private theorem fiber_mem_parts_of_ofSimpleFunc {Ω : Type*} [MeasurableSpace Ω] {α : Type*}
    (f : SimpleFunc Ω α) {a : α} (ha : a ∈ f.range) :
    (⟨f ⁻¹' ({a} : Set α), f.measurableSet_fiber a⟩ :
      Subtype (MeasurableSet : Set Ω → Prop)) ∈
      (MeasurableFinpartition.ofSimpleFunc f).parts := by
  classical
  -- Proof comment: `ofSimpleFunc` stores exactly the nonempty singleton fibers of `f`.
  change
    (⟨f ⁻¹' ({a} : Set α), f.measurableSet_fiber a⟩ :
      Subtype (MeasurableSet : Set Ω → Prop)) ∈
      Finset.preimage _ Subtype.val Subtype.val_injective.injOn
  exact Finset.mem_preimage.mpr (Finset.mem_image.mpr ⟨a, ha, rfl⟩)

/-- Helper for Example 20.36: every atom of `MeasurableFinpartition.ofSimpleFunc g` is the fiber
of `g` over some value in the range of `g`. -/
private theorem exists_fiber_eq_of_ofSimpleFunc_part {Ω : Type*} [MeasurableSpace Ω] {α : Type*}
    (g : SimpleFunc Ω α) (A : (MeasurableFinpartition.ofSimpleFunc g).parts) :
    ∃ a ∈ g.range, g ⁻¹' ({a} : Set α) =
      (((A.1 : Subtype (MeasurableSet : Set Ω → Prop)) : Set Ω)) := by
  classical
  have hA :
      (((A.1 : Subtype (MeasurableSet : Set Ω → Prop)) : Set Ω)) ∈
        g.range.image (fun a ↦ g ⁻¹' ({a} : Set α)) := by
    -- Proof comment: unpack the `ofSimpleFunc` atom back to the stored fiber presentation.
    have hA' :
        (A.1 : Subtype (MeasurableSet : Set Ω → Prop)) ∈
          Finset.preimage (g.range.image (fun a ↦ g ⁻¹' ({a} : Set α)))
            Subtype.val Subtype.val_injective.injOn := by
      simpa [MeasurableFinpartition.ofSimpleFunc] using A.2
    exact Finset.mem_preimage.mp hA'
  rcases Finset.mem_image.mp hA with ⟨a, ha, hEq⟩
  exact ⟨a, ha, hEq⟩

/-- Helper for Example 20.36: each atom of `MeasurableFinpartition.ofSimpleFunc g` remembers the
unique value whose fiber it is. -/
private noncomputable def ofSimpleFuncFiberValue {Ω : Type*} [MeasurableSpace Ω] {α : Type*}
    (g : SimpleFunc Ω α) (A : (MeasurableFinpartition.ofSimpleFunc g).parts) : α :=
  Classical.choose (exists_fiber_eq_of_ofSimpleFunc_part g A)

/-- Helper for Example 20.36: the underlying set of an `ofSimpleFunc` atom is exactly the fiber
over its remembered value. -/
private theorem ofSimpleFuncFiberValue_spec {Ω : Type*} [MeasurableSpace Ω] {α : Type*}
    (g : SimpleFunc Ω α) (A : (MeasurableFinpartition.ofSimpleFunc g).parts) :
    g ⁻¹' ({ofSimpleFuncFiberValue g A} : Set α) =
      (((A.1 : Subtype (MeasurableSet : Set Ω → Prop)) : Set Ω)) := by
  -- Proof comment: unfold the chosen witness for the fiber label of this atom.
  exact (Classical.choose_spec (exists_fiber_eq_of_ofSimpleFunc_part g A)).2

/-- Helper for Example 20.36: the original simple function factors through the canonical atom code
of the partition built from its fibers. -/
private theorem simpleFunc_eq_ofSimpleFuncFiberValue_comp_toSimpleFunc {Ω : Type*}
    [MeasurableSpace Ω] {α : Type*} (g : SimpleFunc Ω α) :
    g = fun ω ↦ ofSimpleFuncFiberValue g ((MeasurableFinpartition.ofSimpleFunc g).toSimpleFunc ω) := by
  funext ω
  -- Proof comment: the selected atom is exactly the fiber containing `ω`, so its remembered value
  -- is `g ω`.
  have hmem := mem_toSimpleFunc_atom (MeasurableFinpartition.ofSimpleFunc g) ω
  have hspec :=
    ofSimpleFuncFiberValue_spec g ((MeasurableFinpartition.ofSimpleFunc g).toSimpleFunc ω)
  have :
      ω ∈ g ⁻¹'
        ({ofSimpleFuncFiberValue g ((MeasurableFinpartition.ofSimpleFunc g).toSimpleFunc ω)} :
          Set α) := by
    simpa [hspec] using hmem
  simpa using this

/-- Helper for Example 20.36: the remembered fiber values injectively label the atoms of
`MeasurableFinpartition.ofSimpleFunc g`. -/
private theorem ofSimpleFuncFiberValue_injective {Ω : Type*} [MeasurableSpace Ω] {α : Type*}
    (g : SimpleFunc Ω α) :
    Function.Injective (ofSimpleFuncFiberValue g) := by
  intro A B hAB
  -- Proof comment: equal remembered values give equal singleton fibers, hence equal atoms.
  apply Subtype.ext
  apply Subtype.ext
  calc
    (((A.1 : Subtype (MeasurableSet : Set Ω → Prop)) : Set Ω)) =
        g ⁻¹' ({ofSimpleFuncFiberValue g A} : Set α) := by
          symm
          exact ofSimpleFuncFiberValue_spec g A
    _ = g ⁻¹' ({ofSimpleFuncFiberValue g B} : Set α) := by rw [hAB]
    _ = (((B.1 : Subtype (MeasurableSet : Set Ω → Prop)) : Set Ω)) := by
          exact ofSimpleFuncFiberValue_spec g B

/-- Helper for Example 20.36: the preimage of a value set under a finite-valued code is the union
of those atoms of the associated `ofSimpleFunc` partition whose remembered values lie in that
value set. -/
private theorem preimage_eq_biUnion_parts_filter_of_ofSimpleFuncFiberValue {Ω : Type*}
    [MeasurableSpace Ω] {α : Type*} (g : SimpleFunc Ω α) (S : Set α)
    [DecidablePred fun A : (MeasurableFinpartition.ofSimpleFunc g).parts =>
      ofSimpleFuncFiberValue g A ∈ S] :
    g ⁻¹' S =
      blockPartsUnion (MeasurableFinpartition.ofSimpleFunc g)
        ((MeasurableFinpartition.ofSimpleFunc g).parts.attach.filter
          (fun A ↦ ofSimpleFuncFiberValue g A ∈ S)) := by
  ext ω
  constructor
  · intro hω
    -- Proof comment: choose the atom selected by `ω`; its remembered fiber value is exactly
    -- `g ω`, so that atom appears in the filtered union.
    let A : (MeasurableFinpartition.ofSimpleFunc g).parts :=
      (MeasurableFinpartition.ofSimpleFunc g).toSimpleFunc ω
    refine Set.mem_iUnion.2 ⟨A, ?_⟩
    refine Set.mem_iUnion.2 ?_
    have hvalue : g ω = ofSimpleFuncFiberValue g A := by
      simpa [A] using congrArg (fun f : Ω → α ↦ f ω)
        (simpleFunc_eq_ofSimpleFuncFiberValue_comp_toSimpleFunc g)
    refine ⟨by simpa [A, hvalue] using hω, ?_⟩
    exact mem_toSimpleFunc_atom (MeasurableFinpartition.ofSimpleFunc g) ω
  · intro hω
    rcases Set.mem_iUnion.1 hω with ⟨A, hω⟩
    rcases Set.mem_iUnion.1 hω with ⟨hA, hωA⟩
    have hAS : ofSimpleFuncFiberValue g A ∈ S := (Finset.mem_filter.mp hA).2
    have hvalue : g ω = ofSimpleFuncFiberValue g A := by
      have : ω ∈ g ⁻¹' ({ofSimpleFuncFiberValue g A} : Set α) := by
        simpa [ofSimpleFuncFiberValue_spec g A] using hωA
      simpa using this
    simpa [hvalue] using hAS

/-- Helper for Example 20.36: a finite union of atoms of `MeasurableFinpartition.ofSimpleFunc g`
is the preimage of the corresponding finite set of remembered values. -/
private theorem blockPartsUnion_eq_preimage_image_of_ofSimpleFuncFiberValue
    {Ω : Type*} [MeasurableSpace Ω] {α : Type*} [DecidableEq α] (g : SimpleFunc Ω α)
    (U : Finset (MeasurableFinpartition.ofSimpleFunc g).parts) :
    blockPartsUnion (MeasurableFinpartition.ofSimpleFunc g) U =
      g ⁻¹' (↑(U.image (ofSimpleFuncFiberValue g)) : Set α) := by
  ext ω
  constructor
  · intro hω
    -- Proof comment: a point in the chosen union lies in one selected atom, so its value is one
    -- of the remembered labels carried by `U`.
    rcases Set.mem_iUnion.1 hω with ⟨A, hω⟩
    rcases Set.mem_iUnion.1 hω with ⟨hA, hωA⟩
    refine Finset.mem_coe.2 (Finset.mem_image.2 ⟨A, hA, ?_⟩)
    have hvalue : g ω = ofSimpleFuncFiberValue g A := by
      have : ω ∈ g ⁻¹' ({ofSimpleFuncFiberValue g A} : Set α) := by
        simpa [ofSimpleFuncFiberValue_spec g A] using hωA
      simpa using this
    exact hvalue.symm
  · intro hω
    have hω' : g ω ∈ U.image (ofSimpleFuncFiberValue g) := Finset.mem_coe.1 hω
    rcases Finset.mem_image.1 hω' with ⟨A, hA, hvalue⟩
    refine Set.mem_iUnion.2 ⟨A, Set.mem_iUnion.2 ⟨hA, ?_⟩⟩
    have : ω ∈ g ⁻¹' ({ofSimpleFuncFiberValue g A} : Set α) := by
      simpa [hvalue] using (show g ω ∈ ({g ω} : Set α) by simp)
    simpa [ofSimpleFuncFiberValue_spec g A] using this

private noncomputable def ofSimpleFuncRangeEquivParts {Ω : Type*} [MeasurableSpace Ω]
    {α : Type*} (g : SimpleFunc Ω α) :
    Set.range g ≃ (MeasurableFinpartition.ofSimpleFunc g).parts := by
  classical
  let F : (MeasurableFinpartition.ofSimpleFunc g).parts → Set.range g := fun A ↦
    ⟨ofSimpleFuncFiberValue g A,
      by
        simpa [ofSimpleFuncFiberValue] using
          (Classical.choose_spec (exists_fiber_eq_of_ofSimpleFunc_part g A)).1⟩
  refine (Equiv.ofBijective F ?_).symm
  constructor
  · intro A B h
    exact ofSimpleFuncFiberValue_injective g (Subtype.ext_iff.mp h)
  · intro a
    rcases a.2 with ⟨ω, hω⟩
    refine ⟨(MeasurableFinpartition.ofSimpleFunc g).toSimpleFunc ω, ?_⟩
    apply Subtype.ext
    simpa [F, hω] using
      (congrArg (fun f : Ω → α ↦ f ω) (simpleFunc_eq_ofSimpleFuncFiberValue_comp_toSimpleFunc g)).symm

/-- Helper for Example 20.36: placeholder equivalence showing that injective relabeling preserves
the number of distinct code words. -/
private noncomputable def rangeEquivCompOfInjective
    {α β γ : Type*} (f : α → β) (g : β → γ) (hg : Function.Injective g) :
    Set.range f ≃ Set.range (g ∘ f) := by
  let F : Set.range f → Set.range (g ∘ f) := fun y ↦
    ⟨g y.1, by
      rcases y.2 with ⟨x, hx⟩
      exact ⟨x, by simpa [Function.comp, hx]⟩⟩
  refine Equiv.ofBijective F ?_
  constructor
  · intro a b hF
    apply Subtype.ext
    exact hg (Subtype.ext_iff.mp hF)
  · intro z
    rcases z.2 with ⟨x, hx⟩
    refine ⟨⟨f x, ⟨x, rfl⟩⟩, ?_⟩
    apply Subtype.ext
    simpa [F, Function.comp, hx]

/-- Helper for Example 20.36: each fiber of the transparent block code is measurable. -/
private theorem measurableSet_prefixBlockCode_fiber {Ω : Type*} [MeasurableSpace Ω]
    (τ : Ω → Ω) (hτ : Measurable τ) (part : MeasurableFinpartition Ω) (n : ℕ+)
    (s : Fin n → part.parts) :
    MeasurableSet ((fun ω : Ω ↦ fun i : Fin n ↦ part.toSimpleFunc ((τ^[i]) ω)) ⁻¹' {s}) := by
  have hmeas : Measurable (fun ω : Ω ↦ fun i : Fin n ↦ part.toSimpleFunc ((τ^[i]) ω)) := by
    -- Proof comment: each coordinate of the transparent block code is measurable.
    refine measurable_pi_lambda _ fun i ↦ ?_
    exact (part.toSimpleFunc).measurable.comp (Measurable.iterate hτ i)
  exact hmeas (measurableSet_singleton s)

/-- Helper for Example 20.36: the transparent length-`n` block code records the first `n`
visited atoms of `part`. -/
private noncomputable def prefixBlockCode {Ω : Type*} [MeasurableSpace Ω]
    (τ : Ω → Ω) (hτ : Measurable τ) (part : MeasurableFinpartition Ω) (n : ℕ+) :
    SimpleFunc Ω (Fin n → part.parts) where
  toFun := fun ω : Ω ↦ fun i : Fin n ↦ part.toSimpleFunc ((τ^[i]) ω)
  measurableSet_fiber' := measurableSet_prefixBlockCode_fiber τ hτ part n
  finite_range' := Set.toFinite _

/-- Helper for Example 20.36: truncate a long block word to its initial shorter prefix. -/
private def prefixRestriction {α : Type*} {N M : ℕ+} (hNM : N ≤ M) :
    (Fin M → α) → (Fin N → α) :=
  fun w i ↦ w (Fin.castLE ((PNat.coe_le_coe N M).2 hNM) i)

/-- Helper for Example 20.36: the short transparent block code is the truncation of any longer
transparent block code. -/
private theorem prefixBlockCode_eq_prefixRestriction {Ω : Type*} [MeasurableSpace Ω]
    {τ : Ω → Ω} (hτ : Measurable τ) (part : MeasurableFinpartition Ω) {N M : ℕ+} (hNM : N ≤ M) :
    prefixBlockCode τ hτ part N =
      fun ω ↦ prefixRestriction hNM (prefixBlockCode τ hτ part M ω) := by
  -- Proof comment: both sides read off the same first `N` iterates of `τ`.
  funext ω i
  simp [prefixRestriction, prefixBlockCode]

/-- Helper for Example 20.36: the measurable sets determined by one finite prefix code form a
member of the reusable prefix-code approximation family. -/
private def prefixBlockPreimageFamily {Ω : Type*} [MeasurableSpace Ω] {τ : Ω → Ω}
    (hτ : Measurable τ) (part : MeasurableFinpartition Ω) : Set (Set Ω) :=
  Set.range fun p : Σ n : ℕ+, Set (Fin n → part.parts) ↦
    (prefixBlockCode τ hτ part p.1) ⁻¹' p.2

/-- Helper for Example 20.36: every member of the prefix-code approximation family is measurable.
-/
private theorem measurableSet_of_mem_prefixBlockPreimageFamily {Ω : Type*} [MeasurableSpace Ω]
    {τ : Ω → Ω} (hτ : Measurable τ) (part : MeasurableFinpartition Ω) {s : Set Ω}
    (hs : s ∈ prefixBlockPreimageFamily hτ part) :
    MeasurableSet s := by
  rcases hs with ⟨⟨N, S⟩, rfl⟩
  -- Proof comment: every family member is a prefix-code preimage of a discrete subset.
  exact (prefixBlockCode τ hτ part N).measurable (MeasurableSet.of_discrete (s := S))

/-- Helper for Example 20.36: the prefix-code approximation family is an algebra of sets. -/
private theorem isSetAlgebra_prefixBlockPreimageFamily {Ω : Type*} [MeasurableSpace Ω]
    {τ : Ω → Ω} (hτ : Measurable τ) (part : MeasurableFinpartition Ω) :
    IsSetAlgebra (prefixBlockPreimageFamily hτ part) := by
  classical
  refine ⟨?_, ?_, ?_⟩
  · -- Proof comment: the empty set is the preimage of the empty subset of a one-step code space.
    refine Set.mem_range.mpr ⟨⟨(1 : ℕ+), (∅ : Set (Fin (1 : ℕ+) → part.parts))⟩, ?_⟩
    ext ω
    rfl
  · rintro s ⟨⟨N, S⟩, rfl⟩
    -- Proof comment: complements stay at the same block length by complementing the code subset.
    refine Set.mem_range.mpr ⟨⟨N, Sᶜ⟩, ?_⟩
    ext ω
    simp
  · rintro s t ⟨⟨N, S⟩, rfl⟩ ⟨⟨M, T⟩, rfl⟩
    let K : ℕ+ := max N M
    let S' : Set (Fin K → part.parts) :=
      {w | prefixRestriction (show N ≤ K from le_max_left N M) w ∈ S}
    let T' : Set (Fin K → part.parts) :=
      {w | prefixRestriction (show M ≤ K from le_max_right N M) w ∈ T}
    -- Proof comment: raise both prefix constraints to one common block length, then take the
    -- union there.
    refine Set.mem_range.mpr ⟨⟨K, S' ∪ T'⟩, ?_⟩
    ext ω
    simp [S', T',
      prefixBlockCode_eq_prefixRestriction (hτ := hτ) (part := part)
        (hNM := show N ≤ K from le_max_left N M),
      prefixBlockCode_eq_prefixRestriction (hτ := hτ) (part := part)
        (hNM := show M ≤ K from le_max_right N M)]

/-- Helper for Example 20.36: each generator atom already belongs to the reusable prefix-code
approximation family. -/
private theorem iterateAtom_mem_prefixBlockPreimageFamily {Ω : Type*} [MeasurableSpace Ω]
    {τ : Ω → Ω} (hτ : Measurable τ) (part : MeasurableFinpartition Ω) (k : ℕ)
    (A : part.parts) :
    (τ^[k]) ⁻¹' (((A.1 : Subtype (MeasurableSet : Set Ω → Prop)) : Set Ω)) ∈
      prefixBlockPreimageFamily hτ part := by
  -- Proof comment: the `k`-th iterate atom is the event that the `k`-th coordinate of the
  -- length-`k+1` prefix word equals `A`.
  refine Set.mem_range.mpr ⟨⟨⟨k + 1, Nat.succ_pos _⟩, {w | w ⟨k, Nat.lt_succ_self k⟩ = A}⟩, ?_⟩
  ext ω
  change part.toSimpleFunc ((τ^[k]) ω) = A ↔ ((τ^[k]) ω) ∈
    (((A.1 : Subtype (MeasurableSet : Set Ω → Prop)) : Set Ω))
  simpa using (mem_atom_iff_toSimpleFunc_eq part (A := A) (ω := (τ^[k]) ω)).symm

/-- Helper for Example 20.36: the owner block partition is definitionally the partition built from
the transparent block code. -/
private theorem block_eq_ofSimpleFunc_prefixBlockCode {Ω : Type*} [MeasurableSpace Ω]
    {τ : Ω → Ω} (hτ : Measurable τ) (part : MeasurableFinpartition Ω) (n : ℕ+) :
    part.block τ hτ n = MeasurableFinpartition.ofSimpleFunc (prefixBlockCode τ hτ part n) := by
  -- Proof comment: both sides unfold to the same `ofSimpleFunc` presentation of the block code.
  rfl

/-- Helper for Example 20.36: two points in the same partition atom have the same canonical
partition code. -/
private theorem toSimpleFunc_eq_of_mem_atom {Ω : Type*} [MeasurableSpace Ω]
    (part : MeasurableFinpartition Ω) {A : part.parts} {ω ω' : Ω}
    (hω : ω ∈ (((A.1 : Subtype (MeasurableSet : Set Ω → Prop)) : Set Ω)))
    (hω' : ω' ∈ (((A.1 : Subtype (MeasurableSet : Set Ω → Prop)) : Set Ω))) :
    part.toSimpleFunc ω = part.toSimpleFunc ω' := by
  -- Proof comment: both points are coded by the unique atom `A` containing them.
  rw [(mem_atom_iff_toSimpleFunc_eq part).mp hω, (mem_atom_iff_toSimpleFunc_eq part).mp hω']

/-- Helper for Example 20.36: a finite-valued code that is constant on each atom of a partition
factors through the canonical partition code. -/
private theorem ofSimpleFunc_factorsThroughPartitionOfMonochromatic
    {Ω : Type*} [MeasurableSpace Ω] {α : Type*} (part : MeasurableFinpartition Ω)
    (g : SimpleFunc Ω α)
    (hmono :
      ∀ {A : part.parts} {ω ω' : Ω},
        ω ∈ (((A.1 : Subtype (MeasurableSet : Set Ω → Prop)) : Set Ω)) →
        ω' ∈ (((A.1 : Subtype (MeasurableSet : Set Ω → Prop)) : Set Ω)) →
        g ω = g ω') :
    ∃ Φ : part.parts → (MeasurableFinpartition.ofSimpleFunc g).parts,
      ((MeasurableFinpartition.ofSimpleFunc g).toSimpleFunc :
          Ω → (MeasurableFinpartition.ofSimpleFunc g).parts) =
        fun ω ↦ Φ (part.toSimpleFunc ω) := by
  classical
  have hreps :
      ∀ A : part.parts,
        ∃ ω : Ω, ω ∈ (((A.1 : Subtype (MeasurableSet : Set Ω → Prop)) : Set Ω)) := by
    intro A
    have hA_nonempty :
        ((((A.1 : Subtype (MeasurableSet : Set Ω → Prop)) : Set Ω)) : Set Ω).Nonempty := by
      by_contra hA_nonempty
      apply part.ne_bot A.2
      ext ω
      simp [Set.not_nonempty_iff_eq_empty.mp hA_nonempty]
    exact hA_nonempty
  choose rep hrep using hreps
  let Φ : part.parts → (MeasurableFinpartition.ofSimpleFunc g).parts := fun A ↦
    ⟨⟨g ⁻¹' ({g (rep A)} : Set α), g.measurableSet_fiber (g (rep A))⟩,
      fiber_mem_parts_of_ofSimpleFunc g (g.mem_range_self (rep A))⟩
  refine ⟨Φ, funext ?_⟩
  intro ω
  -- Proof comment: the selected atom contains `ω`, so monochromaticity identifies `g ω` with the
  -- representative value used to define `Φ`.
  apply (mem_atom_iff_toSimpleFunc_eq (MeasurableFinpartition.ofSimpleFunc g)).mp
  change g ω = g (rep (part.toSimpleFunc ω))
  exact hmono (mem_toSimpleFunc_atom part ω) (hrep (part.toSimpleFunc ω))

/-- Helper for Example 20.36: equality of atoms in an `ofSimpleFunc` partition forces equality of
the underlying simple-function values. -/
private theorem eq_of_toSimpleFunc_eq_of_ofSimpleFunc
    {Ω : Type*} [MeasurableSpace Ω] {α : Type*} (g : SimpleFunc Ω α) {ω ω' : Ω}
    (h :
      (MeasurableFinpartition.ofSimpleFunc g).toSimpleFunc ω =
        (MeasurableFinpartition.ofSimpleFunc g).toSimpleFunc ω') :
    g ω = g ω' := by
  let B : (MeasurableFinpartition.ofSimpleFunc g).parts :=
    (MeasurableFinpartition.ofSimpleFunc g).toSimpleFunc ω
  have hω : ω ∈ (((B.1 : Subtype (MeasurableSet : Set Ω → Prop)) : Set Ω)) := by
    simpa [B] using mem_toSimpleFunc_atom (MeasurableFinpartition.ofSimpleFunc g) ω
  have hω' : ω' ∈ (((B.1 : Subtype (MeasurableSet : Set Ω → Prop)) : Set Ω)) := by
    simpa [B] using h ▸ mem_toSimpleFunc_atom (MeasurableFinpartition.ofSimpleFunc g) ω'
  rcases exists_fiber_eq_of_ofSimpleFunc_part g B with ⟨a, -, hBa⟩
  have hωa : ω ∈ g ⁻¹' ({a} : Set α) := by
    simpa [hBa] using hω
  have hω'a : ω' ∈ g ⁻¹' ({a} : Set α) := by
    simpa [hBa] using hω'
  have hga : g ω = a := by
    simpa using hωa
  have hg'a : g ω' = a := by
    simpa using hω'a
  exact hga.trans hg'a.symm

/-- Helper for Example 20.36: equal simple-function values give equal atoms in the partition built
from that simple function. -/
private theorem toSimpleFunc_eq_of_eq_of_ofSimpleFunc
    {Ω : Type*} [MeasurableSpace Ω] {α : Type*} (g : SimpleFunc Ω α) {ω ω' : Ω}
    (h : g ω = g ω') :
    (MeasurableFinpartition.ofSimpleFunc g).toSimpleFunc ω =
      (MeasurableFinpartition.ofSimpleFunc g).toSimpleFunc ω' := by
  let A : (MeasurableFinpartition.ofSimpleFunc g).parts := by
    refine ⟨⟨g ⁻¹' ({g ω} : Set α), g.measurableSet_fiber (g ω)⟩, ?_⟩
    exact fiber_mem_parts_of_ofSimpleFunc g (g.mem_range_self ω)
  -- Proof comment: both points land in the same singleton fiber of `g`, so the canonical atom
  -- code of `MeasurableFinpartition.ofSimpleFunc g` selects the same atom.
  refine toSimpleFunc_eq_of_mem_atom (part := MeasurableFinpartition.ofSimpleFunc g) (A := A) ?_ ?_
  · simpa [A]
  · simpa [A, h] using (show ω' ∈ g ⁻¹' ({g ω'} : Set α) by simp)

/-- Helper for Example 20.36: points in the same atom of a block partition have identical
transparent prefix codes. -/
private theorem sameBlockAtom_samePrefixCoordinates {Ω : Type*} [MeasurableSpace Ω]
    {τ : Ω → Ω} (hτ : Measurable τ) (part : MeasurableFinpartition Ω) (n : ℕ+)
    {ω ω' : Ω}
    (h :
      (part.block τ hτ n).toSimpleFunc ω =
        (part.block τ hτ n).toSimpleFunc ω') :
    prefixBlockCode τ hτ part n ω = prefixBlockCode τ hτ part n ω' := by
  have h' :
      (MeasurableFinpartition.ofSimpleFunc (prefixBlockCode τ hτ part n)).toSimpleFunc ω =
        (MeasurableFinpartition.ofSimpleFunc (prefixBlockCode τ hτ part n)).toSimpleFunc ω' := by
    -- Proof comment: first rewrite the owner block partition to the transparent `ofSimpleFunc`
    -- presentation.
    simpa [block_eq_ofSimpleFunc_prefixBlockCode hτ part n] using h
  -- Proof comment: equality of `ofSimpleFunc` atoms is exactly equality of the underlying code.
  exact eq_of_toSimpleFunc_eq_of_ofSimpleFunc (prefixBlockCode τ hτ part n) h'

/-- Helper for Example 20.36: if a code factors through the `N`-block partition of `part`, then
its length-`n` block partition factors through the long block partition of length `N + n - 1`. -/
private theorem blockFactor_of_block
    {Ω : Type*} [MeasurableSpace Ω] {τ : Ω → Ω} (hτ : Measurable τ)
    (part : MeasurableFinpartition Ω) {α : Type*} (g : SimpleFunc Ω α)
    {N : ℕ+} {ψ : (part.block τ hτ N).parts → α}
    (hg : g = fun ω ↦ ψ ((part.block τ hτ N).toSimpleFunc ω)) (n : ℕ+) :
    ∃ Φ : (part.block τ hτ (N + n - 1)).parts →
        ((MeasurableFinpartition.ofSimpleFunc g).block τ hτ n).parts,
      (((MeasurableFinpartition.ofSimpleFunc g).block τ hτ n).toSimpleFunc :
          Ω → ((MeasurableFinpartition.ofSimpleFunc g).block τ hτ n).parts) =
        fun ω ↦ Φ ((part.block τ hτ (N + n - 1)).toSimpleFunc ω) := by
  have hmono :
      ∀ {A : (part.block τ hτ (N + n - 1)).parts} {ω ω' : Ω},
        ω ∈ (((A.1 : Subtype (MeasurableSet : Set Ω → Prop)) : Set Ω)) →
        ω' ∈ (((A.1 : Subtype (MeasurableSet : Set Ω → Prop)) : Set Ω)) →
        prefixBlockCode τ hτ (MeasurableFinpartition.ofSimpleFunc g) n ω =
          prefixBlockCode τ hτ (MeasurableFinpartition.ofSimpleFunc g) n ω' := by
    intro A ω ω' hω hω'
    have hsameLong :
        (part.block τ hτ (N + n - 1)).toSimpleFunc ω =
          (part.block τ hτ (N + n - 1)).toSimpleFunc ω' :=
      toSimpleFunc_eq_of_mem_atom (part.block τ hτ (N + n - 1)) hω hω'
    have hprefixLong :
        prefixBlockCode τ hτ part (N + n - 1) ω =
          prefixBlockCode τ hτ part (N + n - 1) ω' :=
      sameBlockAtom_samePrefixCoordinates hτ part (N + n - 1) hsameLong
    funext i
    have hNBlock :
        (part.block τ hτ N).toSimpleFunc ((τ^[i]) ω) =
          (part.block τ hτ N).toSimpleFunc ((τ^[i]) ω') := by
      have hcode :
          prefixBlockCode τ hτ part N ((τ^[i]) ω) =
            prefixBlockCode τ hτ part N ((τ^[i]) ω') := by
        funext j
        have hi_lt : (i : ℕ) < (n : ℕ) := i.2
        have hj_lt : (j : ℕ) < (N : ℕ) := j.2
        have hij_lt : (j : ℕ) + (i : ℕ) < ((N + n - 1 : ℕ+) : ℕ) := by
          pnat_to_nat
          omega
        have hcoord := congrFun hprefixLong
          (⟨(j : ℕ) + (i : ℕ), hij_lt⟩ : Fin (((N + n - 1 : ℕ+) : ℕ)))
        -- Proof comment: the long block already contains the length-`N` window beginning at the
        -- shift `i`, so equality of long prefix codes gives equality of shifted `N`-blocks.
        simpa [prefixBlockCode, Function.iterate_add_apply] using hcoord
      have hcode' :
          (MeasurableFinpartition.ofSimpleFunc (prefixBlockCode τ hτ part N)).toSimpleFunc
              ((τ^[i]) ω) =
            (MeasurableFinpartition.ofSimpleFunc (prefixBlockCode τ hτ part N)).toSimpleFunc
              ((τ^[i]) ω') :=
        toSimpleFunc_eq_of_eq_of_ofSimpleFunc (prefixBlockCode τ hτ part N) hcode
      simpa [block_eq_ofSimpleFunc_prefixBlockCode hτ part N] using hcode'
    have hgω :
        g ((τ^[i]) ω) = ψ ((part.block τ hτ N).toSimpleFunc ((τ^[i]) ω)) := by
      simpa using congrArg (fun f : Ω → α ↦ f ((τ^[i]) ω)) hg
    have hgω' :
        g ((τ^[i]) ω') = ψ ((part.block τ hτ N).toSimpleFunc ((τ^[i]) ω')) := by
      simpa using congrArg (fun f : Ω → α ↦ f ((τ^[i]) ω')) hg
    have hgshift :
        g ((τ^[i]) ω) = g ((τ^[i]) ω') := by
      calc
        g ((τ^[i]) ω) = ψ ((part.block τ hτ N).toSimpleFunc ((τ^[i]) ω)) := hgω
        _ = ψ ((part.block τ hτ N).toSimpleFunc ((τ^[i]) ω')) := by
          exact congrArg ψ hNBlock
        _ = g ((τ^[i]) ω') := hgω'.symm
    -- Proof comment: once the shifted `g`-values agree, the corresponding `ofSimpleFunc` atom
    -- codes agree at coordinate `i`.
    exact toSimpleFunc_eq_of_eq_of_ofSimpleFunc g hgshift
  -- Proof comment: after proving monochromaticity on each long `part`-block atom, the canonical
  -- factorization through the long block partition follows from the generic monochromaticity API.
  simpa [block_eq_ofSimpleFunc_prefixBlockCode hτ (MeasurableFinpartition.ofSimpleFunc g) n] using
    (ofSimpleFunc_factorsThroughPartitionOfMonochromatic
      (part.block τ hτ (N + n - 1))
      (prefixBlockCode τ hτ (MeasurableFinpartition.ofSimpleFunc g) n) hmono)

/-- Helper for Example 20.36: an injective relabeling of a finite pmf preserves Shannon entropy.
-/
private theorem entropy_map_eq_of_injective {α : Type*} {β : Type*} [Finite α] [Finite β]
    (p : PMF α) (f : α → β) (hf : Function.Injective f) :
    entropy (PMF.map f p) = entropy p := by
  classical
  letI : Fintype α := Fintype.ofFinite α
  letI : Fintype β := Fintype.ofFinite β
  let φ : β → ℝ := fun b ↦ ((PMF.map f p) b).toReal * Real.log (((PMF.map f p) b).toReal)
  have hmap : ∀ a : α, PMF.map f p (f a) = p a := by
    intro a
    -- Proof comment: injectivity collapses the pushed-forward mass at `f a` to the single source
    -- atom `a`.
    rw [PMF.map_apply]
    refine (tsum_eq_single a ?_).trans ?_
    · intro a' ha'
      have hneq : f a ≠ f a' := fun h ↦ ha' ((hf h).symm)
      simp [hneq]
    · simp
  have hzero : ∀ b : β, b ∉ Set.range f → PMF.map f p b = 0 := by
    intro b hb
    -- Proof comment: target points outside the image receive no mass.
    rw [PMF.map_apply, ENNReal.tsum_eq_zero]
    intro a
    by_cases hba : b = f a
    · exact (hb ⟨a, hba.symm⟩).elim
    · simp [hba]
  have himage :
      Finset.univ.filter (fun b : β ↦ b ∈ Set.range f) = (Finset.univ.image f) := by
    -- Proof comment: on a finite target alphabet, filtering by the range gives the image set.
    ext b
    simp
  have hfilter_sum :
      Finset.univ.sum φ = (Finset.univ.filter (fun b : β ↦ b ∈ Set.range f)).sum φ := by
    -- Proof comment: points outside the image contribute zero to the entropy sum.
    have hsubset :
        Finset.univ.filter (fun b : β ↦ b ∈ Set.range f) ⊆ Finset.univ := by
      intro b hb
      simp
    have hvanish :
        ∀ b ∈ Finset.univ, b ∉ Finset.univ.filter (fun b : β ↦ b ∈ Set.range f) → φ b = 0 := by
      intro b hb hnot
      simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hnot
      have hb0 : PMF.map f p b = 0 := hzero b hnot
      dsimp [φ]
      rw [hb0]
      norm_num
    simpa using (Finset.sum_subset hsubset hvanish).symm
  have hreindex :
      (Finset.univ.image f).sum φ = Finset.univ.sum (fun a : α ↦ φ (f a)) := by
    -- Proof comment: reindex the entropy sum along the injective relabeling.
    simpa using (Finset.sum_image (s := Finset.univ) (f := φ) hf.injOn)
  have hpointwise :
      Finset.univ.sum (fun a : α ↦ φ (f a)) =
        Finset.univ.sum (fun a : α ↦ (p a).toReal * Real.log ((p a).toReal)) := by
    -- Proof comment: on image points, the relabeled pmf agrees with the original pmf.
    apply Finset.sum_congr rfl
    intro a ha
    dsimp [φ]
    rw [hmap a]
  rw [entropy_eq_sum, entropy_eq_sum]
  calc
    ((-(Finset.univ.sum φ) : ℝ) : EReal) =
        ((-((Finset.univ.filter (fun b : β ↦ b ∈ Set.range f)).sum φ) : ℝ) : EReal) := by
      simpa using congrArg (fun t : ℝ ↦ ((-t : ℝ) : EReal)) hfilter_sum
    _ = ((-((Finset.univ.image f).sum φ) : ℝ) : EReal) := by
      rw [himage]
    _ = ((-(Finset.univ.sum fun a : α ↦ φ (f a)) : ℝ) : EReal) := by
      simpa using congrArg (fun t : ℝ ↦ ((-t : ℝ) : EReal)) hreindex
    _ = ((-(Finset.univ.sum fun a : α ↦ (p a).toReal * Real.log ((p a).toReal)) : ℝ) : EReal) := by
      simpa using congrArg (fun t : ℝ ↦ ((-t : ℝ) : EReal)) hpointwise

/-- Helper for Example 20.36: the real masses of a finite pmf sum to `1`. -/
private theorem pmfToReal_sum_eq_one {α : Type*} [Fintype α] (p : PMF α) :
    ∑ a : α, (p a).toReal = 1 := by
  calc
    ∑ a : α, (p a).toReal = (∑ a : α, p a).toReal := by
      -- Proof comment: convert the finite sum of real masses back to the corresponding
      -- finite sum in `ℝ≥0∞`.
      symm
      exact ENNReal.toReal_sum (fun a _ ↦ p.apply_ne_top a)
    _ = 1 := by
      have hp : ∑ a : α, p a = 1 := by
        simpa [tsum_fintype] using p.tsum_coe
      rw [hp]
      simp

/-- Helper for Example 20.36: pushing a probability measure forward along a composition gives the
pmf pushforward of the intermediate law. -/
private theorem toPMF_eq_map_of_comp {Ω : Type*} [MeasurableSpace Ω]
    (P : Measure Ω) [IsProbabilityMeasure P] {α β : Type*}
    [MeasurableSpace α] [MeasurableSingletonClass α] [Countable α]
    [MeasurableSpace β] [MeasurableSingletonClass β] [Countable β]
    (f : Ω → α) (hf : Measurable f) (g : α → β) (hg : Measurable g)
    [IsProbabilityMeasure (Measure.map f P)]
    [IsProbabilityMeasure (Measure.map (fun ω ↦ g (f ω)) P)] :
    (Measure.map (fun ω ↦ g (f ω)) P).toPMF = PMF.map g ((Measure.map f P).toPMF) := by
  -- Proof comment: compare both pmfs by converting them back to the corresponding pushforward
  -- probability measures.
  apply PMF.toMeasure_injective
  rw [Measure.toPMF_toMeasure, ← PMF.toMeasure_map]
  · rw [Measure.toPMF_toMeasure, Measure.map_map hg hf]
    rfl
  · exact hg

/-- Helper for Example 20.36: the partition entropy of `MeasurableFinpartition.ofSimpleFunc g`
is exactly the Shannon entropy of the law of `g`. -/
private theorem partitionEntropy_ofSimpleFunc_eq_entropy_law {Ω : Type*} [MeasurableSpace Ω]
    (P : Measure Ω) [IsProbabilityMeasure P] {α : Type*}
    [MeasurableSpace α] [MeasurableSingletonClass α] [Countable α] [Finite α]
    (g : SimpleFunc Ω α) [IsProbabilityMeasure (Measure.map g P)] :
    (MeasurableFinpartition.ofSimpleFunc g).partitionEntropy P =
      entropy ((Measure.map g P).toPMF) := by
  let q : MeasurableFinpartition Ω := MeasurableFinpartition.ofSimpleFunc g
  let Φ : q.parts → α := ofSimpleFuncFiberValue g
  letI : IsProbabilityMeasure (Measure.map q.toSimpleFunc P) :=
    Measure.isProbabilityMeasure_map q.toSimpleFunc.aemeasurable
  have hfactor :
      g = fun ω ↦ Φ (q.toSimpleFunc ω) := by
    -- Proof comment: first code each point by its partition atom, then relabel that atom by the
    -- remembered `g`-value.
    simpa [q, Φ] using simpleFunc_eq_ofSimpleFuncFiberValue_comp_toSimpleFunc g
  letI : IsProbabilityMeasure (Measure.map (fun ω ↦ Φ (q.toSimpleFunc ω)) P) := by
    simpa [hfactor] using (show IsProbabilityMeasure (Measure.map g P) from inferInstance)
  have hmap :
      (Measure.map g P).toPMF = PMF.map Φ (q.toPMF P) := by
    -- Proof comment: compare the law of `g` with the pushforward of the canonical atom code.
    simpa [MeasurableFinpartition.toPMF, q, Φ, hfactor] using
      (toPMF_eq_map_of_comp (P := P) (f := q.toSimpleFunc) (hf := q.toSimpleFunc.measurable)
        (g := Φ) (hg := Measurable.of_discrete (f := Φ)))
  rw [MeasurableFinpartition.partitionEntropy_def]
  calc
    entropy (q.toPMF P) = entropy (PMF.map Φ (q.toPMF P)) := by
      symm
      exact entropy_map_eq_of_injective (q.toPMF P) Φ (ofSimpleFuncFiberValue_injective g)
    _ = entropy ((Measure.map g P).toPMF) := by
      rw [← hmap]

/-- Helper for Example 20.36: the block entropy of a partition coming from a finite-valued simple
function is the Shannon entropy of the corresponding block-value law. -/
private theorem blockPartitionEntropy_ofSimpleFunc_eq_entropy_valueBlockLaw
    {Ω : Type*} [MeasurableSpace Ω] (μ : Measure Ω) [IsProbabilityMeasure μ]
    {τ : Ω → Ω} (hτ : Measurable τ) {α : Type*}
    [Finite α] [MeasurableSpace α] [MeasurableSingletonClass α] [Countable α]
    (g : SimpleFunc Ω α) (n : ℕ+)
    [IsProbabilityMeasure (Measure.map (fun ω : Ω ↦ fun i : Fin n ↦ g ((τ^[i]) ω)) μ)] :
    ((MeasurableFinpartition.ofSimpleFunc g).block τ hτ n).partitionEntropy μ =
      entropy ((Measure.map (fun ω : Ω ↦ fun i : Fin n ↦ g ((τ^[i]) ω)) μ).toPMF) := by
  classical
  let part : MeasurableFinpartition Ω := MeasurableFinpartition.ofSimpleFunc g
  let Λ : (Fin n → part.parts) → (Fin n → α) := fun s i ↦ ofSimpleFuncFiberValue g (s i)
  have hΛinj : Function.Injective Λ := by
    intro s t hst
    funext i
    exact ofSimpleFuncFiberValue_injective g (by simpa using congrFun hst i)
  have hfactor :
      (fun ω : Ω ↦ Λ (prefixBlockCode τ hτ part n ω)) =
        fun ω : Ω ↦ fun i : Fin n ↦ g ((τ^[i]) ω) := by
    -- Proof comment: the remembered-value relabeling recovers the underlying `g`-values from each
    -- transparent block atom.
    funext ω
    funext i
    have hcode :=
      congrArg (fun f : Ω → α ↦ f ((τ^[i]) ω))
        (simpleFunc_eq_ofSimpleFuncFiberValue_comp_toSimpleFunc g)
    simpa [part, prefixBlockCode] using hcode.symm
  letI : IsProbabilityMeasure (Measure.map (prefixBlockCode τ hτ part n) μ) :=
    Measure.isProbabilityMeasure_map (prefixBlockCode τ hτ part n).aemeasurable
  letI :
      IsProbabilityMeasure
        (Measure.map (fun ω : Ω ↦ Λ (prefixBlockCode τ hτ part n ω)) μ) := by
    simpa [hfactor] using
      (show IsProbabilityMeasure
          (Measure.map (fun ω : Ω ↦ fun i : Fin n ↦ g ((τ^[i]) ω)) μ) from inferInstance)
  have hmapLaw :
      (Measure.map (fun ω : Ω ↦ fun i : Fin n ↦ g ((τ^[i]) ω)) μ).toPMF =
        PMF.map Λ ((Measure.map (prefixBlockCode τ hτ part n) μ).toPMF) := by
    -- Proof comment: the block-value law is the pushforward of the transparent block code law
    -- along the remembered-value relabeling.
    simpa [hfactor] using
      (toPMF_eq_map_of_comp (P := μ)
        (f := prefixBlockCode τ hτ part n)
        (hf := (prefixBlockCode τ hτ part n).measurable)
        (g := Λ) (hg := Measurable.of_discrete (f := Λ)))
  calc
    ((MeasurableFinpartition.ofSimpleFunc g).block τ hτ n).partitionEntropy μ =
        entropy ((Measure.map (prefixBlockCode τ hτ part n) μ).toPMF) := by
      -- Proof comment: rewrite the owner block partition through the transparent block code.
      rw [block_eq_ofSimpleFunc_prefixBlockCode (hτ := hτ) (part := part) (n := n)]
      simpa using
        (partitionEntropy_ofSimpleFunc_eq_entropy_law
          (P := μ) (g := prefixBlockCode τ hτ part n))
    _ = entropy (PMF.map Λ ((Measure.map (prefixBlockCode τ hτ part n) μ).toPMF)) := by
      -- Proof comment: the remembered-value relabeling on block words is injective.
      symm
      exact entropy_map_eq_of_injective
        ((Measure.map (prefixBlockCode τ hτ part n) μ).toPMF) Λ hΛinj
    _ = entropy ((Measure.map (fun ω : Ω ↦ fun i : Fin n ↦ g ((τ^[i]) ω)) μ).toPMF) := by
      rw [← hmapLaw]

/-- Helper for Example 20.36: the prefix-code approximation family generated by all finite block
codes already generates the ambient measurable space under the generator hypothesis. -/
private theorem generateFrom_prefixBlockPreimageFamily_eq {Ω : Type*} [MeasurableSpace Ω]
    {τ : Ω → Ω} (hτ : Measurable τ) (part : MeasurableFinpartition Ω)
    (hgen : is_generator τ part) :
    MeasurableSpace.generateFrom (prefixBlockPreimageFamily hτ part) = ‹MeasurableSpace Ω› := by
  refine le_antisymm (MeasurableSpace.generateFrom_le ?_) ?_
  · intro s hs
    exact measurableSet_of_mem_prefixBlockPreimageFamily hτ part hs
  · let 𝒢 : Set (Set Ω) :=
      ⋃ n : ℕ,
        Set.range fun A : part.parts ↦
          (τ^[n]) ⁻¹' ((A.1 : Subtype (MeasurableSet : Set Ω → Prop)) : Set Ω)
    have hsubset : 𝒢 ⊆ prefixBlockPreimageFamily hτ part := by
      intro s hs
      rw [Set.mem_iUnion] at hs
      rcases hs with ⟨k, hs⟩
      rcases hs with ⟨A, rfl⟩
      exact iterateAtom_mem_prefixBlockPreimageFamily hτ part k A
    calc
      ‹MeasurableSpace Ω› = MeasurableSpace.generateFrom 𝒢 := by
        simpa [is_generator] using hgen.symm
      _ ≤ MeasurableSpace.generateFrom (prefixBlockPreimageFamily hτ part) :=
        MeasurableSpace.generateFrom_mono hsubset

/-- Helper for Example 20.36: every measurable set can be approximated in measure by a union of
atoms of one sufficiently long block partition of a generating partition. -/
private theorem exists_unionBlockAtoms_symmDiff_lt_of_generator
    {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
    {τ : Ω → Ω} (hτ : Measurable τ) (part : MeasurableFinpartition Ω)
    (hgen : is_generator τ part) {s : Set Ω} (hs : MeasurableSet s) {ε : ℝ} (hε : 0 < ε) :
    ∃ approx : BlockApproximationData hτ part,
      BlockApproximationGood P hτ part s ε approx := by
  classical
  let 𝒜 : Set (Set Ω) := prefixBlockPreimageFamily hτ part
  have h𝒜 : IsSetAlgebra 𝒜 := isSetAlgebra_prefixBlockPreimageFamily hτ part
  have hgen𝒜 :
      MeasurableSpace.generateFrom 𝒜 = ‹MeasurableSpace Ω› :=
    generateFrom_prefixBlockPreimageFamily_eq hτ part hgen
  let hdense : P.MeasureDense 𝒜 :=
    Measure.MeasureDense.of_generateFrom_isSetAlgebra_finite (μ := P) (𝒜 := 𝒜) h𝒜 hgen𝒜.symm
  rcases hdense.fin_meas_approx hs (measure_ne_top P s) ε hε with ⟨t, ht, -, hclose⟩
  rcases ht with ⟨⟨N, S⟩, rfl⟩
  let U : Finset (part.block τ hτ N).parts :=
    (part.block τ hτ N).parts.attach.filter
      (fun A ↦ ofSimpleFuncFiberValue (prefixBlockCode τ hτ part N) A ∈ S)
  have hpreimage :
      (prefixBlockCode τ hτ part N) ⁻¹' S = blockPartsUnion (part.block τ hτ N) U := by
    -- Proof comment: rewrite the approximating prefix-code event as the corresponding finite
    -- union of nonempty block atoms.
    simpa [U, block_eq_ofSimpleFunc_prefixBlockCode hτ part N] using
      preimage_eq_biUnion_parts_filter_of_ofSimpleFuncFiberValue
        (g := prefixBlockCode τ hτ part N) (S := S)
  refine ⟨⟨N, U, blockPartsUnion (part.block τ hτ N) U⟩, ?_⟩
  constructor
  · rfl
  · -- Proof comment: the `MeasureDense` approximation is exactly the claimed small symmetric
    -- difference after rewriting the chosen prefix-code preimage.
    simpa [hpreimage] using hclose

/-- Helper for Example 20.36: a union of `N`-block atoms can be rewritten as a union of atoms of
any longer `M`-block partition. -/
private theorem exists_liftBlockPartsUnion_eq
    {Ω : Type*} [MeasurableSpace Ω] {τ : Ω → Ω} (hτ : Measurable τ)
    (part : MeasurableFinpartition Ω) {N M : ℕ+} (hNM : N ≤ M)
    (U : Finset (part.block τ hτ N).parts) :
    ∃ V : Finset (part.block τ hτ M).parts,
      blockPartsUnion (part.block τ hτ N) U =
        blockPartsUnion (part.block τ hτ M) V := by
  classical
  let shortValues : Finset (Fin N → part.parts) :=
    U.image (ofSimpleFuncFiberValue (prefixBlockCode τ hτ part N))
  let longValueSet : Set (Fin M → part.parts) :=
    {w | prefixRestriction hNM w ∈ (↑shortValues : Set (Fin N → part.parts))}
  let V : Finset (part.block τ hτ M).parts :=
    (part.block τ hτ M).parts.attach.filter
      (fun A ↦ ofSimpleFuncFiberValue (prefixBlockCode τ hτ part M) A ∈ longValueSet)
  refine ⟨V, ?_⟩
  calc
    blockPartsUnion (part.block τ hτ N) U =
        (prefixBlockCode τ hτ part N) ⁻¹' (↑shortValues : Set (Fin N → part.parts)) := by
      -- Proof comment: rewrite the short selected atoms as the preimage of their remembered
      -- short words.
      simpa [shortValues, block_eq_ofSimpleFunc_prefixBlockCode hτ part N] using
        (blockPartsUnion_eq_preimage_image_of_ofSimpleFuncFiberValue
          (g := prefixBlockCode τ hτ part N) U)
    _ = (prefixBlockCode τ hτ part M) ⁻¹' longValueSet := by
      -- Proof comment: lifting to length `M` only asks that the longer block word has one of the
      -- chosen short prefixes.
      ext ω
      simp [longValueSet,
        prefixBlockCode_eq_prefixRestriction (hτ := hτ) (part := part) (hNM := hNM)]
    _ = blockPartsUnion (part.block τ hτ M) V := by
      -- Proof comment: convert the lifted long-word event back to the corresponding finite union
      -- of `M`-block atoms.
      simpa [V, block_eq_ofSimpleFunc_prefixBlockCode hτ part M, longValueSet] using
        (preimage_eq_biUnion_parts_filter_of_ofSimpleFuncFiberValue
          (g := prefixBlockCode τ hτ part M) (S := longValueSet))

/-- Helper for Example 20.36: the atomwise generator approximations can be promoted to one common
long block length while preserving a small total symmetric-difference budget. -/
private theorem existsCommonLengthBlockAtomApproximationFamily
    {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
    {τ : Ω → Ω} (hτ : Measurable τ) (part : MeasurableFinpartition Ω)
    (hgen : is_generator τ part) (q : MeasurableFinpartition Ω) {δ : ℝ} (hδ : 0 < δ) :
    ∃ N : ℕ+, ∃ U : q.parts → Finset (part.block τ hτ N).parts,
      (∑ A : q.parts,
          P ((((A.1 : Subtype (MeasurableSet : Set Ω → Prop)) : Set Ω) \
                blockPartsUnion (part.block τ hτ N) (U A)) ∪
              (blockPartsUnion (part.block τ hτ N) (U A) \
                (((A.1 : Subtype (MeasurableSet : Set Ω → Prop)) : Set Ω))))) <
        ENNReal.ofReal δ := by
  classical
  let δshare : ℝ := δ / (Fintype.card q.parts + 1)
  have hδshare : 0 < δshare := by
    dsimp [δshare]
    positivity
  have happrox :
      ∀ A : q.parts,
        ∃ N : ℕ+, ∃ V : Finset (part.block τ hτ N).parts,
          P ((((A.1 : Subtype (MeasurableSet : Set Ω → Prop)) : Set Ω) \
                blockPartsUnion (part.block τ hτ N) V) ∪
              (blockPartsUnion (part.block τ hτ N) V \
                (((A.1 : Subtype (MeasurableSet : Set Ω → Prop)) : Set Ω)))) <
            ENNReal.ofReal δshare := by
    intro A
    -- Proof comment: approximate each competitor atom separately by one finite union of block
    -- atoms of the generator.
    rcases exists_unionBlockAtoms_symmDiff_lt_of_generator
        (P := P) (hτ := hτ) (part := part) hgen
        (s := ((A.1 : Subtype _) : Set Ω)) A.1.2 hδshare with
      ⟨approx, hgood⟩
    exact ⟨approx.length, approx.atoms, by
      simpa [hgood.1] using hgood.2⟩
  choose N₀ U₀ hU₀ using happrox
  let Nmax : ℕ := Finset.sup Finset.univ fun A : q.parts ↦ ((N₀ A : ℕ+) : ℕ)
  let N : ℕ+ := ⟨max Nmax 1, by positivity⟩
  have hN₀ : ∀ A : q.parts, N₀ A ≤ N := by
    intro A
    refine (PNat.coe_le_coe _ _).2 ?_
    show ((N₀ A : ℕ+) : ℕ) ≤ ((N : ℕ+) : ℕ)
    simpa [N] using
      le_trans
        (Finset.le_sup (s := Finset.univ)
          (f := fun B : q.parts ↦ ((N₀ B : ℕ+) : ℕ)) (by simp))
        (Nat.le_max_left Nmax 1)
  have hlift :
      ∀ A : q.parts,
        ∃ V : Finset (part.block τ hτ N).parts,
          blockPartsUnion (part.block τ hτ (N₀ A)) (U₀ A) =
            blockPartsUnion (part.block τ hτ N) V := by
    intro A
    exact exists_liftBlockPartsUnion_eq (hτ := hτ) (part := part) (hNM := hN₀ A) (U₀ A)
  choose U hU using hlift
  refine ⟨N, U, ?_⟩
  have hterm_le :
      ∀ A : q.parts,
        P ((((A.1 : Subtype (MeasurableSet : Set Ω → Prop)) : Set Ω) \
              blockPartsUnion (part.block τ hτ N) (U A)) ∪
            (blockPartsUnion (part.block τ hτ N) (U A) \
              (((A.1 : Subtype (MeasurableSet : Set Ω → Prop)) : Set Ω)))) ≤
          ENNReal.ofReal δshare := by
    intro A
    exact (by simpa [hU A] using (hU₀ A).le)
  calc
    ∑ A : q.parts,
        P ((((A.1 : Subtype (MeasurableSet : Set Ω → Prop)) : Set Ω) \
              blockPartsUnion (part.block τ hτ N) (U A)) ∪
            (blockPartsUnion (part.block τ hτ N) (U A) \
              (((A.1 : Subtype (MeasurableSet : Set Ω → Prop)) : Set Ω)))) ≤
        ∑ _A : q.parts, ENNReal.ofReal δshare := by
      exact Finset.sum_le_sum fun A _ ↦ hterm_le A
    _ = ENNReal.ofReal ((Fintype.card q.parts) • δshare) := by
      rw [ENNReal.ofReal_nsmul]
      simp
    _ < ENNReal.ofReal δ := by
      rw [ENNReal.ofReal_lt_ofReal_iff hδ]
      rw [nsmul_eq_mul]
      have hcard_lt : ((Fintype.card q.parts : ℕ) : ℝ) < Fintype.card q.parts + 1 := by
        exact_mod_cast Nat.lt_succ_self (Fintype.card q.parts)
      have hdiv_lt_one :
          ((Fintype.card q.parts : ℕ) : ℝ) / (Fintype.card q.parts + 1) < (1 : ℝ) := by
        exact (div_lt_one (by positivity)).2 hcard_lt
      have hmul_lt := mul_lt_mul_of_pos_right hdiv_lt_one hδ
      simpa [δshare, div_eq_mul_inv, mul_comm, mul_left_comm, mul_assoc] using hmul_lt

/-- Helper for Example 20.36: if the sum of the atomwise bad-set measures is small, then the
whole bad union is small as well. -/
private theorem measure_badApproxSet_lt_of_sum_lt
    {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
    {ι : Type*} [Fintype ι] (bad : ι → Set Ω) {ε : ℝ}
    (hbad : (∑ i, P (bad i)) < ENNReal.ofReal ε) :
    P (⋃ i, bad i) < ENNReal.ofReal ε := by
  -- Proof comment: finite subadditivity upgrades the atomwise measure sum to the whole bad
  -- region.
  exact lt_of_le_of_lt (measure_iUnion_fintype_le P bad) hbad

/-- Helper for Example 20.36: from a common-length family of block-atom approximants, build a
total label on long block atoms that agrees with `q.toSimpleFunc` outside the bad union. -/
private theorem exists_blockLabel_of_commonLengthApproximationFamily
    {Ω : Type*} [MeasurableSpace Ω] {τ : Ω → Ω} (hτ : Measurable τ)
    (part q : MeasurableFinpartition Ω) (N : ℕ+)
    (U : q.parts → Finset (part.block τ hτ N).parts) :
    ∃ ψ : (part.block τ hτ N).parts → q.parts,
      ∀ ⦃ω : Ω⦄,
        ω ∉
            ⋃ A : q.parts,
              ((((A.1 : Subtype (MeasurableSet : Set Ω → Prop)) : Set Ω) \
                    blockPartsUnion (part.block τ hτ N) (U A)) ∪
                (blockPartsUnion (part.block τ hτ N) (U A) \
                  (((A.1 : Subtype (MeasurableSet : Set Ω → Prop)) : Set Ω)))) →
        ψ ((part.block τ hτ N).toSimpleFunc ω) = q.toSimpleFunc ω := by
  classical
  let block := part.block τ hτ N
  let claimants : block.parts → Finset q.parts := fun B ↦
    Finset.univ.filter fun A : q.parts => B ∈ U A
  have hreps :
      ∀ B : block.parts,
        ∃ ω : Ω, ω ∈ (((B.1 : Subtype (MeasurableSet : Set Ω → Prop)) : Set Ω)) := by
    intro B
    have hB_nonempty :
        ((((B.1 : Subtype (MeasurableSet : Set Ω → Prop)) : Set Ω)) : Set Ω).Nonempty := by
      by_contra hB_nonempty
      apply block.ne_bot B.2
      ext ω
      simp [Set.not_nonempty_iff_eq_empty.mp hB_nonempty]
    exact hB_nonempty
  choose rep hrep using hreps
  let ψ : block.parts → q.parts := fun B ↦
    if hB : (claimants B).Nonempty then hB.choose else q.toSimpleFunc (rep B)
  refine ⟨ψ, ?_⟩
  intro ω hgood
  let A : q.parts := q.toSimpleFunc ω
  let B : block.parts := block.toSimpleFunc ω
  have hωA :
      ω ∈ (((A.1 : Subtype (MeasurableSet : Set Ω → Prop)) : Set Ω)) := by
    simpa [A] using mem_toSimpleFunc_atom q ω
  have hωB :
      ω ∈ (((B.1 : Subtype (MeasurableSet : Set Ω → Prop)) : Set Ω)) := by
    simpa [B] using mem_toSimpleFunc_atom block ω
  have hnot_badA :
      ω ∉
        ((((A.1 : Subtype (MeasurableSet : Set Ω → Prop)) : Set Ω) \
              blockPartsUnion block (U A)) ∪
          (blockPartsUnion block (U A) \
            (((A.1 : Subtype (MeasurableSet : Set Ω → Prop)) : Set Ω)))) := by
    intro hbadA
    exact hgood <| Set.mem_iUnion.2 ⟨A, hbadA⟩
  have hω_unionA : ω ∈ blockPartsUnion block (U A) := by
    by_contra hω_unionA
    exact hnot_badA (by
      left
      exact ⟨hωA, hω_unionA⟩)
  have hB_mem : B ∈ U A := by
    rcases Set.mem_iUnion.1 hω_unionA with ⟨B', hω_unionA⟩
    rcases Set.mem_iUnion.1 hω_unionA with ⟨hB', hωB'⟩
    have hBB' : B = B' := by
      exact (mem_atom_iff_toSimpleFunc_eq block).mp hωB'
    simpa [hBB'] using hB'
  have hclaimants_nonempty : (claimants B).Nonempty := by
    refine ⟨A, ?_⟩
    simp [claimants, hB_mem]
  have hclaimants_eq :
      ∀ A' ∈ claimants B, A' = A := by
    intro A' hA'
    have hA'_mem : B ∈ U A' := (Finset.mem_filter.mp hA').2
    have hω_unionA' : ω ∈ blockPartsUnion block (U A') := by
      exact Set.mem_iUnion.2 ⟨B, Set.mem_iUnion.2 ⟨hA'_mem, hωB⟩⟩
    have hnot_badA' :
        ω ∉
          ((((A'.1 : Subtype (MeasurableSet : Set Ω → Prop)) : Set Ω) \
                blockPartsUnion block (U A')) ∪
            (blockPartsUnion block (U A') \
              (((A'.1 : Subtype (MeasurableSet : Set Ω → Prop)) : Set Ω)))) := by
      intro hbadA'
      exact hgood <| Set.mem_iUnion.2 ⟨A', hbadA'⟩
    have hωA' :
        ω ∈ (((A'.1 : Subtype (MeasurableSet : Set Ω → Prop)) : Set Ω)) := by
      by_contra hωA'
      exact hnot_badA' (by
        right
        exact ⟨hω_unionA', hωA'⟩)
    exact ((mem_atom_iff_toSimpleFunc_eq q).mp hωA').symm.trans (by rfl)
  have hψ_eq : ψ B = A := by
    dsimp [ψ]
    simp [hclaimants_nonempty]
    exact hclaimants_eq _ hclaimants_nonempty.choose_spec
  simpa [A, B] using hψ_eq

/-- Helper for Example 20.36: the generator approximation can be packaged as one long-block
factor of `part` together with a rare `Option`-valued error code that exactly decodes the
competitor code `q.toSimpleFunc`. -/
private theorem existsDecodedBlockCodeWithSmallError
    {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
    {τ : Ω → Ω} (hτ : Measurable τ) (part : MeasurableFinpartition Ω)
    (hgen : is_generator τ part) (q : MeasurableFinpartition Ω) {δ : ℝ} (hδ : 0 < δ) :
    ∃ N : ℕ+, ∃ ψ : (part.block τ hτ N).parts → q.parts,
      ∃ e : SimpleFunc Ω (Option q.parts),
        (q.toSimpleFunc = fun ω ↦
          Option.elim (e ω) (ψ ((part.block τ hτ N).toSimpleFunc ω)) id) ∧
        P {ω | e ω ≠ none} < ENNReal.ofReal δ := by
  classical
  rcases existsCommonLengthBlockAtomApproximationFamily
      (P := P) (hτ := hτ) (part := part) hgen q hδ with
    ⟨N, U, hU⟩
  rcases exists_blockLabel_of_commonLengthApproximationFamily
      (hτ := hτ) (part := part) (q := q) N U with
    ⟨ψ, hψ⟩
  let block : MeasurableFinpartition Ω := part.block τ hτ N
  let bad : Set Ω :=
    ⋃ A : q.parts,
      (((A.1 : Subtype (MeasurableSet : Set Ω → Prop)) : Set Ω) \
          blockPartsUnion block (U A)) ∪
        (blockPartsUnion block (U A) \
          (((A.1 : Subtype (MeasurableSet : Set Ω → Prop)) : Set Ω)))
  have hbad_meas : MeasurableSet bad := by
    -- Proof comment: the bad region is a finite union of measurable symmetric differences.
    refine MeasurableSet.iUnion fun A ↦ ?_
    exact (A.1.2.diff (measurableSet_blockPartsUnionCurrent block (U A))).union
      ((measurableSet_blockPartsUnionCurrent block (U A)).diff A.1.2)
  let e : SimpleFunc Ω (Option q.parts) :=
    SimpleFunc.piecewise bad hbad_meas (q.toSimpleFunc.map some) (SimpleFunc.const Ω none)
  refine ⟨N, ψ, e, ?_⟩
  constructor
  · -- Proof comment: outside the bad region the block label is correct, and inside the bad
    -- region the error code stores the exact missing atom label.
    funext ω
    by_cases hω : ω ∈ bad
    · simp [e, hω]
    · have hψω : ψ (block.toSimpleFunc ω) = q.toSimpleFunc ω := hψ hω
      simp [e, hω, block, hψω]
  · have hbad_lt : P bad < ENNReal.ofReal δ := by
      -- Proof comment: finite subadditivity turns the atomwise budget into a global bad-region
      -- bound.
      exact measure_badApproxSet_lt_of_sum_lt (P := P)
        (bad := fun A : q.parts ↦
          (((A.1 : Subtype (MeasurableSet : Set Ω → Prop)) : Set Ω) \
              blockPartsUnion block (U A)) ∪
            (blockPartsUnion block (U A) \
              (((A.1 : Subtype (MeasurableSet : Set Ω → Prop)) : Set Ω)))) hU
    have hnonNone : {ω | e ω ≠ none} = bad := by
      ext ω
      by_cases hω : ω ∈ bad <;> simp [e, hω]
    simpa [hnonNone] using hbad_lt

/-- Helper for Example 20.36: once `τ^[N] = id`, every longer block code factors through the
first `N` coordinates, because later coordinates are periodic repetitions of the first period. -/
private theorem blockFactor_of_periodicIterate
    {Ω : Type*} [MeasurableSpace Ω] {τ : Ω → Ω}
    (hτ : Measurable τ) (part : MeasurableFinpartition Ω)
    {N : ℕ+} (hIter : (τ^[N]) = id) (n : ℕ+) :
    ∃ Φ : (part.block τ hτ N).parts → (part.block τ hτ n).parts,
      ((part.block τ hτ n).toSimpleFunc : Ω → (part.block τ hτ n).parts) =
        fun ω ↦ Φ ((part.block τ hτ N).toSimpleFunc ω) := by
  have hperiodicCoord :
      ∀ (ω : Ω) (i : Fin n),
        prefixBlockCode τ hτ part n ω i =
          prefixBlockCode τ hτ part N ω ⟨(i : ℕ) % N, Nat.mod_lt _ N.pos⟩ := by
    intro ω i
    let m : ℕ := (i : ℕ) / N
    have hmul : (τ^[N * m]) = id := by
      -- Proof comment: any multiple of the period acts trivially by iterating the identity map.
      calc
        (τ^[N * m]) = (τ^[N])^[m] := by rw [Function.iterate_mul]
        _ = id^[m] := by rw [hIter]
        _ = id := by simp
    have hsplit : (i : ℕ) = (i : ℕ) % N + N * m := by
      simpa [m] using (Nat.mod_add_div (i : ℕ) N).symm
    -- Proof comment: reduce the `i`-th coordinate to the `(i % N)`-th coordinate by splitting the
    -- iterate into one period block and a multiple of the period.
    have hsplit_apply : (τ^[i]) ω = (τ^[(i : ℕ) % N + N * m]) ω := by
      simpa using congrArg (fun k : ℕ ↦ (τ^[k]) ω) hsplit
    have hiter_eq : (τ^[i]) ω = (τ^[(i : ℕ) % N]) ω := by
      calc
        (τ^[i]) ω = (τ^[(i : ℕ) % N + N * m]) ω := hsplit_apply
        _ = (τ^[(i : ℕ) % N]) ((τ^[N * m]) ω) := by rw [Function.iterate_add_apply]
        _ = (τ^[(i : ℕ) % N]) ω := by simpa [hmul]
    exact congrArg part.toSimpleFunc hiter_eq
  have hmono :
      ∀ {A : (part.block τ hτ N).parts} {ω ω' : Ω},
        ω ∈ (((A.1 : Subtype (MeasurableSet : Set Ω → Prop)) : Set Ω)) →
        ω' ∈ (((A.1 : Subtype (MeasurableSet : Set Ω → Prop)) : Set Ω)) →
        prefixBlockCode τ hτ part n ω = prefixBlockCode τ hτ part n ω' := by
    intro A ω ω' hω hω'
    have hsame :
        (part.block τ hτ N).toSimpleFunc ω = (part.block τ hτ N).toSimpleFunc ω' :=
      toSimpleFunc_eq_of_mem_atom (part.block τ hτ N) hω hω'
    have hprefix :
        prefixBlockCode τ hτ part N ω = prefixBlockCode τ hτ part N ω' :=
      sameBlockAtom_samePrefixCoordinates hτ part N hsame
    -- Proof comment: on one `N`-block atom, the `N`-prefix code agrees, and every longer
    -- coordinate is just the corresponding periodic reduction of one of those first `N`
    -- coordinates.
    funext i
    calc
      prefixBlockCode τ hτ part n ω i =
          prefixBlockCode τ hτ part N ω ⟨(i : ℕ) % N, Nat.mod_lt _ N.pos⟩ :=
        hperiodicCoord ω i
      _ = prefixBlockCode τ hτ part N ω' ⟨(i : ℕ) % N, Nat.mod_lt _ N.pos⟩ := by
          simpa using congrArg
            (fun w : Fin N → part.parts ↦ w ⟨(i : ℕ) % N, Nat.mod_lt _ N.pos⟩) hprefix
      _ = prefixBlockCode τ hτ part n ω' i := (hperiodicCoord ω' i).symm
  -- Proof comment: once the transparent `n`-block code is monochromatic on the `N`-block atoms,
  -- it factors through the owner `N`-block partition.
  simpa [block_eq_ofSimpleFunc_prefixBlockCode hτ part n] using
    (ofSimpleFunc_factorsThroughPartitionOfMonochromatic
      (part.block τ hτ N) (prefixBlockCode τ hτ part n) hmono)

/-- Helper for Example 20.36: a positive iterate identity bounds all block entropies along
multiples of the period by the fixed period block entropy, so the normalized block entropies have
infimum `0`. -/
private theorem dynamicalEntropy_eq_zero_of_periodicIterate
    {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
    (τ : Ω → Ω) (hτ : Measurable τ) (part : MeasurableFinpartition Ω)
    {N : ℕ} (hN : 0 < N) (hIter : (τ^[N]) = id) :
    h(P, τ, hτ; part) = 0 := by
  classical
  let N' : ℕ+ := ⟨N, hN⟩
  letI : Fintype (part.block τ hτ N').parts := Fintype.ofFinite _
  let S : Set EReal :=
    Set.range fun n : ℕ+ ↦
      (part.block τ hτ n).partitionEntropy P * (((n : ℕ) : EReal)⁻¹)
  rw [MeasurableFinpartition.dynamicalEntropy_def]
  change sInf S = 0
  let C : ℝ := max 1 (Fintype.card (part.block τ hτ N').parts : ℝ)
  have hC_pos : 0 < C := by
    dsimp [C]
    exact lt_of_lt_of_le zero_lt_one (le_max_left 1 _)
  have hterm_nonneg :
      ∀ a ∈ S, 0 ≤ a := by
    rintro _ ⟨n, rfl⟩
    -- Proof comment: both the block entropy and the normalization factor are nonnegative.
    refine mul_nonneg ?_ ?_
    · simpa [MeasurableFinpartition.partitionEntropy_def] using
        entropy_nonneg ((part.block τ hτ n).toPMF P)
    · positivity
  have hcard_upper (n : ℕ+) :
      Nat.card (part.block τ hτ n).parts ≤ Nat.card (part.block τ hτ N').parts := by
    rcases blockFactor_of_periodicIterate hτ part (N := N') (by simpa [N'] using hIter) n with
      ⟨Φ, hΦ⟩
    refine Nat.card_le_card_of_surjective Φ ?_
    intro A
    have hA_nonempty :
        ((((A.1 : Subtype (MeasurableSet : Set Ω → Prop)) : Set Ω)) : Set Ω).Nonempty := by
      by_contra hA_nonempty
      apply (part.block τ hτ n).ne_bot A.2
      ext ω
      simp [Set.not_nonempty_iff_eq_empty.mp hA_nonempty]
    rcases hA_nonempty with ⟨ω, hω⟩
    refine ⟨(part.block τ hτ N').toSimpleFunc ω, ?_⟩
    have hcode : (part.block τ hτ n).toSimpleFunc ω = A :=
      (mem_atom_iff_toSimpleFunc_eq (part.block τ hτ n)).mp hω
    have himage :
        (part.block τ hτ n).toSimpleFunc ω =
          Φ ((part.block τ hτ N').toSimpleFunc ω) :=
      congrArg (fun f : Ω → (part.block τ hτ n).parts ↦ f ω) hΦ
    exact himage.symm.trans hcode
  have hterm_upper (n : ℕ+) :
      (part.block τ hτ n).partitionEntropy P * (((n : ℕ) : EReal)⁻¹) ≤
        (C : EReal) * (((n : ℕ) : EReal)⁻¹) := by
    letI : Fintype (part.block τ hτ n).parts := Fintype.ofFinite _
    have hpart_upper : (part.block τ hτ n).partitionEntropy P ≤ (C : EReal) := by
      rw [MeasurableFinpartition.partitionEntropy_def]
      calc
        entropy ((part.block τ hτ n).toPMF P) ≤
            Real.log (Fintype.card (part.block τ hτ n).parts) := entropy_le_log_card _
        _ ≤ (Fintype.card (part.block τ hτ n).parts : ℝ) := by
            exact_mod_cast Real.log_le_self
              (show 0 ≤ (Fintype.card (part.block τ hτ n).parts : ℝ) by positivity)
        _ = (Nat.card (part.block τ hτ n).parts : ℝ) := by
            rw [← Nat.card_eq_fintype_card]
        _ ≤ (Nat.card (part.block τ hτ N').parts : ℝ) := by
            exact_mod_cast hcard_upper n
        _ = (Fintype.card (part.block τ hτ N').parts : ℝ) := by
            rw [Nat.card_eq_fintype_card]
        _ ≤ C := by
            dsimp [C]
            exact_mod_cast
              (le_max_right (1 : ℝ) (Fintype.card (part.block τ hτ N').parts : ℝ))
    exact mul_le_mul_of_nonneg_right hpart_upper (by positivity)
  have hsmall_term :
      ∀ w, 0 < w → ∃ a ∈ S, a < w := by
    intro w hw
    by_cases hw_top : w = ⊤
    · refine ⟨(part.block τ hτ (1 : ℕ+)).partitionEntropy P * (((1 : ℕ) : EReal)⁻¹),
        ?_, ?_⟩
      · exact Set.mem_range.mpr ⟨(1 : ℕ+), rfl⟩
      · have hfinite : (C : EReal) * (((1 : ℕ) : EReal)⁻¹) < ⊤ := by
          simp
        simpa [hw_top] using lt_of_le_of_lt (hterm_upper (1 : ℕ+)) hfinite
    · have hw_bot : w ≠ ⊥ := by
        exact ne_of_gt (lt_of_lt_of_le (by simp : (⊥ : EReal) < 0) hw.le)
      have hw_real_pos : 0 < w.toReal := EReal.toReal_pos hw hw_top
      obtain ⟨m, hm⟩ := exists_nat_one_div_lt (show 0 < w.toReal / C by
        exact div_pos hw_real_pos hC_pos)
      let n : ℕ+ := ⟨m + 1, Nat.succ_pos _⟩
      refine ⟨(part.block τ hτ n).partitionEntropy P * (((n : ℕ) : EReal)⁻¹),
        Set.mem_range.mpr ⟨n, rfl⟩, ?_⟩
      have hreal_bound : C * (1 / (n : ℝ)) < w.toReal := by
        have hm' : C * (1 / (m + 1 : ℝ)) < w.toReal := by
          calc
            C * (1 / (m + 1 : ℝ)) < C * (w.toReal / C) := by
              exact mul_lt_mul_of_pos_left hm hC_pos
            _ = w.toReal := by
              field_simp [hC_pos.ne']
        simpa [n] using hm'
      have hbound_eq :
          (C : EReal) * (((n : ℕ) : EReal)⁻¹) =
            ((C * (1 / (n : ℝ)) : ℝ) : EReal) := by
        have hnat_inv :
            (((n : ℕ) : EReal)⁻¹) = ((((n : ℝ))⁻¹ : ℝ) : EReal) := by
          rw [show ((n : ℕ) : EReal) = ((n : ℝ) : EReal) by norm_num]
          rw [← EReal.coe_inv (n : ℝ)]
        calc
          (C : EReal) * (((n : ℕ) : EReal)⁻¹) =
              (C : EReal) * ((((n : ℝ))⁻¹ : ℝ) : EReal) := by
                rw [hnat_inv]
          _ = ((C * ((n : ℝ)⁻¹) : ℝ) : EReal) := by
                rw [← EReal.coe_mul]
          _ = ((C * (1 / (n : ℝ)) : ℝ) : EReal) := by
                simp [one_div]
      have hbound_lt_w :
          (C : EReal) * (((n : ℕ) : EReal)⁻¹) < w := by
        rw [hbound_eq, ← EReal.coe_toReal hw_top hw_bot]
        exact_mod_cast hreal_bound
      exact lt_of_le_of_lt (hterm_upper n) hbound_lt_w
  -- Proof comment: the normalized block-entropy range has infimum `0` because the finite
  -- `N`-block cardinality bound forces all normalized terms to become arbitrarily small.
  exact sInf_eq_of_forall_ge_of_forall_gt_exists_lt hterm_nonneg hsmall_term

/-- Helper for Example 20.36: once a code factors through an `N`-block of `part`, every `n`-block
entropy of that code is dominated by the corresponding long block entropy of `part`. -/
private theorem negMulLog_add_le
    {x y : ℝ} (hx : 0 ≤ x) (hy : 0 ≤ y) :
    Real.negMulLog (x + y) ≤ Real.negMulLog x + Real.negMulLog y := by
  by_cases hxy : x + y = 0
  · -- Proof comment: if the total mass is zero, both summands already vanish.
    have hx0 : x = 0 := by linarith
    have hy0 : y = 0 := by linarith
    simp [hx0, hy0]
  · -- Proof comment: otherwise normalize by the total mass and use the multiplicative formula for
    -- `Real.negMulLog`.
    set s : ℝ := x + y
    have hxy' : x + y ≠ 0 := by
      simpa [s] using hxy
    have hs : 0 < s := by
      dsimp [s]
      exact lt_of_le_of_ne (add_nonneg hx hy) (by simpa [ne_comm] using hxy')
    have hs_nonneg : 0 ≤ s := le_of_lt hs
    have hs_ne : s ≠ 0 := ne_of_gt hs
    have hxs : x = s * (x / s) := by
      field_simp [s, hs_ne]
    have hys : y = s * (y / s) := by
      field_simp [s, hs_ne]
    have hx_div_nonneg : 0 ≤ x / s := by positivity
    have hy_div_nonneg : 0 ≤ y / s := by positivity
    have hx_div_le_one : x / s ≤ 1 := by
      have hle : x ≤ s := by
        dsimp [s]
        linarith
      field_simp [hs_ne]
      linarith
    have hy_div_le_one : y / s ≤ 1 := by
      have hle : y ≤ s := by
        dsimp [s]
        linarith
      field_simp [hs_ne]
      linarith
    have hsum_div : x / s + y / s = 1 := by
      field_simp [s, hs_ne]
      ring
    have hsplit :
        Real.negMulLog s + (s * Real.negMulLog (x / s) + s * Real.negMulLog (y / s)) =
          ((x / s) * Real.negMulLog s + s * Real.negMulLog (x / s)) +
            ((y / s) * Real.negMulLog s + s * Real.negMulLog (y / s)) := by
      calc
        Real.negMulLog s + (s * Real.negMulLog (x / s) + s * Real.negMulLog (y / s)) =
            ((x / s + y / s) * Real.negMulLog s) +
              (s * Real.negMulLog (x / s) + s * Real.negMulLog (y / s)) := by
          rw [hsum_div]
          ring
        _ =
            ((x / s) * Real.negMulLog s + s * Real.negMulLog (x / s)) +
              ((y / s) * Real.negMulLog s + s * Real.negMulLog (y / s)) := by
          ring
    have hnegMulLog_x :
        Real.negMulLog x = (x / s) * Real.negMulLog s + s * Real.negMulLog (x / s) := by
      calc
        Real.negMulLog x = Real.negMulLog (s * (x / s)) := by
          exact congrArg Real.negMulLog hxs
        _ = (x / s) * Real.negMulLog s + s * Real.negMulLog (x / s) := by
          rw [Real.negMulLog_mul]
    have hnegMulLog_y :
        Real.negMulLog y = (y / s) * Real.negMulLog s + s * Real.negMulLog (y / s) := by
      calc
        Real.negMulLog y = Real.negMulLog (s * (y / s)) := by
          exact congrArg Real.negMulLog hys
        _ = (y / s) * Real.negMulLog s + s * Real.negMulLog (y / s) := by
          rw [Real.negMulLog_mul]
    calc
      Real.negMulLog (x + y) = Real.negMulLog s := by simp [s]
      _ ≤ Real.negMulLog s + (s * Real.negMulLog (x / s) + s * Real.negMulLog (y / s)) := by
        have hx_term_nonneg : 0 ≤ s * Real.negMulLog (x / s) := by
          exact mul_nonneg hs_nonneg (Real.negMulLog_nonneg hx_div_nonneg hx_div_le_one)
        have hy_term_nonneg : 0 ≤ s * Real.negMulLog (y / s) := by
          exact mul_nonneg hs_nonneg (Real.negMulLog_nonneg hy_div_nonneg hy_div_le_one)
        linarith
      _ =
          ((x / s) * Real.negMulLog s + s * Real.negMulLog (x / s)) +
            ((y / s) * Real.negMulLog s + s * Real.negMulLog (y / s)) := by
        exact hsplit
      _ = Real.negMulLog x + Real.negMulLog y := by
        rw [hnegMulLog_x, hnegMulLog_y]

/-- Helper for Example 20.36: the Shannon contribution of a finite sum of nonnegative masses is
bounded by the sum of the individual contributions. -/
private theorem negMulLog_sum_le_sum_negMulLog
    {ι : Type*} (s : Finset ι) (w : ι → ℝ)
    (hw : ∀ i ∈ s, 0 ≤ w i) :
    Real.negMulLog (Finset.sum s w) ≤ Finset.sum s (fun i ↦ Real.negMulLog (w i)) := by
  induction s using Finset.cons_induction with
  | empty =>
      -- Proof comment: the empty sum has zero Shannon contribution.
      simp [Real.negMulLog_zero]
  | @cons a s ha ih =>
      -- Proof comment: split off one mass and apply the two-point superadditivity step.
      have hwa : 0 ≤ w a := hw a (by simp)
      have hws : ∀ i ∈ s, 0 ≤ w i := by
        intro i hi
        exact hw i (by simp [hi])
      have hsum_nonneg : 0 ≤ Finset.sum s w := Finset.sum_nonneg hws
      calc
        Real.negMulLog (Finset.sum (Finset.cons a s ha) w) =
            Real.negMulLog (w a + Finset.sum s w) := by
          simp
        _ ≤ Real.negMulLog (w a) + Real.negMulLog (Finset.sum s w) :=
          negMulLog_add_le hwa hsum_nonneg
        _ ≤ Real.negMulLog (w a) + Finset.sum s (fun i ↦ Real.negMulLog (w i)) := by
          gcongr
          exact ih hws
        _ = Finset.sum (Finset.cons a s ha) (fun i ↦ Real.negMulLog (w i)) := by
          simp

/-- Helper for Example 20.36: deterministic coding on a finite alphabet cannot increase Shannon
entropy. -/
private theorem entropyMap_le
    {α β : Type*} [Finite α] [Finite β] (p : PMF α) (Φ : α → β) :
    entropy (PMF.map Φ p) ≤ entropy p := by
  classical
  letI : Fintype α := Fintype.ofFinite α
  letI : Fintype β := Fintype.ofFinite β
  have hmap_apply (b : β) :
      ((PMF.map Φ p) b).toReal =
        Finset.sum (Finset.univ.filter (fun a : α ↦ Φ a = b)) fun a ↦ (p a).toReal := by
    calc
      ((PMF.map Φ p) b).toReal =
          (∑' a : α, if b = Φ a then p a else 0).toReal := by
        rw [PMF.map_apply]
      _ = (∑ a : α, if b = Φ a then p a else 0).toReal := by
        rw [tsum_fintype]
      _ = ∑ a : α, (if b = Φ a then p a else 0).toReal := by
        refine ENNReal.toReal_sum ?_
        intro a ha
        by_cases hab : b = Φ a
        · simp [hab, p.apply_ne_top a]
        · simp [hab]
      _ = Finset.sum (Finset.univ.filter (fun a : α ↦ Φ a = b)) fun a ↦ (p a).toReal := by
        rw [Finset.sum_filter]
        refine Finset.sum_congr rfl ?_
        intro a ha
        by_cases hab : Φ a = b
        · simp [hab]
        · have hab' : b ≠ Φ a := by
            simpa [eq_comm] using hab
          simp [hab, hab']
  have hfiber :
      ∑ b : β, Real.negMulLog (((PMF.map Φ p) b).toReal) ≤
        ∑ b : β,
          Finset.sum (Finset.univ.filter (fun a : α ↦ Φ a = b))
            fun a ↦ Real.negMulLog ((p a).toReal) := by
    -- Proof comment: apply the finite superadditivity estimate fiberwise to each value of `Φ`.
    refine Finset.sum_le_sum ?_
    intro b hb
    rw [hmap_apply b]
    refine negMulLog_sum_le_sum_negMulLog _ _ ?_
    intro a ha
    exact ENNReal.toReal_nonneg
  have hfiberwise :
      (∑ b : β,
        Finset.sum (Finset.univ.filter (fun a : α ↦ Φ a = b))
          fun a ↦ Real.negMulLog ((p a).toReal)) =
        ∑ a : α, Real.negMulLog ((p a).toReal) := by
    -- Proof comment: the fiberwise decomposition reassembles into the original entropy sum.
    simpa using
      (Finset.sum_fiberwise (s := Finset.univ) (g := Φ)
        (f := fun a : α ↦ Real.negMulLog ((p a).toReal)))
  rw [entropy_eq_sum, entropy_eq_sum]
  apply EReal.coe_le_coe
  calc
    (-∑ b : β, ((PMF.map Φ p) b).toReal * Real.log (((PMF.map Φ p) b).toReal) : ℝ) =
        ∑ b : β, Real.negMulLog (((PMF.map Φ p) b).toReal) := by
      simp [Real.negMulLog_def]
    _ ≤ ∑ b : β,
          Finset.sum (Finset.univ.filter (fun a : α ↦ Φ a = b))
            fun a ↦ Real.negMulLog ((p a).toReal) := hfiber
    _ = ∑ a : α, Real.negMulLog ((p a).toReal) := hfiberwise
    _ = (-∑ a : α, (p a).toReal * Real.log ((p a).toReal) : ℝ) := by
      simp [Real.negMulLog_def]

/-- Helper for Example 20.36: if the coding of `q` factors through the coding of `r`, then the
induced pmf of `q` is the corresponding pushforward of the pmf induced by `r`. -/
private theorem toPMF_eq_map_of_toSimpleFuncFactor
    {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
    {q r : MeasurableFinpartition Ω} (Φ : r.parts → q.parts)
    (hΦ : (q.toSimpleFunc : Ω → q.parts) = fun ω ↦ Φ (r.toSimpleFunc ω)) :
    q.toPMF P = PMF.map Φ (r.toPMF P) := by
  let μq : Measure q.parts := P.map q.toSimpleFunc
  let μr : Measure r.parts := P.map r.toSimpleFunc
  letI : IsProbabilityMeasure μq :=
    Measure.isProbabilityMeasure_map q.toSimpleFunc.aemeasurable
  letI : IsProbabilityMeasure μr :=
    Measure.isProbabilityMeasure_map r.toSimpleFunc.aemeasurable
  change μq.toPMF = PMF.map Φ μr.toPMF
  apply PMF.toMeasure_injective
  -- Proof comment: rewrite both pmfs back to the corresponding pushforward measures.
  rw [Measure.toPMF_toMeasure]
  rw [← PMF.toMeasure_map]
  · rw [Measure.toPMF_toMeasure]
    dsimp [μq, μr]
    rw [Measure.map_map (μ := P) (g := Φ) (f := r.toSimpleFunc)
      (Measurable.of_discrete (f := Φ)) r.toSimpleFunc.measurable]
    rw [hΦ]
    rfl
  · exact Measurable.of_discrete (f := Φ)

/-- Helper for Example 20.36: a partition that factors through another finite measurable partition
cannot have larger one-step entropy. -/
private theorem partitionEntropy_le_of_toSimpleFuncFactor
    {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
    {q r : MeasurableFinpartition Ω} (Φ : r.parts → q.parts)
    (hΦ : (q.toSimpleFunc : Ω → q.parts) = fun ω ↦ Φ (r.toSimpleFunc ω)) :
    q.partitionEntropy P ≤ r.partitionEntropy P := by
  -- Proof comment: rewrite the smaller partition law as a deterministic pushforward of the larger
  -- partition law and apply entropy monotonicity under `PMF.map`.
  calc
    q.partitionEntropy P = entropy (PMF.map Φ (r.toPMF P)) := by
      rw [MeasurableFinpartition.partitionEntropy_def, toPMF_eq_map_of_toSimpleFuncFactor P Φ hΦ]
    _ ≤ entropy (r.toPMF P) := entropyMap_le (r.toPMF P) Φ
    _ = r.partitionEntropy P := by
      rw [MeasurableFinpartition.partitionEntropy_def]

/-- Helper for Example 20.36: the block entropy of the pair code `(g, e)` is bounded by the sum
of the block entropies of `g` and `e`. -/
private theorem blockPartitionEntropy_pair_le_add
    {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
    {τ : Ω → Ω} (hτ : Measurable τ) {β : Type*} {γ : Type*}
    [Finite β] [MeasurableSpace β] [MeasurableSingletonClass β] [Countable β]
    [Finite γ] [MeasurableSpace γ] [MeasurableSingletonClass γ] [Countable γ]
    (g : SimpleFunc Ω β) (e : SimpleFunc Ω γ) (n : ℕ+) :
    ((MeasurableFinpartition.ofSimpleFunc (g.pair e)).block τ hτ n).partitionEntropy P ≤
      ((MeasurableFinpartition.ofSimpleFunc g).block τ hτ n).partitionEntropy P +
        ((MeasurableFinpartition.ofSimpleFunc e).block τ hτ n).partitionEntropy P := by
  classical
  let gBlock : Ω → (Fin n → β) := fun ω i ↦ g ((τ^[i]) ω)
  let eBlock : Ω → (Fin n → γ) := fun ω i ↦ e ((τ^[i]) ω)
  let geBlock : Ω → (Fin n → β × γ) := fun ω i ↦ (g ((τ^[i]) ω), e ((τ^[i]) ω))
  let Ψ : (Fin n → β × γ) → (Fin n → β) × (Fin n → γ) :=
    fun s ↦ (fun i ↦ (s i).1, fun i ↦ (s i).2)
  have hΨinj : Function.Injective Ψ := by
    intro s t hst
    have hfst : (fun i ↦ (s i).1) = fun i ↦ (t i).1 := congrArg Prod.fst hst
    have hsnd : (fun i ↦ (s i).2) = fun i ↦ (t i).2 := congrArg Prod.snd hst
    funext i
    exact Prod.ext (by simpa using congrFun hfst i) (by simpa using congrFun hsnd i)
  have hgBlock : Measurable gBlock := by
    -- Proof comment: each block coordinate of `g` is measurable after iterating `τ`.
    refine measurable_pi_lambda _ fun i ↦ ?_
    exact g.measurable.comp (Measurable.iterate hτ i)
  have heBlock : Measurable eBlock := by
    -- Proof comment: the same coordinatewise measurability argument applies to `e`.
    refine measurable_pi_lambda _ fun i ↦ ?_
    exact e.measurable.comp (Measurable.iterate hτ i)
  have hgeBlock : Measurable geBlock := by
    -- Proof comment: pair the two measurable block-value maps coordinatewise.
    refine measurable_pi_lambda _ fun i ↦ ?_
    exact (g.measurable.comp (Measurable.iterate hτ i)).prodMk
      (e.measurable.comp (Measurable.iterate hτ i))
  letI : IsProbabilityMeasure (Measure.map gBlock P) :=
    Measure.isProbabilityMeasure_map hgBlock.aemeasurable
  letI : IsProbabilityMeasure (Measure.map eBlock P) :=
    Measure.isProbabilityMeasure_map heBlock.aemeasurable
  letI : IsProbabilityMeasure (Measure.map geBlock P) :=
    Measure.isProbabilityMeasure_map hgeBlock.aemeasurable
  letI :
      IsProbabilityMeasure
        (Measure.map (fun ω : Ω ↦ fun i : Fin n ↦ (g.pair e) ((τ^[i]) ω)) P) := by
    simpa [geBlock, SimpleFunc.pair_apply] using
      (show IsProbabilityMeasure (Measure.map geBlock P) from inferInstance)
  let geLaw : PMF (Fin n → β × γ) := (Measure.map geBlock P).toPMF
  let pairLaw : PMF ((Fin n → β) × (Fin n → γ)) := PMF.map Ψ geLaw
  have hfstLaw : PMF.map Prod.fst pairLaw = (Measure.map gBlock P).toPMF := by
    -- Proof comment: the first marginal of the block-pair law is exactly the block law of `g`.
    calc
      PMF.map Prod.fst pairLaw = PMF.map (Prod.fst ∘ Ψ) geLaw := by
        simp [pairLaw, PMF.map_comp]
      _ = PMF.map (fun s : Fin n → β × γ ↦ fun i ↦ (s i).1) geLaw := rfl
      _ = (Measure.map gBlock P).toPMF := by
        symm
        exact toPMF_eq_map_of_comp (P := P)
          (f := geBlock) (hf := hgeBlock)
          (g := fun s : Fin n → β × γ ↦ fun i ↦ (s i).1)
          (hg := Measurable.of_discrete (f := fun s : Fin n → β × γ ↦ fun i ↦ (s i).1))
  have hsndLaw : PMF.map Prod.snd pairLaw = (Measure.map eBlock P).toPMF := by
    -- Proof comment: the second marginal of the block-pair law is exactly the block law of `e`.
    calc
      PMF.map Prod.snd pairLaw = PMF.map (Prod.snd ∘ Ψ) geLaw := by
        simp [pairLaw, PMF.map_comp]
      _ = PMF.map (fun s : Fin n → β × γ ↦ fun i ↦ (s i).2) geLaw := rfl
      _ = (Measure.map eBlock P).toPMF := by
        symm
        exact toPMF_eq_map_of_comp (P := P)
          (f := geBlock) (hf := hgeBlock)
          (g := fun s : Fin n → β × γ ↦ fun i ↦ (s i).2)
          (hg := Measurable.of_discrete (f := fun s : Fin n → β × γ ↦ fun i ↦ (s i).2))
  calc
    ((MeasurableFinpartition.ofSimpleFunc (g.pair e)).block τ hτ n).partitionEntropy P =
        entropy geLaw := by
      -- Proof comment: identify the pair-block partition with the Shannon entropy of its block
      -- value law.
      simpa [geLaw, geBlock, SimpleFunc.pair_apply] using
        (blockPartitionEntropy_ofSimpleFunc_eq_entropy_valueBlockLaw
          (μ := P) (hτ := hτ) (g := g.pair e) (n := n))
    _ = entropy pairLaw := by
      -- Proof comment: regroup each block word into the product of its first and second
      -- coordinate words through an injective relabeling.
      symm
      exact entropy_map_eq_of_injective geLaw Ψ hΨinj
    _ ≤ entropy (PMF.map Prod.fst pairLaw) + entropy (PMF.map Prod.snd pairLaw) := by
      exact entropy_le_entropy_map_fst_add_entropy_map_snd pairLaw
    _ = entropy ((Measure.map gBlock P).toPMF) + entropy ((Measure.map eBlock P).toPMF) := by
      rw [hfstLaw, hsndLaw]
    _ = ((MeasurableFinpartition.ofSimpleFunc g).block τ hτ n).partitionEntropy P +
          ((MeasurableFinpartition.ofSimpleFunc e).block τ hτ n).partitionEntropy P := by
      -- Proof comment: convert both marginal block-value laws back to the corresponding block
      -- partition entropies.
      rw [← blockPartitionEntropy_ofSimpleFunc_eq_entropy_valueBlockLaw
          (μ := P) (hτ := hτ) (g := g) (n := n)]
      rw [← blockPartitionEntropy_ofSimpleFunc_eq_entropy_valueBlockLaw
          (μ := P) (hτ := hτ) (g := e) (n := n)]

/-- Helper for Example 20.36: if a block code is pointwise decoded from two auxiliary codes, then
its block entropy is at most the sum of the two auxiliary block entropies. -/
private theorem blockPartitionEntropy_le_add_ofPointwiseDecode
    {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
    {τ : Ω → Ω} (hτ : Measurable τ) {α : Type*} {β : Type*} {γ : Type*}
    [Finite α] [MeasurableSpace α] [MeasurableSingletonClass α] [Countable α]
    [Finite β] [MeasurableSpace β] [MeasurableSingletonClass β] [Countable β]
    [Finite γ] [MeasurableSpace γ] [MeasurableSingletonClass γ] [Countable γ]
    (q : SimpleFunc Ω α) (g : SimpleFunc Ω β) (e : SimpleFunc Ω γ)
    (decode : β → γ → α)
    (hdecode : q = fun ω ↦ decode (g ω) (e ω)) (n : ℕ+) :
    ((MeasurableFinpartition.ofSimpleFunc q).block τ hτ n).partitionEntropy P ≤
      ((MeasurableFinpartition.ofSimpleFunc g).block τ hτ n).partitionEntropy P +
        ((MeasurableFinpartition.ofSimpleFunc e).block τ hτ n).partitionEntropy P := by
  classical
  let qBlock : Ω → (Fin n → α) := fun ω i ↦ q ((τ^[i]) ω)
  let geBlock : Ω → (Fin n → β × γ) := fun ω i ↦ (g ((τ^[i]) ω), e ((τ^[i]) ω))
  let decodeBlock : (Fin n → β × γ) → (Fin n → α) :=
    fun s i ↦ decode (s i).1 (s i).2
  have hqBlock : Measurable qBlock := by
    -- Proof comment: each decoded block coordinate is a measurable iterate of the original code
    -- `q`.
    refine measurable_pi_lambda _ fun i ↦ ?_
    exact q.measurable.comp (Measurable.iterate hτ i)
  have hgeBlock : Measurable geBlock := by
    -- Proof comment: the paired auxiliary block code is measurable coordinatewise.
    refine measurable_pi_lambda _ fun i ↦ ?_
    exact (g.measurable.comp (Measurable.iterate hτ i)).prodMk
      (e.measurable.comp (Measurable.iterate hτ i))
  have hdecodeBlock :
      qBlock = fun ω ↦ decodeBlock (geBlock ω) := by
    -- Proof comment: decode each time coordinate using the one-step pointwise identity.
    funext ω
    funext i
    have hstep := congrArg (fun f : Ω → α ↦ f ((τ^[i]) ω)) hdecode
    simpa [qBlock, geBlock, decodeBlock] using hstep
  letI : IsProbabilityMeasure (Measure.map qBlock P) :=
    Measure.isProbabilityMeasure_map hqBlock.aemeasurable
  letI : IsProbabilityMeasure (Measure.map geBlock P) :=
    Measure.isProbabilityMeasure_map hgeBlock.aemeasurable
  letI :
      IsProbabilityMeasure (Measure.map (fun ω : Ω ↦ fun i : Fin n ↦ q ((τ^[i]) ω)) P) := by
    simpa [qBlock] using
      (show IsProbabilityMeasure (Measure.map qBlock P) from inferInstance)
  letI :
      IsProbabilityMeasure
        (Measure.map (fun ω : Ω ↦ fun i : Fin n ↦ (g.pair e) ((τ^[i]) ω)) P) := by
    simpa [geBlock, SimpleFunc.pair_apply] using
      (show IsProbabilityMeasure (Measure.map geBlock P) from inferInstance)
  letI : IsProbabilityMeasure (Measure.map (fun ω ↦ decodeBlock (geBlock ω)) P) := by
    simpa [hdecodeBlock] using
      (show IsProbabilityMeasure (Measure.map qBlock P) from inferInstance)
  have hdecodeLaw :
      (Measure.map qBlock P).toPMF =
        PMF.map decodeBlock ((Measure.map geBlock P).toPMF) := by
    -- Proof comment: the decoded block law is the pushforward of the paired auxiliary block law.
    simpa [hdecodeBlock] using
      (toPMF_eq_map_of_comp (P := P)
        (f := geBlock) (hf := hgeBlock)
        (g := decodeBlock) (hg := Measurable.of_discrete (f := decodeBlock)))
  calc
    ((MeasurableFinpartition.ofSimpleFunc q).block τ hτ n).partitionEntropy P =
        entropy ((Measure.map qBlock P).toPMF) := by
      -- Proof comment: normalize the decoded block partition to the Shannon entropy of its block
      -- value law.
      simpa [qBlock] using
        (blockPartitionEntropy_ofSimpleFunc_eq_entropy_valueBlockLaw
          (μ := P) (hτ := hτ) (g := q) (n := n))
    _ = entropy (PMF.map decodeBlock ((Measure.map geBlock P).toPMF)) := by
      rw [hdecodeLaw]
    _ ≤ entropy ((Measure.map geBlock P).toPMF) := by
      exact entropyMap_le ((Measure.map geBlock P).toPMF) decodeBlock
    _ = ((MeasurableFinpartition.ofSimpleFunc (g.pair e)).block τ hτ n).partitionEntropy P := by
      -- Proof comment: the paired auxiliary block law is exactly the block law of the one-step
      -- pair code `(g, e)`.
      symm
      simpa [geBlock, SimpleFunc.pair_apply] using
        (blockPartitionEntropy_ofSimpleFunc_eq_entropy_valueBlockLaw
          (μ := P) (hτ := hτ) (g := g.pair e) (n := n))
    _ ≤
        ((MeasurableFinpartition.ofSimpleFunc g).block τ hτ n).partitionEntropy P +
          ((MeasurableFinpartition.ofSimpleFunc e).block τ hτ n).partitionEntropy P := by
      exact blockPartitionEntropy_pair_le_add (P := P) (hτ := hτ) g e n

/-- Helper for Example 20.36: the entropy of an `Option β`-valued pmf is controlled by the
binary mass of `none` plus the rare non-`none` mass times `log |β|`. -/
private theorem entropyOption_le_ofNonNoneMass {β : Type*} [Fintype β] (p : PMF (Option β)) :
    entropy p ≤
      ((Real.negMulLog ((p none).toReal) + Real.negMulLog (1 - (p none).toReal) +
          (1 - (p none).toReal) * Real.log (Fintype.card β)) : ℝ) := by
  classical
  have hnone_le_one : (p none).toReal ≤ 1 := by
    exact ENNReal.toReal_mono ENNReal.one_ne_top (p.coe_le_one none)
  have hsome_sum_real : ∑ b : β, (p (some b)).toReal = 1 - (p none).toReal := by
    have htotal :
        (p none).toReal + ∑ b : β, (p (some b)).toReal = 1 := by
      simpa [Fintype.sum_option, add_comm, add_left_comm, add_assoc] using pmfToReal_sum_eq_one p
    linarith
  have hentropy_expand :
      entropy p =
        ((Real.negMulLog ((p none).toReal) +
            ∑ b : β, Real.negMulLog ((p (some b)).toReal) : ℝ) : EReal) := by
    -- Proof comment: split the finite entropy sum into the `none` atom and the `some` atoms.
    rw [entropy_eq_sum]
    congr 1
    simp [Fintype.sum_option, Real.negMulLog_def, add_comm, add_left_comm, add_assoc]
  by_cases hq : 1 - (p none).toReal = 0
  · have hpnone : (p none).toReal = 1 := by
      linarith
    have hsome_zero :
        ∀ b : β, (p (some b)).toReal = 0 := by
      intro b
      have hsum_zero : ∑ b : β, (p (some b)).toReal = 0 := by
        simpa [hq] using hsome_sum_real
      exact
        (Finset.sum_eq_zero_iff_of_nonneg
          (fun b _ ↦ ENNReal.toReal_nonneg)).mp hsum_zero b (by simp)
    calc
      entropy p =
          ((Real.negMulLog ((p none).toReal) +
              ∑ b : β, Real.negMulLog ((p (some b)).toReal) : ℝ) : EReal) :=
        hentropy_expand
      _ ≤
          ((Real.negMulLog ((p none).toReal) + Real.negMulLog (1 - (p none).toReal) +
              (1 - (p none).toReal) * Real.log (Fintype.card β) : ℝ) : EReal) := by
        rw [hpnone]
        simp [hsome_zero]
  · set q : ℝ := 1 - (p none).toReal with hq_def
    have hq_pos : 0 < q := by
      have hq_nonneg' : 0 ≤ q := by
        dsimp [q]
        linarith
      exact lt_of_le_of_ne hq_nonneg' (by simpa [eq_comm] using hq)
    have hq_nonneg : 0 ≤ q := le_of_lt hq_pos
    let w : β → ENNReal := fun b ↦ ENNReal.ofReal ((p (some b)).toReal / q)
    have hw_sum_real : ∑ b : β, (p (some b)).toReal / q = 1 := by
      calc
        ∑ b : β, (p (some b)).toReal / q = (∑ b : β, (p (some b)).toReal) / q := by
          rw [Finset.sum_div]
        _ = q / q := by rw [hsome_sum_real, hq_def]
        _ = 1 := by
          field_simp [hq_pos.ne']
    have hw_sum : ∑ b : β, w b = 1 := by
      rw [show (∑ b : β, w b) =
          ENNReal.ofReal (∑ b : β, (p (some b)).toReal / q) by
        simpa [w] using
          (ENNReal.ofReal_sum_of_nonneg
            (s := Finset.univ)
            (f := fun b : β ↦ (p (some b)).toReal / q)
            (fun b _ ↦ by positivity)).symm]
      rw [hw_sum_real]
      simp
    let r : PMF β := PMF.ofFintype w hw_sum
    have hr_apply (b : β) : (r b).toReal = (p (some b)).toReal / q := by
      have hw_nonneg : 0 ≤ (p (some b)).toReal / q := by
        positivity
      simp [r, w, PMF.ofFintype_apply, hw_nonneg]
    have hsome_negMulLog :
        ∑ b : β, Real.negMulLog ((p (some b)).toReal) =
          Real.negMulLog q + q * ∑ b : β, Real.negMulLog ((r b).toReal) := by
      -- Proof comment: normalize the `some` masses by their total mass `q` and factor each
      -- Shannon contribution through `Real.negMulLog_mul`.
      calc
        ∑ b : β, Real.negMulLog ((p (some b)).toReal) =
            ∑ b : β, Real.negMulLog (q * (r b).toReal) := by
          refine Finset.sum_congr rfl ?_
          intro b hb
          have hmul : q * (r b).toReal = (p (some b)).toReal := by
            rw [hr_apply b]
            field_simp [hq_pos.ne']
          rw [← hmul]
        _ =
            ∑ b : β,
              ((r b).toReal * Real.negMulLog q + q * Real.negMulLog ((r b).toReal)) := by
          refine Finset.sum_congr rfl ?_
          intro b hb
          rw [Real.negMulLog_mul]
        _ =
            (∑ b : β, (r b).toReal) * Real.negMulLog q +
              q * ∑ b : β, Real.negMulLog ((r b).toReal) := by
          rw [Finset.sum_add_distrib, ← Finset.sum_mul, Finset.mul_sum]
        _ = Real.negMulLog q + q * ∑ b : β, Real.negMulLog ((r b).toReal) := by
          simp [pmfToReal_sum_eq_one r]
    have hr_entropy :
        entropy r = ((∑ b : β, Real.negMulLog ((r b).toReal) : ℝ) : EReal) := by
      rw [entropy_eq_sum]
      simp [Real.negMulLog_def]
    have hr_bound :
        ∑ b : β, Real.negMulLog ((r b).toReal) ≤ Real.log (Fintype.card β) := by
      exact EReal.coe_le_coe_iff.mp <| by
        rw [← hr_entropy]
        exact entropy_le_log_card r
    have hsome_bound :
        ∑ b : β, Real.negMulLog ((p (some b)).toReal) ≤
          Real.negMulLog q + q * Real.log (Fintype.card β) := by
      calc
        ∑ b : β, Real.negMulLog ((p (some b)).toReal) =
            Real.negMulLog q + q * ∑ b : β, Real.negMulLog ((r b).toReal) :=
          hsome_negMulLog
        _ ≤ Real.negMulLog q + q * Real.log (Fintype.card β) := by
          gcongr
    calc
      entropy p =
          ((Real.negMulLog ((p none).toReal) +
              ∑ b : β, Real.negMulLog ((p (some b)).toReal) : ℝ) : EReal) :=
        hentropy_expand
      _ ≤
          ((Real.negMulLog ((p none).toReal) + (Real.negMulLog q +
              q * Real.log (Fintype.card β)) : ℝ) : EReal) := by
        apply EReal.coe_le_coe
        linarith [hsome_bound]
      _ =
          ((Real.negMulLog ((p none).toReal) + Real.negMulLog (1 - (p none).toReal) +
              (1 - (p none).toReal) * Real.log (Fintype.card β) : ℝ) : EReal) := by
        simp [q, add_assoc]

/-- Helper for Example 20.36: the length-one block partition has the same entropy as the original
partition. -/
private theorem blockPartitionEntropy_one_eq_partitionEntropy
    {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
    {τ : Ω → Ω} (hτ : MeasurePreserving τ P P) (part : MeasurableFinpartition Ω) :
    (part.block τ hτ.measurable 1).partitionEntropy P = part.partitionEntropy P := by
  classical
  let oneCode : SimpleFunc Ω (Fin 1 → part.parts) :=
    prefixBlockCode τ hτ.measurable part (1 : ℕ+)
  let constCode : part.parts → (Fin 1 → part.parts) := fun a _ ↦ a
  have hconstCode_injective : Function.Injective constCode := by
    intro a b hab
    exact congrFun hab 0
  have honeCode :
      oneCode = fun ω ↦ constCode (part.toSimpleFunc ω) := by
    -- Proof comment: a `Fin 1` block records only the time-`0` atom of `part`.
    funext ω
    funext i
    have hi : i = 0 := Fin.eq_zero i
    subst hi
    simp [oneCode, constCode, prefixBlockCode]
  letI : IsProbabilityMeasure (Measure.map part.toSimpleFunc P) :=
    Measure.isProbabilityMeasure_map part.toSimpleFunc.aemeasurable
  letI : IsProbabilityMeasure (Measure.map oneCode P) :=
    Measure.isProbabilityMeasure_map oneCode.aemeasurable
  letI : IsProbabilityMeasure (Measure.map (fun ω ↦ constCode (part.toSimpleFunc ω)) P) := by
    simpa [honeCode] using
      (show IsProbabilityMeasure (Measure.map oneCode P) from inferInstance)
  have hblockLaw :
      (part.block τ hτ.measurable 1).partitionEntropy P =
        entropy ((Measure.map oneCode P).toPMF) := by
    -- Proof comment: normalize the singleton block partition to the entropy of its block-value
    -- law.
    rw [block_eq_ofSimpleFunc_prefixBlockCode (hτ := hτ.measurable) (part := part) (n := (1 : ℕ+))]
    simpa [oneCode] using
      (partitionEntropy_ofSimpleFunc_eq_entropy_law (P := P) (g := oneCode))
  have hmapLaw :
      (Measure.map oneCode P).toPMF = PMF.map constCode (part.toPMF P) := by
    -- Proof comment: the singleton block law is the pushforward of the one-step partition law by
    -- the constant-on-`Fin 1` relabeling.
    simpa [MeasurableFinpartition.toPMF, honeCode] using
      (toPMF_eq_map_of_comp (P := P)
        (f := part.toSimpleFunc) (hf := part.toSimpleFunc.measurable)
        (g := constCode) (hg := Measurable.of_discrete (f := constCode)))
  calc
    (part.block τ hτ.measurable 1).partitionEntropy P =
        entropy ((Measure.map oneCode P).toPMF) := hblockLaw
    _ = entropy (PMF.map constCode (part.toPMF P)) := by
      rw [hmapLaw]
    _ = entropy (part.toPMF P) := by
      exact entropy_map_eq_of_injective (part.toPMF P) constCode hconstCode_injective
    _ = part.partitionEntropy P := by
      rw [MeasurableFinpartition.partitionEntropy_def]

/-- Helper for Example 20.36: adding one more time coordinate to a block increases the block
entropy by at most one copy of the one-step partition entropy. -/
private theorem blockPartitionEntropy_succ_le_add_partitionEntropy
    {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
    {τ : Ω → Ω} (hτ : MeasurePreserving τ P P) (part : MeasurableFinpartition Ω) (n : ℕ+) :
    (part.block τ hτ.measurable (n + 1)).partitionEntropy P ≤
      part.partitionEntropy P + (part.block τ hτ.measurable n).partitionEntropy P := by
  classical
  let q : SimpleFunc Ω (Fin (n + 1) → part.parts) :=
    prefixBlockCode τ hτ.measurable part (n + 1)
  let g : SimpleFunc Ω (Fin n → part.parts) :=
    prefixBlockCode τ hτ.measurable part n
  let e : SimpleFunc Ω part.parts :=
    part.toSimpleFunc.comp (τ^[n]) (Measurable.iterate hτ.measurable n)
  have hdecode : q = (fun ω : Ω ↦ (Fin.snoc (g ω) (e ω) : Fin (n + 1) → part.parts)) := by
    -- Proof comment: an `(n + 1)`-block is the `n`-prefix together with the final shifted atom.
    funext ω
    funext i
    rcases Fin.eq_castSucc_or_eq_last i with ⟨j, rfl⟩ | rfl
    · simp [q, g, prefixBlockCode]
    · simp [q, e, prefixBlockCode]
  have hshiftEntropy :
      (MeasurableFinpartition.ofSimpleFunc e).partitionEntropy P = part.partitionEntropy P := by
    letI : IsProbabilityMeasure (Measure.map e P) :=
      Measure.isProbabilityMeasure_map e.aemeasurable
    letI : IsProbabilityMeasure (Measure.map part.toSimpleFunc P) :=
      Measure.isProbabilityMeasure_map part.toSimpleFunc.aemeasurable
    have hmap :
        Measure.map e P = Measure.map part.toSimpleFunc P := by
      -- Proof comment: the final coordinate has the same law as the time-`0` partition because
      -- the iterate `τ^[n]` preserves `P`.
      calc
        Measure.map e P = Measure.map part.toSimpleFunc (Measure.map (τ^[n]) P) := by
          simpa [e, Function.comp] using
            (Measure.map_map part.toSimpleFunc.measurable
              (Measurable.iterate hτ.measurable n) (μ := P)).symm
        _ = Measure.map part.toSimpleFunc P := by
          rw [(hτ.iterate n).map_eq]
    have hpmf :
        (Measure.map e P).toPMF = (Measure.map part.toSimpleFunc P).toPMF := by
      simpa [hmap]
    calc
      (MeasurableFinpartition.ofSimpleFunc e).partitionEntropy P =
          entropy ((Measure.map e P).toPMF) := by
        -- Proof comment: rewrite the shifted one-step partition entropy to the entropy of its
        -- pushed-forward law.
        simpa [e] using (partitionEntropy_ofSimpleFunc_eq_entropy_law (P := P) (g := e))
      _ = entropy ((Measure.map part.toSimpleFunc P).toPMF) := by
        rw [hpmf]
      _ = entropy (part.toPMF P) := by
        rw [MeasurableFinpartition.toPMF]
      _ = part.partitionEntropy P := by
        rw [MeasurableFinpartition.partitionEntropy_def]
  have hdecodeEntropy :
      (MeasurableFinpartition.ofSimpleFunc q).partitionEntropy P ≤
        (MeasurableFinpartition.ofSimpleFunc g).partitionEntropy P +
          (MeasurableFinpartition.ofSimpleFunc e).partitionEntropy P := by
    have hblock :=
      blockPartitionEntropy_le_add_ofPointwiseDecode
        (P := P) (hτ := hτ.measurable) (q := q) (g := g) (e := e)
        (decode := fun s a ↦ (Fin.snoc s a : Fin (n + 1) → part.parts)) hdecode (1 : ℕ+)
    -- Proof comment: reduce the decoded one-block estimate back to the original one-step
    -- partition entropies.
    calc
      (MeasurableFinpartition.ofSimpleFunc q).partitionEntropy P =
          ((MeasurableFinpartition.ofSimpleFunc q).block τ hτ.measurable 1).partitionEntropy P := by
        symm
        exact blockPartitionEntropy_one_eq_partitionEntropy
          (P := P) (hτ := hτ) (part := MeasurableFinpartition.ofSimpleFunc q)
      _ ≤
          ((MeasurableFinpartition.ofSimpleFunc g).block τ hτ.measurable 1).partitionEntropy P +
            ((MeasurableFinpartition.ofSimpleFunc e).block τ hτ.measurable 1).partitionEntropy P := hblock
      _ =
          (MeasurableFinpartition.ofSimpleFunc g).partitionEntropy P +
            ((MeasurableFinpartition.ofSimpleFunc e).block τ hτ.measurable 1).partitionEntropy P := by
        rw [blockPartitionEntropy_one_eq_partitionEntropy
          (P := P) (hτ := hτ) (part := MeasurableFinpartition.ofSimpleFunc g)]
      _ =
          (MeasurableFinpartition.ofSimpleFunc g).partitionEntropy P +
            (MeasurableFinpartition.ofSimpleFunc e).partitionEntropy P := by
        rw [blockPartitionEntropy_one_eq_partitionEntropy
          (P := P) (hτ := hτ) (part := MeasurableFinpartition.ofSimpleFunc e)]
  calc
    (part.block τ hτ.measurable (n + 1)).partitionEntropy P =
        (MeasurableFinpartition.ofSimpleFunc q).partitionEntropy P := by
      rw [block_eq_ofSimpleFunc_prefixBlockCode (hτ := hτ.measurable) (part := part) (n := n + 1)]
      simp [q]
    _ ≤
        (MeasurableFinpartition.ofSimpleFunc g).partitionEntropy P +
          (MeasurableFinpartition.ofSimpleFunc e).partitionEntropy P := hdecodeEntropy
    _ = (MeasurableFinpartition.ofSimpleFunc g).partitionEntropy P + part.partitionEntropy P := by
      rw [hshiftEntropy]
    _ = part.partitionEntropy P + (part.block τ hτ.measurable n).partitionEntropy P := by
      rw [add_comm]
      rw [block_eq_ofSimpleFunc_prefixBlockCode (hτ := hτ.measurable) (part := part) (n := n)]

/-- Helper for Example 20.36: the entropy of an `n`-block is at most `n` times the one-step
partition entropy. -/
private theorem blockPartitionEntropy_le_mul_partitionEntropy
    {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
    {τ : Ω → Ω} (hτ : MeasurePreserving τ P P) (part : MeasurableFinpartition Ω) (n : ℕ+) :
    (part.block τ hτ.measurable n).partitionEntropy P ≤
      ((n : ℕ) : EReal) * part.partitionEntropy P := by
  have hpart_nonneg : 0 ≤ part.partitionEntropy P := by
    -- Proof comment: partition entropy is always nonnegative because it is Shannon entropy of a
    -- finite law.
    rw [MeasurableFinpartition.partitionEntropy_def]
    exact entropy_nonneg _
  refine PNat.recOn n ?_ ?_
  · -- Proof comment: at `n = 1`, the block entropy is exactly the one-step partition entropy.
    rw [blockPartitionEntropy_one_eq_partitionEntropy (P := P) (hτ := hτ) (part := part)]
    simp
  · intro k hk
    -- Proof comment: iterate the one-step growth estimate and then insert the induction bound
    -- for the remaining `k`-block.
    calc
      (part.block τ hτ.measurable (k + 1)).partitionEntropy P ≤
          part.partitionEntropy P + (part.block τ hτ.measurable k).partitionEntropy P :=
        blockPartitionEntropy_succ_le_add_partitionEntropy (P := P) (hτ := hτ) (part := part) k
      _ ≤ part.partitionEntropy P + (((k : ℕ) : EReal) * part.partitionEntropy P) := by
        simpa [add_comm, add_left_comm, add_assoc] using
          add_le_add_right hk (part.partitionEntropy P)
      _ = (1 : EReal) * part.partitionEntropy P + ((k : ℕ) : EReal) * part.partitionEntropy P := by
        rw [one_mul]
      _ = (1 + ((k : ℕ) : EReal)) * part.partitionEntropy P := by
        symm
        exact EReal.right_distrib_of_nonneg (by positivity) (by positivity)
      _ = ((((k : ℕ) + 1 : ℕ) : EReal) * part.partitionEntropy P) := by
        norm_num [add_comm]

/-- Helper for Example 20.36: every normalized block term is bounded by the corresponding
one-step partition entropy. -/
private theorem normalizedBlockEntropyRate_le_partitionEntropy
    {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
    {τ : Ω → Ω} (hτ : MeasurePreserving τ P P) (part : MeasurableFinpartition Ω) (n : ℕ+) :
    (part.block τ hτ.measurable n).partitionEntropy P * (((n : ℕ) : EReal)⁻¹) ≤
      part.partitionEntropy P := by
  have hblock :
      (part.block τ hτ.measurable n).partitionEntropy P ≤
        ((n : ℕ) : EReal) * part.partitionEntropy P :=
    blockPartitionEntropy_le_mul_partitionEntropy (P := P) (hτ := hτ) (part := part) n
  have hInv_nonneg : 0 ≤ (((n : ℕ) : EReal)⁻¹) := by
    positivity
  have hpart_nonneg : 0 ≤ part.partitionEntropy P := by
    -- Proof comment: the target one-step entropy is nonnegative, so multiplying by a reciprocal
    -- preserves inequalities.
    rw [MeasurableFinpartition.partitionEntropy_def]
    exact entropy_nonneg _
  calc
    (part.block τ hτ.measurable n).partitionEntropy P * (((n : ℕ) : EReal)⁻¹) ≤
        ((((n : ℕ) : EReal) * part.partitionEntropy P) * (((n : ℕ) : EReal)⁻¹)) := by
      exact mul_le_mul_of_nonneg_right hblock hInv_nonneg
    _ = part.partitionEntropy P := by
      have hnat_cancel : (((n : ℕ) : EReal) * (((n : ℕ) : EReal)⁻¹)) = 1 := by
        have hn_real_ne : ((n : ℕ) : ℝ) ≠ 0 := by
          exact_mod_cast n.ne_zero
        change ((((n : ℕ) : ℝ) : EReal) * ((((n : ℕ) : ℝ) : EReal)⁻¹)) = 1
        rw [← EReal.coe_inv, ← EReal.coe_mul]
        norm_num [hn_real_ne]
      calc
        ((((n : ℕ) : EReal) * part.partitionEntropy P) * (((n : ℕ) : EReal)⁻¹)) =
            part.partitionEntropy P * ((((n : ℕ) : EReal) * (((n : ℕ) : EReal)⁻¹))) := by
          ac_rfl
        _ = part.partitionEntropy P * 1 := by
          rw [hnat_cancel]
        _ = part.partitionEntropy P := by
          rw [mul_one]

/-- Helper for Example 20.36: the normalized block entropy of an `Option β`-valued code is
bounded by the one-step rare-symbol entropy expression of its pushforward law. -/
private theorem normalizedOptionBlockEntropyRate_le_entropyLaw
    {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
    {τ : Ω → Ω} (hτ : MeasurePreserving τ P P) {β : Type*}
    [Fintype β] [MeasurableSpace (Option β)] [MeasurableSingletonClass (Option β)]
    [Countable (Option β)]
    (e : SimpleFunc Ω (Option β)) [IsProbabilityMeasure (Measure.map e P)] (n : ℕ+) :
    ((MeasurableFinpartition.ofSimpleFunc e).block τ hτ.measurable n).partitionEntropy P *
      (((n : ℕ) : EReal)⁻¹) ≤
      ((Real.negMulLog ((((Measure.map e P).toPMF) none).toReal) +
          Real.negMulLog (1 - (((Measure.map e P).toPMF) none).toReal) +
          (1 - (((Measure.map e P).toPMF) none).toReal) * Real.log (Fintype.card β)) : ℝ) := by
  let p : PMF (Option β) := (Measure.map e P).toPMF
  have hrate :
      ((MeasurableFinpartition.ofSimpleFunc e).block τ hτ.measurable n).partitionEntropy P *
        (((n : ℕ) : EReal)⁻¹) ≤
        (MeasurableFinpartition.ofSimpleFunc e).partitionEntropy P :=
    normalizedBlockEntropyRate_le_partitionEntropy
      (P := P) (hτ := hτ) (part := MeasurableFinpartition.ofSimpleFunc e) n
  have hpart :
      (MeasurableFinpartition.ofSimpleFunc e).partitionEntropy P ≤
        ((Real.negMulLog ((p none).toReal) + Real.negMulLog (1 - (p none).toReal) +
            (1 - (p none).toReal) * Real.log (Fintype.card β)) : ℝ) := by
    calc
      (MeasurableFinpartition.ofSimpleFunc e).partitionEntropy P = entropy p := by
        -- Proof comment: identify the one-step entropy of `e` with the Shannon entropy of its
        -- pushforward law.
        simpa [p] using (partitionEntropy_ofSimpleFunc_eq_entropy_law (P := P) (g := e))
      _ ≤
          ((Real.negMulLog ((p none).toReal) + Real.negMulLog (1 - (p none).toReal) +
              (1 - (p none).toReal) * Real.log (Fintype.card β)) : ℝ) :=
        entropyOption_le_ofNonNoneMass p
  exact le_trans hrate hpart

/-- Helper for Example 20.36: if the non-`none` region of an `Option β`-valued code has small
measure, then every normalized block entropy of that code is uniformly small. -/
private theorem normalizedOptionBlockEntropyRateLtOfNonNoneMeasureLt
    {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
    {τ : Ω → Ω} (hτ : MeasurePreserving τ P P) {β : Type*}
    [Fintype β] [MeasurableSpace (Option β)] [MeasurableSingletonClass (Option β)]
    [Countable (Option β)] {η : ℝ} (hη : 0 < η) :
    ∃ δ : ℝ, 0 < δ ∧
      ∀ (e : SimpleFunc Ω (Option β)) [IsProbabilityMeasure (Measure.map e P)],
        P {ω | e ω ≠ none} < ENNReal.ofReal δ →
        ∀ n : ℕ+,
          ((MeasurableFinpartition.ofSimpleFunc e).block τ hτ.measurable n).partitionEntropy P *
            (((n : ℕ) : EReal)⁻¹) < (η : EReal) := by
  let f : ℝ → ℝ := fun x ↦
    Real.negMulLog (1 - x) + Real.negMulLog x + x * Real.log (Fintype.card β)
  have hcont : Continuous f := by
    have hleft : Continuous fun x : ℝ ↦ Real.negMulLog (1 - x) := by
      simpa using
        (Real.continuous_negMulLog.comp
          (show Continuous fun x : ℝ ↦ 1 - x by
            simpa using (continuous_const.sub continuous_id')))
    have hright : Continuous fun x : ℝ ↦ Real.negMulLog x + x * Real.log (Fintype.card β) := by
      simpa using
        (Real.continuous_negMulLog.add
          (show Continuous fun x : ℝ ↦ x * Real.log (Fintype.card β) by
            simpa using (continuous_id'.mul continuous_const)))
    simpa [f, add_assoc] using hleft.add hright
  have hcont0 : ContinuousAt f 0 := hcont.continuousAt
  have hf_zero : f 0 = 0 := by
    simp [f]
  rcases Metric.continuousAt_iff.mp hcont0 η hη with ⟨δ, hδ_pos, hδ⟩
  refine ⟨δ, hδ_pos, ?_⟩
  intro e _ hrare n
  have hrate :=
    normalizedOptionBlockEntropyRate_le_entropyLaw
      (P := P) (hτ := hτ) (β := β) e n
  have hpnone_eq :
      (((Measure.map e P).toPMF) none).toReal = (P {ω | e ω = none}).toReal := by
    rw [Measure.toPMF_apply]
    rw [Measure.map_apply e.measurable (measurableSet_singleton none)]
    rfl
  have hprob_real :
      (P {ω | e ω = none}).toReal + (P {ω | e ω ≠ none}).toReal = 1 := by
    simpa [Set.compl_setOf, not_not] using
      probReal_add_probReal_compl (μ := P) (s := {ω | e ω = none}) (e.measurableSet_fiber none)
  have hmass :
      1 - (((Measure.map e P).toPMF none).toReal) = (P {ω | e ω ≠ none}).toReal := by
    linarith [hprob_real, hpnone_eq]
  have hx_lt : (1 - (((Measure.map e P).toPMF none).toReal)) < δ := by
    rw [hmass]
    exact ENNReal.toReal_lt_of_lt_ofReal hrare
  have hx_nonneg : 0 ≤ 1 - (((Measure.map e P).toPMF none).toReal) := by
    rw [hmass]
    exact ENNReal.toReal_nonneg
  have hx_abs : |1 - (((Measure.map e P).toPMF none).toReal)| < δ := by
    simpa [abs_of_nonneg hx_nonneg] using hx_lt
  have hsmall_dist :
      dist (f (1 - (((Measure.map e P).toPMF none).toReal))) (f 0) < η := by
    exact hδ (by simpa [Real.dist_eq] using hx_abs)
  have hsmall_abs :
      |f (1 - (((Measure.map e P).toPMF none).toReal)) - f 0| < η := by
    simpa [Real.dist_eq] using hsmall_dist
  have hsmall :
      f (1 - (((Measure.map e P).toPMF none).toReal)) < η :=
    by simpa [hf_zero] using (abs_lt.mp hsmall_abs).2
  have hsmall' :
      ((Real.negMulLog ((((Measure.map e P).toPMF) none).toReal) +
          Real.negMulLog (1 - (((Measure.map e P).toPMF none).toReal)) +
          (1 - (((Measure.map e P).toPMF none).toReal)) * Real.log (Fintype.card β)) : ℝ) < η := by
    simpa [f, add_comm, add_left_comm, add_assoc] using hsmall
  exact lt_of_le_of_lt hrate <| by
    exact EReal.coe_lt_coe_iff.mpr hsmall'

private theorem blockFactorEntropy_le_longBlockEntropy
    {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
    {τ : Ω → Ω} (hτ : Measurable τ) (part : MeasurableFinpartition Ω)
    {α : Type*} (g : SimpleFunc Ω α) {N : ℕ+} {ψ : (part.block τ hτ N).parts → α}
    (hg : g = fun ω ↦ ψ ((part.block τ hτ N).toSimpleFunc ω)) (n : ℕ+) :
    (((MeasurableFinpartition.ofSimpleFunc g).block τ hτ n).partitionEntropy P) ≤
      (part.block τ hτ (N + n - 1)).partitionEntropy P := by
  rcases blockFactor_of_block hτ part g hg n with ⟨Φ, hΦ⟩
  -- Proof comment: the exact factorization of the `g`-block through the long `part`-block lets
  -- us push entropy monotonicity through the deterministic factor map `Φ`.
  exact partitionEntropy_le_of_toSimpleFuncFactor P Φ hΦ

/-- Helper for Example 20.36: every normalized block term bounds the dynamical entropy of a fixed
finite measurable partition from above. -/
private theorem dynamicalEntropy_le_blockTerm
    {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
    (τ : Ω → Ω) (hτ : Measurable τ) (part : MeasurableFinpartition Ω) (n : ℕ+) :
    h(P, τ, hτ; part) ≤
      (part.block τ hτ n).partitionEntropy P * (((n : ℕ) : EReal)⁻¹) := by
  -- Proof comment: expose the chosen normalized block entropy as one element of the infimum
  -- range defining `h(P, τ, hτ; part)`.
  rw [MeasurableFinpartition.dynamicalEntropy_def]
  exact sInf_le (Set.mem_range.mpr ⟨n, rfl⟩)

/-- Helper for Example 20.36: block entropy is subadditive in the block length. -/
private theorem blockPartitionEntropy_add_le
    {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
    {τ : Ω → Ω} (hτ : MeasurePreserving τ P P) (part : MeasurableFinpartition Ω)
    (m n : ℕ+) :
    (part.block τ hτ.measurable (m + n)).partitionEntropy P ≤
      (part.block τ hτ.measurable m).partitionEntropy P +
        (part.block τ hτ.measurable n).partitionEntropy P := by
  classical
  let q : SimpleFunc Ω (Fin (m + n) → part.parts) :=
    prefixBlockCode τ hτ.measurable part (m + n)
  let g : SimpleFunc Ω (Fin m → part.parts) :=
    prefixBlockCode τ hτ.measurable part m
  let e : SimpleFunc Ω (Fin n → part.parts) :=
    (prefixBlockCode τ hτ.measurable part n).comp (τ^[m]) (Measurable.iterate hτ.measurable m)
  have hdecode :
      q = fun ω : Ω ↦ (Fin.append (g ω) (e ω) : Fin (m + n) → part.parts) := by
    -- Proof comment: an `(m + n)`-block splits into its initial `m` coordinates and the
    -- following `n` coordinates read after shifting by `m`.
    funext ω
    ext i
    cases i using Fin.addCases with
    | left i =>
        simp [q, g, prefixBlockCode, Fin.append_left]
    | right i =>
        simp [q, e, prefixBlockCode, Fin.append_right, Function.comp_apply,
          Function.iterate_add_apply, Nat.add_comm, Nat.add_left_comm, Nat.add_assoc]
  have hshiftEntropy :
      (MeasurableFinpartition.ofSimpleFunc e).partitionEntropy P =
        (part.block τ hτ.measurable n).partitionEntropy P := by
    let base : SimpleFunc Ω (Fin n → part.parts) := prefixBlockCode τ hτ.measurable part n
    letI : IsProbabilityMeasure (Measure.map e P) :=
      Measure.isProbabilityMeasure_map e.aemeasurable
    letI : IsProbabilityMeasure (Measure.map base P) :=
      Measure.isProbabilityMeasure_map base.aemeasurable
    have hmap : Measure.map e P = Measure.map base P := by
      -- Proof comment: the shifted `n`-block has the same law as the unshifted `n`-block because
      -- every iterate of `τ` preserves `P`.
      calc
        Measure.map e P = Measure.map base (Measure.map (τ^[m]) P) := by
          simpa [e, base, Function.comp] using
            (Measure.map_map base.measurable
              (Measurable.iterate hτ.measurable m) (μ := P)).symm
        _ = Measure.map base P := by
          rw [(hτ.iterate m).map_eq]
    have hpmf :
        (Measure.map e P).toPMF = (Measure.map base P).toPMF := by
      simpa [hmap]
    calc
      (MeasurableFinpartition.ofSimpleFunc e).partitionEntropy P =
          entropy ((Measure.map e P).toPMF) := by
        -- Proof comment: rewrite the shifted block code entropy to the entropy of its law.
        simpa [e] using (partitionEntropy_ofSimpleFunc_eq_entropy_law (P := P) (g := e))
      _ = entropy ((Measure.map base P).toPMF) := by
        rw [hpmf]
      _ = (MeasurableFinpartition.ofSimpleFunc base).partitionEntropy P := by
        symm
        simpa [base] using (partitionEntropy_ofSimpleFunc_eq_entropy_law (P := P) (g := base))
      _ = (part.block τ hτ.measurable n).partitionEntropy P := by
        rw [block_eq_ofSimpleFunc_prefixBlockCode (hτ := hτ.measurable) (part := part) (n := n)]
  have hdecodeEntropy :
      (MeasurableFinpartition.ofSimpleFunc q).partitionEntropy P ≤
        (MeasurableFinpartition.ofSimpleFunc g).partitionEntropy P +
          (MeasurableFinpartition.ofSimpleFunc e).partitionEntropy P := by
    have hblock :=
      blockPartitionEntropy_le_add_ofPointwiseDecode
        (P := P) (hτ := hτ.measurable) (q := q) (g := g) (e := e)
        (decode := Fin.append) hdecode (1 : ℕ+)
    -- Proof comment: apply the pointwise decoding inequality at block length `1`, where block
    -- entropy agrees with ordinary partition entropy.
    calc
      (MeasurableFinpartition.ofSimpleFunc q).partitionEntropy P =
          ((MeasurableFinpartition.ofSimpleFunc q).block τ hτ.measurable 1).partitionEntropy P := by
        symm
        exact blockPartitionEntropy_one_eq_partitionEntropy
          (P := P) (hτ := hτ) (part := MeasurableFinpartition.ofSimpleFunc q)
      _ ≤
          ((MeasurableFinpartition.ofSimpleFunc g).block τ hτ.measurable 1).partitionEntropy P +
            ((MeasurableFinpartition.ofSimpleFunc e).block τ hτ.measurable 1).partitionEntropy P := hblock
      _ =
          (MeasurableFinpartition.ofSimpleFunc g).partitionEntropy P +
            ((MeasurableFinpartition.ofSimpleFunc e).block τ hτ.measurable 1).partitionEntropy P := by
        rw [blockPartitionEntropy_one_eq_partitionEntropy
          (P := P) (hτ := hτ) (part := MeasurableFinpartition.ofSimpleFunc g)]
      _ =
          (MeasurableFinpartition.ofSimpleFunc g).partitionEntropy P +
            (MeasurableFinpartition.ofSimpleFunc e).partitionEntropy P := by
        rw [blockPartitionEntropy_one_eq_partitionEntropy
          (P := P) (hτ := hτ) (part := MeasurableFinpartition.ofSimpleFunc e)]
  calc
    (part.block τ hτ.measurable (m + n)).partitionEntropy P =
        (MeasurableFinpartition.ofSimpleFunc q).partitionEntropy P := by
      rw [block_eq_ofSimpleFunc_prefixBlockCode
        (hτ := hτ.measurable) (part := part) (n := m + n)]
      simp [q]
    _ ≤
        (MeasurableFinpartition.ofSimpleFunc g).partitionEntropy P +
          (MeasurableFinpartition.ofSimpleFunc e).partitionEntropy P := hdecodeEntropy
    _ =
        (MeasurableFinpartition.ofSimpleFunc g).partitionEntropy P +
          (part.block τ hτ.measurable n).partitionEntropy P := by
      rw [hshiftEntropy]
    _ =
        (part.block τ hτ.measurable m).partitionEntropy P +
          (part.block τ hτ.measurable n).partitionEntropy P := by
      rw [block_eq_ofSimpleFunc_prefixBlockCode (hτ := hτ.measurable) (part := part) (n := m)]

/-- Helper for Example 20.36: every block entropy is nonnegative because it is the Shannon
entropy of a finite pushed-forward law. -/
private theorem blockPartitionEntropy_nonneg
    {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
    {τ : Ω → Ω} (hτ : Measurable τ) (part : MeasurableFinpartition Ω) (n : ℕ+) :
    0 ≤ (part.block τ hτ n).partitionEntropy P := by
  -- Proof comment: unfold partition entropy to the entropy of the induced block law and apply the
  -- basic Shannon nonnegativity bound.
  rw [MeasurableFinpartition.partitionEntropy_def]
  exact entropy_nonneg _

/-- Helper for Example 20.36: a shifted long-block term with denominator `n` still dominates the
partition dynamical entropy. -/
private theorem shiftedBlockTermInf_le_dynamicalEntropy
    {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
    {τ : Ω → Ω} (hτ : MeasurePreserving τ P P) (part : MeasurableFinpartition Ω)
    (N n : ℕ+) :
    h(P, τ, hτ.measurable; part) ≤
      (part.block τ hτ.measurable (N + n - 1)).partitionEntropy P * (((n : ℕ) : EReal)⁻¹) := by
  have hbase :
      h(P, τ, hτ.measurable; part) ≤
        (part.block τ hτ.measurable (N + n - 1)).partitionEntropy P *
          ((((N + n - 1 : ℕ+) : ℕ) : EReal)⁻¹) :=
    dynamicalEntropy_le_blockTerm P τ hτ.measurable part (N + n - 1)
  have hnonneg :
      0 ≤ (part.block τ hτ.measurable (N + n - 1)).partitionEntropy P :=
    blockPartitionEntropy_nonneg P hτ.measurable part (N + n - 1)
  have hnat :
      (n : ℕ) ≤ ((N + n - 1 : ℕ+) : ℕ) := by
    have hm_pnat : n ≤ N + n - 1 := by
      exact PNat.le_sub_one_of_lt (PNat.lt_add_left n N)
    exact (PNat.coe_le_coe n (N + n - 1)).2 hm_pnat
  have hInv :
      ((((N + n - 1 : ℕ+) : ℕ) : EReal)⁻¹) ≤ (((n : ℕ) : EReal)⁻¹) := by
    -- Proof comment: enlarging the block length only decreases the reciprocal denominator.
    change ((((((N + n - 1 : ℕ+) : ℕ) : ℝ) : EReal)⁻¹) ≤
      ((((n : ℕ) : ℝ) : EReal)⁻¹))
    rw [← EReal.coe_inv, ← EReal.coe_inv]
    simpa [one_div] using
      (show 1 / ((((N + n - 1 : ℕ+) : ℕ) : ℝ)) ≤ 1 / ((n : ℕ) : ℝ) from
        one_div_le_one_div_of_le (by exact_mod_cast n.2) (by exact_mod_cast hnat))
  calc
    h(P, τ, hτ.measurable; part) ≤
        (part.block τ hτ.measurable (N + n - 1)).partitionEntropy P *
          ((((N + n - 1 : ℕ+) : ℕ) : EReal)⁻¹) :=
      hbase
    _ ≤ (part.block τ hτ.measurable (N + n - 1)).partitionEntropy P * (((n : ℕ) : EReal)⁻¹) := by
      -- Proof comment: replace the longer reciprocal denominator by the larger `1 / n`.
      exact mul_le_mul_of_nonneg_left hInv hnonneg

/-- Helper for Example 20.36: the Shannon entropy of a finite measurable partition is finite. -/
private theorem partitionEntropy_lt_top
    {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
    (part : MeasurableFinpartition Ω) :
    part.partitionEntropy P < ⊤ := by
  -- Proof comment: the law of a finite partition is a finite pmf, so its Shannon entropy is
  -- bounded by the logarithm of the finite alphabet size.
  rw [MeasurableFinpartition.partitionEntropy_def]
  exact lt_of_le_of_lt (entropy_le_log_card (part.toPMF P)) (by simp)

/-- Helper for Example 20.36: the entropy of a `k * m` block is controlled by `k` copies of the
`m`-block entropy. -/
private theorem blockPartitionEntropy_mul_le
    {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
    {τ : Ω → Ω} (hτ : MeasurePreserving τ P P) (part : MeasurableFinpartition Ω)
    (k m : ℕ+) :
    (part.block τ hτ.measurable (k * m)).partitionEntropy P ≤
      ((k : ℕ) : EReal) * (part.block τ hτ.measurable m).partitionEntropy P := by
  have hm_nonneg :
      0 ≤ (part.block τ hτ.measurable m).partitionEntropy P :=
    blockPartitionEntropy_nonneg P hτ.measurable part m
  refine PNat.recOn k ?_ ?_
  · -- Proof comment: the single multiple is exactly the original `m`-block, and the coefficient
    -- on the right is `1`.
    rw [one_mul]
    simp
  · intro k hk
    have hmul :
        ((k + 1) * m : ℕ+) = k * m + m := by
      apply PNat.coe_injective
      simp [Nat.succ_eq_add_one, Nat.add_assoc, Nat.add_left_comm, Nat.add_comm,
        Nat.left_distrib, Nat.right_distrib]
    calc
      (part.block τ hτ.measurable ((k + 1) * m)).partitionEntropy P =
          (part.block τ hτ.measurable (k * m + m)).partitionEntropy P := by
        rw [hmul]
      _ ≤
          (part.block τ hτ.measurable (k * m)).partitionEntropy P +
            (part.block τ hτ.measurable m).partitionEntropy P :=
        blockPartitionEntropy_add_le (P := P) (hτ := hτ) (part := part) (k * m) m
      _ ≤
          ((k : ℕ) : EReal) * (part.block τ hτ.measurable m).partitionEntropy P +
            (part.block τ hτ.measurable m).partitionEntropy P := by
        gcongr
      _ =
          ((((k : ℕ) + 1 : ℕ) : EReal) * (part.block τ hτ.measurable m).partitionEntropy P) := by
        -- Proof comment: rewrite the two summands as one factor times `k + 1` using the
        -- nonnegative distributivity rule available for `EReal`.
        calc
          ((k : ℕ) : EReal) * (part.block τ hτ.measurable m).partitionEntropy P +
              (part.block τ hτ.measurable m).partitionEntropy P =
              ((k : ℕ) : EReal) * (part.block τ hτ.measurable m).partitionEntropy P +
                (part.block τ hτ.measurable m).partitionEntropy P * 1 := by
            rw [mul_one]
          _ =
              (part.block τ hτ.measurable m).partitionEntropy P *
                ((((k : ℕ) + 1 : ℕ) : EReal)) := by
            calc
              ((k : ℕ) : EReal) * (part.block τ hτ.measurable m).partitionEntropy P +
                  (part.block τ hτ.measurable m).partitionEntropy P * 1 =
                  (part.block τ hτ.measurable m).partitionEntropy P * ((k : ℕ) : EReal) +
                    (part.block τ hτ.measurable m).partitionEntropy P * 1 := by
                rw [mul_comm (((k : ℕ) : EReal))]
              _ =
                  (part.block τ hτ.measurable m).partitionEntropy P *
                    (((k : ℕ) : EReal) + 1) := by
                symm
                exact EReal.left_distrib_of_nonneg (by positivity) (by positivity)
              _ = (part.block τ hτ.measurable m).partitionEntropy P *
                    ((((k : ℕ) + 1 : ℕ) : EReal)) := by
                norm_num
          _ =
              ((((k : ℕ) + 1 : ℕ) : EReal) * (part.block τ hτ.measurable m).partitionEntropy P) := by
            rw [mul_comm]
      _ =
          (((k + 1 : ℕ+) : ℕ) : EReal) * (part.block τ hτ.measurable m).partitionEntropy P := by
        norm_num

/-- Helper for Example 20.36: normalized block entropy does not increase when the block length is
replaced by a positive multiple. -/
private theorem normalizedBlockEntropyRate_mul_le
    {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
    {τ : Ω → Ω} (hτ : MeasurePreserving τ P P) (part : MeasurableFinpartition Ω)
    (k m : ℕ+) :
    (part.block τ hτ.measurable (k * m)).partitionEntropy P *
        ((((k * m : ℕ)) : EReal)⁻¹) ≤
      (part.block τ hτ.measurable m).partitionEntropy P * (((m : ℕ) : EReal)⁻¹) := by
  have hmul :=
    blockPartitionEntropy_mul_le (P := P) (hτ := hτ) (part := part) k m
  have hinv_nonneg : 0 ≤ ((((k * m : ℕ)) : EReal)⁻¹) := by
    positivity
  have hcoeff :
      ((k : ℕ) : EReal) * ((((k * m : ℕ)) : EReal)⁻¹) = (((m : ℕ) : EReal)⁻¹) := by
    have hk_real_ne : ((k : ℕ) : ℝ) ≠ 0 := by
      exact_mod_cast k.ne_zero
    have hm_real_ne : ((m : ℕ) : ℝ) ≠ 0 := by
      exact_mod_cast m.ne_zero
    have hmul_real :
        ((k * m : ℕ) : ℝ) = ((k : ℕ) : ℝ) * ((m : ℕ) : ℝ) := by
      exact_mod_cast (show ((k * m : ℕ+) : ℕ) = (k : ℕ) * (m : ℕ) by rfl)
    have hcoeff_real :
        ((k : ℕ) : ℝ) * (((k * m : ℕ) : ℝ)⁻¹) = (((m : ℕ) : ℝ)⁻¹) := by
      rw [hmul_real]
      field_simp [hk_real_ne, hm_real_ne]
    calc
      ((k : ℕ) : EReal) * ((((k * m : ℕ)) : EReal)⁻¹) =
          ((((k : ℕ) : ℝ) : EReal) * ((((k * m : ℕ) : ℝ) : EReal)⁻¹)) := by
        norm_num [hmul_real]
      _ = ((((k : ℕ) : ℝ) * (((k * m : ℕ) : ℝ)⁻¹) : ℝ) : EReal) := by
        rw [← EReal.coe_inv, ← EReal.coe_mul]
      _ = (((((m : ℕ) : ℝ)⁻¹ : ℝ) : EReal)) := by
        exact_mod_cast hcoeff_real
      _ = (((m : ℕ) : EReal)⁻¹) := by
        simpa using (EReal.coe_inv (((m : ℕ) : ℝ))).symm
  calc
    (part.block τ hτ.measurable (k * m)).partitionEntropy P * ((((k * m : ℕ)) : EReal)⁻¹) ≤
        (((k : ℕ) : EReal) * (part.block τ hτ.measurable m).partitionEntropy P) *
          ((((k * m : ℕ)) : EReal)⁻¹) := by
      exact mul_le_mul_of_nonneg_right hmul hinv_nonneg
    _ =
        (part.block τ hτ.measurable m).partitionEntropy P *
          (((k : ℕ) : EReal) * ((((k * m : ℕ)) : EReal)⁻¹)) := by
      ac_rfl
    _ =
        (part.block τ hτ.measurable m).partitionEntropy P * (((m : ℕ) : EReal)⁻¹) := by
      rw [hcoeff]

/-- Helper for Example 20.36: adding `t` prefix coordinates costs at most `t` copies of the
one-step partition entropy. -/
private theorem blockPartitionEntropy_prefixNat_le
    {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
    {τ : Ω → Ω} (hτ : MeasurePreserving τ P P) (part : MeasurableFinpartition Ω)
    (t : ℕ) (n : ℕ+) :
    (part.block τ hτ.measurable ⟨t + n, Nat.add_pos_right t n.2⟩).partitionEntropy P ≤
      ((t : ℕ) : EReal) * part.partitionEntropy P +
        (part.block τ hτ.measurable n).partitionEntropy P := by
  have hpart_nonneg : 0 ≤ part.partitionEntropy P := by
    rw [MeasurableFinpartition.partitionEntropy_def]
    exact entropy_nonneg _
  induction t with
  | zero =>
      -- Proof comment: with no prefix, there is nothing to pay beyond the original `n`-block.
      have hzero : (⟨0 + n, Nat.add_pos_right 0 n.2⟩ : ℕ+) = n := by
        apply PNat.coe_injective
        simp
      rw [hzero]
      simp
  | succ t ih =>
      let n' : ℕ+ := ⟨t + n, Nat.add_pos_right t n.2⟩
      have hindex :
          (⟨Nat.succ t + n, Nat.add_pos_right _ n.2⟩ : ℕ+) = n' + (1 : ℕ+) := by
        apply PNat.coe_injective
        simp [n', Nat.succ_eq_add_one, Nat.add_assoc, Nat.add_left_comm, Nat.add_comm]
      calc
        (part.block τ hτ.measurable ⟨Nat.succ t + n, Nat.add_pos_right _ n.2⟩).partitionEntropy P =
            (part.block τ hτ.measurable (n' + (1 : ℕ+))).partitionEntropy P := by
          rw [hindex]
        _ ≤
            part.partitionEntropy P + (part.block τ hτ.measurable n').partitionEntropy P :=
          blockPartitionEntropy_succ_le_add_partitionEntropy
            (P := P) (hτ := hτ) (part := part) n'
        _ ≤ part.partitionEntropy P +
            (((t : ℕ) : EReal) * part.partitionEntropy P +
              (part.block τ hτ.measurable n).partitionEntropy P) := by
          have hih :
              (part.block τ hτ.measurable n').partitionEntropy P ≤
                ((t : ℕ) : EReal) * part.partitionEntropy P +
                  (part.block τ hτ.measurable n).partitionEntropy P := by
            simpa [n'] using ih
          simpa [add_assoc, add_left_comm, add_comm] using
            add_le_add_left hih (part.partitionEntropy P)
        _ =
            (((Nat.succ t : ℕ) : EReal) * part.partitionEntropy P) +
              (part.block τ hτ.measurable n).partitionEntropy P := by
          -- Proof comment: regroup the two prefix-entropy summands before reassembling them as
          -- one copy of `(t + 1) * H(part)`.
          have hprefix_combine :
              part.partitionEntropy P + ((t : ℕ) : EReal) * part.partitionEntropy P =
                ((Nat.succ t : ℕ) : EReal) * part.partitionEntropy P := by
            calc
              part.partitionEntropy P + ((t : ℕ) : EReal) * part.partitionEntropy P =
                  (1 : EReal) * part.partitionEntropy P + ((t : ℕ) : EReal) * part.partitionEntropy P := by
                rw [one_mul]
              _ =
                  ((1 : EReal) + ((t : ℕ) : EReal)) * part.partitionEntropy P := by
                symm
                exact EReal.right_distrib_of_nonneg (by positivity) (by positivity)
              _ = ((Nat.succ t : ℕ) : EReal) * part.partitionEntropy P := by
                congr 1
                norm_num [Nat.succ_eq_add_one, add_comm]
          calc
            part.partitionEntropy P +
                (((t : ℕ) : EReal) * part.partitionEntropy P +
                  (part.block τ hτ.measurable n).partitionEntropy P) =
                (part.partitionEntropy P +
                    ((t : ℕ) : EReal) * part.partitionEntropy P) +
                  (part.block τ hτ.measurable n).partitionEntropy P := by
              ac_rfl
            _ =
                (((Nat.succ t : ℕ) : EReal) * part.partitionEntropy P) +
                  (part.block τ hτ.measurable n).partitionEntropy P := by
              rw [hprefix_combine]

/-- Helper for Example 20.36: a shifted long-block rate is bounded by the matching unshifted block
rate plus the finite entropy cost of the fixed prefix. -/
private theorem shiftedBlockEntropyRate_le_blockRate_add_prefixTail
    {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
    {τ : Ω → Ω} (hτ : MeasurePreserving τ P P) (part : MeasurableFinpartition Ω)
    (N n : ℕ+) :
    (part.block τ hτ.measurable (N + n - 1)).partitionEntropy P * (((n : ℕ) : EReal)⁻¹) ≤
      (part.block τ hτ.measurable n).partitionEntropy P * (((n : ℕ) : EReal)⁻¹) +
        ((((N : ℕ) - 1 : ℕ) : EReal) * part.partitionEntropy P) * (((n : ℕ) : EReal)⁻¹) := by
  let t : ℕ := (N : ℕ) - 1
  have hindex :
      (N + n - 1 : ℕ+) = ⟨t + n, Nat.add_pos_right t n.2⟩ := by
    apply PNat.coe_injective
    dsimp [t]
    pnat_to_nat
    omega
  have hprefix :=
    blockPartitionEntropy_prefixNat_le (P := P) (hτ := hτ) (part := part) t n
  have hinv_nonneg : 0 ≤ (((n : ℕ) : EReal)⁻¹) := by
    positivity
  have hpart_nonneg : 0 ≤ part.partitionEntropy P := by
    rw [MeasurableFinpartition.partitionEntropy_def]
    exact entropy_nonneg _
  have hprefix_nonneg :
      0 ≤ ((t : ℕ) : EReal) * part.partitionEntropy P := by
    exact mul_nonneg (by positivity) hpart_nonneg
  have hblock_nonneg :
      0 ≤ (part.block τ hτ.measurable n).partitionEntropy P :=
    blockPartitionEntropy_nonneg P hτ.measurable part n
  calc
    (part.block τ hτ.measurable (N + n - 1)).partitionEntropy P * (((n : ℕ) : EReal)⁻¹) =
        (part.block τ hτ.measurable ⟨t + n, Nat.add_pos_right t n.2⟩).partitionEntropy P *
          (((n : ℕ) : EReal)⁻¹) := by
      rw [hindex]
    _ ≤
        ((((t : ℕ) : EReal) * part.partitionEntropy P +
            (part.block τ hτ.measurable n).partitionEntropy P) * (((n : ℕ) : EReal)⁻¹)) := by
      exact mul_le_mul_of_nonneg_right hprefix hinv_nonneg
    _ =
        ((((t : ℕ) : EReal) * part.partitionEntropy P) * (((n : ℕ) : EReal)⁻¹)) +
          ((part.block τ hτ.measurable n).partitionEntropy P * (((n : ℕ) : EReal)⁻¹)) := by
      exact EReal.right_distrib_of_nonneg hprefix_nonneg hblock_nonneg
    _ =
        (part.block τ hτ.measurable n).partitionEntropy P * (((n : ℕ) : EReal)⁻¹) +
          ((((N : ℕ) - 1 : ℕ) : EReal) * part.partitionEntropy P) * (((n : ℕ) : EReal)⁻¹) := by
      dsimp [t]
      rw [add_comm]

/-- Helper for Example 20.36: a finite nonnegative entropy coefficient can be made arbitrarily
small after multiplying by the reciprocal of a large positive integer. -/
private theorem exists_pnat_mul_inv_lt_of_lt
    {A : EReal} (hA_nonneg : 0 ≤ A) (hA_top : A < ⊤) {w : ℝ} (hw : 0 < w) :
    ∃ k : ℕ+, A * (((k : ℕ) : EReal)⁻¹) < (w : EReal) := by
  by_cases hA_zero : A = 0
  · refine ⟨1, ?_⟩
    simpa [hA_zero] using hw
  have hA_bot : A ≠ ⊥ := by
    intro hA_bot
    simpa [hA_bot] using hA_nonneg
  have hA_pos : 0 < A := by
    exact lt_of_le_of_ne hA_nonneg (by simpa [eq_comm] using hA_zero)
  have hA_real_pos : 0 < A.toReal := EReal.toReal_pos hA_pos hA_top.ne
  obtain ⟨m, hm⟩ := exists_nat_one_div_lt (show 0 < w / A.toReal by
    exact div_pos hw hA_real_pos)
  let k : ℕ+ := ⟨m + 1, Nat.succ_pos _⟩
  refine ⟨k, ?_⟩
  have hreal :
      A.toReal * (1 / ((k : ℕ) : ℝ)) < w := by
    calc
      A.toReal * (1 / ((k : ℕ) : ℝ)) < A.toReal * (w / A.toReal) := by
        exact mul_lt_mul_of_pos_left (by simpa [k] using hm) hA_real_pos
      _ = w := by
        field_simp [hA_real_pos.ne']
  have hEq :
      A * (((k : ℕ) : EReal)⁻¹) = ((A.toReal * (1 / ((k : ℕ) : ℝ)) : ℝ) : EReal) := by
    rw [← EReal.coe_toReal hA_top.ne hA_bot]
    have hInv :
        (((k : ℕ) : EReal)⁻¹) = ((((k : ℝ))⁻¹ : ℝ) : EReal) := by
      rw [show ((k : ℕ) : EReal) = ((k : ℝ) : EReal) by norm_num]
      rw [← EReal.coe_inv (k : ℝ)]
    rw [hInv, ← EReal.coe_mul]
    norm_num [one_div]
  rw [hEq]
  exact_mod_cast hreal

/-- Helper for Example 20.36: from `h(P, τ; part) < u`, one can choose a shifted long block term
with the same denominator convention that is still below `u`. -/
private theorem existsShiftedLongBlockRateLt
    {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
    {τ : Ω → Ω} (hτ : MeasurePreserving τ P P) (part : MeasurableFinpartition Ω)
    (N : ℕ+) {u : ℝ} (hu : h(P, τ, hτ.measurable; part) < (u : EReal)) :
    ∃ n : ℕ+,
      (part.block τ hτ.measurable (N + n - 1)).partitionEntropy P * (((n : ℕ) : EReal)⁻¹) <
        (u : EReal) := by
  rw [MeasurableFinpartition.dynamicalEntropy_def] at hu
  rcases sInf_lt_iff.mp hu with ⟨_, ⟨m, rfl⟩, hm_lt_u⟩
  obtain ⟨v, hm_lt_v, hv_lt_u⟩ := EReal.exists_between_coe_real hm_lt_u
  have huv_pos : 0 < u - v := by
    have hvu : v < u := by
      exact_mod_cast hv_lt_u
    linarith
  have hpart_nonneg : 0 ≤ part.partitionEntropy P := by
    rw [MeasurableFinpartition.partitionEntropy_def]
    exact entropy_nonneg _
  let A : EReal := ((((N : ℕ) - 1 : ℕ) : EReal) * part.partitionEntropy P)
  have hA_nonneg : 0 ≤ A := by
    dsimp [A]
    exact mul_nonneg (by positivity) hpart_nonneg
  have hA_top : A < ⊤ := by
    rw [lt_top_iff_ne_top]
    dsimp [A]
    have hNat_ne_top : ((((N : ℕ) - 1 : ℕ) : EReal) ≠ ⊤) := by
      change (((((N : ℕ) - 1 : ℕ) : ℝ) : EReal) ≠ ⊤)
      exact EReal.coe_ne_top ((((N : ℕ) - 1 : ℕ) : ℝ))
    exact (EReal.mul_ne_top _ _).2 ⟨Or.inr hpart_nonneg, Or.inl (by positivity),
      Or.inl hNat_ne_top, Or.inr (partitionEntropy_lt_top P part).ne⟩
  rcases exists_pnat_mul_inv_lt_of_lt hA_nonneg hA_top huv_pos with ⟨k, hk_tail⟩
  let n : ℕ+ := k * m
  have hmain :
      (part.block τ hτ.measurable n).partitionEntropy P * (((n : ℕ) : EReal)⁻¹) <
        (v : EReal) := by
    have hmul_rate :=
      normalizedBlockEntropyRate_mul_le (P := P) (hτ := hτ) (part := part) k m
    exact lt_of_le_of_lt (by simpa [n] using hmul_rate) hm_lt_v
  have htail_le :
      A * (((n : ℕ) : EReal)⁻¹) ≤ A * (((k : ℕ) : EReal)⁻¹) := by
    have hnat : (k : ℕ) ≤ (n : ℕ) := by
      dsimp [n]
      have hm_one : 1 ≤ (m : ℕ) := by exact_mod_cast m.2
      have hmul : (k : ℕ) * 1 ≤ (k : ℕ) * (m : ℕ) := Nat.mul_le_mul_left _ hm_one
      simpa [Nat.mul_one] using hmul
    have hInv :
        (((n : ℕ) : EReal)⁻¹) ≤ (((k : ℕ) : EReal)⁻¹) := by
      change (((((n : ℕ) : ℝ) : EReal)⁻¹) ≤ ((((k : ℕ) : ℝ) : EReal)⁻¹))
      rw [← EReal.coe_inv, ← EReal.coe_inv]
      simpa [one_div] using
        (show 1 / ((n : ℕ) : ℝ) ≤ 1 / ((k : ℕ) : ℝ) from
          one_div_le_one_div_of_le (by exact_mod_cast k.2) (by exact_mod_cast hnat))
    exact mul_le_mul_of_nonneg_left hInv hA_nonneg
  have htail :
      A * (((n : ℕ) : EReal)⁻¹) < ((u - v : ℝ) : EReal) := by
    exact lt_of_le_of_lt htail_le (by simpa [n] using hk_tail)
  refine ⟨n, ?_⟩
  have hshift :=
    shiftedBlockEntropyRate_le_blockRate_add_prefixTail (P := P) (hτ := hτ) (part := part) N n
  calc
    (part.block τ hτ.measurable (N + n - 1)).partitionEntropy P * (((n : ℕ) : EReal)⁻¹) ≤
        (part.block τ hτ.measurable n).partitionEntropy P * (((n : ℕ) : EReal)⁻¹) +
          A * (((n : ℕ) : EReal)⁻¹) := by
      simpa [A] using hshift
    _ < (v : EReal) + (((u - v : ℝ) : EReal)) := EReal.add_lt_add hmain htail
    _ = (u : EReal) := by
      exact_mod_cast (show v + (u - v) = u by ring)

/-- Helper for Example 20.36: every competitor partition should be dominated by a generating
partition once the approximation-by-block and rare-error bounds are in place. -/
private theorem competitorDynamicalEntropy_le_generator
    {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
    {τ : Ω → Ω} (hτ : MeasurePreserving τ P P) (part : MeasurableFinpartition Ω)
    (hgen : is_generator τ part) (q : MeasurableFinpartition Ω) :
    h(P, τ, hτ.measurable; q) ≤ h(P, τ, hτ.measurable; part) := by
  -- Route correction: the missing frontier is the long-block rate comparison, not the decoding
  -- package. We now combine the existing decoded long-block factor with the new shifted-rate
  -- lemma to contradict any strict entropy gap.
  letI : MeasurableSpace (Option q.parts) := ⊤
  letI : MeasurableSingletonClass (Option q.parts) := {
    measurableSet_singleton := by
      intro x
      trivial
  }
  letI : Countable (Option q.parts) := by
    infer_instance
  have hsmallError :
      ∀ {η : ℝ}, 0 < η →
        ∃ δ : ℝ, 0 < δ ∧
          ∀ (e : SimpleFunc Ω (Option q.parts)) [IsProbabilityMeasure (Measure.map e P)],
            P {ω | e ω ≠ none} < ENNReal.ofReal δ →
            ∀ n : ℕ+,
              ((MeasurableFinpartition.ofSimpleFunc e).block τ hτ.measurable n).partitionEntropy P *
                (((n : ℕ) : EReal)⁻¹) < (η : EReal) := by
    intro η hη
    exact normalizedOptionBlockEntropyRateLtOfNonNoneMeasureLt
      (P := P) (hτ := hτ) (β := q.parts) hη
  by_contra hq
  have hgap : h(P, τ, hτ.measurable; part) < h(P, τ, hτ.measurable; q) :=
    lt_of_not_ge hq
  obtain ⟨u, hu_part, hu_q⟩ := EReal.exists_between_coe_real hgap
  obtain ⟨v, hv_part, hv_u⟩ := EReal.exists_between_coe_real hu_part
  have huv_pos : 0 < u - v := by
    exact sub_pos.mpr (EReal.coe_lt_coe_iff.mp hv_u)
  obtain ⟨δ, hδ_pos, hδ_small⟩ := hsmallError huv_pos
  rcases existsDecodedBlockCodeWithSmallError
      (P := P) (hτ := hτ.measurable) (part := part) hgen q hδ_pos with
    ⟨N, ψ, e, hdecode, hrare⟩
  obtain ⟨n, hnlt⟩ :=
    existsShiftedLongBlockRateLt (P := P) (hτ := hτ) (part := part) N hv_part
  let g : SimpleFunc Ω q.parts :=
    (part.block τ hτ.measurable N).toSimpleFunc.map ψ
  have hg_factor :
      g = fun ω ↦ ψ ((part.block τ hτ.measurable N).toSimpleFunc ω) := by
    funext ω
    rfl
  have hg_norm_lt :
      ((MeasurableFinpartition.ofSimpleFunc g).block τ hτ.measurable n).partitionEntropy P *
          (((n : ℕ) : EReal)⁻¹) <
        (v : EReal) := by
    have hg_long :
        ((MeasurableFinpartition.ofSimpleFunc g).block τ hτ.measurable n).partitionEntropy P ≤
          (part.block τ hτ.measurable (N + n - 1)).partitionEntropy P :=
      blockFactorEntropy_le_longBlockEntropy
        (P := P) (hτ := hτ.measurable) (part := part) (g := g) (ψ := ψ) hg_factor n
    have hinv_nonneg : 0 ≤ (((n : ℕ) : EReal)⁻¹) := by
      positivity
    have hnorm_le :
        ((MeasurableFinpartition.ofSimpleFunc g).block τ hτ.measurable n).partitionEntropy P *
            (((n : ℕ) : EReal)⁻¹) ≤
          (part.block τ hτ.measurable (N + n - 1)).partitionEntropy P * (((n : ℕ) : EReal)⁻¹) := by
      exact mul_le_mul_of_nonneg_right hg_long hinv_nonneg
    exact lt_of_le_of_lt hnorm_le hnlt
  have he_norm_lt :
      ((MeasurableFinpartition.ofSimpleFunc e).block τ hτ.measurable n).partitionEntropy P *
          (((n : ℕ) : EReal)⁻¹) <
        ((u - v : ℝ) : EReal) := by
    letI : IsProbabilityMeasure (Measure.map e P) :=
      Measure.isProbabilityMeasure_map e.aemeasurable
    exact hδ_small e hrare n
  have hdecode_block :=
    blockPartitionEntropy_le_add_ofPointwiseDecode
      (P := P) (hτ := hτ.measurable) (q := q.toSimpleFunc) (g := g) (e := e)
      (decode := fun a o ↦ Option.elim o a id) hdecode n
  have hinv_nonneg : 0 ≤ (((n : ℕ) : EReal)⁻¹) := by
    positivity
  have hgnonneg :
      0 ≤ ((MeasurableFinpartition.ofSimpleFunc g).block τ hτ.measurable n).partitionEntropy P :=
    blockPartitionEntropy_nonneg P hτ.measurable (MeasurableFinpartition.ofSimpleFunc g) n
  have henonneg :
      0 ≤ ((MeasurableFinpartition.ofSimpleFunc e).block τ hτ.measurable n).partitionEntropy P :=
    blockPartitionEntropy_nonneg P hτ.measurable (MeasurableFinpartition.ofSimpleFunc e) n
  have hcontr : h(P, τ, hτ.measurable; q) < h(P, τ, hτ.measurable; q) := by
    let qCode : SimpleFunc Ω (Fin n → q.parts) := prefixBlockCode τ hτ.measurable q n
    letI : IsProbabilityMeasure (Measure.map qCode P) :=
      Measure.isProbabilityMeasure_map qCode.aemeasurable
    letI :
        IsProbabilityMeasure
          (Measure.map (fun ω : Ω ↦ fun i : Fin n ↦ q.toSimpleFunc ((τ^[i]) ω)) P) := by
      simpa [qCode, prefixBlockCode] using
        (show IsProbabilityMeasure (Measure.map qCode P) from inferInstance)
    have hq_block_entropy :
        (q.block τ hτ.measurable n).partitionEntropy P =
          ((MeasurableFinpartition.ofSimpleFunc q.toSimpleFunc).block τ hτ.measurable n).partitionEntropy P := by
      calc
        (q.block τ hτ.measurable n).partitionEntropy P =
            entropy ((Measure.map qCode P).toPMF) := by
          rw [block_eq_ofSimpleFunc_prefixBlockCode (hτ := hτ.measurable) (part := q) (n := n)]
          simpa [qCode] using (partitionEntropy_ofSimpleFunc_eq_entropy_law (P := P) (g := qCode))
        _ =
            ((MeasurableFinpartition.ofSimpleFunc q.toSimpleFunc).block τ hτ.measurable n).partitionEntropy P := by
          symm
          simpa [qCode, prefixBlockCode] using
            (blockPartitionEntropy_ofSimpleFunc_eq_entropy_valueBlockLaw
              (μ := P) (hτ := hτ.measurable) (g := q.toSimpleFunc) (n := n))
    calc
      h(P, τ, hτ.measurable; q) ≤
          (q.block τ hτ.measurable n).partitionEntropy P * (((n : ℕ) : EReal)⁻¹) :=
        dynamicalEntropy_le_blockTerm P τ hτ.measurable q n
      _ =
          ((MeasurableFinpartition.ofSimpleFunc q.toSimpleFunc).block τ hτ.measurable n).partitionEntropy P *
            (((n : ℕ) : EReal)⁻¹) := by
        rw [hq_block_entropy]
      _ ≤
          (((MeasurableFinpartition.ofSimpleFunc g).block τ hτ.measurable n).partitionEntropy P +
              ((MeasurableFinpartition.ofSimpleFunc e).block τ hτ.measurable n).partitionEntropy P) *
            (((n : ℕ) : EReal)⁻¹) := by
        exact mul_le_mul_of_nonneg_right hdecode_block hinv_nonneg
      _ =
          ((MeasurableFinpartition.ofSimpleFunc g).block τ hτ.measurable n).partitionEntropy P *
              (((n : ℕ) : EReal)⁻¹) +
            ((MeasurableFinpartition.ofSimpleFunc e).block τ hτ.measurable n).partitionEntropy P *
              (((n : ℕ) : EReal)⁻¹) := by
        exact EReal.right_distrib_of_nonneg hgnonneg henonneg
      _ < (v : EReal) + ((u - v : ℝ) : EReal) := by
        exact EReal.add_lt_add hg_norm_lt he_norm_lt
      _ = (u : EReal) := by
        exact_mod_cast (show v + (u - v) = u by ring)
      _ < h(P, τ, hτ.measurable; q) := hu_q
  exact lt_irrefl _ hcontr

/-- Helper for Example 20.36: if `part` is a generator for the measurable space under `τ`, then
the Kolmogorov--Sinai entropy equals the dynamical entropy of `part`. -/
private theorem kolmogorovSinai_eq_dynamicalEntropy_of_generator
    {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
    {τ : Ω → Ω} (hτ : MeasurePreserving τ P P) (part : MeasurableFinpartition Ω)
    (hgen : is_generator τ part) :
    h(P, τ, hτ.measurable) = h(P, τ, hτ.measurable; part) := by
  -- Proof comment: the easy inequality comes directly from the defining supremum. The remaining
  -- direction is the generator comparison for arbitrary competitor partitions.
  refine le_antisymm ?_ (dynamicalEntropy_le_kolmogorovSinai P τ hτ.measurable part)
  -- Proof comment: after rewriting the Kolmogorov--Sinai entropy as a supremum, it suffices to
  -- dominate each competitor partition by the generating partition `part`.
  rw [kolmogorov_sinai_entropy_def]
  refine sSup_le ?_
  rintro _ ⟨q, rfl⟩
  exact competitorDynamicalEntropy_le_generator P hτ part hgen q

-- Proof sketch: `MeasurableFinpartition.block` is the canonical joined partition from
-- Definition 20.34, while `unitAddCircleHalfBlockCode` is the same block data viewed through the
-- textbook Boolean coding of the two half-circle atoms.
-- Route correction: keep a local copy of the transparent block code because the owner
-- `MeasurableFinpartition.blockCode` is private in `Definition_20_34`.
/-- Helper for Example 20.36: the explicit Boolean itinerary is the coordinatewise relabeling of
the transparent block code of the canonical half partition. -/
private theorem unitAddCircleHalfBlockCode_eq_labelPrefixBlockCode (r : ℝ) (n : ℕ+) :
    (unitAddCircleHalfBlockCode r n : UnitAddCircle → Fin n → Bool) =
      fun x ↦
        unitAddCircleHalfPartitionWordLabel n
          (prefixBlockCode ((· + (r : UnitAddCircle)))
            (measurePreserving_add_right volume (r : UnitAddCircle)).measurable
            unitAddCircleHalfPartition n x) := by
  letI : DecidablePred fun y : UnitAddCircle ↦ y ∈ unitAddCircleRightHalf := Classical.decPred _
  funext x
  ext i
  -- Proof comment: each coordinate is just the Boolean label of the half-partition atom visited
  -- at time `i`, so we reduce to the two explicit atoms of `unitAddCircleHalfPartition`.
  let y : UnitAddCircle := (((· + (r : UnitAddCircle)))^[i]) x
  simp only [unitAddCircleHalfBlockCode, unitAddCircleHalfPartitionWordLabel, prefixBlockCode, y]
  have hiff :
      y ∈ unitAddCircleRightHalf ↔
        ↑(unitAddCircleHalfPartition.toSimpleFunc y) = unitAddCircleRightHalfSet := by
    constructor
    · intro hy
      exact congrArg Subtype.val <|
        (mem_atom_iff_toSimpleFunc_eq unitAddCircleHalfPartition
          (A := ⟨unitAddCircleRightHalfSet, unitAddCircleRightHalf_mem_parts⟩) (ω := y)).mp <|
          by simpa [unitAddCircleRightHalfSet] using hy
    · intro hEq
      exact (mem_atom_iff_toSimpleFunc_eq unitAddCircleHalfPartition
        (A := ⟨unitAddCircleRightHalfSet, unitAddCircleRightHalf_mem_parts⟩) (ω := y)).mpr <|
          by
            apply Subtype.ext
            exact hEq
  simpa [y, unitAddCircleHalfPartitionAtomToBool] using hiff

/-- The canonical block partition of the half-circle partition has exactly the same distinct
length-`n` words as the textbook binary coding. -/
private theorem unitAddCircleHalfPartition_block_proj (r : ℝ) (n : ℕ+) :
    Nat.card ↥((unitAddCircleHalfPartition.block
      ((· + (r : UnitAddCircle)))
      (measurePreserving_add_right volume (r : UnitAddCircle)).measurable n).parts) =
      Nat.card ↥(Set.range (unitAddCircleHalfBlockCode r n)) := by
  -- Proof comment: first identify the owner block partition with the transparent prefix code, then
  -- use injective Boolean relabeling to transport the cardinality to the textbook itinerary.
  calc
    Nat.card ↥((unitAddCircleHalfPartition.block
        ((· + (r : UnitAddCircle)))
        (measurePreserving_add_right volume (r : UnitAddCircle)).measurable n).parts) =
        Nat.card ↥(Set.range
          (prefixBlockCode ((· + (r : UnitAddCircle)))
            (measurePreserving_add_right volume (r : UnitAddCircle)).measurable
            unitAddCircleHalfPartition n)) := by
          simpa [block_eq_ofSimpleFunc_prefixBlockCode
            (measurePreserving_add_right volume (r : UnitAddCircle)).measurable
            unitAddCircleHalfPartition n] using
            (Nat.card_congr
              (ofSimpleFuncRangeEquivParts
                (prefixBlockCode ((· + (r : UnitAddCircle)))
                  (measurePreserving_add_right volume (r : UnitAddCircle)).measurable
                  unitAddCircleHalfPartition n)).symm)
    _ = Nat.card ↥(Set.range
          (fun x ↦
            unitAddCircleHalfPartitionWordLabel n
              (prefixBlockCode ((· + (r : UnitAddCircle)))
                (measurePreserving_add_right volume (r : UnitAddCircle)).measurable
                unitAddCircleHalfPartition n x))) := by
            exact Nat.card_congr <|
              rangeEquivCompOfInjective
                (prefixBlockCode ((· + (r : UnitAddCircle)))
                  (measurePreserving_add_right volume (r : UnitAddCircle)).measurable
                  unitAddCircleHalfPartition n)
                (unitAddCircleHalfPartitionWordLabel n)
                (unitAddCircleHalfPartitionWordLabel_injective n)
    _ = Nat.card ↥(Set.range (unitAddCircleHalfBlockCode r n)) := by
          rw [unitAddCircleHalfBlockCode_eq_labelPrefixBlockCode]

-- Proof sketch: write `r = a / b` with `b > 0`, take `n = b`, and use that `n • r` is an
-- integer, so translation by `r` has finite order on `AddCircle 1`.
/-- Helper for Example 20.36 (1): if `r` is rational, then the rotation `x ↦ x + r` on
`AddCircle 1` is
periodic. -/
private theorem unitAddCircleRotation_iterate_eq_id_of_rational (r : ℝ)
    (hr : ∃ q : ℚ, (q : ℝ) = r) :
    ∃ n : ℕ, 0 < n ∧ (((· + (r : UnitAddCircle)))^[n] = id) := by
  rcases hr with ⟨q, rfl⟩
  refine ⟨q.den, q.pos, ?_⟩
  have horder : addOrderOf (((q : ℝ) : UnitAddCircle)) = q.den := by
    simpa using (AddCircle.addOrderOf_coe_rat (p := (1 : ℝ)) (q := q))
  have hzero : q.den • (((q : ℝ) : UnitAddCircle)) = 0 := by
    simpa [horder] using addOrderOf_nsmul_eq_zero (((q : ℝ) : UnitAddCircle))
  -- Proof comment: the `q.den`th iterate is translation by `q.den • q`, which is zero on the
  -- additive circle.
  ext x
  simpa [hzero] using congrFun (add_right_iterate (((q : ℝ) : UnitAddCircle)) q.den) x

-- Proof sketch: if some iterate of the rotation is the identity, then every length-`n` block
-- partition of a finite measurable partition is eventually periodic in `n`, so the normalized
-- block entropies tend to `0`.
/-- Helper for Example 20.36 (1): if `r` is rational, then every finite measurable partition has
dynamical
entropy `0` for the rotation `x ↦ x + r` on `AddCircle 1`. -/
theorem unitAddCircleRotation_dynamicalEntropy_eq_zero_of_rational
    (r : ℝ) (hr : ∃ q : ℚ, (q : ℝ) = r) (part : MeasurableFinpartition UnitAddCircle) :
    h(volume, ((· + (r : UnitAddCircle))),
      (measurePreserving_add_right volume (r : UnitAddCircle)).measurable; part) = 0 := by
  obtain ⟨n, hn, hIter⟩ := unitAddCircleRotation_iterate_eq_id_of_rational r hr
  -- Proof comment: a rational rotation has a positive iterate equal to the identity, so the
  -- general periodic-iterate entropy lemma applies directly.
  exact dynamicalEntropy_eq_zero_of_periodicIterate (P := volume)
    ((· + (r : UnitAddCircle)))
    (measurePreserving_add_right volume (r : UnitAddCircle)).measurable part hn hIter

-- Proof sketch: the rational rotation case gives entropy `0` for every finite measurable
-- partition, so the supremum in `kolmogorov_sinai_entropy` is also `0`.
/-- Helper for Example 20.36 (1): if `r` is rational, then the Kolmogorov--Sinai entropy of the
rotation
`x ↦ x + r` on `AddCircle 1` is `0`. -/
theorem unitAddCircleRotation_kolmogorov_sinai_entropy_eq_zero_of_rational
    (r : ℝ) (hr : ∃ q : ℚ, (q : ℝ) = r) :
    h(volume, ((· + (r : UnitAddCircle))),
      (measurePreserving_add_right volume (r : UnitAddCircle)).measurable) = 0 := by
  rw [kolmogorov_sinai_entropy_def]
  refine le_antisymm ?_ ?_
  · -- Proof comment: every finite measurable partition has zero dynamical entropy under a
    -- rational rotation.
    refine sSup_le ?_
    rintro _ ⟨part, rfl⟩
    simpa using (unitAddCircleRotation_dynamicalEntropy_eq_zero_of_rational r hr part).le
  · let trivialPart : MeasurableFinpartition UnitAddCircle :=
        MeasurableFinpartition.ofSimpleFunc (SimpleFunc.const UnitAddCircle ())
    have htrivial :
        h(volume, ((· + (r : UnitAddCircle))),
          (measurePreserving_add_right volume (r : UnitAddCircle)).measurable; trivialPart) = 0 :=
      unitAddCircleRotation_dynamicalEntropy_eq_zero_of_rational r hr trivialPart
    -- Proof comment: the trivial one-atom partition contributes the explicit value `0` to the
    -- defining supremum.
    simpa using
      (le_sSup (Set.mem_range.mpr ⟨trivialPart, htrivial⟩) :
        0 ≤ sSup
          (Set.range fun part : MeasurableFinpartition UnitAddCircle ↦
            h(volume, ((· + (r : UnitAddCircle))),
              (measurePreserving_add_right volume (r : UnitAddCircle)).measurable; part)))

-- Proof sketch: follow the textbook coding argument for the half-circle partition. As the
-- starting point moves around the circle, each coordinate changes only when an orbit point crosses
-- one of the two partition endpoints, yielding at most `2 n` distinct words of positive length
-- `n`.
/-- Helper for Example 20.36: the forward orbit of an irrational rotation parameter is dense on
`AddCircle 1`. -/
private theorem unitAddCircleDenseRange_nsmul_of_irrational
    (r : ℝ) (hr : Irrational r) :
    DenseRange (fun n : ℕ ↦ n • (r : UnitAddCircle)) := by
  have hz :
      DenseRange (fun z : ℤ ↦ z • (r : UnitAddCircle)) := by
    rw [AddCircle.denseRange_zsmul_iff]
    simpa [AddCircle.isOfFinAddOrder_iff_exists_rat_eq_div, Irrational] using hr
  -- Proof comment: on the compact additive circle, density of the full integer orbit is
  -- equivalent to density of the forward natural orbit.
  exact (denseRange_zsmul_iff_nsmul).mp hz

/-- Helper for Example 20.36: translating and negating the dense irrational orbit keeps it dense,
so the orbit of the half-partition endpoint `1 / 2` under backward iterates is dense as well. -/
private theorem unitAddCircleHalfEndpointDenseRange_of_irrational
    (r : ℝ) (hr : Irrational r) :
    DenseRange
      (fun n : ℕ ↦ ((1 / 2 : ℝ) : UnitAddCircle) - n • (r : UnitAddCircle)) := by
  let shiftNeg : UnitAddCircle → UnitAddCircle :=
    fun x ↦ ((1 / 2 : ℝ) : UnitAddCircle) - x
  have hshiftNeg_cont : Continuous shiftNeg := continuous_const.sub continuous_id
  have hshiftNeg :
      Function.Surjective shiftNeg := by
    intro x
    refine ⟨((1 / 2 : ℝ) : UnitAddCircle) - x, ?_⟩
    simp [shiftNeg, sub_eq_add_neg, add_comm, add_left_comm, add_assoc]
  -- Proof comment: compose the dense forward orbit with the circle automorphism `x ↦ 1/2 - x`.
  exact DenseRange.comp
    (Function.Surjective.denseRange hshiftNeg)
    (unitAddCircleDenseRange_nsmul_of_irrational r hr)
    hshiftNeg_cont

/-- Helper for Example 20.36: the left-threshold chart values `Int.fract (- n * r)` form a dense
subset of `[0, 1)`. -/
private theorem unitAddCircleLeftThresholdDense_of_irrational
    (r : ℝ) (hr : Irrational r) :
    Dense
      (Set.range fun n : ℕ ↦
        (⟨Int.fract (-((n : ℕ) * r)), ⟨Int.fract_nonneg _, Int.fract_lt_one _⟩⟩ :
          Set.Ico (0 : ℝ) 1)) := by
  let leftThreshold : ℕ → Set.Ico (0 : ℝ) 1 := fun n ↦
    ⟨Int.fract (-((n : ℕ) * r)), ⟨Int.fract_nonneg _, Int.fract_lt_one _⟩⟩
  have hdNeg :
      DenseRange (fun n : ℕ ↦ -(n • (r : UnitAddCircle))) := by
    let negMap : UnitAddCircle → UnitAddCircle := fun z ↦ -z
    have hneg_surj : Function.Surjective negMap := by
      intro z
      refine ⟨-z, ?_⟩
      simp [negMap]
    -- Proof comment: negation is a continuous circle automorphism, so it preserves density of the
    -- forward irrational orbit.
    exact DenseRange.comp
      (Function.Surjective.denseRange hneg_surj)
      (unitAddCircleDenseRange_nsmul_of_irrational r hr)
      continuous_neg
  rw [dense_iff_exists_between]
  intro a b hab
  let U : Set UnitAddCircle := ((↑) : ℝ → UnitAddCircle) '' Set.Ioo (a : ℝ) b
  have hU_open : IsOpen U := by
    -- Proof comment: away from the seam at `0`, the quotient map `ℝ → AddCircle 1` is an open
    -- partial homeomorphism, so open real subintervals stay open on the circle.
    simpa [U] using
      (AddCircle.openPartialHomeomorphCoe (p := (1 : ℝ)) (a := (0 : ℝ))).isOpen_image_of_subset_source
        isOpen_Ioo (by
          intro x hx
          constructor
          · linarith [a.2.1, hx.1]
          · linarith [b.2.2, hx.2])
  have hU_nonempty : U.Nonempty := by
    rcases Set.nonempty_Ioo.mpr hab with ⟨x, hx⟩
    exact ⟨((x : ℝ) : UnitAddCircle), ⟨x, hx, rfl⟩⟩
  rcases (hdNeg : Dense (Set.range fun n : ℕ ↦ -(n • (r : UnitAddCircle)))).inter_open_nonempty
      U hU_open hU_nonempty with ⟨z, hzU, hzRange⟩
  rcases hzRange with ⟨n, rfl⟩
  rcases hzU with ⟨x, hx, hxEq⟩
  have hxIco : x ∈ Set.Ico (0 : ℝ) 1 := by
    constructor
    · linarith [a.2.1, hx.1]
    · linarith [b.2.2, hx.2]
  have hxChart :
      (AddCircle.equivIco (1 : ℝ) 0 (((x : ℝ) : UnitAddCircle)) : ℝ) = x := by
    rw [AddCircle.coe_equivIco_mk_apply]
    simpa [Int.fract_eq_self.mpr hxIco]
  have hnChart :
      (AddCircle.equivIco (1 : ℝ) 0 (-(n • (r : UnitAddCircle))) : ℝ) =
        Int.fract (-((n : ℕ) * r)) := by
    have hnsmul_eq :
        -(n • (r : UnitAddCircle)) = (-((r * (n : ℝ)) : ℝ) : UnitAddCircle) := by
      rw [← AddCircle.coe_nsmul]
      congr 1
      rw [nsmul_eq_mul]
      ring
    rw [hnsmul_eq]
    simpa [mul_comm] using
      (AddCircle.coe_equivIco_mk_apply (p := (1 : ℝ)) (x := -(r * (n : ℝ))))
  have hthreshold :
      Int.fract (-((n : ℕ) * r)) ∈ Set.Ioo (a : ℝ) b := by
    -- Proof comment: the dense circle hit in the seam-free interval lifts back to the concrete
    -- chart point `Int.fract (- n * r)`.
    have hEq : x = Int.fract (-((n : ℕ) * r)) := by
      simpa [hxChart, hnChart] using
        congrArg (fun z : UnitAddCircle ↦ (AddCircle.equivIco (1 : ℝ) 0 z : ℝ)) hxEq
    exact hEq ▸ hx
  refine ⟨leftThreshold n, ⟨n, rfl⟩, hthreshold.1, hthreshold.2⟩

/-- Helper for Example 20.36: for `x, t ∈ [0, 1)`, the fractional part of `x + t` lies in the
right half of the unit interval exactly when `x + t` lands in the first or second translated copy
of `[1 / 2, 1)`. -/
private theorem fract_add_mem_rightHalf_iff
    {x t : ℝ} (hx : x ∈ Set.Ico (0 : ℝ) 1) (ht : t ∈ Set.Ico (0 : ℝ) 1) :
    Int.fract (x + t) ∈ Set.Ico (1 / 2 : ℝ) 1 ↔
      x + t ∈ Set.Ico (1 / 2 : ℝ) 1 ∪ Set.Ico (3 / 2 : ℝ) 2 := by
  rw [Set.mem_union]
  by_cases hwrap : x + t < 1
  · have hfract : Int.fract (x + t) = x + t := by
      exact Int.fract_eq_self.mpr ⟨by linarith [hx.1, ht.1], hwrap⟩
    rw [hfract]
    constructor
    · intro hmem
      exact Or.inl hmem
    · intro hmem
      rcases hmem with hmem | hmem
      · exact hmem
      · exfalso
        linarith [hmem.1, hwrap]
  · have hge1 : 1 ≤ x + t := by
      linarith
    have hlt2 : x + t < 2 := by
      linarith [hx.2, ht.2]
    have hfract : Int.fract (x + t) = x + t - 1 := by
      have hmem : x + t - 1 ∈ Set.Ico (0 : ℝ) 1 := by
        constructor <;> linarith
      calc
        Int.fract (x + t) = Int.fract ((x + t - 1) + (1 : ℤ)) := by
          congr 1
          ring
        _ = Int.fract (x + t - 1) := by
          simp
        _ = x + t - 1 := Int.fract_eq_self.mpr hmem
    rw [hfract]
    constructor
    · intro hmem
      exact Or.inr <| by
        constructor <;> linarith [hmem.1, hmem.2]
    · intro hmem
      rcases hmem with hmem | hmem
      · exfalso
        linarith [hmem.2, hge1]
      · constructor <;> linarith [hmem.1, hmem.2]

/-- Helper for Example 20.36: the `i`th right-half itinerary bit is controlled by the translated
chart coordinate `Int.fract (i * r)`, so only one wraparound can occur on `[0, 1)`. -/
private theorem chartRightHalfIterate_mem_iff
    (r : ℝ) (i : ℕ) (x : Set.Ico (0 : ℝ) 1) :
    Int.fract ((x : ℝ) + i * r) ∈ Set.Ico (1 / 2 : ℝ) 1 ↔
      (x : ℝ) + Int.fract (i * r) ∈ Set.Ico (1 / 2 : ℝ) 1 ∪ Set.Ico (3 / 2 : ℝ) 2 := by
  rcases (Int.fract_eq_iff).mp (rfl : Int.fract (i * r) = Int.fract (i * r)) with
    ⟨ht0, ht1, ⟨z, hz⟩⟩
  have hfract :
      Int.fract ((x : ℝ) + i * r) = Int.fract ((x : ℝ) + Int.fract (i * r)) := by
    -- Proof comment: discard the integer part of `i * r`, since `Int.fract` is invariant under
    -- integer translations.
    calc
      Int.fract ((x : ℝ) + i * r) = Int.fract (((x : ℝ) + Int.fract (i * r)) + z) := by
        congr 1
        linarith
      _ = Int.fract ((x : ℝ) + Int.fract (i * r)) := by
        simpa [add_assoc] using Int.fract_add_intCast ((x : ℝ) + Int.fract (i * r)) z
  rw [hfract]
  exact fract_add_mem_rightHalf_iff x.2 ⟨ht0, ht1⟩

-- Example 20.36 (2): the next helpers isolate the finite cut family controlling the first `n`
-- itinerary coordinates before proving the `2 n` block-cardinality bound.
/-- Helper for Example 20.36: the finite chart thresholds where one of the first `n` itinerary
coordinates can change. -/
private noncomputable def unitAddCircleHalfCutPoints (r : ℝ) (n : ℕ+) : Finset ℝ :=
  (Finset.univ.image fun i : Fin n ↦ Int.fract (-((i : ℕ) * r))) ∪
    (Finset.univ.image fun i : Fin n ↦ Int.fract ((1 / 2 : ℝ) - (i : ℕ) * r))

/-- Helper for Example 20.36: the initial chart point `0` is always one of the half-itinerary
cut points, coming from the zeroth iterate. -/
private theorem zero_mem_unitAddCircleHalfCutPoints (r : ℝ) (n : ℕ+) :
    (0 : ℝ) ∈ unitAddCircleHalfCutPoints r n := by
  refine Finset.mem_union.mpr (Or.inl ?_)
  refine Finset.mem_image.mpr ?_
  refine ⟨0, by simp, ?_⟩
  simp

/-- Helper for Example 20.36: each translated lower half-endpoint contributes one of the cut
points governing the length-`n` Boolean code. -/
private theorem leftThreshold_mem_unitAddCircleHalfCutPoints (r : ℝ) (n : ℕ+) (i : Fin n) :
    Int.fract (-((i : ℕ) * r)) ∈ unitAddCircleHalfCutPoints r n := by
  refine Finset.mem_union.mpr (Or.inl ?_)
  exact Finset.mem_image.mpr ⟨i, by simp, rfl⟩

/-- Helper for Example 20.36: each translated upper half-endpoint contributes one of the cut
points governing the length-`n` Boolean code. -/
private theorem halfThreshold_mem_unitAddCircleHalfCutPoints (r : ℝ) (n : ℕ+) (i : Fin n) :
    Int.fract ((1 / 2 : ℝ) - (i : ℕ) * r) ∈ unitAddCircleHalfCutPoints r n := by
  refine Finset.mem_union.mpr (Or.inr ?_)
  exact Finset.mem_image.mpr ⟨i, by simp, rfl⟩

/-- Helper for Example 20.36: every cut point produced by the first `n` itinerary coordinates lies
in the chart interval `[0, 1)`. -/
private theorem mem_Ico_of_mem_unitAddCircleHalfCutPoints
    (r : ℝ) (n : ℕ+) {c : ℝ} (hc : c ∈ unitAddCircleHalfCutPoints r n) :
    c ∈ Set.Ico (0 : ℝ) 1 := by
  rcases Finset.mem_union.mp hc with hc | hc
  · rcases Finset.mem_image.mp hc with ⟨i, -, rfl⟩
    exact ⟨Int.fract_nonneg _, Int.fract_lt_one _⟩
  · rcases Finset.mem_image.mp hc with ⟨i, -, rfl⟩
    exact ⟨Int.fract_nonneg _, Int.fract_lt_one _⟩

/-- Helper for Example 20.36: once no endpoint of `Set.Ico a b` occurs inside `(x, y]`, the
indicator of that interval is constant between `x` and `y`. -/
private theorem mem_Ico_iff_mem_Ico_of_noEndpointsBetween
    {a b x y : ℝ} (hxy : x ≤ y) (ha : a ∉ Set.Ioc x y) (hb : b ∉ Set.Ioc x y) :
    x ∈ Set.Ico a b ↔ y ∈ Set.Ico a b := by
  constructor
  · intro hx
    constructor
    · have hax : a ≤ x := hx.1
      linarith
    · by_contra hylt
      exact hb ⟨hx.2, le_of_not_gt hylt⟩
  · intro hy
    constructor
    · by_contra hax
      exact ha ⟨lt_of_not_ge hax, hy.1⟩
    · linarith [hy.2, hxy]

/-- Helper for Example 20.36: on `[0, 1)`, the two edge intervals
`Set.Ico 0 a ∪ Set.Ico b 1` are the complement of the middle interval `Set.Ico a b`. -/
private theorem mem_edgeIntervals_iff_not_mem_middleIco
    {a b x : ℝ} (hx : x ∈ Set.Ico (0 : ℝ) 1) (hab : a ≤ b) :
    x ∈ Set.Ico (0 : ℝ) a ∪ Set.Ico b 1 ↔ x ∉ Set.Ico a b := by
  constructor
  · intro hxedge
    intro hmid
    rcases hxedge with hxleft | hxright
    · linarith [hxleft.2, hmid.1]
    · linarith [hmid.2, hxright.1]
  · intro hxmid
    by_cases hxa : x < a
    · exact Or.inl ⟨hx.1, hxa⟩
    · have hax : a ≤ x := le_of_not_gt hxa
      have hxb : ¬ x < b := by
        intro hxb
        exact hxmid ⟨hax, hxb⟩
      exact Or.inr ⟨le_of_not_gt hxb, hx.2⟩

/-- Helper for Example 20.36: on a chart interval containing no cut point, the Boolean itinerary
of length `n` is constant as long as the right endpoint is not itself a cut point. -/
private theorem unitAddCircleHalfCode_eq_of_noCutBetween
    (r : ℝ) (n : ℕ+) {x y : Set.Ico (0 : ℝ) 1}
    (hxy : (x : ℝ) ≤ y)
    (hycut : (y : ℝ) ∉ unitAddCircleHalfCutPoints r n)
    (hnoCut :
      ∀ {c : ℝ}, c ∈ unitAddCircleHalfCutPoints r n → c ∈ Set.Ioc (x : ℝ) y → False) :
    unitAddCircleHalfBlockCode r n (((x : ℝ) : UnitAddCircle)) =
      unitAddCircleHalfBlockCode r n (((y : ℝ) : UnitAddCircle)) := by
  -- Proof comment: each coordinate changes only when the chart variable crosses one of the two
  -- translated half-endpoints recorded in `unitAddCircleHalfCutPoints`.
  funext i
  rw [Bool.eq_iff_iff]
  let t : ℝ := Int.fract ((i : ℕ) * r)
  have ht : t ∈ Set.Ico (0 : ℝ) 1 := by
    exact ⟨Int.fract_nonneg _, Int.fract_lt_one _⟩
  have hleft_not :
      Int.fract (-((i : ℕ) * r)) ∉ Set.Ioc (x : ℝ) y := by
    intro hmem
    exact hnoCut (leftThreshold_mem_unitAddCircleHalfCutPoints r n i) hmem
  have hhalf_not :
      Int.fract ((1 / 2 : ℝ) - (i : ℕ) * r) ∉ Set.Ioc (x : ℝ) y := by
    intro hmem
    exact hnoCut (halfThreshold_mem_unitAddCircleHalfCutPoints r n i) hmem
  have hhalf_shift :
      Int.fract ((1 / 2 : ℝ) - (i : ℕ) * r) = Int.fract ((1 / 2 : ℝ) - t) := by
    rcases (Int.fract_eq_iff).mp (show Int.fract ((i : ℕ) * r) = t by rfl) with
      ⟨-, -, ⟨z, hz⟩⟩
    calc
      Int.fract ((1 / 2 : ℝ) - (i : ℕ) * r) = Int.fract (((1 / 2 : ℝ) - t) - z) := by
        congr 1
        linarith
      _ = Int.fract ((1 / 2 : ℝ) - t) := by
        simpa using Int.fract_sub_intCast ((1 / 2 : ℝ) - t) z
  -- Proof comment: compare the `i`th Boolean bit by rewriting it through the chart and then
  -- showing that `x` and `y` lie in the same cut-free component.
  calc
    unitAddCircleHalfBlockCode r n (((x : ℝ) : UnitAddCircle)) i = true ↔
        Int.fract ((x : ℝ) + (i : ℕ) * r) ∈ Set.Ico (1 / 2 : ℝ) 1 :=
      unitAddCircleHalfBlockCode_eq_chartFractCode r n x i
    _ ↔ (x : ℝ) + t ∈ Set.Ico (1 / 2 : ℝ) 1 ∪ Set.Ico (3 / 2 : ℝ) 2 :=
      chartRightHalfIterate_mem_iff r (i : ℕ) x
    _ ↔ (y : ℝ) + t ∈ Set.Ico (1 / 2 : ℝ) 1 ∪ Set.Ico (3 / 2 : ℝ) 2 := by
      by_cases ht0 : t = 0
      · have hx_union :
            (x : ℝ) + t ∈ Set.Ico (1 / 2 : ℝ) 1 ∪ Set.Ico (3 / 2 : ℝ) 2 ↔
              (x : ℝ) ∈ Set.Ico (1 / 2 : ℝ) 1 := by
          constructor
          · intro hxmem
            rcases hxmem with hxmem | hxmem
            · simpa [t, ht0] using hxmem
            · exfalso
              linarith [x.2.2, hxmem.1]
          · intro hxmem
            exact Or.inl <| by simpa [t, ht0] using hxmem
        have hy_union :
            (y : ℝ) + t ∈ Set.Ico (1 / 2 : ℝ) 1 ∪ Set.Ico (3 / 2 : ℝ) 2 ↔
              (y : ℝ) ∈ Set.Ico (1 / 2 : ℝ) 1 := by
          constructor
          · intro hymem
            rcases hymem with hymem | hymem
            · simpa [t, ht0] using hymem
            · exfalso
              linarith [y.2.2, hymem.1]
          · intro hymem
            exact Or.inl <| by simpa [t, ht0] using hymem
        have hhalf_eq :
            Int.fract ((1 / 2 : ℝ) - (i : ℕ) * r) = (1 / 2 : ℝ) := by
          rw [hhalf_shift, ht0]
          norm_num
        have htop_not : (1 : ℝ) ∉ Set.Ioc (x : ℝ) y := by
          intro hmem
          linarith [y.2.2, hmem.2]
        have hmid :
            (x : ℝ) ∈ Set.Ico (1 / 2 : ℝ) 1 ↔ (y : ℝ) ∈ Set.Ico (1 / 2 : ℝ) 1 := by
          refine mem_Ico_iff_mem_Ico_of_noEndpointsBetween hxy ?_ htop_not
          intro hmem
          exact hhalf_not <| by
            rw [Set.mem_Ioc, hhalf_eq]
            exact hmem
        exact hx_union.trans (hmid.trans hy_union.symm)
      · have ht_pos : 0 < t := by
          exact lt_of_le_of_ne ht.1 (by simpa [eq_comm] using ht0)
        have hleft_eq : Int.fract (-((i : ℕ) * r)) = 1 - t := by
          have hne : Int.fract ((i : ℕ) * r) ≠ 0 := by
            simpa [t] using ht0
          simpa [t] using (Int.fract_neg hne : Int.fract (-((i : ℕ) * r)) = 1 - Int.fract ((i : ℕ) * r))
        by_cases hhalf_le : t ≤ (1 / 2 : ℝ)
        · have hhalf_eq :
              Int.fract ((1 / 2 : ℝ) - (i : ℕ) * r) = (1 / 2 : ℝ) - t := by
            rw [hhalf_shift]
            exact Int.fract_eq_self.mpr <| by
              constructor <;> linarith
          have hx_union :
              (x : ℝ) + t ∈ Set.Ico (1 / 2 : ℝ) 1 ∪ Set.Ico (3 / 2 : ℝ) 2 ↔
                (x : ℝ) ∈ Set.Ico ((1 / 2 : ℝ) - t) (1 - t) := by
            constructor
            · intro hxmem
              rcases hxmem with hxmem | hxmem
              · have hxlo : (1 / 2 : ℝ) ≤ (x : ℝ) + t := hxmem.1
                have hxhi : (x : ℝ) + t < 1 := hxmem.2
                constructor <;> linarith
              · exfalso
                linarith [x.2.2, hhalf_le, hxmem.1]
            · intro hxmem
              have hxlo : (1 / 2 : ℝ) - t ≤ (x : ℝ) := hxmem.1
              have hxhi : (x : ℝ) < 1 - t := hxmem.2
              exact Or.inl <| by
                constructor <;> linarith
          have hy_union :
              (y : ℝ) + t ∈ Set.Ico (1 / 2 : ℝ) 1 ∪ Set.Ico (3 / 2 : ℝ) 2 ↔
                (y : ℝ) ∈ Set.Ico ((1 / 2 : ℝ) - t) (1 - t) := by
            constructor
            · intro hymem
              rcases hymem with hymem | hymem
              · have hylo : (1 / 2 : ℝ) ≤ (y : ℝ) + t := hymem.1
                have hyhi : (y : ℝ) + t < 1 := hymem.2
                constructor <;> linarith
              · exfalso
                linarith [y.2.2, hhalf_le, hymem.1]
            · intro hymem
              have hylo : (1 / 2 : ℝ) - t ≤ (y : ℝ) := hymem.1
              have hyhi : (y : ℝ) < 1 - t := hymem.2
              exact Or.inl <| by
                constructor <;> linarith
          have hmid :
              (x : ℝ) ∈ Set.Ico ((1 / 2 : ℝ) - t) (1 - t) ↔
                (y : ℝ) ∈ Set.Ico ((1 / 2 : ℝ) - t) (1 - t) := by
            refine mem_Ico_iff_mem_Ico_of_noEndpointsBetween hxy ?_ ?_
            · intro hmem
              exact hhalf_not <| by
                rw [Set.mem_Ioc, hhalf_eq]
                constructor <;> linarith [hmem.1, hmem.2]
            · simpa [hleft_eq] using hleft_not
          exact hx_union.trans (hmid.trans hy_union.symm)
        · have hhalf_lt : (1 / 2 : ℝ) < t := lt_of_not_ge hhalf_le
          have hhalf_eq :
              Int.fract ((1 / 2 : ℝ) - (i : ℕ) * r) = (3 / 2 : ℝ) - t := by
            rw [hhalf_shift]
            have hfract_eq :
                Int.fract ((1 / 2 : ℝ) - t) = (3 / 2 : ℝ) - t := by
              calc
                Int.fract ((1 / 2 : ℝ) - t) = Int.fract (((3 / 2 : ℝ) - t) - (1 : ℤ)) := by
                  ring
                _ = Int.fract ((3 / 2 : ℝ) - t) := by
                  simpa using Int.fract_sub_intCast ((3 / 2 : ℝ) - t) (1 : ℤ)
                _ = (3 / 2 : ℝ) - t := by
                  have ht_lt_one : t < 1 := ht.2
                  refine Int.fract_eq_self.mpr ?_
                  constructor
                  · linarith
                  · linarith
            exact hfract_eq
          have hx_edge :
              (x : ℝ) + t ∈ Set.Ico (1 / 2 : ℝ) 1 ∪ Set.Ico (3 / 2 : ℝ) 2 ↔
                (x : ℝ) ∈ Set.Ico (0 : ℝ) (1 - t) ∪ Set.Ico ((3 / 2 : ℝ) - t) 1 := by
            constructor
            · intro hxmem
              rcases hxmem with hxmem | hxmem
              · exact Or.inl <| by
                  have hxhi : (x : ℝ) + t < 1 := hxmem.2
                  constructor
                  · exact x.2.1
                  · linarith
              · exact Or.inr <| by
                  have hxlo : (3 / 2 : ℝ) ≤ (x : ℝ) + t := hxmem.1
                  have hxhi : (x : ℝ) + t < 2 := hxmem.2
                  constructor
                  · linarith
                  · exact x.2.2
            · intro hxmem
              rcases hxmem with hxmem | hxmem
              · exact Or.inl <| by
                  have hxlo : (x : ℝ) ∈ Set.Ico (0 : ℝ) (1 - t) := hxmem
                  constructor
                  · linarith [hhalf_lt, hxlo.1]
                  · linarith [hxlo.2]
              · exact Or.inr <| by
                  have hxhi : (x : ℝ) ∈ Set.Ico ((3 / 2 : ℝ) - t) 1 := hxmem
                  constructor <;> linarith [hxhi.1, hxhi.2, ht.2]
          have hy_edge :
              (y : ℝ) + t ∈ Set.Ico (1 / 2 : ℝ) 1 ∪ Set.Ico (3 / 2 : ℝ) 2 ↔
                (y : ℝ) ∈ Set.Ico (0 : ℝ) (1 - t) ∪ Set.Ico ((3 / 2 : ℝ) - t) 1 := by
            constructor
            · intro hymem
              rcases hymem with hymem | hymem
              · exact Or.inl <| by
                  have hyhi : (y : ℝ) + t < 1 := hymem.2
                  constructor
                  · exact y.2.1
                  · linarith
              · exact Or.inr <| by
                  have hylo : (3 / 2 : ℝ) ≤ (y : ℝ) + t := hymem.1
                  have hyhi : (y : ℝ) + t < 2 := hymem.2
                  constructor
                  · linarith
                  · exact y.2.2
            · intro hymem
              rcases hymem with hymem | hymem
              · exact Or.inl <| by
                  have hylo : (y : ℝ) ∈ Set.Ico (0 : ℝ) (1 - t) := hymem
                  constructor
                  · linarith [hhalf_lt, hylo.1]
                  · linarith [hylo.2]
              · exact Or.inr <| by
                  have hyhi : (y : ℝ) ∈ Set.Ico ((3 / 2 : ℝ) - t) 1 := hymem
                  constructor <;> linarith [hyhi.1, hyhi.2, ht.2]
          have hmid :
              (x : ℝ) ∈ Set.Ico (1 - t) ((3 / 2 : ℝ) - t) ↔
                (y : ℝ) ∈ Set.Ico (1 - t) ((3 / 2 : ℝ) - t) := by
            refine mem_Ico_iff_mem_Ico_of_noEndpointsBetween hxy ?_ ?_
            · simpa [hleft_eq] using hleft_not
            · intro hmem
              exact hhalf_not <| by
                rw [Set.mem_Ioc, hhalf_eq]
                constructor <;> linarith [hmem.1, hmem.2]
          have hedge :
              (x : ℝ) ∈ Set.Ico (0 : ℝ) (1 - t) ∪ Set.Ico ((3 / 2 : ℝ) - t) 1 ↔
                (y : ℝ) ∈ Set.Ico (0 : ℝ) (1 - t) ∪ Set.Ico ((3 / 2 : ℝ) - t) 1 := by
            calc
              (x : ℝ) ∈ Set.Ico (0 : ℝ) (1 - t) ∪ Set.Ico ((3 / 2 : ℝ) - t) 1 ↔
                  (x : ℝ) ∉ Set.Ico (1 - t) ((3 / 2 : ℝ) - t) := by
                    exact mem_edgeIntervals_iff_not_mem_middleIco x.2 (by linarith)
              _ ↔ (y : ℝ) ∉ Set.Ico (1 - t) ((3 / 2 : ℝ) - t) := by
                    exact not_congr hmid
              _ ↔ (y : ℝ) ∈ Set.Ico (0 : ℝ) (1 - t) ∪ Set.Ico ((3 / 2 : ℝ) - t) 1 := by
                    exact (mem_edgeIntervals_iff_not_mem_middleIco y.2 (by linarith)).symm
          exact hx_edge.trans (hedge.trans hy_edge.symm)
    _ ↔ Int.fract ((y : ℝ) + (i : ℕ) * r) ∈ Set.Ico (1 / 2 : ℝ) 1 :=
      (chartRightHalfIterate_mem_iff r (i : ℕ) y).symm
    _ ↔ unitAddCircleHalfBlockCode r n (((y : ℝ) : UnitAddCircle)) i = true :=
      (unitAddCircleHalfBlockCode_eq_chartFractCode r n y i).symm

/-- Helper for Example 20.36: the cut family controlling the first `n` coordinates has at most
`2 n` distinct chart points. -/
private theorem card_unitAddCircleHalfCutPoints_le_two_mul (r : ℝ) (n : ℕ+) :
    (unitAddCircleHalfCutPoints r n).card ≤ 2 * (n : ℕ) := by
  classical
  dsimp [unitAddCircleHalfCutPoints]
  calc
    ((Finset.univ.image fun i : Fin n ↦ Int.fract (-((i : ℕ) * r))) ∪
        Finset.univ.image fun i : Fin n ↦ Int.fract ((1 / 2 : ℝ) - (i : ℕ) * r)).card ≤
        (Finset.univ.image fun i : Fin n ↦ Int.fract (-((i : ℕ) * r))).card +
          (Finset.univ.image fun i : Fin n ↦ Int.fract ((1 / 2 : ℝ) - (i : ℕ) * r)).card := by
      exact Finset.card_union_le _ _
    _ ≤ (Finset.univ : Finset (Fin n)).card + (Finset.univ : Finset (Fin n)).card := by
      exact add_le_add Finset.card_image_le Finset.card_image_le
    _ = 2 * (n : ℕ) := by
      simp [two_mul]

-- TODO: after `unitAddCircleHalfPartition_block_proj`, bound the Bool-code range by counting the
-- orbit translates of the two partition endpoints in the `equivIco` chart, then pull the bound
-- back to the canonical block partition.
/-- Helper for Example 20.36 (2): if `r` is irrational, then the canonical length-`n` block
partition of the
half-circle partition has at most `2 n` atoms, equivalently the half-interval coding has at most
`2 n` distinct binary words of positive length `n`. -/
private theorem unitAddCircleHalfPartition_block_card_le_two_mul_of_irrational
    (r : ℝ) (hr : Irrational r) (n : ℕ+) :
    Nat.card ↥((unitAddCircleHalfPartition.block
      ((· + (r : UnitAddCircle)))
      (measurePreserving_add_right volume (r : UnitAddCircle)).measurable n).parts) ≤
      2 * (n : ℕ) := by
  rw [unitAddCircleHalfPartition_block_proj]
  -- Proof comment: the explicit Boolean code is controlled by the finite family of translated
  -- chart endpoints isolated by `chartRightHalfIterate_mem_iff`.
  let cuts := unitAddCircleHalfCutPoints r n
  have hcuts_zero : (0 : ℝ) ∈ cuts := zero_mem_unitAddCircleHalfCutPoints r n
  have hcuts_card : cuts.card ≤ 2 * (n : ℕ) := card_unitAddCircleHalfCutPoints_le_two_mul r n
  let Φ : ↥cuts → ↥(Set.range (unitAddCircleHalfBlockCode r n)) := fun c ↦
    ⟨unitAddCircleHalfBlockCode r n (((c : ℝ) : UnitAddCircle)),
      ⟨(((c : ℝ) : UnitAddCircle)), rfl⟩⟩
  have hsurj : Function.Surjective Φ := by
    intro w
    rcases w.2 with ⟨z, hz⟩
    have hx_chart :
        ((AddCircle.equivIco (1 : ℝ) 0 z : Set.Ico (0 : ℝ) ((0 : ℝ) + 1)) : ℝ) ∈
          Set.Ico (0 : ℝ) 1 := by
      simpa using
        ((AddCircle.equivIco (1 : ℝ) 0 z : Set.Ico (0 : ℝ) ((0 : ℝ) + 1))).2
    let x : Set.Ico (0 : ℝ) 1 :=
      ⟨((AddCircle.equivIco (1 : ℝ) 0 z : Set.Ico (0 : ℝ) ((0 : ℝ) + 1)) : ℝ), hx_chart⟩
    have hxz_raw :
        ((((AddCircle.equivIco (1 : ℝ) 0 z : Set.Ico (0 : ℝ) ((0 : ℝ) + 1)) : ℝ) :
          UnitAddCircle)) = z := by
      change
        (AddCircle.equivIco (1 : ℝ) 0).symm (AddCircle.equivIco (1 : ℝ) 0 z) = z
      exact (AddCircle.equivIco (1 : ℝ) 0).symm_apply_apply z
    have hxz : (((x : ℝ) : UnitAddCircle)) = z := by
      simpa [x] using hxz_raw
    by_cases hxcut : (x : ℝ) ∈ cuts
    · -- Proof comment: if the chart point is already a cut point, it is its own representative.
      refine ⟨⟨(x : ℝ), hxcut⟩, ?_⟩
      apply Subtype.ext
      simpa [Φ] using (congrArg (unitAddCircleHalfBlockCode r n) hxz).trans hz
    · -- Proof comment: otherwise choose the maximal cut point below `x`; no cut lies in the
      -- open interval from that representative to `x`, so the Boolean code stays constant there.
      let below : Finset ℝ := cuts.filter fun c ↦ c ≤ (x : ℝ)
      have hbelow_nonempty : below.Nonempty := by
        refine ⟨0, ?_⟩
        simp [below, hcuts_zero, x.2.1]
      let c : ℝ := below.max' hbelow_nonempty
      have hc_mem_below : c ∈ below := Finset.max'_mem below hbelow_nonempty
      have hc_mem : c ∈ cuts := (Finset.mem_filter.mp hc_mem_below).1
      have hc_le : c ≤ (x : ℝ) := (Finset.mem_filter.mp hc_mem_below).2
      have hc_ico : c ∈ Set.Ico (0 : ℝ) 1 := mem_Ico_of_mem_unitAddCircleHalfCutPoints r n hc_mem
      let xc : Set.Ico (0 : ℝ) 1 := ⟨c, hc_ico⟩
      have hnoCut :
          ∀ {d : ℝ}, d ∈ cuts → d ∈ Set.Ioc (xc : ℝ) (x : ℝ) → False := by
        intro d hd hdIoc
        have hd_mem_below : d ∈ below := Finset.mem_filter.mpr ⟨hd, hdIoc.2⟩
        have hd_le_c : d ≤ c := Finset.le_max' below d hd_mem_below
        exact hdIoc.1.not_ge hd_le_c
      have hcode :
          unitAddCircleHalfBlockCode r n (((xc : ℝ) : UnitAddCircle)) =
            unitAddCircleHalfBlockCode r n (((x : ℝ) : UnitAddCircle)) :=
        unitAddCircleHalfCode_eq_of_noCutBetween r n hc_le hxcut hnoCut
      refine ⟨⟨c, hc_mem⟩, ?_⟩
      apply Subtype.ext
      simpa [Φ] using hcode.trans ((congrArg (unitAddCircleHalfBlockCode r n) hxz).trans hz)
  calc
    Nat.card ↥(Set.range (unitAddCircleHalfBlockCode r n)) ≤ Nat.card ↥cuts := by
      exact Nat.card_le_card_of_surjective Φ hsurj
    _ = cuts.card := by
      simp
    _ ≤ 2 * (n : ℕ) := hcuts_card

/-- Helper for Example 20.36: the candidate generating family consists of all backward
iterate-preimages of the two half-circle atoms. -/
private def unitAddCircleHalfGeneratorFamily (r : ℝ) : Set (Set UnitAddCircle) :=
  ⋃ n : ℕ,
    Set.range fun A : unitAddCircleHalfPartition.parts ↦
      (((· + (r : UnitAddCircle)))^[n]) ⁻¹'
        ((A.1 : Subtype (MeasurableSet : Set UnitAddCircle → Prop)) : Set UnitAddCircle)

/-- Helper for Example 20.36: the full Boolean half-circle itinerary records, for each iterate,
whether the orbit point lies in the right half-circle. -/
private noncomputable def unitAddCircleHalfItinerary (r : ℝ) :
    UnitAddCircle → ℕ → Bool :=
  letI : DecidablePred fun y : UnitAddCircle ↦ y ∈ unitAddCircleRightHalf := Classical.decPred _
  fun z n ↦ if ((((· + (r : UnitAddCircle)))^[n]) z ∈ unitAddCircleRightHalf) then true else false

/-- Helper for Example 20.36: the full Boolean half-circle itinerary is measurable for the
σ-algebra generated by the backward iterates of the half partition. -/
private theorem measurable_unitAddCircleHalfItinerary_generateFrom
    (r : ℝ) :
    Measurable[MeasurableSpace.generateFrom (unitAddCircleHalfGeneratorFamily r), inferInstance]
      (unitAddCircleHalfItinerary r) := by
  let G := unitAddCircleHalfGeneratorFamily r
  letI : MeasurableSpace UnitAddCircle := MeasurableSpace.generateFrom G
  -- Proof comment: each coordinate is the indicator of one generator set, so product
  -- measurability follows from coordinatewise measurability.
  change Measurable (unitAddCircleHalfItinerary r)
  refine measurable_pi_lambda _ ?_
  intro n
  let s : Set UnitAddCircle :=
    (((· + (r : UnitAddCircle)))^[n]) ⁻¹' unitAddCircleRightHalf
  have hs_mem : s ∈ G := by
    refine Set.mem_iUnion.mpr ⟨n, ?_⟩
    refine Set.mem_range.mpr ?_
    refine ⟨⟨unitAddCircleRightHalfSet, unitAddCircleRightHalf_mem_parts⟩, ?_⟩
    ext z
    rfl
  have hs : MeasurableSet s := by
    exact MeasurableSpace.measurableSet_generateFrom hs_mem
  letI : DecidablePred fun j : UnitAddCircle ↦ j ∈ s := Classical.decPred _
  simpa [unitAddCircleHalfItinerary, G, s] using
    (measurable_const.piecewise hs measurable_const :
      Measurable (s.piecewise (fun _ : UnitAddCircle ↦ true) fun _ ↦ false))

/-- Helper for Example 20.36: the standard `[0,1)` chart on `AddCircle 1`. -/
private theorem addCircleEquivIco_mem_Ico_one (z : UnitAddCircle) :
    ((AddCircle.equivIco (1 : ℝ) 0 z : Set.Ico (0 : ℝ) ((0 : ℝ) + 1)) : ℝ) ∈
      Set.Ico (0 : ℝ) 1 := by
  simpa using (AddCircle.equivIco (1 : ℝ) 0 z).2

/-- Helper for Example 20.36: the standard `[0,1)` chart on `AddCircle 1`, recast to the codomain
`Set.Ico (0 : ℝ) 1` used by the itinerary lemmas in this file. -/
private abbrev unitAddCircleChart : UnitAddCircle → Set.Ico (0 : ℝ) 1 :=
  fun z ↦ ⟨(AddCircle.equivIco (1 : ℝ) 0 z : ℝ), addCircleEquivIco_mem_Ico_one z⟩

/-- Helper for Example 20.36: the normalized chart can be recast back to the original codomain of
`AddCircle.equivIco (1 : ℝ) 0` when the inverse chart equivalence is needed. -/
private abbrev unitAddCircleChartOld (z : UnitAddCircle) : Set.Ico (0 : ℝ) ((0 : ℝ) + 1) :=
  AddCircle.equivIco (1 : ℝ) 0 z

/-- Helper for Example 20.36: passing to the normalized `[0,1)` chart and back to the circle
recovers the original point. -/
private theorem unitAddCircleChart_roundtrip (z : UnitAddCircle) :
    (((unitAddCircleChart z : Set.Ico (0 : ℝ) 1) : ℝ) : UnitAddCircle) = z := by
  have hraw :
      ((((unitAddCircleChartOld z : Set.Ico (0 : ℝ) ((0 : ℝ) + 1)) : ℝ) :
        UnitAddCircle)) = z := by
    change (AddCircle.equivIco (1 : ℝ) 0).symm (AddCircle.equivIco (1 : ℝ) 0 z) = z
    exact (AddCircle.equivIco (1 : ℝ) 0).symm_apply_apply z
  simpa [unitAddCircleChart, unitAddCircleChartOld] using hraw

/-- Helper for Example 20.36: each dense left-threshold chart ray is a Boolean combination of the
time-`0` and time-`n` half-partition generators. -/
private theorem chartPreimageIioLeftThreshold_eq_generatorPieces
    (r : ℝ) (n : ℕ) :
    (fun z : UnitAddCircle ↦ (unitAddCircleChart z : ℝ)) ⁻¹'
        Set.Iio (Int.fract (-((n : ℕ) * r))) =
      if Int.fract (-((n : ℕ) * r)) ≤ (1 / 2 : ℝ) then
        unitAddCircleRightHalfᶜ ∩
          (((fun y : UnitAddCircle ↦ y + (r : UnitAddCircle))^[n]) ⁻¹' unitAddCircleRightHalf)
      else
        unitAddCircleRightHalfᶜ ∪
          (unitAddCircleRightHalf ∩
            (((fun y : UnitAddCircle ↦ y + (r : UnitAddCircle))^[n]) ⁻¹' unitAddCircleRightHalf)) := by
  let t : ℝ := Int.fract ((n : ℕ) * r)
  let a : ℝ := Int.fract (-((n : ℕ) * r))
  ext z
  let x : Set.Ico (0 : ℝ) 1 := unitAddCircleChart z
  change (x : ℝ) < a ↔
    z ∈
      if a ≤ (1 / 2 : ℝ) then
        unitAddCircleRightHalfᶜ ∩
          (((fun y : UnitAddCircle ↦ y + (r : UnitAddCircle))^[n]) ⁻¹' unitAddCircleRightHalf)
      else
        unitAddCircleRightHalfᶜ ∪
          (unitAddCircleRightHalf ∩
            (((fun y : UnitAddCircle ↦ y + (r : UnitAddCircle))^[n]) ⁻¹' unitAddCircleRightHalf))
  have hxz : (((x : ℝ) : UnitAddCircle)) = z := by
    have hraw :
        ((((unitAddCircleChartOld z : Set.Ico (0 : ℝ) ((0 : ℝ) + 1)) : ℝ) :
          UnitAddCircle)) = z := by
      change (AddCircle.equivIco (1 : ℝ) 0).symm (AddCircle.equivIco (1 : ℝ) 0 z) = z
      exact (AddCircle.equivIco (1 : ℝ) 0).symm_apply_apply z
    simpa [x, unitAddCircleChart, unitAddCircleChartOld] using hraw
  have hz_right :
      z ∈ unitAddCircleRightHalf ↔ (x : ℝ) ∈ Set.Ico (1 / 2 : ℝ) 1 := by
    -- Proof comment: rewrite right-half membership through the normalized `[0,1)` chart.
    simpa [hxz] using (unitAddCircle_mk_mem_rightHalf_iff (t := (x : ℝ)) x.2)
  have hz_notRight :
      z ∈ unitAddCircleRightHalfᶜ ↔ (x : ℝ) < (1 / 2 : ℝ) := by
    rw [Set.mem_compl_iff]
    constructor
    · intro hz
      by_contra hxhalf
      exact hz <| hz_right.mpr ⟨le_of_not_gt hxhalf, x.2.2⟩
    · intro hxhalf hz
      exact not_lt_of_ge (hz_right.mp hz).1 hxhalf
  have ht : t ∈ Set.Ico (0 : ℝ) 1 := by
    exact ⟨Int.fract_nonneg _, Int.fract_lt_one _⟩
  have hz_iter :
      ((((fun y : UnitAddCircle ↦ y + (r : UnitAddCircle))^[n]) z) ∈ unitAddCircleRightHalf) ↔
        (x : ℝ) + t ∈ Set.Ico (1 / 2 : ℝ) 1 ∪ Set.Ico (3 / 2 : ℝ) 2 := by
    have hfract :
        ((((fun y : UnitAddCircle ↦ y + (r : UnitAddCircle))^[n]) z) ∈
            unitAddCircleRightHalf) ↔
          Int.fract ((x : ℝ) + (n : ℕ) * r) ∈ Set.Ico (1 / 2 : ℝ) 1 := by
      have hfract' :
          ((((fun y : UnitAddCircle ↦ y + (r : UnitAddCircle))^[n]) (((x : ℝ) : UnitAddCircle))) ∈
              unitAddCircleRightHalf) ↔
            Int.fract ((x : ℝ) + (n : ℕ) * r) ∈ Set.Ico (1 / 2 : ℝ) 1 := by
        have hchart :
            (AddCircle.equivIco (1 : ℝ) 0
              ((((fun y : UnitAddCircle ↦ y + (r : UnitAddCircle))^[n])
                (((x : ℝ) : UnitAddCircle))) : UnitAddCircle) : ℝ) =
              Int.fract ((x : ℝ) + (n : ℕ) * r) :=
          unitAddCircleRotation_iterate_eq_chartFract r n x
        simpa [unitAddCircleRightHalf, Set.mem_preimage] using
          congrArg (fun s : ℝ ↦ s ∈ Set.Ico (1 / 2 : ℝ) 1) hchart
      simpa [hxz] using hfract'
    exact hfract.trans <| by simpa [t] using (chartRightHalfIterate_mem_iff r n x)
  have hz_iter_le (htle : t ≤ (1 / 2 : ℝ)) :
      ((((fun y : UnitAddCircle ↦ y + (r : UnitAddCircle))^[n]) z) ∈
          unitAddCircleRightHalf) ↔
        (x : ℝ) ∈ Set.Ico ((1 / 2 : ℝ) - t) (1 - t) := by
    -- Proof comment: when the translated threshold stays in the first half, the iterate-right
    -- condition is a single interval in the chart.
    calc
      ((((fun y : UnitAddCircle ↦ y + (r : UnitAddCircle))^[n]) z) ∈ unitAddCircleRightHalf) ↔
          (x : ℝ) + t ∈ Set.Ico (1 / 2 : ℝ) 1 ∪ Set.Ico (3 / 2 : ℝ) 2 :=
        hz_iter
      _ ↔ (x : ℝ) ∈ Set.Ico ((1 / 2 : ℝ) - t) (1 - t) := by
        constructor
        · intro hmem
          rcases hmem with hmem | hmem
          · constructor
            · linarith [hmem.1]
            · linarith [hmem.2]
          · exfalso
            have hxplus_lt : (x : ℝ) + t < (3 / 2 : ℝ) := by
              linarith [x.2.2, htle]
            exact not_lt_of_ge hmem.1 hxplus_lt
        · intro hmem
          exact Or.inl <| by
            constructor
            · linarith [hmem.1]
            · linarith [hmem.2]
  have hz_iter_ge (htge : (1 / 2 : ℝ) ≤ t) :
      ((((fun y : UnitAddCircle ↦ y + (r : UnitAddCircle))^[n]) z) ∈
          unitAddCircleRightHalf) ↔
        (x : ℝ) ∈ Set.Ico (0 : ℝ) (1 - t) ∪ Set.Ico ((3 / 2 : ℝ) - t) 1 := by
    -- Proof comment: when the translated threshold crosses `1/2`, the iterate-right condition
    -- splits into the two edge intervals of `[0,1)`.
    calc
      ((((fun y : UnitAddCircle ↦ y + (r : UnitAddCircle))^[n]) z) ∈ unitAddCircleRightHalf) ↔
          (x : ℝ) + t ∈ Set.Ico (1 / 2 : ℝ) 1 ∪ Set.Ico (3 / 2 : ℝ) 2 :=
        hz_iter
      _ ↔ (x : ℝ) ∈ Set.Ico (0 : ℝ) (1 - t) ∪ Set.Ico ((3 / 2 : ℝ) - t) 1 := by
        constructor
        · intro hmem
          rcases hmem with hmem | hmem
          · exact Or.inl <| by
              constructor
              · exact x.2.1
              · linarith [hmem.2]
          · exact Or.inr <| by
              constructor
              · linarith [hmem.1]
              · exact x.2.2
        · intro hmem
          rcases hmem with hmem | hmem
          · exact Or.inl <| by
              constructor
              · linarith [htge, hmem.1]
              · linarith [hmem.2]
          · exact Or.inr <| by
              constructor <;> linarith [hmem.1, hmem.2, ht.2]
  by_cases ht0 : t = 0
  · have ha0 : a = 0 := by
      simp [a, t, ht0]
    have ha : a ≤ (1 / 2 : ℝ) := by
      rw [ha0]
      norm_num
    rw [if_pos ha]
    rw [ha0]
    constructor
    · intro hxlt
      exact False.elim ((not_lt_of_ge x.2.1) hxlt)
    · rintro ⟨hzl, hzr⟩
      have hxlt : (x : ℝ) < (1 / 2 : ℝ) := hz_notRight.mp hzl
      have hmid : (x : ℝ) ∈ Set.Ico (1 / 2 : ℝ) 1 := by
        simpa [t, ht0] using (hz_iter_le (by simpa [t, ht0] : t ≤ (1 / 2 : ℝ))).mp hzr
      linarith [hmid.1, hxlt]
  · have ha_eq : a = 1 - t := by
      simpa [a, t] using (Int.fract_neg ht0 : Int.fract (-((n : ℕ) * r)) = 1 - Int.fract ((n : ℕ) * r))
    by_cases htge : (1 / 2 : ℝ) ≤ t
    · have ha : a ≤ (1 / 2 : ℝ) := by
        rw [ha_eq]
        linarith
      rw [if_pos ha, ha_eq]
      constructor
      · intro hxlt
        refine ⟨?_, ?_⟩
        · exact hz_notRight.mpr <| by linarith
        · exact (hz_iter_ge htge).mpr <| Or.inl ⟨x.2.1, hxlt⟩
      · rintro ⟨hzl, hzr⟩
        have hxlt_half : (x : ℝ) < (1 / 2 : ℝ) := hz_notRight.mp hzl
        rcases (hz_iter_ge htge).mp hzr with hleft | hright
        · exact hleft.2
        · linarith [hxlt_half, hright.1, ht.2]
    · have htlt : t < (1 / 2 : ℝ) := lt_of_not_ge htge
      have ht_pos : 0 < t := by
        exact lt_of_le_of_ne ht.1 (by simpa [eq_comm] using ht0)
      have ha : ¬ a ≤ (1 / 2 : ℝ) := by
        rw [ha_eq]
        linarith
      rw [if_neg ha, ha_eq]
      constructor
      · intro hxlt
        by_cases hxhalf : (x : ℝ) < (1 / 2 : ℝ)
        · exact Or.inl (hz_notRight.mpr hxhalf)
        · refine Or.inr ⟨?_, ?_⟩
          · exact hz_right.mpr ⟨le_of_not_gt hxhalf, x.2.2⟩
          · exact (hz_iter_le (le_of_lt htlt)).mpr <| by
              constructor
              · linarith [le_of_not_gt hxhalf, ht_pos]
              · exact hxlt
      · intro hz
        rcases hz with hzl | ⟨hzr, hzn⟩
        · have hxlt_half : (x : ℝ) < (1 / 2 : ℝ) := hz_notRight.mp hzl
          linarith
        · have hxge_half : (1 / 2 : ℝ) ≤ (x : ℝ) := (hz_right.mp hzr).1
          have hseg : (x : ℝ) ∈ Set.Ico ((1 / 2 : ℝ) - t) (1 - t) :=
            (hz_iter_le (le_of_lt htlt)).mp hzn
          linarith [hxge_half, hseg.2]

/-- Helper for Example 20.36: each dense left-threshold chart ray is measurable for the
σ-algebra generated by the half-partition iterates. -/
private theorem chartPreimageIioLeftThreshold_measurable_generateFrom
    (r : ℝ) (n : ℕ) :
    MeasurableSet[MeasurableSpace.generateFrom (unitAddCircleHalfGeneratorFamily r)]
      ((fun z : UnitAddCircle ↦ (unitAddCircleChart z : ℝ)) ⁻¹'
        Set.Iio (Int.fract (-((n : ℕ) * r)))) := by
  let G := unitAddCircleHalfGeneratorFamily r
  have hleft_mem : unitAddCircleRightHalfᶜ ∈ G := by
    refine Set.mem_iUnion.mpr ⟨0, ?_⟩
    refine Set.mem_range.mpr ?_
    refine ⟨⟨unitAddCircleLeftHalfSet, unitAddCircleLeftHalf_mem_parts⟩, ?_⟩
    ext z
    rfl
  have hright_mem :
      (((fun y : UnitAddCircle ↦ y + (r : UnitAddCircle))^[n]) ⁻¹' unitAddCircleRightHalf) ∈ G := by
    refine Set.mem_iUnion.mpr ⟨n, ?_⟩
    refine Set.mem_range.mpr ?_
    refine ⟨⟨unitAddCircleRightHalfSet, unitAddCircleRightHalf_mem_parts⟩, ?_⟩
    ext z
    rfl
  have hleft :
      MeasurableSet[MeasurableSpace.generateFrom G] unitAddCircleRightHalfᶜ :=
    MeasurableSpace.measurableSet_generateFrom hleft_mem
  have hright :
      MeasurableSet[MeasurableSpace.generateFrom G]
        ((((fun y : UnitAddCircle ↦ y + (r : UnitAddCircle))^[n]) ⁻¹' unitAddCircleRightHalf)) :=
    MeasurableSpace.measurableSet_generateFrom hright_mem
  -- Proof comment: the chart threshold preimage is exactly one Boolean combination of the two
  -- generator pieces from the previous lemma, so measurability is immediate.
  rw [chartPreimageIioLeftThreshold_eq_generatorPieces]
  by_cases hthreshold : Int.fract (-((n : ℕ) * r)) ≤ (1 / 2 : ℝ)
  · rw [if_pos hthreshold]
    exact hleft.inter hright
  · rw [if_neg hthreshold]
    simpa [compl_compl] using hleft.union (hleft.compl.inter hright)

/-- Helper for Example 20.36: for irrational `r`, the `[0,1)` chart is measurable for the
σ-algebra generated by the half-partition iterates. -/
private theorem chartMeasurable_generateFrom_of_irrational
    (r : ℝ) (hr : Irrational r) :
    Measurable[MeasurableSpace.generateFrom (unitAddCircleHalfGeneratorFamily r),
      Subtype.instMeasurableSpace] unitAddCircleChart := by
  let leftThreshold : ℕ → Set.Ico (0 : ℝ) 1 := fun n ↦
    ⟨Int.fract (-((n : ℕ) * r)), ⟨Int.fract_nonneg _, Int.fract_lt_one _⟩⟩
  have hdense : Dense (Set.range leftThreshold) :=
    unitAddCircleLeftThresholdDense_of_irrational r hr
  have hbase :
      Measurable[MeasurableSpace.generateFrom (unitAddCircleHalfGeneratorFamily r), borel ℝ]
        (fun z : UnitAddCircle ↦ (unitAddCircleChart z : ℝ)) := by
    letI : MeasurableSpace UnitAddCircle :=
      MeasurableSpace.generateFrom (unitAddCircleHalfGeneratorFamily r)
    change Measurable[MeasurableSpace.generateFrom (unitAddCircleHalfGeneratorFamily r), borel ℝ]
      (fun z : UnitAddCircle ↦ (unitAddCircleChart z : ℝ))
    rw [borel_eq_generateFrom_Iio ℝ]
    refine measurable_generateFrom ?_
    rintro _ ⟨x, rfl⟩
    by_cases hx0 : x ≤ (0 : ℝ)
    · -- Proof comment: the chart is nonnegative, so lower rays below `0` have empty preimage.
      have hpre :
          ((fun z : UnitAddCircle ↦ (unitAddCircleChart z : ℝ)) ⁻¹' Set.Iio x) = ∅ := by
        ext z
        constructor
        · intro hz
          exact False.elim ((not_lt_of_ge (unitAddCircleChart z).2.1) (lt_of_lt_of_le hz hx0))
        · intro hz
          exact False.elim hz
      simpa [hpre]
    · by_cases hx1 : (1 : ℝ) ≤ x
      · -- Proof comment: the chart always lands in `[0,1)`, so lower rays above `1` pull back
        -- to the whole circle.
        have hpre :
            ((fun z : UnitAddCircle ↦ (unitAddCircleChart z : ℝ)) ⁻¹' Set.Iio x) = Set.univ := by
          ext z
          constructor
          · intro _
            simp
          · intro _
            exact lt_of_lt_of_le (unitAddCircleChart z).2.2 hx1
        simpa [hpre]
      · let a : Set.Ico (0 : ℝ) 1 := ⟨x, ⟨le_of_lt (lt_of_not_ge hx0), lt_of_not_ge hx1⟩⟩
        have hIio :
            Set.Iio a = ⋃ n : {n : ℕ // leftThreshold n < a}, Set.Iio (leftThreshold n) := by
          rw [hdense.Iio_eq_biUnion a]
          ext y
          constructor
          · intro hy
            rcases Set.mem_iUnion₂.mp hy with ⟨b, hb, hy⟩
            rcases hb with ⟨hbRange, hba⟩
            rcases hbRange with ⟨n, rfl⟩
            exact Set.mem_iUnion.mpr ⟨⟨n, hba⟩, hy⟩
          · intro hy
            rcases Set.mem_iUnion.mp hy with ⟨n, hy⟩
            exact Set.mem_iUnion₂.mpr ⟨leftThreshold n.1, ⟨⟨n.1, rfl⟩, n.2⟩, hy⟩
        -- Proof comment: inside the seam-free interval `(0,1)`, the dense threshold orbit
        -- expands the real lower ray into a countable union of threshold lower rays.
        change MeasurableSet[MeasurableSpace.generateFrom (unitAddCircleHalfGeneratorFamily r)]
          (unitAddCircleChart ⁻¹' Set.Iio a)
        rw [hIio, Set.preimage_iUnion]
        refine MeasurableSet.iUnion ?_
        intro n
        change MeasurableSet[MeasurableSpace.generateFrom (unitAddCircleHalfGeneratorFamily r)]
          ((fun z : UnitAddCircle ↦ (unitAddCircleChart z : ℝ)) ⁻¹'
            Set.Iio (Int.fract (-((n.1 : ℕ) * r))))
        simpa [leftThreshold] using chartPreimageIioLeftThreshold_measurable_generateFrom r n.1
  -- Proof comment: the subtype-valued chart is measurable once its real-valued coordinate is.
  exact hbase.subtype_mk

-- Proof sketch: for irrational `r`, the backward iterates of the two half-circles separate points
-- on `AddCircle 1`, so they generate the Borel σ-algebra.
/-- For irrational `r`, the canonical half-circle partition is a generator for the rotation
`x ↦ x + r` on `AddCircle 1`. -/
theorem unitAddCircleHalfPartition_is_generator_of_irrational
    (r : ℝ) (hr : Irrational r) :
    is_generator ((· + (r : UnitAddCircle))) unitAddCircleHalfPartition := by
  let G := unitAddCircleHalfGeneratorFamily r
  let mAmbient : MeasurableSpace UnitAddCircle := inferInstance
  have hmGen_le : MeasurableSpace.generateFrom G ≤ mAmbient := by
    -- Proof comment: every generator is an iterate-preimage of one measurable atom of the
    -- half-circle partition, hence already measurable in the ambient circle σ-algebra.
    refine MeasurableSpace.generateFrom_le ?_
    intro s hs
    rcases Set.mem_iUnion.mp hs with ⟨n, hs⟩
    rcases Set.mem_range.mp hs with ⟨A, rfl⟩
    exact A.1.2.preimage
      (Measurable.iterate
        (measurePreserving_add_right volume (r : UnitAddCircle)).measurable n)
  letI : MeasurableSpace UnitAddCircle := MeasurableSpace.generateFrom G
  have hchart :
      Measurable[MeasurableSpace.generateFrom G, Subtype.instMeasurableSpace]
        unitAddCircleChart :=
    chartMeasurable_generateFrom_of_irrational r hr
  have hdecodeMeas :
      Measurable[MeasurableSpace.generateFrom G, mAmbient] fun z : UnitAddCircle ↦
        ((((unitAddCircleChart z : Set.Ico (0 : ℝ) 1) : ℝ) : UnitAddCircle)) := by
    -- Proof comment: compose the measurable chart with the measurable quotient map `ℝ →
    -- AddCircle 1` to obtain a measurable map back to the ambient circle.
    exact (AddCircle.measurable_mk'.comp measurable_subtype_coe).comp hchart
  have hdecodeEqId :
      (fun z : UnitAddCircle ↦
        ((((unitAddCircleChart z : Set.Ico (0 : ℝ) 1) : ℝ) : UnitAddCircle))) = id := by
    -- Proof comment: decoding the normalized chart is literally the identity on the circle.
    funext z
    simpa [id] using unitAddCircleChart_roundtrip z
  have hambient_le : mAmbient ≤ MeasurableSpace.generateFrom G := by
    -- Proof comment: since the measurable chart-decoder is the identity, every ambient
    -- measurable set pulls back to a set in the generated σ-algebra.
    have hcomap :
        MeasurableSpace.comap
            (fun z : UnitAddCircle ↦
              ((((unitAddCircleChart z : Set.Ico (0 : ℝ) 1) : ℝ) : UnitAddCircle)))
            mAmbient ≤
          MeasurableSpace.generateFrom G :=
      (hdecodeMeas.comap_le :
        MeasurableSpace.comap
            (fun z : UnitAddCircle ↦
              ((((unitAddCircleChart z : Set.Ico (0 : ℝ) 1) : ℝ) : UnitAddCircle)))
            mAmbient ≤
          MeasurableSpace.generateFrom G)
    have hidcomap : MeasurableSpace.comap id mAmbient ≤ MeasurableSpace.generateFrom G := by
      simpa [hdecodeEqId] using hcomap
    exact (MeasurableSpace.comap_id (m := mAmbient)) ▸ hidcomap
  exact le_antisymm hmGen_le hambient_le

/-- Helper for Example 20.36: for irrational `r`, every measurable subset of `UnitAddCircle` is
approximable in measure by a finite union of atoms of one long half-block partition. -/
private theorem existsUnionHalfBlockAtomsSymmDiffLt_of_irrational
    (r : ℝ) (hr : Irrational r) {s : Set UnitAddCircle} (hs : MeasurableSet s) {ε : ℝ}
    (hε : 0 < ε) :
    ∃ approx :
      BlockApproximationData
        (measurePreserving_add_right volume (r : UnitAddCircle)).measurable
        unitAddCircleHalfPartition,
      BlockApproximationGood volume
        (measurePreserving_add_right volume (r : UnitAddCircle)).measurable
        unitAddCircleHalfPartition s ε approx := by
  -- Proof comment: specialize the general generator-approximation lemma to the irrational
  -- half-circle generator proved just above.
  exact exists_unionBlockAtoms_symmDiff_lt_of_generator
    (P := volume)
    (hτ := (measurePreserving_add_right volume (r : UnitAddCircle)).measurable)
    (part := unitAddCircleHalfPartition)
    (unitAddCircleHalfPartition_is_generator_of_irrational r hr) hs hε

/-- Helper for Example 20.36: the comparison sequence `log (2 n) / n` tends to `0` along
positive integers. -/
private theorem tendsto_log_two_mul_div_atTop_zero :
    Tendsto (fun n : ℕ+ => Real.log (2 * (n : ℝ)) / (n : ℝ)) atTop (𝓝 0) := by
  have hbase : Tendsto (fun x : ℝ => Real.log x / x) atTop (𝓝 0) := by
    simpa using Real.tendsto_pow_log_div_mul_add_atTop 1 0 1 one_ne_zero
  have hcomp :
      Tendsto (fun x : ℝ => Real.log (2 * x) / (2 * x)) atTop (𝓝 0) := by
    have hmul : Tendsto (fun x : ℝ => 2 * x) atTop atTop := by
      simpa using
        (tendsto_id : Tendsto (fun x : ℝ ↦ x) atTop atTop).const_mul_atTop
          (show 0 < (2 : ℝ) by norm_num)
    exact hbase.comp hmul
  have hscaled :
      Tendsto (fun x : ℝ => 2 * (Real.log (2 * x) / (2 * x))) atTop (𝓝 0) := by
    simpa using tendsto_const_nhds.mul hcomp
  have hEq :
      (fun x : ℝ => Real.log (2 * x) / x) =
        fun x : ℝ => 2 * (Real.log (2 * x) / (2 * x)) := by
    funext x
    by_cases hx : x = 0
    · simp [hx]
    · field_simp [hx]
  have hreal :
      Tendsto (fun x : ℝ => Real.log (2 * x) / x) atTop (𝓝 0) := by
    rw [hEq]
    exact hscaled
  have hpnat_cast :
      Tendsto (fun n : ℕ+ => (n : ℝ)) atTop atTop := by
    simpa using (tendsto_natCast_atTop_atTop.comp tendsto_PNat_val_atTop_atTop)
  simpa using hreal.comp hpnat_cast

-- Proof sketch: the block cardinality bound `#𝒫ₙ ≤ 2 n` forces the normalized block entropies of
-- the half-circle partition to tend to `0`, hence its dynamical entropy is `0`.
/-- Helper for Example 20.36 (2): if `r` is irrational, then the dynamical entropy of the
canonical
half-circle partition is `0`. -/
-- TODO: combine the `2 * n` block-cardinality estimate with `entropy_le_log_card` and the same
-- `sInf` small-term pattern used in `dynamicalEntropy_eq_zero_of_periodicIterate`.
theorem unitAddCircleHalfPartition_dynamicalEntropy_eq_zero_of_irrational
    (r : ℝ) (hr : Irrational r) :
    h(volume, ((· + (r : UnitAddCircle))),
      (measurePreserving_add_right volume (r : UnitAddCircle)).measurable;
      unitAddCircleHalfPartition) = 0 := by
  classical
  let S : Set EReal :=
    Set.range fun n : ℕ+ ↦
      (unitAddCircleHalfPartition.block
          ((· + (r : UnitAddCircle)))
          (measurePreserving_add_right volume (r : UnitAddCircle)).measurable n).partitionEntropy
        volume * (((n : ℕ) : EReal)⁻¹)
  rw [MeasurableFinpartition.dynamicalEntropy_def]
  change sInf S = 0
  have hterm_nonneg :
      ∀ a ∈ S, 0 ≤ a := by
    rintro _ ⟨n, rfl⟩
    -- Proof comment: both the block entropy and the normalizing factor are nonnegative.
    refine mul_nonneg ?_ ?_
    · simpa [MeasurableFinpartition.partitionEntropy_def] using
        entropy_nonneg
          ((unitAddCircleHalfPartition.block
              ((· + (r : UnitAddCircle)))
              (measurePreserving_add_right volume (r : UnitAddCircle)).measurable n).toPMF
            volume)
    · positivity
  have hterm_upper (n : ℕ+) :
      (unitAddCircleHalfPartition.block
          ((· + (r : UnitAddCircle)))
          (measurePreserving_add_right volume (r : UnitAddCircle)).measurable n).partitionEntropy
        volume * (((n : ℕ) : EReal)⁻¹) ≤
        ((Real.log (2 * (n : ℝ)) / (n : ℝ) : ℝ) : EReal) := by
    letI :
        Fintype
          ((unitAddCircleHalfPartition.block
              ((· + (r : UnitAddCircle)))
              (measurePreserving_add_right volume (r : UnitAddCircle)).measurable n).parts) :=
      Fintype.ofFinite _
    have hpart_upper :
        (unitAddCircleHalfPartition.block
            ((· + (r : UnitAddCircle)))
            (measurePreserving_add_right volume (r : UnitAddCircle)).measurable n).partitionEntropy
          volume ≤
          (Real.log (2 * (n : ℝ)) : EReal) := by
      have hparts_nonempty :
          Nonempty
            ((unitAddCircleHalfPartition.block
                ((· + (r : UnitAddCircle)))
                (measurePreserving_add_right volume (r : UnitAddCircle)).measurable n).parts) :=
        ⟨(unitAddCircleHalfPartition.block
            ((· + (r : UnitAddCircle)))
            (measurePreserving_add_right volume (r : UnitAddCircle)).measurable n).toSimpleFunc 0⟩
      rw [MeasurableFinpartition.partitionEntropy_def]
      calc
        entropy
            ((unitAddCircleHalfPartition.block
                ((· + (r : UnitAddCircle)))
                (measurePreserving_add_right volume (r : UnitAddCircle)).measurable n).toPMF
              volume) ≤
            Real.log
              (Fintype.card
                (unitAddCircleHalfPartition.block
                  ((· + (r : UnitAddCircle)))
                  (measurePreserving_add_right volume (r : UnitAddCircle)).measurable n).parts) :=
          entropy_le_log_card _
        _ ≤ Real.log (2 * (n : ℝ)) := by
            have hcard_pos :
                0 <
                  (Fintype.card
                    ((unitAddCircleHalfPartition.block
                        ((· + (r : UnitAddCircle)))
                        (measurePreserving_add_right volume (r : UnitAddCircle)).measurable
                        n).parts) : ℝ) := by
              exact_mod_cast Fintype.card_pos_iff.mpr hparts_nonempty
            have hcard_le :
                (Fintype.card
                  ((unitAddCircleHalfPartition.block
                      ((· + (r : UnitAddCircle)))
                      (measurePreserving_add_right volume (r : UnitAddCircle)).measurable
                      n).parts) : ℝ) ≤
                  2 * (n : ℝ) := by
              let blockParts :=
                (unitAddCircleHalfPartition.block
                  ((· + (r : UnitAddCircle)))
                  (measurePreserving_add_right volume (r : UnitAddCircle)).measurable n).parts
              have hcard_le_nat : Nat.card blockParts ≤ 2 * (n : ℕ) :=
                unitAddCircleHalfPartition_block_card_le_two_mul_of_irrational r hr n
              simpa [blockParts, Nat.card_eq_fintype_card] using
                (show (((Nat.card blockParts : ℕ) : ℝ)) ≤ (((2 * (n : ℕ) : ℕ) : ℝ)) by
                  exact_mod_cast hcard_le_nat)
            exact_mod_cast Real.log_le_log hcard_pos hcard_le
    calc
      (unitAddCircleHalfPartition.block
          ((· + (r : UnitAddCircle)))
          (measurePreserving_add_right volume (r : UnitAddCircle)).measurable n).partitionEntropy
        volume * (((n : ℕ) : EReal)⁻¹) ≤
          (Real.log (2 * (n : ℝ)) : EReal) * (((n : ℕ) : EReal)⁻¹) := by
            exact mul_le_mul_of_nonneg_right hpart_upper (by positivity)
      _ = ((Real.log (2 * (n : ℝ)) / (n : ℝ) : ℝ) : EReal) := by
          have hnat_inv :
              (((n : ℕ) : EReal)⁻¹) = ((((n : ℝ))⁻¹ : ℝ) : EReal) := by
            rw [show ((n : ℕ) : EReal) = ((n : ℝ) : EReal) by norm_num]
            rw [← EReal.coe_inv (n : ℝ)]
          calc
            (Real.log (2 * (n : ℝ)) : EReal) * (((n : ℕ) : EReal)⁻¹) =
                (Real.log (2 * (n : ℝ)) : EReal) * ((((n : ℝ))⁻¹ : ℝ) : EReal) := by
                  rw [hnat_inv]
            _ = ((Real.log (2 * (n : ℝ)) * (n : ℝ)⁻¹ : ℝ) : EReal) := by
                  rw [← EReal.coe_mul]
            _ = ((Real.log (2 * (n : ℝ)) / (n : ℝ) : ℝ) : EReal) := by
                  simp [one_div, div_eq_mul_inv]
  have hsmall_term :
      ∀ w, 0 < w → ∃ a ∈ S, a < w := by
    intro w hw
    by_cases hw_top : w = ⊤
    · refine ⟨(unitAddCircleHalfPartition.block
          ((· + (r : UnitAddCircle)))
          (measurePreserving_add_right volume (r : UnitAddCircle)).measurable
          (1 : ℕ+)).partitionEntropy volume * (((1 : ℕ) : EReal)⁻¹),
