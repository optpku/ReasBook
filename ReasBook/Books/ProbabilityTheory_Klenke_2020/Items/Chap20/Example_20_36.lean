local instance : IsProbabilityMeasure (volume : Measure UnitAddCircle) := by
  refine ⟨by
    rw [show (1 : ENNReal) = ENNReal.ofReal (1 : ℝ) by norm_num]
    exact AddCircle.measure_univ (1 : ℝ)
