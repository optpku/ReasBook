import Mathlib
import Mathlib.Dynamics.Ergodic.Ergodic
import Books.ProbabilityTheory_Klenke_2020.Items.Chap20.Definition_20_5

open MeasureTheory ProbabilityTheory
open scoped Pointwise

variable (n r : ℕ) [NeZero n]

/-- The set `A_i = i + ⟨r⟩` is the coset of the additive subgroup of `ZMod n` generated by `r`
through the point `i`. -/
def A_i (i : ZMod n) : Set (ZMod n) :=
  {x | x - i ∈ AddSubgroup.zmultiples (r : ZMod n)}

section

omit [NeZero n]

/-- This rewrites `A_i` in the textbook coset form `i + ⟨r⟩`. -/
theorem A_i_eq_vadd_zmultiples (i : ZMod n) :
    A_i n r i = i +ᵥ ((AddSubgroup.zmultiples (r : ZMod n)) : Set (ZMod n)) := by
  -- Expand both set descriptions and rewrite `x = i + y` as `x - i = y`.
  ext x
  constructor
  · intro hx
    refine ⟨x - i, hx, ?_⟩
    simp [sub_eq_add_neg]
  · rintro ⟨y, hy, rfl⟩
    -- Membership in the subgroup is exactly the required witness for the translated point.
    simpa [A_i, sub_eq_add_neg, add_assoc, add_left_comm, add_comm] using hy

/-- The sets `A_i` are exactly the fibers of the quotient map modulo the subgroup generated by
`r`. -/
theorem A_i_eq_fiber_quotientMk (i : ZMod n) :
    A_i n r i = {x : ZMod n | (x : ZMod n ⧸ AddSubgroup.zmultiples (r : ZMod n)) = i} := by
  -- Quotient equality modulo `⟨r⟩` is exactly the statement that the difference lies in `⟨r⟩`.
  ext x
  simp [A_i, QuotientAddGroup.eq_iff_sub_mem]

/-- Two sets `A_i` and `A_j` agree exactly when `i` and `j` define the same class modulo the
subgroup generated by `r`. -/
theorem A_i_eq_A_j_iff (i j : ZMod n) :
    A_i n r i = A_i n r j ↔
      (i : ZMod n ⧸ AddSubgroup.zmultiples (r : ZMod n)) = j := by
  -- Fibers of a function are equal exactly when the corresponding values agree.
  rw [A_i_eq_fiber_quotientMk, A_i_eq_fiber_quotientMk]
  constructor
  · intro h
    have hi : i ∈ ({x : ZMod n | (x : ZMod n ⧸ AddSubgroup.zmultiples (r : ZMod n)) = i} :
        Set (ZMod n)) := by
      simp
    simpa [h] using hi
  · intro hij
    ext x
    simp [hij]

/-- Distinct quotient classes give disjoint cosets `A_i`. -/
theorem A_i_disjoint_of_ne (i j : ZMod n)
    (hij : (i : ZMod n ⧸ AddSubgroup.zmultiples (r : ZMod n)) ≠ j) :
    Disjoint (A_i n r i) (A_i n r j) := by
  -- Distinct fibers of the quotient map are disjoint.
  rw [Set.disjoint_left]
  intro x hx hx'
  rw [A_i_eq_fiber_quotientMk] at hx hx'
  exact hij (hx.symm.trans hx')

/-- Helper for Example 20.8: if `A` is invariant under translation by `r`, then membership in `A`
is unchanged after translating by any integer multiple of `r`. -/
lemma mem_iff_add_zsmul_mem_of_invariant {A : Set (ZMod n)}
    (hA : ((fun x : ZMod n => x + (r : ZMod n)) ⁻¹' A) = A)
    (x : ZMod n) (z : ℤ) :
    x ∈ A ↔ x + z • (r : ZMod n) ∈ A := by
  have hstep : ∀ y : ZMod n, y ∈ A ↔ y + (r : ZMod n) ∈ A := by
    intro y
    change y ∈ A ↔ y ∈ (fun x : ZMod n => x + (r : ZMod n)) ⁻¹' A
    rw [hA]
  have hstep' : ∀ y : ZMod n, y ∈ A ↔ y - (r : ZMod n) ∈ A := by
    intro y
    simpa [sub_eq_add_neg, add_assoc, add_left_comm, add_comm] using
      (hstep (y - (r : ZMod n))).symm
  -- Integer induction transports the one-step invariance along all translates in `⟨r⟩`.
  induction z using Int.negInduction with
  | nat m =>
      induction m with
      | zero =>
          simp
      | succ m hm =>
          calc
            x ∈ A ↔ x + (m : ℤ) • (r : ZMod n) ∈ A := hm
            _ ↔ x + (m : ℤ) • (r : ZMod n) + (r : ZMod n) ∈ A := hstep _
            _ ↔ x + ((m + 1 : ℤ) • (r : ZMod n)) ∈ A := by
              have hEq :
                  x + (m : ℤ) • (r : ZMod n) + (r : ZMod n) =
                    x + ((m + 1 : ℤ) • (r : ZMod n)) := by
                ring_nf
              rw [hEq]
  | neg _ m =>
      induction m with
      | zero =>
          simp
      | succ m hm =>
          calc
            x ∈ A ↔ x + (-((m : ℤ)) • (r : ZMod n)) ∈ A := hm
            _ ↔ x + (-((m : ℤ)) • (r : ZMod n)) - (r : ZMod n) ∈ A := hstep' _
            _ ↔ x + (-((m + 1 : ℤ)) • (r : ZMod n)) ∈ A := by
              have hEq :
                  x + (-((m : ℤ)) • (r : ZMod n)) - (r : ZMod n) =
                    x + (-((m + 1 : ℤ)) • (r : ZMod n)) := by
                ring_nf
              rw [hEq]

end

/-- Every invariant set for translation by `r` is a union of some of the cosets `A_i`. -/
theorem is_invariant_event_iff_eq_iUnion_A_i (A : Set (ZMod n)) :
    is_invariant_event ((· + (r : ZMod n)) : ZMod n → ZMod n) A ↔
      ∃ s : Set (ZMod n), A = ⋃ i ∈ s, A_i n r i := by
  constructor
  · rintro ⟨hA_meas, hA_inv⟩
    refine ⟨A, ?_⟩
    -- An invariant set is the union of the orbit-cosets through its own points.
    ext x
    constructor
    · intro hx
      have hxAi : x ∈ A_i n r x := by
        change x - x ∈ AddSubgroup.zmultiples (r : ZMod n)
        simp
      exact Set.mem_iUnion.2 ⟨x, Set.mem_iUnion.2 ⟨hx, by
        exact hxAi⟩⟩
    · intro hx
      rcases Set.mem_iUnion.1 hx with ⟨i, hxi⟩
      rcases Set.mem_iUnion.1 hxi with ⟨hiA, hxi⟩
      rw [A_i] at hxi
      rcases AddSubgroup.mem_zmultiples_iff.1 hxi with ⟨z, hz⟩
      have hx_eq : x = i + z • (r : ZMod n) := by
        calc
          x = i + (x - i) := by
            simp [sub_eq_add_neg, add_left_comm]
          _ = i + z • (r : ZMod n) := by rw [← hz]
      -- Orbit saturation follows from invariance under all integer translates by `r`.
      exact hx_eq ▸ (mem_iff_add_zsmul_mem_of_invariant n r hA_inv i z).mp hiA
  · rintro ⟨s, rfl⟩
    refine ⟨?_, ?_⟩
    · -- Every subset of the finite discrete space `ZMod n` is measurable.
      exact (Set.toFinite _).measurableSet
    · -- Each coset `A_i` is stable under translation by `r`, hence any union of them is stable.
      ext x
      constructor
      · intro hx
        change x + (r : ZMod n) ∈ ⋃ i ∈ s, A_i n r i at hx
        rcases Set.mem_iUnion.1 hx with ⟨i, hxi⟩
        rcases Set.mem_iUnion.1 hxi with ⟨hiS, hxAi⟩
        refine Set.mem_iUnion.2 ⟨i, Set.mem_iUnion.2 ⟨hiS, ?_⟩⟩
        rw [A_i] at hxAi ⊢
        have hr : (r : ZMod n) ∈ AddSubgroup.zmultiples (r : ZMod n) :=
          AddSubgroup.mem_zmultiples (r : ZMod n)
        simpa [sub_eq_add_neg, add_assoc, add_left_comm, add_comm] using
          (AddSubgroup.zmultiples (r : ZMod n)).sub_mem hxAi hr
      · intro hx
        change x + (r : ZMod n) ∈ ⋃ i ∈ s, A_i n r i
        rcases Set.mem_iUnion.1 hx with ⟨i, hxi⟩
        rcases Set.mem_iUnion.1 hxi with ⟨hiS, hxAi⟩
        refine Set.mem_iUnion.2 ⟨i, Set.mem_iUnion.2 ⟨hiS, ?_⟩⟩
        rw [A_i] at hxAi ⊢
        have hr : (r : ZMod n) ∈ AddSubgroup.zmultiples (r : ZMod n) :=
          AddSubgroup.mem_zmultiples (r : ZMod n)
        simpa [sub_eq_add_neg, add_assoc, add_left_comm, add_comm] using
          (AddSubgroup.zmultiples (r : ZMod n)).add_mem hxAi hr

/-- The subgroup generated by `r` is all of `ZMod n` exactly when `r` and `n` are coprime. -/
theorem zmultiples_eq_top_iff_coprime :
    AddSubgroup.zmultiples (r : ZMod n) = ⊤ ↔ Nat.Coprime r n := by
  -- Compare the subgroup cardinality with the cardinality of the ambient cyclic group.
  rw [← AddSubgroup.card_eq_iff_eq_top, Nat.card_zmultiples, Nat.card_zmod,
    ZMod.addOrderOf_coe r (NeZero.ne n), Nat.div_eq_self]
  constructor
  · rintro (hn | hgcd)
    · exact False.elim ((NeZero.ne n) hn)
    · rwa [Nat.coprime_iff_gcd_eq_one, Nat.gcd_comm]
  · intro hcop
    right
    simpa [Nat.gcd_comm] using hcop.gcd_eq_one

-- Proof sketch: translation by a fixed residue class is a permutation of the finite set `ZMod n`,
-- so it preserves the uniform measure.
/-- Translation on `ZMod n` preserves the uniform probability measure. -/
theorem zmodTranslation_measurePreserving :
    MeasurePreserving ((· + (r : ZMod n)) : ZMod n → ZMod n)
      (uniformOn (Set.univ : Set (ZMod n)))
      (uniformOn (Set.univ : Set (ZMod n))) := by
  let μ : Measure (ZMod n) :=
    ((Fintype.card (ZMod n) : ENNReal)⁻¹) • (Measure.count : Measure (ZMod n))
  have hμ : uniformOn (Set.univ : Set (ZMod n)) = μ := by
    ext s hs
    rw [ProbabilityTheory.uniformOn_univ]
    simp [μ, Measure.smul_apply, Measure.count_apply, ENNReal.div_eq_inv_mul]
  -- Rewrite the target measure as a scalar multiple of counting measure and use translation
  -- invariance of counting measure.
  simpa [hμ, μ] using measurePreserving_add_right μ (r : ZMod n)

-- Proof sketch: combine the source-facing decomposition of invariant sets into the cosets `A_i`
-- with the criterion `AddSubgroup.zmultiples (r : ZMod n) = ⊤ ↔ Nat.Coprime r n`.
/-- Example 20.8: for the translation `x ↦ x + r` on `ZMod n` with the uniform probability
measure, ergodicity is equivalent to `r` being coprime to `n`. -/
theorem zmodTranslation_ergodic_iff_coprime :
    Ergodic ((· + (r : ZMod n)) : ZMod n → ZMod n)
      (uniformOn (Set.univ : Set (ZMod n))) ↔
      Nat.Coprime r n := by
  constructor
  · intro hErg
    by_contra hCoprime
    have hNotTop : AddSubgroup.zmultiples (r : ZMod n) ≠ ⊤ := by
      intro hTop
      exact hCoprime ((zmultiples_eq_top_iff_coprime n r).1 hTop)
    have hA0_inv : is_invariant_event ((· + (r : ZMod n)) : ZMod n → ZMod n) (A_i n r 0) := by
      refine ⟨(Set.toFinite _).measurableSet, ?_⟩
      -- The base coset is stable under translation by `r`.
      ext x
      constructor
      · intro hx
        rw [A_i] at hx ⊢
        have hr : (r : ZMod n) ∈ AddSubgroup.zmultiples (r : ZMod n) :=
          AddSubgroup.mem_zmultiples (r : ZMod n)
        simpa [sub_eq_add_neg, add_assoc, add_left_comm, add_comm] using
          (AddSubgroup.zmultiples (r : ZMod n)).sub_mem hx hr
      · intro hx
        rw [A_i] at hx ⊢
        have hr : (r : ZMod n) ∈ AddSubgroup.zmultiples (r : ZMod n) :=
          AddSubgroup.mem_zmultiples (r : ZMod n)
        simpa [sub_eq_add_neg, add_assoc, add_left_comm, add_comm] using
          (AddSubgroup.zmultiples (r : ZMod n)).add_mem hx hr
    have hA0_nonempty : (A_i n r 0 : Set (ZMod n)).Nonempty := by
      refine ⟨0, ?_⟩
      simp [A_i]
    have hA0_fin : (A_i n r 0 : Set (ZMod n)).Finite := Set.toFinite _
    have hA0_ne_univ : A_i n r 0 ≠ (Set.univ : Set (ZMod n)) := by
      intro hA0
      apply hNotTop
      rw [AddSubgroup.eq_top_iff']
      intro x
      have hx : x ∈ A_i n r 0 := by
        rw [hA0]
        simp
      simpa [A_i] using hx
    have hA0_ne_zero : uniformOn (Set.univ : Set (ZMod n)) (A_i n r 0) ≠ 0 := by
      rw [ProbabilityTheory.uniformOn_univ]
      intro hZero
      rcases (ENNReal.div_eq_zero_iff).1 hZero with hCount | hTop
      · exact hA0_nonempty.ne_empty (Measure.count_eq_zero_iff.1 hCount)
      · exact (ENNReal.natCast_ne_top _ hTop).elim
    have hA0_ne_one : uniformOn (Set.univ : Set (ZMod n)) (A_i n r 0) ≠ 1 := by
      rw [ProbabilityTheory.uniformOn_univ]
      intro hOne
      have hcard_ne_zero : ((Fintype.card (ZMod n) : ENNReal) ≠ 0) := by
        exact_mod_cast Fintype.card_ne_zero
      have hCount : Measure.count (A_i n r 0) = (Fintype.card (ZMod n) : ENNReal) := by
        have hMul := congrArg (fun t : ENNReal => t * (Fintype.card (ZMod n) : ENNReal)) hOne
        change
          Measure.count (A_i n r 0) / (Fintype.card (ZMod n) : ENNReal) *
              (Fintype.card (ZMod n) : ENNReal) =
            1 * (Fintype.card (ZMod n) : ENNReal) at hMul
        rw [ENNReal.div_mul_cancel hcard_ne_zero (by simp), one_mul] at hMul
        exact hMul
      have hCardFinset : hA0_fin.toFinset.card = Fintype.card (ZMod n) := by
        rw [Measure.count_apply_finite (A_i n r 0) hA0_fin] at hCount
        exact_mod_cast hCount
      have hFinset : hA0_fin.toFinset = Finset.univ := by
        apply Finset.eq_univ_of_card
        exact hCardFinset
      have hA0_univ : A_i n r 0 = (Set.univ : Set (ZMod n)) := by
        calc
          A_i n r 0 = ((hA0_fin.toFinset : Finset (ZMod n)) : Set (ZMod n)) := by
            symm
            exact Set.Finite.coe_toFinset hA0_fin
          _ = Set.univ := by
            rw [hFinset]
            simp
      exact hA0_ne_univ hA0_univ
    have hMeasureA0 := hErg.toPreErgodic.prob_eq_zero_or_one
      (s := A_i n r 0) hA0_inv.1 hA0_inv.2
    rcases hMeasureA0 with hZero | hOne
    · exact hA0_ne_zero hZero
    · exact hA0_ne_one hOne
  · intro hCoprime
    refine ⟨zmodTranslation_measurePreserving n r, ?_⟩
    refine ⟨?_⟩
    intro A hA_meas hA_inv
    rcases (is_invariant_event_iff_eq_iUnion_A_i n r A).1 ⟨hA_meas, hA_inv⟩ with ⟨s, hs⟩
    have hTop : AddSubgroup.zmultiples (r : ZMod n) = ⊤ :=
      (zmultiples_eq_top_iff_coprime n r).2 hCoprime
    have hAuniv : ∀ i : ZMod n, A_i n r i = (Set.univ : Set (ZMod n)) := by
      intro i
      ext x
      simp [A_i, hTop]
    -- Once `⟨r⟩ = ⊤`, every invariant set is either the empty union or the whole space.
    by_cases hs_nonempty : s.Nonempty
    · obtain ⟨i, hi⟩ := hs_nonempty
      have hAeq : A = (Set.univ : Set (ZMod n)) := by
        rw [hs]
        ext x
        constructor
        · intro _
          simp
        · intro _
          refine Set.mem_iUnion.2 ⟨i, Set.mem_iUnion.2 ⟨hi, ?_⟩⟩
          rw [hAuniv i]
          simp
      simpa [hAeq] using
        (Filter.eventuallyConst_set'.2
          (Or.inr
            (show (Set.univ : Set (ZMod n)) =ᶠ[ae (uniformOn (Set.univ : Set (ZMod n)))] Set.univ
              from Filter.EventuallyEq.rfl)))
    · have hs_empty : s = (∅ : Set (ZMod n)) := Set.not_nonempty_iff_eq_empty.1 hs_nonempty
      have hAeq : A = (∅ : Set (ZMod n)) := by
        rw [hs, hs_empty]
        simp
      simpa [hAeq] using
        (Filter.eventuallyConst_set'.2
          (Or.inl
            (show (∅ : Set (ZMod n)) =ᶠ[ae (uniformOn (Set.univ : Set (ZMod n)))]
                (∅ : Set (ZMod n))
              from Filter.EventuallyEq.rfl)))
