import Mathlib
import Mathlib.Dynamics.Ergodic.Ergodic
import Mathlib.Probability.IdentDistrib
import Mathlib.Probability.Independence.ZeroOne
import Books.ProbabilityTheory_Klenke_2020.Items.Chap02.Definition_2_14
import Books.ProbabilityTheory_Klenke_2020.Items.Chap02.Definition_2_34
import Books.ProbabilityTheory_Klenke_2020.Items.Chap02.Theorem_2_35

-- Declarations for this item will be appended below by the statement pipeline.

open Filter MeasureTheory ProbabilityTheory
open scoped MeasureTheory

universe u v

section

variable {Ω : Type u} [mΩ : MeasurableSpace Ω]
variable {E : Type v} [mE : MeasurableSpace E]
variable {P : Measure Ω} [IsProbabilityMeasure P]
variable {τ : Ω → Ω} {X : ℕ → Ω → E}

/-- Helper for Example 20.12: the iterate `τ^[n]` is measurable from the `n`-tail coordinate
`σ`-algebra to the full coordinate `σ`-algebra generated by the process. -/
lemma measurableIterateFromTailCoordinates
    (hX_iterate : ∀ n : ℕ, X n = X 0 ∘ τ^[n]) (n : ℕ) :
    Measurable[
      (⨆ i ∈ Set.Ici n, MeasurableSpace.comap (X i) mE),
      (⨆ i : ℕ, MeasurableSpace.comap (X i) mE)
    ] (τ^[n]) := by
  -- It is enough to check that every full coordinate pulled back by `τ^[n]`
  -- becomes one of the tail coordinates.
  refine Measurable.of_comap_le ?_
  rw [MeasurableSpace.comap_iSup]
  refine iSup_le fun k ↦ ?_
  rw [MeasurableSpace.comap_comp]
  have h_shift : X k ∘ τ^[n] = X (k + n) := by
    calc
      X k ∘ τ^[n] = (X 0 ∘ τ^[k]) ∘ τ^[n] := by
        rw [hX_iterate k]
      _ = X 0 ∘ τ^[k + n] := by
        rw [Function.comp_assoc, ← Function.iterate_add τ k n]
      _ = X (k + n) := by
        rw [(hX_iterate (k + n)).symm]
  rw [h_shift]
  refine le_iSup_of_le (k + n) ?_
  refine le_iSup_of_le ?_ le_rfl
  simpa [Set.mem_Ici, Nat.add_comm] using Nat.le_add_left n k

/-- Every invariant event of a shift-generated process belongs to the tail `σ`-algebra generated
by the process coordinates. -/
-- Proof sketch: if `A` is invariant under `τ`, then `A = (τ^[n]) ⁻¹' A` for every `n`. The
-- hypothesis that the ambient measurable space is generated by the coordinate maps lets one view
-- `A` as depending on the whole coordinate sequence, and the identity `X n = X 0 ∘ τ^[n]` shifts
-- this dependence to the tail coordinates `X n, X (n + 1), ...`. Hence `A` is measurable with
-- respect to every tail stage, so it belongs to the tail `σ`-algebra.
theorem invariants_le_tailRandomVariableMeasurableSpace_of_iterate_eq
    (h_generate : mΩ ≤ ⨆ n : ℕ, MeasurableSpace.comap (X n) mE)
    (hX_iterate : ∀ n : ℕ, X n = X 0 ∘ τ^[n]) :
    MeasurableSpace.invariants τ ≤ tailRandomVariableMeasurableSpace X :=
  by
  -- Rewrite the tail `σ`-algebra as the intersection of the concrete tail stages.
  rw [show tailRandomVariableMeasurableSpace X =
      ⨅ n : ℕ, ⨆ i ∈ Set.Ici n, MeasurableSpace.comap (X i) mE by
        simpa [tailRandomVariableMeasurableSpace] using
          tailMeasurableSpace_nat_eq_iInf_iSup_Ici
            (fun i ↦ MeasurableSpace.comap (X i) mE)]
  intro A hA
  rw [MeasurableSpace.measurableSet_iInf]
  rcases MeasurableSpace.measurableSet_invariants.mp hA with ⟨hA_meas, hA_invariant⟩
  -- The generation hypothesis upgrades ordinary measurability to the full coordinate space.
  have hA_full :
      MeasurableSet[⨆ i : ℕ, MeasurableSpace.comap (X i) mE] A :=
    h_generate A hA_meas
  intro n
  -- Pull the invariant event back along the `n`-th iterate, then rewrite using invariance.
  have hA_preimage :
      MeasurableSet[⨆ i ∈ Set.Ici n, MeasurableSpace.comap (X i) mE] ((τ^[n]) ⁻¹' A) :=
    measurableIterateFromTailCoordinates hX_iterate n hA_full
  have hA_iterate : (τ^[n]) ⁻¹' A = A :=
    Function.IsFixedPt.preimage_iterate hA_invariant n
  simpa [hA_iterate] using hA_preimage

/-- A process that is i.i.d. and realized by iterates of a map `τ` satisfies the zero-one law for
strictly `τ`-invariant measurable sets. -/
-- Proof sketch: use `invariants_le_tailRandomVariableMeasurableSpace_of_iterate_eq` to show that
-- every strictly invariant measurable set is a tail event. Then apply Kolmogorov's `0`-`1` law to
-- the independent coordinate `σ`-algebras coming from the i.i.d. process, and rewrite the result
-- as the `PreErgodic` condition.
theorem preErgodic_of_iid_of_iterate_eq
    (hX_meas : ∀ n : ℕ, Measurable (X n))
    (hX_iid : IsIID X P)
    (h_generate : mΩ ≤ ⨆ n : ℕ, MeasurableSpace.comap (X n) mE)
    (hX_iterate : ∀ n : ℕ, X n = X 0 ∘ τ^[n]) :
    PreErgodic τ P := by
  let ℱ : ℕ → MeasurableSpace Ω := fun n ↦ MeasurableSpace.comap (X n) mE
  refine ⟨?_⟩
  intro A hA hA_invariant
  -- First identify invariant events as tail events.
  have hA_tail :
      MeasurableSet[tailRandomVariableMeasurableSpace X] A :=
    invariants_le_tailRandomVariableMeasurableSpace_of_iterate_eq h_generate hX_iterate A <|
      MeasurableSpace.measurableSet_invariants.mpr ⟨hA, hA_invariant⟩
  have h_tail_eq : tailRandomVariableMeasurableSpace X = limsup ℱ atTop := by
    calc
      tailRandomVariableMeasurableSpace X = ⨅ n : ℕ, ⨆ i ∈ Set.Ici n, ℱ i := by
        simpa [ℱ, tailRandomVariableMeasurableSpace] using
          tailMeasurableSpace_nat_eq_iInf_iSup_Ici ℱ
      _ = limsup ℱ atTop := by
        rw [Filter.limsup_eq_iInf_iSup_of_nat]
        simp [Set.mem_Ici]
  have hA_limsup : MeasurableSet[limsup ℱ atTop] A := by
    rw [← h_tail_eq]
    exact hA_tail
  -- Kolmogorov's `0`-`1` law makes every tail event almost empty or almost full.
  have hPA : P A = 0 ∨ P A = 1 :=
    measure_zero_or_one_of_measurableSet_limsup_atTop
      (fun n ↦ (hX_meas n).comap_le) hX_iid.iIndepFun.iIndep hA_limsup
  rcases hPA with hPA | hPA
  · exact eventuallyConst_set'.2 <| Or.inl <| ae_eq_empty.2 hPA
  · have hA_compl : P Aᶜ = 0 := by
      rw [measure_compl hA (measure_ne_top P A), IsProbabilityMeasure.measure_univ, hPA, tsub_self]
    exact eventuallyConst_set'.2 <| Or.inr <| ae_eq_univ.2 hA_compl

/-- Example 20.12: if `X 0, X 1, X 2, ...` is an i.i.d. process on a probability space, the
ambient `σ`-algebra is generated by the coordinates, and `X n = X 0 ∘ τ^[n]` for every `n`, then
any measure-preserving realization map `τ` is ergodic. -/
-- Proof sketch: the preceding tail-measurability argument and Kolmogorov's `0`-`1` law give
-- `PreErgodic τ P`. Combining this zero-one law for invariant sets with the assumed measure
-- preservation of `τ` yields `Ergodic τ P`.
theorem ergodic_of_measurePreserving_of_iid_of_iterate_eq
    (hτ : MeasurePreserving τ P P)
    (hX_meas : ∀ n : ℕ, Measurable (X n))
    (hX_iid : IsIID X P)
    (h_generate : mΩ ≤ ⨆ n : ℕ, MeasurableSpace.comap (X n) mE)
    (hX_iterate : ∀ n : ℕ, X n = X 0 ∘ τ^[n]) :
    Ergodic τ P := by
  -- Ergodicity is measure preservation plus the zero-one law for invariant events.
  exact ⟨hτ, preErgodic_of_iid_of_iterate_eq hX_meas hX_iid h_generate hX_iterate⟩

end
