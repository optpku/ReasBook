import Mathlib

-- Declarations for this item will be appended below by the statement pipeline.

universe u v

section

variable {X : Type u} {S : Type v}

open Relation

-- Layer triage:
-- `source-facing`: a set `X` of symbols, a set `S` of words, and the incidence relation
-- `occurs : X → S → Prop`, together with the resulting decomposition of `S` into connected word
-- components and of `X` into the isolated symbols plus the symbols appearing in those components.
-- `core/canonical`: the owner abstractions `wordComponents occurs : Setoid S` and
-- `symbolComponents occurs : Setoid X`, whose classes are the occurrence-connected word and symbol
-- components.
-- `bridge/view`: the partitions `(wordComponents occurs).classes` and
-- `(symbolComponents occurs).classes`, together with the source-facing description of the latter in
-- terms of `isolatedSymbols occurs` and `symbolsOfWords occurs c`.
-- Domain sampling:
-- 1. `Relation.EqvGen.setoid r` is mathlib's owner abstraction for the equivalence relation
--    generated by repeated adjacency steps.
-- 2. `Setoid.classes` and `Setoid.isPartition_classes` are the canonical partition API attached to
--    an equivalence relation.
-- 3. `Setoid.eq_of_mem_classes` is the canonical class-equality API used to pass from a chosen
--    class representative to the corresponding source-facing subset.
-- 4. `Setoid.IsPartition` is the owner predicate for the source-facing partition view once the
--    pieces are expressed as sets of words or symbols.

/-- Two words are adjacent when some symbol occurs in both. -/
def sharesSymbol (occurs : X → S → Prop) : S → S → Prop :=
  fun s t ↦ ∃ x : X, occurs x s ∧ occurs x t

/-- The canonical setoid of words joined by a chain of shared symbol occurrences. -/
def wordComponents (occurs : X → S → Prop) : Setoid S :=
  EqvGen.setoid (sharesSymbol occurs)

/-- The symbols that do not occur in any word. -/
def isolatedSymbols (occurs : X → S → Prop) : Set X :=
  {x | ∀ s : S, ¬ occurs x s}

/-- The symbols occurring in at least one word of a given word family. -/
def symbolsOfWords (occurs : X → S → Prop) (A : Set S) : Set X :=
  {x | ∃ s, s ∈ A ∧ occurs x s}

/-- Two words that contain a common symbol lie in the same word component. -/
private theorem wordComponents_rel_of_occurs
    (occurs : X → S → Prop) {x : X} {s t : S} (hxs : occurs x s) (hxt : occurs x t) :
    wordComponents occurs s t :=
  EqvGen.rel _ _ ⟨x, hxs, hxt⟩

private theorem exists_word_of_not_isolated
    (occurs : X → S → Prop) {x : X} (hx : x ∉ isolatedSymbols occurs) :
    ∃ s, occurs x s := by
  have hx' : ¬ ∀ s : S, ¬ occurs x s := by
    simpa [isolatedSymbols] using hx
  by_contra h
  apply hx'
  intro s hxs
  exact h ⟨s, hxs⟩

/-- The canonical setoid of symbols lying in the same occurrence component: either both are
isolated, or they occur in words from one word component. -/
def symbolComponents (occurs : X → S → Prop) : Setoid X where
  r x y :=
    (x ∈ isolatedSymbols occurs ∧ y ∈ isolatedSymbols occurs) ∨
      ∃ s t, occurs x s ∧ occurs y t ∧ wordComponents occurs s t
  iseqv :=
    { refl := by
        intro x
        by_cases hx : x ∈ isolatedSymbols occurs
        · exact Or.inl ⟨hx, hx⟩
        · obtain ⟨s, hxs⟩ := exists_word_of_not_isolated occurs hx
          exact Or.inr ⟨s, s, hxs, hxs, (wordComponents occurs).refl s⟩
      symm := by
        intro x y hxy
        rcases hxy with ⟨hx, hy⟩ | ⟨s, t, hxs, hyt, hst⟩
        · exact Or.inl ⟨hy, hx⟩
        · exact Or.inr ⟨t, s, hyt, hxs, (wordComponents occurs).symm hst⟩
      trans := by
        intro x y z hxy hyz
        rcases hxy with ⟨hx, hy⟩ | ⟨s, t, hxs, hyt, hst⟩
        · rcases hyz with ⟨_, hz⟩ | ⟨u, v, hyu, hzv, _⟩
          · exact Or.inl ⟨hx, hz⟩
          · exact False.elim (hy u hyu)
        · rcases hyz with ⟨hy, hz⟩ | ⟨u, v, hyu, hzv, huv⟩
          · exact False.elim (hy t hyt)
          · exact Or.inr ⟨s, v, hxs, hzv, (wordComponents occurs).trans hst
              ((wordComponents occurs).trans
                (wordComponents_rel_of_occurs occurs hyt hyu) huv)⟩ }

private theorem symbolComponents_class_eq_isolatedSymbols
    (occurs : X → S → Prop) {x : X} (hx : x ∈ isolatedSymbols occurs) :
    {y | symbolComponents occurs y x} = isolatedSymbols occurs := by
  ext y
  constructor
  · intro hy
    rcases hy with ⟨hy, _⟩ | ⟨s, t, hys, hxt, _⟩
    · exact hy
    · exact False.elim (hx t hxt)
  · intro hy
    exact Or.inl ⟨hy, hx⟩

private theorem symbolComponents_class_eq_symbolsOfWords
    (occurs : X → S → Prop) {c : Set S} (hc : c ∈ (wordComponents occurs).classes) {s : S}
    (hs : s ∈ c) {x : X} (hxs : occurs x s) :
    {y | symbolComponents occurs y x} = symbolsOfWords occurs c := by
  have hc_eq : c = {t | wordComponents occurs t s} :=
    Setoid.eq_of_mem_classes hc hs (Setoid.mem_classes (wordComponents occurs) s)
      ((wordComponents occurs).refl s)
  ext y
  constructor
  · intro hy
    rcases hy with ⟨hy, hx⟩ | ⟨t, u, hyt, hxu, htu⟩
    · exact False.elim (hx s hxs)
    · refine ⟨t, ?_, hyt⟩
      have hts : wordComponents occurs t s := (wordComponents occurs).trans htu
        (wordComponents_rel_of_occurs occurs hxu hxs)
      simpa [hc_eq] using hts
  · rintro ⟨t, ht, hyt⟩
    have hts : wordComponents occurs t s := by
      simpa [hc_eq] using ht
    exact Or.inr ⟨t, s, hyt, hxs, hts⟩

@[simp] theorem mem_symbolComponentClasses_iff (occurs : X → S → Prop) (A : Set X) :
    A ∈ (symbolComponents occurs).classes ↔
      (A = isolatedSymbols occurs ∧ A.Nonempty) ∨
        ∃ c ∈ (wordComponents occurs).classes, A = symbolsOfWords occurs c ∧ A.Nonempty := by
  constructor
  · rintro ⟨x, rfl⟩
    by_cases hx : x ∈ isolatedSymbols occurs
    · left
      refine ⟨symbolComponents_class_eq_isolatedSymbols occurs hx, ?_⟩
      exact ⟨x, (symbolComponents occurs).refl x⟩
    · obtain ⟨s, hxs⟩ := exists_word_of_not_isolated occurs hx
      right
      refine ⟨{t | wordComponents occurs t s}, Setoid.mem_classes (wordComponents occurs) s,
        symbolComponents_class_eq_symbolsOfWords occurs
          (Setoid.mem_classes (wordComponents occurs) s) ((wordComponents occurs).refl s) hxs,
        ?_⟩
      exact ⟨x, Or.inr ⟨s, s, hxs, hxs, (wordComponents occurs).refl s⟩⟩
  · rintro (⟨rfl, hA⟩ | ⟨c, hc, rfl, hA⟩)
    · obtain ⟨x, hx⟩ := hA
      exact ⟨x, (symbolComponents_class_eq_isolatedSymbols occurs hx).symm⟩
    · obtain ⟨x, s, hs, hxs⟩ := hA
      exact ⟨x, (symbolComponents_class_eq_symbolsOfWords occurs hc hs hxs).symm⟩

/-- Proposition 1-7-1: for a symbol-occurrence relation between `X` and `S`, there exists a
partition of `S` into occurrence-connected pieces, namely the equivalence classes of
`wordComponents occurs`, and a corresponding partition of `X` into the isolated symbols `X₀` and
the nonempty symbol subsets carried by those word components. -/
-- Proof sketch: take the canonical partition of `S` into the equivalence classes of
-- `wordComponents occurs`. The isolated part of `X` is `isolatedSymbols occurs` when it is
-- nonempty, and the other symbol parts are the nonempty sets `symbolsOfWords occurs c` for word
-- classes `c`. If a symbol occurs in words from two classes, those classes are adjacent through
-- that symbol, hence equal.
theorem exists_occurrence_component_partition (occurs : X → S → Prop) :
    Setoid.IsPartition (wordComponents occurs).classes ∧
      ∃ symbolClasses : Set (Set X),
        Setoid.IsPartition symbolClasses ∧
          ∀ A, A ∈ symbolClasses ↔
            (A = isolatedSymbols occurs ∧ A.Nonempty) ∨
              ∃ c ∈ (wordComponents occurs).classes,
                A = symbolsOfWords occurs c ∧ A.Nonempty := by
  refine ⟨Setoid.isPartition_classes _, (symbolComponents occurs).classes,
    Setoid.isPartition_classes _, ?_⟩
  exact mem_symbolComponentClasses_iff occurs

end
