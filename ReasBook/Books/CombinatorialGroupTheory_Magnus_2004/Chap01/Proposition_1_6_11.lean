import CombinatorialGroupTheory_Magnus_2004.Basic
import CombinatorialGroupTheory_Magnus_2004.Chap01.Proposition_1_6_13

-- Declarations for this item will be appended below by the statement pipeline.

open scoped RelatorSetIr
open Subgroup

-- Layer triage:
-- `source-facing`: a nontrivial relator `w` in a free group of rank `n`, viewed as the singleton
-- relator set `{w}`, together with the criterion that `Ir({w}) = n - 1` exactly when `w` belongs
-- to the normal closure of a primitive element.
-- `core/canonical`: the relator-set owner notation `Ir(W)`, the mathlib owner abstraction
-- `IsPrimitiveElement` for “belongs to some basis”, and the subgroup owner
-- `Subgroup.normalClosure`.
-- `bridge/view`: the textbook phrase “lies in the normal closure of an element in a basis for
-- `Φ`” is a basis-witness specialization of the owner predicate `IsPrimitiveElement`, via
-- `FreeGroupBasis.isPrimitiveElement`.
-- Domain sampling:
-- 1. `Ir(W)` from Proposition `1-6-13` is the chapter owner abstraction for irreducibility rank.
-- 2. `IsPrimitiveElement` in `CombinatorialGroupTheory.Basic` is the project owner abstraction
--    for “belongs to some free basis”.
-- 3. `FreeGroupBasis.isPrimitiveElement` is the canonical bridge from a chosen basis element to
--    that owner predicate.
-- 4. `Subgroup.normalClosure` is the canonical owner construction for the normal closure of a
--    singleton subset.
-- Primitive vs. derived:
-- the primitive source data are only the rank parameter `n` and the nontrivial relator `w`; the
-- singleton relator set and the primitive-element normal closure are derived canonically from the
-- owner predicate `IsPrimitiveElement`; any explicit basis witness is auxiliary bridge data.

section

/-- Proposition 1-6-11: for a nontrivial element `w` of the free group of rank `n`, the singleton
relator set `{w}` has irreducibility rank `n - 1` if and only if `w` lies in the normal closure
of some primitive element of the ambient free group. -/
-- Proof sketch: the forward direction identifies the one-relator presentation with maximal
-- possible irreducibility rank below `n` and applies Magnus's criterion to show that the relator
-- is normally generated by a primitive element. For the reverse direction, quotienting by the
-- normal closure of a primitive element kills exactly one free generator, so the resulting
-- presented group still has a free quotient of rank `n - 1`, forcing `Ir({w}) = n - 1`.
theorem ir_singleton_eq_pred_iff_mem_normalClosure_of_isPrimitiveElement
    (n : ℕ) (w : FreeGroup (Fin n)) (hw : w ≠ 1) :
    Ir(({w} : Set (FreeGroup (Fin n)))) = n - 1 ↔
      ∃ p : FreeGroup (Fin n),
        IsPrimitiveElement p ∧ w ∈ normalClosure ({p} : Set (FreeGroup (Fin n))) :=
  sorry

/-- Basis-element specialization of Proposition 1-6-11. -/
theorem ir_singleton_eq_pred_iff_mem_normalClosure_of_basis_element
    (n : ℕ) (w : FreeGroup (Fin n)) (hw : w ≠ 1) :
    Ir(({w} : Set (FreeGroup (Fin n)))) = n - 1 ↔
      ∃ (X : Type) (basis : FreeGroupBasis X (FreeGroup (Fin n))) (x : X),
        w ∈ normalClosure ({basis x} : Set (FreeGroup (Fin n))) := by
  rw [ir_singleton_eq_pred_iff_mem_normalClosure_of_isPrimitiveElement n w hw]
  constructor
  · rintro ⟨p, hp, hw⟩
    rcases hp with ⟨X, basis, x, rfl⟩
    exact ⟨X, basis, x, hw⟩
  · rintro ⟨X, basis, x, hw⟩
    exact ⟨basis x, basis.isPrimitiveElement x, hw⟩

end
