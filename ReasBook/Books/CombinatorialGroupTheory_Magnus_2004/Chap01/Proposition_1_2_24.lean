import CombinatorialGroupTheory_Magnus_2004.Chap01.Definition_1_1_1
import CombinatorialGroupTheory_Magnus_2004.Chap01.Proposition_1_2_23
import CombinatorialGroupTheory_Magnus_2004.Chap01.Proposition_1_2_26

-- Declarations for this item will be appended below by the statement pipeline.

universe u v

open FreeGroup
open MulAction
open scoped Pointwise

namespace Proposition_1_2_24

noncomputable section

section

variable {F : Type u} [Group F]

/-- Source-facing predicate: the conjugation action of `g` sends the subgroup generated by `U`
into the subgroup generated by `V`. -/
def generated_subgroup_conjugate_into_by (g : F) (U V : Finset F) : Prop :=
  MulAut.conj g • Subgroup.closure (U : Set F) ≤ Subgroup.closure (V : Set F)

/-- On subgroups, the `ConjAct` action agrees with pointwise conjugation by `MulAut.conj`. -/
theorem toConjAct_smul_subgroup_eq_mulAut_conj_smul (g : F) (H : Subgroup F) :
    ConjAct.toConjAct g • H = MulAut.conj g • H := by
  ext x
  rw [Subgroup.mem_pointwise_smul_iff_inv_smul_mem,
    Subgroup.mem_pointwise_smul_iff_inv_smul_mem]
  change MulAut.conj g⁻¹ x ∈ H ↔ ((MulAut.conj g)⁻¹ • x : F) ∈ H
  simp [MulAut.smul_def]

/-- The canonical conjugation-action orbit relation on `Subgroup F` recovers the textbook
formulation of exact generated-subgroup conjugacy. -/
theorem exists_generated_subgroup_conjugator_iff_orbitRel (U V : Finset F) :
    orbitRel (ConjAct F) (Subgroup F) (Subgroup.closure (V : Set F))
      (Subgroup.closure (U : Set F)) ↔
      ∃ g : F,
        MulAut.conj g • Subgroup.closure (U : Set F) = Subgroup.closure (V : Set F) := by
  rw [orbitRel_apply, mem_orbit_iff]
  constructor
  · rintro ⟨g, hg⟩
    exact ⟨ConjAct.ofConjAct g, by
      simpa [toConjAct_smul_subgroup_eq_mulAut_conj_smul] using hg⟩
  · rintro ⟨g, hg⟩
    exact ⟨ConjAct.toConjAct g, by
      simpa [toConjAct_smul_subgroup_eq_mulAut_conj_smul] using hg⟩

end

private def finsetLetters {ι : Type*} [DecidableEq ι] {F : Type*} [Group F]
    (basis : FreeGroupBasis ι F) (U : Finset F) : List ι :=
  U.toList.flatMap fun u ↦ (basis.repr u).toWord.map Prod.fst

private def signedLetters {ι : Type*} (letters : List ι) : List (ι × Bool) :=
  List.flatMap (fun a ↦ [(a, false), (a, true)]) letters

private def wordsOfLength {ι : Type*} (letters : List ι) : ℕ → List (List (ι × Bool))
  | 0 => [[]]
  | n + 1 =>
      List.flatMap
        (fun w ↦ (signedLetters letters).map fun a ↦ a :: w)
        (wordsOfLength letters n)

private def searchBound {ι : Type v} {F : Type u} [Group F] (basis : FreeGroupBasis ι F)
    [DecidableEq ι] (U : Finset F) : ℕ :=
  U.sum fun u ↦ FreeGroup.norm (basis.repr u)

private def candidateWords {ι : Type v} {F : Type u} [Group F] (basis : FreeGroupBasis ι F)
    [DecidableEq ι] (U : Finset F) : List (List (ι × Bool)) :=
  List.flatMap (wordsOfLength (finsetLetters basis U)) (List.range (searchBound basis U + 1))

private def candidateElements {ι : Type v} {F : Type u} [Group F] (basis : FreeGroupBasis ι F)
    [DecidableEq ι] [DecidableEq F] (U : Finset F) : Finset F :=
  ((candidateWords basis U).map fun w ↦ basis.repr.symm (FreeGroup.mk w)).toFinset

private def candidateTuples {ι : Type v} {F : Type u} [Group F] (basis : FreeGroupBasis ι F)
    [DecidableEq ι] [DecidableEq F] (U : Finset F) (n : ℕ) : Finset (Fin n → F) := by
  classical
  let _ : Fintype {x // x ∈ candidateElements basis U} := by infer_instance
  exact
    (Finset.univ : Finset (Fin n → {x // x ∈ candidateElements basis U})).image fun f i ↦
      (f i : F)

private def tupleBasisOfClosure {F : Type u} [Group F] {n : ℕ} (u : Fin n → F) : Prop :=
  IsFreeGroupBasis {x : Subgroup.closure (Set.range u) | (x : F) ∈ Set.range u}

private def tuplePresentsGeneratedSubgroup {F : Type u} [Group F] {n : ℕ}
    (U : Finset F) (u : Fin n → F) : Prop :=
  tupleBasisOfClosure u ∧ Subgroup.closure (Set.range u) = Subgroup.closure (U : Set F)

private def tupleLiesInGeneratedSubgroup {F : Type u} [Group F] {n : ℕ}
    (V : Finset F) (v : Fin n → F) : Prop :=
  ∀ i, v i ∈ Subgroup.closure (V : Set F)

private noncomputable def generatedSubgroupConjugateIntoSearch {ι : Type v} {F : Type u}
    [Group F] [IsFreeGroup F] (basis : FreeGroupBasis ι F) [DecidableEq ι]
    [DecidableEq F] (U V : Finset F) : Bool := by
  classical
  exact
    (List.range (U.card + 1)).any fun n ↦
      ((candidateTuples basis U n).product (candidateTuples basis V n)).toList.any fun uv ↦
        letI := generated_subgroup_membership_decidable V
        decide
          (tuplePresentsGeneratedSubgroup U uv.1 ∧
            tupleLiesInGeneratedSubgroup V uv.2 ∧
            orbitRel (ConjAct F) (Fin n → F) uv.2 uv.1)

private noncomputable def generatedSubgroupConjugateSearch {ι : Type v} {F : Type u}
    [Group F] [IsFreeGroup F] (basis : FreeGroupBasis ι F) [DecidableEq ι]
    [DecidableEq F] (U V : Finset F) : Bool := by
  classical
  exact
    (List.range (Nat.min U.card V.card + 1)).any fun n ↦
      ((candidateTuples basis U n).product (candidateTuples basis V n)).toList.any fun uv ↦
        decide
          (tuplePresentsGeneratedSubgroup U uv.1 ∧
            tuplePresentsGeneratedSubgroup V uv.2 ∧
            orbitRel (ConjAct F) (Fin n → F) uv.2 uv.1)

section Search

variable {ι : Type v} {F : Type u} [Group F] [IsFreeGroup F]
variable (basis : FreeGroupBasis ι F)

local instance proposition_1_2_24_decidableEq_iota_1 : DecidableEq ι := Classical.decEq ι
local instance proposition_1_2_24_decidableEq_F_1 : DecidableEq F := Classical.decEq F

/-- Proposition 1-2-24 (1): in a free group, subgroup conjugation-into is detected by searching
for a basis tuple of `Gp(U)` and a conjugate tuple lying in `Gp(V)`, with the conjugacy test
itself delegated to the chapter's common-conjugator owner abstraction.

The bounded search only uses the finitely many letters appearing in the finite input `U`, so it
does not require any ambient finite-rank hypothesis. -/
private theorem exists_generated_subgroup_conjugator_iff_search_true (U V : Finset F) :
    (∃ g : F, generated_subgroup_conjugate_into_by g U V) ↔
      generatedSubgroupConjugateIntoSearch basis U V = true := by
  sorry

/-- Proposition 1-2-24 (2): exact conjugacy of the generated subgroups is detected by the
analogous basis-tuple search, again using the chapter's common-conjugator owner abstraction on
tuples.

As above, the search space is controlled by the finite input subsets themselves rather than by an
ambient finite-rank assumption. -/
private theorem generated_subgroup_conjugate_iff_search_true (U V : Finset F) :
    orbitRel (ConjAct F) (Subgroup F) (Subgroup.closure (V : Set F))
      (Subgroup.closure (U : Set F)) ↔
      generatedSubgroupConjugateSearch basis U V = true := by
  sorry

end Search

section Decidable

variable {F : Type u} [Group F] [IsFreeGroup F]

local instance proposition_1_2_24_decidableEq_generators_2 :
    DecidableEq (IsFreeGroup.Generators F) := Classical.decEq _
local instance proposition_1_2_24_decidableEq_F_2 : DecidableEq F := Classical.decEq F

/-- Proposition 1-2-24: in a free group, it is decidable whether the subgroup generated by `U` is
conjugate into the subgroup generated by `V`.

The public statement keeps the source-facing subgroup-conjugation problem. Its owner-side
implementation searches basis tuples for the finitely generated subgroup `Gp(U)` and checks
conjugacy on those tuples using the chapter's canonical common-conjugator owner
`exists_common_conjugator_decidable`, while subgroup-membership side conditions are handled by
`generated_subgroup_membership_decidable`. The search uses only the finitely many letters
appearing in the finite input sets, so no ambient `Group.FG` hypothesis belongs in the public
statement. -/
-- Layer: source-facing textbook decidability statement.
-- `bridge/view`: `generated_subgroup_conjugate_into_by`.
noncomputable def generated_subgroup_conjugate_into_decidable (U V : Finset F) :
    Decidable (∃ g : F, generated_subgroup_conjugate_into_by g U V) := by
  let basis : FreeGroupBasis (IsFreeGroup.Generators F) F := IsFreeGroup.basis F
  exact
    decidable_of_iff
      (generatedSubgroupConjugateIntoSearch basis U V = true)
      (exists_generated_subgroup_conjugator_iff_search_true basis U V).symm

/-- Proposition 1-2-24: in a free group, it is decidable whether the subgroups generated by `U`
and `V` are conjugate.

This public statement is centered on the canonical conjugation-action orbit relation on
`Subgroup F`; the companion theorem `exists_generated_subgroup_conjugator_iff_orbitRel` recovers
the textbook existential formulation. The decision procedure itself is organized by searching basis
tuples for the two generated subgroups and testing tuple common conjugacy through the chapter's
owner abstraction `exists_common_conjugator_decidable`. As in part (1), the finite search depends
only on the finite inputs `U` and `V`, not on any ambient finite-rank structure on `F`. -/
-- Layer: source-facing exact conjugacy through the owner relation on subgroups.
-- `core/canonical`: `orbitRel (ConjAct F) (Subgroup F)`.
noncomputable def generated_subgroup_conjugate_decidable (U V : Finset F) :
    Decidable
      (orbitRel (ConjAct F) (Subgroup F) (Subgroup.closure (V : Set F))
        (Subgroup.closure (U : Set F))) := by
  let basis : FreeGroupBasis (IsFreeGroup.Generators F) F := IsFreeGroup.basis F
  exact
    decidable_of_iff
      (generatedSubgroupConjugateSearch basis U V = true)
      (generated_subgroup_conjugate_iff_search_true basis U V).symm

end Decidable

end

end Proposition_1_2_24

open Proposition_1_2_24
