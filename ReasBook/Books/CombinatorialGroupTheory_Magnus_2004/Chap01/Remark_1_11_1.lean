import Mathlib

-- Declarations for this item will be appended below by the statement pipeline.

/- Remark 1-11-1 studies the subgroup `G* = Gp(a, d)` arising inside an amalgamated free-product
example and identifies it with the two-generator presentation `<a, d | a^3, d⁻¹ a d = a⁻¹>`.

Layer triage:
- `source-facing`: the concrete presented group `G*`, its distinguished generators `a` and `d`,
  its center, and the quotient by that center.
- `core/canonical`: `PresentedGroup`, `Subgroup.center`, `Subgroup.zpowers`, the quotient
  `G* ⧸ Subgroup.center G*`, and `DihedralGroup 3`.
- `bridge/view`: the presentation-level identification of the source quotient with the canonical
  dihedral group of order `6`.

Domain sampling:
1. `PresentedGroup rels` is mathlib's owner abstraction for a finitely presented group.
2. `Subgroup.center G` is the canonical owner of the center of a group.
3. `Subgroup.zpowers g` is the canonical cyclic subgroup generated by `g`.
4. `DihedralGroup 3` is mathlib's canonical dihedral group of order `6`.

Primitive vs. derived:
the primitive source data for this item are the concrete relators defining `G*`; the center and
its quotient are canonical owner constructions derived from that presented group. -/

/-- The generators `a` and `d` for the presentation of the example subgroup `G*`. -/
inductive OrderThreeInversionGenerator
  | a
  | d
  deriving DecidableEq

namespace OrderThreeInversionExample

open OrderThreeInversionGenerator

/-- The relator `a^3` in the presentation of `G*`. -/
abbrev orderThreeRelator : FreeGroup OrderThreeInversionGenerator :=
  FreeGroup.of a ^ (3 : ℕ)

/-- The relator `d⁻¹ a d a`, encoding the conjugation rule `d⁻¹ a d = a⁻¹`. -/
abbrev inversionRelator : FreeGroup OrderThreeInversionGenerator :=
  (FreeGroup.of d)⁻¹ * FreeGroup.of a * FreeGroup.of d * FreeGroup.of a

/-- The defining relator set for the example subgroup `G*`. -/
abbrev relators : Set (FreeGroup OrderThreeInversionGenerator) :=
  {orderThreeRelator, inversionRelator}

/-- The example group `G* = <a, d | a^3, d⁻¹ a d = a⁻¹>`. -/
abbrev GStar : Type :=
  PresentedGroup relators

/-- The distinguished generator `a` in `G*`. -/
abbrev a : GStar :=
  PresentedGroup.of OrderThreeInversionGenerator.a

/-- The distinguished generator `d` in `G*`. -/
abbrev d : GStar :=
  PresentedGroup.of OrderThreeInversionGenerator.d

/-- The central candidate `d^2` in `G*`. -/
abbrev dSquare : GStar :=
  d ^ (2 : ℕ)

/-- The quotient of `G*` by its center. -/
abbrev centerQuotient : Type :=
  GStar ⧸ Subgroup.center GStar

-- Proof sketch: show first that every power of `d^2` commutes with both generators, so
-- `Subgroup.zpowers dSquare ≤ Subgroup.center GStar`. For the reverse inclusion, quotient by the
-- normal closure of `a` to reduce to the infinite cyclic quotient generated by `d`, and then use
-- the relation `d⁻¹ a d = a⁻¹` to force any central element to have even `d`-exponent.
/-- The center of `G*` is the cyclic subgroup generated by `d^2`. -/
theorem center_eq_zpowers_dSquare :
    Subgroup.center GStar = Subgroup.zpowers dSquare := sorry

-- Proof sketch: the equality `center_eq_zpowers_dSquare` identifies the center with the subgroup
-- generated by `d^2`; then show that `d^2` has infinite order by mapping `G*` onto the infinite
-- cyclic quotient generated by the image of `d`.
/-- The center of `G*` is infinite. -/
theorem center_infinite :
    Infinite (Subgroup.center GStar) := sorry

-- Proof sketch: in `centerQuotient`, the image of `d` has order `2` because `d^2` lies in the
-- center, the image of `a` still has order `3`, and conjugation by the image of `d` inverts the
-- image of `a`. These relations identify the quotient with the standard noncyclic group of order
-- `6`, namely `DihedralGroup 3`.
/-- Remark 1-11-1: for the example group `G* = <a, d | a^3, d⁻¹ a d = a⁻¹>`, the quotient by its
center has the same cardinality as `DihedralGroup 3`. -/
theorem centerQuotient_natCard_eq_dihedral_natCard :
    Nat.card centerQuotient = Nat.card (DihedralGroup 3) := sorry

/-- Remark 1-11-1: for the example group `G* = <a, d | a^3, d⁻¹ a d = a⁻¹>`, the quotient by its
center is noncyclic. -/
theorem centerQuotient_not_isCyclic :
    ¬ IsCyclic centerQuotient := sorry

/-- The same source-facing conclusion, stated with the literal order `6`. -/
theorem centerQuotient_natCard_eq_six_and_not_isCyclic :
    Nat.card centerQuotient = 6 ∧ ¬ IsCyclic centerQuotient := by
  refine ⟨?_, centerQuotient_not_isCyclic⟩
  simpa [DihedralGroup.nat_card] using centerQuotient_natCard_eq_dihedral_natCard

end OrderThreeInversionExample
