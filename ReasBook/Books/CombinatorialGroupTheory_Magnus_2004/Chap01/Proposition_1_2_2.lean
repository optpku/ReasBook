import Mathlib
import CombinatorialGroupTheory_Magnus_2004.Chap01.Definition_1_2_1

-- Declarations for this item will be appended below by the statement pipeline.

universe u

set_option autoImplicit false

variable {G : Type u} [Group G]

/-
Domain sampling:
1. `nielsen_transforms_to` from Definition `1-2-1` is the chapter owner abstraction for finite
   compositions of Nielsen moves.
2. `Subgroup.closure` is mathlib's canonical owner for the subgroup generated by a set of group
   elements.
3. `Relation.ReflTransGen.trans_induction_on` is the canonical induction principle for a finite
   composition of elementary moves.

Primitive vs. derived:
- primitive public data: the two lists and the Nielsen-move relation between them;
- core/canonical derived object: the subgroup `Subgroup.closure` generated by the entries;
- bridge/view: a list is read as the set `{x | x ∈ U}` of its entries, which is definitionally
  equivalent to the older indexed presentation `Set.range U.get`.
-/

omit [Group G] in
private theorem list_entry_set_eq_range_get (U : List G) :
    {x | x ∈ U} = Set.range U.get := by
  ext x
  simp [List.mem_iff_get]

private theorem generated_subgroup_eq_of_perm {U V : List G} (hUV : List.Perm U V) :
    Subgroup.closure {x | x ∈ U} = Subgroup.closure {x | x ∈ V} := by
  apply le_antisymm
  · rw [Subgroup.closure_le]
    intro x hx
    exact Subgroup.subset_closure (hUV.subset hx)
  · rw [Subgroup.closure_le]
    intro x hx
    exact Subgroup.subset_closure (hUV.symm.subset hx)

/-- An inversion elementary Nielsen move preserves the generated subgroup. -/
private theorem generated_subgroup_eq_of_invert_elementary_nielsen_move
    {U V : List G} (hUV : invert_elementary_nielsen_move U V) :
    Subgroup.closure {x | x ∈ U} = Subgroup.closure {x | x ∈ V} := by
  rcases hUV with ⟨i, hi, rfl⟩
  let u := U.get ⟨i, hi⟩
  have hU :
      Subgroup.closure {x | x ∈ U} =
        Subgroup.closure {x | x ∈ u :: U.eraseIdx i} := by
    simpa [u] using (generated_subgroup_eq_of_perm (List.getElem_cons_eraseIdx_perm hi)).symm
  have hV :
      Subgroup.closure {x | x ∈ U.set i u⁻¹} =
        Subgroup.closure {x | x ∈ u⁻¹ :: U.eraseIdx i} := by
    simpa [u] using generated_subgroup_eq_of_perm (List.set_perm_cons_eraseIdx hi _)
  calc
    Subgroup.closure {x | x ∈ U} =
        Subgroup.closure {x | x ∈ u :: U.eraseIdx i} := hU
    _ = Subgroup.closure {x | x ∈ u⁻¹ :: U.eraseIdx i} := by
      apply le_antisymm
      · rw [Subgroup.closure_le]
        intro x hx
        simp only [List.mem_cons] at hx
        rcases hx with rfl | hx
        · have huinv : u⁻¹ ∈ Subgroup.closure {x | x ∈ u⁻¹ :: U.eraseIdx i} :=
            Subgroup.subset_closure (by simp)
          simpa [u] using
            (Subgroup.closure {x | x ∈ u⁻¹ :: U.eraseIdx i}).inv_mem huinv
        · exact Subgroup.subset_closure (by simp [hx])
      · rw [Subgroup.closure_le]
        intro x hx
        simp only [List.mem_cons] at hx
        rcases hx with rfl | hx
        · have hu : u ∈ Subgroup.closure {x | x ∈ u :: U.eraseIdx i} :=
            Subgroup.subset_closure (by simp)
          simpa [u] using
            (Subgroup.closure {x | x ∈ u :: U.eraseIdx i}).inv_mem hu
        · exact Subgroup.subset_closure (by simp [hx])
    _ = Subgroup.closure {x | x ∈ U.set i u⁻¹} := hV.symm

/-- A multiplication elementary Nielsen move preserves the generated subgroup. -/
private theorem generated_subgroup_eq_of_multiply_elementary_nielsen_move
    {U V : List G} (hUV : multiply_elementary_nielsen_move U V) :
    Subgroup.closure {x | x ∈ U} = Subgroup.closure {x | x ∈ V} := by
  rcases hUV with ⟨i, j, hi, hj, hij, rfl⟩
  let u := U.get ⟨i, hi⟩
  let v := U.get ⟨j, hj⟩
  have hU :
      Subgroup.closure {x | x ∈ U} =
        Subgroup.closure {x | x ∈ u :: U.eraseIdx i} := by
    simpa [u] using (generated_subgroup_eq_of_perm (List.getElem_cons_eraseIdx_perm hi)).symm
  have hV :
      Subgroup.closure {x | x ∈ U.set i (u * v)} =
        Subgroup.closure {x | x ∈ u * v :: U.eraseIdx i} := by
    simpa [u, v] using generated_subgroup_eq_of_perm (List.set_perm_cons_eraseIdx hi _)
  have hv_mem : v ∈ U.eraseIdx i := by
    simpa [v] using (List.mem_eraseIdx_iff_getElem.2 ⟨j, hj, hij.symm, rfl⟩)
  calc
    Subgroup.closure {x | x ∈ U} =
        Subgroup.closure {x | x ∈ u :: U.eraseIdx i} := hU
    _ = Subgroup.closure {x | x ∈ u * v :: U.eraseIdx i} := by
      apply le_antisymm
      · rw [Subgroup.closure_le]
        intro x hx
        simp only [List.mem_cons] at hx
        rcases hx with rfl | hx
        · exact
            by
              have huv :
                  u * v ∈ Subgroup.closure {x | x ∈ u * v :: U.eraseIdx i} :=
                Subgroup.subset_closure (by simp)
              have hv :
                  v ∈ Subgroup.closure {x | x ∈ u * v :: U.eraseIdx i} :=
                Subgroup.subset_closure (by simp [hv_mem])
              simpa [u, mul_assoc] using
                (Subgroup.closure {x | x ∈ u * v :: U.eraseIdx i}).mul_mem huv
                  ((Subgroup.closure {x | x ∈ u * v :: U.eraseIdx i}).inv_mem hv)
        · exact Subgroup.subset_closure (by simp [hx])
      · rw [Subgroup.closure_le]
        intro x hx
        simp only [List.mem_cons] at hx
        rcases hx with rfl | hx
        · have hu : u ∈ Subgroup.closure {x | x ∈ u :: U.eraseIdx i} :=
            Subgroup.subset_closure (by simp)
          have hv :
              v ∈ Subgroup.closure {x | x ∈ u :: U.eraseIdx i} :=
            Subgroup.subset_closure (by simp [hv_mem])
          simpa [u, mul_assoc] using
            (Subgroup.closure {x | x ∈ u :: U.eraseIdx i}).mul_mem hu hv
        · exact Subgroup.subset_closure (by simp [hx])
    _ = Subgroup.closure {x | x ∈ U.set i (u * v)} := hV.symm

/-- Deleting a trivial entry preserves the generated subgroup. -/
private theorem generated_subgroup_eq_of_delete_elementary_nielsen_move
    {U V : List G} (hUV : delete_elementary_nielsen_move U V) :
    Subgroup.closure {x | x ∈ U} = Subgroup.closure {x | x ∈ V} := by
  rcases hUV with ⟨i, hi, hone, rfl⟩
  have hU :
      Subgroup.closure {x | x ∈ U} =
        Subgroup.closure {x | x ∈ U.get ⟨i, hi⟩ :: U.eraseIdx i} := by
    simpa using (generated_subgroup_eq_of_perm (List.getElem_cons_eraseIdx_perm hi)).symm
  refine hU.trans ?_
  rw [hone]
  apply le_antisymm
  · rw [Subgroup.closure_le]
    intro x hx
    simp only [List.mem_cons] at hx
    rcases hx with rfl | hx
    · exact Subgroup.one_mem _
    · exact Subgroup.subset_closure hx
  · exact Subgroup.closure_mono (by
      intro x hx
      have hx' : x ∈ U.eraseIdx i := by simpa using hx
      simpa [List.mem_cons] using Or.inr hx')

/-- A single elementary Nielsen move preserves the subgroup generated by the entries of the list. -/
-- Proof sketch: check the three defining cases of `elementary_nielsen_move` separately.
-- Inversion replaces a generator by an equivalent one, multiplication replaces `u` by `u * v`
-- without changing the generated subgroup, and deleting `1` removes a redundant generator.
private theorem generated_subgroup_eq_of_elementary_nielsen_move
    {U V : List G} (hUV : elementary_nielsen_move U V) :
    Subgroup.closure (Set.range U.get) =
      Subgroup.closure (Set.range V.get) := by
  rcases (show
      invert_elementary_nielsen_move U V ∨
        multiply_elementary_nielsen_move U V ∨
        delete_elementary_nielsen_move U V from hUV) with hUV | hUV | hUV
  · rw [← list_entry_set_eq_range_get U, ← list_entry_set_eq_range_get V]
    exact generated_subgroup_eq_of_invert_elementary_nielsen_move hUV
  · rw [← list_entry_set_eq_range_get U, ← list_entry_set_eq_range_get V]
    exact generated_subgroup_eq_of_multiply_elementary_nielsen_move hUV
  · rw [← list_entry_set_eq_range_get U, ← list_entry_set_eq_range_get V]
    exact generated_subgroup_eq_of_delete_elementary_nielsen_move hUV

/-- Proposition 1-2-2: if a finite list `U` is carried into `V` by a Nielsen transformation, then
the subgroup `Gp(U)` generated by the entries of `U` equals the subgroup `Gp(V)` generated by the
entries of `V`. -/
-- Layer: source-facing statement on finite Nielsen transformations.
-- Core/canonical owner abstraction: `Subgroup.closure`.
-- Bridge/view: a finite list is viewed as the set of its entries `Set.range U.get`.
-- Proof sketch: prove first that each elementary Nielsen move preserves the generated subgroup,
-- and then induct along the reflexive transitive closure defining `nielsen_transforms_to`.
theorem generated_subgroup_eq_of_nielsen_transforms_to
    {U V : List G} (hUV : nielsen_transforms_to U V) :
    Subgroup.closure (Set.range U.get) =
      Subgroup.closure (Set.range V.get) := by
  induction hUV using Relation.ReflTransGen.trans_induction_on with
  | refl => rfl
  | single h => exact generated_subgroup_eq_of_elementary_nielsen_move h
  | trans _ _ ih₁ ih₂ => exact ih₁.trans ih₂
