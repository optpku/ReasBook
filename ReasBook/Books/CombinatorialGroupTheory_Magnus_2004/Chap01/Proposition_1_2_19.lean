import Mathlib

-- Declarations for this item will be appended below by the statement pipeline.

universe u

section

variable {F : Type u} [Group F] [IsFreeGroup F]

/-- Proposition 1-2-19: if nonzero powers of `a` and `b` commute in a free group, then `a` and
`b` are powers of a common element. -/
-- Layer triage:
-- `source-facing`: the textbook conclusion that `a` and `b` are powers of a common element.
-- `core/canonical`: `Commute`, `Subgroup.zpowers`, and the cyclic-owner theorem
-- `Subgroup.isCyclic_iff_exists_zpowers_eq_top`.
-- `bridge/view`: `Subgroup.mem_zpowers_iff` converts the source wording to explicit integer powers.
-- Domain sampling:
-- 1. `Subgroup.zpowers c` is mathlib's owner for the cyclic subgroup generated by `c`.
-- 2. `Subgroup.mem_zpowers_iff` is the canonical elementwise bridge to explicit integer powers.
-- 3. `Commute.zpow_zpow` is the canonical theorem transporting commutation to integer powers.
-- 4. `Subgroup.isCyclic_iff_exists_zpowers_eq_top` is the owner-side cyclic abstraction behind
--    the source conclusion, so no parallel local subgroup wrapper is introduced here.
-- Proof sketch: the subgroup generated by `a` and `b` is free. The commutation of the nonzero
-- powers `a ^ m` and `b ^ n` forces this subgroup to have rank at most `1`, hence it is cyclic;
-- therefore both `a` and `b` lie in the same `Subgroup.zpowers`.
theorem exists_common_zpowers_generator_of_commute_zpow
    (a b : F) (m n : ℤ) (hm : m ≠ 0) (hn : n ≠ 0) (h : Commute (a ^ m) (b ^ n)) :
    ∃ c : F, a ∈ Subgroup.zpowers c ∧ b ∈ Subgroup.zpowers c := sorry

/-- Derived API: commuting elements of a free group lie in a common cyclic subgroup. This is the
`m = n = 1` specialization of Proposition 1-2-19 to the owner abstraction `Subgroup.zpowers`. -/
-- Layer: `bridge/view`.
-- `core/canonical`: `Commute.zpow_zpow` and `Subgroup.zpowers`.
theorem exists_common_zpowers_generator_of_commute (a b : F) (h : Commute a b) :
    ∃ c : F, a ∈ Subgroup.zpowers c ∧ b ∈ Subgroup.zpowers c :=
  exists_common_zpowers_generator_of_commute_zpow a b 1 1 one_ne_zero one_ne_zero
    (h.zpow_zpow 1 1)

end
