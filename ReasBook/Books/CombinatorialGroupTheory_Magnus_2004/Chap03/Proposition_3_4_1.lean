import CombinatorialGroupTheory_Magnus_2004.Chap01.SignedLetter
import CombinatorialGroupTheory_Magnus_2004.Chap03.Proposition_3_3_4

-- Declarations for this item will be appended below by the statement pipeline.

universe u v w

-- Layer triage:
-- `source-facing`: a labelled Cayley complex `C(X; R)` realized as an actual `TwoComplex`,
-- together with its chosen relator-face boundary paths at the identity vertex, its
-- label-preserving complex automorphisms, and the canonical left-translation automorphisms.
-- `core/canonical`: `TwoComplex.Hom` is the chapter owner for maps of `2`-complexes,
-- `TwoComplex.Aut` is the owner for invertible self-maps of a `2`-complex, `Equiv.Perm` is the
-- owner for induced permutations on the vertex/edge/face carriers, `TwoComplex.BoundaryPath` is
-- the owner for a chosen based face boundary, `Equiv.mulLeft` is the canonical left-translation
-- permutation of a group, and `Subgroup.closure (Set.range edgeLabel)` is the canonical subgroup
-- generated by the edge labels.
-- `bridge/view`: the induced permutations on `G`, `G × Y`, and `G × Rel`, together with the
-- label-preservation predicates, are the coordinate views derived from the actual Cayley-complex
-- owner.
-- Domain sampling:
-- 1. `TwoComplex.Hom` from Proposition `3-3-4` is the owner abstraction for maps of `2`-complexes.
-- 2. `TwoComplex.Aut` is the correct owner abstraction for automorphisms of a `2`-complex.
-- 3. `TwoComplex.BoundaryPath` from Definition `3-2-4` is the owner abstraction for a chosen
--    based boundary of a relator face.
-- 4. `SignedLetter X` is the chapter owner for a generator together with an orientation sign, and
--    `SignedLetter.value` below is the canonical evaluation of such a signed letter in a group.
-- 5. `Equiv.Perm` and `Equiv.mulLeft` are the canonical owners for carrier permutations and left
--    translations on a group.
-- 6. `Subgroup.closure` and `Set.range` express that the chosen edge labels generate `G`.
-- Primitive vs. derived:
-- the primitive data are the ambient `TwoComplex`, its genuine automorphisms, and the chosen
-- Cayley-coordinate identifications together with the involution on the oriented edge-label type
-- and the chosen identity-based relator-face boundary paths. The induced permutations on `G`,
-- `G × Y`, and `G × Rel`, the translated relator-face boundaries, the coordinate
-- label-preservation predicates, and the coordinate formulas for the canonical left translations
-- are derived API.

namespace SignedLetter

variable {X : Type u} {G : Type v} [Group G]

/-- Evaluate a signed letter in a group by reading the sign as the edge orientation. -/
def value (edgeLabel : X → G) : SignedLetter X → G
  | (x, true) => edgeLabel x
  | (x, false) => (edgeLabel x)⁻¹

@[simp] theorem value_pos (edgeLabel : X → G) (x : X) :
    value edgeLabel (x, true) = edgeLabel x :=
  rfl

@[simp] theorem value_neg (edgeLabel : X → G) (x : X) :
    value edgeLabel (x, false) = (edgeLabel x)⁻¹ :=
  rfl

@[simp] theorem value_inv (edgeLabel : X → G) (x : SignedLetter X) :
    value edgeLabel x⁻¹ = (value edgeLabel x)⁻¹ := by
  rcases x with ⟨x, b⟩
  cases b <;> simp [value]

end SignedLetter

namespace TwoComplex

/-- An automorphism of a `2`-complex is an invertible self-map of that complex. -/
@[ext] structure Aut (C : TwoComplex) where
  /-- The underlying self-map. -/
  toHom : Hom C C
  /-- A specified inverse self-map. -/
  invHom : Hom C C
  /-- The inverse undoes the vertex map on the left. -/
  left_inv_vertex (v : C.skeleton) : invHom.toVertex (toHom.toVertex v) = v
  /-- The inverse undoes the vertex map on the right. -/
  right_inv_vertex (v : C.skeleton) : toHom.toVertex (invHom.toVertex v) = v
  /-- The inverse undoes the edge map on the left. -/
  left_inv_edge (e : C.skeleton.Edge) :
      invHom.toHom.toEdge (toHom.toEdge e) = e
  /-- The inverse undoes the edge map on the right. -/
  right_inv_edge (e : C.skeleton.Edge) :
      toHom.toHom.toEdge (invHom.toEdge e) = e
  /-- The inverse undoes the face map on the left. -/
  left_inv_face (D : C.Face) : invHom.mapFace (toHom.mapFace D) = D
  /-- The inverse undoes the face map on the right. -/
  right_inv_face (D : C.Face) : toHom.mapFace (invHom.mapFace D) = D

namespace Aut

variable {C : TwoComplex}

/-- The induced permutation of vertices. -/
def vertexPerm (α : Aut C) : Equiv.Perm C.skeleton where
  toFun := α.toHom.toVertex
  invFun := α.invHom.toVertex
  left_inv := α.left_inv_vertex
  right_inv := α.right_inv_vertex

/-- The induced permutation of oriented edges. -/
def edgePerm (α : Aut C) : Equiv.Perm C.skeleton.Edge where
  toFun := α.toHom.toEdge
  invFun := α.invHom.toEdge
  left_inv := α.left_inv_edge
  right_inv := α.right_inv_edge

/-- The induced permutation of oriented faces. -/
def facePerm (α : Aut C) : Equiv.Perm C.Face where
  toFun := α.toHom.mapFace
  invFun := α.invHom.mapFace
  left_inv := α.left_inv_face
  right_inv := α.right_inv_face

@[simp] theorem vertexPerm_apply (α : Aut C) (v : C.skeleton) :
    α.vertexPerm v = α.toHom.toVertex v :=
  rfl

@[simp] theorem edgePerm_apply (α : Aut C) (e : C.skeleton.Edge) :
    α.edgePerm e = α.toHom.toEdge e :=
  rfl

/-- The oriented-edge permutation of a `2`-complex automorphism preserves geometric-edge classes
exactly. -/
theorem edgePerm_geometricEdge_iff (α : Aut C) {e f : C.skeleton.Edge} :
    (e = f ∨ e = f⁻¹) ↔
      (α.edgePerm e = α.edgePerm f ∨ α.edgePerm e = (α.edgePerm f)⁻¹) := by
  constructor
  · intro h
    rcases h with rfl | h
    · exact Or.inl rfl
    · right
      calc
        α.edgePerm e = α.edgePerm (f⁻¹) := by simp [h]
        _ = (α.edgePerm f)⁻¹ := by simpa using (α.toHom.toHom.map_edgeInv f)
  · intro h
    rcases h with h | h
    · exact Or.inl (α.edgePerm.injective h)
    · right
      apply α.edgePerm.injective
      calc
        α.edgePerm e = (α.edgePerm f)⁻¹ := h
        _ = α.edgePerm (f⁻¹) := by
          simpa using (α.toHom.toHom.map_edgeInv f).symm

/-- An automorphism of a `2`-complex induces a permutation of geometric edges. -/
def geometricEdgePerm (α : Aut C) :
    Equiv.Perm (OneComplex.GeometricEdge C.skeleton) :=
  Quotient.congr α.edgePerm fun _ _ ↦ α.edgePerm_geometricEdge_iff

@[simp] theorem facePerm_apply (α : Aut C) (D : C.Face) :
    α.facePerm D = α.toHom.mapFace D :=
  rfl

/-- The underlying face permutation of a `2`-complex automorphism respects geometric-face
classes. -/
theorem facePerm_respects_geometricFace (α : Aut C) {D E : C.Face}
    (h : D = E ∨ D = E⁻¹) :
    α.facePerm D = α.facePerm E ∨ α.facePerm D = (α.facePerm E)⁻¹ := by
  rcases h with rfl | h
  · exact Or.inl rfl
  · right
    calc
      α.facePerm D = α.facePerm (E⁻¹) := by simp [h]
      _ = (α.facePerm E)⁻¹ := by simpa using (α.toHom.map_faceInv E)

/-- The oriented-face permutation of a `2`-complex automorphism preserves geometric-face classes
exactly. -/
theorem facePerm_geometricFace_iff (α : Aut C) {D E : C.Face} :
    (D = E ∨ D = E⁻¹) ↔
      (α.facePerm D = α.facePerm E ∨ α.facePerm D = (α.facePerm E)⁻¹) := by
  constructor
  · intro h
    exact α.facePerm_respects_geometricFace h
  · intro h
    rcases h with h | h
    · exact Or.inl (α.facePerm.injective h)
    · right
      apply α.facePerm.injective
      calc
        α.facePerm D = (α.facePerm E)⁻¹ := h
        _ = α.facePerm (E⁻¹) := by
          simpa using (α.toHom.map_faceInv E).symm

/-- An automorphism of a `2`-complex induces a permutation of geometric faces. -/
def geometricFacePerm (α : Aut C) : Equiv.Perm (TwoComplex.GeometricFace C) :=
  Quotient.congr α.facePerm fun _ _ ↦ α.facePerm_geometricFace_iff

end Aut

end TwoComplex

namespace CayleyComplex

variable {G : Type u} [Group G]
variable {Y : Type v} {Rel : Type w}

/-- A labelled Cayley `2`-complex structure on an actual `2`-complex, with vertex set `G`,
oriented edges indexed by `G × Y` for an oriented label type `Y`, geometric faces indexed by
`G × Rel`, chosen oriented representatives of those geometric faces, canonical left translations,
and chosen identity-based relator-face boundaries whose translates supply the attaching data of
the chosen representatives. -/
structure Coordinates (C : TwoComplex) (edgeLabel : Y → G) (Rel : Type w) where
  /-- The chosen identification of vertices with `G`. -/
  vertexEquiv : C.skeleton ≃ G
  /-- The inverse-oriented label corresponding to a chosen label. -/
  labelInv : Y → Y
  /-- Reversing label orientation twice gives back the original label. -/
  labelInv_involutive : Function.Involutive labelInv
  /-- The chosen identification of oriented edges with `G × Y`. -/
  edgeEquiv : C.skeleton.Edge ≃ G × Y
  /-- The chosen identification of geometric faces with `G × Rel`. -/
  geometricFaceEquiv : TwoComplex.GeometricFace C ≃ G × Rel
  /-- The chosen oriented representative of the geometric face with coordinates `(g, r)`. -/
  orientedFace (g : G) (r : Rel) : C.Face
  /-- The chosen representative of `(g, r)` lies in the corresponding geometric-face class. -/
  orientedFace_geometricFace (g : G) (r : Rel) :
      geometricFaceEquiv (⟦orientedFace g r⟧ : TwoComplex.GeometricFace C) = (g, r)
  /-- Reversing label orientation inverts its group value. -/
  edgeLabel_inv (y : Y) :
      edgeLabel (labelInv y) = (edgeLabel y)⁻¹
  /-- Under the chosen edge coordinates, the initial vertex of `(g, y)` is `g`. -/
  edge_initial (e : C.skeleton.Edge) :
      vertexEquiv (C.skeleton.initial e) = (edgeEquiv e).1
  /-- Under the chosen edge coordinates, the terminal vertex of `(g, y)` is `g * edgeLabel y`. -/
  edge_terminal (e : C.skeleton.Edge) :
      vertexEquiv (C.skeleton.terminal e) = (edgeEquiv e).1 * edgeLabel (edgeEquiv e).2
  /-- Reversing an oriented edge updates the group coordinate and applies the label involution. -/
  edgeInv_apply (e : C.skeleton.Edge) :
      edgeEquiv e⁻¹ = ((edgeEquiv e).1 * edgeLabel (edgeEquiv e).2, labelInv (edgeEquiv e).2)
  /-- The canonical left translation by `h`. -/
  leftTranslation : G → TwoComplex.Aut C
  /-- On vertices, left translation by `h` acts as `g ↦ h * g`. -/
  leftTranslation_vertex_apply (h : G) (v : C.skeleton) :
      vertexEquiv ((leftTranslation h).vertexPerm v) = h * vertexEquiv v
  /-- On oriented edges, left translation by `h` acts as `(g, y) ↦ (h * g, y)`. -/
  leftTranslation_edge_apply (h : G) (e : C.skeleton.Edge) :
      edgeEquiv ((leftTranslation h).edgePerm e) = (h * (edgeEquiv e).1, (edgeEquiv e).2)
  /-- On the chosen oriented representatives, left translation by `h` acts as
  `(g, r) ↦ (h * g, r)`. -/
  leftTranslation_face_apply (h g : G) (r : Rel) :
      (leftTranslation h).facePerm (orientedFace g r) = orientedFace (h * g) r
  /-- For each relator label `r`, the identity face `(1, r)` has a chosen boundary path based at
  the identity vertex. Translating this path by `g` gives the attaching boundary of the face
  `(g, r)`. -/
  identityBoundary (r : Rel) :
      C.BoundaryPath (orientedFace 1 r) (vertexEquiv.symm 1)

namespace Coordinates

variable {C : TwoComplex} {edgeLabel : Y → G}

/-- A Cayley-complex structure with ordinary generator labels uses `SignedLetter X` as the
oriented edge-label type and evaluates those labels through `SignedLetter.value`. -/
abbrev SignedCoordinates {X : Type v} (C : TwoComplex) (edgeLabel : X → G) (Rel : Type w) :=
  Coordinates C (SignedLetter.value edgeLabel) Rel

/-- The standard Cayley-coordinate data for the presentation `(X; R)` on an actual `2`-complex.
-/
structure PresentationCoordinates {X : Type v} (C : TwoComplex) (R : Set (FreeGroup X))
    extends SignedCoordinates C (PresentedGroup.of : X → PresentedGroup R) ↥R where
  /-- The chosen identity-face boundary for the relator `r` reads exactly `r` in the signed
  generator labels. -/
  identityBoundary_word (r : ↥R) :
      FreeGroup.mk
        ((Quiver.Path.edgeList (identityBoundary r).1).map fun e ↦ (edgeEquiv e.hom.1).2) =
          (r : FreeGroup X)

/-- The face with coordinates `(1, r)`. -/
abbrev identityFace (coords : Coordinates C edgeLabel Rel) (r : Rel) : C.Face :=
  coords.orientedFace 1 r

@[simp] theorem geometricFaceEquiv_identityFace (coords : Coordinates C edgeLabel Rel) (r : Rel) :
    coords.geometricFaceEquiv (⟦coords.identityFace r⟧ : TwoComplex.GeometricFace C) = (1, r) :=
  coords.orientedFace_geometricFace 1 r

@[simp] theorem geometricFaceEquiv_orientedFace (coords : Coordinates C edgeLabel Rel) (g : G)
    (r : Rel) :
    coords.geometricFaceEquiv (⟦coords.orientedFace g r⟧ : TwoComplex.GeometricFace C) = (g, r) :=
  coords.orientedFace_geometricFace g r

@[simp] theorem geometricFaceEquiv_faceInv (coords : Coordinates C edgeLabel Rel) (D : C.Face) :
    coords.geometricFaceEquiv (⟦D⁻¹⟧ : TwoComplex.GeometricFace C) =
      coords.geometricFaceEquiv (⟦D⟧ : TwoComplex.GeometricFace C) := by
  apply congrArg coords.geometricFaceEquiv
  exact Quotient.sound (Or.inr rfl)

@[simp] theorem mk_orientedFace (coords : Coordinates C edgeLabel Rel) (g : G) (r : Rel) :
    (⟦coords.orientedFace g r⟧ : TwoComplex.GeometricFace C) =
      coords.geometricFaceEquiv.symm (g, r) := by
  apply coords.geometricFaceEquiv.injective
  simp

/-- The induced permutation on the vertex coordinates `G`. -/
abbrev vertexPerm (coords : Coordinates C edgeLabel Rel) (α : TwoComplex.Aut C) : Equiv.Perm G :=
  coords.vertexEquiv.permCongr α.vertexPerm

/-- The induced permutation on the edge coordinates `G × Y`. -/
abbrev edgePerm (coords : Coordinates C edgeLabel Rel) (α : TwoComplex.Aut C) :
    Equiv.Perm (G × Y) :=
  coords.edgeEquiv.permCongr α.edgePerm

/-- The induced permutation on the geometric-face coordinates `G × Rel`. -/
abbrev geometricFacePerm (coords : Coordinates C edgeLabel Rel) (α : TwoComplex.Aut C) :
    Equiv.Perm (G × Rel) :=
  coords.geometricFaceEquiv.permCongr α.geometricFacePerm

/-- An automorphism preserves edge labels in the chosen Cayley coordinates when it fixes the
generator coordinate of every oriented edge. -/
def PreservesEdgeLabels (coords : Coordinates C edgeLabel Rel) (α : TwoComplex.Aut C) : Prop :=
  ∀ e : G × Y, (coords.edgePerm α e).2 = e.2

/-- An automorphism preserves face labels in the chosen Cayley coordinates when it fixes the
relator coordinate of every geometric face. -/
def PreservesFaceLabels (coords : Coordinates C edgeLabel Rel) (α : TwoComplex.Aut C) : Prop :=
  ∀ D : G × Rel, (coords.geometricFacePerm α D).2 = D.2

@[simp] theorem vertexPerm_apply (coords : Coordinates C edgeLabel Rel) (α : TwoComplex.Aut C)
    (g : G) :
    coords.vertexPerm α g = coords.vertexEquiv (α.vertexPerm (coords.vertexEquiv.symm g)) :=
  Equiv.permCongr_apply _ _ _

@[simp] theorem edgePerm_apply (coords : Coordinates C edgeLabel Rel) (α : TwoComplex.Aut C)
    (e : G × Y) :
    coords.edgePerm α e = coords.edgeEquiv (α.edgePerm (coords.edgeEquiv.symm e)) :=
  Equiv.permCongr_apply _ _ _

@[simp] theorem geometricFacePerm_apply (coords : Coordinates C edgeLabel Rel)
    (α : TwoComplex.Aut C)
    (D : G × Rel) :
    coords.geometricFacePerm α D =
      coords.geometricFaceEquiv (α.geometricFacePerm (coords.geometricFaceEquiv.symm D)) :=
  Equiv.permCongr_apply _ _ _

@[simp] theorem leftTranslation_identityVertex (coords : Coordinates C edgeLabel Rel) (g : G) :
    (coords.leftTranslation g).toHom.toVertex (coords.vertexEquiv.symm 1) =
      coords.vertexEquiv.symm g := by
  apply coords.vertexEquiv.injective
  simpa using coords.leftTranslation_vertex_apply g (coords.vertexEquiv.symm 1)

@[simp] theorem leftTranslation_identityFace (coords : Coordinates C edgeLabel Rel) (g : G)
    (r : Rel) :
    (coords.leftTranslation g).toHom.mapFace (coords.identityFace r) =
      coords.orientedFace g r := by
  simpa [Coordinates.identityFace] using coords.leftTranslation_face_apply g 1 r

/-- The chosen boundary path of the face with coordinates `(g, r)`, obtained by translating the
identity-face boundary for `r`. -/
def faceBoundary (coords : Coordinates C edgeLabel Rel) (g : G) (r : Rel) :
    C.BoundaryPath (coords.orientedFace g r) (coords.vertexEquiv.symm g) := by
  simpa using (coords.leftTranslation g).toHom.mapBoundary (coords.identityBoundary r)

/-- In a presentation Cayley complex, the translated boundary of the face `(g, r)` still reads the
relator `r`. -/
theorem faceBoundary_word {X : Type v} {R : Set (FreeGroup X)}
    (coords : PresentationCoordinates C R) (g : PresentedGroup R) (r : ↥R) :
    FreeGroup.mk
      ((Quiver.Path.edgeList (coords.faceBoundary g r).1).map
        fun e ↦ (coords.edgeEquiv e.hom.1).2) =
      (r : FreeGroup X) := by
  sorry

/-- In vertex coordinates, left translation by `h` is the canonical permutation `Equiv.mulLeft h`.
-/
theorem leftTranslation_vertexPerm (coords : Coordinates C edgeLabel Rel) (h : G) :
    coords.vertexPerm (coords.leftTranslation h) = Equiv.mulLeft h := by
  ext g
  simpa [Equiv.coe_mulLeft] using coords.leftTranslation_vertex_apply h (coords.vertexEquiv.symm g)

/-- In edge coordinates, left translation by `h` is the product permutation acting by left
multiplication on the group factor and trivially on the generator factor. -/
theorem leftTranslation_edgePerm (coords : Coordinates C edgeLabel Rel) (h : G) :
    coords.edgePerm (coords.leftTranslation h) =
      Equiv.prodCongr (Equiv.mulLeft h) (Equiv.refl Y) := by
  apply Equiv.ext
  intro e
  rcases e with ⟨g, y⟩
  change
    coords.edgeEquiv ((coords.leftTranslation h).edgePerm (coords.edgeEquiv.symm (g, y))) =
      (Equiv.prodCongr (Equiv.mulLeft h) (Equiv.refl Y)) (g, y)
  simpa [Equiv.coe_mulLeft] using coords.leftTranslation_edge_apply h (coords.edgeEquiv.symm (g, y))

/-- In geometric-face coordinates, left translation by `h` is the product permutation acting by left
multiplication on the group factor and trivially on the relator factor. -/
theorem leftTranslation_geometricFacePerm (coords : Coordinates C edgeLabel Rel) (h : G) :
    coords.geometricFacePerm (coords.leftTranslation h) =
      Equiv.prodCongr (Equiv.mulLeft h) (Equiv.refl Rel) := by
  apply Equiv.ext
  intro D
  rcases D with ⟨g, r⟩
  change
    coords.geometricFaceEquiv
        ((coords.leftTranslation h).geometricFacePerm (coords.geometricFaceEquiv.symm (g, r))) =
      (Equiv.prodCongr (Equiv.mulLeft h) (Equiv.refl Rel)) (g, r)
  rw [← coords.mk_orientedFace g r]
  change
    coords.geometricFaceEquiv
        (⟦(coords.leftTranslation h).facePerm (coords.orientedFace g r)⟧ :
          TwoComplex.GeometricFace C) =
      (Equiv.prodCongr (Equiv.mulLeft h) (Equiv.refl Rel)) (g, r)
  simp [coords.leftTranslation_face_apply h g r, Equiv.coe_mulLeft]

/-- Left translation by `h` acts on vertices by the formula `g ↦ h * g`. -/
theorem leftTranslation_vertexPerm_apply (coords : Coordinates C edgeLabel Rel) (h g : G) :
    coords.vertexPerm (coords.leftTranslation h) g = h * g := by
  simp [coords.leftTranslation_vertexPerm h, Equiv.coe_mulLeft]

/-- Left translation by `h` acts on oriented edges by the formula `(g, y) ↦ (h * g, y)`. -/
theorem leftTranslation_edgePerm_apply (coords : Coordinates C edgeLabel Rel) (h : G)
    (e : G × Y) :
    coords.edgePerm (coords.leftTranslation h) e = (h * e.1, e.2) := by
  rw [coords.leftTranslation_edgePerm h]
  rcases e with ⟨g, y⟩
  rfl

/-- Left translation by `h` acts on geometric faces by the formula `(g, r) ↦ (h * g, r)`. -/
theorem leftTranslation_geometricFacePerm_apply (coords : Coordinates C edgeLabel Rel) (h : G)
    (D : G × Rel) :
    coords.geometricFacePerm (coords.leftTranslation h) D = (h * D.1, D.2) := by
  rw [coords.leftTranslation_geometricFacePerm h]
  rcases D with ⟨g, r⟩
  rfl

@[simp] theorem leftTranslation_preservesEdgeLabels
    (coords : Coordinates C edgeLabel Rel) (h : G) :
    coords.PreservesEdgeLabels (coords.leftTranslation h) := by
  intro e
  rw [coords.leftTranslation_edgePerm_apply]

@[simp] theorem leftTranslation_preservesFaceLabels
    (coords : Coordinates C edgeLabel Rel) (h : G) :
    coords.PreservesFaceLabels (coords.leftTranslation h) := by
  intro D
  rw [coords.leftTranslation_geometricFacePerm_apply]

end Coordinates

/-- Proposition 3-4-1: if the edge labels generate `G`, then every automorphism of the labelled
Cayley complex `C(X; R)` that preserves the generator and relator labels has the same action on
vertices, oriented edges, and oriented faces as a unique left translation by some `h : G`. In the
chosen Cayley coordinates, that translation acts by `g ↦ h * g`, `(g, y) ↦ (h * g, y)`, and on
geometric faces by `(g, r) ↦ (h * g, r)`. -/
-- Proof sketch: for `α : TwoComplex.Aut C`, the induced permutation `coords.vertexPerm α` of `G`
-- preserves the labelled edge-adjacency pattern encoded by `coords.edge_initial`,
-- `coords.edge_terminal`, and `Coordinates.PreservesEdgeLabels`, so it commutes with right
-- multiplication by every generator. Setting `h := coords.vertexPerm α 1` and using
-- `Subgroup.closure (Set.range edgeLabel) = ⊤`, one propagates the identity
-- `coords.vertexPerm α g = h * g` from generators to all of `G`. The face-label hypothesis
-- `Coordinates.PreservesFaceLabels` rules out the extra symmetries coming from repeated relators,
-- and uniqueness of `h` follows by evaluating at the identity vertex. The underlying cell action
-- of `α` therefore agrees with the left translation by `h`; the edge and face formulas are then
-- exactly
-- `Coordinates.leftTranslation_edgePerm_apply` and
-- `Coordinates.leftTranslation_geometricFacePerm_apply`.
theorem automorphism_cellAction_eq_leftTranslation {C : TwoComplex} {edgeLabel : Y → G}
    (coords : Coordinates C edgeLabel Rel) (α : TwoComplex.Aut C)
    (hgen : Subgroup.closure (Set.range edgeLabel) = ⊤)
    (hedge : coords.PreservesEdgeLabels α) (hface : coords.PreservesFaceLabels α) :
    ∃! h : G,
      coords.vertexPerm α = coords.vertexPerm (coords.leftTranslation h) ∧
        coords.edgePerm α = coords.edgePerm (coords.leftTranslation h) ∧
        α.facePerm = (coords.leftTranslation h).facePerm := sorry

end CayleyComplex
