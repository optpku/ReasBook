import Mathlib

-- Declarations for this item will be appended below by the statement pipeline.

universe u

open Relation (EqvGen)
open List (finRange)

namespace CosetTable

noncomputable section

/-!
Primary domain: the iterative relator-table step in coset-table enumeration.

Layer triage:
- `source-facing`: a coset-table state consisting of the current relator tables together with the
  equations already recorded between labels, plus the rule choosing the first appearing label that
  still lacks a row and the first relator table in which that happens.
- `core/canonical`: `List` is the owner for relator words, ordered row data, and first-occurrence
  scans,
  `Fin R.length` is the owner for the finitely many relator tables,
  `ℕ → ℕ → Prop` is the owner form for the primitive recorded-equation data, and
  `Relation.EqvGen` is the owner for the equivalence relation generated by the recorded label
  equations.
- `bridge/view`: the textbook phrases “first appearing label”, “first relator table”, and
  “recorded-equal label” are expressed by ordered list scans of the current tables together with
  the equivalence closure of the recorded-equation relation.

Domain sampling:
1. `List.extractp` is the canonical ordered-list owner for selecting the first entry satisfying a
   decidable predicate.
2. `List.dedup` removes duplicates from a list, so `reverse ∘ dedup ∘ reverse` gives the labels in
   first-appearance order.
3. `Fin R.length` is the canonical owner for the finitely many relator tables attached to the
   relators in `R`.
4. Binary relations `ℕ → ℕ → Prop` and `Relation.EqvGen` are the canonical owner declarations for
   recorded label equations and for labels joined by a finite chain of such equations.

Primitive vs. derived:
- primitive data: the current relator tables and the recorded-equation relation between labels;
- derived API: the predicates saying that a label appears, begins a relator-word-labelled row in a
  given table, still needs such a row, satisfies the positive terminal condition, or yields an
  admissible next step-row.
-/

variable {α : Type u} (R : List (List α))

/-- A row in the table for the relator word `r` consists of a starting label together with one
successive target label for each letter of `r`, recorded in the same order as the letters of
`r`. Since the relator word is already the owner list parameter, the row stores only the label
data. -/
structure RelatorRow (r : List α) where
  start : ℕ
  targetLabels : List ℕ
  targetLabels_length : targetLabels.length = r.length

namespace RelatorRow

variable {r : List α}

attribute [simp] RelatorRow.targetLabels_length

/-- The full sequence of labels in a relator row, starting with the initial label. -/
def labels (row : RelatorRow r) : List ℕ :=
  row.start :: row.targetLabels

@[simp] theorem labels_length (row : RelatorRow r) :
    row.labels.length = r.length + 1 := by
  simp [labels]

@[simp] theorem labels_ne_nil (row : RelatorRow r) : row.labels ≠ [] := by
  simp [labels]

/-- The terminal label of a relator row. Since every row starts with its initial label, the full
label list is canonically nonempty. -/
def lastLabel (row : RelatorRow r) : ℕ :=
  row.labels.getLast row.labels_ne_nil

end RelatorRow

/-- A state of the coset-table algorithm consists of the current relator tables together with the
equations that have already been recorded between labels. -/
structure State where
  tables : (i : Fin R.length) → List (RelatorRow (R.get i))
  equations : ℕ → ℕ → Prop

namespace State

variable {R}

/-- Two labels are identified for the purposes of the algorithm when they are connected by a
finite chain of recorded equations. -/
def RecordedEquivalent (s : State R) : ℕ → ℕ → Prop :=
  EqvGen s.equations

/-- A label appears in the current tables when it occurs somewhere in some row of some relator
table. -/
def Appears (s : State R) (k : ℕ) : Prop :=
  ∃ i : Fin R.length, ∃ row ∈ s.tables i, k ∈ row.labels

/-- A label begins a row in the table attached to the `i`th relator when it is the first entry of
one of that table's rows. -/
def BeginsRow (s : State R) (i : Fin R.length) (k : ℕ) : Prop :=
  ∃ row ∈ s.tables i, row.start = k

/-- A label still needs a new row in the table for the `i`th relator when no recorded-equivalent
label begins a row there. -/
def NeedsNewRowInTable (s : State R) (k : ℕ) (i : Fin R.length) : Prop :=
  ¬ ∃ k', s.RecordedEquivalent k k' ∧ s.BeginsRow i k'

/-- The labels occurring anywhere in the current relator tables, with repetitions. -/
def entries (s : State R) : List ℕ :=
  (finRange R.length).flatMap fun i ↦ (s.tables i).flatMap RelatorRow.labels

/-- The labels already appearing in the current tables, listed in first-appearance order. -/
def appearingLabels (s : State R) : List ℕ :=
  let labels := s.entries.reverse
  let uniqueLabels := labels.dedup
  uniqueLabels.reverse

/-- A label still needs a new row somewhere if one of the relator tables lacks an initial row for
that label up to recorded equivalence. -/
def NeedsNewRow (s : State R) (k : ℕ) : Prop :=
  ∃ i : Fin R.length, s.NeedsNewRowInTable k i

/-- The first appearing label that still lacks a row in some relator table. -/
def firstLabelNeedingRow? (s : State R) : Option ℕ :=
  let _ : DecidablePred s.NeedsNewRow := Classical.decPred _
  (s.appearingLabels.extractp s.NeedsNewRow).1

/-- For a fixed label, the first relator table in which that label still lacks a row. -/
def firstTableNeedingRow? (s : State R) (k : ℕ) : Option (Fin R.length) :=
  let _ : DecidablePred (s.NeedsNewRowInTable k) := Classical.decPred _
  ((finRange R.length).extractp (s.NeedsNewRowInTable k)).1

/-- The next pending task in the algorithm: choose the first appearing label still lacking a row,
then the first relator table in which that happens. -/
def nextTask? (s : State R) : Option (ℕ × Fin R.length) :=
  do
    let k ← s.firstLabelNeedingRow?
    let i ← s.firstTableNeedingRow? k
    pure (k, i)

/-- A noninitial entry of a newly completed row is admitted by the source-facing relator-table
construction when it is either already represented up to recorded-equivalence, or is genuinely new
to the current state. -/
def RecordedOrFresh (s : State R) (k : ℕ) : Prop :=
  (∃ k', s.RecordedEquivalent k k' ∧ s.Appears k') ∨ ¬ s.Appears k

/-- A relator-word-labelled row is a valid next-row completion for the `i`th relator table
starting at `k` when it starts at `k`, and each later label supplied along the actual relator word
`R.get i` is either already represented up to recorded equivalence or is genuinely new. -/
def IsNextRow (s : State R) (k : ℕ) (i : Fin R.length) (row : RelatorRow (R.get i)) : Prop :=
  row.start = k ∧
    ∀ x ∈ row.targetLabels, s.RecordedOrFresh x

/-- The equation contributed by closing a newly completed relator row identifies its terminal label
with its initial label. -/
def rowEquation {r : List α} (row : RelatorRow r) : ℕ → ℕ → Prop :=
  fun k k' ↦ k = row.lastLabel ∧ k' = row.start

/-- Append a completed relator row to the chosen table and record the equation produced by closing
that row. -/
def recordRow (s : State R) (i : Fin R.length) (row : RelatorRow (R.get i)) : State R :=
  { tables := fun j ↦
      if h : j = i then
        h.symm ▸ (s.tables i ++ [row])
      else
        s.tables j
    equations := fun k k' ↦ s.equations k k' ∨ rowEquation row k k' }

/-- Remark 3-12-2 in source-facing form: one algorithmic step chooses the first pending pair
`(k, i)`, completes the corresponding relator-word-labelled row using recorded-equal or fresh
labels, and records the resulting equation. -/
def Step (s t : State R) : Prop :=
  ∃ k i row,
    s.nextTask? = some (k, i) ∧
      s.IsNextRow k i row ∧
      t = s.recordRow i row

/-- The positive terminal condition from the last sentence of Remark 3-12-2: every appearing label
already begins a row in every relator table, possibly after replacing it by a recorded-equivalent
label. -/
def Terminated (s : State R) : Prop :=
  ∀ k, s.Appears k →
    ∀ i : Fin R.length, ∃ k', s.RecordedEquivalent k k' ∧ s.BeginsRow i k'

/-- The auxiliary “needs a new row” condition is the negation of the terminal row-initiality
condition for a fixed label and relator table. -/
theorem not_needsNewRowInTable_iff
    (s : State R) (k : ℕ) (i : Fin R.length) :
    ¬ s.NeedsNewRowInTable k i ↔
      ∃ k', s.RecordedEquivalent k k' ∧ s.BeginsRow i k' := by
  classical
  simp [NeedsNewRowInTable]

end State

end

end CosetTable
