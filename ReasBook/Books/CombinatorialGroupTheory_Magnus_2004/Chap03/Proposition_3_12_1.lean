import Mathlib

-- Declarations for this item will be appended below by the statement pipeline.

universe u

section

variable {G : Type u} [Group G] [Group.FG G]

/-- Proposition 3-12-1: if `G` is generated by `n` elements and `H` has finite index in `G`, then
`H` is generated by at most `H.index * (n - 1) + 1` elements. -/
-- Layer triage:
-- `source-facing`: a finitely generated group `G`, a finite-index subgroup `H ≤ G`, and
-- Schreier's bound on the number of generators of `H`.
-- `core/canonical`: `Group.rank` is the owner for the minimum number of generators of a finitely
-- generated group, `Subgroup.index` is the owner for subgroup index, and `Subgroup.fg_of_index_ne_zero`
-- is the inherited finite-generation instance for finite-index subgroups.
-- `bridge/view`: the textbook phrases “generated by `n` elements” and “generated by at most `m`
-- elements” are expressed canonically as the inequalities `Group.rank G ≤ n` and
-- `Group.rank H ≤ m`, so the redundant intermediate variable `m` is replaced by its defining
-- value `H.index * (n - 1) + 1`.
-- Domain sampling:
-- 1. `Group.rank` and `Group.rank_spec` in `Mathlib/GroupTheory/Rank` are the canonical API for
--    finite generating-number statements.
-- 2. `Subgroup.fg_of_index_ne_zero` in `Mathlib/GroupTheory/Schreier` is the canonical owner
--    theorem that finite-index subgroups of finitely generated groups are finitely generated.
-- 3. `Subgroup.rank_le_index_mul_rank` is the upstream Schreier rank bound already phrased in the
--    owner language `Group.rank` and `Subgroup.index`.
-- Primitive vs. derived:
-- the primitive public data are only the subgroup `H` and the ambient generating-number bound
-- `Group.rank G ≤ n`; finite generation of `H` and the target generating-number bound are derived
-- canonically from those owner abstractions.
-- Proof sketch: apply Schreier's rewriting process to a generating set of size `n` for `G`,
-- discard the redundant transversal-edge generators, and count the remaining Schreier generators.
theorem finiteIndex_subgroup_rank_le_schreier_bound
    (H : Subgroup G) [H.FiniteIndex] {n : ℕ} (hG : Group.rank G ≤ n) :
    Group.rank H ≤ H.index * (n - 1) + 1 := sorry

end
