import Mathlib

-- Declarations for this item will be appended below by the statement pipeline.

open scoped Pointwise
open Subgroup

universe u v

section

variable {X : Type u} {F : Type v} [Group F] [Primcodable X]
variable (basis : FreeGroupBasis X F) (X₁ X₂ : Set X) (r : F)

local notation "F₁" => closure (basis '' X₁)
local notation "F₂" => closure (basis '' X₂)
local notation "N" => normalClosure (Set.singleton r)

-- Layer triage:
-- `source-facing`: an ambient free group `F` equipped with a chosen basis
-- `basis : FreeGroupBasis X F`, recursive subsets `X₁`, `X₂` of that basis, the generated
-- subgroups `F₁`, `F₂`, the normal closure `N` of a relator `r : F`, and the decision problem for
-- the subset `F₁ N F₂` of `F`.
-- `core/canonical`: Proposition `2-5-5`'s owner theorem
-- `GroupPresentation.computable_represents_element_of_generatorImageSubgroup`, transported through
-- `basis.repr`, together with `Subgroup.closure`, `Subgroup.normalClosure`,
-- `Subgroup.mul_normal`, `MonoidHom.map_closure`, `FreeGroup.mk`, and `ComputablePred`.
-- `bridge/view`: a signed word `L : List (X × Bool)` encodes the ambient element
-- `basis.repr.symm (FreeGroup.mk L)`, and the source product `F₁ N` is expressed canonically as
-- the subgroup join `F₁ ⊔ N` via `Subgroup.mul_normal`; after quotienting by `N`, membership in
-- `F₁ N F₂` is read as membership in the product of the two canonical generated subgroups of the
-- one-relator quotient, then pulled back along `basis.repr`.
-- Domain sampling:
-- 1. `FreeGroupBasis X F` is the chapter and mathlib owner abstraction for a chosen basis of an
--    ambient free group.
-- 2. `basis.repr : F ≃* FreeGroup X` is the canonical transport between intrinsic basis-level
--    elements of `F` and coded words on `X`.
-- 3. Proposition `2-5-5`'s
--    `GroupPresentation.computable_represents_element_of_generatorImageSubgroup` is the chapter's
--    owner theorem for recursive generated-subgroup membership in a one-relator quotient.
-- 4. `Subgroup.closure` and `Subgroup.normalClosure` are the owner constructions for generated
--    subgroups and normal closures.
-- 5. `Subgroup.mul_normal` is the owner theorem identifying the source product `F₁ N` with the
--    subgroup join `F₁ ⊔ N` when `N` is normal.
-- 6. `ComputablePred` is the project's canonical interface for algorithmic decidability on coded
--    words.
-- Primitive vs. derived:
-- the primitive source data are the chosen basis `basis`, the recursive subsets `X₁`, `X₂`, and
-- the relator `r`; the subgroup owners `F₁`, `F₂`, `N`, and the joined factor `F₁ ⊔ N` are
-- derived from that data and are therefore kept only as owner-side local notation built from
-- `Subgroup.closure`, `Subgroup.normalClosure`, and subgroup join.

/-- Proposition 2-5-6: if `X₁` and `X₂` are recursive subsets of the chosen basis
`basis : FreeGroupBasis X F`, `F₁` and `F₂` are the subgroups they generate in the ambient free
group `F`, and `N` is the normal closure of `r`, then the subset `F₁ N F₂` of `F` has decidable
membership for signed words on the basis alphabet `X`. -/
-- Proof sketch: transport a signed word `L` to the ambient element
-- `basis.repr.symm (FreeGroup.mk L)`, identify `F₁` and `F₂` with the subgroups generated by
-- `basis '' X₁` and `basis '' X₂`, absorb the normal factor `N` into the canonical subgroup join
-- `F₁ ⊔ N` via `Subgroup.mul_normal`, pass to the one-relator quotient determined by
-- `basis.repr r`, and apply Proposition `2-5-5` to the generated subgroups coming from `X₁` and
-- `X₂`, transporting the resulting computable predicate back along the basis equivalence.
theorem computable_represents_element_of_generated_subgroup_mul_normalClosure_mul_generated_subgroup
    (hX₁ : ComputablePred fun x : X ↦ x ∈ X₁)
    (hX₂ : ComputablePred fun x : X ↦ x ∈ X₂) :
    ComputablePred fun L : List (X × Bool) ↦
      basis.repr.symm (FreeGroup.mk L) ∈
        (((F₁ ⊔ N : Subgroup F) : Set F) * F₂) := sorry

end
