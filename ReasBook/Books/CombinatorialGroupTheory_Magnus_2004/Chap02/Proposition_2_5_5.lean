import Mathlib

-- Declarations for this item will be appended below by the statement pipeline.

universe u

namespace GroupPresentation

section

variable {X : Type u} [Primcodable X]

-- Layer triage:
-- `source-facing`: a one-relator group `G = (X; r)`, a recursive subset `X₀ ⊆ X`, the subgroup
-- `G₀` generated by the image of `X₀`, and the decision problem of whether a word in the free
-- group represents an element of `G₀`.
-- `core/canonical`: `PresentedGroup ({r} : Set (FreeGroup X))`, `PresentedGroup.mk`,
-- `PresentedGroup.of`, `Subgroup.closure`, and `ComputablePred`.
-- `bridge/view`: a signed word `L : List (X × Bool)` represents an element of `G₀` exactly when
-- its image under the canonical quotient map belongs to
-- `Subgroup.closure (PresentedGroup.of '' X₀)`.
-- Domain sampling:
-- 1. `PresentedGroup ({r} : Set (FreeGroup X))` is mathlib's canonical one-relator quotient.
-- 2. `PresentedGroup.mk ({r} : Set (FreeGroup X))` is the canonical quotient map from
--    `FreeGroup X`.
-- 3. `PresentedGroup.of` is the canonical map from defining generators into that quotient.
-- 4. `Subgroup.closure` is the owner construction for the subgroup generated by a subset.
-- 5. `ComputablePred` is the chapter's canonical computability interface for decidability on
--    coded words.
-- Primitive vs. derived:
-- the primitive mathematical data are the relator `r`, the recursive subset `X₀`, and the signed
-- word `L`; the subgroup generated by the image of `X₀` is a derived owner-side object, so the
-- statement uses `Subgroup.closure (PresentedGroup.of '' X₀)` directly rather than a parallel
-- local wrapper.

-- Proof sketch: apply the standard one-relator subgroup-membership algorithm to the subgroup
-- generated by the image of the recursive subset `X₀`; the recursive hypothesis gives an
-- effective test for whether a defining generator lies in `X₀`, so signed words can be decided
-- for membership in the corresponding subgroup of the quotient.
/-- Proposition 2-5-5: if `G = (X; r)` is a one-relator group, `X₀ ⊆ X` is recursive, and `G₀`
is the subgroup generated by the image of `X₀`, then one can decide whether a signed word on `X`
represents an element of `G₀`. -/
theorem computable_represents_element_of_generatorImageSubgroup
    (r : FreeGroup X) (X₀ : Set X) (hX₀ : ComputablePred fun x : X ↦ x ∈ X₀) :
    ComputablePred fun L : List (X × Bool) ↦
      PresentedGroup.mk ({r} : Set (FreeGroup X)) (FreeGroup.mk L) ∈
        Subgroup.closure (PresentedGroup.of '' X₀) := sorry

end

end GroupPresentation
