import CombinatorialGroupTheory_Magnus_2004.Chap01.Proposition_1_7_4

-- Declarations for this item will be appended below by the statement pipeline.

universe u v

noncomputable section

section

variable {X : Type u} {F : Type v} [Group F]

local instance proposition_2_5_1_decidableEq : DecidableEq X := Classical.decEq X

open Subgroup (normalClosure)

namespace FreeGroupBasis

-- Primary domain: one-relator groups, free bases, and normal closures.
--
-- Layer triage:
-- `source-facing`: a free group `F` with basis `basis : FreeGroupBasis X F`, a cyclically reduced
-- relator `r`, and a basis generator `x` occurring in `r`.
-- `core/canonical`: `FreeGroupBasis X F`, `FreeGroup.IsCyclicallyReduced`, and
-- `Subgroup.normalClosure`.
-- `bridge/view`: `basis.repr` reads elements of `F` in the canonical free-group model, and
-- `basisLetterOccurs` is the chapter's owner-side occurrence predicate for basis generators.
--
-- Domain sampling:
-- 1. `FreeGroupBasis X F` is the canonical owner abstraction for a chosen basis of a free group.
-- 2. `FreeGroup.IsCyclicallyReduced` is mathlib's owner predicate for cyclically reduced words in
--    the concrete free-group model.
-- 3. `Subgroup.normalClosure` is the owner construction for the normal closure of a relator.
-- 4. `basisLetterOccurs` from Proposition `1-7-4` is the established bridge predicate expressing
--    that a basis generator occurs in the reduced word of an element.
--
-- Primitive vs. derived:
-- the primitive source data are the basis `basis`, the relator `r`, and the chosen generator
-- `x`; cyclic reduction and generator occurrence are both read canonically through `basis.repr`,
-- so no parallel wrapper around reduced words is introduced.

/-- Proposition 2-5-1: if `r` is cyclically reduced with respect to the chosen basis
`basis : FreeGroupBasis X F` and the basis generator `x` occurs in `r`, then every nontrivial
element of the normal closure of `r` also contains `x`. -/
-- Proof sketch: transport the statement through `basis.repr : F ≃* FreeGroup X` to the canonical
-- free-group model on `X`. There, apply Magnus's Freiheitssatz to the cyclically reduced relator
-- `basis.repr r`: a nontrivial consequence of `r` cannot lie in the subgroup generated by the
-- remaining basis letters, so the letter `x` must still occur.
theorem basisLetterOccurs_of_mem_normalClosure_singleton_of_isCyclicallyReduced
    (basis : FreeGroupBasis X F) {r w : F} {x : X}
    (hr : FreeGroup.IsCyclicallyReduced (basis.repr r).toWord)
    (hx : basisLetterOccurs basis x r)
    (hw : w ∈ normalClosure {r}) (hw_ne : w ≠ 1) :
    basisLetterOccurs basis x w := sorry

end FreeGroupBasis

end
