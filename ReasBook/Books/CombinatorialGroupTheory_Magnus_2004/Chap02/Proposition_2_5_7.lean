import Mathlib

-- Declarations for this item will be appended below by the statement pipeline.

universe u

section

variable {F : Type u} [Group F] [IsFreeGroup F]

open Subgroup

-- Layer triage:
-- `source-facing`: two elements `r₁ r₂ : F` in a free group with equal normal closures.
-- `core/canonical`: `Subgroup.normalClosure` for the normal subgroup generated by one element and
-- `IsConj` for conjugacy.
-- `bridge/view`: the source phrase “the same normal closure” is rendered canonically as equality
-- of the singleton normal closures `Subgroup.normalClosure {r₁}` and
-- `Subgroup.normalClosure {r₂}`.
-- Domain sampling:
-- 1. `Subgroup.normalClosure` is mathlib's owner construction for the normal closure of a subset.
-- 2. `IsConj` is mathlib's owner relation for conjugacy in a group.
-- 3. The surrounding chapter already states free-group results on abstract groups `[IsFreeGroup F]`
--    rather than only on the concrete model `FreeGroup X`, so the same owner level is used here.
-- 4. `conjugate_or_conjugate_inv_of_normalClosure_eq` is itself the chapter owner theorem for
--    this Magnus conclusion, so no extra wrapper or basis-level restatement belongs here.
-- Primitive vs. derived:
-- the primitive data are just the two elements and the equality of their singleton normal
-- closures; no extra presentation package or chosen basis belongs in the statement.

-- Proof sketch: this is Magnus's conjugacy theorem for one-relator normal closures in a free
-- group. One analyzes cyclic reductions of `r₁` and `r₂`; equality of their normal closures
-- forces the reduced relators to agree up to cyclic permutation and inversion, which is exactly
-- conjugacy to `r₂` or to `r₂⁻¹`.
/-- Proposition 2-5-7: if two elements of a free group have the same singleton normal closure,
then one is conjugate to the other or to its inverse. -/
theorem conjugate_or_conjugate_inv_of_normalClosure_eq
    (r₁ r₂ : F)
    (hclosure : normalClosure ({r₁}) = normalClosure ({r₂})) :
    IsConj r₁ r₂ ∨ IsConj r₁ r₂⁻¹ := sorry

end
