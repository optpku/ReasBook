import Mathlib

-- Declarations for this item will be appended below by the statement pipeline.

universe u

section

variable {X : Type u}
variable (r s : FreeGroup X) (m : ℕ+)

local notation "rels" => (Set.singleton r : Set (FreeGroup X))
local notation "q" => PresentedGroup.mk rels

-- Layer triage:
-- `source-facing`: a one-relator group `G = (X; r)` with a maximal root decomposition
-- `r = s ^ m`.
-- `core/canonical`: `PresentedGroup ({r} : Set (FreeGroup X))` for the one-relator quotient,
-- `PresentedGroup.mk` for the image of `s`, `orderOf` and `IsOfFinOrder` for torsion, and
-- `IsConj` for conjugacy.
-- `bridge/view`: the textbook element `s̄` is rendered by the canonical quotient map
-- `q s`.
-- Domain sampling:
-- 1. `PresentedGroup ({r} : Set (FreeGroup X))` is the project's owner abstraction for a
--    one-relator group with relator `r`.
-- 2. `PresentedGroup.mk` is the canonical image map from the ambient free group to that quotient.
-- 3. `orderOf` and `IsOfFinOrder` are mathlib's owner APIs for exact order and finite order.
-- 4. `IsConj` is mathlib's canonical relation for conjugacy in a group.
-- Primitive vs. derived:
-- the primitive data are the relator `r`, its chosen maximal root `s`, the exponent `m`, and the
-- maximality hypothesis; the source-side condition `r ≠ 1` is redundant here, since no maximal
-- positive power decomposition can exist for `r = 1`. The image of `s` and the torsion-conjugacy
-- conclusions are derived owner-side statements on the presented group.

/-- Proposition 2-5-16 (1): if `G = (X; r)` with `r = s ^ m` for `m` maximal, then the image of
`s` in `PresentedGroup ({r} : Set (FreeGroup X))` has order `m`. -/
-- Proof sketch: the relation `r = s ^ m` makes the image of `s` satisfy `(s̄)^m = 1`, so its
-- order divides `m`. Magnus's torsion theorem for one-relator groups with maximal root then shows
-- that any smaller positive power of `s̄` cannot be trivial without expressing `r` as a higher
-- root than allowed by maximality.
theorem orderOf_root_image_eq_maximal_exponent
    (hroot : r = s ^ (m : ℕ))
    (hmax : ∀ ⦃t : FreeGroup X⦄ ⦃n : ℕ+⦄, r = t ^ (n : ℕ) → n ≤ m) :
    orderOf (q s) = m := sorry

/-- Proposition 2-5-16 (2): if `G = (X; r)` with `r = s ^ m` for `m` maximal, then every
torsion element of `PresentedGroup ({r} : Set (FreeGroup X))` is conjugate to an integer power of
the image of `s`. -/
-- Proof sketch: let `g` be a finite-order element of the one-relator quotient. Magnus's torsion
-- classification for one-relator groups shows that finite-order elements are conjugate into the
-- cyclic subgroup generated by the image of a maximal root of the relator. Since `s` is such a
-- maximal root, `g` is conjugate to `(q s) ^ k` for some integer `k`.
theorem exists_isConj_zpow_root_image_of_isOfFinOrder
    (hroot : r = s ^ (m : ℕ))
    (hmax : ∀ ⦃t : FreeGroup X⦄ ⦃n : ℕ+⦄, r = t ^ (n : ℕ) → n ≤ m)
    (g : PresentedGroup rels)
    (hg : IsOfFinOrder g) :
    ∃ k : ℤ, IsConj g ((q s) ^ k) := sorry

end
