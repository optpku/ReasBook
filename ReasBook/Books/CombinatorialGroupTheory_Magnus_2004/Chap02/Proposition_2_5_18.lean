import Mathlib

-- Declarations for this item will be appended below by the statement pipeline.

universe u

section

open scoped Pointwise

variable {X : Type u}
variable (s u : FreeGroup X) (m : ℕ+)

local notation "relator" => s ^ (m : ℕ)
local notation "rels" => ({relator} : Set (FreeGroup X))
local notation "q" => PresentedGroup.mk rels

-- Layer triage:
-- `source-facing`: a one-relator group `G = (X; r)` with `r = s^m`, where `m` is maximal among
-- power decompositions of `r`, together with an element `u` that is not a power of `s`.
-- `core/canonical`: `PresentedGroup ({s ^ (m : ℕ)} : Set (FreeGroup X))` for the one-relator
-- quotient and `Subgroup.zpowers` for the cyclic subgroups generated by the images of `s` and of
-- `u⁻¹ * s * u`.
-- `bridge/view`: the textbook phrase “the images of `s` and of `u⁻¹su` in `G`” is expressed by the
-- canonical quotient homomorphism `PresentedGroup.mk ({s ^ (m : ℕ)} : Set (FreeGroup X))`.
-- Domain sampling:
-- 1. `PresentedGroup ({r} : Set (FreeGroup X))` is the chapter's owner abstraction for a
--    one-relator group.
-- 2. `PresentedGroup.mk` is the canonical map from the ambient free group to the one-relator
--    quotient.
-- 3. `Subgroup.zpowers` is mathlib's canonical cyclic subgroup generated by a given group element.
-- 4. `MulAut.conj g • H` is mathlib's canonical subgroup-conjugation owner, so the cyclic
--    subgroup generated by the image of `u⁻¹ * s * u` should be treated as the conjugate of the
--    cyclic subgroup generated by the image of `s`, not as a second primitive object.
-- Primitive vs. derived:
-- the primitive source data are the root `s`, the exponent `m`, the maximality hypothesis for the
-- power decomposition of the relator, and the non-membership hypothesis `u ∉ Subgroup.zpowers s`.
-- The cyclic subgroup generated by the image of `s` is canonical derived data, and the cyclic
-- subgroup generated by the image of `u⁻¹ * s * u` is the further derived conjugate subgroup.

private theorem zpowers_image_conjugate_eq_conj_zpowers_image_root :
    Subgroup.zpowers (q (u⁻¹ * s * u)) =
      (MulAut.conj (q u))⁻¹ • Subgroup.zpowers (q s) := by
  rw [Subgroup.pointwise_smul_def, MonoidHom.map_zpowers]
  simp [MulAut.smul_def, mul_assoc]

/-- Proposition 2-5-18: if a one-relator group has defining relator `s ^ m` with `m` maximal
among all power decompositions of that relator, and if `u` is not a power of `s`, then the cyclic
subgroup generated by the image of `s` in the quotient is disjoint from its conjugate by the image
of `u`. -/
-- Proof sketch: in the one-relator quotient by `s ^ m`, any nontrivial common power of the image
-- of `s` and of the image of `u⁻¹ * s * u` would force a nontrivial conjugate of a power of `s`
-- back into the cyclic subgroup generated by `s`. Magnus's torsion analysis for maximal roots in
-- one-relator groups then implies that `u` must already lie in `Subgroup.zpowers s`, contradicting
-- `hu`.
theorem disjoint_zpowers_image_root_and_conjugateSubgroup_of_not_mem_zpowers
    (hmax :
      ∀ ⦃t : FreeGroup X⦄ ⦃n : ℕ+⦄, relator = t ^ (n : ℕ) → n ≤ m)
    (hu : u ∉ Subgroup.zpowers s) :
    Disjoint
      (Subgroup.zpowers (q s))
      ((MulAut.conj (q u))⁻¹ • Subgroup.zpowers (q s)) := sorry

/-- Source-facing reformulation of Proposition 2-5-18: the cyclic subgroups generated by the
images of `s` and of `u⁻¹ * s * u` in the quotient have trivial intersection. -/
theorem disjoint_zpowers_image_root_and_conjugate_of_not_mem_zpowers
    (hmax :
      ∀ ⦃t : FreeGroup X⦄ ⦃n : ℕ+⦄, relator = t ^ (n : ℕ) → n ≤ m)
    (hu : u ∉ Subgroup.zpowers s) :
    Disjoint
      (Subgroup.zpowers (q s))
      (Subgroup.zpowers (q (u⁻¹ * s * u))) := by
  rw [zpowers_image_conjugate_eq_conj_zpowers_image_root s u m]
  exact
    disjoint_zpowers_image_root_and_conjugateSubgroup_of_not_mem_zpowers s u m hmax hu

end
