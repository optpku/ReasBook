variable {X : Type u} {F : Type v} [Group F]

local instance instDecidableEqX_5_2_3 : DecidableEq X := Classical.decEq X

open GroupPresentation

/-!
Primary domain: small-cancellation conditions for relator sets in a free group with a chosen
basis.

Layer triage:
- `source-facing`: cyclic lists of relators from the symmetrized family generated by `R`, the
  prohibition on successive inverse pairs, and the requirement that one cyclic adjacent product be
  reduced without cancellation.
- `core/canonical`: `FreeGroupBasis X F` is the owner abstraction for reading elements of `F` as
  reduced words in the basis `X`, `GroupPresentation.symmetrizedRelatorFamily` is the owner for
  the source symmetrized relator family, and `Cycle F` is the owner abstraction for cyclic
  adjacency.
- `bridge/view`: `basis.repr` transports the relator set `R` to `FreeGroup X`,
  `(q.toConjClasses).carrier` is the canonical relator-set view of a symmetrized cyclic word in
  the free group, and `FreeGroup.IsReduced` is the canonical predicate for “reduced without
  cancellation”.

Domain sampling:
1. `FreeGroupBasis X F` is the chapter owner for a free group with a chosen basis.
2. `GroupPresentation.symmetrizedRelatorFamily` from Proposition `3-11-2` is the owner for the
   source symmetrized family `R*`.
3. `CyclicWord.toConjClasses` together with `ConjClasses.carrier` is the canonical bridge from a
   symmetrized cyclic word to the set of group elements representing that cyclic relator.
4. `(basis.repr r).toWord` is the canonical reduced-word model of a relator `r`.
5. `FreeGroup.IsReduced` is the owner predicate for reduced signed words.
6. `Cycle F` is mathlib's canonical owner for cyclic adjacency data, so the positive adjacent-pair
   witness below should live on `Cycle` rather than through a negated chain of failures.

Primitive vs. derived:
- primitive source data: the cyclic relator cycle `rs`, membership in the symmetrized relator set
  induced by `R`, and the adjacency condition forbidding inverse successive terms;
- derived API: the existence of one cyclic adjacent pair whose reduced basis words concatenate
  without cancellation.
-/

private def hasAdjacentList {α : Type*} (r : α → α → Prop) (l : List α) : Prop :=
  ∃ p ∈ List.zip l (l.rotate 1), r p.1 p.2

private theorem hasAdjacentList_rotate_iff {α : Type*} (r : α → α → Prop)
    (l : List α) (n : ℕ) :
    hasAdjacentList r (l.rotate n) ↔ hasAdjacentList r l := by
  constructor <;> intro h
  · rcases h with ⟨p, hp, hr⟩
    refine ⟨p, ?_, hr⟩
    have hzip :
        (List.zip l (l.rotate 1)).rotate n =
          List.zip (l.rotate n) ((l.rotate n).rotate 1) := by
      simpa [List.zip, List.rotate_rotate, Nat.add_comm, Nat.add_left_comm, Nat.add_assoc] using
        (List.zipWith_rotate_distrib Prod.mk l (l.rotate 1) n (by simp))
    exact List.mem_rotate.mp <| hzip ▸ hp
  · rcases h with ⟨p, hp, hr⟩
    refine ⟨p, ?_, hr⟩
    have hzip :
        (List.zip l (l.rotate 1)).rotate n =
          List.zip (l.rotate n) ((l.rotate n).rotate 1) := by
      simpa [List.zip, List.rotate_rotate, Nat.add_comm, Nat.add_left_comm, Nat.add_assoc] using
        (List.zipWith_rotate_distrib Prod.mk l (l.rotate 1) n (by simp))
    exact hzip ▸ List.mem_rotate.mpr hp

namespace Cycle

/-- A cycle has an adjacent pair satisfying `r` when some cyclically consecutive pair in a
representative list satisfies `r`. -/
def HasAdjacent {α : Type*} (r : α → α → Prop) (c : Cycle α) : Prop :=
  Quotient.liftOn' c (hasAdjacentList r) fun a b hab ↦ by
    rcases hab with ⟨n, rfl⟩
    exact propext (hasAdjacentList_rotate_iff r a n).symm

end Cycle

namespace FreeGroupBasis

/-- The symmetrized relator set generated by `R`, transported back from the canonical free-group
owner `symmetrizedRelatorFamily` to actual elements of `F` through the chosen basis. -/
def symmetrizedRelatorSet (basis : FreeGroupBasis X F) (R : Set F) : Set F :=
  { r | ∃ q ∈ symmetrizedRelatorFamily (basis.repr '' R),
      basis.repr r ∈ (q.toConjClasses).carrier }

/-- A cyclic relator cycle has a reduced cyclic product when some cyclically adjacent pair of
relators concatenates to a reduced basis word. -/
def hasReducedCyclicProduct (basis : FreeGroupBasis X F) (rs : Cycle F) : Prop :=
  rs.HasAdjacent fun r s ↦
    FreeGroup.IsReduced ((basis.repr r).toWord ++ (basis.repr s).toWord)

/-- Definition 5-2-3: the relator set `R` satisfies `T(q)` with respect to `basis` if every cyclic
relator cycle from the symmetrized relator set generated by `R` of length `h` with
`3 ≤ h < q` and no successive inverse pair has at least one adjacent cyclic product whose reduced
basis words concatenate without cancellation. -/
def condition_t (basis : FreeGroupBasis X F) (R : Set F) (q : ℕ) : Prop :=
  ∀ rs : Cycle F, 3 ≤ rs.length → rs.length < q →
    (∀ r ∈ rs, r ∈ basis.symmetrizedRelatorSet R) →
    rs.Chain (fun r s ↦ r * s ≠ 1) →
    basis.hasReducedCyclicProduct rs

notation:55 "T(" q ")[" basis ", " R "]" => condition_t basis R q

-- Proof sketch: apply the defining predicate `condition_t` to the given cyclic relator list,
-- using its length bounds, relator-membership hypotheses, and cyclic noninverse condition.
/-- Under `T(q)`, every short enough cyclic list of relators from the symmetrized relator set
generated by `R` with no successive inverse pair contains an adjacent cyclic product that is
reduced without cancellation. -/
theorem hasReducedCyclicProduct_of_condition_t
    (basis : FreeGroupBasis X F) {R : Set F} {q : ℕ}
    (hR : T(q)[basis, R]) {rs : List F}
    (hlen_lower : 3 ≤ rs.length) (hlen_upper : rs.length < q)
    (hrs : ∀ r ∈ rs, r ∈ basis.symmetrizedRelatorSet R)
    (hchain : (rs : Cycle F).Chain (fun r s ↦ r * s ≠ 1)) :
    basis.hasReducedCyclicProduct (rs : Cycle F) := by
  simpa using hR (rs : Cycle F) hlen_lower hlen_upper hrs hchain

end FreeGroupBasis

end
