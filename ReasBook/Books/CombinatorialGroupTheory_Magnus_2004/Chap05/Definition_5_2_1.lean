variable {X : Type u} {F : Type v} [Group F]

local instance instDecidableEqX_5_2_1 : DecidableEq X := Classical.decEq X

/-!
Primary domain: small-cancellation conditions for a relator set in a free group with a chosen
basis.

Layer triage:
- `source-facing`: a chosen basis `basis : FreeGroupBasis X F`, a relator set `R : Set F`, the
  symmetrized family generated by `R`, and nontrivial common parts of two distinct symmetrized
  relators.
- `core/canonical`: `FreeGroupBasis X F` is the owner abstraction for the chosen basis, and
  `GroupPresentation.symmetrizedRelatorFamily` is the project owner for the symmetrized relator
  family.
- `bridge/view`: `basis.repr '' R` transports relators to the canonical free-group model
  `FreeGroup X`, and `CyclicWord.HasPart` reads the textbook “common initial segment of cyclic
  conjugates and inverses” as a cyclic part of a symmetrized cyclic word.

Domain sampling:
1. `FreeGroupBasis X F` is the canonical owner for a free group with chosen basis.
2. `GroupPresentation.symmetrizedRelatorFamily` from Proposition `3-11-2` is the existing owner
   abstraction for the symmetrized family `R*`.
3. `basis.repr` is the canonical bridge from `F` to `FreeGroup X`, so the source relator family is
   transported as `basis.repr '' R`.
4. `CyclicWord.HasPart` from Proposition `1-7-9` is the owner predicate for a cyclic segment of a
   symmetrized relator.
5. `CyclicWord.length` is the canonical relator length on that symmetrized owner.
6. The textbook small-cancellation symbol `C'(λ)` should therefore constrain nonempty common parts
   of distinct symmetrized relators, not only common prefixes of raw members of `R`.

Primitive vs. derived:
- primitive source data: the relator set `R`, a nonempty word `piece`, and two distinct
  symmetrized relators containing `piece`;
- derived API: the `C'(λ)` bound for every occurrence of such a piece in a symmetrized relator.
-/

namespace FreeGroupBasis

/-- A word `piece` is a small-cancellation piece for `R` with respect to `basis` if it is a
nonempty common part of two distinct relators in the symmetrized family generated by `R`. -/
def is_piece (basis : FreeGroupBasis X F) (R : Set F) (piece : List (X × Bool)) : Prop :=
  piece ≠ [] ∧
    ∃ q₁ ∈ symmetrizedRelatorFamily (basis.repr '' R),
      ∃ q₂ ∈ symmetrizedRelatorFamily (basis.repr '' R),
        q₁ ≠ q₂ ∧ q₁.HasPart piece ∧ q₂.HasPart piece

-- Proof sketch: unfold `is_piece` and use the two displayed symmetrized relators directly as the
-- witnesses.
/-- A nonempty common cyclic part of two distinct relators in the symmetrized family is a piece. -/
theorem is_piece_of_hasPart
    (basis : FreeGroupBasis X F) {R : Set F} {piece : List (X × Bool)}
    (hpiece : piece ≠ []) {q₁ q₂ : CyclicWord X}
    (hq₁ : q₁ ∈ symmetrizedRelatorFamily (basis.repr '' R))
    (hq₂ : q₂ ∈ symmetrizedRelatorFamily (basis.repr '' R))
    (hne : q₁ ≠ q₂) (h₁ : q₁.HasPart piece) (h₂ : q₂.HasPart piece) :
    basis.is_piece R piece := by
  exact ⟨hpiece, q₁, hq₁, q₂, hq₂, hne, h₁, h₂⟩

/-- Definition 5-2-1: the relator set `R` satisfies the small-cancellation condition `C'(λ)` with
respect to `basis` if every nonempty piece `piece` occurring in a symmetrized relator from `R*`
has length strictly less than `λ` times the length of that symmetrized relator. -/
def condition_c_prime (basis : FreeGroupBasis X F) (R : Set F) (lambda : ℝ) : Prop :=
  ∀ {q : CyclicWord X} (_ : q ∈ symmetrizedRelatorFamily (basis.repr '' R))
    {piece : List (X × Bool)} (_ : q.HasPart piece) (_ : basis.is_piece R piece),
      (piece.length : ℝ) < lambda * q.length

notation:55 "C'(" lambda ")[" basis ", " R "]" => condition_c_prime basis R lambda

-- Proof sketch: apply the defining predicate `condition_c_prime` to the relator membership
-- hypothesis, the displayed occurrence of `piece` in the symmetrized relator `q`, and the
-- assumption that `piece` is a piece.
/-- Under `C'(λ)`, every piece occurring in a symmetrized relator has length strictly less than
`λ` times the length of that symmetrized relator. -/
theorem piece_length_lt_of_condition_c_prime
    (basis : FreeGroupBasis X F) {R : Set F} {lambda : ℝ}
    (hR : C'(lambda)[basis, R]) {q : CyclicWord X}
    (hq : q ∈ symmetrizedRelatorFamily (basis.repr '' R))
    {piece : List (X × Bool)}
    (hpart : q.HasPart piece) (hpiece : basis.is_piece R piece) :
    (piece.length : ℝ) < lambda * q.length :=
  hR hq hpart hpiece

end FreeGroupBasis

end
