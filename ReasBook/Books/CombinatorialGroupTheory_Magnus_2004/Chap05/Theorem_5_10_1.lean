import Mathlib

-- Declarations for this item will be appended below by the statement pipeline.

universe u v

set_option autoImplicit false

noncomputable section

open Monoid

section

variable {ι : Type u} {A : ι → Type v}
variable [∀ i, Group (A i)]

/-!
Primary domain: torsion in small-cancellation quotients of free products.

Layer triage:
- `source-facing`: the symmetrized relator family generated by `R` in a free product, the
  free-product small-cancellation hypothesis `C'(1 / 8)` read on cyclic parts of weakly
  cyclically reduced symmetrized relators, the quotient map `v : F → F / N`, and the two torsion
  alternatives from the textbook.
- `core/canonical`: `Monoid.CoprodI A` is mathlib's owner abstraction for a free product,
  `Monoid.CoprodI.Word` is the intrinsic reduced-word owner, `QuotientGroup.mk'` is the canonical
  quotient map, `IsOfFinOrder` is the owner predicate for finite order, and `IsConj` is the owner
  relation for conjugacy.
- `bridge/view`: cyclic subword geometry is read from the derived cycle `(w.toList :
  Cycle (Σ i, A i))` of a reduced free-product word `w : Monoid.CoprodI.Word A`, while weak
  cyclic reduction is the owner-side predicate on that reduced word.

Domain sampling:
1. `Monoid.CoprodI A` and `Monoid.CoprodI.of` are the canonical free-product owners.
2. `Monoid.CoprodI.Word` and `Word.equiv` are the canonical reduced-word owner and normal-form
   bridge for free-product elements.
3. `GroupPresentation.symmetrizedRelatorFamily` and `FreeGroupBasis.condition_c_prime` from
   Chapter `5` fix the source pattern: symmetrized relators are read through an owner carrying a
   cyclic-part predicate and length, while `C'(\lambda)` is stated directly on that owner.
4. `Subgroup.amalgamatedProductAlong.IsWeaklyCyclicallyReduced` from Definition `5-11-2` gives
   the chapter pattern for distinguishing weak cyclic reduction from the stricter boundary
   condition of Section `4`.

Primitive vs. derived:
- primitive public data: the free-product family `A`, the relator set `R`, the induced
  symmetrized family of weakly cyclically reduced free-product words, the Section `10`
  small-cancellation hypothesis `C'(1 / 8)`, and a finite-order quotient element `w`;
- derived API: the two torsion alternatives, namely conjugacy to the image of a finite-order
  element from the ambient free product or conjugacy to a power coming from a relator root in the
  quotient.
-/

namespace Cycle

/-- A cycle contains the consecutive part `part` when some representative list realizes it as a
contiguous block. -/
def HasPart {α : Type*} (q : Cycle α) (part : List α) : Prop :=
  ∃ u v : List α, q = ((u ++ part ++ v : List α) : Cycle α)

end Cycle

namespace Monoid.CoprodI

namespace Word

/-- The cyclic syllable view of a reduced free-product word. -/
abbrev toCycle (w : Word A) : Cycle (Σ i, A i) :=
  w.toList

/-- The syllable length of a reduced free-product word. -/
abbrev length (w : Word A) : ℕ :=
  w.toList.length

/-- A reduced free-product word contains the consecutive part `part` when its cyclic syllable
view contains `part`. -/
def HasPart (w : Word A) (part : List (Σ i, A i)) : Prop :=
  w.toCycle.HasPart part

/-- Definition 5-10-1 uses weak cyclic reduction in the free product sense: a reduced word may
begin and end in the same factor, but only if those boundary syllables do not cancel. -/
def IsWeaklyCyclicallyReduced (w : Word A) : Prop :=
  ∀ {yLast yFirst : Σ i, A i},
    w.toList.getLast? = some yLast →
      w.toList.head? = some yFirst →
      (hfactor : yLast.1 = yFirst.1) →
        ((hfactor ▸ yLast.2) * yFirst.2 = 1) →
          w.toList.length ≤ 1

-- Proof sketch: this is exactly the length-`0`/length-`1` branch built into the definition.
/-- Words of syllable length at most one are weakly cyclically reduced. -/
theorem isWeaklyCyclicallyReduced_of_length_le_one
    {w : Word A} (hw : w.toList.length ≤ 1) :
    w.IsWeaklyCyclicallyReduced := by
  change ∀ {yLast yFirst : Σ i, A i},
    w.toList.getLast? = some yLast →
      w.toList.head? = some yFirst →
        (hfactor : yLast.1 = yFirst.1) →
          ((hfactor ▸ yLast.2) * yFirst.2 = 1) →
            w.toList.length ≤ 1
  intro _ _ _ _ _ _
  exact hw

end Word

open Word

/-- The symmetrized relator family generated by `R`, modeled on the canonical reduced-word owner.
The weak cyclic-reduction hypothesis is kept separate from the conjugacy data, and cyclic subword
geometry is read through `Word.toCycle`. -/
def symmetrizedRelatorFamily (R : Set (CoprodI A)) : Set (Word A) :=
  { q | q.IsWeaklyCyclicallyReduced ∧ ∃ r ∈ R, IsConj q.prod r ∨ IsConj q.prod r⁻¹ }

/-- A word `piece` is a small-cancellation piece for `R` in a free product when it is a nonempty
common cyclic part of two distinct cyclic views of relators in the symmetrized family generated by
`R`. -/
def is_piece (R : Set (CoprodI A)) (piece : List (Σ i, A i)) : Prop :=
  piece ≠ [] ∧
    ∃ q₁ ∈ symmetrizedRelatorFamily R,
      ∃ q₂ ∈ symmetrizedRelatorFamily R,
        q₁.toCycle ≠ q₂.toCycle ∧ q₁.HasPart piece ∧ q₂.HasPart piece

/-- The free-product relator set `R` satisfies `C'(λ)` when every piece occurring in a
symmetrized weakly cyclically reduced relator from `R*` has syllable length strictly less than
`λ` times the syllable length of that relator. -/
def condition_c_prime (R : Set (CoprodI A)) (lambda : ℝ) : Prop :=
  ∀ {q : Word A} (_ : q ∈ symmetrizedRelatorFamily R)
    {piece : List (Σ i, A i)} (_ : q.HasPart piece) (_ : is_piece R piece),
      (piece.length : ℝ) < lambda * q.length

notation:55 "C'(" lambda ")[" R "]" => condition_c_prime R lambda

-- Proof sketch: apply the defining predicate `condition_c_prime` to the displayed symmetrized
-- relator `q`, its cyclic occurrence of `piece`, and the assumption that `piece` is a piece.
/-- Under the free-product `C'(λ)` hypothesis, every piece occurring in a symmetrized relator has
length strictly less than `λ` times the cyclic length of that relator. -/
theorem piece_length_lt_of_condition_c_prime
    {R : Set (CoprodI A)} {lambda : ℝ} (hR : C'(lambda)[R])
    {q : Word A} (hq : q ∈ symmetrizedRelatorFamily R)
    {piece : List (Σ i, A i)}
    (hpart : q.HasPart piece) (hpiece : is_piece R piece) :
    (piece.length : ℝ) < lambda * q.length :=
  hR hq hpart hpiece

section

variable (R : Set (CoprodI A))

local notation "F" => CoprodI A
local notation "N" => Subgroup.normalClosure R
local notation "G" => F ⧸ N
local notation "v" => QuotientGroup.mk' N

-- Proof sketch: choose a shortest conjugate representative of a preimage of the finite-order
-- quotient element and analyze its powers using the Section `10` free-product small-cancellation
-- theory under `C'(1 / 8)`. If the representative already has finite order in the ambient free
-- product, the free-product torsion theorem conjugates it into one factor, giving alternative
-- `(i)`. Otherwise the reduction analysis forces a defining relator to be a genuine proper power
-- `r = root ^ n` with `1 < n`, and the same normal-form argument shows that the original quotient
-- element is conjugate to an integral power of the image of `root`.
/-- Theorem 5-10-1: for a free product `F = *ᵢ Aᵢ` and a relator set `R` satisfying the Section
`10` free-product small-cancellation hypothesis `C'(1 / 8)` on the symmetrized family of weakly
cyclically reduced relators generated by `R`, every finite-order element of the quotient
`G = F / N` is either conjugate to the image of a finite-order element from one of the factors
`Aᵢ`, or comes from a relator `r ∈ R` that is a genuine proper power `r = root ^ n` with `1 < n`,
with the quotient element conjugate to a power of the image of `root` in `G`. Via
`freeGroupEquivCoprodI`, this also covers the free-group case in the textbook statement. -/
theorem torsion_theorem_for_small_cancellation_quotient
    (hR : C'((1 / 8 : ℝ))[R])
    (w : G) (hw : IsOfFinOrder w) :
    (∃ i : ι, ∃ a : A i, IsOfFinOrder a ∧ IsConj (v (of a)) w) ∨
      ∃ r ∈ R, ∃ root : F, ∃ n : ℕ, 1 < n ∧ r = root ^ n ∧
        ∃ m : ℤ, IsConj ((v root) ^ m) w := sorry

end

end Monoid.CoprodI

end
