import CombinatorialGroupTheory_Magnus_2004.Chap05.Theorem_5_10_1

universe u v

set_option autoImplicit false

section

open Monoid

variable {ι : Type u} {A : ι → Type v}
variable [∀ i, Group (A i)]

/-!
Primary domain: factor embeddings in small-cancellation quotients of free products.

Layer triage:
- `source-facing`: a free product `F = *ᵢ Aᵢ`, a relator set `R ⊆ F` satisfying the Section `10`
  small-cancellation hypothesis `C'(1 / 6)`, and the textbook conclusion that each factor `Aᵢ`
  embeds in the quotient `F / ⟪R⟫`.
- `core/canonical`: `Monoid.CoprodI A` is mathlib's owner abstraction for the ambient free
  product, `Monoid.CoprodI.of` is the canonical factor inclusion, `Subgroup.normalClosure R` is
  the normal subgroup generated by the relators, `QuotientGroup.mk'` is the quotient map, and
  `Function.Injective` is the chapter owner for the embedding claim.
- `bridge/view`: Theorem `5-10-3` specializes this owner-level factor embedding statement to the
  free factors used in the `SQ`-universality construction.

Domain sampling:
1. `Monoid.CoprodI.of_injective` is mathlib's canonical injectivity theorem for factor maps into
   the ambient free product.
2. `HNNExtension.of_injective` from Theorem `4-2-4` fixes the chapter style: direct reuse of the
   owner-side embedding theorem when it already exists.
3. Theorem `4-2-10` uses `Function.Injective` on the canonical comparison morphism as the
   source-facing statement for factor embeddings into an amalgamated product.
4. `IsSQUniversal` from Proposition `2-5-31` is the downstream owner that later consumes this
   lemma in the small-cancellation-product application.

Best owner abstraction:
- the main owner data are the canonical factor map `of : A i →* CoprodI A` and the canonical
  quotient map `QuotientGroup.mk'`; the lemma should state injectivity of their composite directly
  instead of introducing any local embedding wrapper.

Primitive vs. derived:
- primitive public data: the indexed factor family `A`, the relator set `R`, and the chosen factor
  index `i`;
- derived API: the injectivity of the induced map `A i → F / ⟪R⟫`.
-/

namespace Monoid.CoprodI

local notation "F" => CoprodI A

/-- Lemma 5-10-2: if the relator set `R` in the free product `F = *ᵢ Aᵢ` satisfies the Section
`10` small-cancellation hypothesis `C'(1 / 6)`, then the natural map from each factor `Aᵢ` into
the quotient `F / ⟪R⟫` is injective. -/
theorem factor_injective_in_quotient_of_condition_c_prime
    {R : Set F} (hR : C'((1 / 6 : ℝ))[R]) (i : ι) :
    Function.Injective
      ((QuotientGroup.mk' (Subgroup.normalClosure R)).comp (of : A i →* F)) := sorry

end Monoid.CoprodI

end
