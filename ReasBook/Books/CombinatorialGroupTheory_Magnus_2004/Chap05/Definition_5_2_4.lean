import Mathlib

-- Declarations for this item will be appended below by the statement pipeline.

universe u

set_option autoImplicit false

section

open Group Subgroup

variable {F : Type u} [Group F]

/-!
Primary domain: products of relator conjugates and the normal closure that they generate.

Layer triage:
- `source-facing`: finite ordered lists of conjugates of elements of a relator set `R`, together
  with the minimality condition that no shorter such list has the same product.
- `core/canonical`: `conjugatesOfSet R` is the owner for the set of all conjugates of elements of
  `R`, and `normalClosure R` is the owner for the subgroup they generate.
- `bridge/view`: a relator-conjugate list is a source-facing finite factorization of an element of
  `normalClosure R`.

Domain sampling:
1. `IsConj` is mathlib's owner predicate for conjugacy.
2. `conjugatesOfSet R` is the canonical set of conjugates of elements of `R`.
3. `normalClosure R` is the canonical subgroup generated by those conjugates.
4. `conjugatesOfSet_subset_normalClosure` is the canonical bridge from a conjugate of a relator
   to membership in `normalClosure R`.

Primitive vs. derived:
- primitive source data: the relator set `R` and the finite list `cs`;
- derived API: the product `cs.prod`, its membership in `normalClosure R`, and the minimality
  condition excluding shorter relator-conjugate factorizations with the same product.
-/

/-- A list is an `R`-conjugate sequence when each of its terms lies in the canonical set of
conjugates of elements of `R`. -/
def IsRelatorConjugateSequence (R : Set F) (cs : List F) : Prop :=
  ∀ c ∈ cs, c ∈ conjugatesOfSet R

/-- Definition 5-2-4: a sequence of conjugates of elements of `R` is a minimal `R`-sequence when
its product cannot also be expressed as the product of a shorter sequence of conjugates of
elements of `R`. -/
def IsMinimalRelatorSequence (R : Set F) (cs : List F) : Prop :=
  IsRelatorConjugateSequence R cs ∧
    ∀ ds : List F, ds.length < cs.length → IsRelatorConjugateSequence R ds → ds.prod ≠ cs.prod

-- Proof sketch: each factor belongs to `conjugatesOfSet R`, hence to `normalClosure R`; the
-- subgroup is closed under multiplication, so the list product also lies in `normalClosure R`.
/-- The product of an `R`-conjugate sequence lies in the normal closure of `R`. -/
theorem prod_mem_normalClosure_of_isRelatorConjugateSequence
    {R : Set F} {cs : List F} (hcs : IsRelatorConjugateSequence R cs) :
    cs.prod ∈ normalClosure R := by
  induction cs with
  | nil =>
      simp
  | cons c cs ih =>
      have hc : c ∈ conjugatesOfSet R := hcs c (by simp)
      have hcs' : IsRelatorConjugateSequence R cs := by
        intro d hd
        exact hcs d (by simp [hd])
      simpa using (normalClosure R).mul_mem
        (conjugatesOfSet_subset_normalClosure hc) (ih hcs')

-- Proof sketch: unfold `IsMinimalRelatorSequence` and project its second component.
/-- A minimal `R`-sequence has no shorter `R`-conjugate factorization with the same product. -/
theorem prod_ne_of_shorter_relatorConjugateSequence
    {R : Set F} {cs ds : List F} (hcs : IsMinimalRelatorSequence R cs)
    (hshort : ds.length < cs.length) (hds : IsRelatorConjugateSequence R ds) :
    ds.prod ≠ cs.prod :=
  hcs.2 ds hshort hds

end
