module

public import Mathlib.Topology.EMetricSpace.Basic
public import Mathlib.Topology.EMetricSpace.Weak

public section

noncomputable section

namespace EReal

/-- The standard `edist` on `EReal` upgrades the existing weak extended metric
structure to a pseudo emetric space, so the uniform-convergence API applies to
`EReal`-valued functionals. -/
instance instPseudoEMetricSpace : PseudoEMetricSpace EReal :=
  -- The uniform-convergence lemmas only need the uniform structure generated by `edist`.
  PseudoEMetricSpace.ofEDist
    edist
    (fun x ↦
      (inferInstance : WeakEMetricSpace EReal).toWeakPseudoEMetricSpace.edist_self x)
    (fun x y ↦
      (inferInstance : WeakEMetricSpace EReal).toWeakPseudoEMetricSpace.edist_comm x y)
    (fun x y z ↦
      (inferInstance : WeakEMetricSpace EReal).toWeakPseudoEMetricSpace.edist_triangle x y z)

end EReal
