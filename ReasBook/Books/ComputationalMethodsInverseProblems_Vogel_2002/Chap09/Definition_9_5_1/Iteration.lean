module

public import Mathlib.Data.Matrix.Mul
public import Mathlib.Data.Real.Basic
public import Mathlib.Logic.Function.Iterate

public section

noncomputable section

open scoped BigOperators
open scoped Matrix

namespace RichardsonLucy

universe u v

/-- The Richardson-Lucy column-sum factor `k_j = ∑ i, K i j`. -/
def columnSum {ι : Type u} {κ : Type v} [Fintype ι] [Fintype κ] (K : Matrix ι κ ℝ) :
    κ → ℝ :=
  fun j ↦ ∑ i, K i j

/-- The one-step Richardson-Lucy update from equation `(9.42)`. -/
def update {ι : Type u} {κ : Type v} [Fintype ι] [Fintype κ] (K : Matrix ι κ ℝ)
    (d : ι → ℝ) (f : κ → ℝ) :
    κ → ℝ :=
  fun j ↦
    (f j / columnSum K j) *
      ∑ i, K i j * (d i / Matrix.mulVec K f i)

/-- The Richardson-Lucy iterate family generated by repeatedly applying the
update `(9.42)` to the initial iterate `f₀`. -/
@[expose] def iterates {ι : Type u} {κ : Type v} [Fintype ι] [Fintype κ]
    (K : Matrix ι κ ℝ) (d : ι → ℝ) (f0 : κ → ℝ) : ℕ → κ → ℝ
  | 0 => f0
  | v + 1 => update K d (iterates K d f0 v)

/-- The zeroth Richardson-Lucy iterate is the initial iterate `f₀`. -/
@[simp] theorem iterates_zero {ι : Type u} {κ : Type v} [Fintype ι] [Fintype κ]
    (K : Matrix ι κ ℝ) (d : ι → ℝ) (f0 : κ → ℝ) :
    iterates K d f0 0 = f0 := rfl

/-- The successor Richardson-Lucy iterate is obtained by one Richardson-Lucy
update from the previous iterate. -/
@[simp] theorem iterates_succ {ι : Type u} {κ : Type v} [Fintype ι] [Fintype κ]
    (K : Matrix ι κ ℝ) (d : ι → ℝ) (f0 : κ → ℝ) (v : ℕ) :
    iterates K d f0 (v + 1) = update K d (iterates K d f0 v) := rfl

/-- The recursive Richardson-Lucy iterate family agrees with repeated
application of `Nat.iterate` to the one-step update. -/
theorem iterates_eq_nat_iterate {ι : Type u} {κ : Type v} [Fintype ι] [Fintype κ]
    (K : Matrix ι κ ℝ) (d : ι → ℝ) (f0 : κ → ℝ) :
    iterates K d f0 = fun v ↦ Nat.iterate (update K d) v f0 := by
  funext v
  induction v with
  | zero =>
      rfl
  | succ v ih =>
      rw [iterates_succ, Function.iterate_succ_apply']
      exact congrArg (update K d) ih

/-- The Richardson-Lucy column-sum factor is the transpose action of `K` on the all-ones
vector. -/
theorem columnSum_eq_mulVec_transpose_one {ι : Type u} {κ : Type v} [Fintype ι] [Fintype κ]
    (K : Matrix ι κ ℝ) :
    columnSum K = Matrix.mulVec Kᵀ (fun _ ↦ (1 : ℝ)) := by
  -- Both sides expand to the same finite column sum.
  funext j
  simp [columnSum, Matrix.mulVec, dotProduct]

/-- The pointwise Richardson-Lucy update formula is
`f j / columnSum K j * ∑ i, K i j * (d i / Matrix.mulVec K f i)`. -/
theorem update_apply {ι : Type u} {κ : Type v} [Fintype ι] [Fintype κ] (K : Matrix ι κ ℝ)
    (d : ι → ℝ) (f : κ → ℝ) (j : κ) :
    update K d f j =
      (f j / columnSum K j) * ∑ i, K i j * (d i / Matrix.mulVec K f i) := by
  -- This is the defining pointwise formula of `update`.
  rfl

/-- Equation `(9.43)`: the forward-model mass of one Richardson-Lucy step equals the total
observed data mass. -/
theorem sum_mulVec_update_eq_sum_data {ι : Type u} {κ : Type v} [Fintype ι] [Fintype κ]
    (K : Matrix ι κ ℝ) (d : ι → ℝ) (f : κ → ℝ) (hcolPos : ∀ j, 0 < columnSum K j)
    (hmodelPos : ∀ i, 0 < Matrix.mulVec K f i) :
    ∑ i, Matrix.mulVec K (update K d f) i = ∑ i, d i := by
  let ratio : ι → ℝ := fun i ↦ d i / Matrix.mulVec K f i
  -- Expand the forward model and isolate the column-sum factor in each backprojection term.
  calc
    ∑ i, Matrix.mulVec K (update K d f) i
        = ∑ i, ∑ j, K i j * update K d f j := by
            simp [Matrix.mulVec, dotProduct]
    _ = ∑ i, ∑ j, K i j * ((f j / columnSum K j) * ∑ i', K i' j * ratio i') := by
          simp [update_apply, ratio]
    _ = ∑ j, columnSum K j * ((f j / columnSum K j) * ∑ i, K i j * ratio i) := by
          rw [Finset.sum_comm]
          apply Finset.sum_congr rfl
          intro j _
          simpa [columnSum] using
            (Finset.sum_mul (s := Finset.univ)
              (f := fun i ↦ K i j)
              (((f j / columnSum K j) * ∑ i, K i j * ratio i))).symm
    _ = ∑ j, f j * ∑ i, K i j * ratio i := by
          apply Finset.sum_congr rfl
          intro j _
          have hcolNe : columnSum K j ≠ 0 := (hcolPos j).ne'
          simp [div_eq_mul_inv, hcolNe, mul_assoc, mul_left_comm]
    _ = ∑ j, ∑ i, f j * (K i j * ratio i) := by
          simp_rw [Finset.mul_sum]
    _ = ∑ i, ∑ j, f j * (K i j * ratio i) := by
          rw [Finset.sum_comm]
    _ = ∑ i, ratio i * ∑ j, K i j * f j := by
          apply Finset.sum_congr rfl
          intro i _
          simpa [mul_assoc, mul_left_comm, mul_comm] using
            (Finset.mul_sum (s := Finset.univ)
              (a := ratio i)
              (f := fun j ↦ K i j * f j)).symm
    _ = ∑ i, ratio i * Matrix.mulVec K f i := by
          apply Finset.sum_congr rfl
          intro i _
          simp [Matrix.mulVec, dotProduct]
    _ = ∑ i, d i := by
          apply Finset.sum_congr rfl
          intro i _
          have hmodelNe : Matrix.mulVec K f i ≠ 0 := (hmodelPos i).ne'
          simp [ratio, div_eq_mul_inv, hmodelNe]

/-- The Richardson-Lucy update can be read as a transpose/backprojection formula using
`Kᵀ *ᵥ (fun i ↦ d i / Matrix.mulVec K f i)`. -/
theorem update_eq_transpose_mulVec {ι : Type u} {κ : Type v} [Fintype ι] [Fintype κ]
    (K : Matrix ι κ ℝ) (d : ι → ℝ) (f : κ → ℝ) :
    update K d f =
      fun j ↦
        (f j / columnSum K j) *
          Matrix.mulVec Kᵀ (fun i ↦ d i / Matrix.mulVec K f i) j := by
  -- Unfold the update and package the backprojection sum as `Kᵀ *ᵥ ratio`.
  funext j
  simpa [Matrix.mulVec, dotProduct, mul_assoc, mul_left_comm, mul_comm] using
    (update_apply K d f j)

end RichardsonLucy

