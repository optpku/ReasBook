variable {H : Type u} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
variable {ι : Type v} [Fintype ι]

/-- Helper for Theorem 9.4: the active constraint indices at `fStar`. -/
abbrev ActiveIndex (c : ι → H → ℝ) (fStar : H) :=
  {i // c i fStar = 0}

/-- Helper for Theorem 9.4: the active-gradient family is the collection of gradients of the
constraints active at `fStar`. -/
abbrev activeGradientFamily (c : ι → H → ℝ) (fStar : H) :
    ActiveIndex c fStar → H :=
  fun i ↦ gradient (c i.1) fStar

/-- Helper for Theorem 9.4: the active span is generated by the active gradients at `fStar`. -/
abbrev activeSpan (c : ι → H → ℝ) (fStar : H) : Submodule ℝ H :=
  Submodule.span ℝ (Set.range (activeGradientFamily c fStar))

/-- Helper for Theorem 9.4: the active span is finite-dimensional because it is generated by the
finite active family. -/
instance activeSpan_finiteDimensional
    (c : ι → H → ℝ) (fStar : H)
    : FiniteDimensional ℝ (activeSpan c fStar) :=
  FiniteDimensional.span_of_finite ℝ (Set.finite_range (activeGradientFamily c fStar))

/-- Helper for Theorem 9.4: LICQ identifies the active gradients as a linearly independent
finite family. -/
lemma activeGradients_linearIndependent
    (c : ι → H → ℝ) (fStar : H)
    (hregular : ConstraintQualification.IsRegularPoint c fStar) :
    LinearIndependent ℝ (activeGradientFamily c fStar) := by
  -- Rewriting LICQ along the active subtype turns the source statement into the restricted family.
  rw [ConstraintQualification.isRegularPoint_iff] at hregular
  let e : ActiveIndex c fStar ≃ ↑(ActiveSet.active c fStar) :=
    { toFun := fun i ↦ ⟨i.1, by simpa [ActiveSet.mem_active] using i.2⟩
      invFun := fun i ↦ ⟨i.1, (ActiveSet.mem_active c fStar i.1).mp i.2⟩
      left_inv := by
        intro i
        cases i
        rfl
      right_inv := by
        intro i
        cases i
        simp [ActiveSet.mem_active] }
  have hli :
      LinearIndependent ℝ ((ActiveSet.active c fStar).restrict fun i ↦ gradient (c i) fStar) :=
    hregular.linearIndependent_restrict
  have heq :
      ((ActiveSet.active c fStar).restrict fun i ↦ gradient (c i) fStar) ∘ e =
        activeGradientFamily c fStar := by
    funext i
    rfl
  -- The active family is just a reindexing of the restricted active-set family.
  exact (linearIndependent_equiv' (R := ℝ) e heq).2 hli

/-- Helper for Theorem 9.4: membership in the active span is equivalent to an expansion in the
active-gradient family. -/
lemma mem_activeSpan_iff_exists_coefficients
    (c : ι → H → ℝ) (fStar : H) {x : H} :
    x ∈ activeSpan c fStar ↔
      ∃ lambdaA : ActiveIndex c fStar → ℝ,
        ∑ i, lambdaA i • gradient (c i.1) fStar = x := by
  -- Expanding the span rewrites membership as a finite coefficient identity.
  simpa [activeSpan, activeGradientFamily] using
    (Submodule.mem_span_range_iff_exists_fun (R := ℝ)
      (v := activeGradientFamily c fStar) (x := x))

/-- Helper for Theorem 9.4: LICQ provides active directions whose active-gradient pairings are the
Kronecker delta. -/
lemma exists_activeRightInverseFamily
    (c : ι → H → ℝ) (fStar : H)
    (hregular : ConstraintQualification.IsRegularPoint c fStar) :
    ∃ w : ActiveIndex c fStar → activeSpan c fStar,
      (∀ i, inner ℝ (gradient (c i.1) fStar) (w i : H) = 1) ∧
      (∀ i j, j ≠ i → inner ℝ (gradient (c j.1) fStar) (w i : H) = 0) := by
  classical
  let hli := activeGradients_linearIndependent c fStar hregular
  let b : Module.Basis (ActiveIndex c fStar) ℝ (activeSpan c fStar) := Module.Basis.span hli
  let coordDual : ActiveIndex c fStar → StrongDual ℝ (activeSpan c fStar) :=
    fun i ↦ ⟨b.coord i, (b.coord i).continuous_of_finiteDimensional⟩
  refine ⟨fun i ↦ (InnerProductSpace.toDual ℝ (activeSpan c fStar)).symm (coordDual i), ?_, ?_⟩
  · intro i
    -- Realize the `i`-th coordinate functional by Riesz representation on the active span.
    have hdual :
        inner ℝ ((InnerProductSpace.toDual ℝ (activeSpan c fStar)).symm (coordDual i)) (b i) =
          b.coord i (b i) := by
      simpa [coordDual] using
        (InnerProductSpace.toDual_symm_apply
          (𝕜 := ℝ) (E := activeSpan c fStar) (x := b i) (y := coordDual i))
    rw [real_inner_comm] at hdual
    -- The basis vector has `i`-th coordinate equal to `1`.
    simpa [b, Module.Basis.coord_apply, Module.Basis.repr_self] using hdual
  · intro i j hji
    -- The same coordinate functional vanishes on all other basis vectors.
    have hdual :
        inner ℝ ((InnerProductSpace.toDual ℝ (activeSpan c fStar)).symm (coordDual i)) (b j) =
          b.coord i (b j) := by
      simpa [coordDual] using
        (InnerProductSpace.toDual_symm_apply
          (𝕜 := ℝ) (E := activeSpan c fStar) (x := b j) (y := coordDual i))
    rw [real_inner_comm] at hdual
    simpa [b, Module.Basis.coord_apply, Module.Basis.repr_self, hji] using hdual

/-- Helper for Theorem 9.4: summing the active right-inverse family gives one correction
direction whose active-gradient pairing is identically `1`. -/
lemma exists_activeUnitCorrectionDirection
    (c : ι → H → ℝ) (fStar : H)
    (hregular : ConstraintQualification.IsRegularPoint c fStar) :
    ∃ u : H, ∀ i : ActiveIndex c fStar, inner ℝ (gradient (c i.1) fStar) u = 1 := by
  classical
  obtain ⟨w, hw_self, hw_ne⟩ := exists_activeRightInverseFamily c fStar hregular
  refine ⟨∑ j, (w j : H), ?_⟩
  intro i
  -- Summing the Kronecker-delta family collapses every active pairing to the diagonal term.
  calc
    inner ℝ (gradient (c i.1) fStar) (∑ j, (w j : H))
        = ∑ j, inner ℝ (gradient (c i.1) fStar) (w j : H) := by
          rw [inner_sum]
    _ = ∑ j : ActiveIndex c fStar, if j = i then (1 : ℝ) else 0 := by
          refine Finset.sum_congr rfl ?_
          intro j hj
          by_cases hji : j = i
          · simp [hji, hw_self]
          · simp [hji, hw_ne j i (by
              intro hij
              exact hji hij.symm)]
    _ = 1 := by simp

/-- Helper for Theorem 9.4: the active derivative of the tilted correction direction is the
active derivative of `y` shifted by the tilt parameter. -/
lemma activeGradient_pairing_tiltedCorrection
    (c : ι → H → ℝ) (fStar : H) {y u : H}
    (hu : ∀ i : ActiveIndex c fStar, inner ℝ (gradient (c i.1) fStar) u = 1)
    (i : ActiveIndex c fStar) (δ : ℝ) :
    inner ℝ (gradient (c i.1) fStar) (y + δ • u) =
      inner ℝ (gradient (c i.1) fStar) y + δ := by
  -- Expanding the inner product along the tilted direction isolates the unit correction term.
  calc
    inner ℝ (gradient (c i.1) fStar) (y + δ • u)
        = inner ℝ (gradient (c i.1) fStar) y +
            inner ℝ (gradient (c i.1) fStar) (δ • u) := by
          rw [inner_add_right]
    _ = inner ℝ (gradient (c i.1) fStar) y +
          δ * inner ℝ (gradient (c i.1) fStar) u := by
          rw [inner_smul_right]
    _ = inner ℝ (gradient (c i.1) fStar) y + δ := by rw [hu i, mul_one]

/-- Helper for Theorem 9.4: along a tilt parameter `δ ∈ [0, 1]`, the corrected direction stays
uniformly bounded by the norms of `y` and `u`. -/
lemma norm_tiltedCorrection_le
    {y u : H} {δ : ℝ} (hδ0 : 0 ≤ δ) (hδ1 : δ ≤ 1) :
    ‖y + δ • u‖ ≤ ‖y‖ + ‖u‖ := by
  -- The tilt contributes at most one copy of `‖u‖` because `δ` stays in `[0, 1]`.
  calc
    ‖y + δ • u‖ ≤ ‖y‖ + ‖δ • u‖ := norm_add_le _ _
    _ = ‖y‖ + |δ| * ‖u‖ := by rw [norm_smul, Real.norm_eq_abs]
    _ = ‖y‖ + δ * ‖u‖ := by simp [abs_of_nonneg hδ0]
    _ ≤ ‖y‖ + ‖u‖ := by
          gcongr
          nlinarith [norm_nonneg u]

/-- Helper for Theorem 9.4: differentiability controls each active constraint along a fixed ray. -/
lemma activeConstraint_rayLinearization
    (c : ι → H → ℝ) (fStar : H) (i : ActiveIndex c fStar)
    (hc : DifferentiableAt ℝ (c i.1) fStar) (z : H) :
    ∀ ⦃ε : ℝ⦄, 0 < ε →
      ∃ η > 0, ∀ ⦃t : ℝ⦄, |t| < η →
        |c i.1 (fStar + t • z) - t * inner ℝ (gradient (c i.1) fStar) z| ≤
          ε * |t| * ‖z‖ := by
  have hLittle :
      (fun h : H ↦ c i.1 (fStar + h) - c i.1 fStar -
        inner ℝ (gradient (c i.1) fStar) h) =o[𝓝 (0 : H)] fun h ↦ h := by
    -- Rewrite differentiability at `fStar` as the standard little-o remainder estimate.
    exact (hasGradientAt_iff_isLittleO_nhds_zero).1 hc.hasGradientAt
  have hRay :
      (fun t : ℝ ↦ c i.1 (fStar + t • z) - c i.1 fStar -
        inner ℝ (gradient (c i.1) fStar) (t • z)) =o[𝓝 (0 : ℝ)] fun t ↦ t • z := by
    -- Compose the Fréchet remainder estimate with the scalar ray `t ↦ t • z`.
    have htz : Tendsto (fun t : ℝ ↦ t • z) (𝓝 (0 : ℝ)) (𝓝 (0 : H)) := by
      simpa using
        (tendsto_id.smul_const z : Tendsto (fun t : ℝ ↦ t • z) (𝓝 (0 : ℝ)) (𝓝 ((0 : ℝ) • z)))
    simpa [Function.comp_def] using hLittle.comp_tendsto htz
  intro ε hε
  have hBound := hRay.bound hε
  rcases Metric.eventually_nhds_iff.1 hBound with ⟨η, hη, hηball⟩
  refine ⟨η, hη, ?_⟩
  intro t ht
  have hball := hηball (y := t) (by simpa [dist_eq_norm, Real.norm_eq_abs] using ht)
  -- Rewriting the one-dimensional remainder estimate gives the explicit ray inequality.
  simpa [i.2, inner_smul_right, norm_smul, Real.norm_eq_abs, sub_eq_add_neg, mul_assoc] using hball

/-- Helper for Theorem 9.4: every inactive constraint stays strictly feasible in one common
neighborhood of `fStar`. -/
lemma exists_inactiveConstraintNeighborhood
    (c : ι → H → ℝ) (fStar : H)
    (hfStar : ∀ i, 0 ≤ c i fStar)
    (hc : ∀ i, DifferentiableAt ℝ (c i) fStar) :
    ∃ ρ > 0, ∀ ⦃h : H⦄, ‖h‖ < ρ → ∀ i, c i fStar ≠ 0 → 0 < c i (fStar + h) := by
  have hEventually :
      ∀ᶠ h : H in 𝓝 (0 : H), ∀ i, c i fStar ≠ 0 → 0 < c i (fStar + h) := by
    refine Filter.eventually_all.2 ?_
    intro i
    by_cases hactive : c i fStar = 0
    · exact Filter.Eventually.of_forall fun _ hi ↦ False.elim (hi hactive)
    · have hpos : 0 < c i fStar := lt_of_le_of_ne (hfStar i) (Ne.symm hactive)
      have hcont :
          ContinuousAt (fun h : H ↦ c i (fStar + h)) (0 : H) := by
        -- Shift continuity of `c i` at `fStar` to continuity of the translated map at `0`.
        have hadd : ContinuousAt (fun h : H ↦ fStar + h) (0 : H) := by
          convert
            (continuousAt_const.add continuousAt_id :
              ContinuousAt ((fun _ : H ↦ fStar) + id) (0 : H)) using 1
          funext h
          simp [Pi.add_apply]
        have hci : ContinuousAt (c i) (fStar + (0 : H)) := by
          simpa using (hc i).continuousAt
        exact hci.comp hadd
      have hposEvent : ∀ᶠ h in 𝓝 (0 : H), 0 < c i (fStar + h) := by
        have : Set.Ioi (0 : ℝ) ∈ 𝓝 (c i (fStar + (0 : H))) := by
          simpa using (Ioi_mem_nhds hpos : Set.Ioi (0 : ℝ) ∈ 𝓝 (c i fStar))
        exact hcont.eventually_mem this
      exact hposEvent.mono fun _ hh _ ↦ hh
  rcases Metric.eventually_nhds_iff.1 hEventually with ⟨ρ, hρ, hρball⟩
  refine ⟨ρ, hρ, ?_⟩
  intro h hh i hi
  exact hρball (y := h) (by simpa [dist_eq_norm] using hh) i hi

/-- Helper for Theorem 9.4: a positive `ℝ≥0` inverse rescales a real ray back to its direction. -/
lemma nnrealInv_smul_realRay {t : ℝ} (ht : 0 < t) (z : H) :
    ((⟨t, le_of_lt ht⟩ : NNReal)⁻¹) • (t • z) = z := by
  -- All `ℝ≥0` coercion bookkeeping is confined to this one normalization lemma.
  have htnn : (⟨t, le_of_lt ht⟩ : NNReal) ≠ 0 := by
    simp [ht.ne']
  simpa [NNReal.smul_def] using (inv_smul_smul₀ htnn z)

/-- Helper for Theorem 9.4: for each fixed tilt `δ`, one can choose a positive scale so that the
tilted ray stays feasible for every constraint. -/
lemma exists_feasibleScaleForTilt
    (c : ι → H → ℝ) (fStar : H)
    (hfStar : ∀ i, 0 ≤ c i fStar)
    (hc : ∀ i, DifferentiableAt ℝ (c i) fStar)
    {y u : H}
    (hu : ∀ i : ActiveIndex c fStar, inner ℝ (gradient (c i.1) fStar) u = 1)
    (hy : ∀ i : ActiveIndex c fStar, 0 ≤ inner ℝ (gradient (c i.1) fStar) y)
    {δ : ℝ} (hδ0 : 0 < δ) (hδ1 : δ ≤ 1) :
    ∃ t : ℝ, 0 < t ∧ t ≤ δ ∧ ∀ i, 0 ≤ c i (fStar + t • (y + δ • u)) := by
  let z : H := y + δ • u
  let B : ℝ := ‖y‖ + ‖u‖ + 1
  let ε : ℝ := δ / (2 * B)
  have hBpos : 0 < B := by
    -- The global bound `B` is strictly positive because it contains an extra `+ 1`.
    dsimp [B]
    positivity
  have hzB : ‖z‖ ≤ B := by
    -- The tilted directions stay uniformly bounded as `δ` ranges in `(0, 1]`.
    have hnorm := norm_tiltedCorrection_le (y := y) (u := u) hδ0.le hδ1
    dsimp [z, B]
    linarith
  have hεpos : 0 < ε := by
    -- The active linearization tolerance is chosen from `δ` and the global bound `B`.
    dsimp [ε]
    positivity
  have hActiveEvent :
      ∀ᶠ t : ℝ in 𝓝 (0 : ℝ),
        ∀ i : ActiveIndex c fStar,
          |c i.1 (fStar + t • z) - t * inner ℝ (gradient (c i.1) fStar) z| ≤
            ε * |t| * ‖z‖ := by
    refine Filter.eventually_all.2 ?_
    intro i
    rcases activeConstraint_rayLinearization c fStar i (hc i.1) z hεpos with ⟨η, hη, hηbound⟩
    exact Metric.eventually_nhds_iff.2 ⟨η, hη, fun t ht ↦
      hηbound (t := t) (by simpa [dist_eq_norm, Real.norm_eq_abs] using ht)⟩
  rcases Metric.eventually_nhds_iff.1 hActiveEvent with ⟨ηA, hηA, hηAall⟩
  obtain ⟨ρ, hρ, hInactive⟩ := exists_inactiveConstraintNeighborhood c fStar hfStar hc
  let t : ℝ := min (δ / 2) (min (ηA / 2) (ρ / (2 * B)))
  have ht_pos : 0 < t := by
    -- The chosen scale is the half-minimum of the active and inactive admissible radii.
    dsimp [t]
    positivity
  have ht_le_delta : t ≤ δ := by
    -- The scale is at most the original tilt parameter.
    have hhalf : δ / 2 ≤ δ := by nlinarith
    exact (min_le_left _ _).trans hhalf
  refine ⟨t, ht_pos, ht_le_delta, ?_⟩
  intro i
  by_cases hi : c i fStar = 0
  · let iA : ActiveIndex c fStar := ⟨i, hi⟩
    have ht_etaA : t < ηA := by
      have ht_half : t ≤ ηA / 2 := by
        exact (min_le_right _ _).trans (min_le_left _ _)
      nlinarith
    have hrem :=
      hηAall (y := t) (by simpa [dist_eq_norm, Real.norm_eq_abs, abs_of_pos ht_pos] using ht_etaA) iA
    have hpair :
        δ ≤ inner ℝ (gradient (c iA.1) fStar) z := by
      -- The tilt adds `δ` to the active directional derivative.
      have hpairEq :
          inner ℝ (gradient (c iA.1) fStar) z =
            inner ℝ (gradient (c iA.1) fStar) y + δ := by
        simpa [z] using
          activeGradient_pairing_tiltedCorrection (c := c) (fStar := fStar) (y := y) hu iA δ
      nlinarith [hy iA, hpairEq]
    have hεz : ε * ‖z‖ ≤ δ / 2 := by
      -- The error term is at most half of the linear gain coming from the tilt.
      have hscale :
          ε * ‖z‖ ≤ ε * B := mul_le_mul_of_nonneg_left hzB hεpos.le
      have hBne : B ≠ 0 := ne_of_gt hBpos
      calc
        ε * ‖z‖ ≤ ε * B := hscale
        _ = δ / 2 := by
          dsimp [ε]
          field_simp [hBne]
    have herror : ε * t * ‖z‖ ≤ (δ / 2) * t := by
      have := mul_le_mul_of_nonneg_right hεz ht_pos.le
      simpa [mul_assoc, mul_left_comm, mul_comm] using this
    have hrem' :
        |c i (fStar + t • z) - t * inner ℝ (gradient (c i) fStar) z| ≤ ε * t * ‖z‖ := by
      simpa [iA, ε, abs_of_pos ht_pos] using hrem
    -- The active linear term dominates the remainder, so the constraint stays nonnegative.
    have hleft := (abs_le.mp hrem').1
    nlinarith
  · have ht_rho : t ≤ ρ / (2 * B) := by
      -- The inactive branch uses the `ρ / (2B)` part of the minimum.
      exact (min_le_right _ _).trans (min_le_right _ _)
    have hρz : (ρ / (2 * B)) * ‖z‖ ≤ ρ / 2 := by
      -- The bound `‖z‖ ≤ B` converts the inactive radius into a bound on `‖t • z‖`.
      have hscale :
          (ρ / (2 * B)) * ‖z‖ ≤ (ρ / (2 * B)) * B := by
        have hcoeff : 0 ≤ ρ / (2 * B) := by positivity
        exact mul_le_mul_of_nonneg_left hzB hcoeff
      have hBne : B ≠ 0 := ne_of_gt hBpos
      calc
        (ρ / (2 * B)) * ‖z‖ ≤ (ρ / (2 * B)) * B := hscale
        _ = ρ / 2 := by
          field_simp [hBne]
    have hsmall : ‖t • z‖ < ρ := by
      have hnorm_le : ‖t • z‖ ≤ ρ / 2 := by
        have hscale := mul_le_mul_of_nonneg_right ht_rho (norm_nonneg z)
        simpa [norm_smul, Real.norm_eq_abs, abs_of_nonneg ht_pos.le, mul_comm, mul_left_comm,
          mul_assoc] using hscale.trans hρz
      nlinarith
    -- Inactive constraints stay strictly positive inside the common neighborhood.
    exact (hInactive hsmall i hi).le

/-- Helper for Theorem 9.4: a direction satisfying all active first-order inequalities is a
positive tangent direction to the feasible set. -/
lemma linearizedFeasibleDirection_mem_posTangentCone
    (c : ι → H → ℝ) (fStar : H)
    (hfStar : ∀ i, 0 ≤ c i fStar)
    (hc : ∀ i, DifferentiableAt ℝ (c i) fStar)
    (hregular : ConstraintQualification.IsRegularPoint c fStar)
    {y : H}
    (hy : ∀ i : ActiveIndex c fStar, 0 ≤ inner ℝ (gradient (c i.1) fStar) y) :
    y ∈ posTangentConeAt {f | ∀ i, 0 ≤ c i f} fStar := by
  classical
  obtain ⟨u, hu⟩ := exists_activeUnitCorrectionDirection c fStar hregular
  have htilt :
      ∀ i : ActiveIndex c fStar, ∀ δ : ℝ,
        inner ℝ (gradient (c i.1) fStar) (y + δ • u) =
          inner ℝ (gradient (c i.1) fStar) y + δ := by
    intro i δ
    -- The common correction direction shifts every active derivative by exactly `δ`.
    simpa using
      activeGradient_pairing_tiltedCorrection (c := c) (fStar := fStar) (y := y) hu i δ
  have hnorm :
      ∀ ⦃δ : ℝ⦄, 0 ≤ δ → δ ≤ 1 → ‖y + δ • u‖ ≤ ‖y‖ + ‖u‖ := by
    intro δ hδ0 hδ1
    -- The tilted directions remain uniformly bounded while `δ` ranges in `[0, 1]`.
    exact norm_tiltedCorrection_le hδ0 hδ1
  let δSeq : ℕ → ℝ := fun n ↦ (n + 1 : ℝ)⁻¹
  have hδ_pos : ∀ n, 0 < δSeq n := by
    intro n
    dsimp [δSeq]
    positivity
  have hδ_le_one : ∀ n, δSeq n ≤ 1 := by
    intro n
    dsimp [δSeq]
    have hden_nat : 1 ≤ n + 1 := Nat.succ_le_succ (Nat.zero_le n)
    have hden : (1 : ℝ) ≤ n + 1 := by exact_mod_cast hden_nat
    exact inv_le_one_of_one_le₀ hden
  choose t ht_pos ht_le hfeas using fun n ↦
    exists_feasibleScaleForTilt c fStar hfStar hc hu hy (hδ_pos n) (hδ_le_one n)
  let d : ℕ → H := fun n ↦ t n • (y + δSeq n • u)
  have hδ_tendsto : Tendsto δSeq atTop (𝓝 (0 : ℝ)) := by
    simpa [δSeq] using (tendsto_one_div_add_atTop_nhds_zero_nat : Tendsto (fun n : ℕ ↦ 1 / (n + 1 : ℝ)) atTop (𝓝 0))
  have hd_tendsto : Tendsto d atTop (𝓝 (0 : H)) := by
    let B : ℝ := ‖y‖ + ‖u‖ + 1
    have hB_nonneg : 0 ≤ B := by
      dsimp [B]
      positivity
    have hBound :
        ∀ n, ‖d n‖ ≤ δSeq n * B := by
      intro n
      have hnormBound :
          ‖y + δSeq n • u‖ ≤ B := by
        have hnorm' := hnorm (δ := δSeq n) (hδ_pos n).le (hδ_le_one n)
        dsimp [B]
        linarith
      calc
        ‖d n‖ = ‖t n • (y + δSeq n • u)‖ := by
          rfl
        _ = t n * ‖y + δSeq n • u‖ := by
          rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg (ht_pos n).le]
        _ ≤ t n * B := mul_le_mul_of_nonneg_left hnormBound (ht_pos n).le
        _ ≤ δSeq n * B := mul_le_mul_of_nonneg_right (ht_le n) hB_nonneg
    have hUpper : Tendsto (fun n ↦ δSeq n * B) atTop (𝓝 (0 : ℝ)) := by
      simpa using hδ_tendsto.mul tendsto_const_nhds
    -- The feasible increments go to zero because their norms are squeezed by `δₙ B`.
    exact squeeze_zero_norm hBound hUpper
  have hds :
      ∀ᶠ n in atTop, fStar + d n ∈ {f | ∀ i, 0 ≤ c i f} := by
    refine Filter.Eventually.of_forall ?_
    intro n
    simpa [d] using hfeas n
  have hScaled :
      Tendsto
        (fun n ↦ ((⟨t n, le_of_lt (ht_pos n)⟩ : NNReal)⁻¹) • d n)
        atTop (𝓝 y) := by
    have hδu :
        Tendsto (fun n ↦ δSeq n • u) atTop (𝓝 (0 : H)) := by
      simpa using hδ_tendsto.smul_const u
    have htilt_tendsto : Tendsto (fun n ↦ y + δSeq n • u) atTop (𝓝 y) := by
      simpa using
        (tendsto_const_nhds.add hδu :
          Tendsto (fun n : ℕ ↦ y + δSeq n • u) atTop (𝓝 (y + 0)))
    refine Tendsto.congr' ?_ htilt_tendsto
    refine Filter.Eventually.of_forall ?_
    intro n
    simpa [d] using (nnrealInv_smul_realRay (ht_pos n) (y + δSeq n • u)).symm
  -- Route correction: the tangent argument now uses a fixed tilt sequence `δₙ = 1 / (n + 1)`
  -- and a one-step feasible scale `tₙ` for each `n`, avoiding the old two-parameter uniform route.
  change y ∈ tangentConeAt NNReal {f | ∀ i, 0 ≤ c i f} fStar
  exact mem_tangentConeAt_of_seq atTop
    (fun n ↦ ((⟨t n, le_of_lt (ht_pos n)⟩ : NNReal)⁻¹))
    d hd_tendsto hds hScaled

/-- Helper for Theorem 9.4: the local minimum annihilates the orthogonal complement of the active
span, so the objective gradient lies in the active span. -/
lemma exists_activeStationarity
    (J : H → ℝ) (c : ι → H → ℝ) (fStar : H)
    (hfStar : ∀ i, 0 ≤ c i fStar)
    (hmin : IsLocalMinOn J {f | ∀ i, 0 ≤ c i f} fStar)
    (hJ : DifferentiableAt ℝ J fStar)
    (hc : ∀ i, DifferentiableAt ℝ (c i) fStar)
    (hregular : ConstraintQualification.IsRegularPoint c fStar) :
    ∃ lambdaA : ActiveIndex c fStar → ℝ,
      gradient J fStar = ∑ i, lambdaA i • gradient (c i.1) fStar := by
  let S : Submodule ℝ H := activeSpan c fStar
  have hGradient_mem : gradient J fStar ∈ S := by
    have hGradient_mem_orthogonal : gradient J fStar ∈ Sᗮᗮ := by
      -- Every vector orthogonal to the active span gives a zero directional derivative at the
      -- local minimizer, so the objective gradient annihilates `Sᗮ`.
      refine (Sᗮ.mem_orthogonal (gradient J fStar)).2 ?_
      intro y hyS
      have hy_active_eq_zero :
          ∀ i : ActiveIndex c fStar, inner ℝ (gradient (c i.1) fStar) y = 0 := by
        intro i
        have hi_mem : gradient (c i.1) fStar ∈ S := by
          exact Submodule.subset_span ⟨i, rfl⟩
        exact (S.mem_orthogonal y).1 hyS _ hi_mem
      have hy_tangent :
          y ∈ posTangentConeAt {f | ∀ i, 0 ≤ c i f} fStar := by
        -- Orthogonality to every active gradient gives the nonnegative first-order inequalities.
        refine linearizedFeasibleDirection_mem_posTangentCone c fStar hfStar hc hregular ?_
        intro i
        exact le_of_eq (hy_active_eq_zero i).symm
      have hnegy_tangent :
          -y ∈ posTangentConeAt {f | ∀ i, 0 ≤ c i f} fStar := by
        -- The same orthogonality identity applies to `-y`.
        refine linearizedFeasibleDirection_mem_posTangentCone c fStar hfStar hc hregular ?_
        intro i
        have hi_zero := hy_active_eq_zero i
        exact le_of_eq (by simpa [hi_zero])
      have hderiv_zero :
          (fderiv ℝ J fStar) y = 0 :=
        hmin.hasFDerivWithinAt_eq_zero hJ.hasFDerivAt.hasFDerivWithinAt hy_tangent hnegy_tangent
      -- Rewriting the Fréchet derivative through the gradient gives the orthogonality relation.
      rw [hJ.hasGradientAt.fderiv_apply] at hderiv_zero
      simpa [inner_eq_zero_symm] using hderiv_zero
    have hclosure : S.topologicalClosure = S :=
      S.closed_of_finiteDimensional.submodule_topologicalClosure_eq
    -- Finite dimensionality makes the double orthogonal complement collapse back to `S`.
    rw [Submodule.orthogonal_orthogonal_eq_closure, hclosure] at hGradient_mem_orthogonal
    exact hGradient_mem_orthogonal
  obtain ⟨lambdaA, hspan⟩ :=
    (mem_activeSpan_iff_exists_coefficients c fStar).1 hGradient_mem
  -- Reading span membership as a coefficient identity yields the active stationarity formula.
  exact ⟨lambdaA, hspan.symm⟩

/-- Helper for Theorem 9.4: the active stationarity coefficients are nonnegative because each
active right-inverse direction is first-order feasible. -/
lemma activeMultipliers_nonneg
    (J : H → ℝ) (c : ι → H → ℝ) (fStar : H)
    (hfStar : ∀ i, 0 ≤ c i fStar)
    (hmin : IsLocalMinOn J {f | ∀ i, 0 ≤ c i f} fStar)
    (hJ : DifferentiableAt ℝ J fStar)
    (hc : ∀ i, DifferentiableAt ℝ (c i) fStar)
    (hregular : ConstraintQualification.IsRegularPoint c fStar)
    {lambdaA : ActiveIndex c fStar → ℝ}
    (hStationarity :
      gradient J fStar = ∑ i, lambdaA i • gradient (c i.1) fStar) :
    ∀ i : ActiveIndex c fStar, 0 ≤ lambdaA i := by
  classical
  obtain ⟨w, hw_self, hw_ne⟩ := exists_activeRightInverseFamily c fStar hregular
  intro i
  have hw_tangent : (w i : H) ∈ posTangentConeAt {f | ∀ i, 0 ≤ c i f} fStar := by
    -- The right-inverse direction has nonnegative active derivatives by construction.
    refine linearizedFeasibleDirection_mem_posTangentCone c fStar hfStar hc hregular ?_
    intro j
    by_cases hji : j = i
    · rw [hji, hw_self i]
      positivity
    · rw [hw_ne i j hji]
  have hderiv_nonneg :
      0 ≤ inner ℝ (gradient J fStar) (w i : H) := by
    have hnonneg :=
      hmin.hasFDerivWithinAt_nonneg hJ.hasFDerivAt.hasFDerivWithinAt hw_tangent
    -- Rewrite the objective derivative through the gradient.
    rw [hJ.hasGradientAt.fderiv_apply] at hnonneg
    simpa using hnonneg
  have hpairing :
      inner ℝ (gradient J fStar) (w i : H) = lambdaA i := by
    -- The active right-inverse family extracts the `i`-th coefficient from stationarity.
    rw [hStationarity, sum_inner, Finset.sum_eq_single_of_mem i (by simp)]
    · rw [real_inner_smul_left, hw_self i, mul_one]
    · intro j _ hji
      rw [real_inner_smul_left, hw_ne i j hji, mul_zero]
  simpa [hpairing] using hderiv_nonneg

/-- Helper for Theorem 9.4: once the active-set multipliers satisfy stationarity and
nonnegativity on `{i // c i fStar = 0}`, extending them by zero on inactive constraints
produces a global KKT multiplier. -/
lemma extendActiveMultipliers_isMultiplier
    (J : H → ℝ) (c : ι → H → ℝ) (fStar : H)
    (hfStar : ∀ i, 0 ≤ c i fStar)
    (lambdaA : {i // c i fStar = 0} → ℝ)
    (hStationarity :
      gradient J fStar = ∑ i : {i // c i fStar = 0}, lambdaA i • gradient (c i.1) fStar)
    (hDualNonneg : ∀ i : {i // c i fStar = 0}, 0 ≤ lambdaA i) :
    ∃ μ : ι → ℝ, IsMultiplier J c fStar μ := by
  classical
  let μ : ι → ℝ := fun i ↦ if h : c i fStar = 0 then lambdaA ⟨i, h⟩ else 0
  refine ⟨μ, ?_⟩
  refine ofConditions ?_ ?_ hfStar ?_
  · -- Reindex the global sum by the active-set subtype because `μ` vanishes off that set.
    have hsum :
        ∑ i, μ i • gradient (c i) fStar =
          ∑ i : {i // c i fStar = 0}, lambdaA i • gradient (c i.1) fStar := by
      refine Finset.sum_congr_set {i | c i fStar = 0}
        (fun i ↦ μ i • gradient (c i) fStar)
        (fun i : {i // c i fStar = 0} ↦ lambdaA i • gradient (c i.1) fStar)
        ?_ ?_
      · intro i hi
        simpa [μ] using dif_pos hi
      · intro i hi
        have hnot : c i fStar ≠ 0 := hi
        simp [μ, hnot]
    -- The active-index stationarity identity is exactly the full stationarity sum for `μ`.
    calc
      gradient J fStar = ∑ i : {i // c i fStar = 0}, lambdaA i • gradient (c i.1) fStar :=
        hStationarity
      _ = ∑ i, μ i • gradient (c i) fStar := hsum.symm
  · intro i
    -- Active coefficients inherit nonnegativity, and inactive coefficients are defined to be zero.
    by_cases hi : c i fStar = 0
    · simpa [μ, hi] using hDualNonneg ⟨i, hi⟩
    · simp [μ, hi]
  · intro i
    -- Complementarity is immediate from the zero extension on inactive indices.
    by_cases hi : c i fStar = 0
    · simp [μ, hi]
    · simp [μ, hi]

/-- Helper for Theorem 9.4: the remaining analytic step is to construct nonnegative
active-set multipliers whose active-gradient combination equals `gradient J fStar`. -/
lemma exists_activeMultipliersData
    (J : H → ℝ) (c : ι → H → ℝ) (fStar : H)
    (hfStar : ∀ i, 0 ≤ c i fStar)
    (hmin : IsLocalMinOn J {f | ∀ i, 0 ≤ c i f} fStar)
    (hJ : DifferentiableAt ℝ J fStar)
    (hc : ∀ i, DifferentiableAt ℝ (c i) fStar)
    (hregular : ConstraintQualification.IsRegularPoint c fStar) :
    ∃ lambdaA : {i // c i fStar = 0} → ℝ,
      gradient J fStar = ∑ i : {i // c i fStar = 0}, lambdaA i • gradient (c i.1) fStar ∧
      (∀ i : {i // c i fStar = 0}, 0 ≤ lambdaA i) := by
  obtain ⟨lambdaA, hStationarity⟩ :=
    exists_activeStationarity J c fStar hfStar hmin hJ hc hregular
  refine ⟨lambdaA, hStationarity, ?_⟩
  -- Reuse the active right-inverse directions to upgrade stationarity to dual feasibility.
  exact activeMultipliers_nonneg J c fStar hfStar hmin hJ hc hregular hStationarity

/-- Theorem 9.4. If `fStar` is a feasible local minimizer of the inequality-constrained
problem with objective `J`, the constraints `c i` are differentiable at `fStar`, and
`fStar` is a regular point of `c`, then there exists a multiplier vector
satisfying the KKT conditions `(9.10)`-`(9.13)`. -/
theorem exists_isMultiplier (J : H → ℝ) (c : ι → H → ℝ) (fStar : H)
    (hfStar : ∀ i, 0 ≤ c i fStar)
    (hmin : IsLocalMinOn J {f | ∀ i, 0 ≤ c i f} fStar)
    (hJ : DifferentiableAt ℝ J fStar)
    (hc : ∀ i, DifferentiableAt ℝ (c i) fStar)
    (hregular : ConstraintQualification.IsRegularPoint c fStar) :
    ∃ μ : ι → ℝ, IsMultiplier J c fStar μ := by
  -- First construct multipliers on the active constraints only.
  obtain ⟨lambdaA, hStationarity, hDualNonneg⟩ :=
    exists_activeMultipliersData J c fStar hfStar hmin hJ hc hregular
  -- Then extend those multipliers by zero on inactive constraints.
  exact extendActiveMultipliers_isMultiplier J c fStar hfStar lambdaA hStationarity hDualNonneg

end KKT
