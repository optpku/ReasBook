module

public import ComputationalMethodsInverseProblems_Vogel_2002.Chap03.Definition_3_6.Krylov
public import Mathlib.Analysis.InnerProductSpace.PiL2
public import Mathlib.Data.Real.Basic
public import Mathlib.LinearAlgebra.Matrix.ToLin

public section

noncomputable section

namespace Krylov

universe u

variable {n : Type u} [Fintype n] [DecidableEq n]

/-- Definition 3.6. The `k`th Krylov subspace generated by a matrix `A` and a
vector `x` is the span of `x, A x, ..., A^(k - 1) x`. This is the
matrix-specialized view of `Krylov.submodule`. -/
abbrev subspace (A : Matrix n n ℝ) (x : EuclideanSpace ℝ n) (k : ℕ) :
    Submodule ℝ (EuclideanSpace ℝ n) :=
  submodule A.toEuclideanLin x k

/-- The matrix Krylov subspace is the specialization of the generic Krylov
submodule to the Euclidean linear map associated to `A`. -/
theorem subspace_eq_submodule
    (A : Matrix n n ℝ) (x : EuclideanSpace ℝ n) (k : ℕ) :
    subspace A x k = submodule A.toEuclideanLin x k :=
  rfl

/-- The matrix Krylov-subspace membership criterion via bounded-degree
polynomial evaluation. -/
theorem mem_subspace_iff
    (A : Matrix n n ℝ) (x y : EuclideanSpace ℝ n) (k : ℕ) :
    y ∈ subspace A x k ↔
      ∃ p : Polynomial ℝ, p.degree < k ∧ y = (Polynomial.aeval A.toEuclideanLin p) x := by
  simpa [subspace_eq_submodule] using mem_submodule_iff A.toEuclideanLin x y k

end Krylov
