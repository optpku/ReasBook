module

public import Mathlib.Algebra.Polynomial.AlgebraMap
public import Mathlib.LinearAlgebra.Finsupp.LinearCombination
public import Mathlib.RingTheory.Polynomial.Basic

public section

noncomputable section

namespace Krylov

universe u v

variable {R : Type u} {M : Type v}
variable [CommRing R] [AddCommGroup M] [Module R M]

/-- The Krylov submodule generated by `x` under the iterates of the endomorphism
`f` up to order `k`. -/
def submodule (f : M →ₗ[R] M) (x : M) (k : ℕ) : Submodule R M :=
  Submodule.span R (Set.range fun i : Fin k => (f ^ (i : ℕ)) x)

/-- Membership in the Krylov submodule is equivalent to bounded-degree
polynomial evaluation at the generating vector. -/
theorem mem_submodule_iff (f : M →ₗ[R] M) (x y : M) (k : ℕ) :
    y ∈ submodule f x k ↔
      ∃ p : Polynomial R, p.degree < k ∧ y = (Polynomial.aeval f p) x := by
  constructor
  · intro hy
    rw [submodule] at hy
    obtain ⟨c, hc⟩ := Finsupp.mem_span_range_iff_exists_finsupp.mp hy
    let p : Polynomial R := ∑ i : Fin k, Polynomial.monomial (i : ℕ) (c i)
    have hp_mem : p ∈ Polynomial.degreeLT R k := by
      dsimp [p]
      refine Submodule.sum_mem (Polynomial.degreeLT R k) ?_
      intro i hi
      exact Polynomial.mem_degreeLT.2 <|
        lt_of_le_of_lt (Polynomial.degree_monomial_le (i : ℕ) (c i)) (WithBot.coe_lt_coe.2 i.is_lt)
    have hc' : (∑ i : Fin k, c i • (f ^ (i : ℕ)) x) = y := by
      simpa [Finsupp.sum_fintype] using hc
    refine ⟨p, Polynomial.mem_degreeLT.1 hp_mem, ?_⟩
    rw [show (Polynomial.aeval f p) x = ∑ i : Fin k, c i • (f ^ (i : ℕ)) x by
      simp [p, Polynomial.aeval_monomial, Module.End.mul_apply]]
    exact hc'.symm
  · rintro ⟨p, hp, rfl⟩
    rw [submodule, Polynomial.aeval_def, ← Polynomial.sum_monomial_eq p, Polynomial.eval₂_sum,
      Polynomial.sum_def]
    simpa [Polynomial.eval₂_monomial, Module.End.mul_apply, Finset.sum_apply] using
      (Submodule.sum_mem _ fun n hn => by
        have hnk : n < k := WithBot.coe_lt_coe.1 <|
          lt_of_le_of_lt (Polynomial.le_degree_of_mem_supp n hn) hp
        have hpow : (f ^ n) x ∈ Submodule.span R (Set.range fun i : Fin k => (f ^ (i : ℕ)) x) := by
          exact Submodule.subset_span (Set.mem_range.2 ⟨⟨n, hnk⟩, rfl⟩)
        simpa [Polynomial.eval₂_monomial, Module.End.mul_apply] using
          Submodule.smul_mem (Submodule.span R (Set.range fun i : Fin k => (f ^ (i : ℕ)) x))
            (p.coeff n) hpow)

end Krylov
