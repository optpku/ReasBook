module

public import ComputationalMethodsInverseProblems_Vogel_2002.Chap03.Definition_3_6
public import Mathlib.LinearAlgebra.AffineSpace.AffineSubspace.Basic

public section

noncomputable section

namespace ConjugateGradient

universe u

variable {n : Type u} [Fintype n] [DecidableEq n]

/-- The affine Krylov subspace through `f₀` generated by the initial gradient
`A.toEuclideanLin f₀ + b`. -/
def affineKrylovSubspace
    (A : Matrix n n ℝ) (b f₀ : EuclideanSpace ℝ n) (v : ℕ) :
    AffineSubspace ℝ (EuclideanSpace ℝ n) :=
  AffineSubspace.mk' f₀ (Krylov.subspace A (A.toEuclideanLin f₀ + b) v)

/-- Membership in `affineKrylovSubspace A b f₀ v` is equivalent to the
displacement from `f₀` lying in the corresponding Krylov subspace. -/
theorem mem_affineKrylovSubspace_iff
    (A : Matrix n n ℝ) (b f₀ f : EuclideanSpace ℝ n) (v : ℕ) :
    f ∈ affineKrylovSubspace A b f₀ v ↔
      f -ᵥ f₀ ∈ Krylov.subspace A (A.toEuclideanLin f₀ + b) v :=
  Iff.rfl

end ConjugateGradient
