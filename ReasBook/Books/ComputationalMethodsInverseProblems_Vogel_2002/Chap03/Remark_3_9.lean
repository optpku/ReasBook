/-- Helper for Remark 3.9: matrix Krylov subspaces are monotone in the step
index. -/
private lemma krylovSubspace_mono_remark
    (A : Matrix n n ℝ) (b : EuclideanSpace ℝ n) {v w : ℕ} (hvw : v ≤ w) :
    Krylov.subspace A b v ≤ Krylov.subspace A b w := by
  -- Reuse the same polynomial witness, since the degree bound only gets weaker.
  intro y hy
  rcases (Krylov.mem_subspace_iff A b y v).1 hy with ⟨p, hpdeg, hp⟩
  refine (Krylov.mem_subspace_iff A b y w).2 ⟨p, ?_, hp⟩
  exact lt_of_lt_of_le hpdeg (by exact_mod_cast hvw)

/-- Helper for Remark 3.9: applying `A` to a vector in the `k`th Krylov
subspace lands in the `(k + 1)`st Krylov subspace. -/
private lemma toEuclideanLin_mem_krylovSubspace_succ_remark
    (A : Matrix n n ℝ) (b y : EuclideanSpace ℝ n) (k : ℕ)
    (hy : y ∈ Krylov.subspace A b k) :
    A.toEuclideanLin y ∈ Krylov.subspace A b (k + 1) := by
  rcases (Krylov.mem_subspace_iff A b y k).1 hy with ⟨p, hpdeg, rfl⟩
  -- Multiplication by `X` raises the Krylov order by one.
  refine (Krylov.mem_subspace_iff A b _ (k + 1)).2 ?_
  refine ⟨Polynomial.X * p, ?_, ?_⟩
  · by_cases hp : p = 0
    · simp [hp]
    · have hpnat : p.natDegree < k :=
        (Polynomial.natDegree_lt_iff_degree_lt hp).2 hpdeg
      have hmul_nat : (p * Polynomial.X).natDegree ≤ k := by
        simpa [Polynomial.natDegree_mul_X hp] using Nat.succ_le_of_lt hpnat
      exact lt_of_le_of_lt
        (by simpa [Polynomial.X_mul] using Polynomial.degree_le_of_natDegree_le hmul_nat)
        (show (k : WithBot ℕ) < (k + 1 : ℕ) by
          exact_mod_cast Nat.lt_succ_self k)
  · simp [Polynomial.aeval_mul, Polynomial.aeval_X, Module.End.mul_apply]

/-- Helper for Remark 3.9: with initial guess `f₀ = 0`, the stored solution,
gradient, and search direction at step `v` all lie in the `(v + 1)`st Krylov
subspace generated by `A` and `b`. -/
private lemma iterateStateMem_krylovSubspace_zero
    (A : Matrix n n ℝ) (b : EuclideanSpace ℝ n) :
    ∀ v : ℕ,
      let σ := iterates A b 0 v
      σ.solution ∈ Krylov.subspace A b (v + 1) ∧
        σ.gradient ∈ Krylov.subspace A b (v + 1) ∧
        σ.direction ∈ Krylov.subspace A b (v + 1) := by
  intro v
  induction v with
  | zero =>
      -- The initial state is built from `0`, `b`, and `-b`.
      have hzero_mem : (0 : EuclideanSpace ℝ n) ∈ Krylov.subspace A b 1 := by
        simp
      have hb_mem : b ∈ Krylov.subspace A b 1 := by
        refine (Krylov.mem_subspace_iff A b b 1).2 ?_
        refine ⟨1, ?_, ?_⟩
        · norm_num
        · simp
      have hdir_mem : (-b : EuclideanSpace ℝ n) ∈ Krylov.subspace A b 1 := by
        simpa using Submodule.smul_mem (Krylov.subspace A b 1) (-1 : ℝ) hb_mem
      simpa [iterates_zero] using And.intro hzero_mem (And.intro hb_mem hdir_mem)
  | succ v hv =>
      rcases hv with ⟨hsol, hgrad, hdir⟩
      have hsol_up :
          (iterates A b 0 v).solution ∈ Krylov.subspace A b (v + 2) :=
        krylovSubspace_mono_remark A b (Nat.le_succ (v + 1)) hsol
      have hgrad_up :
          (iterates A b 0 v).gradient ∈ Krylov.subspace A b (v + 2) :=
        krylovSubspace_mono_remark A b (Nat.le_succ (v + 1)) hgrad
      have hdir_up :
          (iterates A b 0 v).direction ∈ Krylov.subspace A b (v + 2) :=
        krylovSubspace_mono_remark A b (Nat.le_succ (v + 1)) hdir
      have hAdir :
          A.toEuclideanLin ((iterates A b 0 v).direction) ∈ Krylov.subspace A b (v + 2) :=
        toEuclideanLin_mem_krylovSubspace_succ_remark A b
          (iterates A b 0 v).direction (v + 1) hdir
      -- The solution update adds a scalar multiple of the current direction.
      have hnext_solution :
          (step A (iterates A b 0 v)).solution ∈ Krylov.subspace A b (v + 2) := by
        exact Submodule.add_mem _ hsol_up
          (Submodule.smul_mem _ _ hdir_up)
      have hnext_gradient :
          (step A (iterates A b 0 v)).gradient ∈ Krylov.subspace A b (v + 2) := by
        exact Submodule.add_mem _ hgrad_up
          (Submodule.smul_mem _ _ hAdir)
      -- The direction update is built from the new gradient and the old direction.
      have hnext_direction :
          (step A (iterates A b 0 v)).direction ∈ Krylov.subspace A b (v + 2) := by
        exact Submodule.add_mem _
          (Submodule.neg_mem _ hnext_gradient)
          (Submodule.smul_mem _ _ hdir_up)
      simpa [iterates_succ] using
        And.intro hnext_solution (And.intro hnext_gradient hnext_direction)

/-- Helper for Remark 3.9: with initial guess `f₀ = 0`, the `v`th
conjugate-gradient iterate belongs to the `(v + 1)`st Krylov subspace
generated by `A` and `b`. -/
private theorem solution_mem_krylovSubspace_zero
    (A : Matrix n n ℝ) (b : EuclideanSpace ℝ n) (v : ℕ) :
    (iterates A b 0 v).solution ∈ Krylov.subspace A b (v + 1) := by
  -- The first component of the zero-start state invariant is exactly the desired claim.
  simpa using (iterateStateMem_krylovSubspace_zero A b v).1

/-- Helper for Remark 3.9: with initial guess `f₀ = 0`, each
conjugate-gradient iterate is of the form `pᵥ(A) b` for a polynomial of degree
at most `v`. -/
private theorem solution_eq_aeval_polynomial_zero
    (A : Matrix n n ℝ) (b : EuclideanSpace ℝ n) (v : ℕ) :
    ∃ p : Polynomial ℝ,
      p.degree < v + 1 ∧
      (iterates A b 0 v).solution = (Polynomial.aeval A.toEuclideanLin p) b := by
  -- Convert the verified Krylov membership into the canonical polynomial witness.
  rcases (Krylov.mem_subspace_iff A b (iterates A b 0 v).solution (v + 1)).1
      (solution_mem_krylovSubspace_zero A b v) with ⟨p, hpdeg, hp⟩
  exact ⟨p, hpdeg, hp⟩

omit [DecidableEq n] in
/-- Helper for Remark 3.9: a polynomial in a self-adjoint operator preserves
the orthogonal complement of each eigenspace. -/
private lemma aeval_mem_orthogonalComplement_eigenspace
    {T : Module.End ℝ (EuclideanSpace ℝ n)} (hT : T.IsSymmetric)
    (μ : ℝ) (p : Polynomial ℝ) {x : EuclideanSpace ℝ n}
    (hx : x ∈ (eigenspace T μ)ᗮ) :
    (Polynomial.aeval T p) x ∈ (eigenspace T μ)ᗮ := by
  -- Encode the invariance of the orthogonal complement as a stable-submodule hypothesis.
  have hstable : (eigenspace T μ)ᗮ ≤ (eigenspace T μ)ᗮ.comap T := by
    intro y hy
    exact hT.invariant_orthogonalComplement_eigenspace μ y hy
  -- Then the generic polynomial-on-invariant-submodule lemma applies directly.
  exact Polynomial.aeval_apply_smul_mem_of_le_comap hx p T hstable

omit [DecidableEq n] in
/-- Helper for Remark 3.9: if `p(T)` annihilates `b`, then any nonzero
eigenspace component of `b` forces `p` to vanish at the corresponding
eigenvalue. -/
private lemma annihilatingPolynomial_eval_zero_of_nonzeroEigenspaceProjection
    {T : Module.End ℝ (EuclideanSpace ℝ n)} (hT : T.IsSymmetric)
    (p : Polynomial ℝ) (b : EuclideanSpace ℝ n) {μ : ℝ}
    (hp : (Polynomial.aeval T p) b = 0)
    (hproj : (eigenspace T μ).orthogonalProjectionOnto b ≠ 0) :
    p.eval μ = 0 := by
  let y : eigenspace T μ := (eigenspace T μ).orthogonalProjectionOnto b
  have hy_mem : ((y : eigenspace T μ) : EuclideanSpace ℝ n) ∈ eigenspace T μ := y.2
  have hy_ne : (y : EuclideanSpace ℝ n) ≠ 0 := by
    intro hy_zero
    exact hproj (Subtype.ext hy_zero)
  have hy_eig : T (y : EuclideanSpace ℝ n) = μ • (y : EuclideanSpace ℝ n) := by
    rwa [Module.End.mem_eigenspace_iff] at hy_mem
  have hy_orth : b - (y : EuclideanSpace ℝ n) ∈ (eigenspace T μ)ᗮ := by
    exact (eigenspace T μ).sub_starProjection_mem_orthogonal b
  have hp_on_eigen :
      (Polynomial.aeval T p) (y : EuclideanSpace ℝ n) =
        p.eval μ • (y : EuclideanSpace ℝ n) := by
    simpa using Module.End.aeval_apply_of_mem_apply_eq_smul hy_eig
  have hp_orth :
      (Polynomial.aeval T p) (b - (y : EuclideanSpace ℝ n)) ∈ (eigenspace T μ)ᗮ :=
    aeval_mem_orthogonalComplement_eigenspace hT μ p hy_orth
  -- Split the annihilation equation into the eigenspace and orthogonal-complement parts.
  have hsplit :
      (Polynomial.aeval T p) (y : EuclideanSpace ℝ n) +
        (Polynomial.aeval T p) (b - (y : EuclideanSpace ℝ n)) = 0 := by
    calc
      (Polynomial.aeval T p) (y : EuclideanSpace ℝ n) +
          (Polynomial.aeval T p) (b - (y : EuclideanSpace ℝ n))
          = (Polynomial.aeval T p) b := by
              rw [← map_add]
              abel
      _ = 0 := hp
  have hp_eig_mem :
      (Polynomial.aeval T p) (y : EuclideanSpace ℝ n) ∈ eigenspace T μ := by
    rw [hp_on_eigen]
    exact Submodule.smul_mem _ _ hy_mem
  have hp_eig_orth :
      (Polynomial.aeval T p) (y : EuclideanSpace ℝ n) ∈ (eigenspace T μ)ᗮ := by
    have hneg_mem :
        -((Polynomial.aeval T p) (b - (y : EuclideanSpace ℝ n))) ∈ (eigenspace T μ)ᗮ :=
      Submodule.neg_mem _ hp_orth
    have hneg_eq :
        (Polynomial.aeval T p) (y : EuclideanSpace ℝ n) =
          -((Polynomial.aeval T p) (b - (y : EuclideanSpace ℝ n))) :=
      eq_neg_of_add_eq_zero_left hsplit
    rw [hneg_eq]
    exact hneg_mem
  have hp_zero :
      (Polynomial.aeval T p) (y : EuclideanSpace ℝ n) = 0 := by
    have hmem :
        (Polynomial.aeval T p) (y : EuclideanSpace ℝ n) ∈
          eigenspace T μ ⊓ (eigenspace T μ)ᗮ :=
      ⟨hp_eig_mem, hp_eig_orth⟩
    have : (Polynomial.aeval T p) (y : EuclideanSpace ℝ n) ∈
        (⊥ : Submodule ℝ (EuclideanSpace ℝ n)) := by
      simpa [(Submodule.orthogonal_disjoint (eigenspace T μ)).eq_bot] using hmem
    simpa using this
  -- The eigenspace projection is nonzero, so the scalar factor must vanish.
  rw [hp_on_eigen] at hp_zero
  exact Or.resolve_right (smul_eq_zero.mp hp_zero) hy_ne

/-- Helper for Remark 3.9: if `f₀ = 0`, then the conjugate-gradient iterates are
polynomial approximations `pᵥ(A) b` to `-A⁻¹ b`; when the orthogonal
projection of `b` onto each eigenspace is nonzero, some iterate attained in at
most `n` steps interpolates `-1 / λ` on every eigenvalue of `A`, so the
corresponding polynomial evaluation equals `-(A⁻¹).toEuclideanLin`. -/
private theorem zeroStartIterateInterpolatesInverseOnEigenvalues
    (A : Matrix n n ℝ) (b : EuclideanSpace ℝ n) (hA : A.PosDef)
    (hb_nondeg :
      ∀ μ ∈ Set.range hA.isHermitian.eigenvalues,
        (eigenspace A.toEuclideanLin μ).orthogonalProjectionOnto b ≠ 0) :
    let eigvals := hA.isHermitian.eigenvalues
    ∃ k ≤ Fintype.card n, ∃ p : Polynomial ℝ,
      (iterates A b 0 k).solution = (Polynomial.aeval A.toEuclideanLin p) b ∧
      (∀ i : n, p.eval (eigvals i) = -(1 / eigvals i)) ∧
      Polynomial.aeval A.toEuclideanLin p = -(A⁻¹).toEuclideanLin := by
  dsimp
  obtain ⟨k, hk, _, hkSolve⟩ :=
    terminates_at_exact_solution_from_any_initial_guess_spec A b 0 hA
  obtain ⟨p, hpdeg, hpIter⟩ := solution_eq_aeval_polynomial_zero A b k
  have hp_interp :
      ∀ i : n, p.eval (hA.isHermitian.eigenvalues i) = -(1 / hA.isHermitian.eigenvalues i) := by
    intro i
    let r : Polynomial ℝ := 1 + Polynomial.X * p
    have hr_apply :
        (Polynomial.aeval A.toEuclideanLin r) b = 0 := by
      -- Fold the terminating iterate into an annihilating polynomial at `b`.
      calc
        (Polynomial.aeval A.toEuclideanLin r) b
            = b + A.toEuclideanLin ((Polynomial.aeval A.toEuclideanLin p) b) := by
                simp [r, Polynomial.aeval_add, Polynomial.aeval_mul, Module.End.mul_apply]
        _ = b + A.toEuclideanLin ((iterates A b 0 k).solution) := by
              rw [hpIter]
        _ = b + -b := by
              rw [hkSolve]
        _ = 0 := by
              simp
    have hr_eval_zero :
        r.eval (hA.isHermitian.eigenvalues i) = 0 := by
      -- A nonzero eigenspace projection forces the annihilating polynomial to vanish there.
      refine annihilatingPolynomial_eval_zero_of_nonzeroEigenspaceProjection
        (Matrix.isSymmetric_toEuclideanLin_iff.mpr hA.isHermitian) r b hr_apply ?_
      exact hb_nondeg _ (Set.mem_range_self i)
    have hi_pos : 0 < hA.isHermitian.eigenvalues i := hA.eigenvalues_pos i
    have hi_ne : hA.isHermitian.eigenvalues i ≠ 0 := ne_of_gt hi_pos
    have hr_scalar :
        1 + hA.isHermitian.eigenvalues i * p.eval (hA.isHermitian.eigenvalues i) = 0 := by
      simpa [r, add_comm, add_left_comm, add_assoc, mul_comm, mul_left_comm, mul_assoc] using
        hr_eval_zero
    -- Solve the scalar identity using positivity of the eigenvalue.
    field_simp [hi_ne] at hr_scalar ⊢
    linarith
  refine ⟨k, hk, p, hpIter, hp_interp, ?_⟩
  -- Compare both operators on the Hermitian eigenbasis.
  · let B := hA.isHermitian.eigenvectorBasis
    apply B.toBasis.ext
    intro i
    let lam := hA.isHermitian.eigenvalues i
    have hlam_pos : 0 < lam := by
      simpa [lam] using hA.eigenvalues_pos i
    have hlam_ne : lam ≠ 0 := ne_of_gt hlam_pos
    have hA_det : IsUnit A.det := A.isUnit_iff_isUnit_det.mp hA.isUnit
    have heig :
        A.toEuclideanLin (B i) = lam • B i := by
      ext j
      simpa [Matrix.toLpLin_apply, B] using
        congrFun (hA.isHermitian.mulVec_eigenvectorBasis i) j
    have hleft :
        (Polynomial.aeval A.toEuclideanLin p) (B i) = -(1 / lam) • B i := by
      -- The polynomial action on an eigenvector is scalar evaluation at its eigenvalue.
      rw [Module.End.aeval_apply_of_mem_apply_eq_smul heig]
      simpa [lam] using congrArg (fun c : ℝ ↦ c • B i) (hp_interp i)
    have hright_core :
        (A⁻¹).toEuclideanLin (B i) = (1 / lam) • B i := by
      -- Show both vectors have the same image under `A`, then use injectivity of `A`.
      apply sub_eq_zero.mp
      apply eq_zero_of_toEuclideanLin_eq_zero_of_posDef A hA
      rw [map_sub]
      have hfirst :
          A.toEuclideanLin ((A⁻¹).toEuclideanLin (B i)) = B i := by
        calc
          A.toEuclideanLin ((A⁻¹).toEuclideanLin (B i))
              = Matrix.toEuclideanLin (A * A⁻¹) (B i) := by
                  simp [Matrix.toEuclideanLin, Matrix.toLpLin_apply, Matrix.mulVec_mulVec]
          _ = B i := by
                rw [Matrix.mul_nonsing_inv A hA_det]
                simp
      have hsecond :
          A.toEuclideanLin ((1 / lam) • B i) = B i := by
        calc
          A.toEuclideanLin ((1 / lam) • B i) = (1 / lam) • A.toEuclideanLin (B i) := by
            rw [map_smul]
          _ = (1 / lam) • (lam • B i) := by
            rw [heig]
          _ = ((1 / lam) * lam) • B i := by
            rw [smul_smul]
          _ = B i := by
            rw [one_div, inv_mul_cancel₀ hlam_ne, one_smul]
      rw [hfirst, hsecond, sub_self]
    -- The inverse acts by reciprocal eigenvalues on each eigenvector.
    calc
      (Polynomial.aeval A.toEuclideanLin p) (B i) = -(1 / lam) • B i := hleft
      _ = (-(A⁻¹).toEuclideanLin) (B i) := by
            simp [LinearMap.neg_apply, hright_core]

/-- A sequence starts at `0` and each iterate is a polynomial of degree at most
the step index in `A`, applied to `b`. -/
private def IsZeroStartPolynomialApproximationSequence
    (A : Matrix n n ℝ) (b : EuclideanSpace ℝ n)
    (f : ℕ → EuclideanSpace ℝ n) : Prop :=
  f 0 = 0 ∧
    ∀ v : ℕ,
      ∃ p : Polynomial ℝ,
        p.degree < v + 1 ∧
        f v = (Polynomial.aeval A.toEuclideanLin p) b

/-- A zero-start polynomial approximation sequence is exactly a sequence whose
initial value is `0` and whose `v`th term is a degree-`≤ v` polynomial in
`A`, applied to `b`. -/
private theorem isZeroStartPolynomialApproximationSequence_iff
    (A : Matrix n n ℝ) (b : EuclideanSpace ℝ n)
    (f : ℕ → EuclideanSpace ℝ n) :
    IsZeroStartPolynomialApproximationSequence A b f ↔
      f 0 = 0 ∧
        ∀ v : ℕ,
          ∃ p : Polynomial ℝ,
            p.degree < v + 1 ∧
            f v = (Polynomial.aeval A.toEuclideanLin p) b := by
  -- This is the defining expansion of the private predicate.
  rfl

/- Remark 3.9. Main labeled source-facing entry.

The source remark is formalized below as four clause theorems: polynomial
zero-start iterates, finite-step exactness under nondegenerate eigenspace
projections, semidefinite convergence to `-A† b`, and the Chebyshev
energy-norm bound.
-/

/-- Polynomial approximation clause of Remark 3.9. If the initial guess is `0`,
then the conjugate-gradient
iterates are polynomial approximations `p_v(A) b`. -/
theorem zeroStart_polynomialApproximation
    (A : Matrix n n ℝ) (b : EuclideanSpace ℝ n) (_hA : A.PosDef) :
    ∀ v : ℕ,
      ∃ p : Polynomial ℝ,
        p.degree < v + 1 ∧
        (iterates A b 0 v).solution = (Polynomial.aeval A.toEuclideanLin p) b := by
  -- The positive-definite hypothesis is part of the remark's regime, but the
  -- polynomial representation only uses the zero-start Krylov argument.
  intro v
  exact solution_eq_aeval_polynomial_zero A b v

/-- remark_3_9 (2). If the projection of `b` onto every eigenspace of the
positive-definite matrix `A` is nonzero, then after at most `Fintype.card n`
steps one conjugate-gradient polynomial interpolates `-1 / λ` on every
eigenvalue and satisfies `p(A) = -A⁻¹`. -/
theorem zeroStart_exactness_of_nondegenerateEigenspaceProjections
    (A : Matrix n n ℝ) (b : EuclideanSpace ℝ n) (hA : A.PosDef)
    (hb_nondeg :
      ∀ μ ∈ Set.range hA.isHermitian.eigenvalues,
        (eigenspace A.toEuclideanLin μ).orthogonalProjectionOnto b ≠ 0) :
    ∃ k ≤ Fintype.card n, ∃ p : Polynomial ℝ,
      (iterates A b 0 k).solution = (Polynomial.aeval A.toEuclideanLin p) b ∧
      (∀ i : n, p.eval (hA.isHermitian.eigenvalues i) = -(1 / hA.isHermitian.eigenvalues i)) ∧
      Polynomial.aeval A.toEuclideanLin p = -(A⁻¹).toEuclideanLin := by
  -- Reuse the zero-start interpolation theorem proved on the private API.
  exact zeroStartIterateInterpolatesInverseOnEigenvalues A b hA hb_nondeg

/-- A semidefinite conjugate-gradient regularization sequence for `A f = -b`
starts at `0` and, on each affine Krylov slice `affineKrylovSubspace A b 0 v`,
selects a least-residual iterate of minimal Euclidean norm. -/
def IsSemidefiniteCgRegularizationSequence
    (A : Matrix n n ℝ) (b : EuclideanSpace ℝ n)
    (f : ℕ → EuclideanSpace ℝ n) : Prop :=
  f 0 = 0 ∧
    ∀ v : ℕ,
      f v ∈ affineKrylovSubspace A b 0 v ∧
        IsMinOn (fun x : EuclideanSpace ℝ n ↦ ‖A.toEuclideanLin x + b‖)
          (affineKrylovSubspace A b 0 v) (f v) ∧
        ∀ x ∈ affineKrylovSubspace A b 0 v,
          IsMinOn (fun y : EuclideanSpace ℝ n ↦ ‖A.toEuclideanLin y + b‖)
            (affineKrylovSubspace A b 0 v) x →
            ‖f v‖ ≤ ‖x‖

/-- Unfolding `IsSemidefiniteCgRegularizationSequence` recovers the zero-start,
affine-Krylov, least-residual, and minimum-norm conditions directly. -/
theorem isSemidefiniteCgRegularizationSequence_iff
    (A : Matrix n n ℝ) (b : EuclideanSpace ℝ n)
    (f : ℕ → EuclideanSpace ℝ n) :
    IsSemidefiniteCgRegularizationSequence A b f ↔
      f 0 = 0 ∧
        ∀ v : ℕ,
          f v ∈ affineKrylovSubspace A b 0 v ∧
            IsMinOn (fun x : EuclideanSpace ℝ n ↦ ‖A.toEuclideanLin x + b‖)
              (affineKrylovSubspace A b 0 v) (f v) ∧
            ∀ x ∈ affineKrylovSubspace A b 0 v,
            IsMinOn (fun y : EuclideanSpace ℝ n ↦ ‖A.toEuclideanLin y + b‖)
                (affineKrylovSubspace A b 0 v) x →
                ‖f v‖ ≤ ‖x‖ := by
  -- This theorem just unfolds the defining predicate.
  rfl

/-- Private least-squares target anchor: `-A† b` is the canonical minimum-norm
solution for `A f = -b`, matching the convergence target in the semidefinite
Remark 3.9 clause. -/
private theorem isLeastSquaresMinimumNormSolution_iff_eq_neg_pseudoInverse
    (A : Matrix n n ℝ) (b x : EuclideanSpace ℝ n) :
    IsLeastSquaresMinimumNormSolution (A.toEuclideanLin.toContinuousLinearMap) (-b) x ↔
      x = -(pseudoInverse (A.toEuclideanLin.toContinuousLinearMap) b) := by
  let K : EuclideanSpace ℝ n →L[ℝ] EuclideanSpace ℝ n :=
    A.toEuclideanLin.toContinuousLinearMap
  constructor
  · intro hmin
    have hpseudo :
        IsLeastSquaresMinimumNormSolution K (-b) (-(pseudoInverse K b)) :=
      by
        -- Normalize the canonical pseudoinverse theorem from `-b` back to `-(A† b)`.
        simpa using K.isLeastSquaresMinimumNormSolution_pseudoInverse (-b)
    have hxker : x ∈ K.kerᗮ :=
      K.leastSquaresMinimumNormSolution_mem_kerOrthogonal hmin
    have hpker : -(pseudoInverse K b) ∈ K.kerᗮ :=
      K.leastSquaresMinimumNormSolution_mem_kerOrthogonal hpseudo
    have hdiff_ker :
        x - (-(pseudoInverse K b)) ∈ K.ker := by
      have hls_affine :
          IsLeastSquaresSolution K (-b) x ↔
            x ∈ AffineSubspace.mk' (-(pseudoInverse K b)) K.ker :=
        K.isLeastSquaresSolution_iff_mem_affineSubspace (-b) hpseudo.leastSquares
      have hx_affine :
          x ∈ AffineSubspace.mk' (-(pseudoInverse K b)) K.ker :=
        hls_affine.1 hmin.leastSquares
      simpa [vsub_eq_sub] using hx_affine
    have hdiff_orth :
        x - (-(pseudoInverse K b)) ∈ K.kerᗮ :=
      Submodule.sub_mem _ hxker hpker
    have hzero :
        x - (-(pseudoInverse K b)) = 0 := by
      have hmem :
          x - (-(pseudoInverse K b)) ∈ K.ker ⊓ K.kerᗮ :=
        ⟨hdiff_ker, hdiff_orth⟩
      have : x - (-(pseudoInverse K b)) ∈ (⊥ : Submodule ℝ (EuclideanSpace ℝ n)) := by
        simpa [(Submodule.orthogonal_disjoint K.ker).eq_bot] using hmem
      simpa using this
    exact sub_eq_zero.mp hzero
  · intro hx
    rw [hx]
    -- Reuse the canonical pseudoinverse theorem at the datum `-b`.
    simpa using K.isLeastSquaresMinimumNormSolution_pseudoInverse (-b)

/-- Helper anchor: `-A† b` is the canonical least-squares minimum-norm
solution of `A f = -b`, used as the target in the semidefinite
`Remark 3.9` clause. -/
private theorem neg_pseudoInverse_isLeastSquaresMinimumNormSolution
    (A : Matrix n n ℝ) (b : EuclideanSpace ℝ n) :
    IsLeastSquaresMinimumNormSolution (A.toEuclideanLin.toContinuousLinearMap) (-b)
      (-(pseudoInverse (A.toEuclideanLin.toContinuousLinearMap) b)) := by
  -- Apply the canonical pseudoinverse theorem to the datum `-b` and simplify linearity.
  simpa using
    (A.toEuclideanLin.toContinuousLinearMap).isLeastSquaresMinimumNormSolution_pseudoInverse (-b)

/-- Helper for Remark 3.9: if an element of `K.kerᗮ` maps to a chosen range
point `g`, then it is exactly the inverse image selected by
`kerOrthogonalEquivRange.symm`. -/
private lemma kerOrthogonalEquivRange_symm_eq_of_map_eq
    {H₁ H₂ : Type*} [NormedAddCommGroup H₁] [InnerProductSpace ℝ H₁] [CompleteSpace H₁]
    [NormedAddCommGroup H₂] [InnerProductSpace ℝ H₂]
    (K : H₁ →L[ℝ] H₂) [CompleteSpace K.range]
    {x : H₁} (hx : x ∈ K.kerᗮ) {g : H₂} (hg : g ∈ K.range)
    (hmap : K x = g) :
    (⟨x, hx⟩ : K.kerᗮ) = K.kerOrthogonalEquivRange.symm ⟨g, hg⟩ := by
  -- Route correction: compare the induced range elements, not the underlying subtypes.
  apply K.kerOrthogonalEquivRange.injective
  -- Both candidates become the same point of `K.range` after applying the restricted map.
  calc
    K.kerOrthogonalRangeRestrict ⟨x, hx⟩ = ⟨g, hg⟩ := by
      ext
      simpa [ContinuousLinearMap.kerOrthogonalRangeRestrict_apply] using hmap
    _ = K.kerOrthogonalRangeRestrict (K.kerOrthogonalEquivRange.symm ⟨g, hg⟩) := by
      symm
      exact K.kerOrthogonalEquivRange_symm_apply ⟨g, hg⟩

/-- Helper for Remark 3.9: on `ker(A)ᗮ`, solving `A x = -b` identifies `x` with
the negative pseudoinverse image of `b`. -/
private lemma eq_neg_pseudoInverse_of_mem_kerOrthogonal_of_solve
    (A : Matrix n n ℝ) (b x : EuclideanSpace ℝ n)
    (hxker : x ∈ (A.toEuclideanLin.ker)ᗮ)
    (hsolve : A.toEuclideanLin x = -b)
    (hb : b ∈ Set.range A.toEuclideanLin) :
    x = -(pseudoInverse (A.toEuclideanLin.toContinuousLinearMap) b) := by
  let K : EuclideanSpace ℝ n →L[ℝ] EuclideanSpace ℝ n :=
    A.toEuclideanLin.toContinuousLinearMap
  have hnegb : -b ∈ Set.range A.toEuclideanLin := by
    rcases hb with ⟨y, rfl⟩
    -- Negating a range witness keeps the datum inside the same range.
    refine ⟨-y, ?_⟩
    simp
  have hx_eq :
      (⟨x, hxker⟩ : K.kerᗮ) = K.kerOrthogonalEquivRange.symm ⟨-b, hnegb⟩ := by
    -- Both `ker(A)ᗮ` elements map to the same range point `-b`.
    exact kerOrthogonalEquivRange_symm_eq_of_map_eq K hxker hnegb (by simpa [K] using hsolve)
  have hpseudo :
      K.pseudoInverse (-b) = x := by
    -- On the range, the pseudoinverse is the inverse of `kerOrthogonalEquivRange`.
    calc
      K.pseudoInverse (-b)
          = (K.kerOrthogonalEquivRange.symm ⟨-b, hnegb⟩ : EuclideanSpace ℝ n) := by
              simpa [K] using K.pseudoInverse_apply_of_mem_range hnegb
      _ = x := by
            simpa [K] using congrArg (fun z : K.kerᗮ ↦ (z : EuclideanSpace ℝ n)) hx_eq.symm
  -- Convert the solved system at `-b` back to the target expression `-(A† b)`.
  calc
    x = K.pseudoInverse (-b) := hpseudo.symm
    _ = -(K.pseudoInverse b) := by
          exact map_neg K.pseudoInverse b
    _ = -(pseudoInverse (A.toEuclideanLin.toContinuousLinearMap) b) := by
          rfl

/-- Helper for Remark 3.9: with `f₀ = 0`, affine-Krylov membership is exactly
ordinary Krylov-subspace membership. -/
private lemma mem_zeroStartAffineKrylovSubspace_iff
    (A : Matrix n n ℝ) (b x : EuclideanSpace ℝ n) (v : ℕ) :
    x ∈ affineKrylovSubspace A b 0 v ↔ x ∈ Krylov.subspace A b v := by
  -- The zero-start affine slice is the translate of the Krylov subspace by `0`.
  rw [mem_affineKrylovSubspace_iff]
  simp [vsub_eq_sub]

/-- Helper for Remark 3.9: zero-start affine Krylov slices are monotone in the
iteration index. -/
private lemma affineKrylovSubspace_zero_mono
    (A : Matrix n n ℝ) (b : EuclideanSpace ℝ n) {v w : ℕ} (hvw : v ≤ w) :
    affineKrylovSubspace A b 0 v ≤ affineKrylovSubspace A b 0 w := by
  -- After rewriting to linear Krylov membership, monotonicity is inherited
  -- from the polynomial-degree criterion.
  intro x hx
  rw [mem_zeroStartAffineKrylovSubspace_iff] at hx ⊢
  exact krylovSubspace_mono_remark A b hvw hx

/-- Helper for Remark 3.9: restrict `A` to the `v`th zero-start Krylov
subspace. -/
private abbrev zeroStartRestrictedMap
    (A : Matrix n n ℝ) (b : EuclideanSpace ℝ n) (v : ℕ) :
    Krylov.subspace A b v →L[ℝ] EuclideanSpace ℝ n :=
  A.toEuclideanLin.toContinuousLinearMap.comp (Krylov.subspace A b v).subtypeL

/-- Helper for Remark 3.9: the restricted operator on each zero-start Krylov
slice has closed range because its domain is finite-dimensional. -/
private theorem isClosed_range_zeroStartRestrictedMap
    (A : Matrix n n ℝ) (b : EuclideanSpace ℝ n) (v : ℕ) :
    IsClosed (Set.range (zeroStartRestrictedMap A b v)) := by
  -- Finite-dimensional subspaces of Euclidean space are closed, and the range
  -- of the restricted map is one such subspace.
  change IsClosed
    (((zeroStartRestrictedMap A b v).toLinearMap.range : Submodule ℝ (EuclideanSpace ℝ n)) :
      Set (EuclideanSpace ℝ n))
  exact Submodule.closed_of_finiteDimensional _

/-- Helper for Remark 3.9: least-squares solutions of the restricted operator
are exactly the least-residual points on the zero-start affine Krylov slice. -/
private theorem isLeastSquaresSolution_zeroStartRestrictedMap_iff
    (A : Matrix n n ℝ) (b : EuclideanSpace ℝ n) (v : ℕ)
    (x : Krylov.subspace A b v) :
    (zeroStartRestrictedMap A b v).IsLeastSquaresSolution (-b) x ↔
      IsMinOn (fun y : EuclideanSpace ℝ n ↦ ‖A.toEuclideanLin y + b‖)
        (affineKrylovSubspace A b 0 v) x := by
  constructor
  · intro hx
    -- Translate the universal least-squares inequality on the restricted
    -- domain into minimization over the ambient affine slice.
    rw [isMinOn_iff]
    intro y hy
    let yS : Krylov.subspace A b v := ⟨y, (mem_zeroStartAffineKrylovSubspace_iff A b y v).1 hy⟩
    have hx' :=
      ((zeroStartRestrictedMap A b v).isLeastSquaresSolution_iff (-b) x).1 hx yS
    simpa [zeroStartRestrictedMap, yS, sub_eq_add_neg, add_assoc, add_left_comm, add_comm] using
      hx'
  · intro hx
    -- Conversely, every ambient competitor on the slice comes from a point of
    -- the restricted domain, so slice minimality gives a least-squares
    -- solution of the restricted operator.
    rw [(zeroStartRestrictedMap A b v).isLeastSquaresSolution_iff (-b) x]
    rw [isMinOn_iff] at hx
    intro y
    have hy_mem :
        ((y : Krylov.subspace A b v) : EuclideanSpace ℝ n) ∈
          affineKrylovSubspace A b 0 v := by
      rw [mem_zeroStartAffineKrylovSubspace_iff]
      exact y.property
    simpa [zeroStartRestrictedMap, sub_eq_add_neg, add_assoc, add_left_comm, add_comm] using
      hx y hy_mem

/-- Helper for Remark 3.9: choose on each zero-start Krylov slice the
closed-range pseudoinverse minimizer of the restricted least-squares problem. -/
private noncomputable def zeroStartSliceSelector
    (A : Matrix n n ℝ) (b : EuclideanSpace ℝ n) (v : ℕ) :
    EuclideanSpace ℝ n :=
  ((zeroStartRestrictedMap A b v).pseudoInverseOfClosedRange
    (isClosed_range_zeroStartRestrictedMap A b v) (-b) : Krylov.subspace A b v)

/-- Helper for Remark 3.9: the zero-start slice selector lies in the `v`th
affine Krylov slice, minimizes the residual there, and has minimal Euclidean
norm among those minimizers. -/
private theorem zeroStartSliceSelector_spec
    (A : Matrix n n ℝ) (b : EuclideanSpace ℝ n) (v : ℕ) :
    zeroStartSliceSelector A b v ∈ affineKrylovSubspace A b 0 v ∧
      IsMinOn (fun x : EuclideanSpace ℝ n ↦ ‖A.toEuclideanLin x + b‖)
        (affineKrylovSubspace A b 0 v) (zeroStartSliceSelector A b v) ∧
      ∀ x ∈ affineKrylovSubspace A b 0 v,
        IsMinOn (fun y : EuclideanSpace ℝ n ↦ ‖A.toEuclideanLin y + b‖)
          (affineKrylovSubspace A b 0 v) x →
          ‖zeroStartSliceSelector A b v‖ ≤ ‖x‖ := by
  let K := zeroStartRestrictedMap A b v
  let x : Krylov.subspace A b v :=
    K.pseudoInverseOfClosedRange (isClosed_range_zeroStartRestrictedMap A b v) (-b)
  have hxmin :
      K.IsLeastSquaresMinimumNormSolution (-b) x := by
    -- The restricted closed-range pseudoinverse is the canonical least-squares
    -- minimum-norm selector on the slice.
    exact
      K.isLeastSquaresMinimumNormSolution_pseudoInverseOfClosedRange
        (isClosed_range_zeroStartRestrictedMap A b v) (-b)
  refine ⟨?_, ?_, ?_⟩
  · -- Membership is just the subtype witness, rewritten back to the affine slice.
    rw [zeroStartSliceSelector, mem_zeroStartAffineKrylovSubspace_iff]
    simp
  · -- Least-squares optimality of the restricted selector becomes ambient
    -- residual minimality on the slice.
    simpa [zeroStartSliceSelector, K, x] using
      (isLeastSquaresSolution_zeroStartRestrictedMap_iff A b v x).1 hxmin.leastSquares
  · intro y hy hymin
    let yS : Krylov.subspace A b v := ⟨y, (mem_zeroStartAffineKrylovSubspace_iff A b y v).1 hy⟩
    have hyls : K.IsLeastSquaresSolution (-b) yS := by
      -- Convert the slice-level minimality of `y` into a least-squares
      -- property for the restricted operator.
      exact (isLeastSquaresSolution_zeroStartRestrictedMap_iff A b v yS).2 hymin
    simpa [zeroStartSliceSelector, K, x, yS] using hxmin.norm_le yS hyls

/-- Helper for Remark 3.9: the selected zero-start slice minimizer at step `0`
is the zero vector. -/
private theorem zeroStartSliceSelector_zero
    (A : Matrix n n ℝ) (b : EuclideanSpace ℝ n) :
    zeroStartSliceSelector A b 0 = 0 := by
  -- Step `0` has the trivial Krylov slice, so the selected point must be `0`.
  have hmem := (zeroStartSliceSelector_spec A b 0).1
  rw [mem_zeroStartAffineKrylovSubspace_iff] at hmem
  rcases (Krylov.mem_subspace_iff A b (zeroStartSliceSelector A b 0) 0).1 hmem with
    ⟨p, hpdeg, hp⟩
  have hp_bot : p.degree = ⊥ := by
    simpa using hpdeg
  have hp_zero : p = 0 := by
    rwa [Polynomial.degree_eq_bot] at hp_bot
  simpa [hp_zero] using hp

/-- Helper for Remark 3.9: the closed-range slice selector defines a
semidefinite conjugate-gradient regularization sequence. -/
private theorem zeroStartSliceSelector_isSemidefiniteCgRegularizationSequence
    (A : Matrix n n ℝ) (b : EuclideanSpace ℝ n) :
    IsSemidefiniteCgRegularizationSequence A b (zeroStartSliceSelector A b) := by
  -- Assemble the stepwise slice selector properties into the public sequence
  -- predicate.
  rw [isSemidefiniteCgRegularizationSequence_iff]
  constructor
  · exact zeroStartSliceSelector_zero A b
  · intro v
    exact zeroStartSliceSelector_spec A b v

/-- Helper for Remark 3.9: the negative pseudoinverse target belongs to a
finite zero-start Krylov slice. -/
private theorem negPseudoInverse_mem_zeroStartAffineKrylov
    (A : Matrix n n ℝ) (b : EuclideanSpace ℝ n) (hA : A.PosSemidef) :
    ∃ k : ℕ,
      -(pseudoInverse (A.toEuclideanLin.toContinuousLinearMap) b) ∈
        affineKrylovSubspace A b 0 k := by
  let eigvals := hA.isHermitian.eigenvalues
  let s : Finset ℝ := Finset.univ.image eigvals
  let r : ℝ → ℝ := fun t ↦ if t = 0 then 0 else -(1 / t)
  let p : Polynomial ℝ := Lagrange.interpolate s (fun t : ℝ ↦ t) r
  have hs_inj : Set.InjOn (fun t : ℝ ↦ t) s := by
    intro x hx y hy hxy
    exact hxy
  have hpdeg_s : p.degree < s.card := by
    simpa [p] using
      (Lagrange.degree_interpolate_lt (s := s) (v := fun t : ℝ ↦ t) (r := r) hs_inj)
  have hs_card : s.card ≤ Fintype.card n := Finset.card_image_le
  have hpdeg : p.degree < Fintype.card n + 1 := by
    exact lt_trans hpdeg_s (by exact_mod_cast Nat.lt_succ_of_le hs_card)
  have hp_eval :
      ∀ i : n, p.eval (eigvals i) = r (eigvals i) := by
    intro i
    simpa [p, s, eigvals] using
      (Lagrange.eval_interpolate_at_node (s := s) (v := fun t : ℝ ↦ t) (r := r)
        hs_inj (by simp [s, eigvals]))
  let K : EuclideanSpace ℝ n →L[ℝ] EuclideanSpace ℝ n :=
    A.toEuclideanLin.toContinuousLinearMap
  have hp_operator :
      (Polynomial.aeval A.toEuclideanLin p :
        EuclideanSpace ℝ n →ₗ[ℝ] EuclideanSpace ℝ n) =
        ((-(pseudoInverse K)) : EuclideanSpace ℝ n →ₗ[ℝ] EuclideanSpace ℝ n) := by
    let B := hA.isHermitian.eigenvectorBasis
    apply B.toBasis.ext
    intro i
    let lam := eigvals i
    have heig :
        A.toEuclideanLin (B i) = lam • B i := by
      ext j
      simpa [Matrix.toLpLin_apply, B, lam] using
        congrFun (hA.isHermitian.mulVec_eigenvectorBasis i) j
    have hleft :
        (Polynomial.aeval A.toEuclideanLin p) (B i) = r lam • B i := by
      rw [Module.End.aeval_apply_of_mem_apply_eq_smul heig, hp_eval i]
    have hright :
        ((-(pseudoInverse K)) : EuclideanSpace ℝ n →ₗ[ℝ] EuclideanSpace ℝ n) (B i) =
          r lam • B i := by
      by_cases hlam : lam = 0
      · have hKsymm : K.IsSymmetric := by
          simpa [K] using (Matrix.isSymmetric_toEuclideanLin_iff.mpr hA.isHermitian)
        have hker : B i ∈ K.ker := by
          rw [LinearMap.mem_ker]
          simpa [K, lam, hlam] using heig
        have horth : B i ∈ K.rangeᗮ := by
          simpa [hKsymm.orthogonal_range] using hker
        simp [K, r, lam, hlam, LinearMap.neg_apply,
          K.pseudoInverse_apply_of_mem_orthogonal horth]
      · have hsymm : A.toEuclideanLin.IsSymmetric :=
          Matrix.isSymmetric_toEuclideanLin_iff.mpr hA.isHermitian
        have hBasis_mem :
            B i ∈ eigenspace A.toEuclideanLin lam := by
          exact (Module.End.mem_eigenspace_iff).2 heig
        have hBasis_kerOrth :
            B i ∈ (A.toEuclideanLin.ker)ᗮ := by
          rw [Submodule.mem_orthogonal']
          intro y hy
          have hy_zero : y ∈ eigenspace A.toEuclideanLin 0 := by
            exact (Module.End.mem_eigenspace_iff).2 (by simpa [LinearMap.mem_ker] using hy)
          let bi : eigenspace A.toEuclideanLin lam := ⟨B i, hBasis_mem⟩
          let yz : eigenspace A.toEuclideanLin 0 := ⟨y, hy_zero⟩
          simpa [bi, yz] using hsymm.orthogonalFamily_eigenspaces hlam bi yz
        have hxker :
            (-(1 / lam) • B i) ∈ (A.toEuclideanLin.ker)ᗮ := by
          exact Submodule.smul_mem _ _ hBasis_kerOrth
        have hsolve :
            A.toEuclideanLin (-(1 / lam) • B i) = -B i := by
          have hscalar : (((-(1 / lam)) * lam) : ℝ) = -1 := by
            field_simp [hlam]
          calc
            A.toEuclideanLin (-(1 / lam) • B i) = (-(1 / lam)) • A.toEuclideanLin (B i) := by
              rw [map_smul]
            _ = (-(1 / lam)) • (lam • B i) := by
              rw [heig]
            _ = (((-(1 / lam)) * lam) : ℝ) • B i := by
              rw [smul_smul]
            _ = (-1 : ℝ) • B i := by
              rw [hscalar]
            _ = -B i := by
              simp
        have hBasis_range : (B i : EuclideanSpace ℝ n) ∈ Set.range A.toEuclideanLin := by
          have hscalar : (((1 / lam) * lam) : ℝ) = 1 := by
            field_simp [hlam]
          refine ⟨(1 / lam) • B i, ?_⟩
          calc
            A.toEuclideanLin ((1 / lam) • B i) = (1 / lam) • A.toEuclideanLin (B i) := by
              rw [map_smul]
            _ = (1 / lam) • (lam • B i) := by
              rw [heig]
            _ = (((1 / lam) * lam) : ℝ) • B i := by
              rw [smul_smul]
            _ = (1 : ℝ) • B i := by
              rw [hscalar]
            _ = B i := by
              simp
        have hx_eq :
            (-(1 / lam) • B i) = -(pseudoInverse K (B i)) := by
          simpa [K] using
            (eq_neg_pseudoInverse_of_mem_kerOrthogonal_of_solve
              A (B i) (-(1 / lam) • B i) hxker hsolve hBasis_range)
        simpa [K, r, lam, hlam, LinearMap.neg_apply] using hx_eq.symm
    simpa using hleft.trans hright.symm
  have hp_apply :
      (Polynomial.aeval A.toEuclideanLin p) b = -(pseudoInverse K b) := by
    -- Once the operators agree on the Hermitian eigenbasis, they agree on `b`.
    exact congrArg (fun T : EuclideanSpace ℝ n →ₗ[ℝ] EuclideanSpace ℝ n ↦ T b) hp_operator
  refine ⟨Fintype.card n + 1, ?_⟩
  -- The interpolating polynomial realizes the pseudoinverse target inside a
  -- finite Krylov slice.
  rw [mem_zeroStartAffineKrylovSubspace_iff]
  exact (Krylov.mem_subspace_iff A b _ (Fintype.card n + 1)).2 ⟨p, hpdeg, hp_apply.symm⟩

/-- Helper for Remark 3.9: once the negative pseudoinverse target lies in a
zero-start slice, every least-residual minimum-norm point on that slice
coincides with it. -/
private theorem eq_negPseudoInverse_of_sliceOptimal
    (A : Matrix n n ℝ) (b x : EuclideanSpace ℝ n) (v : ℕ)
    (hx_min :
      IsMinOn (fun y : EuclideanSpace ℝ n ↦ ‖A.toEuclideanLin y + b‖)
        (affineKrylovSubspace A b 0 v) x)
    (hx_norm :
      ∀ y ∈ affineKrylovSubspace A b 0 v,
        IsMinOn (fun z : EuclideanSpace ℝ n ↦ ‖A.toEuclideanLin z + b‖)
          (affineKrylovSubspace A b 0 v) y →
          ‖x‖ ≤ ‖y‖)
    (hz_mem :
      -(pseudoInverse (A.toEuclideanLin.toContinuousLinearMap) b) ∈
        affineKrylovSubspace A b 0 v) :
    x = -(pseudoInverse (A.toEuclideanLin.toContinuousLinearMap) b) := by
  let K : EuclideanSpace ℝ n →L[ℝ] EuclideanSpace ℝ n :=
    A.toEuclideanLin.toContinuousLinearMap
  let z : EuclideanSpace ℝ n := -(pseudoInverse K b)
  have hz_minNorm :
      K.IsLeastSquaresMinimumNormSolution (-b) z :=
    neg_pseudoInverse_isLeastSquaresMinimumNormSolution A b
  have hz_sliceMin :
      IsMinOn (fun y : EuclideanSpace ℝ n ↦ ‖A.toEuclideanLin y + b‖)
        (affineKrylovSubspace A b 0 v) z := by
    -- The global least-squares minimizer remains a minimizer after restricting
    -- to the slice containing it.
    rw [isMinOn_iff]
    intro y hy
    have hz_ls :=
      ((K.isLeastSquaresSolution_iff (-b) z).1 hz_minNorm.leastSquares) y
    simpa [K, z, sub_eq_add_neg, add_assoc, add_left_comm, add_comm] using hz_ls
  have hx_ls : K.IsLeastSquaresSolution (-b) x := by
    -- Slice minimality against the global target upgrades `x` to a global
    -- least-squares solution.
    rw [K.isLeastSquaresSolution_iff]
    intro y
    have hx_to_z := (isMinOn_iff.mp hx_min) z hz_mem
    have hz_to_y := ((K.isLeastSquaresSolution_iff (-b) z).1 hz_minNorm.leastSquares) y
    calc
      ‖K x - (-b)‖ ≤ ‖K z - (-b)‖ := by
        simpa [K, z, sub_eq_add_neg, add_assoc, add_left_comm, add_comm] using hx_to_z
      _ ≤ ‖K y - (-b)‖ := hz_to_y
  have hx_le_z : ‖x‖ ≤ ‖z‖ := hx_norm z hz_mem hz_sliceMin
  have hx_normGlobal :
      ∀ y : EuclideanSpace ℝ n, K.IsLeastSquaresSolution (-b) y → ‖x‖ ≤ ‖y‖ := by
    intro y hy
    exact le_trans hx_le_z (hz_minNorm.norm_le y hy)
  have hx_minNorm :
      K.IsLeastSquaresMinimumNormSolution (-b) x :=
    ContinuousLinearMap.IsLeastSquaresMinimumNormSolution.ofLeastSquaresAndNormLE
      hx_ls hx_normGlobal
  -- The private pseudoinverse characterization turns the global optimality
  -- statement into the desired equality.
  exact (isLeastSquaresMinimumNormSolution_iff_eq_neg_pseudoInverse A b x).1 hx_minNorm

/-- Helper for Remark 3.9: every eigenvalue of a Hermitian real matrix lies in
the closed spectral interval `[λ_min(A), λ_max(A)]`. -/
private lemma eigenvalue_mem_spectralInterval [Nonempty n]
    {A : Matrix n n ℝ} (hA : A.IsHermitian) (i : n) :
    sInf (spectrum ℝ A) ≤ hA.eigenvalues i ∧ hA.eigenvalues i ≤ sSup (spectrum ℝ A) := by
  have hspectrum_finite : (spectrum ℝ A).Finite := by
    simpa [hA.spectrum_real_eq_range_eigenvalues] using Set.finite_range hA.eigenvalues
  have hspectrum_bddBelow : BddBelow (spectrum ℝ A) := hspectrum_finite.bddBelow
  have hspectrum_bddAbove : BddAbove (spectrum ℝ A) := hspectrum_finite.bddAbove
  have hmem : hA.eigenvalues i ∈ spectrum ℝ A := hA.eigenvalues_mem_spectrum_real i
  constructor
  · -- The spectral infimum is a lower bound for every eigenvalue.
    exact csInf_le hspectrum_bddBelow hmem
  · -- The spectral supremum is an upper bound for every eigenvalue.
    exact le_csSup hspectrum_bddAbove hmem

/-- Helper for Remark 3.9: the quadratic form of a Hermitian real matrix is
the eigenvalue-weighted sum of squared coordinates in its orthonormal
eigenbasis. -/
private lemma inner_toEuclideanLin_eq_weightedSqRepr
    {A : Matrix n n ℝ} (hA : A.IsHermitian)
    (x : EuclideanSpace ℝ n) :
    inner ℝ (A.toEuclideanLin x) x =
      ∑ i, hA.eigenvalues i * (hA.eigenvectorBasis.repr x i) ^ 2 := by
  have hsymm : A.toEuclideanLin.IsSymmetric :=
    Matrix.isSymmetric_toEuclideanLin_iff.mpr hA
  have heig :
      ∀ i : n, A.toEuclideanLin (hA.eigenvectorBasis i) =
        hA.eigenvalues i • hA.eigenvectorBasis i := by
    intro i
    ext j
    simpa [Matrix.toLpLin_apply] using congrFun (hA.mulVec_eigenvectorBasis i) j
  -- Expand the quadratic form in the orthonormal eigenbasis and collapse cross terms.
  calc
    inner ℝ (A.toEuclideanLin x) x =
        ∑ i,
          inner ℝ (A.toEuclideanLin x) (hA.eigenvectorBasis i) *
            inner ℝ (hA.eigenvectorBasis i) x := by
          symm
          simpa using hA.eigenvectorBasis.sum_inner_mul_inner (A.toEuclideanLin x) x
    _ =
        ∑ i,
          (hA.eigenvalues i * (hA.eigenvectorBasis.repr x i)) *
            (hA.eigenvectorBasis.repr x i) := by
          refine Finset.sum_congr rfl ?_
          intro i hi
          have hcoord :
              inner ℝ (hA.eigenvectorBasis i) (A.toEuclideanLin x) =
                hA.eigenvalues i * (hA.eigenvectorBasis.repr x i) := by
            calc
              inner ℝ (hA.eigenvectorBasis i) (A.toEuclideanLin x)
                  = inner ℝ (A.toEuclideanLin (hA.eigenvectorBasis i)) x := by
                      symm
                      exact hsymm (hA.eigenvectorBasis i) x
              _ = inner ℝ (hA.eigenvalues i • hA.eigenvectorBasis i) x := by
                    rw [heig i]
              _ = hA.eigenvalues i * (hA.eigenvectorBasis.repr x i) := by
                    rw [OrthonormalBasis.repr_apply_apply, real_inner_smul_left]
          rw [real_inner_comm, hcoord, OrthonormalBasis.repr_apply_apply]
    _ = ∑ i, hA.eigenvalues i * (hA.eigenvectorBasis.repr x i) ^ 2 := by
          refine Finset.sum_congr rfl ?_
          intro i hi
          ring

/-- Helper for Remark 3.9: in the Hermitian eigenbasis, `Polynomial.aeval`
scales each coordinate by evaluating the polynomial at the corresponding
eigenvalue. -/
private lemma reprAeval_eq_eval_mul_repr
    {A : Matrix n n ℝ} (hA : A.IsHermitian) (q : Polynomial ℝ)
    (x : EuclideanSpace ℝ n) (i : n) :
    (hA.eigenvectorBasis.repr ((Polynomial.aeval A.toEuclideanLin q) x)) i =
      q.eval (hA.eigenvalues i) * (hA.eigenvectorBasis.repr x i) := by
  let B := hA.eigenvectorBasis
  have hxsum :
      ∑ j, (B.repr x j) • B j = x := by
    simpa [B] using B.sum_repr x
  -- Read off the `i`th coordinate after rewriting the image in the eigenbasis.
  calc
    (B.repr ((Polynomial.aeval A.toEuclideanLin q) x)) i
        = inner ℝ (B i) ((Polynomial.aeval A.toEuclideanLin q) x) := by
            rw [OrthonormalBasis.repr_apply_apply]
    _ = inner ℝ (B i) ((Polynomial.aeval A.toEuclideanLin q) (∑ j, (B.repr x j) • B j)) := by
          rw [hxsum]
    _ = inner ℝ (B i) (∑ j, (B.repr x j) • (q.eval (hA.eigenvalues j) • B j)) := by
          rw [map_sum]
          apply congrArg (inner ℝ (B i))
          refine Finset.sum_congr rfl ?_
          intro j hj
          have heig :
              A.toEuclideanLin (B j) = hA.eigenvalues j • B j := by
            ext k
            simpa [Matrix.toLpLin_apply, B] using congrFun (hA.mulVec_eigenvectorBasis j) k
          calc
            (Polynomial.aeval A.toEuclideanLin q) ((B.repr x j) • B j)
                = (B.repr x j) • ((Polynomial.aeval A.toEuclideanLin q) (B j)) := by
                    rw [map_smul]
            _ = (B.repr x j) • (q.eval (hA.eigenvalues j) • B j) := by
                  rw [Module.End.aeval_apply_of_mem_apply_eq_smul heig]
    _ = ∑ j, inner ℝ (B i) ((B.repr x j) • (q.eval (hA.eigenvalues j) • B j)) := by
          rw [inner_sum]
    _ = ∑ j,
          (B.repr x j) * q.eval (hA.eigenvalues j) * inner ℝ (B i) (B j) := by
          refine Finset.sum_congr rfl ?_
          intro j hj
          rw [inner_smul_right, inner_smul_right]
          ring
    _ = (B.repr x i) * q.eval (hA.eigenvalues i) := by
          rw [Finset.sum_eq_single i]
          · simp [B, mul_comm]
          · intro j hj hij
            have horth : inner ℝ (B i) (B j) = 0 := by
              calc
                inner ℝ (B i) (B j) = (B.repr (B j)) i := by
                    rw [OrthonormalBasis.repr_apply_apply]
                _ = 0 := by simp [hij]
            simp [horth]
          · intro hi
            exact (hi (Finset.mem_univ i)).elim
    _ = q.eval (hA.eigenvalues i) * (B.repr x i) := by
          ring

/-- Helper for Remark 3.9: a polynomial uniformly bounded on the spectral
interval controls the `A`-energy norm of its operator evaluation. -/
private lemma energyNorm_aeval_le_of_interval_bound
    [Nonempty n] (A : Matrix n n ℝ) (hA : A.PosDef) (q : Polynomial ℝ) {C : ℝ}
    (hC : 0 ≤ C)
    (hq : ∀ t ∈ Set.Icc (sInf (spectrum ℝ A)) (sSup (spectrum ℝ A)), |q.eval t| ≤ C)
    (e : EuclideanSpace ℝ n) :
    ‖(Polynomial.aeval A.toEuclideanLin q) e‖_[A, hA] ≤ C * ‖e‖_[A, hA] := by
  let hH : A.IsHermitian := hA.isHermitian
  let eigenbasis := hH.eigenvectorBasis
  let eigenvalues := hH.eigenvalues
  let e' : EuclideanSpace ℝ n := (Polynomial.aeval A.toEuclideanLin q) e
  have he_nonneg :
      0 ≤ inner ℝ (A.toEuclideanLin e) e :=
    Matrix.inner_toEuclideanLin_nonneg_of_posSemidef _ hA.posSemidef _
  have he'_nonneg :
      0 ≤ inner ℝ (A.toEuclideanLin e') e' :=
    Matrix.inner_toEuclideanLin_nonneg_of_posSemidef _ hA.posSemidef _
  have hsq_e :
      ‖e‖_[A, hA] ^ 2 = inner ℝ (A.toEuclideanLin e) e := by
    rw [Matrix.energyNorm_eq_sqrt_energyInner, Matrix.energyInner_eq, Real.sq_sqrt he_nonneg]
  have hsq_e' :
      ‖e'‖_[A, hA] ^ 2 = inner ℝ (A.toEuclideanLin e') e' := by
    rw [Matrix.energyNorm_eq_sqrt_energyInner, Matrix.energyInner_eq, Real.sq_sqrt he'_nonneg]
  have hsq_bound :
      ‖e'‖_[A, hA] ^ 2 ≤ (C * ‖e‖_[A, hA]) ^ 2 := by
    -- Expand both energy norms in the eigenbasis and bound each coordinate
    -- by the interval hypothesis.
    calc
      ‖e'‖_[A, hA] ^ 2 = inner ℝ (A.toEuclideanLin e') e' := hsq_e'
      _ = ∑ i, eigenvalues i * (eigenbasis.repr e' i) ^ 2 := by
            rw [inner_toEuclideanLin_eq_weightedSqRepr hH e']
      _ = ∑ i, eigenvalues i * ((q.eval (eigenvalues i) * (eigenbasis.repr e i)) ^ 2) := by
            refine Finset.sum_congr rfl ?_
            intro i hi
            rw [reprAeval_eq_eval_mul_repr hH q e i]
      _ ≤ ∑ i, C ^ 2 * (eigenvalues i * (eigenbasis.repr e i) ^ 2) := by
            refine Finset.sum_le_sum ?_
            intro i hi
            have hi_bounds := eigenvalue_mem_spectralInterval hH i
            have hi_nonneg : 0 ≤ eigenvalues i := by
              exact le_of_lt (hA.eigenvalues_pos i)
            have hq_i : |q.eval (eigenvalues i)| ≤ C :=
              hq _ (Set.mem_Icc.mpr hi_bounds)
            have hq_sq :
                (q.eval (eigenvalues i)) ^ 2 ≤ C ^ 2 := by
              have hq_bounds := abs_le.mp hq_i
              nlinarith [hC, hq_bounds.1, hq_bounds.2]
            have hi_term_nonneg : 0 ≤ eigenvalues i * (eigenbasis.repr e i) ^ 2 :=
              mul_nonneg hi_nonneg (sq_nonneg _)
            nlinarith [hq_sq, hi_term_nonneg]
      _ = C ^ 2 * ∑ i, eigenvalues i * (eigenbasis.repr e i) ^ 2 := by
            rw [← Finset.mul_sum]
      _ = C ^ 2 * inner ℝ (A.toEuclideanLin e) e := by
            rw [← inner_toEuclideanLin_eq_weightedSqRepr hH e]
      _ = (C * ‖e‖_[A, hA]) ^ 2 := by
            rw [← hsq_e]
            ring
  have hleft_nonneg : 0 ≤ ‖e'‖_[A, hA] := by
    rw [Matrix.energyNorm_eq_sqrt_energyInner]
    exact Real.sqrt_nonneg _
  have hright_nonneg : 0 ≤ C * ‖e‖_[A, hA] := by
    rw [Matrix.energyNorm_eq_sqrt_energyInner]
    exact mul_nonneg hC (Real.sqrt_nonneg _)
  -- Unsquare the spectral estimate once both sides are known to be nonnegative.
  exact (sq_le_sq₀ hleft_nonneg hright_nonneg).mp hsq_bound

/-- Helper for Remark 3.9: on a singleton positive interval, one can choose a
normalized polynomial witness that matches the `κ = 1` Chebyshev bound. -/
private lemma singletonIntervalNormalizedWitness
    (m : ℝ) (hm_pos : 0 < m) (v : ℕ) :
    ∃ q : Polynomial ℝ,
      q.eval 0 = 1 ∧
      q.degree ≤ v ∧
      ∀ t ∈ Set.Icc m m,
        |q.eval t| ≤
          2 * ((Real.sqrt (m / m) - 1) / (Real.sqrt (m / m) + 1)) ^ v := by
  cases v with
  | zero =>
      -- For `v = 0`, the constant polynomial `1` already satisfies the normalization.
      refine ⟨1, by simp, ?_, ?_⟩
      · norm_num
      · intro t ht
        rcases Set.mem_Icc.mp ht with ⟨htm, htm'⟩
        have : t = m := le_antisymm htm' htm
        simp [this]
  | succ k =>
      let q : Polynomial ℝ := Polynomial.C (-m⁻¹) * Polynomial.X + 1
      have hq0 : q.eval 0 = 1 := by
        -- The affine singleton witness is normalized at the origin.
        simp [q]
      have hqnat : q.natDegree = 1 := by
        -- The witness is a genuine linear polynomial because `m ≠ 0`.
        rw [Polynomial.natDegree_eq_one]
        refine ⟨-m⁻¹, ?_, 1, by simp [q]⟩
        exact neg_ne_zero.mpr (inv_ne_zero hm_pos.ne')
      have hqdeg : q.degree ≤ k + 1 := by
        have hqdeg1 : q.degree ≤ (1 : WithBot ℕ) := by
          simpa [hqnat] using (show q.degree ≤ q.natDegree from Polynomial.degree_le_natDegree)
        refine le_trans hqdeg1 ?_
        exact_mod_cast Nat.succ_le_succ (Nat.zero_le k)
      refine ⟨q, hq0, hqdeg, ?_⟩
      intro t ht
      rcases Set.mem_Icc.mp ht with ⟨htm, htm'⟩
      have ht_eq : t = m := le_antisymm htm' htm
      -- On the singleton point, the linear witness vanishes exactly.
      simp [q, ht_eq, hm_pos.ne']

/-- Helper for Remark 3.9: the strict-interval Chebyshev normalization
denominator decays with the standard square-root condition-number factor. -/
private lemma strictIntervalChebyshevDecay
    (m M : ℝ) (hm_pos : 0 < m) (hmM : m < M) (v : ℕ) :
    let κ : ℝ := M / m
    let x₀ : ℝ := (M + m) / (M - m)
    (((Polynomial.Chebyshev.T ℝ (v : ℤ)).eval x₀)⁻¹ : ℝ) ≤
      2 * ((Real.sqrt κ - 1) / (Real.sqrt κ + 1)) ^ v := by
  dsimp
  let κ : ℝ := M / m
  let x₀ : ℝ := (M + m) / (M - m)
  let θ : ℝ := Real.arcosh x₀
  let u : ℝ := Real.sqrt κ
  let z : ℝ := (((v : ℤ) : ℝ) * θ)
  have hκ_pos : 0 < κ := by
    dsimp [κ]
    exact div_pos (lt_trans hm_pos hmM) hm_pos
  have hκ_gt_one : 1 < κ := by
    dsimp [κ]
    exact (one_lt_div hm_pos).2 hmM
  have hu_nonneg : 0 ≤ u := by
    dsimp [u]
    exact Real.sqrt_nonneg _
  have hu_gt_one : 1 < u := by
    have hu_sq : u ^ 2 = κ := by
      dsimp [u]
      exact Real.sq_sqrt hκ_pos.le
    nlinarith [hκ_gt_one, hu_nonneg, hu_sq]
  have hx₀_κ :
      x₀ = (κ + 1) / (κ - 1) := by
    dsimp [x₀, κ]
    field_simp [hm_pos.ne', sub_ne_zero.mpr hmM.ne]
  have hx₀_eq :
      x₀ = (u ^ 2 + 1) / (u ^ 2 - 1) := by
    simpa [u, Real.sq_sqrt hκ_pos.le] using hx₀_κ
  have hx₀_ge_one : 1 ≤ x₀ := by
    have hden_pos : 0 < M - m := sub_pos.mpr hmM
    dsimp [x₀]
    refine (one_le_div hden_pos).2 ?_
    nlinarith [hm_pos]
  have hθ_nonneg : 0 ≤ θ := Real.arcosh_nonneg hx₀_ge_one
  have hT_eval :
      (Polynomial.Chebyshev.T ℝ (v : ℤ)).eval x₀ = Real.cosh z := by
    -- Evaluate the Chebyshev polynomial on the hyperbolic parameterization of `x₀`.
    dsimp [z]
    rw [← Real.cosh_arcosh hx₀_ge_one, Polynomial.Chebyshev.T_real_cosh]
  have hz_nonneg : 0 ≤ z := by
    positivity
  have hcosh_lower :
      Real.exp z / 2 ≤ Real.cosh z := by
    rw [Real.cosh_eq]
    have hexp_nonneg : 0 ≤ Real.exp (-z) := by positivity
    linarith
  have hcosh_pos : 0 < Real.cosh z := by
    have hexp_half_pos : 0 < Real.exp z / 2 := by
      positivity
    exact lt_of_lt_of_le hexp_half_pos hcosh_lower
  have hInv_exp :
      (Real.cosh z)⁻¹ ≤ 2 * Real.exp (-z) := by
    have hmul :
        1 ≤ Real.cosh z * (2 * Real.exp (-z)) := by
      have h :=
        mul_le_mul_of_nonneg_right hcosh_lower (show 0 ≤ 2 * Real.exp (-z) by positivity)
      have hleft : (Real.exp z / 2) * (2 * Real.exp (-z)) = 1 := by
        calc
          (Real.exp z / 2) * (2 * Real.exp (-z))
              = Real.exp z * Real.exp (-z) := by ring
          _ = Real.exp (z + -z) := by rw [← Real.exp_add]
          _ = 1 := by simp
      linarith
    rw [inv_le_iff_one_le_mul₀ hcosh_pos]
    simpa [mul_assoc, mul_left_comm, mul_comm] using hmul
  have hExp :
      Real.exp θ = (u + 1) / (u - 1) := by
    have hu_denom_pos : 0 < u ^ 2 - 1 := by
      nlinarith [hu_gt_one, hu_nonneg]
    have hsqrt :
        Real.sqrt (x₀ ^ 2 - 1) = (2 * u) / (u ^ 2 - 1) := by
      rw [hx₀_eq]
      have hsquare :
          ((u ^ 2 + 1) / (u ^ 2 - 1)) ^ 2 - 1 = ((2 * u) / (u ^ 2 - 1)) ^ 2 := by
        field_simp [hu_denom_pos.ne']
        ring
      rw [hsquare, Real.sqrt_sq_eq_abs]
      have hfrac_nonneg : 0 ≤ (2 * u) / (u ^ 2 - 1) := by
        exact div_nonneg (by positivity) hu_denom_pos.le
      exact abs_of_nonneg hfrac_nonneg
    calc
      Real.exp θ = x₀ + Real.sqrt (x₀ ^ 2 - 1) := Real.exp_arcosh hx₀_ge_one
      _ = x₀ + (2 * u) / (u ^ 2 - 1) := by rw [hsqrt]
      _ = (u ^ 2 + 1) / (u ^ 2 - 1) + (2 * u) / (u ^ 2 - 1) := by rw [hx₀_eq]
      _ = (u + 1) / (u - 1) := by
            have hu_ne : u - 1 ≠ 0 := sub_ne_zero.mpr hu_gt_one.ne.symm
            field_simp [hu_ne]
            ring
  have hExp_neg :
      Real.exp (-θ) = (u - 1) / (u + 1) := by
    rw [Real.exp_neg, hExp]
    have hu_add_ne : u + 1 ≠ 0 := by positivity
    have hu_sub_ne : u - 1 ≠ 0 := sub_ne_zero.mpr hu_gt_one.ne.symm
    field_simp [hu_add_ne, hu_sub_ne]
  have hDecay :
      2 * Real.exp (-z) ≤
        2 * ((Real.sqrt κ - 1) / (Real.sqrt κ + 1)) ^ v := by
    calc
      2 * Real.exp (-z)
          = 2 * (Real.exp (-θ)) ^ v := by
              dsimp [z]
              rw [show -((((v : ℤ) : ℝ) * θ)) = (v : ℕ) * (-θ) by norm_num]
              rw [Real.exp_nat_mul]
      _ = 2 * ((Real.sqrt κ - 1) / (Real.sqrt κ + 1)) ^ v := by
            rw [hExp_neg]
      _ ≤ 2 * ((Real.sqrt κ - 1) / (Real.sqrt κ + 1)) ^ v := by
            exact le_rfl
  -- Compare the inverse Chebyshev denominator to the exponential upper envelope.
  -- Compare the inverse Chebyshev denominator to the exponential upper envelope.
  rw [hT_eval]
  exact le_trans hInv_exp hDecay

/-- Helper for Remark 3.9: on a strict positive interval, the normalized
Chebyshev polynomial gives the textbook minimax error witness. -/
private lemma strictIntervalChebyshevWitness
    (m M : ℝ) (hm_pos : 0 < m) (hmM : m < M) (v : ℕ) :
    ∃ q : Polynomial ℝ,
      q.eval 0 = 1 ∧
      q.degree ≤ v ∧
      ∀ t ∈ Set.Icc m M,
        |q.eval t| ≤
          2 * ((Real.sqrt (M / m) - 1) / (Real.sqrt (M / m) + 1)) ^ v := by
  let affine : Polynomial ℝ :=
    Polynomial.C (-(2 / (M - m))) * Polynomial.X + Polynomial.C ((M + m) / (M - m))
  let d : ℝ := (Polynomial.Chebyshev.T ℝ (v : ℤ)).eval ((M + m) / (M - m))
  let q : Polynomial ℝ := Polynomial.C d⁻¹ * (Polynomial.Chebyshev.T ℝ (v : ℤ)).comp affine
  have hden_bound : 1 ≤ d := by
    -- The normalization denominator is evaluated at a point to the right of `1`.
    have hden_ge_one :
        1 ≤ (M + m) / (M - m) := by
      have hden_pos : 0 < M - m := sub_pos.mpr hmM
      refine (one_le_div hden_pos).2 ?_
      nlinarith [hm_pos]
    simpa [d] using Polynomial.Chebyshev.one_le_eval_T_real (v : ℤ) hden_ge_one
  have hd_nonneg : 0 ≤ d⁻¹ := inv_nonneg.mpr (le_trans (by norm_num : (0 : ℝ) ≤ 1) hden_bound)
  have hq0 : q.eval 0 = 1 := by
    -- The normalization is chosen so that evaluating at `0` cancels the denominator.
    have hd_ne : d ≠ 0 := by linarith
    simp [q, affine, d, hd_ne]
  have haffine_natDegree : affine.natDegree = 1 := by
    -- The affine change of variables is a genuine linear polynomial because `M - m ≠ 0`.
    rw [Polynomial.natDegree_eq_one]
    refine ⟨-(2 / (M - m)), ?_, (M + m) / (M - m), by simp [affine]⟩
    have hden_ne : M - m ≠ 0 := sub_ne_zero.mpr hmM.ne'
    exact neg_ne_zero.mpr (div_ne_zero two_ne_zero hden_ne)
  have hqdeg_nat : q.natDegree ≤ v := by
    -- Degree bookkeeping: composition with an affine polynomial preserves the Chebyshev degree.
    calc
      q.natDegree ≤ ((Polynomial.Chebyshev.T ℝ (v : ℤ)).comp affine).natDegree :=
        Polynomial.natDegree_C_mul_le _ _
      _ ≤ (Polynomial.Chebyshev.T ℝ (v : ℤ)).natDegree * affine.natDegree :=
        Polynomial.natDegree_comp_le
      _ = v := by simp [haffine_natDegree]
  have hqdeg : q.degree ≤ v := Polynomial.degree_le_of_natDegree_le hqdeg_nat
  refine ⟨q, hq0, hqdeg, ?_⟩
  intro t ht
  have hqeval :
      q.eval t =
        d⁻¹ *
          (Polynomial.Chebyshev.T ℝ (v : ℤ)).eval (((M + m - 2 * t) / (M - m) : ℝ)) := by
    calc
      q.eval t = d⁻¹ * (Polynomial.Chebyshev.T ℝ (v : ℤ)).eval (affine.eval t) := by
        simp [q]
      _ = d⁻¹ * (Polynomial.Chebyshev.T ℝ (v : ℤ)).eval (((M + m - 2 * t) / (M - m) : ℝ)) := by
        congr 1
        simp [affine]
        field_simp [sub_ne_zero.mpr hmM.ne']
        ring
  have hphi_abs :
      |((M + m - 2 * t) / (M - m) : ℝ)| ≤ 1 := by
    -- The affine map sends the interval `[m, M]` into `[-1, 1]`.
    have hden_pos : 0 < M - m := sub_pos.mpr hmM
    refine abs_le.mpr ?_
    constructor
    · refine (le_div_iff₀ hden_pos).2 ?_
      rcases Set.mem_Icc.mp ht with ⟨htm, htM⟩
      nlinarith
    · refine (div_le_iff₀ hden_pos).2 ?_
      rcases Set.mem_Icc.mp ht with ⟨htm, htM⟩
      nlinarith
  have hTv_abs :
      |(Polynomial.Chebyshev.T ℝ (v : ℤ)).eval (((M + m - 2 * t) / (M - m) : ℝ))| ≤ 1 :=
    Polynomial.Chebyshev.abs_eval_T_real_le_one (v : ℤ) hphi_abs
  have hDecay :=
    strictIntervalChebyshevDecay m M hm_pos hmM v
  -- Combine the interval `[-1, 1]` bound with the denominator estimate.
  calc
    |q.eval t|
        = |d⁻¹| *
            |(Polynomial.Chebyshev.T ℝ (v : ℤ)).eval (((M + m - 2 * t) / (M - m) : ℝ))| := by
              rw [hqeval, abs_mul]
    _ = d⁻¹ *
          |(Polynomial.Chebyshev.T ℝ (v : ℤ)).eval (((M + m - 2 * t) / (M - m) : ℝ))| := by
            rw [abs_of_nonneg hd_nonneg]
    _ ≤ d⁻¹ * 1 := by
          exact mul_le_mul_of_nonneg_left hTv_abs hd_nonneg
    _ = d⁻¹ := by ring
    _ ≤ 2 * ((Real.sqrt (M / m) - 1) / (Real.sqrt (M / m) + 1)) ^ v := by
          simpa [d] using hDecay

/-- Helper for Remark 3.9: the standard scaled Chebyshev witness on the
spectral interval is normalized at `0` and obeys the textbook spectral-ratio
bound `λ_max(A) / λ_min(A)`. -/
lemma scaledChebyshevPolynomial_spec
    [Nonempty n] (A : Matrix n n ℝ) (hA : A.PosDef) (v : ℕ) :
    ∃ q : Polynomial ℝ,
      q.eval 0 = 1 ∧
      q.degree ≤ v ∧
      ∀ t ∈ Set.Icc (sInf (spectrum ℝ A)) (sSup (spectrum ℝ A)),
        |q.eval t| ≤
          2 * ((Real.sqrt (sSup (spectrum ℝ A) / sInf (spectrum ℝ A)) - 1) /
            (Real.sqrt (sSup (spectrum ℝ A) / sInf (spectrum ℝ A)) + 1)) ^ v := by
  let m : ℝ := sInf (spectrum ℝ A)
  let M : ℝ := sSup (spectrum ℝ A)
  have hm_pos : 0 < m := by
    have hspectrum_finite : (spectrum ℝ A).Finite := by
      simpa [hA.isHermitian.spectrum_real_eq_range_eigenvalues] using
        Set.finite_range hA.isHermitian.eigenvalues
    have hspectrum_nonempty : (spectrum ℝ A).Nonempty := by
      simpa [hA.isHermitian.spectrum_real_eq_range_eigenvalues] using
        Set.range_nonempty hA.isHermitian.eigenvalues
    dsimp [m]
    refine (hspectrum_finite.lt_csInf_iff hspectrum_nonempty).2 ?_
    intro x hx
    rw [hA.isHermitian.spectrum_real_eq_range_eigenvalues] at hx
    rcases hx with ⟨i, rfl⟩
    exact hA.eigenvalues_pos i
  have hmM_le : m ≤ M := by
    classical
    let i : n := Classical.choice ‹Nonempty n›
    exact (eigenvalue_mem_spectralInterval hA.isHermitian i).1.trans
      (eigenvalue_mem_spectralInterval hA.isHermitian i).2
  by_cases hEq : m = M
  · -- Route correction: the affine Chebyshev normalization is singular on a singleton interval,
    -- so handle `lambdaMin = lambdaMax` by a direct normalized witness instead.
    obtain ⟨q, hq0, hqdeg, hqbound⟩ := singletonIntervalNormalizedWitness m hm_pos v
    refine ⟨q, hq0, hqdeg, ?_⟩
    intro t ht
    have ht' : t ∈ Set.Icc m m := by simpa [m, M, hEq] using ht
    simpa [m, M, hEq] using hqbound t ht'
  · have hmM : m < M := lt_of_le_of_ne hmM_le hEq
    obtain ⟨q, hq0, hqdeg, hqbound⟩ := strictIntervalChebyshevWitness m M hm_pos hmM v
    refine ⟨q, hq0, hqdeg, ?_⟩
    intro t ht
    simpa [m, M] using hqbound t ht

/-- Helper for Remark 3.9: for a positive-definite matrix and
initial guess `f₀ = 0`, the Chebyshev choice from `(3.12)` yields the
spectral-ratio error bound `(3.13)` in the `A`-energy norm. -/
private theorem chebyshev_energyNorm_error_bound
    [Nonempty n] (A : Matrix n n ℝ) (b : EuclideanSpace ℝ n) (hA : A.PosDef)
    (v : ℕ) :
    QuadraticOptimization.energyNormError A b hA (iterates A b 0 v).solution ≤
      2 * ((Real.sqrt (sSup (spectrum ℝ A) / sInf (spectrum ℝ A)) - 1) /
            (Real.sqrt (sSup (spectrum ℝ A) / sInf (spectrum ℝ A)) + 1)) ^ v *
        ‖QuadraticOptimization.error A b 0‖_[A, hA] := by
  obtain ⟨q, hq0, hqdeg, hqbound⟩ := scaledChebyshevPolynomial_spec A hA v
  let C : ℝ :=
    2 * ((Real.sqrt (sSup (spectrum ℝ A) / sInf (spectrum ℝ A)) - 1) /
      (Real.sqrt (sSup (spectrum ℝ A) / sInf (spectrum ℝ A)) + 1)) ^ v
  have hC : 0 ≤ C := by
    classical
    let i : n := Classical.choice inferInstance
    have hi_mem :
        hA.isHermitian.eigenvalues i ∈ Set.Icc (sInf (spectrum ℝ A)) (sSup (spectrum ℝ A)) :=
      Set.mem_Icc.mpr (eigenvalue_mem_spectralInterval hA.isHermitian i)
    have hi_bound : |q.eval (hA.isHermitian.eigenvalues i)| ≤ C := by
      simpa [C] using hqbound (hA.isHermitian.eigenvalues i) hi_mem
    exact le_trans (abs_nonneg _) hi_bound
  have hmin :=
    energyNorm_error_le_aeval_initialError A b 0 hA v q hq0 hqdeg
  have hspec :=
    energyNorm_aeval_le_of_interval_bound A hA q hC (by simpa [C] using hqbound)
      (initialError A b 0)
  -- Assemble the minimization step with the spectral-interval bound from the witness polynomial.
  calc
    QuadraticOptimization.energyNormError A b hA (iterates A b 0 v).solution
        = energyNormError A b 0 hA v := by
            rfl
    _ ≤ ‖(Polynomial.aeval A.toEuclideanLin q) (initialError A b 0)‖_[A, hA] := hmin
    _ ≤ C * ‖initialError A b 0‖_[A, hA] := hspec
    _ = 2 * ((Real.sqrt (sSup (spectrum ℝ A) / sInf (spectrum ℝ A)) - 1) /
          (Real.sqrt (sSup (spectrum ℝ A) / sInf (spectrum ℝ A)) + 1)) ^ v *
          ‖QuadraticOptimization.error A b 0‖_[A, hA] := by
            rfl

/-- Companion bridge for Remark 3.9 clause (3): any semidefinite
conjugate-gradient regularization sequence for `A f = -b` converges to the
least-squares minimum-norm solution `-A† b`. -/
theorem semidefiniteCgRegularizationSequence_tendsto_neg_pseudoInverse
    (A : Matrix n n ℝ) (b : EuclideanSpace ℝ n) (hA : A.PosSemidef)
    {f : ℕ → EuclideanSpace ℝ n}
    (hf : IsSemidefiniteCgRegularizationSequence A b f) :
    Filter.Tendsto f Filter.atTop
      (nhds (-(pseudoInverse (A.toEuclideanLin.toContinuousLinearMap) b))) := by
  let z : EuclideanSpace ℝ n :=
    -(pseudoInverse (A.toEuclideanLin.toContinuousLinearMap) b)
  rcases (isSemidefiniteCgRegularizationSequence_iff A b f).1 hf with ⟨_, hf_spec⟩
  obtain ⟨k, hk_mem⟩ := negPseudoInverse_mem_zeroStartAffineKrylov A b hA
  have hEventually :
      f =ᶠ[Filter.atTop] fun _ : ℕ ↦ z := by
    -- Once the pseudoinverse target enters a Krylov slice, slice-wise
    -- optimality forces every later iterate to equal it.
    refine Filter.eventually_atTop.2 ⟨k, ?_⟩
    intro v hv
    rcases hf_spec v with ⟨_, hmin, hnorm⟩
    have hz_mem : z ∈ affineKrylovSubspace A b 0 v :=
      affineKrylovSubspace_zero_mono A b hv hk_mem
    exact eq_negPseudoInverse_of_sliceOptimal A b (f v) v hmin hnorm hz_mem
  -- An eventually constant sequence converges to that constant.
  exact hEventually.tendsto

/-- Remark 3.9 (3). If `A` is symmetric positive semidefinite and `f₀ = 0`,
then there exists a semidefinite conjugate-gradient regularization sequence for
`A f = -b` that converges to the least-squares minimum-norm solution `-A† b`. -/
theorem zeroStart_semidefinite_regularization_tendsto_neg_pseudoInverse
    (A : Matrix n n ℝ) (b : EuclideanSpace ℝ n) (hA : A.PosSemidef) :
    ∃ f : ℕ → EuclideanSpace ℝ n,
      IsSemidefiniteCgRegularizationSequence A b f ∧
      Filter.Tendsto f Filter.atTop
        (nhds (-(pseudoInverse (A.toEuclideanLin.toContinuousLinearMap) b))) := by
  refine ⟨zeroStartSliceSelector A b, ?_, ?_⟩
  · -- The explicit slice selector satisfies the semidefinite regularization
    -- sequence predicate by construction.
    exact zeroStartSliceSelector_isSemidefiniteCgRegularizationSequence A b
  · -- Apply the universal convergence theorem to the explicit selector.
    exact semidefiniteCgRegularizationSequence_tendsto_neg_pseudoInverse
      A b hA (zeroStartSliceSelector_isSemidefiniteCgRegularizationSequence A b)

/-- remark_3_9 (4). For a positive-definite matrix `A` and initial guess
`f₀ = 0`, the scaled Chebyshev polynomial from `(3.12)` yields the iterative
error bound `(3.13)` in the `A`-energy norm. -/
theorem zeroStart_chebyshev_energyNorm_error_bound
    [Nonempty n] (A : Matrix n n ℝ) (b : EuclideanSpace ℝ n) (hA : A.PosDef)
    (v : ℕ) :
    energyNormError A b 0 hA v ≤
      2 * ((Real.sqrt (A.posDefConditionNumber hA) - 1) /
            (Real.sqrt (A.posDefConditionNumber hA) + 1)) ^ v *
        ‖initialError A b 0‖_[A, hA] := by
  -- Rewrite the private spectral-ratio estimate using the positive-definite
  -- condition number.
  simpa [ConjugateGradient.energyNormError, ConjugateGradient.initialError,
    Matrix.posDefConditionNumber_eq_spectralExtrema A hA] using
    chebyshev_energyNorm_error_bound A b hA v

end ConjugateGradient
