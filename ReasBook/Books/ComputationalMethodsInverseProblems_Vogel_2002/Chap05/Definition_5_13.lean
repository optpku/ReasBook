module

public import Mathlib.LinearAlgebra.Matrix.Circulant
public import Mathlib.Logic.Equiv.Fin.Rotate

public section

open scoped Matrix

universe u

namespace Matrix

variable {α : Type u}

/-- The circulant right shift matrix for Definition 5.13 on `Fin n` is the circulant matrix
generated by the vector that is `1` at the index `1 % n` and `0` elsewhere. -/
@[expose]
def circulantRightShift (n : ℕ) [Zero α] [One α] : Matrix (Fin n) (Fin n) α :=
  Matrix.circulant (fun i : Fin n ↦ if i.1 = 1 % n then 1 else 0)

/-- `Matrix.circulantRightShift` is the circulant matrix generated by the indicator of `1 % n`. -/
theorem circulantRightShift_eq_circulant (n : ℕ) [Zero α] [One α] :
    circulantRightShift n = Matrix.circulant (fun i : Fin n ↦ if i.1 = 1 % n then 1 else 0) := rfl

/-- Helper for Definition 5.13: the generator index `1 % n` occurs exactly when the row index is
the right rotation of the column index. -/
lemma sub_eq_oneMod_iff_eq_finRotate (n : ℕ) (i j : Fin n) :
    ((i - j : Fin n)).1 = 1 % n ↔ i = finRotate n j := by
  -- Local instance justification (index arithmetic): the numerals in `Fin n` identities such as
  -- `sub_eq_iff_eq_add` and `finRotate_apply` need `[NeZero n]`, and the index `i : Fin n`
  -- supplies the required positivity witness for `n`.
  letI : NeZero n := by
    refine ⟨Nat.ne_of_gt ?_⟩
    exact lt_of_lt_of_le (Nat.zero_lt_succ i.1) (Nat.succ_le_of_lt i.is_lt)
  constructor
  · intro h
    have hsub : (i - j : Fin n) = (1 : Fin n) := by
      apply Fin.ext
      simpa using h
    have hadd : i = (1 : Fin n) + j := sub_eq_iff_eq_add.mp hsub
    simpa [finRotate_apply, add_comm] using hadd
  · intro h
    have hsub : (i - j : Fin n) = (1 : Fin n) := by
      apply sub_eq_iff_eq_add.mpr
      simpa [finRotate_apply, add_comm] using h
    simpa using congrArg (fun k : Fin n ↦ k.1) hsub

/-- Entrywise description of `Matrix.circulantRightShift`. -/
@[simp] theorem circulantRightShift_apply (n : ℕ) [Zero α] [One α] (i j : Fin n) :
    circulantRightShift n i j = if i = finRotate n j then 1 else 0 := by
  rw [circulantRightShift_eq_circulant (α := α), Matrix.circulant_apply]
  simp [sub_eq_oneMod_iff_eq_finRotate]

/-- Helper for Definition 5.13: the `i`th row of `circulantRightShift n` is supported only at
`(finRotate n).symm i`. -/
lemma circulantRightShift_row (n : ℕ) [Zero α] [One α] (i : Fin n) :
    circulantRightShift n i = Pi.single ((finRotate n).symm i) (1 : α) := by
  ext j
  rw [circulantRightShift, Matrix.circulant_apply, Pi.single_apply]
  by_cases hij : i = finRotate n j
  · have h : j = (finRotate n).symm i := by
      exact (Equiv.apply_eq_iff_eq_symm_apply (finRotate n)).mp hij.symm
    have hsub : ((i - j : Fin n)).1 = 1 % n :=
      (sub_eq_oneMod_iff_eq_finRotate n i j).2 hij
    rw [if_pos hsub, if_pos h]
  · have h : j ≠ (finRotate n).symm i := by
      intro hj
      apply hij
      simpa using ((Equiv.eq_symm_apply (finRotate n)).mp hj).symm
    have hsub : ((i - j : Fin n)).1 ≠ 1 % n := by
      intro hsub
      exact hij ((sub_eq_oneMod_iff_eq_finRotate n i j).1 hsub)
    rw [if_neg hsub, if_neg h]

/-- Definition 5.13. Left multiplication by `Matrix.circulantRightShift` rotates a vector by
moving its last coordinate to the front. -/
theorem circulantRightShift_mulVec (n : ℕ) [NonAssocSemiring α] (x : Fin n → α) :
    circulantRightShift n *ᵥ x = x ∘ (finRotate n).symm := by
  ext i
  rw [mulVec_apply_eq_sum]
  have hsum :
      ∑ j : Fin n, circulantRightShift n i j * x j =
        ∑ j : Fin n, (if j = (finRotate n).symm i then 1 else 0) * x j := by
    refine Finset.sum_congr rfl ?_
    intro j _
    by_cases hj : j = (finRotate n).symm i
    · subst hj
      have hij : i = finRotate n ((finRotate n).symm i) := by
        simpa using ((finRotate n).apply_symm_apply i).symm
      have hterm :
          circulantRightShift n i ((finRotate n).symm i) * x ((finRotate n).symm i) =
            x ((finRotate n).symm i) := by
        rw [circulantRightShift, Matrix.circulant_apply]
        have hsub :
            ((i - (finRotate n).symm i : Fin n)).1 = 1 % n :=
          (sub_eq_oneMod_iff_eq_finRotate n i ((finRotate n).symm i)).2 hij
        rw [if_pos hsub]
        simp
      exact hterm.trans (by simp)
    · have hij : i ≠ finRotate n j := by
        intro hij
        apply hj
        exact (Equiv.apply_eq_iff_eq_symm_apply (finRotate n)).mp hij.symm
      have hterm : circulantRightShift n i j * x j = 0 := by
        rw [circulantRightShift, Matrix.circulant_apply]
        have hsub : ((i - j : Fin n)).1 ≠ 1 % n := by
          intro hsub
          exact hij ((sub_eq_oneMod_iff_eq_finRotate n i j).1 hsub)
        simp [hsub]
      calc
        circulantRightShift n i j * x j = 0 := hterm
        _ = (if j = (finRotate n).symm i then 1 else 0) * x j := by
              rw [if_neg hj]
              simp
  calc
    ∑ j : Fin n, circulantRightShift n i j * x j
        = ∑ j : Fin n, (if j = (finRotate n).symm i then 1 else 0) * x j := by
            exact hsum
    _ = x ((finRotate n).symm i) := by
          rw [Finset.sum_eq_single_of_mem ((finRotate n).symm i) (Finset.mem_univ _)]
          · simp
          · intro j _ hj
            rw [if_neg hj]
            simp
    _ = (x ∘ (finRotate n).symm) i := by
          rfl

/-- Pointwise form of `Matrix.circulantRightShift_mulVec`. -/
@[simp] theorem circulantRightShift_mulVec_apply (n : ℕ) [NonAssocSemiring α]
    (x : Fin n → α) (i : Fin n) :
    (circulantRightShift n *ᵥ x) i = x ((finRotate n).symm i) := by
  simpa using congr_fun (circulantRightShift_mulVec n x) i

end Matrix
