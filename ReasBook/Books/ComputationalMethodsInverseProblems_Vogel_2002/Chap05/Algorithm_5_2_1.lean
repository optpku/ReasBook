module

public import ComputationalMethodsInverseProblems_Vogel_2002.Chap05.Algorithm_5_2_1.Assembled
public import ComputationalMethodsInverseProblems_Vogel_2002.Chap05.Algorithm_5_2_1.CirculantExtension
public import ComputationalMethodsInverseProblems_Vogel_2002.Chap05.Prop_5_26

public section

noncomputable section

namespace Matrix

open scoped Complex.FiniteDimensional

/-!
Algorithm 5.2.1 records the source-facing block-circulant-extension procedure
for applying a BTTB matrix generated by a centered odd-grid kernel. The
primitive reusable owners are the odd-grid kernel interpretation
`Matrix.oddKernel`, the doubled-grid array assembly
`Matrix.blockCirculantExtension`, and the assembled doubled-grid Fourier solve
`Matrix.blockCirculantExtensionAssembledProduct`; this file keeps the
source-facing odd-kernel bridge and its correctness statement.
-/

/-- Algorithm 5.2.1. Given a centered odd-grid kernel `t` and an
`n_x × n_y` array `f`, assemble the doubled block-circulant-extension array
`cExt`, zero-pad `f`, compute the doubled-grid Fourier-domain product, and
extract the leading block. -/
@[expose] def blockCirculantExtensionProduct
    {n_x n_y : ℕ} [NeZero (2 * n_x)] [NeZero (2 * n_y)]
    (t : ℂ^[2 * n_x - 1, 2 * n_y - 1])
    (f : ℂ^[n_x, n_y]) :
    ℂ^[n_x, n_y] :=
  Matrix.blockCirculantExtensionAssembledProduct
    (Matrix.blockCirculantExtension t) f

/-- The defining assembled-array bridge for
`Matrix.blockCirculantExtensionProduct`. -/
theorem blockCirculantExtensionProduct_assembled
    {n_x n_y : ℕ} [NeZero (2 * n_x)] [NeZero (2 * n_y)]
    (t : ℂ^[2 * n_x - 1, 2 * n_y - 1])
    (f : ℂ^[n_x, n_y]) :
    Matrix.blockCirculantExtensionProduct t f =
      Matrix.blockCirculantExtensionAssembledProduct
        (Matrix.blockCirculantExtension t)
        f := rfl

/-- The defining doubled-grid Fourier formula for
`Matrix.blockCirculantExtensionProduct`. -/
theorem blockCirculantExtensionProduct_def
    {n_x n_y : ℕ} [NeZero (2 * n_x)] [NeZero (2 * n_y)]
    (t : ℂ^[2 * n_x - 1, 2 * n_y - 1])
    (f : ℂ^[n_x, n_y]) :
    Matrix.blockCirculantExtensionProduct t f =
      let cExt := Matrix.blockCirculantExtension t
      let fExt := Matrix.blockCirculantExtensionZeroPad f
      Matrix.blockCirculantExtensionLeadingBlock
        (Matrix.ifft2 (2 * n_x) (2 * n_y)
          (Matrix.hadamard
            (Matrix.fft2 (2 * n_x) (2 * n_y) cExt)
            (Matrix.fft2 (2 * n_x) (2 * n_y) fExt))) := by
  rw [Matrix.blockCirculantExtensionProduct_assembled]
  rfl

/-- The vector output attached to Algorithm 5.2.1, matching the final source
assignment `g = Matrix.vec g`. -/
abbrev blockCirculantExtensionProductVec
    {n_x n_y : ℕ} [NeZero (2 * n_x)] [NeZero (2 * n_y)]
    (t : ℂ^[2 * n_x - 1, 2 * n_y - 1])
    (f : ℂ^[n_x, n_y]) :
    Fin n_y × Fin n_x → ℂ :=
  Matrix.vec (Matrix.blockCirculantExtensionProduct t f)

/-- The defining formula for `Matrix.blockCirculantExtensionProductVec`. -/
theorem blockCirculantExtensionProductVec_def
    {n_x n_y : ℕ} [NeZero (2 * n_x)] [NeZero (2 * n_y)]
    (t : ℂ^[2 * n_x - 1, 2 * n_y - 1])
    (f : ℂ^[n_x, n_y]) :
    Matrix.blockCirculantExtensionProductVec t f =
      Matrix.vec (Matrix.blockCirculantExtensionProduct t f) := rfl

/-- Evaluating the vectorized Algorithm 5.2.1 output at `(j, i)` returns the
`(i, j)` entry of the extracted array. -/
theorem blockCirculantExtensionProductVec_apply
    {n_x n_y : ℕ} [NeZero (2 * n_x)] [NeZero (2 * n_y)]
    (t : ℂ^[2 * n_x - 1, 2 * n_y - 1])
    (f : ℂ^[n_x, n_y])
    (q : Fin n_y × Fin n_x) :
    Matrix.blockCirculantExtensionProductVec t f q =
      Matrix.blockCirculantExtensionProduct t f q.2 q.1 := by
  rcases q with ⟨j, i⟩
  rfl

/-- The source-kernel vectorization agrees with the assembled-array doubled-grid
bridge after assembling `t` via `Matrix.blockCirculantExtension`. -/
theorem blockCirculantExtensionProductVec_assembled
    {n_x n_y : ℕ} [NeZero (2 * n_x)] [NeZero (2 * n_y)]
    (t : ℂ^[2 * n_x - 1, 2 * n_y - 1])
    (f : ℂ^[n_x, n_y]) :
    Matrix.blockCirculantExtensionProductVec t f =
      Matrix.blockCirculantExtensionAssembledProductVec
        (Matrix.blockCirculantExtension t)
        f := rfl

/-- Helper for Algorithm 5.2.1: periodizing the doubled block-circulant
extension and evaluating it on a base-grid difference pair recovers the
odd-kernel entry dictated by the source array `t`. -/
lemma periodicBlockCirculantExtension_eq_oddKernel_on_baseDifferences
    {n_x n_y : ℕ} [NeZero (2 * n_x)] [NeZero (2 * n_y)]
    (t : ℂ^[2 * n_x - 1, 2 * n_y - 1])
    (i k : Fin n_x) (j l : Fin n_y) :
    Matrix.periodicExtensionOfNeZero (Matrix.blockCirculantExtension t)
      (((i : ℕ) : ℤ) - ((k : ℕ) : ℤ))
      (((j : ℕ) : ℤ) - ((l : ℕ) : ℤ)) =
      Matrix.oddKernel t
        (((i : ℕ) : ℤ) - ((k : ℕ) : ℤ))
        (((j : ℕ) : ℤ) - ((l : ℕ) : ℤ)) := by
  -- Route correction: compare both kernels by rewriting them to the same
  -- explicit source entry instead of proving an opaque equality of index encodings.
  calc
    Matrix.periodicExtensionOfNeZero (Matrix.blockCirculantExtension t)
        (((i : ℕ) : ℤ) - ((k : ℕ) : ℤ))
        (((j : ℕ) : ℤ) - ((l : ℕ) : ℤ)) =
        t ⟨i.1 + (n_x - 1 - k.1), by omega⟩
          ⟨j.1 + (n_y - 1 - l.1), by omega⟩ := by
            -- The support owner now exposes the periodized doubled-grid kernel
            -- directly in explicit source-entry form.
            rw [Matrix.periodicExtension_blockCirculantExtension_apply_baseDifferences]
    _ = Matrix.bttb n_x n_y (Matrix.oddKernel t) (j, i) (l, k) := by
          -- The odd-kernel BTTB owner evaluates to the same explicit entry.
          symm
          exact Matrix.bttb_oddKernel_apply t j l i k
    _ = Matrix.oddKernel t
          (((i : ℕ) : ℤ) - ((k : ℕ) : ℤ))
          (((j : ℕ) : ℤ) - ((l : ℕ) : ℤ)) := by
          rw [Matrix.bttb_apply]

/-- Helper for Algorithm 5.2.1: the doubled-grid Fourier product can be read as
the leading block of the periodic convolution with the periodized
block-circulant extension. -/
lemma blockCirculantExtensionProduct_eq_leadingBlock_periodicConvolution
    {n_x n_y : ℕ} [NeZero (2 * n_x)] [NeZero (2 * n_y)]
    (t : ℂ^[2 * n_x - 1, 2 * n_y - 1])
    (f : ℂ^[n_x, n_y]) :
    Matrix.blockCirculantExtensionProduct t f =
      Matrix.blockCirculantExtensionLeadingBlock
        (Matrix.discreteConvolution2D
          (Matrix.periodicExtensionOfNeZero (Matrix.blockCirculantExtension t))
          (Matrix.blockCirculantExtensionZeroPad f)) := by
  -- First rewrite the algorithm to the assembled doubled-grid Fourier formula.
  rw [Matrix.blockCirculantExtensionProduct_assembled]
  rw [Matrix.blockCirculantExtensionAssembledProduct_def]
  -- Then replace the doubled-grid inverse transform with the equivalent periodic convolution.
  simpa using congrArg Matrix.blockCirculantExtensionLeadingBlock
    (Matrix.periodicExtension_discreteConvolution2D_eq_ifft2_hadamard_fft2
      (2 * n_x) (2 * n_y) (Matrix.blockCirculantExtension t)
      (Matrix.blockCirculantExtensionZeroPad f)).symm

/-- Helper for Algorithm 5.2.1: evaluating the leading-block extraction amounts
to reading the doubled-grid array at the upper-left embedded indices. -/
lemma blockCirculantExtensionLeadingBlock_apply
    {n_x n_y : ℕ}
    (sExt : Matrix (Fin (2 * n_x)) (Fin (2 * n_y)) ℂ)
    (i : Fin n_x) (j : Fin n_y) :
    Matrix.blockCirculantExtensionLeadingBlock sExt i j =
      sExt
        ((finCongr (two_mul n_x)).symm (Fin.castAdd n_x i))
        ((finCongr (two_mul n_y)).symm (Fin.castAdd n_y j)) := by
  -- Expand the crop-and-reindex owner to expose the upper-left embedded entry.
  rfl

/-- Helper for Algorithm 5.2.1: the zero-padded doubled-grid array agrees with
`f` on the embedded upper-left source block. -/
lemma blockCirculantExtensionZeroPad_apply_embedded
    {n_x n_y : ℕ}
    (f : ℂ^[n_x, n_y])
    (i : Fin n_x) (j : Fin n_y) :
    Matrix.blockCirculantExtensionZeroPad f
        ((finCongr (two_mul n_x)).symm (Fin.castAdd n_x i))
        ((finCongr (two_mul n_y)).symm (Fin.castAdd n_y j)) =
      f i j := by
  -- The embedded upper-left indices stay inside the source support of the zero pad.
  simp [Matrix.blockCirculantExtensionZeroPad_apply]

/-- Helper for Algorithm 5.2.1: the doubled-grid zero pad vanishes outside the
upper-left source block. -/
lemma blockCirculantExtensionZeroPad_eq_zero_of_outsideUpperLeft
    {n_x n_y : ℕ}
    (f : ℂ^[n_x, n_y])
    (i : Fin (2 * n_x)) (j : Fin (2 * n_y))
    (hOutside : ¬ i.1 < n_x ∨ ¬ j.1 < n_y) :
    Matrix.blockCirculantExtensionZeroPad f i j = 0 := by
  -- Expand the zero pad and collapse the branch that lies outside the source support.
  rw [Matrix.blockCirculantExtensionZeroPad_apply]
  rcases hOutside with hix | hjy
  · simp [hix]
  · split_ifs with hix
    · simp
    · rfl

/-- Helper for Algorithm 5.2.1: summing any doubled-grid test function against
the zero-padded input only keeps the embedded upper-left source block. -/
lemma sum_mul_blockCirculantExtensionZeroPad_eq_sum_embedded
    {n_x n_y : ℕ}
    (φ : Fin (2 * n_y) × Fin (2 * n_x) → ℂ)
    (f : ℂ^[n_x, n_y]) :
    ∑ x : Fin (2 * n_y) × Fin (2 * n_x),
      φ x * Matrix.blockCirculantExtensionZeroPad f x.2 x.1 =
      ∑ x : Fin n_y × Fin n_x,
        φ (((finCongr (two_mul n_y)).symm (Fin.castAdd n_y x.1),
          (finCongr (two_mul n_x)).symm (Fin.castAdd n_x x.2))) * f x.2 x.1 := by
  let eY : Fin (2 * n_y) ≃ Fin n_y ⊕ Fin n_y :=
    (finCongr (two_mul n_y)).trans finSumFinEquiv.symm
  let eX : Fin (2 * n_x) ≃ Fin n_x ⊕ Fin n_x :=
    (finCongr (two_mul n_x)).trans finSumFinEquiv.symm
  let e :
      (Fin n_y ⊕ Fin n_y) × (Fin n_x ⊕ Fin n_x) ≃
        Fin (2 * n_y) × Fin (2 * n_x) :=
    Equiv.prodCongr eY.symm eX.symm
  calc
    ∑ x : Fin (2 * n_y) × Fin (2 * n_x),
        φ x * Matrix.blockCirculantExtensionZeroPad f x.2 x.1
        =
        ∑ x : (Fin n_y ⊕ Fin n_y) × (Fin n_x ⊕ Fin n_x),
          φ (e x) * Matrix.blockCirculantExtensionZeroPad f (e x).2 (e x).1 := by
          symm
          exact Fintype.sum_equiv e
            (fun x : (Fin n_y ⊕ Fin n_y) × (Fin n_x ⊕ Fin n_x) ↦
              φ (e x) * Matrix.blockCirculantExtensionZeroPad f (e x).2 (e x).1)
            (fun x : Fin (2 * n_y) × Fin (2 * n_x) ↦
              φ x * Matrix.blockCirculantExtensionZeroPad f x.2 x.1)
            (fun x ↦ rfl)
    _ =
        ∑ j : Fin n_y, ∑ i : Fin n_x,
          φ (e (Sum.inl j, Sum.inl i)) * f i j := by
          rw [Fintype.sum_prod_type]
          simp [Fintype.sum_sum_type, e, eX, eY, Matrix.blockCirculantExtensionZeroPad_apply]
    _ =
        ∑ x : Fin n_y × Fin n_x,
          φ (((finCongr (two_mul n_y)).symm (Fin.castAdd n_y x.1),
            (finCongr (two_mul n_x)).symm (Fin.castAdd n_x x.2))) * f x.2 x.1 := by
          rw [← Fintype.sum_prod_type']
          refine Finset.sum_congr rfl ?_
          intro x hx
          rcases x with ⟨j, i⟩
          simp [e, eX, eY]

/-- Helper for Algorithm 5.2.1: the doubled-grid HTTB kernel restricted to the
embedded source block agrees with the original odd-kernel HTTB entry. -/
lemma embeddedPeriodicBlockCirculantEntry_eq_oddKernel
    {n_x n_y : ℕ} [NeZero (2 * n_x)] [NeZero (2 * n_y)]
    (t : ℂ^[2 * n_x - 1, 2 * n_y - 1])
    (i k : Fin n_x) (j l : Fin n_y) :
    Matrix.httb (2 * n_x) (2 * n_y)
        (Matrix.periodicExtensionOfNeZero (Matrix.blockCirculantExtension t))
        (((finCongr (two_mul n_y)).symm (Fin.castAdd n_y j),
          (finCongr (two_mul n_x)).symm (Fin.castAdd n_x i)))
        (((finCongr (two_mul n_y)).symm (Fin.castAdd n_y l),
          (finCongr (two_mul n_x)).symm (Fin.castAdd n_x k))) =
      Matrix.httb n_x n_y (Matrix.oddKernel t) (j, i) (l, k) := by
  -- Normalize both HTTB entries to the same base-grid difference pair.
  rw [Matrix.httb_apply, Matrix.httb_apply]
  simpa using periodicBlockCirculantExtension_eq_oddKernel_on_baseDifferences t i k j l

/-- Helper for Algorithm 5.2.1: cropping the doubled periodic convolution of
the periodized block-circulant extension against the zero-padded input recovers
the original odd-kernel convolution on the source grid. -/
lemma leadingBlock_discreteConvolution2D_blockCirculantExtension_eq_oddKernel
    {n_x n_y : ℕ} [NeZero (2 * n_x)] [NeZero (2 * n_y)]
    (t : ℂ^[2 * n_x - 1, 2 * n_y - 1])
    (f : ℂ^[n_x, n_y]) :
    Matrix.blockCirculantExtensionLeadingBlock
        (Matrix.discreteConvolution2D
          (Matrix.periodicExtensionOfNeZero (Matrix.blockCirculantExtension t))
          (Matrix.blockCirculantExtensionZeroPad f)) =
      Matrix.discreteConvolution2D (Matrix.oddKernel t) f := by
  -- First compare the cropped doubled-grid convolution and the source-grid
  -- convolution entrywise.
  ext i j
  -- Route correction: restrict the doubled-grid sum once using the zero-pad support lemma,
  -- then rewrite the surviving embedded kernel entries to the odd-kernel HTTB entries.
  rw [Matrix.blockCirculantExtensionLeadingBlock_apply]
  rw [Matrix.discreteConvolution2D_def, Matrix.discreteConvolution2D_def, Matrix.of_apply, Matrix.of_apply]
  rw [Matrix.mulVec_apply_eq_sum, Matrix.mulVec_apply_eq_sum]
  let target :
      Fin (2 * n_y) × Fin (2 * n_x) :=
    (((finCongr (two_mul n_y)).symm (Fin.castAdd n_y j)),
      ((finCongr (two_mul n_x)).symm (Fin.castAdd n_x i)))
  change
    ∑ x : Fin (2 * n_y) × Fin (2 * n_x),
        Matrix.httb (2 * n_x) (2 * n_y)
            (Matrix.periodicExtensionOfNeZero (Matrix.blockCirculantExtension t))
            target x *
          Matrix.blockCirculantExtensionZeroPad f x.2 x.1 =
      ∑ x : Fin n_y × Fin n_x,
        Matrix.httb n_x n_y (Matrix.oddKernel t) (j, i) x * f x.2 x.1
  have hRestrict :=
    Matrix.sum_mul_blockCirculantExtensionZeroPad_eq_sum_embedded
      (φ := fun x : Fin (2 * n_y) × Fin (2 * n_x) ↦
        Matrix.httb (2 * n_x) (2 * n_y)
          (Matrix.periodicExtensionOfNeZero (Matrix.blockCirculantExtension t))
          target x)
      f
  have hRestrict' :
      ∑ x : Fin (2 * n_y) × Fin (2 * n_x),
          Matrix.httb (2 * n_x) (2 * n_y)
              (Matrix.periodicExtensionOfNeZero (Matrix.blockCirculantExtension t))
              target x *
            Matrix.blockCirculantExtensionZeroPad f x.2 x.1 =
        ∑ x : Fin n_y × Fin n_x,
          Matrix.httb (2 * n_x) (2 * n_y)
              (Matrix.periodicExtensionOfNeZero (Matrix.blockCirculantExtension t))
              target
              (((finCongr (two_mul n_y)).symm (Fin.castAdd n_y x.1),
                (finCongr (two_mul n_x)).symm (Fin.castAdd n_x x.2))) *
            f x.2 x.1 := by
    simpa [target] using hRestrict
  rw [hRestrict']
  dsimp [target]
  refine Finset.sum_congr rfl ?_
  intro x hx
  rcases x with ⟨l, k⟩
  -- Normalize the surviving embedded kernel factor to the odd-kernel HTTB entry.
  change
    Matrix.httb (2 * n_x) (2 * n_y)
        (Matrix.periodicExtensionOfNeZero (Matrix.blockCirculantExtension t))
        (((finCongr (two_mul n_y)).symm (Fin.castAdd n_y j),
          (finCongr (two_mul n_x)).symm (Fin.castAdd n_x i)))
        (((finCongr (two_mul n_y)).symm (Fin.castAdd n_y l),
          (finCongr (two_mul n_x)).symm (Fin.castAdd n_x k))) *
      f k l =
    Matrix.httb n_x n_y (Matrix.oddKernel t) (j, i) (l, k) * f k l
  rw [Matrix.embeddedPeriodicBlockCirculantEntry_eq_oddKernel]

/-- Helper for Algorithm 5.2.1: the doubled-grid FFT algorithm computes the
same source-grid array as convolving `f` with the centered odd kernel
`Matrix.oddKernel t`. -/
lemma blockCirculantExtensionProduct_eq_discreteConvolution2D_oddKernel
    {n_x n_y : ℕ} [NeZero (2 * n_x)] [NeZero (2 * n_y)]
    (t : ℂ^[2 * n_x - 1, 2 * n_y - 1])
    (f : ℂ^[n_x, n_y]) :
    Matrix.blockCirculantExtensionProduct t f =
      Matrix.discreteConvolution2D (Matrix.oddKernel t) f := by
  -- Assemble the Fourier-to-convolution rewrite with the pending cropped-convolution bridge.
  rw [blockCirculantExtensionProduct_eq_leadingBlock_periodicConvolution]
  rw [leadingBlock_discreteConvolution2D_blockCirculantExtension_eq_oddKernel]

/-- Algorithm 5.2.1 correctness statement: the doubled-grid FFT computation
recovers the BTTB product generated by the centered kernel `Matrix.oddKernel t`.
This is the source-facing bridge from the odd-grid assembly `(5.61)`-`(5.63)`
to the canonical BTTB owner. -/
theorem blockCirculantExtensionProduct_spec
    {n_x n_y : ℕ} [NeZero (2 * n_x)] [NeZero (2 * n_y)]
    (t : ℂ^[2 * n_x - 1, 2 * n_y - 1])
    (f : ℂ^[n_x, n_y]) :
    Matrix.blockCirculantExtensionProduct t f =
      Matrix.of fun i j ↦
        (Matrix.bttb n_x n_y (Matrix.oddKernel t) *ᵥ Matrix.vec f) (j, i) := by
  -- Route correction: once the source-grid convolution bridge is in place, the published BTTB
  -- statement is the canonical owner theorem for discrete convolution.
  rw [blockCirculantExtensionProduct_eq_discreteConvolution2D_oddKernel]
  simpa using Matrix.discreteConvolution2D_eq_of_bttb_mulVec (Matrix.oddKernel t) f

/-- Vectorizing the Algorithm 5.2.1 output recovers the canonical BTTB
matrix-vector action generated by the odd-grid kernel `t`. -/
theorem blockCirculantExtensionProductVec_spec
    {n_x n_y : ℕ} [NeZero (2 * n_x)] [NeZero (2 * n_y)]
    (t : ℂ^[2 * n_x - 1, 2 * n_y - 1])
    (f : ℂ^[n_x, n_y]) :
    Matrix.blockCirculantExtensionProductVec t f =
      Matrix.bttb n_x n_y (Matrix.oddKernel t) *ᵥ Matrix.vec f := by
  simpa [Matrix.blockCirculantExtensionProductVec] using
    (congrArg Matrix.vec (Matrix.blockCirculantExtensionProduct_spec t f)).trans
      (Matrix.vec_of_swap (Matrix.bttb n_x n_y (Matrix.oddKernel t) *ᵥ Matrix.vec f))

end Matrix
