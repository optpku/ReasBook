module

public import ComputationalMethodsInverseProblems_Vogel_2002.Chap05.Definition_5_1_1
public import ComputationalMethodsInverseProblems_Vogel_2002.Chap05.Definition_5_13
public import ComputationalMethodsInverseProblems_Vogel_2002.Chap05.Prop_5_6.Diagonalization

public section

open scoped Matrix

noncomputable section

namespace Matrix

/-- Helper for Lemma 5.15: `circulantRightShift n` is the circulant matrix generated by its first
column, so Proposition 5.6 applies directly to that column. -/
lemma circulantRightShift_eq_circulant_col_zero (n : ℕ) [NeZero n] :
    circulant ((circulantRightShift (α := ℂ) n).col 0) = circulantRightShift (α := ℂ) n := by
  -- Recover the generator from column zero, then apply `circulant` to that recovered vector.
  simpa [Matrix.circulantRightShift] using
    congrArg Matrix.circulant
      (Matrix.circulant_col_zero
        (c := fun i : Fin n ↦ if i.1 = 1 % n then (1 : ℂ) else 0))

/-- Helper for Lemma 5.15: the first column of `circulantRightShift n` is the basis vector at
index `1 : Fin n`. -/
lemma circulantRightShift_col_zero_eq_single (n : ℕ) [NeZero n] :
    ((circulantRightShift n).col 0 : Fin n → ℂ) = Pi.single (1 : Fin n) (1 : ℂ) := by
  -- Convert column zero back to the circulant generator and compare it to the standard basis
  -- vector entrywise.
  have hcol :
      ((circulantRightShift n).col 0 : Fin n → ℂ) =
        fun i : Fin n ↦ if i.1 = 1 % n then (1 : ℂ) else 0 := by
    simpa [Matrix.circulantRightShift] using
      (Matrix.circulant_col_zero
        (c := fun i : Fin n ↦ if i.1 = 1 % n then (1 : ℂ) else 0))
  ext i
  rw [hcol]
  by_cases hi : i = (1 : Fin n)
  · subst hi
    simp
  · have hval : i.1 ≠ 1 % n := by
      intro h
      apply hi
      exact Fin.ext h
    simp [hi, hval]

/-- Helper for Lemma 5.15: column `1` of the normalized Fourier matrix is the normalized Fourier
spectrum. -/
lemma fourierMatrix_col_one (n : ℕ) [NeZero n] :
    ((fourierMatrix n).col (1 : Fin n) : Fin n → ℂ) =
      (1 / Real.sqrt n : ℂ) • fourierSpectrum n := by
  -- Split off the singleton case `n = 1`; once `n ≥ 2`, the `Fin` index `1` has value `1`
  -- literally and the entrywise formula simplifies directly.
  cases n with
  | zero =>
      cases (NeZero.ne (n := 0) rfl)
  | succ m =>
      cases m with
      | zero =>
          ext i
          have hi : i = 0 := Fin.eq_zero i
          subst hi
          simp [Matrix.col_apply, Matrix.fourierMatrix_apply, Matrix.fourierSpectrum_apply]
      | succ k =>
          ext i
          simp [Matrix.col_apply, Matrix.fourierMatrix_apply, Matrix.fourierSpectrum_apply,
            div_eq_mul_inv, mul_comm]

/-- The first column of `circulantRightShift n` is the circulant generator at `1 % n`, so its
normalized Fourier transform is `(1 / Real.sqrt n : ℂ) • fourierSpectrum n`. This is the bridge
showing that Lemma 5.15 is the right-shift specialization of the general circulant Fourier
diagonalization. -/
theorem dft_circulantRightShift_col_zero (n : ℕ) [NeZero n] :
    dft n ((circulantRightShift n).col 0) = (1 / Real.sqrt n : ℂ) • fourierSpectrum n := by
  -- Replace the shift generator by the standard basis vector, then use `mulVec_single_one` to
  -- identify its DFT with the corresponding Fourier column.
  rw [Matrix.dft, Matrix.mulVecLin_apply, circulantRightShift_col_zero_eq_single,
    Matrix.mulVec_single_one, fourierMatrix_col_one]

/-- Lemma 5.15. The Chapter 5 circulant right shift matrix is diagonalized by the normalized
Fourier matrix, with diagonal entries `1, w, …, w^(n - 1)` encoded by
`fourierSpectrum n`. -/
theorem circulantRightShift_eq_fourierDiagonalization (n : ℕ) [NeZero n] :
    circulantRightShift n = (fourierMatrix n)ᴴ * diagonal (fourierSpectrum n) * fourierMatrix n :=
  by
    -- Route correction: instead of reproducing the geometric-sum argument entrywise, instantiate
    -- the general circulant diagonalization theorem at the shift's first column.
    have hdiag :=
      smul_circulant_eq_fourierDiagonalization n ((circulantRightShift n).col 0)
    rw [circulantRightShift_eq_circulant_col_zero, dft_circulantRightShift_col_zero] at hdiag
    -- Rewrite the right-hand side so the same scalar multiplies both sides, then cancel it.
    have hscale : (1 / Real.sqrt n : ℂ) ≠ 0 := by
      have hn : (0 : ℝ) < n := by
        exact_mod_cast Nat.pos_of_neZero n
      have hsqrt : Real.sqrt (n : ℝ) ≠ 0 := Real.sqrt_ne_zero'.2 hn
      exact one_div_ne_zero (by exact_mod_cast hsqrt)
    exact (smul_right_injective _ hscale) <| by
      simpa [Matrix.diagonal_smul, mul_assoc, smul_mul_assoc, mul_smul_comm] using hdiag

end Matrix
