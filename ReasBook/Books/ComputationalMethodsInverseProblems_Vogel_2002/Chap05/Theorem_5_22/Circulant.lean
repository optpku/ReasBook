module

public import ComputationalMethodsInverseProblems_Vogel_2002.Chap05.Prop_5_20
public import Mathlib.LinearAlgebra.Matrix.Circulant

public section

noncomputable section

open scoped Matrix.Norms.Frobenius

namespace Matrix

/-- The linear map sending a real vector of coefficients to its circulant matrix. -/
def circulantLinear (n : ℕ) :
    (Fin n → ℝ) →ₗ[ℝ] Matrix (Fin n) (Fin n) ℝ where
  toFun := Matrix.circulant
  map_add' := Matrix.circulant_add
  map_smul' := Matrix.circulant_smul

/-- The `ℝ`-subspace of real circulant `n × n` matrices. -/
def circulantSubmodule (n : ℕ) :
    Submodule ℝ (Matrix (Fin n) (Fin n) ℝ) :=
  (circulantLinear n).range

/-- A real matrix belongs to `Matrix.circulantSubmodule n` exactly when it is generated by some
vector via `Matrix.circulant`. -/
theorem mem_circulantSubmodule_iff {n : ℕ} {C : Matrix (Fin n) (Fin n) ℝ} :
    C ∈ circulantSubmodule n ↔ ∃ c : Fin n → ℝ, Matrix.circulant c = C := by
  rfl

/-- `Matrix.bestCirculantApproximation A` lies in the circulant submodule. -/
theorem bestCirculantApproximation_mem_circulantSubmodule {n : ℕ}
    (A : Matrix (Fin n) (Fin n) ℝ) :
    bestCirculantApproximation A ∈ circulantSubmodule n := by
  refine ⟨bestCirculantApproximationCoeffs A, ?_⟩
  rfl

end Matrix
