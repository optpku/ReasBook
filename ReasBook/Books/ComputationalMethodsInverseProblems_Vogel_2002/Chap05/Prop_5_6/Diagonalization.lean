open scoped Matrix BigOperators

noncomputable section

namespace Matrix

/-- Helper for Proposition 5.6: the Chapter 5 Fourier matrix also satisfies
`Matrix.fourierMatrix n * (Matrix.fourierMatrix n)ᴴ = 1`. -/
lemma fourierMatrix_mul_conjTranspose
    (n : ℕ) [NeZero n] :
    Matrix.fourierMatrix n * (Matrix.fourierMatrix n)ᴴ = 1 :=
  Matrix.mem_unitaryGroup_iff.mp <| Matrix.fourierMatrix_mem_unitaryGroup n

/-- Helper for Proposition 5.6: left multiplication by the complex Chapter 5 right-shift matrix
sends the `k`th standard basis vector to the rotated basis vector at `finRotate n k`. -/
lemma circulantRightShift_mulVec_single
    {n : ℕ} [NeZero n] (k : Fin n) :
    Matrix.circulantRightShift (α := ℂ) n *ᵥ Pi.single k (1 : ℂ) =
      Pi.single (finRotate n k) (1 : ℂ) := by
  ext i
  have hi :=
    congrFun (Matrix.circulantRightShift_mulVec (n := n) (Pi.single k (1 : ℂ))) i
  by_cases h : i = k + 1
  · have hsub : i - 1 = k := by
      simpa using (sub_eq_iff_eq_add.mpr h)
    simpa [Function.comp_apply, Pi.single_apply, finRotate_symm_apply, h, hsub, add_comm] using hi
  · have hsub : i - 1 ≠ k := by
      intro hk
      apply h
      simpa [add_comm] using (sub_eq_iff_eq_add.mp hk)
    simpa [Function.comp_apply, Pi.single_apply, finRotate_symm_apply, h, hsub, add_comm] using hi

/-- Helper for Proposition 5.6: the `m`th power of the Chapter 5 right-shift matrix sends the
`k`th standard basis vector to the basis vector indexed by `((finRotate n)^[m]) k`. -/
lemma rightShiftPow_mulVec_single
    {n : ℕ} [NeZero n] (m : ℕ) (k : Fin n) :
    (Matrix.circulantRightShift (α := ℂ) n ^ m) *ᵥ Pi.single k (1 : ℂ) =
      Pi.single (((finRotate n)^[m]) k) (1 : ℂ) := by
  induction m generalizing k with
  | zero =>
      -- At power zero, the identity matrix fixes every basis vector.
      rw [pow_zero, Matrix.mulVec_single_one]
      ext i
      simp [Matrix.col, Matrix.one_apply, Pi.single_apply]
  | succ m ih =>
      -- One more factor of the shift advances the basis index by one more rotation.
      rw [pow_succ', ← Matrix.mulVec_mulVec, ih]
      rw [Function.iterate_succ_apply']
      simpa using circulantRightShift_mulVec_single (n := n) (((finRotate n)^[m]) k)

/-- Helper for Proposition 5.6: the circulant basis matrix generated by `Pi.single j 1` has a
single `1` in each column, located at the row `k + j`. -/
lemma circulantSingle_apply
    {n : ℕ} [NeZero n] (j i k : Fin n) :
    Matrix.circulant (Pi.single j (1 : ℂ)) i k = if i = k + j then 1 else 0 := by
  rw [Matrix.circulant_apply, Pi.single_apply]
  by_cases h : i = k + j
  · have hsub : i - k = j := by
      simpa [add_comm] using (sub_eq_iff_eq_add.mpr (by simpa [add_comm] using h : i = j + k))
    simp [h, hsub]
  · have hsub : i - k ≠ j := by
      intro hk
      apply h
      simpa [add_comm] using (sub_eq_iff_eq_add.mp hk)
    simp [h, hsub]

/-- Helper for Proposition 5.6: the `k`th column of the circulant basis matrix generated by
`Pi.single j 1` is the standard basis vector at `k + j`. -/
lemma circulantSingle_mulVec_single
    {n : ℕ} [NeZero n] (j k : Fin n) :
    Matrix.circulant (Pi.single j (1 : ℂ)) *ᵥ Pi.single k (1 : ℂ) =
      Pi.single (k + j) (1 : ℂ) := by
  -- Expanding the `k`th column of the circulant basis matrix exposes the translated support.
  rw [Matrix.mulVec_single_one]
  ext i
  simpa [Matrix.col, Pi.single_apply] using circulantSingle_apply (j := j) i k

/-- Helper for Proposition 5.6: the `j`th power of the complex Chapter 5 right-shift matrix is
the complex circulant basis matrix generated by `Pi.single j 1`. -/
lemma circulantRightShift_pow_eq_circulant_single
    {n : ℕ} [NeZero n] (j : Fin n) :
    Matrix.circulantRightShift (α := ℂ) n ^ (j : ℕ) = Matrix.circulant (Pi.single j (1 : ℂ)) := by
  -- Compare both matrices on the standard basis vectors, where both act by the same cyclic shift.
  apply Matrix.ext_of_mulVec_single
  intro k
  rw [rightShiftPow_mulVec_single, circulantSingle_mulVec_single]
  have hcycle : ((finRotate n)^[j.1]) k = k + j := by
    simpa using congrFun (finCycle_eq_finRotate_iterate (k := j)).symm k
  simpa [hcycle]

/-- Helper for Proposition 5.6: a complex circulant matrix is the finite linear combination of
the basis matrices `Matrix.circulant (Pi.single j 1)` with its generating coefficients. -/
lemma sum_smul_circulant_single_eq_circulant
    {n : ℕ} [NeZero n] (c : Fin n → ℂ) :
    ∑ j : Fin n, c j • Matrix.circulant (Pi.single j (1 : ℂ)) = Matrix.circulant c := by
  -- Evaluate entrywise and keep only the unique basis matrix supported at `j = i - k`.
  ext i k
  let f : Fin n → ℂ := fun j ↦ c j * Matrix.circulant (Pi.single j (1 : ℂ)) i k
  rw [Matrix.sum_apply, Matrix.circulant_apply]
  change Finset.univ.sum f = c (i - k)
  rw [Fintype.sum_eq_single (i - k)]
  · simp [f, circulantSingle_apply]
  · intro j hj
    have hneq : i ≠ k + j := by
      intro h
      apply hj
      exact
        (sub_eq_iff_eq_add.mpr (by simpa [add_comm] using h : i = j + k)).symm
    dsimp [f]
    simp [Pi.single_apply, hj]

/-- Helper for Proposition 5.6: a complex circulant matrix is the finite linear combination of
the complex powers of `Matrix.circulantRightShift n` with its generating coefficients. -/
lemma circulant_eq_sum_rightShift_pow
    {n : ℕ} [NeZero n] (c : Fin n → ℂ) :
    Matrix.circulant c =
      ∑ j : Fin n, c j • ((Matrix.circulantRightShift (α := ℂ) n) ^ (j : ℕ)) := by
  -- Rewrite the right-shift powers into the complex circulant basis and reassemble the basis sum.
  symm
  calc
    ∑ j : Fin n, c j • ((Matrix.circulantRightShift (α := ℂ) n) ^ (j : ℕ))
        = ∑ j : Fin n, c j • Matrix.circulant (Pi.single j (1 : ℂ)) := by
            refine Finset.sum_congr rfl ?_
            intro j _
            rw [circulantRightShift_pow_eq_circulant_single]
    _ = Matrix.circulant c := sum_smul_circulant_single_eq_circulant c

/-- Helper for Proposition 5.6: `Matrix.fourierRoot n` is an `n`th root of unity. -/
lemma fourierRoot_pow_card
    (n : ℕ) [NeZero n] :
    Matrix.fourierRoot n ^ n = 1 := by
  rw [Matrix.fourierRoot_eq_stdAddChar, ← AddChar.map_nsmul_eq_pow]
  simp [nsmul_eq_mul]

/-- Helper for Proposition 5.6: the Chapter 5 right-shift matrix is diagonalized by the normalized
Fourier matrix, with diagonal entries `Matrix.fourierSpectrum n`. -/
lemma circulantRightShift_eq_fourierDiagonalization
    (n : ℕ) [NeZero n] :
    Matrix.circulantRightShift (α := ℂ) n =
      (fourierMatrix n)ᴴ *
        diagonal (fun i : Fin n ↦ Matrix.fourierRoot n ^ (i : ℕ)) *
        fourierMatrix n := by
  -- Conjugating the right shift by the Fourier matrix reduces it to pointwise multiplication by
  -- the Fourier spectrum.
  have hmul :
      fourierMatrix n * Matrix.circulantRightShift (α := ℂ) n =
        diagonal (fun i : Fin n ↦ Matrix.fourierRoot n ^ (i : ℕ)) * fourierMatrix n := by
    obtain ⟨m, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (NeZero.ne n)
    ext i j
    rw [Matrix.mul_apply, Matrix.diagonal_mul]
    have hsum :
        ∑ x : Fin (m + 1),
          fourierMatrix (m + 1) i x * Matrix.circulantRightShift (α := ℂ) (m + 1) x j =
            fourierMatrix (m + 1) i (finRotate (m + 1) j) := by
      rw [Fintype.sum_eq_single (finRotate (m + 1) j)]
      · have hone :
            Matrix.circulantRightShift (α := ℂ) (m + 1) (finRotate (m + 1) j) j = (1 : ℂ) := by
              have hfin : (finRotate (m + 1) j - j : Fin (m + 1)) = (1 : Fin (m + 1)) := by
                apply sub_eq_iff_eq_add.mpr
                simpa [finRotate_apply, add_comm]
              rw [Matrix.circulantRightShift, Matrix.circulant_apply, hfin]
              simp
        calc
          fourierMatrix (m + 1) i (finRotate (m + 1) j) *
              Matrix.circulantRightShift (α := ℂ) (m + 1) (finRotate (m + 1) j) j
              =
              fourierMatrix (m + 1) i (finRotate (m + 1) j) * 1 := by rw [hone]
          _ = fourierMatrix (m + 1) i (finRotate (m + 1) j) := by simp
      · intro x hx
        have hzero : Matrix.circulantRightShift (α := ℂ) (m + 1) x j = (0 : ℂ) := by
          have hsub : (x - j : Fin (m + 1)) ≠ (1 : Fin (m + 1)) := by
            intro hx1
            apply hx
            simpa [finRotate_apply, add_comm] using (sub_eq_iff_eq_add.mp hx1)
          have hsubval : ((x - j : Fin (m + 1)) : ℕ) ≠ 1 % (m + 1) := by
            intro hxval
            apply hsub
            apply Fin.ext
            simpa using hxval
          rw [Matrix.circulantRightShift, Matrix.circulant_apply]
          simp [hsubval]
        simp [hzero]
    rw [hsum]
    by_cases hj : j = Fin.last m
    · subst hj
      have hroot : Matrix.fourierRoot (m + 1) ^ (m + 1) = 1 := fourierRoot_pow_card (m + 1)
      have hrooti :
          Matrix.fourierRoot (m + 1) ^ ((i : ℕ) * (m + 1)) = 1 := by
        rw [Nat.mul_comm, pow_mul, hroot, one_pow]
      have hexp : (i : ℕ) + (i : ℕ) * m = (i : ℕ) * (m + 1) := by ring
      calc
        fourierMatrix (m + 1) i (finRotate (m + 1) (Fin.last m))
            = fourierMatrix (m + 1) i 0 := by simp
        _ = Matrix.fourierRoot (m + 1) ^ ((i : ℕ) * (m + 1)) / Real.sqrt (m + 1) := by
              simp [Matrix.fourierMatrix_apply, hrooti]
        _ = Matrix.fourierRoot (m + 1) ^ (i : ℕ) * fourierMatrix (m + 1) i (Fin.last m) := by
              rw [Matrix.fourierMatrix_apply, Fin.val_last]
              simp only [div_eq_mul_inv]
              rw [← hexp, pow_add]
              simpa [mul_assoc]
    · have hrotate : (finRotate (m + 1) j : ℕ) = j + 1 := coe_finRotate_of_ne_last hj
      have hexp : (i : ℕ) * (j + 1) = (i : ℕ) * j + i := by ring
      calc
        fourierMatrix (m + 1) i (finRotate (m + 1) j)
            = Matrix.fourierRoot (m + 1) ^ ((i : ℕ) * ↑(finRotate (m + 1) j)) / Real.sqrt (m + 1) := by
              simpa using Matrix.fourierMatrix_apply (m + 1) i (finRotate (m + 1) j)
        _ = Matrix.fourierRoot (m + 1) ^ ((i : ℕ) * (j + 1)) / Real.sqrt (m + 1) := by
              rw [hrotate]
        _ = Matrix.fourierRoot (m + 1) ^ (i : ℕ) * fourierMatrix (m + 1) i j := by
              rw [Matrix.fourierMatrix_apply]
              simp only [div_eq_mul_inv]
              rw [hexp, pow_add]
              ring_nf
              simpa using rfl
  calc
    Matrix.circulantRightShift (α := ℂ) n
        = (1 : Matrix (Fin n) (Fin n) ℂ) * Matrix.circulantRightShift (α := ℂ) n := by simp
    _ = ((fourierMatrix n)ᴴ * fourierMatrix n) * Matrix.circulantRightShift (α := ℂ) n := by
          rw [Matrix.fourierMatrix_conjTranspose_mul]
    _ = (fourierMatrix n)ᴴ * (fourierMatrix n * Matrix.circulantRightShift (α := ℂ) n) := by
          simp [Matrix.mul_assoc]
    _ =
        (fourierMatrix n)ᴴ *
          (diagonal (fun i : Fin n ↦ Matrix.fourierRoot n ^ (i : ℕ)) * fourierMatrix n) := by
          rw [hmul]
    _ =
        (fourierMatrix n)ᴴ *
          diagonal (fun i : Fin n ↦ Matrix.fourierRoot n ^ (i : ℕ)) *
          fourierMatrix n := by
          simp [Matrix.mul_assoc]

/-- Helper for Proposition 5.6: every power of the Chapter 5 right-shift matrix is diagonalized by
the normalized Fourier matrix, with diagonal entries `Matrix.fourierSpectrum n ^ m`. -/
lemma rightShiftPow_eq_fourierDiagonalization
    (n : ℕ) [NeZero n] (m : ℕ) :
    (Matrix.circulantRightShift (α := ℂ) n ^ m) =
      (fourierMatrix n)ᴴ *
        diagonal (fun i : Fin n ↦ (Matrix.fourierRoot n ^ (i : ℕ)) ^ m) *
        fourierMatrix n := by
  induction m with
  | zero =>
      -- At exponent zero, both sides are the identity matrix.
      simp [Matrix.mul_assoc, Matrix.fourierMatrix_conjTranspose_mul]
  | succ m ih =>
      -- Insert the diagonal form of one more shift and collapse the unitary middle factor.
      calc
        Matrix.circulantRightShift (α := ℂ) n ^ (m + 1)
            = Matrix.circulantRightShift (α := ℂ) n ^ m *
                Matrix.circulantRightShift (α := ℂ) n := by
                  rw [pow_succ]
        _ =
            ((fourierMatrix n)ᴴ * diagonal (fun i : Fin n ↦ (Matrix.fourierRoot n ^ (i : ℕ)) ^ m) *
                fourierMatrix n) *
              ((fourierMatrix n)ᴴ *
                diagonal (fun i : Fin n ↦ Matrix.fourierRoot n ^ (i : ℕ)) *
                fourierMatrix n) := by
                rw [ih, circulantRightShift_eq_fourierDiagonalization]
        _ =
            (fourierMatrix n)ᴴ *
              diagonal (fun i : Fin n ↦ (Matrix.fourierRoot n ^ (i : ℕ)) ^ m) *
                (fourierMatrix n * (fourierMatrix n)ᴴ) *
                  diagonal (fun i : Fin n ↦ Matrix.fourierRoot n ^ (i : ℕ)) * fourierMatrix n := by
                    simp [Matrix.mul_assoc]
        _ =
            (fourierMatrix n)ᴴ *
              diagonal (fun i : Fin n ↦ (Matrix.fourierRoot n ^ (i : ℕ)) ^ m) *
                diagonal (fun i : Fin n ↦ Matrix.fourierRoot n ^ (i : ℕ)) * fourierMatrix n := by
                  rw [fourierMatrix_mul_conjTranspose]
                  simp [Matrix.mul_assoc]
        _ =
            (fourierMatrix n)ᴴ *
              diagonal (fun i : Fin n ↦ (Matrix.fourierRoot n ^ (i : ℕ)) ^ (m + 1)) * fourierMatrix n := by
                calc
                  (fourierMatrix n)ᴴ *
                      diagonal (fun i : Fin n ↦ (Matrix.fourierRoot n ^ (i : ℕ)) ^ m) *
                        diagonal (fun i : Fin n ↦ Matrix.fourierRoot n ^ (i : ℕ)) * fourierMatrix n
                      =
                      (fourierMatrix n)ᴴ *
                        (diagonal (fun i : Fin n ↦ (Matrix.fourierRoot n ^ (i : ℕ)) ^ m) *
                          diagonal (fun i : Fin n ↦ Matrix.fourierRoot n ^ (i : ℕ))) * fourierMatrix n := by
                            simp [Matrix.mul_assoc]
                  _ =
                      (fourierMatrix n)ᴴ *
                        diagonal (fun i : Fin n ↦ (Matrix.fourierRoot n ^ (i : ℕ)) ^ (m + 1)) *
                        fourierMatrix n := by
                            rw [Matrix.diagonal_mul_diagonal]
                            simp [Matrix.mul_assoc, pow_succ]

/-- Proposition 5.6 core bridge. The normalized circulant operator generated by `t`
is diagonalized by the Chapter 5 normalized Fourier matrix, with diagonal entries
`Matrix.dft n t`. -/
theorem smul_circulant_eq_fourierDiagonalization
    (n : ℕ) [NeZero n] (t : Fin n → ℂ) :
    ((1 / Real.sqrt n : ℂ) • circulant t) =
      (fourierMatrix n)ᴴ * diagonal (dft n t) * fourierMatrix n := by
  -- Expand the circulant matrix in the right-shift basis, diagonalize each basis element, and
  -- reassemble the diagonal entries into the DFT of the generating vector.
  calc
    ((1 / Real.sqrt n : ℂ) • circulant t)
        = ((1 / Real.sqrt n : ℂ) •
            ∑ j : Fin n, t j • ((Matrix.circulantRightShift (α := ℂ) n) ^ (j : ℕ))) := by
              rw [circulant_eq_sum_rightShift_pow]
    _ =
        ∑ j : Fin n, t j •
          ((1 / Real.sqrt n : ℂ) •
            ((Matrix.circulantRightShift (α := ℂ) n) ^ (j : ℕ))) := by
              simp [Finset.smul_sum, smul_smul, mul_comm, mul_left_comm, mul_assoc]
    _ =
        ∑ j : Fin n, t j •
          ((fourierMatrix n)ᴴ *
            diagonal (fun i : Fin n ↦
              (1 / Real.sqrt n : ℂ) * (Matrix.fourierRoot n ^ (i : ℕ)) ^ (j : ℕ)) *
              fourierMatrix n) := by
                refine Finset.sum_congr rfl ?_
                intro j _
                rw [rightShiftPow_eq_fourierDiagonalization]
                apply congrArg (fun M : Matrix (Fin n) (Fin n) ℂ => t j • M)
                calc
                  ((1 / Real.sqrt n : ℂ) •
                      (((fourierMatrix n)ᴴ *
                          diagonal (fun i : Fin n ↦ (Matrix.fourierRoot n ^ (i : ℕ)) ^ (j : ℕ))) *
                        fourierMatrix n))
                      =
                      (((1 / Real.sqrt n : ℂ) •
                          ((fourierMatrix n)ᴴ *
                            diagonal (fun i : Fin n ↦ (Matrix.fourierRoot n ^ (i : ℕ)) ^ (j : ℕ)))) *
                        fourierMatrix n) := by
                          rw [smul_mul_assoc]
                  _ =
                      (((fourierMatrix n)ᴴ *
                          ((1 / Real.sqrt n : ℂ) •
                            diagonal (fun i : Fin n ↦ (Matrix.fourierRoot n ^ (i : ℕ)) ^ (j : ℕ)))) *
                        fourierMatrix n) := by
                          rw [Matrix.mul_smul]
                  _ =
                      ((fourierMatrix n)ᴴ *
                        diagonal (fun i : Fin n ↦
                          (1 / Real.sqrt n : ℂ) * (Matrix.fourierRoot n ^ (i : ℕ)) ^ (j : ℕ)) *
                          fourierMatrix n) := by
                            rw [← Matrix.diagonal_smul]
                            rfl
    _ =
        (fourierMatrix n)ᴴ *
          (∑ j : Fin n,
            t j •
              diagonal (fun i : Fin n ↦
                (1 / Real.sqrt n : ℂ) * (Matrix.fourierRoot n ^ (i : ℕ)) ^ (j : ℕ))) *
              fourierMatrix n := by
                calc
                  ∑ j : Fin n, t j •
                      ((fourierMatrix n)ᴴ *
                        diagonal (fun i : Fin n ↦
                          (1 / Real.sqrt n : ℂ) * (Matrix.fourierRoot n ^ (i : ℕ)) ^ (j : ℕ)) *
                          fourierMatrix n)
                      =
                      ∑ j : Fin n,
                        ((fourierMatrix n)ᴴ *
                          (t j • diagonal
                            (fun i : Fin n ↦
                              (1 / Real.sqrt n : ℂ) * (Matrix.fourierRoot n ^ (i : ℕ)) ^ (j : ℕ)))) *
                          fourierMatrix n := by
                            refine Finset.sum_congr rfl ?_
                            intro j _
                            calc
                              t j •
                                  (((fourierMatrix n)ᴴ *
                                      diagonal
                                        (fun i : Fin n ↦
                                          (1 / Real.sqrt n : ℂ) *
                                            (Matrix.fourierRoot n ^ (i : ℕ)) ^ (j : ℕ))) *
                                    fourierMatrix n)
                                  =
                                  (t j •
                                      ((fourierMatrix n)ᴴ *
                                        diagonal
                                          (fun i : Fin n ↦
                                            (1 / Real.sqrt n : ℂ) *
                                              (Matrix.fourierRoot n ^ (i : ℕ)) ^ (j : ℕ)))) *
                                    fourierMatrix n := by
                                      rw [smul_mul_assoc]
                              _ =
                                  (((fourierMatrix n)ᴴ *
                                      (t j •
                                        diagonal
                                          (fun i : Fin n ↦
                                            (1 / Real.sqrt n : ℂ) *
                                              (Matrix.fourierRoot n ^ (i : ℕ)) ^ (j : ℕ)))) *
                                    fourierMatrix n) := by
                                      rw [Matrix.mul_smul]
                  _ =
                      (fourierMatrix n)ᴴ *
                        (∑ j : Fin n,
                          t j • diagonal
                            (fun i : Fin n ↦
                              (1 / Real.sqrt n : ℂ) * (Matrix.fourierRoot n ^ (i : ℕ)) ^ (j : ℕ))) *
                          fourierMatrix n := by
                            calc
                              ∑ j : Fin n,
                                  (((fourierMatrix n)ᴴ *
                                      (t j •
                                        diagonal
                                          (fun i : Fin n ↦
                                            (1 / Real.sqrt n : ℂ) *
                                              (Matrix.fourierRoot n ^ (i : ℕ)) ^ (j : ℕ)))) *
                                    fourierMatrix n)
                                  =
                                  (∑ j : Fin n,
                                      ((fourierMatrix n)ᴴ *
                                        (t j •
                                          diagonal
                                            (fun i : Fin n ↦
                                              (1 / Real.sqrt n : ℂ) *
                                                (Matrix.fourierRoot n ^ (i : ℕ)) ^ (j : ℕ))))) *
                                    fourierMatrix n := by
                                      rw [Finset.sum_mul]
                              _ =
                                  (fourierMatrix n)ᴴ *
                                    (∑ j : Fin n,
                                      t j •
                                        diagonal
                                          (fun i : Fin n ↦
                                            (1 / Real.sqrt n : ℂ) *
                                              (Matrix.fourierRoot n ^ (i : ℕ)) ^ (j : ℕ))) *
                                    fourierMatrix n := by
                                      rw [Finset.mul_sum]
    _ = (fourierMatrix n)ᴴ * diagonal (dft n t) * fourierMatrix n := by
          congr 2
          ext i k
          by_cases hik : i = k
          · subst hik
            rw [Matrix.sum_apply, Matrix.diagonal_apply]
            rw [Matrix.dft_apply]
            simp [Matrix.fourierMatrix_apply, div_eq_mul_inv,
              pow_mul, mul_assoc, mul_left_comm, mul_comm]
          · rw [Matrix.sum_apply, Matrix.diagonal_apply]
            simp [hik]

end Matrix
