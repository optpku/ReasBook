public section

open scoped Matrix
open DiscreteSignal

noncomputable section

namespace Matrix

/-- The Toeplitz matrix of the periodic extension of `t` is the circulant matrix
generated by `t`. -/
theorem toeplitzByDiag_periodicExtension_eq_circulant
    (n : ℕ) [NeZero n] (t : Fin n → ℂ) :
    toeplitzByDiag n (periodicExtensionOfNeZero t) = circulant t := by
  ext i j
  rw [toeplitzByDiag_apply, periodicExtensionOfNeZero_apply, circulant_apply]
  congr
  apply Fin.ext
  have hsub : ((i - j : Fin n) : Int) = ((i : Int) - (j : Int)) % n :=
    Fin.coe_int_sub_eq_mod i j
  simpa [periodicIndexOfNeZero_val] using congrArg Int.toNat hsub.symm

/-- Backend Fourier form of Proposition 5.6, after rewriting the periodic
convolution `t^ext ⋆ f` as the circulant action `circulant t *ᵥ f`. -/
theorem circulant_mulVec_eq_invDFT_mul_dft
    (n : ℕ) [NeZero n] (t f : Fin n → ℂ) :
    ((1 / Real.sqrt n : ℂ) • (circulant t *ᵥ f)) =
      invDFT n (dft n t * dft n f) := by
  calc
    ((1 / Real.sqrt n : ℂ) • (circulant t *ᵥ f))
        = (((1 / Real.sqrt n : ℂ) • circulant t) *ᵥ f) := by
            rw [Matrix.smul_mulVec]
    _ = ((fourierMatrix n)ᴴ * diagonal (dft n t) * fourierMatrix n) *ᵥ f := by
          rw [smul_circulant_eq_fourierDiagonalization n t]
    _ = (fourierMatrix n)ᴴ *ᵥ (diagonal (dft n t) *ᵥ (fourierMatrix n *ᵥ f)) := by
          rw [Matrix.mulVec_mulVec, Matrix.mulVec_mulVec]
    _ = (fourierMatrix n)ᴴ *ᵥ (dft n t * dft n f) := by
          congr 1
          ext i
          simp [dft, Matrix.mulVec_diagonal]
    _ = invDFT n (dft n t * dft n f) := by
          rfl

end Matrix
