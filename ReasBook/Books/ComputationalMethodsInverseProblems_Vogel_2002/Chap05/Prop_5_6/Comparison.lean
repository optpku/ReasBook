public import ComputationalMethodsInverseProblems_Vogel_2002.Chap05.Definition_5_4
public import ComputationalMethodsInverseProblems_Vogel_2002.Chap05.Definition_5_11.Toeplitz
public import ComputationalMethodsInverseProblems_Vogel_2002.Chap05.Definition_5_12
