public section

noncomputable section

namespace Fredholm1D

/-- The diagonal coefficients of the Chapter 1 Gaussian midpoint matrix when it
is viewed as a Chapter 5 Toeplitz matrix. -/
@[expose] def gaussianMidpointToeplitzDiag (n : ℕ) (C γ : ℝ) : ℤ → ℝ :=
  fun k ↦
    let h : ℝ := 1 / n
    h * C * Real.exp (-(((k : ℝ) * h) ^ 2 / (2 * γ ^ 2)))

/-- Entrywise formula for `Fredholm1D.gaussianMidpointToeplitzDiag`. -/
theorem gaussianMidpointToeplitzDiag_apply (n : ℕ) (C γ : ℝ) (k : ℤ) :
    gaussianMidpointToeplitzDiag n C γ k =
      let h : ℝ := 1 / n
      h * C * Real.exp (-(((k : ℝ) * h) ^ 2 / (2 * γ ^ 2))) := rfl

/-- The Chapter 1 midpoint matrix is the Toeplitz matrix generated by
`Fredholm1D.gaussianMidpointToeplitzDiag`. -/
theorem midpointMatrix_eq_toeplitzByDiag (n : ℕ) (C γ : ℝ) :
    midpointMatrix n C γ = Matrix.toeplitzByDiag n (gaussianMidpointToeplitzDiag n C γ) := by
  ext i j
  rw [midpointMatrix_apply, Matrix.toeplitzByDiag_apply, gaussianMidpointToeplitzDiag_apply]
  have hcast :
      (((((i : ℕ) : ℤ) - ((j : ℕ) : ℤ)) : ℤ) : ℝ) = ((i : ℕ) : ℝ) - ((j : ℕ) : ℝ) := by
    simp
  simp [hcast]

end Fredholm1D

