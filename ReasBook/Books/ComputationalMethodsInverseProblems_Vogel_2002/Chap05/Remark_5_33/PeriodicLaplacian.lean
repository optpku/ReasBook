module

public import ComputationalMethodsInverseProblems_Vogel_2002.Chap05.Definition_5_27.BCCB
public import Mathlib.Data.Real.Basic

public section

namespace Matrix

/-- The generating `n_x × n_y` stencil for the periodic Chapter 5 regularization matrix `L`
from `(5.69)`: a central weight `4` together with the four wrapped nearest-neighbor
contributions, each recorded separately so that small periodic grids retain the correct
multiplicities when offsets coincide. -/
def periodicLaplacianStencil (n_x n_y : ℕ) [NeZero n_x] [NeZero n_y] :
    Matrix (Fin n_x) (Fin n_y) ℝ :=
  fun dx dy ↦
    (if dx = 0 ∧ dy = 0 then (4 : ℝ) else 0) -
      (if dx = 1 ∧ dy = 0 then (1 : ℝ) else 0) -
        (if dx = (0 : Fin n_x) - 1 ∧ dy = 0 then (1 : ℝ) else 0) -
          (if dx = 0 ∧ dy = 1 then (1 : ℝ) else 0) -
            (if dx = 0 ∧ dy = (0 : Fin n_y) - 1 then (1 : ℝ) else 0)

/-- The Chapter 5 periodic regularization matrix `L` from `(5.69)`, realized as the BCCB matrix
generated by the wrapped five-point stencil `Matrix.periodicLaplacianStencil`. -/
@[expose]
def periodicLaplacian (n_x n_y : ℕ) [NeZero n_x] [NeZero n_y] :
    Matrix (Fin n_y × Fin n_x) (Fin n_y × Fin n_x) ℝ :=
  Matrix.bccb (Matrix.periodicLaplacianStencil n_x n_y)

/-- The Chapter 5 periodic regularization matrix is exactly the BCCB matrix generated by its
wrapped five-point stencil. -/
theorem periodicLaplacian_eq_bccb (n_x n_y : ℕ) [NeZero n_x] [NeZero n_y] :
    Matrix.periodicLaplacian n_x n_y =
      Matrix.bccb (Matrix.periodicLaplacianStencil n_x n_y) := rfl

/-- Entrywise formula for `Matrix.periodicLaplacian`. This is the sparse five-term stencil behind
the remark's `5 * n_x * n_y + O(1)` matrix-vector-cost clause. -/
theorem periodicLaplacian_apply
    (n_x n_y : ℕ) [NeZero n_x] [NeZero n_y]
    (j l : Fin n_y) (i k : Fin n_x) :
    Matrix.periodicLaplacian n_x n_y (j, i) (l, k) =
      (if i - k = 0 ∧ j - l = 0 then (4 : ℝ) else 0) -
        (if i - k = 1 ∧ j - l = 0 then (1 : ℝ) else 0) -
          (if i - k = (0 : Fin n_x) - 1 ∧ j - l = 0 then (1 : ℝ) else 0) -
            (if i - k = 0 ∧ j - l = 1 then (1 : ℝ) else 0) -
              (if i - k = 0 ∧ j - l = (0 : Fin n_y) - 1 then (1 : ℝ) else 0) := by
  rw [Matrix.periodicLaplacian_eq_bccb, Matrix.bccb_apply]
  rfl

/-- Away from the center and the four wrapped nearest-neighbor offsets, the periodic Chapter 5
regularization matrix has zero entries. -/
theorem periodicLaplacian_apply_eq_zero_of_not_stencil
    (n_x n_y : ℕ) [NeZero n_x] [NeZero n_y]
    (j l : Fin n_y) (i k : Fin n_x)
    (h_center : i - k ≠ 0 ∨ j - l ≠ 0)
    (h_right : i - k ≠ 1 ∨ j - l ≠ 0)
    (h_left : i - k ≠ (0 : Fin n_x) - 1 ∨ j - l ≠ 0)
    (h_up : i - k ≠ 0 ∨ j - l ≠ 1)
    (h_down : i - k ≠ 0 ∨ j - l ≠ (0 : Fin n_y) - 1) :
    Matrix.periodicLaplacian n_x n_y (j, i) (l, k) = 0 := by
  have h_center' : ¬ (i - k = 0 ∧ j - l = 0) := by
    intro h
    exact h_center.elim (fun hdx ↦ hdx h.1) (fun hdy ↦ hdy h.2)
  have h_right' : ¬ (i - k = 1 ∧ j - l = 0) := by
    intro h
    exact h_right.elim (fun hdx ↦ hdx h.1) (fun hdy ↦ hdy h.2)
  have h_left' : ¬ (i - k = (0 : Fin n_x) - 1 ∧ j - l = 0) := by
    intro h
    exact h_left.elim (fun hdx ↦ hdx h.1) (fun hdy ↦ hdy h.2)
  have h_up' : ¬ (i - k = 0 ∧ j - l = 1) := by
    intro h
    exact h_up.elim (fun hdx ↦ hdx h.1) (fun hdy ↦ hdy h.2)
  have h_down' : ¬ (i - k = 0 ∧ j - l = (0 : Fin n_y) - 1) := by
    intro h
    exact h_down.elim (fun hdx ↦ hdx h.1) (fun hdy ↦ hdy h.2)
  have h_center0 : (if i - k = 0 ∧ j - l = 0 then (4 : ℝ) else 0) = 0 := by
    simp [h_center']
  have h_right0 : (if i - k = 1 ∧ j - l = 0 then (1 : ℝ) else 0) = 0 := by
    simp [h_right']
  have h_left0 : (if i - k = (0 : Fin n_x) - 1 ∧ j - l = 0 then (1 : ℝ) else 0) = 0 := by
    by_cases hEq : i - k = (0 : Fin n_x) - 1 ∧ j - l = 0
    · exact (h_left' hEq).elim
    · exact if_neg hEq
  have h_up0 : (if i - k = 0 ∧ j - l = 1 then (1 : ℝ) else 0) = 0 := by
    simp [h_up']
  have h_down0 :
      (if i - k = 0 ∧ j - l = (0 : Fin n_y) - 1 then (1 : ℝ) else 0) = 0 := by
    by_cases hEq : i - k = 0 ∧ j - l = (0 : Fin n_y) - 1
    · exact (h_down' hEq).elim
    · exact if_neg hEq
  rw [Matrix.periodicLaplacian_apply]
  rw [h_center0, h_right0, h_left0, h_up0, h_down0]
  ring

end Matrix
