namespace Matrix

/-- Helper for Lemma 5.21: the Chapter 5 right-shift matrix is the circulant basis matrix
generated by the standard basis vector at the index `1`. -/
def chapterRightShift (n : ℕ) [NeZero n] : Matrix (Fin n) (Fin n) ℂ :=
  Matrix.circulant (Pi.single (1 : Fin n) (1 : ℂ))

/-- Helper for Lemma 5.21: entrywise, the Chapter 5 right-shift matrix has a single `1` in each
column, at the rotated row `finRotate n j`. -/
lemma chapterRightShift_apply
    {n : ℕ} [NeZero n] (i j : Fin n) :
    chapterRightShift n i j = if i = finRotate n j then 1 else 0 := by
  rw [chapterRightShift, Matrix.circulant_apply, Pi.single_apply]
  by_cases hsub : (i - j : Fin n) = 1
  · have hadd : i = (1 : Fin n) + j := sub_eq_iff_eq_add.mp hsub
    have hrotate : i = finRotate n j := by
      simpa [finRotate_apply, add_comm] using hadd
    rw [if_pos hsub, if_pos hrotate]
  · have hrotate : i ≠ finRotate n j := by
      intro hij
      apply hsub
      apply sub_eq_iff_eq_add.mpr
      simpa [finRotate_apply, add_comm] using hij
    rw [if_neg hsub, if_neg hrotate]

/-- Helper for Lemma 5.21: the Chapter 5 Fourier matrix also satisfies
`Matrix.fourierMatrix n * (Matrix.fourierMatrix n)ᴴ = 1`. -/
lemma fourierMatrix_mul_conjTranspose
    (n : ℕ) [NeZero n] :
    Matrix.fourierMatrix n * (Matrix.fourierMatrix n)ᴴ = 1 :=
  Matrix.mem_unitaryGroup_iff.mp <| Matrix.fourierMatrix_mem_unitaryGroup n

/-- Helper for Lemma 5.21: `Matrix.invDFT n` is a right inverse for `Matrix.dft n`. -/
lemma dft_invDFT
    {n : ℕ} [NeZero n] (d : Fin n → ℂ) :
    Matrix.dft n (Matrix.invDFT n d) = d := by
  -- Compose the Fourier matrix with its conjugate transpose and collapse the unitary factor.
  simpa [Matrix.dft, Matrix.invDFT, Matrix.mulVec_mulVec] using
    congrArg (fun M : Matrix (Fin n) (Fin n) ℂ => M *ᵥ d)
      (fourierMatrix_mul_conjTranspose n)

/-- Helper for Lemma 5.21: left multiplication by the complex Chapter 5 right-shift matrix sends
the `k`th standard basis vector to the rotated basis vector at `finRotate n k`. -/
lemma circulantRightShift_mulVec_single_complex
    {n : ℕ} [NeZero n] (k : Fin n) :
    chapterRightShift n *ᵥ Pi.single k (1 : ℂ) =
      Pi.single (finRotate n k) (1 : ℂ) := by
  rw [Matrix.mulVec_single_one]
  ext i
  rw [Matrix.col_apply, chapterRightShift_apply]
  by_cases h : i = finRotate n k
  · simp [h]
  · simp [Pi.single_apply]

/-- Helper for Lemma 5.21: the `m`th power of the complex Chapter 5 right-shift matrix sends the
`k`th standard basis vector to the basis vector indexed by `((finRotate n)^[m]) k`. -/
lemma rightShiftPow_mulVec_single_complex
    {n : ℕ} [NeZero n] (m : ℕ) (k : Fin n) :
    (chapterRightShift n ^ m) *ᵥ Pi.single k (1 : ℂ) =
      Pi.single (((finRotate n)^[m]) k) (1 : ℂ) := by
  induction m generalizing k with
  | zero =>
      rw [pow_zero, Matrix.mulVec_single_one]
      ext i
      simp [Matrix.col, Matrix.one_apply, Pi.single_apply]
  | succ m ih =>
      rw [pow_succ', ← Matrix.mulVec_mulVec, ih]
      rw [Function.iterate_succ_apply']
      simpa using circulantRightShift_mulVec_single_complex (n := n) (((finRotate n)^[m]) k)

/-- Helper for Lemma 5.21: the complex circulant basis matrix generated by `Pi.single j 1` has a
single `1` in each column, located at the row `k + j`. -/
lemma circulantSingle_apply_complex
    {n : ℕ} [NeZero n] (j i k : Fin n) :
    Matrix.circulant (Pi.single j (1 : ℂ)) i k = if i = k + j then 1 else 0 := by
  rw [Matrix.circulant_apply, Pi.single_apply]
  by_cases h : i = k + j
  · have hsub : i - k = j := by
      simpa [add_comm] using (sub_eq_iff_eq_add.mpr (by simpa [add_comm] using h : i = j + k))
    simp [h]
  · have hsub : i - k ≠ j := by
      intro hk
      apply h
      simpa [add_comm] using (sub_eq_iff_eq_add.mp hk)
    simp [h, hsub]

/-- Helper for Lemma 5.21: the `k`th column of the complex circulant basis matrix generated by
`Pi.single j 1` is the standard basis vector at `k + j`. -/
lemma circulantSingle_mulVec_single_complex
    {n : ℕ} [NeZero n] (j k : Fin n) :
    Matrix.circulant (Pi.single j (1 : ℂ)) *ᵥ Pi.single k (1 : ℂ) =
      Pi.single (k + j) (1 : ℂ) := by
  rw [Matrix.mulVec_single_one]
  ext i
  simpa [Matrix.col, Pi.single_apply] using circulantSingle_apply_complex (j := j) i k

/-- Helper for Lemma 5.21: the `j`th power of `Matrix.circulantRightShift n` is the complex
circulant basis matrix generated by `Pi.single j 1`. -/
lemma circulantRightShift_pow_eq_circulant_single_complex
    {n : ℕ} [NeZero n] (j : Fin n) :
    (chapterRightShift n) ^ (j : ℕ) = Matrix.circulant (Pi.single j (1 : ℂ)) := by
  apply Matrix.ext_of_mulVec_single
  intro k
  rw [rightShiftPow_mulVec_single_complex, circulantSingle_mulVec_single_complex]
  have hcycle : ((finRotate n)^[j.1]) k = k + j := by
    simpa using congrFun (finCycle_eq_finRotate_iterate (k := j)).symm k
  simp [hcycle]

/-- Helper for Lemma 5.21: a complex circulant matrix is the finite linear combination of the
basis matrices `Matrix.circulant (Pi.single j 1)` with its generating coefficients. -/
lemma sum_smul_circulant_single_eq_circulant_complex
    {n : ℕ} (c : Fin n → ℂ) :
    ∑ j : Fin n, c j • Matrix.circulant (Pi.single j (1 : ℂ)) = Matrix.circulant c := by
  ext i k
  -- Each entry reduces to the unique singleton term indexed by `i - k`.
  simp [Matrix.sum_apply, Matrix.circulant_apply, Pi.single_apply]

/-- Helper for Lemma 5.21: a complex circulant matrix is the finite linear combination of the
complex powers of `Matrix.circulantRightShift n` with its generating coefficients. -/
lemma circulant_eq_sum_rightShift_pow_complex
    {n : ℕ} [NeZero n] (c : Fin n → ℂ) :
    Matrix.circulant c =
      ∑ j : Fin n, c j • ((chapterRightShift n) ^ (j : ℕ)) := by
  -- Rewrite the right-shift powers into the complex circulant basis and reassemble the basis sum.
  symm
  calc
    ∑ j : Fin n, c j • ((chapterRightShift n) ^ (j : ℕ))
        = ∑ j : Fin n, c j • Matrix.circulant (Pi.single j (1 : ℂ)) := by
            refine Finset.sum_congr rfl ?_
            intro j _
            rw [circulantRightShift_pow_eq_circulant_single_complex]
    _ = Matrix.circulant c := sum_smul_circulant_single_eq_circulant_complex c

/-- Helper for Lemma 5.21: `Matrix.fourierRoot n` is an `n`th root of unity. -/
lemma fourierRoot_pow_card
    (n : ℕ) [NeZero n] :
    Matrix.fourierRoot n ^ n = 1 := by
  rw [Matrix.fourierRoot_eq_stdAddChar, ← AddChar.map_nsmul_eq_pow]
  simp [nsmul_eq_mul]

/-- Helper for Lemma 5.21: the complex Chapter 5 right-shift matrix is diagonalized by the
normalized Fourier matrix, with diagonal entries `Matrix.fourierSpectrum n`. -/
lemma circulantRightShift_eq_fourierDiagonalization
    (n : ℕ) [NeZero n] :
    chapterRightShift n =
      (fourierMatrix n)ᴴ *
        diagonal (fun i : Fin n ↦ Matrix.fourierRoot n ^ (i : ℕ)) *
        fourierMatrix n := by
  -- Conjugating the right shift by the Fourier matrix reduces it to pointwise multiplication by
  -- the Fourier spectrum.
  have hmul :
      fourierMatrix n * chapterRightShift n =
        diagonal (fun i : Fin n ↦ Matrix.fourierRoot n ^ (i : ℕ)) * fourierMatrix n := by
    obtain ⟨m, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (NeZero.ne n)
    ext i j
    rw [Matrix.mul_apply, Matrix.diagonal_mul]
    have hsum :
        ∑ x : Fin (m + 1),
          fourierMatrix (m + 1) i x * chapterRightShift (m + 1) x j =
            fourierMatrix (m + 1) i (finRotate (m + 1) j) := by
      rw [Fintype.sum_eq_single (finRotate (m + 1) j)]
      · have hone :
            chapterRightShift (m + 1) (finRotate (m + 1) j) j = (1 : ℂ) := by
              rw [chapterRightShift_apply]
              simp
        calc
          fourierMatrix (m + 1) i (finRotate (m + 1) j) *
              chapterRightShift (m + 1) (finRotate (m + 1) j) j
              =
              fourierMatrix (m + 1) i (finRotate (m + 1) j) * 1 := by rw [hone]
          _ = fourierMatrix (m + 1) i (finRotate (m + 1) j) := by simp
      · intro x hx
        have hzero : chapterRightShift (m + 1) x j = (0 : ℂ) := by
          rw [chapterRightShift_apply]
          rw [if_neg hx]
        simp [hzero]
    rw [hsum]
    by_cases hj : j = Fin.last m
    · subst hj
      have hroot : Matrix.fourierRoot (m + 1) ^ (m + 1) = 1 := fourierRoot_pow_card (m + 1)
      have hrooti :
          Matrix.fourierRoot (m + 1) ^ ((i : ℕ) * (m + 1)) = 1 := by
        rw [Nat.mul_comm, pow_mul, hroot, one_pow]
      have hexp : (i : ℕ) + (i : ℕ) * m = (i : ℕ) * (m + 1) := by
        ring
      calc
        fourierMatrix (m + 1) i (finRotate (m + 1) (Fin.last m))
            = fourierMatrix (m + 1) i 0 := by
                simp
        _ = Matrix.fourierRoot (m + 1) ^ ((i : ℕ) * (m + 1)) / Real.sqrt (m + 1) := by
              simp [Matrix.fourierMatrix_apply, hrooti]
        _ = Matrix.fourierRoot (m + 1) ^ (i : ℕ) * fourierMatrix (m + 1) i (Fin.last m) := by
              rw [Matrix.fourierMatrix_apply, Fin.val_last]
              simp only [div_eq_mul_inv]
              rw [← hexp, pow_add]
              simp [mul_assoc]
    · have hrotate : (finRotate (m + 1) j : ℕ) = j + 1 := coe_finRotate_of_ne_last hj
      have hexp : (i : ℕ) * (j + 1) = (i : ℕ) * j + i := by
        ring
      calc
        fourierMatrix (m + 1) i (finRotate (m + 1) j)
            =
            Matrix.fourierRoot (m + 1) ^ ((i : ℕ) * ↑(finRotate (m + 1) j)) /
              Real.sqrt (m + 1) := by
                simpa using Matrix.fourierMatrix_apply (m + 1) i (finRotate (m + 1) j)
        _ = Matrix.fourierRoot (m + 1) ^ ((i : ℕ) * (j + 1)) / Real.sqrt (m + 1) := by
              rw [hrotate]
        _ = Matrix.fourierRoot (m + 1) ^ (i : ℕ) * fourierMatrix (m + 1) i j := by
              rw [Matrix.fourierMatrix_apply]
              simp only [div_eq_mul_inv]
              rw [hexp, pow_add]
              ring_nf
              simp
  calc
    chapterRightShift n = (1 : Matrix (Fin n) (Fin n) ℂ) * chapterRightShift n := by
            simp
    _ = ((fourierMatrix n)ᴴ * fourierMatrix n) * chapterRightShift n := by
          rw [Matrix.fourierMatrix_conjTranspose_mul]
    _ = (fourierMatrix n)ᴴ * (fourierMatrix n * chapterRightShift n) := by
          simp [Matrix.mul_assoc]
    _ =
        (fourierMatrix n)ᴴ *
          (diagonal (fun i : Fin n ↦ Matrix.fourierRoot n ^ (i : ℕ)) * fourierMatrix n) := by
          rw [hmul]
    _ =
        (fourierMatrix n)ᴴ *
          diagonal (fun i : Fin n ↦ Matrix.fourierRoot n ^ (i : ℕ)) *
          fourierMatrix n := by
          simp [Matrix.mul_assoc]

/-- Helper for Lemma 5.21: every power of the Chapter 5 right-shift matrix is diagonalized by
the normalized Fourier matrix, with diagonal entries `Matrix.fourierSpectrum n ^ m`. -/
lemma rightShiftPow_eq_fourierDiagonalization
    (n : ℕ) [NeZero n] (m : ℕ) :
    (chapterRightShift n ^ m) =
      (fourierMatrix n)ᴴ *
        diagonal (fun i : Fin n ↦ (Matrix.fourierRoot n ^ (i : ℕ)) ^ m) *
        fourierMatrix n := by
  induction m with
  | zero =>
      -- At exponent zero, both sides are the identity matrix.
      rw [pow_zero]
      simpa [Matrix.mul_assoc] using (Matrix.fourierMatrix_conjTranspose_mul n).symm
  | succ m ih =>
      -- Insert the diagonal form of one more shift and collapse the unitary middle factor.
      calc
        chapterRightShift n ^ (m + 1) = chapterRightShift n ^ m * chapterRightShift n := by
                  rw [pow_succ]
        _ =
            ((fourierMatrix n)ᴴ *
                diagonal (fun i : Fin n ↦ (Matrix.fourierRoot n ^ (i : ℕ)) ^ m) *
                fourierMatrix n) *
              ((fourierMatrix n)ᴴ *
                diagonal (fun i : Fin n ↦ Matrix.fourierRoot n ^ (i : ℕ)) *
                fourierMatrix n) := by
                rw [ih, circulantRightShift_eq_fourierDiagonalization]
        _ =
            (fourierMatrix n)ᴴ *
              diagonal (fun i : Fin n ↦ (Matrix.fourierRoot n ^ (i : ℕ)) ^ m) *
                (fourierMatrix n * (fourierMatrix n)ᴴ) *
                  diagonal (fun i : Fin n ↦ Matrix.fourierRoot n ^ (i : ℕ)) *
                  fourierMatrix n := by
                    simp [Matrix.mul_assoc]
        _ =
            (fourierMatrix n)ᴴ *
              diagonal (fun i : Fin n ↦ (Matrix.fourierRoot n ^ (i : ℕ)) ^ m) *
                diagonal (fun i : Fin n ↦ Matrix.fourierRoot n ^ (i : ℕ)) *
                fourierMatrix n := by
                  rw [fourierMatrix_mul_conjTranspose]
                  simp [Matrix.mul_assoc]
        _ =
            (fourierMatrix n)ᴴ *
              (diagonal (fun i : Fin n ↦ (Matrix.fourierRoot n ^ (i : ℕ)) ^ m) *
                diagonal (fun i : Fin n ↦ Matrix.fourierRoot n ^ (i : ℕ))) *
              fourierMatrix n := by
                  simp [Matrix.mul_assoc]
        _ =
            (fourierMatrix n)ᴴ *
              diagonal (fun i : Fin n ↦ (Matrix.fourierRoot n ^ (i : ℕ)) ^ (m + 1)) *
              fourierMatrix n := by
                rw [Matrix.diagonal_mul_diagonal]
                simp [Matrix.mul_assoc, pow_succ]

/-- Helper for Lemma 5.21: the normalized circulant operator generated by `t`
is diagonalized by the Chapter 5 normalized Fourier matrix, with diagonal entries
`Matrix.dft n t`. -/
theorem smul_circulant_eq_fourierDiagonalization
    (n : ℕ) [NeZero n] (t : Fin n → ℂ) :
    ((1 / Real.sqrt n : ℂ) • circulant t) =
      (fourierMatrix n)ᴴ * diagonal (dft n t) * fourierMatrix n := by
  -- Expand the circulant matrix in the right-shift basis, diagonalize each basis element, and
  -- reassemble the diagonal entries into the DFT of the generating vector.
  calc
    ((1 / Real.sqrt n : ℂ) • circulant t)
        = ((1 / Real.sqrt n : ℂ) •
            ∑ j : Fin n, t j • ((chapterRightShift n) ^ (j : ℕ))) := by
              rw [circulant_eq_sum_rightShift_pow_complex]
    _ =
        ∑ j : Fin n, t j •
          ((1 / Real.sqrt n : ℂ) •
            ((chapterRightShift n) ^ (j : ℕ))) := by
              simp [Finset.smul_sum, smul_smul, mul_comm]
    _ =
        ∑ j : Fin n, t j •
          ((fourierMatrix n)ᴴ *
            diagonal (fun i : Fin n ↦
              (1 / Real.sqrt n : ℂ) * (Matrix.fourierRoot n ^ (i : ℕ)) ^ (j : ℕ)) *
              fourierMatrix n) := by
                refine Finset.sum_congr rfl ?_
                intro j _
                rw [rightShiftPow_eq_fourierDiagonalization]
                apply congrArg (fun M : Matrix (Fin n) (Fin n) ℂ ↦ t j • M)
                calc
                  ((1 / Real.sqrt n : ℂ) •
                      (((fourierMatrix n)ᴴ *
                          diagonal (fun i : Fin n ↦
                            (Matrix.fourierRoot n ^ (i : ℕ)) ^ (j : ℕ))) *
                        fourierMatrix n))
                      =
                      (((1 / Real.sqrt n : ℂ) •
                          ((fourierMatrix n)ᴴ *
                            diagonal (fun i : Fin n ↦
                              (Matrix.fourierRoot n ^ (i : ℕ)) ^ (j : ℕ)))) *
                        fourierMatrix n) := by
                          rw [smul_mul_assoc]
                  _ =
                      (((fourierMatrix n)ᴴ *
                          ((1 / Real.sqrt n : ℂ) •
                            diagonal (fun i : Fin n ↦
                              (Matrix.fourierRoot n ^ (i : ℕ)) ^ (j : ℕ)))) *
                        fourierMatrix n) := by
                          rw [Matrix.mul_smul]
                  _ =
                      ((fourierMatrix n)ᴴ *
                        diagonal (fun i : Fin n ↦
                          (1 / Real.sqrt n : ℂ) * (Matrix.fourierRoot n ^ (i : ℕ)) ^ (j : ℕ)) *
                          fourierMatrix n) := by
                            rw [← Matrix.diagonal_smul]
                            rfl
    _ =
        (fourierMatrix n)ᴴ *
          (∑ j : Fin n,
            t j • diagonal (fun i : Fin n ↦
              (1 / Real.sqrt n : ℂ) * (Matrix.fourierRoot n ^ (i : ℕ)) ^ (j : ℕ))) *
              fourierMatrix n := by
                calc
                  ∑ j : Fin n, t j •
                      ((fourierMatrix n)ᴴ *
                        diagonal (fun i : Fin n ↦
                          (1 / Real.sqrt n : ℂ) * (Matrix.fourierRoot n ^ (i : ℕ)) ^ (j : ℕ)) *
                          fourierMatrix n)
                      =
                      ∑ j : Fin n,
                        ((fourierMatrix n)ᴴ *
                          (t j • diagonal
                            (fun i : Fin n ↦
                              (1 / Real.sqrt n : ℂ) *
                                (Matrix.fourierRoot n ^ (i : ℕ)) ^ (j : ℕ)))) *
                          fourierMatrix n := by
                            refine Finset.sum_congr rfl ?_
                            intro j _
                            calc
                              t j •
                                  (((fourierMatrix n)ᴴ *
                                      diagonal
                                        (fun i : Fin n ↦
                                          (1 / Real.sqrt n : ℂ) *
                                            (Matrix.fourierRoot n ^ (i : ℕ)) ^ (j : ℕ))) *
                                    fourierMatrix n)
                                  =
                                  (t j •
                                      ((fourierMatrix n)ᴴ *
                                        diagonal
                                          (fun i : Fin n ↦
                                            (1 / Real.sqrt n : ℂ) *
                                              (Matrix.fourierRoot n ^ (i : ℕ)) ^ (j : ℕ)))) *
                                    fourierMatrix n := by
                                      rw [smul_mul_assoc]
                              _ =
                                  (((fourierMatrix n)ᴴ *
                                      (t j •
                                        diagonal
                                          (fun i : Fin n ↦
                                            (1 / Real.sqrt n : ℂ) *
                                              (Matrix.fourierRoot n ^ (i : ℕ)) ^ (j : ℕ)))) *
                                    fourierMatrix n) := by
                                      rw [Matrix.mul_smul]
                  _ =
                      (fourierMatrix n)ᴴ *
                        (∑ j : Fin n,
                          t j • diagonal
                            (fun i : Fin n ↦
                              (1 / Real.sqrt n : ℂ) * (Matrix.fourierRoot n ^ (i : ℕ)) ^ (j : ℕ))) *
                          fourierMatrix n := by
                            calc
                              ∑ j : Fin n,
                                  (((fourierMatrix n)ᴴ *
                                      (t j •
                                        diagonal
                                          (fun i : Fin n ↦
                                            (1 / Real.sqrt n : ℂ) *
                                              (Matrix.fourierRoot n ^ (i : ℕ)) ^ (j : ℕ)))) *
                                    fourierMatrix n)
                                  =
                                  (∑ j : Fin n,
                                      ((fourierMatrix n)ᴴ *
                                        (t j •
                                          diagonal
                                            (fun i : Fin n ↦
                                              (1 / Real.sqrt n : ℂ) *
                                                (Matrix.fourierRoot n ^ (i : ℕ)) ^ (j : ℕ))))) *
                                    fourierMatrix n := by
                                      rw [Finset.sum_mul]
                              _ =
                                  (fourierMatrix n)ᴴ *
                                    (∑ j : Fin n,
                                      t j •
                                        diagonal
                                          (fun i : Fin n ↦
                                            (1 / Real.sqrt n : ℂ) *
                                              (Matrix.fourierRoot n ^ (i : ℕ)) ^ (j : ℕ))) *
                                    fourierMatrix n := by
                                      rw [Finset.mul_sum]
    _ = (fourierMatrix n)ᴴ * diagonal (dft n t) * fourierMatrix n := by
          congr 2
          ext i k
          by_cases hik : i = k
          · subst hik
            rw [Matrix.sum_apply, Matrix.diagonal_apply, Matrix.dft_apply]
            simp [Matrix.fourierMatrix_apply, div_eq_mul_inv, pow_mul, mul_comm]
          · rw [Matrix.sum_apply]
            simp [hik]

/-- Helper for Lemma 5.21: every Fourier-diagonal matrix is circulant. -/
lemma fourierDiagonalForm_mem_circulantMatrices
    {n : ℕ} [NeZero n] (d : Fin n → ℂ) :
    ((fourierMatrix n)ᴴ * diagonal d * fourierMatrix n) ∈ circulantMatrices n := by
  -- Use Proposition 5.6 with the inverse Fourier coefficients as the circulant generator.
  rw [mem_circulantMatrices_iff]
  refine ⟨(1 / Real.sqrt n : ℂ) • Matrix.invDFT n d, ?_⟩
  have hdiag := Matrix.smul_circulant_eq_fourierDiagonalization n (Matrix.invDFT n d)
  rw [dft_invDFT] at hdiag
  rw [← Matrix.circulant_smul] at hdiag
  exact hdiag

/-- Helper for Lemma 5.21: every admissible circulant matrix has a Fourier-diagonal form. -/
lemma exists_fourierDiagonalForm_of_mem_circulantMatrices
    {n : ℕ} [NeZero n] {M : Matrix (Fin n) (Fin n) ℂ} :
    M ∈ circulantMatrices n →
      ∃ d : Fin n → ℂ, M = (fourierMatrix n)ᴴ * diagonal d * fourierMatrix n := by
  intro hM
  rw [mem_circulantMatrices_iff] at hM
  rcases hM with ⟨c, rfl⟩
  have hn_pos : 0 < (n : ℝ) := by
    exact_mod_cast Nat.pos_of_neZero n
  have hsqrt_ne : (Real.sqrt n : ℂ) ≠ 0 := by
    exact_mod_cast Real.sqrt_ne_zero'.2 hn_pos
  refine ⟨(Real.sqrt n : ℂ) • Matrix.dft n c, ?_⟩
  -- Rescale Proposition 5.6 so the left-hand side becomes the unscaled circulant matrix.
  calc
    Matrix.circulant c = (Real.sqrt n : ℂ) • ((1 / Real.sqrt n : ℂ) • Matrix.circulant c) := by
      rw [one_div, smul_smul, mul_inv_cancel₀ hsqrt_ne, one_smul]
    _ = (Real.sqrt n : ℂ) •
          ((fourierMatrix n)ᴴ * diagonal (dft n c) * fourierMatrix n) := by
      rw [Matrix.smul_circulant_eq_fourierDiagonalization]
    _ = (fourierMatrix n)ᴴ * diagonal ((Real.sqrt n : ℂ) • Matrix.dft n c) *
          fourierMatrix n := by
      simp [Matrix.diagonal_smul, Matrix.mul_assoc]

/-- Helper for Lemma 5.21: conjugating `Matrix.fourierDiagonalProjection A` into Fourier
coordinates leaves only the diagonal of `(fourierMatrix n) * A * (fourierMatrix n)ᴴ`. -/
lemma fourierDiagonalProjection_fourierCoordinates
    {n : ℕ} [NeZero n] (A : Matrix (Fin n) (Fin n) ℂ) :
    (fourierMatrix n) * fourierDiagonalProjection A * (fourierMatrix n)ᴴ =
      diagonal (((fourierMatrix n) * A * (fourierMatrix n)ᴴ).diag) := by
  -- Normalize the two unitary cancellation factors around the explicit projection formula.
  rw [fourierDiagonalProjection_def]
  calc
    fourierMatrix n *
          (((fourierMatrix n)ᴴ * diagonal (((fourierMatrix n) * A * (fourierMatrix n)ᴴ).diag)) *
            fourierMatrix n) *
        (fourierMatrix n)ᴴ =
        (((fourierMatrix n) * (fourierMatrix n)ᴴ) *
            diagonal (((fourierMatrix n) * A * (fourierMatrix n)ᴴ).diag)) *
          (fourierMatrix n * (fourierMatrix n)ᴴ) := by
            simp [Matrix.mul_assoc]
    _ = diagonal (((fourierMatrix n) * A * (fourierMatrix n)ᴴ).diag) := by
          simp [fourierMatrix_mul_conjTranspose]

/-- Helper for Lemma 5.21: right multiplication by the Chapter 5 Fourier matrix preserves the
Frobenius norm. -/
lemma frobeniusNorm_mul_fourier
    {n : ℕ} [NeZero n] (X : Matrix (Fin n) (Fin n) ℂ) :
    ‖X * fourierMatrix n‖ = ‖X‖ := by
  have hFourierTranspose :
      (fourierMatrix n)ᵀ ∈ Matrix.unitaryGroup (Fin n) ℂ :=
    Matrix.transpose_mem_unitaryGroup_iff.mpr (Matrix.fourierMatrix_mem_unitaryGroup n)
  -- Convert right multiplication into left multiplication after transposing the residual.
  calc
    ‖X * fourierMatrix n‖ = ‖(X * fourierMatrix n)ᵀ‖ := by
      symm
      rw [Matrix.frobenius_norm_transpose]
    _ = ‖(fourierMatrix n)ᵀ * Xᵀ‖ := by
      simp [Matrix.transpose_mul]
    _ = ‖Xᵀ‖ := by
      simpa using Matrix.frobenius_norm_mul_eq_of_mem_unitary hFourierTranspose (Xᵀ)
    _ = ‖X‖ := by
      rw [Matrix.frobenius_norm_transpose]

/-- Helper for Lemma 5.21: Fourier conjugation transports the residual norm for a
Fourier-diagonal matrix to the residual norm of its diagonal factor. -/
lemma fourierDiagonalResidual_norm_eq
    {n : ℕ} [NeZero n] (A : Matrix (Fin n) (Fin n) ℂ) (d : Fin n → ℂ) :
    ‖A - ((fourierMatrix n)ᴴ * diagonal d * fourierMatrix n)‖ =
      ‖(fourierMatrix n) * A * (fourierMatrix n)ᴴ - diagonal d‖ := by
  have hrewrite :
      (fourierMatrix n) * (A - ((fourierMatrix n)ᴴ * diagonal d * fourierMatrix n)) =
        (((fourierMatrix n) * A * (fourierMatrix n)ᴴ - diagonal d) * fourierMatrix n) := by
    have hcancel :
        (fourierMatrix n) * ((fourierMatrix n)ᴴ * diagonal d * fourierMatrix n) =
          diagonal d * fourierMatrix n := by
      -- Collapse the left unitary factor before comparing the two residual spellings.
      calc
        (fourierMatrix n) * ((fourierMatrix n)ᴴ * diagonal d * fourierMatrix n)
            = (((fourierMatrix n) * (fourierMatrix n)ᴴ) * diagonal d) * fourierMatrix n := by
                simp [Matrix.mul_assoc]
        _ = diagonal d * fourierMatrix n := by
              simp [fourierMatrix_mul_conjTranspose]
    -- Expand the conjugated residual and cancel the unitary factors around the diagonal core.
    calc
      (fourierMatrix n) * (A - ((fourierMatrix n)ᴴ * diagonal d * fourierMatrix n))
          = (fourierMatrix n) * A -
              (fourierMatrix n) * ((fourierMatrix n)ᴴ * diagonal d * fourierMatrix n) := by
              simp [Matrix.mul_sub]
      _ = (fourierMatrix n) * A - diagonal d * fourierMatrix n := by
            rw [hcancel]
      _ = (((fourierMatrix n) * A * (fourierMatrix n)ᴴ) * fourierMatrix n) -
            diagonal d * fourierMatrix n := by
            simp [Matrix.mul_assoc, Matrix.fourierMatrix_conjTranspose_mul]
      _ = ((fourierMatrix n) * A * (fourierMatrix n)ᴴ - diagonal d) * fourierMatrix n := by
            simp [Matrix.sub_mul]
  -- Preserve the norm under the two unitary multiplications and reduce to the normalized residual.
  calc
    ‖A - ((fourierMatrix n)ᴴ * diagonal d * fourierMatrix n)‖
        = ‖(fourierMatrix n) * (A - ((fourierMatrix n)ᴴ * diagonal d * fourierMatrix n))‖ := by
            symm
            simpa using Matrix.frobenius_norm_mul_eq_of_mem_unitary
              (Matrix.fourierMatrix_mem_unitaryGroup n)
              (A - ((fourierMatrix n)ᴴ * diagonal d * fourierMatrix n))
    _ = ‖((fourierMatrix n) * A * (fourierMatrix n)ᴴ - diagonal d) * fourierMatrix n‖ := by
          rw [hrewrite]
    _ = ‖(fourierMatrix n) * A * (fourierMatrix n)ᴴ - diagonal d‖ := by
          exact frobeniusNorm_mul_fourier _

/-- Helper for Lemma 5.21: the squared Frobenius residual to `diagonal d` splits into the
off-diagonal residual to `diagonal X.diag` and the diagonal entry errors. -/
lemma diagonalResidual_normSq_split
    {n : ℕ} (X : Matrix (Fin n) (Fin n) ℂ) (d : Fin n → ℂ) :
    ‖X - diagonal d‖ ^ (2 : ℕ) =
      ‖X - diagonal X.diag‖ ^ (2 : ℕ) +
        ∑ i : Fin n, ‖X i i - d i‖ ^ (2 : ℕ) := by
  have hnormSq (M : Matrix (Fin n) (Fin n) ℂ) :
      ‖M‖ ^ (2 : ℕ) = ∑ i, ∑ j, ‖M i j‖ ^ (2 : ℕ) := by
    have hnonneg : 0 ≤ ∑ i, ∑ j, ‖M i j‖ ^ (2 : ℝ) := by
      refine Finset.sum_nonneg ?_
      intro i _
      refine Finset.sum_nonneg ?_
      intro j _
      simp
    -- Rewrite the Frobenius norm through the upstream `rpow (1/2)` formula and square it away.
    rw [Matrix.frobenius_norm_def]
    rw [← Real.sqrt_eq_rpow (∑ i, ∑ j, ‖M i j‖ ^ (2 : ℝ))]
    rw [Real.sq_sqrt hnonneg]
    refine Finset.sum_congr rfl ?_
    intro i _
    refine Finset.sum_congr rfl ?_
    intro j _
    simp
  have hentry (i j : Fin n) :
      ‖(X - diagonal d) i j‖ ^ (2 : ℕ) =
        ‖(X - diagonal X.diag) i j‖ ^ (2 : ℕ) +
          if i = j then ‖X i i - d i‖ ^ (2 : ℕ) else 0 := by
    -- Separate the diagonal entry from the unchanged off-diagonal entries.
    by_cases h : i = j
    · subst h
      simp
    · simp [h]
  have hdiagSum (i : Fin n) :
      ∑ j : Fin n, (if i = j then ‖X i i - d i‖ ^ (2 : ℕ) else 0) =
        ‖X i i - d i‖ ^ (2 : ℕ) := by
    -- Only the diagonal index contributes to the error sum.
    rw [Finset.sum_eq_single i]
    · simp
    · intro j _ hji
      have hij : i ≠ j := fun hij => hji hij.symm
      simp [hij]
    · simp
  -- Compare the residuals entrywise and collapse the diagonal error sum.
  calc
    ‖X - diagonal d‖ ^ (2 : ℕ) = ∑ i, ∑ j, ‖(X - diagonal d) i j‖ ^ (2 : ℕ) := hnormSq _
    _ = ∑ i, ∑ j,
          (‖(X - diagonal X.diag) i j‖ ^ (2 : ℕ) +
            if i = j then ‖X i i - d i‖ ^ (2 : ℕ) else 0) := by
            refine Finset.sum_congr rfl ?_
            intro i _
            refine Finset.sum_congr rfl ?_
            intro j _
            rw [hentry i j]
    _ = (∑ i, ∑ j, ‖(X - diagonal X.diag) i j‖ ^ (2 : ℕ)) +
          ∑ i, ∑ j, (if i = j then ‖X i i - d i‖ ^ (2 : ℕ) else 0) := by
            simp_rw [Finset.sum_add_distrib]
    _ = ‖X - diagonal X.diag‖ ^ (2 : ℕ) +
          ∑ i, ∑ j, (if i = j then ‖X i i - d i‖ ^ (2 : ℕ) else 0) := by
            rw [← hnormSq (X - diagonal X.diag)]
    _ = ‖X - diagonal X.diag‖ ^ (2 : ℕ) +
          ∑ i, ‖X i i - d i‖ ^ (2 : ℕ) := by
            refine congrArg (fun t : ℝ => ‖X - diagonal X.diag‖ ^ (2 : ℕ) + t) ?_
            refine Finset.sum_congr rfl ?_
            intro i _
            exact hdiagSum i

/-- Helper for Lemma 5.21: among diagonal matrices, `diagonal X.diag` is the unique nearest
matrix to `X` in Frobenius norm. -/
lemma diag_eq_of_diagonalResidual_le
    {n : ℕ} (X : Matrix (Fin n) (Fin n) ℂ) {d : Fin n → ℂ}
    (hle : ‖X - diagonal d‖ ≤ ‖X - diagonal X.diag‖) :
    d = X.diag := by
  have hsq_le : ‖X - diagonal d‖ ^ (2 : ℕ) ≤ ‖X - diagonal X.diag‖ ^ (2 : ℕ) := by
    -- Square the norm inequality; both sides are nonnegative.
    nlinarith [hle, norm_nonneg (X - diagonal d), norm_nonneg (X - diagonal X.diag)]
  have hsum_nonneg : 0 ≤ ∑ i : Fin n, ‖X i i - d i‖ ^ (2 : ℕ) := by
    refine Finset.sum_nonneg ?_
    intro i _
    exact sq_nonneg ‖X i i - d i‖
  have hsum_zero : ∑ i : Fin n, ‖X i i - d i‖ ^ (2 : ℕ) = 0 := by
    -- The diagonal-error sum cannot be positive if `diagonal d` is no farther than the minimizer.
    rw [diagonalResidual_normSq_split] at hsq_le
    nlinarith
  ext i
  have hterm_zero : ‖X i i - d i‖ ^ (2 : ℕ) = 0 := by
    exact (Finset.sum_eq_zero_iff_of_nonneg (fun j _ ↦ sq_nonneg ‖X j j - d j‖)).mp hsum_zero i
      (Finset.mem_univ i)
  have hnorm_zero : ‖X i i - d i‖ = 0 := by
    -- Each diagonal error has zero squared norm, hence the error itself vanishes.
    nlinarith [norm_nonneg (X i i - d i), hterm_zero]
  have hentry_zero : X i i - d i = 0 := by
    exact norm_eq_zero.mp hnorm_zero
  have hentry : X i i = d i := by
    rwa [sub_eq_zero] at hentry_zero
  simpa using hentry.symm

/-- Lemma 5.21. If `C` is a best circulant approximation of
`A : Matrix (Fin n) (Fin n) ℂ`, then `C` equals `Matrix.fourierDiagonalProjection A`,
where the book's `Λ` is the diagonal matrix with the same diagonal entries as
`(Matrix.fourierMatrix n) * A * (Matrix.fourierMatrix n)ᴴ`. -/
theorem bestCirculantApproximation_eq_fourierDiagonalProjection
    {n : ℕ} [NeZero n] (A C : Matrix (Fin n) (Fin n) ℂ)
    (hC : IsBestCirculantApproximation A C) :
    C = fourierDiagonalProjection A := by
  let X : Matrix (Fin n) (Fin n) ℂ := (fourierMatrix n) * A * (fourierMatrix n)ᴴ
  rcases exists_fourierDiagonalForm_of_mem_circulantMatrices hC.mem_admissible with ⟨d, hCd⟩
  have hProjection_mem : fourierDiagonalProjection A ∈ circulantMatrices n := by
    -- The Fourier-diagonal truncation is circulant because every Fourier-diagonal matrix is.
    rw [fourierDiagonalProjection_def]
    exact fourierDiagonalForm_mem_circulantMatrices X.diag
  have hOptimal :
      ‖A - ((fourierMatrix n)ᴴ * diagonal d * fourierMatrix n)‖ ≤
        ‖A - fourierDiagonalProjection A‖ := by
    -- Evaluate the minimizer certificate at the Fourier-diagonal truncation candidate.
    have hmin := (isMinOn_iff.mp hC.optimal) (fourierDiagonalProjection A) hProjection_mem
    simpa [circulantApproximationObjective_def, hCd, norm_sub_rev] using hmin
  have hDiag_le : ‖X - diagonal d‖ ≤ ‖X - diagonal X.diag‖ := by
    -- Route correction: transport the circulant optimization problem into Fourier coordinates,
    -- where it becomes the nearest-diagonal problem.
    calc
      ‖X - diagonal d‖
          = ‖A - ((fourierMatrix n)ᴴ * diagonal d * fourierMatrix n)‖ := by
              simpa [X] using (fourierDiagonalResidual_norm_eq A d).symm
      _ ≤ ‖A - fourierDiagonalProjection A‖ := hOptimal
      _ = ‖X - diagonal X.diag‖ := by
            simpa [X, fourierDiagonalProjection_def] using
              fourierDiagonalResidual_norm_eq A X.diag
  have hd : d = X.diag := diag_eq_of_diagonalResidual_le X hDiag_le
  -- Substitute the minimizing diagonal back into the extracted Fourier-diagonal form of `C`.
  simp [X, fourierDiagonalProjection_def, hCd, hd]

end Matrix
