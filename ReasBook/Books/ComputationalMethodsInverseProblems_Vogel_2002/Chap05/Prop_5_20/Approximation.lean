public import ComputationalMethodsInverseProblems_Vogel_2002.Chap05.Definition_5_19
public import ComputationalMethodsInverseProblems_Vogel_2002.Chap05.Definition_5_13
public import ComputationalMethodsInverseProblems_Vogel_2002.Chap05.Prop_5_14

public section

noncomputable section

open scoped Matrix.Norms.Frobenius

namespace Matrix

/-- The generating coefficients of the circulant approximation of a real square matrix,
indexed by `j : Fin n`. -/
@[expose]
def bestCirculantApproximationCoeffs {n : ℕ} (A : Matrix (Fin n) (Fin n) ℝ) : Fin n → ℝ :=
  fun j ↦ (1 / (n : ℝ)) * inner ℝ A (Matrix.circulantRightShift n ^ (j : ℕ))

/-- The coefficient formula for `Matrix.bestCirculantApproximationCoeffs`. -/
@[simp] theorem bestCirculantApproximationCoeffs_apply
    {n : ℕ} (A : Matrix (Fin n) (Fin n) ℝ) (j : Fin n) :
    bestCirculantApproximationCoeffs A j =
      (1 / (n : ℝ)) * inner ℝ A (Matrix.circulantRightShift n ^ (j : ℕ)) := rfl

/-- The circulant approximation of a real square matrix. -/
@[expose]
def bestCirculantApproximation {n : ℕ} (A : Matrix (Fin n) (Fin n) ℝ) :
    Matrix (Fin n) (Fin n) ℝ :=
  Matrix.circulant (bestCirculantApproximationCoeffs A)

/-- `Matrix.bestCirculantApproximation A` is the circulant matrix generated by
`Matrix.bestCirculantApproximationCoeffs A`. -/
theorem bestCirculantApproximation_eq_circulant_coeffs
    {n : ℕ} (A : Matrix (Fin n) (Fin n) ℝ) :
    bestCirculantApproximation A = Matrix.circulant (bestCirculantApproximationCoeffs A) := rfl

/-- The real matrix `Matrix.bestCirculantApproximation A`, viewed over `ℂ`, is circulant. -/
theorem bestCirculantApproximation_mem_circulantMatrices
    {n : ℕ} (A : Matrix (Fin n) (Fin n) ℝ) :
    (bestCirculantApproximation A).map Complex.ofReal ∈ circulantMatrices n := by
  rw [mem_circulantMatrices_iff]
  refine ⟨fun j ↦ Complex.ofReal (bestCirculantApproximationCoeffs A j), ?_⟩
  rw [bestCirculantApproximation_eq_circulant_coeffs, Matrix.map_circulant]

/-- Helper for Proposition 5.20: a complex circulant matrix is the finite linear combination of
the basis matrices `Matrix.circulant (Pi.single j 1)` with its generating coefficients. -/
lemma sum_smul_circulant_single_eq_circulant_complex
    {n : ℕ} (c : Fin n → ℂ) :
    ∑ j : Fin n, c j • Matrix.circulant (Pi.single j (1 : ℂ)) = Matrix.circulant c := by
  classical
  -- Pull `Matrix.circulant` across the finite sum, then collapse the standard-basis expansion.
  have hsum :
      ∀ s : Finset (Fin n),
        ∑ j in s, c j • Matrix.circulant (Pi.single j (1 : ℂ)) =
          Matrix.circulant (fun i ↦ ∑ j in s, (c j • Pi.single j (1 : ℂ)) i) := by
    intro s
    induction s using Finset.induction_on with
    | empty =>
        simp [Matrix.circulant_zero]
    | @insert a s ha ih =>
        simp [ha, ih, Matrix.circulant_add, Matrix.circulant_smul]
  calc
    ∑ j : Fin n, c j • Matrix.circulant (Pi.single j (1 : ℂ))
        = Matrix.circulant (fun i ↦ ∑ j : Fin n, (c j • Pi.single j (1 : ℂ)) i) := by
            simpa using hsum Finset.univ
    _ = Matrix.circulant c := by
        ext i
        simp

/-- Helper for Proposition 5.20: the `j`th power of the complex Chapter 5 right-shift matrix is
the complex circulant basis matrix generated by `Pi.single j 1`. -/
lemma circulantRightShift_pow_eq_circulant_single_complex
    {n : ℕ} (j : Fin n) :
    (Matrix.circulantRightShift (α := ℂ) n) ^ (j : ℕ) = Matrix.circulant (Pi.single j (1 : ℂ)) := by
  -- Complexify the real right-shift basis identity from Proposition 5.14.
  simpa [Matrix.circulantRightShift, Matrix.map_circulant, Matrix.map_pow] using
    congrArg (fun M : Matrix (Fin n) (Fin n) ℝ ↦ M.map Complex.ofReal)
      (Matrix.circulantRightShift_pow_eq_circulant_single (n := n) j)

/-- Helper for Proposition 5.20: a complex circulant matrix is the finite linear combination of
the complex powers of `Matrix.circulantRightShift n` with its generating coefficients. -/
lemma circulant_eq_sum_rightShift_pow_complex
    {n : ℕ} (c : Fin n → ℂ) :
    Matrix.circulant c =
      ∑ j : Fin n, c j • ((Matrix.circulantRightShift (α := ℂ) n) ^ (j : ℕ)) := by
  -- Rewrite the right-shift powers into the complex circulant basis and reassemble the basis sum.
  symm
  calc
    ∑ j : Fin n, c j • ((Matrix.circulantRightShift (α := ℂ) n) ^ (j : ℕ))
        = ∑ j : Fin n, c j • Matrix.circulant (Pi.single j (1 : ℂ)) := by
            refine Finset.sum_congr rfl ?_
            intro j _
            rw [circulantRightShift_pow_eq_circulant_single_complex]
    _ = Matrix.circulant c := sum_smul_circulant_single_eq_circulant_complex c

/-- Helper for Proposition 5.20: complexifying real matrices sends the Frobenius inner product to
`Complex.ofReal`. -/
lemma inner_map_ofReal
    {n : ℕ} (A B : Matrix (Fin n) (Fin n) ℝ) :
    inner ℂ (A.map Complex.ofReal) (B.map Complex.ofReal) = Complex.ofReal (inner ℝ A B) := by
  -- Expand both Frobenius inner products entrywise and compare the resulting finite sums.
  change inner ℂ (WithLp.toLp 2 fun i ↦ WithLp.toLp 2 ((A.map Complex.ofReal) i))
      (WithLp.toLp 2 fun i ↦ WithLp.toLp 2 ((B.map Complex.ofReal) i)) =
    Complex.ofReal
      (inner ℝ (WithLp.toLp 2 fun i ↦ WithLp.toLp 2 (A i))
        (WithLp.toLp 2 fun i ↦ WithLp.toLp 2 (B i)))
  simp_rw [Matrix.map_apply, PiLp.inner_apply, PiLp.toLp_apply, RCLike.inner_apply',
    Complex.conj_ofReal]
  norm_num

/-- Helper for Proposition 5.20: the complexified powers of `Matrix.circulantRightShift n` are
orthogonal for the Frobenius inner product, and each has squared norm `n`. -/
lemma inner_circulantRightShift_powers_complex
    {n : ℕ} (j k : Fin n) :
    inner ℂ (((Matrix.circulantRightShift n : Matrix (Fin n) (Fin n) ℝ) ^ (j : ℕ)).map Complex.ofReal)
      (((Matrix.circulantRightShift n : Matrix (Fin n) (Fin n) ℝ) ^ (k : ℕ)).map Complex.ofReal) =
        if j = k then (n : ℂ) else 0 := by
  -- Reduce the complex inner product to the real Frobenius orthogonality from Proposition 5.14.
  rw [Matrix.circulantRightShift_pow_eq_circulant_single,
    Matrix.circulantRightShift_pow_eq_circulant_single, inner_map_ofReal,
    Matrix.inner_circulant_single_circulant_single]
  simp

/-- Proposition 5.20 together with Definition 5.19: the explicit real-valued matrix
`Matrix.bestCirculantApproximation A`, viewed over `ℂ`, is a best circulant approximation
of `A`. -/
theorem bestCirculantApproximation_isBestCirculantApproximation
    {n : ℕ} (A : Matrix (Fin n) (Fin n) ℝ) :
    IsBestCirculantApproximation (A.map Complex.ofReal)
      ((bestCirculantApproximation A).map Complex.ofReal) := by
  refine ⟨bestCirculantApproximation_mem_circulantMatrices A, ?_⟩
  intro M hM
  rw [mem_circulantMatrices_iff] at hM
  rcases hM with ⟨c, rfl⟩
  let U : Matrix (Fin n) (Fin n) ℂ := A.map Complex.ofReal
  let C : Matrix (Fin n) (Fin n) ℂ := (bestCirculantApproximation A).map Complex.ofReal
  let coeffs : Fin n → ℂ := fun j ↦ Complex.ofReal (bestCirculantApproximationCoeffs A j)
  let basis : Fin n → Matrix (Fin n) (Fin n) ℂ := fun j ↦
    (((Matrix.circulantRightShift n : Matrix (Fin n) (Fin n) ℝ) ^ (j : ℕ)).map Complex.ofReal)
  have hCdecomp : C = ∑ j : Fin n, coeffs j • basis j := by
    -- Expand the candidate circulant matrix in the right-shift basis.
    rw [bestCirculantApproximation_eq_circulant_coeffs, Matrix.map_circulant]
    simpa [C, coeffs, basis] using circulant_eq_sum_rightShift_pow_complex (coeffs)
  have horth_basis : ∀ k : Fin n, inner ℂ (U - C) (basis k) = 0 := by
    intro k
    have hU :
        inner ℂ U (basis k) =
          Complex.ofReal (inner ℝ A ((Matrix.circulantRightShift n) ^ (k : ℕ))) := by
      simpa [U, basis] using inner_map_ofReal A ((Matrix.circulantRightShift n) ^ (k : ℕ))
    have hC_inner :
        inner ℂ C (basis k) = coeffs k * (n : ℂ) := by
      rw [hCdecomp, sum_inner]
      rw [Finset.sum_eq_single k]
      · rw [inner_smul_left, inner_circulantRightShift_powers_complex]
        simp [basis, coeffs]
      · intro j _ hjk
        rw [inner_smul_left, inner_circulantRightShift_powers_complex]
        simp [basis, coeffs, hjk]
      · simp [basis, coeffs]
    have hn_pos : 0 < n := lt_of_le_of_lt (Nat.zero_le k.1) k.2
    have hn_ne : (n : ℝ) ≠ 0 := by
      exact_mod_cast Nat.ne_of_gt hn_pos
    have hcoeff :
        coeffs k * (n : ℂ) = Complex.ofReal (inner ℝ A ((Matrix.circulantRightShift n) ^ (k : ℕ))) := by
      rw [bestCirculantApproximationCoeffs_apply, coeffs, ← Complex.ofReal_mul]
      have hmul :
          ((1 / (n : ℝ)) * inner ℝ A ((Matrix.circulantRightShift n) ^ (k : ℕ))) * (n : ℝ) =
            inner ℝ A ((Matrix.circulantRightShift n) ^ (k : ℕ)) := by
        field_simp [hn_ne]
      simpa [mul_assoc] using congrArg Complex.ofReal hmul
    rw [inner_sub_left, hU, hC_inner, hcoeff]
    simp
  have horth_circulant :
      ∀ d : Fin n → ℂ, inner ℂ (U - C) (Matrix.circulant d) = 0 := by
    intro d
    rw [circulant_eq_sum_rightShift_pow_complex, inner_sum]
    refine Finset.sum_eq_zero ?_
    intro j _
    rw [inner_smul_right, horth_basis j]
    simp
  have horth_C : inner ℂ (U - C) C = 0 := by
    simpa [C, coeffs] using horth_circulant coeffs
  have horth_M : inner ℂ (U - C) (Matrix.circulant c) = 0 := horth_circulant c
  have horth_diff : inner ℂ (U - C) (C - Matrix.circulant c) = 0 := by
    rw [inner_sub_right, horth_C, horth_M]
    simp
  have hsplit : U - Matrix.circulant c = (U - C) + (C - Matrix.circulant c) := by
    abel
  have hsq :
      ‖U - Matrix.circulant c‖ * ‖U - Matrix.circulant c‖ =
        ‖U - C‖ * ‖U - C‖ +
          ‖C - Matrix.circulant c‖ * ‖C - Matrix.circulant c‖ := by
    rw [hsplit]
    exact norm_add_sq_eq_norm_sq_add_norm_sq_of_inner_eq_zero (U - C) (C - Matrix.circulant c)
      horth_diff
  rw [circulantApproximationObjective_def, circulantApproximationObjective_def, norm_sub_rev]
  have hle_sq :
      ‖U - C‖ * ‖U - C‖ ≤ ‖U - Matrix.circulant c‖ * ‖U - Matrix.circulant c‖ := by
    rw [hsq]
    exact le_add_of_nonneg_right (mul_self_nonneg _)
  exact nonneg_le_nonneg_of_sq_le_sq (norm_nonneg _) hle_sq

/-- The complexification of `Matrix.bestCirculantApproximation A` minimizes the
Frobenius-distance objective on circulant matrices. -/
theorem bestCirculantApproximation_isMinOn
    {n : ℕ} (A : Matrix (Fin n) (Fin n) ℝ) :
    IsMinOn (circulantApproximationObjective (A.map Complex.ofReal)) (circulantMatrices n)
      ((bestCirculantApproximation A).map Complex.ofReal) :=
  (bestCirculantApproximation_isBestCirculantApproximation A).optimal

end Matrix
