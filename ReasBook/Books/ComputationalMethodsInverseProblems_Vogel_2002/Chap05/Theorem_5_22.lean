noncomputable section

open scoped Matrix.Norms.Frobenius

namespace Matrix

/-- Helper for Theorem 5.22: left multiplication by the Chapter 5 right-shift matrix sends the
`k`th standard basis vector to the rotated basis vector at `finRotate n k`. -/
lemma circulantRightShiftMulVecSingleReal
    {n : ℕ} (k : Fin n) :
    Matrix.circulantRightShift n *ᵥ Pi.single k (1 : ℝ) = Pi.single (finRotate n k) (1 : ℝ) := by
  ext i
  have hn_pos : 0 < n := lt_of_lt_of_le (Nat.zero_lt_succ i.1) (Nat.succ_le_of_lt i.is_lt)
  -- Local instance justification (index arithmetic): `finRotate_symm_apply` and
  -- `sub_eq_iff_eq_add` on `Fin n` require `[NeZero n]`, and the witness `i : Fin n` supplies
  -- `0 < n`.
  letI : NeZero n := ⟨Nat.ne_of_gt hn_pos⟩
  have hi :=
    congrFun (Matrix.circulantRightShift_mulVec (n := n) (Pi.single k (1 : ℝ))) i
  by_cases h : i = k + 1
  · have hsub : i - 1 = k := by
      simpa using (sub_eq_iff_eq_add.mpr h)
    simp [Function.comp_apply, finRotate_symm_apply, h] at hi ⊢
  · have hsub : i - 1 ≠ k := by
      intro hk
      apply h
      simpa [add_comm] using (sub_eq_iff_eq_add.mp hk)
    simp [Function.comp_apply, finRotate_symm_apply, h, hsub] at hi ⊢

/-- Helper for Theorem 5.22: the `m`th power of the Chapter 5 right-shift matrix sends the `k`th
standard basis vector to the basis vector indexed by `((finRotate n)^[m]) k`. -/
lemma rightShiftPowMulVecSingleReal
    {n : ℕ} (m : ℕ) (k : Fin n) :
    (Matrix.circulantRightShift n ^ m) *ᵥ Pi.single k (1 : ℝ) =
      Pi.single (((finRotate n)^[m]) k) (1 : ℝ) := by
  induction m generalizing k with
  | zero =>
      rw [pow_zero, Matrix.mulVec_single_one]
      ext i
      simp [Matrix.col, Matrix.one_apply, Pi.single_apply]
  | succ m ih =>
      rw [pow_succ', ← Matrix.mulVec_mulVec, ih]
      rw [Function.iterate_succ_apply']
      simpa using circulantRightShiftMulVecSingleReal (n := n) (((finRotate n)^[m]) k)

/-- Helper for Theorem 5.22: the circulant basis matrix generated by `Pi.single j 1` has a single
`1` in each column, located at the row `k + j`. -/
lemma circulantSingleApplyReal
    {n : ℕ} (j i k : Fin n) :
    Matrix.circulant (Pi.single j (1 : ℝ)) i k = if i = k + j then 1 else 0 := by
  have hn_pos : 0 < n := lt_of_lt_of_le (Nat.zero_lt_succ i.1) (Nat.succ_le_of_lt i.is_lt)
  -- Local instance justification (index arithmetic): `sub_eq_iff_eq_add` on `Fin n` requires
  -- `[NeZero n]`, and the witness `i : Fin n` supplies `0 < n`.
  letI : NeZero n := ⟨Nat.ne_of_gt hn_pos⟩
  rw [Matrix.circulant_apply, Pi.single_apply]
  by_cases h : i = k + j
  · have hsub : i - k = j := by
      have h' : i = j + k := by simpa [add_comm] using h
      simpa using (sub_eq_iff_eq_add.mpr h')
    simp [h]
  · have hsub : i - k ≠ j := by
      intro hk
      apply h
      simpa [add_comm] using (sub_eq_iff_eq_add.mp hk)
    simp [h, hsub]

/-- Helper for Theorem 5.22: the `k`th column of the circulant basis matrix generated by
`Pi.single j 1` is the standard basis vector at `k + j`. -/
lemma circulantSingleMulVecSingleReal
    {n : ℕ} (j k : Fin n) :
    Matrix.circulant (Pi.single j (1 : ℝ)) *ᵥ Pi.single k (1 : ℝ) =
      Pi.single (k + j) (1 : ℝ) := by
  rw [Matrix.mulVec_single_one]
  ext i
  simpa [Matrix.col, Pi.single_apply] using circulantSingleApplyReal (j := j) i k

/-- Helper for Theorem 5.22: the `j`th power of the Chapter 5 right-shift matrix is the circulant
basis matrix generated by `Pi.single j 1`. -/
lemma circulantRightShiftPowEqCirculantSingleReal
    {n : ℕ} (j : Fin n) :
    Matrix.circulantRightShift n ^ (j : ℕ) = Matrix.circulant (Pi.single j (1 : ℝ)) := by
  apply Matrix.ext_of_mulVec_single
  intro k
  rw [rightShiftPowMulVecSingleReal, circulantSingleMulVecSingleReal]
  have hcycle : ((finRotate n)^[j.1]) k = k + j := by
    simpa using congrFun (finCycle_eq_finRotate_iterate (k := j)).symm k
  simp [hcycle]

/-- The bundled linear endomorphism underlying `Matrix.bestCirculantApproximation`. -/
def bestCirculantApproximationLinear (n : ℕ) :
    Matrix (Fin n) (Fin n) ℝ →ₗ[ℝ] Matrix (Fin n) (Fin n) ℝ where
  toFun := fun A ↦ bestCirculantApproximation A
  map_add' := by
    intro A B
    -- Compare the two sides on the generating circulant coefficients.
    rw [bestCirculantApproximation_eq_circulant_frobeniusCoeffs,
      bestCirculantApproximation_eq_circulant_frobeniusCoeffs,
      bestCirculantApproximation_eq_circulant_frobeniusCoeffs, ← Matrix.circulant_add,
      Matrix.Fin.circulant_inj]
    ext j
    rw [inner_add_left, mul_add]
    rfl
  map_smul' := by
    intro c A
    -- Compare the two sides on the generating circulant coefficients.
    rw [bestCirculantApproximation_eq_circulant_frobeniusCoeffs,
      bestCirculantApproximation_eq_circulant_frobeniusCoeffs,
      ← Matrix.circulant_smul, Matrix.Fin.circulant_inj]
    ext j
    simp [Pi.smul_apply, inner_smul_left, mul_assoc, mul_comm]

/-- Helper for Theorem 5.22: the `j`th coefficient of the circulant approximation is the average
along the `j`th wrapped diagonal of `A`. -/
lemma bestCirculantApproximationCoeffs_apply_diagonalAverage {n : ℕ}
    (A : Matrix (Fin n) (Fin n) ℝ) (j : Fin n) :
    bestCirculantApproximationCoeffs A j =
      (1 / (n : ℝ)) * ∑ k : Fin n, A (k + j) k := by
  -- Rewrite the right-shift basis matrix into the single-support circulant basis.
  rw [bestCirculantApproximationCoeffs, circulantRightShiftPowEqCirculantSingleReal]
  -- Expand the Frobenius inner product entrywise and collapse each column sum to its supported row.
  rw [Matrix.frobeniusInner_eq_sum_mul]
  rw [Finset.sum_comm]
  have hcol :
      ∀ k : Fin n,
        ∑ i : Fin n, A i k * Matrix.circulant (Pi.single j (1 : ℝ)) i k = A (k + j) k := by
    intro k
    let f : Fin n → ℝ := fun i ↦ A i k * Matrix.circulant (Pi.single j (1 : ℝ)) i k
    change ∑ i : Fin n, f i = A (k + j) k
    calc
      ∑ i : Fin n, f i = f (k + j) := by
        refine Finset.sum_eq_single_of_mem (k + j) (Finset.mem_univ _) ?_
        intro i hi hik
        have hentry : Matrix.circulant (Pi.single j (1 : ℝ)) i k = 0 := by
          rw [circulantSingleApplyReal]
          simp [hik]
        rw [show f i = A i k * Matrix.circulant (Pi.single j (1 : ℝ)) i k by rfl, hentry]
        simp
      _ = A (k + j) k := by
        have hentry : Matrix.circulant (Pi.single j (1 : ℝ)) (k + j) k = 1 := by
          rw [circulantSingleApplyReal]
          simp
        rw [show f (k + j) = A (k + j) k * Matrix.circulant (Pi.single j (1 : ℝ)) (k + j) k by
          rfl, hentry]
        simp
  simp_rw [hcol]

/-- Helper for Theorem 5.22: extracting coefficients from a circulant matrix recovers its
generating vector. -/
lemma bestCirculantApproximationCoeffs_circulant {n : ℕ}
    (c : Fin n → ℝ) :
    bestCirculantApproximationCoeffs (Matrix.circulant c) = c := by
  ext j
  have hn_pos : 0 < n := lt_of_le_of_lt (Nat.zero_le j.1) j.2
  have hn_ne : (n : ℝ) ≠ 0 := by
    exact_mod_cast Nat.ne_of_gt hn_pos
  -- Every wrapped diagonal of a circulant matrix is constant.
  rw [bestCirculantApproximationCoeffs_apply_diagonalAverage]
  have hdiag : ∀ k : Fin n, Matrix.circulant c (k + j) k = c j := by
    intro k
    -- Local instance justification (index arithmetic): `sub_eq_iff_eq_add` on `Fin n` requires
    -- `[NeZero n]`, and the witness `j : Fin n` supplies `0 < n`.
    letI : NeZero n := ⟨Nat.ne_of_gt hn_pos⟩
    rw [Matrix.circulant_apply]
    have hsub : (k + j) - k = j := by
      apply sub_eq_iff_eq_add.mpr
      abel
    simp [hsub]
  simp_rw [hdiag]
  calc
    (1 / (n : ℝ)) * ∑ _k : Fin n, c j = (1 / (n : ℝ)) * ((n : ℝ) * c j) := by simp
    _ = c j := by
        field_simp [hn_ne]

/-- Helper for Theorem 5.22: the circulant approximation of `A` averages each wrapped diagonal
entrywise. -/
lemma bestCirculantApproximation_apply_diagonalAverage {n : ℕ}
    (A : Matrix (Fin n) (Fin n) ℝ) (i j : Fin n) :
    bestCirculantApproximation A i j =
      (1 / (n : ℝ)) * ∑ k : Fin n, A (k + i) (k + j) := by
  have hn_pos : 0 < n := lt_of_lt_of_le (Nat.zero_lt_succ i.1) (Nat.succ_le_of_lt i.is_lt)
  -- Local instance justification (index arithmetic): the `Fin n` subtraction identities used in
  -- the cyclic reindexing step require `[NeZero n]`, and the witness `i : Fin n` supplies `0 < n`.
  letI : NeZero n := ⟨Nat.ne_of_gt hn_pos⟩
  -- Rewrite the circulant output entry through its generating coefficient at `i - j`.
  calc
    bestCirculantApproximation A i j
        = (1 / (n : ℝ)) * ∑ k : Fin n, A (k + (i - j)) k := by
            rw [bestCirculantApproximation_eq_circulant_frobeniusCoeffs, Matrix.circulant_apply]
            simpa [bestCirculantApproximationCoeffs] using
              bestCirculantApproximationCoeffs_apply_diagonalAverage A (i - j)
    _ = (1 / (n : ℝ)) * ∑ k : Fin n, A (k + i) (k + j) := by
          -- Reindex the diagonal-average sum by subtracting `j` from the running index.
          refine congrArg ((1 / (n : ℝ)) * ·) ?_
          let e : Fin n → Fin n := fun k ↦ k - j
          have hleft : Function.LeftInverse (fun x : Fin n ↦ x + j) e := by
            intro x
            simp [e]
          have he : Function.Bijective e := by
            refine ⟨hleft.injective, ?_⟩
            intro k
            refine ⟨k + j, ?_⟩
            simp [e]
          exact Fintype.sum_bijective e he
            (fun k : Fin n ↦ A (k + (i - j)) k)
            (fun k : Fin n ↦ A (k + i) (k + j))
            (fun k ↦ by
              have hcol : e k + j = k := by
                simp [e]
              have hrow : e k + i = k + (i - j) := by
                dsimp [e]
                abel
              rw [hrow, hcol])

/-- Helper for Theorem 5.22: the circulant approximation is the average of all cyclic row-column
reindexings of `A`. -/
lemma bestCirculantApproximation_eq_avg_shiftedSubmatrices {n : ℕ}
    (A : Matrix (Fin n) (Fin n) ℝ) :
    bestCirculantApproximation A =
      (1 / (n : ℝ)) • ∑ k : Fin n, A.submatrix (fun i ↦ k + i) (fun j ↦ k + j) := by
  ext i j
  -- Compare both sides entrywise using the diagonal-average formula and the definition of
  -- `Matrix.submatrix`.
  rw [bestCirculantApproximation_apply_diagonalAverage, Matrix.smul_apply, Matrix.sum_apply]
  rfl

/-- Helper for Theorem 5.22: the circulant approximation fixes every matrix in
`Matrix.circulantSubmodule n`. -/
lemma bestCirculantApproximation_eq_self_of_mem_circulantSubmodule {n : ℕ}
    {A : Matrix (Fin n) (Fin n) ℝ} (hA : A ∈ circulantSubmodule n) :
    bestCirculantApproximation A = A := by
  rcases (mem_circulantSubmodule_iff.mp hA) with ⟨c, rfl⟩
  -- Compare both matrices through the recovered generating coefficients.
  rw [bestCirculantApproximation_eq_circulant_frobeniusCoeffs, Matrix.Fin.circulant_inj]
  change bestCirculantApproximationCoeffs (Matrix.circulant c) = c
  exact bestCirculantApproximationCoeffs_circulant c

/-- Additivity of `Matrix.bestCirculantApproximation`. -/
theorem bestCirculantApproximation_map_add {n : ℕ}
    (A B : Matrix (Fin n) (Fin n) ℝ) :
    bestCirculantApproximation (A + B) =
      bestCirculantApproximation A + bestCirculantApproximation B := by
  exact (bestCirculantApproximationLinear n).map_add' A B

/-- Homogeneity of `Matrix.bestCirculantApproximation`. -/
theorem bestCirculantApproximation_map_smul {n : ℕ}
    (c : ℝ) (A : Matrix (Fin n) (Fin n) ℝ) :
    bestCirculantApproximation (c • A) =
      c • bestCirculantApproximation A := by
  exact (bestCirculantApproximationLinear n).map_smul' c A

/-- The range of `bestCirculantApproximationLinear` is exactly the circulant subspace
`Matrix.circulantSubmodule n`. -/
theorem bestCirculantApproximationLinear_range_eq_circulantSubmodule (n : ℕ) :
    (bestCirculantApproximationLinear n).range = circulantSubmodule n := by
  -- One inclusion is immediate from the definition; the other uses the fixed-point property.
  ext A
  constructor
  · rintro ⟨B, rfl⟩
    exact bestCirculantApproximation_mem_circulantSubmodule B
  · intro hA
    refine ⟨A, ?_⟩
    exact bestCirculantApproximation_eq_self_of_mem_circulantSubmodule hA

/-- Theorem 5.22 (1). The textbook `C(A)` is formalized by
`Matrix.bestCirculantApproximation A`; the bundled map
`bestCirculantApproximationLinear n` is the linear projection onto the circulant subspace
`Matrix.circulantSubmodule n`. -/
theorem bestCirculantApproximation_isProj (n : ℕ) :
    LinearMap.IsProj (circulantSubmodule n) (bestCirculantApproximationLinear n) := by
  refine ⟨?_, ?_⟩
  · -- Every output is circulant by construction.
    intro A
    exact bestCirculantApproximation_mem_circulantSubmodule A
  · -- The projection fixes every point in the circulant subspace.
    intro A hA
    exact bestCirculantApproximation_eq_self_of_mem_circulantSubmodule hA

/-- Theorem 5.22 (2). If `A` is symmetric, then
`Matrix.bestCirculantApproximation A` is symmetric. -/
theorem bestCirculantApproximation_isSymm {n : ℕ}
    {A : Matrix (Fin n) (Fin n) ℝ} (hA : A.IsSymm) :
    (bestCirculantApproximation A).IsSymm := by
  -- Route correction: use the diagonal-average entrywise formula rather than the old
  -- shift-conjugation transport route.
  refine Matrix.IsSymm.ext ?_
  intro i j
  -- Compare the transposed entries through the same wrapped-diagonal average.
  rw [bestCirculantApproximation_apply_diagonalAverage,
    bestCirculantApproximation_apply_diagonalAverage]
  congr 1
  refine Finset.sum_congr rfl ?_
  intro k _
  simpa using hA.apply (k + i) (k + j)

/-- Theorem 5.22 (3). If `A` is positive definite, then
`Matrix.bestCirculantApproximation A` is positive definite. -/
theorem bestCirculantApproximation_posDef {n : ℕ}
    {A : Matrix (Fin n) (Fin n) ℝ} (hA : A.PosDef) :
    (bestCirculantApproximation A).PosDef := by
  -- Route correction: use the shifted-submatrix average interface instead of the older
  -- shift-conjugation proof shape.
  by_cases hn : n = 0
  · subst hn
    -- In the zero-dimensional matrix space every matrix is equal, so the conclusion is immediate.
    have hEq : bestCirculantApproximation A = A := Subsingleton.elim _ _
    simpa [hEq] using hA
  · have hn_pos : 0 < n := Nat.pos_iff_ne_zero.mpr hn
    have hscalar : 0 < (1 / (n : ℝ)) := by
      have hn_real : 0 < (n : ℝ) := by
        exact_mod_cast hn_pos
      exact one_div_pos.mpr hn_real
    have hs : (Finset.univ : Finset (Fin n)).Nonempty := ⟨⟨0, hn_pos⟩, Finset.mem_univ _⟩
    have hshifted :
        ∀ k : Fin n, (A.submatrix (fun i ↦ k + i) (fun j ↦ k + j)).PosDef := by
      intro k
      -- Each cyclic reindexing is a positive-definite submatrix of `A`.
      exact hA.submatrix (e := fun i ↦ k + i) (by
        intro a b hab
        exact add_left_cancel hab)
    have hsum :
        (∑ k : Fin n, A.submatrix (fun i ↦ k + i) (fun j ↦ k + j)).PosDef := by
      -- A nonempty finite sum of positive-definite matrices stays positive definite.
      simpa using
        (Matrix.posDef_sum
          (A := fun k : Fin n ↦ A.submatrix (fun i ↦ k + i) (fun j ↦ k + j))
          (s := Finset.univ) hs (by
            intro k hk
            exact hshifted k))
    have havg :
        ((1 / (n : ℝ)) • ∑ k : Fin n, A.submatrix (fun i ↦ k + i) (fun j ↦ k + j)).PosDef := by
      -- Positive scaling preserves positive definiteness, so the cyclic average also does.
      exact hsum.smul hscalar
    simpa [bestCirculantApproximation_eq_avg_shiftedSubmatrices] using havg

end Matrix
