module

public import ComputationalMethodsInverseProblems_Vogel_2002.Chap05.Definition_5_24.HTTB
public import ComputationalMethodsInverseProblems_Vogel_2002.Chap05.Definition_5_9.PeriodicExtension
public import ComputationalMethodsInverseProblems_Vogel_2002.Chap05.Definition_5_27.BCCB

public section

open scoped Matrix

universe u

namespace Matrix

variable {α : Type u}

/-- Helper for Proposition 5.28: periodic reduction of an integer difference agrees with the
corresponding `Fin` subtraction. -/
theorem periodicIndex_sub_eq_finSub {n : ℕ}
    (h : 0 < n) (i k : Fin n) :
    DiscreteSignal.periodicIndex n h (((i : ℕ) : ℤ) - ((k : ℕ) : ℤ)) = i - k := by
  -- Compare both reduced indices through their residue representatives in `ℤ`.
  apply Fin.ext
  have hsub : ((i - k : Fin n) : ℤ) = ((i : ℤ) - (k : ℤ)) % n :=
    Fin.coe_int_sub_eq_mod i k
  simpa [DiscreteSignal.periodicIndex_val] using congrArg Int.toNat hsub.symm

/-- The HTTB matrix generated by the periodic extension of `c` is `Matrix.bccb c`. -/
theorem httb_periodicExtension_eq_bccb {n_x n_y : ℕ}
    (h_x : 0 < n_x) (h_y : 0 < n_y) (c : Matrix (Fin n_x) (Fin n_y) α) :
    Matrix.httb n_x n_y (Matrix.periodicExtension h_x h_y c) = Matrix.bccb c := by
  -- Compare the two matrix owners entrywise and normalize the periodic indices.
  ext ji lk
  rcases ji with ⟨j, i⟩
  rcases lk with ⟨l, k⟩
  rw [Matrix.httb_apply, Matrix.periodicExtension_apply, Matrix.bccb_apply]
  have hx :
      DiscreteSignal.periodicIndex n_x h_x (((i : ℕ) : ℤ) - ((k : ℕ) : ℤ)) = i - k := by
    -- The row-direction periodic index reduces to `Fin` subtraction.
    simpa using periodicIndex_sub_eq_finSub h_x i k
  have hy :
      DiscreteSignal.periodicIndex n_y h_y (((j : ℕ) : ℤ) - ((l : ℕ) : ℤ)) = j - l := by
    -- The block-direction periodic index reduces in the same way.
    simpa using periodicIndex_sub_eq_finSub h_y j l
  rw [hx, hy]

end Matrix
