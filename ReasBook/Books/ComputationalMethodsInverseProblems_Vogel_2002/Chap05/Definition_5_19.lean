module

public import Mathlib.Analysis.Matrix.Normed
public import Mathlib.LinearAlgebra.Matrix.Circulant
public import Mathlib.Order.Filter.Extr

public section

noncomputable section

open scoped Matrix.Norms.Frobenius

namespace Matrix

/-- The admissible set `𝒞_n` of complex circulant `n × n` matrices. -/
def circulantMatrices (n : ℕ) : Set (Matrix (Fin n) (Fin n) ℂ) :=
  Set.range (Matrix.circulant : (Fin n → ℂ) → Matrix (Fin n) (Fin n) ℂ)

/-- A matrix belongs to `circulantMatrices n` exactly when it is generated by some vector via
`Matrix.circulant`. -/
theorem mem_circulantMatrices_iff {n : ℕ} {C : Matrix (Fin n) (Fin n) ℂ} :
    C ∈ circulantMatrices n ↔ ∃ c : Fin n → ℂ, Matrix.circulant c = C := by
  rfl

/-- The Frobenius-norm objective for approximating `A` by a circulant matrix `C`. -/
@[expose] def circulantApproximationObjective
    {n : ℕ} (A : Matrix (Fin n) (Fin n) ℂ) : Matrix (Fin n) (Fin n) ℂ → ℝ :=
  fun C ↦ ‖C - A‖

/-- The defining formula for `circulantApproximationObjective`. -/
theorem circulantApproximationObjective_def
    {n : ℕ} (A C : Matrix (Fin n) (Fin n) ℂ) :
    circulantApproximationObjective A C = ‖C - A‖ :=
  rfl

/-- Definition 5.19. A matrix `C` is a best circulant approximation of
`A : Matrix (Fin n) (Fin n) ℂ` when `C` is circulant and minimizes
`‖C - A‖` on `circulantMatrices n`. -/
structure IsBestCirculantApproximation
    {n : ℕ} (A C : Matrix (Fin n) (Fin n) ℂ) : Prop where
  /-- The candidate matrix is circulant. -/
  mem_admissible : C ∈ circulantMatrices n
  /-- The candidate minimizes the Frobenius-norm objective on the circulant matrices. -/
  optimal : IsMinOn (circulantApproximationObjective A) (circulantMatrices n) C

namespace IsBestCirculantApproximation

set_option linter.defProp false in
/-- Construct a best-circulant-approximation certificate from admissibility and optimality. -/
def ofMemOptimal
    {n : ℕ} {A C : Matrix (Fin n) (Fin n) ℂ}
    (h_mem : C ∈ circulantMatrices n)
    (h_opt : IsMinOn (circulantApproximationObjective A) (circulantMatrices n) C) :
    IsBestCirculantApproximation A C :=
  ⟨h_mem, h_opt⟩

end IsBestCirculantApproximation

/-- The defining characterization of `IsBestCirculantApproximation`. -/
theorem isBestCirculantApproximation_iff
    {n : ℕ} (A C : Matrix (Fin n) (Fin n) ℂ) :
    IsBestCirculantApproximation A C ↔
      C ∈ circulantMatrices n ∧
        IsMinOn (circulantApproximationObjective A) (circulantMatrices n) C := by
  constructor
  · intro h
    exact ⟨h.mem_admissible, h.optimal⟩
  · rintro ⟨h_mem, h_opt⟩
    exact ⟨h_mem, h_opt⟩

/-- A best circulant approximation is circulant. -/
theorem isBestCirculantApproximation_mem
    {n : ℕ} {A C : Matrix (Fin n) (Fin n) ℂ}
    (h : IsBestCirculantApproximation A C) :
    C ∈ circulantMatrices n :=
  h.mem_admissible

/-- A best circulant approximation minimizes the Frobenius-distance objective on
`circulantMatrices n`. -/
theorem isBestCirculantApproximation_isMinOn
    {n : ℕ} {A C : Matrix (Fin n) (Fin n) ℂ}
    (h : IsBestCirculantApproximation A C) :
    IsMinOn (circulantApproximationObjective A) (circulantMatrices n) C :=
  h.optimal

end Matrix
