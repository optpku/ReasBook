module

public import ComputationalMethodsInverseProblems_Vogel_2002.Chap05.Definition_5_27.BCCB
public import ComputationalMethodsInverseProblems_Vogel_2002.Chap05.Notation_5_2_2
public import Mathlib.LinearAlgebra.Eigenspace.Matrix

public section

open Module.End
open scoped Kronecker Matrix

namespace Matrix

/-- Proposition 5.31 (1). The BCCB matrix generated by `c` is diagonalized by the
Kronecker product of the Chapter 5 Fourier matrices, with diagonal entries
`vec (fft2 n_x n_y c)`. -/
theorem bccb_eq_fourierDiagonalization {n_x n_y : ℕ} [NeZero n_x] [NeZero n_y]
    (c : Matrix (Fin n_x) (Fin n_y) ℂ) :
    bccb c =
      (((fourierMatrix n_y) ⊗ₖ (fourierMatrix n_x))ᴴ) *
        diagonal (vec (fft2 n_x n_y c)) *
        ((fourierMatrix n_y) ⊗ₖ (fourierMatrix n_x)) := by
  let F : Matrix (Fin n_y × Fin n_x) (Fin n_y × Fin n_x) ℂ :=
    (fourierMatrix n_y) ⊗ₖ (fourierMatrix n_x)
  have hdiag :
      F * bccb c =
        diagonal (vec (fft2 n_x n_y c)) * F := by
    rw [bccb_eq_circulant_vec]
    simpa [F] using
      kronFourier_mul_circulantVec_eq_diagonal_vec_fft2_mul n_x n_y c
  have hunit : Fᴴ * F = 1 := by
    calc
      Fᴴ * F
          =
            (((fourierMatrix n_y)ᴴ) ⊗ₖ ((fourierMatrix n_x)ᴴ)) *
              (((fourierMatrix n_y) ⊗ₖ (fourierMatrix n_x))) := by
                simp [F, conjTranspose_kronecker]
      _ =
          (((fourierMatrix n_y)ᴴ * fourierMatrix n_y) ⊗ₖ
            (((fourierMatrix n_x)ᴴ * fourierMatrix n_x))) := by
              rw [mul_kronecker_mul]
      _ = (1 : Matrix (Fin n_y) (Fin n_y) ℂ) ⊗ₖ (1 : Matrix (Fin n_x) (Fin n_x) ℂ) := by
              rw [fourierMatrix_conjTranspose_mul, fourierMatrix_conjTranspose_mul]
      _ = 1 := by
              rw [one_kronecker_one]
  calc
    bccb c = 1 * bccb c := by simp
    _ = (Fᴴ * F) * bccb c := by rw [hunit]
    _ = Fᴴ * (F * bccb c) := by rw [mul_assoc]
    _ = Fᴴ * (diagonal (vec (fft2 n_x n_y c)) * F) := by rw [hdiag]
    _ = Fᴴ * diagonal (vec (fft2 n_x n_y c)) * F := by rw [mul_assoc]

/-- Proposition 5.31 (2), canonical product-index form: the eigenvalues of `bccb c`
are exactly the entries of `vec (fft2 n_x n_y c)`. -/
theorem bccb_hasEigenvalue_iff_vec {n_x n_y : ℕ} [NeZero n_x] [NeZero n_y]
    (c : Matrix (Fin n_x) (Fin n_y) ℂ) (μ : ℂ) :
    HasEigenvalue (toLin' (bccb c)) μ ↔
      ∃ q : Fin n_y × Fin n_x, vec (fft2 n_x n_y c) q = μ := by
  let F : Matrix (Fin n_y × Fin n_x) (Fin n_y × Fin n_x) ℂ :=
    (fourierMatrix n_y) ⊗ₖ (fourierMatrix n_x)
  let d : Fin n_y × Fin n_x → ℂ := vec (fft2 n_x n_y c)
  have hFhF : Fᴴ * F = 1 := by
    calc
      Fᴴ * F
          =
            (((fourierMatrix n_y)ᴴ) ⊗ₖ ((fourierMatrix n_x)ᴴ)) *
              (((fourierMatrix n_y) ⊗ₖ (fourierMatrix n_x))) := by
                simp [F, conjTranspose_kronecker]
      _ =
          (((fourierMatrix n_y)ᴴ * fourierMatrix n_y) ⊗ₖ
            (((fourierMatrix n_x)ᴴ * fourierMatrix n_x))) := by
              rw [mul_kronecker_mul]
      _ = (1 : Matrix (Fin n_y) (Fin n_y) ℂ) ⊗ₖ (1 : Matrix (Fin n_x) (Fin n_x) ℂ) := by
              rw [fourierMatrix_conjTranspose_mul, fourierMatrix_conjTranspose_mul]
      _ = 1 := by
              rw [one_kronecker_one]
  have hFFh : F * Fᴴ = 1 := by
    exact Matrix.mem_unitaryGroup_iff.mp <| Matrix.mem_unitaryGroup_iff'.mpr hFhF
  let u : (Matrix (Fin n_y × Fin n_x) (Fin n_y × Fin n_x) ℂ)ˣ :=
    ⟨F, Fᴴ, hFFh, hFhF⟩
  rw [hasEigenvalue_iff_mem_spectrum, Matrix.spectrum_toLin']
  calc
    μ ∈ spectrum ℂ (bccb c) ↔ μ ∈ spectrum ℂ (Fᴴ * diagonal d * F) := by
      rw [bccb_eq_fourierDiagonalization]
    _ ↔ μ ∈ spectrum ℂ (diagonal d) := by
      have hconj : spectrum ℂ (u⁻¹ * diagonal d * u) = spectrum ℂ (diagonal d) :=
        spectrum.units_conjugate'
      simpa [u] using congrArg (fun s ↦ μ ∈ s) hconj
    _ ↔ HasEigenvalue (toLin' (diagonal d)) μ := by
      rw [← Matrix.spectrum_toLin', hasEigenvalue_iff_mem_spectrum]
    _ ↔ ∃ q : Fin n_y × Fin n_x, d q = μ := by
      simpa only [d] using hasEigenvalue_toLin'_diagonal_iff d

/-- Proposition 5.31 (2). The entries of `fft2 n_x n_y c` are exactly the
eigenvalues of `bccb c`. -/
theorem bccb_hasEigenvalue_iff {n_x n_y : ℕ} [NeZero n_x] [NeZero n_y]
    (c : Matrix (Fin n_x) (Fin n_y) ℂ) (μ : ℂ) :
    HasEigenvalue (toLin' (bccb c)) μ ↔
      ∃ i : Fin n_x, ∃ j : Fin n_y, fft2 n_x n_y c i j = μ := by
  constructor
  · intro hμ
    rcases (bccb_hasEigenvalue_iff_vec c μ).mp hμ with ⟨⟨j, i⟩, hij⟩
    exact ⟨i, j, by simpa [vec] using hij⟩
  · rintro ⟨i, j, hij⟩
    exact (bccb_hasEigenvalue_iff_vec c μ).mpr ⟨(j, i), by simpa [vec] using hij⟩

end Matrix
