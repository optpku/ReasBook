module

public import ComputationalMethodsInverseProblems_Vogel_2002.Chap05.Definition_5_25.Array
public import Mathlib.LinearAlgebra.Matrix.Circulant

public section

open scoped Matrix

universe u

namespace Matrix

variable {α : Type u}

/-- The block-circulant with circulant-blocks matrix generated by `c`. -/
def bccb {n_x n_y : ℕ} (c : Matrix (Fin n_x) (Fin n_y) α) :
    Matrix (Fin n_y × Fin n_x) (Fin n_y × Fin n_x) α :=
  Matrix.circulant c.vec

/-- Entrywise formula for `Matrix.bccb`. -/
theorem bccb_apply {n_x n_y : ℕ} (c : Matrix (Fin n_x) (Fin n_y) α)
    (j l : Fin n_y) (i k : Fin n_x) :
    Matrix.bccb c (j, i) (l, k) = c (i - k) (j - l) := by
  -- Unfold the BCCB owner and evaluate its underlying circulant entry.
  simp [Matrix.bccb, Matrix.circulant_apply]

/-- `Matrix.bccb` is the product-index circulant generated by `Matrix.vec c`. -/
@[simp] theorem bccb_eq_circulant_vec {n_x n_y : ℕ} (c : Matrix (Fin n_x) (Fin n_y) α) :
    Matrix.bccb c = Matrix.circulant c.vec := by
  ext q r
  rcases q with ⟨j, i⟩
  rcases r with ⟨l, k⟩
  rw [Matrix.bccb_apply, Matrix.circulant_apply]
  rfl

/-- BCCB entries agree whenever the block and in-block index differences agree. -/
theorem bccb_apply_eq_of_sub_eq_sub {n_x n_y : ℕ} (c : Matrix (Fin n_x) (Fin n_y) α)
    {j₁ l₁ j₂ l₂ : Fin n_y} {i₁ k₁ i₂ k₂ : Fin n_x}
    (h_x : i₁ - k₁ = i₂ - k₂) (h_y : j₁ - l₁ = j₂ - l₂) :
    Matrix.bccb c (j₁, i₁) (l₁, k₁) = Matrix.bccb c (j₂, i₂) (l₂, k₂) := by
  simp [Matrix.bccb_apply, h_x, h_y]

/-- The first column of `Matrix.bccb c` is the generating vector `Matrix.vec c`. -/
theorem bccb_col_zero {n_x n_y : ℕ} [NeZero n_x] [NeZero n_y]
    (c : Matrix (Fin n_x) (Fin n_y) α) :
    (Matrix.bccb c).col 0 = c.vec := by
  -- Compare the first column entrywise and use the first-column formula for circulant matrices.
  ext ij
  rw [Matrix.col_apply, Matrix.bccb, Matrix.circulant_col_zero_eq]

/-- Reconstructing the generating array from the first column of `Matrix.bccb c`
with `Matrix.of` recovers `c`. -/
theorem of_bccb_col_zero {n_x n_y : ℕ} [NeZero n_x] [NeZero n_y]
    (c : Matrix (Fin n_x) (Fin n_y) α) :
    Matrix.of (fun i j ↦ ((Matrix.bccb c).col 0) (j, i)) = c := by
  -- First identify the first column with `c.vec`, then cancel `Matrix.of` against `Matrix.vec`.
  rw [Matrix.bccb_col_zero, Matrix.of_vec]

/-- Entrywise formula for the `(j,l)` block of `Matrix.bccb c`. -/
theorem bccb_block_apply {n_x n_y : ℕ} (c : Matrix (Fin n_x) (Fin n_y) α)
    (j l : Fin n_y) (i k : Fin n_x) :
    (Matrix.bccb c).submatrix (fun i' ↦ (j, i')) (fun k' ↦ (l, k')) i k =
      c (i - k) (j - l) := by
  -- Evaluating the selected block entry just specializes the global BCCB entry formula.
  simp [Matrix.submatrix_apply]

/-- The `j`th block in the first block column of `Matrix.bccb c` is `Matrix.circulant (c.col j)`. -/
theorem bccb_block_zero_eq_circulant {n_x n_y : ℕ} [NeZero n_y]
    (c : Matrix (Fin n_x) (Fin n_y) α) (j : Fin n_y) :
    (Matrix.bccb c).submatrix (fun i ↦ (j, i)) (fun k ↦ (0, k)) =
      Matrix.circulant (c.col j) := by
  -- Compare the block and circulant entries, then normalize `j - 0` to `j`.
  ext i k
  rw [Matrix.circulant_apply]
  simp

end Matrix
