module

public import ComputationalMethodsInverseProblems_Vogel_2002.Chap05.Definition_5_11.Toeplitz

public section

universe u

namespace Matrix

variable {α : Type u}

/-- The block Toeplitz with Toeplitz blocks matrix generated by an integer-indexed kernel `t`. -/
def bttb (n_x n_y : ℕ) (t : ℤ → ℤ → α) :
    Matrix (Fin n_y × Fin n_x) (Fin n_y × Fin n_x) α :=
  fun (ji : Fin n_y × Fin n_x) (lk : Fin n_y × Fin n_x) ↦
    t (((ji.2 : ℕ) : ℤ) - ((lk.2 : ℕ) : ℤ)) (((ji.1 : ℕ) : ℤ) - ((lk.1 : ℕ) : ℤ))

/-- Entrywise formula for `Matrix.bttb`. -/
theorem bttb_apply {n_x n_y : ℕ} (t : ℤ → ℤ → α)
    (j l : Fin n_y) (i k : Fin n_x) :
    Matrix.bttb n_x n_y t (j, i) (l, k) =
      t (((i : ℕ) : ℤ) - ((k : ℕ) : ℤ)) (((j : ℕ) : ℤ) - ((l : ℕ) : ℤ)) := by
  simp [Matrix.bttb]

/-- Each `(j, l)` block of `Matrix.bttb n_x n_y t` is the Toeplitz matrix
`Matrix.toeplitzByDiag n_x (fun d ↦ t d (((j : ℕ) : ℤ) - ((l : ℕ) : ℤ)))`. -/
theorem bttb_block_eq_toeplitzByDiag {n_x n_y : ℕ} (t : ℤ → ℤ → α) (j l : Fin n_y) :
    (Matrix.bttb n_x n_y t).submatrix (fun i ↦ (j, i)) (fun k ↦ (l, k)) =
      Matrix.toeplitzByDiag n_x (fun d : ℤ ↦ t d (((j : ℕ) : ℤ) - ((l : ℕ) : ℤ))) := by
  ext i k
  simp [Matrix.bttb_apply, Matrix.toeplitzByDiag_apply]

end Matrix
