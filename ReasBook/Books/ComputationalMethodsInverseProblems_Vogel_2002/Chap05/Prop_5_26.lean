module

public import ComputationalMethodsInverseProblems_Vogel_2002.Chap05.Definition_5_8.Convolution2D

public section

open scoped Matrix

namespace Matrix

/-- Vectorizing the two-dimensional discrete convolution recovers the canonical
BTTB matrix-vector action generated by the same kernel. -/
theorem vec_discreteConvolution2D_eq_bttb_mulVec {n_x n_y : ℕ} (t : ℤ → ℤ → ℂ)
    (f : Matrix (Fin n_x) (Fin n_y) ℂ) :
    (discreteConvolution2D t f).vec = bttb n_x n_y t *ᵥ f.vec := by
  simpa [httb] using vec_discreteConvolution2D t f

/-- Proposition 5.26. The two-dimensional convolution product `(5.25)` is the
reconstruction of the vectorized action of the BTTB matrix generated by the
same kernel. -/
theorem discreteConvolution2D_eq_of_bttb_mulVec {n_x n_y : ℕ}
    (t : ℤ → ℤ → ℂ) (f : Matrix (Fin n_x) (Fin n_y) ℂ) :
    discreteConvolution2D t f = Matrix.of fun i j ↦ (bttb n_x n_y t *ᵥ f.vec) (j, i) := by
  rw [← Matrix.of_vec (discreteConvolution2D t f)]
  congr
  funext i
  funext j
  exact congrFun (vec_discreteConvolution2D_eq_bttb_mulVec t f) (j, i)

end Matrix
