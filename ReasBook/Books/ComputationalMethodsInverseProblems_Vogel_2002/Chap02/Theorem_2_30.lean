universe u

open Filter

variable {H : Type u} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]

/-- Helper for Theorem 2.30: the closed span of a sequence in a real Hilbert space is separable. -/
lemma closedSpanRange_separableSpace {f : ℕ → H} :
    TopologicalSpace.SeparableSpace
      ((Submodule.span ℝ (Set.range f)).topologicalClosure : Submodule ℝ H) := by
  -- We identify the closed span with the closure of a separable span generated by a countable set.
  change TopologicalSpace.SeparableSpace
    (closure (((Submodule.span ℝ (Set.range f) : Submodule ℝ H) : Set H)))
  have hsepRange : TopologicalSpace.IsSeparable (Set.range f : Set H) := by
    exact Set.Countable.isSeparable (Set.countable_range f)
  have hsepSpan :
      TopologicalSpace.IsSeparable
        ((Submodule.span ℝ (Set.range f) : Submodule ℝ H) : Set H) := by
    exact hsepRange.span
  exact hsepSpan.closure.separableSpace

/-- Helper for Theorem 2.30: a weak-* convergent sequence of Riesz representatives yields a weakly
convergent sequence in the Hilbert space itself. -/
lemma weakSeqTendsto_of_tendsto_toWeakDual_toDual
    {K : Type*} [NormedAddCommGroup K] [InnerProductSpace ℝ K] [CompleteSpace K]
    {u : ℕ → K} {L : WeakDual ℝ K}
    (h :
      Filter.Tendsto
        (fun n ↦ StrongDual.toWeakDual (InnerProductSpace.toDual ℝ K (u n)))
        Filter.atTop (nhds L)) :
    weakSeqTendsto u ((InnerProductSpace.toDual ℝ K).symm (WeakDual.toStrongDual L)) := by
  -- We test the weak-* convergence against each evaluation map.
  rw [weakSeqTendsto_iff_forall_inner_tendsto]
  intro g
  simpa [Function.comp_def, InnerProductSpace.toDual_symm_apply] using
    ((WeakDual.eval_continuous (𝕜 := ℝ) g).tendsto L).comp h

/-- Helper for Theorem 2.30: weak convergence in a subspace implies weak convergence of the same
sequence in the ambient Hilbert space. -/
lemma weakSeqTendsto_subtype_val {K : Submodule ℝ H} {u : ℕ → K} {x : K}
    (h : weakSeqTendsto u x) : weakSeqTendsto (fun n ↦ (u n : H)) (x : H) := by
  -- We compose each ambient functional with the subtype inclusion.
  rw [weakSeqTendsto_iff_forall_dual_apply_tendsto] at h ⊢
  intro ℓ
  simpa [Function.comp_def] using h (ℓ.comp K.subtypeL)

/-- Helper for Theorem 2.30: a weak sequential limit of points in a closed convex set remains in
that set. -/
lemma mem_closedConvex_of_weakSeqTendsto {C : Set H} (hC_closed : IsClosed C)
    (hC_convex : Convex ℝ C) {f : ℕ → H} {fStar : H} (hf : weakSeqTendsto f fStar)
    (hf_mem : ∀ n, f n ∈ C) : fStar ∈ C := by
  -- The weak limit lies in the weak closure of `C`, and closed convex sets are weakly closed.
  rw [weakSeqTendsto_iff] at hf
  have hlimit : toWeakSpace ℝ H fStar ∈ closure ((toWeakSpace ℝ H) '' C) := by
    exact mem_closure_of_tendsto hf (Filter.Eventually.of_forall fun n ↦ ⟨f n, hf_mem n, rfl⟩)
  have hclosure :
      closure ((toWeakSpace ℝ H) '' C) = (toWeakSpace ℝ H) '' C := by
    simpa [hC_closed.closure_eq] using (hC_convex.toWeakSpace_closure (𝕜 := ℝ)).symm
  rcases hclosure ▸ hlimit with ⟨x, hxC, hxEq⟩
  exact (toWeakSpace ℝ H).injective hxEq ▸ hxC

/-- Helper for Theorem 2.30: if `J ∘ f` is bounded above and `J` is coercive, then `f` is
norm-bounded. -/
lemma exists_norm_le_of_coercive_of_bddAbove {J : H → ℝ} {f : ℕ → H}
    (hJ_coercive : coercive J) (hJ_bdd : BddAbove (Set.range fun n ↦ J (f n))) :
    ∃ R, ∀ n, ‖f n‖ ≤ R := by
  rcases hJ_bdd with ⟨A, hA⟩
  by_contra hBound
  have hunboundedTail : ∀ N : ℝ, ∀ m : ℕ, ∃ n ≥ m, N ≤ ‖f n‖ := by
    intro N m
    by_contra h
    push Not at h
    have htail : ∀ n, m ≤ n → ‖f n‖ < N := by
      intro n hn
      exact h n hn
    let R : ℝ := max N (Finset.sum (Finset.range m) fun i => ‖f i‖)
    have hR : ∀ n, ‖f n‖ ≤ R := by
      intro n
      by_cases hn : n < m
      · calc
          ‖f n‖ ≤ Finset.sum (Finset.range m) fun i => ‖f i‖ := by
            exact Finset.single_le_sum
              (fun i _ => norm_nonneg _)
              (by simpa using Finset.mem_range.mpr hn)
          _ ≤ R := le_max_right _ _
      · have hm : m ≤ n := Nat.le_of_not_gt hn
        exact (le_of_lt (htail n hm)).trans (le_max_left _ _)
    exact hBound ⟨R, hR⟩
  let φ : ℕ → ℕ :=
    Nat.rec (Classical.choose (hunboundedTail 0 0))
      (fun n prev =>
        Classical.choose (hunboundedTail ((n : ℝ) + 1) (prev + 1)))
  have hφ_norm : ∀ n : ℕ, (n : ℝ) ≤ ‖f (φ n)‖ := by
    intro n
    induction n with
    | zero =>
        simpa [φ] using (Classical.choose_spec (hunboundedTail 0 0)).2
    | succ n ih =>
        have h1 :=
          (Classical.choose_spec
            (hunboundedTail ((n : ℝ) + 1) (φ n + 1))).2
        simpa [Nat.cast_add, φ] using h1
  have hnorm_top : Tendsto (fun n ↦ ‖f (φ n)‖) atTop atTop := by
    -- The extracted tail witnesses force the norms to diverge to `∞`.
    refine tendsto_atTop.2 ?_
    intro b
    obtain ⟨N, hN⟩ := exists_nat_ge b
    exact mem_atTop_sets.2 ⟨N, fun n hn =>
      le_trans hN <| le_trans (by exact_mod_cast hn) (hφ_norm n)⟩
  have hJ_top : Tendsto (fun n ↦ J (f (φ n))) atTop atTop :=
    (coercive_iff.mp hJ_coercive) hnorm_top
  have hEventually : ∀ᶠ n in atTop, A + 1 ≤ J (f (φ n)) :=
    (tendsto_atTop.1 hJ_top) (A + 1)
  rcases mem_atTop_sets.1 hEventually with ⟨N, hN⟩
  have hN' : A + 1 ≤ J (f (φ N)) := hN N le_rfl
  have hAφ : J (f (φ N)) ≤ A := hA ⟨φ N, rfl⟩
  linarith

/-- Helper for Theorem 2.30: every norm-bounded sequence in a real Hilbert space has a weakly
convergent subsequence. -/
lemma exists_strictMono_subseq_weakSeqTendsto_of_bounded {f : ℕ → H}
    (hf_bdd : ∃ R, ∀ n, ‖f n‖ ≤ R) :
    ∃ φ : ℕ → ℕ, StrictMono φ ∧ ∃ fStar : H, weakSeqTendsto (f ∘ φ) fStar := by
  obtain ⟨R, hR⟩ := hf_bdd
  let K : Submodule ℝ H := (Submodule.span ℝ (Set.range f)).topologicalClosure
  let u : ℕ → K := fun n ↦
    ⟨f n,
      (Submodule.span ℝ (Set.range f)).le_topologicalClosure
        (Submodule.subset_span (Set.mem_range_self n))⟩
  haveI : TopologicalSpace.SeparableSpace K := closedSpanRange_separableSpace
  have hv_mem : ∀ n,
      StrongDual.toWeakDual (InnerProductSpace.toDual ℝ K (u n)) ∈
        WeakDual.toStrongDual ⁻¹' Metric.closedBall (0 : StrongDual ℝ K) R := by
    intro n
    -- We place the Riesz representatives inside a weak-* sequentially compact ball.
    change InnerProductSpace.toDual ℝ K (u n) ∈
      Metric.closedBall (0 : StrongDual ℝ K) R
    simpa [Metric.mem_closedBall, u] using hR n
  obtain ⟨L, hLmem, φ, hφ, hTendsto⟩ :=
    WeakDual.isSeqCompact_closedBall (𝕜 := ℝ) (E := K) (0 : StrongDual ℝ K) R
      (fun n ↦ hv_mem n)
  have huWeak :
      weakSeqTendsto (u ∘ φ)
        ((InnerProductSpace.toDual ℝ K).symm (WeakDual.toStrongDual L)) :=
    weakSeqTendsto_of_tendsto_toWeakDual_toDual hTendsto
  refine ⟨φ, hφ, ((InnerProductSpace.toDual ℝ K).symm (WeakDual.toStrongDual L) : K), ?_⟩
  -- We finally forget the closed-span subtype and return to the ambient Hilbert space.
  simpa [u, Function.comp_def] using weakSeqTendsto_subtype_val huWeak

/-- Theorem 2.30 (1). If `J : H → ℝ` is weakly lower semicontinuous and coercive, and `C` is a
nonempty closed convex subset of `H`, then `J` attains a minimum on `C`. -/
theorem exists_isMinOn_of_weakLowerSemicontinuous_of_coercive
    (J : H → ℝ) {C : Set H} (hC_nonempty : C.Nonempty) (hC_closed : IsClosed C)
    (hC_convex : Convex ℝ C) (hJ_wlsc : weakLowerSemicontinuous J) (hJ_coercive : coercive J) :
    ∃ fStar ∈ C, IsMinOn J C fStar := by
  rw [weakLowerSemicontinuous_iff] at hJ_wlsc
  have hImage_nonempty : (J '' C).Nonempty := by
    rcases hC_nonempty with ⟨x, hx⟩
    exact ⟨J x, ⟨x, hx, rfl⟩⟩
  have hImage_bddBelow : BddBelow (J '' C) := by
    by_contra hNot
    rw [not_bddBelow_iff] at hNot
    have hNegApprox : ∀ n : ℕ, ∃ x ∈ C, J x < -(n : ℝ) := by
      intro n
      rcases hNot (-(n : ℝ)) with ⟨y, hyImage, hyLt⟩
      rcases hyImage with ⟨x, hxC, rfl⟩
      exact ⟨x, hxC, hyLt⟩
    choose g hgMem hgLt using hNegApprox
    have hgJ_bdd : BddAbove (Set.range fun n ↦ J (g n)) := by
      refine ⟨0, ?_⟩
      rintro _ ⟨n, rfl⟩
      linarith [hgLt n]
    obtain ⟨R, hR⟩ :=
      exists_norm_le_of_coercive_of_bddAbove hJ_coercive hgJ_bdd
    obtain ⟨φ, hφ, gStar, hgWeak⟩ :=
      exists_strictMono_subseq_weakSeqTendsto_of_bounded ⟨R, hR⟩
    have hφge : ∀ n, n ≤ φ n := fun n => StrictMono.id_le hφ n
    have hRealBot : Tendsto (fun n ↦ J (g (φ n))) atTop atBot := by
      -- The negative sequence still tends to `-∞` after passing to the subsequence.
      refine tendsto_atBot.2 ?_
      intro b
      obtain ⟨N, hN⟩ := exists_nat_ge (-b)
      exact mem_atTop_sets.2 ⟨N, fun n hn => by
        have hNφ : (N : ℝ) ≤ φ n := by
          exact_mod_cast le_trans hn (hφge n)
        have hnegφ : -((φ n : ℝ)) ≤ b := by
          linarith
        exact (hgLt (φ n)).le.trans hnegφ⟩
    have hBot : Tendsto (fun n ↦ (J (g (φ n)) : EReal)) atTop (nhds ⊥) := by
      rw [EReal.tendsto_coe_nhds_bot_iff]
      exact hRealBot
    have hLiminf : Filter.liminf (fun n ↦ (J (g (φ n)) : EReal)) atTop = ⊥ :=
      Filter.Tendsto.liminf_eq hBot
    have hwlsc := hJ_wlsc hgWeak
    simpa [hLiminf] using hwlsc
  let m : ℝ := sInf (J '' C)
  have hApprox : ∀ n : ℕ, ∃ x ∈ C, J x < m + 1 / (n + 1 : ℝ) := by
    intro n
    have hpos : (0 : ℝ) < n + 1 := by
      exact_mod_cast Nat.succ_pos n
    have hlt : m < m + 1 / (n + 1 : ℝ) := by
      have hpos' : (0 : ℝ) < 1 / (n + 1 : ℝ) := one_div_pos.mpr hpos
      linarith
    rcases exists_lt_of_csInf_lt hImage_nonempty hlt with ⟨y, hyImage, hyLt⟩
    rcases hyImage with ⟨x, hxC, rfl⟩
    exact ⟨x, hxC, hyLt⟩
  choose f hfC hfLt using hApprox
  have hSeq_bddAbove : BddAbove (Set.range fun n ↦ J (f n)) := by
    refine ⟨m + 1, ?_⟩
    rintro _ ⟨n, rfl⟩
    have hle : (1 : ℝ) ≤ n + 1 := by
      exact_mod_cast Nat.succ_le_succ (Nat.zero_le n)
    have hdiv : 1 / (n + 1 : ℝ) ≤ 1 := by
      simpa using
        (one_div_le_one_div_of_le (show (0 : ℝ) < 1 by positivity) hle :
          1 / (n + 1 : ℝ) ≤ 1 / (1 : ℝ))
    linarith [hfLt n]
  obtain ⟨R, hR⟩ :=
    exists_norm_le_of_coercive_of_bddAbove hJ_coercive hSeq_bddAbove
  obtain ⟨φ, hφ, fStar, hfWeak⟩ :=
    exists_strictMono_subseq_weakSeqTendsto_of_bounded ⟨R, hR⟩
  have hfStar_mem : fStar ∈ C :=
    mem_closedConvex_of_weakSeqTendsto hC_closed hC_convex hfWeak
      (fun n ↦ hfC (φ n))
  have hm_le : ∀ n, m ≤ J (f n) := by
    intro n
    exact csInf_le hImage_bddBelow ⟨f n, hfC n, rfl⟩
  have hφge : ∀ n, n ≤ φ n := fun n => StrictMono.id_le hφ n
  have hSubseqUpper : ∀ n, J (f (φ n)) ≤ m + 1 / (n + 1 : ℝ) := by
    intro n
    have hle : (n + 1 : ℝ) ≤ φ n + 1 := by
      exact_mod_cast Nat.succ_le_succ (hφge n)
    have hdiv : 1 / (φ n + 1 : ℝ) ≤ 1 / (n + 1 : ℝ) := by
      simpa using
        (one_div_le_one_div_of_le
          (show (0 : ℝ) < n + 1 by exact_mod_cast Nat.succ_pos n) hle :
          1 / (φ n + 1 : ℝ) ≤ 1 / (n + 1 : ℝ))
    linarith [hfLt (φ n), hdiv]
  have hSubseqTendsto : Tendsto (fun n ↦ J (f (φ n))) atTop (nhds m) := by
    -- We squeeze the subsequence values between `m` and `m + 1 / (n + 1)`.
    refine tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds ?_
      (fun n => hm_le (φ n)) hSubseqUpper
    simpa using
      tendsto_const_nhds.add
        (tendsto_one_div_add_atTop_nhds_zero_nat :
          Tendsto (fun n : ℕ => 1 / (n + 1 : ℝ)) atTop (nhds 0))
  have hSubseqTendstoEReal :
      Tendsto (fun n ↦ (J (f (φ n)) : EReal)) atTop (nhds (m : EReal)) := by
    exact continuous_coe_real_ereal.continuousAt.tendsto.comp hSubseqTendsto
  have hLiminf : Filter.liminf (fun n ↦ (J (f (φ n)) : EReal)) atTop = m :=
    Filter.Tendsto.liminf_eq hSubseqTendstoEReal
  have hMinVal : J fStar ≤ m := by
    have hwlsc := hJ_wlsc hfWeak
    simpa [hLiminf] using hwlsc
  refine ⟨fStar, hfStar_mem, ?_⟩
  intro x hx
  exact hMinVal.trans (csInf_le hImage_bddBelow ⟨x, hx, rfl⟩)

/- Theorem 2.30 (2). If `J` is strictly convex on `C`, then any two minimizers of `J` on `C`
coincide. -/
#check StrictConvexOn.eq_of_isMinOn

namespace IsMinOn

/-- Theorem 2.30. Combining existence with strict-convexity uniqueness yields a unique minimizer
of `J` on `C`. -/
theorem existsUnique
    (J : H → ℝ) {C : Set H} (hC_nonempty : C.Nonempty) (hC_closed : IsClosed C)
    (hC_convex : Convex ℝ C) (hJ_wlsc : weakLowerSemicontinuous J) (hJ_coercive : coercive J)
    (hJ_strict : StrictConvexOn ℝ C J) :
    ∃! fStar, fStar ∈ C ∧ IsMinOn J C fStar := by
  obtain ⟨fStar, hfStar_mem, hfStar_min⟩ :=
    exists_isMinOn_of_weakLowerSemicontinuous_of_coercive
      J hC_nonempty hC_closed hC_convex hJ_wlsc hJ_coercive
  refine ⟨fStar, ⟨hfStar_mem, hfStar_min⟩, ?_⟩
  intro g hg
  exact hJ_strict.eq_of_isMinOn hg.2 hfStar_min hg.1 hfStar_mem

end IsMinOn
