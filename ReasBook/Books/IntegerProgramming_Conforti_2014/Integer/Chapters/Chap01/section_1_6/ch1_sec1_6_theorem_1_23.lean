module

public import Mathlib.Algebra.BigOperators.Ring.Finset
public import Mathlib.Algebra.Group.Submonoid.Finsupp
public import Mathlib.NumberTheory.FrobeniusNumber

public section

open scoped BigOperators

namespace Nat

/-- Helper for remote integer-programming sorry cleanup
Integer/Chapters/Chap01/section_1_6/ch1_sec1_6_theorem_1_23.lean: membership in the additive
submonoid generated by a finite family of naturals gives a nonnegative linear combination. -/
lemma exists_sum_mul_eq_of_mem_closure_range
    {ι : Type*}
    [Fintype ι]
    (a : ι → ℕ)
    {m : ℕ}
    (hm : m ∈ AddSubmonoid.closure (Set.range a)) :
    ∃ x : ι → ℕ, (∑ i, a i * x i) = m := by
  -- Represent closure membership by a finite family of natural coefficients.
  obtain ⟨x, hx⟩ := AddSubmonoid.exists_of_mem_closure_range a m hm
  refine ⟨x, ?_⟩
  -- Reverse the library equality and put each natural scalar multiple in the desired order.
  simpa only [Nat.nsmul_eq_mul, mul_comm] using hx.symm

/-- remote integer-programming sorry cleanup Integer/Chapters/Chap01/section_1_6/ch1_sec1_6_theorem_1_23.lean:
Theorem 1.23. If `n > 0`,
`a : Fin n → ℕ` has positive entries, and `Nat.setGcd (Set.range a) = 1`, then every sufficiently
large natural number is a nonnegative linear combination `∑ i, a i * x i` of the family `a`. -/
theorem existsNonnegativeSolutionOfSetGcd_eq_one
    {n : ℕ}
    (hn : 0 < n)
    (a : Fin n → ℕ)
    (ha_pos : ∀ i, 0 < a i)
    (hcoprime : Nat.setGcd (Set.range a) = 1) :
    ∃ k : ℕ, ∀ m : ℕ, k + 1 ≤ m → ∃ x : Fin n → ℕ, (∑ i : Fin n, a i * x i) = m := by
  -- Use the first positive generator to enlarge the eventual-membership threshold.
  let i : Fin n := ⟨0, hn⟩
  -- The set gcd controls eventual membership in the generated additive submonoid.
  obtain ⟨k, hk⟩ := Nat.exists_mem_closure_of_ge (Set.range a)
  have hklt : k < k + a i := Nat.lt_add_of_pos_right (ha_pos i)
  refine ⟨k + a i, fun m hm ↦ ?_⟩
  -- Convert that closure membership into the coefficient vector required by the theorem.
  apply exists_sum_mul_eq_of_mem_closure_range a
  apply hk m
  · exact hklt.le.trans ((Nat.le_succ _).trans hm)
  · rw [hcoprime]
    exact one_dvd m

end Nat
