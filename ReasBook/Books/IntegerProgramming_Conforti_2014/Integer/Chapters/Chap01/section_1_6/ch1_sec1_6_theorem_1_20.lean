import IntegerProgramming_Conforti_2014.Integer.Chapters.Chap01.section_1_5.ch1_sec1_5_theorem_1_13
import IntegerProgramming_Conforti_2014.Integer.Chapters.Chap05.section_5_1_1.ch5_sec5_1_1_lemma_5_4.MixedCut
import Mathlib.LinearAlgebra.Dimension.Constructions
import Mathlib.LinearAlgebra.Matrix.ToLin
import Mathlib.LinearAlgebra.Quotient.Basic

open scoped Matrix

-- Declarations for this item will be appended below by the statement pipeline.

section Theorem120

variable {m n p : ℕ}

/-- Helper for remote integer-programming sorry cleanup
`Integer/Chapters/Chap01/section_1_6/ch1_sec1_6_theorem_1_20.lean`: the quotient-coordinate
matrix that records a rational vector modulo the continuous image of `G`. -/
private noncomputable def continuousEliminationMatrix
    (G : Matrix (Fin m) (Fin p) ℚ) :
    Matrix
      (Fin (Module.finrank ℚ ((Fin m → ℚ) ⧸ LinearMap.range G.mulVecLin)))
      (Fin m)
      ℚ :=
  LinearMap.toMatrix
    (Pi.basisFun ℚ (Fin m))
    (Module.finBasis ℚ ((Fin m → ℚ) ⧸ LinearMap.range G.mulVecLin))
    (LinearMap.range G.mulVecLin).mkQ

/-- Helper for remote integer-programming sorry cleanup
`Integer/Chapters/Chap01/section_1_6/ch1_sec1_6_theorem_1_20.lean`: the elimination matrix
vanishes precisely on right-hand sides generated by the continuous block. -/
private lemma continuousEliminationMatrix_mulVec_eq_zero_iff
    (G : Matrix (Fin m) (Fin p) ℚ)
    (d : Fin m → ℚ) :
    continuousEliminationMatrix G *ᵥ d = 0 ↔
      ∃ y : Fin p → ℚ, G *ᵥ y = d := by
  classical
  let Q := (Fin m → ℚ) ⧸ LinearMap.range G.mulVecLin
  let qBasis := Module.finBasis ℚ Q
  have hcoordinates :
      continuousEliminationMatrix G *ᵥ d =
        qBasis.repr ((LinearMap.range G.mulVecLin).mkQ d) := by
    -- The standard-basis matrix computes the quotient coordinate map on `d`.
    simpa [continuousEliminationMatrix, Q, qBasis] using
      (LinearMap.toMatrix_mulVec_repr
        (Pi.basisFun ℚ (Fin m))
        (Module.finBasis ℚ Q)
        (LinearMap.range G.mulVecLin).mkQ
        d)
  rw [hcoordinates]
  constructor
  · intro hzero
    have hquotient : (LinearMap.range G.mulVecLin).mkQ d = 0 := by
      -- Injectivity of basis coordinates turns coordinate vanishing into quotient vanishing.
      exact qBasis.repr.injective (by simpa using hzero)
    have hrange : d ∈ LinearMap.range G.mulVecLin := by
      have hkernel : d ∈ LinearMap.ker (LinearMap.range G.mulVecLin).mkQ :=
        (LinearMap.mem_ker).2 hquotient
      simpa only [Submodule.ker_mkQ] using hkernel
    rcases hrange with ⟨y, hy⟩
    exact ⟨y, hy⟩
  · rintro ⟨y, hy⟩
    have hrange : d ∈ LinearMap.range G.mulVecLin := ⟨y, hy⟩
    have hquotient : (LinearMap.range G.mulVecLin).mkQ d = 0 := by
      rw [← LinearMap.mem_ker, Submodule.ker_mkQ]
      exact hrange
    funext i
    simp [hquotient]

/-- Helper for remote integer-programming sorry cleanup
`Integer/Chapters/Chap01/section_1_6/ch1_sec1_6_theorem_1_20.lean`: the elimination matrix
annihilates the continuous coefficient matrix. -/
private lemma continuousEliminationMatrix_mul_eq_zero
    (G : Matrix (Fin m) (Fin p) ℚ) :
    continuousEliminationMatrix G * G = 0 := by
  classical
  ext i j
  have hcolumn :
      continuousEliminationMatrix G *ᵥ (fun k ↦ G k j) = 0 := by
    -- Each column of `G` is generated by the corresponding standard basis vector.
    rw [continuousEliminationMatrix_mulVec_eq_zero_iff]
    exact ⟨Pi.single j 1, Matrix.mulVec_single_one G j⟩
  -- Matrix multiplication evaluates by applying the left matrix to each column.
  simpa [Matrix.mul_apply, Matrix.mulVec] using congrFun hcolumn i

/-- Helper for remote integer-programming sorry cleanup
`Integer/Chapters/Chap01/section_1_6/ch1_sec1_6_theorem_1_20.lean`: vanishing of the
eliminated residual is equivalent to solvability of the continuous block over `ℝ`. -/
private lemma continuousEliminationMatrix_mulVec_eq_zero_iff_exists_real_solution
    (G : Matrix (Fin m) (Fin p) ℚ)
    (d : Fin m → ℚ) :
    continuousEliminationMatrix G *ᵥ d = 0 ↔
      ∃ y : Fin p → ℝ,
        (G.map (Rat.castHom ℝ)) *ᵥ y = fun i ↦ (d i : ℝ) := by
  classical
  constructor
  · intro hzero
    rcases (continuousEliminationMatrix_mulVec_eq_zero_iff G d).mp hzero with ⟨q, hq⟩
    refine ⟨fun j ↦ (q j : ℝ), ?_⟩
    -- Cast the rational solution coordinatewise to obtain a real solution.
    funext i
    calc
      ((G.map (Rat.castHom ℝ)) *ᵥ (fun j ↦ (q j : ℝ))) i =
          ((G *ᵥ q) i : ℝ) :=
        (RingHom.map_mulVec (Rat.castHom ℝ) G q i).symm
      _ = (d i : ℝ) := congrArg (Rat.castHom ℝ) (congrFun hq i)
  · rintro ⟨y, hy⟩
    have hproductReal :
        (continuousEliminationMatrix G).map (Rat.castHom ℝ) *
            G.map (Rat.castHom ℝ) = 0 := by
      -- The rational annihilation identity remains valid after scalar extension.
      rw [← Matrix.map_mul, continuousEliminationMatrix_mul_eq_zero]
      simp
    have hzeroReal :
        (continuousEliminationMatrix G).map (Rat.castHom ℝ) *ᵥ
            (fun i ↦ (d i : ℝ)) = 0 := by
      calc
        (continuousEliminationMatrix G).map (Rat.castHom ℝ) *ᵥ
              (fun i ↦ (d i : ℝ)) =
            (continuousEliminationMatrix G).map (Rat.castHom ℝ) *ᵥ
              ((G.map (Rat.castHom ℝ)) *ᵥ y) := congrArg _ hy.symm
        _ = ((continuousEliminationMatrix G).map (Rat.castHom ℝ) *
              G.map (Rat.castHom ℝ)) *ᵥ y := by rw [Matrix.mulVec_mulVec]
        _ = 0 := by rw [hproductReal]; simp
    -- Injectivity of `ℚ → ℝ` reflects coordinatewise vanishing back to `ℚ`.
    funext i
    apply (Rat.cast_injective : Function.Injective (fun a : ℚ ↦ (a : ℝ)))
    calc
      ((continuousEliminationMatrix G *ᵥ d) i : ℝ) =
          ((continuousEliminationMatrix G).map (Rat.castHom ℝ) *ᵥ
            (fun k ↦ (d k : ℝ))) i :=
        RingHom.map_mulVec (Rat.castHom ℝ) (continuousEliminationMatrix G) d i
      _ = 0 := congrFun hzeroReal i
      _ = ((0 : ℚ) : ℝ) := by simp

/-- Helper for remote integer-programming sorry cleanup
`Integer/Chapters/Chap01/section_1_6/ch1_sec1_6_theorem_1_20.lean`: for a fixed integer
vector, the eliminated rational equation is equivalent to completing it by real continuous
variables. -/
private lemma eliminatedEquation_iff_existsContinuousSolution
    (A : Matrix (Fin m) (Fin n) ℚ)
    (G : Matrix (Fin m) (Fin p) ℚ)
    (b : Fin m → ℚ)
    (x : Fin n → ℤ) :
    (continuousEliminationMatrix G * A) *ᵥ (fun j ↦ (x j : ℚ)) =
        continuousEliminationMatrix G *ᵥ b ↔
      ∃ y : Fin p → ℝ,
        (A.map (Rat.castHom ℝ)) *ᵥ (fun j ↦ (x j : ℝ)) +
            (G.map (Rat.castHom ℝ)) *ᵥ y = fun i ↦ (b i : ℝ) := by
  classical
  constructor
  · intro heliminated
    have hresidual :
        continuousEliminationMatrix G *ᵥ
            (b - A *ᵥ (fun j ↦ (x j : ℚ))) = 0 := by
      -- Move the fixed integer contribution into the residual annihilated by `H`.
      rw [Matrix.mulVec_sub, Matrix.mulVec_mulVec, heliminated, sub_self]
    rcases
        (continuousEliminationMatrix_mulVec_eq_zero_iff_exists_real_solution G
          (b - A *ᵥ (fun j ↦ (x j : ℚ)))).mp hresidual with
      ⟨y, hy⟩
    refine ⟨y, ?_⟩
    -- Reinsert the integer contribution after casting the rational residual.
    funext i
    have hAcast :
        ((A.map (Rat.castHom ℝ)) *ᵥ (fun j ↦ (x j : ℝ))) i =
          ((A *ᵥ (fun j ↦ (x j : ℚ))) i : ℝ) :=
      (RingHom.map_mulVec (Rat.castHom ℝ) A (fun j ↦ (x j : ℚ)) i).symm
    rw [Pi.add_apply, hAcast, congrFun hy i]
    simp
  · rintro ⟨y, hy⟩
    have hresidual :
        continuousEliminationMatrix G *ᵥ
            (b - A *ᵥ (fun j ↦ (x j : ℚ))) = 0 := by
      apply
        (continuousEliminationMatrix_mulVec_eq_zero_iff_exists_real_solution G
          (b - A *ᵥ (fun j ↦ (x j : ℚ)))).mpr
      refine ⟨y, ?_⟩
      -- Solve for the continuous term and identify it with the cast residual.
      funext i
      have hmixed := congrFun hy i
      have hAcast :
          ((A.map (Rat.castHom ℝ)) *ᵥ (fun j ↦ (x j : ℝ))) i =
            ((A *ᵥ (fun j ↦ (x j : ℚ))) i : ℝ) :=
        (RingHom.map_mulVec (Rat.castHom ℝ) A (fun j ↦ (x j : ℚ)) i).symm
      rw [Pi.add_apply, hAcast] at hmixed
      have hcontinuous :
          ((G.map (Rat.castHom ℝ)) *ᵥ y) i =
            (b i : ℝ) - ((A *ᵥ (fun j ↦ (x j : ℚ))) i : ℝ) := by
        apply eq_sub_iff_add_eq.mpr
        simpa [add_comm] using hmixed
      simpa only [Pi.sub_apply, Rat.cast_sub] using hcontinuous
    -- Expanding the eliminated residual recovers the required rational equation.
    rw [Matrix.mulVec_sub, Matrix.mulVec_mulVec] at hresidual
    exact (sub_eq_zero.mp hresidual).symm

/-- Helper for remote integer-programming sorry cleanup
`Integer/Chapters/Chap01/section_1_6/ch1_sec1_6_theorem_1_20.lean`: a Farkas certificate
for a rational system obtained through an annihilator lifts to a multiplier for the original
mixed system. -/
private lemma liftedAnnihilator_isMixedGomoryFractionalCutMultiplier
    {r : ℕ}
    (H : Matrix (Fin r) (Fin m) ℚ)
    (A : Matrix (Fin m) (Fin n) ℚ)
    (G : Matrix (Fin m) (Fin p) ℚ)
    (b : Fin m → ℚ)
    (v : Fin r → ℝ)
    (hHG : H * G = 0)
    (hvA :
      v ᵥ* ((H * A).map (Rat.castHom ℝ)) ∈ integerVectors n)
    (hvb :
      v ⬝ᵥ (fun i ↦ ((H *ᵥ b) i : ℝ)) ∉
        Set.range (Int.cast : ℤ → ℝ)) :
    IsMixedGomoryFractionalCutMultiplier
      (A.map (Rat.castHom ℝ))
      (G.map (Rat.castHom ℝ))
      (fun i ↦ (b i : ℝ))
      (v ᵥ* H.map (Rat.castHom ℝ)) := by
  rw [isMixedGomoryFractionalCutMultiplier_iff]
  have hrow :
      (v ᵥ* H.map (Rat.castHom ℝ)) ᵥ* A.map (Rat.castHom ℝ) =
        v ᵥ* ((H * A).map (Rat.castHom ℝ)) := by
    -- Associate the two row multiplications and recombine the scalar-extended product.
    calc
      (v ᵥ* H.map (Rat.castHom ℝ)) ᵥ* A.map (Rat.castHom ℝ) =
          v ᵥ* (H.map (Rat.castHom ℝ) * A.map (Rat.castHom ℝ)) := by
        rw [Matrix.vecMul_vecMul]
      _ = v ᵥ* ((H * A).map (Rat.castHom ℝ)) := by rw [Matrix.map_mul]
  have hcontinuous :
      (v ᵥ* H.map (Rat.castHom ℝ)) ᵥ* G.map (Rat.castHom ℝ) = 0 := by
    -- The lifted row still annihilates the continuous block.
    calc
      (v ᵥ* H.map (Rat.castHom ℝ)) ᵥ* G.map (Rat.castHom ℝ) =
          v ᵥ* (H.map (Rat.castHom ℝ) * G.map (Rat.castHom ℝ)) := by
        rw [Matrix.vecMul_vecMul]
      _ = v ᵥ* ((H * G).map (Rat.castHom ℝ)) := by rw [Matrix.map_mul]
      _ = 0 := by rw [hHG]; simp
  have hcastRight :
      H.map (Rat.castHom ℝ) *ᵥ (fun i ↦ (b i : ℝ)) =
        fun k ↦ ((H *ᵥ b) k : ℝ) := by
    -- Scalar extension commutes with applying `H` to the right-hand side.
    funext k
    exact (RingHom.map_mulVec (Rat.castHom ℝ) H b k).symm
  have hright :
      (v ᵥ* H.map (Rat.castHom ℝ)) ⬝ᵥ (fun i ↦ (b i : ℝ)) =
        v ⬝ᵥ (fun k ↦ ((H *ᵥ b) k : ℝ)) := by
    calc
      (v ᵥ* H.map (Rat.castHom ℝ)) ⬝ᵥ (fun i ↦ (b i : ℝ)) =
          v ⬝ᵥ (H.map (Rat.castHom ℝ) *ᵥ (fun i ↦ (b i : ℝ))) := by
        rw [Matrix.dotProduct_mulVec]
      _ = v ⬝ᵥ (fun k ↦ ((H *ᵥ b) k : ℝ)) := by rw [hcastRight]
  refine ⟨?_, hcontinuous, ?_⟩
  · intro j
    -- The first multiplier field is exactly the integral Farkas row after reassociation.
    rw [hrow]
    rcases (mem_integerVectors_iff_forall.mp hvA) j with ⟨z, hz⟩
    exact ⟨z, hz.symm⟩
  · rintro ⟨z, hz⟩
    -- Rewriting the right pairing would contradict the Farkas nonintegrality certificate.
    exact hvb ⟨z, hz.symm.trans hright⟩

/-- Helper for remote integer-programming sorry cleanup
`Integer/Chapters/Chap01/section_1_6/ch1_sec1_6_theorem_1_20.lean`: a mixed Gomory
fractional-cut multiplier excludes every mixed solution of its defining equality system. -/
private lemma mixedGomoryFractionalCutMultiplier_excludes_solution
    (A : Matrix (Fin m) (Fin n) ℝ)
    (G : Matrix (Fin m) (Fin p) ℝ)
    (b : Fin m → ℝ)
    (u : Fin m → ℝ)
    (hu : IsMixedGomoryFractionalCutMultiplier A G b u) :
    ¬ ∃ x : Fin n → ℤ, ∃ y : Fin p → ℝ,
      A *ᵥ (fun j ↦ (x j : ℝ)) + G *ᵥ y = b := by
  classical
  rw [isMixedGomoryFractionalCutMultiplier_iff] at hu
  rcases hu with ⟨huA, huG, hub⟩
  choose z hz using huA
  have huAeq : u ᵥ* A = fun j ↦ (z j : ℝ) := funext hz
  rintro ⟨x, y, hxy⟩
  apply hub
  refine ⟨z ⬝ᵥ x, ?_⟩
  -- Pair the proposed equation with `u`; the continuous term vanishes and the remaining
  -- dot product is the cast of an integer dot product.
  calc
    u ⬝ᵥ b = u ⬝ᵥ (A *ᵥ (fun j ↦ (x j : ℝ)) + G *ᵥ y) :=
      congrArg (fun w ↦ u ⬝ᵥ w) hxy.symm
    _ = u ⬝ᵥ (A *ᵥ (fun j ↦ (x j : ℝ))) + u ⬝ᵥ (G *ᵥ y) := by
      rw [dotProduct_add]
    _ = (u ᵥ* A) ⬝ᵥ (fun j ↦ (x j : ℝ)) + (u ᵥ* G) ⬝ᵥ y := by
      rw [Matrix.dotProduct_mulVec, Matrix.dotProduct_mulVec]
    _ = (fun j ↦ (z j : ℝ)) ⬝ᵥ (fun j ↦ (x j : ℝ)) := by
      rw [huAeq, huG, zero_dotProduct, add_zero]
    _ = ((z ⬝ᵥ x : ℤ) : ℝ) := by simp [dotProduct]

/-- remote integer-programming sorry cleanup Integer/Chapters/Chap01/section_1_6/ch1_sec1_6_theorem_1_20.lean
Theorem 1.20: the rational mixed system
`(A.map (Rat.castHom ℝ)) *ᵥ (fun j ↦ (x j : ℝ)) + (G.map (Rat.castHom ℝ)) *ᵥ y = fun i ↦ (b i : ℝ)`
with `x : Fin n → ℤ` and `y : Fin p → ℝ` is infeasible if and only if there exists
`u : Fin m → ℝ` such that `IsMixedGomoryFractionalCutMultiplier (A.map (Rat.castHom ℝ))
(G.map (Rat.castHom ℝ)) (fun i ↦ (b i : ℝ)) u`. -/
theorem mixed_integer_linear_equations_infeasible_iff_exists_multiplier
    (A : Matrix (Fin m) (Fin n) ℚ)
    (G : Matrix (Fin m) (Fin p) ℚ)
    (b : Fin m → ℚ) :
    (¬ ∃ x : Fin n → ℤ, ∃ y : Fin p → ℝ,
      (A.map (Rat.castHom ℝ)) *ᵥ (fun j ↦ (x j : ℝ)) + (G.map (Rat.castHom ℝ)) *ᵥ y =
        fun i ↦ (b i : ℝ)) ↔
      ∃ u : Fin m → ℝ,
        IsMixedGomoryFractionalCutMultiplier
          (A.map (Rat.castHom ℝ))
          (G.map (Rat.castHom ℝ))
          (fun i ↦ (b i : ℝ))
          u := by
  constructor
  · intro hmixedInfeasible
    have heliminatedInfeasible :
        ¬ RationalLinearSystem.hasIntegerSolution
          (continuousEliminationMatrix G * A)
          (continuousEliminationMatrix G *ᵥ b) := by
      intro heliminatedFeasible
      rw [RationalLinearSystem.hasIntegerSolution_iff] at heliminatedFeasible
      rcases heliminatedFeasible with ⟨x, hx⟩
      -- A solution of the eliminated integer system extends to a forbidden mixed solution.
      apply hmixedInfeasible
      exact ⟨x, (eliminatedEquation_iff_existsContinuousSolution A G b x).mp hx⟩
    obtain ⟨v, hvA, hvb⟩ :=
      (RationalLinearSystem.integerFarkasLemma
        (continuousEliminationMatrix G * A)
        (continuousEliminationMatrix G *ᵥ b)).mp heliminatedInfeasible
    -- Lift the integer Farkas row back through the continuous annihilator.
    refine ⟨v ᵥ* (continuousEliminationMatrix G).map (Rat.castHom ℝ), ?_⟩
    exact
      liftedAnnihilator_isMixedGomoryFractionalCutMultiplier
        (continuousEliminationMatrix G) A G b v
        (continuousEliminationMatrix_mul_eq_zero G) hvA hvb
  · rintro ⟨u, hu⟩
    -- Soundness is the direct dot-product contradiction supplied by the multiplier fields.
    exact
      mixedGomoryFractionalCutMultiplier_excludes_solution
        (A.map (Rat.castHom ℝ)) (G.map (Rat.castHom ℝ))
        (fun i ↦ (b i : ℝ)) u hu

end Theorem120

#print axioms mixed_integer_linear_equations_infeasible_iff_exists_multiplier
