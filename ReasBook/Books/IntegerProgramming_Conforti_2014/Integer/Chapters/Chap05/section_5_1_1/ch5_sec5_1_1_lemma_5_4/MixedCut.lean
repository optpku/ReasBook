import IntegerProgramming_Conforti_2014.Integer.Chapters.Chap01.section_1_1.ch1_sec1_1_definition_1_4.Polyhedron
import IntegerProgramming_Conforti_2014.Integer.Chapters.Chap05.section_5_1_1.ch5_sec5_1_1_theorem_5_5

open scoped Matrix

section MixedCut

variable {m nI nC : ℕ}

/-- The left-hand side of the mixed fractional split cut generated by the row multiplier `u`. -/
noncomputable abbrev mixed_gomory_fractional_cut_value
    (A : Matrix (Fin m) (Fin nI) ℝ)
    (G : Matrix (Fin m) (Fin nC) ℝ)
    (b : Fin m → ℝ)
    (u : Fin m → ℝ)
    (xy : MixedRealPoint nI nC) : ℝ :=
  split_cut_value (mixedConstraintMatrix A G) b u (Int.floor (u ⬝ᵥ b)) (Fin.append xy.1 xy.2)

/-- A mixed Gomory fractional-cut row multiplier is integral on the integer block, annihilates
the continuous block, and evaluates nonintegrally on the right-hand side. -/
def IsMixedGomoryFractionalCutMultiplier
    (A : Matrix (Fin m) (Fin nI) ℝ)
    (G : Matrix (Fin m) (Fin nC) ℝ)
    (b : Fin m → ℝ)
    (u : Fin m → ℝ) : Prop :=
  (∀ j : Fin nI, ∃ z : ℤ, (u ᵥ* A) j = (z : ℝ)) ∧
    u ᵥ* G = 0 ∧
    ¬ ∃ z : ℤ, u ⬝ᵥ b = (z : ℝ)

/-- `IsMixedGomoryFractionalCutMultiplier A G b u` unfolds to the textbook integrality,
annihilation, and nonintegrality conditions on `u`. -/
theorem isMixedGomoryFractionalCutMultiplier_iff
    (A : Matrix (Fin m) (Fin nI) ℝ)
    (G : Matrix (Fin m) (Fin nC) ℝ)
    (b : Fin m → ℝ)
    (u : Fin m → ℝ) :
    IsMixedGomoryFractionalCutMultiplier A G b u ↔
      (∀ j : Fin nI, ∃ z : ℤ, (u ᵥ* A) j = (z : ℝ)) ∧
        u ᵥ* G = 0 ∧
        ¬ ∃ z : ℤ, u ⬝ᵥ b = (z : ℝ) :=
  Iff.rfl

/-- `mixed_gomory_fractional_cut_value` is the mixed-point view of the canonical split-cut owner
`split_cut_value` for the flattened block matrix. -/
theorem mixed_gomory_fractional_cut_value_eq_split_cut_value
    (A : Matrix (Fin m) (Fin nI) ℝ)
    (G : Matrix (Fin m) (Fin nC) ℝ)
    (b : Fin m → ℝ)
    (u : Fin m → ℝ)
    (xy : MixedRealPoint nI nC) :
    mixed_gomory_fractional_cut_value A G b u xy =
      split_cut_value (mixedConstraintMatrix A G) b u (Int.floor (u ⬝ᵥ b))
        (Fin.append xy.1 xy.2) :=
  rfl

/-- Evaluating `mixed_gomory_fractional_cut_value` gives the standard positive-part and
negative-part slack expression from the split-cut formula. -/
theorem mixed_gomory_fractional_cut_value_eq
    (A : Matrix (Fin m) (Fin nI) ℝ)
    (G : Matrix (Fin m) (Fin nC) ℝ)
    (b : Fin m → ℝ)
    (u : Fin m → ℝ)
    (xy : MixedRealPoint nI nC) :
    mixed_gomory_fractional_cut_value A G b u xy =
      row_multiplier_pos u ⬝ᵥ (b - (A *ᵥ xy.1 + G *ᵥ xy.2)) / Int.fract (u ⬝ᵥ b) +
        row_multiplier_neg u ⬝ᵥ (b - (A *ᵥ xy.1 + G *ᵥ xy.2)) /
          (1 - Int.fract (u ⬝ᵥ b)) := by
  rw [mixed_gomory_fractional_cut_value, split_cut_value, Int.self_sub_floor]
  rw [show ((Int.floor (u ⬝ᵥ b) : ℝ) + 1 - u ⬝ᵥ b) = 1 - Int.fract (u ⬝ᵥ b) by
    calc
      ((Int.floor (u ⬝ᵥ b) : ℝ) + 1 - u ⬝ᵥ b) =
          1 - (u ⬝ᵥ b - (Int.floor (u ⬝ᵥ b) : ℝ)) := by ring
      _ = 1 - Int.fract (u ⬝ᵥ b) := by rw [Int.self_sub_floor]]
  rw [mixedConstraintMatrix_mulVec_append]

end MixedCut
