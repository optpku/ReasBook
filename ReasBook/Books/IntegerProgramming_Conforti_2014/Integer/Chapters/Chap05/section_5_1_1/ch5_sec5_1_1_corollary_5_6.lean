import IntegerProgramming_Conforti_2014.Integer.Chapters.Chap05.section_5_1_1.ch5_sec5_1_1_lemma_5_4

open scoped Matrix

-- Semantic recall note: this file reuses the canonical mixed split-closure owner on the
-- canonical Chapter 4.8 mixed polyhedron from Lemma 5.4.

section Corollary56

variable {m nI nC : ℕ}

/-- The points of `P` satisfying every split inequality `(5.6)` generated by a row multiplier
`u` with integral `u A_I`, vanishing `u A_C`, nonintegral `u b`, and linearly independent
support rows. -/
def independent_support_split_cut_system
    (A_I : Matrix (Fin m) (Fin nI) ℝ)
    (A_C : Matrix (Fin m) (Fin nC) ℝ)
    (b : Fin m → ℝ) : Set (MixedRealPoint nI nC) :=
  {xy | xy ∈ real_mixed_polyhedron A_I A_C b ∧
    ∀ u : Fin m → ℝ,
      IsMixedGomoryFractionalCutMultiplier A_I A_C b u →
        RowMultiplierHasIndependentSupportRows (mixedConstraintMatrix A_I A_C) u →
          1 ≤ mixed_gomory_fractional_cut_value A_I A_C b u xy}

/-- Membership in `independent_support_split_cut_system A_I A_C b` means belonging to the mixed
polyhedron `P` and satisfying every split inequality `(5.6)` coming from a multiplier with
integral `u A_I`, vanishing `u A_C`, nonintegral `u b`, and linearly independent support rows. -/
theorem mem_independent_support_split_cut_system_iff
    (A_I : Matrix (Fin m) (Fin nI) ℝ)
    (A_C : Matrix (Fin m) (Fin nC) ℝ)
    (b : Fin m → ℝ)
    (xy : MixedRealPoint nI nC) :
    xy ∈ independent_support_split_cut_system A_I A_C b ↔
      xy ∈ real_mixed_polyhedron A_I A_C b ∧
        ∀ u : Fin m → ℝ,
          IsMixedGomoryFractionalCutMultiplier A_I A_C b u →
            RowMultiplierHasIndependentSupportRows (mixedConstraintMatrix A_I A_C) u →
              1 ≤ mixed_gomory_fractional_cut_value A_I A_C b u xy :=
  Iff.rfl

/-- Helper for ch5_sec5_1_1_corollary_5_6: appending a zero continuous block preserves the
nonzeroness of the integer split vector. -/
lemma flatMixedSplit_nonzero
    {π : Fin nI → ℤ}
    (hπ : π ≠ 0) :
    Fin.append π (fun _ : Fin nC ↦ (0 : ℤ)) ≠ 0 := by
  -- Check the first block to recover the original split coefficients.
  intro happ
  apply hπ
  funext j
  have hcoord := congrFun happ (Fin.castAdd nC j)
  simpa using hcoord

/-- Helper for ch5_sec5_1_1_corollary_5_6: the flattened split over `Fin (nI + nC)` has no
continuous coordinates because `Finset.univ` has empty complement. -/
lemma flatMixedSplit_zeroOnContinuous
    (π : Fin nI → ℤ) :
    ∀ j ∈ (Finset.univ : Finset (Fin (nI + nC)))ᶜ,
      Fin.append π (fun _ : Fin nC ↦ (0 : ℤ)) j = 0 := by
  -- The complement of `Finset.univ` is empty, so there are no continuous coordinates to check.
  intro j hj
  simp at hj
  exact False.elim hj

/-- Helper for ch5_sec5_1_1_corollary_5_6: the mixed split data `(π, π₀)` becomes the flat split
with coefficient vector `Fin.append π 0` on `Fin (nI + nC)`. -/
def flatMixedSplit
    (π : Fin nI → ℤ)
    (π0 : ℤ)
    (hπ : π ≠ 0) :
    Split (Finset.univ : Finset (Fin (nI + nC))) where
  π := Fin.append π (fun _ : Fin nC ↦ (0 : ℤ))
  π0 := π0
  nonzero := flatMixedSplit_nonzero (nC := nC) hπ
  zero_on_continuous := flatMixedSplit_zeroOnContinuous (nC := nC) π

/-- Helper for ch5_sec5_1_1_corollary_5_6: the integer coordinates of `flatMixedSplit π π₀ hπ`
recover the original split vector `π`. -/
lemma flatMixedSplit_apply_castAdd
    (π : Fin nI → ℤ)
    (π0 : ℤ)
    (hπ : π ≠ 0)
    (j : Fin nI) :
    flatMixedSplit (nC := nC) π π0 hπ (Fin.castAdd nC j) = π j :=
  rfl

/-- Helper for ch5_sec5_1_1_corollary_5_6: the continuous coordinates of `flatMixedSplit π π₀ hπ`
vanish. -/
lemma flatMixedSplit_apply_natAdd
    (π : Fin nI → ℤ)
    (π0 : ℤ)
    (hπ : π ≠ 0)
    (j : Fin nC) :
    flatMixedSplit (nC := nC) π π0 hπ (Fin.natAdd nI j) = 0 :=
  rfl

/-- Helper for ch5_sec5_1_1_corollary_5_6: the integer coordinates of
`u ᵥ* mixedConstraintMatrix A_I A_C` are exactly `u ᵥ* A_I`. -/
lemma vecMul_mixedConstraintMatrix_castAdd
    (A_I : Matrix (Fin m) (Fin nI) ℝ)
    (A_C : Matrix (Fin m) (Fin nC) ℝ)
    (u : Fin m → ℝ)
    (j : Fin nI) :
    (u ᵥ* mixedConstraintMatrix A_I A_C) (Fin.castAdd nC j) = (u ᵥ* A_I) j := by
  simpa [mixedConstraintMatrix, Matrix.vecMul, dotProduct, Fin.sum_univ_add]

/-- Helper for ch5_sec5_1_1_corollary_5_6: the continuous coordinates of
`u ᵥ* mixedConstraintMatrix A_I A_C` are exactly `u ᵥ* A_C`. -/
lemma vecMul_mixedConstraintMatrix_natAdd
    (A_I : Matrix (Fin m) (Fin nI) ℝ)
    (A_C : Matrix (Fin m) (Fin nC) ℝ)
    (u : Fin m → ℝ)
    (j : Fin nC) :
    (u ᵥ* mixedConstraintMatrix A_I A_C) (Fin.natAdd nI j) = (u ᵥ* A_C) j := by
  simpa [mixedConstraintMatrix, Matrix.vecMul, dotProduct, Fin.sum_univ_add]

/-- Helper for ch5_sec5_1_1_corollary_5_6: flattening `real_mixed_polyhedron A_I A_C b` by
`Fin.appendEquiv` gives the matrix polyhedron for `mixedConstraintMatrix A_I A_C`. -/
lemma appendEquiv_image_realMixedPolyhedron_eq_polyhedron
    (A_I : Matrix (Fin m) (Fin nI) ℝ)
    (A_C : Matrix (Fin m) (Fin nC) ℝ)
    (b : Fin m → ℝ) :
    Fin.appendEquiv nI nC '' real_mixed_polyhedron A_I A_C b =
      polyhedron_le_set (mixedConstraintMatrix A_I A_C) b := by
  ext z
  constructor
  · rintro ⟨xy, hxy, rfl⟩
    rw [mem_real_mixed_polyhedron_iff] at hxy
    simpa [mixedConstraintMatrix_mulVec_append] using hxy
  · intro hz
    let xy : MixedRealPoint nI nC :=
      (fun j : Fin nI ↦ z (Fin.castAdd nC j), fun j : Fin nC ↦ z (Fin.natAdd nI j))
    have hxy_eq : Fin.append xy.1 xy.2 = z := by
      funext j
      refine Fin.addCases ?_ ?_ j
      · intro jI
        rfl
      · intro jC
        rfl
    refine ⟨xy, ?_, ?_⟩
    · rw [mem_real_mixed_polyhedron_iff]
      simpa [xy, hxy_eq, mixedConstraintMatrix_mulVec_append] using hz
    · simpa [Fin.appendEquiv, hxy_eq]

/-- Helper for ch5_sec5_1_1_corollary_5_6: mixed split-hull membership transports to the flat
split polyhedron defined by `flatMixedSplit π π₀ hπ`. -/
lemma memMixedSplitHullRealMixedPolyhedronIffFlatSplitPolyhedron
    (A_I : Matrix (Fin m) (Fin nI) ℝ)
    (A_C : Matrix (Fin m) (Fin nC) ℝ)
    (b : Fin m → ℝ)
    (π : Fin nI → ℤ)
    (π0 : ℤ)
    (hπ : π ≠ 0)
    (xy : MixedRealPoint nI nC) :
    xy ∈ mixed_split_hull (real_mixed_polyhedron A_I A_C b) π π0 ↔
      Fin.append xy.1 xy.2 ∈
        split_polyhedron (mixedConstraintMatrix A_I A_C) b (flatMixedSplit π π0 hπ) := by
  have hflatSet :
      Fin.appendEquiv nI nC '' mixed_split_hull (real_mixed_polyhedron A_I A_C b) π π0 =
        split_polyhedron (mixedConstraintMatrix A_I A_C) b (flatMixedSplit π π0 hπ) := by
    -- The mixed split hull becomes the Chapter 5 split polyhedron after flattening.
    rw [appendEquiv_image_mixed_split_hull,
      appendEquiv_image_realMixedPolyhedron_eq_polyhedron A_I A_C b]
    rfl
  constructor
  · intro hxy
    have hflatImage :
        Fin.appendEquiv nI nC xy ∈
          Fin.appendEquiv nI nC '' mixed_split_hull (real_mixed_polyhedron A_I A_C b) π π0 :=
      ⟨xy, hxy, rfl⟩
    rw [hflatSet] at hflatImage
    simpa [Fin.appendEquiv] using hflatImage
  · intro hflat
    have hflatImage :
        Fin.appendEquiv nI nC xy ∈
          Fin.appendEquiv nI nC '' mixed_split_hull (real_mixed_polyhedron A_I A_C b) π π0 := by
      rw [hflatSet]
      simpa [Fin.appendEquiv] using hflat
    rcases hflatImage with ⟨xy', hxy', hxy'Eq⟩
    have hxy' : xy' = xy := (Fin.appendEquiv nI nC).injective hxy'Eq
    simpa [hxy'] using hxy'

/-- Helper for ch5_sec5_1_1_corollary_5_6: a flat basic row multiplier for the split
`flatMixedSplit π π₀ hπ` is exactly a mixed multiplier reproducing `π` on `A_I`, annihilating
`A_C`, and having independent support rows. -/
lemma memBasicRowMultiplierSetFlatMixedSplitIff
    (A_I : Matrix (Fin m) (Fin nI) ℝ)
    (A_C : Matrix (Fin m) (Fin nC) ℝ)
    (π : Fin nI → ℤ)
    (π0 : ℤ)
    (hπ : π ≠ 0)
    (u : Fin m → ℝ) :
    u ∈ basic_row_multiplier_set (mixedConstraintMatrix A_I A_C) (flatMixedSplit π π0 hπ) ↔
      u ᵥ* A_I = fun j : Fin nI ↦ (π j : ℝ) ∧
        u ᵥ* A_C = 0 ∧
          RowMultiplierHasIndependentSupportRows (mixedConstraintMatrix A_I A_C) u := by
  constructor
  · intro hu
    rcases (mem_basic_row_multiplier_set_iff
        (mixedConstraintMatrix A_I A_C) (flatMixedSplit π π0 hπ) u).mp hu with
      ⟨huRow, huIndep⟩
    have huAI : u ᵥ* A_I = fun j : Fin nI ↦ (π j : ℝ) := by
      ext j
      have hcoord := congrFun huRow (Fin.castAdd nC j)
      rw [vecMul_mixedConstraintMatrix_castAdd A_I A_C u j,
        flatMixedSplit_apply_castAdd (nC := nC) π π0 hπ j] at hcoord
      exact hcoord
    have huAC : u ᵥ* A_C = 0 := by
      ext j
      have hcoord := congrFun huRow (Fin.natAdd nI j)
      rw [vecMul_mixedConstraintMatrix_natAdd A_I A_C u j,
        flatMixedSplit_apply_natAdd (nC := nC) π π0 hπ j] at hcoord
      exact hcoord
    exact ⟨huAI, huAC, huIndep⟩
  · rintro ⟨huAI, huAC, huIndep⟩
    refine (mem_basic_row_multiplier_set_iff
      (mixedConstraintMatrix A_I A_C) (flatMixedSplit π π0 hπ) u).2 ?_
    constructor
    · ext j
      refine Fin.addCases ?_ ?_ j
      · intro jI
        rw [vecMul_mixedConstraintMatrix_castAdd A_I A_C u jI,
          flatMixedSplit_apply_castAdd (nC := nC) π π0 hπ jI]
        exact congrFun huAI jI
      · intro jC
        rw [vecMul_mixedConstraintMatrix_natAdd A_I A_C u jC,
          flatMixedSplit_apply_natAdd (nC := nC) π π0 hπ jC]
        exact congrFun huAC jC
    · exact huIndep

/-- Helper for ch5_sec5_1_1_corollary_5_6: once `⌊u b⌋ = π₀`, the flat split-cut value equals the
mixed Gomory fractional-cut value. -/
lemma splitCutValueFlatMixedEqMixedGomoryOfFloorEq
    (A_I : Matrix (Fin m) (Fin nI) ℝ)
    (A_C : Matrix (Fin m) (Fin nC) ℝ)
    (b : Fin m → ℝ)
    (u : Fin m → ℝ)
    (xy : MixedRealPoint nI nC)
    (π0 : ℤ)
    (hfloor : Int.floor (u ⬝ᵥ b) = π0) :
    split_cut_value (mixedConstraintMatrix A_I A_C) b u π0 (Fin.append xy.1 xy.2) =
      mixed_gomory_fractional_cut_value A_I A_C b u xy := by
  -- Rewrite the mixed cut owner to the flat owner and replace the floor by `π₀`.
  rw [mixed_gomory_fractional_cut_value_eq_split_cut_value, hfloor]

/-- Helper for ch5_sec5_1_1_corollary_5_6: a violating flat basic multiplier for
`flatMixedSplit π π₀ hπ` is already a mixed Gomory fractional-cut multiplier with the same
independent-support data and floor value `π₀`. -/
lemma flatBasicViolationDataToMixedMultiplier
    (A_I : Matrix (Fin m) (Fin nI) ℝ)
    (A_C : Matrix (Fin m) (Fin nC) ℝ)
    (b : Fin m → ℝ)
    (π : Fin nI → ℤ)
    (π0 : ℤ)
    (hπ : π ≠ 0)
    (u : Fin m → ℝ)
    (huBasic :
      u ∈ basic_row_multiplier_set (mixedConstraintMatrix A_I A_C) (flatMixedSplit π π0 hπ))
    (hub_left : (π0 : ℝ) < u ⬝ᵥ b)
    (hub_right : u ⬝ᵥ b < (π0 : ℝ) + 1) :
    IsMixedGomoryFractionalCutMultiplier A_I A_C b u ∧
      RowMultiplierHasIndependentSupportRows (mixedConstraintMatrix A_I A_C) u ∧
      Int.floor (u ⬝ᵥ b) = π0 := by
  rcases (memBasicRowMultiplierSetFlatMixedSplitIff
      A_I A_C π π0 hπ u).mp huBasic with ⟨huAI, huAC, huIndep⟩
  have huMixed : IsMixedGomoryFractionalCutMultiplier A_I A_C b u := by
    -- The flat basic-row witness packages exactly the mixed multiplier data, and the strip
    -- inequalities exclude integral values of `u ⬝ᵥ b`.
    refine ⟨?_, huAC, ?_⟩
    · intro j
      refine ⟨π j, ?_⟩
      simpa using congrFun huAI j
    · intro hub_int
      rcases hub_int with ⟨z, hz⟩
      linarith
  have hfloor : Int.floor (u ⬝ᵥ b) = π0 := by
    -- The same strip inequalities identify the floor uniquely.
    exact Int.floor_eq_iff.mpr <| by
      constructor <;> linarith
  exact ⟨huMixed, huIndep, hfloor⟩

/-- Helper for ch5_sec5_1_1_corollary_5_6: every point of `real_mixed_polyhedron A_I A_C b`
belongs to the mixed split hull cut out by the zero split vector. -/
lemma memMixedSplitHullZero_of_memRealMixedPolyhedron
    (A_I : Matrix (Fin m) (Fin nI) ℝ)
    (A_C : Matrix (Fin m) (Fin nC) ℝ)
    (b : Fin m → ℝ)
    {xy : MixedRealPoint nI nC}
    (hxy : xy ∈ real_mixed_polyhedron A_I A_C b)
    (π0 : ℤ) :
    xy ∈ mixed_split_hull (real_mixed_polyhedron A_I A_C b) (fun _ : Fin nI ↦ 0) π0 := by
  rw [mixed_split_hull]
  by_cases hπ0 : 0 ≤ π0
  · -- If `π₀ ≥ 0`, the lower branch already contains the whole ambient polyhedron.
    refine subset_convexHull ℝ _ (Or.inl ?_)
    refine ⟨hxy, ?_⟩
    simp [hπ0]
  · -- If `π₀ < 0`, the upper branch contains the whole ambient polyhedron instead.
    have hupperInt : π0 + 1 ≤ 0 := Int.add_one_le_iff.mpr (lt_of_not_ge hπ0)
    refine subset_convexHull ℝ _ (Or.inr ?_)
    refine ⟨hxy, ?_⟩
    have hupperReal : (π0 : ℝ) + 1 ≤ (0 : ℝ) := by
      exact_mod_cast hupperInt
    simpa using hupperReal

/-- Helper for ch5_sec5_1_1_corollary_5_6: points of the mixed split closure satisfy every
independent-support mixed Gomory fractional cut. -/
lemma memIndependentSupportSplitCutSystem_of_memMixedSplitClosure
    (A_I : Matrix (Fin m) (Fin nI) ℝ)
    (A_C : Matrix (Fin m) (Fin nC) ℝ)
    (b : Fin m → ℝ)
    (hnI : nI ≠ 0)
    {xy : MixedRealPoint nI nC}
    (hxyClosure : xy ∈ mixed_split_closure (real_mixed_polyhedron A_I A_C b)) :
    xy ∈ independent_support_split_cut_system A_I A_C b := by
  let P : Set (MixedRealPoint nI nC) := real_mixed_polyhedron A_I A_C b
  let M : Matrix (Fin m) (Fin (nI + nC)) ℝ := mixedConstraintMatrix A_I A_C
  rw [mem_independent_support_split_cut_system_iff]
  have hclosure := (mem_mixed_split_closure_iff P xy).mp hxyClosure
  have hnI_pos : 0 < nI := Nat.pos_of_ne_zero hnI
  let j0 : Fin nI := ⟨0, hnI_pos⟩
  let πstar : Fin nI → ℤ := Pi.single j0 1
  have hπstar : πstar ≠ 0 := by
    -- Use the distinguished coordinate `j0` to witness nonzeroness.
    intro hzero
    have hcoord := congrFun hzero j0
    simpa [πstar] using hcoord
  have hxyStar : xy ∈ mixed_split_hull P πstar 0 :=
    hclosure ⟨πstar, hπstar⟩ 0
  have hxyFlat :
      Fin.append xy.1 xy.2 ∈ split_polyhedron M b (flatMixedSplit πstar 0 hπstar) :=
    (memMixedSplitHullRealMixedPolyhedronIffFlatSplitPolyhedron
      A_I A_C b πstar 0 hπstar xy).1 hxyStar
  have hxyPolyFlat :
      Fin.append xy.1 xy.2 ∈ polyhedron_le_set M b :=
    mem_polyhedron_of_memSplitPolyhedron M b (flatMixedSplit πstar 0 hπstar) hxyFlat
  have hxyPoly : xy ∈ P := by
    -- One nontrivial split-hull membership is enough to recover ambient feasibility.
    refine (mem_real_mixed_polyhedron_iff).2 ?_
    simpa [mixedConstraintMatrix_mulVec_append] using hxyPolyFlat
  refine ⟨hxyPoly, ?_⟩
  intro u hu _huIndep
  classical
  choose πu hπu using hu.1
  have hπu' : u ᵥ* A_I = fun j : Fin nI ↦ (πu j : ℝ) := by
    funext j
    exact hπu j
  by_cases hπu_zero : πu = 0
  · have hxyZero :
        xy ∈ mixed_split_hull P πu (Int.floor (u ⬝ᵥ b)) := by
      -- When the extracted split row is zero, ambient feasibility already implies split-hull
      -- membership for the zero split.
      simpa [hπu_zero] using
        memMixedSplitHullZero_of_memRealMixedPolyhedron
          A_I A_C b hxyPoly (Int.floor (u ⬝ᵥ b))
    exact mixed_gomory_fractional_cut_valid_on_split_hull_of_multiplier
      A_I A_C b u πu hπu' hu xy hxyZero
  · have hxySplit :
        xy ∈ mixed_split_hull P πu (Int.floor (u ⬝ᵥ b)) :=
      hclosure ⟨πu, hπu_zero⟩ (Int.floor (u ⬝ᵥ b))
    exact mixed_gomory_fractional_cut_valid_on_split_hull_of_multiplier
      A_I A_C b u πu hπu' hu xy hxySplit

/-- Helper for ch5_sec5_1_1_corollary_5_6: any point satisfying every independent-support mixed
Gomory fractional cut belongs to every mixed split hull. -/
lemma memMixedSplitClosure_of_memIndependentSupportSplitCutSystem
    (A_I : Matrix (Fin m) (Fin nI) ℝ)
    (A_C : Matrix (Fin m) (Fin nC) ℝ)
    (b : Fin m → ℝ)
    {xy : MixedRealPoint nI nC}
    (hxy : xy ∈ independent_support_split_cut_system A_I A_C b) :
    xy ∈ mixed_split_closure (real_mixed_polyhedron A_I A_C b) := by
  let M : Matrix (Fin m) (Fin (nI + nC)) ℝ := mixedConstraintMatrix A_I A_C
  rw [mem_mixed_split_closure_iff]
  intro π π0
  have hxyPolyFlat :
      Fin.append xy.1 xy.2 ∈ polyhedron_le_set M b := by
    -- The ambient mixed-polyhedron membership becomes the flat matrix feasibility condition.
    simpa [mixedConstraintMatrix_mulVec_append] using
      (mem_real_mixed_polyhedron_iff.mp hxy.1)
  have hflat :
      Fin.append xy.1 xy.2 ∈
        split_polyhedron M b (flatMixedSplit π.1 π0 π.2) := by
    -- Theorem 5.5 reduces the flat split hull to the corresponding basic split-cut system.
    rw [split_polyhedron_eq_basic_split_cut_system M b (flatMixedSplit π.1 π0 π.2)]
    refine (mem_basic_split_cut_system_iff
      M b (flatMixedSplit π.1 π0 π.2) π0 (Fin.append xy.1 xy.2)).2 ?_
    refine ⟨?_, ?_⟩
    · simpa using hxyPolyFlat
    · intro u huBasic hub_left hub_right
      rcases flatBasicViolationDataToMixedMultiplier
          A_I A_C b π.1 π0 π.2 u huBasic hub_left hub_right with
        ⟨huMixed, huIndep, hfloor⟩
      have hcutMixed :
          1 ≤ mixed_gomory_fractional_cut_value A_I A_C b u xy :=
        hxy.2 u huMixed huIndep
      rw [splitCutValueFlatMixedEqMixedGomoryOfFloorEq A_I A_C b u xy π0 hfloor]
      exact hcutMixed
  exact (memMixedSplitHullRealMixedPolyhedronIffFlatSplitPolyhedron
    A_I A_C b π.1 π0 π.2 xy).2 hflat

/-- ch5_sec5_1_1_corollary_5_6

Corollary 5.6. When the integer block is nonempty, the split closure `P^split` of
`P = {(x, y) | A_I x + A_C y ≤ b}` is exactly the set of points of `P` satisfying the split
inequalities `(5.6)` for all row multipliers `u ∈ ℝ^m` such that `u A_I` is integral,
`u A_C = 0`, `u b ∉ ℤ`, and the rows of `A` corresponding to the nonzero entries of `u`
are linearly independent. -/
theorem mixed_split_closure_eq_independent_support_split_cut_system
    (A_I : Matrix (Fin m) (Fin nI) ℝ)
    (A_C : Matrix (Fin m) (Fin nC) ℝ)
    (b : Fin m → ℝ)
    (hnI : nI ≠ 0) :
    mixed_split_closure (real_mixed_polyhedron A_I A_C b) =
      independent_support_split_cut_system A_I A_C b := by
  ext xy
  constructor
  · exact memIndependentSupportSplitCutSystem_of_memMixedSplitClosure A_I A_C b hnI
  · exact memMixedSplitClosure_of_memIndependentSupportSplitCutSystem A_I A_C b

end Corollary56
