import IntegerProgramming_Conforti_2014.Integer.Chapters.Chap03.section_3_2.ch3_sec3_2_theorem_3_4
import IntegerProgramming_Conforti_2014.Integer.Chapters.Chap03.section_3_3.ch3_sec3_3_theorem_3_7
import IntegerProgramming_Conforti_2014.Integer.Chapters.Chap03.section_3_3.ch3_sec3_3_remark_3_10
import IntegerProgramming_Conforti_2014.Integer.Chapters.Chap05.section_5_1.ch5_sec5_1_definition_5_1_extra_1
import IntegerProgramming_Conforti_2014.Integer.Chapters.Chap05.section_5_1.ch5_sec5_1_lemma_5_3

open scoped Matrix

section Theorem55

variable {m n : ℕ}

/-- The support of a row multiplier `u`, viewed as the set of indices of its nonzero entries. -/
noncomputable def row_multiplier_support
    (u : Fin m → ℝ) : Finset (Fin m) :=
  Finset.univ.filter fun i : Fin m ↦ u i ≠ 0

/-- The rows of `A` indexed by the support of `u` are linearly independent. -/
def RowMultiplierHasIndependentSupportRows
    (A : Matrix (Fin m) (Fin n) ℝ)
    (u : Fin m → ℝ) : Prop :=
  LinearIndependent ℝ (fun i : {i // i ∈ row_multiplier_support u} ↦ A i.1)

/-- The set `B_π` of basic row multipliers `u` such that `u A = π` and the rows of `A`
corresponding to the nonzero entries of `u` are linearly independent. -/
def basic_row_multiplier_set
    (A : Matrix (Fin m) (Fin n) ℝ)
    (π : Fin n → ℤ) : Set (Fin m → ℝ) :=
  {u : Fin m → ℝ |
    u ᵥ* A = (fun j : Fin n ↦ (π j : ℝ)) ∧
      RowMultiplierHasIndependentSupportRows A u}

/-- Membership in `basic_row_multiplier_set A π` means reproducing the split row `π` and having
linearly independent support rows. -/
theorem mem_basic_row_multiplier_set_iff
    (A : Matrix (Fin m) (Fin n) ℝ)
    (π : Fin n → ℤ)
    (u : Fin m → ℝ) :
    u ∈ basic_row_multiplier_set A π ↔
      u ᵥ* A = (fun j : Fin n ↦ (π j : ℝ)) ∧
        RowMultiplierHasIndependentSupportRows A u :=
  Iff.rfl

/-- The positive part `u⁺` of a row multiplier, taken coordinatewise. -/
def row_multiplier_pos
    (u : Fin m → ℝ) : Fin m → ℝ :=
  fun i : Fin m ↦ max (u i) 0

/-- The negative part `u⁻` of a row multiplier, taken coordinatewise so that `u = u⁺ - u⁻`. -/
def row_multiplier_neg
    (u : Fin m → ℝ) : Fin m → ℝ :=
  fun i : Fin m ↦ max (-u i) 0

/-- The left-hand side of inequality `(5.7)` generated by the row multiplier `u`. -/
noncomputable def split_cut_value
    (A : Matrix (Fin m) (Fin n) ℝ)
    (b : Fin m → ℝ)
    (u : Fin m → ℝ)
    (π0 : ℤ)
    (x : Fin n → ℝ) : ℝ :=
  row_multiplier_pos u ⬝ᵥ (b - A *ᵥ x) / (u ⬝ᵥ b - (π0 : ℝ)) +
    row_multiplier_neg u ⬝ᵥ (b - A *ᵥ x) / ((π0 : ℝ) + 1 - u ⬝ᵥ b)

/-- The set of points of `P = {x | A x ≤ b}` satisfying every split inequality `(5.7)` arising
from a basic row multiplier `u ∈ B_π` with `π₀ < u b < π₀ + 1`. -/
def basic_split_cut_system
    (A : Matrix (Fin m) (Fin n) ℝ)
    (b : Fin m → ℝ)
    (π : Fin n → ℤ)
    (π0 : ℤ) : Set (Fin n → ℝ) :=
  polyhedron_le_set A b ∩
    {x : Fin n → ℝ |
      ∀ u : Fin m → ℝ,
        u ∈ basic_row_multiplier_set A π →
          (π0 : ℝ) < u ⬝ᵥ b →
            u ⬝ᵥ b < (π0 : ℝ) + 1 →
              1 ≤ split_cut_value A b u π0 x}

/-- Membership in `basic_split_cut_system A b π π0` means belonging to `polyhedron_le_set A b`
and satisfying every basic split-cut inequality `(5.7)` for the split data `(π, π₀)`. -/
theorem mem_basic_split_cut_system_iff
    (A : Matrix (Fin m) (Fin n) ℝ)
    (b : Fin m → ℝ)
    (π : Fin n → ℤ)
    (π0 : ℤ)
    (x : Fin n → ℝ) :
    x ∈ basic_split_cut_system A b π π0 ↔
      A *ᵥ x ≤ b ∧
        ∀ u : Fin m → ℝ,
          u ∈ basic_row_multiplier_set A π →
            (π0 : ℝ) < u ⬝ᵥ b →
              u ⬝ᵥ b < (π0 : ℝ) + 1 →
              1 ≤ split_cut_value A b u π0 x :=
  Iff.rfl

/-- Helper for Theorem 5.5: an index belongs to `row_multiplier_support u` exactly when the
corresponding coordinate of `u` is nonzero. -/
lemma mem_row_multiplier_support_iff
    (u : Fin m → ℝ)
    (i : Fin m) :
    i ∈ row_multiplier_support u ↔ u i ≠ 0 := by
  simp [row_multiplier_support]

/-- Helper for Theorem 5.5: the coordinatewise positive and negative parts reconstruct a row
multiplier. -/
lemma row_multiplier_pos_sub_neg_eq
    (u : Fin m → ℝ) :
    row_multiplier_pos u - row_multiplier_neg u = u := by
  -- Split on the sign of each coordinate so the `max` definitions collapse deterministically.
  ext i
  by_cases hi : 0 ≤ u i
  · have hneg : -u i ≤ 0 := by
      linarith
    simp [row_multiplier_pos, row_multiplier_neg, hi, hneg]
  · have hi' : u i < 0 := lt_of_not_ge hi
    have hneg : 0 ≤ -u i := by
      linarith
    simp [row_multiplier_pos, row_multiplier_neg, hi'.le, hneg]

/-- Helper for Theorem 5.5: the normalized one-variable cut expression is at least `1` once the
lower-gap inequality `f ≤ s₁ - s₂` holds. -/
lemma one_le_fractionalCutExpr_of_lowerGap
    {s1 s2 f : ℝ}
    (hf_pos : 0 < f)
    (hf_lt_one : f < 1)
    (hs2_nonneg : 0 ≤ s2)
    (hgap : f ≤ s1 - s2) :
    1 ≤ s1 / f + s2 / (1 - f) := by
  have h_one_sub_pos : 0 < 1 - f := by
    linarith
  have hnum :
      f * (1 - f) ≤ (1 - f) * s1 + f * s2 := by
    have hscaled :
        (1 - f) * f ≤ (1 - f) * (s1 - s2) := by
      exact mul_le_mul_of_nonneg_left hgap (sub_nonneg.mpr hf_lt_one.le)
    -- Rearranging the gap estimate produces the numerator inequality.
    nlinarith
  have hrepr :
      s1 / f + s2 / (1 - f) =
        ((1 - f) * s1 + f * s2) / (f * (1 - f)) := by
    field_simp [hf_pos.ne', h_one_sub_pos.ne']
  rw [hrepr]
  have hnum' : 1 * (f * (1 - f)) ≤ (1 - f) * s1 + f * s2 := by
    simpa using hnum
  exact (le_div_iff₀ (mul_pos hf_pos h_one_sub_pos)).2 hnum'

/-- Helper for Theorem 5.5: the symmetric upper-gap inequality `1 - f ≤ s₂ - s₁` also forces the
normalized cut expression to be at least `1`. -/
lemma one_le_fractionalCutExpr_of_upperGap
    {s1 s2 f : ℝ}
    (hf_pos : 0 < f)
    (hf_lt_one : f < 1)
    (hs1_nonneg : 0 ≤ s1)
    (hgap : 1 - f ≤ s2 - s1) :
    1 ≤ s1 / f + s2 / (1 - f) := by
  have h_one_sub_pos : 0 < 1 - f := by
    linarith
  have hnum :
      f * (1 - f) ≤ (1 - f) * s1 + f * s2 := by
    have hscaled :
        f * (1 - f) ≤ f * (s2 - s1) := by
      exact mul_le_mul_of_nonneg_left hgap hf_pos.le
    -- Adding the nonnegative `s₁` term yields the desired numerator bound.
    nlinarith
  have hrepr :
      s1 / f + s2 / (1 - f) =
        ((1 - f) * s1 + f * s2) / (f * (1 - f)) := by
    field_simp [hf_pos.ne', h_one_sub_pos.ne']
  rw [hrepr]
  have hnum' : 1 * (f * (1 - f)) ≤ (1 - f) * s1 + f * s2 := by
    simpa using hnum
  exact (le_div_iff₀ (mul_pos hf_pos h_one_sub_pos)).2 hnum'

/-- Helper for Theorem 5.5: the positive-minus-negative slack equals the scalar gap
`u b - π x` whenever `u A = π`. -/
lemma splitCutRowSlackGap_eq_rhsGap
    (A : Matrix (Fin m) (Fin n) ℝ)
    (b : Fin m → ℝ)
    (u : Fin m → ℝ)
    (π : Fin n → ℤ)
    (huπ : u ᵥ* A = fun j : Fin n ↦ (π j : ℝ))
    (x : Fin n → ℝ) :
    row_multiplier_pos u ⬝ᵥ (b - A *ᵥ x) -
        row_multiplier_neg u ⬝ᵥ (b - A *ᵥ x) =
      u ⬝ᵥ b - split_dot π x := by
  have hdecomp : row_multiplier_pos u - row_multiplier_neg u = u :=
    row_multiplier_pos_sub_neg_eq u
  have hAu : u ⬝ᵥ (A *ᵥ x) = split_dot π x := by
    -- Rewrite the row action `u A` into the split coefficients `π`.
    rw [Matrix.dotProduct_mulVec, huπ, split_dot]
  calc
    row_multiplier_pos u ⬝ᵥ (b - A *ᵥ x) -
        row_multiplier_neg u ⬝ᵥ (b - A *ᵥ x)
        = (row_multiplier_pos u - row_multiplier_neg u) ⬝ᵥ (b - A *ᵥ x) := by
            rw [sub_dotProduct]
    _ = u ⬝ᵥ (b - A *ᵥ x) := by
          rw [hdecomp]
    _ = u ⬝ᵥ b - u ⬝ᵥ (A *ᵥ x) := by
          rw [dotProduct_sub]
    _ = u ⬝ᵥ b - split_dot π x := by
          rw [hAu]

/-- Helper for Theorem 5.5: the split-cut value is affine on convex combinations of points. -/
lemma splitCutValue_convexCombination
    (A : Matrix (Fin m) (Fin n) ℝ)
    (b : Fin m → ℝ)
    (u : Fin m → ℝ)
    (π0 : ℤ)
    (α β : ℝ)
    (hαβ : α + β = 1)
    (x y : Fin n → ℝ) :
    split_cut_value A b u π0 (α • x + β • y) =
      α * split_cut_value A b u π0 x +
        β * split_cut_value A b u π0 y := by
  have hslack :
      b - A *ᵥ (α • x + β • y) =
        α • (b - A *ᵥ x) + β • (b - A *ᵥ y) := by
    -- The slack vector is affine because the coefficients add to `1`.
    ext i
    rw [Matrix.mulVec_add, Matrix.mulVec_smul, Matrix.mulVec_smul]
    simp only [Pi.sub_apply, Pi.add_apply, Pi.smul_apply, smul_eq_mul]
    have hβ : β = 1 - α := by
      linarith
    rw [hβ]
    ring
  -- Push the affine slack decomposition through both dot products in the cut formula.
  rw [split_cut_value, split_cut_value, split_cut_value, hslack]
  rw [dotProduct_add, dotProduct_smul, dotProduct_smul]
  rw [dotProduct_add, dotProduct_smul, dotProduct_smul]
  simp [smul_eq_mul]
  ring

/-- Helper for Theorem 5.5: every fixed split-cut halfspace is convex. -/
lemma splitCutHalfspace_convex
    (A : Matrix (Fin m) (Fin n) ℝ)
    (b : Fin m → ℝ)
    (u : Fin m → ℝ)
    (π0 : ℤ) :
    Convex ℝ {x : Fin n → ℝ | 1 ≤ split_cut_value A b u π0 x} := by
  intro x hx y hy α β hα_nonneg hβ_nonneg hαβ
  have hx' : 1 ≤ split_cut_value A b u π0 x := by
    simpa using hx
  have hy' : 1 ≤ split_cut_value A b u π0 y := by
    simpa using hy
  -- Affinity of the cut value turns convexity into a one-line arithmetic estimate.
  change 1 ≤ split_cut_value A b u π0 (α • x + β • y)
  rw [splitCutValue_convexCombination A b u π0 α β hαβ x y]
  nlinarith

/-- Helper for Theorem 5.5: points on the lower split branch satisfy the split inequality `(5.7)`
for any row multiplier reproducing the split row. -/
lemma one_le_splitCutValue_of_mem_split_branch_lower
    (A : Matrix (Fin m) (Fin n) ℝ)
    (b : Fin m → ℝ)
    (π : Fin n → ℤ)
    (π0 : ℤ)
    (u : Fin m → ℝ)
    (huπ : u ᵥ* A = fun j : Fin n ↦ (π j : ℝ))
    (hub_left : (π0 : ℝ) < u ⬝ᵥ b)
    (hub_right : u ⬝ᵥ b < (π0 : ℝ) + 1)
    {x : Fin n → ℝ}
    (hx : x ∈ split_branch_lower (polyhedron_le_set A b) π π0) :
    1 ≤ split_cut_value A b u π0 x := by
  rcases (mem_split_branch_lower_iff.mp hx) with ⟨hxP, hxlower⟩
  let r : Fin m → ℝ := b - A *ᵥ x
  let s1 : ℝ := row_multiplier_pos u ⬝ᵥ r
  let s2 : ℝ := row_multiplier_neg u ⬝ᵥ r
  have hr_nonneg : 0 ≤ r := by
    intro i
    dsimp [r]
    exact sub_nonneg.mpr (hxP i)
  have hs2_nonneg : 0 ≤ s2 := by
    -- Every negative-part slack term is nonnegative.
    dsimp [s2]
    exact dotProduct_nonneg_of_nonneg
      (by
        intro i
        simp [row_multiplier_neg])
      hr_nonneg
  have hgap_eq : s1 - s2 = u ⬝ᵥ b - split_dot π x := by
    simpa [r, s1, s2] using splitCutRowSlackGap_eq_rhsGap A b u π huπ x
  have hf_pos : 0 < u ⬝ᵥ b - (π0 : ℝ) := by
    linarith
  have hf_lt_one : u ⬝ᵥ b - (π0 : ℝ) < 1 := by
    linarith
  have hgap : u ⬝ᵥ b - (π0 : ℝ) ≤ s1 - s2 := by
    rw [hgap_eq]
    linarith
  have hden : (π0 : ℝ) + 1 - u ⬝ᵥ b = 1 - (u ⬝ᵥ b - (π0 : ℝ)) := by
    ring
  -- The branch inequality gives exactly the lower-gap estimate in the one-variable cut lemma.
  simpa [split_cut_value, r, s1, s2, hden] using
    one_le_fractionalCutExpr_of_lowerGap hf_pos hf_lt_one hs2_nonneg hgap

/-- Helper for Theorem 5.5: points on the upper split branch satisfy the split inequality `(5.7)`
for any row multiplier reproducing the split row. -/
lemma one_le_splitCutValue_of_mem_split_branch_upper
    (A : Matrix (Fin m) (Fin n) ℝ)
    (b : Fin m → ℝ)
    (π : Fin n → ℤ)
    (π0 : ℤ)
    (u : Fin m → ℝ)
    (huπ : u ᵥ* A = fun j : Fin n ↦ (π j : ℝ))
    (hub_left : (π0 : ℝ) < u ⬝ᵥ b)
    (hub_right : u ⬝ᵥ b < (π0 : ℝ) + 1)
    {x : Fin n → ℝ}
    (hx : x ∈ split_branch_upper (polyhedron_le_set A b) π π0) :
    1 ≤ split_cut_value A b u π0 x := by
  rcases (mem_split_branch_upper_iff.mp hx) with ⟨hxP, hxupper⟩
  let r : Fin m → ℝ := b - A *ᵥ x
  let s1 : ℝ := row_multiplier_pos u ⬝ᵥ r
  let s2 : ℝ := row_multiplier_neg u ⬝ᵥ r
  have hr_nonneg : 0 ≤ r := by
    intro i
    dsimp [r]
    exact sub_nonneg.mpr (hxP i)
  have hs1_nonneg : 0 ≤ s1 := by
    -- Every positive-part slack term is nonnegative.
    dsimp [s1]
    exact dotProduct_nonneg_of_nonneg
      (by
        intro i
        simp [row_multiplier_pos])
      hr_nonneg
  have hgap_eq : s1 - s2 = u ⬝ᵥ b - split_dot π x := by
    simpa [r, s1, s2] using splitCutRowSlackGap_eq_rhsGap A b u π huπ x
  have hgap_eq' : s2 - s1 = split_dot π x - u ⬝ᵥ b := by
    linarith
  have hf_pos : 0 < u ⬝ᵥ b - (π0 : ℝ) := by
    linarith
  have hf_lt_one : u ⬝ᵥ b - (π0 : ℝ) < 1 := by
    linarith
  have hgap : 1 - (u ⬝ᵥ b - (π0 : ℝ)) ≤ s2 - s1 := by
    rw [hgap_eq']
    linarith
  have hden : (π0 : ℝ) + 1 - u ⬝ᵥ b = 1 - (u ⬝ᵥ b - (π0 : ℝ)) := by
    ring
  -- The upper-branch inequality gives the symmetric gap estimate.
  simpa [split_cut_value, r, s1, s2, hden] using
    one_le_fractionalCutExpr_of_upperGap hf_pos hf_lt_one hs1_nonneg hgap

/-- Helper for Theorem 5.5: every point of the split polyhedron belongs to the ambient
polyhedron `P = {x | A x ≤ b}`. -/
lemma mem_polyhedron_of_memSplitPolyhedron
    (A : Matrix (Fin m) (Fin n) ℝ)
    (b : Fin m → ℝ)
    {I : Finset (Fin n)}
    (s : Split I)
    {x : Fin n → ℝ}
    (hx : x ∈ split_polyhedron A b s) :
    x ∈ polyhedron_le_set A b := by
  rw [mem_split_polyhedron_iff, split_hull] at hx
  -- Both split branches already lie in `P`, and `P` is convex.
  refine convexHull_min ?_ (polyhedron_le_set_convex A b) hx
  intro y hy
  rcases hy with hy | hy
  · exact (mem_split_branch_lower_iff.mp hy).1
  · exact (mem_split_branch_upper_iff.mp hy).1

/-- Helper for Theorem 5.5: validity of `(5.7)` on each split branch extends to the whole split
polyhedron. -/
lemma validSplitCutValue_of_memSplitPolyhedron
    (A : Matrix (Fin m) (Fin n) ℝ)
    (b : Fin m → ℝ)
    {I : Finset (Fin n)}
    (s : Split I)
    {x : Fin n → ℝ}
    (hx : x ∈ split_polyhedron A b s)
    (u : Fin m → ℝ)
    (huBasic : u ∈ basic_row_multiplier_set A s)
    (hub_left : (s.π0 : ℝ) < u ⬝ᵥ b)
    (hub_right : u ⬝ᵥ b < (s.π0 : ℝ) + 1) :
    1 ≤ split_cut_value A b u s.π0 x := by
  rcases (mem_basic_row_multiplier_set_iff A s u).mp huBasic with ⟨huπ, _⟩
  rw [mem_split_polyhedron_iff, split_hull] at hx
  -- The cut is valid on each generator branch, and the cut halfspace is convex.
  refine convexHull_min ?_ (splitCutHalfspace_convex A b u s.π0) hx
  intro y hy
  rcases hy with hy | hy
  · exact one_le_splitCutValue_of_mem_split_branch_lower
      A b s s.π0 u huπ hub_left hub_right hy
  · exact one_le_splitCutValue_of_mem_split_branch_upper
      A b s s.π0 u huπ hub_left hub_right hy

/-- Helper for Theorem 5.5: if `x̄ ∈ P` but `x̄ ∉ P^(π, π₀)`, then `x̄` lies in the open split
strip `π₀ < π x̄ < π₀ + 1`. -/
lemma memSplitStrip_of_polyhedron_not_memSplitPolyhedron
    (A : Matrix (Fin m) (Fin n) ℝ)
    (b : Fin m → ℝ)
    {I : Finset (Fin n)}
    (s : Split I)
    {xbar : Fin n → ℝ}
    (hxbar_poly : xbar ∈ polyhedron_le_set A b)
    (hxbar_not : xbar ∉ split_polyhedron A b s) :
    xbar ∈ split_strip s s.π0 := by
  refine (mem_split_strip_iff).2 ⟨?_, ?_⟩
  · by_contra hleft
    apply hxbar_not
    rw [mem_split_polyhedron_iff, split_hull]
    exact subset_convexHull ℝ
      (split_branch_lower (polyhedron_le_set A b) s s.π0 ∪
        split_branch_upper (polyhedron_le_set A b) s s.π0)
      (Or.inl ((mem_split_branch_lower_iff).2 ⟨hxbar_poly, not_lt.mp hleft⟩))
  · by_contra hright
    apply hxbar_not
    rw [mem_split_polyhedron_iff, split_hull]
    exact subset_convexHull ℝ
      (split_branch_lower (polyhedron_le_set A b) s s.π0 ∪
        split_branch_upper (polyhedron_le_set A b) s s.π0)
      (Or.inr ((mem_split_branch_upper_iff).2 ⟨hxbar_poly, not_lt.mp hright⟩))

/-- Helper for Theorem 5.5: the raw stacked auxiliary system used to search for an upper-point
witness is exactly `A x ≤ b` together with the scaled-slack bound from Lemma 5.3. -/
lemma upperPointAuxPrimalFeasible_iff
    (A : Matrix (Fin m) (Fin n) ℝ)
    (b : Fin m → ℝ)
    (δ : ℝ)
    (rbar : Fin m → ℝ)
    (x : Fin n → ℝ) :
    ((Matrix.fromRows A (-A) : Matrix (Fin m ⊕ Fin m) (Fin n) ℝ) *ᵥ x ≤
        Sum.elim b (δ⁻¹ • rbar - b)) ↔
      A *ᵥ x ≤ b ∧
        b - A *ᵥ x ≤ δ⁻¹ • rbar := by
  constructor
  · intro hx
    constructor
    · intro i
      have hi :
          (Matrix.fromRows A (-A) *ᵥ x) (Sum.inl i) ≤
            Sum.elim b (δ⁻¹ • rbar - b) (Sum.inl i) :=
        hx (Sum.inl i)
      simpa [Matrix.fromRows_mulVec] using hi
    · intro i
      have hi :
          (Matrix.fromRows A (-A) *ᵥ x) (Sum.inr i) ≤
            Sum.elim b (δ⁻¹ • rbar - b) (Sum.inr i) :=
        hx (Sum.inr i)
      have hi' : -((A *ᵥ x) i) ≤ (δ⁻¹ • rbar) i - b i := by
        simpa [Matrix.fromRows_mulVec, Matrix.neg_mulVec, Pi.sub_apply] using hi
      have : b i - (A *ᵥ x) i ≤ (δ⁻¹ • rbar) i := by
        linarith
      simpa [Pi.sub_apply] using this
  · rintro ⟨hx_poly, hx_slack⟩
    intro s
    rcases s with i | i
    · -- The top block is the original polyhedron feasibility system.
      simpa [Matrix.fromRows_mulVec] using hx_poly i
    · -- The lower block is exactly the scaled residual inequality after moving `b i` across.
      have hi : b i - (A *ᵥ x) i ≤ (δ⁻¹ • rbar) i := by
        simpa [Pi.sub_apply] using hx_slack i
      have hi' : -((A *ᵥ x) i) ≤ (δ⁻¹ • rbar) i - b i := by
        linarith
      simpa [Matrix.fromRows_mulVec, Matrix.neg_mulVec, Pi.sub_apply] using hi'

/-- Helper for Theorem 5.5: after reindexing the stacked row system along `finSumFinEquiv`, the
Remark 3.10 threshold system is exactly the upper-branch search problem from Lemma 5.3. -/
lemma upperPointThresholdFeasible_iff
    (A : Matrix (Fin m) (Fin n) ℝ)
    (b : Fin m → ℝ)
    {I : Finset (Fin n)}
    (s : Split I)
    (δ : ℝ)
    (rbar : Fin m → ℝ)
    (x : Fin n → ℝ) :
    objective_threshold_matrix
        ((Matrix.fromRows A (-A)).reindex finSumFinEquiv (Equiv.refl _))
        (fun j : Fin n ↦ (s j : ℝ)) *ᵥ x ≤
    objective_threshold_rhs
        ((Sum.elim b (δ⁻¹ • rbar - b)) ∘ finSumFinEquiv.symm)
        ((s.π0 : ℝ) + 1) ↔
      x ∈ split_branch_upper (polyhedron_le_set A b) s s.π0 ∧
        b - A *ᵥ x ≤ δ⁻¹ • rbar := by
  let rawA : Matrix (Fin m ⊕ Fin m) (Fin n) ℝ := Matrix.fromRows A (-A)
  let stackedA : Matrix (Fin (m + m)) (Fin n) ℝ :=
    rawA.reindex finSumFinEquiv (Equiv.refl _)
  let rawb : Fin m ⊕ Fin m → ℝ := Sum.elim b (δ⁻¹ • rbar - b)
  let stackedb : Fin (m + m) → ℝ := rawb ∘ finSumFinEquiv.symm
  have hmul :=
    Matrix.submatrix_mulVec_equiv rawA x finSumFinEquiv.symm (Equiv.refl _)
  constructor
  · intro hx
    have hxRows : stackedA *ᵥ x ≤ stackedb := by
      intro i
      simpa [stackedA, stackedb] using hx i.succ
    have hxRaw : rawA *ᵥ x ≤ rawb := by
      intro i
      have hrow := hxRows (finSumFinEquiv i)
      have hEq :
          (stackedA *ᵥ x) (finSumFinEquiv i) = (rawA *ᵥ x) i := by
        simpa [stackedA, Matrix.reindex_apply] using congrFun hmul (finSumFinEquiv i)
      have hRhs : stackedb (finSumFinEquiv i) = rawb i := by
        simp [stackedb, rawb]
      rw [hEq, hRhs] at hrow
      exact hrow
    rcases (upperPointAuxPrimalFeasible_iff A b δ rbar x).1 hxRaw with ⟨hxPoly, hxSlack⟩
    have hupper : (s.π0 : ℝ) + 1 ≤ split_dot s x := by
      have hzero :
          (objective_threshold_matrix stackedA (fun j : Fin n ↦ (s j : ℝ)) *ᵥ x) 0 ≤
            objective_threshold_rhs stackedb ((s.π0 : ℝ) + 1) 0 :=
        hx 0
      have hneg : -split_dot s x ≤ -((s.π0 : ℝ) + 1) := by
        simpa [split_dot_eq_sum, Matrix.mulVec, dotProduct, neg_mul,
          Finset.sum_neg_distrib] using hzero
      linarith
    exact ⟨(mem_split_branch_upper_iff).2 ⟨hxPoly, hupper⟩, hxSlack⟩
  · rintro ⟨hxUpper, hxSlack⟩
    rcases (mem_split_branch_upper_iff.mp hxUpper) with ⟨hxPoly, hupper⟩
    have hxRaw : rawA *ᵥ x ≤ rawb :=
      (upperPointAuxPrimalFeasible_iff A b δ rbar x).2 ⟨hxPoly, hxSlack⟩
    have hxRows : stackedA *ᵥ x ≤ stackedb := by
      intro i
      have hrow := hxRaw (finSumFinEquiv.symm i)
      have hEq :
          (stackedA *ᵥ x) i = (rawA *ᵥ x) (finSumFinEquiv.symm i) := by
        simpa [stackedA, Matrix.reindex_apply] using congrFun hmul i
      have hRhs : stackedb i = rawb (finSumFinEquiv.symm i) := by
        simp [stackedb, rawb]
      rw [hEq, hRhs]
      exact hrow
    refine Fin.cases ?_ ?_
    · have hneg : -split_dot s x ≤ -((s.π0 : ℝ) + 1) := by
        linarith
      simpa [split_dot_eq_sum, Matrix.mulVec, dotProduct, neg_mul,
        Finset.sum_neg_distrib] using hneg
    · intro i
      simpa [stackedA, stackedb] using hxRows i

/-- Helper for Theorem 5.5: if the objective-threshold system `c ⬝ᵥ x ≥ z`, `A x ≤ b` is
infeasible while `A x ≤ b` itself is feasible, then some dual-feasible multiplier has value
strictly below `z`. -/
lemma existsDualFeasibleBelow_of_objectiveThresholdInfeasible
    (A : Matrix (Fin m) (Fin n) ℝ)
    (b : Fin m → ℝ)
    (c : Fin n → ℝ)
    (hP : Set.Nonempty (primal_feasible_region A b))
    {z : ℝ}
    (h_infeasible :
      ¬ ∃ x : Fin n → ℝ,
          objective_threshold_matrix A c *ᵥ x ≤ objective_threshold_rhs b z) :
    ∃ u ∈ dual_feasible_region A c, u ⬝ᵥ b < z := by
  let B := objective_threshold_matrix A c
  let r := objective_threshold_rhs b z
  obtain ⟨y, hy⟩ := (farkas_lemma_linear_inequalities B r).mp h_infeasible
  let α : ℝ := y 0
  let uRaw : Fin m → ℝ := fun i ↦ y i.succ
  have hα_pos : 0 < α := by
    have hα_nonneg : 0 ≤ α := by
      simpa [α] using hy.nonneg 0
    by_contra hα_not_pos
    have hα_eq : α = 0 := by
      linarith
    have huRaw_cert : IsFarkasCertificate A b uRaw := by
      refine
        { nonneg := ?_
          annihilates := ?_
          negative_rhs := ?_ }
      · intro i
        simpa [uRaw] using hy.nonneg i.succ
      · ext j
        have hj0 : (y ᵥ* B) j = 0 := by
          simpa [B] using congrFun hy.annihilates j
        have hj : -α * c j + (uRaw ᵥ* A) j = 0 := by
          simpa [α, uRaw, B, vecMul_objective_threshold_matrix A c y] using hj0
        simpa [hα_eq] using hj
      · have hy_rhs : -α * z + uRaw ⬝ᵥ b < 0 := by
          simpa [α, uRaw, r, dotProduct_objective_threshold_rhs b z y] using hy.negative_rhs
        simpa [hα_eq] using hy_rhs
    rcases hP with ⟨x, hx⟩
    exact (farkas_certificate_excludes_solution huRaw_cert)
      ⟨x, (mem_primal_feasible_region_iff A b x).mp hx⟩
  have huRaw_eq : uRaw ᵥ* A = α • c := by
    ext j
    have hj0 : (y ᵥ* B) j = 0 := by
      simpa [B] using congrFun hy.annihilates j
    have hj' : -α * c j + (uRaw ᵥ* A) j = 0 := by
      simpa [α, uRaw, B, vecMul_objective_threshold_matrix A c y] using hj0
    have hj'' : (uRaw ᵥ* A) j = α * c j := by
      linarith
    simpa [Pi.smul_apply] using hj''
  let u : Fin m → ℝ := (1 / α) • uRaw
  have hu_mem : u ∈ dual_feasible_region A c := by
    rw [mem_dual_feasible_region_iff]
    constructor
    · calc
        u ᵥ* A = ((1 / α) • uRaw) ᵥ* A := by rfl
        _ = (1 / α) • (uRaw ᵥ* A) := by rw [Matrix.smul_vecMul]
        _ = (1 / α) • (α • c) := by rw [huRaw_eq]
        _ = c := by
          ext j
          simp [hα_pos.ne']
    · intro i
      exact smul_nonneg (one_div_nonneg.mpr hα_pos.le) (hy.nonneg i.succ)
  have hy_rhs : -α * z + uRaw ⬝ᵥ b < 0 := by
    simpa [α, uRaw, r, dotProduct_objective_threshold_rhs] using hy.negative_rhs
  have hu_lt : u ⬝ᵥ b < z := by
    have huRaw_lt : uRaw ⬝ᵥ b < α * z := by
      linarith
    have huRaw_lt' : uRaw ⬝ᵥ b < z * α := by
      simpa [mul_comm] using huRaw_lt
    have hu_div : (uRaw ⬝ᵥ b) / α < z := by
      exact (div_lt_iff₀ hα_pos).2 huRaw_lt'
    have hu_value : u ⬝ᵥ b = (uRaw ⬝ᵥ b) / α := by
      calc
        u ⬝ᵥ b = ((1 / α) • uRaw) ⬝ᵥ b := by rfl
        _ = (1 / α) * (uRaw ⬝ᵥ b) := by
              rw [smul_dotProduct]
              simp [smul_eq_mul]
        _ = (uRaw ⬝ᵥ b) / α := by field_simp [hα_pos.ne']
    rw [hu_value]
    exact hu_div
  exact ⟨u, hu_mem, hu_lt⟩

/-- Helper for Theorem 5.5: nonnegative stacked dual multipliers with disjoint positive support
recover the coordinatewise positive and negative parts of the signed row multiplier
`uPos - uNeg`. -/
lemma rowMultiplierParts_eq_of_disjointPair
    {uPos uNeg : Fin m → ℝ}
    (huPos_nonneg : 0 ≤ uPos)
    (huNeg_nonneg : 0 ≤ uNeg)
    (hdisjoint : ∀ i : Fin m, ¬ (0 < uPos i ∧ 0 < uNeg i)) :
    row_multiplier_pos (uPos - uNeg) = uPos ∧
      row_multiplier_neg (uPos - uNeg) = uNeg := by
  constructor
  · -- On each coordinate, either the positive entry stays and the negative entry vanishes, or the
    -- entire difference is nonpositive and the positive part is zero.
    ext i
    by_cases hpos : 0 < uPos i
    · have hneg_zero : uNeg i = 0 := by
        by_contra hne
        have hneg_pos : 0 < uNeg i := lt_of_le_of_ne (huNeg_nonneg i) (Ne.symm hne)
        exact (hdisjoint i) ⟨hpos, hneg_pos⟩
      have hpos_nonneg : 0 ≤ uPos i := huPos_nonneg i
      have hsub_nonneg : 0 ≤ (uPos - uNeg) i := by
        simp [Pi.sub_apply, hneg_zero, le_of_lt hpos]
      simp [row_multiplier_pos, Pi.sub_apply, hneg_zero, hpos_nonneg]
    · have hpos_zero : uPos i = 0 := le_antisymm (not_lt.mp hpos) (huPos_nonneg i)
      have hneg_nonneg : 0 ≤ uNeg i := huNeg_nonneg i
      simpa [row_multiplier_pos, Pi.sub_apply, hpos_zero] using hneg_nonneg
  · -- The same case split identifies the negative part with the second block.
    ext i
    by_cases hneg : 0 < uNeg i
    · have hpos_zero : uPos i = 0 := by
        by_contra hne
        have hpos_pos : 0 < uPos i := lt_of_le_of_ne (huPos_nonneg i) (Ne.symm hne)
        exact (hdisjoint i) ⟨hpos_pos, hneg⟩
      simpa [row_multiplier_neg, Pi.sub_apply, hpos_zero] using (huNeg_nonneg i)
    · have hneg_zero : uNeg i = 0 := le_antisymm (not_lt.mp hneg) (huNeg_nonneg i)
      have hpos_nonneg : 0 ≤ uPos i := huPos_nonneg i
      simpa [row_multiplier_neg, Pi.sub_apply, hneg_zero] using hpos_nonneg

/-- Helper for Theorem 5.5: after compressing a nonnegative pair to the signed multiplier
`uPos - uNeg`, the negative part can only shrink coordinatewise. -/
lemma rowMultiplierNeg_le_of_nonnegPairDifference
    {uPos uNeg : Fin m → ℝ}
    (huPos_nonneg : 0 ≤ uPos)
    (huNeg_nonneg : 0 ≤ uNeg) :
    row_multiplier_neg (uPos - uNeg) ≤ uNeg := by
  intro i
  -- Split on the sign of the compressed coordinate so the `max` normal form is explicit.
  by_cases hsub_nonpos : uPos i - uNeg i ≤ 0
  · have hneg_nonneg : 0 ≤ -(uPos i - uNeg i) := by
      linarith
    rw [row_multiplier_neg, Pi.sub_apply, max_eq_left hneg_nonneg]
    have hle : -(uPos i - uNeg i) ≤ uNeg i := by
      simpa [sub_eq_add_neg, add_comm, add_left_comm, add_assoc] using
        (sub_le_self (uNeg i) (huPos_nonneg i))
    exact hle
  · have hsub_pos : 0 < uPos i - uNeg i := by
      linarith
    have hneg_nonpos : -(uPos i - uNeg i) ≤ 0 := by
      linarith
    rw [row_multiplier_neg, Pi.sub_apply, max_eq_right hneg_nonpos]
    exact huNeg_nonneg i

/-- Helper for Theorem 5.5: compressing a strict nonnegative dual pair to the signed multiplier
preserves the strict objective bound because only the negative part enters the residual term. -/
lemma strictSignedObjective_of_nonnegDualPair
    (A : Matrix (Fin m) (Fin n) ℝ)
    (b : Fin m → ℝ)
    {I : Finset (Fin n)}
    (s : Split I)
    {xbar : Fin n → ℝ}
    {uPos uNeg : Fin m → ℝ}
    (huPos_nonneg : 0 ≤ uPos)
    (huNeg_nonneg : 0 ≤ uNeg)
    (hxbar_poly : xbar ∈ polyhedron_le_set A b)
    (hδ_pos : 0 < split_dot s xbar - (s.π0 : ℝ))
    (hstrict :
      ((uPos - uNeg) ⬝ᵥ b) +
          (uNeg ⬝ᵥ (b - A *ᵥ xbar)) / (split_dot s xbar - (s.π0 : ℝ)) <
        (s.π0 : ℝ) + 1) :
    ((uPos - uNeg) ⬝ᵥ b) +
        (row_multiplier_neg (uPos - uNeg) ⬝ᵥ (b - A *ᵥ xbar)) /
            (split_dot s xbar - (s.π0 : ℝ)) <
      (s.π0 : ℝ) + 1 := by
  let r : Fin m → ℝ := b - A *ᵥ xbar
  have hr_nonneg : 0 ≤ r := by
    -- Feasibility of `xbar` makes every residual coordinate nonnegative.
    intro i
    dsimp [r]
    exact sub_nonneg.mpr (hxbar_poly i)
  have hneg_le :
      row_multiplier_neg (uPos - uNeg) ≤ uNeg :=
    rowMultiplierNeg_le_of_nonnegPairDifference huPos_nonneg huNeg_nonneg
  have hdot_le :
      row_multiplier_neg (uPos - uNeg) ⬝ᵥ r ≤ uNeg ⬝ᵥ r := by
    -- Dot-product monotonicity transfers the coordinatewise bound to the residual term.
    exact dotProduct_le_dotProduct_of_nonneg_right hneg_le hr_nonneg
  have hdiv_le :
      (row_multiplier_neg (uPos - uNeg) ⬝ᵥ r) / (split_dot s xbar - (s.π0 : ℝ)) ≤
        (uNeg ⬝ᵥ r) / (split_dot s xbar - (s.π0 : ℝ)) := by
    exact div_le_div_of_nonneg_right hdot_le hδ_pos.le
  -- Only the residual term changes under compression, so the strict pair bound remains strict.
  dsimp [r] at hdiv_le
  linarith

/-- Helper for Theorem 5.5: from `x̄ ∈ P \ P^(π, π₀)` one obtains a strict stacked-dual
certificate whose two blocks are the source proof's multipliers `u¹` and `u²`. -/
lemma existsStrictViolatingDualPair_of_not_memSplitPolyhedron
    (A : Matrix (Fin m) (Fin n) ℝ)
    (b : Fin m → ℝ)
    {I : Finset (Fin n)}
    (s : Split I)
    {xbar : Fin n → ℝ}
    (hxbar_poly : xbar ∈ polyhedron_le_set A b)
    (hxbar_not : xbar ∉ split_polyhedron A b s) :
    ∃ uPos uNeg : Fin m → ℝ,
      0 ≤ uPos ∧
        0 ≤ uNeg ∧
          (uPos - uNeg) ᵥ* A = (fun j : Fin n ↦ (s j : ℝ)) ∧
            ((uPos - uNeg) ⬝ᵥ b) +
                (uNeg ⬝ᵥ (b - A *ᵥ xbar)) / (split_dot s xbar - (s.π0 : ℝ)) <
              (s.π0 : ℝ) + 1 := by
  let δ : ℝ := split_dot s xbar - (s.π0 : ℝ)
  let rbar : Fin m → ℝ := b - A *ᵥ xbar
  let rawA : Matrix (Fin m ⊕ Fin m) (Fin n) ℝ := Matrix.fromRows A (-A)
  let stackedA : Matrix (Fin (m + m)) (Fin n) ℝ :=
    rawA.reindex finSumFinEquiv (Equiv.refl _)
  let rawb : Fin m ⊕ Fin m → ℝ := Sum.elim b (δ⁻¹ • rbar - b)
  let stackedb : Fin (m + m) → ℝ := rawb ∘ finSumFinEquiv.symm
  have hxbar_strip : xbar ∈ split_strip s s.π0 :=
    memSplitStrip_of_polyhedron_not_memSplitPolyhedron A b s hxbar_poly hxbar_not
  have hδ_pos : 0 < δ := by
    simpa [δ] using (mem_split_strip_iff.mp hxbar_strip).1
  have hδ_lt_one : δ < 1 := by
    rcases mem_split_strip_iff.mp hxbar_strip with ⟨hleft, hright⟩
    dsimp [δ]
    linarith
  have hrbar_nonneg : 0 ≤ rbar := by
    -- Feasibility of `xbar` makes the residual vector coordinatewise nonnegative.
    intro i
    exact sub_nonneg.mpr (hxbar_poly i)
  have hxbar_raw : rawA *ᵥ xbar ≤ rawb := by
    refine (upperPointAuxPrimalFeasible_iff A b δ rbar xbar).2 ⟨hxbar_poly, ?_⟩
    intro i
    have hscaled : (rbar i) * δ ≤ rbar i := by
      have hδ_le_one : δ ≤ 1 := by
        linarith
      simpa using mul_le_mul_of_nonneg_left hδ_le_one (hrbar_nonneg i)
    have hi : rbar i ≤ (rbar i) / δ := by
      exact (le_div_iff₀ hδ_pos).2 hscaled
    simpa [rbar, Pi.sub_apply, Pi.smul_apply, smul_eq_mul, div_eq_mul_inv, mul_comm] using hi
  have hmul :=
    Matrix.submatrix_mulVec_equiv rawA xbar finSumFinEquiv.symm (Equiv.refl _)
  have hxbar_base : xbar ∈ primal_feasible_region stackedA stackedb := by
    rw [mem_primal_feasible_region_iff]
    intro i
    have hrow := hxbar_raw (finSumFinEquiv.symm i)
    have hEq :
        (stackedA *ᵥ xbar) i = (rawA *ᵥ xbar) (finSumFinEquiv.symm i) := by
      simpa [stackedA, Matrix.reindex_apply] using congrFun hmul i
    have hRhs : stackedb i = rawb (finSumFinEquiv.symm i) := by
      simp [stackedb, rawb]
    rw [hEq, hRhs]
    exact hrow
  have h_infeasible :
      ¬ ∃ x : Fin n → ℝ,
          objective_threshold_matrix stackedA (fun j : Fin n ↦ (s j : ℝ)) *ᵥ x ≤
            objective_threshold_rhs stackedb ((s.π0 : ℝ) + 1) := by
    intro hx
    rcases hx with ⟨x, hx⟩
    rcases (upperPointThresholdFeasible_iff A b s δ rbar x).1 hx with ⟨hxUpper, hxSlack⟩
    have hxsplit : xbar ∈ split_polyhedron A b s := by
      refine (mem_split_polyhedron_iff_exists_upper_point A b s xbar hxbar_strip).2 ?_
      exact ⟨x, hxUpper, by simpa [δ, rbar] using hxSlack⟩
    exact hxbar_not hxsplit
  obtain ⟨w, hw_dual, hw_value⟩ :=
    existsDualFeasibleBelow_of_objectiveThresholdInfeasible
      stackedA stackedb (fun j : Fin n ↦ (s j : ℝ)) ⟨xbar, hxbar_base⟩ h_infeasible
  rcases (mem_dual_feasible_region_iff stackedA (fun j : Fin n ↦ (s j : ℝ)) w).mp hw_dual with
    ⟨hw_eq, hw_nonneg⟩
  let wRaw : Fin m ⊕ Fin m → ℝ := w ∘ finSumFinEquiv
  let uPos : Fin m → ℝ := wRaw ∘ Sum.inl
  let uNeg : Fin m → ℝ := wRaw ∘ Sum.inr
  have hw_vec :=
    Matrix.submatrix_vecMul_equiv rawA w finSumFinEquiv.symm (Equiv.refl _)
  have hw_rawEq : wRaw ᵥ* rawA = (fun j : Fin n ↦ (s j : ℝ)) := by
    ext j
    calc
      (wRaw ᵥ* rawA) j = (w ᵥ* stackedA) j := by
          symm
          simpa [wRaw, stackedA, Matrix.reindex_apply] using congrFun hw_vec j
      _ = (s j : ℝ) := congrFun hw_eq j
  have huPos_nonneg : 0 ≤ uPos := by
    intro i
    exact hw_nonneg (finSumFinEquiv (Sum.inl i))
  have huNeg_nonneg : 0 ≤ uNeg := by
    intro i
    exact hw_nonneg (finSumFinEquiv (Sum.inr i))
  have huπ : (uPos - uNeg) ᵥ* A = (fun j : Fin n ↦ (s j : ℝ)) := by
    have hwRaw_split : Sum.elim uPos uNeg = wRaw := by
      funext i
      cases i <;> rfl
    ext j
    have hj :
        (uPos ᵥ* A) j + (uNeg ᵥ* (-A)) j = (s j : ℝ) := by
      simpa [hwRaw_split, rawA, Matrix.vecMul_fromRows, add_assoc] using
        congrFun hw_rawEq j
    have hsub : ((uPos - uNeg) ᵥ* A) j = (uPos ᵥ* A) j - (uNeg ᵥ* A) j := by
      simpa [Pi.sub_apply] using congrFun (Matrix.sub_vecMul A uPos uNeg) j
    have hneg : (uNeg ᵥ* (-A)) j = -((uNeg ᵥ* A) j) := by
      simpa using congrFun (Matrix.vecMul_neg uNeg A) j
    rw [hsub]
    linarith
  have hw_rhs :
      uPos ⬝ᵥ b + uNeg ⬝ᵥ (δ⁻¹ • rbar - b) = w ⬝ᵥ stackedb := by
    calc
      uPos ⬝ᵥ b + uNeg ⬝ᵥ (δ⁻¹ • rbar - b)
          = (Sum.elim uPos uNeg) ⬝ᵥ rawb := by
              rw [sumElim_dotProduct_sumElim]
      _ = w ⬝ᵥ stackedb := by
            simpa [uPos, uNeg, wRaw, stackedb, rawb, Function.comp] using
              (comp_equiv_symm_dotProduct w rawb finSumFinEquiv.symm).symm
  have hstrict :
      ((uPos - uNeg) ⬝ᵥ b) + (uNeg ⬝ᵥ rbar) / δ < (s.π0 : ℝ) + 1 := by
    have hsplit : uPos ⬝ᵥ b + uNeg ⬝ᵥ (δ⁻¹ • rbar - b) < (s.π0 : ℝ) + 1 := by
      rw [hw_rhs]
      exact hw_value
    have hrewrite :
        uPos ⬝ᵥ b + uNeg ⬝ᵥ (δ⁻¹ • rbar - b) =
          ((uPos - uNeg) ⬝ᵥ b) + (uNeg ⬝ᵥ rbar) / δ := by
      calc
        uPos ⬝ᵥ b + uNeg ⬝ᵥ (δ⁻¹ • rbar - b)
            = uPos ⬝ᵥ b + (uNeg ⬝ᵥ (δ⁻¹ • rbar) - uNeg ⬝ᵥ b) := by
                rw [dotProduct_sub]
        _ = uPos ⬝ᵥ b + ((δ⁻¹) * (uNeg ⬝ᵥ rbar) - uNeg ⬝ᵥ b) := by
              rw [dotProduct_smul]
              simp [smul_eq_mul]
        _ = (uPos ⬝ᵥ b - uNeg ⬝ᵥ b) + (uNeg ⬝ᵥ rbar) / δ := by
              field_simp [hδ_pos.ne']
              ring
        _ = ((uPos - uNeg) ⬝ᵥ b) + (uNeg ⬝ᵥ rbar) / δ := by
              rw [sub_dotProduct]
    rw [hrewrite] at hsplit
    exact hsplit
  exact ⟨uPos, uNeg, huPos_nonneg, huNeg_nonneg, huπ, by simpa [δ, rbar] using hstrict⟩

/-- Helper for Theorem 5.5: the positive support of a nonnegative vector is the set of indices with
strictly positive coordinates. -/
noncomputable def positiveSupport
    (u : Fin m → ℝ) : Finset (Fin m) :=
  Finset.univ.filter fun i : Fin m ↦ 0 < u i

/-- Helper for Theorem 5.5: the block support of a dual pair counts positive coordinates in `uPos`
and `uNeg` separately. This is the support notion that strictly drops under common-coordinate
cancellation. -/
noncomputable def dualPairBlockSupportCard
    (uPos uNeg : Fin m → ℝ) : ℕ :=
  (positiveSupport uPos).card + (positiveSupport uNeg).card

/-- Helper for Theorem 5.5: the common cancellation amount is the mass removable from both dual
blocks at a fixed row. -/
def dualPairCancellationAmount
    (uPos uNeg : Fin m → ℝ)
    (i : Fin m) : ℝ :=
  min (uPos i) (uNeg i)

/-- Helper for Theorem 5.5: canceling the common mass from the positive block at row `i`. -/
def dualPairCancelPos
    (uPos uNeg : Fin m → ℝ)
    (i : Fin m) : Fin m → ℝ :=
  uPos - dualPairCancellationAmount uPos uNeg i • Pi.single i (1 : ℝ)

/-- Helper for Theorem 5.5: canceling the common mass from the negative block at row `i`. -/
def dualPairCancelNeg
    (uPos uNeg : Fin m → ℝ)
    (i : Fin m) : Fin m → ℝ :=
  uNeg - dualPairCancellationAmount uPos uNeg i • Pi.single i (1 : ℝ)

/-- Helper for Theorem 5.5: subtracting a nonnegative multiple of a single basis vector cannot
create new strictly positive coordinates. -/
lemma positiveSupport_sub_single_subset
    (u : Fin m → ℝ)
    {i : Fin m}
    {ε : ℝ}
    (hε_nonneg : 0 ≤ ε) :
    positiveSupport (u - ε • Pi.single i (1 : ℝ)) ⊆ positiveSupport u := by
  intro j hj
  rcases Finset.mem_filter.mp hj with ⟨_, hj_pos⟩
  refine Finset.mem_filter.mpr ⟨Finset.mem_univ _, ?_⟩
  by_cases hji : j = i
  · subst hji
    have hj_pos' : 0 < u j - ε := by
      simpa [positiveSupport, Pi.sub_apply, Pi.smul_apply, Pi.single_apply, smul_eq_mul] using
        hj_pos
    linarith
  · simpa [positiveSupport, Pi.sub_apply, Pi.smul_apply, Pi.single_apply, smul_eq_mul, hji]
      using hj_pos

/-- Helper for Theorem 5.5: subtracting the full `i`-th coordinate removes `i` from the positive
support and therefore strictly shrinks that support. -/
lemma positiveSupport_sub_self_single_ssubset
    (u : Fin m → ℝ)
    {i : Fin m}
    (hui_pos : 0 < u i) :
    positiveSupport (u - u i • Pi.single i (1 : ℝ)) ⊂ positiveSupport u := by
  refine ⟨positiveSupport_sub_single_subset u (i := i) (ε := u i) hui_pos.le, ?_⟩
  intro hsubset
  have hi_mem : i ∈ positiveSupport u := by
    simp [positiveSupport, hui_pos]
  have hi_mem' := hsubset hi_mem
  have hi_not : i ∉ positiveSupport (u - u i • Pi.single i (1 : ℝ)) := by
    simp [positiveSupport, Pi.sub_apply, Pi.smul_apply, Pi.single_apply, smul_eq_mul]
  exact hi_not hi_mem'

/-- Helper for Theorem 5.5: common-coordinate cancellation preserves coordinatewise
nonnegativity of both dual blocks. -/
lemma dualPairCancellation_nonneg
    {uPos uNeg : Fin m → ℝ}
    (huPos_nonneg : 0 ≤ uPos)
    (huNeg_nonneg : 0 ≤ uNeg)
    (i : Fin m) :
    0 ≤ dualPairCancelPos uPos uNeg i ∧
      0 ≤ dualPairCancelNeg uPos uNeg i := by
  constructor <;> intro j
  · by_cases hji : j = i
    · subst hji
      simpa [dualPairCancelPos, dualPairCancellationAmount, Pi.sub_apply, Pi.smul_apply,
        Pi.single_apply, smul_eq_mul] using
        (sub_nonneg.mpr (min_le_left (uPos i) (uNeg i)))
    · simp [dualPairCancelPos, Pi.sub_apply, Pi.smul_apply, Pi.single_apply, smul_eq_mul, hji,
        Pi.single_eq_of_ne hji] at *
      exact huPos_nonneg j
  · by_cases hji : j = i
    · subst hji
      simpa [dualPairCancelNeg, dualPairCancellationAmount, Pi.sub_apply, Pi.smul_apply,
        Pi.single_apply, smul_eq_mul] using
        (sub_nonneg.mpr (min_le_right (uPos i) (uNeg i)))
    · simp [dualPairCancelNeg, Pi.sub_apply, Pi.smul_apply, Pi.single_apply, smul_eq_mul, hji,
        Pi.single_eq_of_ne hji] at *
      exact huNeg_nonneg j

/-- Helper for Theorem 5.5: canceling the same mass from both blocks leaves the signed multiplier
unchanged. -/
lemma dualPairCancellation_preservesDifference
    {uPos uNeg : Fin m → ℝ}
    (i : Fin m) :
    dualPairCancelPos uPos uNeg i - dualPairCancelNeg uPos uNeg i = uPos - uNeg := by
  -- Cancel the same single-coordinate term from both blocks and compare pointwise.
  ext j
  by_cases hji : j = i
  · subst hji
    simp [dualPairCancelPos, dualPairCancelNeg, dualPairCancellationAmount, smul_eq_mul]
  · simp [dualPairCancelPos, dualPairCancelNeg, smul_eq_mul, hji]

/-- Helper for Theorem 5.5: common-coordinate cancellation cannot increase the strict pair
objective because only the residual term changes, and it changes by a nonpositive amount. -/
lemma dualPairCancellation_objective_le
    (b r : Fin m → ℝ)
    {δ : ℝ}
    (hδ_pos : 0 < δ)
    {uPos uNeg : Fin m → ℝ}
    (huPos_nonneg : 0 ≤ uPos)
    (huNeg_nonneg : 0 ≤ uNeg)
    (hr_nonneg : 0 ≤ r)
    (i : Fin m) :
    let vPos := dualPairCancelPos uPos uNeg i
    let vNeg := dualPairCancelNeg uPos uNeg i
    ((vPos - vNeg) ⬝ᵥ b) + (vNeg ⬝ᵥ r) / δ ≤
      ((uPos - uNeg) ⬝ᵥ b) + (uNeg ⬝ᵥ r) / δ := by
  let ε : ℝ := dualPairCancellationAmount uPos uNeg i
  let vPos := dualPairCancelPos uPos uNeg i
  let vNeg := dualPairCancelNeg uPos uNeg i
  have hvNeg_le : vNeg ≤ uNeg := by
    intro j
    by_cases hji : j = i
    · subst hji
      have hε_nonneg : 0 ≤ ε := by
        dsimp [ε, dualPairCancellationAmount]
        exact le_min (huPos_nonneg j) (huNeg_nonneg j)
      simpa [vNeg, dualPairCancelNeg, ε, dualPairCancellationAmount, Pi.sub_apply,
        Pi.smul_apply, Pi.single_apply, smul_eq_mul] using sub_le_self (uNeg j) hε_nonneg
    · simp [vNeg, dualPairCancelNeg, Pi.sub_apply, Pi.smul_apply, Pi.single_apply, smul_eq_mul,
        hji]
  have hvNeg_dot_le : vNeg ⬝ᵥ r ≤ uNeg ⬝ᵥ r :=
    dotProduct_le_dotProduct_of_nonneg_right hvNeg_le hr_nonneg
  have hvNeg_div_le : (vNeg ⬝ᵥ r) / δ ≤ (uNeg ⬝ᵥ r) / δ := by
    exact div_le_div_of_nonneg_right hvNeg_dot_le hδ_pos.le
  have hvDiff : vPos - vNeg = uPos - uNeg :=
    dualPairCancellation_preservesDifference i
  calc
    ((vPos - vNeg) ⬝ᵥ b) + (vNeg ⬝ᵥ r) / δ
        = ((uPos - uNeg) ⬝ᵥ b) + (vNeg ⬝ᵥ r) / δ := by rw [hvDiff]
    _ ≤ ((uPos - uNeg) ⬝ᵥ b) + (uNeg ⬝ᵥ r) / δ := by gcongr

/-- Helper for Theorem 5.5: a strict dual pair stays strict after common-coordinate cancellation
provided the residual vector is coordinatewise nonnegative. -/
lemma dualPairCancellation_preservesStrictObjective
    (A : Matrix (Fin m) (Fin n) ℝ)
    (b : Fin m → ℝ)
    {I : Finset (Fin n)}
    (s : Split I)
    {xbar : Fin n → ℝ}
    {uPos uNeg : Fin m → ℝ}
    (huPos_nonneg : 0 ≤ uPos)
    (huNeg_nonneg : 0 ≤ uNeg)
    (hxbar_poly : xbar ∈ polyhedron_le_set A b)
    (hδ_pos : 0 < split_dot s xbar - (s.π0 : ℝ))
    (i : Fin m)
    (hstrict :
      ((uPos - uNeg) ⬝ᵥ b) +
          (uNeg ⬝ᵥ (b - A *ᵥ xbar)) / (split_dot s xbar - (s.π0 : ℝ)) <
        (s.π0 : ℝ) + 1) :
    let vPos := dualPairCancelPos uPos uNeg i
    let vNeg := dualPairCancelNeg uPos uNeg i
    ((vPos - vNeg) ⬝ᵥ b) +
        (vNeg ⬝ᵥ (b - A *ᵥ xbar)) / (split_dot s xbar - (s.π0 : ℝ)) <
      (s.π0 : ℝ) + 1 := by
  have hr_nonneg : 0 ≤ b - A *ᵥ xbar := by
    -- Feasibility of `xbar` makes the residual vector coordinatewise nonnegative.
    intro j
    exact sub_nonneg.mpr (hxbar_poly j)
  have hle :=
    dualPairCancellation_objective_le
      b (b - A *ᵥ xbar) hδ_pos huPos_nonneg huNeg_nonneg hr_nonneg i
      (uPos := uPos) (uNeg := uNeg)
  dsimp at hle ⊢
  exact lt_of_le_of_lt hle hstrict

/-- Helper for Theorem 5.5: canceling a common positive coordinate strictly lowers the total block
support count because one of the two positive coordinates disappears and no new positive coordinate
is created elsewhere. -/
lemma dualPairCancellation_blockSupportCard_lt
    {uPos uNeg : Fin m → ℝ}
    {i : Fin m}
    (hiPos : 0 < uPos i)
    (hiNeg : 0 < uNeg i) :
    let vPos := dualPairCancelPos uPos uNeg i
    let vNeg := dualPairCancelNeg uPos uNeg i
    dualPairBlockSupportCard vPos vNeg < dualPairBlockSupportCard uPos uNeg := by
  dsimp [dualPairBlockSupportCard]
  by_cases hminPos : uPos i ≤ uNeg i
  · have hvPos_ssub :
        positiveSupport (dualPairCancelPos uPos uNeg i) ⊂ positiveSupport uPos := by
      simpa [dualPairCancelPos, dualPairCancellationAmount, min_eq_left hminPos] using
        positiveSupport_sub_self_single_ssubset uPos (i := i) hiPos
    have hvNeg_subset :
        positiveSupport (dualPairCancelNeg uPos uNeg i) ⊆ positiveSupport uNeg := by
      simpa [dualPairCancelNeg, dualPairCancellationAmount, min_eq_left hminPos] using
        positiveSupport_sub_single_subset uNeg (i := i) (ε := uPos i) hiPos.le
    have hcardPos :
        (positiveSupport (dualPairCancelPos uPos uNeg i)).card < (positiveSupport uPos).card :=
      Finset.card_lt_card hvPos_ssub
    have hcardNeg :
        (positiveSupport (dualPairCancelNeg uPos uNeg i)).card ≤ (positiveSupport uNeg).card :=
      Finset.card_le_card hvNeg_subset
    omega
  · have hminNeg : uNeg i ≤ uPos i := by linarith
    have hvPos_subset :
        positiveSupport (dualPairCancelPos uPos uNeg i) ⊆ positiveSupport uPos := by
      simpa [dualPairCancelPos, dualPairCancellationAmount, min_eq_right hminNeg] using
        positiveSupport_sub_single_subset uPos (i := i) (ε := uNeg i) hiNeg.le
    have hvNeg_ssub :
        positiveSupport (dualPairCancelNeg uPos uNeg i) ⊂ positiveSupport uNeg := by
      simpa [dualPairCancelNeg, dualPairCancellationAmount, min_eq_right hminNeg] using
        positiveSupport_sub_self_single_ssubset uNeg (i := i) hiNeg
    have hcardPos :
        (positiveSupport (dualPairCancelPos uPos uNeg i)).card ≤ (positiveSupport uPos).card :=
      Finset.card_le_card hvPos_subset
    have hcardNeg :
        (positiveSupport (dualPairCancelNeg uPos uNeg i)).card < (positiveSupport uNeg).card :=
      Finset.card_lt_card hvNeg_ssub
    omega

/-- Helper for Theorem 5.5: among the strict violating dual pairs with the fixed row equation,
one minimizes the total block support. -/
lemma existsBlockSupportMinimalStrictViolatingDualPair
    (A : Matrix (Fin m) (Fin n) ℝ)
    (b : Fin m → ℝ)
    {I : Finset (Fin n)}
    (s : Split I)
    {xbar : Fin n → ℝ}
    {uPos uNeg : Fin m → ℝ}
    (huPos_nonneg : 0 ≤ uPos)
    (huNeg_nonneg : 0 ≤ uNeg)
    (huπ : (uPos - uNeg) ᵥ* A = (fun j : Fin n ↦ (s j : ℝ)))
    (hstrict :
      ((uPos - uNeg) ⬝ᵥ b) +
          (uNeg ⬝ᵥ (b - A *ᵥ xbar)) / (split_dot s xbar - (s.π0 : ℝ)) <
        (s.π0 : ℝ) + 1) :
    ∃ uPos' uNeg' : Fin m → ℝ,
      0 ≤ uPos' ∧
        0 ≤ uNeg' ∧
          (uPos' - uNeg') ᵥ* A = (fun j : Fin n ↦ (s j : ℝ)) ∧
            ((uPos' - uNeg') ⬝ᵥ b) +
                (uNeg' ⬝ᵥ (b - A *ᵥ xbar)) / (split_dot s xbar - (s.π0 : ℝ)) <
              (s.π0 : ℝ) + 1 ∧
                ∀ vPos vNeg : Fin m → ℝ,
                  0 ≤ vPos →
                    0 ≤ vNeg →
                      (vPos - vNeg) ᵥ* A = (fun j : Fin n ↦ (s j : ℝ)) →
                        ((vPos - vNeg) ⬝ᵥ b) +
                            (vNeg ⬝ᵥ (b - A *ᵥ xbar)) /
                                (split_dot s xbar - (s.π0 : ℝ)) <
                          (s.π0 : ℝ) + 1 →
                            dualPairBlockSupportCard uPos' uNeg' ≤
                              dualPairBlockSupportCard vPos vNeg := by
  classical
  let P : ℕ → Prop := fun t ↦
    ∃ uPos' uNeg' : Fin m → ℝ,
      0 ≤ uPos' ∧
        0 ≤ uNeg' ∧
          (uPos' - uNeg') ᵥ* A = (fun j : Fin n ↦ (s j : ℝ)) ∧
            ((uPos' - uNeg') ⬝ᵥ b) +
                (uNeg' ⬝ᵥ (b - A *ᵥ xbar)) / (split_dot s xbar - (s.π0 : ℝ)) <
              (s.π0 : ℝ) + 1 ∧
                dualPairBlockSupportCard uPos' uNeg' = t
  have hP : ∃ t, P t := by
    -- Package the existing strict certificate so `Nat.find` can minimize its block support size.
    exact
      ⟨dualPairBlockSupportCard uPos uNeg,
        uPos, uNeg, huPos_nonneg, huNeg_nonneg, huπ, hstrict, rfl⟩
  rcases Nat.find_spec hP with ⟨uPos', uNeg', huPos'_nonneg, huNeg'_nonneg, huπ', hstrict',
    huCard⟩
  refine ⟨uPos', uNeg', huPos'_nonneg, huNeg'_nonneg, huπ', hstrict', ?_⟩
  intro vPos vNeg hvPos_nonneg hvNeg_nonneg hvπ hvstrict
  have hmin : Nat.find hP ≤ dualPairBlockSupportCard vPos vNeg := by
    -- Any competing strict certificate contributes another admissible block-support size.
    exact Nat.find_min' hP ⟨vPos, vNeg, hvPos_nonneg, hvNeg_nonneg, hvπ, hvstrict, rfl⟩
  simpa [huCard] using hmin

/-- Helper for Theorem 5.5: a strict witness minimizing total block support is automatically
coordinatewise disjoint, because any common positive coordinate can be canceled while preserving
the row equation and strictness and strictly lowering that support count. -/
lemma dualPairDisjoint_of_blockSupportMinimalStrict
    (A : Matrix (Fin m) (Fin n) ℝ)
    (b : Fin m → ℝ)
    {I : Finset (Fin n)}
    (s : Split I)
    {xbar : Fin n → ℝ}
    (hxbar_poly : xbar ∈ polyhedron_le_set A b)
    (hδ_pos : 0 < split_dot s xbar - (s.π0 : ℝ))
    {uPos uNeg : Fin m → ℝ}
    (huPos_nonneg : 0 ≤ uPos)
    (huNeg_nonneg : 0 ≤ uNeg)
    (huπ : (uPos - uNeg) ᵥ* A = (fun j : Fin n ↦ (s j : ℝ)))
    (hstrict :
      ((uPos - uNeg) ⬝ᵥ b) +
          (uNeg ⬝ᵥ (b - A *ᵥ xbar)) / (split_dot s xbar - (s.π0 : ℝ)) <
        (s.π0 : ℝ) + 1)
    (hminimal :
      ∀ vPos vNeg : Fin m → ℝ,
        0 ≤ vPos →
          0 ≤ vNeg →
            (vPos - vNeg) ᵥ* A = (fun j : Fin n ↦ (s j : ℝ)) →
              ((vPos - vNeg) ⬝ᵥ b) +
                  (vNeg ⬝ᵥ (b - A *ᵥ xbar)) / (split_dot s xbar - (s.π0 : ℝ)) <
                (s.π0 : ℝ) + 1 →
                  dualPairBlockSupportCard uPos uNeg ≤ dualPairBlockSupportCard vPos vNeg) :
    ∀ i : Fin m, ¬ (0 < uPos i ∧ 0 < uNeg i) := by
  intro i hi
  rcases hi with ⟨hiPos, hiNeg⟩
  let vPos := dualPairCancelPos uPos uNeg i
  let vNeg := dualPairCancelNeg uPos uNeg i
  have hv_nonneg :
      0 ≤ vPos ∧ 0 ≤ vNeg := by
    simpa [vPos, vNeg] using dualPairCancellation_nonneg huPos_nonneg huNeg_nonneg i
  have hvπ : (vPos - vNeg) ᵥ* A = (fun j : Fin n ↦ (s j : ℝ)) := by
    -- The row equation is unchanged because cancellation removes the same basis vector twice.
    calc
      (vPos - vNeg) ᵥ* A = (uPos - uNeg) ᵥ* A := by
          simpa [vPos, vNeg] using congrArg (fun u : Fin m → ℝ ↦ u ᵥ* A)
            (dualPairCancellation_preservesDifference (uPos := uPos) (uNeg := uNeg) i)
      _ = (fun j : Fin n ↦ (s j : ℝ)) := huπ
  have hvstrict :
      ((vPos - vNeg) ⬝ᵥ b) +
          (vNeg ⬝ᵥ (b - A *ᵥ xbar)) / (split_dot s xbar - (s.π0 : ℝ)) <
        (s.π0 : ℝ) + 1 := by
    -- The positive strip width makes the residual term monotone under cancellation.
    simpa [vPos, vNeg] using dualPairCancellation_preservesStrictObjective
      A b s huPos_nonneg huNeg_nonneg hxbar_poly hδ_pos i hstrict
  have hlt :
      dualPairBlockSupportCard vPos vNeg < dualPairBlockSupportCard uPos uNeg := by
    -- Removing the common positive mass deletes one positive coordinate from the block support.
    simpa [vPos, vNeg] using dualPairCancellation_blockSupportCard_lt
      (uPos := uPos) (uNeg := uNeg) hiPos hiNeg
  have hle : dualPairBlockSupportCard uPos uNeg ≤ dualPairBlockSupportCard vPos vNeg :=
    hminimal vPos vNeg hv_nonneg.1 hv_nonneg.2 hvπ hvstrict
  exact (not_lt_of_ge hle) hlt

/-- Helper for Theorem 5.5: if the packed support columns of
`Matrix.fromCols A.transpose (-A.transpose)` are linearly independent, then the signed multiplier
obtained from the two blocks has linearly independent support rows in `A`. -/
lemma rowMultiplierHasIndependentSupportRows_of_packedSupportLinearIndependent
    (A : Matrix (Fin m) (Fin n) ℝ)
    {uPos uNeg : Fin m → ℝ}
    (hpacked :
      LinearIndependent ℝ
        (fun j : Function.support (Sum.elim uPos uNeg) ↦
          fun k : Fin n ↦ (Matrix.fromCols A.transpose (-A.transpose)) k j.1)) :
    RowMultiplierHasIndependentSupportRows A (uPos - uNeg) := by
  let liftIndex :
      {i // i ∈ row_multiplier_support (uPos - uNeg)} →
        Function.support (Sum.elim uPos uNeg) :=
    fun i ↦
      if hPos : uPos i.1 ≠ 0 then
        ⟨Sum.inl i.1, by
          simp [Function.mem_support, hPos]⟩
      else
        ⟨Sum.inr i.1, by
          have hiSupport : (uPos - uNeg) i.1 ≠ 0 :=
            (mem_row_multiplier_support_iff (uPos - uNeg) i.1).1 i.2
          have hNeg : uNeg i.1 ≠ 0 := by
            have hPosZero : uPos i.1 = 0 := by
              simpa using hPos
            intro hNegZero
            apply hiSupport
            simp [Pi.sub_apply, hPosZero, hNegZero]
          simp [Function.mem_support, hNeg]⟩
  have hlift_injective : Function.Injective liftIndex := by
    intro i j hij
    apply Subtype.ext
    have hval : (liftIndex i).1 = (liftIndex j).1 := congrArg Subtype.val hij
    by_cases hiPos : uPos i.1 ≠ 0
    · by_cases hjPos : uPos j.1 ≠ 0
      · have hEq : (Sum.inl i.1 : Fin m ⊕ Fin m) = Sum.inl j.1 := by
          simpa [liftIndex, hiPos, hjPos] using hval
        exact Sum.inl.inj hEq
      · have hEq : (Sum.inl i.1 : Fin m ⊕ Fin m) = Sum.inr j.1 := by
          have hjPosZero : uPos j.1 = 0 := by
            simpa using hjPos
          simpa [liftIndex, hiPos, hjPosZero] using hval
        cases hEq
    · by_cases hjPos : uPos j.1 ≠ 0
      · have hEq : (Sum.inr i.1 : Fin m ⊕ Fin m) = Sum.inl j.1 := by
          have hiPosZero : uPos i.1 = 0 := by
            simpa using hiPos
          simpa [liftIndex, hiPosZero, hjPos] using hval
        cases hEq
      · have hEq : (Sum.inr i.1 : Fin m ⊕ Fin m) = Sum.inr j.1 := by
          have hiPosZero : uPos i.1 = 0 := by
            simpa using hiPos
          have hjPosZero : uPos j.1 = 0 := by
            simpa using hjPos
          simpa [liftIndex, hiPosZero, hjPosZero] using hval
        exact Sum.inr.inj hEq
  let packedRows :
      {i // i ∈ row_multiplier_support (uPos - uNeg)} → Fin n → ℝ :=
    fun i ↦ fun k : Fin n ↦ (Matrix.fromCols A.transpose (-A.transpose)) k (liftIndex i).1
  have hpackedRows : LinearIndependent ℝ packedRows :=
    hpacked.comp liftIndex hlift_injective
  let supportSign : {i // i ∈ row_multiplier_support (uPos - uNeg)} → ℝˣ :=
    fun i ↦ if hPos : uPos i.1 ≠ 0 then 1 else -1
  have hsigned :
      LinearIndependent ℝ (fun i ↦ supportSign i • packedRows i) :=
    hpackedRows.units_smul supportSign
  have hrowEq :
      (fun i ↦ supportSign i • packedRows i) =
        (fun i : {i // i ∈ row_multiplier_support (uPos - uNeg)} ↦ A i.1) := by
    funext i
    ext k
    by_cases hPos : uPos i.1 ≠ 0
    · -- When the positive block is active, the chosen packed column is literally the row of `A`.
      simp [supportSign, packedRows, liftIndex, hPos, Matrix.fromCols_apply_inl]
    · -- Otherwise the chosen packed column comes from `-A`, so multiplying by `-1` restores `A`.
      have hPosZero : uPos i.1 = 0 := by
        simpa using hPos
      simp [supportSign, packedRows, liftIndex, hPosZero, Matrix.fromCols_apply_inr]
  -- The support-row family is a signed reindexing of the packed support family.
  simpa [RowMultiplierHasIndependentSupportRows, hrowEq] using hsigned

/-- Helper for Theorem 5.5: the packed positive support of a witness records the indices where the
coordinate is strictly positive. -/
noncomputable def packedPositiveSupport
    {ι : Type*} [Fintype ι]
    (w : ι → ℝ) : Finset ι :=
  Finset.univ.filter fun i : ι ↦ 0 < w i

/-- Helper for Theorem 5.5: for a coordinatewise nonnegative dual pair, the block-support count is
exactly the cardinality of the packed positive support of `Sum.elim uPos uNeg`. -/
lemma dualPairBlockSupportCard_eq_packedPositiveSupportCard
    {uPos uNeg : Fin m → ℝ}
    (huPos_nonneg : 0 ≤ uPos)
    (huNeg_nonneg : 0 ≤ uNeg) :
    dualPairBlockSupportCard uPos uNeg =
      (packedPositiveSupport (Sum.elim uPos uNeg)).card := by
  classical
  let posMap : Function.Embedding (Fin m) (Fin m ⊕ Fin m) :=
    ⟨Sum.inl, by
      intro a b h
      exact Sum.inl.inj h⟩
  let negMap : Function.Embedding (Fin m) (Fin m ⊕ Fin m) :=
    ⟨Sum.inr, by
      intro a b h
      exact Sum.inr.inj h⟩
  have hsupport :
      packedPositiveSupport (Sum.elim uPos uNeg) =
        (positiveSupport uPos).map posMap ∪ (positiveSupport uNeg).map negMap := by
    ext i
    cases i with
    | inl i =>
        simp [packedPositiveSupport, positiveSupport, posMap, negMap]
    | inr i =>
        simp [packedPositiveSupport, positiveSupport, posMap, negMap]
  have hdisj :
      Disjoint ((positiveSupport uPos).map posMap) ((positiveSupport uNeg).map negMap) := by
    refine Finset.disjoint_left.mpr ?_
    intro i hiPos hiNeg
    rcases Finset.mem_map.mp hiPos with ⟨j, hj, hEq⟩
    rcases Finset.mem_map.mp hiNeg with ⟨k, hk, hEq'⟩
    cases hEq.trans hEq'.symm
  rw [hsupport, Finset.card_union_of_disjoint hdisj, Finset.card_map, Finset.card_map]
  simp [dualPairBlockSupportCard]

/-- Helper for Theorem 5.5: a nonnegative coordinate belongs to `packedPositiveSupport` exactly
when it is nonzero. -/
lemma mem_packedPositiveSupport_iff_of_nonneg
    {ι : Type*} [Fintype ι]
    {w : ι → ℝ}
    (hw_nonneg : 0 ≤ w)
    (i : ι) :
    i ∈ packedPositiveSupport w ↔ w i ≠ 0 := by
  constructor
  · intro hi
    exact ne_of_gt ((show 0 < w i by simpa [packedPositiveSupport] using hi))
  · intro hi
    have hpos : 0 < w i := lt_of_le_of_ne (hw_nonneg i) hi.symm
    simpa [packedPositiveSupport] using hpos

/-- Helper for Theorem 5.5: outside the packed positive support, a nonnegative coordinate must
vanish. -/
lemma eq_zero_of_nonneg_of_not_mem_packedPositiveSupport
    {ι : Type*} [Fintype ι]
    {w : ι → ℝ}
    (hw_nonneg : 0 ≤ w)
    {i : ι}
    (hi : i ∉ packedPositiveSupport w) :
    w i = 0 := by
  by_contra hne
  exact hi ((mem_packedPositiveSupport_iff_of_nonneg hw_nonneg i).2 hne)

/-- Helper for Theorem 5.5: the packed dual objective `w ⬝ᵥ rawb` is exactly the strict-pair
objective written in the source proof. -/
lemma packedDualObjective_eq_strictPairObjective
    (b rbar : Fin m → ℝ)
    {δ : ℝ}
    (hδ_ne : δ ≠ 0)
    (uPos uNeg : Fin m → ℝ) :
    (Sum.elim uPos uNeg) ⬝ᵥ Sum.elim b (δ⁻¹ • rbar - b) =
      ((uPos - uNeg) ⬝ᵥ b) + (uNeg ⬝ᵥ rbar) / δ := by
  calc
    (Sum.elim uPos uNeg) ⬝ᵥ Sum.elim b (δ⁻¹ • rbar - b)
        = uPos ⬝ᵥ b + uNeg ⬝ᵥ (δ⁻¹ • rbar - b) := by
            rw [sumElim_dotProduct_sumElim]
    _ = uPos ⬝ᵥ b + (uNeg ⬝ᵥ (δ⁻¹ • rbar) - uNeg ⬝ᵥ b) := by
          rw [dotProduct_sub]
    _ = uPos ⬝ᵥ b + ((δ⁻¹) * (uNeg ⬝ᵥ rbar) - uNeg ⬝ᵥ b) := by
          rw [dotProduct_smul]
          simp [smul_eq_mul]
    _ = (uPos ⬝ᵥ b - uNeg ⬝ᵥ b) + (uNeg ⬝ᵥ rbar) / δ := by
          field_simp [hδ_ne]
          ring
    _ = ((uPos - uNeg) ⬝ᵥ b) + (uNeg ⬝ᵥ rbar) / δ := by
          rw [sub_dotProduct]

/-- Helper for Theorem 5.5: once the signed multiplier itself satisfies the strict normalized dual
bound, the source inequalities `(5.9)` through `(5.11)` yield a violated split cut. -/
lemma strictViolation_of_strictSignedRowMultiplier
    (A : Matrix (Fin m) (Fin n) ℝ)
    (b : Fin m → ℝ)
    {I : Finset (Fin n)}
    (s : Split I)
    {xbar : Fin n → ℝ}
    (hxbar_poly : xbar ∈ polyhedron_le_set A b)
    (hxbar_strip : xbar ∈ split_strip s s.π0)
    {u : Fin m → ℝ}
    (huπ : u ᵥ* A = (fun j : Fin n ↦ (s j : ℝ)))
    (hstrict :
      (u ⬝ᵥ b) +
          (row_multiplier_neg u ⬝ᵥ (b - A *ᵥ xbar)) / (split_dot s xbar - (s.π0 : ℝ)) <
        (s.π0 : ℝ) + 1) :
    (s.π0 : ℝ) < u ⬝ᵥ b ∧
      u ⬝ᵥ b < (s.π0 : ℝ) + 1 ∧
        split_cut_value A b u s.π0 xbar < 1 := by
  let r : Fin m → ℝ := b - A *ᵥ xbar
  let s1 : ℝ := row_multiplier_pos u ⬝ᵥ r
  let s2 : ℝ := row_multiplier_neg u ⬝ᵥ r
  let δ : ℝ := split_dot s xbar - (s.π0 : ℝ)
  let f : ℝ := u ⬝ᵥ b - (s.π0 : ℝ)
  rcases mem_split_strip_iff.mp hxbar_strip with ⟨hδ_pos, hδ_lt_top⟩
  have hδ_pos' : 0 < δ := by
    simpa [δ] using hδ_pos
  have hδ_lt_one : δ < 1 := by
    dsimp [δ]
    linarith
  have hr_nonneg : 0 ≤ r := by
    -- Feasibility of `xbar` makes every residual coordinate nonnegative.
    intro i
    dsimp [r]
    exact sub_nonneg.mpr (hxbar_poly i)
  have hs1_nonneg : 0 ≤ s1 := by
    -- The positive-part slack is a nonnegative weighted sum of nonnegative residuals.
    dsimp [s1]
    exact dotProduct_nonneg_of_nonneg
      (by
        intro i
        simp [row_multiplier_pos])
      hr_nonneg
  have hs2_nonneg : 0 ≤ s2 := by
    -- The negative-part slack is the same kind of nonnegative sum.
    dsimp [s2]
    exact dotProduct_nonneg_of_nonneg
      (by
        intro i
        simp [row_multiplier_neg])
      hr_nonneg
  have hgap0 : s1 - s2 = u ⬝ᵥ b - split_dot s xbar := by
    -- This is the row-slack identity for the signed multiplier itself.
    simpa [r, s1, s2] using splitCutRowSlackGap_eq_rhsGap A b u s huπ xbar
  have hgap : s1 - s2 = f - δ := by
    dsimp [f, δ]
    linarith
  have hstrict' : f + s2 / δ < 1 := by
    -- Rewrite the strict bound in the normalized variables `f` and `s₂ / δ`.
    dsimp [f, δ, s2] at hstrict ⊢
    linarith
  have hf_lt_one : f < 1 := by
    have hs2_div_nonneg : 0 ≤ s2 / δ := by
      exact div_nonneg hs2_nonneg hδ_pos'.le
    linarith
  have hs2_lt : s2 < δ * (1 - f) := by
    have hs2_div_lt : s2 / δ < 1 - f := by
      linarith
    have hs2_lt' : s2 < (1 - f) * δ := by
      exact (div_lt_iff₀ hδ_pos').mp hs2_div_lt
    simpa [mul_comm, mul_left_comm, mul_assoc] using hs2_lt'
  have hs1_lt : s1 < f * (1 - δ) := by
    -- Substitute the slack-gap identity into the strict upper estimate for `s₂`.
    nlinarith [hgap, hs2_lt]
  have hf_pos : 0 < f := by
    have hprod_pos : 0 < f * (1 - δ) := by
      exact lt_of_le_of_lt hs1_nonneg hs1_lt
    nlinarith
  have hub_left : (s.π0 : ℝ) < u ⬝ᵥ b := by
    dsimp [f] at hf_pos
    linarith
  have hub_right : u ⬝ᵥ b < (s.π0 : ℝ) + 1 := by
    dsimp [f] at hf_lt_one
    linarith
  have hnum_lt : (1 - f) * s1 + f * s2 < f * (1 - f) := by
    -- The numerator shortfall is exactly the strict defect `δ * (1 - f) - s₂`.
    nlinarith [hgap, hs2_lt]
  have hcut_repr :
      split_cut_value A b u s.π0 xbar =
        ((1 - f) * s1 + f * s2) / (f * (1 - f)) := by
    have hf_ne : f ≠ 0 := ne_of_gt hf_pos
    have h_one_sub_f_pos : 0 < 1 - f := by
      linarith
    have h_one_sub_f_ne : 1 - f ≠ 0 := ne_of_gt h_one_sub_f_pos
    -- Rewrite the split-cut value into one rational expression over the positive denominator.
    rw [split_cut_value]
    have hden_left : u ⬝ᵥ b - (s.π0 : ℝ) = f := by
      rfl
    have hden_right : (s.π0 : ℝ) + 1 - u ⬝ᵥ b = 1 - f := by
      dsimp [f]
      ring
    rw [hden_left, hden_right]
    field_simp [hf_ne, h_one_sub_f_ne]
    ring
  have hcut_lt : split_cut_value A b u s.π0 xbar < 1 := by
    have hden_pos : 0 < f * (1 - f) := mul_pos hf_pos (by linarith)
    have hnum_lt' : (1 - f) * s1 + f * s2 < 1 * (f * (1 - f)) := by
      simpa using hnum_lt
    rw [hcut_repr]
    exact (div_lt_iff₀ hden_pos).2 hnum_lt'
  exact ⟨hub_left, hub_right, hcut_lt⟩

/-- Helper for Theorem 5.5: from any strict dual pair, the stacked dual owner has a feasible
witness whose value is already below the split threshold. -/
lemma existsStackedStrictDualWitness_of_strictDualPair
    (A : Matrix (Fin m) (Fin n) ℝ)
    (b : Fin m → ℝ)
    {I : Finset (Fin n)}
    (s : Split I)
    {xbar : Fin n → ℝ}
    (hxbar_poly : xbar ∈ polyhedron_le_set A b)
    (hxbar_strip : xbar ∈ split_strip s s.π0)
    {uPos uNeg : Fin m → ℝ}
    (huPos_nonneg : 0 ≤ uPos)
    (huNeg_nonneg : 0 ≤ uNeg)
    (huπ : (uPos - uNeg) ᵥ* A = (fun j : Fin n ↦ (s j : ℝ)))
    (hstrict :
      ((uPos - uNeg) ⬝ᵥ b) +
          (uNeg ⬝ᵥ (b - A *ᵥ xbar)) / (split_dot s xbar - (s.π0 : ℝ)) <
        (s.π0 : ℝ) + 1) :
    let δ : ℝ := split_dot s xbar - (s.π0 : ℝ)
    let rbar : Fin m → ℝ := b - A *ᵥ xbar
    let rawA : Matrix (Fin m ⊕ Fin m) (Fin n) ℝ := Matrix.fromRows A (-A)
    let stackedA : Matrix (Fin (m + m)) (Fin n) ℝ :=
      rawA.reindex finSumFinEquiv (Equiv.refl _)
    let rawb : Fin m ⊕ Fin m → ℝ := Sum.elim b (δ⁻¹ • rbar - b)
    let stackedb : Fin (m + m) → ℝ := rawb ∘ finSumFinEquiv.symm
    ∃ w : Fin (m + m) → ℝ,
      w ∈ dual_feasible_region stackedA (fun j : Fin n ↦ (s j : ℝ)) ∧
        w ⬝ᵥ stackedb < (s.π0 : ℝ) + 1 := by
  let δ : ℝ := split_dot s xbar - (s.π0 : ℝ)
  let rbar : Fin m → ℝ := b - A *ᵥ xbar
  let rawA : Matrix (Fin m ⊕ Fin m) (Fin n) ℝ := Matrix.fromRows A (-A)
  let stackedA : Matrix (Fin (m + m)) (Fin n) ℝ :=
    rawA.reindex finSumFinEquiv (Equiv.refl _)
  let rawb : Fin m ⊕ Fin m → ℝ := Sum.elim b (δ⁻¹ • rbar - b)
  let stackedb : Fin (m + m) → ℝ := rawb ∘ finSumFinEquiv.symm
  let wRaw : Fin m ⊕ Fin m → ℝ := Sum.elim uPos uNeg
  let w : Fin (m + m) → ℝ := wRaw ∘ finSumFinEquiv.symm
  have hw_comp : w ∘ finSumFinEquiv = wRaw := by
    -- Composing the stacked witness with the packing equivalence recovers the raw two-block view.
    funext i
    simp [w, wRaw]
  have hδ_pos : 0 < δ := by
    simpa [δ] using (mem_split_strip_iff.mp hxbar_strip).1
  have hδ_ne : δ ≠ 0 := hδ_pos.ne'
  have hw_nonneg : 0 ≤ w := by
    -- Reindexing preserves the coordinatewise nonnegativity of the two source multipliers.
    intro i
    cases hsplit : finSumFinEquiv.symm i with
    | inl k =>
        simpa [w, wRaw, hsplit] using huPos_nonneg k
    | inr k =>
        simpa [w, wRaw, hsplit] using huNeg_nonneg k
  have hw_rawEq : wRaw ᵥ* rawA = (fun j : Fin n ↦ (s j : ℝ)) := by
    -- The raw stacked owner records the row equation `uPos A - uNeg A = s`.
    ext j
    have hsub :
        ((uPos - uNeg) ᵥ* A) j = (uPos ᵥ* A) j - (uNeg ᵥ* A) j := by
      simpa [Pi.sub_apply] using congrFun (Matrix.sub_vecMul A uPos uNeg) j
    have hneg : (uNeg ᵥ* (-A)) j = -((uNeg ᵥ* A) j) := by
      simpa using congrFun (Matrix.vecMul_neg uNeg A) j
    calc
      (wRaw ᵥ* rawA) j = (uPos ᵥ* A) j + (uNeg ᵥ* (-A)) j := by
          simp [wRaw, rawA, Matrix.vecMul_fromRows]
      _ = (uPos ᵥ* A) j - (uNeg ᵥ* A) j := by
            rw [hneg]
            ring
      _ = ((uPos - uNeg) ᵥ* A) j := by
            rw [hsub]
      _ = (s j : ℝ) := congrFun huπ j
  have hw_vec :=
    Matrix.submatrix_vecMul_equiv rawA w finSumFinEquiv.symm (Equiv.refl _)
  have hw_eq : w ᵥ* stackedA = (fun j : Fin n ↦ (s j : ℝ)) := by
    -- The raw row equation transfers directly to the reindexed stacked owner.
    ext j
    calc
      (w ᵥ* stackedA) j = (wRaw ᵥ* rawA) j := by
          simpa [stackedA, Matrix.reindex_apply, hw_comp] using congrFun hw_vec j
      _ = (s j : ℝ) := congrFun hw_rawEq j
  have hw_rhs : wRaw ⬝ᵥ rawb = w ⬝ᵥ stackedb := by
    -- The dot product is invariant under the same row permutation used in the stacked owner.
    calc
      wRaw ⬝ᵥ rawb = (w ∘ finSumFinEquiv) ⬝ᵥ rawb := by
          rw [hw_comp]
      _ = w ⬝ᵥ stackedb := by
            simpa [stackedb, rawb, Function.comp] using
              comp_equiv_symm_dotProduct w rawb finSumFinEquiv.symm
  have hw_obj :
      w ⬝ᵥ stackedb =
        ((uPos - uNeg) ⬝ᵥ b) + (uNeg ⬝ᵥ rbar) / δ := by
    -- The stacked objective is exactly the source strict-pair objective after reindexing.
    calc
      w ⬝ᵥ stackedb = wRaw ⬝ᵥ rawb := hw_rhs.symm
      _ = ((uPos - uNeg) ⬝ᵥ b) + (uNeg ⬝ᵥ rbar) / δ := by
            simpa [wRaw, rawb] using
              packedDualObjective_eq_strictPairObjective b rbar hδ_ne uPos uNeg
  refine ⟨w, ?_, ?_⟩
  · -- The reindexed witness is dual feasible once the transported row equation and
    -- coordinatewise nonnegativity are in place.
    exact (mem_dual_feasible_region_iff stackedA (fun j : Fin n ↦ (s j : ℝ)) w).2
      ⟨hw_eq, hw_nonneg⟩
  · -- Rewriting the stacked objective back to the strict-pair objective exposes the given bound.
    calc
      w ⬝ᵥ stackedb =
          ((uPos - uNeg) ⬝ᵥ b) + (uNeg ⬝ᵥ rbar) / δ := hw_obj
      _ =
          ((uPos - uNeg) ⬝ᵥ b) +
            (uNeg ⬝ᵥ (b - A *ᵥ xbar)) / (split_dot s xbar - (s.π0 : ℝ)) := by
              simp [δ, rbar]
      _ < (s.π0 : ℝ) + 1 := hstrict

/-- Helper for Theorem 5.5: among the optimal stacked dual witnesses below the threshold, one can
choose a witness with minimal packed positive support. -/
lemma existsSupportMinimalOptimalStackedWitness
    (stackedA : Matrix (Fin (m + m)) (Fin n) ℝ)
    (stackedb : Fin (m + m) → ℝ)
    (c : Fin n → ℝ)
    (z : ℝ)
    (hP : Set.Nonempty (primal_feasible_region stackedA stackedb))
    (hStrictDual :
      ∃ w : Fin (m + m) → ℝ,
        w ∈ dual_feasible_region stackedA c ∧
          w ⬝ᵥ stackedb < z) :
    ∃ wStar : Fin (m + m) → ℝ,
      wStar ∈ dual_feasible_region stackedA c ∧
        IsLeast (dual_objective_values stackedA stackedb c) (wStar ⬝ᵥ stackedb) ∧
          wStar ⬝ᵥ stackedb < z ∧
            ∀ w : Fin (m + m) → ℝ,
              w ∈ dual_feasible_region stackedA c →
                IsLeast (dual_objective_values stackedA stackedb c) (w ⬝ᵥ stackedb) →
                  (packedPositiveSupport wStar).card ≤ (packedPositiveSupport w).card := by
  classical
  rcases hStrictDual with ⟨wStrict, hwStrict_mem, hwStrict_lt⟩
  obtain ⟨wOpt, hwOpt_mem, hwOpt_least⟩ :=
    linear_programming_duality_dual_optimum_exists stackedA stackedb c hP ⟨wStrict, hwStrict_mem⟩
  have hwOpt_lt : wOpt ⬝ᵥ stackedb < z := by
    have hwOpt_le : wOpt ⬝ᵥ stackedb ≤ wStrict ⬝ᵥ stackedb := by
      exact hwOpt_least.2 ⟨wStrict, hwStrict_mem, rfl⟩
    exact lt_of_le_of_lt hwOpt_le hwStrict_lt
  let P : ℕ → Prop := fun t ↦
    ∃ w : Fin (m + m) → ℝ,
      w ∈ dual_feasible_region stackedA c ∧
        IsLeast (dual_objective_values stackedA stackedb c) (w ⬝ᵥ stackedb) ∧
          w ⬝ᵥ stackedb < z ∧
            (packedPositiveSupport w).card = t
  have hP_nonempty : ∃ t, P t := by
    refine ⟨(packedPositiveSupport wOpt).card, ?_⟩
    exact ⟨wOpt, hwOpt_mem, hwOpt_least, hwOpt_lt, rfl⟩
  obtain ⟨wStar, hwStar_mem, hwStar_least, hwStar_lt, hwStar_card⟩ := Nat.find_spec hP_nonempty
  refine ⟨wStar, hwStar_mem, hwStar_least, hwStar_lt, ?_⟩
  intro w hw_mem hw_least
  have hmin :
      Nat.find hP_nonempty ≤ (packedPositiveSupport w).card := by
    exact Nat.find_min' hP_nonempty ⟨w, hw_mem, hw_least, lt_of_le_of_lt (hw_least.2 ⟨wStrict, hwStrict_mem, rfl⟩) hwStrict_lt, rfl⟩
  simpa [hwStar_card] using hmin

/-- Helper for Theorem 5.5: dependence among the active packed rows yields a supported ambient
kernel direction. -/
lemma existsSupportedPackedKernelDirection_of_not_linearIndependent
    (stackedA : Matrix (Fin (m + m)) (Fin n) ℝ)
    {w : Fin (m + m) → ℝ}
    (hdep : ¬ LinearIndependent ℝ (fun j : packedPositiveSupport w ↦ stackedA j.1)) :
    ∃ d : Fin (m + m) → ℝ,
      d ≠ 0 ∧
        Function.support d ⊆ (packedPositiveSupport w : Set (Fin (m + m))) ∧
          d ᵥ* stackedA = 0 := by
  classical
  obtain ⟨g, hg_sum, i0, hgi0⟩ := (Fintype.not_linearIndependent_iff.mp hdep)
  let d : Fin (m + m) → ℝ :=
    fun i ↦ if hi : i ∈ packedPositiveSupport w then g ⟨i, hi⟩ else 0
  refine ⟨d, ?_, ?_, ?_⟩
  · -- A nontrivial dependence on the packed support stays nontrivial after zero extension.
    intro hd_zero
    have : g i0 = 0 := by
      simpa [d, i0.2] using congrFun hd_zero i0.1
    exact hgi0 this
  · -- Outside the packed support the zero extension vanishes, so every support index lies inside.
    intro i hi
    by_contra hnot
    have hi' : d i ≠ 0 := by
      simpa [Function.support] using hi
    have hzero : d i = 0 := by
      dsimp [d]
      split_ifs with hi_mem
      · exact False.elim (hnot hi_mem)
      · rfl
    exact hi' hzero
  · -- Reindex the ambient row sum back to the packed-support subtype relation.
    ext j
    have hsum_finset :
        (∑ i : Fin (m + m), d i * stackedA i j) =
          Finset.sum (packedPositiveSupport w) (fun i : Fin (m + m) ↦ d i * stackedA i j) := by
      simpa using
        (Finset.sum_subset (Finset.subset_univ (packedPositiveSupport w))
          (fun i _ hi => by
            by_cases hmem : i ∈ packedPositiveSupport w
            · exact False.elim (hi hmem)
            · simp [d, hmem])).symm
    have hsum_coe :
        Finset.sum (packedPositiveSupport w) (fun i : Fin (m + m) ↦ d i * stackedA i j) =
          ∑ i : packedPositiveSupport w, g i * stackedA i.1 j := by
      simpa [d] using
        (Finset.sum_coe_sort (s := packedPositiveSupport w)
          (f := fun i : Fin (m + m) ↦ d i * stackedA i j)).symm
    have hsum_support :
        ∑ i : Fin (m + m), d i * stackedA i j =
          ∑ i : packedPositiveSupport w, g i * stackedA i.1 j := by
      exact hsum_finset.trans hsum_coe
    have hcoord_zero :
        ∑ i : packedPositiveSupport w, g i * stackedA i.1 j = (0 : ℝ) := by
      simpa [Pi.smul_apply, smul_eq_mul] using congrFun hg_sum j
    calc
      (d ᵥ* stackedA) j = ∑ i : Fin (m + m), d i * stackedA i j := by
          simp [Matrix.vecMul, dotProduct]
      _ = ∑ i : packedPositiveSupport w, g i * stackedA i.1 j := hsum_support
      _ = (0 : Fin n → ℝ) j := by
            simpa using hcoord_zero

/-- Helper for Theorem 5.5: an optimal packed dual witness with minimal packed positive support
has linearly independent active rows. -/
lemma packedPositiveSupportLinearIndependent_of_supportMinimalOptimalWitness
    (stackedA : Matrix (Fin (m + m)) (Fin n) ℝ)
    (stackedb : Fin (m + m) → ℝ)
    (c : Fin n → ℝ)
    {wStar : Fin (m + m) → ℝ}
    (hwStar_mem : wStar ∈ dual_feasible_region stackedA c)
    (hwStar_least : IsLeast (dual_objective_values stackedA stackedb c) (wStar ⬝ᵥ stackedb))
    (hwStar_min :
      ∀ w : Fin (m + m) → ℝ,
        w ∈ dual_feasible_region stackedA c →
          IsLeast (dual_objective_values stackedA stackedb c) (w ⬝ᵥ stackedb) →
            (packedPositiveSupport wStar).card ≤ (packedPositiveSupport w).card) :
    LinearIndependent ℝ (fun j : packedPositiveSupport wStar ↦ stackedA j.1) := by
  classical
  rcases (mem_dual_feasible_region_iff stackedA c wStar).mp hwStar_mem with
    ⟨hwStar_eq, hwStar_nonneg⟩
  by_contra hdep
  rcases existsSupportedPackedKernelDirection_of_not_linearIndependent stackedA hdep with
    ⟨d, hd_ne, hd_support, hd_kernel⟩
  let B : Matrix (Fin (m + m) ⊕ Fin (m + m)) (Fin 1) ℝ :=
    fun s _ ↦ Sum.elim d (fun i ↦ -d i) s
  let r : Fin (m + m) ⊕ Fin (m + m) → ℝ := Sum.elim wStar wStar
  have hnonempty :
      Set.Nonempty {t : ℝ | B *ᵥ (fun _ : Fin 1 ↦ t) ≤ r} := by
    refine ⟨0, ?_⟩
    intro s
    cases s with
    | inl i =>
        simpa [B, r, Matrix.mulVec, dotProduct] using hwStar_nonneg i
    | inr i =>
        simpa [B, r, Matrix.mulVec, dotProduct] using hwStar_nonneg i
  have hsupport_nonempty : (Function.support d).Nonempty := by
    by_contra hempty
    apply hd_ne
    funext i
    by_contra hdi
    exact hempty ⟨i, by simpa [Function.support] using hdi⟩
  obtain ⟨i0, hi0_support⟩ := hsupport_nonempty
  have hdi0_ne : d i0 ≠ 0 := by
    simpa [Function.support] using hi0_support
  let s0 : Fin (m + m) ⊕ Fin (m + m) :=
    if hpos : 0 < d i0 then Sum.inl i0 else Sum.inr i0
  have hs0_pos : 0 < B s0 0 := by
    by_cases hpos : 0 < d i0
    · simp [B, s0, hpos]
    · have hneg : 0 < -d i0 := by
        have hnonpos : d i0 ≤ 0 := le_of_not_gt hpos
        have hlt : d i0 < 0 := lt_of_le_of_ne hnonpos hdi0_ne
        linarith
      simp [B, s0, hpos, hneg]
  have hbounded : BddAbove {t : ℝ | B *ᵥ (fun _ : Fin 1 ↦ t) ≤ r} := by
    refine ⟨r s0 / B s0 0, ?_⟩
    intro t ht
    have hrow : (B *ᵥ (fun _ : Fin 1 ↦ t)) s0 ≤ r s0 := ht s0
    exact (le_div_iff₀ hs0_pos).2 (by simpa [B, r, Matrix.mulVec, dotProduct, mul_comm] using hrow)
  rcases
      exists_isGreatest_one_variable_system_of_nonempty_bddAbove
        B
        r
        hnonempty
        hbounded with
    ⟨h, hh_pos, hgreatest⟩
  let ε : ℝ := r h / B h 0
  have hε_feas : B *ᵥ (fun _ : Fin 1 ↦ ε) ≤ r := hgreatest.1
  have hε_pos : 0 < ε := by
    cases h with
    | inl i =>
        have hdi_ne : d i ≠ 0 := hh_pos.ne'
        have hi_support : i ∈ packedPositiveSupport wStar := by
          exact hd_support (by simpa [Function.support] using hdi_ne)
        have hwi_pos : 0 < wStar i := by
          simpa [packedPositiveSupport] using hi_support
        simpa [ε, B, r] using (div_pos hwi_pos hh_pos)
    | inr i =>
        have hdi_ne : d i ≠ 0 := by
          exact neg_ne_zero.mp (ne_of_gt hh_pos)
        have hi_support : i ∈ packedPositiveSupport wStar := by
          exact hd_support (by simpa [Function.support] using hdi_ne)
        have hwi_pos : 0 < wStar i := by
          simpa [packedPositiveSupport] using hi_support
        simpa [ε, B, r] using (div_pos hwi_pos hh_pos)
  have hplus_nonneg : 0 ≤ wStar + ε • d := by
    intro i
    have hi : -d i * ε ≤ wStar i := by
      simpa [B, r, Matrix.mulVec, dotProduct, mul_comm] using hε_feas (Sum.inr i)
    have : 0 ≤ wStar i + ε * d i := by
      linarith
    simpa [Pi.add_apply, Pi.smul_apply, smul_eq_mul] using this
  have hminus_nonneg : 0 ≤ wStar - ε • d := by
    intro i
    have hi : d i * ε ≤ wStar i := by
      simpa [B, r, Matrix.mulVec, dotProduct, mul_comm] using hε_feas (Sum.inl i)
    have : 0 ≤ wStar i - ε * d i := by
      linarith
    simpa [Pi.sub_apply, Pi.smul_apply, smul_eq_mul] using this
  have hplus_mem : wStar + ε • d ∈ dual_feasible_region stackedA c := by
    -- The symmetric positive step keeps nonnegativity and preserves the dual row equation.
    refine (mem_dual_feasible_region_iff stackedA c (wStar + ε • d)).2 ⟨?_, hplus_nonneg⟩
    calc
      (wStar + ε • d) ᵥ* stackedA = wStar ᵥ* stackedA + (ε • d) ᵥ* stackedA := by
          rw [Matrix.add_vecMul]
      _ = wStar ᵥ* stackedA + ε • (d ᵥ* stackedA) := by
            rw [Matrix.smul_vecMul]
      _ = c := by
            simp [hwStar_eq, hd_kernel]
  have hminus_mem : wStar - ε • d ∈ dual_feasible_region stackedA c := by
    -- The symmetric negative step satisfies the same row equation and nonnegativity conditions.
    refine (mem_dual_feasible_region_iff stackedA c (wStar - ε • d)).2 ⟨?_, hminus_nonneg⟩
    calc
      (wStar - ε • d) ᵥ* stackedA = wStar ᵥ* stackedA - (ε • d) ᵥ* stackedA := by
          rw [Matrix.sub_vecMul]
      _ = wStar ᵥ* stackedA - ε • (d ᵥ* stackedA) := by
            rw [Matrix.smul_vecMul]
      _ = c := by
            simp [hwStar_eq, hd_kernel]
  have hplus_opt :
      wStar ⬝ᵥ stackedb ≤ (wStar + ε • d) ⬝ᵥ stackedb := by
    exact hwStar_least.2 ⟨wStar + ε • d, hplus_mem, rfl⟩
  have hminus_opt :
      wStar ⬝ᵥ stackedb ≤ (wStar - ε • d) ⬝ᵥ stackedb := by
    exact hwStar_least.2 ⟨wStar - ε • d, hminus_mem, rfl⟩
  have hd_objective_zero : d ⬝ᵥ stackedb = 0 := by
    -- Optimality on the symmetric perturbations forces the objective slope along `d` to vanish.
    have hplus_eval :
        (wStar + ε • d) ⬝ᵥ stackedb = wStar ⬝ᵥ stackedb + ε * (d ⬝ᵥ stackedb) := by
      simpa [smul_eq_mul] using congrArg id (show
        (wStar + ε • d) ⬝ᵥ stackedb = wStar ⬝ᵥ stackedb + ε • (d ⬝ᵥ stackedb) by
          rw [add_dotProduct, smul_dotProduct])
    have hminus_eval :
        (wStar - ε • d) ⬝ᵥ stackedb = wStar ⬝ᵥ stackedb - ε * (d ⬝ᵥ stackedb) := by
      simpa [smul_eq_mul] using congrArg id (show
        (wStar - ε • d) ⬝ᵥ stackedb = wStar ⬝ᵥ stackedb - ε • (d ⬝ᵥ stackedb) by
          rw [sub_dotProduct, smul_dotProduct])
    rw [hplus_eval] at hplus_opt
    rw [hminus_eval] at hminus_opt
    nlinarith [hε_pos, hplus_opt, hminus_opt]
  cases h with
  | inl i =>
      have hi_support : i ∈ packedPositiveSupport wStar := by
        exact hd_support (by simpa [Function.support] using hh_pos.ne')
      have hminus_obj :
          (wStar - ε • d) ⬝ᵥ stackedb = wStar ⬝ᵥ stackedb := by
        rw [sub_dotProduct, smul_dotProduct, hd_objective_zero]
        ring
      have hminus_least :
          IsLeast (dual_objective_values stackedA stackedb c) ((wStar - ε • d) ⬝ᵥ stackedb) := by
        simpa [hminus_obj] using hwStar_least
      have hsubset :
          packedPositiveSupport (wStar - ε • d) ⊆ packedPositiveSupport wStar := by
        intro j hj
        by_contra hj_old
        have hwj_zero : wStar j = 0 :=
          eq_zero_of_nonneg_of_not_mem_packedPositiveSupport hwStar_nonneg hj_old
        have hdj_zero : d j = 0 := by
          by_contra hdj_ne
          exact hj_old (hd_support (by simpa [Function.support] using hdj_ne))
        have hnext_zero : (wStar - ε • d) j = 0 := by
          simp [Pi.sub_apply, Pi.smul_apply, smul_eq_mul, hwj_zero, hdj_zero]
        exact ((mem_packedPositiveSupport_iff_of_nonneg hminus_nonneg j).1 hj) hnext_zero
      have hdrop_zero : (wStar - ε • d) i = 0 := by
        have hratio : (wStar i / d i) * d i = wStar i := by
          have hcancel : (d i)⁻¹ * d i = 1 := by
            exact inv_mul_cancel₀ hh_pos.ne'
          calc
            (wStar i / d i) * d i = wStar i * ((d i)⁻¹ * d i) := by
                rw [div_eq_mul_inv]
                ring
            _ = wStar i * 1 := by
                  rw [hcancel]
            _ = wStar i := by
                  ring
        calc
          (wStar - ε • d) i = wStar i - ε * d i := by
              simp [Pi.sub_apply, Pi.smul_apply, smul_eq_mul]
          _ = wStar i - (wStar i / d i) * d i := by
                simp [ε, B, r]
          _ = 0 := by
                rw [hratio]
                ring
      have hi_not_mem :
          i ∉ packedPositiveSupport (wStar - ε • d) := by
        intro hi_mem
        exact ((mem_packedPositiveSupport_iff_of_nonneg hminus_nonneg i).1 hi_mem) hdrop_zero
      have hssub :
          packedPositiveSupport (wStar - ε • d) ⊂ packedPositiveSupport wStar := by
        refine Finset.ssubset_iff_subset_ne.mpr ⟨hsubset, ?_⟩
        intro hEq
        exact hi_not_mem (hEq ▸ hi_support)
      have hcard_lt :
          (packedPositiveSupport (wStar - ε • d)).card < (packedPositiveSupport wStar).card := by
        exact Finset.card_lt_card hssub
      have hcard_le :
          (packedPositiveSupport wStar).card ≤ (packedPositiveSupport (wStar - ε • d)).card :=
        hwStar_min (wStar - ε • d) hminus_mem hminus_least
      exact (not_lt_of_ge hcard_le) hcard_lt
  | inr i =>
      have hdi_ne : d i ≠ 0 := by
        exact neg_ne_zero.mp (ne_of_gt hh_pos)
      have hi_support : i ∈ packedPositiveSupport wStar := by
        exact hd_support (by simpa [Function.support] using hdi_ne)
      have hplus_obj :
          (wStar + ε • d) ⬝ᵥ stackedb = wStar ⬝ᵥ stackedb := by
        rw [add_dotProduct, smul_dotProduct, hd_objective_zero]
        ring
      have hplus_least :
          IsLeast (dual_objective_values stackedA stackedb c) ((wStar + ε • d) ⬝ᵥ stackedb) := by
        simpa [hplus_obj] using hwStar_least
      have hsubset :
          packedPositiveSupport (wStar + ε • d) ⊆ packedPositiveSupport wStar := by
        intro j hj
        by_contra hj_old
        have hwj_zero : wStar j = 0 :=
          eq_zero_of_nonneg_of_not_mem_packedPositiveSupport hwStar_nonneg hj_old
        have hdj_zero : d j = 0 := by
          by_contra hdj_ne
          exact hj_old (hd_support (by simpa [Function.support] using hdj_ne))
        have hnext_zero : (wStar + ε • d) j = 0 := by
          simp [Pi.add_apply, Pi.smul_apply, smul_eq_mul, hwj_zero, hdj_zero]
        exact ((mem_packedPositiveSupport_iff_of_nonneg hplus_nonneg j).1 hj) hnext_zero
      have hdrop_zero : (wStar + ε • d) i = 0 := by
        have hd_neg : d i < 0 := by
          simpa [B] using hh_pos
        have hratio : (wStar i / (-d i)) * d i = -wStar i := by
          calc
            (wStar i / (-d i)) * d i = (wStar i / (-d i)) * (-(-d i)) := by ring
            _ = -((wStar i / (-d i)) * (-d i)) := by ring
            _ = -wStar i := by
                  rw [div_eq_mul_inv, mul_assoc, inv_mul_cancel₀ (neg_ne_zero.mpr hdi_ne), mul_one]
        calc
          (wStar + ε • d) i = wStar i + ε * d i := by
              simp [Pi.add_apply, Pi.smul_apply, smul_eq_mul]
          _ = wStar i + (wStar i / (-d i)) * d i := by
                simp [ε, B, r]
          _ = 0 := by
                rw [hratio]
                simp
      have hi_not_mem :
          i ∉ packedPositiveSupport (wStar + ε • d) := by
        intro hi_mem
        exact ((mem_packedPositiveSupport_iff_of_nonneg hplus_nonneg i).1 hi_mem) hdrop_zero
      have hssub :
          packedPositiveSupport (wStar + ε • d) ⊂ packedPositiveSupport wStar := by
        refine Finset.ssubset_iff_subset_ne.mpr ⟨hsubset, ?_⟩
        intro hEq
        exact hi_not_mem (hEq ▸ hi_support)
      have hcard_lt :
          (packedPositiveSupport (wStar + ε • d)).card < (packedPositiveSupport wStar).card := by
        exact Finset.card_lt_card hssub
      have hcard_le :
          (packedPositiveSupport wStar).card ≤ (packedPositiveSupport (wStar + ε • d)).card :=
        hwStar_min (wStar + ε • d) hplus_mem hplus_least
      exact (not_lt_of_ge hcard_le) hcard_lt

/-- Helper for Theorem 5.5: among the strict stacked-dual witnesses one can choose a packed dual
optimizer with minimal active support; its active packed rows are linearly independent, so the
compressed signed multiplier already has independent support rows in `A`. -/
lemma existsIndependentSupportStrictViolatingDualPair
    (A : Matrix (Fin m) (Fin n) ℝ)
    (b : Fin m → ℝ)
    {I : Finset (Fin n)}
    (s : Split I)
    {xbar : Fin n → ℝ}
    (hxbar_poly : xbar ∈ polyhedron_le_set A b)
    (hxbar_strip : xbar ∈ split_strip s s.π0)
    {uPos uNeg : Fin m → ℝ}
    (huPos_nonneg : 0 ≤ uPos)
    (huNeg_nonneg : 0 ≤ uNeg)
    (huπ : (uPos - uNeg) ᵥ* A = (fun j : Fin n ↦ (s j : ℝ)))
    (hstrict :
      ((uPos - uNeg) ⬝ᵥ b) +
          (uNeg ⬝ᵥ (b - A *ᵥ xbar)) / (split_dot s xbar - (s.π0 : ℝ)) <
        (s.π0 : ℝ) + 1) :
    ∃ uPos' uNeg' : Fin m → ℝ,
      0 ≤ uPos' ∧
        0 ≤ uNeg' ∧
          (uPos' - uNeg') ᵥ* A = (fun j : Fin n ↦ (s j : ℝ)) ∧
            ((uPos' - uNeg') ⬝ᵥ b) +
                (uNeg' ⬝ᵥ (b - A *ᵥ xbar)) / (split_dot s xbar - (s.π0 : ℝ)) <
              (s.π0 : ℝ) + 1 ∧
                RowMultiplierHasIndependentSupportRows A (uPos' - uNeg') := by
  classical
  -- Route correction: keep the contradiction in the packed `Fin (m + m)` owner, choose an
  -- optimal witness with minimal active support there, and only then transport back to `A`.
  let δ : ℝ := split_dot s xbar - (s.π0 : ℝ)
  let rbar : Fin m → ℝ := b - A *ᵥ xbar
  let rawA : Matrix (Fin m ⊕ Fin m) (Fin n) ℝ := Matrix.fromRows A (-A)
  let stackedA : Matrix (Fin (m + m)) (Fin n) ℝ :=
    rawA.reindex finSumFinEquiv (Equiv.refl _)
  let rawb : Fin m ⊕ Fin m → ℝ := Sum.elim b (δ⁻¹ • rbar - b)
  let stackedb : Fin (m + m) → ℝ := rawb ∘ finSumFinEquiv.symm
  have hδ_pos : 0 < δ := by
    simpa [δ] using (mem_split_strip_iff.mp hxbar_strip).1
  have hδ_lt_one : δ < 1 := by
    rcases mem_split_strip_iff.mp hxbar_strip with ⟨hleft, hright⟩
    dsimp [δ]
    linarith
  have hrbar_nonneg : 0 ≤ rbar := by
    -- Feasibility of `xbar` makes the residual vector coordinatewise nonnegative.
    intro i
    exact sub_nonneg.mpr (hxbar_poly i)
  have hxbar_raw : rawA *ᵥ xbar ≤ rawb := by
    refine (upperPointAuxPrimalFeasible_iff A b δ rbar xbar).2 ⟨hxbar_poly, ?_⟩
    intro i
    have hscaled : (rbar i) * δ ≤ rbar i := by
      have hδ_le_one : δ ≤ 1 := by
        linarith
      simpa using mul_le_mul_of_nonneg_left hδ_le_one (hrbar_nonneg i)
    have hi : rbar i ≤ (rbar i) / δ := by
      exact (le_div_iff₀ hδ_pos).2 hscaled
    simpa [rbar, Pi.sub_apply, Pi.smul_apply, smul_eq_mul, div_eq_mul_inv, mul_comm] using hi
  have hmul :=
    Matrix.submatrix_mulVec_equiv rawA xbar finSumFinEquiv.symm (Equiv.refl _)
  have hxbar_base : xbar ∈ primal_feasible_region stackedA stackedb := by
    rw [mem_primal_feasible_region_iff]
    intro i
    have hrow := hxbar_raw (finSumFinEquiv.symm i)
    have hEq :
        (stackedA *ᵥ xbar) i = (rawA *ᵥ xbar) (finSumFinEquiv.symm i) := by
      simpa [stackedA, Matrix.reindex_apply] using congrFun hmul i
    have hRhs : stackedb i = rawb (finSumFinEquiv.symm i) := by
      simp [stackedb, rawb]
    rw [hEq, hRhs]
    exact hrow
  obtain ⟨wStrict, hwStrict_mem, hwStrict_lt⟩ :=
    existsStackedStrictDualWitness_of_strictDualPair
      A b s hxbar_poly hxbar_strip huPos_nonneg huNeg_nonneg huπ hstrict
  obtain ⟨wStar, hwStar_mem, hwStar_least, hwStar_lt, hwStar_min⟩ :=
    existsSupportMinimalOptimalStackedWitness
      stackedA stackedb (fun j : Fin n ↦ (s j : ℝ)) ((s.π0 : ℝ) + 1)
      ⟨xbar, hxbar_base⟩
      ⟨wStrict, hwStrict_mem, hwStrict_lt⟩
  have hδ_ne : δ ≠ 0 := hδ_pos.ne'
  rcases (mem_dual_feasible_region_iff stackedA (fun j : Fin n ↦ (s j : ℝ)) wStar).mp hwStar_mem with
    ⟨hwStar_eq, hwStar_nonneg⟩
  have hpacked_indep :
      LinearIndependent ℝ (fun j : packedPositiveSupport wStar ↦ stackedA j.1) := by
    -- The packed owner is now closed: support-minimal optimal witnesses cannot carry a supported
    -- kernel direction, because the maximal symmetric step would preserve optimality and drop one
    -- active support index.
    exact packedPositiveSupportLinearIndependent_of_supportMinimalOptimalWitness
      stackedA
      stackedb
      (fun j : Fin n ↦ (s j : ℝ))
      hwStar_mem
      hwStar_least
      hwStar_min
  let wRaw : Fin m ⊕ Fin m → ℝ := wStar ∘ finSumFinEquiv
  let uPos' : Fin m → ℝ := wRaw ∘ Sum.inl
  let uNeg' : Fin m → ℝ := wRaw ∘ Sum.inr
  have hwRaw_split : Sum.elim uPos' uNeg' = wRaw := by
    -- The packed witness splits back into its positive and negative raw blocks coordinatewise.
    funext i
    cases i <;> rfl
  have huPos'_nonneg : 0 ≤ uPos' := by
    -- Reindexing the nonnegative packed witness preserves nonnegativity on the positive block.
    intro i
    exact hwStar_nonneg (finSumFinEquiv (Sum.inl i))
  have huNeg'_nonneg : 0 ≤ uNeg' := by
    -- Reindexing the nonnegative packed witness preserves nonnegativity on the negative block.
    intro i
    exact hwStar_nonneg (finSumFinEquiv (Sum.inr i))
  have hw_vec :=
    Matrix.submatrix_vecMul_equiv rawA wStar finSumFinEquiv.symm (Equiv.refl _)
  have hw_rawEq : wRaw ᵥ* rawA = (fun j : Fin n ↦ (s j : ℝ)) := by
    -- The stacked row equation transfers back to the raw two-block owner by undoing the reindexing.
    ext j
    calc
      (wRaw ᵥ* rawA) j = (wStar ᵥ* stackedA) j := by
          symm
          simpa [wRaw, stackedA, Matrix.reindex_apply] using congrFun hw_vec j
      _ = (s j : ℝ) := congrFun hwStar_eq j
  have huπ' : (uPos' - uNeg') ᵥ* A = (fun j : Fin n ↦ (s j : ℝ)) := by
    -- Splitting the raw stacked equation into its two blocks recovers the signed row multiplier.
    ext j
    have hsub :
        ((uPos' - uNeg') ᵥ* A) j = (uPos' ᵥ* A) j - (uNeg' ᵥ* A) j := by
      simpa [Pi.sub_apply] using congrFun (Matrix.sub_vecMul A uPos' uNeg') j
    have hneg : (uNeg' ᵥ* (-A)) j = -((uNeg' ᵥ* A) j) := by
      simpa using congrFun (Matrix.vecMul_neg uNeg' A) j
    calc
      ((uPos' - uNeg') ᵥ* A) j = (uPos' ᵥ* A) j - (uNeg' ᵥ* A) j := hsub
      _ = (uPos' ᵥ* A) j + (uNeg' ᵥ* (-A)) j := by
            rw [hneg]
            ring
      _ = (wRaw ᵥ* rawA) j := by
            simpa [uPos', uNeg', wRaw, hwRaw_split, rawA, Matrix.vecMul_fromRows, add_assoc]
      _ = (s j : ℝ) := congrFun hw_rawEq j
  have hw_rhs : wRaw ⬝ᵥ rawb = wStar ⬝ᵥ stackedb := by
    -- The objective dot product is unchanged by the same reindexing used for the stacked owner.
    calc
      wRaw ⬝ᵥ rawb = (wStar ∘ finSumFinEquiv) ⬝ᵥ rawb := by
          rfl
      _ = wStar ⬝ᵥ stackedb := by
            simpa [stackedb, rawb, Function.comp] using
              comp_equiv_symm_dotProduct wStar rawb finSumFinEquiv.symm
  have hstrict' :
      ((uPos' - uNeg') ⬝ᵥ b) +
          (uNeg' ⬝ᵥ (b - A *ᵥ xbar)) / (split_dot s xbar - (s.π0 : ℝ)) <
        (s.π0 : ℝ) + 1 := by
    have hsplit_raw : wRaw ⬝ᵥ rawb < (s.π0 : ℝ) + 1 := by
      rw [hw_rhs]
      exact hwStar_lt
    have hsplit :
        uPos' ⬝ᵥ b + uNeg' ⬝ᵥ (δ⁻¹ • rbar - b) < (s.π0 : ℝ) + 1 := by
      calc
        uPos' ⬝ᵥ b + uNeg' ⬝ᵥ (δ⁻¹ • rbar - b) = wRaw ⬝ᵥ rawb := by
            rw [← sumElim_dotProduct_sumElim]
            simp [uPos', uNeg', wRaw, rawb]
        _ < (s.π0 : ℝ) + 1 := hsplit_raw
    have hrewrite :
        uPos' ⬝ᵥ b + uNeg' ⬝ᵥ (δ⁻¹ • rbar - b) =
          ((uPos' - uNeg') ⬝ᵥ b) + (uNeg' ⬝ᵥ rbar) / δ := by
      calc
        uPos' ⬝ᵥ b + uNeg' ⬝ᵥ (δ⁻¹ • rbar - b)
            = uPos' ⬝ᵥ b + (uNeg' ⬝ᵥ (δ⁻¹ • rbar) - uNeg' ⬝ᵥ b) := by
                rw [dotProduct_sub]
        _ = uPos' ⬝ᵥ b + ((δ⁻¹) * (uNeg' ⬝ᵥ rbar) - uNeg' ⬝ᵥ b) := by
              rw [dotProduct_smul]
              simp [smul_eq_mul]
        _ = (uPos' ⬝ᵥ b - uNeg' ⬝ᵥ b) + (uNeg' ⬝ᵥ rbar) / δ := by
              field_simp [hδ_ne]
              ring
        _ = ((uPos' - uNeg') ⬝ᵥ b) + (uNeg' ⬝ᵥ rbar) / δ := by
              rw [sub_dotProduct]
    rw [hrewrite] at hsplit
    simpa [δ, rbar] using hsplit
  have hpacked_support :
      LinearIndependent ℝ
        (fun j : Function.support (Sum.elim uPos' uNeg') ↦
          fun k : Fin n ↦ (Matrix.fromCols A.transpose (-A.transpose)) k j.1) := by
    let packIndex :
        Function.support (Sum.elim uPos' uNeg') → packedPositiveSupport wStar :=
      fun j ↦
        ⟨finSumFinEquiv j.1, by
          have hj_nonzero : wStar (finSumFinEquiv j.1) ≠ 0 := by
            simpa [wRaw, hwRaw_split] using j.2
          exact (mem_packedPositiveSupport_iff_of_nonneg hwStar_nonneg (finSumFinEquiv j.1)).2
            hj_nonzero⟩
    have hpack_injective : Function.Injective packIndex := by
      -- The support transport only changes indices by the packing equivalence.
      intro i j hij
      apply Subtype.ext
      exact finSumFinEquiv.injective (congrArg Subtype.val hij)
    have hcomp :
        LinearIndependent ℝ (fun j : Function.support (Sum.elim uPos' uNeg') ↦ stackedA (packIndex j).1) :=
      hpacked_indep.comp packIndex hpack_injective
    have hrowEq :
        (fun j : Function.support (Sum.elim uPos' uNeg') ↦ stackedA (packIndex j).1) =
          (fun j : Function.support (Sum.elim uPos' uNeg') ↦
            fun k : Fin n ↦ (Matrix.fromCols A.transpose (-A.transpose)) k j.1) := by
      -- Undoing `finSumFinEquiv` identifies stacked rows with the raw packed columns.
      funext j
      ext k
      cases hsum : j.1 with
      | inl i =>
          have hrow : finSumFinEquiv.symm (Fin.castAdd m i) = Sum.inl i := by
            simpa using (finSumFinEquiv.symm_apply_apply (Sum.inl i))
          simp [packIndex, stackedA, rawA, Matrix.reindex_apply, hsum,
            Matrix.fromRows_apply_inl, Matrix.fromCols_apply_inl, hrow]
      | inr i =>
          have hnat : i.addNat m = Fin.natAdd m i := by
            simp
          have hrow : finSumFinEquiv.symm (i.addNat m) = Sum.inr i := by
            rw [hnat]
            simpa using (finSumFinEquiv_symm_apply_natAdd (m := m) i)
          simp [packIndex, stackedA, rawA, Matrix.reindex_apply, hsum,
            Matrix.fromCols_apply_inr, hrow]
    simpa [hrowEq] using hcomp
  have hindep : RowMultiplierHasIndependentSupportRows A (uPos' - uNeg') := by
    -- The packed support independence transports back to the original signed row multiplier.
    exact rowMultiplierHasIndependentSupportRows_of_packedSupportLinearIndependent A hpacked_support
  exact ⟨uPos', uNeg', huPos'_nonneg, huNeg'_nonneg, huπ', hstrict', hindep⟩

/-- Helper for Theorem 5.5: once a strict dual pair is disjoint, the source inequalities `(5.9)`
through `(5.11)` normalize it to a violating split-cut row multiplier. -/
lemma strictViolation_of_disjointDualPair
    (A : Matrix (Fin m) (Fin n) ℝ)
    (b : Fin m → ℝ)
    {I : Finset (Fin n)}
    (s : Split I)
    {xbar : Fin n → ℝ}
    (hxbar_poly : xbar ∈ polyhedron_le_set A b)
    (hxbar_strip : xbar ∈ split_strip s s.π0)
    {uPos uNeg : Fin m → ℝ}
    (huPos_nonneg : 0 ≤ uPos)
    (huNeg_nonneg : 0 ≤ uNeg)
    (hdisjoint : ∀ i : Fin m, ¬ (0 < uPos i ∧ 0 < uNeg i))
    (huπ : (uPos - uNeg) ᵥ* A = (fun j : Fin n ↦ (s j : ℝ)))
    (hstrict :
      ((uPos - uNeg) ⬝ᵥ b) +
          (uNeg ⬝ᵥ (b - A *ᵥ xbar)) / (split_dot s xbar - (s.π0 : ℝ)) <
        (s.π0 : ℝ) + 1) :
    let u : Fin m → ℝ := uPos - uNeg
    (s.π0 : ℝ) < u ⬝ᵥ b ∧
      u ⬝ᵥ b < (s.π0 : ℝ) + 1 ∧
        split_cut_value A b u s.π0 xbar < 1 := by
  dsimp
  let u : Fin m → ℝ := uPos - uNeg
  let r : Fin m → ℝ := b - A *ᵥ xbar
  let s1 : ℝ := uPos ⬝ᵥ r
  let s2 : ℝ := uNeg ⬝ᵥ r
  let δ : ℝ := split_dot s xbar - (s.π0 : ℝ)
  let f : ℝ := u ⬝ᵥ b - (s.π0 : ℝ)
  rcases mem_split_strip_iff.mp hxbar_strip with ⟨hδ_pos, hδ_lt_top⟩
  have hδ_pos' : 0 < δ := by
    simpa [δ] using hδ_pos
  have hδ_lt_one : δ < 1 := by
    dsimp [δ]
    linarith
  have hr_nonneg : 0 ≤ r := by
    intro i
    dsimp [r]
    exact sub_nonneg.mpr (hxbar_poly i)
  have hs1_nonneg : 0 ≤ s1 := by
    -- The positive-part slack is a nonnegative weighted sum of nonnegative residuals.
    dsimp [s1]
    exact dotProduct_nonneg_of_nonneg huPos_nonneg hr_nonneg
  have hs2_nonneg : 0 ≤ s2 := by
    -- The negative-part slack is the same kind of nonnegative sum.
    dsimp [s2]
    exact dotProduct_nonneg_of_nonneg huNeg_nonneg hr_nonneg
  have hparts := rowMultiplierParts_eq_of_disjointPair huPos_nonneg huNeg_nonneg hdisjoint
  rcases hparts with ⟨hpos_part, hneg_part⟩
  have huπ' : u ᵥ* A = (fun j : Fin n ↦ (s j : ℝ)) := by
    simpa [u] using huπ
  have hgap0 : s1 - s2 = u ⬝ᵥ b - split_dot s xbar := by
    -- This is the row-slack identity from the already-proved split-gap lemma.
    have hgap0' := splitCutRowSlackGap_eq_rhsGap A b u s huπ' xbar
    rw [hpos_part, hneg_part] at hgap0'
    simpa [r, s1, s2] using hgap0'
  have hgap : s1 - s2 = f - δ := by
    dsimp [f, δ]
    linarith
  have hstrict' : f + s2 / δ < 1 := by
    -- Rewrite the strict stacked-dual inequality in the normalized variables `f` and `s2 / δ`.
    dsimp [f, δ, u, s2] at hstrict ⊢
    linarith
  have hf_lt_one : f < 1 := by
    have hs2_div_nonneg : 0 ≤ s2 / δ := by
      exact div_nonneg hs2_nonneg hδ_pos'.le
    linarith
  have hs2_lt : s2 < δ * (1 - f) := by
    have hs2_div_lt : s2 / δ < 1 - f := by
      linarith
    have hs2_lt' : s2 < (1 - f) * δ := by
      exact (div_lt_iff₀ hδ_pos').mp hs2_div_lt
    simpa [mul_comm, mul_left_comm, mul_assoc] using hs2_lt'
  have hs1_lt : s1 < f * (1 - δ) := by
    -- Substitute the slack-gap identity into the strict upper estimate for `s2`.
    nlinarith [hgap, hs2_lt]
  have hf_pos : 0 < f := by
    have hprod_pos : 0 < f * (1 - δ) := by
      exact lt_of_le_of_lt hs1_nonneg hs1_lt
    nlinarith
  have hub_left : (s.π0 : ℝ) < u ⬝ᵥ b := by
    dsimp [f] at hf_pos
    linarith
  have hub_right : u ⬝ᵥ b < (s.π0 : ℝ) + 1 := by
    dsimp [f] at hf_lt_one
    linarith
  have hnum_lt : (1 - f) * s1 + f * s2 < f * (1 - f) := by
    -- The numerator shortfall is exactly the strict defect `δ * (1 - f) - s2`.
    nlinarith [hgap, hs2_lt]
  have hcut_repr :
      split_cut_value A b u s.π0 xbar =
        ((1 - f) * s1 + f * s2) / (f * (1 - f)) := by
    have hf_ne : f ≠ 0 := ne_of_gt hf_pos
    have h_one_sub_f_pos : 0 < 1 - f := by
      linarith
    have h_one_sub_f_ne : 1 - f ≠ 0 := ne_of_gt h_one_sub_f_pos
    -- Rewrite the split-cut value into a single rational expression over the positive
    -- denominator `f * (1 - f)`.
    rw [split_cut_value, hpos_part, hneg_part]
    have hden_left : u ⬝ᵥ b - (s.π0 : ℝ) = f := by
      rfl
    have hden_right : (s.π0 : ℝ) + 1 - u ⬝ᵥ b = 1 - f := by
      dsimp [f]
      ring
    rw [hden_left, hden_right]
    field_simp [hf_ne, h_one_sub_f_ne]
    ring
  have hcut_lt : split_cut_value A b u s.π0 xbar < 1 := by
    have hden_pos : 0 < f * (1 - f) := mul_pos hf_pos (by linarith)
    have hnum_lt' : (1 - f) * s1 + f * s2 < 1 * (f * (1 - f)) := by
      simpa using hnum_lt
    rw [hcut_repr]
    exact (div_lt_iff₀ hden_pos).2 hnum_lt'
  exact ⟨hub_left, hub_right, hcut_lt⟩

/-- Helper for Theorem 5.5: a point of `P \ P^(π, π₀)` violates one split inequality generated by
a basic row multiplier. -/
lemma existsBasicViolatingRowMultiplier_of_not_memSplitPolyhedron
    (A : Matrix (Fin m) (Fin n) ℝ)
    (b : Fin m → ℝ)
    {I : Finset (Fin n)}
    (s : Split I)
    {xbar : Fin n → ℝ}
    (hxbar_poly : xbar ∈ polyhedron_le_set A b)
    (hxbar_not : xbar ∉ split_polyhedron A b s) :
    ∃ u : Fin m → ℝ,
      u ∈ basic_row_multiplier_set A s ∧
        (s.π0 : ℝ) < u ⬝ᵥ b ∧
          u ⬝ᵥ b < (s.π0 : ℝ) + 1 ∧
            split_cut_value A b u s.π0 xbar < 1 := by
  have hxbar_strip : xbar ∈ split_strip s s.π0 :=
    memSplitStrip_of_polyhedron_not_memSplitPolyhedron A b s hxbar_poly hxbar_not
  have hδ_pos : 0 < split_dot s xbar - (s.π0 : ℝ) := by
    simpa using (mem_split_strip_iff.mp hxbar_strip).1
  obtain ⟨uPos, uNeg, huPos_nonneg, huNeg_nonneg, huπ, hstrict⟩ :=
    existsStrictViolatingDualPair_of_not_memSplitPolyhedron A b s hxbar_poly hxbar_not
  obtain ⟨uPos', uNeg', huPos'_nonneg, huNeg'_nonneg, huπ', hstrict', hindep⟩ :=
    existsIndependentSupportStrictViolatingDualPair
      A b s hxbar_poly hxbar_strip huPos_nonneg huNeg_nonneg huπ hstrict
  let u : Fin m → ℝ := uPos' - uNeg'
  have hstrictSigned :
      (u ⬝ᵥ b) +
          (row_multiplier_neg u ⬝ᵥ (b - A *ᵥ xbar)) / (split_dot s xbar - (s.π0 : ℝ)) <
        (s.π0 : ℝ) + 1 := by
    -- Compress the packed dual pair to its signed multiplier before applying the final strip
    -- normalization argument.
    simpa [u] using strictSignedObjective_of_nonnegDualPair
      A b s huPos'_nonneg huNeg'_nonneg hxbar_poly hδ_pos hstrict'
  have hu_violate :
      (s.π0 : ℝ) < u ⬝ᵥ b ∧
        u ⬝ᵥ b < (s.π0 : ℝ) + 1 ∧
          split_cut_value A b u s.π0 xbar < 1 := by
    -- Route correction: after extracting the packed basic witness, the last step works directly
    -- with the signed multiplier and no longer needs a disjointness normalization lemma.
    simpa [u] using strictViolation_of_strictSignedRowMultiplier
      A b s hxbar_poly hxbar_strip huπ' hstrictSigned
  rcases hu_violate with ⟨hub_left, hub_right, hcut⟩
  refine ⟨u, ?_, hub_left, hub_right, hcut⟩
  exact (mem_basic_row_multiplier_set_iff A s u).2 ⟨huπ', hindep⟩

/-- Theorem 5.5. Let `P = {x ∈ ℝ^n | A x ≤ b}`, let `I ⊆ {1, …, n}`, and let
`S = mixed_integer_feasible_set A b I`. Given a split `s = (π, π₀)` supported on `I`, the split
polyhedron `P^(π, π₀)` is exactly the set of points of `P` satisfying all inequalities `(5.7)`
indexed by basic row multipliers `u ∈ B_π` with `π₀ < u b < π₀ + 1`. -/
theorem split_polyhedron_eq_basic_split_cut_system
    (A : Matrix (Fin m) (Fin n) ℝ)
    (b : Fin m → ℝ)
    {I : Finset (Fin n)}
    (s : Split I) :
    split_polyhedron A b s = basic_split_cut_system A b s s.π0 := by
  ext x
  constructor
  · intro hx
    refine (mem_basic_split_cut_system_iff A b s s.π0 x).2 ?_
    refine ⟨mem_polyhedron_of_memSplitPolyhedron A b s hx, ?_⟩
    intro u huBasic hub_left hub_right
    -- The forward inclusion is exactly validity of `(5.7)` on the split hull.
    exact validSplitCutValue_of_memSplitPolyhedron A b s hx u huBasic hub_left hub_right
  · intro hx
    rcases (mem_basic_split_cut_system_iff A b s s.π0 x).mp hx with ⟨hx_poly, hx_cuts⟩
    by_contra hx_not
    rcases existsBasicViolatingRowMultiplier_of_not_memSplitPolyhedron
        A b s hx_poly hx_not with ⟨u, huBasic, hub_left, hub_right, hviol⟩
    have hcut := hx_cuts u huBasic hub_left hub_right
    linarith

end Theorem55
