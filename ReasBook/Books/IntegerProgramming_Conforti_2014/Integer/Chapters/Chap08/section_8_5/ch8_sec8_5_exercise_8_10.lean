import Mathlib.LinearAlgebra.Matrix.DotProduct
import IntegerProgramming_Conforti_2014.Integer.Chapters.Chap08.section_8_5.ch8_sec8_5_exercise_8_9

-- Declarations for this item will be appended below by the statement pipeline.

open scoped BigOperators Matrix

section Exercise810

-- Semantic recall note: the Chapter 8 owner for subgradients is `IsSubgradientAtOn`; this file
-- reuses that owner at `Set.univ` and adds only the exercise-specific ascent/descent predicates.

variable {n : ℕ}

/-- A vector `s` is a direction of ascent for `g` at `λ_star` when sufficiently short positive
steps along `s` strictly increase the function value. -/
def IsAscentDirectionAt
    (g : (Fin n → ℝ) → ℝ) (lambdaStar s : Fin n → ℝ) : Prop :=
  ∃ ε : ℝ, 0 < ε ∧
    ∀ ⦃t : ℝ⦄, 0 < t → t < ε → g (lambdaStar + t • s) > g lambdaStar

/-- A vector `s` is a direction of descent for `g` at `λ_star` when sufficiently short positive
steps along `s` strictly decrease the function value. -/
def IsDescentDirectionAt
    (g : (Fin n → ℝ) → ℝ) (lambdaStar s : Fin n → ℝ) : Prop :=
  IsAscentDirectionAt (fun x ↦ -g x) lambdaStar s

namespace IsDescentDirectionAt

/-- Unfolding `IsDescentDirectionAt g λ_star s` gives the textbook short-step strict decrease
condition along `s`. -/
theorem iff_exists_pos
    {g : (Fin n → ℝ) → ℝ} {lambdaStar s : Fin n → ℝ} :
    IsDescentDirectionAt g lambdaStar s ↔
      ∃ ε : ℝ, 0 < ε ∧
        ∀ ⦃t : ℝ⦄, 0 < t → t < ε → g (lambdaStar + t • s) < g lambdaStar := by
  constructor
  · rintro ⟨ε, hε, hε_step⟩
    refine ⟨ε, hε, ?_⟩
    intro t ht_pos ht_lt
    have hlt := hε_step ht_pos ht_lt
    linarith
  · rintro ⟨ε, hε, hε_step⟩
    refine ⟨ε, hε, ?_⟩
    intro t ht_pos ht_lt
    have hlt := hε_step ht_pos ht_lt
    linarith

/-- A descent direction supplies a short-step strict decrease witness. -/
theorem exists_pos
    {g : (Fin n → ℝ) → ℝ} {lambdaStar s : Fin n → ℝ}
    (hs : IsDescentDirectionAt g lambdaStar s) :
    ∃ ε : ℝ, 0 < ε ∧
      ∀ ⦃t : ℝ⦄, 0 < t → t < ε → g (lambdaStar + t • s) < g lambdaStar :=
  iff_exists_pos.mp hs

/-- The textbook short-step strict decrease condition is sufficient for
`IsDescentDirectionAt g λ_star s`. -/
theorem mk
    {g : (Fin n → ℝ) → ℝ} {lambdaStar s : Fin n → ℝ}
    (hs : ∃ ε : ℝ, 0 < ε ∧
      ∀ ⦃t : ℝ⦄, 0 < t → t < ε → g (lambdaStar + t • s) < g lambdaStar) :
    IsDescentDirectionAt g lambdaStar s :=
  iff_exists_pos.mpr hs

end IsDescentDirectionAt

/-- A whole-space subgradient controls `g` from below along the ray generated by that same
subgradient vector. -/
theorem subgradient_self_ray_lower_bound
    (g : (Fin n → ℝ) → ℝ)
    (lambdaStar s : Fin n → ℝ)
    (hs : IsSubgradientAt g lambdaStar s)
    (t : ℝ) :
    g (lambdaStar + t • s) ≥ g lambdaStar + t * (s ⬝ᵥ s) := by
  simpa [dotProduct, Finset.mul_sum, mul_assoc, mul_left_comm, mul_comm] using
    hs.ineq (lambdaStar + t • s)

/-- Along the ray generated by a whole-space subgradient, `g` cannot decrease for nonnegative
stepsizes. -/
theorem subgradient_self_ray_ge
    (g : (Fin n → ℝ) → ℝ)
    (lambdaStar s : Fin n → ℝ)
    (hs : IsSubgradientAt g lambdaStar s)
    {t : ℝ}
    (ht : 0 ≤ t) :
    g (lambdaStar + t • s) ≥ g lambdaStar := by
  -- Compare `g` to its affine lower support along the ray generated by `s`.
  have hlower := subgradient_self_ray_lower_bound g lambdaStar s hs t
  have hdot : 0 ≤ s ⬝ᵥ s := by
    -- Over `ℝ`, the self-dot-product is a sum of squares.
    simp only [dotProduct]
    exact Finset.sum_nonneg fun i _ ↦ mul_self_nonneg (s i)
  have hmul : 0 ≤ t * (s ⬝ᵥ s) := mul_nonneg ht hdot
  linarith

/-- Exercise 8.10 (1). Any whole-space subgradient at `λ_star` already forces strict increase
along its own nonzero direction, so in particular the convex setting of the exercise cannot be
realized by taking a subgradient as the direction vector itself. -/
theorem subgradient_is_ascent_direction
    (g : (Fin n → ℝ) → ℝ)
    (lambdaStar s : Fin n → ℝ)
    (hs : IsSubgradientAt g lambdaStar s)
    (hs_ne : s ≠ 0) :
    IsAscentDirectionAt g lambdaStar s := by
  refine ⟨1, zero_lt_one, ?_⟩
  intro t ht_pos _ht_lt
  -- The self-ray lower bound becomes strict because `s ⬝ᵥ s` is positive for `s ≠ 0`.
  have hlower := subgradient_self_ray_lower_bound g lambdaStar s hs t
  have hdot_nonneg : 0 ≤ s ⬝ᵥ s := by
    simp only [dotProduct]
    exact Finset.sum_nonneg fun i _ ↦ mul_self_nonneg (s i)
  have hdot_ne : s ⬝ᵥ s ≠ 0 := by
    intro hdot_zero
    exact hs_ne (dotProduct_self_eq_zero.mp hdot_zero)
  have hdot : 0 < s ⬝ᵥ s := by
    exact lt_of_le_of_ne hdot_nonneg (fun hzero ↦ hdot_ne hzero.symm)
  have hmul : 0 < t * (s ⬝ᵥ s) := mul_pos ht_pos hdot
  linarith

/-- Exercise 8.10 (2). A whole-space subgradient at `λ_star` cannot be a direction of descent at
`λ_star`. -/
theorem subgradient_is_not_descent_direction
    (g : (Fin n → ℝ) → ℝ)
    (lambdaStar s : Fin n → ℝ)
    (hs : IsSubgradientAt g lambdaStar s) :
    ¬ IsDescentDirectionAt g lambdaStar s := by
  intro hs_desc
  rcases hs_desc.exists_pos with ⟨ε, hε, hstep⟩
  have hlower := subgradient_self_ray_ge g lambdaStar s hs (show 0 ≤ ε / 2 by linarith)
  have hlt := hstep (show 0 < ε / 2 by linarith) (show ε / 2 < ε by linarith)
  linarith

end Exercise810
