import IntegerProgramming_Conforti_2014.Integer.Chapters.Chap08.section_8_3.ch8_sec8_3_theorem_8_18

-- Declarations for this item will be appended below by the statement pipeline.

open scoped Matrix

-- This source-facing exercise keeps the nonlinear master data `f` and `F`, while reusing the
-- Chapter 8 Benders subproblem owners for the unchanged linear-programming `y`-subproblem.

section Exercise817

variable {α : Type*}
variable {m p : ℕ}
variable {K J : Type*}

/-- The right-hand side `b - F(x)` obtained after fixing the master variable `x` in the nonlinear
Benders subproblem. -/
def nonlinear_benders_residual
    (F : α → Fin m → ℝ)
    (b : Fin m → ℝ)
    (x : α) : Fin m → ℝ :=
  fun i ↦ b i - F x i

/-- The feasible `x`-projection of the mixed system `F(x) + G y ≤ b`, `y ≥ 0`, encoded as
existence of a subproblem solution after fixing `x`. -/
abbrev nonlinear_benders_projection_set
    (F : α → Fin m → ℝ)
    (G : Matrix (Fin m) (Fin p) ℝ)
    (b : Fin m → ℝ) : Set α :=
  Benders.projectionSet (nonlinear_benders_residual F b) G

/-- Membership in the nonlinear Benders projection means that there exists a nonnegative vector
`y` satisfying `G y ≤ b - F(x)`. -/
theorem mem_nonlinear_benders_projection_set_iff
    (F : α → Fin m → ℝ)
    (G : Matrix (Fin m) (Fin p) ℝ)
    (b : Fin m → ℝ)
    (x : α) :
    x ∈ nonlinear_benders_projection_set F G b ↔
      ∃ y : Fin p → ℝ,
        y ∈ benders_subproblem_feasible_set G (nonlinear_benders_residual F b x) :=
  Benders.mem_projectionSet_iff (nonlinear_benders_residual F b) G x

/-- The optimality cuts generated by `u` at a fixed master point `x`. -/
abbrev nonlinear_benders_optimality_cut_set
    (F : α → Fin m → ℝ)
    (b : Fin m → ℝ)
    (u : K → Fin m → ℝ)
    (x : α) : Set ℝ :=
  Benders.optimalityCutSet (nonlinear_benders_residual F b) u x

/-- Membership in the nonlinear Benders optimality-cut set means satisfying every inequality
`η ≤ u^k (b - F(x))`. -/
theorem mem_nonlinear_benders_optimality_cut_set_iff
    (F : α → Fin m → ℝ)
    (b : Fin m → ℝ)
    (u : K → Fin m → ℝ)
    (x : α)
    (η : ℝ) :
    η ∈ nonlinear_benders_optimality_cut_set F b u x ↔
      ∀ k, η ≤ u k ⬝ᵥ nonlinear_benders_residual F b x :=
  Benders.mem_optimalityCutSet_iff (nonlinear_benders_residual F b) u x η

/-- The supremal `η` allowed by all nonlinear Benders optimality cuts at `x`. -/
noncomputable abbrev nonlinear_benders_optimality_cut_value
    (F : α → Fin m → ℝ)
    (b : Fin m → ℝ)
    (u : K → Fin m → ℝ)
    (x : α) : EReal :=
  Benders.optimalityCutValue (nonlinear_benders_residual F b) u x

/-- The feasibility cuts generated by `r` on the master variable `x`. -/
abbrev nonlinear_benders_feasibility_cut_set
    (F : α → Fin m → ℝ)
    (b : Fin m → ℝ)
    (r : J → Fin m → ℝ) : Set α :=
  Benders.feasibilityCutSet (nonlinear_benders_residual F b) r

/-- Membership in the nonlinear Benders feasibility-cut set means satisfying every inequality
`r^j (b - F(x)) ≥ 0`. -/
theorem mem_nonlinear_benders_feasibility_cut_set_iff
    (F : α → Fin m → ℝ)
    (b : Fin m → ℝ)
    (r : J → Fin m → ℝ)
    (x : α) :
    x ∈ nonlinear_benders_feasibility_cut_set F b r ↔
      ∀ j, 0 ≤ r j ⬝ᵥ nonlinear_benders_residual F b x :=
  Benders.mem_feasibilityCutSet_iff (nonlinear_benders_residual F b) r x

/-- The feasible set of the nonlinear mixed problem
`max {f(x) + h y | x ∈ X, F(x) + G y ≤ b, y ∈ ℝ_+^p}`. -/
abbrev nonlinear_benders_original_feasible_set
    (F : α → Fin m → ℝ)
    (G : Matrix (Fin m) (Fin p) ℝ)
    (b : Fin m → ℝ)
    (X : Set α) : Set (α × (Fin p → ℝ)) :=
  Benders.originalFeasibleSet (nonlinear_benders_residual F b) G X

/-- Membership in the nonlinear mixed feasible set means `x ∈ X` and `y` solves the nonlinear
Benders subproblem with right-hand side `b - F(x)`. -/
theorem mem_nonlinear_benders_original_feasible_set_iff
    (F : α → Fin m → ℝ)
    (G : Matrix (Fin m) (Fin p) ℝ)
    (b : Fin m → ℝ)
    (X : Set α)
    (xy : α × (Fin p → ℝ)) :
    xy ∈ nonlinear_benders_original_feasible_set F G b X ↔
      xy.1 ∈ X ∧
        xy.2 ∈ benders_subproblem_feasible_set G (nonlinear_benders_residual F b xy.1) :=
  Benders.mem_originalFeasibleSet_iff (nonlinear_benders_residual F b) G X xy

/-- The source value `z_I` of the nonlinear mixed problem, namely the maximum of
`f(x) + h y` over the feasible pairs `(x, y)`. -/
noncomputable abbrev nonlinear_benders_original_value
    (F : α → Fin m → ℝ)
    (G : Matrix (Fin m) (Fin p) ℝ)
    (b : Fin m → ℝ)
    (X : Set α)
    (f : α → ℝ)
    (h : Fin p → ℝ) : EReal :=
  Benders.originalValue (nonlinear_benders_residual F b) G X f h

/-- The feasible set of the nonlinear Benders master reformulation, with optimality cuts indexed
by `K` and feasibility cuts indexed by `J`. -/
abbrev nonlinear_benders_master_feasible_set
    (F : α → Fin m → ℝ)
    (b : Fin m → ℝ)
    (X : Set α)
    (u : K → Fin m → ℝ)
    (r : J → Fin m → ℝ) : Set (α × ℝ) :=
  Benders.masterFeasibleSet (nonlinear_benders_residual F b) X u r

/-- Membership in the nonlinear Benders master feasible set is exactly the conjunction of the
master restriction `x ∈ X`, all optimality cuts, and all feasibility cuts. -/
theorem mem_nonlinear_benders_master_feasible_set_iff
    (F : α → Fin m → ℝ)
    (b : Fin m → ℝ)
    (X : Set α)
    (u : K → Fin m → ℝ)
    (r : J → Fin m → ℝ)
    (xη : α × ℝ) :
    xη ∈ nonlinear_benders_master_feasible_set F b X u r ↔
      xη.1 ∈ X ∧
        (∀ k, xη.2 ≤ u k ⬝ᵥ nonlinear_benders_residual F b xη.1) ∧
        ∀ j, 0 ≤ r j ⬝ᵥ nonlinear_benders_residual F b xη.1 :=
  Benders.mem_masterFeasibleSet_iff (nonlinear_benders_residual F b) X u r xη

/-- The optimal value of the nonlinear Benders master reformulation, namely the maximum of
`f(x) + η` over the master feasible pairs `(x, η)`. -/
noncomputable abbrev nonlinear_benders_master_value
    (F : α → Fin m → ℝ)
    (b : Fin m → ℝ)
    (X : Set α)
    (u : K → Fin m → ℝ)
    (r : J → Fin m → ℝ)
    (f : α → ℝ) : EReal :=
  Benders.masterValue (nonlinear_benders_residual F b) X u r f

/-- Exercise 8.17. Let `X ⊆ ℝ^n`. For arbitrary maps `f : X → ℝ` and `F : X → ℝ^m`, the mixed
optimization problem
`max {f(x) + h y | x ∈ X, F(x) + G y ≤ b, y ∈ ℝ_+^p}` admits the same Benders reformulation
pattern as (8.26): if the feasible `x`-projection is exactly the set cut out by the feasibility
cuts and the subproblem value is exactly the supremum described by the optimality cuts, then the
original problem value equals the nonlinear Benders master value obtained by replacing `c x` and
`A x` with `f(x)` and `F(x)` respectively. -/
theorem nonlinear_benders_original_value_eq_master_value
    (F : α → Fin m → ℝ)
    (G : Matrix (Fin m) (Fin p) ℝ)
    (b : Fin m → ℝ)
    (X : Set α)
    (f : α → ℝ)
    (h : Fin p → ℝ)
    (u : K → Fin m → ℝ)
    (r : J → Fin m → ℝ)
    (hproj :
      nonlinear_benders_projection_set F G b =
        nonlinear_benders_feasibility_cut_set F b r)
    (hsubproblem :
      ∀ x : α,
        x ∈ nonlinear_benders_projection_set F G b →
          benders_subproblem_value G h (nonlinear_benders_residual F b x) =
            nonlinear_benders_optimality_cut_value F b u x) :
    nonlinear_benders_original_value F G b X f h =
      nonlinear_benders_master_value F b X u r f := by
  -- Specialize the residual-based Benders reformulation to the nonlinear residual `x ↦ b - F x`.
  exact Benders.originalValue_eq_masterValue (nonlinear_benders_residual F b) G X f h u r
    hproj hsubproblem

end Exercise817
