import IntegerProgramming_Conforti_2014.Integer.Chapters.Chap03.section_3_6.ch3_sec3_6_proposition_3_15
import IntegerProgramming_Conforti_2014.Integer.Chapters.Chap03.section_3_11.ch3_sec3_11_definition_3_11_extra_1

open scoped Pointwise

section PointedCoreSupport

variable {n : ℕ}

/-- Helper for Theorem 3.37: a vector of a cone that contains its negative is a lineality
direction. -/
lemma mem_linealitySpace_of_mem_cone_and_neg
    {C : Set (Fin n → ℝ)}
    (hC_cone : ∃ K : PointedCone ℝ (Fin n → ℝ), (K : Set (Fin n → ℝ)) = C)
    {x : Fin n → ℝ}
    (hx : x ∈ C)
    (hnegx : -x ∈ C) :
    x ∈ linealitySpace C := by
  rcases hC_cone with ⟨K, rfl⟩
  rw [mem_linealitySpace_iff]
  intro z hz a
  by_cases ha : 0 ≤ a
  · exact add_mem hz (K.smul_mem ha hx)
  · have hneg_a : 0 ≤ -a := (neg_pos.mpr (lt_of_not_ge ha)).le
    have hscaled : (-a) • (-x) ∈ K := K.smul_mem hneg_a hnegx
    simpa [smul_neg, neg_smul] using add_mem hz hscaled

/-- Helper for Theorem 3.37: pointedness forces a cone vector whose negative is also in the cone
to vanish. -/
lemma eq_zero_of_mem_pointedCone_and_neg
    {C : Set (Fin n → ℝ)}
    (hC_cone : ∃ K : PointedCone ℝ (Fin n → ℝ), (K : Set (Fin n → ℝ)) = C)
    (hC_pointed : is_pointed C)
    {x : Fin n → ℝ}
    (hx : x ∈ C)
    (hnegx : -x ∈ C) :
    x = 0 := by
  -- Convert the two-sided cone membership into the lineality criterion for pointedness.
  exact (is_pointed_iff_eq_zero_of_mem_linealitySpace.mp hC_pointed) x
    (mem_linealitySpace_of_mem_cone_and_neg hC_cone hx hnegx)

/-- Helper for Theorem 3.37: adding a nonnegative multiple of one point of a finitely generated
cone to another stays in that cone. -/
lemma finitelyGeneratedCone_add_smul_mem
    {q : ℕ} (rays : Fin q → Fin n → ℝ)
    {y r : Fin n → ℝ}
    (hy : y ∈ finitely_generated_cone rays)
    (hr : r ∈ finitely_generated_cone rays)
    {a : ℝ} (ha : 0 ≤ a) :
    y + a • r ∈ finitely_generated_cone rays := by
  rcases mem_finitely_generated_cone_iff.mp hy with ⟨μ, hμ, rfl⟩
  rcases mem_finitely_generated_cone_iff.mp hr with ⟨ν, hν, rfl⟩
  refine mem_finitely_generated_cone_iff.mpr ⟨fun i ↦ μ i + a * ν i, ?_, ?_⟩
  · intro i
    exact add_nonneg (hμ i) (mul_nonneg ha (hν i))
  · calc
      (∑ i, μ i • rays i) + a • ∑ i, ν i • rays i
          = (∑ i, μ i • rays i) + ∑ i, (a * ν i) • rays i := by
              congr 1
              rw [Finset.smul_sum]
              refine Finset.sum_congr rfl ?_
              intro i _
              rw [smul_smul]
      _ = ∑ i, (μ i • rays i + (a * ν i) • rays i) := by
            rw [← Finset.sum_add_distrib]
      _ = ∑ i, (μ i + a * ν i) • rays i := by
            refine Finset.sum_congr rfl ?_
            intro i _
            rw [add_smul]

/-- Helper for Theorem 3.37: a conic representation splits into one selected generator and a
point of the cone generated by the remaining family. -/
lemma mem_finitelyGeneratedCone_splitGenerator
    {q : ℕ}
    {rays : Fin (q + 1) → Fin n → ℝ}
    {i : Fin (q + 1)}
    {x : Fin n → ℝ}
    (hx : x ∈ finitely_generated_cone rays) :
    ∃ a : ℝ, 0 ≤ a ∧
      ∃ y : Fin n → ℝ,
        y ∈ finitely_generated_cone (fun j : Fin q ↦ rays (i.succAbove j)) ∧
          x = a • rays i + y := by
  rcases mem_finitely_generated_cone_iff.mp hx with ⟨μ, hμ, hsum⟩
  refine ⟨μ i, hμ i, ∑ j : Fin q, μ (i.succAbove j) • rays (i.succAbove j), ?_, ?_⟩
  · refine mem_finitely_generated_cone_iff.mpr ⟨fun j ↦ μ (i.succAbove j), ?_, rfl⟩
    intro j
    exact hμ (i.succAbove j)
  · calc
      x = ∑ j : Fin (q + 1), μ j • rays j := hsum
      _ = μ i • rays i + ∑ j : Fin q, μ (i.succAbove j) • rays (i.succAbove j) := by
            simpa using (Fin.sum_univ_succAbove (f := fun j : Fin (q + 1) ↦ μ j • rays j) i)

/-- Helper for Theorem 3.37: deleting a generator already generated by all the other rays does
not change a finitely generated cone. -/
lemma finitelyGeneratedCone_eq_delete_of_generator_mem
    {q : ℕ}
    (rays : Fin (q + 1) → Fin n → ℝ)
    (i : Fin (q + 1))
    (hi : rays i ∈ finitely_generated_cone (fun j : Fin q ↦ rays (i.succAbove j))) :
    finitely_generated_cone rays =
      finitely_generated_cone (fun j : Fin q ↦ rays (i.succAbove j)) := by
  apply Set.Subset.antisymm
  · intro x hx
    rcases mem_finitelyGeneratedCone_splitGenerator (i := i) hx with
      ⟨a, ha, y, hy, hsplit⟩
    have hsum :=
      finitelyGeneratedCone_add_smul_mem (fun j : Fin q ↦ rays (i.succAbove j)) hy hi ha
    simpa [hsplit, add_comm] using hsum
  · simpa [finitely_generated_cone] using
      (cone_min
        (S := Set.range fun j : Fin q ↦ rays (i.succAbove j))
        (T := Set.range rays)
        (by
          rintro _ ⟨j, rfl⟩
          exact subset_cone (Set.range rays) (Set.mem_range_self (i.succAbove j))))

/-- Helper for Theorem 3.37: a nonextreme generator of a pointed finitely generated cone belongs
to the cone generated by the remaining generators. -/
lemma nonextremeGenerator_mem_deletedCone_of_pointed
    {q : ℕ}
    (C : Set (Fin n → ℝ))
    (rays : Fin (q + 1) → Fin n → ℝ)
    (i : Fin (q + 1))
    (hC_pointed : is_pointed C)
    (hC_eq : C = finitely_generated_cone rays)
    (hi_not_extreme : ¬ IsExtremeRayOfCone C (rays i)) :
    rays i ∈ finitely_generated_cone (fun j : Fin q ↦ rays (i.succAbove j)) := by
  classical
  let deleted : Fin q → Fin n → ℝ := fun j ↦ rays (i.succAbove j)
  have hdeleted_subset : finitely_generated_cone deleted ⊆ C := by
    rw [hC_eq]
    simpa [deleted, finitely_generated_cone] using
      (cone_min
        (S := Set.range deleted)
        (T := Set.range rays)
        (by
          rintro _ ⟨j, rfl⟩
          exact subset_cone (Set.range rays) (Set.mem_range_self (i.succAbove j))))
  have hgi_mem : rays i ∈ C := by
    rw [hC_eq]
    exact subset_cone (Set.range rays) (Set.mem_range_self i)
  by_cases hgi_zero : rays i = 0
  · refine mem_finitely_generated_cone_iff.mpr ⟨fun _ ↦ 0, ?_, ?_⟩
    · intro j
      simp
    · simp [hgi_zero]
  · have hC_cone :
        ∃ K : PointedCone ℝ (Fin n → ℝ), (K : Set (Fin n → ℝ)) = C := by
      refine ⟨PointedCone.hull ℝ (Set.range rays), ?_⟩
      simpa [finitely_generated_cone] using hC_eq.symm
    have hproper : ProperConicCombinationOfDistinctConeRays C (rays i) := by
      have hnotnot : ¬ ¬ ProperConicCombinationOfDistinctConeRays C (rays i) := by
        simpa [isExtremeRayOfCone_iff_not_proper_conic_combination_of_distinct_rays
          hC_cone hgi_mem hgi_zero] using hi_not_extreme
      exact not_not.mp hnotnot
    rcases hproper with
      ⟨r₁, r₂, hr₁, hr₂, hr₁_ne, hr₂_ne, hrays_ne,
        μ₁, μ₂, hμ₁, hμ₂, hray_eq⟩
    rcases mem_finitelyGeneratedCone_splitGenerator
        (i := i) (by simpa [hC_eq] using hr₁) with
      ⟨α, hα, y₁, hy₁, hr₁_split⟩
    rcases mem_finitelyGeneratedCone_splitGenerator
        (i := i) (by simpa [hC_eq] using hr₂) with
      ⟨β, hβ, y₂, hy₂, hr₂_split⟩
    have htail_mem : μ₁ • y₁ + μ₂ • y₂ ∈ finitely_generated_cone deleted := by
      exact finitelyGeneratedCone_add_smul_mem deleted
        (cone_smul_mem hy₁ hμ₁.le) hy₂ hμ₂.le
    have hsplit_eq :
        rays i = (μ₁ * α + μ₂ * β) • rays i + (μ₁ • y₁ + μ₂ • y₂) := by
      calc
        rays i = μ₁ • r₁ + μ₂ • r₂ := hray_eq
        _ = μ₁ • (α • rays i + y₁) + μ₂ • (β • rays i + y₂) := by
              rw [hr₁_split, hr₂_split]
        _ = (μ₁ * α + μ₂ * β) • rays i + (μ₁ • y₁ + μ₂ • y₂) := by
              ext j
              simp [Pi.smul_apply, smul_eq_mul]
              ring_nf
    have htail_eq :
        μ₁ • y₁ + μ₂ • y₂ = (1 - (μ₁ * α + μ₂ * β)) • rays i := by
      calc
        μ₁ • y₁ + μ₂ • y₂ = rays i - (μ₁ * α + μ₂ * β) • rays i := by
              rw [eq_sub_iff_add_eq]
              simpa [add_comm, add_left_comm, add_assoc] using hsplit_eq.symm
        _ = (1 - (μ₁ * α + μ₂ * β)) • rays i := by
              ext j
              simp [Pi.smul_apply, smul_eq_mul]
              ring_nf
    have hcoeff_pos : 0 < 1 - (μ₁ * α + μ₂ * β) := by
      by_contra hcoeff
      have hcoeff_nonneg : 0 ≤ (μ₁ * α + μ₂ * β) - 1 := by
        linarith
      have hneg_tail : -(μ₁ • y₁ + μ₂ • y₂) ∈ C := by
        have hscaled : ((μ₁ * α + μ₂ * β) - 1) • rays i ∈ C := by
          rw [hC_eq]
          exact cone_smul_mem
            (subset_cone (Set.range rays) (Set.mem_range_self i)) hcoeff_nonneg
        have heq :
            -(μ₁ • y₁ + μ₂ • y₂) =
              ((μ₁ * α + μ₂ * β) - 1) • rays i := by
          rw [htail_eq]
          ext j
          simp [Pi.smul_apply, smul_eq_mul]
          ring_nf
        rwa [heq]
      have htail_zero : μ₁ • y₁ + μ₂ • y₂ = 0 :=
        eq_zero_of_mem_pointedCone_and_neg hC_cone hC_pointed
          (hdeleted_subset htail_mem) hneg_tail
      have hy₁_zero : y₁ = 0 := by
        have hneg₁ : -(μ₁ • y₁) = μ₂ • y₂ := by
          rw [neg_eq_iff_add_eq_zero]
          simpa [add_comm] using htail_zero
        have hμ₁y₁_zero : μ₁ • y₁ = 0 :=
          eq_zero_of_mem_pointedCone_and_neg hC_cone hC_pointed
            (hdeleted_subset (cone_smul_mem hy₁ hμ₁.le))
            (by
              rw [hneg₁]
              exact hdeleted_subset (cone_smul_mem hy₂ hμ₂.le))
        exact (smul_eq_zero.mp hμ₁y₁_zero).resolve_left hμ₁.ne'
      have hy₂_zero : y₂ = 0 := by
        have hμ₂y₂_zero : μ₂ • y₂ = 0 := by
          simpa [hy₁_zero] using htail_zero
        exact (smul_eq_zero.mp hμ₂y₂_zero).resolve_left hμ₂.ne'
      have hα_ne : α ≠ 0 := by
        intro hα_zero
        apply hr₁_ne
        simpa [hα_zero, hy₁_zero] using hr₁_split
      have hβ_ne : β ≠ 0 := by
        intro hβ_zero
        apply hr₂_ne
        simpa [hβ_zero, hy₂_zero] using hr₂_split
      have hα_pos : 0 < α := lt_of_le_of_ne hα hα_ne.symm
      have hβ_pos : 0 < β := lt_of_le_of_ne hβ hβ_ne.symm
      have hr₁_same : SameRay ℝ r₁ (rays i) := by
        rw [hr₁_split, hy₁_zero, add_zero]
        exact SameRay.sameRay_pos_smul_left (rays i) hα_pos
      have hr₂_same : SameRay ℝ r₂ (rays i) := by
        rw [hr₂_split, hy₂_zero, add_zero]
        exact SameRay.sameRay_pos_smul_left (rays i) hβ_pos
      exact hrays_ne (SameRay.trans hr₁_same hr₂_same.symm
        (fun hzero ↦ False.elim (hgi_zero hzero)))
    have htail_ne : μ₁ • y₁ + μ₂ • y₂ ≠ 0 := by
      intro hzero
      have hscaled : (1 - (μ₁ * α + μ₂ * β)) • rays i = 0 := by
        simpa [htail_eq] using hzero
      exact hgi_zero ((smul_eq_zero.mp hscaled).resolve_left hcoeff_pos.ne')
    have hcoeff_ne : 1 - (μ₁ * α + μ₂ * β) ≠ 0 := hcoeff_pos.ne'
    have hray_eq_tail :
        rays i = (1 - (μ₁ * α + μ₂ * β))⁻¹ • (μ₁ • y₁ + μ₂ • y₂) := by
      rw [htail_eq, smul_smul, inv_mul_cancel₀ hcoeff_ne, one_smul]
    rw [hray_eq_tail]
    exact cone_smul_mem htail_mem (inv_nonneg.mpr hcoeff_pos.le)

/-- Helper for Theorem 3.37: every finite generating family of a pointed cone can be pruned to a
finite generating family consisting of extreme rays. -/
lemma existsExtremeRayGeneratingFamilyOfPointedFiniteCone
    (C : Set (Fin n → ℝ))
    (hC_pointed : is_pointed C)
    {q : ℕ}
    (rays : Fin q → Fin n → ℝ)
    (hC_eq : C = finitely_generated_cone rays) :
    ∃ k : ℕ, ∃ gen : Fin k → Fin n → ℝ,
      C = finitely_generated_cone gen ∧
        ∀ s : Fin k, IsExtremeRayOfCone C (gen s) := by
  induction q with
  | zero =>
      have hrays : rays = Fin.elim0 := by
        funext j
        exact Fin.elim0 j
      refine ⟨0, Fin.elim0, ?_, ?_⟩
      · simpa [hrays] using hC_eq
      intro s
      exact Fin.elim0 s
  | succ q ih =>
      classical
      by_cases hall : ∀ s : Fin (q + 1), IsExtremeRayOfCone C (rays s)
      · exact ⟨q + 1, rays, hC_eq, hall⟩
      · obtain ⟨i, hi⟩ := not_forall.mp hall
        have hi_mem :=
          nonextremeGenerator_mem_deletedCone_of_pointed C rays i hC_pointed hC_eq hi
        have hdelete := finitelyGeneratedCone_eq_delete_of_generator_mem rays i hi_mem
        have hC_delete :
            C = finitely_generated_cone (fun j : Fin q ↦ rays (i.succAbove j)) := by
          rw [hC_eq, hdelete]
        exact ih (fun j : Fin q ↦ rays (i.succAbove j)) hC_delete

/-- Helper for Theorem 3.37: every pointed polyhedral cone has a finite generating family made of
extreme-ray generators. -/
lemma existsExtremeRayGeneratingFamilyOfPointedPolyhedralCone
    (C : Set (Fin n → ℝ))
    (hC_polyhedral : is_polyhedral_cone C)
    (hC_pointed : is_pointed C) :
    ∃ k : ℕ, ∃ gen : Fin k → Fin n → ℝ,
      C = finitely_generated_cone gen ∧
        ∀ s : Fin k, IsExtremeRayOfCone C (gen s) := by
  rcases finitely_generated_cone_iff_polyhedral_cone.mpr hC_polyhedral with ⟨q, R, hR⟩
  let rays : Fin q → Fin n → ℝ := fun j i ↦ R i j
  have hC_eq : C = finitely_generated_cone rays := by
    calc
      C = (matrix_cone R : Set (Fin n → ℝ)) := hR
      _ = finitely_generated_cone rays := by
            rfl
  exact existsExtremeRayGeneratingFamilyOfPointedFiniteCone C hC_pointed rays hC_eq

/-- Helper for Theorem 3.37: homogenizing a nonempty pointed polyhedron produces a pointed
polyhedral cone. -/
lemma homogenizedPolyhedronCone_pointed_of_pointed
    {m : ℕ}
    (A : Matrix (Fin m) (Fin n) ℝ)
    (b : Fin m → ℝ)
    (hP_nonempty : (polyhedron_le_set A b).Nonempty)
    (hP_pointed : is_pointed (polyhedron_le_set A b)) :
    is_pointed (polyhedron_le_set (homogenized_polyhedron_matrix A b) 0) := by
  rw [is_pointed_iff_eq_zero_of_mem_linealitySpace]
  intro g hg
  rw [mem_linealitySpace_iff] at hg
  have hzero_mem :
      (0 : Fin (n + 1) → ℝ) ∈ polyhedron_le_set (homogenized_polyhedron_matrix A b) 0 := by
    intro i
    simp [Matrix.mulVec]
  have hg_mem : g ∈ polyhedron_le_set (homogenized_polyhedron_matrix A b) 0 := by
    simpa using hg hzero_mem 1
  have hneg_mem : -g ∈ polyhedron_le_set (homogenized_polyhedron_matrix A b) 0 := by
    simpa using hg hzero_mem (-1)
  have hg_data :=
    (mem_homogenized_polyhedron_cone_iff_general A b (Fin.init g) (g (Fin.last n))).mp
      (by simpa using hg_mem)
  have hneg_data :=
    (mem_homogenized_polyhedron_cone_iff_general A b (-(Fin.init g)) (-(g (Fin.last n)))).mp
      (by
        convert hneg_mem using 1
        ext i
        cases i using Fin.lastCases with
        | last => simp
        | cast i => simp [Fin.init])
  have hheight_zero : g (Fin.last n) = 0 := by
    linarith [hg_data.2, hneg_data.2]
  have hvisible_rec : Fin.init g ∈ recessionCone (polyhedron_le_set A b) := by
    rw [polyhedron_recessionCone_eq_homogeneous_solution_set A b hP_nonempty]
    simpa [hheight_zero] using hg_data.1
  have hvisible_neg_rec : -(Fin.init g) ∈ recessionCone (polyhedron_le_set A b) := by
    rw [polyhedron_recessionCone_eq_homogeneous_solution_set A b hP_nonempty]
    simpa [hheight_zero] using hneg_data.1
  have hvisible_lineality : Fin.init g ∈ linealitySpace (polyhedron_le_set A b) := by
    rw [linealitySpace_eq_recessionCone_inter_neg]
    exact ⟨hvisible_rec, by rwa [mem_neg_recessionCone_iff]⟩
  have hvisible_zero : Fin.init g = 0 :=
    (is_pointed_iff_eq_zero_of_mem_linealitySpace.mp hP_pointed) _ hvisible_lineality
  -- Both the visible coordinates and the homogenizing height vanish.
  ext i
  cases i using Fin.lastCases with
  | last => simpa [hheight_zero]
  | cast i => simpa using congrFun hvisible_zero i

/-- Helper for Theorem 3.37: an extreme ray of a homogenized pointed polyhedron has either
positive height and normalizes to a vertex, or zero height and projects to an extreme recession
ray. -/
lemma homogenizedExtremeRay_classification
    {m : ℕ}
    (A : Matrix (Fin m) (Fin n) ℝ)
    (b : Fin m → ℝ)
    (hP_nonempty : (polyhedron_le_set A b).Nonempty)
    {g : Fin (n + 1) → ℝ}
    (hg_extreme :
      IsExtremeRayOfCone (polyhedron_le_set (homogenized_polyhedron_matrix A b) 0) g) :
    (0 < g (Fin.last n) ∧
        (fun i : Fin n ↦ g i.castSucc / g (Fin.last n)) ∈
          (polyhedron_le_set A b).extremePoints ℝ) ∨
      (g (Fin.last n) = 0 ∧
        IsExtremeRayOfCone (recessionCone (polyhedron_le_set A b)) (Fin.init g)) := by
  let x : Fin n → ℝ := Fin.init g
  let y : ℝ := g (Fin.last n)
  have hg_ray :
      g ∈ (PointedCone.hull ℝ ({g} : Set (Fin (n + 1) → ℝ)) :
        Set (Fin (n + 1) → ℝ)) :=
    PointedCone.subset_hull (by simp)
  have hg_mem : g ∈ polyhedron_le_set (homogenized_polyhedron_matrix A b) 0 :=
    (isExtremeRayOfCone_iff.mp hg_extreme).isExtreme.subset hg_ray
  have hg_data :=
    (mem_homogenized_polyhedron_cone_iff_general A b x y).mp (by
      simpa [x, y] using hg_mem)
  rcases lt_or_eq_of_le hg_data.2 with hy_pos | hy_zero
  · left
    refine ⟨hy_pos, ?_⟩
    rw [mem_extremePoints_iff_left]
    constructor
    · intro i
      have hi := hg_data.1 i
      have hscaled := mul_le_mul_of_nonneg_left hi (inv_nonneg.mpr hy_pos.le)
      have hvisible_scaled :
          (fun j : Fin n ↦ g j.castSucc / g (Fin.last n)) = y⁻¹ • x := by
        ext j
        simp [x, y, Fin.init, div_eq_mul_inv, mul_comm]
      calc
        (Matrix.mulVec A (fun j : Fin n ↦ g j.castSucc / g (Fin.last n))) i =
            y⁻¹ * (Matrix.mulVec A x) i := by
              rw [hvisible_scaled, Matrix.mulVec_smul]
              rfl
        _ ≤ y⁻¹ * (y * b i) := hscaled
        _ = b i := by field_simp
    · intro v₁ hv₁ v₂ hv₂ hv_open
      rcases hv_open with ⟨a, c, ha, hc, hac, hv⟩
      let g₁ : Fin (n + 1) → ℝ := y • Fin.snoc v₁ 1
      let g₂ : Fin (n + 1) → ℝ := y • Fin.snoc v₂ 1
      have hg₁_mem : g₁ ∈ polyhedron_le_set (homogenized_polyhedron_matrix A b) 0 := by
        have hmem := (mem_homogenized_polyhedron_cone_iff_general A b (y • v₁) y).2 <| by
          constructor
          · intro i
            have hi := hv₁ i
            simpa [Matrix.mulVec_smul, Pi.smul_apply, mul_comm] using
              mul_le_mul_of_nonneg_left hi hy_pos.le
          · exact hy_pos.le
        convert hmem using 1
        ext i
        cases i using Fin.lastCases with
        | last => simp [g₁]
        | cast i => simp [g₁]
      have hg₂_mem : g₂ ∈ polyhedron_le_set (homogenized_polyhedron_matrix A b) 0 := by
        have hmem := (mem_homogenized_polyhedron_cone_iff_general A b (y • v₂) y).2 <| by
          constructor
          · intro i
            have hi := hv₂ i
            simpa [Matrix.mulVec_smul, Pi.smul_apply, mul_comm] using
              mul_le_mul_of_nonneg_left hi hy_pos.le
          · exact hy_pos.le
        convert hmem using 1
        ext i
        cases i using Fin.lastCases with
        | last => simp [g₂]
        | cast i => simp [g₂]
      have hg_eq : g = y • Fin.snoc (fun i : Fin n ↦ g i.castSucc / y) 1 := by
        ext i
        cases i using Fin.lastCases with
        | last => simp [y]
        | cast i =>
            simp only [Pi.smul_apply, Fin.snoc_castSucc]
            change g i.castSucc = y * (g i.castSucc / y)
            field_simp
      have hg_open : g ∈ openSegment ℝ g₁ g₂ := by
        refine ⟨a, c, ha, hc, hac, ?_⟩
        rw [hg_eq]
        ext i
        cases i using Fin.lastCases with
        | last =>
            simp [g₁, g₂]
            rw [← add_mul, hac, one_mul]
        | cast i =>
            have hi := congrArg (fun z ↦ z i) hv
            simp [g₁, g₂, Pi.smul_apply] at hi ⊢
            rw [← hi]
            ring
      have hg₁_ray :
          g₁ ∈ (PointedCone.hull ℝ ({g} : Set (Fin (n + 1) → ℝ)) :
            Set (Fin (n + 1) → ℝ)) :=
        (isExtremeRayOfCone_iff.mp hg_extreme).isExtreme.left_mem_of_mem_openSegment
          hg₁_mem hg₂_mem hg_ray hg_open
      rcases mem_singletonRayHull_iff.mp hg₁_ray with ⟨μ, hμ, hμg⟩
      have hμ_one : μ = 1 := by
        have hlast := congrArg (fun z ↦ z (Fin.last n)) hμg
        simp [g₁, y] at hlast
        nlinarith
      have hμg_one : g₁ = g := by simpa [hμ_one] using hμg
      ext i
      have hi := congrArg (fun z ↦ z i.castSucc) hμg_one
      dsimp [g₁] at hi
      simp only [Pi.smul_apply, Fin.snoc_castSucc] at hi
      change y * v₁ i = g i.castSucc at hi
      exact (eq_div_iff hy_pos.ne').2 (by simpa [mul_comm] using hi)
  · right
    refine ⟨by simpa [y] using hy_zero.symm, ?_⟩
    have hx_rec : x ∈ recessionCone (polyhedron_le_set A b) := by
      rw [polyhedron_recessionCone_eq_homogeneous_solution_set A b hP_nonempty]
      simpa [← hy_zero] using hg_data.1
    have hg_ne : g ≠ 0 := extremeRay_ne_zero hg_extreme
    have hx_ne : x ≠ 0 := by
      intro hx_zero
      apply hg_ne
      ext i
      cases i using Fin.lastCases with
      | last => simpa [y] using hy_zero.symm
      | cast i => exact congrFun hx_zero i
    rw [isExtremeRayOfCone_iff]
    refine
      { convex := (PointedCone.hull ℝ ({x} : Set (Fin n → ℝ))).convex
        isExtreme := ?_
        finrank_direction_eq_one := singletonRayHullFinrankDirectionEqOneOfNeZero hx_ne }
    refine
      { subset := ?_
        left_mem_of_mem_openSegment := ?_ }
    · intro z hz
      rcases mem_singletonRayHull_iff.mp hz with ⟨μ, hμ, rfl⟩
      exact smul_mem_recessionCone hx_rec hμ
    · intro r₁ hr₁ r₂ hr₂ z hz_ray hz_open
      rcases hz_open with ⟨a, c, ha, hc, hac, hz⟩
      let lift : (Fin n → ℝ) → Fin (n + 1) → ℝ := fun r ↦ Fin.snoc r 0
      have hlift₁ : lift r₁ ∈ polyhedron_le_set (homogenized_polyhedron_matrix A b) 0 := by
        exact (mem_homogenized_polyhedron_cone_iff_general A b r₁ 0).2 <| by
          rw [polyhedron_recessionCone_eq_homogeneous_solution_set A b hP_nonempty] at hr₁
          simpa using hr₁
      have hlift₂ : lift r₂ ∈ polyhedron_le_set (homogenized_polyhedron_matrix A b) 0 := by
        exact (mem_homogenized_polyhedron_cone_iff_general A b r₂ 0).2 <| by
          rw [polyhedron_recessionCone_eq_homogeneous_solution_set A b hP_nonempty] at hr₂
          simpa using hr₂
      have hliftz_ray :
          lift z ∈ (PointedCone.hull ℝ ({g} : Set (Fin (n + 1) → ℝ)) :
            Set (Fin (n + 1) → ℝ)) := by
        rcases mem_singletonRayHull_iff.mp hz_ray with ⟨μ, hμ, rfl⟩
        apply mem_singletonRayHull_iff.mpr
        refine ⟨μ, hμ, ?_⟩
        ext i
        cases i using Fin.lastCases with
        | last =>
            have hheight : g (Fin.last n) = 0 := by simpa [y] using hy_zero.symm
            simp [lift, hheight]
        | cast i => simp [lift, x, Fin.init]
      have hliftz_open : lift z ∈ openSegment ℝ (lift r₁) (lift r₂) := by
        refine ⟨a, c, ha, hc, hac, ?_⟩
        ext i
        cases i using Fin.lastCases with
        | last => simp [lift]
        | cast i =>
            have hi := congrArg (fun w ↦ w i) hz
            simpa [lift, Pi.smul_apply] using hi
      have hlift₁_ray :=
        (isExtremeRayOfCone_iff.mp hg_extreme).isExtreme.left_mem_of_mem_openSegment
          hlift₁ hlift₂ hliftz_ray hliftz_open
      rcases mem_singletonRayHull_iff.mp hlift₁_ray with ⟨μ, hμ, hμg⟩
      apply mem_singletonRayHull_iff.mpr
      refine ⟨μ, hμ, ?_⟩
      ext i
      have hi := congrArg (fun w ↦ w i.castSucc) hμg
      simpa [lift, x, Fin.init, Pi.smul_apply] using hi

/-- Helper for Theorem 3.37: a nonempty pointed polyhedron is generated by its extreme points
and the extreme rays of its recession cone. -/
lemma pointedPolyhedron_subset_convexHull_extremePoints_add_cone_extremeRays
    (Q : Set (Fin n → ℝ))
    (hQ_nonempty : Q.Nonempty)
    (hQ_polyhedron : is_polyhedron Q)
    (hQ_pointed : is_pointed Q) :
    Q ⊆ convexHull ℝ (Q.extremePoints ℝ) +
      cone {d : Fin n → ℝ | IsExtremeRayOfCone (recessionCone Q) d} := by
  rcases hQ_polyhedron with ⟨m, A, b, rfl⟩
  let C : Set (Fin (n + 1) → ℝ) :=
    polyhedron_le_set (homogenized_polyhedron_matrix A b) 0
  have hC_polyhedral : is_polyhedral_cone C := by
    refine (is_polyhedral_cone_iff).2 ?_
    exact ⟨m + 1, homogenized_polyhedron_matrix A b, rfl⟩
  have hC_pointed : is_pointed C := by
    exact homogenizedPolyhedronCone_pointed_of_pointed A b hQ_nonempty hQ_pointed
  rcases existsExtremeRayGeneratingFamilyOfPointedPolyhedralCone C hC_polyhedral hC_pointed with
    ⟨k, gen, hC_gen, hgen_extreme⟩
  let R : Matrix (Fin (n + 1)) (Fin k) ℝ := fun i j ↦ gen j i
  have hC_matrix : C = (matrix_cone R : Set (Fin (n + 1) → ℝ)) := by
    calc
      C = finitely_generated_cone gen := hC_gen
      _ = (matrix_cone R : Set (Fin (n + 1) → ℝ)) := by rfl
  have hgen_mem : ∀ j : Fin k, gen j ∈ C := by
    intro j
    rw [hC_gen]
    exact subset_cone (Set.range gen) (Set.mem_range_self j)
  have hlast_nonneg : ∀ j : Fin k, 0 ≤ R (Fin.last n) j := by
    intro j
    have hj_data :=
      (mem_homogenized_polyhedron_cone_iff_general A b (Fin.init (gen j))
        (gen j (Fin.last n))).mp (by simpa [C] using hgen_mem j)
    simpa [R] using hj_data.2
  intro z hz
  have hz_lift : Fin.snoc z 1 ∈ C := by
    exact (mem_homogenized_polyhedron_cone_iff A b z).2 hz
  have hz_matrix : Fin.snoc z 1 ∈ (matrix_cone R : Set (Fin (n + 1) → ℝ)) := by
    rw [← hC_matrix]
    exact hz_lift
  have hz_split :=
    (mem_slice_one_matrix_cone_iff_mem_convexHull_add_cone_of_nonnegative_heights
      R hlast_nonneg).1 hz_matrix
  let J₁ : Type := {j : Fin k // 0 < R (Fin.last n) j}
  let J₀ : Type := {j : Fin k // R (Fin.last n) j = 0}
  let vertices : J₁ → Fin n → ℝ :=
    fun a i ↦ R i.castSucc a.1 / R (Fin.last n) a.1
  let rays : J₀ → Fin n → ℝ := fun a i ↦ R i.castSucc a.1
  have hvertices_extreme : Set.range vertices ⊆ (polyhedron_le_set A b).extremePoints ℝ := by
    rintro _ ⟨j, rfl⟩
    rcases homogenizedExtremeRay_classification A b hQ_nonempty (hgen_extreme j.1) with
      hpositive | hzero
    · simpa [vertices, R] using hpositive.2
    · exfalso
      exact (ne_of_gt j.2) (by simpa [R] using hzero.1)
  have hrays_extreme :
      Set.range rays ⊆
        {d : Fin n → ℝ | IsExtremeRayOfCone (recessionCone (polyhedron_le_set A b)) d} := by
    rintro _ ⟨j, rfl⟩
    rcases homogenizedExtremeRay_classification A b hQ_nonempty (hgen_extreme j.1) with
      hpositive | hzero
    · exfalso
      have : (0 : ℝ) < 0 := by simpa [R, j.2] using hpositive.1
      linarith
    · simpa [rays, R] using hzero.2
  rcases hz_split with ⟨u, hu, v, hv, huv⟩
  refine Set.mem_add.mpr ⟨u, ?_, v, ?_, huv⟩
  · exact (convexHull_mono hvertices_extreme) hu
  · exact
      (cone_min (hrays_extreme.trans
        (subset_cone {d : Fin n → ℝ |
          IsExtremeRayOfCone (recessionCone (polyhedron_le_set A b)) d}))) hv

end PointedCoreSupport
