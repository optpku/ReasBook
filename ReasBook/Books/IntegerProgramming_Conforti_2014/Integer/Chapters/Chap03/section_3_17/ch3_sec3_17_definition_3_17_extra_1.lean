import IntegerProgramming_Conforti_2014.Integer.Chapters.Chap03.section_3_5_1.ch3_sec3_5_1_theorem_3_11

open scoped Matrix

-- This file reuses the Chapter 3 owners `matrix_cone` and `matrix_polyhedral_cone`.

/-- Definition 3.17-extra-1. A pair of matrices `(A, R)` is an MW-pair when the polyhedral cone
cut out by `A *ᵥ x ≤ 0` agrees with the cone generated by the columns of `R`. -/
def mw_pair {m n k : ℕ} (A : Matrix (Fin m) (Fin n) ℝ) (R : Matrix (Fin n) (Fin k) ℝ) :
    Prop :=
  matrix_polyhedral_cone A = (matrix_cone R : Set (Fin n → ℝ))
