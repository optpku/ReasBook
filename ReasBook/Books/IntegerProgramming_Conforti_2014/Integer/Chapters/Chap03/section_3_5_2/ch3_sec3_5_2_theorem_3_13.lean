open scoped BigOperators Matrix Pointwise

/-!
Semantic note: this file follows the source proof via the homogenized cone in `ℝ^(n+1)`.
The forward direction passes from a polyhedron to a polyhedral cone, applies Theorem 3.11,
and then reads the `y = 1` slice as `convexHull + cone`. The reverse direction lifts a
`convexHull + cone` presentation to a finitely generated cone and descends again.
-/

/-- Helper for Theorem 3.13: the homogeneous matrix whose non-last rows are
`(A_i, -b_i)` and whose last row is `(0, -1)`. -/
def homogenized_polyhedron_matrix
    {m n : ℕ} (A : Matrix (Fin m) (Fin n) ℝ) (b : Fin m → ℝ) :
    Matrix (Fin (m + 1)) (Fin (n + 1)) ℝ :=
  fun i ↦
    Fin.lastCases
      (Fin.snoc (fun _ : Fin n ↦ (0 : ℝ)) (-1))
      (fun i' ↦ Fin.snoc (A i') (-b i'))
      i

/-- Helper for Theorem 3.13: multiplying the homogenized matrix by `(x,y)` produces the
rowwise slacks `A *ᵥ x - y • b` together with the final coordinate `-y`. -/
lemma homogenized_polyhedron_matrix_mulVec_snoc
    {m n : ℕ} (A : Matrix (Fin m) (Fin n) ℝ) (b : Fin m → ℝ)
    (x : Fin n → ℝ) (y : ℝ) :
    homogenized_polyhedron_matrix A b *ᵥ Fin.snoc x y =
      Fin.snoc (fun i ↦ (A *ᵥ x) i - y * b i) (-y) := by
  -- Evaluate the homogenized system row by row.
  ext i
  cases i using Fin.lastCases with
  | last =>
      -- The final row is exactly the constraint `-y ≤ 0`.
      simp [homogenized_polyhedron_matrix, Matrix.mulVec, dotProduct, Fin.sum_univ_castSucc]
  | cast i =>
      -- Each original row becomes `(A_i, -b_i) · (x, y) = (A *ᵥ x)_i - y b_i`.
      simp [homogenized_polyhedron_matrix, Matrix.mulVec, dotProduct, Fin.sum_univ_castSucc,
        sub_eq_add_neg, mul_comm]

/-- Helper for Theorem 3.13: the `y = 1` slice of the homogenized cone is the original
polyhedron. -/
lemma mem_homogenized_polyhedron_cone_iff_general
    {m n : ℕ} (A : Matrix (Fin m) (Fin n) ℝ) (b : Fin m → ℝ)
    (x : Fin n → ℝ) (y : ℝ) :
    Fin.snoc x y ∈ polyhedron_le_set (homogenized_polyhedron_matrix A b) 0 ↔
      (A *ᵥ x ≤ fun i ↦ y * b i) ∧ 0 ≤ y := by
  -- Expand the homogenized inequalities and separate the visible and final coordinates.
  change homogenized_polyhedron_matrix A b *ᵥ Fin.snoc x y ≤ 0 ↔
    (A *ᵥ x ≤ fun i ↦ y * b i) ∧ 0 ≤ y
  rw [homogenized_polyhedron_matrix_mulVec_snoc]
  constructor
  · intro hx
    refine ⟨?_, ?_⟩
    · intro i
      have hi := hx i.castSucc
      exact sub_nonpos.mp (by simpa using hi)
    · have hlast := hx (Fin.last m)
      exact neg_nonpos.mp (by simpa using hlast)
  · rintro ⟨hx, hy⟩
    refine Fin.lastCases ?_ (fun i ↦ ?_)
    · simpa using neg_nonpos.mpr hy
    · have hi := hx i
      simpa using sub_nonpos.mpr hi

/-- Helper for Theorem 3.13: the `y = 1` slice of the homogenized cone is the original
polyhedron. -/
lemma mem_homogenized_polyhedron_cone_iff
    {m n : ℕ} (A : Matrix (Fin m) (Fin n) ℝ) (b : Fin m → ℝ) (x : Fin n → ℝ) :
    Fin.snoc x 1 ∈ polyhedron_le_set (homogenized_polyhedron_matrix A b) 0 ↔
      x ∈ polyhedron_le_set A b := by
  -- Rewrite the homogeneous inequalities and read off the non-last coordinates.
  simpa using
    (mem_homogenized_polyhedron_cone_iff_general A b x (1 : ℝ))

/-- Helper for Theorem 3.13: every matrix column belongs to the cone generated by all columns. -/
lemma matrix_column_mem_matrix_cone
    {n k : ℕ} (R : Matrix (Fin n) (Fin k) ℝ) (j : Fin k) :
    (fun i : Fin n ↦ R i j) ∈ matrix_cone R := by
  -- Select the `j`-th column by the singleton coefficient vector.
  refine mem_matrix_cone_iff.mpr ?_
  refine ⟨Pi.single j 1, ?_, ?_⟩
  · intro t
    by_cases ht : t = j
    · subst ht
      simp [Pi.single]
    · simp [Pi.single, ht]
  · ext i
    exact congrFun (Matrix.mulVec_single_one R j) i

/-- Helper for Theorem 3.13: the pointed-cone hull of a set agrees with the Chapter 3 generated
cone of that set. -/
lemma pointedCone_hull_eq_cone
    {n : ℕ} (S : Set (Fin n → ℝ)) :
    (PointedCone.hull ℝ S : Set (Fin n → ℝ)) = cone S :=
  rfl

/-- Helper for Theorem 3.13: membership in a finitely generated cone is exactly a nonnegative
linear combination of its listed generators. -/
lemma mem_finitely_generated_cone_iff
    {n q : ℕ} {rays : Fin q → Fin n → ℝ} {x : Fin n → ℝ} :
    x ∈ finitely_generated_cone rays ↔
      ∃ μ : Fin q → ℝ, (∀ i : Fin q, 0 ≤ μ i) ∧ x = ∑ i, μ i • rays i := by
  -- Rewrite to the canonical matrix-column cone and unpack its coefficient description.
  rw [show finitely_generated_cone rays =
      (matrix_cone (fun i j ↦ rays j i) : Set (Fin n → ℝ)) by
        calc
          finitely_generated_cone rays = cone (Set.range rays) := rfl
          _ = (PointedCone.hull ℝ (Set.range rays) : Set (Fin n → ℝ)) := by
                symm
                exact pointedCone_hull_eq_cone (Set.range rays)
          _ = (matrix_cone (fun i j ↦ rays j i) : Set (Fin n → ℝ)) := by
                rfl]
  constructor
  · intro hx
    rcases mem_matrix_cone_iff.mp hx with ⟨μ, hμ_nonneg, hmul⟩
    refine ⟨μ, hμ_nonneg, ?_⟩
    ext i
    have hcoord := congrArg (fun z ↦ z i) hmul
    simpa [Matrix.mulVec, dotProduct, Pi.smul_apply, mul_comm] using hcoord.symm
  · rintro ⟨μ, hμ_nonneg, hsum⟩
    refine mem_matrix_cone_iff.mpr ⟨μ, hμ_nonneg, ?_⟩
    ext i
    rw [hsum]
    simp [Matrix.mulVec, dotProduct, Pi.smul_apply, mul_comm]

/-- Helper for Theorem 3.13: the lifted matrix whose first columns are `(v,1)` and whose
remaining columns are `(r,0)`. -/
def lifted_vertex_ray_matrix
    {n p q : ℕ} (v : Fin p → Fin n → ℝ) (rays : Fin q → Fin n → ℝ) :
    Matrix (Fin (n + 1)) (Fin (p + q)) ℝ :=
  let V : Matrix (Fin (n + 1)) (Fin p) ℝ :=
    fun i j ↦ Fin.lastCases (1 : ℝ) (fun i' ↦ v j i') i
  let R : Matrix (Fin (n + 1)) (Fin q) ℝ :=
    fun i j ↦ Fin.lastCases (0 : ℝ) (fun i' ↦ rays j i') i
  (Matrix.fromCols V R).submatrix (Equiv.refl _) finSumFinEquiv.symm

/-- Helper for Theorem 3.13: multiplying the lifted vertex/ray matrix by appended coefficients
recovers the visible-space linear combination and stores the vertex-weight sum in the last
coordinate. -/
lemma lifted_vertex_ray_matrix_mulVec_append
    {n p q : ℕ} (v : Fin p → Fin n → ℝ) (rays : Fin q → Fin n → ℝ)
    (lam : Fin p → ℝ) (mu : Fin q → ℝ) :
    lifted_vertex_ray_matrix v rays *ᵥ Fin.append lam mu =
      Fin.snoc (∑ j, lam j • v j + ∑ j, mu j • rays j) (∑ j, lam j) := by
  -- Reindex the column split back to the block matrix and use `fromCols_mulVec`.
  let V : Matrix (Fin (n + 1)) (Fin p) ℝ :=
    fun i j ↦ Fin.lastCases (1 : ℝ) (fun i' ↦ v j i') i
  let R : Matrix (Fin (n + 1)) (Fin q) ℝ :=
    fun i j ↦ Fin.lastCases (0 : ℝ) (fun i' ↦ rays j i') i
  have happend : Fin.append lam mu ∘ finSumFinEquiv = Sum.elim lam mu := by
    simpa using (Fin.append_comp_sumElim (xs := lam) (ys := mu))
  have hmul :=
    Matrix.submatrix_mulVec_equiv (Matrix.fromCols V R) (Fin.append lam mu)
      (Equiv.refl _) finSumFinEquiv.symm
  calc
    lifted_vertex_ray_matrix v rays *ᵥ Fin.append lam mu
        = Matrix.fromCols V R *ᵥ Sum.elim lam mu := by
          ext i
          have hi := congrFun hmul i
          simpa [lifted_vertex_ray_matrix, V, R, happend] using hi
    _ = V *ᵥ lam + R *ᵥ mu := by
          simp [V, R]
    _ = Fin.snoc (∑ j, lam j • v j + ∑ j, mu j • rays j) (∑ j, lam j) := by
          ext i
          cases i using Fin.lastCases with
          | last =>
              simp [V, R, Matrix.mulVec, dotProduct]
          | cast i =>
              simp [V, R, Matrix.mulVec, dotProduct, mul_comm]

/-- Helper for Theorem 3.13: the `y = 1` slice of a homogeneous system `M *ᵥ z ≤ 0` is the
ordinary polyhedron with coefficient matrix given by the non-last columns and right-hand side
`-M_last`. -/
lemma slice_one_homogeneous_polyhedron_eq_polyhedron
    {m n : ℕ} (M : Matrix (Fin m) (Fin (n + 1)) ℝ) :
    {x : Fin n → ℝ | Fin.snoc x 1 ∈ polyhedron_le_set M 0} =
      polyhedron_le_set (fun i j ↦ M i j.castSucc) (fun i ↦ -M i (Fin.last n)) := by
  ext x
  -- Expand the homogeneous inequalities and isolate the trailing coefficient.
  change M *ᵥ Fin.snoc x 1 ≤ 0 ↔
    (fun i ↦ ∑ j : Fin n, M i j.castSucc * x j) ≤ fun i ↦ -M i (Fin.last n)
  constructor
  · intro hx i
    have hi := hx i
    have hi' :
        M i (Fin.last n) + ∑ x_1 : Fin n, x x_1 * M i x_1.castSucc ≤ 0 := by
      simpa [Matrix.mulVec, dotProduct, Fin.sum_univ_castSucc, add_comm, add_left_comm, add_assoc,
        mul_comm] using hi
    have hi'' : M i (Fin.last n) + ∑ j : Fin n, M i j.castSucc * x j ≤ 0 := by
      simpa [mul_comm] using hi'
    linarith [hi'']
  · intro hx i
    have hi' : ∑ j : Fin n, M i j.castSucc * x j ≤ -M i (Fin.last n) := by
      simpa using hx i
    have hi'' : ∑ x_1 : Fin n, x x_1 * M i x_1.castSucc ≤ -M i (Fin.last n) := by
      simpa [mul_comm] using hi'
    have : M i (Fin.last n) + ∑ x_1 : Fin n, x x_1 * M i x_1.castSucc ≤ 0 := by
      linarith [hi'']
    simpa [Matrix.mulVec, dotProduct, Fin.sum_univ_castSucc, add_comm, add_left_comm, add_assoc,
      mul_comm] using this

/-- Helper for Theorem 3.13: a point belongs to the convex hull of a finite indexed family exactly
when it has nonnegative barycentric coordinates summing to `1`. -/
lemma mem_convexHull_range_iff_exists_barycentric_weights
    {n p : ℕ} {v : Fin p → Fin n → ℝ} {x : Fin n → ℝ} :
    x ∈ convexHull ℝ (Set.range v) ↔
      ∃ lam : Fin p → ℝ, (∀ i : Fin p, 0 ≤ lam i) ∧
        (∑ i, lam i = 1) ∧ x = ∑ i, lam i • v i := by
  constructor
  · intro hx
    -- Convert the finite-support affine-combination witness into full `Fin p` barycentric
    -- coordinates by extending the weights with `0` off the support.
    rw [convexHull_range_eq_exists_affineCombination] at hx
    rcases hx with ⟨s, w, hw_nonneg, hw_sum, hx⟩
    let lam : Fin p → ℝ := Set.indicator (↑s) w
    have hlam_nonneg : 0 ≤ lam := by
      intro j
      by_cases hj : j ∈ s
      · simp [lam, hj, hw_nonneg j hj]
      · simp [lam, hj]
    have hlam_sum : ∑ i : Fin p, lam i = 1 := by
      classical
      have hsum' : ∑ i : Fin p, lam i = s.sum w := by
        simpa [lam] using
          (Finset.sum_indicator_subset w (by simp : s ⊆ Finset.univ))
      rw [hsum']
      exact hw_sum
    have hx' : ∑ i : Fin p, lam i • v i = x := by
      have hsub : s ⊆ Finset.univ := by
        intro i hi
        simp
      have hs :
          s.affineCombination ℝ v w =
            Finset.univ.affineCombination ℝ v lam := by
        classical
        simpa [lam] using
          (Finset.affineCombination_indicator_subset
            (k := ℝ) (w := w) (p := v) hsub)
      calc
        ∑ i : Fin p, lam i • v i = Finset.univ.affineCombination ℝ v lam := by
          symm
          exact Finset.affineCombination_eq_linear_combination Finset.univ v lam hlam_sum
        _ = s.affineCombination ℝ v w := hs.symm
        _ = x := hx
    exact ⟨lam, fun i ↦ hlam_nonneg i, hlam_sum, hx'.symm⟩
  · rintro ⟨lam, hlam_nonneg, hlam_sum, hlamx⟩
    -- Package the full-index barycentric coordinates directly as a convex-hull witness.
    exact
      mem_convexHull_of_exists_fintype lam v hlam_nonneg hlam_sum
        (fun i ↦ Set.mem_range_self i) (by simpa using hlamx.symm)

/-- Helper for Theorem 3.13: the same barycentric-coordinate description works for any finite
index type after reindexing to `Fin`. -/
lemma mem_convexHull_range_iff_exists_barycentric_weights_fintype
    {ι : Type*} [Fintype ι] {n : ℕ} {v : ι → Fin n → ℝ} {x : Fin n → ℝ} :
    x ∈ convexHull ℝ (Set.range v) ↔
      ∃ lam : ι → ℝ, (∀ i : ι, 0 ≤ lam i) ∧
        (∑ i, lam i = 1) ∧ x = ∑ i, lam i • v i := by
  let e : ι ≃ Fin (Fintype.card ι) := Fintype.equivFin ι
  let v' : Fin (Fintype.card ι) → Fin n → ℝ := fun i ↦ v (e.symm i)
  have hrange : Set.range v' = Set.range v := by
    ext y
    constructor
    · rintro ⟨i, rfl⟩
      exact ⟨e.symm i, rfl⟩
    · rintro ⟨i, rfl⟩
      exact ⟨e i, by simp [v']⟩
  constructor
  · intro hx
    have hx' : x ∈ convexHull ℝ (Set.range v') := by
      simpa [v', hrange] using hx
    rcases mem_convexHull_range_iff_exists_barycentric_weights.mp hx' with
      ⟨lam', hlam'_nonneg, hlam'_sum, hrepr⟩
    refine ⟨fun i ↦ lam' (e i), ?_, ?_, ?_⟩
    · intro i
      exact hlam'_nonneg (e i)
    · have hsum_reindex :
          ∑ i : ι, lam' (e i) = ∑ j : Fin (Fintype.card ι), lam' j := by
        exact
          Fintype.sum_equiv e
            (fun i : ι ↦ lam' (e i))
            (fun j : Fin (Fintype.card ι) ↦ lam' j)
            (fun i ↦ rfl)
      exact hsum_reindex.trans hlam'_sum
    · -- Reindex the finite barycentric sum back to the original index type.
      calc
        x = ∑ j : Fin (Fintype.card ι), lam' j • v' j := hrepr
        _ = ∑ i : ι, lam' (e i) • v i := by
              exact
                (Fintype.sum_equiv e
                  (fun i : ι ↦ lam' (e i) • v i)
                  (fun j : Fin (Fintype.card ι) ↦ lam' j • v' j)
                  (fun i ↦ by simp [v'])).symm
  · rintro ⟨lam, hlam_nonneg, hlam_sum, hrepr⟩
    have hx' : x ∈ convexHull ℝ (Set.range v') := by
      refine mem_convexHull_range_iff_exists_barycentric_weights.mpr ?_
      refine ⟨fun j ↦ lam (e.symm j), ?_, ?_, ?_⟩
      · intro j
        exact hlam_nonneg (e.symm j)
      · calc
          ∑ j : Fin (Fintype.card ι), lam (e.symm j) = ∑ i : ι, lam i := by
            exact
              (Fintype.sum_equiv e
                (fun i : ι ↦ lam i)
                (fun j : Fin (Fintype.card ι) ↦ lam (e.symm j))
                (fun i ↦ by simp)).symm
          _ = 1 := hlam_sum
      · -- Reindex the original barycentric sum onto the canonical `Fin` index type.
        calc
          x = ∑ i : ι, lam i • v i := hrepr
          _ = ∑ j : Fin (Fintype.card ι), lam (e.symm j) • v' j := by
                exact
                  Fintype.sum_equiv e
                    (fun i : ι ↦ lam i • v i)
                    (fun j : Fin (Fintype.card ι) ↦ lam (e.symm j) • v' j)
                    (fun i ↦ by simp [v'])
    simpa [v', hrange] using hx'

/-- Helper for Theorem 3.13: a finite nonnegative weighted sum belongs to the cone generated by
the same indexed family. -/
lemma finite_weighted_sum_mem_cone_range
    {ι : Type*} [Fintype ι] {n : ℕ}
    (r : ι → Fin n → ℝ)
    (u : ι → ℝ)
    (hu_nonneg : ∀ i, 0 ≤ u i) :
    (fun t : Fin n ↦ ∑ i : ι, u i * r i t) ∈ cone (Set.range r) := by
  let e : ι ≃ Fin (Fintype.card ι) := Fintype.equivFin ι
  -- Reindex the finite family once so the cone witness uses the canonical `Fin` index type.
  refine (mem_cone_iff).2 ?_
  refine ⟨Fintype.card ι, fun j ↦ r (e.symm j), ?_, ?_⟩
  · intro j
    exact Set.mem_range_self (e.symm j)
  · refine ⟨fun j ↦ u (e.symm j), ?_, ?_⟩
    · intro j
      exact hu_nonneg (e.symm j)
    · ext t
      -- Reindex the coordinate sum along `equivFin` and rewrite scalar multiplication
      -- coordinatewise.
      calc
        (fun t : Fin n ↦ ∑ i : ι, u i * r i t) t = ∑ i : ι, u i * r i t := by
          rfl
        _ = ∑ j : Fin (Fintype.card ι), u (e.symm j) * r (e.symm j) t := by
              exact
                Fintype.sum_equiv e
                  (fun i : ι ↦ u i * r i t)
                  (fun j : Fin (Fintype.card ι) ↦ u (e.symm j) * r (e.symm j) t)
                  (fun i ↦ by simp)
        _ = (∑ j : Fin (Fintype.card ι), u (e.symm j) • r (e.symm j)) t := by
              simp [smul_eq_mul]

/-- Helper for Theorem 3.13: cone membership for a finite indexed family can be written using
nonnegative coefficients on the original index type. -/
lemma mem_cone_range_iff_exists_weights
    {ι : Type*} [Fintype ι] {n : ℕ} {r : ι → Fin n → ℝ} {x : Fin n → ℝ} :
    x ∈ cone (Set.range r) ↔
      ∃ u : ι → ℝ, (∀ i : ι, 0 ≤ u i) ∧ x = ∑ i, u i • r i := by
  let e : ι ≃ Fin (Fintype.card ι) := Fintype.equivFin ι
  let r' : Fin (Fintype.card ι) → Fin n → ℝ := fun i ↦ r (e.symm i)
  have hrange : Set.range r' = Set.range r := by
    ext y
    constructor
    · rintro ⟨i, rfl⟩
      exact ⟨e.symm i, rfl⟩
    · rintro ⟨i, rfl⟩
      exact ⟨e i, by simp [r']⟩
  constructor
  · intro hx
    have hx' : x ∈ finitely_generated_cone r' := by
      simpa [finitely_generated_cone, r', hrange] using hx
    rcases mem_finitely_generated_cone_iff.mp hx' with ⟨u', hu'_nonneg, hrepr⟩
    refine ⟨fun i ↦ u' (e i), ?_, ?_⟩
    · intro i
      exact hu'_nonneg (e i)
    · -- Reindex the finite conic sum back to the original index type.
      calc
        x = ∑ j : Fin (Fintype.card ι), u' j • r' j := hrepr
        _ = ∑ i : ι, u' (e i) • r i := by
              exact
                (Fintype.sum_equiv e
                  (fun i : ι ↦ u' (e i) • r i)
                  (fun j : Fin (Fintype.card ι) ↦ u' j • r' j)
                  (fun i ↦ by simp [r'])).symm
  · rintro ⟨u, hu_nonneg, hrepr⟩
    have hx' : x ∈ finitely_generated_cone r' := by
      refine mem_finitely_generated_cone_iff.mpr ?_
      refine ⟨fun j ↦ u (e.symm j), ?_, ?_⟩
      · intro j
        exact hu_nonneg (e.symm j)
      · -- Reindex the original conic sum onto the canonical `Fin` index type.
        calc
          x = ∑ i : ι, u i • r i := hrepr
          _ = ∑ j : Fin (Fintype.card ι), u (e.symm j) • r' j := by
                exact
                  Fintype.sum_equiv e
                    (fun i : ι ↦ u i • r i)
                    (fun j : Fin (Fintype.card ι) ↦ u (e.symm j) • r' j)
                    (fun i ↦ by simp [r'])
    simpa [finitely_generated_cone, r', hrange] using hx'

/-- Helper for Theorem 3.13: when every generator of `matrix_cone R` has nonnegative last
coordinate, the `y = 1` slice is the Minkowski sum of the convex hull of the normalized
positive-height generators and the cone of the zero-height generators. -/
lemma mem_slice_one_matrix_cone_iff_mem_convexHull_add_cone_of_nonnegative_heights
    {n k : ℕ} (R : Matrix (Fin (n + 1)) (Fin k) ℝ)
    (hlast : ∀ j : Fin k, 0 ≤ R (Fin.last n) j)
    {x : Fin n → ℝ} :
    let J₁ : Type := {j : Fin k // 0 < R (Fin.last n) j}
    let J₀ : Type := {j : Fin k // R (Fin.last n) j = 0}
    let v : J₁ → Fin n → ℝ := fun a i ↦ R i.castSucc a.1 / R (Fin.last n) a.1
    let r : J₀ → Fin n → ℝ := fun b i ↦ R i.castSucc b.1
    Fin.snoc (α := fun _ ↦ ℝ) x (1 : ℝ) ∈ ((matrix_cone R :
      PointedCone ℝ (Fin (n + 1) → ℝ)) : Set _) ↔
      x ∈ convexHull ℝ (Set.range v) + cone (Set.range r) := by
  dsimp
  let J₁ : Type := {j : Fin k // 0 < R (Fin.last n) j}
  let J₀ : Type := {j : Fin k // R (Fin.last n) j = 0}
  let v : J₁ → Fin n → ℝ := fun a i ↦ R i.castSucc a.1 / R (Fin.last n) a.1
  let r : J₀ → Fin n → ℝ := fun b i ↦ R i.castSucc b.1
  constructor
  · intro hx
    rcases mem_matrix_cone_iff.mp hx with ⟨ξ, hξ_nonneg, hξx⟩
    let lam : J₁ → ℝ := fun a ↦ ξ a.1 * R (Fin.last n) a.1
    let μ : J₀ → ℝ := fun b ↦ ξ b.1
    have hlam_nonneg : ∀ a : J₁, 0 ≤ lam a := by
      intro a
      exact mul_nonneg (hξ_nonneg a.1) (hlast a.1)
    have hμ_nonneg : ∀ b : J₀, 0 ≤ μ b := by
      intro b
      exact hξ_nonneg b.1
    have hnot_pos_iff_zero : ∀ j : Fin k, (¬ 0 < R (Fin.last n) j) ↔ R (Fin.last n) j = 0 := by
      intro j
      constructor
      · intro hj
        exact le_antisymm (not_lt.mp hj) (hlast j)
      · intro hj
        simp [hj]
    have hle_iff_zero : ∀ j : Fin k, (R (Fin.last n) j ≤ 0) ↔ R (Fin.last n) j = 0 := by
      intro j
      constructor
      · intro hj
        exact le_antisymm hj (hlast j)
      · intro hj
        simp [hj]
    have hlast_sum :
        (1 : ℝ) = ∑ j : Fin k, ξ j * R (Fin.last n) j := by
      -- The last coordinate of `R *ᵥ ξ` records the total positive height.
      have hcoord := congrFun hξx (Fin.last n)
      simpa [Matrix.mulVec, dotProduct, mul_comm] using hcoord.symm
    have hzero_last :
        Finset.sum (Finset.univ.filter (fun j : Fin k ↦ ¬ 0 < R (Fin.last n) j))
            (fun j : Fin k ↦ ξ j * R (Fin.last n) j) = 0 := by
      refine Finset.sum_eq_zero ?_
      intro j hj
      have hj' : ¬ 0 < R (Fin.last n) j := (Finset.mem_filter.mp hj).2
      have hzero : R (Fin.last n) j = 0 := (hnot_pos_iff_zero j).mp hj'
      simp [hzero]
    have hlam_sum : ∑ a : J₁, lam a = 1 := by
      -- Split the last-coordinate sum into positive-height and zero-height columns.
      have hsplit :
          ∑ j : Fin k, ξ j * R (Fin.last n) j =
            ∑ a : J₁, ξ a.1 * R (Fin.last n) a.1 := by
        calc
          ∑ j : Fin k, ξ j * R (Fin.last n) j
              = Finset.sum (Finset.univ.filter (fun j : Fin k ↦ 0 < R (Fin.last n) j))
                    (fun j : Fin k ↦ ξ j * R (Fin.last n) j)
                  + Finset.sum (Finset.univ.filter (fun j : Fin k ↦ ¬ 0 < R (Fin.last n) j))
                      (fun j : Fin k ↦ ξ j * R (Fin.last n) j) := by
                    symm
                    exact
                      Finset.sum_filter_add_sum_filter_not Finset.univ
                        (fun j : Fin k ↦ 0 < R (Fin.last n) j)
                        (fun j : Fin k ↦ ξ j * R (Fin.last n) j)
          _ = Finset.sum (Finset.univ.filter (fun j : Fin k ↦ 0 < R (Fin.last n) j))
                (fun j : Fin k ↦ ξ j * R (Fin.last n) j) := by
                  rw [hzero_last, add_zero]
          _ = ∑ a : J₁, ξ a.1 * R (Fin.last n) a.1 := by
                simpa [J₁] using
                  (Finset.sum_subtype_eq_sum_filter
                    (s := Finset.univ)
                    (p := fun j : Fin k ↦ 0 < R (Fin.last n) j)
                    (f := fun j : Fin k ↦ ξ j * R (Fin.last n) j)).symm
      have : (1 : ℝ) = ∑ a : J₁, lam a := by
        simpa [lam] using hlast_sum.trans hsplit
      simpa using this.symm
    have hrepr :
        x = ∑ a : J₁, lam a • v a + ∑ b : J₀, μ b • r b := by
      -- Split each visible coordinate into its positive-height and zero-height contributions.
      ext i
      have hcoord : x i = ∑ j : Fin k, ξ j * R i.castSucc j := by
        have hi := congrFun hξx i.castSucc
        simpa [Matrix.mulVec, dotProduct, mul_comm] using hi.symm
      have hpos :
          Finset.sum (Finset.univ.filter (fun j : Fin k ↦ 0 < R (Fin.last n) j))
              (fun j : Fin k ↦ ξ j * R i.castSucc j)
            = ∑ a : J₁, lam a • v a i := by
        calc
          Finset.sum (Finset.univ.filter (fun j : Fin k ↦ 0 < R (Fin.last n) j))
                (fun j : Fin k ↦ ξ j * R i.castSucc j)
              = ∑ a : J₁, ξ a.1 * R i.castSucc a.1 := by
                  simpa [J₁] using
                    (Finset.sum_subtype_eq_sum_filter
                      (s := Finset.univ)
                      (p := fun j : Fin k ↦ 0 < R (Fin.last n) j)
                      (f := fun j : Fin k ↦ ξ j * R i.castSucc j)).symm
          _ = ∑ a : J₁, lam a • v a i := by
                refine Finset.sum_congr rfl ?_
                intro a ha
                have hne : R (Fin.last n) a.1 ≠ 0 := ne_of_gt a.2
                dsimp [lam, v]
                field_simp [hne]
      have hzero :
          Finset.sum (Finset.univ.filter (fun j : Fin k ↦ ¬ 0 < R (Fin.last n) j))
              (fun j : Fin k ↦ ξ j * R i.castSucc j)
            = ∑ b : J₀, μ b • r b i := by
        calc
          Finset.sum (Finset.univ.filter (fun j : Fin k ↦ ¬ 0 < R (Fin.last n) j))
                (fun j : Fin k ↦ ξ j * R i.castSucc j)
              = Finset.sum (Finset.univ.filter (fun j : Fin k ↦ R (Fin.last n) j = 0))
                  (fun j : Fin k ↦ ξ j * R i.castSucc j) := by
                    refine Finset.sum_congr ?_ ?_
                    · ext j
                      simp [hle_iff_zero j]
                    · intro j hj
                      rfl
          _ = ∑ b : J₀, ξ b.1 * R i.castSucc b.1 := by
                simpa [J₀] using
                  (Finset.sum_subtype_eq_sum_filter
                    (s := Finset.univ)
                    (p := fun j : Fin k ↦ R (Fin.last n) j = 0)
                    (f := fun j : Fin k ↦ ξ j * R i.castSucc j)).symm
          _ = ∑ b : J₀, μ b • r b i := by
                refine Finset.sum_congr rfl ?_
                intro b hb
                rfl
      calc
        x i = ∑ j : Fin k, ξ j * R i.castSucc j := hcoord
        _ = Finset.sum (Finset.univ.filter (fun j : Fin k ↦ 0 < R (Fin.last n) j))
              (fun j : Fin k ↦ ξ j * R i.castSucc j)
              + Finset.sum (Finset.univ.filter (fun j : Fin k ↦ ¬ 0 < R (Fin.last n) j))
                  (fun j : Fin k ↦ ξ j * R i.castSucc j) := by
                    symm
                    exact
                      Finset.sum_filter_add_sum_filter_not Finset.univ
                        (fun j : Fin k ↦ 0 < R (Fin.last n) j)
                        (fun j : Fin k ↦ ξ j * R i.castSucc j)
        _ = ∑ a : J₁, lam a • v a i + ∑ b : J₀, μ b • r b i := by
              rw [hpos, hzero]
        _ = (∑ a : J₁, lam a • v a + ∑ b : J₀, μ b • r b) i := by
              simp
    refine ⟨∑ a : J₁, lam a • v a, ?_, ∑ b : J₀, μ b • r b, ?_, ?_⟩
    · -- The positive-height coefficients are barycentric weights on the normalized columns.
      exact
        mem_convexHull_range_iff_exists_barycentric_weights_fintype.mpr
          ⟨lam, hlam_nonneg, hlam_sum, rfl⟩
    · -- The zero-height coefficients give a conic combination of the zero-height columns.
      convert finite_weighted_sum_mem_cone_range r μ hμ_nonneg using 1
      ext t
      simp [smul_eq_mul]
    · simp [hrepr]
  · rintro ⟨xQ, hxQ, xR, hxR, rfl⟩
    rcases mem_convexHull_range_iff_exists_barycentric_weights_fintype.mp hxQ with
      ⟨lam, hlam_nonneg, hlam_sum, hQrepr⟩
    rcases mem_cone_range_iff_exists_weights.mp hxR with ⟨μ, hμ_nonneg, hRrepr⟩
    have hpos_col : ∀ a : J₁, Fin.snoc (α := fun _ ↦ ℝ) (v a) (1 : ℝ) ∈ ((matrix_cone R :
        PointedCone ℝ (Fin (n + 1) → ℝ)) : Set _) := by
      intro a
      have hcol : (fun i : Fin (n + 1) ↦ R i a.1) ∈ ((matrix_cone R :
          PointedCone ℝ (Fin (n + 1) → ℝ)) : Set _) :=
        matrix_column_mem_matrix_cone R a.1
      have hinv_nonneg : 0 ≤ (R (Fin.last n) a.1)⁻¹ := by
        exact inv_nonneg.mpr (hlast a.1)
      have hscaled :
          (R (Fin.last n) a.1)⁻¹ • (fun i : Fin (n + 1) ↦ R i a.1) ∈ ((matrix_cone R :
            PointedCone ℝ (Fin (n + 1) → ℝ)) : Set _) :=
        PointedCone.smul_mem (matrix_cone R) hinv_nonneg hcol
      -- Normalize the positive-height generator so its last coordinate becomes `1`.
      convert hscaled using 1
      ext i
      cases i using Fin.lastCases with
      | last =>
          simp [smul_eq_mul, v, ne_of_gt a.2]
      | cast i =>
          simp [smul_eq_mul, v, div_eq_mul_inv, mul_comm]
    have hzero_col : ∀ b : J₀, Fin.snoc (α := fun _ ↦ ℝ) (r b) (0 : ℝ) ∈ ((matrix_cone R :
        PointedCone ℝ (Fin (n + 1) → ℝ)) : Set _) := by
      intro b
      have hcol : (fun i : Fin (n + 1) ↦ R i b.1) ∈ ((matrix_cone R :
          PointedCone ℝ (Fin (n + 1) → ℝ)) : Set _) :=
        matrix_column_mem_matrix_cone R b.1
      -- Zero-height generators are already ray generators of the slice.
      convert hcol using 1
      ext i
      cases i using Fin.lastCases with
      | last =>
          simp [r, b.2]
      | cast i =>
          simp [r]
    have hQmem :
        Fin.snoc (α := fun _ ↦ ℝ) (∑ a : J₁, lam a • v a) (1 : ℝ) ∈ ((matrix_cone R :
          PointedCone ℝ (Fin (n + 1) → ℝ)) : Set _) := by
      have hsum_mem :
          ∑ a : J₁, lam a • Fin.snoc (v a) (1 : ℝ) ∈ ((matrix_cone R :
            PointedCone ℝ (Fin (n + 1) → ℝ)) : Set _) := by
        exact
          Submodule.sum_mem (matrix_cone R) (fun a _ ↦
            PointedCone.smul_mem (matrix_cone R) (hlam_nonneg a) (hpos_col a))
      have hsum_eq :
          ∑ a : J₁, lam a • Fin.snoc (v a) (1 : ℝ) =
            Fin.snoc (α := fun _ ↦ ℝ) (∑ a : J₁, lam a • v a) (1 : ℝ) := by
        ext i
        cases i using Fin.lastCases with
        | last =>
            simpa [hlam_sum]
        | cast i =>
            simp
      simpa [hsum_eq]
        using hsum_mem
    have hRmem :
        Fin.snoc (α := fun _ ↦ ℝ) (∑ b : J₀, μ b • r b) (0 : ℝ) ∈ ((matrix_cone R :
          PointedCone ℝ (Fin (n + 1) → ℝ)) : Set _) := by
      have hsum_mem :
          ∑ b : J₀, μ b • Fin.snoc (r b) (0 : ℝ) ∈ ((matrix_cone R :
            PointedCone ℝ (Fin (n + 1) → ℝ)) : Set _) := by
        exact
          Submodule.sum_mem (matrix_cone R) (fun b _ ↦
            PointedCone.smul_mem (matrix_cone R) (hμ_nonneg b) (hzero_col b))
      have hsum_eq :
          ∑ b : J₀, μ b • Fin.snoc (r b) (0 : ℝ) =
            Fin.snoc (α := fun _ ↦ ℝ) (∑ b : J₀, μ b • r b) (0 : ℝ) := by
        ext i
        cases i using Fin.lastCases with
        | last =>
            simp
        | cast i =>
            simp
      simpa [hsum_eq]
        using hsum_mem
    have hadd :
        Fin.snoc (α := fun _ ↦ ℝ) (∑ a : J₁, lam a • v a + ∑ b : J₀, μ b • r b) (1 : ℝ) ∈
          ((matrix_cone R : PointedCone ℝ (Fin (n + 1) → ℝ)) : Set _) := by
      have hsum_mem :
          Fin.snoc (α := fun _ ↦ ℝ) (∑ a : J₁, lam a • v a) (1 : ℝ) +
            Fin.snoc (α := fun _ ↦ ℝ) (∑ b : J₀, μ b • r b) (0 : ℝ) ∈ ((matrix_cone R :
              PointedCone ℝ (Fin (n + 1) → ℝ)) : Set _) :=
        Submodule.add_mem (matrix_cone R) hQmem hRmem
      have hsnoc_add :
          Fin.snoc (α := fun _ ↦ ℝ) (∑ a : J₁, lam a • v a) (1 : ℝ) +
              Fin.snoc (α := fun _ ↦ ℝ) (∑ b : J₀, μ b • r b) (0 : ℝ) =
            Fin.snoc (α := fun _ ↦ ℝ)
              (∑ a : J₁, lam a • v a + ∑ b : J₀, μ b • r b) (1 : ℝ) := by
        ext i
        cases i using Fin.lastCases with
        | last =>
            simp
        | cast i =>
            simp
      simpa [hsnoc_add] using hsum_mem
    -- Route correction: rebuild the slice point by summing normalized vertex generators and
    -- zero-height ray generators inside `matrix_cone R`, instead of forcing a global coefficient
    -- vector on all columns.
    simpa [hQrepr, hRrepr]
      using hadd

/-- Helper for Theorem 3.13: splitting an arbitrary coefficient vector across the lifted
vertex-ray matrix yields separate visible-space vertex and ray combinations, while the last
coordinate records the total vertex weight. -/
lemma lifted_vertex_ray_matrix_mulVec_split
    {n p q : ℕ} (v : Fin p → Fin n → ℝ) (rays : Fin q → Fin n → ℝ)
    (ξ : Fin (p + q) → ℝ) :
    let lam : Fin p → ℝ := fun i ↦ ξ (Fin.castAdd q i)
    let μ : Fin q → ℝ := fun j ↦ ξ (Fin.natAdd p j)
    lifted_vertex_ray_matrix v rays *ᵥ ξ =
      Fin.snoc (∑ j, lam j • v j + ∑ j, μ j • rays j) (∑ j, lam j) := by
  let V : Matrix (Fin (n + 1)) (Fin p) ℝ :=
    fun i j ↦ Fin.lastCases (1 : ℝ) (fun i' ↦ v j i') i
  let R : Matrix (Fin (n + 1)) (Fin q) ℝ :=
    fun i j ↦ Fin.lastCases (0 : ℝ) (fun i' ↦ rays j i') i
  let lam : Fin p → ℝ := fun i ↦ ξ (Fin.castAdd q i)
  let μ : Fin q → ℝ := fun j ↦ ξ (Fin.natAdd p j)
  have hmul :=
    Matrix.submatrix_mulVec_equiv (Matrix.fromCols V R) ξ (Equiv.refl _) finSumFinEquiv.symm
  have hleft : (ξ ∘ finSumFinEquiv) ∘ Sum.inl = lam := by
    funext i
    simp [lam]
  have hright : (ξ ∘ finSumFinEquiv) ∘ Sum.inr = μ := by
    funext j
    simp [μ]
  calc
    lifted_vertex_ray_matrix v rays *ᵥ ξ = Matrix.fromCols V R *ᵥ (ξ ∘ finSumFinEquiv) := by
      ext i
      have hi := congrFun hmul i
      simpa [lifted_vertex_ray_matrix, V, R] using hi
    _ = V *ᵥ lam + R *ᵥ μ := by
          rw [Matrix.fromCols_mulVec, hleft, hright]
    _ = Fin.snoc (∑ j, lam j • v j + ∑ j, μ j • rays j) (∑ j, lam j) := by
          ext i
          cases i using Fin.lastCases with
          | last =>
              simp [V, R, Matrix.mulVec, dotProduct, lam, μ]
          | cast i =>
              simp [V, R, Matrix.mulVec, dotProduct, lam, μ, mul_comm]

/-- Helper for Theorem 3.13: the `y = 1` slice of the lifted vertex-ray cone is exactly the
standard explicit `(lam, μ)` presentation with barycentric vertex coefficients and nonnegative ray
coefficients. -/
lemma mem_lifted_vertex_ray_matrix_cone_iff_exists_weights
    {n p q : ℕ}
    {v : Fin p → Fin n → ℝ}
    {rays : Fin q → Fin n → ℝ}
    {x : Fin n → ℝ} :
    Fin.snoc (α := fun _ ↦ ℝ) x (1 : ℝ) ∈ ((matrix_cone (lifted_vertex_ray_matrix v rays) :
        PointedCone ℝ (Fin (n + 1) → ℝ)) : Set _) ↔
      ∃ lam : Fin p → ℝ, ∃ μ : Fin q → ℝ,
        (∀ i : Fin p, 0 ≤ lam i) ∧
        (∀ j : Fin q, 0 ≤ μ j) ∧
        (∑ i, lam i = 1) ∧
        x = ∑ i, lam i • v i + ∑ j, μ j • rays j := by
  constructor
  · intro hx
    -- Split the matrix-cone witness into vertex and ray coordinates using the block structure.
    rcases mem_matrix_cone_iff.mp hx with ⟨ξ, hξ_nonneg, hξx⟩
    let lam : Fin p → ℝ := fun i ↦ ξ (Fin.castAdd q i)
    let μ : Fin q → ℝ := fun j ↦ ξ (Fin.natAdd p j)
    have hsplit := lifted_vertex_ray_matrix_mulVec_split v rays ξ
    rw [hsplit] at hξx
    refine ⟨lam, μ, ?_, ?_, ?_, ?_⟩
    · intro i
      exact hξ_nonneg (Fin.castAdd q i)
    · intro j
      exact hξ_nonneg (Fin.natAdd p j)
    · have hlast := congrFun hξx (Fin.last n)
      simpa [lam, μ] using hlast
    · ext i
      have hi := congrFun hξx i.castSucc
      simpa [lam, μ] using hi.symm
  · rintro ⟨lam, μ, hlam_nonneg, hμ_nonneg, hlam_sum, hrepr⟩
    -- Assemble the explicit coefficients back into the canonical matrix-cone witness.
    let ξ : Fin (p + q) → ℝ := Sum.elim lam μ ∘ finSumFinEquiv.symm
    refine mem_matrix_cone_iff.mpr ⟨ξ, ?_, ?_⟩
    · intro t
      classical
      cases hsplit : finSumFinEquiv.symm t with
      | inl i =>
          simpa [ξ, hsplit] using hlam_nonneg i
      | inr j =>
          simpa [ξ, hsplit] using hμ_nonneg j
    · -- The split lemma reconstructs exactly the prescribed visible and last coordinates.
      simpa [ξ, hlam_sum, hrepr] using lifted_vertex_ray_matrix_mulVec_split v rays ξ

/-- Helper for Theorem 3.13: a Minkowski sum of a finite convex hull and a finitely generated cone
is exactly the `y = 1` slice of the associated lifted vertex-ray cone. -/
lemma mem_polytope_add_finitely_generated_cone_iff_mem_lifted_vertex_ray_matrix_cone
    {n p q : ℕ}
    {v : Fin p → Fin n → ℝ}
    {rays : Fin q → Fin n → ℝ}
    {x : Fin n → ℝ} :
    x ∈ convexHull ℝ (Set.range v) + finitely_generated_cone rays ↔
      Fin.snoc (α := fun _ ↦ ℝ) x (1 : ℝ) ∈ ((matrix_cone (lifted_vertex_ray_matrix v rays) :
        PointedCone ℝ (Fin (n + 1) → ℝ)) : Set _) := by
  constructor
  · rintro ⟨xQ, hxQ, xR, hxR, rfl⟩
    rcases mem_convexHull_range_iff_exists_barycentric_weights.mp hxQ with
      ⟨lam, hlam_nonneg, hlam_sum, hQrepr⟩
    rcases mem_finitely_generated_cone_iff.mp hxR with ⟨μ, hμ_nonneg, hRrepr⟩
    -- Match both summands to the same explicit `(lam, μ)` normal form.
    refine mem_lifted_vertex_ray_matrix_cone_iff_exists_weights.mpr
      ⟨lam, μ, hlam_nonneg, hμ_nonneg, hlam_sum, ?_⟩
    simp [hQrepr, hRrepr]
  · intro hx
    rcases mem_lifted_vertex_ray_matrix_cone_iff_exists_weights.mp hx with
      ⟨lam, μ, hlam_nonneg, hμ_nonneg, hlam_sum, hrepr⟩
    -- Repackage the explicit coefficient witness as a convex-hull point plus a conic point.
    refine ⟨∑ i, lam i • v i, ?_, ∑ j, μ j • rays j, ?_, ?_⟩
    · exact mem_convexHull_range_iff_exists_barycentric_weights.mpr
        ⟨lam, hlam_nonneg, hlam_sum, rfl⟩
    · exact mem_finitely_generated_cone_iff.mpr ⟨μ, hμ_nonneg, rfl⟩
    · simp [hrepr]

/-- Theorem 3.13 (Minkowski-Weyl Theorem [279,348]). A subset `P` of `ℝ^n` is a polyhedron if
and only if `P` is the Minkowski sum of a polytope and a finitely generated cone. -/
theorem is_polyhedron_iff_eq_polytope_add_finitely_generated_cone
    {n : ℕ} {P : Set (Fin n → ℝ)} :
    is_polyhedron P ↔
      ∃ Q : Set (Fin n → ℝ),
        Q.IsPolytope ℝ ∧
        ∃ q : ℕ, ∃ rays : Fin q → Fin n → ℝ,
          P = Q + finitely_generated_cone rays := by
  constructor
  · rintro ⟨m, A, b, rfl⟩
    let C : Set (Fin (n + 1) → ℝ) := polyhedron_le_set (homogenized_polyhedron_matrix A b) 0
    have hC_polyhedral : is_polyhedral_cone C := by
      -- The homogenized system is already homogeneous, so it is a polyhedral cone by definition.
      refine (is_polyhedral_cone_iff).2 ?_
      exact ⟨m + 1, homogenized_polyhedron_matrix A b, rfl⟩
    rcases (finitely_generated_cone_iff_polyhedral_cone.mpr hC_polyhedral) with ⟨k, R, hR⟩
    have hlast_nonneg : ∀ j : Fin k, 0 ≤ R (Fin.last n) j := by
      intro j
      have hj_cone :
          (fun i : Fin (n + 1) ↦ R i j) ∈ ((matrix_cone R :
            PointedCone ℝ (Fin (n + 1) → ℝ)) : Set _) :=
        matrix_column_mem_matrix_cone R j
      have hj_hom : (fun i : Fin (n + 1) ↦ R i j) ∈ C := by
        rw [hR]
        exact hj_cone
      have hj_hom' :
          Fin.snoc (fun i : Fin n ↦ R i.castSucc j) (R (Fin.last n) j) ∈ C := by
        convert hj_hom using 1
        ext i
        cases i using Fin.lastCases with
        | last =>
            simp [Fin.snoc_last]
        | cast i =>
            simp [Fin.snoc_castSucc]
      exact
        (mem_homogenized_polyhedron_cone_iff_general A b
          (fun i : Fin n ↦ R i.castSucc j) (R (Fin.last n) j)).1 hj_hom' |>.2
    let J₁ : Type := {j : Fin k // 0 < R (Fin.last n) j}
    let J₀ : Type := {j : Fin k // R (Fin.last n) j = 0}
    let v : J₁ → Fin n → ℝ := fun a i ↦ R i.castSucc a.1 / R (Fin.last n) a.1
    let r : J₀ → Fin n → ℝ := fun b i ↦ R i.castSucc b.1
    let Q : Set (Fin n → ℝ) := convexHull ℝ (Set.range v)
    let q : ℕ := Fintype.card J₀
    let e : Fin q ≃ J₀ := (Fintype.equivFin J₀).symm
    let rays : Fin q → Fin n → ℝ := fun i ↦ r (e i)
    have hrange_rays : Set.range rays = Set.range r := by
      ext y
      constructor
      · rintro ⟨i, rfl⟩
        exact ⟨e i, rfl⟩
      · rintro ⟨j, rfl⟩
        exact ⟨e.symm j, by simp [rays]⟩
    refine ⟨Q, ?_, q, rays, ?_⟩
    · -- The positive-height normalized generators give a finite vertex set for the slice.
      exact ⟨Set.range v, Set.finite_range v, rfl⟩
    · ext x
      constructor
      · intro hx
        have hx_hom :
            Fin.snoc (α := fun _ ↦ ℝ) x (1 : ℝ) ∈ C := by
          simpa [C] using (mem_homogenized_polyhedron_cone_iff A b x).2 hx
        have hx_matrix :
            Fin.snoc (α := fun _ ↦ ℝ) x (1 : ℝ) ∈ ((matrix_cone R :
              PointedCone ℝ (Fin (n + 1) → ℝ)) : Set _) := by
          simpa [hR] using hx_hom
        have hx_slice : x ∈ Q + cone (Set.range r) := by
          simpa [Q, J₁, J₀, v, r] using
            (mem_slice_one_matrix_cone_iff_mem_convexHull_add_cone_of_nonnegative_heights
              R hlast_nonneg (x := x)).1 hx_matrix
        simpa [Q, finitely_generated_cone, hrange_rays] using hx_slice
      · intro hx
        have hx_slice : x ∈ Q + cone (Set.range r) := by
          simpa [Q, finitely_generated_cone, hrange_rays] using hx
        have hx_matrix :
            Fin.snoc (α := fun _ ↦ ℝ) x (1 : ℝ) ∈ ((matrix_cone R :
              PointedCone ℝ (Fin (n + 1) → ℝ)) : Set _) := by
          simpa [Q, J₁, J₀, v, r] using
            (mem_slice_one_matrix_cone_iff_mem_convexHull_add_cone_of_nonnegative_heights
              R hlast_nonneg (x := x)).2 hx_slice
        have hx_hom :
            Fin.snoc (α := fun _ ↦ ℝ) x (1 : ℝ) ∈ C := by
          simpa [hR] using hx_matrix
        simpa [C] using (mem_homogenized_polyhedron_cone_iff A b x).1 hx_hom
  · rintro ⟨Q, hQ_polytope, q, rays, hP⟩
    rcases hQ_polytope with ⟨V, hV_finite, hQ⟩
    let s : Finset (Fin n → ℝ) := hV_finite.toFinset
    let e : Fin s.card ≃ ↥(s : Set (Fin n → ℝ)) := (Finset.equivFin s).symm
    let v : Fin s.card → Fin n → ℝ := fun i ↦ (e i).1
    have hV_range : Set.range v = V := by
      ext x
      constructor
      · rintro ⟨i, rfl⟩
        simpa [s] using (e i).2
      · intro hx
        have hx' : x ∈ (s : Set (Fin n → ℝ)) := by
          simpa [s] using hx
        refine ⟨e.symm ⟨x, hx'⟩, ?_⟩
        simp [v]
    have hP_lift :
        P = convexHull ℝ (Set.range v) + finitely_generated_cone rays := by
      calc
        P = Q + finitely_generated_cone rays := hP
        _ = convexHull ℝ V + finitely_generated_cone rays := by rw [hQ]
        _ = convexHull ℝ (Set.range v) + finitely_generated_cone rays := by rw [← hV_range]
    let L : Matrix (Fin (n + 1)) (Fin (s.card + q)) ℝ := lifted_vertex_ray_matrix v rays
    have hL_polyhedral :
        is_polyhedral_cone (matrix_cone L : Set (Fin (n + 1) → ℝ)) := by
      exact matrix_cone_is_polyhedral L
    rcases (is_polyhedral_cone_iff.mp hL_polyhedral) with ⟨m, M, hM⟩
    refine (is_polyhedron_iff).2 ?_
    refine ⟨m, fun i j ↦ M i j.castSucc, fun i ↦ -M i (Fin.last n), ?_⟩
    calc
      P = {x : Fin n → ℝ |
            Fin.snoc (α := fun _ ↦ ℝ) x (1 : ℝ) ∈ (matrix_cone L : Set (Fin (n + 1) → ℝ))} := by
            ext x
            simpa [L, hP_lift] using
              (mem_polytope_add_finitely_generated_cone_iff_mem_lifted_vertex_ray_matrix_cone
                (v := v) (rays := rays) (x := x))
      _ = {x : Fin n → ℝ | Fin.snoc x (1 : ℝ) ∈ polyhedron_le_set M 0} := by
            ext x
            rw [hM]
      _ = polyhedron_le_set (fun i j ↦ M i j.castSucc) (fun i ↦ -M i (Fin.last n)) := by
            exact slice_one_homogeneous_polyhedron_eq_polyhedron M
