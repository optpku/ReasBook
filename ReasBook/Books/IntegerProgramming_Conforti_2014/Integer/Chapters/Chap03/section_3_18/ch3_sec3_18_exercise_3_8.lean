open scoped Matrix

-- Semantic search tool `lean_leansearch` was unavailable in this environment; the declarations
-- below were matched against mathlib's canonical `AffineSubspace.affineSpan_coe`,
-- `AffineSubspace.mk'`, `Submodule.toAffineSubspace_direction`, and `Matrix.mulVecLin` APIs.

section AffineSpace

variable {k : Type*} {V : Type*} {P : Type*} [Ring k] [AddCommGroup V] [Module k V]
  [AddTorsor V P]

/-- Exercise 3.8 (1), owner-level form. A subset `s` of an affine space is an affine space if and
only if it is the carrier of an affine subspace. Here "is an affine space" is expressed by `s`
being equal to its affine span. -/
theorem eq_affineSpan_iff_exists_affineSubspace
    (s : Set P) :
    (affineSpan k s : Set P) = s ↔
      ∃ S : AffineSubspace k P, (S : Set P) = s := by
  constructor
  · intro hs
    -- Realize an affine set by the affine subspace generated by the set itself.
    exact ⟨affineSpan k s, hs⟩
  · rintro ⟨S, rfl⟩
    -- The carrier of an affine subspace is unchanged by taking its affine span.
    exact congrArg (fun T : AffineSubspace k P => (T : Set P))
      (AffineSubspace.affineSpan_coe (k := k) S)

/-- Exercise 3.8 (1). A subset `s` of an affine space is an affine space if and only if there is a
linear subspace `L` such that, for every `x⋆ ∈ s`, the set `s` is the translate of `L` by `x⋆`.
Here "is an affine space" is expressed by `s` being equal to its affine span. -/
theorem eq_affineSpan_iff_exists_submodule_eq_point_translate
    (s : Set P) :
    (affineSpan k s : Set P) = s ↔
      ∃ L : Submodule k V,
        ∀ ⦃xStar : P⦄, xStar ∈ s →
          s = (AffineSubspace.mk' xStar L : Set P) := by
  constructor
  · intro hs
    refine ⟨(affineSpan k s).direction, ?_⟩
    intro xStar hxStar
    -- Any point of an affine subspace recovers that subspace from its direction.
    have hxSpan : xStar ∈ affineSpan k s := by
      exact subset_affineSpan k s hxStar
    have hmk :
        AffineSubspace.mk' xStar (affineSpan k s).direction = affineSpan k s :=
      AffineSubspace.mk'_eq hxSpan
    have hmkSet :
        (AffineSubspace.mk' xStar (affineSpan k s).direction : Set P) =
          (affineSpan k s : Set P) :=
      congrArg (fun T : AffineSubspace k P => (T : Set P)) hmk
    calc
      s = (affineSpan k s : Set P) := hs.symm
      _ = (AffineSubspace.mk' xStar (affineSpan k s).direction : Set P) := hmkSet.symm
  · rintro ⟨L, hL⟩
    by_cases hsne : s.Nonempty
    · obtain ⟨xStar, hxStar⟩ := hsne
      have hsEq : s = (AffineSubspace.mk' xStar L : Set P) := hL hxStar
      -- A nonempty translate of a submodule is the carrier of an affine subspace.
      calc
        (affineSpan k s : Set P) =
            (affineSpan k ((AffineSubspace.mk' xStar L : Set P)) : Set P) := by rw [hsEq]
        _ = (AffineSubspace.mk' xStar L : Set P) := by
          exact congrArg (fun T : AffineSubspace k P => (T : Set P))
            (AffineSubspace.affineSpan_coe (k := k) (AffineSubspace.mk' xStar L))
        _ = s := hsEq.symm
    · have hsEmpty : s = ∅ := Set.not_nonempty_iff_eq_empty.mp hsne
      -- The empty set is the bottom affine subspace.
      rw [hsEmpty, AffineSubspace.span_empty, AffineSubspace.bot_coe]

end AffineSpace

section MatrixSolutionSets

variable {K : Type*} [Field K]
variable {n : Type*} [Fintype n]

/-- Helper for Exercise 3.8: a translate of a submodule in `K^n` is the solution set of a finite
linear system obtained from coordinates on the quotient by that submodule. -/
lemma point_translate_submodule_eq_matrix_solution_set
    (L : Submodule K (n → K))
    (xStar : n → K) :
    ∃ m : ℕ, ∃ A : Matrix (Fin m) n K, ∃ b : Fin m → K,
      (AffineSubspace.mk' xStar L : Set (n → K)) = {x : n → K | A *ᵥ x = b} := by
  classical
  let m := Module.finrank K ((n → K) ⧸ L)
  let bQ := Module.finBasis K ((n → K) ⧸ L)
  let ψ : (n → K) →ₗ[K] Fin m → K := bQ.equivFun.toLinearMap.comp L.mkQ
  refine ⟨m, LinearMap.toMatrix' ψ, ψ xStar, ?_⟩
  ext x
  constructor
  · intro hx
    -- Membership in the translate means that the quotient classes of `x` and `xStar` coincide.
    have hmkQ : L.mkQ x = L.mkQ xStar := by
      rw [Submodule.mkQ_apply, Submodule.mkQ_apply, Submodule.Quotient.eq]
      simpa [AffineSubspace.mem_mk'] using hx
    have hψ : ψ x = ψ xStar := by
      change bQ.equivFun (L.mkQ x) = bQ.equivFun (L.mkQ xStar)
      exact congrArg bQ.equivFun hmkQ
    -- Converting the linear map to a matrix keeps the same solution set.
    simpa [ψ] using (LinearMap.toMatrix'_mulVec ψ x).trans hψ
  · intro hx
    -- Equality of coordinates implies equality in the quotient, hence the difference lies in `L`.
    have hψ : ψ x = ψ xStar := by
      simpa [ψ] using (LinearMap.toMatrix'_mulVec ψ x).symm.trans hx
    have hmkQ : L.mkQ x = L.mkQ xStar := by
      exact bQ.equivFun.injective (by simpa [ψ] using hψ)
    have hsub : x - xStar ∈ L := by
      rw [Submodule.mkQ_apply, Submodule.mkQ_apply, Submodule.Quotient.eq] at hmkQ
      simpa using hmkQ
    simpa [AffineSubspace.mem_mk'] using hsub

/-- Helper for Exercise 3.8: once `x⋆` is a solution of `A *ᵥ x = b`, the whole solution set is
the translate of the kernel of the associated linear map by `x⋆`. -/
lemma matrix_solution_set_eq_point_translate_ker_of_mem
    {m : Type*}
    (A : Matrix m n K)
    (b : m → K)
    {xStar : n → K}
    (hxStar : A *ᵥ xStar = b) :
    {x : n → K | A *ᵥ x = b} =
      (AffineSubspace.mk' xStar A.mulVecLin.ker : Set (n → K)) := by
  ext x
  -- Rewrite the affine condition as membership in the kernel after subtracting one solution.
  simp [AffineSubspace.mem_mk', LinearMap.mem_ker, hxStar, Matrix.mulVec_sub, sub_eq_zero]

/-- Exercise 3.8 (2). A subset `s` of `K^n` is an affine space if and only if it is the solution
set of a finite linear system `A *ᵥ x = b`. Here "is an affine space" is expressed by `s` being
equal to its affine span. -/
theorem eq_affineSpan_iff_exists_matrix_eq_solution_set
    (s : Set (n → K)) :
    (affineSpan K s : Set (n → K)) = s ↔
      ∃ m : ℕ, ∃ A : Matrix (Fin m) n K, ∃ b : Fin m → K,
        s = {x : n → K | A *ᵥ x = b} := by
  constructor
  · intro hs
    obtain ⟨L, hL⟩ := (eq_affineSpan_iff_exists_submodule_eq_point_translate (k := K)
      (V := n → K) (P := n → K) s).mp hs
    by_cases hsne : s.Nonempty
    · obtain ⟨xStar, hxStar⟩ := hsne
      have hsEq : s = (AffineSubspace.mk' xStar L : Set (n → K)) := hL hxStar
      obtain ⟨m, A, b, hMatrix⟩ := point_translate_submodule_eq_matrix_solution_set (K := K) L xStar
      -- A nonempty affine set is a translate of a submodule, hence a matrix solution set.
      exact ⟨m, A, b, hsEq.trans hMatrix⟩
    · have hsEmpty : s = ∅ := Set.not_nonempty_iff_eq_empty.mp hsne
      -- The empty affine set is an inconsistent linear system.
      refine ⟨1, 0, fun _ => (1 : K), ?_⟩
      rw [hsEmpty]
      ext x
      constructor
      · intro hx
        cases hx
      · intro hx
        have h0 : (0 : K) = 1 := by
          simpa using congrArg (fun f : Fin 1 → K => f (0 : Fin 1)) hx
        exact zero_ne_one h0
  · rintro ⟨m, A, b, rfl⟩
    by_cases hsol : ∃ xStar : n → K, A *ᵥ xStar = b
    · obtain ⟨xStar, hxStar⟩ := hsol
      have hSet :
          {x : n → K | A *ᵥ x = b} =
            (AffineSubspace.mk' xStar A.mulVecLin.ker : Set (n → K)) :=
        matrix_solution_set_eq_point_translate_ker_of_mem (K := K) A b hxStar
      -- A nonempty solution set is the carrier of an affine subspace.
      calc
        (affineSpan K {x : n → K | A *ᵥ x = b} : Set (n → K)) =
            (affineSpan K ((AffineSubspace.mk' xStar A.mulVecLin.ker : Set (n → K))) :
              Set (n → K)) := by rw [hSet]
        _ = (AffineSubspace.mk' xStar A.mulVecLin.ker : Set (n → K)) := by
          exact congrArg (fun T : AffineSubspace K (n → K) => (T : Set (n → K)))
            (AffineSubspace.affineSpan_coe (k := K) (AffineSubspace.mk' xStar A.mulVecLin.ker))
        _ = {x : n → K | A *ᵥ x = b} := hSet.symm
    · have hEmpty : ({x : n → K | A *ᵥ x = b} : Set (n → K)) = ∅ := by
        ext x
        constructor
        · intro hx
          exact False.elim (hsol ⟨x, hx⟩)
        · intro hx
          cases hx
      -- If the system is inconsistent, its solution set is empty.
      rw [hEmpty, AffineSubspace.span_empty, AffineSubspace.bot_coe]

/-- Exercise 3.8 (3). If `x⋆` is a solution of the linear system `A *ᵥ x = b`, then the full
solution set is the translate of the kernel of `A` by `x⋆`. -/
theorem linear_solution_set_eq_point_translate_ker
    {m : Type*}
    (A : Matrix m n K)
    (b : m → K)
    {xStar : n → K}
    (hxStar : A *ᵥ xStar = b) :
    {x : n → K | A *ᵥ x = b} =
      (AffineSubspace.mk' xStar A.mulVecLin.ker : Set (n → K)) := by
  -- This is exactly the normalization lemma for matrix solution sets.
  simpa using matrix_solution_set_eq_point_translate_ker_of_mem (K := K) A b hxStar

end MatrixSolutionSets

section MatrixSolutionSetDimension

variable {K : Type*} [Field K]
variable {m n : Type*} [Fintype n]

/-- Exercise 3.8 (4). If `x⋆` is a solution of `A *ᵥ x = b`, then the affine dimension of the
solution set equals the dimension of the kernel of `A`. -/
theorem finrank_direction_affineSpan_linear_solution_set_eq_finrank_ker
    (A : Matrix m n K)
    (b : m → K)
    {xStar : n → K}
    (hxStar : A *ᵥ xStar = b) :
    Module.finrank K (affineSpan K {x : n → K | A *ᵥ x = b}).direction =
      Module.finrank K A.mulVecLin.ker := by
  have hAff :
      affineSpan K {x : n → K | A *ᵥ x = b} = AffineSubspace.mk' xStar A.mulVecLin.ker := by
    -- First rewrite the solution set as a translate of the kernel.
    rw [linear_solution_set_eq_point_translate_ker (K := K) A b hxStar]
    exact AffineSubspace.affineSpan_coe (k := K) (AffineSubspace.mk' xStar A.mulVecLin.ker)
  -- The direction of a point-translate is the underlying submodule.
  rw [hAff, AffineSubspace.direction_mk']

end MatrixSolutionSetDimension
