/-- Helper for Proposition 3.15: the pointed-cone hull and the Chapter 3 generated cone define the
same conic set. -/
lemma pointedCone_hull_eq_cone
    {n : ℕ} (S : Set (Fin n → ℝ)) :
    (PointedCone.hull ℝ S : Set (Fin n → ℝ)) = cone S :=
  rfl

/-- Helper for Proposition 3.15: the source-facing generated cone agrees with the canonical
matrix-column cone obtained by placing the rays as columns. -/
lemma finitely_generated_cone_eq_matrix_cone
    {n q : ℕ} (rays : Fin q → Fin n → ℝ) :
    finitely_generated_cone rays =
      (matrix_cone (fun i j ↦ rays j i) : Set (Fin n → ℝ)) := by
  -- Both owners describe the same cone generated by the finite ray family `rays`.
  calc
    finitely_generated_cone rays = cone (Set.range rays) := rfl
    _ = (PointedCone.hull ℝ (Set.range rays) : Set (Fin n → ℝ)) := by
          symm
          exact pointedCone_hull_eq_cone (Set.range rays)
    _ = (matrix_cone (fun i j ↦ rays j i) : Set (Fin n → ℝ)) := by
          rfl

/-- Membership in the cone generated by `rays` is exactly a nonnegative linear combination of
those rays. -/
theorem mem_finitely_generated_cone_iff
    {n q : ℕ} {rays : Fin q → Fin n → ℝ} {x : Fin n → ℝ} :
    x ∈ finitely_generated_cone rays ↔
      ∃ μ : Fin q → ℝ, (∀ i : Fin q, 0 ≤ μ i) ∧ x = ∑ i, μ i • rays i := by
  -- Rewrite to the canonical matrix-column cone and unpack its coefficient description.
  rw [finitely_generated_cone_eq_matrix_cone rays]
  constructor
  · intro hx
    rcases mem_matrix_cone_iff.mp hx with ⟨μ, hμ_nonneg, hmul⟩
    refine ⟨μ, hμ_nonneg, ?_⟩
    ext i
    have hcoord := congrArg (fun v ↦ v i) hmul
    simpa [Matrix.mulVec, dotProduct, Pi.smul_apply, mul_comm] using hcoord.symm
  · rintro ⟨μ, hμ_nonneg, hsum⟩
    refine mem_matrix_cone_iff.mpr ⟨μ, hμ_nonneg, ?_⟩
    ext i
    rw [hsum]
    simp [Matrix.mulVec, dotProduct, Pi.smul_apply, mul_comm]

/-- Helper for Proposition 3.15: adjoining one extra generator splits membership into a
nonnegative multiple of the new ray plus a point of the old cone. -/
lemma mem_matrix_cone_cons_iff
    {n q : ℕ} (r : Fin n → ℝ) (rays : Fin q → Fin n → ℝ) {x : Fin n → ℝ} :
    x ∈ (matrix_cone
      (fun i j ↦ ((Fin.cons r rays : Fin (q + 1) → Fin n → ℝ) j) i) : Set (Fin n → ℝ)) ↔
      ∃ a : ℝ, 0 ≤ a ∧
        ∃ y : Fin n → ℝ, y ∈ (matrix_cone (fun i j ↦ rays j i) : Set (Fin n → ℝ)) ∧
          x = a • r + y := by
  -- Route correction: isolate the source proof's one-new-generator decomposition before the
  -- closedness induction, instead of folding the split into the final closure argument.
  rw [← finitely_generated_cone_eq_matrix_cone (Fin.cons r rays)]
  rw [mem_finitely_generated_cone_iff]
  constructor
  · rintro ⟨μ, hμ_nonneg, hsum⟩
    refine ⟨μ 0, hμ_nonneg 0, ∑ i : Fin q, μ i.succ • rays i, ?_, ?_⟩
    · -- The tail coefficients still witness membership in the old cone.
      rw [← finitely_generated_cone_eq_matrix_cone rays]
      refine mem_finitely_generated_cone_iff.mpr ⟨fun i ↦ μ i.succ, ?_, rfl⟩
      intro i
      exact hμ_nonneg i.succ
    · -- Splitting the head coefficient separates the new ray from the old cone part.
      calc
        x = ∑ j : Fin (q + 1), μ j • Fin.cons r rays j := hsum
        _ = μ 0 • r + ∑ i : Fin q, μ i.succ • rays i := by
              rw [Fin.sum_univ_succ]
              simp
  · rintro ⟨a, ha, y, hy, rfl⟩
    rw [← finitely_generated_cone_eq_matrix_cone rays] at hy
    rcases mem_finitely_generated_cone_iff.mp hy with ⟨μ, hμ_nonneg, rfl⟩
    refine ⟨Fin.cons a μ, ?_, ?_⟩
    · -- Reassembling the head coefficient preserves nonnegativity.
      intro j
      cases j using Fin.cases with
      | zero =>
          simpa using ha
      | succ j =>
          simpa using hμ_nonneg j
    · -- The reassembled coefficients recover the desired sum in the larger cone.
      rw [Fin.sum_univ_succ]
      simp

/-- Helper for Proposition 3.15: adding a generator already contained in the cone does not change
the cone. -/
lemma matrix_cone_cons_eq_of_head_mem
    {n q : ℕ} (r : Fin n → ℝ) (rays : Fin q → Fin n → ℝ)
    (hr : r ∈ (matrix_cone (fun i j ↦ rays j i) : Set (Fin n → ℝ))) :
    (matrix_cone
      (fun i j ↦ ((Fin.cons r rays : Fin (q + 1) → Fin n → ℝ) j) i) : Set (Fin n → ℝ)) =
      (matrix_cone (fun i j ↦ rays j i) : Set (Fin n → ℝ)) := by
  ext x
  rw [mem_matrix_cone_cons_iff]
  constructor
  · rintro ⟨a, ha, y, hy, hxy⟩
    -- The old cone is stable under nonnegative scaling of `r` and under addition.
    have har : a • r ∈ (matrix_cone (fun i j ↦ rays j i) : Set (Fin n → ℝ)) :=
      PointedCone.smul_mem (matrix_cone (fun i j ↦ rays j i)) ha hr
    have hsum :
        a • r + y ∈
          ((matrix_cone (fun i j ↦ rays j i)) : PointedCone ℝ (Fin n → ℝ)) :=
      add_mem har hy
    simpa [hxy] using hsum
  · intro hx
    -- The larger cone contains the old cone by taking zero coefficient on the new ray.
    exact ⟨0, le_rfl, x, hx, by simp⟩

/-- Helper for Proposition 3.15: reindexing a finite generating family does not change the matrix
cone. -/
lemma matrix_cone_reindex
    {n q : ℕ} (rays : Fin q → Fin n → ℝ) (e : Fin q ≃ Fin q) :
    (matrix_cone (fun i j ↦ rays (e j) i) : Set (Fin n → ℝ)) =
      (matrix_cone (fun i j ↦ rays j i) : Set (Fin n → ℝ)) := by
  -- Reindexing preserves the source set of generators, hence the generated cone itself.
  rw [← finitely_generated_cone_eq_matrix_cone (fun j ↦ rays (e j))]
  rw [← finitely_generated_cone_eq_matrix_cone rays]
  change cone (Set.range fun j : Fin q ↦ rays (e j)) = cone (Set.range rays)
  congr 1
  ext x
  constructor
  · rintro ⟨j, rfl⟩
    exact ⟨e j, rfl⟩
  · rintro ⟨j, rfl⟩
    exact ⟨e.symm j, by simp⟩

/-- Helper for Proposition 3.15: deleting one generator gives a subcone of the original finite
cone. -/
lemma matrix_cone_delete_subset
    {n q : ℕ} (rays : Fin (q + 1) → Fin n → ℝ) (i : Fin (q + 1)) :
    (matrix_cone (fun a j ↦ rays (i.succAbove j) a) : Set (Fin n → ℝ)) ⊆
      (matrix_cone (fun a j ↦ rays j a) : Set (Fin n → ℝ)) := by
  intro x hx
  rw [← finitely_generated_cone_eq_matrix_cone (fun j : Fin q ↦ rays (i.succAbove j))] at hx
  rw [mem_finitely_generated_cone_iff (rays := fun j : Fin q ↦ rays (i.succAbove j))] at hx
  rcases hx with ⟨μ, hμ_nonneg, hsum⟩
  let ν : Fin (q + 1) → ℝ := Fin.insertNth i (0 : ℝ) μ
  rw [← finitely_generated_cone_eq_matrix_cone rays]
  refine mem_finitely_generated_cone_iff.mpr ⟨ν, ?_, ?_⟩
  · -- Reinsert the deleted generator with zero coefficient.
    intro j
    rcases Fin.eq_self_or_eq_succAbove i j with hji | hji
    · simp [ν, hji]
    · rcases hji with ⟨k, rfl⟩
      simpa [ν] using hμ_nonneg k
  · -- Summing after reinserting the zero coefficient recovers the original point.
    calc
      x = ∑ j : Fin q, μ j • rays (i.succAbove j) := hsum
      _ = 0 • rays i + ∑ j : Fin q, ν (i.succAbove j) • rays (i.succAbove j) := by
            simp [ν]
      _ = ∑ j : Fin (q + 1), ν j • rays j := by
            symm
            simpa [ν] using
              (Fin.sum_univ_succAbove (f := fun j : Fin (q + 1) ↦ ν j • rays j) i)

/-- Helper for Proposition 3.15: if one coefficient in a conic representation vanishes, then the
point already lies in the cone generated by the remaining rays. -/
lemma mem_matrix_cone_delete_of_zero_coeff
    {n q : ℕ} (rays : Fin (q + 1) → Fin n → ℝ)
    {i : Fin (q + 1)} {x : Fin n → ℝ} {μ : Fin (q + 1) → ℝ}
    (hμ_nonneg : ∀ j : Fin (q + 1), 0 ≤ μ j)
    (hμi : μ i = 0)
    (hx : x = ∑ j : Fin (q + 1), μ j • rays j) :
    x ∈ (matrix_cone (fun a j ↦ rays (i.succAbove j) a) : Set (Fin n → ℝ)) := by
  rw [← finitely_generated_cone_eq_matrix_cone (fun j : Fin q ↦ rays (i.succAbove j))]
  refine mem_finitely_generated_cone_iff.mpr ⟨fun j ↦ μ (i.succAbove j), ?_, ?_⟩
  · -- Restricting the witness to the deleted family preserves nonnegativity.
    intro j
    exact hμ_nonneg (i.succAbove j)
  · -- The zero coefficient drops out after splitting the full sum at `i`.
    calc
      x = ∑ j : Fin (q + 1), μ j • rays j := hx
      _ = μ i • rays i + ∑ j : Fin q, μ (i.succAbove j) • rays (i.succAbove j) := by
            simpa using
              (Fin.sum_univ_succAbove (f := fun j : Fin (q + 1) ↦ μ j • rays j) i)
      _ = ∑ j : Fin q, μ (i.succAbove j) • rays (i.succAbove j) := by
            simp [hμi]

/-- Helper for Proposition 3.15: a cone generated by one ray is closed because it is the image of
`[0, ∞)` under scalar multiplication by that ray. -/
lemma isClosed_matrix_cone_singleton
    {n : ℕ} (rays : Fin 1 → Fin n → ℝ) :
    IsClosed
      (((matrix_cone (fun i j ↦ rays j i)) : PointedCone ℝ (Fin n → ℝ)) :
        Set (Fin n → ℝ)) := by
  let r : Fin n → ℝ := rays 0
  have hrays : rays = Fin.cons r Fin.elim0 := by
    ext j i
    fin_cases j
    rfl
  have himage :
      (((matrix_cone (fun i j ↦ rays j i)) : PointedCone ℝ (Fin n → ℝ)) :
        Set (Fin n → ℝ)) =
        (fun a : ℝ ↦ a • r) '' Set.Ici 0 := by
    rw [hrays]
    ext x
    constructor
    · intro hx
      have hx' :
          x ∈ (matrix_cone
            (fun i j ↦ ((Fin.cons r Fin.elim0 : Fin 1 → Fin n → ℝ) j) i) :
              Set (Fin n → ℝ)) := by
        simpa using hx
      rcases mem_matrix_cone_iff.mp hx' with ⟨μ, hμ_nonneg, hsum⟩
      -- Read the unique coefficient directly as the scalar in front of the unique ray.
      refine ⟨μ 0, hμ_nonneg 0, ?_⟩
      ext i
      have hcoord := congrArg (fun v ↦ v i) hsum
      simpa [Matrix.mulVec, dotProduct, Pi.smul_apply, mul_comm] using hcoord
    · rintro ⟨a, ha, rfl⟩
      -- The singleton coefficient family rebuilds the same nonnegative multiple.
      have hx' :
          a • r ∈ (matrix_cone
            (fun i j ↦ ((Fin.cons r Fin.elim0 : Fin 1 → Fin n → ℝ) j) i) :
              Set (Fin n → ℝ)) := by
        refine mem_matrix_cone_iff.mpr ⟨fun _ ↦ a, ?_, ?_⟩
        · intro j
          fin_cases j
          simpa using ha
        · ext i
          simp [Matrix.mulVec, dotProduct, Pi.smul_apply, mul_comm]
      simpa using hx'
  -- Closedness transfers from the closed-map image of the closed ray parameter interval.
  rw [himage]
  exact (isClosedMap_smul_left (𝕜 := ℝ) r) _ isClosed_Ici

/-- Helper for Proposition 3.15: a convex-hull witness for `0` yields a nonnegative affine
relation among the finite ray family. -/
lemma exists_convex_zero_relation_of_mem_convexHull_range
    {n q : ℕ} {rays : Fin (q + 2) → Fin n → ℝ}
    (hzero : (0 : Fin n → ℝ) ∈ convexHull ℝ (Set.range rays)) :
    ∃ w : Fin (q + 2) → ℝ,
      (∀ i : Fin (q + 2), 0 ≤ w i) ∧
        (∑ i : Fin (q + 2), w i = 1) ∧
          ∑ i : Fin (q + 2), w i • rays i = 0 := by
  classical
  -- Extract the source proof's affine-combination witness for `0` and extend it by zero outside
  -- the supporting finite set.
  rw [convexHull_range_eq_exists_affineCombination] at hzero
  rcases hzero with ⟨s, w₀, hw_nonneg, hw_sum, hw_zero⟩
  let w : Fin (q + 2) → ℝ := Set.indicator (↑s) w₀
  have hw_nonneg' : ∀ i : Fin (q + 2), 0 ≤ w i := by
    intro i
    by_cases hi : i ∈ s
    · simp [w, hi, hw_nonneg i hi]
    · simp [w, hi]
  have hw_sum' : ∑ i : Fin (q + 2), w i = 1 := by
    rw [← hw_sum]
    simpa [w] using (Finset.sum_indicator_subset w₀ (by simp : s ⊆ Finset.univ))
  have hw_zero' : ∑ i : Fin (q + 2), w i • rays i = 0 := by
    -- Rewrite the affine combination on `s` as the full-index affine combination for `λ`.
    have hsub : s ⊆ Finset.univ := by simp
    have hs :
        s.affineCombination ℝ rays w₀ =
          Finset.univ.affineCombination ℝ rays w := by
      simpa [w] using
        (Finset.affineCombination_indicator_subset
          (k := ℝ) (w := w₀) (p := rays) (h := hsub))
    calc
      ∑ i : Fin (q + 2), w i • rays i = Finset.univ.affineCombination ℝ rays w := by
            symm
            exact Finset.affineCombination_eq_linear_combination Finset.univ rays w hw_sum'
      _ = s.affineCombination ℝ rays w₀ := hs.symm
      _ = 0 := hw_zero
  exact ⟨w, hw_nonneg', hw_sum', hw_zero'⟩

/-- Helper for Proposition 3.15: finitely generated cones in `ℝ^n` are closed. -/
lemma isClosed_matrix_cone
    {n q : ℕ} (rays : Fin q → Fin n → ℝ) :
    IsClosed
      (((matrix_cone (fun i j ↦ rays j i)) : PointedCone ℝ (Fin n → ℝ)) :
        Set (Fin n → ℝ)) := by
  let C : PointedCone ℝ (Fin n → ℝ) := matrix_cone (fun i j ↦ rays j i)
  have hC_fg : C.FG := by
    -- The matrix-column presentation is already a finite generating family.
    simpa [C] using matrix_cone_is_finitely_generated (fun i j ↦ rays j i)
  have hC_polyhedral : is_polyhedral_cone (C : Set (Fin n → ℝ)) := by
    -- Route correction: convert finite generation directly to the chapter's polyhedral-cone API.
    exact (is_finitely_generated_cone_iff_is_polyhedral_cone).mp hC_fg
  rcases hC_polyhedral with ⟨K, hK_dualfg, hK_eq⟩
  rcases hK_dualfg with ⟨t, ht⟩
  have hK_closed : IsClosed (K : Set (Fin n → ℝ)) := by
    -- A dual cone of a finite set is closed by the standard dual-cone topology theorem.
    simpa [ht] using
      PointedCone.isClosed_dual
        (p := dotProductBilin ℝ ℝ)
        (s := (t : Set (Fin n → ℝ)))
        (fun x ↦ by fun_prop)
  -- Transfer closedness back along the polyhedral-cone identification.
  simpa [C] using hK_eq ▸ hK_closed

/-- Helper for Proposition 3.15: finitely generated cones in `ℝ^n` are closed. -/
lemma isClosed_finitely_generated_cone
    {n q : ℕ} (rays : Fin q → Fin n → ℝ) :
    IsClosed (finitely_generated_cone rays) := by
  -- Transfer closedness from the canonical matrix-column cone back to the source-facing cone.
  rw [finitely_generated_cone_eq_matrix_cone rays]
  exact isClosed_matrix_cone rays

/-- Helper for Proposition 3.15: a finitely generated cone is closed under adding a nonnegative
multiple of another cone element. -/
lemma finitely_generated_cone_add_smul_mem
    {n q : ℕ} (rays : Fin q → Fin n → ℝ)
    {y r : Fin n → ℝ}
    (hy : y ∈ finitely_generated_cone rays)
    (hr : r ∈ finitely_generated_cone rays)
    {a : ℝ} (ha : 0 ≤ a) :
    y + a • r ∈ finitely_generated_cone rays := by
  -- Expand both cone memberships into nonnegative coefficient families.
  rcases (mem_finitely_generated_cone_iff.mp hy) with ⟨μ, hμ_nonneg, rfl⟩
  rcases (mem_finitely_generated_cone_iff.mp hr) with ⟨ν, hν_nonneg, rfl⟩
  refine mem_finitely_generated_cone_iff.mpr ⟨fun i ↦ μ i + a * ν i, ?_, ?_⟩
  · -- The updated coefficients remain nonnegative.
    intro i
    exact add_nonneg (hμ_nonneg i) (mul_nonneg ha (hν_nonneg i))
  · -- Distribute the new coefficients across the generating rays.
    calc
      (∑ i, μ i • rays i) + a • ∑ i, ν i • rays i
          = (∑ i, μ i • rays i) + ∑ i, (a * ν i) • rays i := by
            congr 1
            rw [Finset.smul_sum]
            apply Finset.sum_congr rfl
            intro i hi
            rw [smul_smul]
      _ = ∑ i, (μ i • rays i + (a * ν i) • rays i) := by
            rw [← Finset.sum_add_distrib]
      _ = ∑ i, (μ i + a * ν i) • rays i := by
            apply Finset.sum_congr rfl
            intro i hi
            rw [add_smul]

/-- Proposition 3.15 (1). For a nonempty polyhedron `P = {x | A *ᵥ x ≤ b}`, its recession cone is
exactly the set of vectors `r` satisfying `A *ᵥ r ≤ 0`. -/
theorem polyhedron_recessionCone_eq_homogeneous_solution_set
    {m n : ℕ}
    (A : Matrix (Fin m) (Fin n) ℝ)
    (b : Fin m → ℝ)
    (h_nonempty : Set.Nonempty (polyhedron_le_set A b)) :
    recessionCone (polyhedron_le_set A b) = {r : Fin n → ℝ | A *ᵥ r ≤ 0} := by
  ext r
  constructor
  · intro hr
    rw [mem_recessionCone_iff] at hr
    rcases h_nonempty with ⟨x₀, hx₀⟩
    -- First control each row by testing the recession property at a fixed feasible base point.
    change A *ᵥ r ≤ 0
    intro i
    by_contra h_not_le
    have hpos : 0 < (A *ᵥ r) i := lt_of_not_ge h_not_le
    let a : ℝ := (b i - (A *ᵥ x₀) i + 1) / (A *ᵥ r) i
    have hx₀_le : (A *ᵥ x₀) i ≤ b i := hx₀ i
    have ha_nonneg : 0 ≤ a := by
      dsimp [a]
      refine div_nonneg ?_ hpos.le
      linarith
    have hxa : x₀ + a • r ∈ polyhedron_le_set A b := hr hx₀ a ha_nonneg
    have hrow : (A *ᵥ x₀) i + a * (A *ᵥ r) i ≤ b i := by
      simpa [polyhedron_le_set, Matrix.mulVec_add, Matrix.mulVec_smul] using hxa i
    have ha_mul : a * (A *ᵥ r) i = b i - (A *ᵥ x₀) i + 1 := by
      dsimp [a]
      field_simp [hpos.ne']
    linarith
  · intro hr
    rw [mem_recessionCone_iff]
    intro x hx a ha
    -- Conversely, homogeneous feasibility keeps every feasible point feasible after translation.
    change A *ᵥ (x + a • r) ≤ b
    intro i
    have hx_le : (A *ᵥ x) i ≤ b i := hx i
    have hr_le : (A *ᵥ r) i ≤ 0 := hr i
    have hmul : a * (A *ᵥ r) i ≤ 0 := mul_nonpos_of_nonneg_of_nonpos ha hr_le
    have hsum : (A *ᵥ x) i + a * (A *ᵥ r) i ≤ b i := by
      linarith
    simpa [Matrix.mulVec_add, Matrix.mulVec_smul] using hsum

/-- Proposition 3.15 (2). If the nonempty polyhedron `P = {x | A *ᵥ x ≤ b}` is also represented as
`convexHull ℝ (Set.range vertices) + finitely_generated_cone rays`, then its recession cone is the
cone generated by the rays in that representation. -/
theorem polyhedron_recessionCone_eq_finitely_generated_cone
    {m n p q : ℕ}
    (A : Matrix (Fin m) (Fin n) ℝ)
    (b : Fin m → ℝ)
    (vertices : Fin p → Fin n → ℝ)
    (rays : Fin q → Fin n → ℝ)
    (h_nonempty : Set.Nonempty (polyhedron_le_set A b))
    (h_repr :
      polyhedron_le_set A b = convexHull ℝ (Set.range vertices) + finitely_generated_cone rays) :
    recessionCone (polyhedron_le_set A b) = finitely_generated_cone rays := by
  let K : Set (Fin n → ℝ) := convexHull ℝ (Set.range vertices)
  let C : Set (Fin n → ℝ) := finitely_generated_cone rays
  have hK_bounded : Bornology.IsBounded K := by
    -- The convex hull of finitely many vertices is bounded.
    dsimp [K]
    exact (isBounded_convexHull).2 (Set.finite_range vertices).isBounded
  have hC_closed : IsClosed C := by
    -- Closedness is the only remaining cone-side blocker; keep the main source proof intact.
    simpa [C] using isClosed_finitely_generated_cone rays
  have hx0K : ∃ x0 : Fin n → ℝ, x0 ∈ K := by
    -- Extract one point from the bounded convex-hull summand using the nonempty representation.
    rcases h_nonempty with ⟨x, hx⟩
    rw [h_repr] at hx
    rcases Set.mem_add.mp hx with ⟨y, hy, z, hz, hsum⟩
    exact ⟨y, hy⟩
  rcases hx0K with ⟨x0, hx0K⟩
  have hzeroC : (0 : Fin n → ℝ) ∈ C := by
    dsimp [C, finitely_generated_cone]
    exact cone_zero_mem
  have hx0P : x0 ∈ polyhedron_le_set A b := by
    -- The chosen convex-hull point becomes feasible by adding the zero cone element.
    rw [h_repr]
    refine Set.mem_add.mpr ⟨x0, hx0K, 0, hzeroC, ?_⟩
    simp
  ext r
  constructor
  · intro hr
    rw [mem_recessionCone_iff] at hr
    -- Route correction: the reverse inclusion follows the textbook limit argument rather than
    -- trying to unfold the cone directly. We decompose `x0 + (n+1) • r`, normalize the cone part,
    -- and use closedness of `C`.
    have hdecomp :
        ∀ n : ℕ,
          ∃ y z,
            y ∈ K ∧ z ∈ C ∧ y + z = x0 + (((n : ℝ) + 1) • r) := by
      intro n
      have hxnr : x0 + (((n : ℝ) + 1) • r) ∈ polyhedron_le_set A b := by
        exact hr hx0P (((n : ℝ) + 1)) (by positivity)
      rw [h_repr] at hxnr
      rcases Set.mem_add.mp hxnr with ⟨y, hy, z, hz, hsum⟩
      exact ⟨y, z, hy, hz, hsum⟩
    choose y z hyK hzC hsum using hdecomp
    let δ : ℕ → ℝ := fun n ↦ (((n : ℝ) + 1)⁻¹)
    let u : ℕ → Fin n → ℝ := fun n ↦ δ n • z n
    have hδ_nonneg : ∀ n : ℕ, 0 ≤ δ n := by
      intro n
      dsimp [δ]
      positivity
    have hu_mem : ∀ n : ℕ, u n ∈ C := by
      intro n
      -- Normalizing by a positive scalar keeps the cone component inside the cone.
      exact IsCone.smul_mem' (C := C) (hzC n) (hδ_nonneg n)
    have hu_eq :
        ∀ n : ℕ, u n = r + δ n • (x0 - y n) := by
      intro n
      have hscale_ne : ((n : ℝ) + 1) ≠ 0 := by positivity
      have hz_eq : z n = x0 + (((n : ℝ) + 1) • r) - y n := by
        exact (eq_sub_iff_add_eq).2 (by simpa [add_comm] using hsum n)
      calc
        u n = δ n • (x0 + (((n : ℝ) + 1) • r) - y n) := by
          dsimp [u]
          rw [hz_eq]
        _ = δ n • (x0 + (((n : ℝ) + 1) • r)) - δ n • y n := by
          rw [smul_sub]
        _ = (δ n • x0 + δ n • (((n : ℝ) + 1) • r)) - δ n • y n := by
          rw [smul_add]
        _ = (δ n • x0 + r) - δ n • y n := by
          congr 1
          rw [smul_smul, inv_mul_cancel₀ hscale_ne, one_smul]
        _ = r + (δ n • x0 - δ n • y n) := by
          simp [sub_eq_add_neg, add_assoc, add_comm]
        _ = r + δ n • (x0 - y n) := by
          rw [smul_sub]
    have hdiff_bounded : Bornology.IsBounded (Set.range fun n : ℕ ↦ x0 - y n) := by
      -- The error terms stay in the difference of a singleton and the bounded convex hull.
      refine
        (isBounded_sub
          (show Bornology.IsBounded ({x0} : Set (Fin n → ℝ)) from Bornology.isBounded_singleton)
          hK_bounded).subset ?_
      intro v hv
      rcases hv with ⟨n, rfl⟩
      exact Set.sub_mem_sub (by simp) (hyK n)
    have hnorm_bounded :
        Filter.IsBoundedUnder (· ≤ ·) (Filter.atTop : Filter ℕ) (norm ∘ fun n : ℕ ↦ x0 - y n) := by
      obtain ⟨R, hR⟩ := hdiff_bounded.subset_closedBall (0 : Fin n → ℝ)
      refine Filter.isBoundedUnder_of ?_
      refine ⟨R, ?_⟩
      intro k
      have hmem : x0 - y k ∈ Set.range (fun j : ℕ ↦ x0 - y j) := Set.mem_range_self k
      have hball : x0 - y k ∈ Metric.closedBall (0 : Fin n → ℝ) R := hR hmem
      simpa [Metric.mem_closedBall, dist_eq_norm] using hball
    have hδ_tendsto : Filter.Tendsto δ (Filter.atTop : Filter ℕ) (nhds 0) := by
      simpa [δ, one_div] using
        (tendsto_one_div_add_atTop_nhds_zero_nat :
          Filter.Tendsto (fun n : ℕ ↦ 1 / ((n : ℝ) + 1)) (Filter.atTop : Filter ℕ) (nhds 0))
    have herr_tendsto :
        Filter.Tendsto (fun n : ℕ ↦ δ n • (x0 - y n)) (Filter.atTop : Filter ℕ) (nhds 0) :=
      NormedField.tendsto_zero_smul_of_tendsto_zero_of_bounded hδ_tendsto hnorm_bounded
    have hu_tendsto : Filter.Tendsto u (Filter.atTop : Filter ℕ) (nhds r) := by
      -- After normalization, the bounded convex-hull error vanishes.
      have htarget :
          Filter.Tendsto (fun m : ℕ ↦ r + δ m • (x0 - y m)) (Filter.atTop : Filter ℕ) (nhds r) := by
        simpa using (tendsto_const_nhds.add herr_tendsto)
      refine Filter.Tendsto.congr' ?_ htarget
      exact Filter.Eventually.of_forall fun m ↦ (hu_eq m).symm
    -- Closedness of the cone lets the limit point return to the cone.
    exact hC_closed.mem_of_tendsto hu_tendsto (Filter.Eventually.of_forall hu_mem)
  · intro hr
    -- Keep the convex-hull part fixed and absorb the translated ray into the cone summand.
    rw [mem_recessionCone_iff]
    intro x hx a ha
    rw [h_repr] at hx ⊢
    rcases Set.mem_add.mp hx with ⟨y, hy, z, hz, hsum⟩
    have hz' : z + a • r ∈ C := by
      exact finitely_generated_cone_add_smul_mem rays hz hr ha
    refine Set.mem_add.mpr ⟨y, hy, z + a • r, hz', ?_⟩
    simpa [C, add_assoc] using congrArg (fun t ↦ t + a • r) hsum

/-- Proposition 3.15 (3). For a nonempty polyhedron `P = {x | A *ᵥ x ≤ b}`, its lineality space is
exactly the set of vectors `r` satisfying `A *ᵥ r = 0`. -/
theorem polyhedron_linealitySpace_eq_kernel_set
    {m n : ℕ}
    (A : Matrix (Fin m) (Fin n) ℝ)
    (b : Fin m → ℝ)
    (h_nonempty : Set.Nonempty (polyhedron_le_set A b)) :
    linealitySpace (polyhedron_le_set A b) = {r : Fin n → ℝ | A *ᵥ r = 0} := by
  ext r
  constructor
  · intro hr
    rw [mem_linealitySpace_iff] at hr
    let P := polyhedron_le_set A b
    have hrec :=
      polyhedron_recessionCone_eq_homogeneous_solution_set A b h_nonempty
    have hr_pos : r ∈ recessionCone P := by
      rw [mem_recessionCone_iff]
      intro x hx a ha
      exact hr hx a
    have hr_neg : -r ∈ recessionCone P := by
      rw [mem_recessionCone_iff]
      intro x hx a ha
      simpa [smul_neg, neg_smul] using hr hx (-a)
    have hr_le : A *ᵥ r ≤ 0 := by
      rw [hrec] at hr_pos
      exact hr_pos
    have hneg_le : A *ᵥ (-r) ≤ 0 := by
      rw [hrec] at hr_neg
      exact hr_neg
    rw [Matrix.mulVec_neg] at hneg_le
    -- Intersecting the recession cone with its negative forces every row to vanish.
    ext i
    apply le_antisymm
    · exact hr_le i
    · have hnonneg : 0 ≤ (A *ᵥ r) i := by
        exact neg_nonpos.mp (hneg_le i)
      exact hnonneg
  · intro hr
    rw [mem_linealitySpace_iff]
    intro x hx a
    -- Vanishing homogeneous image keeps every translate feasible.
    change A *ᵥ (x + a • r) ≤ b
    intro i
    have hx_le : (A *ᵥ x) i ≤ b i := hx i
    have hr_eq : (A *ᵥ r) i = 0 := by
      simpa using congrArg (fun v ↦ v i) hr
    simpa [Matrix.mulVec_add, Matrix.mulVec_smul, hr_eq] using hx_le
