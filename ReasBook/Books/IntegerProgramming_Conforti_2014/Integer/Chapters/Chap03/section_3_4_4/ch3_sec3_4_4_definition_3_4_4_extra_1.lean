import Mathlib

open scoped BigOperators

-- Domain-style sampling for this refine pass:
-- * source-facing finite conic-combination witness: `IsConicCombination`
-- * core/canonical cone owner: `PointedCone R E`
-- * core generated-cone construction: `PointedCone.hull`
-- * canonical ray relation: `SameRay`
--
-- Primitive data vs. derived API:
-- * primitive source-facing data: finite nonnegative coefficient witnesses
-- * derived/canonical cone owner: `PointedCone.hull`
-- * derived/canonical ray comparison: `SameRay`
--
-- Accordingly, this file keeps the finite-family witness predicates as the source-facing layer and
-- exposes `cone` and `ray` only as thin bridges to the canonical pointed-cone owner.

section ConicCombination

variable {R E : Type*} [Semiring R] [PartialOrder R] [IsOrderedRing R]
variable [AddCommMonoid E] [Module R E]

/-- Definition 3.4.4-extra-1 (1): A vector is a conic combination of a finite family of vectors
when it is a finite nonnegative linear combination of that family. -/
def IsConicCombination (R : Type*) [Semiring R] [PartialOrder R] [IsOrderedRing R]
    {E : Type*} [AddCommMonoid E] [Module R E] {q : ℕ} (x : E) (r : Fin q → E) : Prop :=
  ∃ coeff : Fin q → R, (∀ j, 0 ≤ coeff j) ∧ x = ∑ j, coeff j • r j

/-- A convenient expansion of `IsConicCombination`. -/
theorem isConicCombination_iff {q : ℕ} {x : E} {r : Fin q → E} :
    IsConicCombination R x r ↔
      ∃ coeff : Fin q → R, (∀ j, 0 ≤ coeff j) ∧ x = ∑ j, coeff j • r j :=
  Iff.rfl

namespace PointedCone

/-- Definition 3.4.4-extra-1 (3): in the canonical owner `PointedCone`, every conic combination of
members of the cone stays in the cone. -/
theorem conicCombination_mem {q : ℕ} {C : PointedCone R E} {r : Fin q → E} {x : E}
    (hr : ∀ j, r j ∈ C) (hx : IsConicCombination R x r) :
    x ∈ C := by
  rcases hx with ⟨coeff, hcoeff_nonneg, hsum⟩
  have hterm : ∀ j : Fin q, coeff j • r j ∈ C := by
    intro j
    exact PointedCone.smul_mem C (hcoeff_nonneg j) (hr j)
  have hsum_mem : ∑ j, coeff j • r j ∈ C := by
    exact Submodule.sum_mem C fun j _ ↦ hterm j
  simpa [hsum] using hsum_mem

end PointedCone

/-- Helper for Definition 3.4.4-extra-1: a single nonnegative multiple admits a singleton
conic-combination witness. -/
theorem isConicCombination_singleton {r : E} {a : R} (ha : 0 ≤ a) :
    IsConicCombination R (a • r) ![r] := by
  refine ⟨![a], ?_, ?_⟩
  · intro j
    fin_cases j
    simpa using ha
  · simp

/-- Helper for Definition 3.4.4-extra-1: a two-term nonnegative linear combination is a conic
combination of the corresponding two-element family. -/
theorem isConicCombination_pair {x y : E} {a b : R} (ha : 0 ≤ a) (hb : 0 ≤ b) :
    IsConicCombination R (a • x + b • y) ![x, y] := by
  refine ⟨![a, b], ?_, ?_⟩
  · intro j
    fin_cases j
    · simpa using ha
    · simpa using hb
  · simp [Fin.sum_univ_two]

/-- Helper for Definition 3.4.4-extra-1: nonnegative scaling preserves a conic-combination witness
over the same source family. -/
theorem IsConicCombination.smul {q : ℕ} {x : E} {r : Fin q → E}
    (hx : IsConicCombination R x r) {a : R} (ha : 0 ≤ a) :
    IsConicCombination R (a • x) r := by
  rcases hx with ⟨coeff, hcoeff_nonneg, hsum⟩
  refine ⟨fun j ↦ a * coeff j, ?_, ?_⟩
  · intro j
    exact mul_nonneg ha (hcoeff_nonneg j)
  · calc
      a • x = a • ∑ j, coeff j • r j := by simp [hsum]
      _ = ∑ j, a • (coeff j • r j) := by rw [Finset.smul_sum]
      _ = ∑ j, (a * coeff j) • r j := by
            congr with j
            rw [smul_smul]

end ConicCombination

section Cone

variable {R E : Type*} [Semiring R] [PartialOrder R] [IsOrderedRing R]
variable [AddCommMonoid E] [Module R E]

/-- Definition 3.4.4-extra-1 (2): A set is a cone when it contains `0` and is closed under
nonnegative scalar multiplication. -/
class IsCone (R : Type*) [Semiring R] [PartialOrder R] [IsOrderedRing R]
    {E : Type*} [AddCommMonoid E] [Module R E] (C : Set E) : Prop where
  zero_mem : (0 : E) ∈ C
  smul_mem {x : E} (hx : x ∈ C) {a : R} (ha : 0 ≤ a) : a • x ∈ C

/-- Closure under nonnegative scalar multiplication in a cone. -/
theorem IsCone.smul_mem' {C : Set E} [hC : IsCone R C] {x : E} (hx : x ∈ C) {a : R}
    (ha : 0 ≤ a) :
    a • x ∈ C :=
  hC.smul_mem hx ha

instance (C : PointedCone R E) : IsCone R (C : Set E) where
  zero_mem := Submodule.zero_mem C
  smul_mem {_} hx {_} ha := PointedCone.smul_mem C ha hx

/-- Definition 3.4.4-extra-1 (4): the cone generated by a set is the set of all finite conic
combinations of vectors from that set. This source-facing owner is implemented by the canonical
pointed-cone hull. -/
abbrev cone (R : Type*) [Semiring R] [PartialOrder R] [IsOrderedRing R]
    {E : Type*} [AddCommMonoid E] [Module R E] (S : Set E) : Set E :=
  PointedCone.hull R S

/-- Membership in the generated cone is membership as a conic combination of finitely many source
vectors. -/
theorem mem_cone_iff {S : Set E} {x : E} :
    x ∈ cone R S ↔
      ∃ q : ℕ, ∃ r : Fin q → E, (∀ j, r j ∈ S) ∧ IsConicCombination R x r := by
  constructor
  · intro hx
    change x ∈ PointedCone.hull R S at hx
    rw [PointedCone.mem_hull_set] at hx
    rcases hx with ⟨c, hc_source, hc_nonneg, hsum⟩
    let e : c.support ≃ Fin c.support.card := Finset.equivFin c.support
    refine ⟨c.support.card, fun i ↦ (e.symm i : E), ?_, ?_⟩
    · intro i
      exact hc_source (e.symm i).2
    · refine ⟨fun i ↦ c (e.symm i), ?_, ?_⟩
      · intro i
        exact hc_nonneg _
      · calc
          x = c.sum (fun m r ↦ r • m) := hsum.symm
          _ = ∑ j : c.support, c j • (j : E) := by
                rw [Finsupp.sum, ← Finset.sum_coe_sort c.support]
          _ = ∑ i : Fin c.support.card, c (e.symm i) • (e.symm i : E) := by
                exact
                  Fintype.sum_equiv e
                    (fun j : c.support ↦ c j • (j : E))
                    (fun i : Fin c.support.card ↦ c (e.symm i) • (e.symm i : E))
                    (fun j ↦ by simp)
  · rintro ⟨q, r, hr_source, hxcomb⟩
    change x ∈ PointedCone.hull R S
    exact PointedCone.conicCombination_mem (fun j ↦ PointedCone.subset_hull (hr_source j)) hxcomb

/-- Every source vector belongs to the cone it generates. -/
theorem subset_cone (S : Set E) : S ⊆ cone R S :=
  PointedCone.subset_hull

/-- Helper for Definition 3.4.4-extra-1: the zero vector belongs to every generated cone. -/
theorem cone_zero_mem {S : Set E} : (0 : E) ∈ cone R S := by
  change (0 : E) ∈ PointedCone.hull R S
  exact Submodule.zero_mem _

/-- Helper for Definition 3.4.4-extra-1: a conic combination of vectors already lying in `cone R S`
still lies in `cone R S`. -/
theorem cone_conicCombination_mem {S : Set E} {q : ℕ} {r : Fin q → E} {x : E}
    (hr : ∀ j, r j ∈ cone R S) (hx : IsConicCombination R x r) :
    x ∈ cone R S := by
  change x ∈ PointedCone.hull R S
  exact PointedCone.conicCombination_mem hr hx

/-- Helper for Definition 3.4.4-extra-1: generated cones are closed under nonnegative scaling. -/
theorem cone_smul_mem {S : Set E} {x : E} (hx : x ∈ cone R S) {a : R} (ha : 0 ≤ a) :
    a • x ∈ cone R S := by
  change a • x ∈ PointedCone.hull R S
  exact PointedCone.smul_mem (PointedCone.hull R S) ha hx

/-- Every generated cone is a cone in the textbook sense. -/
instance (S : Set E) : IsCone R (cone R S) := inferInstance

/-- Every generated cone is a convex subset of the ambient module. -/
theorem cone_convex (S : Set E) :
    Convex R (cone R S) := by
  simpa using PointedCone.convex (PointedCone.hull R S)

/-- The generated cone is the least generated cone containing the source set. -/
theorem cone_min {S T : Set E} (hST : S ⊆ cone R T) :
    cone R S ⊆ cone R T := by
  change PointedCone.hull R S ≤ PointedCone.hull R T
  exact Submodule.span_le.2 hST

/-- The textbook convention `cone R ∅ = {0}` is built into the generated-cone definition. -/
theorem cone_empty : cone R (∅ : Set E) = ({0} : Set E) := by
  ext x
  constructor
  · intro hx
    rcases mem_cone_iff.1 hx with ⟨q, r, hr, hxr⟩
    rcases hxr with ⟨coeff, hcoeff, hsum⟩
    have hq : q = 0 := by
      cases q with
      | zero =>
          rfl
      | succ q' =>
          have : r 0 ∈ (∅ : Set E) := hr 0
          simp at this
    subst hq
    simpa using hsum
  · rintro rfl
    exact cone_zero_mem

end Cone

section Ray

variable {R E : Type*} [Semiring R] [PartialOrder R] [IsOrderedRing R]
variable [AddCommMonoid E] [Module R E]

/-- Definition 3.4.4-extra-1 (5): The ray generated by a vector is the cone generated by the
singleton containing that vector. -/
abbrev ray (R : Type*) [Semiring R] [PartialOrder R] [IsOrderedRing R]
    {E : Type*} [AddCommMonoid E] [Module R E] (r : E) : Set E :=
  cone R ({r} : Set E)

/-- Membership in a ray is membership as a nonnegative scalar multiple of its generator. -/
theorem mem_ray_iff {r x : E} :
    x ∈ ray R r ↔ ∃ a : R, 0 ≤ a ∧ x = a • r := by
  constructor
  · intro hx
    rcases mem_cone_iff.1 hx with ⟨q, v, hv_source, hxcomb⟩
    rcases hxcomb with ⟨coeff, hcoeff_nonneg, hsum⟩
    refine ⟨∑ j, coeff j, Finset.sum_nonneg fun j _ ↦ hcoeff_nonneg j, ?_⟩
    calc
      x = ∑ j, coeff j • v j := hsum
      _ = ∑ j, coeff j • r := by
            congr with j
            rw [Set.mem_singleton_iff.mp (hv_source j)]
      _ = (∑ j, coeff j) • r := by rw [Finset.sum_smul]
  · rintro ⟨a, ha, rfl⟩
    refine mem_cone_iff.2 ⟨1, ![r], ?_, isConicCombination_singleton ha⟩
    intro j
    fin_cases j
    simp

/-- Helper for Definition 3.4.4-extra-1: every ray contains the zero vector. -/
theorem ray_zero_mem {r : E} : (0 : E) ∈ ray R r := by
  change (0 : E) ∈ cone R ({r} : Set E)
  exact cone_zero_mem

/-- Helper for Definition 3.4.4-extra-1: every generator belongs to its own ray. -/
theorem ray_self_mem (r : E) : r ∈ ray R r := by
  refine mem_ray_iff.2 ⟨1, zero_le_one, ?_⟩
  simp

/-- Helper for Definition 3.4.4-extra-1: rays are closed under nonnegative scaling. -/
theorem ray_smul_mem {r x : E} (hx : x ∈ ray R r) {a : R} (ha : 0 ≤ a) :
    a • x ∈ ray R r := by
  change a • x ∈ cone R ({r} : Set E)
  exact cone_smul_mem hx ha

/-- Helper for Definition 3.4.4-extra-1: a conic combination of vectors on the same ray still lies
on that ray. -/
theorem ray_conicCombination_mem {q : ℕ} {r : E} {v : Fin q → E} {x : E}
    (hv : ∀ j, v j ∈ ray R r) (hx : IsConicCombination R x v) :
    x ∈ ray R r := by
  change x ∈ cone R ({r} : Set E)
  exact cone_conicCombination_mem hv hx

/-- A ray is the cone generated by the singleton containing its generator. -/
theorem ray_eq_cone_singleton (r : E) :
    ray R r = cone R ({r} : Set E) :=
  rfl

end Ray

section SameRayBridge

variable {R E : Type*}

/-- A witness that one vector is a positive scalar multiple of another. -/
def PositiveScalarMultiple (R : Type*) [Preorder R] [Zero R] {E : Type*} [SMul R E]
    (r r' : E) : Prop :=
  ∃ a : R, 0 < a ∧ r = a • r'

/-- A convenient expansion of `PositiveScalarMultiple`. -/
theorem positiveScalarMultiple_iff [Preorder R] [Zero R] [SMul R E] {r r' : E} :
    PositiveScalarMultiple R r r' ↔ ∃ a : R, 0 < a ∧ r = a • r' :=
  Iff.rfl

/-- Definition 3.4.4-extra-1 (6): Two ray generators are distinct when neither is a positive scalar
multiple of the other. -/
def DistinctRays (R : Type*) [Preorder R] [Zero R] {E : Type*} [SMul R E] (r r' : E) : Prop :=
  ¬ PositiveScalarMultiple R r r' ∧ ¬ PositiveScalarMultiple R r' r

/-- `DistinctRays` matches the source wording in terms of positive scalar multiples. -/
theorem distinctRays_iff_not_positiveScalarMultiple [Preorder R] [Zero R] [SMul R E] {r r' : E} :
    DistinctRays R r r' ↔
      ¬ PositiveScalarMultiple R r r' ∧ ¬ PositiveScalarMultiple R r' r :=
  Iff.rfl

variable [Field R] [LinearOrder R] [IsStrictOrderedRing R]
variable [AddCommGroup E] [Module R E]

/-- Helper for Definition 3.4.4-extra-1: for nonzero vectors, being a positive scalar multiple is
equivalent to lying on the same mathlib ray. -/
theorem positiveScalarMultiple_iff_sameRay {r r' : E} (hr : r ≠ 0) (hr' : r' ≠ 0) :
    PositiveScalarMultiple R r r' ↔ SameRay R r r' := by
  simp [PositiveScalarMultiple, exists_pos_right_iff_sameRay hr hr']

/-- For nonzero vectors, distinct ray generators are exactly vectors that are not on the same ray in
the sense of mathlib's `SameRay`. -/
theorem distinctRays_iff_not_sameRay {r r' : E} (hr : r ≠ 0) (hr' : r' ≠ 0) :
    DistinctRays R r r' ↔ ¬ SameRay R r r' := by
  simp [DistinctRays, positiveScalarMultiple_iff_sameRay hr hr',
    positiveScalarMultiple_iff_sameRay hr' hr, SameRay.sameRay_comm]

end SameRayBridge

/- In the real-vector-space chapter, the source-facing owners are used with the default scalar
`ℝ`; the raw owners remain available as `_root_.IsConicCombination`, `_root_.IsCone`,
`_root_.cone`, `_root_.ray`, `_root_.PositiveScalarMultiple`, and `_root_.DistinctRays`. -/
notation "IsConicCombination" => _root_.IsConicCombination ℝ
notation "IsCone" => _root_.IsCone ℝ
notation "cone" => _root_.cone ℝ
notation "ray" => _root_.ray ℝ
notation "PositiveScalarMultiple" => _root_.PositiveScalarMultiple ℝ
notation "DistinctRays" => _root_.DistinctRays ℝ
