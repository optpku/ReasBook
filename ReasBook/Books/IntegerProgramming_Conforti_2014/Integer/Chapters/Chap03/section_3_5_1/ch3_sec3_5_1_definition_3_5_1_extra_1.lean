import Mathlib

/-!
Definition 3.5.1-extra-1 lies in the pointed-cone / finitely-generated-cone domain.

Domain-style sampling for this refine pass:
* mathlib owner abstraction: `PointedCone.hull`
* mathlib membership API: `PointedCone.mem_hull_set`
* mathlib finite-generation owner: `Submodule.FG`, used on `PointedCone` since
  `PointedCone R E` is canonically a submodule over nonnegative scalars
* mathlib finite-family API: `Submodule.fg_iff_exists_fin_generating_family`

The source-facing matrix presentation below is therefore kept only as a bridge to the canonical
owner `C.FG`.
-/

open scoped Matrix

/- Definition 3.5.1-extra-1. The canonical owner for finitely generated pointed cones is
`Submodule.FG`, specialized to `PointedCone ℝ (Fin n → ℝ)`. -/
section

variable {n : ℕ}

#check (Submodule.FG : PointedCone ℝ (Fin n → ℝ) → Prop)

end

/-- The cone generated by the columns of a real matrix. -/
abbrev matrix_cone {n k : ℕ} (R : Matrix (Fin n) (Fin k) ℝ) : PointedCone ℝ (Fin n → ℝ) :=
  PointedCone.hull ℝ (Set.range Rᵀ)

/-- Membership in `matrix_cone R` is equivalent to being a nonnegative linear combination of the
columns of `R`. -/
theorem mem_matrix_cone_iff {n k : ℕ} {R : Matrix (Fin n) (Fin k) ℝ} {x : Fin n → ℝ} :
    x ∈ matrix_cone R ↔ ∃ μ : Fin k → ℝ, 0 ≤ μ ∧ R *ᵥ μ = x := by
  rw [matrix_cone, PointedCone.hull]
  change x ∈ Submodule.span NNReal (Set.range Rᵀ) ↔
    ∃ μ : Fin k → ℝ, 0 ≤ μ ∧ R *ᵥ μ = x
  have hspan :
      x ∈ Submodule.span NNReal (Set.range Rᵀ) ↔
        ∃ μ : Fin k → NNReal, ∑ j, μ j • Rᵀ j = x :=
    Submodule.mem_span_range_iff_exists_fun NNReal
  constructor
  · intro hx
    rcases hspan.mp hx with ⟨μ, hμx⟩
    refine ⟨fun j ↦ μ j, fun j ↦ (μ j).2, ?_⟩
    ext i
    calc
      (R *ᵥ fun j ↦ μ j) i = ∑ j : Fin k, (μ j : ℝ) • R i j := by
        simp [Matrix.mulVec, dotProduct, smul_eq_mul, mul_comm]
      _ = x i := by
        simpa [Matrix.transpose_apply, Pi.smul_apply] using congrFun hμx i
  · rintro ⟨μ, hμ_nonneg, hμx⟩
    refine hspan.mpr ⟨fun j ↦ ⟨μ j, hμ_nonneg j⟩, ?_⟩
    ext i
    calc
      (∑ j : Fin k, (⟨μ j, hμ_nonneg j⟩ : NNReal) • Rᵀ j) i
          = ∑ j : Fin k, μ j • R i j := by
              simp [Matrix.transpose_apply, Pi.smul_apply]
      _ = x i := by
          simpa [Matrix.mulVec, dotProduct, smul_eq_mul, mul_comm] using congrFun hμx i

/-- Definition 3.5.1-extra-1, source-facing matrix form: a pointed cone in `ℝ^n` is finitely
generated exactly when it is the cone generated by the columns of some real matrix. -/
theorem fg_iff_exists_matrix_cone {n : ℕ} {C : PointedCone ℝ (Fin n → ℝ)} :
    C.FG ↔ ∃ k : ℕ, ∃ R : Matrix (Fin n) (Fin k) ℝ, C = matrix_cone R := by
  rw [Submodule.fg_iff_exists_fin_generating_family]
  constructor
  · rintro ⟨k, s, hs⟩
    refine ⟨k, fun i j ↦ s j i, ?_⟩
    simpa [matrix_cone, PointedCone.hull] using hs.symm
  · rintro ⟨k, R, rfl⟩
    refine ⟨k, Rᵀ, ?_⟩
    rfl

/-- Any cone generated by finitely many matrix columns is finitely generated. -/
theorem matrix_cone_is_finitely_generated {n k : ℕ}
    (R : Matrix (Fin n) (Fin k) ℝ) :
    (matrix_cone R).FG := by
  exact (fg_iff_exists_matrix_cone).2 ⟨k, R, rfl⟩
