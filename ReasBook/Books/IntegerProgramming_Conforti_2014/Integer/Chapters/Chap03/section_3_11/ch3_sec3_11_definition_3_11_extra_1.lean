import IntegerProgramming_Conforti_2014.Integer.Chapters.Chap03.section_3_5.ch3_sec3_5_definition_3_5_extra_1

-- This file keeps the set-level edge/extreme-ray predicates as compatibility helpers, while the
-- labeled source-facing API adds the missing pointed/polyhedral hypotheses from Section 3.11.

open scoped BigOperators

universe u

-- Semantic recall note: `lean_leansearch` only surfaced generic ray/cone owners (`SameRay`,
-- pointed-cone structures), so this repair keeps the local helper API and adds explicit
-- source-facing wrappers for pointed polyhedral cones and pointed nonempty polyhedra.
variable {E : Type u} [AddCommGroup E] [Module ℝ E]

/-- Helper: an edge of `P` is a one-dimensional convex extreme subset of `P`. -/
@[mk_iff]
class IsEdgeOf (P F : Set E) : Prop where
  /-- The carrier of an edge is convex. -/
  convex : Convex ℝ F
  /-- The subset `F` is extreme in `P`. -/
  isExtreme : IsExtreme ℝ P F
  /-- The direction of the affine span of `F` is one-dimensional. -/
  finrank_direction_eq_one : Module.finrank ℝ (affineSpan ℝ F).direction = 1

/-- An edge is, in particular, an extreme subset. -/
instance instIsExtremeOfIsEdgeOf {P F : Set E} [h : IsEdgeOf P F] : IsExtreme ℝ P F :=
  h.isExtreme

/-- Helper: the set-level predicate that the half-line generated by `r` is an edge of `C`. -/
def IsExtremeRayOfCone (C : Set E) (r : E) : Prop :=
  IsEdgeOf C (PointedCone.hull ℝ ({r} : Set E) : Set E)

/-- Unfolding lemma for the helper predicate `IsExtremeRayOfCone`. -/
theorem isExtremeRayOfCone_iff {C : Set E} {r : E} :
    IsExtremeRayOfCone C r ↔
      IsEdgeOf C (PointedCone.hull ℝ ({r} : Set E) : Set E) := by
  -- This is the definitional expansion of the set-level extreme-ray predicate.
  rfl

/-- Helper for Definition 3.11-extra-1: membership in the singleton pointed-cone hull is exactly
being a nonnegative scalar multiple of the generator. -/
lemma mem_singletonRayHull_iff {r x : E} :
    x ∈ (PointedCone.hull ℝ ({r} : Set E) : Set E) ↔
      ∃ μ : ℝ, 0 ≤ μ ∧ x = μ • r := by
  -- Interpret the pointed-cone hull as a span over the nonnegative real scalars.
  constructor
  · intro hx
    rcases Submodule.mem_span_singleton.mp hx with ⟨μ, hμ⟩
    exact ⟨μ, μ.property, hμ.symm⟩
  · rintro ⟨μ, hμ, rfl⟩
    exact Submodule.mem_span_singleton.mpr ⟨⟨μ, hμ⟩, rfl⟩

/-- Helper for Definition 3.11-extra-1: the singleton pointed-cone hull generated by `0` is
exactly `{0}`. -/
lemma singletonRayHullZero :
    (PointedCone.hull ℝ ({(0 : E)} : Set E) : Set E) = ({0} : Set E) := by
  ext x
  rw [mem_singletonRayHull_iff]
  -- Every scalar multiple of zero is zero, and zero has the coefficient zero.
  constructor
  · rintro ⟨μ, _, rfl⟩
    simp
  · intro hx
    rcases Set.mem_singleton_iff.mp hx with rfl
    have hzero_smul : (0 : E) = (0 : ℝ) • 0 := by
      simp
    exact ⟨0, le_rfl, hzero_smul⟩

/-- Helper for Definition 3.11-extra-1: an extreme-ray generator of a cone cannot be zero. -/
lemma extremeRay_ne_zero {C : Set E} {r : E} (hr : IsExtremeRayOfCone C r) :
    r ≠ 0 := by
  intro hr_zero
  have hzero_edge : IsEdgeOf C ({0} : Set E) := by
    simpa only [IsExtremeRayOfCone, hr_zero, singletonRayHullZero] using hr
  -- A singleton has zero-dimensional affine direction, contradicting the edge dimension.
  have hdim_zero : Module.finrank ℝ (affineSpan ℝ ({0} : Set E)).direction = 0 := by
    rw [direction_affineSpan, vectorSpan_singleton]
    simp
  have hdim_one : Module.finrank ℝ (affineSpan ℝ ({0} : Set E)).direction = 1 :=
    hzero_edge.finrank_direction_eq_one
  rw [hdim_zero] at hdim_one
  exact Nat.zero_ne_one hdim_one

/-- Helper for Definition 3.11-extra-1: nonzero same-ray generators define the same singleton
pointed-cone hull. -/
lemma singletonRayHull_eq_of_sameRay_of_nonzero {r r' : E}
    (hr_ne : r ≠ 0) (hr'_ne : r' ≠ 0) (hsame : SameRay ℝ r r') :
    (PointedCone.hull ℝ ({r} : Set E) : Set E) =
      (PointedCone.hull ℝ ({r'} : Set E) : Set E) := by
  rcases hsame.exists_nonneg_right hr'_ne with ⟨a, ha, hra⟩
  rcases hsame.exists_nonneg_left hr_ne with ⟨b, hb, hrb⟩
  ext x
  rw [mem_singletonRayHull_iff, mem_singletonRayHull_iff]
  -- Transport a nonnegative multiple through each of the two ray parametrizations.
  constructor
  · rintro ⟨μ, hμ, rfl⟩
    refine ⟨μ * a, mul_nonneg hμ ha, ?_⟩
    rw [hra, smul_smul]
  · rintro ⟨μ, hμ, rfl⟩
    refine ⟨μ * b, mul_nonneg hμ hb, ?_⟩
    rw [← hrb, smul_smul]

/-- Helper for Definition 3.11-extra-1: extreme-rayhood is preserved when the generator is replaced
by another nonzero vector on the same ray. -/
lemma isExtremeRayOfCone_of_sameRay {C : Set E} {r r' : E}
    (hr : IsExtremeRayOfCone C r)
    (hsame : SameRay ℝ r r')
    (hr'_ne : r' ≠ 0) :
    IsExtremeRayOfCone C r' := by
  have hr_ne : r ≠ 0 := extremeRay_ne_zero hr
  -- Replace the generated hull by the equal hull of the new nonzero generator.
  rw [IsExtremeRayOfCone,
    ← singletonRayHull_eq_of_sameRay_of_nonzero hr_ne hr'_ne hsame]
  exact hr

/-- A witness that `rbar` is a proper conic combination of two distinct rays contained in the
carrier set `C`. Distinctness of rays is expressed by `¬ SameRay ℝ r₁ r₂`. -/
def ProperConicCombinationOfDistinctConeRays
    (C : Set E) (rbar : E) : Prop :=
  ∃ r₁ r₂ : E,
    r₁ ∈ C ∧
    r₂ ∈ C ∧
    r₁ ≠ 0 ∧
    r₂ ≠ 0 ∧
    ¬ SameRay ℝ r₁ r₂ ∧
    ∃ μ₁ μ₂ : ℝ,
      0 < μ₁ ∧
      0 < μ₂ ∧
      rbar = μ₁ • r₁ + μ₂ • r₂

-- Downstream note: Theorem 3.35 (2) reuses the cone-level characterization below. The
-- source-facing owner for this item remains the Section 3.11 edge/extreme-ray API.
/-- Helper for Definition 3.11-extra-1: any point of the singleton pointed-cone hull generated by
`r` lies on the same ray as `r`. -/
lemma sameRayOfMemSingletonRayHull {r x : E}
    (hr : r ≠ 0)
    (hx : x ∈ (PointedCone.hull ℝ ({r} : Set E) : Set E)) :
    SameRay ℝ x r := by
  rcases mem_singletonRayHull_iff.mp hx with ⟨μ, hμ, rfl⟩
  -- A nonnegative multiple lies on the same ray as its generator.
  have hmultiple : SameRay ℝ (μ • r) r := SameRay.sameRay_nonneg_smul_left r hμ
  have hmiddle : r = 0 → μ • r = 0 ∨ r = 0 := by
    intro hr_zero
    exact False.elim (hr hr_zero)
  exact hmultiple.trans (SameRay.refl r) hmiddle

/-- Helper for Definition 3.11-extra-1: every vector on the same nonzero ray as `r` belongs to the
singleton pointed-cone hull generated by `r`. -/
lemma memSingletonRayHull_of_sameRay {r x : E}
    (hr : r ≠ 0)
    (hx : SameRay ℝ x r) :
    x ∈ (PointedCone.hull ℝ ({r} : Set E) : Set E) := by
  rcases hx.exists_nonneg_right hr with ⟨μ, hμ, hμx⟩
  -- Use the nonnegative scalar supplied by the same-ray characterization.
  exact mem_singletonRayHull_iff.mpr ⟨μ, hμ, hμx⟩

/-- Helper for Definition 3.11-extra-1: removing a positive scalar from a singleton-ray-hull
membership keeps the vector inside the same hull. -/
lemma memSingletonRayHull_of_pos_smul_memSingletonRayHull {r x : E} {a : ℝ}
    (ha : 0 < a)
    (hx : a • x ∈ (PointedCone.hull ℝ ({r} : Set E) : Set E)) :
    x ∈ (PointedCone.hull ℝ ({r} : Set E) : Set E) := by
  -- Closure under the positive inverse scalar cancels the given factor.
  have hscaled :=
    (PointedCone.hull ℝ ({r} : Set E)).smul_mem (inv_nonneg.mpr ha.le) hx
  simpa only [inv_smul_smul₀ ha.ne'] using hscaled

/-- Helper for Definition 3.11-extra-1: the singleton pointed-cone hull generated by a nonzero
vector has one-dimensional affine-span direction. -/
lemma singletonRayHullFinrankDirectionEqOneOfNeZero {r : E}
    (hr : r ≠ 0) :
    Module.finrank ℝ
        (affineSpan ℝ (PointedCone.hull ℝ ({r} : Set E) : Set E)).direction = 1 := by
  have hzero :
      (0 : E) ∈ (PointedCone.hull ℝ ({r} : Set E) : Set E) :=
    (PointedCone.hull ℝ ({r} : Set E)).zero_mem
  rw [direction_affineSpan, vectorSpan_eq_span_vsub_set_right ℝ hzero]
  have himage :
      ((fun x : E ↦ x -ᵥ (0 : E)) ''
          (PointedCone.hull ℝ ({r} : Set E) : Set E)) =
        (PointedCone.hull ℝ ({r} : Set E) : Set E) := by
    simp
  rw [himage]
  -- The real span of all nonnegative multiples of `r` is the ordinary singleton span.
  have hspan :
      Submodule.span ℝ (PointedCone.hull ℝ ({r} : Set E) : Set E) =
        Submodule.span ℝ ({r} : Set E) := by
    apply le_antisymm
    · rw [Submodule.span_le]
      intro x hx
      rcases mem_singletonRayHull_iff.mp hx with ⟨μ, _, rfl⟩
      exact Submodule.smul_mem _ μ (Submodule.mem_span_singleton_self r)
    · exact Submodule.span_mono PointedCone.subset_hull
  rw [hspan]
  exact finrank_span_singleton hr

/-- Helper for Definition 3.11-extra-1: if `x + y = 0` and `x` does not already lie on the ray
generated by `rbar`, then `rbar` would have a forbidden proper conic decomposition. -/
lemma memSingletonRayHull_of_sameRay_add_of_zeroSum
    {rbar x y : E}
    (hxy_zero : x + y = 0)
    (hrbar_add_y_ne : rbar + y ≠ 0)
    (hsame : SameRay ℝ x (rbar + y)) :
    x ∈ (PointedCone.hull ℝ ({rbar} : Set E) : Set E) := by
  rcases hsame.exists_eq_smul_add with ⟨a, b, ha, _, _, hxa, _⟩
  refine mem_singletonRayHull_iff.mpr ⟨a, ha, ?_⟩
  have hsum_rbar : x + (rbar + y) = rbar := by
    by_cases hrbar_add_y_zero : rbar + y = 0
    · exact False.elim (hrbar_add_y_ne hrbar_add_y_zero)
    · calc
        x + (rbar + y) = rbar + (x + y) := by abel
        _ = rbar := by rw [hxy_zero, add_zero]
  -- The sum of the two same-ray vectors reduces to `rbar` by the zero-sum hypothesis.
  calc
    x = a • (x + (rbar + y)) := hxa
    _ = a • rbar := by rw [hsum_rbar]

/-- Helper for Definition 3.11-extra-1: if `x + y = 0` and `x` does not already lie on the ray
generated by `rbar`, then `rbar` would have a forbidden proper conic decomposition. -/
lemma zeroSumOffSingletonRayHullContradiction
    {C : Set E} {rbar x y : E}
    (hC_cone : ∃ K : PointedCone ℝ E, (K : Set E) = C)
    (hrbar : rbar ∈ C)
    (hno : ¬ ProperConicCombinationOfDistinctConeRays C rbar)
    (hx : x ∈ C)
    (hy : y ∈ C)
    (hxt : x ∉ (PointedCone.hull ℝ ({rbar} : Set E) : Set E))
    (hxy_zero : x + y = 0) : False := by
  rcases hC_cone with ⟨K, rfl⟩
  have hx_ne : x ≠ 0 := by
    intro hx_zero
    apply hxt
    rw [hx_zero]
    exact (PointedCone.hull ℝ ({rbar} : Set E)).zero_mem
  have hrbar_add_y_mem : rbar + y ∈ K := K.add_mem hrbar hy
  have hrbar_add_y_ne : rbar + y ≠ 0 := by
    intro hrbar_add_y_zero
    apply hxt
    have hx_eq : x = rbar := by
      calc
        x = x + (rbar + y) := by rw [hrbar_add_y_zero, add_zero]
        _ = rbar + (x + y) := by abel
        _ = rbar := by rw [hxy_zero, add_zero]
    rw [hx_eq]
    exact PointedCone.subset_hull (Set.mem_singleton rbar)
  have hnotSame : ¬ SameRay ℝ x (rbar + y) := by
    intro hsame
    exact hxt
      (memSingletonRayHull_of_sameRay_add_of_zeroSum hxy_zero hrbar_add_y_ne hsame)
  have hrearrange : x + (rbar + y) = rbar + (x + y) := by
    abel
  -- The vectors `x` and `rbar + y`, both with coefficient one, form the forbidden decomposition.
  apply hno
  refine ⟨x, rbar + y, hx, hrbar_add_y_mem, hx_ne, hrbar_add_y_ne, hnotSame,
    1, 1, zero_lt_one, zero_lt_one, ?_⟩
  calc
    rbar = x + (rbar + y) := by
      rw [hrearrange, hxy_zero, add_zero]
    _ = (1 : ℝ) • x + (1 : ℝ) • (rbar + y) := by simp

/-- Helper for Definition 3.11-extra-1: if `x + y` is a positive multiple of `rbar` and `x` does
not already lie on the ray generated by `rbar`, then `rbar` would have a forbidden proper conic
decomposition. -/
lemma positiveRaySumOffSingletonRayHullContradiction
    {C : Set E} {rbar x y : E} {t : ℝ}
    (hrbar_ne_zero : rbar ≠ 0)
    (hno : ¬ ProperConicCombinationOfDistinctConeRays C rbar)
    (hx : x ∈ C)
    (hy : y ∈ C)
    (hxt : x ∉ (PointedCone.hull ℝ ({rbar} : Set E) : Set E))
    (ht_pos : 0 < t)
    (hsum_eq : x + y = t • rbar) : False := by
  have hx_ne : x ≠ 0 := by
    intro hx_zero
    apply hxt
    rw [hx_zero]
    exact (PointedCone.hull ℝ ({rbar} : Set E)).zero_mem
  have hnotSame : ¬ SameRay ℝ x y := by
    intro hsame
    rcases hsame.exists_eq_smul_add with ⟨a, b, ha, _, _, hxa, _⟩
    apply hxt
    refine mem_singletonRayHull_iff.mpr ⟨a * t, mul_nonneg ha ht_pos.le, ?_⟩
    -- Same-ray normalization expresses `x` as a nonnegative multiple of the ray sum.
    calc
      x = a • (x + y) := hxa
      _ = a • (t • rbar) := congrArg (fun z : E ↦ a • z) hsum_eq
      _ = (a * t) • rbar := by rw [smul_smul]
  have hy_ne : y ≠ 0 := by
    intro hy_zero
    apply hnotSame
    rw [hy_zero]
    exact SameRay.zero_right x
  have hinv_pos : 0 < t⁻¹ := inv_pos.mpr ht_pos
  have hscaled_ne : t • rbar ≠ 0 := smul_ne_zero ht_pos.ne' hrbar_ne_zero
  have ht_ne : t ≠ 0 := by
    intro ht_zero
    apply hscaled_ne
    rw [ht_zero, zero_smul]
  have hnormalized :
      rbar = t⁻¹ • x + t⁻¹ • y := by
    calc
      rbar = t⁻¹ • (t • rbar) := (inv_smul_smul₀ ht_ne rbar).symm
      _ = t⁻¹ • (x + y) := congrArg (fun z : E ↦ t⁻¹ • z) hsum_eq.symm
      _ = t⁻¹ • x + t⁻¹ • y := by rw [smul_add]
  -- Scaling the positive ray sum by `t⁻¹` gives the forbidden proper decomposition.
  apply hno
  exact ⟨x, y, hx, hy, hx_ne, hy_ne, hnotSame,
    t⁻¹, t⁻¹, hinv_pos, hinv_pos, hnormalized⟩

/-- Helper for Definition 3.11-extra-1: under the no-proper-conic-combination hypothesis, if a
sum of two cone vectors lies on the ray generated by `rbar`, then the left summand already lies on
that ray. -/
lemma leftMemSingletonRayHull_of_add_mem_of_noProperConicCombination
    {C : Set E} {rbar x y : E}
    (hC_cone : ∃ K : PointedCone ℝ E, (K : Set E) = C)
    (hrbar : rbar ∈ C)
    (hrbar_ne_zero : rbar ≠ 0)
    (hno : ¬ ProperConicCombinationOfDistinctConeRays C rbar)
    (hx : x ∈ C)
    (hy : y ∈ C)
    (hsum : x + y ∈ (PointedCone.hull ℝ ({rbar} : Set E) : Set E)) :
    x ∈ (PointedCone.hull ℝ ({rbar} : Set E) : Set E) := by
  rcases mem_singletonRayHull_iff.mp hsum with ⟨t, ht, hsum_eq⟩
  by_contra hxt
  -- Split the ray coefficient into the zero and positive cases.
  rcases eq_or_lt_of_le ht with ht_zero | ht_pos
  · have hxy_zero : x + y = 0 := by
      simpa only [← ht_zero, zero_smul] using hsum_eq
    exact zeroSumOffSingletonRayHullContradiction
      hC_cone hrbar hno hx hy hxt hxy_zero
  · exact positiveRaySumOffSingletonRayHullContradiction
      hrbar_ne_zero hno hx hy hxt ht_pos hsum_eq

/-- Helper for Definition 3.11-extra-1: under the no-proper-conic-combination hypothesis, if a
sum of two cone vectors lies on the ray generated by `rbar`, then both summands lie on that ray. -/
lemma memSingletonRayHull_of_add_mem_of_noProperConicCombination
    {C : Set E} {rbar x y : E}
    (hC_cone : ∃ K : PointedCone ℝ E, (K : Set E) = C)
    (hrbar : rbar ∈ C)
    (hrbar_ne_zero : rbar ≠ 0)
    (hno : ¬ ProperConicCombinationOfDistinctConeRays C rbar)
    (hx : x ∈ C)
    (hy : y ∈ C)
    (hsum : x + y ∈ (PointedCone.hull ℝ ({rbar} : Set E) : Set E)) :
    x ∈ (PointedCone.hull ℝ ({rbar} : Set E) : Set E) ∧
      y ∈ (PointedCone.hull ℝ ({rbar} : Set E) : Set E) := by
  -- Apply the one-sided result to the sum in both orders.
  constructor
  · exact leftMemSingletonRayHull_of_add_mem_of_noProperConicCombination
      hC_cone hrbar hrbar_ne_zero hno hx hy hsum
  · exact leftMemSingletonRayHull_of_add_mem_of_noProperConicCombination
      hC_cone hrbar hrbar_ne_zero hno hy hx (add_comm y x ▸ hsum)

/-- Helper for Definition 3.11-extra-1: the singleton pointed-cone hull generated by `rbar` is an
extreme subset of `C` once `rbar` admits no proper conic combination of distinct cone rays. -/
lemma isExtremeSingletonRayHull_of_noProperConicCombination
    {C : Set E} {rbar : E}
    (hC_cone : ∃ K : PointedCone ℝ E, (K : Set E) = C)
    (hrbar : rbar ∈ C)
    (hrbar_ne_zero : rbar ≠ 0)
    (hno : ¬ ProperConicCombinationOfDistinctConeRays C rbar) :
    IsExtreme ℝ C (PointedCone.hull ℝ ({rbar} : Set E) : Set E) := by
  rcases hC_cone with ⟨K, rfl⟩
  refine ⟨?_, ?_⟩
  · intro z hz
    rcases mem_singletonRayHull_iff.mp hz with ⟨μ, hμ, rfl⟩
    -- The cone contains every nonnegative multiple of its member `rbar`.
    exact K.smul_mem hμ hrbar
  · intro x hx y hy z hz hz_segment
    rcases hz_segment with ⟨a, b, ha, hb, _, hcomb⟩
    have hax : a • x ∈ K := K.smul_mem ha.le hx
    have hby : b • y ∈ K := K.smul_mem hb.le hy
    have hsum :
        a • x + b • y ∈
          (PointedCone.hull ℝ ({rbar} : Set E) : Set E) := by
      rw [hcomb]
      exact hz
    have hparts := memSingletonRayHull_of_add_mem_of_noProperConicCombination
      ⟨K, rfl⟩ hrbar hrbar_ne_zero hno hax hby hsum
    -- Extremality of the ray sum puts the scaled endpoint in the hull; cancel its positive scale.
    exact memSingletonRayHull_of_pos_smul_memSingletonRayHull ha hparts.1

/-- Helper for Definition 3.11-extra-1: an extreme singleton ray hull forbids proper conic
decompositions into distinct cone rays. -/
lemma notProperConicCombinationOfIsExtremeRayOfCone
    {C : Set E} {rbar : E}
    (hC_cone : ∃ K : PointedCone ℝ E, (K : Set E) = C)
    (hrbar_ne_zero : rbar ≠ 0)
    (hExtreme : IsExtreme ℝ C (PointedCone.hull ℝ ({rbar} : Set E) : Set E)) :
    ¬ ProperConicCombinationOfDistinctConeRays C rbar := by
  rcases hC_cone with ⟨K, hK⟩
  intro hproper
  rcases hproper with
    ⟨r₁, r₂, hr₁, hr₂, hr₁_ne, hr₂_ne, hdistinct,
      μ₁, μ₂, hμ₁, hμ₂, hdecomp⟩
  have hr₁_cone : r₁ ∈ K := by
    change r₁ ∈ (K : Set E)
    rw [hK]
    exact hr₁
  have hr₁_carrier : r₁ ∈ C := hK ▸ hr₁_cone
  have hsum_pos : 0 < μ₁ + μ₂ := add_pos hμ₁ hμ₂
  have hsum_ne : μ₁ + μ₂ ≠ 0 := hsum_pos.ne'
  have hcoeff_sum : μ₁ / (μ₁ + μ₂) + μ₂ / (μ₁ + μ₂) = 1 := by
    rw [← add_div, div_self hsum_ne]
  have hnormalized :
      (μ₁ / (μ₁ + μ₂)) • r₁ + (μ₂ / (μ₁ + μ₂)) • r₂ =
        (μ₁ + μ₂)⁻¹ • rbar := by
    rw [hdecomp]
    module
  have hrbar_hull :
      rbar ∈ (PointedCone.hull ℝ ({rbar} : Set E) : Set E) :=
    PointedCone.subset_hull (Set.mem_singleton rbar)
  have hnormalized_hull :
      (μ₁ + μ₂)⁻¹ • rbar ∈
        (PointedCone.hull ℝ ({rbar} : Set E) : Set E) :=
    (PointedCone.hull ℝ ({rbar} : Set E)).smul_mem
      (inv_nonneg.mpr hsum_pos.le) hrbar_hull
  have hnormalized_segment :
      (μ₁ + μ₂)⁻¹ • rbar ∈ openSegment ℝ r₁ r₂ := by
    -- Dividing by the positive coefficient sum turns the conic combination into an open segment.
    exact ⟨μ₁ / (μ₁ + μ₂), μ₂ / (μ₁ + μ₂),
      div_pos hμ₁ hsum_pos, div_pos hμ₂ hsum_pos, hcoeff_sum, hnormalized⟩
  have hr₁_hull := hExtreme.left_mem_of_mem_openSegment
    hr₁_carrier hr₂ hnormalized_hull hnormalized_segment
  have hr₂_hull := hExtreme.right_mem_of_mem_openSegment
    hr₁_carrier hr₂ hnormalized_hull hnormalized_segment
  have hr₁_same : SameRay ℝ r₁ rbar :=
    sameRayOfMemSingletonRayHull hrbar_ne_zero hr₁_hull
  have hr₂_same : SameRay ℝ r₂ rbar :=
    sameRayOfMemSingletonRayHull hrbar_ne_zero hr₂_hull
  have hmiddle : rbar = 0 → r₁ = 0 ∨ r₂ = 0 := by
    intro hrbar_zero
    exact False.elim (hrbar_ne_zero hrbar_zero)
  -- Both generators lie on the ray of `rbar`, hence they share the ray's direction.
  exact hdistinct (hr₁_same.trans hr₂_same.symm hmiddle)

/-- remote integer-programming sorry cleanup Integer/Chapters/Chap03/section_3_11/ch3_sec3_11_definition_3_11_extra_1.lean. See https://en.wikipedia.org/wiki/Extremal_ray.

For a cone `C`, a nonzero vector `rbar` generates an extreme ray exactly when `rbar` is not a
proper conic combination of two distinct rays contained in `C`. -/
theorem isExtremeRayOfCone_iff_not_proper_conic_combination_of_distinct_rays
    {C : Set E} {rbar : E}
    (hC_cone : ∃ K : PointedCone ℝ E, (K : Set E) = C)
    (hrbar : rbar ∈ C)
    (hrbar_ne_zero : rbar ≠ 0) :
    IsExtremeRayOfCone C rbar ↔
      ¬ ProperConicCombinationOfDistinctConeRays C rbar := by
  constructor
  · intro hray
    -- The extreme-subset field excludes every normalized proper conic decomposition.
    exact notProperConicCombinationOfIsExtremeRayOfCone
      hC_cone hrbar_ne_zero hray.isExtreme
  · intro hno
    -- Assemble the edge from cone convexity, the decomposition criterion, and rank one.
    refine ⟨(PointedCone.hull ℝ ({rbar} : Set E)).convex, ?_, ?_⟩
    · exact isExtremeSingletonRayHull_of_noProperConicCombination
        hC_cone hrbar hrbar_ne_zero hno
    · exact singletonRayHullFinrankDirectionEqOneOfNeZero hrbar_ne_zero

/-- Helper: the set-level predicate obtained by applying `IsExtremeRayOfCone` to the recession
cone of `P`. -/
def IsExtremeRayOfPolyhedron (P : Set E) (r : E) : Prop :=
  IsExtremeRayOfCone (recessionCone P) r

/-- Unfolding lemma for the helper predicate `IsExtremeRayOfPolyhedron`. -/
theorem isExtremeRayOfPolyhedron_iff {P : Set E} {r : E} :
    IsExtremeRayOfPolyhedron P r ↔ IsExtremeRayOfCone (recessionCone P) r := by
  -- This is the definitional expansion through the recession-cone wrapper.
  rfl

section SourceFacing

variable {n : ℕ}

/-- Definition 3.11-extra-1. An extreme ray of a pointed polyhedral cone `C` is an edge of `C`.
In this project, `is_polyhedral_cone C` is already the local owner for "pointed polyhedral cone",
and the edge is represented by the half-line generated by `r`. -/
class IsExtremeRayOfPointedPolyhedralCone
    (C : Set (Fin n → ℝ)) (r : Fin n → ℝ) : Prop where
  /-- The ambient cone is polyhedral, which is the project-local owner for pointed polyhedral
  cones in this section. -/
  polyhedral : is_polyhedral_cone C
  /-- The generator `r` determines an extreme ray of the ambient cone. -/
  isExtremeRay : IsExtremeRayOfCone C r

/-- An extreme ray of a pointed polyhedral cone is, in particular, an extreme ray of the ambient
cone. -/
instance instIsExtremeRayOfConeOfIsExtremeRayOfPointedPolyhedralCone
    {C : Set (Fin n → ℝ)} {r : Fin n → ℝ}
    [h : IsExtremeRayOfPointedPolyhedralCone C r] :
    IsExtremeRayOfCone C r :=
  h.isExtremeRay

/-- An extreme ray of a pointed polyhedral cone is, in particular, an edge of the ambient cone
along the generated half-line. -/
instance instIsEdgeOfOfIsExtremeRayOfPointedPolyhedralCone
    {C : Set (Fin n → ℝ)} {r : Fin n → ℝ}
    [h : IsExtremeRayOfPointedPolyhedralCone C r] :
    IsEdgeOf C (PointedCone.hull ℝ ({r} : Set (Fin n → ℝ)) : Set (Fin n → ℝ)) :=
  h.isExtremeRay

/-- The source-facing pointed-polyhedral-cone owner expands to the ambient polyhedral-cone
hypothesis together with the set-level edge predicate on the generated half-line. -/
theorem isExtremeRayOfPointedPolyhedralCone_iff
    {C : Set (Fin n → ℝ)} {r : Fin n → ℝ} :
    IsExtremeRayOfPointedPolyhedralCone C r ↔
      is_polyhedral_cone C ∧ IsExtremeRayOfCone C r := by
  constructor
  · intro h
    exact ⟨h.polyhedral, h.isExtremeRay⟩
  · rintro ⟨hC_polyhedral, hr_extreme⟩
    exact ⟨hC_polyhedral, hr_extreme⟩

/-- Extreme-ray generators of a pointed polyhedral cone are invariant under replacing the
generator by another nonzero vector on the same ray. -/
theorem isExtremeRayOfPointedPolyhedralCone_of_sameRay
    {C : Set (Fin n → ℝ)} {r r' : Fin n → ℝ}
    (hr : IsExtremeRayOfPointedPolyhedralCone C r)
    (hsame : SameRay ℝ r r')
    (hr'_ne : r' ≠ 0) :
    IsExtremeRayOfPointedPolyhedralCone C r' := by
  -- Keep the ambient pointed-polyhedral hypothesis and transport only the edge witness.
  exact ⟨hr.polyhedral, isExtremeRayOfCone_of_sameRay hr.isExtremeRay hsame hr'_ne⟩

/-- Companion source-facing predicate: the extreme rays of a pointed polyhedron are the extreme rays
of its recession cone. The nonemptiness assumption is part of the Section 3.11 standing context. -/
def IsExtremeRayOfPointedPolyhedron
    (P : Set (Fin n → ℝ)) (r : Fin n → ℝ) : Prop :=
  P.Nonempty ∧ is_polyhedron P ∧ is_pointed P ∧
    IsExtremeRayOfCone (recessionCone P) r

/-- A pointed-polyhedron extreme ray carries the Section 3.11 nonemptiness hypothesis. -/
theorem IsExtremeRayOfPointedPolyhedron.nonempty
    {P : Set (Fin n → ℝ)} {r : Fin n → ℝ}
    (h : IsExtremeRayOfPointedPolyhedron P r) :
    P.Nonempty :=
  h.1

/-- A pointed-polyhedron extreme ray carries the ambient polyhedron hypothesis. -/
theorem IsExtremeRayOfPointedPolyhedron.polyhedral
    {P : Set (Fin n → ℝ)} {r : Fin n → ℝ}
    (h : IsExtremeRayOfPointedPolyhedron P r) :
    is_polyhedron P :=
  h.2.1

/-- A pointed-polyhedron extreme ray carries the ambient pointedness hypothesis. -/
theorem IsExtremeRayOfPointedPolyhedron.pointed
    {P : Set (Fin n → ℝ)} {r : Fin n → ℝ}
    (h : IsExtremeRayOfPointedPolyhedron P r) :
    is_pointed P :=
  h.2.2.1

/-- A pointed-polyhedron extreme ray is an extreme ray of the recession cone. -/
theorem IsExtremeRayOfPointedPolyhedron.isExtremeRay
    {P : Set (Fin n → ℝ)} {r : Fin n → ℝ}
    (h : IsExtremeRayOfPointedPolyhedron P r) :
    IsExtremeRayOfCone (recessionCone P) r :=
  h.2.2.2

/-- Unfolding lemma for the pointed-polyhedron predicate. -/
theorem isExtremeRayOfPointedPolyhedron_iff
    {P : Set (Fin n → ℝ)} {r : Fin n → ℝ} :
    IsExtremeRayOfPointedPolyhedron P r ↔
      P.Nonempty ∧ is_polyhedron P ∧ is_pointed P ∧
        IsExtremeRayOfCone (recessionCone P) r := by
  rfl

/-- Same-ray invariance for extreme rays of pointed polyhedra, provided the new generator is
nonzero. -/
theorem isExtremeRayOfPointedPolyhedron_of_sameRay
    {P : Set (Fin n → ℝ)} {r r' : Fin n → ℝ}
    (hr : IsExtremeRayOfPointedPolyhedron P r)
    (hsame : SameRay ℝ r r')
    (hr'_ne : r' ≠ 0) :
    IsExtremeRayOfPointedPolyhedron P r' := by
  -- Preserve the ambient pointed-polyhedron data and transport the recession-cone edge witness.
  exact ⟨hr.nonempty, hr.polyhedral, hr.pointed,
    isExtremeRayOfCone_of_sameRay hr.isExtremeRay hsame hr'_ne⟩

end SourceFacing

#print axioms isExtremeRayOfCone_iff_not_proper_conic_combination_of_distinct_rays
