/-- Helper for Corollary 3.42: an extreme ray of a polyhedron is in particular a recession
direction. -/
lemma isExtremeRayOfPolyhedron_mem_recessionCone
    {n : ℕ} {P : Set (Fin n → ℝ)} {r : Fin n → ℝ}
    (hr : IsExtremeRayOfPolyhedron P r) :
    r ∈ recessionCone P := by
  -- Unpack the source-facing extreme-ray predicate to the canonical cone-edge witness.
  have hr_cone : IsExtremeRayOfCone (recessionCone P) r :=
    (isExtremeRayOfPolyhedron_iff).1 hr
  have hedge :
      IsEdgeOf (recessionCone P) (PointedCone.hull ℝ ({r} : Set (Fin n → ℝ))) :=
    (isExtremeRayOfCone_iff).1 hr_cone
  -- The ray generator belongs to its singleton cone hull, and the edge sits inside the ambient
  -- cone.
  have hr_hull : r ∈ PointedCone.hull ℝ ({r} : Set (Fin n → ℝ)) :=
    PointedCone.subset_hull (by simp)
  exact hedge.isExtreme.subset hr_hull

/-- Helper for Corollary 3.42: once a point splits into a convex-hull vertex part and a cone part
generated by extreme rays, Corollary 3.41 and Theorem 3.40 compress those two pieces to bounded
independent families. -/
lemma exists_bounded_vertex_and_ray_decomposition_of_split
    {n : ℕ} {P : Set (Fin n → ℝ)} {x : Fin n → ℝ}
    (hsplit :
      ∃ vertexPart rayPart : Fin n → ℝ,
        vertexPart ∈ convexHull ℝ (P.extremePoints ℝ) ∧
        rayPart ∈ PointedCone.hull ℝ {r | IsExtremeRayOfPolyhedron P r} ∧
        x = vertexPart + rayPart) :
    ∃ vertexPart : Fin n → ℝ, ∃ vertices : Finset (Fin n → ℝ),
      (vertices : Set _) ⊆ P.extremePoints ℝ ∧
      AffineIndependent ℝ ((↑) : vertices → Fin n → ℝ) ∧
      vertexPart ∈ convexHull ℝ (vertices : Set _) ∧
      vertices.card ≤ Module.finrank ℝ (affineSpan ℝ P).direction + 1 ∧
      ∃ q : ℕ, ∃ r : Fin q → Fin n → ℝ,
        (∀ j, r j ∈ {r | IsExtremeRayOfPolyhedron P r}) ∧
        LinearIndependent ℝ r ∧
        q ≤ Module.finrank ℝ (Submodule.span ℝ (recessionCone P)) ∧
        ∃ coeff : Fin q → ℝ, (∀ j, 0 ≤ coeff j) ∧
          x = vertexPart + ∑ j, coeff j • r j := by
  rcases hsplit with ⟨vertexPart, rayPart, hvertexPart, hrayPart, hx_split⟩
  -- Compress the convex-hull part to an affinely independent vertex family.
  rcases exists_affineIndependent_convexCombination_of_mem_convexHull hvertexPart with
    ⟨vertices, hvertices_subset, hvertices_affineIndependent, hvertexPart_mem, hvertices_card⟩
  have hvertex_extreme_subset :
      (P.extremePoints ℝ : Set (Fin n → ℝ)) ⊆ P :=
    extremePoints_subset
  have hvertex_dim_le :
      Module.finrank ℝ (affineSpan ℝ (P.extremePoints ℝ)).direction ≤
        Module.finrank ℝ (affineSpan ℝ P).direction := by
    exact Submodule.finrank_mono
      (AffineSubspace.direction_le (affineSpan_mono ℝ hvertex_extreme_subset))
  have hvertices_bound :
      vertices.card ≤ Module.finrank ℝ (affineSpan ℝ P).direction + 1 := by
    exact hvertices_card.trans <| by
      simpa [add_comm] using add_le_add_right hvertex_dim_le 1
  -- Compress the cone part to a linearly independent family of extreme rays.
  rcases exists_linearIndependent_conicCombination_of_mem_hull hrayPart with
    ⟨q, r, hr_mem, hr_linearIndependent, hq_span, coeff, hcoeff_nonneg, hray_repr⟩
  have hray_subset_recession :
      {r | IsExtremeRayOfPolyhedron P r} ⊆ recessionCone P := by
    intro r hr
    exact isExtremeRayOfPolyhedron_mem_recessionCone hr
  have hray_span_le :
      Module.finrank ℝ (Submodule.span ℝ {r | IsExtremeRayOfPolyhedron P r}) ≤
        Module.finrank ℝ (Submodule.span ℝ (recessionCone P)) := by
    exact Submodule.finrank_mono (Submodule.span_mono hray_subset_recession)
  refine ⟨vertexPart, vertices, hvertices_subset, hvertices_affineIndependent, hvertexPart_mem,
    hvertices_bound, q, r, hr_mem, hr_linearIndependent, hq_span.trans hray_span_le,
    coeff, hcoeff_nonneg, ?_⟩
  -- Substitute the compressed cone representation back into the original split.
  calc
    x = vertexPart + rayPart := hx_split
    _ = vertexPart + ∑ j, coeff j • r j := by rw [hray_repr]

/-- Helper for sorry cleanup existing repo ch3_sec3_14_corollary_3_42: a one-dimensional exposed
recession face containing a nonlineal point is exactly its generated ray. -/
lemma exposedRecessionFace_eq_singletonRayHull_of_finrank_one
    {n : ℕ} (P R : Set (Fin n → ℝ)) {r : Fin n → ℝ}
    (hR_exposed : IsExposed ℝ (recessionCone P) R)
    (hrR : r ∈ R)
    (hr_not_lineality : r ∉ linealitySpace P)
    (hR_dim : Module.finrank ℝ (affineSpan ℝ R).direction = 1) :
    R = (PointedCone.hull ℝ ({r} : Set (Fin n → ℝ)) : Set (Fin n → ℝ)) := by
  have hr_ne_zero : r ≠ 0 := by
    intro hr_zero
    apply hr_not_lineality
    simpa [hr_zero] using (zero_mem_linealitySpace : (0 : Fin n → ℝ) ∈ linealitySpace P)
  have hr_rec : r ∈ recessionCone P := hR_exposed.subset hrR
  have hray_subset : ray r ⊆ R := by
    obtain ⟨l, rfl⟩ := hR_exposed ⟨r, hrR⟩
    have hr_max : ∀ z ∈ recessionCone P, l z ≤ l r := hrR.2
    have hlr_nonneg : 0 ≤ l r := by
      simpa using hr_max 0 zero_mem_recessionCone
    have htwo_nonneg : (0 : ℝ) ≤ 2 := by positivity
    have htwo_mem : (2 : ℝ) • r ∈ recessionCone P :=
      smul_mem_recessionCone hr_rec htwo_nonneg
    have hlr_nonpos : l r ≤ 0 := by
      have hdouble : (2 : ℝ) * l r ≤ l r := by
        simpa using hr_max ((2 : ℝ) • r) htwo_mem
      linarith
    have hlr_zero : l r = 0 := le_antisymm hlr_nonpos hlr_nonneg
    intro z hz
    rcases mem_ray_iff.mp hz with ⟨a, ha, rfl⟩
    refine ⟨smul_mem_recessionCone hr_rec ha, ?_⟩
    intro w hw
    calc
      l w ≤ l r := hr_max w hw
      _ = 0 := hlr_zero
      _ = l (a • r) := by simp [hlr_zero]
  apply Set.Subset.antisymm
  · intro z hzR
    have hzeroR : (0 : Fin n → ℝ) ∈ R := hray_subset ray_zero_mem
    have hr_aff : r ∈ affineSpan ℝ R := subset_affineSpan ℝ R hrR
    have hz_aff : z ∈ affineSpan ℝ R := subset_affineSpan ℝ R hzR
    have hzero_aff : (0 : Fin n → ℝ) ∈ affineSpan ℝ R :=
      subset_affineSpan ℝ R hzeroR
    have hr_dir : r ∈ (affineSpan ℝ R).direction := by
      simpa [vsub_eq_sub] using AffineSubspace.vsub_mem_direction hr_aff hzero_aff
    have hz_dir : z ∈ (affineSpan ℝ R).direction := by
      simpa [vsub_eq_sub] using AffineSubspace.vsub_mem_direction hz_aff hzero_aff
    have hspan_le : ℝ ∙ r ≤ (affineSpan ℝ R).direction :=
      (Submodule.span_singleton_le_iff_mem r _).2 hr_dir
    have hdirection_eq : (affineSpan ℝ R).direction = ℝ ∙ r := by
      symm
      refine Submodule.eq_of_le_of_finrank_eq hspan_le ?_
      rw [hR_dim]
      simpa using finrank_span_singleton hr_ne_zero
    have hz_span : z ∈ ℝ ∙ r := by
      rwa [← hdirection_eq]
    rcases Submodule.mem_span_singleton.mp hz_span with ⟨μ, hμ⟩
    have hz_eq : z = μ • r := hμ.symm
    have hμ_nonneg : 0 ≤ μ := by
      by_contra hμ_neg
      have hμ_lt : μ < 0 := lt_of_not_ge hμ_neg
      have hz_rec : z ∈ recessionCone P := hR_exposed.subset hzR
      have hinv_nonneg : 0 ≤ (-μ)⁻¹ := inv_nonneg.mpr (neg_nonneg.mpr hμ_lt.le)
      have hz_scaled : ((-μ)⁻¹ : ℝ) • z ∈ recessionCone P :=
        smul_mem_recessionCone hz_rec hinv_nonneg
      have hmul : ((-μ)⁻¹ : ℝ) * μ = -1 := by
        calc
          ((-μ)⁻¹ : ℝ) * μ = (-(μ⁻¹)) * μ := by rw [inv_neg]
          _ = -(μ⁻¹ * μ) := by ring
          _ = -1 := by rw [inv_mul_cancel₀ hμ_lt.ne]
      have hscaled_eq : ((-μ)⁻¹ : ℝ) • z = -r := by
        calc
          ((-μ)⁻¹ : ℝ) • z = ((-μ)⁻¹ : ℝ) • (μ • r) := by rw [hz_eq]
          _ = (((-μ)⁻¹ : ℝ) * μ) • r := by rw [smul_smul]
          _ = -r := by rw [hmul, neg_one_smul]
      have hminus_r : -r ∈ recessionCone P := hscaled_eq ▸ hz_scaled
      have hr_lineality : r ∈ linealitySpace P := by
        rw [linealitySpace_eq_recessionCone_inter_neg]
        refine ⟨hr_rec, ?_⟩
        rwa [mem_neg_recessionCone_iff]
      exact hr_not_lineality hr_lineality
    exact mem_singletonRayHull_iff.mpr ⟨μ, hμ_nonneg, hz_eq⟩
  · intro z hz
    rcases mem_singletonRayHull_iff.mp hz with ⟨μ, hμ_nonneg, hz_eq⟩
    exact hray_subset (mem_ray_iff.mpr ⟨μ, hμ_nonneg, hz_eq⟩)

/-- Helper for sorry cleanup existing repo ch3_sec3_14_corollary_3_42: pointedness makes the
lineality submodule trivial. -/
lemma linealitySubmodule_eq_bot_of_pointed
    {n : ℕ} {P : Set (Fin n → ℝ)}
    (hP_pointed : is_pointed P) :
    linealitySubmodule P = ⊥ := by
  rw [Submodule.eq_bot_iff]
  intro r hr
  -- Convert the bundled membership to the source-facing lineality space and use pointedness.
  exact (is_pointed_iff_eq_zero_of_mem_linealitySpace.mp hP_pointed) r
    (mem_linealitySubmodule_iff.mp hr)

/-- Helper for Corollary 3.42: a point of a pointed polyhedron splits into a convex combination of
vertices and a conic combination of extreme rays. -/
lemma exists_vertex_part_add_extreme_ray_part_of_mem_polyhedron
    {n : ℕ} {P : Set (Fin n → ℝ)}
    (hP_polyhedron : is_polyhedron P)
    (hP_pointed : is_pointed P)
    {x : Fin n → ℝ} (hx : x ∈ P) :
    ∃ vertexPart rayPart : Fin n → ℝ,
      vertexPart ∈ convexHull ℝ (P.extremePoints ℝ) ∧
      rayPart ∈ PointedCone.hull ℝ {r | IsExtremeRayOfPolyhedron P r} ∧
      x = vertexPart + rayPart := by
  -- Route correction: the needed pointed decomposition is available in the earlier `PointedCore`
  -- support module, so no dependency on the blocked full Theorem 3.37 module is necessary.
  have hP_nonempty : P.Nonempty := ⟨x, hx⟩
  have hx_decomposition :=
    pointedPolyhedron_subset_convexHull_extremePoints_add_cone_extremeRays
      P hP_nonempty hP_polyhedron hP_pointed hx
  -- Unpack the Minkowski-sum witness and expose its two canonical components.
  rcases Set.mem_add.mp hx_decomposition with
    ⟨vertexPart, hvertexPart, rayPart, hrayPart, hparts_sum⟩
  refine ⟨vertexPart, rayPart, hvertexPart, ?_, hparts_sum.symm⟩
  -- Fold the source-facing extreme-ray predicate and the generated-cone abbreviation.
  exact hrayPart

/-- remote integer-programming sorry cleanup Integer/Chapters/Chap03/section_3_14/ch3_sec3_14_corollary_3_42.lean.
Corollary 3.42. If `P` is a pointed polyhedron, then every point `x ∈ P` can be written as the
sum of a convex combination of at most `dim(P) + 1` affinely independent vertices of `P` and a
conic combination of at most `dim(rec(P))` linearly independent extreme rays of `P`. The vertex
part is expressed canonically as membership in the convex hull of a finite affinely independent
subset of `P.extremePoints ℝ`, while the ray part is given directly as the finite-family witness
from Theorem 3.40. -/
theorem exists_vertex_convex_combination_add_extreme_ray_conic_combination
    {n : ℕ} {P : Set (Fin n → ℝ)}
    (hP_polyhedron : is_polyhedron P)
    (hP_pointed : is_pointed P)
    {x : Fin n → ℝ} (hx : x ∈ P) :
    ∃ vertexPart : Fin n → ℝ, ∃ vertices : Finset (Fin n → ℝ),
      (vertices : Set _) ⊆ P.extremePoints ℝ ∧
      AffineIndependent ℝ ((↑) : vertices → Fin n → ℝ) ∧
      vertexPart ∈ convexHull ℝ (vertices : Set _) ∧
      vertices.card ≤ Module.finrank ℝ (affineSpan ℝ P).direction + 1 ∧
      ∃ q : ℕ, ∃ r : Fin q → Fin n → ℝ,
        (∀ j, r j ∈ {r | IsExtremeRayOfPolyhedron P r}) ∧
        LinearIndependent ℝ r ∧
        q ≤ Module.finrank ℝ (Submodule.span ℝ (recessionCone P)) ∧
        ∃ coeff : Fin q → ℝ, (∀ j, 0 ≤ coeff j) ∧
          x = vertexPart + ∑ j, coeff j • r j := by
  -- Reduce the corollary to the coarse decomposition promised by the source-faithful homogenized
  -- route.
  rcases exists_vertex_part_add_extreme_ray_part_of_mem_polyhedron
      hP_polyhedron hP_pointed hx with
    ⟨vertexPart, rayPart, hvertexPart, hrayPart, hx_split⟩
  -- Once the split is available, the bounded independent families come from Corollary 3.41 and
  -- Theorem 3.40.
  exact exists_bounded_vertex_and_ray_decomposition_of_split
    ⟨vertexPart, rayPart, hvertexPart, hrayPart, hx_split⟩

