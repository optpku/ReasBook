import IntegerProgramming_Conforti_2014.Integer.Chapters.Chap04.section_4_1.ch4_sec4_1_theorem_4_3
import IntegerProgramming_Conforti_2014.Integer.Chapters.Chap04.section_4_8.ch4_sec4_8_theorem_4_30
import IntegerProgramming_Conforti_2014.Integer.Chapters.Chap04.section_4_12.ch4_sec4_12_exercise_4_30
import IntegerProgramming_Conforti_2014.Integer.Chapters.Chap03.section_3_5.ch3_sec3_5_definition_3_5_extra_1

open scoped BigOperators Matrix Pointwise

-- Semantic recall note: the mixed-space owner API for rational mixed polyhedra and mixed-integer
-- points is already established upstream in Chapter 4.1, and the generic recession-cone owner is
-- reused through Theorem 4.30. This file adds only the real-coefficient/right-hand-side variants
-- needed by the remark.

section Remark432

variable {m n p : ℕ}

/-- A real matrix has rational entries when each coefficient is the real coercion of some
rational number. -/
def matrix_has_rational_entries
    (A : Matrix (Fin m) (Fin n) ℝ) : Prop :=
  ∀ i j, ∃ q : ℚ, A i j = (q : ℝ)

/-- A real vector has rational entries when each coordinate is the real coercion of some rational
number. -/
def vector_has_rational_entries
    (b : Fin m → ℝ) : Prop :=
  ∀ i, ∃ q : ℚ, b i = (q : ℝ)

/-- The mixed polyhedron cut out by rational matrices `A`, `G` and a real right-hand side `b`. -/
def rational_matrices_real_rhs_mixed_polyhedron
    (A : Matrix (Fin m) (Fin n) ℚ)
    (G : Matrix (Fin m) (Fin p) ℚ)
    (b : Fin m → ℝ) :
    Set (MixedRealPoint n p) :=
  real_mixed_polyhedron (A.map (Rat.castHom ℝ)) (G.map (Rat.castHom ℝ)) b

/-- Helper for Remark 4.32: a nonempty matrix polyhedron has the same recession cone after an
arbitrary real right-hand side is allowed; because the homogeneous matrix is still rational, that
cone has finitely many integral generators. -/
private lemma rationalMatrixRealRhs_recessionCone_eq_integralCone
    {m k : ℕ}
    (M : Matrix (Fin m) (Fin k) ℚ)
    (β : Fin m → ℝ)
    (h_nonempty : Set.Nonempty
      (polyhedron_le_set (M.map (Rat.castHom ℝ)) β)) :
    ∃ q : ℕ,
      ∃ rays : Fin q → Fin k → ℤ,
        recessionCone (polyhedron_le_set (M.map (Rat.castHom ℝ)) β) =
          finitely_generated_cone
            (fun j : Fin q ↦ fun i : Fin k ↦ (rays j i : ℝ)) := by
  rcases exists_rational_matrix_cone_of_rational_matrix_polyhedral_cone M with
    ⟨q, R, hR⟩
  let raysQ : Fin q → Fin k → ℚ := fun j i ↦ R i j
  let raysInt : Fin q → Fin k → ℤ :=
    fun j ↦ common_denominator_scaled_vector (raysQ j)
  refine ⟨q, raysInt, ?_⟩
  -- The real right-hand side disappears in the homogeneous recession system.
  calc
    recessionCone (polyhedron_le_set (M.map (Rat.castHom ℝ)) β)
        = matrix_polyhedral_cone (M.map (Rat.castHom ℝ)) := by
            simpa [matrix_polyhedral_cone] using
              polyhedron_recessionCone_eq_homogeneous_solution_set
                (M.map (Rat.castHom ℝ)) β h_nonempty
    _ = (matrix_cone (R.map (Rat.castHom ℝ)) : Set (Fin k → ℝ)) := hR
    _ = finitely_generated_cone
          (fun j : Fin q ↦ fun i : Fin k ↦ (raysQ j i : ℝ)) := by
            simpa [raysQ] using
              (finitely_generated_cone_eq_matrix_cone
                (fun j : Fin q ↦ fun i : Fin k ↦ (raysQ j i : ℝ))).symm
    _ = finitely_generated_cone
          (fun j : Fin q ↦ fun i : Fin k ↦ (raysInt j i : ℝ)) := by
            simpa [raysInt, raysQ] using
              (commonDenominatorScaledRays_eq_finitely_generated_cone
                (r := raysQ)).symm

/-- Helper for Remark 4.32: `integerVectors` is the standard coordinate lattice generated by the
coordinate basis. -/
private lemma integerVectors_eq_zspan_piBasis (k : ℕ) :
    integerVectors k =
      (Submodule.span ℤ (Set.range (Pi.basisFun ℝ (Fin k))) : Set (Fin k → ℝ)) := by
  ext x
  constructor
  · rintro ⟨z, rfl⟩
    -- The integer coordinates are exactly the coordinates of the vector on the standard basis.
    change (Int.cast ∘ z : Fin k → ℝ) ∈
      Submodule.span ℤ (Set.range (Pi.basisFun ℝ (Fin k)))
    rw [(Pi.basisFun ℝ (Fin k)).mem_span_iff_repr_mem ℤ]
    intro i
    exact ⟨z i, by simp [Pi.basisFun_repr]⟩
  · intro hx
    -- Integral coordinates on the standard basis reconstruct the real integer vector.
    change x ∈ Submodule.span ℤ (Set.range (Pi.basisFun ℝ (Fin k))) at hx
    rw [(Pi.basisFun ℝ (Fin k)).mem_span_iff_repr_mem ℤ] at hx
    choose z hz using hx
    refine ⟨z, ?_⟩
    ext i
    simpa [Pi.basisFun_repr] using hz i

/-- Helper for Remark 4.32: the rows inherited from the original matrix are unchanged after
adjoining the fixed-leading-block inequalities. -/
private lemma fixedFirstBlockRows_mulVec_original
    {n p m : ℕ}
    (M : Matrix (Fin m) (Fin (n + p)) ℝ)
    (u : Fin (n + p) → ℝ)
    (i : Fin m) :
    (Fin.append M
        (Fin.append
          (fun i : Fin n ↦ fun j : Fin (n + p) ↦
            if j = Fin.castAdd p i then 1 else 0)
          (fun i : Fin n ↦ fun j : Fin (n + p) ↦
            if j = Fin.castAdd p i then -1 else 0)) *ᵥ u)
        (Fin.castAdd (n + n) i) =
      (M *ᵥ u) i := by
  simp [Matrix.mulVec, dotProduct]

/-- Helper for Remark 4.32: adjoining a fixed leading block adds the upper coordinate rows for
that block. -/
private lemma fixedFirstBlockRows_mulVec_upper
    {n p m : ℕ}
    (M : Matrix (Fin m) (Fin (n + p)) ℝ)
    (u : Fin (n + p) → ℝ)
    (i : Fin n) :
    (Fin.append M
        (Fin.append
          (fun i : Fin n ↦ fun j : Fin (n + p) ↦
            if j = Fin.castAdd p i then 1 else 0)
          (fun i : Fin n ↦ fun j : Fin (n + p) ↦
            if j = Fin.castAdd p i then -1 else 0)) *ᵥ u)
        (Fin.natAdd m (Fin.castAdd n i)) =
      u (Fin.castAdd p i) := by
  rw [Matrix.mulVec, dotProduct, Fin.append_right, Fin.append_left]
  simp [Pi.single_apply]

/-- Helper for Remark 4.32: adjoining a fixed leading block adds the lower coordinate rows for
that block. -/
private lemma fixedFirstBlockRows_mulVec_lower
    {n p m : ℕ}
    (M : Matrix (Fin m) (Fin (n + p)) ℝ)
    (u : Fin (n + p) → ℝ)
    (i : Fin n) :
    (Fin.append M
        (Fin.append
          (fun i : Fin n ↦ fun j : Fin (n + p) ↦
            if j = Fin.castAdd p i then 1 else 0)
          (fun i : Fin n ↦ fun j : Fin (n + p) ↦
            if j = Fin.castAdd p i then -1 else 0)) *ᵥ u)
        (Fin.natAdd m (Fin.natAdd n i)) =
      -u (Fin.castAdd p i) := by
  rw [Matrix.mulVec, dotProduct, Fin.append_right, Fin.append_right]
  simp [Pi.single_apply]

/-- Helper for Remark 4.32: the right-hand sides inherited from the original system are unchanged
after adjoining the fixed-leading-block inequalities. -/
private lemma fixedFirstBlockRhs_original
    {n m : ℕ}
    (b : Fin m → ℝ)
    (z : Fin n → ℝ)
    (i : Fin m) :
    Fin.append b (Fin.append z (fun i ↦ -z i)) (Fin.castAdd (n + n) i) = b i := by
  simp

/-- Helper for Remark 4.32: the upper right-hand side for a fixed leading coordinate is that
coordinate. -/
private lemma fixedFirstBlockRhs_upper
    {n m : ℕ}
    (b : Fin m → ℝ)
    (z : Fin n → ℝ)
    (i : Fin n) :
    Fin.append b (Fin.append z (fun i ↦ -z i))
        (Fin.natAdd m (Fin.castAdd n i)) = z i := by
  simp

/-- Helper for Remark 4.32: the lower right-hand side for a fixed leading coordinate is its
negation. -/
private lemma fixedFirstBlockRhs_lower
    {n m : ℕ}
    (b : Fin m → ℝ)
    (z : Fin n → ℝ)
    (i : Fin n) :
    Fin.append b (Fin.append z (fun i ↦ -z i))
        (Fin.natAdd m (Fin.natAdd n i)) = -z i := by
  rw [Fin.append_right, Fin.append_right]

/-- Helper for Remark 4.32: fixing the leading `n` coordinates of a matrix polyhedron gives a
matrix polyhedron. -/
private lemma isPolyhedron_fixedFirstBlock
    {n p : ℕ} {P : Set (Fin (n + p) → ℝ)}
    (hP : is_polyhedron P)
    (z : Fin n → ℝ) :
    is_polyhedron
      (P ∩ {u : Fin (n + p) → ℝ | ∀ i : Fin n, u (Fin.castAdd p i) = z i}) := by
  rcases hP with ⟨m, M, b, rfl⟩
  let A : Matrix (Fin (m + (n + n))) (Fin (n + p)) ℝ :=
    Fin.append M
        (Fin.append
          (fun i j ↦ if j = Fin.castAdd p i then 1 else 0)
          (fun i j ↦ if j = Fin.castAdd p i then -1 else 0))
  let c : Fin (m + (n + n)) → ℝ :=
    Fin.append b
      (Fin.append (fun i ↦ z i) (fun i ↦ -z i))
  refine ⟨m + (n + n), A, c, ?_⟩
  ext u
  rw [Set.mem_inter_iff, mem_polyhedron_le_set_iff, mem_polyhedron_le_set_iff]
  constructor
  · rintro ⟨huP, huFix⟩ r
    refine Fin.addCases ?_ ?_ r
    · intro i
      rw [fixedFirstBlockRows_mulVec_original]
      simpa [c, fixedFirstBlockRhs_original, polyhedron_le_set] using huP i
    · intro r'
      refine Fin.addCases ?_ ?_ r'
      · intro i
        have hi : u (Fin.castAdd p i) = z i := huFix i
        rw [fixedFirstBlockRows_mulVec_upper, hi]
        have hc : c (Fin.natAdd m (Fin.castAdd n i)) = z i := by
          simpa [c] using fixedFirstBlockRhs_upper (n := n) (m := m) b z i
        rw [hc]
      · intro i
        have hi : u (Fin.castAdd p i) = z i := huFix i
        rw [fixedFirstBlockRows_mulVec_lower, hi]
        have hc : c (Fin.natAdd m (Fin.natAdd n i)) = -z i := by
          simpa [c] using fixedFirstBlockRhs_lower (n := n) (m := m) b z i
        rw [hc]
  · intro hu
    constructor
    · intro i
      have hi := hu (Fin.castAdd (n + n) i)
      rw [fixedFirstBlockRows_mulVec_original] at hi
      simpa [c, fixedFirstBlockRhs_original, polyhedron_le_set] using hi
    · intro i
      have hUpper := hu (Fin.natAdd m (Fin.castAdd n i))
      have hLower := hu (Fin.natAdd m (Fin.natAdd n i))
      have hUpper' : u (Fin.castAdd p i) ≤ z i := by
        rw [fixedFirstBlockRows_mulVec_upper] at hUpper
        have hc : c (Fin.natAdd m (Fin.castAdd n i)) = z i := by
          simpa [c] using fixedFirstBlockRhs_upper (n := n) (m := m) b z i
        rw [hc] at hUpper
        exact hUpper
      have hLower' : -u (Fin.castAdd p i) ≤ -z i := by
        rw [fixedFirstBlockRows_mulVec_lower] at hLower
        have hc : c (Fin.natAdd m (Fin.natAdd n i)) = -z i := by
          simpa [c] using fixedFirstBlockRhs_lower (n := n) (m := m) b z i
        rw [hc] at hLower
        exact hLower
      exact le_antisymm hUpper' (neg_le_neg_iff.mp hLower')

/-- Helper for Remark 4.32: the rational matrix whose real coercion is the flattened rational
mixed constraint matrix. -/
private def rationalMixedConstraintMatrix
    {m n p : ℕ}
    (A : Matrix (Fin m) (Fin n) ℚ)
    (G : Matrix (Fin m) (Fin p) ℚ) :
    Matrix (Fin m) (Fin (n + p)) ℚ :=
  fun i ↦ Fin.addCases (A i) (G i)

/-- Helper for Remark 4.32: coercing the rational flattened constraint matrix gives the flattened
constraint matrix of the coerced blocks. -/
private lemma rationalMixedConstraintMatrix_map
    {m n p : ℕ}
    (A : Matrix (Fin m) (Fin n) ℚ)
    (G : Matrix (Fin m) (Fin p) ℚ) :
    (rationalMixedConstraintMatrix A G).map (Rat.castHom ℝ) =
      mixedConstraintMatrix (A.map (Rat.castHom ℝ)) (G.map (Rat.castHom ℝ)) := by
  ext i j
  refine Fin.addCases ?_ ?_ j
  · intro k
    simp [rationalMixedConstraintMatrix, mixedConstraintMatrix]
  · intro k
    simp [rationalMixedConstraintMatrix, mixedConstraintMatrix]

/-- Helper for Remark 4.32: the bounded fractional part of the real cone generated by an integral
ray family. -/
private def fractionalRayBox
    {d q : ℕ}
    (rays : Fin q → Fin d → ℤ) :
    Set (Fin d → ℝ) :=
  (fun μ : Fin q → ℝ ↦ ∑ j : Fin q, μ j • (fun i : Fin d ↦ (rays j i : ℝ))) ''
    Set.univ.pi (fun _ : Fin q ↦ Set.Icc (0 : ℝ) 1)

/-- Helper for Remark 4.32: the closed unit box is the convex hull of its finitely many zero-one
vertices. -/
private lemma unitBox_eq_convexHull_zeroOneCube (d : ℕ) :
    Set.univ.pi (fun _ : Fin d ↦ Set.Icc (0 : ℝ) 1) =
      convexHull ℝ (zero_one_cube d) := by
  let U : Set (Fin d → ℝ) := Set.univ.pi (fun _ : Fin d ↦ Set.Icc (0 : ℝ) 1)
  let cubeVertex : (Fin d → Bool) → Fin d → ℝ :=
    fun b j ↦ if b j then 1 else 0
  have hCubeRange : zero_one_cube d = Set.range cubeVertex := by
    ext x
    rw [mem_zero_one_cube_iff]
    constructor
    · intro hx
      let b : Fin d → Bool := fun j ↦ x j = 1
      refine ⟨b, ?_⟩
      ext j
      by_cases hbj : b j
      · have hxj : x j = 1 := by simpa [b] using hbj
        simp [cubeVertex, hbj, hxj]
      · have hxj : x j = 0 := by
          rcases hx j with hzero | hone
          · exact hzero
          · exact False.elim (hbj (by simp [b, hone]))
        simp [cubeVertex, hbj, hxj]
    · rintro ⟨b, rfl⟩ j
      by_cases hbj : b j
      · right
        simp [cubeVertex, hbj]
      · left
        simp [cubeVertex, hbj]
  have hCompact : IsCompact U := by
    exact isCompact_univ_pi fun _ ↦ isCompact_Icc
  have hConvex : Convex ℝ U := by
    exact convex_pi fun _ _ ↦ convex_Icc (0 : ℝ) 1
  have hExtremeFinite : (U.extremePoints ℝ).Finite := by
    rw [extremePoints_unit_box_eq_zero_one_cube, hCubeRange]
    exact Set.finite_range cubeVertex
  calc
    U = closure (convexHull ℝ (U.extremePoints ℝ)) := by
          simpa using (closure_convexHull_extremePoints hCompact hConvex).symm
    _ = convexHull ℝ (U.extremePoints ℝ) := by
          rw [(hExtremeFinite.isClosed_convexHull ℝ).closure_eq]
    _ = convexHull ℝ (zero_one_cube d) := by
          rw [extremePoints_unit_box_eq_zero_one_cube]

/-- Helper for Remark 4.32: the fractional ray box is a polytope. -/
private lemma fractionalRayBox_isPolytope
    {d q : ℕ}
    (rays : Fin q → Fin d → ℤ) :
    (fractionalRayBox rays).IsPolytope ℝ := by
  let cubeVertex : (Fin q → Bool) → Fin q → ℝ :=
    fun b j ↦ if b j then 1 else 0
  have hCubeRange : zero_one_cube q = Set.range cubeVertex := by
    ext x
    rw [mem_zero_one_cube_iff]
    constructor
    · intro hx
      let b : Fin q → Bool := fun j ↦ x j = 1
      refine ⟨b, ?_⟩
      ext j
      by_cases hbj : b j
      · have hxj : x j = 1 := by simpa [b] using hbj
        simp [cubeVertex, hbj, hxj]
      · have hxj : x j = 0 := by
          rcases hx j with hzero | hone
          · exact hzero
          · exact False.elim (hbj (by simp [b, hone]))
        simp [cubeVertex, hbj, hxj]
    · rintro ⟨b, rfl⟩ j
      by_cases hbj : b j
      · right
        simp [cubeVertex, hbj]
      · left
        simp [cubeVertex, hbj]
  let L : (Fin q → ℝ) →ₗ[ℝ] (Fin d → ℝ) :=
    { toFun := fun μ ↦ ∑ j : Fin q, μ j • (fun i : Fin d ↦ (rays j i : ℝ))
      map_add' := by
        intro μ ν
        ext i
        simp [Pi.add_apply, add_smul, Finset.sum_add_distrib]
      map_smul' := by
        intro a μ
        ext i
        simp [Pi.smul_apply, smul_eq_mul, Finset.mul_sum, mul_assoc] }
  let vertex : (Fin q → Bool) → Fin d → ℝ := fun b i ↦
    ∑ j : Fin q, cubeVertex b j * (rays j i : ℝ)
  have hL_apply (μ : Fin q → ℝ) :
      L μ = ∑ j : Fin q, μ j • (fun i : Fin d ↦ (rays j i : ℝ)) := by
    dsimp [L]
  have hRange : L '' Set.range cubeVertex = Set.range vertex := by
    ext x
    constructor
    · rintro ⟨μ, ⟨b, rfl⟩, rfl⟩
      refine ⟨b, ?_⟩
      rw [hL_apply]
      ext i
      simp [vertex, Pi.smul_apply, smul_eq_mul]
    · rintro ⟨b, rfl⟩
      refine ⟨cubeVertex b, ⟨b, rfl⟩, ?_⟩
      rw [hL_apply]
      ext i
      simp [vertex, Pi.smul_apply, smul_eq_mul]
  refine ⟨Set.range vertex, Set.finite_range vertex, ?_⟩
  calc
    fractionalRayBox rays
        = L '' Set.univ.pi (fun _ : Fin q ↦ Set.Icc (0 : ℝ) 1) := rfl
    _ = L '' convexHull ℝ (zero_one_cube q) := by
          rw [unitBox_eq_convexHull_zeroOneCube]
    _ = L '' convexHull ℝ (Set.range cubeVertex) := by
          rw [hCubeRange]
    _ = convexHull ℝ (L '' Set.range cubeVertex) := by
          rw [L.image_convexHull]
    _ = convexHull ℝ (Set.range vertex) := by
          rw [hRange]

/-- Helper for Remark 4.32: the Minkowski sum of two polytopes is a polytope. -/
private lemma isPolytope_add
    {d : ℕ} {P Q : Set (Fin d → ℝ)}
    (hP : P.IsPolytope ℝ)
    (hQ : Q.IsPolytope ℝ) :
    (P + Q).IsPolytope ℝ := by
  rcases exists_convexHull_range_eq_of_isPolytope hP with ⟨p, verticesP, hP⟩
  rcases exists_convexHull_range_eq_of_isPolytope hQ with ⟨q, verticesQ, hQ⟩
  let vertices : Fin p × Fin q → Fin d → ℝ :=
    fun ij ↦ verticesP ij.1 + verticesQ ij.2
  refine ⟨Set.range vertices, Set.finite_range vertices, ?_⟩
  calc
    P + Q = convexHull ℝ (Set.range verticesP) +
        convexHull ℝ (Set.range verticesQ) := by
          rw [hP, hQ]
    _ = convexHull ℝ (Set.range verticesP + Set.range verticesQ) := by
          rw [convexHull_add]
    _ = convexHull ℝ (Set.range vertices) := by
          congr 1
          ext x
          simp [vertices, Set.mem_add]

/-- Helper for Remark 4.32: every polytope is a polyhedron, using the empty cone in the
Minkowski-Weyl representation. -/
private lemma isPolyhedron_of_isPolytope
    {d : ℕ} {Q : Set (Fin d → ℝ)}
    (hQ : Q.IsPolytope ℝ) :
    is_polyhedron Q := by
  refine (is_polyhedron_iff_eq_polytope_add_finitely_generated_cone).2
    ⟨Q, hQ, 0, Fin.elim0, ?_⟩
  ext x
  constructor
  · intro hx
    exact ⟨x, hx, 0, by simp, by simp⟩
  · rintro ⟨y, hy, z, hz, hEq⟩
    have hz0 : z = 0 := by
      simpa [finitely_generated_cone] using hz
    have hyx : y = x := by
      simpa [hz0] using hEq
    simpa [hyx] using hy

/-- Helper for Remark 4.32: a nonempty bounded set has only the zero recession direction. -/
private lemma recessionCone_eq_singleton_zero_of_nonempty_bounded
    {d : ℕ}
    {P : Set (Fin d → ℝ)}
    (hP_nonempty : P.Nonempty)
    (hP_bounded : Bornology.IsBounded P) :
    recessionCone P = ({0} : Set (Fin d → ℝ)) := by
  obtain ⟨x₀, hx₀⟩ := hP_nonempty
  have htranslate : ({x₀} + recessionCone P) ⊆ P := by
    rintro y ⟨x, hx, r, hr, rfl⟩
    rw [Set.mem_singleton_iff] at hx
    subst hx
    rw [mem_recessionCone_iff] at hr
    simpa using hr hx₀ 1 zero_le_one
  have hrec_bounded : Bornology.IsBounded (recessionCone P) := by
    obtain ⟨R, -, hP_ball⟩ := hP_bounded.subset_ball_lt 0 (0 : Fin d → ℝ)
    refine Bornology.IsBounded.subset
      (show Bornology.IsBounded (Metric.ball (0 : Fin d → ℝ) (R + ‖x₀‖)) from
        Metric.isBounded_ball) ?_
    intro r hr
    have hxrP : x₀ + r ∈ P :=
      htranslate ⟨x₀, Set.mem_singleton x₀, r, hr, by simp⟩
    have hxr_ball : ‖x₀ + r‖ < R := by
      simpa [Metric.mem_ball, dist_eq_norm] using hP_ball hxrP
    have hr_eq : r = (x₀ + r) + (-x₀) := by
      ext i
      simp
    have hr_norm_le : ‖r‖ ≤ ‖x₀ + r‖ + ‖x₀‖ := by
      rw [hr_eq]
      simpa using norm_add_le (x₀ + r) (-x₀)
    have hr_norm_lt : ‖r‖ < R + ‖x₀‖ := by
      linarith
    simpa [Metric.mem_ball, dist_eq_norm] using hr_norm_lt
  ext r
  constructor
  · intro hr
    by_cases hr0 : r = 0
    · simp [hr0]
    · obtain ⟨R, hR⟩ := hrec_bounded.subset_closedBall (0 : Fin d → ℝ)
      have hzero_mem : (0 : Fin d → ℝ) ∈ recessionCone P := zero_mem_recessionCone
      have hR_nonneg : 0 ≤ R := by
        have hzero_ball :
            (0 : Fin d → ℝ) ∈ Metric.closedBall (0 : Fin d → ℝ) R := hR hzero_mem
        simpa [Metric.mem_closedBall] using hzero_ball
      have hr_norm_pos : 0 < ‖r‖ := norm_pos_iff.mpr hr0
      have hr_norm_ne : ‖r‖ ≠ 0 := ne_of_gt hr_norm_pos
      have ht_nonneg : 0 ≤ R / ‖r‖ + 1 := by positivity
      have htr_mem : (R / ‖r‖ + 1) • r ∈ recessionCone P :=
        smul_mem_recessionCone hr ht_nonneg
      have hmem_ball :
          (R / ‖r‖ + 1) • r ∈ Metric.closedBall (0 : Fin d → ℝ) R :=
        hR htr_mem
      have htr_bound : ‖(R / ‖r‖ + 1) • r‖ ≤ R := by
        simpa [Metric.mem_closedBall, dist_eq_norm] using hmem_ball
      have htr_norm : ‖(R / ‖r‖ + 1) • r‖ = R + ‖r‖ := by
        calc
          ‖(R / ‖r‖ + 1) • r‖ = |R / ‖r‖ + 1| * ‖r‖ := norm_smul _ _
          _ = (R / ‖r‖ + 1) * ‖r‖ := by rw [abs_of_nonneg ht_nonneg]
          _ = (R / ‖r‖) * ‖r‖ + ‖r‖ := by rw [add_mul, one_mul]
          _ = R + ‖r‖ := by rw [div_mul_cancel₀ _ hr_norm_ne]
      have hlarge : R + ‖r‖ ≤ R := by
        simpa [htr_norm] using htr_bound
      linarith
  · intro hr
    have hr0 : r = 0 := Set.mem_singleton_iff.mp hr
    subst hr0
    exact zero_mem_recessionCone

/-- Helper for Remark 4.32: a bounded polyhedron is a polytope. -/
private lemma isPolytope_of_isPolyhedron_bounded
    {d : ℕ}
    {P : Set (Fin d → ℝ)}
    (hP_polyhedron : is_polyhedron P)
    (hP_bounded : Bornology.IsBounded P) :
    P.IsPolytope ℝ := by
  by_cases hP_nonempty : P.Nonempty
  · rcases hP_polyhedron with ⟨m, A, b, hP_eq⟩
    rcases (is_polyhedron_iff_eq_polytope_add_finitely_generated_cone).1
      (show is_polyhedron P from ⟨m, A, b, hP_eq⟩) with
      ⟨Q, hQ, q, rays, hP_decomp⟩
    rcases exists_convexHull_range_eq_of_isPolytope hQ with
      ⟨p, vertices, hQ_vertices⟩
    have hnonemptyMatrix : Set.Nonempty (polyhedron_le_set A b) := by
      rw [← hP_eq]
      exact hP_nonempty
    have hP_decompPolyhedron :
        polyhedron_le_set A b = convexHull ℝ (Set.range vertices) +
          finitely_generated_cone rays := by
      calc
        polyhedron_le_set A b = P := hP_eq.symm
        _ = Q + finitely_generated_cone rays := hP_decomp
        _ = convexHull ℝ (Set.range vertices) + finitely_generated_cone rays := by
              rw [hQ_vertices]
    have hrecessionRays :
        recessionCone (polyhedron_le_set A b) = finitely_generated_cone rays :=
      polyhedron_recessionCone_eq_finitely_generated_cone
        A b vertices rays hnonemptyMatrix hP_decompPolyhedron
    have hP_recession_zero : recessionCone P = ({0} : Set (Fin d → ℝ)) :=
      recessionCone_eq_singleton_zero_of_nonempty_bounded hP_nonempty hP_bounded
    have hcone_zero : finitely_generated_cone rays = ({0} : Set (Fin d → ℝ)) := by
      calc
        finitely_generated_cone rays = recessionCone (polyhedron_le_set A b) :=
          hrecessionRays.symm
        _ = recessionCone P := by rw [hP_eq]
        _ = ({0} : Set (Fin d → ℝ)) := hP_recession_zero
    have hP_eq_Q : P = Q := by
      calc
        P = Q + finitely_generated_cone rays := hP_decomp
        _ = Q + ({0} : Set (Fin d → ℝ)) := by rw [hcone_zero]
        _ = Q := by
              ext x
              constructor
              · intro hx
                rcases Set.mem_add.mp hx with ⟨y, hy, z, hz, hsum⟩
                have hz0 : z = 0 := Set.mem_singleton_iff.mp hz
                have hyx : y = x := by simpa [hz0] using hsum
                simpa [hyx] using hy
              · intro hx
                exact Set.mem_add.mpr ⟨x, hx, 0, Set.mem_singleton 0, by simp⟩
    simpa [hP_eq_Q] using hQ
  · have hP_empty : P = ∅ := Set.not_nonempty_iff_eq_empty.mp hP_nonempty
    refine ⟨∅, Set.finite_empty, ?_⟩
    simp [hP_empty]

/-- Helper for Remark 4.32: the real cone generated by integral rays is the Minkowski sum of a
bounded fractional box and the integral cone on the same rays. -/
private lemma finitelyGeneratedCone_eq_fractionalRayBox_add_integralIntcone
    {d q : ℕ}
    (rays : Fin q → Fin d → ℤ) :
    finitely_generated_cone (fun j : Fin q ↦ fun i : Fin d ↦ (rays j i : ℝ)) =
      fractionalRayBox rays + integral_intcone rays := by
  ext x
  constructor
  · intro hx
    rcases (mem_finitely_generated_cone_iff).1 hx with ⟨μ, hμ_nonneg, hrepr⟩
    let multiplicity : Fin q → ℕ := fun j ↦ ⌊μ j⌋₊
    let fractional : Fin q → ℝ := fun j ↦ μ j - multiplicity j
    have hmultiplicity_cast :
        ∀ j : Fin q, (multiplicity j : ℝ) = Int.floor (μ j) := by
      intro j
      dsimp [multiplicity]
      exact natCast_floor_eq_intCast_floor (hμ_nonneg j)
    have hfractional_mem :
        fractional ∈ Set.univ.pi (fun _ : Fin q ↦ Set.Icc (0 : ℝ) 1) := by
      rw [Set.mem_univ_pi]
      intro j
      constructor
      · have hfloor_le : (Int.floor (μ j) : ℝ) ≤ μ j := Int.floor_le (μ j)
        dsimp [fractional]
        rw [hmultiplicity_cast j]
        linarith
      · have hlt : μ j < Int.floor (μ j) + 1 := Int.lt_floor_add_one (μ j)
        dsimp [fractional]
        rw [hmultiplicity_cast j]
        linarith
    refine Set.mem_add.2 ⟨
      ∑ j : Fin q, fractional j • (fun i : Fin d ↦ (rays j i : ℝ)),
      ⟨fractional, hfractional_mem, rfl⟩,
      ∑ j : Fin q, (multiplicity j : ℝ) • (fun i : Fin d ↦ (rays j i : ℝ)),
      (mem_integral_intcone_iff).2 ⟨multiplicity, rfl⟩, ?_⟩
    have hsplit : ∀ j : Fin q, μ j = fractional j + (multiplicity j : ℝ) := by
      intro j
      dsimp [fractional]
      linarith
    ext i
    rw [hrepr]
    simp only [Pi.add_apply, Finset.sum_apply, Pi.smul_apply]
    calc
      ∑ j : Fin q, fractional j * (rays j i : ℝ) +
          ∑ j : Fin q, (multiplicity j : ℝ) * (rays j i : ℝ)
          = ∑ j : Fin q, (fractional j + (multiplicity j : ℝ)) * (rays j i : ℝ) := by
              simp [add_mul, Finset.sum_add_distrib]
      _ = ∑ j : Fin q, μ j * (rays j i : ℝ) := by
            refine Finset.sum_congr rfl ?_
            intro j _
            rw [← hsplit j]
  · rintro ⟨u, hu, c, hc, rfl⟩
    rcases hu with ⟨μ, hμ, rfl⟩
    rcases (mem_integral_intcone_iff).1 hc with ⟨a, rfl⟩
    refine (mem_finitely_generated_cone_iff).2 ?_
    refine ⟨fun j ↦ μ j + (a j : ℝ), ?_, ?_⟩
    · intro j
      have hμj : μ j ∈ Set.Icc (0 : ℝ) 1 := by
        simpa [Set.mem_univ_pi] using hμ j
      exact add_nonneg hμj.1 (by positivity)
    · ext i
      simp [Pi.add_apply, Pi.smul_apply, add_smul, Finset.sum_add_distrib]

/-- Helper for Remark 4.32: the first-block integer condition. -/
private def firstBlockIntegerSet (n p : ℕ) : Set (Fin (n + p) → ℝ) :=
  {u | (fun i : Fin n ↦ u (Fin.castAdd p i)) ∈ integerVectors n}

/-- Helper for Remark 4.32: integral first blocks are closed under addition. -/
private lemma integerVectors_add
    {n : ℕ} {u v : Fin n → ℝ}
    (hu : u ∈ integerVectors n)
    (hv : v ∈ integerVectors n) :
    u + v ∈ integerVectors n := by
  rcases (mem_integerVectors_iff).1 hu with ⟨a, rfl⟩
  rcases (mem_integerVectors_iff).1 hv with ⟨b, rfl⟩
  refine (mem_integerVectors_iff).2 ⟨fun i ↦ a i + b i, ?_⟩
  funext i
  simp

/-- Helper for Remark 4.32: integral first blocks are closed under subtraction. -/
private lemma integerVectors_sub
    {n : ℕ} {u v : Fin n → ℝ}
    (hu : u ∈ integerVectors n)
    (hv : v ∈ integerVectors n) :
    u - v ∈ integerVectors n := by
  rcases (mem_integerVectors_iff).1 hu with ⟨a, rfl⟩
  rcases (mem_integerVectors_iff).1 hv with ⟨b, rfl⟩
  refine (mem_integerVectors_iff).2 ⟨fun i ↦ a i - b i, ?_⟩
  funext i
  simp

/-- Helper for Remark 4.32: every point in an integral ray cone has an integral first block. -/
private lemma firstBlock_mem_integerVectors_of_mem_integralIntcone
    {n p q : ℕ}
    {rays : Fin q → Fin (n + p) → ℤ}
    {u : Fin (n + p) → ℝ}
    (hu : u ∈ integral_intcone rays) :
    (fun i : Fin n ↦ u (Fin.castAdd p i)) ∈ integerVectors n := by
  rcases (mem_integral_intcone_iff).1 hu with ⟨a, rfl⟩
  refine (mem_integerVectors_iff).2
    ⟨fun i : Fin n ↦ ∑ j : Fin q, (a j : ℤ) * rays j (Fin.castAdd p i), ?_⟩
  funext i
  simp [Pi.smul_apply, smul_eq_mul, mul_comm, mul_left_comm, mul_assoc]

/-- Helper for Remark 4.32: cutting out finitely many first-block fibers of a bounded mixed set
leaves a base whose convex hull is a polytope. -/
private lemma isPolytope_convexHull_iUnion
    {d k : ℕ}
    (Q : Fin k → Set (Fin d → ℝ))
    (hQ : ∀ i, (Q i).IsPolytope ℝ) :
    (convexHull ℝ (⋃ i : Fin k, Q i)).IsPolytope ℝ := by
  classical
  choose t vertices hvertices using fun i ↦
    exists_convexHull_range_eq_of_isPolytope (hQ i)
  let allVertices : Sigma (fun i : Fin k ↦ Fin (t i)) → Fin d → ℝ :=
    fun a ↦ vertices a.1 a.2
  have hrange_subset : Set.range allVertices ⊆ ⋃ i : Fin k, Q i := by
    rintro x ⟨a, rfl⟩
    exact Set.mem_iUnion.2 ⟨a.1, by
      rw [hvertices a.1]
      exact subset_convexHull ℝ _ ⟨a.2, rfl⟩⟩
  have hunion_subset :
      (⋃ i : Fin k, Q i) ⊆ convexHull ℝ (Set.range allVertices) := by
    intro x hx
    rcases Set.mem_iUnion.1 hx with ⟨i, hx⟩
    rw [hvertices i] at hx
    refine (convexHull_mono ?_) hx
    rintro y ⟨j, rfl⟩
    exact ⟨⟨i, j⟩, rfl⟩
  refine ⟨Set.range allVertices, Set.finite_range allVertices, ?_⟩
  apply Set.Subset.antisymm
  · exact convexHull_min hunion_subset (convex_convexHull ℝ _)
  · refine convexHull_min ?_ (convex_convexHull ℝ _)
    intro x hx
    exact subset_convexHull ℝ _ (hrange_subset hx)

/-- Helper for Remark 4.32: once the flattened ambient set is a polytope translated by an integral
cone, its flattened mixed-integer points are the integer slice of the polytope translated by that
same cone. -/
private lemma flattenedMixedIntegerPoints_eq_baseSlice_add_integralIntcone
    {n p q : ℕ}
    {P : Set (MixedRealPoint n p)}
    {Q : Set (Fin (n + p) → ℝ)}
    {rays : Fin q → Fin (n + p) → ℤ}
    (hdecomp : Fin.appendEquiv n p '' P = Q + integral_intcone rays) :
    Fin.appendEquiv n p '' mixed_integer_points P =
      (Q ∩ firstBlockIntegerSet n p) + integral_intcone rays := by
  ext u
  constructor
  · intro hu
    rcases (mem_flattened_mixed_integer_points_iff (P := P) (u := u)).1 hu with
      ⟨huP, huInt⟩
    rw [hdecomp] at huP
    rcases Set.mem_add.1 huP with ⟨q, hqQ, c, hc, rfl⟩
    refine Set.mem_add.2 ⟨q, ?_, c, hc, rfl⟩
    refine ⟨hqQ, ?_⟩
    have hqcInt :
        (fun i : Fin n ↦ (q + c) (Fin.castAdd p i)) ∈ integerVectors n := by
      simpa [firstBlockIntegerSet] using huInt
    have hcInt :
        (fun i : Fin n ↦ c (Fin.castAdd p i)) ∈ integerVectors n :=
      firstBlock_mem_integerVectors_of_mem_integralIntcone hc
    have hqEq :
        (fun i : Fin n ↦ q (Fin.castAdd p i)) =
          (fun i : Fin n ↦ (q + c) (Fin.castAdd p i)) -
            fun i : Fin n ↦ c (Fin.castAdd p i) := by
      funext i
      simp [Pi.sub_apply]
    have hqInt :
        (fun i : Fin n ↦ q (Fin.castAdd p i)) ∈ integerVectors n := by
      rw [hqEq]
      exact integerVectors_sub hqcInt hcInt
    simpa [firstBlockIntegerSet] using hqInt
  · rintro ⟨q, hq, c, hc, rfl⟩
    rcases hq with ⟨hqQ, hqInt⟩
    refine (mem_flattened_mixed_integer_points_iff (P := P)).2 ⟨?_, ?_⟩
    · rw [hdecomp]
      exact Set.mem_add.2 ⟨q, hqQ, c, hc, rfl⟩
    · have hcInt :
          (fun i : Fin n ↦ c (Fin.castAdd p i)) ∈ integerVectors n :=
        firstBlock_mem_integerVectors_of_mem_integralIntcone hc
      have hqInt' :
          (fun i : Fin n ↦ q (Fin.castAdd p i)) ∈ integerVectors n := by
        simpa [firstBlockIntegerSet] using hqInt
      simpa [Pi.add_apply] using integerVectors_add hqInt' hcInt

/-- Helper for Remark 4.32: the integer slice of a bounded polytope has a polytope convex hull.
The projection to the first block is bounded, so it meets the integer lattice in only finitely many
points; each resulting fixed-coordinate fiber is a bounded polyhedron. -/
private lemma isPolytope_convexHull_firstBlockIntegerSlice
    {n p : ℕ}
    {R : Set (Fin (n + p) → ℝ)}
    (hR : R.IsPolytope ℝ) :
    (convexHull ℝ (R ∩ firstBlockIntegerSet n p)).IsPolytope ℝ := by
  classical
  let project : (Fin (n + p) → ℝ) →L[ℝ] (Fin n → ℝ) :=
    ContinuousLinearMap.pi fun i : Fin n ↦
      ContinuousLinearMap.proj (Fin.castAdd p i)
  have hRbounded : Bornology.IsBounded R := by
    -- A polytope is the convex hull of finitely many vertices, hence is bounded.
    rcases hR with ⟨vertices, hvertices, rfl⟩
    exact (isBounded_convexHull).2 hvertices.isBounded
  have hRpolyhedron : is_polyhedron R := isPolyhedron_of_isPolytope hR
  have hfiniteFirstBlocks :
      Set.Finite
        ((project '' R) ∩
          (Submodule.span ℤ (Set.range (Pi.basisFun ℝ (Fin n))) :
            Set (Fin n → ℝ))) := by
    exact
      ZSpan.setFinite_inter (Pi.basisFun ℝ (Fin n))
        (hRbounded.image project)
  have hfiniteIntegerFirstBlocks :
      Set.Finite ((project '' R) ∩ integerVectors n) := by
    rw [integerVectors_eq_zspan_piBasis n]
    exact hfiniteFirstBlocks
  obtain ⟨k, z, -, hz_range⟩ := hfiniteIntegerFirstBlocks.fin_param
  let fibers : Fin k → Set (Fin (n + p) → ℝ) := fun j ↦
    R ∩ {u | ∀ i : Fin n, u (Fin.castAdd p i) = z j i}
  have hslice_eq :
      (R ∩ firstBlockIntegerSet n p) = ⋃ j : Fin k, fibers j := by
    ext u
    constructor
    · intro hu
      have huInt :
          (fun i : Fin n ↦ u (Fin.castAdd p i)) ∈ integerVectors n := by
        simpa [firstBlockIntegerSet] using hu.2
      have huProjected :
          project u ∈ (project '' R) ∩ integerVectors n :=
        ⟨⟨u, hu.1, rfl⟩, huInt⟩
      rw [← hz_range] at huProjected
      rcases huProjected with ⟨j, hj⟩
      refine Set.mem_iUnion.2 ⟨j, hu.1, ?_⟩
      intro i
      simpa [project] using (congrFun hj i).symm
    · intro hu
      rcases Set.mem_iUnion.1 hu with ⟨j, huj⟩
      refine ⟨huj.1, ?_⟩
      have hzj :
          z j ∈ (project '' R) ∩ integerVectors n := by
        rw [← hz_range]
        exact ⟨j, rfl⟩
      rw [firstBlockIntegerSet]
      have hprojection : (fun i : Fin n ↦ u (Fin.castAdd p i)) = z j := by
        funext i
        exact huj.2 i
      change (fun i : Fin n ↦ u (Fin.castAdd p i)) ∈ integerVectors n
      rw [hprojection]
      exact hzj.2
  have hfibers : ∀ j : Fin k, (fibers j).IsPolytope ℝ := by
    intro j
    have hfiberPolyhedron : is_polyhedron (fibers j) := by
      simpa [fibers] using isPolyhedron_fixedFirstBlock hRpolyhedron (z j)
    have hfiberBounded : Bornology.IsBounded (fibers j) := by
      exact hRbounded.subset fun _ hu ↦ hu.1
    exact isPolytope_of_isPolyhedron_bounded hfiberPolyhedron hfiberBounded
  have hHull : (convexHull ℝ (⋃ j : Fin k, fibers j)).IsPolytope ℝ :=
    isPolytope_convexHull_iUnion fibers hfibers
  simpa [hslice_eq] using hHull

/-- Helper for Remark 4.32: a nonempty polyhedron with rational constraint matrix and arbitrary real
right-hand side is a nonempty polytope translated by an integral cone. -/
private lemma flattenedRealRhsPolyhedron_eq_polytope_add_integralCone
    {m n p : ℕ}
    (A : Matrix (Fin m) (Fin n) ℚ)
    (G : Matrix (Fin m) (Fin p) ℚ)
    (b : Fin m → ℝ)
    (h_nonempty :
      Set.Nonempty (rational_matrices_real_rhs_mixed_polyhedron A G b)) :
    ∃ Q : Set (Fin (n + p) → ℝ),
      Q.IsPolytope ℝ ∧
        Q.Nonempty ∧
          ∃ q : ℕ,
            ∃ rays : Fin q → Fin (n + p) → ℤ,
              Fin.appendEquiv n p '' rational_matrices_real_rhs_mixed_polyhedron A G b =
                Q + finitely_generated_cone
                  (fun j : Fin q ↦ fun i : Fin (n + p) ↦ (rays j i : ℝ)) ∧
              recessionCone
                  (Fin.appendEquiv n p ''
                    rational_matrices_real_rhs_mixed_polyhedron A G b) =
                finitely_generated_cone
                  (fun j : Fin q ↦ fun i : Fin (n + p) ↦ (rays j i : ℝ)) := by
  let Pflat : Set (Fin (n + p) → ℝ) :=
    Fin.appendEquiv n p '' rational_matrices_real_rhs_mixed_polyhedron A G b
  let M : Matrix (Fin m) (Fin (n + p)) ℝ :=
    mixedConstraintMatrix (A.map (Rat.castHom ℝ)) (G.map (Rat.castHom ℝ))
  have hPflat_eq : Pflat = polyhedron_le_set M b := by
    simpa [Pflat, M, rational_matrices_real_rhs_mixed_polyhedron] using
      image_real_mixed_polyhedron_eq_polyhedron_le_set
        (A.map (Rat.castHom ℝ)) (G.map (Rat.castHom ℝ)) b
  have hPflat_nonempty : Pflat.Nonempty := by
    rcases h_nonempty with ⟨xy, hxy⟩
    exact ⟨Fin.appendEquiv n p xy, ⟨xy, hxy, rfl⟩⟩
  have hnonemptyMatrix : Set.Nonempty (polyhedron_le_set M b) := by
    rw [← hPflat_eq]
    exact hPflat_nonempty
  have hpolyhedron : is_polyhedron Pflat := ⟨m, M, b, hPflat_eq⟩
  rcases (is_polyhedron_iff_eq_polytope_add_finitely_generated_cone).1 hpolyhedron with
    ⟨Q, hQ, q, realRays, hdecomp⟩
  rcases exists_convexHull_range_eq_of_isPolytope hQ with
    ⟨p', vertices, hQ_vertices⟩
  have hdecompPolyhedron :
      polyhedron_le_set M b =
        convexHull ℝ (Set.range vertices) + finitely_generated_cone realRays := by
    calc
      polyhedron_le_set M b = Pflat := hPflat_eq.symm
      _ = Q + finitely_generated_cone realRays := hdecomp
      _ = convexHull ℝ (Set.range vertices) + finitely_generated_cone realRays := by
            rw [hQ_vertices]
  have hrecessionReal :
      recessionCone Pflat = finitely_generated_cone realRays := by
    calc
      recessionCone Pflat = recessionCone (polyhedron_le_set M b) := by rw [hPflat_eq]
      _ = finitely_generated_cone realRays :=
        polyhedron_recessionCone_eq_finitely_generated_cone
          M b vertices realRays hnonemptyMatrix hdecompPolyhedron
  have hnonemptyRationalMatrix :
      Set.Nonempty
        (polyhedron_le_set
          ((rationalMixedConstraintMatrix A G).map (Rat.castHom ℝ)) b) := by
    rw [rationalMixedConstraintMatrix_map]
    rw [← hPflat_eq]
    exact hPflat_nonempty
  rcases rationalMatrixRealRhs_recessionCone_eq_integralCone
      (rationalMixedConstraintMatrix A G) b hnonemptyRationalMatrix with
    ⟨qInt, integralRays, hrecessionIntegralMatrix⟩
  have hrecessionIntegral :
      recessionCone Pflat =
        finitely_generated_cone
          (fun j : Fin qInt ↦ fun i : Fin (n + p) ↦ (integralRays j i : ℝ)) := by
    calc
      recessionCone Pflat =
          recessionCone
            (polyhedron_le_set
              ((rationalMixedConstraintMatrix A G).map (Rat.castHom ℝ)) b) := by
            rw [hPflat_eq, rationalMixedConstraintMatrix_map]
      _ = finitely_generated_cone
            (fun j : Fin qInt ↦ fun i : Fin (n + p) ↦ (integralRays j i : ℝ)) :=
            hrecessionIntegralMatrix
  have hcone_eq :
      finitely_generated_cone realRays =
        finitely_generated_cone
          (fun j : Fin qInt ↦ fun i : Fin (n + p) ↦ (integralRays j i : ℝ)) :=
    hrecessionReal.symm.trans hrecessionIntegral
  have hQ_nonempty : Q.Nonempty := by
    rcases hPflat_nonempty with ⟨u, hu⟩
    rw [hdecomp] at hu
    rcases Set.mem_add.1 hu with ⟨q, hq, c, -, -⟩
    exact ⟨q, hq⟩
  refine ⟨Q, hQ, hQ_nonempty, qInt, integralRays, ?_, hrecessionIntegral⟩
  calc
    Pflat = Q + finitely_generated_cone realRays := hdecomp
    _ = Q + finitely_generated_cone
          (fun j : Fin qInt ↦ fun i : Fin (n + p) ↦ (integralRays j i : ℝ)) := by
          rw [hcone_eq]

/-- Helper for Remark 4.32: the recession cone of a nonempty polytope translated by a finitely
generated cone is exactly that cone. -/
private lemma recessionCone_polytope_add_finitelyGeneratedCone
    {d q : ℕ}
    {Q : Set (Fin d → ℝ)}
    {rays : Fin q → Fin d → ℝ}
    (hQ : Q.IsPolytope ℝ)
    (hQ_nonempty : Q.Nonempty) :
    recessionCone (Q + finitely_generated_cone rays) = finitely_generated_cone rays := by
  have h_sum_polyhedron : is_polyhedron (Q + finitely_generated_cone rays) :=
    (is_polyhedron_iff_eq_polytope_add_finitely_generated_cone).2
      ⟨Q, hQ, q, rays, rfl⟩
  rcases h_sum_polyhedron with ⟨m, A, b, hpoly_eq⟩
  have hnonempty : Set.Nonempty (polyhedron_le_set A b) := by
    rw [← hpoly_eq]
    rcases hQ_nonempty with ⟨x, hx⟩
    have hzero : (0 : Fin d → ℝ) ∈ finitely_generated_cone rays := cone_zero_mem
    exact ⟨x, Set.mem_add.2 ⟨x, hx, 0, hzero, by simp⟩⟩
  rcases exists_convexHull_range_eq_of_isPolytope hQ with ⟨p, vertices, hvertices⟩
  have hrepr :
      polyhedron_le_set A b =
        convexHull ℝ (Set.range vertices) + finitely_generated_cone rays := by
    rw [← hpoly_eq, hvertices]
  simpa [hpoly_eq] using
    polyhedron_recessionCone_eq_finitely_generated_cone
      A b vertices rays hnonempty hrepr

/-- Helper for Remark 4.32: the mixed point of `ℝ^0 × ℝ^1` whose unique real coordinate is
`√2`. -/
private noncomputable def sqrtTwoMixedPoint : MixedRealPoint 0 1 :=
  (fun i ↦ Fin.elim0 i, ![Real.sqrt 2])

/-- Helper for Remark 4.32: the singleton `{sqrtTwoMixedPoint}` is not a rational mixed
polyhedron. -/
private lemma sqrtTwoMixedPoint_not_rationalMixedPolyhedron :
    ¬ is_rational_mixed_polyhedron ({sqrtTwoMixedPoint} : Set (MixedRealPoint 0 1)) := by
  let x : Fin 1 → ℝ := ![Real.sqrt 2]
  intro hRational
  have hFlat :
      (Fin.appendEquiv 0 1 '' ({sqrtTwoMixedPoint} : Set (MixedRealPoint 0 1))) =
        ({x} : Set (Fin 1 → ℝ)) := by
    -- Flattening the singleton keeps only its unique real coordinate.
    ext u
    simp [sqrtTwoMixedPoint, x, Fin.appendEquiv]
  have hFlatRational : is_rational_polyhedron ({x} : Set (Fin 1 → ℝ)) := by
    -- Rewrite the mixed singleton through its flattened `Fin 1` presentation.
    simpa [is_rational_mixed_polyhedron, hFlat] using hRational
  rcases hFlatRational with ⟨m, A, b, hAb⟩
  have hx_mem : x ∈ polyhedron_le_set (A.map (Rat.castHom ℝ)) (fun i ↦ (b i : ℝ)) := by
    rw [← hAb]
    simp
  have hx_row :
      ∀ i : Fin m, (A i 0 : ℝ) * Real.sqrt 2 ≤ b i := by
    intro i
    have hxi := hx_mem i
    simpa [x, rational_matrix_polyhedron, Matrix.mulVec, dotProduct] using hxi
  let posRows : Finset (Fin m) := Finset.univ.filter fun i : Fin m ↦ 0 < A i 0
  have hpos_nonempty : posRows.Nonempty := by
    by_contra hpos_empty
    have hA_nonpos : ∀ i : Fin m, (A i 0 : ℝ) ≤ 0 := by
      intro i
      have hi_not_pos : ¬ 0 < A i 0 := by
        intro hi_pos
        exact hpos_empty ⟨i, Finset.mem_filter.2 ⟨by simp, hi_pos⟩⟩
      exact_mod_cast le_of_not_gt hi_not_pos
    let xPlus : Fin 1 → ℝ := ![Real.sqrt 2 + 1]
    have hxPlus_mem : xPlus ∈ polyhedron_le_set (A.map (Rat.castHom ℝ)) (fun i ↦ (b i : ℝ)) := by
      intro i
      have hi := hx_row i
      have hAi_nonpos := hA_nonpos i
      simpa [xPlus, rational_matrix_polyhedron, Matrix.mulVec, dotProduct] using
        (by linarith : (A i 0 : ℝ) * (Real.sqrt 2 + 1) ≤ b i)
    rw [← hAb] at hxPlus_mem
    have hxPlus_eq : xPlus = x := Set.mem_singleton_iff.1 hxPlus_mem
    have hcoord := congrFun hxPlus_eq 0
    norm_num [xPlus, x] at hcoord
  have hactive_pos : ∃ i : Fin m, 0 < A i 0 ∧ (A i 0 : ℝ) * Real.sqrt 2 = b i := by
    by_contra hactive
    let δ : Fin m → ℝ := fun i ↦ ((b i : ℝ) - (A i 0 : ℝ) * Real.sqrt 2) / (A i 0 : ℝ)
    let ε : ℝ := (posRows.inf' hpos_nonempty δ) / 2
    have hδ_pos : ∀ i ∈ posRows, 0 < δ i := by
      intro i hi
      have hi_pos : 0 < A i 0 := (Finset.mem_filter.1 hi).2
      have hi_le := hx_row i
      have hi_ne :
          (A i 0 : ℝ) * Real.sqrt 2 ≠ b i := by
        intro hi_eq
        exact hactive ⟨i, hi_pos, hi_eq⟩
      have hi_lt : (A i 0 : ℝ) * Real.sqrt 2 < b i :=
        lt_of_le_of_ne hi_le hi_ne
      have hnum_pos : 0 < (b i : ℝ) - (A i 0 : ℝ) * Real.sqrt 2 := by
        linarith
      have hden_pos : 0 < (A i 0 : ℝ) := by
        exact_mod_cast hi_pos
      dsimp [δ]
      exact div_pos hnum_pos hden_pos
    have hε_pos : 0 < ε := by
      have hInf_pos : 0 < posRows.inf' hpos_nonempty δ := by
        refine (Finset.lt_inf'_iff _).2 ?_
        intro i hi
        exact hδ_pos i hi
      dsimp [ε]
      exact half_pos hInf_pos
    let xPlus : Fin 1 → ℝ := ![Real.sqrt 2 + ε]
    have hxPlus_mem : xPlus ∈ polyhedron_le_set (A.map (Rat.castHom ℝ)) (fun i ↦ (b i : ℝ)) := by
      intro i
      by_cases hi_pos : 0 < A i 0
      · have hi_mem : i ∈ posRows := Finset.mem_filter.2 ⟨by simp, hi_pos⟩
        have hε_le : ε ≤ δ i := by
          dsimp [ε]
          exact
            (half_le_self
              (show 0 ≤ posRows.inf' hpos_nonempty δ from
                le_of_lt ((Finset.lt_inf'_iff _).2 hδ_pos))).trans
              (Finset.inf'_le _ hi_mem)
        have hAi_pos : 0 < (A i 0 : ℝ) := by
          exact_mod_cast hi_pos
        have hi_bound : (A i 0 : ℝ) * ε ≤ (b i : ℝ) - (A i 0 : ℝ) * Real.sqrt 2 := by
          have hδ_eq :
              (A i 0 : ℝ) * δ i = (b i : ℝ) - (A i 0 : ℝ) * Real.sqrt 2 := by
            dsimp [δ]
            field_simp [ne_of_gt hAi_pos]
          have hmul : (A i 0 : ℝ) * ε ≤ (A i 0 : ℝ) * δ i := by
            exact mul_le_mul_of_nonneg_left hε_le hAi_pos.le
          rwa [hδ_eq] at hmul
        simpa [xPlus, rational_matrix_polyhedron, Matrix.mulVec, dotProduct, add_mul] using
          (by linarith [hx_row i, hi_bound] :
            (A i 0 : ℝ) * (Real.sqrt 2 + ε) ≤ b i)
      · have hAi_nonpos : (A i 0 : ℝ) ≤ 0 := by
          exact_mod_cast le_of_not_gt hi_pos
        simpa [xPlus, rational_matrix_polyhedron, Matrix.mulVec, dotProduct, add_mul] using
          (by nlinarith [hx_row i] : (A i 0 : ℝ) * (Real.sqrt 2 + ε) ≤ b i)
    rw [← hAb] at hxPlus_mem
    have hxPlus_eq : xPlus = x := Set.mem_singleton_iff.1 hxPlus_mem
    have hcoord := congrFun hxPlus_eq 0
    have : Real.sqrt 2 + ε = Real.sqrt 2 := by simpa [xPlus, x] using hcoord
    linarith
  rcases hactive_pos with ⟨i, hi_pos, hi_eq⟩
  have hAi_ne : (A i 0 : ℝ) ≠ 0 := by
    exact ne_of_gt (by exact_mod_cast hi_pos)
  have hdiv : Real.sqrt 2 = (b i : ℝ) / (A i 0 : ℝ) := by
    refine (eq_div_iff hAi_ne).2 ?_
    simpa [mul_comm] using hi_eq
  have hx0 : Real.sqrt 2 = ((b i / A i 0 : ℚ) : ℝ) := by
    simpa using hdiv
  exact irrational_sqrt_two.ne_rat (b i / A i 0) hx0

/-- Remark 4.32 (1). If the mixed-system matrices are allowed to have nonrational entries, the
convex hull of the mixed-integer feasible set need not be a polyhedron. -/
theorem exists_nonrational_matrix_counterexample_to_polyhedral_mixed_integer_hull :
    ∃ m n p : ℕ,
      ∃ A : Matrix (Fin m) (Fin n) ℝ,
        ∃ G : Matrix (Fin m) (Fin p) ℝ,
          ∃ b : Fin m → ℝ,
            (¬ matrix_has_rational_entries A ∨ ¬ matrix_has_rational_entries G) ∧
              ¬ is_mixed_polyhedron
                (convexHull ℝ (mixed_integer_points (real_mixed_polyhedron A G b))) := by
  let A : Matrix (Fin 2) (Fin 2) ℝ := !![-Real.sqrt 2, 1; 0, -1]
  let G : Matrix (Fin 2) (Fin 0) ℝ := 0
  let b : Fin 2 → ℝ := ![0, -1]
  refine ⟨2, 2, 0, A, G, b, ?_⟩
  constructor
  · left
    intro hA_rational
    -- The top-left entry is `-√2`, so a rational presentation would force `√2` to be rational.
    rcases hA_rational 0 0 with ⟨q, hq⟩
    have hentry : (-Real.sqrt 2 : ℝ) = q := by
      simpa [A] using hq
    have hsqrt : Real.sqrt 2 = (-q : ℝ) := by
      linarith
    exact irrational_sqrt_two.ne_rat (-q) (by simpa using hsqrt)
  · intro hHullPolyhedron
    have hFlatPoints :
        Fin.appendEquiv 2 0 '' mixed_integer_points (real_mixed_polyhedron A G b) =
          (LinearEquiv.finTwoArrow ℝ ℝ).symm '' exercise_4_30_real_feasible_set := by
      ext z
      constructor
      · rintro ⟨xy, hxy, rfl⟩
        rcases xy with ⟨x, y⟩
        rcases (mem_mixed_integer_points_iff).1 hxy with ⟨hxP, hxInt⟩
        rw [mem_mixed_integer_lattice_iff, mem_integerVectors_iff] at hxInt
        rcases hxInt with ⟨xInt, rfl⟩
        rw [mem_real_mixed_polyhedron_iff] at hxP
        have hupper : ((xInt 1 : ℤ) : ℝ) ≤ Real.sqrt 2 * (xInt 0 : ℝ) := by
          have hrow0 : -Real.sqrt 2 * (xInt 0 : ℝ) + (xInt 1 : ℝ) ≤ 0 := by
            simpa [A, G, b, Matrix.mulVec, dotProduct] using hxP 0
          linarith
        have hone : 1 ≤ xInt 1 := by
          have hrow1 : -((xInt 1 : ℤ) : ℝ) ≤ -1 := by
            simpa [A, G, b, Matrix.mulVec, dotProduct] using hxP 1
          exact_mod_cast (by linarith : (1 : ℝ) ≤ (xInt 1 : ℝ))
        refine ⟨exercise_4_30_real_point (xInt 0, xInt 1), ?_, ?_⟩
        · -- The two defining rows are exactly the Exercise 4.30 feasibility inequalities.
          exact Set.mem_image_of_mem exercise_4_30_real_point ⟨hone, hupper⟩
        · ext i
          fin_cases i
          · rfl
          · rfl
      · rintro ⟨u, hu, rfl⟩
        rcases hu with ⟨xInt, hxInt, rfl⟩
        refine ⟨((LinearEquiv.finTwoArrow ℝ ℝ).symm (exercise_4_30_real_point xInt),
            fun i ↦ Fin.elim0 i), ?_, ?_⟩
        · refine (mem_mixed_integer_points_iff).2 ?_
          constructor
          · rw [mem_real_mixed_polyhedron_iff]
            intro i
            fin_cases i
            · -- The first row is `x₂ ≤ √2 x₁`.
              simpa [A, G, b, exercise_4_30_real_point, Matrix.mulVec, dotProduct, mul_comm]
                using hxInt.2
            · -- The second row is `1 ≤ x₂`.
              have hrow1 : -(xInt.2 : ℝ) ≤ -1 := by
                have hrow1' : (1 : ℝ) ≤ (xInt.2 : ℝ) := by
                  exact_mod_cast hxInt.1
                linarith
              simpa [A, G, b, exercise_4_30_real_point, Matrix.mulVec, dotProduct]
                using hrow1
          · rw [mem_mixed_integer_lattice_iff, mem_integerVectors_iff]
            refine ⟨![xInt.1, xInt.2], ?_⟩
            ext i
            fin_cases i <;> simp [exercise_4_30_real_point]
        · ext i
          fin_cases i <;> simp [exercise_4_30_real_point, Fin.appendEquiv]
    have hFlatHull :
        (Fin.appendEquiv 2 0 '' convexHull ℝ (mixed_integer_points (real_mixed_polyhedron A G b))) =
          (LinearEquiv.finTwoArrow ℝ ℝ).symm '' convexHull ℝ exercise_4_30_real_feasible_set := by
      calc
        Fin.appendEquiv 2 0 '' convexHull ℝ (mixed_integer_points (real_mixed_polyhedron A G b))
            = convexHull ℝ
                (Fin.appendEquiv 2 0 '' mixed_integer_points (real_mixed_polyhedron A G b)) := by
                  rw [appendEquiv_image_convexHull]
        _ =
            convexHull ℝ
              ((LinearEquiv.finTwoArrow ℝ ℝ).symm '' exercise_4_30_real_feasible_set) := by
              rw [hFlatPoints]
        _ = (LinearEquiv.finTwoArrow ℝ ℝ).symm '' convexHull ℝ exercise_4_30_real_feasible_set := by
              symm
              exact (LinearEquiv.finTwoArrow ℝ ℝ).symm.toLinearMap.image_convexHull
                exercise_4_30_real_feasible_set
    -- Route correction: transport the canonical Exercise 4.30 counterexample through the
    -- `p = 0` flattening equivalence instead of reproving nonpolyhedrality locally.
    exact exercise_4_30_convexHull_real_feasible_set_not_polyhedron <| by
      simpa [is_mixed_polyhedron, hFlatHull] using hHullPolyhedron

/-- Remark 4.32 (2), strengthened using Theorem 4.30 for the rational-right-hand-side case: if
`A` and `G` are rational matrices and `b` is any real right-hand side, then the mixed-integer
hull is still a polyhedron. -/
theorem rational_matrices_real_rhs_mixed_integer_hull_is_polyhedron
    (A : Matrix (Fin m) (Fin n) ℚ)
    (G : Matrix (Fin m) (Fin p) ℚ)
    (b : Fin m → ℝ) :
    is_mixed_polyhedron
      (convexHull ℝ
        (mixed_integer_points (rational_matrices_real_rhs_mixed_polyhedron A G b))) := by
  let P := rational_matrices_real_rhs_mixed_polyhedron A G b
  let S := mixed_integer_points P
  let Sflat : Set (Fin (n + p) → ℝ) := Fin.appendEquiv n p '' S
  change is_polyhedron (Fin.appendEquiv n p '' convexHull ℝ S)
  rw [appendEquiv_image_convexHull]
  change is_polyhedron (convexHull ℝ Sflat)
  by_cases hS_nonempty : S.Nonempty
  · -- A feasible mixed point makes the ambient polyhedron nonempty, so it has a
    -- polytope-plus-integral-cone decomposition.
    have hP_nonempty : P.Nonempty :=
      nonempty_of_mixed_integer_points_nonempty (P := P) hS_nonempty
    rcases flattenedRealRhsPolyhedron_eq_polytope_add_integralCone A G b hP_nonempty with
      ⟨Q, hQ, -, q, rays, hdecomp, -⟩
    let Qbase : Set (Fin (n + p) → ℝ) := Q + fractionalRayBox rays
    have hQbase : Qbase.IsPolytope ℝ := by
      dsimp [Qbase]
      exact isPolytope_add hQ (fractionalRayBox_isPolytope rays)
    have hdecompIntegral : Fin.appendEquiv n p '' P = Qbase + integral_intcone rays := by
      calc
        Fin.appendEquiv n p '' P
            = Q + finitely_generated_cone
                (fun j : Fin q ↦ fun i : Fin (n + p) ↦ (rays j i : ℝ)) := hdecomp
        _ = Q + (fractionalRayBox rays + integral_intcone rays) := by
              rw [finitelyGeneratedCone_eq_fractionalRayBox_add_integralIntcone]
        _ = Qbase + integral_intcone rays := by
              simp [Qbase, add_assoc]
    have hSdecomp :
        Sflat = (Qbase ∩ firstBlockIntegerSet n p) + integral_intcone rays := by
      simpa [Sflat, S] using
        flattenedMixedIntegerPoints_eq_baseSlice_add_integralIntcone
          (P := P) hdecompIntegral
    have hslice : (convexHull ℝ (Qbase ∩ firstBlockIntegerSet n p)).IsPolytope ℝ :=
      isPolytope_convexHull_firstBlockIntegerSlice hQbase
    -- Convexification distributes over the bounded slice and the integral cone.
    rw [hSdecomp, convexHull_add,
      convexHull_integral_intcone_eq_finitely_generated_cone]
    exact (is_polyhedron_iff_eq_polytope_add_finitely_generated_cone).2
      ⟨convexHull ℝ (Qbase ∩ firstBlockIntegerSet n p),
        hslice, q, (fun j i ↦ (rays j i : ℝ)), rfl⟩
  · -- The empty mixed-integer set has the explicit rational empty-polyhedron witness.
    have hS_empty : S = ∅ := Set.not_nonempty_iff_eq_empty.mp hS_nonempty
    have hSflat_empty : Sflat = ∅ := by
      simp [Sflat, hS_empty]
    rw [hSflat_empty, convexHull_empty]
    exact is_polyhedron_of_is_rational_polyhedron
      (is_rational_polyhedron_empty (k := n + p))

/-- Remark 4.32 (3), again including the rational-right-hand-side case already covered by
Theorem 4.30: if `A` and `G` are rational matrices and the mixed-integer feasible set is
nonempty, then its mixed-integer hull has the same recession cone as the original mixed
polyhedron. -/
theorem rational_matrices_real_rhs_mixed_integer_hull_recessionCone_eq
    (A : Matrix (Fin m) (Fin n) ℚ)
    (G : Matrix (Fin m) (Fin p) ℚ)
    (b : Fin m → ℝ)
    (hS_nonempty :
      Set.Nonempty (mixed_integer_points (rational_matrices_real_rhs_mixed_polyhedron A G b))) :
    recessionCone
        (convexHull ℝ (mixed_integer_points (rational_matrices_real_rhs_mixed_polyhedron A G b))) =
      recessionCone (rational_matrices_real_rhs_mixed_polyhedron A G b) := by
  let P := rational_matrices_real_rhs_mixed_polyhedron A G b
  let S := mixed_integer_points P
  let Pflat : Set (Fin (n + p) → ℝ) := Fin.appendEquiv n p '' P
  let Sflat : Set (Fin (n + p) → ℝ) := Fin.appendEquiv n p '' S
  have hP_nonempty : P.Nonempty :=
    nonempty_of_mixed_integer_points_nonempty (P := P) hS_nonempty
  rcases flattenedRealRhsPolyhedron_eq_polytope_add_integralCone A G b hP_nonempty with
    ⟨Q, hQ, -, q, rays, hdecomp, hrecession⟩
  let Qbase : Set (Fin (n + p) → ℝ) := Q + fractionalRayBox rays
  have hQbase : Qbase.IsPolytope ℝ := by
    dsimp [Qbase]
    exact isPolytope_add hQ (fractionalRayBox_isPolytope rays)
  have hdecompIntegral : Pflat = Qbase + integral_intcone rays := by
    calc
      Pflat = Q + finitely_generated_cone
          (fun j : Fin q ↦ fun i : Fin (n + p) ↦ (rays j i : ℝ)) := hdecomp
      _ = Q + (fractionalRayBox rays + integral_intcone rays) := by
            rw [finitelyGeneratedCone_eq_fractionalRayBox_add_integralIntcone]
      _ = Qbase + integral_intcone rays := by
            simp [Qbase, add_assoc]
  have hSdecomp :
      Sflat = (Qbase ∩ firstBlockIntegerSet n p) + integral_intcone rays := by
    simpa [Sflat, S, Pflat] using
      flattenedMixedIntegerPoints_eq_baseSlice_add_integralIntcone
        (P := P) hdecompIntegral
  have hslice : (convexHull ℝ (Qbase ∩ firstBlockIntegerSet n p)).IsPolytope ℝ :=
    isPolytope_convexHull_firstBlockIntegerSlice hQbase
  have hslice_nonempty : (Qbase ∩ firstBlockIntegerSet n p).Nonempty := by
    -- A mixed-integer point in the flattened set projects to its bounded base part.
    rcases hS_nonempty with ⟨xy, hxy⟩
    have huS : Fin.appendEquiv n p xy ∈ Sflat := ⟨xy, hxy, rfl⟩
    rw [hSdecomp] at huS
    rcases Set.mem_add.1 huS with ⟨u, hu, c, hc, hsum⟩
    exact ⟨u, hu⟩
  have hsliceHull_nonempty :
      (convexHull ℝ (Qbase ∩ firstBlockIntegerSet n p)).Nonempty := by
    rcases hslice_nonempty with ⟨u, hu⟩
    exact ⟨u, subset_convexHull ℝ _ hu⟩
  have hHullDecomp :
      convexHull ℝ Sflat =
        convexHull ℝ (Qbase ∩ firstBlockIntegerSet n p) +
          finitely_generated_cone
            (fun j : Fin q ↦ fun i : Fin (n + p) ↦ (rays j i : ℝ)) := by
    calc
      convexHull ℝ Sflat
          = convexHull ℝ
              ((Qbase ∩ firstBlockIntegerSet n p) + integral_intcone rays) := by
              rw [hSdecomp]
      _ = convexHull ℝ (Qbase ∩ firstBlockIntegerSet n p) +
            convexHull ℝ (integral_intcone rays) := by
              rw [convexHull_add]
      _ = convexHull ℝ (Qbase ∩ firstBlockIntegerSet n p) +
            finitely_generated_cone
              (fun j : Fin q ↦ fun i : Fin (n + p) ↦ (rays j i : ℝ)) := by
              rw [convexHull_integral_intcone_eq_finitely_generated_cone]
  have hHullRec :
      recessionCone (convexHull ℝ Sflat) =
        finitely_generated_cone
          (fun j : Fin q ↦ fun i : Fin (n + p) ↦ (rays j i : ℝ)) := by
    calc
      recessionCone (convexHull ℝ Sflat)
          = recessionCone
              (convexHull ℝ (Qbase ∩ firstBlockIntegerSet n p) +
                finitely_generated_cone
                  (fun j : Fin q ↦ fun i : Fin (n + p) ↦ (rays j i : ℝ))) := by
              rw [hHullDecomp]
      _ = finitely_generated_cone
            (fun j : Fin q ↦ fun i : Fin (n + p) ↦ (rays j i : ℝ)) :=
              recessionCone_polytope_add_finitelyGeneratedCone hslice hsliceHull_nonempty
  have hflat : recessionCone (convexHull ℝ Sflat) = recessionCone Pflat :=
    hHullRec.trans hrecession.symm
  -- Flattening is an equivalence, so the equality descends to the original mixed spaces.
  ext d
  constructor
  · intro hd
    have hdFlat :
        Fin.appendEquiv n p d ∈
          recessionCone (Fin.appendEquiv n p '' convexHull ℝ S) :=
      (mem_recessionCone_flatten_iff
        (Q := convexHull ℝ S) (d := d)).2 hd
    rw [appendEquiv_image_convexHull, hflat] at hdFlat
    exact (mem_recessionCone_flatten_iff (Q := P) (d := d)).1 hdFlat
  · intro hd
    have hdFlat : Fin.appendEquiv n p d ∈ recessionCone Pflat :=
      (mem_recessionCone_flatten_iff (Q := P) (d := d)).2 hd
    have hdFlat' :
        Fin.appendEquiv n p d ∈
          recessionCone (Fin.appendEquiv n p '' convexHull ℝ S) := by
      rw [appendEquiv_image_convexHull, hflat]
      exact hdFlat
    exact (mem_recessionCone_flatten_iff (Q := convexHull ℝ S) (d := d)).1 hdFlat'

/-- Remark 4.32 (4). Even with rational matrices `A` and `G`, a nonrational right-hand side can
yield a mixed-integer hull that is not a rational polyhedron. -/
theorem exists_nonrational_rhs_counterexample_to_rational_mixed_integer_hull :
    ∃ m n p : ℕ,
      ∃ A : Matrix (Fin m) (Fin n) ℚ,
        ∃ G : Matrix (Fin m) (Fin p) ℚ,
          ∃ b : Fin m → ℝ,
            ¬ vector_has_rational_entries b ∧
              ¬ is_rational_mixed_polyhedron
                (convexHull ℝ
                  (mixed_integer_points
                    (rational_matrices_real_rhs_mixed_polyhedron A G b))) := by
  let A : Matrix (Fin 2) (Fin 0) ℚ := 0
  let G : Matrix (Fin 2) (Fin 1) ℚ := !![(1 : ℚ); -1]
  let b : Fin 2 → ℝ := ![Real.sqrt 2, -Real.sqrt 2]
  refine ⟨2, 0, 1, A, G, b, ?_⟩
  constructor
  · intro hb_rational
    rcases hb_rational 0 with ⟨q, hq⟩
    exact irrational_sqrt_two.ne_rat q (by simpa [b] using hq)
  · have hPolyhedronSingleton :
        rational_matrices_real_rhs_mixed_polyhedron A G b = {sqrtTwoMixedPoint} := by
        ext xy
        constructor
        · intro hxy
          rw [rational_matrices_real_rhs_mixed_polyhedron, mem_real_mixed_polyhedron_iff] at hxy
          rcases xy with ⟨x, y⟩
          have hupper : y 0 ≤ Real.sqrt 2 := by
            simpa [A, G, b, Matrix.mulVec, dotProduct] using hxy 0
          have hlower : Real.sqrt 2 ≤ y 0 := by
            have hrow1 : -(y 0) ≤ -Real.sqrt 2 := by
              simpa [A, G, b, Matrix.mulVec, dotProduct] using hxy 1
            linarith
          have hy : y = ![Real.sqrt 2] := by
            ext i
            fin_cases i
            exact le_antisymm hupper hlower
          have hx : x = fun i ↦ Fin.elim0 i := by
            ext i
            exact Fin.elim0 i
          rw [Set.mem_singleton_iff]
          simp [sqrtTwoMixedPoint, hx, hy]
        · rintro rfl
          -- The two rational rows cut out the single coordinate equation `y = √2`.
          rw [rational_matrices_real_rhs_mixed_polyhedron, mem_real_mixed_polyhedron_iff]
          intro i
          fin_cases i <;> simp [A, G, b, sqrtTwoMixedPoint, Matrix.mulVec, dotProduct]
    have hMixedIntegerSingleton :
        mixed_integer_points (rational_matrices_real_rhs_mixed_polyhedron A G b) =
          {sqrtTwoMixedPoint} := by
      ext xy
      rw [mem_mixed_integer_points_iff, hPolyhedronSingleton]
      constructor
      · intro hxy
        exact hxy.1
      · intro hxy
        constructor
        · exact hxy
        · rcases Set.mem_singleton_iff.1 hxy with rfl
          rw [mem_mixed_integer_lattice_iff, mem_integerVectors_iff]
          refine ⟨fun i ↦ Fin.elim0 i, ?_⟩
          ext i
          exact Fin.elim0 i
    have hHullSingleton :
        convexHull ℝ
            (mixed_integer_points (rational_matrices_real_rhs_mixed_polyhedron A G b)) =
          {sqrtTwoMixedPoint} := by
      -- Once the feasible set is already a singleton, taking mixed-integer points and convex hull
      -- does not change it.
      rw [hMixedIntegerSingleton, convexHull_singleton]
    simpa [hHullSingleton] using sqrtTwoMixedPoint_not_rationalMixedPolyhedron

end Remark432
