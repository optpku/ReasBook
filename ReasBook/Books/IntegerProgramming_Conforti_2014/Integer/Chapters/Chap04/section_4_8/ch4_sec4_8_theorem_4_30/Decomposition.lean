import IntegerProgramming_Conforti_2014.Integer.Chapters.Chap03.section_3_5_1.ch3_sec3_5_1_proposition_3_12
import IntegerProgramming_Conforti_2014.Integer.Chapters.Chap03.section_3_5_2.ch3_sec3_5_2_theorem_3_13
import IntegerProgramming_Conforti_2014.Integer.Chapters.Chap03.section_3_6.ch3_sec3_6_proposition_3_15

open scoped BigOperators Matrix Pointwise

-- The rational presentation helpers below support the source-faithful Chapter 3.13 step
-- in Meyer's proof while keeping this item self-contained for validation.

section Theorem430

variable {n p : ℕ}

/-- Helper for Theorem 4.30: the rational homogenized inequality matrix has rows `(Aᵢ, -bᵢ)`
and final row `(0, -1)`. -/
def rationalHomogenizedPolyhedronMatrix
    {m k : ℕ} (A : Matrix (Fin m) (Fin k) ℚ) (b : Fin m → ℚ) :
    Matrix (Fin (m + 1)) (Fin (k + 1)) ℚ :=
  fun i ↦
    Fin.lastCases
      (Fin.snoc (fun _ : Fin k ↦ (0 : ℚ)) (-1))
      (fun i' ↦ Fin.snoc (A i') (-b i'))
      i

/-- Helper for Theorem 4.30: casting the rational homogenized matrix to `ℝ` recovers the real
homogenized matrix used in Theorem 3.13. -/
lemma rationalHomogenizedPolyhedronMatrix_map
    {m k : ℕ} (A : Matrix (Fin m) (Fin k) ℚ) (b : Fin m → ℚ) :
    (rationalHomogenizedPolyhedronMatrix A b).map (Rat.castHom ℝ) =
      homogenized_polyhedron_matrix (A.map (Rat.castHom ℝ)) (fun i ↦ (b i : ℝ)) := by
  -- Compare the final row and the original inequality rows coordinatewise.
  ext i j
  cases i using Fin.lastCases with
  | last =>
      cases j using Fin.lastCases with
      | last =>
          simp [rationalHomogenizedPolyhedronMatrix, homogenized_polyhedron_matrix]
      | cast j =>
          simp [rationalHomogenizedPolyhedronMatrix, homogenized_polyhedron_matrix]
  | cast i =>
      cases j using Fin.lastCases with
      | last =>
          simp [rationalHomogenizedPolyhedronMatrix, homogenized_polyhedron_matrix]
      | cast j =>
          simp [rationalHomogenizedPolyhedronMatrix, homogenized_polyhedron_matrix]

/-- Helper for Theorem 4.30: every rational polyhedron is a convex hull of finitely many
rational points plus a cone generated by finitely many rational rays. -/
lemma existsRationalVertexRayPresentation
    {k : ℕ} {P : Set (Fin k → ℝ)}
    (hP : is_rational_polyhedron P) :
    ∃ t s : ℕ, ∃ vertices : Fin t → Fin k → ℚ, ∃ rays : Fin s → Fin k → ℚ,
      P =
        convexHull ℝ (Set.range (fun i : Fin t ↦ fun u : Fin k ↦ (vertices i u : ℝ))) +
          finitely_generated_cone (fun j : Fin s ↦ fun u : Fin k ↦ (rays j u : ℝ)) := by
  classical
  rcases (is_rational_polyhedron_iff.mp hP) with ⟨m, A, b, rfl⟩
  let Hℚ : Matrix (Fin (m + 1)) (Fin (k + 1)) ℚ :=
    rationalHomogenizedPolyhedronMatrix A b
  have hHℚ_map :
      Hℚ.map (Rat.castHom ℝ) =
        homogenized_polyhedron_matrix (A.map (Rat.castHom ℝ)) (fun i ↦ (b i : ℝ)) := by
    -- The bridge lemma keeps all subsequent cone reasoning in the real Chapter 3 API.
    exact rationalHomogenizedPolyhedronMatrix_map A b
  rcases exists_rational_matrix_cone_of_rational_matrix_polyhedral_cone Hℚ with
    ⟨g, R, hR⟩
  have hR_homogenized :
      polyhedron_le_set
          (homogenized_polyhedron_matrix (A.map (Rat.castHom ℝ)) (fun i ↦ (b i : ℝ))) 0 =
        (matrix_cone (R.map (Rat.castHom ℝ)) : Set (Fin (k + 1) → ℝ)) := by
    -- Replace the rational homogeneous system by its rational generating columns.
    calc
      polyhedron_le_set
          (homogenized_polyhedron_matrix (A.map (Rat.castHom ℝ)) (fun i ↦ (b i : ℝ))) 0 =
          matrix_polyhedral_cone (Hℚ.map (Rat.castHom ℝ)) := by
            rw [hHℚ_map]
      _ = (matrix_cone (R.map (Rat.castHom ℝ)) : Set (Fin (k + 1) → ℝ)) := hR
  have hlast_nonneg :
      ∀ j : Fin g, 0 ≤ (R.map (Rat.castHom ℝ)) (Fin.last k) j := by
    intro j
    have hj_cone :
        (fun i : Fin (k + 1) ↦ (R.map (Rat.castHom ℝ)) i j) ∈
          ((matrix_cone (R.map (Rat.castHom ℝ)) :
            PointedCone ℝ (Fin (k + 1) → ℝ)) : Set _) :=
      matrix_column_mem_matrix_cone (R.map (Rat.castHom ℝ)) j
    have hj_homogenized :
        (fun i : Fin (k + 1) ↦ (R.map (Rat.castHom ℝ)) i j) ∈
          polyhedron_le_set
            (homogenized_polyhedron_matrix (A.map (Rat.castHom ℝ))
              (fun i ↦ (b i : ℝ))) 0 := by
      rw [hR_homogenized]
      exact hj_cone
    have hj_snoc :
        Fin.snoc
            (fun i : Fin k ↦ (R.map (Rat.castHom ℝ)) i.castSucc j)
            ((R.map (Rat.castHom ℝ)) (Fin.last k) j) ∈
          polyhedron_le_set
            (homogenized_polyhedron_matrix (A.map (Rat.castHom ℝ))
              (fun i ↦ (b i : ℝ))) 0 := by
      -- Repackage a generator column as its visible block followed by its height.
      convert hj_homogenized using 1
      ext i
      cases i using Fin.lastCases with
      | last =>
          simp
      | cast i =>
          simp
    exact
      (mem_homogenized_polyhedron_cone_iff_general
        (A.map (Rat.castHom ℝ)) (fun i ↦ (b i : ℝ))
        (fun i : Fin k ↦ (R.map (Rat.castHom ℝ)) i.castSucc j)
        ((R.map (Rat.castHom ℝ)) (Fin.last k) j)).1 hj_snoc |>.2
  let J₁ : Type :=
    {j : Fin g // 0 < (R.map (Rat.castHom ℝ)) (Fin.last k) j}
  let J₀ : Type :=
    {j : Fin g // (R.map (Rat.castHom ℝ)) (Fin.last k) j = 0}
  let vertexℚ : J₁ → Fin k → ℚ :=
    fun a i ↦ R i.castSucc a.1 / R (Fin.last k) a.1
  let rayℚ : J₀ → Fin k → ℚ :=
    fun a i ↦ R i.castSucc a.1
  let t : ℕ := Fintype.card J₁
  let s : ℕ := Fintype.card J₀
  let vertexEquiv : Fin t ≃ J₁ := (Fintype.equivFin J₁).symm
  let rayEquiv : Fin s ≃ J₀ := (Fintype.equivFin J₀).symm
  let vertices : Fin t → Fin k → ℚ := fun i ↦ vertexℚ (vertexEquiv i)
  let rays : Fin s → Fin k → ℚ := fun i ↦ rayℚ (rayEquiv i)
  let vertexReal : J₁ → Fin k → ℝ := fun a i ↦ (vertexℚ a i : ℝ)
  let rayReal : J₀ → Fin k → ℝ := fun a i ↦ (rayℚ a i : ℝ)
  have hvertex_range :
      Set.range (fun i : Fin t ↦ fun u : Fin k ↦ (vertices i u : ℝ)) =
        Set.range vertexReal := by
    -- Reindex the finite positive-height columns onto a canonical `Fin` type.
    ext x
    constructor
    · rintro ⟨i, rfl⟩
      exact ⟨vertexEquiv i, rfl⟩
    · rintro ⟨a, rfl⟩
      exact ⟨vertexEquiv.symm a, by simp [vertices, vertexReal]⟩
  have hray_range :
      Set.range (fun i : Fin s ↦ fun u : Fin k ↦ (rays i u : ℝ)) =
        Set.range rayReal := by
    -- Reindex the finite zero-height columns onto a canonical `Fin` type.
    ext x
    constructor
    · rintro ⟨i, rfl⟩
      exact ⟨rayEquiv i, rfl⟩
    · rintro ⟨a, rfl⟩
      exact ⟨rayEquiv.symm a, by simp [rays, rayReal]⟩
  refine ⟨t, s, vertices, rays, ?_⟩
  ext x
  constructor
  · intro hx
    have hx_homogenized :
        Fin.snoc (α := fun _ ↦ ℝ) x (1 : ℝ) ∈
          polyhedron_le_set
            (homogenized_polyhedron_matrix (A.map (Rat.castHom ℝ))
              (fun i ↦ (b i : ℝ))) 0 := by
      exact (mem_homogenized_polyhedron_cone_iff
        (A.map (Rat.castHom ℝ)) (fun i ↦ (b i : ℝ)) x).2 hx
    have hx_matrix :
        Fin.snoc (α := fun _ ↦ ℝ) x (1 : ℝ) ∈
          ((matrix_cone (R.map (Rat.castHom ℝ)) :
            PointedCone ℝ (Fin (k + 1) → ℝ)) : Set _) := by
      rw [← hR_homogenized]
      exact hx_homogenized
    have hx_slice :
        x ∈ convexHull ℝ (Set.range vertexReal) + cone (Set.range rayReal) := by
      simpa [J₁, J₀, vertexℚ, rayℚ, vertexReal, rayReal] using
        (mem_slice_one_matrix_cone_iff_mem_convexHull_add_cone_of_nonnegative_heights
          (R.map (Rat.castHom ℝ)) hlast_nonneg (x := x)).1 hx_matrix
    simpa [finitely_generated_cone, hvertex_range, hray_range] using hx_slice
  · intro hx
    have hx_slice :
        x ∈ convexHull ℝ (Set.range vertexReal) + cone (Set.range rayReal) := by
      simpa [finitely_generated_cone, hvertex_range, hray_range] using hx
    have hx_slice_native :
        x ∈
          convexHull ℝ
              (Set.range fun a : J₁ ↦ fun i : Fin k ↦
                (R.map (Rat.castHom ℝ)) i.castSucc a.1 /
                  (R.map (Rat.castHom ℝ)) (Fin.last k) a.1) +
            cone
              (Set.range fun a : J₀ ↦ fun i : Fin k ↦
                (R.map (Rat.castHom ℝ)) i.castSucc a.1) := by
      -- Cast rational quotients before applying the real slice theorem in the reverse direction.
      simpa [vertexℚ, rayℚ, vertexReal, rayReal] using hx_slice
    have hx_matrix :
        Fin.snoc (α := fun _ ↦ ℝ) x (1 : ℝ) ∈
          ((matrix_cone (R.map (Rat.castHom ℝ)) :
            PointedCone ℝ (Fin (k + 1) → ℝ)) : Set _) := by
      simpa [J₁, J₀] using
        (mem_slice_one_matrix_cone_iff_mem_convexHull_add_cone_of_nonnegative_heights
          (R.map (Rat.castHom ℝ)) hlast_nonneg (x := x)).2 hx_slice_native
    have hx_homogenized :
        Fin.snoc (α := fun _ ↦ ℝ) x (1 : ℝ) ∈
          polyhedron_le_set
            (homogenized_polyhedron_matrix (A.map (Rat.castHom ℝ))
              (fun i ↦ (b i : ℝ))) 0 := by
      rw [hR_homogenized]
      exact hx_matrix
    exact (mem_homogenized_polyhedron_cone_iff
      (A.map (Rat.castHom ℝ)) (fun i ↦ (b i : ℝ)) x).1 hx_homogenized

/-- Helper for Theorem 4.30: once the flattened ambient set is known to be polyhedral, Theorem
3.13 gives Meyer's required `polytope + finitely generated cone` decomposition. -/
lemma pflat_eq_polytope_add_finitely_generated_cone
    {Pflat : Set (Fin (n + p) → ℝ)}
    (hPflat_polyhedron : is_polyhedron Pflat) :
    ∃ Q : Set (Fin (n + p) → ℝ),
      Q.IsPolytope ℝ ∧
        ∃ q : ℕ, ∃ rays : Fin q → Fin (n + p) → ℝ,
          Pflat = Q + finitely_generated_cone rays := by
  -- This is exactly the Chapter 3.13 decomposition, specialized to the flattened ambient space.
  exact (is_polyhedron_iff_eq_polytope_add_finitely_generated_cone).1 hPflat_polyhedron

/-- remote integer-programming sorr<!-- -->y cleanup Integer/Chapters/Chap04/section_4_8/ch4_sec4_8_theorem_4_30/Decomposition.lean

Helper for Theorem 4.30: a nonempty rational flattened ambient set admits a rational
vertex presentation that keeps the already normalized integral recession rays fixed. -/
lemma existsFlattenedRationalVertexPresentationCompatibleWithIntegralRays
    {k q : ℕ}
    {Pflat : Set (Fin k → ℝ)}
    (hPflat_rational : is_rational_polyhedron Pflat)
    (hPflat_nonempty : Set.Nonempty Pflat)
    (rays : Fin q → Fin k → ℤ)
    (hrec_integral :
      recessionCone Pflat =
        finitely_generated_cone (fun j : Fin q ↦ fun i : Fin k ↦ (rays j i : ℝ))) :
    ∃ t : ℕ, ∃ vℚ : Fin t → Fin k → ℚ,
      Pflat =
        convexHull ℝ (Set.range (fun i : Fin t ↦ fun u : Fin k ↦ (vℚ i u : ℝ))) +
          finitely_generated_cone (fun j : Fin q ↦ fun i : Fin k ↦ (rays j i : ℝ)) := by
  rcases (is_rational_polyhedron_iff.mp hPflat_rational) with ⟨m, A, b, hPflat⟩
  rcases existsRationalVertexRayPresentation hPflat_rational with
    ⟨t, s, vertices, rationalRays, hrepr⟩
  have hPflat_nonempty' :
      Set.Nonempty
        (polyhedron_le_set (A.map (Rat.castHom ℝ)) (fun i ↦ (b i : ℝ))) := by
    -- Transport the supplied feasible point to the rational inequality presentation.
    rw [← hPflat]
    exact hPflat_nonempty
  have hrepr' :
      polyhedron_le_set (A.map (Rat.castHom ℝ)) (fun i ↦ (b i : ℝ)) =
        convexHull ℝ
            (Set.range (fun i : Fin t ↦ fun u : Fin k ↦ (vertices i u : ℝ))) +
          finitely_generated_cone
            (fun j : Fin s ↦ fun i : Fin k ↦ (rationalRays j i : ℝ)) := by
    -- Put the rational decomposition into the presentation expected by Proposition 3.15.
    rw [← hPflat]
    exact hrepr
  have hgenerated_recession :
      recessionCone Pflat =
        finitely_generated_cone
          (fun j : Fin s ↦ fun i : Fin k ↦ (rationalRays j i : ℝ)) := by
    -- Proposition 3.15 identifies the cone summand with the global recession cone.
    rw [hPflat]
    exact polyhedron_recessionCone_eq_finitely_generated_cone
      (A.map (Rat.castHom ℝ)) (fun i ↦ (b i : ℝ))
      (fun i : Fin t ↦ fun u : Fin k ↦ (vertices i u : ℝ))
      (fun j : Fin s ↦ fun i : Fin k ↦ (rationalRays j i : ℝ))
      hPflat_nonempty' hrepr'
  have hcone_eq :
      finitely_generated_cone
          (fun j : Fin s ↦ fun i : Fin k ↦ (rationalRays j i : ℝ)) =
        finitely_generated_cone
          (fun j : Fin q ↦ fun i : Fin k ↦ (rays j i : ℝ)) := by
    -- Both finite cones are the recession cone of `Pflat`.
    exact hgenerated_recession.symm.trans hrec_integral
  refine ⟨t, vertices, ?_⟩
  -- Replace only the cone summand, retaining the rational vertex family.
  rw [← hcone_eq]
  exact hrepr

#print axioms existsFlattenedRationalVertexPresentationCompatibleWithIntegralRays

end Theorem430
