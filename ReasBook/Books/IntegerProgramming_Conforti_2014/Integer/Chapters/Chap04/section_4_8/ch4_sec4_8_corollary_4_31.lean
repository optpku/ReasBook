import IntegerProgramming_Conforti_2014.Integer.Chapters.Chap04.section_4_9_3.ch4_sec4_9_3_theorem_4_47

open scoped BigOperators Matrix Pointwise

-- Semantic recall note: the mixed-space owner API for rational mixed polyhedra and mixed-integer
-- points is already established upstream in Chapter 4.1, and the rational-polytope / integer-cone
-- owner API is already established upstream in Chapter 4.9.3. This file keeps the source-facing
-- mixed-space statement and uses only a thin bridge to those canonical owners.

section Corollary431

variable {n p q : ℕ}

/-- Source-facing bridge: a subset of `ℝ^n × ℝ^p` is a rational polytope when its canonical
flattening in `ℝ^(n + p)` is a rational polytope. -/
def is_mixed_rational_polytope (P : Set (MixedRealPoint n p)) : Prop :=
  ((Fin.appendEquiv n p) '' P).IsRationalPolytope

/-- Source-facing bridge: the mixed integer cone generated by finitely many directions in
`ℤ^n × ℤ^p` is the pullback of the canonical Chapter 4.9.3 owner `integral_intcone` along
`Fin.appendEquiv`. -/
def mixed_integer_intcone (r : Fin q → (Fin n → ℤ) × (Fin p → ℤ)) :
    Set (MixedRealPoint n p) :=
  (Fin.appendEquiv n p).symm ''
    integral_intcone (fun j ↦ Fin.append (r j).1 (r j).2)

/-- Helper for Corollary 4.31: flattening by `Fin.appendEquiv` rewrites mixed-integer membership
as ambient flattened membership together with integrality of the first block. -/
private lemma memFlatMixedIntegerPoints_iff
    {P : Set (MixedRealPoint n p)}
    {u : Fin (n + p) → ℝ} :
    u ∈ (Fin.appendEquiv n p '' mixed_integer_points P) ↔
      u ∈ (Fin.appendEquiv n p '' P) ∧
        (fun i : Fin n ↦ u (Fin.castAdd p i)) ∈ integerVectors n := by
  constructor
  · rintro ⟨xy, hxy, rfl⟩
    -- Unpack mixed-integer membership into ambient membership and integrality of the first block.
    rcases (mem_mixed_integer_points_iff).1 hxy with ⟨hxyP, hxyZ⟩
    constructor
    · exact ⟨xy, hxyP, rfl⟩
    · rw [mem_mixed_integer_lattice_iff] at hxyZ
      simpa using hxyZ
  · rintro ⟨huP, huZ⟩
    rcases huP with ⟨xy, hxyP, rfl⟩
    -- Route correction: the flattened integrality side condition is exactly the mixed-lattice one.
    refine ⟨xy, ?_, rfl⟩
    refine (mem_mixed_integer_points_iff).2 ⟨hxyP, ?_⟩
    rw [mem_mixed_integer_lattice_iff]
    simpa using huZ

/-- Helper for Corollary 4.31: flattening after unflattening is the identity on
`Fin (n + p) → ℝ`. -/
private lemma appendEquivSymmApply
    (u : Fin (n + p) → ℝ) :
    Fin.appendEquiv n p ((Fin.appendEquiv n p).symm u) = u := by
  -- Check the two coordinate blocks separately so the block coercions stay syntactic.
  ext i
  refine Fin.addCases ?_ ?_ i
  · intro j
    simp [Fin.appendEquiv]
  · intro j
    simp [Fin.appendEquiv]

/-- Helper for Corollary 4.31: applying `Fin.appendEquiv` to the pullback of a flat set along its
inverse recovers the original flat set. -/
private lemma appendEquiv_image_symm_eq
    (S : Set (Fin (n + p) → ℝ)) :
    Fin.appendEquiv n p '' ((Fin.appendEquiv n p).symm '' S) = S := by
  -- Compare both sides by unpacking the two image witnesses explicitly.
  ext u
  constructor
  · rintro ⟨v, ⟨w, hw, rfl⟩, hvu⟩
    have hu : u = w := by
      exact hvu.symm.trans (appendEquivSymmApply (n := n) (p := p) w)
    exact hu ▸ hw
  · intro hu
    refine ⟨(Fin.appendEquiv n p).symm u, ⟨u, hu, rfl⟩, ?_⟩
    simpa using appendEquivSymmApply (n := n) (p := p) u

/-- Helper for Corollary 4.31: the auxiliary integer-variable matrix for the flattened witness
system has zero rows for the ambient polyhedron and `±Id` rows for the equalities `z = u₁`. -/
private def flatMixedIntegerWitnessIntMatrix
    {m : ℕ} :
    Matrix (Fin (m + (n + n))) (Fin n) ℚ :=
  fun i ↦
    Fin.addCases
      (fun _ _ ↦ 0)
      (Fin.addCases
        (fun i' j ↦ if j = i' then 1 else 0)
        (fun i' j ↦ if j = i' then -1 else 0))
      i

/-- Helper for Corollary 4.31: the auxiliary real-variable matrix keeps the original flattened
polyhedron rows and adds `∓Id` rows on the first `n` real coordinates. -/
private def flatMixedIntegerWitnessRealMatrix
    {m : ℕ}
    (A : Matrix (Fin m) (Fin (n + p)) ℚ) :
    Matrix (Fin (m + (n + n))) (Fin (n + p)) ℚ :=
  fun i ↦
    Fin.addCases
      A
      (Fin.addCases
        (fun i' ↦ Fin.append (fun j ↦ if j = i' then -1 else 0) (fun _ ↦ 0))
        (fun i' ↦ Fin.append (fun j ↦ if j = i' then 1 else 0) (fun _ ↦ 0)))
      i

/-- Helper for Corollary 4.31: the lifted witness system reuses the original right-hand side and
uses zero for the equality rows. -/
private def flatMixedIntegerWitnessRhs
    {m : ℕ}
    (b : Fin m → ℚ) :
    Fin (m + (n + n)) → ℚ :=
  Fin.addCases b (Fin.addCases (fun _ ↦ 0) (fun _ ↦ 0))

/-- Helper for Corollary 4.31: the first equality-row block of the integer witness matrix picks
out the chosen integer coordinate. -/
private lemma flatMixedIntegerWitnessIntFirstRow
    {m : ℕ}
    (z : Fin n → ℤ)
    (i : Fin n) :
    (((flatMixedIntegerWitnessIntMatrix (n := n) (m := m)).map (Rat.castHom ℝ)) *ᵥ
        fun j ↦ (z j : ℝ)) (Fin.natAdd m (Fin.castAdd n i)) =
      (z i : ℝ) := by
  classical
  -- Evaluate the `+Id` row by isolating the unique nonzero coefficient at `i`.
  rw [Matrix.mulVec, dotProduct, Finset.sum_eq_single i]
  · simp [flatMixedIntegerWitnessIntMatrix, Fin.addCases_right]
  · intro j _ hj
    simp [flatMixedIntegerWitnessIntMatrix, Fin.addCases_right, hj]
  · simp [flatMixedIntegerWitnessIntMatrix, Fin.addCases_right]

/-- Helper for Corollary 4.31: the second equality-row block of the integer witness matrix
contributes the negated chosen integer coordinate. -/
private lemma flatMixedIntegerWitnessIntSecondRow
    {m : ℕ}
    (z : Fin n → ℤ)
    (i : Fin n) :
    (((flatMixedIntegerWitnessIntMatrix (n := n) (m := m)).map (Rat.castHom ℝ)) *ᵥ
        fun j ↦ (z j : ℝ)) (Fin.natAdd m (Fin.natAdd n i)) =
      -(z i : ℝ) := by
  classical
  -- Evaluate the `-Id` row by isolating the same coordinate with coefficient `-1`.
  have hcoeff :
      ∀ j : Fin n,
        (((flatMixedIntegerWitnessIntMatrix (n := n) (m := m)).map (Rat.castHom ℝ))
            (Fin.natAdd m (Fin.natAdd n i)) j) =
          if j = i then (-1 : ℝ) else 0 := by
    intro j
    have hnat : i.addNat n = Fin.natAdd n i := by
      apply Fin.ext
      simpa [Nat.add_comm] using rfl
    simp [flatMixedIntegerWitnessIntMatrix]
    rw [hnat, Fin.addCases_right]
    by_cases h : j = i <;> simp [h]
  rw [Matrix.mulVec, dotProduct]
  simp_rw [hcoeff]
  rw [Finset.sum_eq_single i]
  · simp
  · intro j _ hj
    simp [hj]
  · simp

/-- Helper for Corollary 4.31: the first equality-row block of the real witness matrix records
the negated first-block coordinate of the ambient point. -/
private lemma flatMixedIntegerWitnessRealFirstRow
    {m : ℕ}
    (A : Matrix (Fin m) (Fin (n + p)) ℚ)
    (u : Fin (n + p) → ℝ)
    (i : Fin n) :
    (((flatMixedIntegerWitnessRealMatrix (n := n) (p := p) A).map (Rat.castHom ℝ)) *ᵥ
        u) (Fin.natAdd m (Fin.castAdd n i)) =
      -u (Fin.castAdd p i) := by
  classical
  -- Split the flattened coordinates into the first `n` block and the trailing `p` block.
  rw [Matrix.mulVec, dotProduct, Fin.sum_univ_add, Finset.sum_eq_single i]
  · simp [flatMixedIntegerWitnessRealMatrix, Fin.addCases_right]
  · intro j _ hj
    simp [flatMixedIntegerWitnessRealMatrix, Fin.addCases_right, hj]
  · simp [flatMixedIntegerWitnessRealMatrix, Fin.addCases_right]

/-- Helper for Corollary 4.31: the second equality-row block of the real witness matrix records
the first-block coordinate of the ambient point. -/
private lemma flatMixedIntegerWitnessRealSecondRow
    {m : ℕ}
    (A : Matrix (Fin m) (Fin (n + p)) ℚ)
    (u : Fin (n + p) → ℝ)
    (i : Fin n) :
    (((flatMixedIntegerWitnessRealMatrix (n := n) (p := p) A).map (Rat.castHom ℝ)) *ᵥ
        u) (Fin.natAdd m (Fin.natAdd n i)) =
      u (Fin.castAdd p i) := by
  classical
  -- The second equality block is the same coordinate extraction with coefficient `+1`.
  have hcoeffLeft :
      ∀ j : Fin n,
        (((flatMixedIntegerWitnessRealMatrix (n := n) (p := p) A).map (Rat.castHom ℝ))
            (Fin.natAdd m (Fin.natAdd n i)) (Fin.castAdd p j)) =
          if j = i then (1 : ℝ) else 0 := by
    intro j
    have hnat : i.addNat n = Fin.natAdd n i := by
      apply Fin.ext
      simpa [Nat.add_comm] using rfl
    simp [flatMixedIntegerWitnessRealMatrix]
    rw [hnat, Fin.addCases_right]
    by_cases h : j = i <;> simp [h]
  have hcoeffRight :
      ∀ j : Fin p,
        (((flatMixedIntegerWitnessRealMatrix (n := n) (p := p) A).map (Rat.castHom ℝ))
            (Fin.natAdd m (Fin.natAdd n i)) (Fin.natAdd n j)) =
          0 := by
    intro j
    have hnat : i.addNat n = Fin.natAdd n i := by
      apply Fin.ext
      simpa [Nat.add_comm] using rfl
    simp [flatMixedIntegerWitnessRealMatrix]
    rw [hnat, Fin.addCases_right]
    simp
  rw [Matrix.mulVec, dotProduct, Fin.sum_univ_add]
  simp_rw [hcoeffLeft, hcoeffRight]
  rw [Finset.sum_eq_single i]
  · simp
  · intro j _ hj
    simp [hj]
  · simp

/-- Helper for Corollary 4.31: the second equality-row block of the witness right-hand side is
zero. -/
private lemma flatMixedIntegerWitnessRhsSecondRow
    {m : ℕ}
    (b : Fin m → ℚ)
    (i : Fin n) :
    (↑(flatMixedIntegerWitnessRhs (n := n) b (Fin.natAdd m (Fin.natAdd n i))) : ℝ) = 0 := by
  have hnat : i.addNat n = Fin.natAdd n i := by
    apply Fin.ext
    simpa [Nat.add_comm] using rfl
  simp [flatMixedIntegerWitnessRhs]
  rw [hnat, Fin.addCases_right]

/-- Helper for Corollary 4.31: membership in the lifted witness polyhedron is exactly ambient
flattened feasibility together with the equalities tying the integer variables to the first block.
-/
private lemma memFlatMixedIntegerWitnessPolyhedron_iff
    {m : ℕ}
    {A : Matrix (Fin m) (Fin (n + p)) ℚ}
    {b : Fin m → ℚ}
    {z : Fin n → ℤ}
    {u : Fin (n + p) → ℝ} :
    ((fun i ↦ (z i : ℝ)), u) ∈
        rational_mixed_polyhedron
          (flatMixedIntegerWitnessIntMatrix (n := n) (m := m))
          (flatMixedIntegerWitnessRealMatrix (n := n) (p := p) A)
          (flatMixedIntegerWitnessRhs (n := n) b) ↔
      u ∈ polyhedron_le_set (A.map (Rat.castHom ℝ)) (fun i ↦ (b i : ℝ)) ∧
        (fun i : Fin n ↦ u (Fin.castAdd p i)) = fun i ↦ (z i : ℝ) := by
  rw [mem_rational_mixed_polyhedron_iff, mem_polyhedron_le_set_iff]
  constructor
  · intro h
    constructor
    · -- The leading `m` rows are exactly the original ambient inequalities.
      intro i
      have hi := h (Fin.castAdd (n + n) i)
      simpa [flatMixedIntegerWitnessIntMatrix, flatMixedIntegerWitnessRealMatrix,
        flatMixedIntegerWitnessRhs, Matrix.mulVec, dotProduct, Fin.sum_univ_add] using hi
    · -- The two `±Id` row blocks force equality between `z` and the first `n` coordinates.
      funext i
      apply le_antisymm
      · have hi := h (Fin.natAdd m (Fin.natAdd n i))
        have hIntRow := flatMixedIntegerWitnessIntSecondRow (n := n) (m := m) z i
        have hRealRow := flatMixedIntegerWitnessRealSecondRow (n := n) (p := p) (m := m) A u i
        rw [Pi.add_apply, hIntRow, hRealRow] at hi
        have hRhs :
            (fun j ↦ (flatMixedIntegerWitnessRhs (n := n) b j : ℝ))
                (Fin.natAdd m (Fin.natAdd n i)) = 0 := by
          simpa using flatMixedIntegerWitnessRhsSecondRow (n := n) (m := m) b i
        rw [hRhs] at hi
        have hi' : -(z i : ℝ) + u (Fin.castAdd p i) ≤ 0 := by
          exact hi
        -- The `u_i - z_i ≤ 0` inequality gives `u_i ≤ z_i`.
        have hi'' : u (Fin.castAdd p i) ≤ (z i : ℝ) := by
          linarith
        exact hi''
      · have hi := h (Fin.natAdd m (Fin.castAdd n i))
        have hIntRow := flatMixedIntegerWitnessIntFirstRow (n := n) (m := m) z i
        have hRealRow := flatMixedIntegerWitnessRealFirstRow (n := n) (p := p) (m := m) A u i
        rw [Pi.add_apply, hIntRow, hRealRow] at hi
        have hi' : (z i : ℝ) + -u (Fin.castAdd p i) ≤ 0 := by
          simpa [flatMixedIntegerWitnessRhs] using hi
        -- The `z_i - u_i ≤ 0` inequality gives `z_i ≤ u_i`.
        have hi'' : (z i : ℝ) ≤ u (Fin.castAdd p i) := by
          linarith
        exact hi''
  · rintro ⟨hu, huz⟩
    intro i
    -- Split the witness rows into the ambient block and the two equality blocks.
    refine Fin.addCases ?_ ?_ i
    · intro j
      have hj := hu j
      simpa [flatMixedIntegerWitnessIntMatrix, flatMixedIntegerWitnessRealMatrix,
        flatMixedIntegerWitnessRhs, Matrix.mulVec, dotProduct, Fin.sum_univ_add] using hj
    · intro j
      refine Fin.addCases ?_ ?_ j
      · intro j'
        have hj' : u (Fin.castAdd p j') = (z j' : ℝ) := congrFun huz j'
        have hIntRow := flatMixedIntegerWitnessIntFirstRow (n := n) (m := m) z j'
        have hRealRow :=
          flatMixedIntegerWitnessRealFirstRow (n := n) (p := p) (m := m) A u j'
        have hrow : (z j' : ℝ) + -u (Fin.castAdd p j') ≤ 0 := by
          simpa [hj']
        -- Repackage the coordinate equality as the corresponding equality-row inequality.
        rw [Pi.add_apply, hIntRow, hRealRow]
        simpa [flatMixedIntegerWitnessRhs] using hrow
      · intro j'
        have hj' : u (Fin.castAdd p j') = (z j' : ℝ) := congrFun huz j'
        have hIntRow := flatMixedIntegerWitnessIntSecondRow (n := n) (m := m) z j'
        have hRealRow :=
          flatMixedIntegerWitnessRealSecondRow (n := n) (p := p) (m := m) A u j'
        have hrow : -(z j' : ℝ) + u (Fin.castAdd p j') ≤ 0 := by
          simpa [hj']
        -- Repackage the same coordinate equality for the second equality-row block.
        rw [Pi.add_apply, hIntRow, hRealRow]
        have hRhs :
            (fun j ↦ (flatMixedIntegerWitnessRhs (n := n) b j : ℝ))
                (Fin.natAdd m (Fin.natAdd n j')) = 0 := by
          simpa using flatMixedIntegerWitnessRhsSecondRow (n := n) (m := m) b j'
        rw [hRhs]
        exact hrow

/-- Helper for Corollary 4.31: the flattened mixed-integer set is mixed-integer linear
representable, so Theorem 4.47 applies directly in the flattened ambient space. -/
private lemma flatMixedIntegerPoints_isMixedIntegerLinearRepresentable
    (P : Set (MixedRealPoint n p))
    (hP : is_rational_mixed_polyhedron P) :
    is_mixed_integer_linear_representable ((Fin.appendEquiv n p) '' mixed_integer_points P) := by
  rcases (show is_rational_polyhedron ((Fin.appendEquiv n p) '' P) from hP) with
    ⟨m, A, b, hPflat_eq⟩
  let W : Set (MixedRealPoint n (n + p)) :=
    rational_mixed_polyhedron
      (flatMixedIntegerWitnessIntMatrix (n := n) (m := m))
      (flatMixedIntegerWitnessRealMatrix (n := n) (p := p) A)
      (flatMixedIntegerWitnessRhs (n := n) b)
  -- Route correction: work with the flattened rational presentation of `P` directly so the
  -- witness polyhedron matches the explicit `±Id` normalization lemma above.
  rw [is_mixed_integer_linear_representable_iff]
  refine ⟨0, n, W, ?_, ?_⟩
  · -- The witness polyhedron is rational by construction.
    refine (is_rational_mixed_polyhedron_iff).2 ?_
    refine ⟨m + (n + n), flatMixedIntegerWitnessIntMatrix (n := n) (m := m),
      flatMixedIntegerWitnessRealMatrix (n := n) (p := p) A,
      flatMixedIntegerWitnessRhs (n := n) b, rfl⟩
  · -- Identify the flattened mixed-integer set with the witness `x`-projection.
    ext u
    rw [mem_mixed_integer_x_projection_iff]
    constructor
    · intro hu
      rcases (memFlatMixedIntegerPoints_iff (P := P) (u := u)).1 hu with ⟨huP, huZ⟩
      rw [hPflat_eq] at huP
      rcases (mem_integerVectors_iff (n := n) (x := fun i : Fin n ↦ u (Fin.castAdd p i))).1 huZ
        with ⟨z, hz⟩
      refine ⟨(fun j : Fin 0 ↦ Fin.elim0 j), z, ?_⟩
      have hwitness : ((fun j ↦ (z j : ℝ)), u) ∈ W := by
        rw [memFlatMixedIntegerWitnessPolyhedron_iff]
        exact ⟨huP, hz⟩
      simpa [W]
        using hwitness
    · rintro ⟨y, z, hzW⟩
      have hyappend : Fin.append u y = u := by
        funext i
        simpa using Fin.append_left u y i
      have hzWitness :
          ((fun j ↦ (z j : ℝ)), u) ∈
            rational_mixed_polyhedron
              (flatMixedIntegerWitnessIntMatrix (n := n) (m := m))
              (flatMixedIntegerWitnessRealMatrix (n := n) (p := p) A)
              (flatMixedIntegerWitnessRhs (n := n) b) := by
        simpa [W, hyappend] using hzW
      have hzW' :=
        (memFlatMixedIntegerWitnessPolyhedron_iff
          (n := n) (p := p) (m := m) (A := A) (b := b) (z := z) (u := u)).1 hzWitness
      have huP : u ∈ Fin.appendEquiv n p '' P := by
        rw [hPflat_eq]
        simpa using hzW'.1
      have huZ : (fun i : Fin n ↦ u (Fin.castAdd p i)) ∈ integerVectors n := by
        refine (mem_integerVectors_iff (n := n)
          (x := fun i : Fin n ↦ u (Fin.castAdd p i))).2 ?_
        refine ⟨z, ?_⟩
        funext i
        have hi := congrFun hzW'.2 i
        simpa using hi
      exact (memFlatMixedIntegerPoints_iff (P := P) (u := u)).2 ⟨huP, huZ⟩

/-- Helper for Corollary 4.31: flattening sends the mixed integer cone to the ordinary integral
cone generated by the flattened directions. -/
private lemma appendEquiv_image_mixedIntegerIntcone_eq_integralIntcone
    (r : Fin q → (Fin n → ℤ) × (Fin p → ℤ)) :
    Fin.appendEquiv n p '' mixed_integer_intcone r =
      integral_intcone (fun j : Fin q ↦ Fin.append (r j).1 (r j).2) := by
  ext u
  constructor
  · rintro ⟨x, hx, rfl⟩
    rcases hx with ⟨v, hv, rfl⟩
    rw [appendEquivSymmApply (n := n) (p := p) v]
    exact hv
  · intro hu
    refine ⟨(Fin.appendEquiv n p).symm u, ?_, ?_⟩
    · exact ⟨u, hu, rfl⟩
    · simpa using appendEquivSymmApply (n := n) (p := p) u

/-- Helper for Corollary 4.31: flattening transports the finite-union-plus-mixed-integer-cone
decomposition to the ambient flat union-plus-integral-cone decomposition. -/
private lemma appendEquiv_image_iUnion_add_mixedIntegerIntcone_eq
    {k : ℕ}
    (P' : Fin k → Set (MixedRealPoint n p))
    (r : Fin q → (Fin n → ℤ) × (Fin p → ℤ)) :
    Fin.appendEquiv n p '' ((⋃ i : Fin k, P' i) + mixed_integer_intcone r) =
      (⋃ i : Fin k, Fin.appendEquiv n p '' P' i) +
        integral_intcone (fun j : Fin q ↦ Fin.append (r j).1 (r j).2) := by
  ext u
  constructor
  · rintro ⟨xy, hxy, rfl⟩
    rcases hxy with ⟨a, ha, b, hb, rfl⟩
    rcases Set.mem_iUnion.1 ha with ⟨i, hai⟩
    have hb' :
        Fin.appendEquiv n p b ∈ integral_intcone (fun j : Fin q ↦ Fin.append (r j).1 (r j).2) := by
      rw [← appendEquiv_image_mixedIntegerIntcone_eq_integralIntcone (n := n) (p := p) (q := q) r]
      exact ⟨b, hb, rfl⟩
    refine Set.mem_add.2 ⟨Fin.appendEquiv n p a, ?_, Fin.appendEquiv n p b, hb', ?_⟩
    · exact Set.mem_iUnion.2 ⟨i, ⟨a, hai, rfl⟩⟩
    · ext j
      refine Fin.addCases ?_ ?_ j
      · intro t
        simp [Fin.appendEquiv]
      · intro t
        simp [Fin.appendEquiv]
  · rintro ⟨u₁, hu₁, u₂, hu₂, hu_eq⟩
    rcases Set.mem_iUnion.1 hu₁ with ⟨i, hu₁⟩
    rcases hu₁ with ⟨a, ha, rfl⟩
    have hu₂' : (Fin.appendEquiv n p).symm u₂ ∈ mixed_integer_intcone r := by
      exact ⟨u₂, hu₂, rfl⟩
    refine ⟨a + (Fin.appendEquiv n p).symm u₂, Set.mem_add.2 ⟨a, Set.mem_iUnion.2 ⟨i, ha⟩,
      (Fin.appendEquiv n p).symm u₂, hu₂', rfl⟩, ?_⟩
    calc
      Fin.appendEquiv n p (a + (Fin.appendEquiv n p).symm u₂)
          = Fin.appendEquiv n p a + Fin.appendEquiv n p ((Fin.appendEquiv n p).symm u₂) := by
              ext j
              refine Fin.addCases ?_ ?_ j
              · intro t
                simp [Fin.appendEquiv]
              · intro t
                simp [Fin.appendEquiv]
      _ = Fin.appendEquiv n p a + u₂ := by
            congr 1
            simpa using appendEquivSymmApply (n := n) (p := p) u₂
      _ = u := hu_eq

/-- Corollary 4.31. Let `P ⊆ ℝ^n × ℝ^p` be a rational polyhedron and
`S := P ∩ (ℤ^n × ℝ^p)`. Then there exist finitely many rational polytopes
`P₁, ..., P_k ⊆ ℝ^n × ℝ^p` and integral directions `r¹, ..., r^q ∈ ℤ^n × ℤ^p` such that
`S = (⋃ i, Pᵢ) + intcone {r¹, ..., r^q}`. -/
theorem mixed_integer_points_eq_iUnion_rational_polytopes_add_intcone
    (P : Set (MixedRealPoint n p))
    (hP : is_rational_mixed_polyhedron P) :
    ∃ k q : ℕ,
      ∃ P' : Fin k → Set (MixedRealPoint n p),
        ∃ r : Fin q → (Fin n → ℤ) × (Fin p → ℤ),
          (∀ i : Fin k, is_mixed_rational_polytope (P' i)) ∧
            mixed_integer_points P = (⋃ i : Fin k, P' i) + mixed_integer_intcone r := by
  -- Route correction: the source cites Theorem 4.30, but the import graph goes the other way.
  -- We therefore apply Theorem 4.47 directly to the flattened mixed-integer set.
  have hrepr :
      is_mixed_integer_linear_representable ((Fin.appendEquiv n p) '' mixed_integer_points P) :=
    flatMixedIntegerPoints_isMixedIntegerLinearRepresentable (n := n) (p := p) P hP
  rcases
    (mixed_integer_linear_representable_iff_union_rational_polytopes_add_integral_intcone
      ((Fin.appendEquiv n p) '' mixed_integer_points P)).1 hrepr with
    ⟨k, q, Q, rFlat, hQ, hSflat⟩
  let P' : Fin k → Set (MixedRealPoint n p) :=
    fun i ↦ (Fin.appendEquiv n p).symm '' Q i
  let r : Fin q → (Fin n → ℤ) × (Fin p → ℤ) :=
    fun j ↦
      (fun i ↦ rFlat j (Fin.castAdd p i),
        fun i ↦ rFlat j (Fin.natAdd n i))
  have hrFlat :
      (fun j : Fin q ↦ Fin.append (r j).1 (r j).2) = rFlat := by
    -- Recombine the split rays to recover the flat ray family from Theorem 4.47.
    funext j
    ext i
    refine Fin.addCases ?_ ?_ i
    · intro t
      simp [r]
    · intro t
      simp [r]
  have hP'rational : ∀ i : Fin k, is_mixed_rational_polytope (P' i) := by
    intro i
    -- Pulling a flat rational polytope back through `Fin.appendEquiv` preserves rationality.
    have hPi : Fin.appendEquiv n p '' P' i = Q i := by
      simpa [P'] using appendEquiv_image_symm_eq (n := n) (p := p) (S := Q i)
    simpa [is_mixed_rational_polytope, hPi] using hQ i
  have hImage :
      Fin.appendEquiv n p '' ((⋃ i : Fin k, P' i) + mixed_integer_intcone r) =
        (⋃ i : Fin k, Q i) + integral_intcone rFlat := by
    have hP'image : (fun i : Fin k ↦ Fin.appendEquiv n p '' P' i) = Q := by
      funext i
      simpa [P'] using appendEquiv_image_symm_eq (n := n) (p := p) (S := Q i)
    calc
      Fin.appendEquiv n p '' ((⋃ i : Fin k, P' i) + mixed_integer_intcone r)
          = (⋃ i : Fin k, Fin.appendEquiv n p '' P' i) +
              integral_intcone (fun j : Fin q ↦ Fin.append (r j).1 (r j).2) := by
                exact appendEquiv_image_iUnion_add_mixedIntegerIntcone_eq (n := n) (p := p) (q := q) P' r
      _ = (⋃ i : Fin k, Q i) + integral_intcone rFlat := by
            simp [hP'image, hrFlat]
  have hEqImage :
      Fin.appendEquiv n p '' mixed_integer_points P =
        Fin.appendEquiv n p '' ((⋃ i : Fin k, P' i) + mixed_integer_intcone r) := by
    calc
      Fin.appendEquiv n p '' mixed_integer_points P = (⋃ i : Fin k, Q i) + integral_intcone rFlat := hSflat
      _ = Fin.appendEquiv n p '' ((⋃ i : Fin k, P' i) + mixed_integer_intcone r) := by
            symm
            exact hImage
  refine ⟨k, q, P', r, hP'rational, ?_⟩
  ext xy
  constructor
  · intro hxy
    have hxy' :
        Fin.appendEquiv n p xy ∈ Fin.appendEquiv n p '' ((⋃ i : Fin k, P' i) + mixed_integer_intcone r) := by
      rw [← hEqImage]
      exact ⟨xy, hxy, rfl⟩
    rcases hxy' with ⟨xy', hxy', hxyEq⟩
    exact (Fin.appendEquiv n p).injective hxyEq ▸ hxy'
  · intro hxy
    have hxy' :
        Fin.appendEquiv n p xy ∈ Fin.appendEquiv n p '' mixed_integer_points P := by
      rw [hEqImage]
      exact ⟨xy, hxy, rfl⟩
    rcases hxy' with ⟨xy', hxy', hxyEq⟩
    exact (Fin.appendEquiv n p).injective hxyEq ▸ hxy'

end Corollary431
