    · intro i j
      have hPi_nonempty : Set.Nonempty (P i) := by
        exact nonempty_of_mixed_integer_points_nonempty (by
          dsimp [P]
          by_cases hi : Set.Nonempty (mixed_integer_points (Q0 i))
