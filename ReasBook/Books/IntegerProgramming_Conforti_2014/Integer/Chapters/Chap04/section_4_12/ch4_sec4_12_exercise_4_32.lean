          · simpa [hi] using hi0_nonempty)
      have hPj_nonempty : Set.Nonempty (P j) := by
        exact nonempty_of_mixed_integer_points_nonempty (by
          dsimp [P]
          by_cases hj : Set.Nonempty (mixed_integer_points (Q0 j))
          · simpa [hj] using hj
          · simpa [hj] using hi0_nonempty)
      dsimp [P, Q0]
      by_cases hi : Set.Nonempty (mixed_integer_points
        (rational_mixed_polyhedron AprojInt AprojReal (bproj (e0.symm i))))
      · have hPi_nonempty' :
            Set.Nonempty (rational_mixed_polyhedron AprojInt AprojReal (bproj (e0.symm i))) :=
          nonempty_of_mixed_integer_points_nonempty hi
        by_cases hj : Set.Nonempty (mixed_integer_points
          (rational_mixed_polyhedron AprojInt AprojReal (bproj (e0.symm j))))
        · simpa [hi, hj] using
            (recessionCone_rationalMixedPolyhedron_eq_of_rhs_of_nonempty
              (A := AprojInt) (G := AprojReal)
              (b := bproj (e0.symm i)) (b' := bproj (e0.symm j))
              hPi_nonempty' (nonempty_of_mixed_integer_points_nonempty hj))
        · simpa [hi, hj] using
            (recessionCone_rationalMixedPolyhedron_eq_of_rhs_of_nonempty
              (A := AprojInt) (G := AprojReal)
              (b := bproj (e0.symm i)) (b' := bproj (e0.symm i0))
              hPi_nonempty' (nonempty_of_mixed_integer_points_nonempty hi0_nonempty))
      · by_cases hj : Set.Nonempty (mixed_integer_points
          (rational_mixed_polyhedron AprojInt AprojReal (bproj (e0.symm j))))
        · simpa [hi, hj] using
            (recessionCone_rationalMixedPolyhedron_eq_of_rhs_of_nonempty
              (A := AprojInt) (G := AprojReal)
              (b := bproj (e0.symm i0)) (b' := bproj (e0.symm j))
              (nonempty_of_mixed_integer_points_nonempty hi0_nonempty)
              (nonempty_of_mixed_integer_points_nonempty hj))
        · simpa [hi, hj] using
            (recessionCone_rationalMixedPolyhedron_eq_of_rhs_of_nonempty
              (A := AprojInt) (G := AprojReal)
              (b := bproj (e0.symm i0)) (b' := bproj (e0.symm i0))
              (nonempty_of_mixed_integer_points_nonempty hi0_nonempty)
              (nonempty_of_mixed_integer_points_nonempty hi0_nonempty))
  · rintro ⟨k, P, hP_rational, hP_nonempty, hP_eq, hP_recession⟩
    have hS_nonempty_union :
        Set.Nonempty (⋃ i : Fin k, mixed_integer_points (P i)) := by
      simpa [hP_eq] using hS_nonempty
    obtain ⟨i, _⟩ :=
      exists_nonempty_component_of_nonempty_iUnion_mixed_integer_points hS_nonempty_union
    have hk_pos : 0 < k := by
      simpa using Fintype.card_pos_iff.mpr ⟨i⟩
    rcases existsExplicitPresentation_of_rationalMixedPolyhedronFamily P hP_rational with
      ⟨mQ, AintQ, ArealQ, bQ, hQ_eq⟩
    have hQ_poly_nonempty :
        ∀ i : Fin k,
          Set.Nonempty (rational_mixed_polyhedron (AintQ i) (ArealQ i) (bQ i)) :=
      nonemptyExplicitPresentation_of_nonemptyMixedIntegerFamily hQ_eq hP_nonempty
    have hQ_recession :
        ∀ i j : Fin k,
          recessionCone (rational_mixed_polyhedron (AintQ i) (ArealQ i) (bQ i)) =
            recessionCone (rational_mixed_polyhedron (AintQ j) (ArealQ j) (bQ j)) :=
      recessionCone_eq_of_explicitPresentationFamily hQ_eq hP_recession
    simpa [hP_eq, hQ_eq] using
      isMixedBinaryLinearRepresentable_iUnion_mixedIntegerPoints_of_sharedRecession
      (mQ := mQ) (AintQ := AintQ) (ArealQ := ArealQ) (bQ := bQ)
      hk_pos hQ_poly_nonempty hQ_recession
