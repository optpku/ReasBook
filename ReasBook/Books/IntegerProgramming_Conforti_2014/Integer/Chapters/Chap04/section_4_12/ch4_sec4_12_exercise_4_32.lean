open scoped BigOperators Matrix MixedIntegerNotation

namespace Set

/-- Helper for Exercise 4.32: a subset of `ℝ^n` is a rational polytope when it is the convex hull
of finitely many rational points. -/
def IsRationalPolytope {n : ℕ} (P : Set (Fin n → ℝ)) : Prop :=
  ∃ k : ℕ,
    ∃ v : Fin k → Fin n → ℚ,
      P = convexHull ℝ (Set.range fun i : Fin k ↦ fun j : Fin n ↦ (v i j : ℝ))

end Set

/-- Helper for Exercise 4.32: the integer cone generated by finitely many integral directions,
viewed inside the ambient real space. -/
def integral_intcone
    {n t : ℕ} (r : Fin t → Fin n → ℤ) : Set (Fin n → ℝ) :=
  {x : Fin n → ℝ |
    ∃ a : Fin t → ℕ,
      x = ∑ j : Fin t, (a j : ℝ) • (fun i : Fin n ↦ (r j i : ℝ))}

/-- Helper for Exercise 4.32: membership in `integral_intcone r` is exactly an integral
nonnegative combination of the listed generators. -/
theorem mem_integral_intcone_iff
    {n t : ℕ} {r : Fin t → Fin n → ℤ} {x : Fin n → ℝ} :
    x ∈ integral_intcone r ↔
      ∃ a : Fin t → ℕ,
        x = ∑ j : Fin t, (a j : ℝ) • (fun i : Fin n ↦ (r j i : ℝ)) := by
  rfl

/-- Helper for Exercise 4.32: the projection cone of `B` consists of the nonnegative row
multipliers that annihilate `B`. -/
def polyhedron_projection_cone
    {m p : ℕ}
    (B : Matrix (Fin m) (Fin p) ℝ) : Set (Fin m → ℝ) :=
  {u | 0 ≤ u ∧ u ᵥ* B = 0}

/-- Helper for Exercise 4.32: membership in `polyhedron_projection_cone B` unfolds to pointwise
nonnegativity together with the annihilation condition `u ᵥ* B = 0`. -/
theorem mem_polyhedron_projection_cone_iff
    {m p : ℕ}
    {B : Matrix (Fin m) (Fin p) ℝ}
    {u : Fin m → ℝ} :
    u ∈ polyhedron_projection_cone B ↔ 0 ≤ u ∧ u ᵥ* B = 0 := by
  rfl

/-- Helper for Exercise 4.32: membership in the projection of a product set along `Prod.fst` is
exactly the existence of a second coordinate. -/
private theorem mem_image_fst_iff
    {α β : Type*}
    {S : Set (α × β)}
    {x : α} :
    x ∈ Prod.fst '' S ↔ ∃ y : β, (x, y) ∈ S := by
  constructor
  · rintro ⟨xy, hxy, rfl⟩
    exact ⟨xy.2, hxy⟩
  · rintro ⟨y, hy⟩
    exact ⟨(x, y), hy, rfl⟩

/-- The projection onto the original mixed space `ℝ^n × ℝ^p` of the rational mixed-binary system
`Aint x_int + Areal x_real + B y + C z ≤ d`, where the original block `x_int` is integral and
the auxiliary integer vector `z` is binary. -/
def mixed_binary_linear_projection
    {n p m q r : ℕ}
    (Aint : Matrix (Fin r) (Fin n) ℚ)
    (Areal : Matrix (Fin r) (Fin p) ℚ)
    (B : Matrix (Fin r) (Fin m) ℚ)
    (C : Matrix (Fin r) (Fin q) ℚ)
    (d : Fin r → ℚ) : Set (MixedRealPoint n p) :=
  {xy : MixedRealPoint n p |
    xy ∈ (ℤ^n×ℝ^p) ∧
      ∃ y : Fin m → ℝ,
        ∃ z : Fin q → ℤ,
          is_zero_one_vector (fun j ↦ (z j : ℝ)) ∧
            ∀ i : Fin r,
              (∑ j : Fin n, (Aint i j : ℝ) * xy.1 j) +
                  (∑ j : Fin p, (Areal i j : ℝ) * xy.2 j) +
                  (∑ j : Fin m, (B i j : ℝ) * y j) +
                  (∑ j : Fin q, (C i j : ℝ) * (z j : ℝ)) ≤
                (d i : ℝ)}

/-- Membership in `mixed_binary_linear_projection Aint Areal B C d` is exactly the existence of
auxiliary real variables `y` and binary auxiliary integer variables `z` satisfying the displayed
rational mixed-binary system, together with integrality of the original `x_int`-block. -/
theorem mem_mixed_binary_linear_projection_iff
    {n p m q r : ℕ}
    {Aint : Matrix (Fin r) (Fin n) ℚ}
    {Areal : Matrix (Fin r) (Fin p) ℚ}
    {B : Matrix (Fin r) (Fin m) ℚ}
    {C : Matrix (Fin r) (Fin q) ℚ}
    {d : Fin r → ℚ}
    {xy : MixedRealPoint n p} :
    xy ∈ mixed_binary_linear_projection Aint Areal B C d ↔
      xy ∈ (ℤ^n×ℝ^p) ∧
        ∃ y : Fin m → ℝ,
          ∃ z : Fin q → ℤ,
            is_zero_one_vector (fun j ↦ (z j : ℝ)) ∧
              ∀ i : Fin r,
                (∑ j : Fin n, (Aint i j : ℝ) * xy.1 j) +
                    (∑ j : Fin p, (Areal i j : ℝ) * xy.2 j) +
                    (∑ j : Fin m, (B i j : ℝ) * y j) +
                    (∑ j : Fin q, (C i j : ℝ) * (z j : ℝ)) ≤
                  (d i : ℝ) :=
  Iff.rfl

/-- A subset of `ℝ^n × ℝ^p` is mixed binary linear representable when it is the projection of a
rational mixed-binary linear system onto the original mixed-space variables. -/
def is_mixed_binary_linear_representable
    {n p : ℕ} (S : Set (MixedRealPoint n p)) : Prop :=
  ∃ r m q : ℕ,
    ∃ Aint : Matrix (Fin r) (Fin n) ℚ,
      ∃ Areal : Matrix (Fin r) (Fin p) ℚ,
        ∃ B : Matrix (Fin r) (Fin m) ℚ,
          ∃ C : Matrix (Fin r) (Fin q) ℚ,
            ∃ d : Fin r → ℚ,
              S = mixed_binary_linear_projection Aint Areal B C d

/-- A binary vector whose coordinates sum to `1` has a unique active coordinate. -/
theorem binary_one_hot_selector
    {k : ℕ}
    (δ : Fin k → ℤ)
    (hδ_binary : is_zero_one_vector (fun i ↦ (δ i : ℝ)))
    (hδ_sum : ∑ i : Fin k, δ i = 1) :
    ∃! j : Fin k, δ j = 1 := by
  have hδ_binary_int : ∀ i : Fin k, δ i = 0 ∨ δ i = 1 := by
    intro i
    rcases hδ_binary i with hzero | hone
    · left
      have hzero_real : (δ i : ℝ) = 0 := by
        simpa using hzero
      have hzero' : δ i = 0 := by
        exact_mod_cast hzero_real
      exact hzero'
    · right
      have hone_real : (δ i : ℝ) = 1 := by
        simpa using hone
      have hone' : δ i = 1 := by
        exact_mod_cast hone_real
      exact hone'
  have hδ_nonneg : ∀ i : Fin k, 0 ≤ δ i := by
    intro i
    rcases hδ_binary_int i with hzero | hone
    · simp [hzero]
    · simp [hone]
  have h_exists_ne_zero : ∃ j : Fin k, δ j ≠ 0 := by
    by_contra hnone
    push Not at hnone
    have hsum_zero : ∑ i : Fin k, δ i = 0 := by
      simp [hnone]
    linarith
  rcases h_exists_ne_zero with ⟨j, hj_ne_zero⟩
  have hj_one : δ j = 1 := by
    rcases hδ_binary_int j with hzero | hone
    · exact False.elim (hj_ne_zero hzero)
    · exact hone
  refine ⟨j, hj_one, ?_⟩
  intro i hi_one
  by_cases hij : i = j
  · exact hij
  let rest : ℤ := Finset.sum (Finset.univ.erase j) fun t : Fin k ↦ δ t
  have hsplit : rest + δ j = ∑ t : Fin k, δ t := by
    unfold rest
    simpa [add_comm] using
      (Finset.sum_erase_add (fun t : Fin k ↦ δ t) (Finset.mem_univ j))
  have hrest_zero : rest = 0 := by
    rw [hδ_sum] at hsplit
    rw [hj_one] at hsplit
    omega
  have hi_mem : i ∈ Finset.univ.erase j := by
    simp [hij]
  have hi_le_rest : δ i ≤ rest := by
    unfold rest
    refine Finset.single_le_sum ?_ hi_mem
    intro t ht
    exact hδ_nonneg t
  have hi_zero : δ i = 0 := by
    have hi_nonneg : 0 ≤ δ i := hδ_nonneg i
    rw [hrest_zero] at hi_le_rest
    linarith
  exact False.elim (by omega)

/-- Helper for Exercise 4.32: encode a Boolean assignment as its integer `0/1` vector. -/
def binary_assignment_to_int
    {q : ℕ} (β : Fin q → Bool) : Fin q → ℤ :=
  fun j ↦ if β j then 1 else 0

/-- Helper for Exercise 4.32: the integer encoding of a Boolean assignment is a `0/1` vector. -/
lemma binary_assignment_to_int_is_zero_one_vector
    {q : ℕ} (β : Fin q → Bool) :
    is_zero_one_vector (fun j ↦ ((binary_assignment_to_int β) j : ℝ)) := by
  -- Each coordinate is definitionally either `0` or `1`.
  intro j
  by_cases hβ : β j
  · right
    simp [binary_assignment_to_int, hβ]
  · left
    simp [binary_assignment_to_int, hβ]

/-- Helper for Exercise 4.32: every integral `0/1` vector comes from a Boolean assignment. -/
lemma exists_binary_assignment_eq_of_zero_one_integer_vector
    {q : ℕ} {z : Fin q → ℤ}
    (hz : is_zero_one_vector (fun j ↦ (z j : ℝ))) :
    ∃ β : Fin q → Bool, z = binary_assignment_to_int β := by
  let β : Fin q → Bool := fun j ↦ decide (z j = 1)
  refine ⟨β, funext ?_⟩
  intro j
  by_cases h1 : z j = 1
  · -- If the coordinate is `1`, the Boolean decoder sends it back to `true`.
    simp [β, binary_assignment_to_int, h1]
  · -- Otherwise the zero-one hypothesis forces the coordinate to be `0`.
    have hzj := hz j
    rcases hzj with hz0 | hz1
    · have hz0' : z j = 0 := by
        have hz0_real : (z j : ℝ) = 0 := by
          simpa using hz0
        exact_mod_cast hz0_real
      simp [β, binary_assignment_to_int, hz0']
    · have hz1' : z j = 1 := by
        have hz1_real : (z j : ℝ) = 1 := by
          simpa using hz1
        exact_mod_cast hz1_real
      exact False.elim (h1 hz1')

/-- Helper for Exercise 4.32: nonemptiness of `mixed_integer_points P` yields a point of the
ambient set `P`. -/
lemma nonempty_of_mixed_integer_points_nonempty
    {n p : ℕ}
    {P : Set (MixedRealPoint n p)}
    (hS_nonempty : Set.Nonempty (mixed_integer_points P)) :
    Set.Nonempty P := by
  rcases hS_nonempty with ⟨xy, hxy⟩
  -- Forget the integrality side condition and keep the ambient membership.
  exact ⟨xy, (mem_mixed_integer_points_iff).1 hxy |>.1⟩

/-- Helper for Exercise 4.32: the source-facing finitely generated cone agrees with the canonical
pointed-cone hull on the same generating set. -/
private lemma pointedConeHull_eq_cone
    {n : ℕ} (S : Set (Fin n → ℝ)) :
    (PointedCone.hull ℝ S : Set (Fin n → ℝ)) = cone S :=
  rfl

/-- Helper for Exercise 4.32: the finite ray family `rays` defines the same cone whether it is
read through `finitely_generated_cone` or through the matrix-column owner `matrix_cone`. -/
private lemma finitelyGeneratedCone_eq_matrixCone
    {n q : ℕ} (rays : Fin q → Fin n → ℝ) :
    finitely_generated_cone rays =
      (matrix_cone (fun i j ↦ rays j i) : Set (Fin n → ℝ)) := by
  -- Both owners package the same cone generated by the range of `rays`.
  calc
    finitely_generated_cone rays = cone (Set.range rays) := rfl
    _ = (PointedCone.hull ℝ (Set.range rays) : Set (Fin n → ℝ)) := by
          symm
          exact pointedConeHull_eq_cone (Set.range rays)
    _ = (matrix_cone (fun i j ↦ rays j i) : Set (Fin n → ℝ)) := by
          rfl

/-- Helper for Exercise 4.32: membership in `finitely_generated_cone rays` is exactly a
nonnegative linear combination of the listed rays. -/
private theorem mem_finitelyGeneratedCone_iff
    {n q : ℕ} {rays : Fin q → Fin n → ℝ} {x : Fin n → ℝ} :
    x ∈ finitely_generated_cone rays ↔
      ∃ μ : Fin q → ℝ, (∀ i : Fin q, 0 ≤ μ i) ∧ x = ∑ i, μ i • rays i := by
  -- Rewrite to the matrix-column cone and unpack the coefficient witness there.
  rw [finitelyGeneratedCone_eq_matrixCone rays]
  constructor
  · intro hx
    rcases mem_matrix_cone_iff.mp hx with ⟨μ, hμ_nonneg, hmul⟩
    refine ⟨μ, hμ_nonneg, ?_⟩
    ext i
    have hcoord := congrArg (fun v ↦ v i) hmul
    simpa [Matrix.mulVec, dotProduct, Pi.smul_apply, mul_comm] using hcoord.symm
  · rintro ⟨μ, hμ_nonneg, hsum⟩
    refine mem_matrix_cone_iff.mpr ⟨μ, hμ_nonneg, ?_⟩
    ext i
    rw [hsum]
    simp [Matrix.mulVec, dotProduct, Pi.smul_apply, mul_comm]

/-- Helper for Exercise 4.32: if the projection cone equals the cone generated by `rays`, then
each listed ray is itself a nonnegative multiplier annihilating `B`. -/
private lemma ray_mem_projectionCone
    {m p q : ℕ}
    (B : Matrix (Fin m) (Fin p) ℝ)
    (rays : Fin q → Fin m → ℝ)
    (h_cone : polyhedron_projection_cone B = closure (finitely_generated_cone rays))
    (t : Fin q) :
    0 ≤ rays t ∧ rays t ᵥ* B = 0 := by
  -- The singleton coefficient vector realizes `rays t` as a cone generator.
  have hray_mem : rays t ∈ finitely_generated_cone rays := by
    refine mem_finitelyGeneratedCone_iff.mpr ⟨Pi.single t 1, ?_, ?_⟩
    · intro s
      by_cases hs : s = t
      · subst hs
        norm_num
      · simp [hs]
    · ext i
      classical
      rw [Finset.sum_eq_single t]
      · simp
      · intro s hs hst
        simp [hst]
      · simp
  have hmem : rays t ∈ polyhedron_projection_cone B := by
    simpa [h_cone] using subset_closure hray_mem
  -- Transport the cone-membership witness back to the defining inequalities.
  exact mem_polyhedron_projection_cone_iff.mp hmem

/-- Helper for Exercise 4.32: any feasible projected point satisfies every inequality coming from
a nonnegative left-kernel multiplier of `B`. -/
private lemma multiplierEvaluation_le_of_feasible
    {m n p : ℕ}
    (A : Matrix (Fin m) (Fin n) ℝ)
    (B : Matrix (Fin m) (Fin p) ℝ)
    (b : Fin m → ℝ)
    {x : Fin n → ℝ}
    {u : Fin m → ℝ}
    (hx : ∃ z : Fin p → ℝ, A *ᵥ x + B *ᵥ z ≤ b)
    (hu : 0 ≤ u)
    (huB : u ᵥ* B = 0) :
    u ⬝ᵥ (A *ᵥ x) ≤ u ⬝ᵥ b := by
  rcases hx with ⟨z, hz⟩
  -- Multiply each row inequality by the nonnegative coefficient `u i` and sum.
  have hsum : u ⬝ᵥ (A *ᵥ x + B *ᵥ z) ≤ u ⬝ᵥ b := by
    simpa [dotProduct] using
      (Finset.sum_le_sum fun i _ ↦ mul_le_mul_of_nonneg_left (hz i) (hu i))
  have hzero : u ⬝ᵥ (B *ᵥ z) = 0 := by
    -- The `B`-part vanishes because `u` annihilates the auxiliary block.
    rw [Matrix.dotProduct_mulVec, huB]
    simp
  calc
    u ⬝ᵥ (A *ᵥ x) = u ⬝ᵥ (A *ᵥ x) + u ⬝ᵥ (B *ᵥ z) := by
      rw [hzero, add_zero]
    _ = u ⬝ᵥ (A *ᵥ x + B *ᵥ z) := by
      rw [dotProduct_add]
    _ ≤ u ⬝ᵥ b := hsum

/-- Helper for Exercise 4.32: feasibility of the projection system is equivalent to feasibility of
the shifted auxiliary system `B *ᵥ z ≤ b - A *ᵥ x`. -/
private lemma projectionFeasible_iff_shiftedSystemFeasible
    {m n p : ℕ}
    (A : Matrix (Fin m) (Fin n) ℝ)
    (B : Matrix (Fin m) (Fin p) ℝ)
    (b : Fin m → ℝ)
    (x : Fin n → ℝ) :
    (∃ z : Fin p → ℝ, A *ᵥ x + B *ᵥ z ≤ b) ↔
      (∃ z : Fin p → ℝ, B *ᵥ z ≤ b - A *ᵥ x) := by
  constructor
  · intro hx
    rcases hx with ⟨z, hz⟩
    -- Move the fixed `A *ᵥ x` term to the right-hand side row by row.
    refine ⟨z, ?_⟩
    intro i
    have hzi : (B *ᵥ z) i + (A *ᵥ x) i ≤ b i := by
      simpa [add_comm, add_left_comm, add_assoc] using hz i
    exact (le_sub_iff_add_le).2 hzi
  · intro hx
    rcases hx with ⟨z, hz⟩
    -- Reverse the same rowwise rearrangement.
    refine ⟨z, ?_⟩
    intro i
    have hzi : (B *ᵥ z) i + (A *ᵥ x) i ≤ b i := (le_sub_iff_add_le).1 (hz i)
    simpa [add_comm, add_left_comm, add_assoc] using hzi

/-- Helper for Exercise 4.32: every point of a finitely generated cone preserves the inequalities
already valid on each generator. -/
private lemma finitelyGeneratedConeEvaluation_le_of_raywise_le
    {m n q : ℕ}
    (A : Matrix (Fin m) (Fin n) ℝ)
    (b : Fin m → ℝ)
    (rays : Fin q → Fin m → ℝ)
    {x : Fin n → ℝ}
    {u : Fin m → ℝ}
    (h_raywise : ∀ t : Fin q, rays t ⬝ᵥ (A *ᵥ x) ≤ rays t ⬝ᵥ b)
    (hu : u ∈ finitely_generated_cone rays) :
    u ⬝ᵥ (A *ᵥ x) ≤ u ⬝ᵥ b := by
  rcases mem_finitelyGeneratedCone_iff.mp hu with ⟨μ, hμ_nonneg, rfl⟩
  -- Expand the multiplier as a conic combination of rays and sum the raywise inequalities.
  calc
    (∑ t : Fin q, μ t • rays t) ⬝ᵥ (A *ᵥ x)
        = ∑ t : Fin q, (μ t • rays t) ⬝ᵥ (A *ᵥ x) := by
          simpa using
            (sum_dotProduct Finset.univ (fun t : Fin q ↦ μ t • rays t) (A *ᵥ x))
    _ = ∑ t : Fin q, μ t * (rays t ⬝ᵥ (A *ᵥ x)) := by
          simp [smul_eq_mul]
    _ ≤ ∑ t : Fin q, μ t * (rays t ⬝ᵥ b) := by
          refine Finset.sum_le_sum ?_
          intro t ht
          exact mul_le_mul_of_nonneg_left (h_raywise t) (hμ_nonneg t)
    _ = ∑ t : Fin q, (μ t • rays t) ⬝ᵥ b := by
          simp [smul_eq_mul]
    _ = (∑ t : Fin q, μ t • rays t) ⬝ᵥ b := by
          symm
          simpa using (sum_dotProduct Finset.univ (fun t : Fin q ↦ μ t • rays t) b)

/-- Helper for Exercise 4.32: if a linear inequality holds on every point of a finitely generated
cone, then it also holds on the closure of that cone. -/
private lemma closureFinitelyGeneratedConeEvaluation_le_of_raywise_le
    {m n q : ℕ}
    (A : Matrix (Fin m) (Fin n) ℝ)
    (b : Fin m → ℝ)
    (rays : Fin q → Fin m → ℝ)
    {x : Fin n → ℝ}
    {u : Fin m → ℝ}
    (h_raywise : ∀ t : Fin q, rays t ⬝ᵥ (A *ᵥ x) ≤ rays t ⬝ᵥ b)
    (hu : u ∈ closure (finitely_generated_cone rays)) :
    u ⬝ᵥ (A *ᵥ x) ≤ u ⬝ᵥ b := by
  let H : Set (Fin m → ℝ) := {v | v ⬝ᵥ (A *ᵥ x) ≤ v ⬝ᵥ b}
  have hH_closed : IsClosed H := by
    have hLeft : Continuous fun v : Fin m → ℝ ↦ v ⬝ᵥ (A *ᵥ x) := by
      continuity
    have hRight : Continuous fun v : Fin m → ℝ ↦ v ⬝ᵥ b := by
      continuity
    exact isClosed_le hLeft hRight
  have hcone_subset : finitely_generated_cone rays ⊆ H := by
    intro v hv
    exact finitelyGeneratedConeEvaluation_le_of_raywise_le A b rays h_raywise hv
  exact (closure_minimal hcone_subset hH_closed) hu

/-- Helper for Exercise 4.32: the shifted system `B *ᵥ z ≤ d` is feasible exactly when every
nonnegative left-kernel multiplier of `B` evaluates nonnegatively on `d`. -/
private lemma shiftedSystemFeasible_iff_nonnegativeMultiplierNonnegative
    {m p : ℕ}
    (B : Matrix (Fin m) (Fin p) ℝ)
    (d : Fin m → ℝ) :
    (∃ z : Fin p → ℝ, B *ᵥ z ≤ d) ↔
      ∀ u : Fin m → ℝ, 0 ≤ u → u ᵥ* B = 0 → 0 ≤ u ⬝ᵥ d := by
  let h_farkas :=
    mixed_linear_system_feasible_iff_nonnegative_multiplier_evaluation
      (0 : Matrix (Fin m) (Fin 0) ℝ)
      B
      (0 : Matrix (Fin 0) (Fin 0) ℝ)
      (0 : Matrix (Fin 0) (Fin p) ℝ)
      d
      (0 : Fin 0 → ℝ)
  have h_left :
      (∃ x : Fin 0 → ℝ, ∃ z : Fin p → ℝ,
        0 ≤ x ∧
          (0 : Matrix (Fin m) (Fin 0) ℝ) *ᵥ x + B *ᵥ z ≤ d ∧
          (0 : Matrix (Fin 0) (Fin 0) ℝ) *ᵥ x + (0 : Matrix (Fin 0) (Fin p) ℝ) *ᵥ z = 0) ↔
        (∃ z : Fin p → ℝ, B *ᵥ z ≤ d) := by
    constructor
    · rintro ⟨x, z, _, hxz, _⟩
      exact ⟨z, by simpa using hxz⟩
    · rintro ⟨z, hz⟩
      exact ⟨0, z, by simp, by simpa using hz, by simp⟩
  have h_right :
      (∀ u : Fin m → ℝ, ∀ v : Fin 0 → ℝ,
        0 ≤ u →
          0 ≤ u ᵥ* (0 : Matrix (Fin m) (Fin 0) ℝ) + v ᵥ* (0 : Matrix (Fin 0) (Fin 0) ℝ) →
            u ᵥ* B + v ᵥ* (0 : Matrix (Fin 0) (Fin p) ℝ) = 0 →
              0 ≤ u ⬝ᵥ d + v ⬝ᵥ (0 : Fin 0 → ℝ)) ↔
        ∀ u : Fin m → ℝ, 0 ≤ u → u ᵥ* B = 0 → 0 ≤ u ⬝ᵥ d := by
    constructor
    · intro h u hu huB
      have huB' : u ᵥ* B + (0 : Fin 0 → ℝ) ᵥ* (0 : Matrix (Fin 0) (Fin p) ℝ) = 0 := by
        simpa using huB
      simpa using h u 0 hu (by simp) huB'
    · intro h u v hu _ huB
      have hv : v = 0 := by
        ext i
        exact Fin.elim0 i
      subst hv
      have huB' : u ᵥ* B = 0 := by
        simpa using huB
      simpa using h u hu huB'
  exact h_left.symm.trans (h_farkas.trans h_right)

/-- Helper for Exercise 4.32: infeasibility of the shifted auxiliary system yields a nonnegative
left-kernel multiplier with negative evaluation on the right-hand side. -/
private theorem shiftedSystemInfeasible_hasMultiplier
    {m p : ℕ}
    (B : Matrix (Fin m) (Fin p) ℝ)
    (d : Fin m → ℝ) :
    (¬ ∃ z : Fin p → ℝ, B *ᵥ z ≤ d) →
      ∃ u : Fin m → ℝ, 0 ≤ u ∧ u ᵥ* B = 0 ∧ u ⬝ᵥ d < 0 := by
  intro h_infeasible
  classical
  -- Negate the desired certificate and specialize the Farkas alternative.
  by_contra h_no_multiplier
  have h_nonnegative_eval :
      ∀ u : Fin m → ℝ, 0 ≤ u → u ᵥ* B = 0 → 0 ≤ u ⬝ᵥ d := by
    intro u hu_nonneg hu_annihilates
    -- Any negative evaluation would already be the missing infeasibility certificate.
    by_contra hu_negative
    exact h_no_multiplier ⟨u, hu_nonneg, hu_annihilates, lt_of_not_ge hu_negative⟩
  have h_feasible : ∃ z : Fin p → ℝ, B *ᵥ z ≤ d :=
    (shiftedSystemFeasible_iff_nonnegativeMultiplierNonnegative B d).2 h_nonnegative_eval
  exact h_infeasible h_feasible

/-- Helper for Exercise 4.32: if `polyhedron_projection_cone B` is generated by the listed rays,
then the `x`-projection of `A *ᵥ x + B *ᵥ z ≤ b` is cut out exactly by the multiplier
inequalities defined by those rays. -/
private theorem polyhedronProjectionEq_generatorInequalities
    {m n p q : ℕ}
    (A : Matrix (Fin m) (Fin n) ℝ)
    (B : Matrix (Fin m) (Fin p) ℝ)
    (b : Fin m → ℝ)
    (rays : Fin q → Fin m → ℝ)
    (h_cone : polyhedron_projection_cone B = closure (finitely_generated_cone rays)) :
    Prod.fst '' {xz : (Fin n → ℝ) × (Fin p → ℝ) | A *ᵥ xz.1 + B *ᵥ xz.2 ≤ b} =
      {x : Fin n → ℝ | ∀ t : Fin q, rays t ⬝ᵥ (A *ᵥ x) ≤ rays t ⬝ᵥ b} := by
  ext x
  rw [mem_image_fst_iff]
  constructor
  · intro hx t
    obtain ⟨hray_nonneg, hray_annihilates⟩ :=
      ray_mem_projectionCone B rays h_cone t
    exact multiplierEvaluation_le_of_feasible A B b hx hray_nonneg hray_annihilates
  · intro hx
    by_contra hx_not
    have hshift_infeasible : ¬ ∃ z : Fin p → ℝ, B *ᵥ z ≤ b - A *ᵥ x := by
      simpa [projectionFeasible_iff_shiftedSystemFeasible A B b x] using hx_not
    obtain ⟨u, hu_nonneg, hu_annihilates, hu_negative⟩ :=
      shiftedSystemInfeasible_hasMultiplier B (b - A *ᵥ x) hshift_infeasible
    have hmem : u ∈ polyhedron_projection_cone B := by
      exact mem_polyhedron_projection_cone_iff.mpr ⟨hu_nonneg, hu_annihilates⟩
    have hcone_mem : u ∈ closure (finitely_generated_cone rays) := by
      simpa [h_cone] using hmem
    have hu_nonnegative :
        0 ≤ u ⬝ᵥ (b - A *ᵥ x) := by
      have h_raywise : ∀ t : Fin q, rays t ⬝ᵥ (A *ᵥ x) ≤ rays t ⬝ᵥ b := hx
      have h_eval :=
        closureFinitelyGeneratedConeEvaluation_le_of_raywise_le
          A b rays h_raywise hcone_mem
      simpa [dotProduct_sub] using h_eval
    linarith

/-- Helper for Exercise 4.32: the explicit rational homogeneous system defining
`polyhedron_projection_cone (B.map (Rat.castHom ℝ))`. -/
def projectionConePresentationMatrix
    {r m : ℕ}
    (B : Matrix (Fin r) (Fin m) ℚ) :
    Matrix (Fin (m + (m + r))) (Fin r) ℚ :=
  fun i ↦
    Fin.addCases
      B.transpose
      (Fin.addCases (-B.transpose) fun j : Fin r ↦ -Pi.single j (1 : ℚ))
      i

/-- Helper for Exercise 4.32: the nonnegativity row `-Pi.single i 1` evaluates to `-u i`. -/
private lemma projectionConeCastNonnegRow
    {r : ℕ}
    (i : Fin r) :
    (fun j ↦ ((-(Pi.single i (1 : ℚ) : Fin r → ℚ)) j : ℝ)) =
      (fun j ↦ -((Pi.single i (1 : ℝ) : Fin r → ℝ) j)) := by
  -- Normalize the casted rational singleton row coordinatewise.
  ext j
  by_cases h : j = i
  · subst h
    simp [Pi.single]
  · simp [Pi.single, h]

/-- Helper for Exercise 4.32: the nonnegativity row `-Pi.single i 1` evaluates to `-u i`. -/
private lemma projectionConeNonnegRow_dot
    {r : ℕ}
    (u : Fin r → ℝ)
    (i : Fin r) :
    (fun j ↦ -((Pi.single i (1 : ℝ) : Fin r → ℝ) j)) ⬝ᵥ u = -u i := by
  -- Only the `i`th singleton coordinate contributes to the dot product.
  rw [dotProduct, Finset.sum_eq_single i]
  · simp
  · intro j _ hji
    simp [hji]
  · simp

/-- Helper for Exercise 4.32: the projection cone of a rational matrix is exactly one explicit
rational homogeneous inequality system. -/
lemma polyhedronProjectionCone_eq_polyhedronLeSet
    {r m : ℕ}
    (B : Matrix (Fin r) (Fin m) ℚ) :
    polyhedron_projection_cone (B.map (Rat.castHom ℝ)) =
      polyhedron_le_set ((projectionConePresentationMatrix B).map (Rat.castHom ℝ)) 0 := by
  ext u
  rw [mem_polyhedron_projection_cone_iff, mem_polyhedron_le_set_iff]
  constructor
  · rintro ⟨hu_nonneg, huB⟩
    intro s
    cases s using Fin.addCases with
    | left j =>
        have hj :
            ((((projectionConePresentationMatrix B).map (Rat.castHom ℝ)) *ᵥ u)
                (Fin.castAdd (m + r) j)) =
              ((((B.transpose).map (Rat.castHom ℝ)) *ᵥ u) j) := by
          simp [projectionConePresentationMatrix, Matrix.mulVec, Fin.addCases_left]
        rw [hj]
        have hzero : ((((B.transpose).map (Rat.castHom ℝ)) *ᵥ u) j) = 0 := by
          simpa [Matrix.transpose_map, Matrix.mulVec_transpose] using congrFun huB j
        rw [hzero]
        simp
    | right s =>
        cases s using Fin.addCases with
        | left j =>
            have hj :
                ((((projectionConePresentationMatrix B).map (Rat.castHom ℝ)) *ᵥ u)
                    (Fin.natAdd m (Fin.castAdd r j))) =
                  (((-((B.transpose).map (Rat.castHom ℝ))) *ᵥ u) j) := by
              simp [projectionConePresentationMatrix, Matrix.mulVec, Fin.addCases_right,
                Fin.addCases_left, Matrix.map_neg]
            rw [hj]
            have hzero : (((-((B.transpose).map (Rat.castHom ℝ))) *ᵥ u) j) = 0 := by
              simpa [Matrix.transpose_map, Matrix.neg_mulVec, Matrix.mulVec_transpose] using
                congrArg Neg.neg (congrFun huB j)
            rw [hzero]
            simp
        | right i =>
            have hi :
                ((((projectionConePresentationMatrix B).map (Rat.castHom ℝ)) *ᵥ u)
                    (Fin.natAdd m (Fin.natAdd m i))) =
                  -u i := by
              calc
                ((((projectionConePresentationMatrix B).map (Rat.castHom ℝ)) *ᵥ u)
                    (Fin.natAdd m (Fin.natAdd m i)))
                    =
                      (fun j ↦ ((-(Pi.single i (1 : ℚ) : Fin r → ℚ)) j : ℝ)) ⬝ᵥ u := by
                        simp [projectionConePresentationMatrix, Matrix.mulVec, Fin.addCases_right]
                _ = (fun j ↦ -((Pi.single i (1 : ℝ) : Fin r → ℝ) j)) ⬝ᵥ u := by
                      rw [projectionConeCastNonnegRow i]
                _ = -u i := projectionConeNonnegRow_dot u i
            rw [hi]
            exact neg_nonpos.mpr (hu_nonneg i)
  · intro hu
    refine ⟨?_, ?_⟩
    · intro i
      have hi_nonpos :
          ((((projectionConePresentationMatrix B).map (Rat.castHom ℝ)) *ᵥ u)
              (Fin.natAdd m (Fin.natAdd m i))) ≤ 0 :=
        hu (Fin.natAdd m (Fin.natAdd m i))
      have hi :
          ((((projectionConePresentationMatrix B).map (Rat.castHom ℝ)) *ᵥ u)
              (Fin.natAdd m (Fin.natAdd m i))) =
            -u i := by
        calc
          ((((projectionConePresentationMatrix B).map (Rat.castHom ℝ)) *ᵥ u)
              (Fin.natAdd m (Fin.natAdd m i)))
              =
                (fun j ↦ ((-(Pi.single i (1 : ℚ) : Fin r → ℚ)) j : ℝ)) ⬝ᵥ u := by
                  simp [projectionConePresentationMatrix, Matrix.mulVec, Fin.addCases_right]
          _ = (fun j ↦ -((Pi.single i (1 : ℝ) : Fin r → ℝ) j)) ⬝ᵥ u := by
                rw [projectionConeCastNonnegRow i]
          _ = -u i := projectionConeNonnegRow_dot u i
      rw [hi] at hi_nonpos
      exact neg_nonpos.mp hi_nonpos
    · ext j
      have hj_nonpos :
          ((((projectionConePresentationMatrix B).map (Rat.castHom ℝ)) *ᵥ u)
              (Fin.castAdd (m + r) j)) ≤ 0 :=
        hu (Fin.castAdd (m + r) j)
      have hj_neg_nonpos :
          ((((projectionConePresentationMatrix B).map (Rat.castHom ℝ)) *ᵥ u)
              (Fin.natAdd m (Fin.castAdd r j))) ≤ 0 :=
        hu (Fin.natAdd m (Fin.castAdd r j))
      have hj₁ : ((u ᵥ* (B.map (Rat.castHom ℝ))) j) ≤ 0 := by
        have hcol : ((((B.transpose).map (Rat.castHom ℝ)) *ᵥ u) j) ≤ 0 := by
          simpa [projectionConePresentationMatrix, Matrix.mulVec, Fin.addCases_left] using
            hj_nonpos
        simpa [Matrix.transpose_map, Matrix.mulVec_transpose] using hcol
      have hj₂ : 0 ≤ ((u ᵥ* (B.map (Rat.castHom ℝ))) j) := by
        have hnegcol :
            (((-((B.transpose).map (Rat.castHom ℝ))) *ᵥ u) j) ≤ 0 := by
          simpa [projectionConePresentationMatrix, Matrix.mulVec, Fin.addCases_right,
            Fin.addCases_left] using hj_neg_nonpos
        have hnegcol' : -((((B.transpose).map (Rat.castHom ℝ)) *ᵥ u) j) ≤ 0 := by
          simpa [Matrix.neg_mulVec] using hnegcol
        have hcol : 0 ≤ ((((B.transpose).map (Rat.castHom ℝ)) *ᵥ u) j) := by
          exact neg_nonpos.mp hnegcol'
        simpa [Matrix.transpose_map, Matrix.mulVec_transpose] using hcol
      exact le_antisymm hj₁ hj₂

/-- Helper for Exercise 4.32: a real matrix whose entries are all rational casts comes from a
genuine rational matrix. -/
lemma matrixEqRatCastOfEntrywiseRational
    {m n : ℕ} {A : Matrix (Fin m) (Fin n) ℝ}
    (hA : ∀ i j, ∃ q : ℚ, A i j = (q : ℝ)) :
    ∃ Aℚ : Matrix (Fin m) (Fin n) ℚ, A = Aℚ.map (Rat.castHom ℝ) := by
  classical
  let Aℚ : Matrix (Fin m) (Fin n) ℚ := fun i j ↦ Classical.choose (hA i j)
  -- Choose the rational witness entrywise and then reassemble the full matrix by extensionality.
  refine ⟨Aℚ, ?_⟩
  ext i j
  simpa [Aℚ] using Classical.choose_spec (hA i j)

/-- Helper for Exercise 4.32: the convex hull of a finite union of rational polytopes is the
convex hull of one finite rational vertex family. -/
private lemma convexHull_iUnion_rationalPolytopes_eq
    {n k : ℕ}
    {P : Fin k → Set (Fin n → ℝ)}
    (hP : ∀ i : Fin k, (P i).IsRationalPolytope) :
    ∃ p : ℕ,
      ∃ vertices : Fin p → Fin n → ℚ,
        convexHull ℝ (⋃ i : Fin k, P i) =
          convexHull ℝ
            (Set.range fun j : Fin p ↦ fun u : Fin n ↦ (vertices j u : ℝ)) := by
  classical
  choose m v hv using hP
  let ι := Σ i : Fin k, Fin (m i)
  let verticesSigma : ι → Fin n → ℚ := fun a ↦ v a.1 a.2
  let verticesSigmaReal : ι → Fin n → ℝ := fun a u ↦ (verticesSigma a u : ℝ)
  have hUnion_subset :
      (⋃ i : Fin k, P i) ⊆ convexHull ℝ (Set.range verticesSigmaReal) := by
    intro x hx
    rcases Set.mem_iUnion.1 hx with ⟨i, hxi⟩
    rw [hv i] at hxi
    exact
      (convexHull_mono fun y hy ↦ by
        rcases hy with ⟨j, rfl⟩
        exact ⟨⟨i, j⟩, rfl⟩) hxi
  have hVertices_subset :
      Set.range verticesSigmaReal ⊆ convexHull ℝ (⋃ i : Fin k, P i) := by
    rintro x ⟨⟨i, j⟩, rfl⟩
    exact subset_convexHull ℝ _ <| Set.mem_iUnion.2 ⟨i, by
      rw [hv i]
      exact subset_convexHull ℝ _ ⟨j, rfl⟩⟩
  have hHullSigma :
      convexHull ℝ (⋃ i : Fin k, P i) =
        convexHull ℝ (Set.range verticesSigmaReal) := by
    apply le_antisymm
    · exact convexHull_min hUnion_subset (convex_convexHull ℝ _)
    · exact convexHull_min hVertices_subset (convex_convexHull ℝ _)
  let p : ℕ := Fintype.card ι
  let e : Fin p ≃ ι := (Fintype.equivFin ι).symm
  let vertices : Fin p → Fin n → ℚ := fun j ↦ verticesSigma (e j)
  have hRange :
      Set.range (fun j : Fin p ↦ fun u : Fin n ↦ (vertices j u : ℝ)) =
        Set.range verticesSigmaReal := by
    ext x
    constructor
    · rintro ⟨j, rfl⟩
      exact ⟨e j, rfl⟩
    · rintro ⟨a, rfl⟩
      refine ⟨e.symm a, ?_⟩
      simp [vertices, verticesSigmaReal]
  refine ⟨p, vertices, ?_⟩
  rw [hRange]
  exact hHullSigma

/-- Helper for Exercise 4.32: finite systems of linear inequalities define closed sets. -/
private lemma isClosed_polyhedronLeSet
    {m n : ℕ} (A : Matrix (Fin m) (Fin n) ℝ) (b : Fin m → ℝ) :
    IsClosed (polyhedron_le_set A b) := by
  rw [show polyhedron_le_set A b = ⋂ i : Fin m, {x : Fin n → ℝ | (A *ᵥ x) i ≤ b i} by
    ext x
    constructor
    · intro hx
      simpa [polyhedron_le_set] using hx
    · intro hx
      simpa [polyhedron_le_set] using hx]
  refine isClosed_iInter ?_
  intro i
  have hcont : Continuous fun x : Fin n → ℝ ↦ (A *ᵥ x) i := by
    exact (continuous_apply i).comp A.mulVecLin.continuous_of_finiteDimensional
  exact isClosed_le hcont continuous_const

/-- Helper for Exercise 4.32: every integral cone generator gives a point of the associated real
finitely generated cone. -/
private lemma integralIntcone_subset_finitelyGeneratedCone
    {n t : ℕ}
    {r : Fin t → Fin n → ℤ}
    {x : Fin n → ℝ}
    (hx : x ∈ integral_intcone r) :
    x ∈ finitely_generated_cone (fun j : Fin t ↦ fun i : Fin n ↦ (r j i : ℝ)) := by
  rcases (mem_integral_intcone_iff).1 hx with ⟨a, rfl⟩
  exact (mem_finitelyGeneratedCone_iff).2 ⟨fun j ↦ (a j : ℝ), fun _ ↦ Nat.cast_nonneg _, rfl⟩

/-- Helper for Exercise 4.32: the integral cone is closed under addition. -/
private lemma add_mem_integralIntcone
    {n t : ℕ}
    {r : Fin t → Fin n → ℤ}
    {u v : Fin n → ℝ}
    (hu : u ∈ integral_intcone r)
    (hv : v ∈ integral_intcone r) :
    u + v ∈ integral_intcone r := by
  rcases (mem_integral_intcone_iff).1 hu with ⟨a, rfl⟩
  rcases (mem_integral_intcone_iff).1 hv with ⟨b, rfl⟩
  refine (mem_integral_intcone_iff).2 ?_
  refine ⟨fun j ↦ a j + b j, ?_⟩
  simp [Finset.sum_add_distrib, Nat.cast_add, add_smul]

/-- Helper for Exercise 4.32: every natural multiple of a listed integral generator belongs to the
integral cone generated by the full family. -/
private lemma nat_smul_generator_mem_integralIntcone
    {n t : ℕ}
    (r : Fin t → Fin n → ℤ)
    (j : Fin t)
    (m : ℕ) :
    (m : ℝ) • (fun i : Fin n ↦ (r j i : ℝ)) ∈ integral_intcone r := by
  refine (mem_integral_intcone_iff).2 ?_
  refine ⟨fun s ↦ if s = j then m else 0, ?_⟩
  ext i
  rw [Finset.sum_eq_single j]
  · simp
  · intro s _ hsj
    simp [hsj]
  · simp

/-- Helper for Exercise 4.32: a finite union of rational polytopes is bounded. -/
private lemma iUnion_rationalPolytopes_isBounded
    {n k : ℕ}
    {P : Fin k → Set (Fin n → ℝ)}
    (hP : ∀ i : Fin k, (P i).IsRationalPolytope) :
    Bornology.IsBounded (⋃ i : Fin k, P i) := by
  rcases convexHull_iUnion_rationalPolytopes_eq hP with ⟨p, vertices, hHull⟩
  have hsubset :
      (⋃ i : Fin k, P i) ⊆
        convexHull ℝ
          (Set.range fun j : Fin p ↦ fun u : Fin n ↦ (vertices j u : ℝ)) := by
    intro x hx
    have hxHull : x ∈ convexHull ℝ (⋃ i : Fin k, P i) := subset_convexHull ℝ _ hx
    simpa [hHull] using hxHull
  have hboundedHull :
      Bornology.IsBounded
        (convexHull ℝ
          (Set.range fun j : Fin p ↦ fun u : Fin n ↦ (vertices j u : ℝ))) := by
    exact (isBounded_convexHull).2 (Set.finite_range _).isBounded
  exact hboundedHull.subset hsubset

/-- Helper for Exercise 4.32: the zero multiplier always belongs to the projection cone. -/
private theorem zero_memPolyhedronProjectionCone
    {r m : ℕ}
    (B : Matrix (Fin r) (Fin m) ℚ) :
    (0 : Fin r → ℝ) ∈ polyhedron_projection_cone (B.map (Rat.castHom ℝ)) := by
  exact mem_polyhedron_projection_cone_iff.mpr ⟨by simp, by simp⟩

/-- Helper for Exercise 4.32: the projection cone is closed under nonnegative real scaling. -/
private theorem smul_memPolyhedronProjectionCone
    {r m : ℕ}
    {B : Matrix (Fin r) (Fin m) ℚ}
    {u : Fin r → ℝ}
    (hu : u ∈ polyhedron_projection_cone (B.map (Rat.castHom ℝ)))
    {a : ℝ}
    (ha : 0 ≤ a) :
    a • u ∈ polyhedron_projection_cone (B.map (Rat.castHom ℝ)) := by
  rcases mem_polyhedron_projection_cone_iff.mp hu with ⟨hu_nonneg, hu_mul⟩
  refine mem_polyhedron_projection_cone_iff.mpr ⟨?_, ?_⟩
  · intro i
    simpa [Pi.smul_apply] using mul_nonneg ha (hu_nonneg i)
  · simpa [Matrix.smul_vecMul] using congrArg (fun v : Fin m → ℝ ↦ a • v) hu_mul

/-- Helper for Exercise 4.32: the projection cone is pointed because a vector and its negative
cannot both be componentwise nonnegative unless the vector is zero. -/
private theorem polyhedronProjectionCone_isPointed
    {r m : ℕ}
    (B : Matrix (Fin r) (Fin m) ℚ) :
    is_pointed (polyhedron_projection_cone (B.map (Rat.castHom ℝ))) := by
  rw [is_pointed_iff_eq_zero_of_mem_linealitySpace]
  intro u hu
  rw [mem_linealitySpace_iff] at hu
  have hzero_mem :
      (0 : Fin r → ℝ) ∈ polyhedron_projection_cone (B.map (Rat.castHom ℝ)) := by
    refine mem_polyhedron_projection_cone_iff.mpr ⟨?_, ?_⟩
    · intro i
      simp
    · ext j
      simp
  have hu_mem : u ∈ polyhedron_projection_cone (B.map (Rat.castHom ℝ)) := by
    simpa using hu hzero_mem (1 : ℝ)
  have hneg_mem : -u ∈ polyhedron_projection_cone (B.map (Rat.castHom ℝ)) := by
    simpa using hu hzero_mem (-1 : ℝ)
  rcases mem_polyhedron_projection_cone_iff.mp hu_mem with ⟨hu_nonneg, _⟩
  rcases mem_polyhedron_projection_cone_iff.mp hneg_mem with ⟨hneg_nonneg, _⟩
  ext i
  have hui_nonneg : 0 ≤ u i := hu_nonneg i
  have hui_nonpos : u i ≤ 0 := by
    have hi : 0 ≤ (-u) i := hneg_nonneg i
    simpa using hi
  exact le_antisymm hui_nonpos hui_nonneg

/-- Helper for Exercise 4.32: the only extreme point of the projection cone is the origin. -/
private theorem extremePoint_eq_zero_of_memPolyhedronProjectionCone
    {r m : ℕ}
    {B : Matrix (Fin r) (Fin m) ℚ}
    {u : Fin r → ℝ}
    (hu : u ∈ (polyhedron_projection_cone (B.map (Rat.castHom ℝ))).extremePoints ℝ) :
    u = 0 := by
  let C := polyhedron_projection_cone (B.map (Rat.castHom ℝ))
  have hu_ext := mem_extremePoints_iff_left.mp hu
  have hu_mem : u ∈ C := hu_ext.1
  by_cases huzero : u = 0
  · exact huzero
  have hhalf_mem : ((1 / 2 : ℝ) • u) ∈ C :=
    smul_memPolyhedronProjectionCone hu_mem (by positivity)
  have hthreeHalf_mem : ((3 / 2 : ℝ) • u) ∈ C :=
    smul_memPolyhedronProjectionCone hu_mem (by positivity)
  have hu_open : u ∈ openSegment ℝ ((1 / 2 : ℝ) • u) ((3 / 2 : ℝ) • u) := by
    rw [mem_openSegment_iff_div]
    refine ⟨(1 : ℝ), (1 : ℝ), by positivity, by positivity, ?_⟩
    ext i
    simp [Pi.smul_apply]
    ring
  have hleft : ((1 / 2 : ℝ) • u) = u :=
    hu_ext.2 ((1 / 2 : ℝ) • u) hhalf_mem ((3 / 2 : ℝ) • u) hthreeHalf_mem hu_open
  have hsmul_zero : (((1 / 2 : ℝ) - 1) • u) = 0 := by
    simpa [sub_smul] using sub_eq_zero.mpr hleft
  rcases smul_eq_zero.mp hsmul_zero with hcoeff | huzero'
  · norm_num at hcoeff
  · exact huzero'

/-- Helper for Exercise 4.32: the projection cone attached to a rational auxiliary matrix admits a
finite generating family with rational coordinates. -/
lemma exists_rational_projection_cone_generators
    {r m : ℕ}
    (B : Matrix (Fin r) (Fin m) ℚ) :
    ∃ t : ℕ, ∃ U : Matrix (Fin r) (Fin t) ℚ,
      polyhedron_projection_cone (B.map (Rat.castHom ℝ)) =
        closure (finitely_generated_cone (fun j : Fin t ↦ fun i : Fin r ↦ (U i j : ℝ))) := by
  have hpoly :
      polyhedron_projection_cone (B.map (Rat.castHom ℝ)) =
        matrix_polyhedral_cone ((projectionConePresentationMatrix B).map (Rat.castHom ℝ)) := by
    simpa [matrix_polyhedral_cone] using polyhedronProjectionCone_eq_polyhedronLeSet B
  rcases exists_rational_matrix_cone_of_rational_matrix_polyhedral_cone
      (projectionConePresentationMatrix B) with ⟨t, U, hU⟩
  have hclosed :
      IsClosed (polyhedron_projection_cone (B.map (Rat.castHom ℝ))) := by
    rw [polyhedronProjectionCone_eq_polyhedronLeSet]
    exact isClosed_polyhedronLeSet _ 0
  have hcone :
      polyhedron_projection_cone (B.map (Rat.castHom ℝ)) =
        (matrix_cone (U.map (Rat.castHom ℝ)) : Set (Fin r → ℝ)) := by
    calc
      polyhedron_projection_cone (B.map (Rat.castHom ℝ)) =
          matrix_polyhedral_cone ((projectionConePresentationMatrix B).map (Rat.castHom ℝ)) := hpoly
      _ = (matrix_cone (U.map (Rat.castHom ℝ)) : Set (Fin r → ℝ)) := hU
  have hclosed_cone :
      IsClosed ((matrix_cone (U.map (Rat.castHom ℝ)) : Set (Fin r → ℝ))) := by
    rw [← hcone]
    exact hclosed
  refine ⟨t, U, ?_⟩
  calc
    polyhedron_projection_cone (B.map (Rat.castHom ℝ)) =
        (matrix_cone (U.map (Rat.castHom ℝ)) : Set (Fin r → ℝ)) := hcone
    _ = closure ((matrix_cone (U.map (Rat.castHom ℝ)) : Set (Fin r → ℝ))) := by
          symm
          exact hclosed_cone.closure_eq
    _ = closure (finitely_generated_cone (fun j : Fin t ↦ fun i : Fin r ↦ (U i j : ℝ))) := by
          simpa using
            congrArg closure
              (finitelyGeneratedCone_eq_matrixCone
                (fun j : Fin t ↦ fun i : Fin r ↦ (U i j : ℝ))).symm

/-- Helper for Exercise 4.32: the slice corresponding to a fixed binary assignment `β` is the set
of mixed-lattice points that admit a real auxiliary witness for the original inequalities with
`z = β`. -/
def mixed_binary_assignment_slice
    {n p m q r : ℕ}
    (Aint : Matrix (Fin r) (Fin n) ℚ)
    (Areal : Matrix (Fin r) (Fin p) ℚ)
    (B : Matrix (Fin r) (Fin m) ℚ)
    (C : Matrix (Fin r) (Fin q) ℚ)
    (d : Fin r → ℚ)
    (β : Fin q → Bool) : Set (MixedRealPoint n p) :=
  {xy : MixedRealPoint n p |
    xy ∈ (ℤ^n×ℝ^p) ∧
      ∃ y : Fin m → ℝ,
        ∀ i : Fin r,
          (∑ j : Fin n, (Aint i j : ℝ) * xy.1 j) +
              (∑ j : Fin p, (Areal i j : ℝ) * xy.2 j) +
              (∑ j : Fin m, (B i j : ℝ) * y j) +
              (∑ j : Fin q, (C i j : ℝ) * (((binary_assignment_to_int β) j : ℤ) : ℝ)) ≤
            (d i : ℝ)}

/-- Helper for Exercise 4.32: membership in a fixed-assignment slice is exactly the defining
mixed-lattice condition plus a real auxiliary witness for that assignment. -/
theorem mem_mixed_binary_assignment_slice_iff
    {n p m q r : ℕ}
    {Aint : Matrix (Fin r) (Fin n) ℚ}
    {Areal : Matrix (Fin r) (Fin p) ℚ}
    {B : Matrix (Fin r) (Fin m) ℚ}
    {C : Matrix (Fin r) (Fin q) ℚ}
    {d : Fin r → ℚ}
    {β : Fin q → Bool}
    {xy : MixedRealPoint n p} :
    xy ∈ mixed_binary_assignment_slice Aint Areal B C d β ↔
      xy ∈ (ℤ^n×ℝ^p) ∧
        ∃ y : Fin m → ℝ,
          ∀ i : Fin r,
            (∑ j : Fin n, (Aint i j : ℝ) * xy.1 j) +
                (∑ j : Fin p, (Areal i j : ℝ) * xy.2 j) +
                (∑ j : Fin m, (B i j : ℝ) * y j) +
                (∑ j : Fin q, (C i j : ℝ) * (((binary_assignment_to_int β) j : ℤ) : ℝ)) ≤
              (d i : ℝ) :=
  Iff.rfl

/-- Helper for Exercise 4.32: a mixed-binary projection is the finite union of its fixed Boolean
assignment slices. This is the first structural reduction in the forward direction. -/
theorem mixed_binary_linear_projection_eq_iUnion_assignment_slices
    {n p m q r : ℕ}
    (Aint : Matrix (Fin r) (Fin n) ℚ)
    (Areal : Matrix (Fin r) (Fin p) ℚ)
    (B : Matrix (Fin r) (Fin m) ℚ)
    (C : Matrix (Fin r) (Fin q) ℚ)
    (d : Fin r → ℚ) :
    mixed_binary_linear_projection Aint Areal B C d =
      ⋃ β : Fin q → Bool, mixed_binary_assignment_slice Aint Areal B C d β := by
  ext xy
  constructor
  · intro hxy
    rw [mem_mixed_binary_linear_projection_iff] at hxy
    rcases hxy with ⟨hxy_int, y, z, hz_binary, hineq⟩
    -- Decode the integral `0/1` witness into an honest Boolean assignment.
    rcases exists_binary_assignment_eq_of_zero_one_integer_vector hz_binary with ⟨β, rfl⟩
    rw [Set.mem_iUnion]
    refine ⟨β, ?_⟩
    exact (mem_mixed_binary_assignment_slice_iff).2 ⟨hxy_int, y, hineq⟩
  · intro hxy
    rw [Set.mem_iUnion] at hxy
    rcases hxy with ⟨β, hβ⟩
    rw [mem_mixed_binary_linear_projection_iff]
    rcases (mem_mixed_binary_assignment_slice_iff).1 hβ with ⟨hxy_int, y, hineq⟩
    -- Re-encode the chosen Boolean assignment as the binary auxiliary integer vector.
    refine ⟨hxy_int, y, binary_assignment_to_int β,
      binary_assignment_to_int_is_zero_one_vector β, hineq⟩

/-- Helper for Exercise 4.32: the mixed `(x_int, x_real)` constraint matrix obtained by
concatenating the integer and real coefficient blocks. -/
private def mixedBlockMatrix
    {r n p : ℕ}
    (Aint : Matrix (Fin r) (Fin n) ℚ)
    (Areal : Matrix (Fin r) (Fin p) ℚ) :
    Matrix (Fin r) (Fin (n + p)) ℚ :=
  fun i ↦ Fin.addCases (Aint i) (Areal i)

/-- Helper for Exercise 4.32: multiplying the mixed block matrix by `Fin.append x_int x_real`
recovers the separate integer and real contributions. -/
theorem mixedBlockMatrix_mulVec_append
    {r n p : ℕ}
    (Aint : Matrix (Fin r) (Fin n) ℚ)
    (Areal : Matrix (Fin r) (Fin p) ℚ)
    (xInt : Fin n → ℝ)
    (xReal : Fin p → ℝ) :
    (mixedBlockMatrix Aint Areal).map (Rat.castHom ℝ) *ᵥ Fin.append xInt xReal =
      (Aint.map (Rat.castHom ℝ)) *ᵥ xInt + (Areal.map (Rat.castHom ℝ)) *ᵥ xReal := by
  -- Compute each row after splitting the appended vector into its integer and real blocks.
  ext i
  simp [mixedBlockMatrix, Matrix.mulVec, dotProduct, Fin.append, Fin.sum_univ_add]

/-- Helper for Exercise 4.32: flattening by `Fin.appendEquiv` commutes with affine ray
translations in the mixed ambient space. -/
theorem appendEquiv_add_smul
    {n p : ℕ}
    (x d : MixedRealPoint n p)
    (a : ℝ) :
    Fin.appendEquiv n p (x + a • d) =
      Fin.appendEquiv n p x + a • Fin.appendEquiv n p d := by
  -- Check the integer and real coordinate blocks separately.
  ext i
  refine Fin.addCases ?_ ?_ i
  · intro j
    simp [Fin.appendEquiv]
  · intro j
    simp [Fin.appendEquiv]

/-- Helper for Exercise 4.32: flattening after unflattening is the identity on `Fin (n + p)`. -/
theorem appendEquiv_symm_apply
    {n p : ℕ}
    (u : Fin (n + p) → ℝ) :
    Fin.appendEquiv n p ((Fin.appendEquiv n p).symm u) = u := by
  -- Read the two coordinate blocks of the inverse equivalence directly.
  ext i
  refine Fin.addCases ?_ ?_ i
  · intro j
    simp [Fin.appendEquiv]
  · intro j
    simp [Fin.appendEquiv]

/-- Helper for Exercise 4.32: recession directions are preserved by the flattening equivalence
`Fin.appendEquiv`. -/
theorem mem_recessionCone_appendEquiv_iff
    {n p : ℕ}
    {Q : Set (MixedRealPoint n p)}
    {d : MixedRealPoint n p} :
    Fin.appendEquiv n p d ∈ recessionCone (Fin.appendEquiv n p '' Q) ↔
      d ∈ recessionCone Q := by
  constructor
  · intro hd
    rw [mem_recessionCone_iff] at hd ⊢
    intro x hx a ha
    -- Apply the flattened recession condition at the flattened base point.
    have hImage :
        Fin.appendEquiv n p x + a • Fin.appendEquiv n p d ∈
          Fin.appendEquiv n p '' Q := by
      exact hd ⟨x, hx, rfl⟩ a ha
    rcases hImage with ⟨y, hyQ, hyEq⟩
    -- Injectivity of `Fin.appendEquiv` recovers the original translated point.
    have hyFlat : Fin.appendEquiv n p y = Fin.appendEquiv n p (x + a • d) := by
      calc
        Fin.appendEquiv n p y = Fin.appendEquiv n p x + a • Fin.appendEquiv n p d := hyEq
        _ = Fin.appendEquiv n p (x + a • d) := by
              symm
              exact appendEquiv_add_smul (n := n) (p := p) x d a
    have hy : y = x + a • d := (Fin.appendEquiv n p).injective hyFlat
    exact hy ▸ hyQ
  · intro hd
    rw [mem_recessionCone_iff] at hd ⊢
    rintro u ⟨x, hxQ, rfl⟩ a ha
    -- Translate in the mixed space and flatten the result back.
    refine ⟨x + a • d, hd hxQ a ha, ?_⟩
    exact appendEquiv_add_smul (n := n) (p := p) x d a

/-- Helper for Exercise 4.32: a nonempty polyhedron `polyhedron_le_set A b` has recession cone
cut out by the homogeneous inequalities `A *ᵥ r ≤ 0`. -/
private lemma mem_recessionCone_polyhedronLeSet_iff_of_nonempty
    {m n : ℕ}
    {A : Matrix (Fin m) (Fin n) ℝ}
    {b : Fin m → ℝ}
    (hP_nonempty : Set.Nonempty (polyhedron_le_set A b))
    {r : Fin n → ℝ} :
    r ∈ recessionCone (polyhedron_le_set A b) ↔ A *ᵥ r ≤ 0 := by
  constructor
  · intro hr
    rcases hP_nonempty with ⟨x0, hx0⟩
    rw [mem_recessionCone_iff] at hr
    have hx1 : x0 + r ∈ polyhedron_le_set A b := by
      simpa using hr hx0 1 zero_le_one
    have hx2 : x0 + (2 : ℝ) • r ∈ polyhedron_le_set A b := by
      have htwo_nonneg : (0 : ℝ) ≤ 2 := by norm_num
      simpa using hr hx0 2 htwo_nonneg
    rw [mem_polyhedron_le_set_iff] at hx0 hx1
    rw [mem_polyhedron_le_set_iff] at hx2
    intro i
    by_contra hri
    have hri_pos : 0 < (A *ᵥ r) i := lt_of_not_ge hri
    let a : ℝ := (b i - (A *ᵥ x0) i + 1) / (A *ᵥ r) i
    have hnum_pos : 0 < b i - (A *ᵥ x0) i + 1 := by
      linarith [hx0 i]
    have ha_nonneg : 0 ≤ a := by
      exact div_nonneg (le_of_lt hnum_pos) (le_of_lt hri_pos)
    have hxa : x0 + a • r ∈ polyhedron_le_set A b := hr hx0 a ha_nonneg
    have hxai : (A *ᵥ x0) i + a * (A *ᵥ r) i ≤ b i := by
      rw [mem_polyhedron_le_set_iff] at hxa
      simpa [Matrix.mulVec_add, Matrix.mulVec_smul] using hxa i
    have ha_mul : a * (A *ᵥ r) i = b i - (A *ᵥ x0) i + 1 := by
      unfold a
      field_simp [hri_pos.ne']
    linarith
  · intro hr
    rw [mem_recessionCone_iff]
    intro x hx a ha
    rw [mem_polyhedron_le_set_iff] at hx ⊢
    intro i
    have hmul : a * (A *ᵥ r) i ≤ 0 := mul_nonpos_of_nonneg_of_nonpos ha (hr i)
    have hsum : (A *ᵥ x) i + a * (A *ᵥ r) i ≤ b i := by
      linarith [hx i, hmul]
    simpa [Matrix.mulVec_add, Matrix.mulVec_smul] using hsum

/-- Helper for Exercise 4.32: for a nonempty rational mixed polyhedron, the recession cone is the
homogeneous system cut out by the common left-hand-side matrices. -/
theorem mem_recessionCone_rationalMixedPolyhedron_iff_of_nonempty
    {m n p : ℕ}
    {A : Matrix (Fin m) (Fin n) ℚ}
    {G : Matrix (Fin m) (Fin p) ℚ}
    {b : Fin m → ℚ}
    (hP_nonempty : Set.Nonempty (rational_mixed_polyhedron A G b))
    {d : MixedRealPoint n p} :
    d ∈ recessionCone (rational_mixed_polyhedron A G b) ↔
      (A.map (Rat.castHom ℝ)) *ᵥ d.1 + (G.map (Rat.castHom ℝ)) *ᵥ d.2 ≤ 0 := by
  let Aflat : Matrix (Fin m) (Fin (n + p)) ℚ := mixedBlockMatrix A G
  let bflat : Fin m → ℝ := fun i ↦ (b i : ℝ)
  have hflat :
      Fin.appendEquiv n p '' rational_mixed_polyhedron A G b =
        polyhedron_le_set (Aflat.map (Rat.castHom ℝ)) bflat := by
    ext u
    constructor
    · rintro ⟨xy, hxy, rfl⟩
      rw [mem_polyhedron_le_set_iff]
      change (Aflat.map (Rat.castHom ℝ)) *ᵥ Fin.append xy.1 xy.2 ≤ bflat
      rw [mem_rational_mixed_polyhedron_iff] at hxy
      have hblock := mixedBlockMatrix_mulVec_append A G xy.1 xy.2
      exact hblock.symm ▸ (by simpa [bflat] using hxy)
    · intro hu
      refine ⟨(Fin.appendEquiv n p).symm u, ?_, ?_⟩
      · rw [mem_rational_mixed_polyhedron_iff]
        rw [mem_polyhedron_le_set_iff] at hu
        change
          (A.map (Rat.castHom ℝ)) *ᵥ (fun i ↦ u (Fin.castAdd p i)) +
              (G.map (Rat.castHom ℝ)) *ᵥ (fun i ↦ u (Fin.natAdd n i)) ≤
            fun i ↦ (b i : ℝ)
        have hu_eq :
            Fin.append (fun i ↦ u (Fin.castAdd p i)) (fun i ↦ u (Fin.natAdd n i)) = u := by
          ext j
          refine Fin.addCases ?_ ?_ j
          · intro k
            simp
          · intro k
            simp
        have hu_append :
            (Aflat.map (Rat.castHom ℝ)) *ᵥ
                Fin.append (fun i ↦ u (Fin.castAdd p i)) (fun i ↦ u (Fin.natAdd n i)) ≤
              bflat := by
          rw [hu_eq]
          exact hu
        have hblock :=
          mixedBlockMatrix_mulVec_append A G (fun i ↦ u (Fin.castAdd p i))
            (fun i ↦ u (Fin.natAdd n i))
        exact hblock ▸ (by simpa [bflat] using hu_append)
      · exact appendEquiv_symm_apply (n := n) (p := p) u
  have hflat_nonempty :
      Set.Nonempty (polyhedron_le_set (Aflat.map (Rat.castHom ℝ)) bflat) := by
    rcases hP_nonempty with ⟨xy, hxy⟩
    refine ⟨Fin.appendEquiv n p xy, ?_⟩
    rw [← hflat]
    exact Set.mem_image_of_mem (Fin.appendEquiv n p) hxy
  -- Flatten to an ordinary polyhedron, compute its recession cone, and rewrite back.
  calc
    d ∈ recessionCone (rational_mixed_polyhedron A G b) ↔
        Fin.appendEquiv n p d ∈
          recessionCone (Fin.appendEquiv n p '' rational_mixed_polyhedron A G b) := by
            symm
            exact mem_recessionCone_appendEquiv_iff (Q := rational_mixed_polyhedron A G b) (d := d)
    _ ↔ (Aflat.map (Rat.castHom ℝ)) *ᵥ (Fin.appendEquiv n p d) ≤ 0 := by
          rw [hflat]
          exact mem_recessionCone_polyhedronLeSet_iff_of_nonempty hflat_nonempty
    _ ↔ (A.map (Rat.castHom ℝ)) *ᵥ d.1 + (G.map (Rat.castHom ℝ)) *ᵥ d.2 ≤ 0 := by
          constructor
          · intro hd'
            change (Aflat.map (Rat.castHom ℝ)) *ᵥ Fin.append d.1 d.2 ≤ 0 at hd'
            have hblock := mixedBlockMatrix_mulVec_append A G d.1 d.2
            exact hblock ▸ hd'
          · intro hd'
            change (Aflat.map (Rat.castHom ℝ)) *ᵥ Fin.append d.1 d.2 ≤ 0
            have hblock := mixedBlockMatrix_mulVec_append A G d.1 d.2
            exact hblock.symm ▸ hd'

/-- Helper for Exercise 4.32: two nonempty rational mixed polyhedra with the same left-hand-side
matrices share the same recession cone, regardless of their right-hand sides. -/
theorem recessionCone_rationalMixedPolyhedron_eq_of_rhs_of_nonempty
    {m n p : ℕ}
    {A : Matrix (Fin m) (Fin n) ℚ}
    {G : Matrix (Fin m) (Fin p) ℚ}
    {b b' : Fin m → ℚ}
    (hP_nonempty : Set.Nonempty (rational_mixed_polyhedron A G b))
    (hP'_nonempty : Set.Nonempty (rational_mixed_polyhedron A G b')) :
    recessionCone (rational_mixed_polyhedron A G b) =
      recessionCone (rational_mixed_polyhedron A G b') := by
  ext d
  -- Both recession cones are cut out by the same homogeneous left-hand-side system.
  rw [mem_recessionCone_rationalMixedPolyhedron_iff_of_nonempty
      (hP_nonempty := hP_nonempty) (d := d)]
  rw [mem_recessionCone_rationalMixedPolyhedron_iff_of_nonempty
      (hP_nonempty := hP'_nonempty) (d := d)]

/-- Helper for Exercise 4.32: every explicit rational mixed-system presentation is rational in the
chapter sense. -/
lemma rational_mixed_polyhedron_is_rational
    {m n p : ℕ}
    (A : Matrix (Fin m) (Fin n) ℚ)
    (G : Matrix (Fin m) (Fin p) ℚ)
    (b : Fin m → ℚ) :
    is_rational_mixed_polyhedron (rational_mixed_polyhedron A G b) := by
  -- Reuse the canonical Chapter 4.1 presentation theorem for explicit mixed systems.
  exact (is_rational_mixed_polyhedron_iff).2 ⟨m, A, G, b, rfl⟩

/-- Helper for Exercise 4.32: multiplying the original mixed-system rows by the rational
multiplier matrix `Uᵀ` is exactly the same as asking the corresponding multiplier inequalities. -/
lemma mem_multiplier_rationalMixedPolyhedron_iff
    {n p r t : ℕ}
    (Aint : Matrix (Fin r) (Fin n) ℚ)
    (Areal : Matrix (Fin r) (Fin p) ℚ)
    (U : Matrix (Fin r) (Fin t) ℚ)
    (rhs : Fin r → ℚ)
    {xy : MixedRealPoint n p} :
    xy ∈ rational_mixed_polyhedron (U.transpose * Aint) (U.transpose * Areal) (U.transpose *ᵥ rhs) ↔
      ∀ s : Fin t,
        (fun i ↦ (U i s : ℝ)) ⬝ᵥ
            ((Aint.map (Rat.castHom ℝ)) *ᵥ xy.1 + (Areal.map (Rat.castHom ℝ)) *ᵥ xy.2) ≤
          (fun i ↦ (U i s : ℝ)) ⬝ᵥ (fun i ↦ (rhs i : ℝ)) := by
  -- Rewrite the multiplied left-hand side once so that each row becomes the corresponding
  -- dot-product multiplier inequality.
  rw [mem_rational_mixed_polyhedron_iff]
  have hInt :
      ((U.transpose * Aint).map (Rat.castHom ℝ)) *ᵥ xy.1 =
        fun s : Fin t ↦
          (fun i ↦ (U i s : ℝ)) ⬝ᵥ ((Aint.map (Rat.castHom ℝ)) *ᵥ xy.1) := by
    ext s
    calc
      (((U.transpose * Aint).map (Rat.castHom ℝ)) *ᵥ xy.1) s
          = (((U.transpose).map (Rat.castHom ℝ) * (Aint.map (Rat.castHom ℝ))) *ᵥ xy.1) s := by
              rw [Matrix.map_mul]
      _ = ((U.transpose).map (Rat.castHom ℝ) *ᵥ ((Aint.map (Rat.castHom ℝ)) *ᵥ xy.1)) s := by
            rw [← Matrix.mulVec_mulVec]
      _ = (fun i ↦ (U i s : ℝ)) ⬝ᵥ ((Aint.map (Rat.castHom ℝ)) *ᵥ xy.1) := by
            simp [Matrix.mulVec, dotProduct]
  have hReal :
      ((U.transpose * Areal).map (Rat.castHom ℝ)) *ᵥ xy.2 =
        fun s : Fin t ↦
          (fun i ↦ (U i s : ℝ)) ⬝ᵥ ((Areal.map (Rat.castHom ℝ)) *ᵥ xy.2) := by
    ext s
    calc
      (((U.transpose * Areal).map (Rat.castHom ℝ)) *ᵥ xy.2) s
          = (((U.transpose).map (Rat.castHom ℝ) * (Areal.map (Rat.castHom ℝ))) *ᵥ xy.2) s := by
              rw [Matrix.map_mul]
      _ = ((U.transpose).map (Rat.castHom ℝ) *ᵥ ((Areal.map (Rat.castHom ℝ)) *ᵥ xy.2)) s := by
            rw [← Matrix.mulVec_mulVec]
      _ = (fun i ↦ (U i s : ℝ)) ⬝ᵥ ((Areal.map (Rat.castHom ℝ)) *ᵥ xy.2) := by
            simp [Matrix.mulVec, dotProduct]
  have hRhs :
      (fun s : Fin t ↦ (((U.transpose *ᵥ rhs) s : ℚ) : ℝ)) =
        fun s : Fin t ↦
          (fun i ↦ (U i s : ℝ)) ⬝ᵥ (fun i ↦ (rhs i : ℝ)) := by
    ext s
    calc
      (((U.transpose *ᵥ rhs) s : ℚ) : ℝ)
          = ((U.transpose).map (Rat.castHom ℝ) *ᵥ (fun i ↦ (rhs i : ℝ))) s := by
              simpa using RingHom.map_mulVec (Rat.castHom ℝ) U.transpose rhs s
      _ = (fun i ↦ (U i s : ℝ)) ⬝ᵥ (fun i ↦ (rhs i : ℝ)) := by
            simp [Matrix.mulVec, dotProduct]
  -- After the rowwise normalization, the mixed-polyhedron membership is exactly the displayed
  -- family of multiplier inequalities.
  constructor
  · intro hxy
    intro s
    have hs := hxy s
    have hInt_s := congrFun hInt s
    have hReal_s := congrFun hReal s
    have hRhs_s := congrFun hRhs s
    calc
      (fun i ↦ (U i s : ℝ)) ⬝ᵥ
          ((Aint.map (Rat.castHom ℝ)) *ᵥ xy.1 + (Areal.map (Rat.castHom ℝ)) *ᵥ xy.2)
          = (((U.transpose * Aint).map (Rat.castHom ℝ)) *ᵥ xy.1) s +
              (((U.transpose * Areal).map (Rat.castHom ℝ)) *ᵥ xy.2) s := by
                rw [dotProduct_add, ← hInt_s, ← hReal_s]
      _ ≤ (fun i ↦ (U i s : ℝ)) ⬝ᵥ (fun i ↦ (rhs i : ℝ)) := by
            simpa [hRhs_s] using hs
  · intro hxy
    intro s
    have hs := hxy s
    have hInt_s := congrFun hInt s
    have hReal_s := congrFun hReal s
    have hRhs_s := congrFun hRhs s
    calc
      (((U.transpose * Aint).map (Rat.castHom ℝ)) *ᵥ xy.1) s +
          (((U.transpose * Areal).map (Rat.castHom ℝ)) *ᵥ xy.2) s
          = (fun i ↦ (U i s : ℝ)) ⬝ᵥ
              ((Aint.map (Rat.castHom ℝ)) *ᵥ xy.1 + (Areal.map (Rat.castHom ℝ)) *ᵥ xy.2) := by
                rw [hInt_s, hReal_s, dotProduct_add]
      _ ≤ (fun i ↦ (U i s : ℝ)) ⬝ᵥ (fun i ↦ (rhs i : ℝ)) := hs
      _ = (fun i ↦ (((U.transpose *ᵥ rhs) i : ℚ) : ℝ)) s := by
            simpa [hRhs_s]

/-- Helper for Exercise 4.32: every fixed Boolean slice is the mixed-integer points of a rational
mixed polyhedron with one common left-hand-side matrix family. -/
theorem existsCommonAssignmentSlicePolyhedra
    {n p m q r : ℕ}
    (Aint : Matrix (Fin r) (Fin n) ℚ)
    (Areal : Matrix (Fin r) (Fin p) ℚ)
    (B : Matrix (Fin r) (Fin m) ℚ)
    (C : Matrix (Fin r) (Fin q) ℚ)
    (d : Fin r → ℚ) :
    ∃ t : ℕ,
      ∃ AprojInt : Matrix (Fin t) (Fin n) ℚ,
        ∃ AprojReal : Matrix (Fin t) (Fin p) ℚ,
          ∃ bproj : (Fin q → Bool) → Fin t → ℚ,
            ∀ β : Fin q → Bool,
              mixed_binary_assignment_slice Aint Areal B C d β =
                mixed_integer_points (rational_mixed_polyhedron AprojInt AprojReal (bproj β)) := by
  -- Choose one rational generator family for the projection cone of the auxiliary block `B`.
  rcases exists_rational_projection_cone_generators B with ⟨t, U, hU⟩
  let rhs : (Fin q → Bool) → Fin r → ℚ :=
    fun β i ↦ d i - ∑ j : Fin q, C i j * (((binary_assignment_to_int β) j : ℤ) : ℚ)
  refine ⟨t, U.transpose * Aint, U.transpose * Areal, fun β ↦ U.transpose *ᵥ rhs β, ?_⟩
  intro β
  ext xy
  have hproj :
      Prod.fst ''
          {xz : (Fin (n + p) → ℝ) × (Fin m → ℝ) |
            ((mixedBlockMatrix Aint Areal).map (Rat.castHom ℝ)) *ᵥ xz.1 +
                (B.map (Rat.castHom ℝ)) *ᵥ xz.2 ≤
              fun i : Fin r ↦ (rhs β i : ℝ)} =
        {x : Fin (n + p) → ℝ |
          ∀ s : Fin t,
            (fun i ↦ (U i s : ℝ)) ⬝ᵥ
                (((mixedBlockMatrix Aint Areal).map (Rat.castHom ℝ)) *ᵥ x) ≤
              (fun i ↦ (U i s : ℝ)) ⬝ᵥ (fun i : Fin r ↦ (rhs β i : ℝ))} := by
    -- This is exactly the projection theorem applied to the flattened mixed-space block.
    simpa using
      polyhedronProjectionEq_generatorInequalities
        ((mixedBlockMatrix Aint Areal).map (Rat.castHom ℝ))
        (B.map (Rat.castHom ℝ))
        (fun i : Fin r ↦ (rhs β i : ℝ))
        (fun s : Fin t ↦ fun i : Fin r ↦ (U i s : ℝ))
        hU
  constructor
  · intro hxy
    rcases (mem_mixed_binary_assignment_slice_iff).1 hxy with ⟨hxy_int, y, hineq⟩
    have hflat_mem :
        Fin.append xy.1 xy.2 ∈
          Prod.fst ''
            {xz : (Fin (n + p) → ℝ) × (Fin m → ℝ) |
              ((mixedBlockMatrix Aint Areal).map (Rat.castHom ℝ)) *ᵥ xz.1 +
                  (B.map (Rat.castHom ℝ)) *ᵥ xz.2 ≤
                fun i : Fin r ↦ (rhs β i : ℝ)} := by
      rw [mem_image_fst_iff]
      refine ⟨y, ?_⟩
      intro i
      have hi := hineq i
      have hblock := congrFun (mixedBlockMatrix_mulVec_append Aint Areal xy.1 xy.2) i
      change
        (((mixedBlockMatrix Aint Areal).map (Rat.castHom ℝ)) *ᵥ Fin.append xy.1 xy.2 +
            (B.map (Rat.castHom ℝ)) *ᵥ y) i ≤
          (fun i : Fin r ↦ (rhs β i : ℝ)) i
      have hrhs :
          ((rhs β i : ℚ) : ℝ) =
            (d i : ℝ) -
              ∑ j : Fin q, (C i j : ℝ) * (((binary_assignment_to_int β) j : ℤ) : ℝ) := by
        simp [rhs]
      have hi' :
          ((Aint.map (Rat.castHom ℝ)) *ᵥ xy.1 + (Areal.map (Rat.castHom ℝ)) *ᵥ xy.2) i +
              ((B.map (Rat.castHom ℝ)) *ᵥ y) i ≤
            (rhs β i : ℝ) := by
        rw [hrhs]
        change
          (∑ j : Fin n, (Aint i j : ℝ) * xy.1 j) +
              (∑ j : Fin p, (Areal i j : ℝ) * xy.2 j) +
              (∑ j : Fin m, (B i j : ℝ) * y j) ≤
            (d i : ℝ) -
              ∑ j : Fin q, (C i j : ℝ) * (((binary_assignment_to_int β) j : ℤ) : ℝ)
        linarith
      have hsumblock :
          ((((mixedBlockMatrix Aint Areal).map (Rat.castHom ℝ)) *ᵥ Fin.append xy.1 xy.2) i) +
              ((B.map (Rat.castHom ℝ)) *ᵥ y) i =
            ((Aint.map (Rat.castHom ℝ)) *ᵥ xy.1 + (Areal.map (Rat.castHom ℝ)) *ᵥ xy.2) i +
              ((B.map (Rat.castHom ℝ)) *ᵥ y) i := by
        simpa using congrArg (fun t ↦ t + ((B.map (Rat.castHom ℝ)) *ᵥ y) i) hblock
      change
        ((((mixedBlockMatrix Aint Areal).map (Rat.castHom ℝ)) *ᵥ Fin.append xy.1 xy.2) i) +
            ((B.map (Rat.castHom ℝ)) *ᵥ y) i ≤
          (rhs β i : ℝ)
      rw [hsumblock]
      simpa [Pi.add_apply] using hi'
    have hmult :
        ∀ s : Fin t,
          (fun i ↦ (U i s : ℝ)) ⬝ᵥ
              (((mixedBlockMatrix Aint Areal).map (Rat.castHom ℝ)) *ᵥ Fin.append xy.1 xy.2) ≤
            (fun i ↦ (U i s : ℝ)) ⬝ᵥ (fun i : Fin r ↦ (rhs β i : ℝ)) := by
      have hproj_mem := congrArg (fun S : Set (Fin (n + p) → ℝ) ↦ Fin.append xy.1 xy.2 ∈ S) hproj
      simpa using hproj_mem.mp hflat_mem
    refine (mem_mixed_integer_points_iff).2 ?_
    refine ⟨?_, hxy_int⟩
    rw [mem_multiplier_rationalMixedPolyhedron_iff Aint Areal U (rhs β)]
    intro s
    have hblockDot :
        (fun i ↦ (U i s : ℝ)) ⬝ᵥ
            (((mixedBlockMatrix Aint Areal).map (Rat.castHom ℝ)) *ᵥ Fin.append xy.1 xy.2) =
          (fun i ↦ (U i s : ℝ)) ⬝ᵥ
            ((Aint.map (Rat.castHom ℝ)) *ᵥ xy.1 + (Areal.map (Rat.castHom ℝ)) *ᵥ xy.2) := by
      simpa using
        congrArg (fun v ↦ (fun i ↦ (U i s : ℝ)) ⬝ᵥ v)
          (mixedBlockMatrix_mulVec_append Aint Areal xy.1 xy.2)
    have hs := hmult s
    rwa [hblockDot] at hs
  · intro hxy
    rcases (mem_mixed_integer_points_iff).1 hxy with ⟨hxy_poly, hxy_int⟩
    have hmultExpanded :
        ∀ s : Fin t,
          (fun i ↦ (U i s : ℝ)) ⬝ᵥ
              ((Aint.map (Rat.castHom ℝ)) *ᵥ xy.1 + (Areal.map (Rat.castHom ℝ)) *ᵥ xy.2) ≤
            (fun i ↦ (U i s : ℝ)) ⬝ᵥ (fun i : Fin r ↦ (rhs β i : ℝ)) := by
      have hpoly' :=
        (mem_multiplier_rationalMixedPolyhedron_iff Aint Areal U (rhs β) (xy := xy)).1 hxy_poly
      intro s
      have hs := hpoly' s
      exact hs
    have hmult :
        ∀ s : Fin t,
          (fun i ↦ (U i s : ℝ)) ⬝ᵥ
              (((mixedBlockMatrix Aint Areal).map (Rat.castHom ℝ)) *ᵥ Fin.append xy.1 xy.2) ≤
            (fun i ↦ (U i s : ℝ)) ⬝ᵥ (fun i : Fin r ↦ (rhs β i : ℝ)) := by
      intro s
      have hblockDot :
          (fun i ↦ (U i s : ℝ)) ⬝ᵥ
              (((mixedBlockMatrix Aint Areal).map (Rat.castHom ℝ)) *ᵥ Fin.append xy.1 xy.2) =
            (fun i ↦ (U i s : ℝ)) ⬝ᵥ
              ((Aint.map (Rat.castHom ℝ)) *ᵥ xy.1 + (Areal.map (Rat.castHom ℝ)) *ᵥ xy.2) := by
        simpa using
          congrArg (fun v ↦ (fun i ↦ (U i s : ℝ)) ⬝ᵥ v)
            (mixedBlockMatrix_mulVec_append Aint Areal xy.1 xy.2)
      have hs := hmultExpanded s
      rwa [← hblockDot] at hs
    have hflat_mem :
        Fin.append xy.1 xy.2 ∈
          Prod.fst ''
            {xz : (Fin (n + p) → ℝ) × (Fin m → ℝ) |
              ((mixedBlockMatrix Aint Areal).map (Rat.castHom ℝ)) *ᵥ xz.1 +
                  (B.map (Rat.castHom ℝ)) *ᵥ xz.2 ≤
                fun i : Fin r ↦ (rhs β i : ℝ)} := by
      have hproj_mem := congrArg (fun S : Set (Fin (n + p) → ℝ) ↦ Fin.append xy.1 xy.2 ∈ S) hproj
      exact hproj_mem.mpr hmult
    rw [mem_mixed_binary_assignment_slice_iff]
    refine ⟨hxy_int, ?_⟩
    rw [mem_image_fst_iff] at hflat_mem
    rcases hflat_mem with ⟨y, hy⟩
    refine ⟨y, ?_⟩
    intro i
    have hyi := hy i
    have hblock := congrFun (mixedBlockMatrix_mulVec_append Aint Areal xy.1 xy.2) i
    change
      (((mixedBlockMatrix Aint Areal).map (Rat.castHom ℝ)) *ᵥ Fin.append xy.1 xy.2 +
          (B.map (Rat.castHom ℝ)) *ᵥ y) i ≤
        (fun i : Fin r ↦ (rhs β i : ℝ)) i at hyi
    have hyi' :
        ((Aint.map (Rat.castHom ℝ)) *ᵥ xy.1 + (Areal.map (Rat.castHom ℝ)) *ᵥ xy.2) i +
            ((B.map (Rat.castHom ℝ)) *ᵥ y) i ≤
          (rhs β i : ℝ) := by
      have hsumblock :
          ((((mixedBlockMatrix Aint Areal).map (Rat.castHom ℝ)) *ᵥ Fin.append xy.1 xy.2) i) +
              ((B.map (Rat.castHom ℝ)) *ᵥ y) i =
            ((Aint.map (Rat.castHom ℝ)) *ᵥ xy.1 + (Areal.map (Rat.castHom ℝ)) *ᵥ xy.2) i +
              ((B.map (Rat.castHom ℝ)) *ᵥ y) i := by
        simpa using congrArg (fun t ↦ t + ((B.map (Rat.castHom ℝ)) *ᵥ y) i) hblock
      have hyi' := hyi
      change
        ((((mixedBlockMatrix Aint Areal).map (Rat.castHom ℝ)) *ᵥ Fin.append xy.1 xy.2) i) +
            ((B.map (Rat.castHom ℝ)) *ᵥ y) i ≤
          (rhs β i : ℝ) at hyi'
      rw [hsumblock] at hyi'
      simpa [Pi.add_apply] using hyi'
    have hrhs :
        ((rhs β i : ℚ) : ℝ) =
          (d i : ℝ) -
            ∑ j : Fin q, (C i j : ℝ) * (((binary_assignment_to_int β) j : ℤ) : ℝ) := by
      simp [rhs]
    rw [hrhs] at hyi'
    change
      (∑ j : Fin n, (Aint i j : ℝ) * xy.1 j) +
          (∑ j : Fin p, (Areal i j : ℝ) * xy.2 j) +
          (∑ j : Fin m, (B i j : ℝ) * y j) ≤
        (d i : ℝ) -
          ∑ j : Fin q, (C i j : ℝ) * (((binary_assignment_to_int β) j : ℤ) : ℝ) at hyi'
    change
      (∑ j : Fin n, (Aint i j : ℝ) * xy.1 j) +
          (∑ j : Fin p, (Areal i j : ℝ) * xy.2 j) +
          (∑ j : Fin m, (B i j : ℝ) * y j) +
          ∑ j : Fin q, (C i j : ℝ) * (((binary_assignment_to_int β) j : ℤ) : ℝ) ≤
        (d i : ℝ)
    linarith

/-- Helper for Exercise 4.32: the one-hot integer vector activating coordinate `j`. -/
def one_hot_integer_vector
    {k : ℕ} (j : Fin k) : Fin k → ℤ :=
  fun i ↦ if i = j then 1 else 0

/-- Helper for Exercise 4.32: the one-hot vector is a binary vector. -/
lemma one_hot_integer_vector_is_zero_one_vector
    {k : ℕ} (j : Fin k) :
    is_zero_one_vector (fun i ↦ ((one_hot_integer_vector j) i : ℝ)) := by
  -- Each coordinate is definitionally either the active `1` or an inactive `0`.
  intro i
  by_cases hij : i = j
  · right
    simp [one_hot_integer_vector, hij]
  · left
    simp [one_hot_integer_vector, hij]

/-- Helper for Exercise 4.32: the one-hot vector has total sum `1`. -/
lemma sum_one_hot_integer_vector
    {k : ℕ} (j : Fin k) :
    ∑ i : Fin k, one_hot_integer_vector j i = 1 := by
  -- Only the active coordinate contributes to the sum.
  rw [Finset.sum_eq_single j]
  · simp [one_hot_integer_vector]
  · intro i _ hij
    simp [one_hot_integer_vector, hij]
  · simp

/-- Helper for Exercise 4.32: a binary selector with total sum `1` collapses any weighted sum to
the active coordinate. -/
lemma weightedSelectorSum_eq_active
    {k : ℕ}
    {δ : Fin k → ℤ}
    {a : Fin k → ℝ}
    {j : Fin k}
    (hδ_binary : is_zero_one_vector (fun i ↦ (δ i : ℝ)))
    (hδ_sum : ∑ i : Fin k, δ i = 1)
    (hj : δ j = 1) :
    ∑ i : Fin k, a i * (δ i : ℝ) = a j := by
  -- First identify `j` as the unique active selector coordinate.
  obtain ⟨j0, hj0, hj0_unique⟩ := binary_one_hot_selector δ hδ_binary hδ_sum
  have hj_eq : j = j0 := hj0_unique j hj
  subst hj_eq
  -- Every inactive coordinate contributes a zero factor to the weighted sum.
  rw [Finset.sum_eq_single j]
  · simp [hj0]
  · intro i _ hij
    have hi_ne_one : δ i ≠ 1 := by
      intro hi_one
      exact hij (hj0_unique i hi_one)
    have hi_zero : (δ i : ℝ) = 0 := by
      rcases hδ_binary i with hi_zero | hi_one
      · exact hi_zero
      · have hi_one_int : δ i = 1 := by
          have hi_one_real : (δ i : ℝ) = 1 := by
            simpa using hi_one
          exact_mod_cast hi_one_real
        exact False.elim (hi_ne_one hi_one_int)
    simp [hi_zero]
  · simp

/-- Helper for Exercise 4.32: a binary selector with total sum `1` vanishes away from its unique
active coordinate. -/
lemma binarySelector_eq_zero_of_ne_active
    {k : ℕ}
    {δ : Fin k → ℤ}
    (hδ_binary : is_zero_one_vector (fun i ↦ (δ i : ℝ)))
    (hδ_sum : ∑ i : Fin k, δ i = 1)
    {j i : Fin k}
    (hj : δ j = 1)
    (hij : i ≠ j) :
    δ i = 0 := by
  obtain ⟨j0, hj0, hj0_unique⟩ := binary_one_hot_selector δ hδ_binary hδ_sum
  have hj_eq : j = j0 := hj0_unique j hj
  rcases hδ_binary i with hi_zero | hi_one
  · have hi_zero_real : (δ i : ℝ) = 0 := by
      simpa using hi_zero
    exact_mod_cast hi_zero_real
  · have hi_one_int : δ i = 1 := by
      have hi_one_real : (δ i : ℝ) = 1 := by
        simpa using hi_one
      exact_mod_cast hi_one_real
    have hi_eq : i = j0 := hj0_unique i hi_one_int
    exact False.elim (hij (hi_eq.trans hj_eq.symm))

/-- Helper for Exercise 4.32: a nonempty finite union of mixed-integer component sets contains a
nonempty component. -/
lemma exists_nonempty_component_of_nonempty_iUnion_mixed_integer_points
    {n p k : ℕ}
    {P : Fin k → Set (MixedRealPoint n p)}
    (h_nonempty : Set.Nonempty (⋃ i : Fin k, mixed_integer_points (P i))) :
    ∃ i : Fin k, Set.Nonempty (mixed_integer_points (P i)) := by
  rcases h_nonempty with ⟨x, hx⟩
  rw [Set.mem_iUnion] at hx
  rcases hx with ⟨i, hxi⟩
  exact ⟨i, ⟨x, hxi⟩⟩

/-- Helper for Exercise 4.32: filtering a finite family to its nonempty mixed-integer components
does not change the union. -/
lemma iUnion_nonempty_mixed_integer_components_eq_iUnion
    {n p k : ℕ}
    (P : Fin k → Set (MixedRealPoint n p)) :
    (⋃ i : {j : Fin k // Set.Nonempty (mixed_integer_points (P j))},
      mixed_integer_points (P i.1)) =
      ⋃ i : Fin k, mixed_integer_points (P i) := by
  ext xy
  constructor
  · intro hxy
    rw [Set.mem_iUnion] at hxy
    rcases hxy with ⟨i, hi⟩
    exact Set.mem_iUnion.2 ⟨i.1, hi⟩
  · intro hxy
    rw [Set.mem_iUnion] at hxy
    rcases hxy with ⟨i, hi⟩
    -- Package the witnessed point as proof that the chosen component is nonempty.
    exact Set.mem_iUnion.2 ⟨⟨i, ⟨xy, hi⟩⟩, hi⟩

/-- Helper for Exercise 4.32: a finite family of rational mixed polyhedra admits explicit
componentwise rational matrix presentations. -/
lemma existsExplicitPresentation_of_rationalMixedPolyhedronFamily
    {n p l : ℕ}
    (Q : Fin l → Set (MixedRealPoint n p))
    (hQ_rational : ∀ i : Fin l, is_rational_mixed_polyhedron (Q i)) :
    ∃ m : Fin l → ℕ,
      ∃ A : ∀ i : Fin l, Matrix (Fin (m i)) (Fin n) ℚ,
        ∃ G : ∀ i : Fin l, Matrix (Fin (m i)) (Fin p) ℚ,
          ∃ b : ∀ i : Fin l, Fin (m i) → ℚ,
            ∀ i : Fin l, Q i = rational_mixed_polyhedron (A i) (G i) (b i) := by
  have hpresent :
      ∀ i : Fin l,
        ∃ m : ℕ,
          ∃ A : Matrix (Fin m) (Fin n) ℚ,
            ∃ G : Matrix (Fin m) (Fin p) ℚ,
              ∃ b : Fin m → ℚ,
                Q i = rational_mixed_polyhedron A G b := by
    intro i
    -- Expand rationality of the `i`th component into an explicit mixed-system presentation.
    exact (is_rational_mixed_polyhedron_iff).1 (hQ_rational i)
  -- Choose one explicit rational presentation for every retained component.
  choose m A G b hQ_eq using hpresent
  exact ⟨m, A, G, b, hQ_eq⟩

/-- Helper for Exercise 4.32: nonempty mixed-integer components yield nonempty ambient
polyhedra after rewriting through an explicit presentation. -/
lemma nonemptyExplicitPresentation_of_nonemptyMixedIntegerFamily
    {n p l : ℕ}
    {Q : Fin l → Set (MixedRealPoint n p)}
    {m : Fin l → ℕ}
    {A : ∀ i : Fin l, Matrix (Fin (m i)) (Fin n) ℚ}
    {G : ∀ i : Fin l, Matrix (Fin (m i)) (Fin p) ℚ}
    {b : ∀ i : Fin l, Fin (m i) → ℚ}
    (hQ_eq : ∀ i : Fin l, Q i = rational_mixed_polyhedron (A i) (G i) (b i))
    (hQ_nonempty : ∀ i : Fin l, Set.Nonempty (mixed_integer_points (Q i))) :
    ∀ i : Fin l, Set.Nonempty (rational_mixed_polyhedron (A i) (G i) (b i)) := by
  intro i
  -- Forget integrality first, then transport the resulting ambient point through `hQ_eq`.
  simpa [hQ_eq i] using
    (nonempty_of_mixed_integer_points_nonempty (P := Q i) (hQ_nonempty i))

/-- Helper for Exercise 4.32: equal recession cones transport through explicit componentwise
rational presentations. -/
lemma recessionCone_eq_of_explicitPresentationFamily
    {n p l : ℕ}
    {Q : Fin l → Set (MixedRealPoint n p)}
    {m : Fin l → ℕ}
    {A : ∀ i : Fin l, Matrix (Fin (m i)) (Fin n) ℚ}
    {G : ∀ i : Fin l, Matrix (Fin (m i)) (Fin p) ℚ}
    {b : ∀ i : Fin l, Fin (m i) → ℚ}
    (hQ_eq : ∀ i : Fin l, Q i = rational_mixed_polyhedron (A i) (G i) (b i))
    (hQ_recession : ∀ i j : Fin l, recessionCone (Q i) = recessionCone (Q j)) :
    ∀ i j : Fin l,
      recessionCone (rational_mixed_polyhedron (A i) (G i) (b i)) =
        recessionCone (rational_mixed_polyhedron (A j) (G j) (b j)) := by
  intro i j
  -- Rewriting both components through `hQ_eq` turns this into the original family equality.
  simpa [hQ_eq i, hQ_eq j] using hQ_recession i j

/-- Helper for Exercise 4.32: a finite sum of recession directions is again a recession
direction. -/
lemma finsetSum_mem_recessionCone
    {n p l : ℕ}
    {P : Set (MixedRealPoint n p)}
    {v : Fin l → MixedRealPoint n p}
    (hv : ∀ i : Fin l, v i ∈ recessionCone P) :
    (∑ i : Fin l, v i) ∈ recessionCone P := by
  -- Recession directions form a submodule, so finite sums remain in the same recession cone.
  exact Submodule.sum_mem (recessionPointedCone ℝ P) (fun i _ ↦ hv i)

/-- Helper for Exercise 4.32: if a nonempty rational mixed polyhedron is satisfied with right-hand
side scaled by the zero selector, then the witness is already a recession direction. -/
lemma mem_recessionCone_of_selector_eq_zero
    {m n p : ℕ}
    {A : Matrix (Fin m) (Fin n) ℚ}
    {G : Matrix (Fin m) (Fin p) ℚ}
    {b : Fin m → ℚ}
    (hP_nonempty : Set.Nonempty (rational_mixed_polyhedron A G b))
    {u : MixedRealPoint n p}
    (hu :
      (A.map (Rat.castHom ℝ)) *ᵥ u.1 + (G.map (Rat.castHom ℝ)) *ᵥ u.2 ≤
        fun i : Fin m ↦ (0 : ℝ) * (b i : ℝ)) :
    u ∈ recessionCone (rational_mixed_polyhedron A G b) := by
  -- Normalize the homogeneous zero-selector inequalities to the recession-cone owner.
  rw [mem_recessionCone_rationalMixedPolyhedron_iff_of_nonempty
    (hP_nonempty := hP_nonempty) (d := u)]
  intro i
  simpa using hu i

/-- Helper for Exercise 4.32: the lifted real auxiliary block stores one mixed-space copy for
each component of the shared-recession family. -/
private abbrev SharedRecessionLiftAux
    (n p l : ℕ) : Type :=
  (Fin l × Fin n) ⊕ (Fin l × Fin p)

/-- Helper for Exercise 4.32: the direct one-hot lifted system has one row family for component
constraints, two row families for each reconstruction equality, and two selector-sum rows. -/
private inductive SharedRecessionLiftRow
    {n p l : ℕ} (mQ : Fin l → ℕ) : Type
  | component : (i : Fin l) → Fin (mQ i) → SharedRecessionLiftRow mQ
  | intEqLe : Fin n → SharedRecessionLiftRow mQ
  | intEqGe : Fin n → SharedRecessionLiftRow mQ
  | realEqLe : Fin p → SharedRecessionLiftRow mQ
  | realEqGe : Fin p → SharedRecessionLiftRow mQ
  | selectorUpper : SharedRecessionLiftRow mQ
  | selectorLower : SharedRecessionLiftRow mQ
deriving Fintype, DecidableEq

/-- Helper for Exercise 4.32: read the `i`th mixed component copy from the lifted auxiliary real
coordinates. -/
private def sharedRecessionLiftPart
    {n p l : ℕ}
    (y : SharedRecessionLiftAux n p l → ℝ) (i : Fin l) : MixedRealPoint n p :=
  (fun j ↦ y (Sum.inl (i, j)), fun j ↦ y (Sum.inr (i, j)))

/-- Helper for Exercise 4.32: the visible integer block of the direct shared-recession lift only
appears in the reconstruction rows. -/
private def sharedRecessionLiftAint
    {n p l : ℕ}
    (mQ : Fin l → ℕ) :
    Matrix (SharedRecessionLiftRow (n := n) (p := p) mQ) (Fin n) ℚ :=
  fun row j ↦
    match row with
    | .intEqLe j' => if j = j' then 1 else 0
    | .intEqGe j' => if j = j' then -1 else 0
    | _ => 0

/-- Helper for Exercise 4.32: the visible real block of the direct shared-recession lift only
appears in the reconstruction rows. -/
private def sharedRecessionLiftAreal
    {n p l : ℕ}
    (mQ : Fin l → ℕ) :
    Matrix (SharedRecessionLiftRow (n := n) (p := p) mQ) (Fin p) ℚ :=
  fun row j ↦
    match row with
    | .realEqLe j' => if j = j' then 1 else 0
    | .realEqGe j' => if j = j' then -1 else 0
    | _ => 0

/-- Helper for Exercise 4.32: the auxiliary real block stores one copy of each component point
and supplies the reconstruction coefficients. -/
private def sharedRecessionLiftAuxMatrix
    {n p l : ℕ}
    (mQ : Fin l → ℕ)
    (AintQ : ∀ i : Fin l, Matrix (Fin (mQ i)) (Fin n) ℚ)
    (ArealQ : ∀ i : Fin l, Matrix (Fin (mQ i)) (Fin p) ℚ) :
    Matrix (SharedRecessionLiftRow (n := n) (p := p) mQ) (SharedRecessionLiftAux n p l) ℚ :=
  fun row a ↦
    match row, a with
    | .component i t, Sum.inl ij => if ij.1 = i then AintQ i t ij.2 else 0
    | .component i t, Sum.inr ij => if ij.1 = i then ArealQ i t ij.2 else 0
    | .intEqLe j, Sum.inl ij => if ij.2 = j then -1 else 0
    | .intEqGe j, Sum.inl ij => if ij.2 = j then 1 else 0
    | .realEqLe j, Sum.inr ij => if ij.2 = j then -1 else 0
    | .realEqGe j, Sum.inr ij => if ij.2 = j then 1 else 0
    | _, _ => 0

/-- Helper for Exercise 4.32: the selector block scales component right-hand sides and imposes the
one-hot sum constraints. -/
private def sharedRecessionLiftSelectorMatrix
    {n p l : ℕ}
    (mQ : Fin l → ℕ)
    (bQ : ∀ i : Fin l, Fin (mQ i) → ℚ) :
    Matrix (SharedRecessionLiftRow (n := n) (p := p) mQ) (Fin l) ℚ :=
  fun row i ↦
    match row with
    | .component i' t => if i = i' then -(bQ i' t) else 0
    | .selectorUpper => 1
    | .selectorLower => -1
    | _ => 0

/-- Helper for Exercise 4.32: every non-selector row of the direct shared-recession lift has
right-hand side `0`, while the selector rows encode `∑ z_i ≤ 1` and `1 ≤ ∑ z_i`. -/
private def sharedRecessionLiftRhs
    {n p l : ℕ}
    (mQ : Fin l → ℕ)
    (bQ : ∀ i : Fin l, Fin (mQ i) → ℚ) :
    SharedRecessionLiftRow (n := n) (p := p) mQ → ℚ
  | .selectorUpper => 1
  | .selectorLower => -1
  | _ => 0

/-- Helper for Exercise 4.32: a rational singleton row selects one active coordinate after
casting to `ℝ`. -/
private lemma sumCastIteMul_eq_active
    {k : ℕ}
    (f : Fin k → ℝ)
    (i : Fin k)
    (c : ℚ) :
    ∑ j : Fin k, (((if j = i then c else 0 : ℚ) : ℝ) * f j) = (c : ℝ) * f i := by
  -- Only the active coordinate survives the singleton-weighted finite sum.
  rw [Finset.sum_eq_single i]
  · simp
  · intro j _ hji
    simp [hji]
  · simp

/-- Helper for Exercise 4.32: a copied block indexed by the outer component collapses to the
active component after casting its rational coefficients to `ℝ`. -/
private lemma sumProdCastIteMul_eq_activeOuter
    {l k : ℕ}
    (f : Fin l → Fin k → ℝ)
    (i : Fin l)
    (c : Fin k → ℚ) :
    ∑ ij : Fin l × Fin k, (((if ij.1 = i then c ij.2 else 0 : ℚ) : ℝ) * f ij.1 ij.2) =
      ∑ j : Fin k, (c j : ℝ) * f i j := by
  -- Expand by outer component and discard the inactive copied blocks.
  rw [Fintype.sum_prod_type, Finset.sum_eq_single i]
  · simp
  · intro i' _ hi'
    simp [hi']
  · simp

/-- Helper for Exercise 4.32: a copied block indexed by one visible coordinate collapses to that
coordinate across every component copy. -/
private lemma sumProdCastIteMul_eq_activeInner
    {l k : ℕ}
    (f : Fin l → Fin k → ℝ)
    (u : Fin k)
    (c : ℚ) :
    ∑ ij : Fin l × Fin k, (((if ij.2 = u then c else 0 : ℚ) : ℝ) * f ij.1 ij.2) =
      ∑ i : Fin l, (c : ℝ) * f i u := by
  -- Expand the product sum row-by-row and collapse each inner singleton at `u`.
  rw [Fintype.sum_prod_type]
  refine Finset.sum_congr rfl ?_
  intro i hi
  simpa using sumCastIteMul_eq_active (f := fun j ↦ f i j) u c

/-- Helper for Exercise 4.32: a component row of the direct lifted system is exactly the
corresponding component inequality for `sharedRecessionLiftPart y i`, with right-hand side scaled
by the selector coordinate `z i`. -/
private lemma sharedRecessionLift_componentRow_eval
    {n p l : ℕ}
    (mQ : Fin l → ℕ)
    (AintQ : ∀ i : Fin l, Matrix (Fin (mQ i)) (Fin n) ℚ)
    (ArealQ : ∀ i : Fin l, Matrix (Fin (mQ i)) (Fin p) ℚ)
    (bQ : ∀ i : Fin l, Fin (mQ i) → ℚ)
    (y : SharedRecessionLiftAux n p l → ℝ)
    (z : Fin l → ℤ)
    (i : Fin l)
    (t : Fin (mQ i)) :
    (fun a : SharedRecessionLiftAux n p l ↦
        (sharedRecessionLiftAuxMatrix (n := n) (p := p) mQ AintQ ArealQ
          (SharedRecessionLiftRow.component (n := n) (p := p) i t) a : ℝ)) ⬝ᵥ y +
    (fun j : Fin l ↦
        (sharedRecessionLiftSelectorMatrix (n := n) (p := p) mQ bQ
          (SharedRecessionLiftRow.component (n := n) (p := p) i t) j : ℝ)) ⬝ᵥ
        (fun j ↦ (z j : ℝ)) =
      ((((AintQ i).map (Rat.castHom ℝ)) *ᵥ (sharedRecessionLiftPart y i).1) +
          (((ArealQ i).map (Rat.castHom ℝ)) *ᵥ (sharedRecessionLiftPart y i).2)) t -
        (z i : ℝ) * (bQ i t : ℝ) := by
  have hInt :
      ∑ ij : Fin l × Fin n,
          (((if ij.1 = i then AintQ i t ij.2 else 0 : ℚ) : ℝ) * y (Sum.inl ij)) =
        (((AintQ i).map (Rat.castHom ℝ)) *ᵥ (sharedRecessionLiftPart y i).1) t := by
    -- Collapse the copied integer block to the active component `i`.
    rw [sumProdCastIteMul_eq_activeOuter
      (f := fun i' j ↦ y (Sum.inl (i', j))) (i := i) (c := fun j ↦ AintQ i t j)]
    simp [Matrix.mulVec, dotProduct, sharedRecessionLiftPart]
  have hReal :
      ∑ ij : Fin l × Fin p,
          (((if ij.1 = i then ArealQ i t ij.2 else 0 : ℚ) : ℝ) * y (Sum.inr ij)) =
        (((ArealQ i).map (Rat.castHom ℝ)) *ᵥ (sharedRecessionLiftPart y i).2) t := by
    -- The copied real block collapses in the same way.
    rw [sumProdCastIteMul_eq_activeOuter
      (f := fun i' j ↦ y (Sum.inr (i', j))) (i := i) (c := fun j ↦ ArealQ i t j)]
    simp [Matrix.mulVec, dotProduct, sharedRecessionLiftPart]
  have hSel :
      ∑ j : Fin l, (((if j = i then -(bQ i t) else 0 : ℚ) : ℝ) * (z j : ℝ)) =
        ((-(bQ i t) : ℚ) : ℝ) * (z i : ℝ) := by
    -- The selector block contributes only the active right-hand-side scaling term.
    simpa using sumCastIteMul_eq_active (f := fun j ↦ (z j : ℝ)) i (-(bQ i t))
  -- Split the sum-type auxiliary dot product, then rewrite every block in its stable normal form.
  calc
    (fun a : SharedRecessionLiftAux n p l ↦
        (sharedRecessionLiftAuxMatrix (n := n) (p := p) mQ AintQ ArealQ
          (SharedRecessionLiftRow.component (n := n) (p := p) i t) a : ℝ)) ⬝ᵥ y +
      (fun j : Fin l ↦
          (sharedRecessionLiftSelectorMatrix (n := n) (p := p) mQ bQ
            (SharedRecessionLiftRow.component (n := n) (p := p) i t) j : ℝ)) ⬝ᵥ
          (fun j ↦ (z j : ℝ)) =
        (∑ ij : Fin l × Fin n,
            (((if ij.1 = i then AintQ i t ij.2 else 0 : ℚ) : ℝ) * y (Sum.inl ij))) +
          (∑ ij : Fin l × Fin p,
            (((if ij.1 = i then ArealQ i t ij.2 else 0 : ℚ) : ℝ) * y (Sum.inr ij))) +
          ∑ j : Fin l, (((if j = i then -(bQ i t) else 0 : ℚ) : ℝ) * (z j : ℝ)) := by
            simp [dotProduct, Fintype.sum_sum_type, sharedRecessionLiftAuxMatrix,
              sharedRecessionLiftSelectorMatrix, add_assoc, add_left_comm, add_comm]
    _ =
        (((AintQ i).map (Rat.castHom ℝ)) *ᵥ (sharedRecessionLiftPart y i).1) t +
          (((ArealQ i).map (Rat.castHom ℝ)) *ᵥ (sharedRecessionLiftPart y i).2) t +
          (((-(bQ i t) : ℚ) : ℝ) * (z i : ℝ)) := by
            rw [hInt, hReal, hSel]
    _ =
        ((((AintQ i).map (Rat.castHom ℝ)) *ᵥ (sharedRecessionLiftPart y i).1) +
            (((ArealQ i).map (Rat.castHom ℝ)) *ᵥ (sharedRecessionLiftPart y i).2)) t -
          (z i : ℝ) * (bQ i t : ℝ) := by
            simp [sub_eq_add_neg, add_assoc, add_left_comm, add_comm, mul_comm, mul_left_comm,
              mul_assoc]

/-- Helper for Exercise 4.32: the `intEqLe` row rewrites to `xy.1 u - ∑ i, (sharedRecessionLiftPart y i).1 u`. -/
private lemma sharedRecessionLift_intEqLe_row_eval
    {n p l : ℕ}
    (mQ : Fin l → ℕ)
    (AintQ : ∀ i : Fin l, Matrix (Fin (mQ i)) (Fin n) ℚ)
    (ArealQ : ∀ i : Fin l, Matrix (Fin (mQ i)) (Fin p) ℚ)
    (xy : MixedRealPoint n p)
    (y : SharedRecessionLiftAux n p l → ℝ)
    (u : Fin n) :
    (fun j : Fin n ↦
      (sharedRecessionLiftAint (n := n) (p := p) mQ
        (SharedRecessionLiftRow.intEqLe (n := n) (p := p) u) j : ℝ)) ⬝ᵥ
        xy.1 +
    (fun a : SharedRecessionLiftAux n p l ↦
        (sharedRecessionLiftAuxMatrix (n := n) (p := p) mQ AintQ ArealQ
          (SharedRecessionLiftRow.intEqLe (n := n) (p := p) u) a : ℝ)) ⬝ᵥ y =
      xy.1 u - ∑ i : Fin l, (sharedRecessionLiftPart y i).1 u := by
  have hVisible :
      (fun j : Fin n ↦
        (sharedRecessionLiftAint (n := n) (p := p) mQ
          (SharedRecessionLiftRow.intEqLe (n := n) (p := p) u) j : ℝ)) ⬝ᵥ xy.1 =
        xy.1 u := by
    -- The visible singleton row keeps only coordinate `u`.
    simpa [dotProduct, sharedRecessionLiftAint] using
      sumCastIteMul_eq_active (f := xy.1) u 1
  have hAux :
      (fun a : SharedRecessionLiftAux n p l ↦
          (sharedRecessionLiftAuxMatrix (n := n) (p := p) mQ AintQ ArealQ
            (SharedRecessionLiftRow.intEqLe (n := n) (p := p) u) a : ℝ)) ⬝ᵥ y =
        ∑ i : Fin l, (-1 : ℝ) * (sharedRecessionLiftPart y i).1 u := by
    -- The copied integer block contributes the negative sum of the `u`th coordinates.
    calc
      (fun a : SharedRecessionLiftAux n p l ↦
          (sharedRecessionLiftAuxMatrix (n := n) (p := p) mQ AintQ ArealQ
            (SharedRecessionLiftRow.intEqLe (n := n) (p := p) u) a : ℝ)) ⬝ᵥ y =
          ∑ ij : Fin l × Fin n, (((if ij.2 = u then (-1 : ℚ) else 0 : ℚ) : ℝ) * y (Sum.inl ij)) := by
            simp [dotProduct, Fintype.sum_sum_type, sharedRecessionLiftAuxMatrix]
      _ = ∑ i : Fin l, ((-1 : ℚ) : ℝ) * y (Sum.inl (i, u)) := by
            rw [sumProdCastIteMul_eq_activeInner
              (f := fun i j ↦ y (Sum.inl (i, j))) (u := u) (c := (-1 : ℚ))]
      _ = ∑ i : Fin l, (-1 : ℝ) * (sharedRecessionLiftPart y i).1 u := by
            simp [sharedRecessionLiftPart]
  -- Normalize the visible row and the copied block separately before recombining them.
  calc
    (fun j : Fin n ↦
      (sharedRecessionLiftAint (n := n) (p := p) mQ
        (SharedRecessionLiftRow.intEqLe (n := n) (p := p) u) j : ℝ)) ⬝ᵥ
        xy.1 +
      (fun a : SharedRecessionLiftAux n p l ↦
          (sharedRecessionLiftAuxMatrix (n := n) (p := p) mQ AintQ ArealQ
            (SharedRecessionLiftRow.intEqLe (n := n) (p := p) u) a : ℝ)) ⬝ᵥ y =
        xy.1 u + ∑ i : Fin l, (-1 : ℝ) * (sharedRecessionLiftPart y i).1 u := by
          rw [hVisible, hAux]
    _ = xy.1 u + ∑ i : Fin l, -((sharedRecessionLiftPart y i).1 u) := by
          simp
    _ = xy.1 u + -(∑ i : Fin l, (sharedRecessionLiftPart y i).1 u) := by
          rw [Finset.sum_neg_distrib]
    _ = xy.1 u - ∑ i : Fin l, (sharedRecessionLiftPart y i).1 u := by
          simp [sub_eq_add_neg]

/-- Helper for Exercise 4.32: the `intEqGe` row rewrites to `-xy.1 u + ∑ i, (sharedRecessionLiftPart y i).1 u`. -/
private lemma sharedRecessionLift_intEqGe_row_eval
    {n p l : ℕ}
    (mQ : Fin l → ℕ)
    (AintQ : ∀ i : Fin l, Matrix (Fin (mQ i)) (Fin n) ℚ)
    (ArealQ : ∀ i : Fin l, Matrix (Fin (mQ i)) (Fin p) ℚ)
    (xy : MixedRealPoint n p)
    (y : SharedRecessionLiftAux n p l → ℝ)
    (u : Fin n) :
    (fun j : Fin n ↦
      (sharedRecessionLiftAint (n := n) (p := p) mQ
        (SharedRecessionLiftRow.intEqGe (n := n) (p := p) u) j : ℝ)) ⬝ᵥ
        xy.1 +
    (fun a : SharedRecessionLiftAux n p l ↦
        (sharedRecessionLiftAuxMatrix (n := n) (p := p) mQ AintQ ArealQ
          (SharedRecessionLiftRow.intEqGe (n := n) (p := p) u) a : ℝ)) ⬝ᵥ y =
      -xy.1 u + ∑ i : Fin l, (sharedRecessionLiftPart y i).1 u := by
  have hVisible :
      (fun j : Fin n ↦
        (sharedRecessionLiftAint (n := n) (p := p) mQ
          (SharedRecessionLiftRow.intEqGe (n := n) (p := p) u) j : ℝ)) ⬝ᵥ xy.1 =
        -xy.1 u := by
    -- The visible singleton row keeps coordinate `u` with the opposite sign.
    simpa [dotProduct, sharedRecessionLiftAint] using
      sumCastIteMul_eq_active (f := xy.1) u (-1)
  have hAux :
      (fun a : SharedRecessionLiftAux n p l ↦
          (sharedRecessionLiftAuxMatrix (n := n) (p := p) mQ AintQ ArealQ
            (SharedRecessionLiftRow.intEqGe (n := n) (p := p) u) a : ℝ)) ⬝ᵥ y =
        ∑ i : Fin l, (sharedRecessionLiftPart y i).1 u := by
    -- The copied integer block now contributes with positive sign.
    calc
      (fun a : SharedRecessionLiftAux n p l ↦
          (sharedRecessionLiftAuxMatrix (n := n) (p := p) mQ AintQ ArealQ
            (SharedRecessionLiftRow.intEqGe (n := n) (p := p) u) a : ℝ)) ⬝ᵥ y =
          ∑ ij : Fin l × Fin n, (((if ij.2 = u then (1 : ℚ) else 0 : ℚ) : ℝ) * y (Sum.inl ij)) := by
            simp [dotProduct, Fintype.sum_sum_type, sharedRecessionLiftAuxMatrix]
      _ = ∑ i : Fin l, ((1 : ℚ) : ℝ) * y (Sum.inl (i, u)) := by
            rw [sumProdCastIteMul_eq_activeInner
              (f := fun i j ↦ y (Sum.inl (i, j))) (u := u) (c := (1 : ℚ))]
      _ = ∑ i : Fin l, (sharedRecessionLiftPart y i).1 u := by
            simp [sharedRecessionLiftPart]
  -- The opposite-sign reconstruction row is now a direct sum of the visible and copied parts.
  calc
    (fun j : Fin n ↦
      (sharedRecessionLiftAint (n := n) (p := p) mQ
        (SharedRecessionLiftRow.intEqGe (n := n) (p := p) u) j : ℝ)) ⬝ᵥ
        xy.1 +
      (fun a : SharedRecessionLiftAux n p l ↦
          (sharedRecessionLiftAuxMatrix (n := n) (p := p) mQ AintQ ArealQ
            (SharedRecessionLiftRow.intEqGe (n := n) (p := p) u) a : ℝ)) ⬝ᵥ y =
        -xy.1 u + ∑ i : Fin l, (sharedRecessionLiftPart y i).1 u := by
          rw [hVisible, hAux]

/-- Helper for Exercise 4.32: the `realEqLe` row rewrites to `xy.2 u - ∑ i, (sharedRecessionLiftPart y i).2 u`. -/
private lemma sharedRecessionLift_realEqLe_row_eval
    {n p l : ℕ}
    (mQ : Fin l → ℕ)
    (AintQ : ∀ i : Fin l, Matrix (Fin (mQ i)) (Fin n) ℚ)
    (ArealQ : ∀ i : Fin l, Matrix (Fin (mQ i)) (Fin p) ℚ)
    (xy : MixedRealPoint n p)
    (y : SharedRecessionLiftAux n p l → ℝ)
    (u : Fin p) :
    (fun j : Fin p ↦
      (sharedRecessionLiftAreal (n := n) (p := p) mQ
        (SharedRecessionLiftRow.realEqLe (n := n) (p := p) u) j : ℝ)) ⬝ᵥ
        xy.2 +
    (fun a : SharedRecessionLiftAux n p l ↦
        (sharedRecessionLiftAuxMatrix (n := n) (p := p) mQ AintQ ArealQ
          (SharedRecessionLiftRow.realEqLe (n := n) (p := p) u) a : ℝ)) ⬝ᵥ y =
      xy.2 u - ∑ i : Fin l, (sharedRecessionLiftPart y i).2 u := by
  have hVisible :
      (fun j : Fin p ↦
        (sharedRecessionLiftAreal (n := n) (p := p) mQ
          (SharedRecessionLiftRow.realEqLe (n := n) (p := p) u) j : ℝ)) ⬝ᵥ xy.2 =
        xy.2 u := by
    -- The visible real singleton row keeps only coordinate `u`.
    simpa [dotProduct, sharedRecessionLiftAreal] using
      sumCastIteMul_eq_active (f := xy.2) u 1
  have hAux :
      (fun a : SharedRecessionLiftAux n p l ↦
          (sharedRecessionLiftAuxMatrix (n := n) (p := p) mQ AintQ ArealQ
            (SharedRecessionLiftRow.realEqLe (n := n) (p := p) u) a : ℝ)) ⬝ᵥ y =
        ∑ i : Fin l, (-1 : ℝ) * (sharedRecessionLiftPart y i).2 u := by
    -- The copied real block contributes the negative sum of the `u`th coordinates.
    calc
      (fun a : SharedRecessionLiftAux n p l ↦
          (sharedRecessionLiftAuxMatrix (n := n) (p := p) mQ AintQ ArealQ
            (SharedRecessionLiftRow.realEqLe (n := n) (p := p) u) a : ℝ)) ⬝ᵥ y =
          ∑ ij : Fin l × Fin p, (((if ij.2 = u then (-1 : ℚ) else 0 : ℚ) : ℝ) * y (Sum.inr ij)) := by
            simp [dotProduct, Fintype.sum_sum_type, sharedRecessionLiftAuxMatrix]
      _ = ∑ i : Fin l, ((-1 : ℚ) : ℝ) * y (Sum.inr (i, u)) := by
            rw [sumProdCastIteMul_eq_activeInner
              (f := fun i j ↦ y (Sum.inr (i, j))) (u := u) (c := (-1 : ℚ))]
      _ = ∑ i : Fin l, (-1 : ℝ) * (sharedRecessionLiftPart y i).2 u := by
            simp [sharedRecessionLiftPart]
  -- The real reconstruction row is the same normalization pattern as the integer one.
  calc
    (fun j : Fin p ↦
      (sharedRecessionLiftAreal (n := n) (p := p) mQ
        (SharedRecessionLiftRow.realEqLe (n := n) (p := p) u) j : ℝ)) ⬝ᵥ
        xy.2 +
      (fun a : SharedRecessionLiftAux n p l ↦
          (sharedRecessionLiftAuxMatrix (n := n) (p := p) mQ AintQ ArealQ
            (SharedRecessionLiftRow.realEqLe (n := n) (p := p) u) a : ℝ)) ⬝ᵥ y =
        xy.2 u + ∑ i : Fin l, (-1 : ℝ) * (sharedRecessionLiftPart y i).2 u := by
          rw [hVisible, hAux]
    _ = xy.2 u + ∑ i : Fin l, -((sharedRecessionLiftPart y i).2 u) := by
          simp
    _ = xy.2 u + -(∑ i : Fin l, (sharedRecessionLiftPart y i).2 u) := by
          rw [Finset.sum_neg_distrib]
    _ = xy.2 u - ∑ i : Fin l, (sharedRecessionLiftPart y i).2 u := by
          simp [sub_eq_add_neg]

/-- Helper for Exercise 4.32: the `realEqGe` row rewrites to `-xy.2 u + ∑ i, (sharedRecessionLiftPart y i).2 u`. -/
private lemma sharedRecessionLift_realEqGe_row_eval
    {n p l : ℕ}
    (mQ : Fin l → ℕ)
    (AintQ : ∀ i : Fin l, Matrix (Fin (mQ i)) (Fin n) ℚ)
    (ArealQ : ∀ i : Fin l, Matrix (Fin (mQ i)) (Fin p) ℚ)
    (xy : MixedRealPoint n p)
    (y : SharedRecessionLiftAux n p l → ℝ)
    (u : Fin p) :
    (fun j : Fin p ↦
      (sharedRecessionLiftAreal (n := n) (p := p) mQ
        (SharedRecessionLiftRow.realEqGe (n := n) (p := p) u) j : ℝ)) ⬝ᵥ
        xy.2 +
    (fun a : SharedRecessionLiftAux n p l ↦
        (sharedRecessionLiftAuxMatrix (n := n) (p := p) mQ AintQ ArealQ
          (SharedRecessionLiftRow.realEqGe (n := n) (p := p) u) a : ℝ)) ⬝ᵥ y =
      -xy.2 u + ∑ i : Fin l, (sharedRecessionLiftPart y i).2 u := by
  have hVisible :
      (fun j : Fin p ↦
        (sharedRecessionLiftAreal (n := n) (p := p) mQ
          (SharedRecessionLiftRow.realEqGe (n := n) (p := p) u) j : ℝ)) ⬝ᵥ xy.2 =
        -xy.2 u := by
    -- The visible real singleton row keeps coordinate `u` with the opposite sign.
    simpa [dotProduct, sharedRecessionLiftAreal] using
      sumCastIteMul_eq_active (f := xy.2) u (-1)
  have hAux :
      (fun a : SharedRecessionLiftAux n p l ↦
          (sharedRecessionLiftAuxMatrix (n := n) (p := p) mQ AintQ ArealQ
            (SharedRecessionLiftRow.realEqGe (n := n) (p := p) u) a : ℝ)) ⬝ᵥ y =
        ∑ i : Fin l, (sharedRecessionLiftPart y i).2 u := by
    -- The copied real block now contributes with positive sign.
    calc
      (fun a : SharedRecessionLiftAux n p l ↦
          (sharedRecessionLiftAuxMatrix (n := n) (p := p) mQ AintQ ArealQ
            (SharedRecessionLiftRow.realEqGe (n := n) (p := p) u) a : ℝ)) ⬝ᵥ y =
          ∑ ij : Fin l × Fin p, (((if ij.2 = u then (1 : ℚ) else 0 : ℚ) : ℝ) * y (Sum.inr ij)) := by
            simp [dotProduct, Fintype.sum_sum_type, sharedRecessionLiftAuxMatrix]
      _ = ∑ i : Fin l, ((1 : ℚ) : ℝ) * y (Sum.inr (i, u)) := by
            rw [sumProdCastIteMul_eq_activeInner
              (f := fun i j ↦ y (Sum.inr (i, j))) (u := u) (c := (1 : ℚ))]
      _ = ∑ i : Fin l, (sharedRecessionLiftPart y i).2 u := by
            simp [sharedRecessionLiftPart]
  -- The opposite-sign real row is now the direct sum of the visible and copied parts.
  calc
    (fun j : Fin p ↦
      (sharedRecessionLiftAreal (n := n) (p := p) mQ
        (SharedRecessionLiftRow.realEqGe (n := n) (p := p) u) j : ℝ)) ⬝ᵥ
        xy.2 +
      (fun a : SharedRecessionLiftAux n p l ↦
          (sharedRecessionLiftAuxMatrix (n := n) (p := p) mQ AintQ ArealQ
            (SharedRecessionLiftRow.realEqGe (n := n) (p := p) u) a : ℝ)) ⬝ᵥ y =
        -xy.2 u + ∑ i : Fin l, (sharedRecessionLiftPart y i).2 u := by
          rw [hVisible, hAux]

/-- Helper for Exercise 4.32: reindexing the row and auxiliary finite types preserves membership
in the mixed-binary projection owner. -/
private theorem mem_mixed_binary_linear_projection_rowAux_reindex_iff
    {n p q : ℕ}
    {ρ μ : Type*}
    [Fintype ρ] [Fintype μ]
    (Aint : Matrix ρ (Fin n) ℚ)
    (Areal : Matrix ρ (Fin p) ℚ)
    (B : Matrix ρ μ ℚ)
    (C : Matrix ρ (Fin q) ℚ)
    (d : ρ → ℚ)
    {xy : MixedRealPoint n p} :
    let AintFin : Matrix (Fin (Fintype.card ρ)) (Fin n) ℚ :=
      Aint.reindex (Fintype.equivFin ρ) (Equiv.refl (Fin n))
    let ArealFin : Matrix (Fin (Fintype.card ρ)) (Fin p) ℚ :=
      Areal.reindex (Fintype.equivFin ρ) (Equiv.refl (Fin p))
    let BFin : Matrix (Fin (Fintype.card ρ)) (Fin (Fintype.card μ)) ℚ :=
      B.reindex (Fintype.equivFin ρ) (Fintype.equivFin μ)
    let CFin : Matrix (Fin (Fintype.card ρ)) (Fin q) ℚ :=
      C.reindex (Fintype.equivFin ρ) (Equiv.refl (Fin q))
    let dFin : Fin (Fintype.card ρ) → ℚ :=
      d ∘ (Fintype.equivFin ρ).symm
    xy ∈ mixed_binary_linear_projection AintFin ArealFin BFin CFin dFin ↔
      xy ∈ (ℤ^n×ℝ^p) ∧
        ∃ y : μ → ℝ,
          ∃ z : Fin q → ℤ,
            is_zero_one_vector (fun j ↦ (z j : ℝ)) ∧
              ∀ i : ρ,
                (∑ j : Fin n, (Aint i j : ℝ) * xy.1 j) +
                    (∑ j : Fin p, (Areal i j : ℝ) * xy.2 j) +
                (∑ j : μ, (B i j : ℝ) * y j) +
                    (∑ j : Fin q, (C i j : ℝ) * (z j : ℝ)) ≤
                  (d i : ℝ) := by
  -- Unfold the reindexed `Fin`-presentation before transporting the auxiliary witness.
  dsimp
  rw [mem_mixed_binary_linear_projection_iff]
  let eρ : ρ ≃ Fin (Fintype.card ρ) := Fintype.equivFin ρ
  let eμ : μ ≃ Fin (Fintype.card μ) := Fintype.equivFin μ
  constructor
  · rintro ⟨hxy_int, yFin, z, hz_binary, hineq⟩
    let y : μ → ℝ := fun j ↦ yFin (eμ j)
    refine ⟨hxy_int, y, z, hz_binary, ?_⟩
    intro i
    have hsumB :
        (∑ j : Fin (Fintype.card μ),
            (B i (eμ.symm j) : ℝ) * yFin j) =
          ∑ j : μ, (B i j : ℝ) * yFin (eμ j) := by
      -- Reindex the auxiliary sum back from `Fin (card μ)` to the original type `μ`.
      exact Fintype.sum_equiv eμ.symm
        (fun j : Fin (Fintype.card μ) ↦ (B i (eμ.symm j) : ℝ) * yFin j)
        (fun j : μ ↦ (B i j : ℝ) * yFin (eμ j))
        (fun j ↦ by simp [eρ, eμ])
    -- Evaluate the transported inequality at the corresponding original row.
    have hi := hineq (eρ i)
    simpa [eρ, eμ, y, hsumB] using hi
  · rintro ⟨hxy_int, y, z, hz_binary, hineq⟩
    let yFin : Fin (Fintype.card μ) → ℝ := fun j ↦ y (eμ.symm j)
    refine ⟨hxy_int, yFin, z, hz_binary, ?_⟩
    intro i
    have hsumB :
        (∑ j : μ, (B (eρ.symm i) j : ℝ) * y j) =
          ∑ j : Fin (Fintype.card μ),
            (B (eρ.symm i) (eμ.symm j) : ℝ) * y (eμ.symm j) := by
      -- The same transport works in the reverse direction after unpacking the inverse row index.
      exact Fintype.sum_equiv eμ
        (fun j : μ ↦ (B (eρ.symm i) j : ℝ) * y j)
        (fun j : Fin (Fintype.card μ) ↦ (B (eρ.symm i) (eμ.symm j) : ℝ) * y (eμ.symm j))
        (fun j ↦ by simp [eρ, eμ])
    -- Read the original inequality at the inverse row and rewrite it into the `Fin`-indexed form.
    have hi := hineq (eρ.symm i)
    simpa [eρ, eμ, yFin, hsumB] using hi

/-- Helper for Exercise 4.32: after transporting each inactive component direction into the
active common recession cone, their finite sum is still a recession direction of the active
component. -/
private lemma sum_mem_recessionCone_of_sharedRecession
    {n p l : ℕ}
    {Q : Fin l → Set (MixedRealPoint n p)}
    {u : Fin l → MixedRealPoint n p}
    {j : Fin l}
    (hu : ∀ i : Fin l, i ≠ j → u i ∈ recessionCone (Q i))
    (hQ : ∀ i : Fin l, recessionCone (Q i) = recessionCone (Q j)) :
    Finset.sum (Finset.univ.erase j) u ∈ recessionCone (Q j) := by
  -- Transport each inactive component into the active recession cone, then sum there.
  refine Submodule.sum_mem (recessionPointedCone ℝ (Q j)) ?_
  intro i hi
  have hij : i ≠ j := by
    simpa using hi
  have hui : u i ∈ recessionCone (Q i) := hu i hij
  simpa [hQ i] using hui

/-- Helper for Exercise 4.32: the direct shared-recession lift inequalities hold rowwise for the
visible mixed point `xy`, auxiliary real block `y`, and binary selector `z`. -/
private def sharedRecessionLiftRowsSatisfied
    {n p l : ℕ}
    (mQ : Fin l → ℕ)
    (AintQ : ∀ i : Fin l, Matrix (Fin (mQ i)) (Fin n) ℚ)
    (ArealQ : ∀ i : Fin l, Matrix (Fin (mQ i)) (Fin p) ℚ)
    (bQ : ∀ i : Fin l, Fin (mQ i) → ℚ)
    (xy : MixedRealPoint n p)
    (y : SharedRecessionLiftAux n p l → ℝ)
    (z : Fin l → ℤ) : Prop :=
  ∀ row : SharedRecessionLiftRow (n := n) (p := p) mQ,
    (∑ j : Fin n, (sharedRecessionLiftAint (n := n) (p := p) mQ row j : ℝ) * xy.1 j) +
        (∑ j : Fin p, (sharedRecessionLiftAreal (n := n) (p := p) mQ row j : ℝ) * xy.2 j) +
      (∑ a : SharedRecessionLiftAux n p l,
        (sharedRecessionLiftAuxMatrix (n := n) (p := p) mQ AintQ ArealQ row a : ℝ) * y a) +
        (∑ j : Fin l,
          (sharedRecessionLiftSelectorMatrix (n := n) (p := p) mQ bQ row j : ℝ) * (z j : ℝ)) ≤
      (sharedRecessionLiftRhs (n := n) (p := p) mQ bQ row : ℝ)

/-- Helper for Exercise 4.32: a component row in the shared-recession lifted owner is equivalent
to the corresponding component inequality bounded by the selector-scaled right-hand side. -/
private lemma sharedRecessionLift_componentConstraint_of_rows
    {n p l : ℕ}
    (mQ : Fin l → ℕ)
    (AintQ : ∀ i : Fin l, Matrix (Fin (mQ i)) (Fin n) ℚ)
    (ArealQ : ∀ i : Fin l, Matrix (Fin (mQ i)) (Fin p) ℚ)
    (bQ : ∀ i : Fin l, Fin (mQ i) → ℚ)
    {xy : MixedRealPoint n p}
    {y : SharedRecessionLiftAux n p l → ℝ}
    {z : Fin l → ℤ}
    (hineq : sharedRecessionLiftRowsSatisfied
      (n := n) (p := p) (l := l) mQ AintQ ArealQ bQ xy y z)
    (i : Fin l)
    (t : Fin (mQ i)) :
    ((((AintQ i).map (Rat.castHom ℝ)) *ᵥ (sharedRecessionLiftPart y i).1) +
        (((ArealQ i).map (Rat.castHom ℝ)) *ᵥ (sharedRecessionLiftPart y i).2)) t ≤
      (z i : ℝ) * (bQ i t : ℝ) := by
  -- Read the component row out of the lifted system and discard the zero visible blocks.
  have hrow :=
    hineq (SharedRecessionLiftRow.component (n := n) (p := p) i t)
  have hrow' :
      (fun a : SharedRecessionLiftAux n p l ↦
          (sharedRecessionLiftAuxMatrix (n := n) (p := p) mQ AintQ ArealQ
            (SharedRecessionLiftRow.component (n := n) (p := p) i t) a : ℝ)) ⬝ᵥ y +
        (fun j : Fin l ↦
            (sharedRecessionLiftSelectorMatrix (n := n) (p := p) mQ bQ
              (SharedRecessionLiftRow.component (n := n) (p := p) i t) j : ℝ)) ⬝ᵥ
            (fun j ↦ (z j : ℝ)) ≤
        0 := by
    have hnorm :
        (∑ a₁ : Fin l × Fin n,
            (sharedRecessionLiftAuxMatrix (n := n) (p := p) mQ AintQ ArealQ
              (SharedRecessionLiftRow.component (n := n) (p := p) i t) (Sum.inl a₁) : ℝ) *
              y (Sum.inl a₁)) +
          ∑ a₂ : Fin l × Fin p,
            (sharedRecessionLiftAuxMatrix (n := n) (p := p) mQ AintQ ArealQ
              (SharedRecessionLiftRow.component (n := n) (p := p) i t) (Sum.inr a₂) : ℝ) *
              y (Sum.inr a₂) +
          ∑ j : Fin l,
            (sharedRecessionLiftSelectorMatrix (n := n) (p := p) mQ bQ
              (SharedRecessionLiftRow.component (n := n) (p := p) i t) j : ℝ) * (z j : ℝ) =
          (fun a : SharedRecessionLiftAux n p l ↦
              (sharedRecessionLiftAuxMatrix (n := n) (p := p) mQ AintQ ArealQ
                (SharedRecessionLiftRow.component (n := n) (p := p) i t) a : ℝ)) ⬝ᵥ y +
            (fun j : Fin l ↦
                (sharedRecessionLiftSelectorMatrix (n := n) (p := p) mQ bQ
                  (SharedRecessionLiftRow.component (n := n) (p := p) i t) j : ℝ)) ⬝ᵥ
                (fun j ↦ (z j : ℝ)) := by
      symm
      simpa [dotProduct, Fintype.sum_sum_type, add_assoc] using
        sharedRecessionLift_componentRow_eval (mQ := mQ) (AintQ := AintQ) (ArealQ := ArealQ)
          (bQ := bQ) (y := y) (z := z) (i := i) (t := t)
    have hrowSum :
        (∑ a₁ : Fin l × Fin n,
            (sharedRecessionLiftAuxMatrix (n := n) (p := p) mQ AintQ ArealQ
              (SharedRecessionLiftRow.component (n := n) (p := p) i t) (Sum.inl a₁) : ℝ) *
              y (Sum.inl a₁)) +
          ∑ a₂ : Fin l × Fin p,
            (sharedRecessionLiftAuxMatrix (n := n) (p := p) mQ AintQ ArealQ
              (SharedRecessionLiftRow.component (n := n) (p := p) i t) (Sum.inr a₂) : ℝ) *
              y (Sum.inr a₂) +
          ∑ j : Fin l,
            (sharedRecessionLiftSelectorMatrix (n := n) (p := p) mQ bQ
              (SharedRecessionLiftRow.component (n := n) (p := p) i t) j : ℝ) * (z j : ℝ) ≤
          0 := by
      simpa [sharedRecessionLiftAint, sharedRecessionLiftAreal, sharedRecessionLiftRhs,
        dotProduct, Fintype.sum_sum_type, add_assoc] using hrow
    rwa [hnorm] at hrowSum
  -- Convert the packaged row back to the scalar component inequality.
  rw [sharedRecessionLift_componentRow_eval (mQ := mQ) (AintQ := AintQ) (ArealQ := ArealQ)
    (bQ := bQ) (y := y) (z := z) (i := i) (t := t)] at hrow'
  exact sub_nonpos.mp hrow'

/-- Helper for Exercise 4.32: the `intEqLe` row forces each visible integer coordinate to be at
most the sum of its copied component coordinates. -/
private lemma sharedRecessionLift_intReconstructionLe_of_rows
    {n p l : ℕ}
    (mQ : Fin l → ℕ)
    (AintQ : ∀ i : Fin l, Matrix (Fin (mQ i)) (Fin n) ℚ)
    (ArealQ : ∀ i : Fin l, Matrix (Fin (mQ i)) (Fin p) ℚ)
    (bQ : ∀ i : Fin l, Fin (mQ i) → ℚ)
    {xy : MixedRealPoint n p}
    {y : SharedRecessionLiftAux n p l → ℝ}
    {z : Fin l → ℤ}
    (hineq : sharedRecessionLiftRowsSatisfied
      (n := n) (p := p) (l := l) mQ AintQ ArealQ bQ xy y z)
    (u : Fin n) :
    xy.1 u ≤ ∑ i : Fin l, (sharedRecessionLiftPart y i).1 u := by
  -- Read the `intEqLe` row and remove the zero visible-real and selector blocks.
  have hrow :=
    hineq (SharedRecessionLiftRow.intEqLe (n := n) (p := p) u)
  have hrow' :
      (fun j : Fin n ↦
          (sharedRecessionLiftAint (n := n) (p := p) mQ
            (SharedRecessionLiftRow.intEqLe (n := n) (p := p) u) j : ℝ)) ⬝ᵥ xy.1 +
        (fun a : SharedRecessionLiftAux n p l ↦
            (sharedRecessionLiftAuxMatrix (n := n) (p := p) mQ AintQ ArealQ
              (SharedRecessionLiftRow.intEqLe (n := n) (p := p) u) a : ℝ)) ⬝ᵥ y ≤
        0 := by
    have hnorm :
        ∑ j : Fin n,
            (sharedRecessionLiftAint (n := n) (p := p) mQ
              (SharedRecessionLiftRow.intEqLe (n := n) (p := p) u) j : ℝ) * xy.1 j +
          (∑ a₁ : Fin l × Fin n,
              (sharedRecessionLiftAuxMatrix (n := n) (p := p) mQ AintQ ArealQ
                (SharedRecessionLiftRow.intEqLe (n := n) (p := p) u) (Sum.inl a₁) : ℝ) *
                y (Sum.inl a₁) +
            ∑ a₂ : Fin l × Fin p,
              (sharedRecessionLiftAuxMatrix (n := n) (p := p) mQ AintQ ArealQ
                (SharedRecessionLiftRow.intEqLe (n := n) (p := p) u) (Sum.inr a₂) : ℝ) *
                y (Sum.inr a₂)) =
          (fun j : Fin n ↦
              (sharedRecessionLiftAint (n := n) (p := p) mQ
                (SharedRecessionLiftRow.intEqLe (n := n) (p := p) u) j : ℝ)) ⬝ᵥ xy.1 +
            (fun a : SharedRecessionLiftAux n p l ↦
                (sharedRecessionLiftAuxMatrix (n := n) (p := p) mQ AintQ ArealQ
                  (SharedRecessionLiftRow.intEqLe (n := n) (p := p) u) a : ℝ)) ⬝ᵥ y := by
      symm
      simpa [dotProduct, Fintype.sum_sum_type, add_assoc] using
        sharedRecessionLift_intEqLe_row_eval (mQ := mQ) (AintQ := AintQ) (ArealQ := ArealQ)
          (xy := xy) (y := y) (u := u)
    have hrowSum :
        ∑ j : Fin n,
            (sharedRecessionLiftAint (n := n) (p := p) mQ
              (SharedRecessionLiftRow.intEqLe (n := n) (p := p) u) j : ℝ) * xy.1 j +
          (∑ a₁ : Fin l × Fin n,
              (sharedRecessionLiftAuxMatrix (n := n) (p := p) mQ AintQ ArealQ
                (SharedRecessionLiftRow.intEqLe (n := n) (p := p) u) (Sum.inl a₁) : ℝ) *
                y (Sum.inl a₁) +
            ∑ a₂ : Fin l × Fin p,
              (sharedRecessionLiftAuxMatrix (n := n) (p := p) mQ AintQ ArealQ
                (SharedRecessionLiftRow.intEqLe (n := n) (p := p) u) (Sum.inr a₂) : ℝ) *
                y (Sum.inr a₂)) ≤
          0 := by
      simpa [sharedRecessionLiftAreal, sharedRecessionLiftSelectorMatrix, sharedRecessionLiftRhs,
        dotProduct, Fintype.sum_sum_type, add_assoc] using hrow
    rwa [hnorm] at hrowSum
  -- Convert the packaged row back to the scalar reconstruction inequality.
  rw [sharedRecessionLift_intEqLe_row_eval (mQ := mQ) (AintQ := AintQ) (ArealQ := ArealQ)
    (xy := xy) (y := y) (u := u)] at hrow'
  exact sub_nonpos.mp hrow'

/-- Helper for Exercise 4.32: the `intEqGe` row forces the copied component coordinates to sum to
at most the visible integer coordinate. -/
private lemma sharedRecessionLift_intReconstructionGe_of_rows
    {n p l : ℕ}
    (mQ : Fin l → ℕ)
    (AintQ : ∀ i : Fin l, Matrix (Fin (mQ i)) (Fin n) ℚ)
    (ArealQ : ∀ i : Fin l, Matrix (Fin (mQ i)) (Fin p) ℚ)
    (bQ : ∀ i : Fin l, Fin (mQ i) → ℚ)
    {xy : MixedRealPoint n p}
    {y : SharedRecessionLiftAux n p l → ℝ}
    {z : Fin l → ℤ}
    (hineq : sharedRecessionLiftRowsSatisfied
      (n := n) (p := p) (l := l) mQ AintQ ArealQ bQ xy y z)
    (u : Fin n) :
    ∑ i : Fin l, (sharedRecessionLiftPart y i).1 u ≤ xy.1 u := by
  -- Read the `intEqGe` row and remove the zero visible-real and selector blocks.
  have hrow :=
    hineq (SharedRecessionLiftRow.intEqGe (n := n) (p := p) u)
  have hrow' :
      (fun j : Fin n ↦
          (sharedRecessionLiftAint (n := n) (p := p) mQ
            (SharedRecessionLiftRow.intEqGe (n := n) (p := p) u) j : ℝ)) ⬝ᵥ xy.1 +
        (fun a : SharedRecessionLiftAux n p l ↦
            (sharedRecessionLiftAuxMatrix (n := n) (p := p) mQ AintQ ArealQ
              (SharedRecessionLiftRow.intEqGe (n := n) (p := p) u) a : ℝ)) ⬝ᵥ y ≤
        0 := by
    have hnorm :
        ∑ j : Fin n,
            (sharedRecessionLiftAint (n := n) (p := p) mQ
              (SharedRecessionLiftRow.intEqGe (n := n) (p := p) u) j : ℝ) * xy.1 j +
          (∑ a₁ : Fin l × Fin n,
              (sharedRecessionLiftAuxMatrix (n := n) (p := p) mQ AintQ ArealQ
                (SharedRecessionLiftRow.intEqGe (n := n) (p := p) u) (Sum.inl a₁) : ℝ) *
                y (Sum.inl a₁) +
            ∑ a₂ : Fin l × Fin p,
              (sharedRecessionLiftAuxMatrix (n := n) (p := p) mQ AintQ ArealQ
                (SharedRecessionLiftRow.intEqGe (n := n) (p := p) u) (Sum.inr a₂) : ℝ) *
                y (Sum.inr a₂)) =
          (fun j : Fin n ↦
              (sharedRecessionLiftAint (n := n) (p := p) mQ
                (SharedRecessionLiftRow.intEqGe (n := n) (p := p) u) j : ℝ)) ⬝ᵥ xy.1 +
            (fun a : SharedRecessionLiftAux n p l ↦
                (sharedRecessionLiftAuxMatrix (n := n) (p := p) mQ AintQ ArealQ
                  (SharedRecessionLiftRow.intEqGe (n := n) (p := p) u) a : ℝ)) ⬝ᵥ y := by
      symm
      simpa [dotProduct, Fintype.sum_sum_type, add_assoc] using
        sharedRecessionLift_intEqGe_row_eval (mQ := mQ) (AintQ := AintQ) (ArealQ := ArealQ)
          (xy := xy) (y := y) (u := u)
    have hrowSum :
        ∑ j : Fin n,
            (sharedRecessionLiftAint (n := n) (p := p) mQ
              (SharedRecessionLiftRow.intEqGe (n := n) (p := p) u) j : ℝ) * xy.1 j +
          (∑ a₁ : Fin l × Fin n,
              (sharedRecessionLiftAuxMatrix (n := n) (p := p) mQ AintQ ArealQ
                (SharedRecessionLiftRow.intEqGe (n := n) (p := p) u) (Sum.inl a₁) : ℝ) *
                y (Sum.inl a₁) +
            ∑ a₂ : Fin l × Fin p,
              (sharedRecessionLiftAuxMatrix (n := n) (p := p) mQ AintQ ArealQ
                (SharedRecessionLiftRow.intEqGe (n := n) (p := p) u) (Sum.inr a₂) : ℝ) *
                y (Sum.inr a₂)) ≤
          0 := by
      simpa [sharedRecessionLiftAreal, sharedRecessionLiftSelectorMatrix, sharedRecessionLiftRhs,
        dotProduct, Fintype.sum_sum_type, add_assoc] using hrow
    rwa [hnorm] at hrowSum
  -- Convert the packaged row back to the scalar reconstruction inequality.
  rw [sharedRecessionLift_intEqGe_row_eval (mQ := mQ) (AintQ := AintQ) (ArealQ := ArealQ)
    (xy := xy) (y := y) (u := u)] at hrow'
  linarith

/-- Helper for Exercise 4.32: the `realEqLe` row forces each visible real coordinate to be at
most the sum of its copied component coordinates. -/
private lemma sharedRecessionLift_realReconstructionLe_of_rows
    {n p l : ℕ}
    (mQ : Fin l → ℕ)
    (AintQ : ∀ i : Fin l, Matrix (Fin (mQ i)) (Fin n) ℚ)
    (ArealQ : ∀ i : Fin l, Matrix (Fin (mQ i)) (Fin p) ℚ)
    (bQ : ∀ i : Fin l, Fin (mQ i) → ℚ)
    {xy : MixedRealPoint n p}
    {y : SharedRecessionLiftAux n p l → ℝ}
    {z : Fin l → ℤ}
    (hineq : sharedRecessionLiftRowsSatisfied
      (n := n) (p := p) (l := l) mQ AintQ ArealQ bQ xy y z)
    (u : Fin p) :
    xy.2 u ≤ ∑ i : Fin l, (sharedRecessionLiftPart y i).2 u := by
  -- Read the `realEqLe` row and remove the zero visible-integer and selector blocks.
  have hrow :=
    hineq (SharedRecessionLiftRow.realEqLe (n := n) (p := p) u)
  have hrow' :
      (fun j : Fin p ↦
          (sharedRecessionLiftAreal (n := n) (p := p) mQ
            (SharedRecessionLiftRow.realEqLe (n := n) (p := p) u) j : ℝ)) ⬝ᵥ xy.2 +
        (fun a : SharedRecessionLiftAux n p l ↦
            (sharedRecessionLiftAuxMatrix (n := n) (p := p) mQ AintQ ArealQ
              (SharedRecessionLiftRow.realEqLe (n := n) (p := p) u) a : ℝ)) ⬝ᵥ y ≤
        0 := by
    have hnorm :
        ∑ j : Fin p,
            (sharedRecessionLiftAreal (n := n) (p := p) mQ
              (SharedRecessionLiftRow.realEqLe (n := n) (p := p) u) j : ℝ) * xy.2 j +
          (∑ a₁ : Fin l × Fin n,
              (sharedRecessionLiftAuxMatrix (n := n) (p := p) mQ AintQ ArealQ
                (SharedRecessionLiftRow.realEqLe (n := n) (p := p) u) (Sum.inl a₁) : ℝ) *
                y (Sum.inl a₁) +
            ∑ a₂ : Fin l × Fin p,
              (sharedRecessionLiftAuxMatrix (n := n) (p := p) mQ AintQ ArealQ
                (SharedRecessionLiftRow.realEqLe (n := n) (p := p) u) (Sum.inr a₂) : ℝ) *
                y (Sum.inr a₂)) =
          (fun j : Fin p ↦
              (sharedRecessionLiftAreal (n := n) (p := p) mQ
                (SharedRecessionLiftRow.realEqLe (n := n) (p := p) u) j : ℝ)) ⬝ᵥ xy.2 +
            (fun a : SharedRecessionLiftAux n p l ↦
                (sharedRecessionLiftAuxMatrix (n := n) (p := p) mQ AintQ ArealQ
                  (SharedRecessionLiftRow.realEqLe (n := n) (p := p) u) a : ℝ)) ⬝ᵥ y := by
      symm
      simpa [dotProduct, Fintype.sum_sum_type, add_assoc] using
        sharedRecessionLift_realEqLe_row_eval (mQ := mQ) (AintQ := AintQ) (ArealQ := ArealQ)
          (xy := xy) (y := y) (u := u)
    have hrowSum :
        ∑ j : Fin p,
            (sharedRecessionLiftAreal (n := n) (p := p) mQ
              (SharedRecessionLiftRow.realEqLe (n := n) (p := p) u) j : ℝ) * xy.2 j +
          (∑ a₁ : Fin l × Fin n,
              (sharedRecessionLiftAuxMatrix (n := n) (p := p) mQ AintQ ArealQ
                (SharedRecessionLiftRow.realEqLe (n := n) (p := p) u) (Sum.inl a₁) : ℝ) *
                y (Sum.inl a₁) +
            ∑ a₂ : Fin l × Fin p,
              (sharedRecessionLiftAuxMatrix (n := n) (p := p) mQ AintQ ArealQ
                (SharedRecessionLiftRow.realEqLe (n := n) (p := p) u) (Sum.inr a₂) : ℝ) *
                y (Sum.inr a₂)) ≤
          0 := by
      simpa [sharedRecessionLiftAint, sharedRecessionLiftSelectorMatrix, sharedRecessionLiftRhs,
        dotProduct, Fintype.sum_sum_type, add_assoc] using hrow
    rwa [hnorm] at hrowSum
  -- Convert the packaged row back to the scalar reconstruction inequality.
  rw [sharedRecessionLift_realEqLe_row_eval (mQ := mQ) (AintQ := AintQ) (ArealQ := ArealQ)
    (xy := xy) (y := y) (u := u)] at hrow'
  exact sub_nonpos.mp hrow'

/-- Helper for Exercise 4.32: the `realEqGe` row forces the copied component coordinates to sum to
at most the visible real coordinate. -/
private lemma sharedRecessionLift_realReconstructionGe_of_rows
    {n p l : ℕ}
    (mQ : Fin l → ℕ)
    (AintQ : ∀ i : Fin l, Matrix (Fin (mQ i)) (Fin n) ℚ)
    (ArealQ : ∀ i : Fin l, Matrix (Fin (mQ i)) (Fin p) ℚ)
    (bQ : ∀ i : Fin l, Fin (mQ i) → ℚ)
    {xy : MixedRealPoint n p}
    {y : SharedRecessionLiftAux n p l → ℝ}
    {z : Fin l → ℤ}
    (hineq : sharedRecessionLiftRowsSatisfied
      (n := n) (p := p) (l := l) mQ AintQ ArealQ bQ xy y z)
    (u : Fin p) :
    ∑ i : Fin l, (sharedRecessionLiftPart y i).2 u ≤ xy.2 u := by
  -- Read the `realEqGe` row and remove the zero visible-integer and selector blocks.
  have hrow :=
    hineq (SharedRecessionLiftRow.realEqGe (n := n) (p := p) u)
  have hrow' :
      (fun j : Fin p ↦
          (sharedRecessionLiftAreal (n := n) (p := p) mQ
            (SharedRecessionLiftRow.realEqGe (n := n) (p := p) u) j : ℝ)) ⬝ᵥ xy.2 +
        (fun a : SharedRecessionLiftAux n p l ↦
            (sharedRecessionLiftAuxMatrix (n := n) (p := p) mQ AintQ ArealQ
              (SharedRecessionLiftRow.realEqGe (n := n) (p := p) u) a : ℝ)) ⬝ᵥ y ≤
        0 := by
    have hnorm :
        ∑ j : Fin p,
            (sharedRecessionLiftAreal (n := n) (p := p) mQ
              (SharedRecessionLiftRow.realEqGe (n := n) (p := p) u) j : ℝ) * xy.2 j +
          (∑ a₁ : Fin l × Fin n,
              (sharedRecessionLiftAuxMatrix (n := n) (p := p) mQ AintQ ArealQ
                (SharedRecessionLiftRow.realEqGe (n := n) (p := p) u) (Sum.inl a₁) : ℝ) *
                y (Sum.inl a₁) +
            ∑ a₂ : Fin l × Fin p,
              (sharedRecessionLiftAuxMatrix (n := n) (p := p) mQ AintQ ArealQ
                (SharedRecessionLiftRow.realEqGe (n := n) (p := p) u) (Sum.inr a₂) : ℝ) *
                y (Sum.inr a₂)) =
          (fun j : Fin p ↦
              (sharedRecessionLiftAreal (n := n) (p := p) mQ
                (SharedRecessionLiftRow.realEqGe (n := n) (p := p) u) j : ℝ)) ⬝ᵥ xy.2 +
            (fun a : SharedRecessionLiftAux n p l ↦
                (sharedRecessionLiftAuxMatrix (n := n) (p := p) mQ AintQ ArealQ
                  (SharedRecessionLiftRow.realEqGe (n := n) (p := p) u) a : ℝ)) ⬝ᵥ y := by
      symm
      simpa [dotProduct, Fintype.sum_sum_type, add_assoc] using
        sharedRecessionLift_realEqGe_row_eval (mQ := mQ) (AintQ := AintQ) (ArealQ := ArealQ)
          (xy := xy) (y := y) (u := u)
    have hrowSum :
        ∑ j : Fin p,
            (sharedRecessionLiftAreal (n := n) (p := p) mQ
              (SharedRecessionLiftRow.realEqGe (n := n) (p := p) u) j : ℝ) * xy.2 j +
          (∑ a₁ : Fin l × Fin n,
              (sharedRecessionLiftAuxMatrix (n := n) (p := p) mQ AintQ ArealQ
                (SharedRecessionLiftRow.realEqGe (n := n) (p := p) u) (Sum.inl a₁) : ℝ) *
                y (Sum.inl a₁) +
            ∑ a₂ : Fin l × Fin p,
              (sharedRecessionLiftAuxMatrix (n := n) (p := p) mQ AintQ ArealQ
                (SharedRecessionLiftRow.realEqGe (n := n) (p := p) u) (Sum.inr a₂) : ℝ) *
                y (Sum.inr a₂)) ≤
          0 := by
      simpa [sharedRecessionLiftAint, sharedRecessionLiftSelectorMatrix, sharedRecessionLiftRhs,
        dotProduct, Fintype.sum_sum_type, add_assoc] using hrow
    rwa [hnorm] at hrowSum
  -- Convert the packaged row back to the scalar reconstruction inequality.
  rw [sharedRecessionLift_realEqGe_row_eval (mQ := mQ) (AintQ := AintQ) (ArealQ := ArealQ)
    (xy := xy) (y := y) (u := u)] at hrow'
  linarith

/-- Helper for Exercise 4.32: the selector upper and lower rows force the binary selector to have
total sum `1`. -/
private lemma sharedRecessionLift_selectorSum_eq_one_of_rows
    {n p l : ℕ}
    (mQ : Fin l → ℕ)
    (AintQ : ∀ i : Fin l, Matrix (Fin (mQ i)) (Fin n) ℚ)
    (ArealQ : ∀ i : Fin l, Matrix (Fin (mQ i)) (Fin p) ℚ)
    (bQ : ∀ i : Fin l, Fin (mQ i) → ℚ)
    {xy : MixedRealPoint n p}
    {y : SharedRecessionLiftAux n p l → ℝ}
    {z : Fin l → ℤ}
    (hineq : sharedRecessionLiftRowsSatisfied
      (n := n) (p := p) (l := l) mQ AintQ ArealQ bQ xy y z) :
    ∑ i : Fin l, z i = 1 := by
  -- Read the two selector rows and normalize them to upper and lower bounds on `∑ z`.
  have hUpper :=
    hineq (SharedRecessionLiftRow.selectorUpper (n := n) (p := p) (mQ := mQ))
  have hLower :=
    hineq (SharedRecessionLiftRow.selectorLower (n := n) (p := p) (mQ := mQ))
  have hUpper' : ∑ i : Fin l, (z i : ℝ) ≤ 1 := by
    simpa [sharedRecessionLiftAint, sharedRecessionLiftAreal, sharedRecessionLiftAuxMatrix,
      sharedRecessionLiftSelectorMatrix, sharedRecessionLiftRhs, dotProduct, add_assoc,
      add_left_comm, add_comm] using hUpper
  have hLower' : (1 : ℝ) ≤ ∑ i : Fin l, (z i : ℝ) := by
    have hLower'' : ∑ i : Fin l, (-1 : ℝ) * (z i : ℝ) ≤ -1 := by
      simpa [sharedRecessionLiftAint, sharedRecessionLiftAreal, sharedRecessionLiftAuxMatrix,
        sharedRecessionLiftSelectorMatrix, sharedRecessionLiftRhs, dotProduct, add_assoc,
        add_left_comm, add_comm] using hLower
    have hLower''' : -(∑ i : Fin l, (z i : ℝ)) ≤ -1 := by
      simpa using hLower''
    linarith
  have hsum_real : ∑ i : Fin l, (z i : ℝ) = 1 := by
    linarith
  have hsum_int_cast : ((∑ i : Fin l, z i : ℤ) : ℝ) = 1 := by
    simpa using hsum_real
  exact_mod_cast hsum_int_cast

/-- Helper for Exercise 4.32: the lifted selector rows produce a unique active component. -/
private lemma sharedRecessionLift_exists_activeSelector_of_rows
    {n p l : ℕ}
    (mQ : Fin l → ℕ)
    (AintQ : ∀ i : Fin l, Matrix (Fin (mQ i)) (Fin n) ℚ)
    (ArealQ : ∀ i : Fin l, Matrix (Fin (mQ i)) (Fin p) ℚ)
    (bQ : ∀ i : Fin l, Fin (mQ i) → ℚ)
    {xy : MixedRealPoint n p}
    {y : SharedRecessionLiftAux n p l → ℝ}
    {z : Fin l → ℤ}
    (hz_binary : is_zero_one_vector (fun i ↦ (z i : ℝ)))
    (hineq : sharedRecessionLiftRowsSatisfied
      (n := n) (p := p) (l := l) mQ AintQ ArealQ bQ xy y z) :
    ∃! j : Fin l, z j = 1 := by
  -- Once the selector sum is normalized, the standard binary one-hot lemma closes the claim.
  exact binary_one_hot_selector z hz_binary
    (sharedRecessionLift_selectorSum_eq_one_of_rows
      (mQ := mQ) (AintQ := AintQ) (ArealQ := ArealQ) (bQ := bQ) hineq)

/-- Helper for Exercise 4.32: if selector coordinate `j` is active, the copied block `j` is a
feasible point of component `j`. -/
private lemma sharedRecessionLiftPart_mem_component_of_selector_eq_one
    {n p l : ℕ}
    (mQ : Fin l → ℕ)
    (AintQ : ∀ i : Fin l, Matrix (Fin (mQ i)) (Fin n) ℚ)
    (ArealQ : ∀ i : Fin l, Matrix (Fin (mQ i)) (Fin p) ℚ)
    (bQ : ∀ i : Fin l, Fin (mQ i) → ℚ)
    {xy : MixedRealPoint n p}
    {y : SharedRecessionLiftAux n p l → ℝ}
    {z : Fin l → ℤ}
    (hineq : sharedRecessionLiftRowsSatisfied
      (n := n) (p := p) (l := l) mQ AintQ ArealQ bQ xy y z)
    {j : Fin l}
    (hj : z j = 1) :
    sharedRecessionLiftPart y j ∈
      rational_mixed_polyhedron (AintQ j) (ArealQ j) (bQ j) := by
  -- Specialize the component-row inequality at the active selector value `z j = 1`.
  rw [mem_rational_mixed_polyhedron_iff]
  intro t
  have hcomponent :=
    sharedRecessionLift_componentConstraint_of_rows
      (mQ := mQ) (AintQ := AintQ) (ArealQ := ArealQ) (bQ := bQ) hineq j t
  simpa [hj] using hcomponent

/-- Helper for Exercise 4.32: if selector coordinate `i` is inactive, the copied block `i` is a
recession direction of component `i`. -/
private lemma sharedRecessionLiftPart_mem_recessionCone_of_selector_eq_zero
    {n p l : ℕ}
    (mQ : Fin l → ℕ)
    (AintQ : ∀ i : Fin l, Matrix (Fin (mQ i)) (Fin n) ℚ)
    (ArealQ : ∀ i : Fin l, Matrix (Fin (mQ i)) (Fin p) ℚ)
    (bQ : ∀ i : Fin l, Fin (mQ i) → ℚ)
    (hQ_poly_nonempty :
      ∀ i : Fin l,
        Set.Nonempty (rational_mixed_polyhedron (AintQ i) (ArealQ i) (bQ i)))
    {xy : MixedRealPoint n p}
    {y : SharedRecessionLiftAux n p l → ℝ}
    {z : Fin l → ℤ}
    (hineq : sharedRecessionLiftRowsSatisfied
      (n := n) (p := p) (l := l) mQ AintQ ArealQ bQ xy y z)
    {i : Fin l}
    (hi : z i = 0) :
    sharedRecessionLiftPart y i ∈
      recessionCone (rational_mixed_polyhedron (AintQ i) (ArealQ i) (bQ i)) := by
  -- The inactive selector value reduces the component inequalities to the homogeneous recession
  -- system of the same component.
  refine mem_recessionCone_of_selector_eq_zero (hP_nonempty := hQ_poly_nonempty i) ?_
  intro t
  have hcomponent :=
    sharedRecessionLift_componentConstraint_of_rows
      (mQ := mQ) (AintQ := AintQ) (ArealQ := ArealQ) (bQ := bQ) hineq i t
  simpa [hi] using hcomponent

/-- Helper for Exercise 4.32: the reconstruction rows force the visible mixed point to equal the
sum of the copied component blocks. -/
private lemma sharedRecessionLift_visibleEq_sumParts_of_rows
    {n p l : ℕ}
    (mQ : Fin l → ℕ)
    (AintQ : ∀ i : Fin l, Matrix (Fin (mQ i)) (Fin n) ℚ)
    (ArealQ : ∀ i : Fin l, Matrix (Fin (mQ i)) (Fin p) ℚ)
    (bQ : ∀ i : Fin l, Fin (mQ i) → ℚ)
    {xy : MixedRealPoint n p}
    {y : SharedRecessionLiftAux n p l → ℝ}
    {z : Fin l → ℤ}
    (hineq : sharedRecessionLiftRowsSatisfied
      (n := n) (p := p) (l := l) mQ AintQ ArealQ bQ xy y z) :
    xy = ∑ i : Fin l, sharedRecessionLiftPart y i := by
  apply Prod.ext
  · funext u
    have hLe : xy.1 u ≤ ∑ i : Fin l, (sharedRecessionLiftPart y i).1 u :=
      sharedRecessionLift_intReconstructionLe_of_rows
        (mQ := mQ) (AintQ := AintQ) (ArealQ := ArealQ) (bQ := bQ) hineq u
    have hGe : ∑ i : Fin l, (sharedRecessionLiftPart y i).1 u ≤ xy.1 u :=
      sharedRecessionLift_intReconstructionGe_of_rows
        (mQ := mQ) (AintQ := AintQ) (ArealQ := ArealQ) (bQ := bQ) hineq u
    have hsum_fst :
        (∑ i : Fin l, sharedRecessionLiftPart y i).1 u =
          ∑ i : Fin l, (sharedRecessionLiftPart y i).1 u := by
      simpa using
        congrArg (fun f : Fin n → ℝ ↦ f u)
          (Prod.fst_sum (s := Finset.univ) (f := fun i : Fin l ↦ sharedRecessionLiftPart y i))
    rw [hsum_fst]
    exact le_antisymm hLe hGe
  · funext u
    have hLe : xy.2 u ≤ ∑ i : Fin l, (sharedRecessionLiftPart y i).2 u :=
      sharedRecessionLift_realReconstructionLe_of_rows
        (mQ := mQ) (AintQ := AintQ) (ArealQ := ArealQ) (bQ := bQ) hineq u
    have hGe : ∑ i : Fin l, (sharedRecessionLiftPart y i).2 u ≤ xy.2 u :=
      sharedRecessionLift_realReconstructionGe_of_rows
        (mQ := mQ) (AintQ := AintQ) (ArealQ := ArealQ) (bQ := bQ) hineq u
    have hsum_snd :
        (∑ i : Fin l, sharedRecessionLiftPart y i).2 u =
          ∑ i : Fin l, (sharedRecessionLiftPart y i).2 u := by
      simpa using
        congrArg (fun f : Fin p → ℝ ↦ f u)
          (Prod.snd_sum (s := Finset.univ) (f := fun i : Fin l ↦ sharedRecessionLiftPart y i))
    rw [hsum_snd]
    exact le_antisymm hLe hGe

/-- Helper for Exercise 4.32: once one selector coordinate is active, the visible mixed point
already belongs to that active mixed-integer component. -/
private lemma sharedRecessionLift_mem_mixedIntegerPoints_of_activeSelector
    {n p l : ℕ}
    (mQ : Fin l → ℕ)
    (AintQ : ∀ i : Fin l, Matrix (Fin (mQ i)) (Fin n) ℚ)
    (ArealQ : ∀ i : Fin l, Matrix (Fin (mQ i)) (Fin p) ℚ)
    (bQ : ∀ i : Fin l, Fin (mQ i) → ℚ)
    (hQ_poly_nonempty :
      ∀ i : Fin l,
        Set.Nonempty (rational_mixed_polyhedron (AintQ i) (ArealQ i) (bQ i)))
    (hQ_recession :
      ∀ i j : Fin l,
        recessionCone (rational_mixed_polyhedron (AintQ i) (ArealQ i) (bQ i)) =
          recessionCone (rational_mixed_polyhedron (AintQ j) (ArealQ j) (bQ j)))
    {xy : MixedRealPoint n p}
    {y : SharedRecessionLiftAux n p l → ℝ}
    {z : Fin l → ℤ}
    (hxy_int : xy ∈ (ℤ^n×ℝ^p))
    (hz_binary : is_zero_one_vector (fun i ↦ (z i : ℝ)))
    (hineq : sharedRecessionLiftRowsSatisfied
      (n := n) (p := p) (l := l) mQ AintQ ArealQ bQ xy y z)
    {j : Fin l}
    (hj : z j = 1) :
    xy ∈ mixed_integer_points (rational_mixed_polyhedron (AintQ j) (ArealQ j) (bQ j)) := by
  -- The active copied block is feasible in component `j`, while every inactive block is a common
  -- recession direction, so the reconstructed visible point lies in the same component.
  refine (mem_mixed_integer_points_iff).2 ⟨?_, hxy_int⟩
  have hsum :
      ∑ i : Fin l, z i = 1 :=
    sharedRecessionLift_selectorSum_eq_one_of_rows
      (mQ := mQ) (AintQ := AintQ) (ArealQ := ArealQ) (bQ := bQ) hineq
  have hactive_mem :
      sharedRecessionLiftPart y j ∈
        rational_mixed_polyhedron (AintQ j) (ArealQ j) (bQ j) :=
    sharedRecessionLiftPart_mem_component_of_selector_eq_one
      (mQ := mQ) (AintQ := AintQ) (ArealQ := ArealQ) (bQ := bQ) hineq hj
  have hinactive :
      ∀ i : Fin l, i ≠ j →
        sharedRecessionLiftPart y i ∈
          recessionCone (rational_mixed_polyhedron (AintQ i) (ArealQ i) (bQ i)) := by
    intro i hij
    have hi : z i = 0 :=
      binarySelector_eq_zero_of_ne_active hz_binary hsum hj hij
    exact
      sharedRecessionLiftPart_mem_recessionCone_of_selector_eq_zero
        (mQ := mQ) (AintQ := AintQ) (ArealQ := ArealQ) (bQ := bQ)
        (hQ_poly_nonempty := hQ_poly_nonempty) hineq hi
  have hsum_mem :
      Finset.sum (Finset.univ.erase j) (fun i : Fin l ↦ sharedRecessionLiftPart y i) ∈
        recessionCone (rational_mixed_polyhedron (AintQ j) (ArealQ j) (bQ j)) :=
    sum_mem_recessionCone_of_sharedRecession
      (Q := fun i : Fin l ↦ rational_mixed_polyhedron (AintQ i) (ArealQ i) (bQ i))
      (u := fun i : Fin l ↦ sharedRecessionLiftPart y i)
      (j := j) hinactive (fun i ↦ hQ_recession i j)
  have hsplit :
      sharedRecessionLiftPart y j +
          Finset.sum (Finset.univ.erase j) (fun i : Fin l ↦ sharedRecessionLiftPart y i) =
        ∑ i : Fin l, sharedRecessionLiftPart y i := by
    simpa [add_comm] using
      (Finset.sum_erase_add (s := Finset.univ)
        (f := fun i : Fin l ↦ sharedRecessionLiftPart y i) (by simp : j ∈ Finset.univ))
  have hxy_eq :
      xy =
        sharedRecessionLiftPart y j +
          Finset.sum (Finset.univ.erase j) (fun i : Fin l ↦ sharedRecessionLiftPart y i) := by
    -- Rewrite the visible point through the packaged reconstruction equality and then split off
    -- the active component from the full finite sum.
    calc
      xy = ∑ i : Fin l, sharedRecessionLiftPart y i :=
        sharedRecessionLift_visibleEq_sumParts_of_rows
          (mQ := mQ) (AintQ := AintQ) (ArealQ := ArealQ) (bQ := bQ) hineq
      _ = sharedRecessionLiftPart y j +
            Finset.sum (Finset.univ.erase j) (fun i : Fin l ↦ sharedRecessionLiftPart y i) := by
            symm
            exact hsplit
  rw [hxy_eq]
  simpa [one_smul] using
    (mem_recessionCone_iff.mp hsum_mem) hactive_mem 1 zero_le_one

/-- Helper for Exercise 4.32: the direct shared-recession lift uses one finite row type after
reindexing the abstract row family by `Fin`. -/
private abbrev sharedRecessionLiftRowFin
    {n p l : ℕ} (mQ : Fin l → ℕ) : Type :=
  Fin (Fintype.card (SharedRecessionLiftRow (n := n) (p := p) mQ))

/-- Helper for Exercise 4.32: the direct shared-recession lift uses one finite auxiliary type
after reindexing the copied mixed variables by `Fin`. -/
private abbrev sharedRecessionLiftAuxFin
    (n p l : ℕ) : Type :=
  Fin (Fintype.card (SharedRecessionLiftAux n p l))

/-- Helper for Exercise 4.32: the visible integer block of the direct shared-recession lift after
reindexing rows by `Fin`. -/
private noncomputable def sharedRecessionLiftAintFin
    {n p l : ℕ} (mQ : Fin l → ℕ) :
    Matrix (sharedRecessionLiftRowFin (n := n) (p := p) mQ) (Fin n) ℚ :=
  (sharedRecessionLiftAint (n := n) (p := p) mQ).reindex
    (Fintype.equivFin _) (Equiv.refl _)

/-- Helper for Exercise 4.32: the visible real block of the direct shared-recession lift after
reindexing rows by `Fin`. -/
private noncomputable def sharedRecessionLiftArealFin
    {n p l : ℕ} (mQ : Fin l → ℕ) :
    Matrix (sharedRecessionLiftRowFin (n := n) (p := p) mQ) (Fin p) ℚ :=
  (sharedRecessionLiftAreal (n := n) (p := p) mQ).reindex
    (Fintype.equivFin _) (Equiv.refl _)

/-- Helper for Exercise 4.32: the copied auxiliary mixed block of the direct shared-recession
lift after reindexing rows and columns by `Fin`. -/
private noncomputable def sharedRecessionLiftAuxMatrixFin
    {n p l : ℕ}
    (mQ : Fin l → ℕ)
    (AintQ : ∀ i : Fin l, Matrix (Fin (mQ i)) (Fin n) ℚ)
    (ArealQ : ∀ i : Fin l, Matrix (Fin (mQ i)) (Fin p) ℚ) :
    Matrix (sharedRecessionLiftRowFin (n := n) (p := p) mQ)
      (sharedRecessionLiftAuxFin n p l) ℚ :=
  (sharedRecessionLiftAuxMatrix (n := n) (p := p) mQ AintQ ArealQ).reindex
    (Fintype.equivFin _) (Fintype.equivFin _)

/-- Helper for Exercise 4.32: the selector block of the direct shared-recession lift after
reindexing the row type by `Fin`. -/
private noncomputable def sharedRecessionLiftSelectorMatrixFin
    {n p l : ℕ}
    (mQ : Fin l → ℕ)
    (bQ : ∀ i : Fin l, Fin (mQ i) → ℚ) :
    Matrix (sharedRecessionLiftRowFin (n := n) (p := p) mQ) (Fin l) ℚ :=
  (sharedRecessionLiftSelectorMatrix (n := n) (p := p) mQ bQ).reindex
    (Fintype.equivFin _) (Equiv.refl _)

/-- Helper for Exercise 4.32: the direct shared-recession lift right-hand side after reindexing
the row family by `Fin`. -/
private noncomputable def sharedRecessionLiftRhsFin
    {n p l : ℕ}
    (mQ : Fin l → ℕ)
    (bQ : ∀ i : Fin l, Fin (mQ i) → ℚ) :
    sharedRecessionLiftRowFin (n := n) (p := p) mQ → ℚ :=
  sharedRecessionLiftRhs (n := n) (p := p) mQ bQ ∘ (Fintype.equivFin _).symm

/-- Helper for Exercise 4.32: the `Fin`-indexed direct shared-recession lift packages the same
mixed-binary projection as the abstract row and auxiliary families. -/
private noncomputable def sharedRecessionLiftProjectionFin
    {n p l : ℕ}
    (mQ : Fin l → ℕ)
    (AintQ : ∀ i : Fin l, Matrix (Fin (mQ i)) (Fin n) ℚ)
    (ArealQ : ∀ i : Fin l, Matrix (Fin (mQ i)) (Fin p) ℚ)
    (bQ : ∀ i : Fin l, Fin (mQ i) → ℚ) :
    Set (MixedRealPoint n p) :=
  mixed_binary_linear_projection
    (sharedRecessionLiftAintFin (n := n) (p := p) mQ)
    (sharedRecessionLiftArealFin (n := n) (p := p) mQ)
    (sharedRecessionLiftAuxMatrixFin (n := n) (p := p) (l := l) mQ AintQ ArealQ)
    (sharedRecessionLiftSelectorMatrixFin (n := n) (p := p) (l := l) mQ bQ)
    (sharedRecessionLiftRhsFin (n := n) (p := p) (l := l) mQ bQ)

/-- Helper for Exercise 4.32: the direct shared-recession lift has the same projection whether its
row and auxiliary types are kept abstract or reindexed by `Fin`. -/
private lemma mem_sharedRecessionLiftProjection_iff
    {n p l : ℕ}
    (mQ : Fin l → ℕ)
    (AintQ : ∀ i : Fin l, Matrix (Fin (mQ i)) (Fin n) ℚ)
    (ArealQ : ∀ i : Fin l, Matrix (Fin (mQ i)) (Fin p) ℚ)
    (bQ : ∀ i : Fin l, Fin (mQ i) → ℚ)
    {xy : MixedRealPoint n p} :
    xy ∈ sharedRecessionLiftProjectionFin
      (n := n) (p := p) (l := l) mQ AintQ ArealQ bQ ↔
      xy ∈ (ℤ^n×ℝ^p) ∧
        ∃ y : SharedRecessionLiftAux n p l → ℝ,
          ∃ z : Fin l → ℤ,
            is_zero_one_vector (fun j ↦ (z j : ℝ)) ∧
              sharedRecessionLiftRowsSatisfied
                (n := n) (p := p) (l := l) mQ AintQ ArealQ bQ xy y z := by
  -- Route correction: keep the shared-recession construction, but factor the reindex transport
  -- into one bridge lemma instead of re-elaborating it inside the closing theorem.
  simpa [sharedRecessionLiftProjectionFin, sharedRecessionLiftAintFin, sharedRecessionLiftArealFin,
    sharedRecessionLiftAuxMatrixFin, sharedRecessionLiftSelectorMatrixFin,
    sharedRecessionLiftRhsFin, sharedRecessionLiftRowsSatisfied] using
    (mem_mixed_binary_linear_projection_rowAux_reindex_iff
      (Aint := sharedRecessionLiftAint (n := n) (p := p) mQ)
      (Areal := sharedRecessionLiftAreal (n := n) (p := p) mQ)
      (B := sharedRecessionLiftAuxMatrix (n := n) (p := p) mQ AintQ ArealQ)
      (C := sharedRecessionLiftSelectorMatrix (n := n) (p := p) mQ bQ)
      (d := sharedRecessionLiftRhs (n := n) (p := p) mQ bQ)
      (xy := xy))

/-- Helper for Exercise 4.32: a point from one explicit mixed-integer component yields the direct
shared-recession lifted witness for the full finite union. -/
private lemma sharedRecessionLiftWitness_of_mem_component
    {n p l : ℕ}
    (mQ : Fin l → ℕ)
    (AintQ : ∀ i : Fin l, Matrix (Fin (mQ i)) (Fin n) ℚ)
    (ArealQ : ∀ i : Fin l, Matrix (Fin (mQ i)) (Fin p) ℚ)
    (bQ : ∀ i : Fin l, Fin (mQ i) → ℚ)
    {xy : MixedRealPoint n p}
    (hxy :
      xy ∈ ⋃ i : Fin l, mixed_integer_points (rational_mixed_polyhedron (AintQ i) (ArealQ i)
        (bQ i))) :
    xy ∈ sharedRecessionLiftProjectionFin
      (n := n) (p := p) (l := l) mQ AintQ ArealQ bQ := by
  rw [mem_sharedRecessionLiftProjection_iff
    (mQ := mQ) (AintQ := AintQ) (ArealQ := ArealQ) (bQ := bQ)]
  rw [Set.mem_iUnion] at hxy
  rcases hxy with ⟨j, hj⟩
  rcases (mem_mixed_integer_points_iff).1 hj with ⟨hxy_poly, hxy_int⟩
  let y : SharedRecessionLiftAux n p l → ℝ := fun a ↦
    match a with
    | Sum.inl ij => if ij.1 = j then xy.1 ij.2 else 0
    | Sum.inr ij => if ij.1 = j then xy.2 ij.2 else 0
  refine ⟨hxy_int, y, one_hot_integer_vector j, one_hot_integer_vector_is_zero_one_vector j, ?_⟩
  intro row
  cases row with
  | component i t =>
      by_cases hij : i = j
      · subst i
        have hrow_eq :
            (∑ j' : Fin n,
                (sharedRecessionLiftAint (n := n) (p := p) mQ
                  (SharedRecessionLiftRow.component (n := n) (p := p) j t) j' : ℝ) * xy.1 j') +
              (∑ j' : Fin p,
                (sharedRecessionLiftAreal (n := n) (p := p) mQ
                  (SharedRecessionLiftRow.component (n := n) (p := p) j t) j' : ℝ) * xy.2 j') +
              (∑ a : SharedRecessionLiftAux n p l,
                (sharedRecessionLiftAuxMatrix (n := n) (p := p) mQ AintQ ArealQ
                  (SharedRecessionLiftRow.component (n := n) (p := p) j t) a : ℝ) * y a) +
              (∑ j' : Fin l,
                (sharedRecessionLiftSelectorMatrix (n := n) (p := p) mQ bQ
                  (SharedRecessionLiftRow.component (n := n) (p := p) j t) j' : ℝ) *
                    (one_hot_integer_vector j j' : ℝ)) =
              ((((AintQ j).map (Rat.castHom ℝ)) *ᵥ (sharedRecessionLiftPart y j).1) +
                  (((ArealQ j).map (Rat.castHom ℝ)) *ᵥ (sharedRecessionLiftPart y j).2)) t -
                (one_hot_integer_vector j j : ℝ) * (bQ j t : ℝ) := by
          simpa [sharedRecessionLiftAint, sharedRecessionLiftAreal, sharedRecessionLiftRhs,
            dotProduct, Fintype.sum_sum_type, add_assoc] using
            (sharedRecessionLift_componentRow_eval
              (mQ := mQ) (AintQ := AintQ) (ArealQ := ArealQ) (bQ := bQ) (y := y)
              (z := one_hot_integer_vector j) (i := j) (t := t))
        rw [hrow_eq]
        have hyj :
            sharedRecessionLiftPart y j = xy := by
          apply Prod.ext
          · funext u
            simp [y, sharedRecessionLiftPart]
          · funext u
            simp [y, sharedRecessionLiftPart]
        have hrowj := (mem_rational_mixed_polyhedron_iff.mp hxy_poly) t
        simpa [hyj, one_hot_integer_vector, sharedRecessionLiftRhs]
          using hrowj
      · have hrow_eq :
            (∑ j' : Fin n,
                (sharedRecessionLiftAint (n := n) (p := p) mQ
                  (SharedRecessionLiftRow.component (n := n) (p := p) i t) j' : ℝ) * xy.1 j') +
              (∑ j' : Fin p,
                (sharedRecessionLiftAreal (n := n) (p := p) mQ
                  (SharedRecessionLiftRow.component (n := n) (p := p) i t) j' : ℝ) * xy.2 j') +
              (∑ a : SharedRecessionLiftAux n p l,
                (sharedRecessionLiftAuxMatrix (n := n) (p := p) mQ AintQ ArealQ
                  (SharedRecessionLiftRow.component (n := n) (p := p) i t) a : ℝ) * y a) +
              (∑ j' : Fin l,
                (sharedRecessionLiftSelectorMatrix (n := n) (p := p) mQ bQ
                  (SharedRecessionLiftRow.component (n := n) (p := p) i t) j' : ℝ) *
                    (one_hot_integer_vector j j' : ℝ)) =
              ((((AintQ i).map (Rat.castHom ℝ)) *ᵥ (sharedRecessionLiftPart y i).1) +
                  (((ArealQ i).map (Rat.castHom ℝ)) *ᵥ (sharedRecessionLiftPart y i).2)) t -
                (one_hot_integer_vector j i : ℝ) * (bQ i t : ℝ) := by
          simpa [sharedRecessionLiftAint, sharedRecessionLiftAreal, sharedRecessionLiftRhs,
            dotProduct, Fintype.sum_sum_type, add_assoc] using
            (sharedRecessionLift_componentRow_eval
              (mQ := mQ) (AintQ := AintQ) (ArealQ := ArealQ) (bQ := bQ) (y := y)
              (z := one_hot_integer_vector j) (i := i) (t := t))
        rw [hrow_eq]
        have hyi_zero :
            sharedRecessionLiftPart y i = 0 := by
          apply Prod.ext
          · funext u
            simp [y, sharedRecessionLiftPart, hij]
          · funext u
            simp [y, sharedRecessionLiftPart, hij]
        simpa [hyi_zero, one_hot_integer_vector, hij, sharedRecessionLiftRhs]
  | intEqLe u =>
      have hrow_eq :
          (∑ j' : Fin n,
              (sharedRecessionLiftAint (n := n) (p := p) mQ
                (SharedRecessionLiftRow.intEqLe (n := n) (p := p) u) j' : ℝ) * xy.1 j') +
            (∑ j' : Fin p,
              (sharedRecessionLiftAreal (n := n) (p := p) mQ
                (SharedRecessionLiftRow.intEqLe (n := n) (p := p) u) j' : ℝ) * xy.2 j') +
            (∑ a : SharedRecessionLiftAux n p l,
              (sharedRecessionLiftAuxMatrix (n := n) (p := p) mQ AintQ ArealQ
                (SharedRecessionLiftRow.intEqLe (n := n) (p := p) u) a : ℝ) * y a) +
            (∑ j' : Fin l,
              (sharedRecessionLiftSelectorMatrix (n := n) (p := p) mQ bQ
                (SharedRecessionLiftRow.intEqLe (n := n) (p := p) u) j' : ℝ) *
                  (one_hot_integer_vector j j' : ℝ)) =
            xy.1 u - ∑ i : Fin l, (sharedRecessionLiftPart y i).1 u := by
        simpa [sharedRecessionLiftAreal, sharedRecessionLiftSelectorMatrix, sharedRecessionLiftRhs,
          dotProduct, Fintype.sum_sum_type, add_assoc] using
          (sharedRecessionLift_intEqLe_row_eval
            (mQ := mQ) (AintQ := AintQ) (ArealQ := ArealQ) (xy := xy) (y := y) (u := u))
      rw [hrow_eq]
      have hsum :
          ∑ i : Fin l, (sharedRecessionLiftPart y i).1 u = xy.1 u := by
        rw [Finset.sum_eq_single j]
        · simp [y, sharedRecessionLiftPart]
        · intro i _ hij
          simp [y, sharedRecessionLiftPart, hij]
        · simp
      simpa [sharedRecessionLiftRhs, hsum]
  | intEqGe u =>
      have hrow_eq :
          (∑ j' : Fin n,
              (sharedRecessionLiftAint (n := n) (p := p) mQ
                (SharedRecessionLiftRow.intEqGe (n := n) (p := p) u) j' : ℝ) * xy.1 j') +
            (∑ j' : Fin p,
              (sharedRecessionLiftAreal (n := n) (p := p) mQ
                (SharedRecessionLiftRow.intEqGe (n := n) (p := p) u) j' : ℝ) * xy.2 j') +
            (∑ a : SharedRecessionLiftAux n p l,
              (sharedRecessionLiftAuxMatrix (n := n) (p := p) mQ AintQ ArealQ
                (SharedRecessionLiftRow.intEqGe (n := n) (p := p) u) a : ℝ) * y a) +
            (∑ j' : Fin l,
              (sharedRecessionLiftSelectorMatrix (n := n) (p := p) mQ bQ
                (SharedRecessionLiftRow.intEqGe (n := n) (p := p) u) j' : ℝ) *
                  (one_hot_integer_vector j j' : ℝ)) =
            -xy.1 u + ∑ i : Fin l, (sharedRecessionLiftPart y i).1 u := by
        simpa [sharedRecessionLiftAreal, sharedRecessionLiftSelectorMatrix, sharedRecessionLiftRhs,
          dotProduct, Fintype.sum_sum_type, add_assoc] using
          (sharedRecessionLift_intEqGe_row_eval
            (mQ := mQ) (AintQ := AintQ) (ArealQ := ArealQ) (xy := xy) (y := y) (u := u))
      rw [hrow_eq]
      have hsum :
          ∑ i : Fin l, (sharedRecessionLiftPart y i).1 u = xy.1 u := by
        rw [Finset.sum_eq_single j]
        · simp [y, sharedRecessionLiftPart]
        · intro i _ hij
          simp [y, sharedRecessionLiftPart, hij]
        · simp
      simpa [sharedRecessionLiftRhs, hsum]
  | realEqLe u =>
      have hrow_eq :
          (∑ j' : Fin n,
              (sharedRecessionLiftAint (n := n) (p := p) mQ
                (SharedRecessionLiftRow.realEqLe (n := n) (p := p) u) j' : ℝ) * xy.1 j') +
            (∑ j' : Fin p,
              (sharedRecessionLiftAreal (n := n) (p := p) mQ
                (SharedRecessionLiftRow.realEqLe (n := n) (p := p) u) j' : ℝ) * xy.2 j') +
            (∑ a : SharedRecessionLiftAux n p l,
              (sharedRecessionLiftAuxMatrix (n := n) (p := p) mQ AintQ ArealQ
                (SharedRecessionLiftRow.realEqLe (n := n) (p := p) u) a : ℝ) * y a) +
            (∑ j' : Fin l,
              (sharedRecessionLiftSelectorMatrix (n := n) (p := p) mQ bQ
                (SharedRecessionLiftRow.realEqLe (n := n) (p := p) u) j' : ℝ) *
                  (one_hot_integer_vector j j' : ℝ)) =
            xy.2 u - ∑ i : Fin l, (sharedRecessionLiftPart y i).2 u := by
        simpa [sharedRecessionLiftAint, sharedRecessionLiftSelectorMatrix, sharedRecessionLiftRhs,
          dotProduct, Fintype.sum_sum_type, add_assoc] using
          (sharedRecessionLift_realEqLe_row_eval
            (mQ := mQ) (AintQ := AintQ) (ArealQ := ArealQ) (xy := xy) (y := y) (u := u))
      rw [hrow_eq]
      have hsum :
          ∑ i : Fin l, (sharedRecessionLiftPart y i).2 u = xy.2 u := by
        rw [Finset.sum_eq_single j]
        · simp [y, sharedRecessionLiftPart]
        · intro i _ hij
          simp [y, sharedRecessionLiftPart, hij]
        · simp
      simpa [sharedRecessionLiftRhs, hsum]
  | realEqGe u =>
      have hrow_eq :
          (∑ j' : Fin n,
              (sharedRecessionLiftAint (n := n) (p := p) mQ
                (SharedRecessionLiftRow.realEqGe (n := n) (p := p) u) j' : ℝ) * xy.1 j') +
            (∑ j' : Fin p,
              (sharedRecessionLiftAreal (n := n) (p := p) mQ
                (SharedRecessionLiftRow.realEqGe (n := n) (p := p) u) j' : ℝ) * xy.2 j') +
            (∑ a : SharedRecessionLiftAux n p l,
              (sharedRecessionLiftAuxMatrix (n := n) (p := p) mQ AintQ ArealQ
                (SharedRecessionLiftRow.realEqGe (n := n) (p := p) u) a : ℝ) * y a) +
            (∑ j' : Fin l,
              (sharedRecessionLiftSelectorMatrix (n := n) (p := p) mQ bQ
                (SharedRecessionLiftRow.realEqGe (n := n) (p := p) u) j' : ℝ) *
                  (one_hot_integer_vector j j' : ℝ)) =
            -xy.2 u + ∑ i : Fin l, (sharedRecessionLiftPart y i).2 u := by
        simpa [sharedRecessionLiftAint, sharedRecessionLiftSelectorMatrix, sharedRecessionLiftRhs,
          dotProduct, Fintype.sum_sum_type, add_assoc] using
          (sharedRecessionLift_realEqGe_row_eval
            (mQ := mQ) (AintQ := AintQ) (ArealQ := ArealQ) (xy := xy) (y := y) (u := u))
      rw [hrow_eq]
      have hsum :
          ∑ i : Fin l, (sharedRecessionLiftPart y i).2 u = xy.2 u := by
        rw [Finset.sum_eq_single j]
        · simp [y, sharedRecessionLiftPart]
        · intro i _ hij
          simp [y, sharedRecessionLiftPart, hij]
        · simp
      simpa [sharedRecessionLiftRhs, hsum]
  | selectorUpper =>
      have hsum_real : ∑ i : Fin l, (one_hot_integer_vector j i : ℝ) = 1 := by
        exact_mod_cast sum_one_hot_integer_vector (j := j)
      simpa [sharedRecessionLiftAint, sharedRecessionLiftAreal, sharedRecessionLiftAuxMatrix,
        sharedRecessionLiftSelectorMatrix, sharedRecessionLiftRhs, dotProduct, add_assoc,
        add_left_comm, add_comm, hsum_real]
  | selectorLower =>
      have hsum_real : ∑ i : Fin l, (one_hot_integer_vector j i : ℝ) = 1 := by
        exact_mod_cast sum_one_hot_integer_vector (j := j)
      simpa [sharedRecessionLiftAint, sharedRecessionLiftAreal, sharedRecessionLiftAuxMatrix,
        sharedRecessionLiftSelectorMatrix, sharedRecessionLiftRhs, dotProduct, add_assoc,
        add_left_comm, add_comm, hsum_real]

/-- Helper for Exercise 4.32: any witness for the direct shared-recession lifted system recovers
membership in one explicit mixed-integer component of the finite union. -/
private lemma mem_iUnion_of_mem_sharedRecessionLiftWitness
    {n p l : ℕ}
    (mQ : Fin l → ℕ)
    (AintQ : ∀ i : Fin l, Matrix (Fin (mQ i)) (Fin n) ℚ)
    (ArealQ : ∀ i : Fin l, Matrix (Fin (mQ i)) (Fin p) ℚ)
    (bQ : ∀ i : Fin l, Fin (mQ i) → ℚ)
    (hQ_poly_nonempty :
      ∀ i : Fin l,
        Set.Nonempty (rational_mixed_polyhedron (AintQ i) (ArealQ i) (bQ i)))
    (hQ_recession :
      ∀ i j : Fin l,
        recessionCone (rational_mixed_polyhedron (AintQ i) (ArealQ i) (bQ i)) =
          recessionCone (rational_mixed_polyhedron (AintQ j) (ArealQ j) (bQ j)))
    {xy : MixedRealPoint n p}
    (hxy_int : xy ∈ (ℤ^n×ℝ^p))
    {y : SharedRecessionLiftAux n p l → ℝ}
    {z : Fin l → ℤ}
    (hz_binary : is_zero_one_vector (fun i ↦ (z i : ℝ)))
    (hineq : sharedRecessionLiftRowsSatisfied
      (n := n) (p := p) (l := l) mQ AintQ ArealQ bQ xy y z) :
    xy ∈ ⋃ i : Fin l, mixed_integer_points (rational_mixed_polyhedron (AintQ i) (ArealQ i)
      (bQ i)) := by
  obtain ⟨j, hj, _⟩ :=
    sharedRecessionLift_exists_activeSelector_of_rows
      (mQ := mQ) (AintQ := AintQ) (ArealQ := ArealQ) (bQ := bQ)
      hz_binary hineq
  -- The unique active selector identifies the component containing the visible mixed point.
  rw [Set.mem_iUnion]
  exact ⟨j,
    sharedRecessionLift_mem_mixedIntegerPoints_of_activeSelector
      (mQ := mQ) (AintQ := AintQ) (ArealQ := ArealQ) (bQ := bQ)
      (hQ_poly_nonempty := hQ_poly_nonempty) (hQ_recession := hQ_recession)
      hxy_int hz_binary hineq hj⟩

/-- Helper for Exercise 4.32: a nonempty finite family of rational mixed polyhedra with a common
recession cone is mixed-binary representable by the direct one-hot lifted system. -/
private theorem isMixedBinaryLinearRepresentable_iUnion_mixedIntegerPoints_of_sharedRecession
    {n p l : ℕ}
    (mQ : Fin l → ℕ)
    (AintQ : ∀ i : Fin l, Matrix (Fin (mQ i)) (Fin n) ℚ)
    (ArealQ : ∀ i : Fin l, Matrix (Fin (mQ i)) (Fin p) ℚ)
    (bQ : ∀ i : Fin l, Fin (mQ i) → ℚ)
    (hl_pos : 0 < l)
    (hQ_poly_nonempty :
      ∀ i : Fin l,
        Set.Nonempty (rational_mixed_polyhedron (AintQ i) (ArealQ i) (bQ i)))
    (hQ_recession :
      ∀ i j : Fin l,
        recessionCone (rational_mixed_polyhedron (AintQ i) (ArealQ i) (bQ i)) =
          recessionCone (rational_mixed_polyhedron (AintQ j) (ArealQ j) (bQ j))) :
    is_mixed_binary_linear_representable
      (⋃ i : Fin l, mixed_integer_points
        (rational_mixed_polyhedron (AintQ i) (ArealQ i) (bQ i))) := by
  have _ := hl_pos
  refine ⟨Fintype.card (SharedRecessionLiftRow (n := n) (p := p) mQ),
    Fintype.card (SharedRecessionLiftAux n p l), l,
    sharedRecessionLiftAintFin (n := n) (p := p) mQ,
    sharedRecessionLiftArealFin (n := n) (p := p) mQ,
    sharedRecessionLiftAuxMatrixFin (n := n) (p := p) (l := l) mQ AintQ ArealQ,
    sharedRecessionLiftSelectorMatrixFin (n := n) (p := p) (l := l) mQ bQ,
    sharedRecessionLiftRhsFin (n := n) (p := p) (l := l) mQ bQ, ?_⟩
  ext xy
  constructor
  · intro hxy
    -- Package the forward direction as one named shared-lift witness lemma.
    exact sharedRecessionLiftWitness_of_mem_component
      (mQ := mQ) (AintQ := AintQ) (ArealQ := ArealQ) (bQ := bQ) hxy
  · intro hxy
    -- Unpack the reindexed projection witness once, then recover the active component.
    have hxy' :=
      (mem_sharedRecessionLiftProjection_iff
        (mQ := mQ) (AintQ := AintQ) (ArealQ := ArealQ) (bQ := bQ) (xy := xy)).1 hxy
    rcases hxy' with ⟨hxy_int, y, z, hz_binary, hineq⟩
    exact mem_iUnion_of_mem_sharedRecessionLiftWitness
      (mQ := mQ) (AintQ := AintQ) (ArealQ := ArealQ) (bQ := bQ)
      (hQ_poly_nonempty := hQ_poly_nonempty) (hQ_recession := hQ_recession)
      hxy_int hz_binary hineq

/-- Helper for Exercise 4.32: the empty mixed set is mixed-binary linear representable via one
inconsistent rational inequality. -/
theorem empty_is_mixed_binary_linear_representable
    {n p : ℕ} :
    is_mixed_binary_linear_representable (∅ : Set (MixedRealPoint n p)) := by
  refine ⟨1, 0, 0,
    (0 : Matrix (Fin 1) (Fin n) ℚ),
    (0 : Matrix (Fin 1) (Fin p) ℚ),
    (0 : Matrix (Fin 1) (Fin 0) ℚ),
    (0 : Matrix (Fin 1) (Fin 0) ℚ),
    (fun _ : Fin 1 ↦ (-1 : ℚ)), ?_⟩
  ext xy
  constructor
  · intro hxy
    exact False.elim hxy
  · intro hxy
    rw [mem_mixed_binary_linear_projection_iff] at hxy
    rcases hxy with ⟨_, y, z, _, hineq⟩
    -- The unique inequality is `0 ≤ -1`, so the system is inconsistent.
    have hfalse : (0 : ℝ) ≤ (-1 : ℝ) := by
      simpa using hineq 0
    linarith

/-- Exercise 4.32. A nonempty set `S ⊆ ℤ^n × ℝ^p` is mixed binary linear representable if and
only if it is a finite union of mixed-integer linear sets having the same recession cone. -/
theorem mixed_binary_linear_representable_iff_finite_union_of_mixed_integer_linear_sets
    {n p : ℕ} (S : Set (MixedRealPoint n p))
    (hS_mixed : S ⊆ (ℤ^n×ℝ^p))
    (hS_nonempty : Set.Nonempty S) :
    is_mixed_binary_linear_representable S ↔
      ∃ k : ℕ,
        ∃ P : Fin k → Set (MixedRealPoint n p),
          (∀ i : Fin k, is_rational_mixed_polyhedron (P i)) ∧
          (∀ i : Fin k, Set.Nonempty (mixed_integer_points (P i))) ∧
              (S = ⋃ i : Fin k, mixed_integer_points (P i)) ∧
                ∀ i j : Fin k,
                  recessionCone (P i) =
                    recessionCone (P j) := by
  constructor
  · rintro ⟨r, m, q, Aint, Areal, B, C, d, rfl⟩
    obtain ⟨t, AprojInt, AprojReal, bproj, hbproj⟩ :=
      existsCommonAssignmentSlicePolyhedra Aint Areal B C d
    classical
    let k0 : ℕ := Fintype.card (Fin q → Bool)
    let e0 : (Fin q → Bool) ≃ Fin k0 := Fintype.equivFin (Fin q → Bool)
    let Q0 : Fin k0 → Set (MixedRealPoint n p) := fun i ↦
      rational_mixed_polyhedron AprojInt AprojReal (bproj (e0.symm i))
    have hUnionQ0 :
        mixed_binary_linear_projection Aint Areal B C d =
          ⋃ i : Fin k0, mixed_integer_points (Q0 i) := by
      ext xy
      constructor
      · intro hxy
        rw [mixed_binary_linear_projection_eq_iUnion_assignment_slices] at hxy
        rw [Set.mem_iUnion] at hxy
        rcases hxy with ⟨β, hβ⟩
        exact Set.mem_iUnion.2 ⟨e0 β, by simpa [Q0, hbproj β] using hβ⟩
      · intro hxy
        rw [mixed_binary_linear_projection_eq_iUnion_assignment_slices]
        rw [Set.mem_iUnion] at hxy
        rcases hxy with ⟨i, hi⟩
        exact Set.mem_iUnion.2 ⟨e0.symm i, by simpa [Q0, hbproj (e0.symm i)] using hi⟩
    have hUnion_nonempty :
        Set.Nonempty (⋃ i : Fin k0, mixed_integer_points (Q0 i)) := by
      simpa [hUnionQ0] using hS_nonempty
    obtain ⟨i0, hi0_nonempty⟩ :=
      exists_nonempty_component_of_nonempty_iUnion_mixed_integer_points hUnion_nonempty
    let P : Fin k0 → Set (MixedRealPoint n p) := fun i ↦
      if h : Set.Nonempty (mixed_integer_points (Q0 i)) then Q0 i else Q0 i0
    refine ⟨k0, P, ?_, ?_, ?_, ?_⟩
    · intro i
      by_cases hi : Set.Nonempty (mixed_integer_points (Q0 i))
      · simp [P, hi, Q0]
        exact rational_mixed_polyhedron_is_rational
          (A := AprojInt) (G := AprojReal) (b := bproj (e0.symm i))
      · simp [P, hi, Q0]
        exact rational_mixed_polyhedron_is_rational
          (A := AprojInt) (G := AprojReal) (b := bproj (e0.symm i0))
    · intro i
      dsimp [P]
      by_cases hi : Set.Nonempty (mixed_integer_points (Q0 i))
      · simpa [hi] using hi
      · simpa [hi] using hi0_nonempty
    · ext xy
      constructor
      · intro hxy
        rw [hUnionQ0] at hxy
        rw [Set.mem_iUnion] at hxy
        rcases hxy with ⟨i, hi⟩
        have hi_nonempty : Set.Nonempty (mixed_integer_points (Q0 i)) := ⟨xy, hi⟩
        rw [Set.mem_iUnion]
        exact ⟨i, by simpa [P, hi_nonempty] using hi⟩
      · intro hxy
        rw [Set.mem_iUnion] at hxy
        rcases hxy with ⟨i, hi⟩
        by_cases hi_nonempty : Set.Nonempty (mixed_integer_points (Q0 i))
        · rw [hUnionQ0]
          rw [Set.mem_iUnion]
          exact ⟨i, by simpa [P, hi_nonempty] using hi⟩
        · rw [hUnionQ0]
          rw [Set.mem_iUnion]
