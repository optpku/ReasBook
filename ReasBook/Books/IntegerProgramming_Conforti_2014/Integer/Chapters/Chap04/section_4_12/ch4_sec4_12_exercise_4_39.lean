import Mathlib
import IntegerProgramming_Conforti_2014.Integer.Chapters.Chap03.section_3_14.ch3_sec3_14_theorem_3_40
import IntegerProgramming_Conforti_2014.Integer.Chapters.Chap03.section_3_2.ch3_sec3_2_theorem_3_5

open scoped BigOperators Matrix

section Exercise439

namespace Exercise439Aux

namespace RationalFamily

/-- Helper for Exercise 4.39: a rational family is a Hilbert basis when every integral vector in
its rational cone is a nonnegative integral combination of family members. -/
def IsHilbertBasis {n : ℕ} {ι : Type*} (a : ι → Fin n → ℚ) : Prop :=
  ∀ z : Fin n → ℤ,
    (fun i ↦ (z i : ℚ)) ∈ (PointedCone.hull ℚ (Set.range a) : Set (Fin n → ℚ)) →
      ∃ u : ι →₀ ℕ,
        (fun i ↦ (z i : ℚ)) = u.sum (fun i c ↦ c • a i)

end RationalFamily

/-- Helper for Exercise 4.39: an integral family is a Hilbert basis when its canonical rational
realization is a rational Hilbert basis. -/
abbrev IsHilbertBasisFamily {n : ℕ} {ι : Type*} (a : ι → Fin n → ℤ) : Prop :=
  RationalFamily.IsHilbertBasis (fun i ↦ fun j ↦ (a i j : ℚ))

end Exercise439Aux

open Exercise439Aux

/-- The integer vector `(a, b)` in `ℤ²`. -/
def intPair (a b : ℤ) : Fin 2 → ℤ :=
  ![a, b]

/-- The two ray generators `(0, 1)` and `(k, 1)` of the cone in Exercise 4.39. -/
def exercise_4_39_generators (k : ℕ) : Fin 2 → Fin 2 → ℤ
  | 0 => intPair 0 1
  | 1 => intPair (k : ℤ) 1

/-- The cone in `ℝ²` generated by `(0, 1)` and `(k, 1)`. -/
abbrev exercise_4_39_cone (k : ℕ) : Set (Fin 2 → ℝ) :=
  PointedCone.hull ℝ (Set.range fun i ↦ fun j ↦ (exercise_4_39_generators k i j : ℝ))

/-- The candidate Hilbert-basis family `(i, 1)` for `i = 0, \ldots, k`. -/
def exercise_4_39_hilbert_basis_family (k : ℕ) : Fin (k + 1) → Fin 2 → ℤ :=
  fun i ↦ intPair (i : ℤ) 1

/-- A set `S ⊆ ℤⁿ` is a Hilbert-basis range of `C` when it is the range of a finite integral
Hilbert-basis family whose real cone is exactly `C`.

This is a bridge/view predicate from the family-level owner `IsHilbertBasisFamily` to the
set-level `Minimal` formulation used in Exercise 4.39. -/
def IsHilbertBasisRangeOf {n : ℕ}
    (C : Set (Fin n → ℝ)) (S : Set (Fin n → ℤ)) : Prop :=
  ∃ l : ℕ, ∃ a : Fin l → Fin n → ℤ,
    Set.range a = S ∧
      Exercise439Aux.IsHilbertBasisFamily a ∧
      (PointedCone.hull ℝ (Set.range fun i ↦ fun j ↦ (a i j : ℝ)) : Set (Fin n → ℝ)) = C

/-- Membership in the candidate Hilbert basis is exactly being one of the vectors `(i, 1)` with
`i = 0, ..., k`. -/
theorem mem_exercise_4_39_hilbert_basis_iff
    {k : ℕ} {x : Fin 2 → ℤ} :
    x ∈ Set.range (exercise_4_39_hilbert_basis_family k) ↔
      ∃ i : Fin (k + 1), x = intPair (i : ℤ) 1 := by
  constructor
  · rintro ⟨i, rfl⟩
    exact ⟨i, rfl⟩
  · rintro ⟨i, rfl⟩
    exact ⟨i, rfl⟩

/-- Helper for Exercise 4.39: when `k > 0`, the two ray generators are distinct. -/
lemma exercise_4_39_generators_ne {k : ℕ} (hk : 0 < k) :
    (fun i ↦ (exercise_4_39_generators k 0 i : ℝ)) ≠
      fun i ↦ (exercise_4_39_generators k 1 i : ℝ) := by
  -- Compare the first coordinates: the left ray has first coordinate `0`, the right ray has `k`.
  intro hEq
  have h0 : (0 : ℝ) = (k : ℝ) := by
    simpa [exercise_4_39_generators, intPair] using
      congrArg (fun f : Fin 2 → ℝ ↦ f 0) hEq
  have hk_ne : (k : ℝ) ≠ 0 := by
    exact_mod_cast (Nat.ne_of_gt hk)
  exact hk_ne h0.symm

/-- Helper for Exercise 4.39: a finitely supported conic combination supported on the two rays is
exactly a two-parameter conic combination when `k > 0`. -/
lemma exercise_4_39_finsupp_eq_two_single
    {k : ℕ}
    (hk : 0 < k)
    {c : (Fin 2 → ℝ) →₀ ℝ}
    (hc :
      ↑c.support ⊆
        Set.range (fun j : Fin 2 ↦ fun i ↦ (exercise_4_39_generators k j i : ℝ))) :
    c =
      Finsupp.single (fun i ↦ (exercise_4_39_generators k 0 i : ℝ))
          (c (fun i ↦ (exercise_4_39_generators k 0 i : ℝ))) +
        Finsupp.single (fun i ↦ (exercise_4_39_generators k 1 i : ℝ))
          (c (fun i ↦ (exercise_4_39_generators k 1 i : ℝ))) := by
  classical
  -- Route correction: the source proof only needs the two boundary-ray coefficients, so we
  -- compress the ambiently indexed `Finsupp` by support instead of reintroducing the old API.
  let g0 : Fin 2 → ℝ := fun i ↦ (exercise_4_39_generators k 0 i : ℝ)
  let g1 : Fin 2 → ℝ := fun i ↦ (exercise_4_39_generators k 1 i : ℝ)
  have hg : g0 ≠ g1 := exercise_4_39_generators_ne hk
  ext x
  by_cases hx0 : x = g0
  · -- At the first generator, only the first singleton survives.
    subst hx0
    simp [g0, g1, hg]
  by_cases hx1 : x = g1
  · -- At the second generator, only the second singleton survives.
    subst hx1
    simp [g0, g1, hg, eq_comm]
  -- Away from the two generators, the support condition forces the coefficient to vanish.
  have hx_support : x ∉ c.support := by
    intro hx_support
    rcases hc hx_support with ⟨j, rfl⟩
    fin_cases j
    · exact hx0 rfl
    · exact hx1 rfl
  have hcx : c x = 0 := Finsupp.notMem_support_iff.mp hx_support
  simp [g0, g1, hx0, hx1, hcx]

/-- Helper for Exercise 4.39: the `Finsupp.sum` of a singleton conic witness is the expected
single scalar multiple. -/
lemma exercise_4_39_finsupp_sum_single_smul
    (u : Fin 2 → ℝ) (a : ℝ) :
    (Finsupp.single u a).sum (fun y s ↦ s • y) = a • u := by
  -- A singleton witness contributes only its unique support point.
  classical
  by_cases ha : a = 0
  · simp [ha]
  · simpa [Finsupp.sum, ha]

/-- Helper for Exercise 4.39: two distinct singleton conic witnesses sum to the expected two-ray
expression. -/
lemma exercise_4_39_finsupp_sum_two_single_smul
    (u v : Fin 2 → ℝ) (a b : ℝ)
    (huv : u ≠ v) :
    (Finsupp.single u a + Finsupp.single v b).sum (fun y s ↦ s • y) =
      a • u + b • v := by
  -- Distinct singleton supports do not interact, so the sum splits termwise.
  classical
  rw [Finsupp.sum_add_index' (h_zero := fun y ↦ by simp)
      (h_add := fun y s t ↦ by simp [add_smul])]
  rw [exercise_4_39_finsupp_sum_single_smul, exercise_4_39_finsupp_sum_single_smul]

/-- Helper for Exercise 4.39: if a conic witness is supported on a single ray, then the whole
sum is one scalar multiple of that ray. -/
lemma exercise_4_39_sum_of_single_ray_support
    (u : Fin 2 → ℝ)
    {c : (Fin 2 → ℝ) →₀ ℝ}
    (hc : ↑c.support ⊆ ({u} : Set (Fin 2 → ℝ))) :
    c.sum (fun y s ↦ s • y) = (c.sum fun _ s ↦ s) • u := by
  -- Every supported term equals `u`, so the common ray factors out of the sum.
  classical
  calc
    c.sum (fun y s ↦ s • y) = c.sum (fun _ s ↦ s • u) := by
      rw [Finsupp.sum]
      refine Finset.sum_congr rfl ?_
      intro y hy
      have hyu : y = u := by simpa using hc hy
      simp [hyu]
    _ = (c.sum fun _ s ↦ s) • u := by
      simpa [Finsupp.sum] using
        (Finset.sum_smul (s := c.support) (f := fun y ↦ c y) (x := u)).symm

/-- Helper for Exercise 4.39: when `k > 0`, a conic witness supported on the two extreme rays
already has the source proof's explicit two-ray sum form. -/
lemma exercise_4_39_two_ray_sum_of_supported_finsupp
    {k : ℕ}
    (hk : 0 < k)
    {c : (Fin 2 → ℝ) →₀ ℝ}
    (hc :
      ↑c.support ⊆
        Set.range (fun j : Fin 2 ↦ fun i ↦ (exercise_4_39_generators k j i : ℝ))) :
    c.sum (fun y s ↦ s • y) =
      c (fun i ↦ (exercise_4_39_generators k 0 i : ℝ)) •
          (fun i ↦ (exercise_4_39_generators k 0 i : ℝ)) +
        c (fun i ↦ (exercise_4_39_generators k 1 i : ℝ)) •
          (fun i ↦ (exercise_4_39_generators k 1 i : ℝ)) := by
  -- Route correction: the source proof only needs the final two-ray sum identity, not ambient
  -- `Finsupp` equality on the witness itself.
  rw [exercise_4_39_finsupp_eq_two_single hk hc]
  simpa [exercise_4_39_generators_ne hk] using
    (exercise_4_39_finsupp_sum_two_single_smul _ _
      (c (fun i ↦ (exercise_4_39_generators k 0 i : ℝ)))
      (c (fun i ↦ (exercise_4_39_generators k 1 i : ℝ)))
      (exercise_4_39_generators_ne hk))

/-- Helper for Exercise 4.39: the cone is exactly the set of nonnegative conic combinations of the
two generators `(0, 1)` and `(k, 1)`. -/
lemma mem_exercise_4_39_cone_real_iff
    {k : ℕ} {x : Fin 2 → ℝ} :
    x ∈ exercise_4_39_cone k ↔
      ∃ α β : ℝ,
        0 ≤ α ∧
          0 ≤ β ∧
            x =
              α • (fun i ↦ (exercise_4_39_generators k 0 i : ℝ)) +
                β • (fun i ↦ (exercise_4_39_generators k 1 i : ℝ)) := by
  let g0 : Fin 2 → ℝ := fun i ↦ (exercise_4_39_generators k 0 i : ℝ)
  let g1 : Fin 2 → ℝ := fun i ↦ (exercise_4_39_generators k 1 i : ℝ)
  constructor
  · intro hx
    rcases PointedCone.mem_hull_set.mp hx with ⟨c, hc, hc_nonneg, rfl⟩
    by_cases h0 : k = 0
    · let α : ℝ := c.sum fun _ s ↦ s
      have hα_nonneg : 0 ≤ α := by
        -- The single-ray coefficient is a sum of nonnegative witness coefficients.
        dsimp [α]
        exact Finsupp.sum_nonneg' (fun y ↦ hc_nonneg y)
      have hc_single : ↑c.support ⊆ ({g0} : Set (Fin 2 → ℝ)) := by
        intro y hy
        rcases hc hy with ⟨j, hj⟩
        fin_cases j
        · simpa [g0] using hj.symm
        · simpa [g0, h0, exercise_4_39_generators, intPair] using hj.symm
      refine ⟨α, 0, hα_nonneg, le_rfl, ?_⟩
      -- In the degenerate branch `k = 0`, both generators lie on the same ray.
      have hsum_single :
          c.sum (fun y s ↦ s • y) =
            α • (fun i ↦ (exercise_4_39_generators k 0 i : ℝ)) := by
        simpa [α, g0] using exercise_4_39_sum_of_single_ray_support g0 hc_single
      have hsum_two :
          c.sum (fun y s ↦ s • y) =
            α • (fun i ↦ (exercise_4_39_generators k 0 i : ℝ)) +
              (0 : ℝ) • (fun i ↦ (exercise_4_39_generators k 1 i : ℝ)) := by
        simpa [zero_smul] using hsum_single
      exact hsum_two
    · have hk : 0 < k := Nat.pos_of_ne_zero h0
      refine ⟨c g0, c g1, hc_nonneg g0, hc_nonneg g1, ?_⟩
      -- The positive-`k` branch reduces directly to the two boundary-ray coefficients.
      simpa [g0, g1] using
        exercise_4_39_two_ray_sum_of_supported_finsupp hk hc
  · rintro ⟨α, β, hα, hβ, hx⟩
    by_cases h0 : k = 0
    · refine PointedCone.mem_hull_set.mpr ?_
      refine ⟨Finsupp.single g0 (α + β), ?_, ?_, ?_⟩
      · intro y hy
        by_cases hy0 : y = g0
        · exact ⟨0, hy0.symm⟩
        · exfalso
          exact (Finsupp.mem_support_iff.mp hy) (by simp [hy0])
      · intro y
        by_cases hy0 : y = g0
        · subst hy0
          simpa using add_nonneg hα hβ
        · simp [hy0]
      · -- In the degenerate branch, collapse the two-ray expression to the single ray `g0`.
        calc
          (Finsupp.single g0 (α + β)).sum (fun y s ↦ s • y) = (α + β) • g0 := by
            exact exercise_4_39_finsupp_sum_single_smul _ _
          _ = α • g0 + β • g1 := by
            rw [add_smul]
            congr 2
            ext i
            fin_cases i <;> simp [g0, g1, h0, exercise_4_39_generators, intPair]
          _ = x := hx.symm
    · have hk : 0 < k := Nat.pos_of_ne_zero h0
      have hg : g0 ≠ g1 := exercise_4_39_generators_ne hk
      refine PointedCone.mem_hull_set.mpr ?_
      refine ⟨Finsupp.single g0 α + Finsupp.single g1 β, ?_, ?_, ?_⟩
      · intro y hy
        by_cases hy0 : y = g0
        · exact ⟨0, hy0.symm⟩
        · by_cases hy1 : y = g1
          · exact ⟨1, hy1.symm⟩
          · exfalso
            exact (Finsupp.mem_support_iff.mp hy) (by simp [hy0, hy1])
      · intro y
        by_cases hy0 : y = g0
        · subst hy0
          simpa [g1, hg] using hα
        · by_cases hy1 : y = g1
          · subst hy1
            simpa [g0, hg] using hβ
          · simp [hy0, hy1]
      · -- The positive-`k` branch uses the explicit two-singleton witness.
        calc
          (Finsupp.single g0 α + Finsupp.single g1 β).sum (fun y s ↦ s • y) =
              α • g0 + β • g1 := by
                exact exercise_4_39_finsupp_sum_two_single_smul _ _ _ _ hg
          _ = x := hx.symm

/-- Helper for Exercise 4.39: an integer lattice point lies in the cone exactly when its second
coordinate is nonnegative and its first coordinate lies between `0` and `k` times the second. -/
lemma int_mem_exercise_4_39_cone_iff
    {k : ℕ} {x : Fin 2 → ℤ} :
    (fun i ↦ (x i : ℝ)) ∈ exercise_4_39_cone k ↔
      0 ≤ x 1 ∧ 0 ≤ x 0 ∧ x 0 ≤ (k : ℤ) * x 1 := by
  let g0 : Fin 2 → ℝ := fun i ↦ (exercise_4_39_generators k 0 i : ℝ)
  let g1 : Fin 2 → ℝ := fun i ↦ (exercise_4_39_generators k 1 i : ℝ)
  constructor
  · intro hx
    rcases mem_exercise_4_39_cone_real_iff.mp hx with ⟨α, β, hα, hβ, hx_eq⟩
    have hx1_eq : (x 1 : ℝ) = α + β := by
      -- The second coordinate records the total height `α + β`.
      simpa [g0, g1, exercise_4_39_generators, intPair] using
        congrArg (fun f : Fin 2 → ℝ ↦ f 1) hx_eq
    have hx0_eq : (x 0 : ℝ) = (k : ℝ) * β := by
      -- The first coordinate records the contribution from the right boundary ray.
      simpa [g0, g1, exercise_4_39_generators, intPair, mul_comm] using
        congrArg (fun f : Fin 2 → ℝ ↦ f 0) hx_eq
    have hx1_nonneg_real : 0 ≤ (x 1 : ℝ) := by
      nlinarith
    have hx0_nonneg_real : 0 ≤ (x 0 : ℝ) := by
      have hk_nonneg : 0 ≤ (k : ℝ) := by exact_mod_cast Nat.zero_le k
      nlinarith
    have hx0_le_real : (x 0 : ℝ) ≤ (k : ℝ) * (x 1 : ℝ) := by
      nlinarith
    refine ⟨?_, ?_, ?_⟩
    · exact_mod_cast hx1_nonneg_real
    · exact_mod_cast hx0_nonneg_real
    · exact_mod_cast hx0_le_real
  · rintro ⟨hx1_nonneg, hx0_nonneg, hx0_le⟩
    by_cases h0 : k = 0
    · have hx0_zero : x 0 = 0 := by
        have hx0_le_zero : x 0 ≤ 0 := by simpa [h0] using hx0_le
        omega
      refine mem_exercise_4_39_cone_real_iff.mpr ?_
      refine ⟨(x 1 : ℝ), 0, ?_, le_rfl, ?_⟩
      · exact_mod_cast hx1_nonneg
      · ext i
        fin_cases i
        · simp [g0, g1, h0, exercise_4_39_generators, intPair, hx0_zero]
        · simp [g0, g1, h0, exercise_4_39_generators, intPair]
    · have hk : 0 < k := Nat.pos_of_ne_zero h0
      have hkR : (0 : ℝ) < (k : ℝ) := by
        exact_mod_cast hk
      have hx1_nonneg_real : 0 ≤ (x 1 : ℝ) := by exact_mod_cast hx1_nonneg
      have hx0_nonneg_real : 0 ≤ (x 0 : ℝ) := by exact_mod_cast hx0_nonneg
      have hx0_le_real : (x 0 : ℝ) ≤ (k : ℝ) * (x 1 : ℝ) := by exact_mod_cast hx0_le
      let β : ℝ := (x 0 : ℝ) / (k : ℝ)
      let α : ℝ := (x 1 : ℝ) - β
      have hβ_nonneg : 0 ≤ β := by
        -- The right-ray coefficient is the normalized first coordinate.
        dsimp [β]
        exact div_nonneg hx0_nonneg_real (le_of_lt hkR)
      have hβ_le : β ≤ (x 1 : ℝ) := by
        -- The strip inequality becomes the bound `β ≤ x₁`.
        dsimp [β]
        rw [div_le_iff₀ hkR]
        simpa [mul_comm, mul_left_comm, mul_assoc] using hx0_le_real
      have hα_nonneg : 0 ≤ α := by
        -- The remaining height is the nonnegative coefficient on the left boundary ray.
        dsimp [α]
        linarith
      refine mem_exercise_4_39_cone_real_iff.mpr ⟨α, β, hα_nonneg, hβ_nonneg, ?_⟩
      ext i
      fin_cases i
      · have hkR_ne : (k : ℝ) ≠ 0 := ne_of_gt hkR
        have hβk : β * (k : ℝ) = (x 0 : ℝ) := by
          dsimp [β]
          field_simp [hkR_ne]
        simpa [g0, g1, exercise_4_39_generators, intPair, mul_comm, mul_left_comm, mul_assoc] using
          hβk.symm
      · dsimp [α]
        simp [g0, g1, exercise_4_39_generators, intPair, β]

/-- Helper for Exercise 4.39: every `a ≤ k b` can be written as a sum of `b` integers from
`{0, ..., k}`. -/
lemma exists_fin_sum_eq_of_le_mul
    (a b k : ℕ)
    (h : a ≤ k * b) :
    ∃ t : Fin b → Fin (k + 1), a = ∑ j, (t j : ℕ) := by
  induction b generalizing a with
  | zero =>
      have ha_zero : a = 0 := by omega
      subst ha_zero
      refine ⟨fun j ↦ Fin.elim0 j, ?_⟩
      simp
  | succ b ih =>
      by_cases hsmall : a ≤ k
      · refine ⟨Fin.cons ⟨a, by simpa using hsmall⟩ (fun _ ↦ 0), ?_⟩
        simp [Fin.sum_univ_succ]
      · have hk_lt_a : k < a := Nat.lt_of_not_ge hsmall
        have htail : a - k ≤ k * b := by
          rw [Nat.sub_le_iff_le_add]
          simpa [Nat.mul_add, Nat.mul_one, add_comm, add_left_comm, add_assoc] using h
        rcases ih (a - k) htail with ⟨t, ht⟩
        refine ⟨Fin.cons ⟨k, Nat.lt_succ_self k⟩ t, ?_⟩
        have hk_le_a : k ≤ a := Nat.le_of_lt hk_lt_a
        simpa [Fin.sum_univ_succ, ht, Nat.add_comm] using (Nat.sub_add_cancel hk_le_a).symm

/-- Helper for Exercise 4.39: every height-one candidate vector lies in the cone. -/
lemma basis_vector_mem_exercise_4_39_cone
    (k : ℕ) (i : Fin (k + 1)) :
    (fun j ↦ (exercise_4_39_hilbert_basis_family k i j : ℝ)) ∈ exercise_4_39_cone k := by
  -- The candidate vector `(i, 1)` satisfies the strip inequalities `0 ≤ i ≤ k`.
  refine int_mem_exercise_4_39_cone_iff.mpr ?_
  refine ⟨by simp [exercise_4_39_hilbert_basis_family, intPair], ?_, ?_⟩
  · simpa [exercise_4_39_hilbert_basis_family, intPair] using
      (show (0 : ℤ) ≤ (i : ℤ) by exact_mod_cast Nat.zero_le i)
  have hi_le : (i : ℤ) ≤ (k : ℤ) := by
    exact_mod_cast (Nat.le_of_lt_succ i.2)
  simpa [exercise_4_39_hilbert_basis_family, intPair] using hi_le

/-- Helper for Exercise 4.39: a finitely supported nonnegative combination of height-one
candidate generators stays inside the exercise cone. -/
lemma exercise_4_39_finsupp_sum_mem_cone_of_support
    {k : ℕ}
    {c : (Fin 2 → ℝ) →₀ ℝ}
    (hc :
      ↑c.support ⊆
        Set.range (fun i ↦ fun j ↦ (exercise_4_39_hilbert_basis_family k i j : ℝ)))
    (hc_nonneg : ∀ y, 0 ≤ c y) :
    c.sum (fun y s ↦ s • y) ∈ exercise_4_39_cone k := by
  let H : PointedCone ℝ (Fin 2 → ℝ) :=
    PointedCone.hull ℝ
      (Set.range fun i ↦ fun j ↦ (exercise_4_39_generators k i j : ℝ))
  -- Each supported summand is a nonnegative multiple of a height-one candidate vector, so the
  -- cone closure properties `smul_mem` and `sum_mem` give the full conic combination.
  have hterm :
      ∀ y ∈ c.support, c y • y ∈ (H : Set (Fin 2 → ℝ)) := by
    intro y hy
    rcases hc hy with ⟨i, rfl⟩
    have hi_mem : (fun j ↦ (exercise_4_39_hilbert_basis_family k i j : ℝ)) ∈ (H : Set (Fin 2 → ℝ)) := by
      simpa [H, exercise_4_39_cone] using basis_vector_mem_exercise_4_39_cone k i
    exact PointedCone.smul_mem H (hc_nonneg _) hi_mem
  simpa [H, exercise_4_39_cone] using
    (Submodule.sum_mem H (fun y hy ↦ hterm y hy))

/-- Helper for Exercise 4.39: the candidate height-one family generates the same real cone as the
two extreme rays. -/
lemma exercise_4_39_candidate_hull_eq_cone
    (k : ℕ) :
    (PointedCone.hull ℝ
        (Set.range fun i ↦ fun j ↦ (exercise_4_39_hilbert_basis_family k i j : ℝ)) :
      Set (Fin 2 → ℝ)) = exercise_4_39_cone k := by
  ext x
  constructor
  · intro hx
    rcases PointedCone.mem_hull_set.mp hx with ⟨c, hc, hc_nonneg, rfl⟩
    -- The forward inclusion is exactly the support-stable cone-closure helper above.
    exact exercise_4_39_finsupp_sum_mem_cone_of_support hc hc_nonneg
  · intro hx
    rcases mem_exercise_4_39_cone_real_iff.mp hx with ⟨α, β, hα, hβ, rfl⟩
    let H : PointedCone ℝ (Fin 2 → ℝ) :=
      PointedCone.hull ℝ
        (Set.range fun i ↦ fun j ↦ (exercise_4_39_hilbert_basis_family k i j : ℝ))
    have hleft :
        (fun j ↦ (exercise_4_39_generators k 0 j : ℝ)) ∈ (H : Set (Fin 2 → ℝ)) := by
      -- The left boundary ray is the candidate vector `(0, 1)`.
      exact PointedCone.subset_hull
        ⟨0, by
          ext j
          fin_cases j <;>
            simp [exercise_4_39_generators, exercise_4_39_hilbert_basis_family, intPair]⟩
    have hright :
        (fun j ↦ (exercise_4_39_generators k 1 j : ℝ)) ∈ (H : Set (Fin 2 → ℝ)) := by
      -- The right boundary ray is the candidate vector `(k, 1)`.
      exact PointedCone.subset_hull
        ⟨⟨k, Nat.lt_succ_self k⟩, by
          ext j
          fin_cases j <;>
            simp [exercise_4_39_generators, exercise_4_39_hilbert_basis_family, intPair]⟩
    have hleft_smul :
        α • (fun j ↦ (exercise_4_39_generators k 0 j : ℝ)) ∈ (H : Set (Fin 2 → ℝ)) :=
      PointedCone.smul_mem H hα hleft
    have hright_smul :
        β • (fun j ↦ (exercise_4_39_generators k 1 j : ℝ)) ∈ (H : Set (Fin 2 → ℝ)) :=
      PointedCone.smul_mem H hβ hright
    -- Adding the two boundary-ray contributions recovers the original cone point.
    exact add_mem hleft_smul hright_smul

/-- Helper for Exercise 4.39: coordinate projection commutes with a finitely supported sum of
rational vectors. -/
lemma rational_vector_finsupp_sum_coordinate
    {α : Type*}
    (c : α →₀ ℚ)
    (v : α → Fin 2 → ℚ)
    (j : Fin 2) :
    (c.sum (fun a q ↦ q • v a)) j = c.sum (fun a q ↦ q * v a j) := by
  -- Rewrite both `Finsupp.sum`s over the same support and then evaluate coordinatewise.
  classical
  rw [Finsupp.sum, Finsupp.sum]
  simp [smul_eq_mul]

/-- Helper for Exercise 4.39: projecting a candidate-family `Finsupp.sum` to one coordinate turns
the function-valued sum into an ordinary scalar sum. -/
lemma candidate_family_finsupp_sum_coordinate
    {k : ℕ}
    (u : Fin (k + 1) →₀ ℕ)
    (j : Fin 2) :
    (u.sum (fun i c ↦ c • fun t ↦ (exercise_4_39_hilbert_basis_family k i t : ℚ))) j =
      u.sum (fun i c ↦ (c : ℚ) * (exercise_4_39_hilbert_basis_family k i j : ℚ)) := by
  -- Project first, then each supported term becomes scalar multiplication in `ℚ`.
  classical
  rw [Finsupp.sum, Finsupp.sum]
  simp [smul_eq_mul]

/-- Helper for Exercise 4.39: the counted witness attached to `t : Fin b → Fin (k + 1)` records
the total height and first-coordinate sum of the chosen height-one generators. -/
lemma fiber_count_finsupp_coordinates_of_fin_sum
    {k b : ℕ}
    (t : Fin b → Fin (k + 1)) :
    let u : Fin (k + 1) →₀ ℕ :=
      Finsupp.equivFunOnFinite.symm
        (fun i ↦ (Finset.univ.filter fun j : Fin b ↦ t j = i).card)
    u.sum (fun _ c ↦ (c : ℚ)) = b ∧
      u.sum (fun i c ↦ (c : ℚ) * (i : ℚ)) = ∑ j : Fin b, (t j : ℚ) := by
  classical
  dsimp
  refine ⟨?_, ?_⟩
  · -- Summing the fiber cardinalities counts every `j : Fin b` exactly once.
    rw [Finsupp.sum_fintype _ _ (fun _ ↦ by simp)]
    calc
      ∑ i : Fin (k + 1), (((Finset.univ.filter fun j : Fin b ↦ t j = i).card : ℕ) : ℚ)
          = ∑ i : Fin (k + 1),
              Finset.sum (Finset.univ.filter (fun j : Fin b ↦ t j = i)) (fun _ ↦ (1 : ℚ)) := by
              refine Finset.sum_congr rfl ?_
              intro i hi
              simp
      _ = ∑ i : Fin (k + 1), (∑ j : Fin b, if t j = i then (1 : ℚ) else 0) := by
            refine Finset.sum_congr rfl ?_
            intro i hi
            simp
      _ = ∑ j : Fin b, ∑ i : Fin (k + 1), if t j = i then (1 : ℚ) else 0 := by
            rw [Finset.sum_comm]
      _ = ∑ _j : Fin b, (1 : ℚ) := by
            refine Finset.sum_congr rfl ?_
            intro j hj
            simp
      _ = b := by simp
  · -- Weighting each fiber cardinality by `i` recovers the original first-coordinate sum.
    rw [Finsupp.sum_fintype _ _ (fun _ ↦ by simp)]
    calc
      ∑ i : Fin (k + 1),
          (((Finset.univ.filter fun j : Fin b ↦ t j = i).card : ℕ) : ℚ) * (i : ℚ)
          = ∑ i : Fin (k + 1),
              Finset.sum (Finset.univ.filter (fun j : Fin b ↦ t j = i)) (fun _ ↦ (i : ℚ)) := by
              refine Finset.sum_congr rfl ?_
              intro i hi
              rw [Finset.sum_const, nsmul_eq_mul]
      _ = ∑ i : Fin (k + 1), (∑ j : Fin b, if t j = i then (i : ℚ) else 0) := by
            refine Finset.sum_congr rfl ?_
            intro i hi
            simpa using
              (show
                Finset.sum (Finset.univ.filter (fun j : Fin b ↦ t j = i)) (fun _ ↦ (i : ℚ)) =
                  ∑ j : Fin b, if t j = i then (i : ℚ) else 0 by
                rw [Finset.sum_filter])
      _ = ∑ j : Fin b, ∑ i : Fin (k + 1), if t j = i then (i : ℚ) else 0 := by
            rw [Finset.sum_comm]
      _ = ∑ j : Fin b, (t j : ℚ) := by
            refine Finset.sum_congr rfl ?_
            intro j hj
            simp

/-- Helper for Exercise 4.39: every lattice point in the strip `0 ≤ z₀ ≤ k z₁` decomposes as a
sum of the height-one candidate generators `(i, 1)`. -/
lemma candidate_finsupp_of_strip_lattice_point
    {k : ℕ}
    {z : Fin 2 → ℤ}
    (hz1_nonneg : 0 ≤ z 1)
    (hz0_nonneg : 0 ≤ z 0)
    (hz0_le : z 0 ≤ (k : ℤ) * z 1) :
    ∃ u : Fin (k + 1) →₀ ℕ,
      (fun j ↦ (z j : ℚ)) =
        u.sum (fun i c ↦ c • fun j ↦ (exercise_4_39_hilbert_basis_family k i j : ℚ)) := by
  -- Follow the source strip proof: decompose the first coordinate into `z₁` many integers in
  -- `{0, ..., k}`, then package those choices as a counted `Finsupp`.
  have hz_nat :
      Int.toNat (z 0) ≤ k * Int.toNat (z 1) := by
    have hz_nat_int :
        ((Int.toNat (z 0) : ℕ) : ℤ) ≤ (k : ℤ) * Int.toNat (z 1) := by
      simpa [Int.toNat_of_nonneg hz0_nonneg, Int.toNat_of_nonneg hz1_nonneg] using hz0_le
    exact_mod_cast hz_nat_int
  rcases exists_fin_sum_eq_of_le_mul (Int.toNat (z 0)) (Int.toNat (z 1)) k hz_nat with
    ⟨t, ht⟩
  let u : Fin (k + 1) →₀ ℕ :=
    Finsupp.equivFunOnFinite.symm
      (fun i ↦ (Finset.univ.filter fun j : Fin (Int.toNat (z 1)) ↦ t j = i).card)
  refine ⟨u, ?_⟩
  ext j
  fin_cases j
  · -- The first coordinate is the sum of the chosen integers `t j`.
    have hz0_cast : (Int.toNat (z 0) : ℚ) = (z 0 : ℚ) := by
      exact_mod_cast (Int.toNat_of_nonneg hz0_nonneg)
    have hfirst :=
      (fiber_count_finsupp_coordinates_of_fin_sum (k := k) (b := Int.toNat (z 1)) t).2
    calc
      (z 0 : ℚ) = (Int.toNat (z 0) : ℚ) := by simpa using hz0_cast.symm
      _ = ∑ j : Fin (Int.toNat (z 1)), (t j : ℚ) := by exact_mod_cast ht
      _ = u.sum (fun i c ↦ (c : ℚ) * (i : ℚ)) := by simpa [u] using hfirst.symm
      _ =
          (u.sum
            (fun i c ↦ c • fun j ↦ (exercise_4_39_hilbert_basis_family k i j : ℚ))) 0 := by
              rw [candidate_family_finsupp_sum_coordinate (u := u) (j := 0)]
              simp [exercise_4_39_hilbert_basis_family, intPair]
  · -- The second coordinate is the total number `z₁` of chosen height-one generators.
    have hz1_cast : (Int.toNat (z 1) : ℚ) = (z 1 : ℚ) := by
      exact_mod_cast (Int.toNat_of_nonneg hz1_nonneg)
    have hsecond :=
      (fiber_count_finsupp_coordinates_of_fin_sum (k := k) (b := Int.toNat (z 1)) t).1
    calc
      (z 1 : ℚ) = (Int.toNat (z 1) : ℚ) := by simpa using hz1_cast.symm
      _ = u.sum (fun _ c ↦ (c : ℚ)) := by simpa [u] using hsecond.symm
      _ =
          (u.sum
            (fun i c ↦ c • fun j ↦ (exercise_4_39_hilbert_basis_family k i j : ℚ))) 1 := by
              rw [candidate_family_finsupp_sum_coordinate (u := u) (j := 1)]
              simp [exercise_4_39_hilbert_basis_family, intPair]

/-- Helper for Exercise 4.39: a rational hull witness supported on the candidate family forces the
integral target vector to satisfy the strip inequalities `0 ≤ z₀ ≤ k z₁`. -/
lemma exercise_4_39_strip_inequalities_of_candidate_hull_witness
    {k : ℕ}
    {c : (Fin 2 → ℚ) →₀ ℚ}
    {z : Fin 2 → ℤ}
    (hc_support :
      ↑c.support ⊆
        Set.range (fun i ↦ fun j ↦ (exercise_4_39_hilbert_basis_family k i j : ℚ)))
    (hc_nonneg : ∀ y, 0 ≤ c y)
    (hc_sum : c.sum (fun y q ↦ q • y) = fun j ↦ (z j : ℚ)) :
    0 ≤ z 1 ∧ 0 ≤ z 0 ∧ z 0 ≤ (k : ℤ) * z 1 := by
  have hsupp_second : ∀ {y : Fin 2 → ℚ}, y ∈ c.support → y 1 = 1 := by
    intro y hy
    rcases hc_support hy with ⟨i, rfl⟩
    simp [exercise_4_39_hilbert_basis_family, intPair]
  have hsupp_first_nonneg : ∀ {y : Fin 2 → ℚ}, y ∈ c.support → 0 ≤ y 0 := by
    intro y hy
    rcases hc_support hy with ⟨i, rfl⟩
    simpa [exercise_4_39_hilbert_basis_family, intPair] using
      (show (0 : ℚ) ≤ (i : ℚ) by exact_mod_cast Nat.zero_le i)
  have hsupp_first_le : ∀ {y : Fin 2 → ℚ}, y ∈ c.support → y 0 ≤ (k : ℚ) * y 1 := by
    intro y hy
    rcases hc_support hy with ⟨i, rfl⟩
    have hi_le : (i : ℚ) ≤ (k : ℚ) := by
      exact_mod_cast (Nat.le_of_lt_succ i.2)
    simpa [exercise_4_39_hilbert_basis_family, intPair] using hi_le
  have hz1_eq : c.sum (fun y q ↦ q * y 1) = (z 1 : ℚ) := by
    -- Project the vector-valued hull equation to the height coordinate.
    simpa [rational_vector_finsupp_sum_coordinate] using
      congrArg (fun f : Fin 2 → ℚ ↦ f 1) hc_sum
  have hz0_eq : c.sum (fun y q ↦ q * y 0) = (z 0 : ℚ) := by
    -- Project the same hull equation to the first coordinate.
    simpa [rational_vector_finsupp_sum_coordinate] using
      congrArg (fun f : Fin 2 → ℚ ↦ f 0) hc_sum
  have hz1_nonneg_q : 0 ≤ (z 1 : ℚ) := by
    -- Every support vector has second coordinate `1`, so the height is a sum of nonnegative
    -- coefficients.
    rw [← hz1_eq, Finsupp.sum]
    refine Finset.sum_nonneg ?_
    intro y hy
    have hy1_nonneg : 0 ≤ y 1 := by
      simpa [hsupp_second hy] using (show (0 : ℚ) ≤ 1 by norm_num)
    exact mul_nonneg (hc_nonneg y) hy1_nonneg
  have hz0_nonneg_q : 0 ≤ (z 0 : ℚ) := by
    -- Every support vector has nonnegative first coordinate, so the first coordinate sum is also
    -- nonnegative.
    rw [← hz0_eq, Finsupp.sum]
    refine Finset.sum_nonneg ?_
    intro y hy
    exact mul_nonneg (hc_nonneg y) (hsupp_first_nonneg hy)
  have hsum_le :
      c.sum (fun y q ↦ q * y 0) ≤ c.sum (fun y q ↦ q * ((k : ℚ) * y 1)) := by
    -- The source strip inequality holds termwise on each supported candidate vector.
    rw [Finsupp.sum, Finsupp.sum]
    refine Finset.sum_le_sum ?_
    intro y hy
    exact mul_le_mul_of_nonneg_left (hsupp_first_le hy) (hc_nonneg y)
  have hsum_factor :
      c.sum (fun y q ↦ q * ((k : ℚ) * y 1)) = (k : ℚ) * c.sum (fun y q ↦ q * y 1) := by
    -- Pull the constant factor `k` outside the support-indexed sum.
    rw [Finsupp.sum, Finsupp.sum, Finset.mul_sum]
    refine Finset.sum_congr rfl ?_
    intro y hy
    ring
  have hz0_le_q : (z 0 : ℚ) ≤ (k : ℚ) * (z 1 : ℚ) := by
    -- Compare the coordinate sums termwise and then factor out `k`.
    calc
      (z 0 : ℚ) = c.sum (fun y q ↦ q * y 0) := hz0_eq.symm
      _ ≤ c.sum (fun y q ↦ q * ((k : ℚ) * y 1)) := hsum_le
      _ = (k : ℚ) * c.sum (fun y q ↦ q * y 1) := hsum_factor
      _ = (k : ℚ) * (z 1 : ℚ) := by rw [hz1_eq]
  exact ⟨by exact_mod_cast hz1_nonneg_q, by exact_mod_cast hz0_nonneg_q,
    by exact_mod_cast hz0_le_q⟩

/-- Helper for Exercise 4.39: the candidate family is a Hilbert basis of the cone. -/
lemma exercise_4_39_is_hilbert_basis
    (k : ℕ) :
    Exercise439Aux.IsHilbertBasisFamily (exercise_4_39_hilbert_basis_family k) ∧
      (PointedCone.hull ℝ
          (Set.range fun i ↦ fun j ↦ (exercise_4_39_hilbert_basis_family k i j : ℝ)) :
        Set (Fin 2 → ℝ)) = exercise_4_39_cone k := by
  constructor
  · intro z hz
    rcases PointedCone.mem_hull_set.mp hz with ⟨c, hc_support, hc_nonneg, hc_sum⟩
    -- Route correction: the source proof first extracts the strip inequalities from the rational
    -- hull witness and only then packages the counted decomposition.
    have hz_strip :=
      exercise_4_39_strip_inequalities_of_candidate_hull_witness hc_support hc_nonneg hc_sum
    exact candidate_finsupp_of_strip_lattice_point hz_strip.1 hz_strip.2.1 hz_strip.2.2
  · -- The geometric half is already isolated in `exercise_4_39_candidate_hull_eq_cone`.
    exact exercise_4_39_candidate_hull_eq_cone k

/-- Helper for Exercise 4.39: every element of a Hilbert-basis family of this cone lies in the
cone. -/
lemma mem_cone_of_mem_range_of_hilbert_basis
    {k l : ℕ}
    {a : Fin l → Fin 2 → ℤ}
    (ha : Exercise439Aux.IsHilbertBasisFamily a ∧
      (PointedCone.hull ℝ (Set.range fun i ↦ fun j ↦ (a i j : ℝ)) : Set (Fin 2 → ℝ)) =
        exercise_4_39_cone k)
    {y : Fin 2 → ℤ}
    (hy : y ∈ Set.range a) :
    (fun i ↦ (y i : ℝ)) ∈ exercise_4_39_cone k := by
  -- A generator from the family lies in its real hull, which is identified with the exercise cone.
  rcases hy with ⟨i, rfl⟩
  have hi_mem :
      (fun j ↦ (a i j : ℝ)) ∈
        (PointedCone.hull ℝ (Set.range fun i ↦ fun j ↦ (a i j : ℝ)) : Set (Fin 2 → ℝ)) := by
    exact PointedCone.subset_hull ⟨i, rfl⟩
  simpa [ha.2] using hi_mem

/-- Helper for Exercise 4.39: a cone lattice point of height `0` must be the zero vector. -/
lemma eq_zero_of_mem_exercise_4_39_cone_of_second_zero
    {k : ℕ}
    {y : Fin 2 → ℤ}
    (hy : (fun i ↦ (y i : ℝ)) ∈ exercise_4_39_cone k)
    (hy1 : y 1 = 0) :
    y = 0 := by
  rcases int_mem_exercise_4_39_cone_iff.mp hy with ⟨_, hy0_nonneg, hy0_le⟩
  ext i
  fin_cases i
  · have hy0_zero : y 0 = 0 := by
      have hy0_le_zero : y 0 ≤ 0 := by
        simpa [hy1] using hy0_le
      omega
    simp [hy0_zero]
  · simp [hy1]

/-- Helper for Exercise 4.39: a real nonnegative solution of a rational linear system can be
rationalized without changing feasibility. -/
lemma exists_rat_nonnegative_solution_of_real_cast_feasible
    {ι : Type*} [Fintype ι]
    (M : Matrix ι (Fin 2) ℚ)
    (d : Fin 2 → ℚ)
    (hreal :
      ∃ xR : ι → ℝ,
        (xR ᵥ* (M.map (Rat.castHom ℝ)) = fun j ↦ (d j : ℝ)) ∧ 0 ≤ xR) :
    ∃ xQ : ι → ℚ, xQ ᵥ* M = d ∧ 0 ≤ xQ := by
  rcases hreal with ⟨xR, hxR_row, hxR_nonneg⟩
  have hreal_transpose :
      ∃ xR : ι → ℝ,
        (M.transpose.map (Rat.castHom ℝ)) *ᵥ xR = (fun j ↦ (d j : ℝ)) ∧ 0 ≤ xR := by
    refine ⟨xR, ?_, hxR_nonneg⟩
    -- Rewrite the row-vector equation as the transpose-column system needed for Theorem 3.5.
    simpa [Matrix.transpose_map] using
      (Matrix.mulVec_transpose (M.map (Rat.castHom ℝ)) xR).trans hxR_row
  have hreal_multipliers :
      ∀ u : Fin 2 → ℝ,
        u ᵥ* (M.transpose.map (Rat.castHom ℝ)) ≤ 0 →
          u ⬝ᵥ (fun j ↦ (d j : ℝ)) ≤ 0 :=
    (feasible_nonnegative_linear_system_iff_nonpositive_row_multipliers
      (M.transpose.map (Rat.castHom ℝ))
      (fun j ↦ (d j : ℝ))).mp hreal_transpose
  have hrat_multipliers :
      ∀ u : Fin 2 → ℚ, u ᵥ* M.transpose ≤ 0 → u ⬝ᵥ d ≤ 0 := by
    intro u hu
    let uR : Fin 2 → ℝ := fun j ↦ (u j : ℝ)
    have huR :
        uR ᵥ* (M.transpose.map (Rat.castHom ℝ)) ≤ 0 := by
      intro i
      -- Cast the rational multiplier inequality componentwise to `ℝ`.
      have hi : (u ᵥ* M.transpose) i ≤ 0 := hu i
      have hiR : ((u ᵥ* M.transpose) i : ℝ) ≤ 0 := by
        exact_mod_cast hi
      simpa [uR, Matrix.vecMul, dotProduct] using hiR
    have huR_dot : uR ⬝ᵥ (fun j ↦ (d j : ℝ)) ≤ 0 := hreal_multipliers uR huR
    have hu_dot_cast : (((u ⬝ᵥ d : ℚ) : ℝ)) ≤ 0 := by
      simpa [uR, dotProduct] using huR_dot
    exact_mod_cast hu_dot_cast
  obtain ⟨xQ, hxQ, hxQ_nonneg⟩ :=
    (feasible_nonnegative_linear_system_iff_nonpositive_row_multipliers M.transpose d).mpr
      hrat_multipliers
  refine ⟨xQ, ?_, hxQ_nonneg⟩
  -- Return from the transpose-column system to the original row-vector equation.
  simpa [Matrix.mulVec_transpose] using hxQ

/-- Helper for Exercise 4.39: a finite nonnegative rational combination of family vectors lies in
their rational cone. -/
lemma mem_hull_of_equivFin_nonnegative_family
    {q : ℕ}
    (r : Fin q → Fin 2 → ℚ)
    (coeff : Fin q → ℚ)
    (v : Fin 2 → ℚ)
    (hcoeff_nonneg : ∀ k, 0 ≤ coeff k)
    (hv : v = ∑ k : Fin q, coeff k • r k) :
    v ∈
      (PointedCone.hull ℚ (Set.range r) : Set (Fin 2 → ℚ)) := by
  -- Package the given finite conic-combination data directly through `mem_hull_iff`.
  refine (mem_hull_iff).2 ?_
  refine ⟨q, r, ?_, coeff, hcoeff_nonneg, hv⟩
  intro k
  exact ⟨k, rfl⟩

/-- Helper for Exercise 4.39: an integral point of the real cone generated by a finite integral
family already lies in the corresponding rational cone. -/
lemma integral_point_mem_rational_hull_of_mem_real_hull
    {l : ℕ}
    {a : Fin l → Fin 2 → ℤ}
    {z : Fin 2 → ℤ}
    (hz :
      (fun j ↦ (z j : ℝ)) ∈
        (PointedCone.hull ℝ (Set.range fun i ↦ fun j ↦ (a i j : ℝ)) : Set (Fin 2 → ℝ))) :
    (fun j ↦ (z j : ℚ)) ∈
      (PointedCone.hull ℚ (Set.range fun i ↦ fun j ↦ (a i j : ℚ)) : Set (Fin 2 → ℚ)) := by
  classical
  rcases (mem_hull_iff.mp hz) with ⟨s, r, hr_mem, coeffR, hcoeffR_nonneg, hz_eq⟩
  let idx : Fin s → Fin l := fun m ↦ Classical.choose (hr_mem m)
  have hidx : ∀ m : Fin s, r m = fun j ↦ (a (idx m) j : ℝ) := by
    intro m
    exact (Classical.choose_spec (hr_mem m)).symm
  let M : Matrix (Fin s) (Fin 2) ℚ := fun m j ↦ a (idx m) j
  have hreal :
      ∃ xR : Fin s → ℝ,
        (xR ᵥ* (M.map (Rat.castHom ℝ)) = fun j ↦ (z j : ℝ)) ∧ 0 ≤ xR := by
    refine ⟨coeffR, ?_, hcoeffR_nonneg⟩
    -- Rewrite the real hull witness as the row-vector equation required by the rationalization
    -- lemma from Theorem 4.60.
    ext j
    calc
      (coeffR ᵥ* (M.map (Rat.castHom ℝ))) j
          = ∑ m : Fin s, coeffR m * (r m j) := by
              simp [M, Matrix.vecMul, dotProduct, hidx]
      _ = (∑ m : Fin s, coeffR m • r m) j := by
            simp [smul_eq_mul]
      _ = (fun j ↦ (z j : ℝ)) j := by
            simpa using congrArg (fun f : Fin 2 → ℝ ↦ f j) hz_eq.symm
  rcases
      exists_rat_nonnegative_solution_of_real_cast_feasible
        M (fun j ↦ (z j : ℚ)) hreal with
    ⟨coeffQ, hcoeffQ_row, hcoeffQ_nonneg⟩
  have hzQ_eq :
      (fun j ↦ (z j : ℚ)) =
        ∑ m : Fin s, coeffQ m • (fun j ↦ (a (idx m) j : ℚ)) := by
    -- The rationalized row equation is exactly a rational conic-combination witness.
    ext j
    calc
      (fun t ↦ (z t : ℚ)) j = (coeffQ ᵥ* M) j := by
        simpa using (congrFun hcoeffQ_row j).symm
      _ = (∑ m : Fin s, coeffQ m • (fun t ↦ (a (idx m) t : ℚ))) j := by
        simp [M, Matrix.vecMul, dotProduct, smul_eq_mul]
  have hmem_idx :
      (fun j ↦ (z j : ℚ)) ∈
        (PointedCone.hull ℚ (Set.range fun m : Fin s ↦ fun j ↦ (a (idx m) j : ℚ)) :
          Set (Fin 2 → ℚ)) := by
    -- Package the rational coefficients back into hull membership over the compressed support
    -- family.
    refine mem_hull_of_equivFin_nonnegative_family
      (fun m : Fin s ↦ fun j ↦ (a (idx m) j : ℚ))
      coeffQ (fun j ↦ (z j : ℚ)) hcoeffQ_nonneg ?_
    simpa using hzQ_eq
  have hsubset :
      Set.range (fun m : Fin s ↦ fun j ↦ (a (idx m) j : ℚ)) ⊆
        Set.range (fun i : Fin l ↦ fun j ↦ (a i j : ℚ)) := by
    rintro y ⟨m, rfl⟩
    exact ⟨idx m, rfl⟩
  -- Finally enlarge from the compressed support family back to the original family.
  exact (show
      (PointedCone.hull ℚ (Set.range fun m : Fin s ↦ fun j ↦ (a (idx m) j : ℚ)) :
        Set (Fin 2 → ℚ)) ⊆
        (PointedCone.hull ℚ (Set.range fun i : Fin l ↦ fun j ↦ (a i j : ℚ)) :
          Set (Fin 2 → ℚ)) from
      Submodule.span_mono hsubset) hmem_idx

/-- Helper for Exercise 4.39: a Hilbert-basis decomposition of a height-one vector `(i, 1)` must
already contain that vector as one of its generators. -/
lemma exists_generator_eq_basis_vector_of_hilbert_decomposition
    {k l : ℕ}
    {a : Fin l → Fin 2 → ℤ}
    (ha : Exercise439Aux.IsHilbertBasisFamily a ∧
      (PointedCone.hull ℝ (Set.range fun i ↦ fun j ↦ (a i j : ℝ)) : Set (Fin 2 → ℝ)) =
        exercise_4_39_cone k)
    {i : Fin (k + 1)}
    {u : Fin l →₀ ℕ}
    (hu :
      (fun j ↦ (exercise_4_39_hilbert_basis_family k i j : ℚ)) =
        u.sum (fun m c ↦ c • fun j ↦ (a m j : ℚ))) :
    ∃ m, a m = exercise_4_39_hilbert_basis_family k i := by
  classical
  let height : Fin l → ℕ := fun m ↦ Int.toNat (a m 1)
  have ha_second_nonneg : ∀ m : Fin l, 0 ≤ a m 1 := by
    intro m
    exact (int_mem_exercise_4_39_cone_iff.mp
      (mem_cone_of_mem_range_of_hilbert_basis ha ⟨m, rfl⟩)).1
  have hsecond_q :
      (1 : ℚ) = Finset.sum u.support (fun x ↦ (u x : ℚ) * (a x 1 : ℚ)) := by
    -- Project the decomposition to the height coordinate; this is the source proof's rank
    -- function.
    have hproj := congrArg (fun f : Fin 2 → ℚ ↦ f 1) hu
    simpa [exercise_4_39_hilbert_basis_family, intPair, Finsupp.sum] using hproj
  have hsecond_nat :
      u.sum (fun m c ↦ c * height m) = 1 := by
    have hcast :
        ((u.sum (fun m c ↦ c * height m) : ℕ) : ℚ) = (1 : ℚ) := by
      rw [Finsupp.sum, Nat.cast_sum, hsecond_q]
      have hsum_eq :
          Finset.sum u.support (fun x : Fin l ↦ ((u x * height x : ℕ) : ℚ)) =
            Finset.sum u.support (fun x : Fin l ↦ (u x : ℚ) * (a x 1 : ℚ)) := by
        refine Finset.sum_congr rfl ?_
        intro x hx
        calc
          ((u x * height x : ℕ) : ℚ) = (u x : ℚ) * ((height x : ℕ) : ℚ) := by
            rw [Nat.cast_mul]
          _ = (u x : ℚ) * (a x 1 : ℚ) := by
            have hheight_cast : ((height x : ℕ) : ℚ) = (a x 1 : ℚ) := by
              exact_mod_cast (Int.toNat_of_nonneg (ha_second_nonneg x))
            rw [hheight_cast]
      exact hsum_eq
    exact Nat.cast_injective (R := ℚ) hcast
  have hexists :
      ∃ m : Fin l, u m * height m ≠ 0 := by
    by_contra hnone
    push Not at hnone
    have hsum_zero : u.sum (fun m c ↦ c * height m) = 0 := by
      rw [Finsupp.sum]
      exact Finset.sum_eq_zero fun m hm ↦ hnone m
    omega
  rcases hexists with ⟨m, hm_ne_zero⟩
  have hm_le :
      u m * height m ≤ u.sum (fun n c ↦ c * height n) := by
    -- Each term is bounded above by the total height sum.
    simpa using
      (Finsupp.single_le_sum u
        (g := fun n c ↦ c * height n)
        (h := fun _ _ ↦ Nat.zero_le _) m)
  have hm_eq_one : u m * height m = 1 := by
    omega
  have hu_m : u m = 1 := by
    exact Nat.eq_one_of_dvd_one ⟨height m, hm_eq_one.symm⟩
  have hheight_m : height m = 1 := by
    exact Nat.eq_one_of_dvd_one ⟨u m, by simpa [Nat.mul_comm] using hm_eq_one.symm⟩
  have hm_second : a m 1 = 1 := by
    have hcast :
        ((height m : ℕ) : ℤ) = a m 1 := by
      simp [height, Int.toNat_of_nonneg (ha_second_nonneg m)]
    omega
  have hrest_zero :
      (u.erase m).sum (fun n c ↦ c * height n) = 0 := by
    have hsplit :
        (u.erase m).sum (fun n c ↦ c * height n) + u m * height m =
          u.sum (fun n c ↦ c * height n) := by
      -- Split the height sum into the distinguished generator and the remaining support.
      simpa [Finsupp.erase_eq_update_zero, add_comm, add_left_comm, add_assoc] using
        (Finsupp.sum_update_add u m 0
          (fun n c ↦ c * height n)
          (fun _ ↦ by simp)
          (fun n x y ↦ by simp [height, Nat.add_mul]))
    omega
  have hother_term_zero :
      ∀ n : Fin l, n ≠ m → u n * height n = 0 := by
    intro n hn
    have hn_le :
        (u.erase m) n * height n ≤ (u.erase m).sum (fun t c ↦ c * height t) := by
      simpa using
        (Finsupp.single_le_sum (u.erase m)
          (g := fun t c ↦ c * height t)
          (h := fun _ _ ↦ Nat.zero_le _) n)
    have hzero_erase : (u.erase m) n * height n = 0 := by
      rw [hrest_zero] at hn_le
      omega
    rw [Finsupp.erase_apply, if_neg hn] at hzero_erase
    exact hzero_erase
  have hzero_generator :
      ∀ n : Fin l, n ≠ m → u n ≠ 0 → a n = 0 := by
    intro n hn hun
    have hheight_zero : height n = 0 := by
      rcases Nat.mul_eq_zero.mp (hother_term_zero n hn) with hun_zero | hheight_zero
      · exact False.elim (hun hun_zero)
      · exact hheight_zero
    have hn_second : a n 1 = 0 := by
      have hcast :
          ((height n : ℕ) : ℤ) = a n 1 := by
        simp [height, Int.toNat_of_nonneg (ha_second_nonneg n)]
      omega
    exact eq_zero_of_mem_exercise_4_39_cone_of_second_zero
      (mem_cone_of_mem_range_of_hilbert_basis ha ⟨n, rfl⟩) hn_second
  have hfirst_q :
      (i : ℚ) = Finset.sum u.support (fun x ↦ (u x : ℚ) * (a x 0 : ℚ)) := by
    -- After the height analysis, we identify the remaining generator by its first coordinate.
    have hproj := congrArg (fun f : Fin 2 → ℚ ↦ f 0) hu
    simpa [exercise_4_39_hilbert_basis_family, intPair, Finsupp.sum] using hproj
  have hrest_first_zero :
      (u.erase m).sum (fun n c ↦ (c : ℚ) * (a n 0 : ℚ)) = 0 := by
    rw [Finsupp.sum]
    refine Finset.sum_eq_zero ?_
    intro n hn_support
    have hn : n ≠ m := by
      intro hnm
      subst hnm
      exact (Finsupp.mem_support_iff.mp hn_support) (by simp)
    have hun_erase : (u.erase m) n ≠ 0 := Finsupp.mem_support_iff.mp hn_support
    have hun : u n ≠ 0 := by
      rw [Finsupp.erase_apply, if_neg hn] at hun_erase
      exact hun_erase
    have hzero : a n = 0 := hzero_generator n hn hun
    rw [Finsupp.erase_apply, if_neg hn]
    simp [hzero]
  have hsplit_first :
      (u.erase m).sum (fun n c ↦ (c : ℚ) * (a n 0 : ℚ)) + (u m : ℚ) * (a m 0 : ℚ) =
        u.sum (fun n c ↦ (c : ℚ) * (a n 0 : ℚ)) := by
    -- Split the first-coordinate sum in the same way as the height sum.
    simpa [Finsupp.erase_eq_update_zero, add_comm, add_left_comm, add_assoc] using
      (Finsupp.sum_update_add u m 0
        (fun n c ↦ (c : ℚ) * (a n 0 : ℚ))
        (fun _ ↦ by simp)
        (fun n x y ↦ by simp [Nat.cast_add, add_mul]))
  have hm_first_q : (a m 0 : ℚ) = (i : ℚ) := by
    calc
      (a m 0 : ℚ) = (u m : ℚ) * (a m 0 : ℚ) := by simp [hu_m]
      _ = u.sum (fun n c ↦ (c : ℚ) * (a n 0 : ℚ)) := by
            rw [← hsplit_first, hrest_first_zero]
            simp
      _ = (i : ℚ) := by simpa [Finsupp.sum] using hfirst_q.symm
  have hm_first : a m 0 = i := by
    exact_mod_cast hm_first_q
  refine ⟨m, ?_⟩
  ext j
  fin_cases j
  · simpa [exercise_4_39_hilbert_basis_family, intPair] using hm_first
  · simpa [exercise_4_39_hilbert_basis_family, intPair] using hm_second

/-- Helper for Exercise 4.39: in any Hilbert-basis family of this cone, every candidate vector
`(i, 1)` already lies in the range. -/
lemma basis_vector_mem_range_of_hilbert_basis
    {k l : ℕ}
    {a : Fin l → Fin 2 → ℤ}
    (ha : Exercise439Aux.IsHilbertBasisFamily a ∧
      (PointedCone.hull ℝ (Set.range fun i ↦ fun j ↦ (a i j : ℝ)) : Set (Fin 2 → ℝ)) =
        exercise_4_39_cone k)
    (i : Fin (k + 1)) :
    exercise_4_39_hilbert_basis_family k i ∈ Set.range a := by
  have hbasis_real :
      (fun j ↦ (exercise_4_39_hilbert_basis_family k i j : ℝ)) ∈ exercise_4_39_cone k :=
    basis_vector_mem_exercise_4_39_cone k i
  have hbasis_rat :
      (fun j ↦ (exercise_4_39_hilbert_basis_family k i j : ℚ)) ∈
        (PointedCone.hull ℚ (Set.range fun m ↦ fun j ↦ (a m j : ℚ)) : Set (Fin 2 → ℚ)) := by
    -- Bridge the real cone membership of `(i, 1)` to the rational cone so that the Hilbert-basis
    -- decomposition hypothesis applies.
    exact integral_point_mem_rational_hull_of_mem_real_hull (a := a) (z := exercise_4_39_hilbert_basis_family k i) <| by
      simpa [ha.2] using hbasis_real
  rcases ha.1 (exercise_4_39_hilbert_basis_family k i) hbasis_rat with ⟨u, hu⟩
  -- The height-one decomposition can only use one nonzero generator, and that generator must be
  -- exactly `(i, 1)`.
  rcases exists_generator_eq_basis_vector_of_hilbert_decomposition ha hu with ⟨m, hm⟩
  exact ⟨m, hm⟩

/-- Helper for Exercise 4.39: every Hilbert-basis range for the cone already contains the
candidate range `{(i, 1) | 0 ≤ i ≤ k}`. -/
lemma candidate_range_subset_of_hilbert_basis_range
    {k : ℕ}
    {S : Set (Fin 2 → ℤ)}
    (hS : IsHilbertBasisRangeOf (exercise_4_39_cone k) S) :
    Set.range (exercise_4_39_hilbert_basis_family k) ⊆ S := by
  rintro x ⟨i, rfl⟩
  rcases hS with ⟨l, a, rfl, ha_family, ha_cone⟩
  -- Unpack the range witness and apply the universal containment lemma above.
  exact basis_vector_mem_range_of_hilbert_basis ⟨ha_family, ha_cone⟩ i

/-- Exercise 4.39. If `C ⊆ ℝ²` is the cone generated by `(0, 1)` and `(k, 1)`, then the unique
minimal Hilbert basis for `C` is the set `{(i, 1) | 0 ≤ i ≤ k}`, viewed as the unique
inclusion-minimal range of an integral Hilbert-basis family generating `C`. -/
theorem exercise_4_39_unique_minimal_hilbert_basis
    (k : ℕ) :
    let C := exercise_4_39_cone k
    let B := Set.range (exercise_4_39_hilbert_basis_family k)
    Minimal (IsHilbertBasisRangeOf C) B ∧
      ∀ ⦃l : ℕ⦄ (a : Fin l → Fin 2 → ℤ),
        Minimal (IsHilbertBasisRangeOf C) (Set.range a) →
          Set.range a = B := by
  dsimp
  have hB :
      IsHilbertBasisRangeOf
        (exercise_4_39_cone k) (Set.range (exercise_4_39_hilbert_basis_family k)) := by
    refine ⟨k + 1, exercise_4_39_hilbert_basis_family k, rfl, ?_, ?_⟩
    · exact (exercise_4_39_is_hilbert_basis k).1
    · exact (exercise_4_39_is_hilbert_basis k).2
  have hminimalB :
      Minimal
        (IsHilbertBasisRangeOf (exercise_4_39_cone k))
        (Set.range (exercise_4_39_hilbert_basis_family k)) := by
    -- Minimality reduces to the universal containment of the candidate range in every other
    -- Hilbert-basis range of the same cone.
    rw [minimal_subset_iff']
    refine ⟨hB, ?_⟩
    intro T hT hT_subset
    exact candidate_range_subset_of_hilbert_basis_range hT
  refine ⟨hminimalB, ?_⟩
  intro l a hminimalA
  have hA :
      IsHilbertBasisRangeOf (exercise_4_39_cone k) (Set.range a) :=
    (minimal_subset_iff'.mp hminimalA).1
  have hB_subset_A :
      Set.range (exercise_4_39_hilbert_basis_family k) ⊆ Set.range a :=
    candidate_range_subset_of_hilbert_basis_range hA
  have hA_subset_B :
      Set.range a ⊆ Set.range (exercise_4_39_hilbert_basis_family k) := by
    -- Apply minimality of `Set.range a` to the candidate range itself.
    exact (minimal_subset_iff'.mp hminimalA).2 hB hB_subset_A
  exact Set.Subset.antisymm hA_subset_B hB_subset_A

end Exercise439
