open Matrix SimpleGraph

universe u

variable {V : Type u}

/-- The spanning subgraph of `G` generated by an edge family `F : Set G.edgeSet`. -/
abbrev edgeFamilySubgraph (G : SimpleGraph V) (F : Set G.edgeSet) : G.Subgraph :=
  SimpleGraph.toSubgraph (SimpleGraph.fromEdgeSet (((↑) '' F : Set (Sym2 V)))) <| by
    intro v w hvw
    rw [SimpleGraph.fromEdgeSet_adj] at hvw
    rcases hvw.1 with ⟨e, heF, heq⟩
    exact G.mem_edgeSet.mp (heq.symm ▸ e.2)

/-- The incidence submatrix of `G` indexed by the support and chosen edges of the edge-family
subgraph determined by `F`. -/
def edgeFamilyIncidenceSubmatrix (G : SimpleGraph V) (R : Type*) [Finite V] [DecidableEq V]
    [DecidableRel G.Adj] [Zero R] [One R] (F : Set G.edgeSet) :
    Matrix ↥((edgeFamilySubgraph G F).support) ↥F R :=
  (G.edgeIncMatrix R).submatrix Subtype.val Subtype.val

section CycleAdjacency

variable {n : ℕ}

/-- Helper for Exercise 4.17: cycle-graph adjacency is exactly cyclic successor or predecessor. -/
lemma cycleGraph_adj_iff_finRotate (hcycle_len : 3 ≤ n) (i j : Fin n) :
    (cycleGraph n).Adj i j ↔ j = finRotate n i ∨ i = finRotate n j := by
  obtain ⟨m, rfl⟩ := Nat.exists_eq_add_of_le hcycle_len
  constructor
  · intro hij
    rw [SimpleGraph.cycleGraph_adj'] at hij
    rcases hij with hij | hij
    · right
      have hij' : i - j = (1 : Fin (3 + m)) := by
        apply Fin.ext
        simpa [Nat.mod_eq_of_lt (by omega : 1 < 3 + m)] using hij
      rw [sub_eq_iff_eq_add] at hij'
      simpa [add_comm] using hij'
    · left
      have hij' : j - i = (1 : Fin (3 + m)) := by
        apply Fin.ext
        simpa [Nat.mod_eq_of_lt (by omega : 1 < 3 + m)] using hij
      rw [sub_eq_iff_eq_add] at hij'
      simpa [add_comm] using hij'
  · rintro (rfl | rfl)
    · rw [SimpleGraph.cycleGraph_adj']
      right
      have hsub : finRotate (3 + m) i - i = (1 : Fin (3 + m)) := by
        rw [sub_eq_iff_eq_add]
        simp [add_comm, finRotate_apply]
      simpa [Nat.mod_eq_of_lt (by omega : 1 < 3 + m)] using congrArg Fin.val hsub
    · rw [SimpleGraph.cycleGraph_adj']
      left
      have hsub : finRotate (3 + m) j - j = (1 : Fin (3 + m)) := by
        rw [sub_eq_iff_eq_add]
        simp [add_comm, finRotate_apply]
      simpa [Nat.mod_eq_of_lt (by omega : 1 < 3 + m)] using congrArg Fin.val hsub

end CycleAdjacency

/-- A finite connected graph is of the form needed in Exercise 4.17 when it is either a tree or a
connected non-bipartite unicyclic graph, equivalently a tree with one extra edge closing an odd
cycle. -/
def tree_or_odd_unicyclic (H : SimpleGraph V) [Finite V] : Prop :=
  H.IsTree ∨ (H.Connected ∧ Nat.card H.edgeSet = Nat.card V ∧ ¬ H.IsBipartite)

/-- The edge families singled out in Exercise 4.17: each connected component of the edge-family
subgraph generated by `F` is either a tree or a connected odd-unicyclic graph. -/
def incidence_independent_edge_family (G : SimpleGraph V) [Finite V] (F : Set G.edgeSet) : Prop :=
  ∀ c : (edgeFamilySubgraph G F).spanningCoe.ConnectedComponent,
    tree_or_odd_unicyclic c.toSimpleGraph

/-- The edge set of the subgraph generated by an edge family is exactly the chosen family of
underlying edges. -/
lemma edgeFamilySubgraph_edgeSet (G : SimpleGraph V) (F : Set G.edgeSet) :
    (edgeFamilySubgraph G F).edgeSet = ((↑) '' F : Set (Sym2 V)) := by
  ext e
  induction e using Sym2.ind with
  | h v w =>
      constructor
      · intro he
        rw [Subgraph.mem_edgeSet] at he
        rw [edgeFamilySubgraph] at he
        change (SimpleGraph.fromEdgeSet (((↑) '' F : Set (Sym2 V)))).Adj v w at he
        rw [SimpleGraph.fromEdgeSet_adj] at he
        exact he.1
      · intro he
        rw [Subgraph.mem_edgeSet]
        rw [edgeFamilySubgraph]
        change (SimpleGraph.fromEdgeSet (((↑) '' F : Set (Sym2 V)))).Adj v w
        rw [SimpleGraph.fromEdgeSet_adj]
        refine ⟨he, ?_⟩
        have hs : s(v, w) ∈ G.edgeSet := by
          rcases he with ⟨e, -, heq⟩
          simpa [heq] using e.2
        exact G.ne_of_adj (G.mem_edgeSet.mp hs)

private lemma support_eq_verts_of_connected_not_isTree {G : SimpleGraph V} {H : G.Subgraph}
    (hconn : H.Connected) (hnotTree : ¬ H.coe.IsTree) :
    H.support = H.verts := by
  have hnotSubsingleton : ¬ Subsingleton H.verts := by
    intro hsub
    letI : Subsingleton H.verts := hsub
    obtain ⟨v, hv⟩ := hconn.nonempty
    letI : Nonempty H.verts := ⟨⟨v, hv⟩⟩
    exact hnotTree IsTree.of_subsingleton
  letI : Nontrivial H.verts := not_subsingleton_iff_nontrivial.mp hnotSubsingleton
  ext v
  constructor
  · intro hv
    exact H.support_subset_verts hv
  · intro hv
    obtain ⟨w, hvw⟩ := hconn.preconnected.exists_adj_of_nontrivial ⟨v, hv⟩
    exact (Subgraph.mem_support H).2 ⟨w, hvw⟩

/-- Helper for Exercise 4.17: evaluating the transpose of the signless incidence matrix on an edge
adds the values of the two incident vertices. -/
lemma edgeIncMatrix_transpose_mulVec_apply (G : SimpleGraph V) [Fintype V] [DecidableEq V]
    [DecidableRel G.Adj] (x : V → ℚ) (e : G.edgeSet) {v : V} (hv : v ∈ (e : Sym2 V)) :
    ((G.edgeIncMatrix ℚ)ᵀ *ᵥ x) e = x v + x (Sym2.Mem.other' hv) := by
  classical
  rcases Sym2.mem_iff_exists.mp hv with ⟨w, hw⟩
  have hvw : G.Adj v w := by
    exact G.mem_edgeSet.mp (by simpa [hw] using e.2)
  have hother : Sym2.Mem.other' hv = w := by
    have hs : s(v, Sym2.Mem.other' hv) = s(v, w) := by
      simpa [hw] using Sym2.other_spec' hv
    exact Sym2.congr_right.mp hs
  have hne : v ≠ w := G.ne_of_adj hvw
  -- Expanding the transpose-mulVec entry leaves exactly the two incident vertices of the edge.
  calc
    ((G.edgeIncMatrix ℚ)ᵀ *ᵥ x) e
      = x v + x w := by
          simp_rw [SimpleGraph.edgeIncMatrix, Matrix.mulVec, dotProduct, Matrix.transpose_apply,
            Matrix.submatrix_apply, SimpleGraph.incMatrix_apply', hw]
          let f : V → ℚ :=
            fun a : V ↦ (if s(v, w) ∈ G.incidenceSet a then (1 : ℚ) else 0) * x a
          change Finset.univ.sum
              f = x v + x w
          rw [← Finset.sum_erase_add (s := (Finset.univ : Finset V)) (a := v) (f := f)
            (Finset.mem_univ v)]
          rw [← Finset.sum_erase_add (s := Finset.univ.erase v) (a := w) (f := f)
            (by simpa [eq_comm] using hne)]
          let restSet : Finset V := (Finset.univ.erase v).erase w
          have hrest : restSet.sum f = 0 := by
            refine Finset.sum_eq_zero ?_
            intro a ha
            have haw : a ≠ w := Finset.ne_of_mem_erase ha
            have hav : a ≠ v := by
              exact Finset.ne_of_mem_erase (Finset.mem_of_mem_erase ha)
            have hnot : s(v, w) ∉ G.incidenceSet a := by
              intro hs
              rw [SimpleGraph.mk'_mem_incidenceSet_iff] at hs
              rcases hs.2 with rfl | rfl
              · exact hav rfl
              · exact haw rfl
            simp [hnot]
          have hv_term : f v = x v := by
            simp [f, SimpleGraph.mk'_mem_incidenceSet_iff, hvw]
          have hw_term : f w = x w := by
            simp [f, SimpleGraph.mk'_mem_incidenceSet_iff, hvw]
          rw [hv_term, hw_term, hrest]
          ring
    _ = x v + x (Sym2.Mem.other' hv) := by
          rw [← hother]

/-- Helper for Exercise 4.17: belonging to the transpose kernel is equivalent to satisfying the
edge relations `x_u + x_v = 0` on every edge of the graph. -/
lemma edgeIncMatrix_transpose_mulVec_eq_zero_iff_forall_adj (G : SimpleGraph V) [Fintype V]
    [DecidableEq V] [DecidableRel G.Adj] {x : V → ℚ} :
    (G.edgeIncMatrix ℚ)ᵀ *ᵥ x = 0 ↔ ∀ ⦃u v : V⦄, G.Adj u v → x u + x v = 0 := by
  constructor
  · intro hx u v huv
    let e : G.edgeSet := ⟨s(u, v), G.mem_edgeSet.mpr huv⟩
    have hu : u ∈ (e : Sym2 V) := by
      simp [e]
    have he : ((G.edgeIncMatrix ℚ)ᵀ *ᵥ x) e = 0 := by
      simpa [hx] using congrFun hx e
    have hother : Sym2.Mem.other' hu = v := by
      have hs : s(u, Sym2.Mem.other' hu) = s(u, v) := by
        simpa [e] using Sym2.other_spec' hu
      exact Sym2.congr_right.mp hs
    -- Evaluating at the edge `{u, v}` turns the kernel equation into `x u + x v = 0`.
    rw [edgeIncMatrix_transpose_mulVec_apply (G := G) x e hu] at he
    simpa [hother] using he
  · intro hx
    ext e
    rcases e with ⟨e, he⟩
    induction e using Sym2.ind with
    | h u v =>
        let e' : G.edgeSet := ⟨s(u, v), by simpa using he⟩
        have hu : u ∈ (e' : Sym2 V) := by
          simp [e']
        have hother : Sym2.Mem.other' hu = v := by
          have hs : s(u, Sym2.Mem.other' hu) = s(u, v) := by
            simpa [e'] using Sym2.other_spec' hu
          exact Sym2.congr_right.mp hs
        -- Route correction: instead of unfolding the whole kernel, reduce each coordinate to the
        -- single edge relation attached to that edge.
        rw [show (⟨s(u, v), by simpa using he⟩ : G.edgeSet) = e' by rfl]
        rw [edgeIncMatrix_transpose_mulVec_apply (G := G) x e' hu]
        simpa [hother] using hx (by simpa using he)

/-- Helper for Exercise 4.17: along a reachable path in a graph satisfying `x_u + x_v = 0` on each
edge, the endpoint value is either the start value or its negation. -/
lemma reachable_eq_or_neg_of_edge_sum_eq_zero {G : SimpleGraph V} {x : V → ℚ}
    (hx : ∀ ⦃u v : V⦄, G.Adj u v → x u + x v = 0) :
    ∀ ⦃u v : V⦄, G.Reachable u v → x v = x u ∨ x v = -x u := by
  intro u v huv
  rcases huv with ⟨p⟩
  -- Follow the source route: induct on a walk and alternate the sign at each traversed edge.
  induction p with
  | nil =>
      left
      rfl
  | @cons a b c hab p ih =>
      have hstep : x b = -x a := by
        linarith [hx hab]
      cases ih with
      | inl hbc =>
          right
          linarith
      | inr hbc =>
          left
          linarith

/-- Helper for Exercise 4.17: if a connected graph satisfies the edge relations `x_u + x_v = 0`
and the value at one vertex is zero, then the whole function is zero. -/
lemma Connected.eq_zero_of_edge_sum_eq_zero_of_vertex_eq_zero {G : SimpleGraph V}
    (hconn : G.Connected) {x : V → ℚ} (hx : ∀ ⦃u v : V⦄, G.Adj u v → x u + x v = 0) {v₀ : V}
    (hv₀ : x v₀ = 0) :
    x = 0 := by
  ext v
  -- Reachability from the base vertex reduces every value to either `x v₀` or `-x v₀`.
  have hsign :
      x v = x v₀ ∨ x v = -x v₀ :=
    reachable_eq_or_neg_of_edge_sum_eq_zero (G := G) hx (hconn v₀ v)
  cases hsign with
  | inl hv =>
      simp [hv, hv₀]
  | inr hv =>
      simp [hv, hv₀]

/-- Helper for Exercise 4.17: a nonzero solution of the edge relations on a connected graph
produces a two-coloring, so the graph must be bipartite. -/
lemma Connected.isBipartite_of_edge_sum_eq_zero_of_vertex_ne_zero {G : SimpleGraph V}
    (hconn : G.Connected) {x : V → ℚ} (hx : ∀ ⦃u v : V⦄, G.Adj u v → x u + x v = 0) {v₀ : V}
    (hv₀ : x v₀ ≠ 0) :
    G.IsBipartite := by
  let s : Set V := {v | x v = x v₀}
  let t : Set V := {v | x v = -x v₀}
  refine (SimpleGraph.isBipartite_iff_exists_isBipartiteWith (G := G)).2 ?_
  refine ⟨s, t, ?_⟩
  refine ⟨?_, ?_⟩
  · -- The `+` and `-` level sets are disjoint because `x v₀ ≠ 0`.
    rw [Set.disjoint_left]
    intro v hs ht
    simp only [s, t, Set.mem_setOf_eq] at hs ht
    have : x v₀ = 0 := by
      linarith
    exact hv₀ this
  · intro u v huv
    have hu :
        x u = x v₀ ∨ x u = -x v₀ :=
      reachable_eq_or_neg_of_edge_sum_eq_zero (G := G) hx (hconn v₀ u)
    have hv :
        x v = x v₀ ∨ x v = -x v₀ :=
      reachable_eq_or_neg_of_edge_sum_eq_zero (G := G) hx (hconn v₀ v)
    have hsum : x u + x v = 0 := hx huv
    cases hu with
    | inl hu_eq =>
        cases hv with
        | inl hv_eq =>
            have : x v₀ = 0 := by
              linarith
            exact False.elim (hv₀ this)
        | inr hv_eq =>
            left
            simp [s, t, hu_eq, hv_eq]
    | inr hu_eq =>
        cases hv with
        | inl hv_eq =>
            right
            simp [s, t, hu_eq, hv_eq]
        | inr hv_eq =>
            have : x v₀ = 0 := by
              linarith
            exact False.elim (hv₀ this)

/-- Helper for Exercise 4.17: on a connected non-bipartite graph, the only solution of the edge
relations `x_u + x_v = 0` is the zero function. -/
lemma Connected.eq_zero_of_not_isBipartite_of_edge_sum_eq_zero {G : SimpleGraph V}
    (hconn : G.Connected) (hnon : ¬ G.IsBipartite) {x : V → ℚ}
    (hx : ∀ ⦃u v : V⦄, G.Adj u v → x u + x v = 0) :
    x = 0 := by
  classical
  by_cases hzero : x = 0
  · exact hzero
  · have hx_nonzero : ∃ v₀, x v₀ ≠ 0 := by
      by_contra hnone
      push Not at hnone
      apply hzero
      ext v
      exact hnone v
    rcases hx_nonzero with ⟨v₀, hv₀⟩
    exact False.elim <|
      hnon (Connected.isBipartite_of_edge_sum_eq_zero_of_vertex_ne_zero hconn hx hv₀)

/-- Helper for Exercise 4.17: choose a two-coloring of a bipartite connected component. -/
noncomputable def bipartite_component_coloring {G : SimpleGraph V}
    (c : {c : G.ConnectedComponent // c.toSimpleGraph.IsBipartite}) :
    c.1.toSimpleGraph.Coloring (Fin 2) :=
  Classical.choice (show Nonempty (c.1.toSimpleGraph.Coloring (Fin 2)) from c.2)

/-- Helper for Exercise 4.17: the normalized sign vector attached to a bipartite connected
component, equal to `1` at the chosen representative vertex. -/
noncomputable def bipartite_component_signVector {G : SimpleGraph V}
    (c : {c : G.ConnectedComponent // c.toSimpleGraph.IsBipartite}) : V → ℚ :=
  letI : DecidablePred (fun v : V ↦ v ∈ c.1.supp) := Classical.decPred _
  fun v ↦
    if hv : v ∈ c.1.supp then
      if bipartite_component_coloring c ⟨v, hv⟩ =
          bipartite_component_coloring c ⟨c.1.out, c.1.out_eq⟩ then
        (1 : ℚ)
      else -1
    else 0

/-- Helper for Exercise 4.17: the normalized sign vector takes value `1` at the component's chosen
representative vertex. -/
lemma bipartite_component_signVector_out {G : SimpleGraph V}
    (c : {c : G.ConnectedComponent // c.toSimpleGraph.IsBipartite}) :
    bipartite_component_signVector c c.1.out = 1 := by
  classical
  have hout : c.1.out ∈ c.1.supp := c.1.out_eq
  rw [bipartite_component_signVector, dif_pos hout]
  have hcolor :
      bipartite_component_coloring c ⟨c.1.out, hout⟩ =
        bipartite_component_coloring c ⟨c.1.out, c.1.out_eq⟩ := by
    congr
  simp [hcolor]

/-- Helper for Exercise 4.17: the normalized sign vector vanishes away from its chosen connected
component. -/
lemma bipartite_component_signVector_eq_zero_of_not_mem {G : SimpleGraph V}
    (c : {c : G.ConnectedComponent // c.toSimpleGraph.IsBipartite}) {v : V}
    (hv : v ∉ c.1.supp) :
    bipartite_component_signVector c v = 0 := by
  -- Outside the component, the sign vector is defined to be zero.
  classical
  rw [bipartite_component_signVector, dif_neg hv]

/-- Helper for Exercise 4.17: evaluating a component sign vector at a representative vertex of a
different connected component gives zero. -/
lemma bipartite_component_signVector_out_eq_zero_of_ne {G : SimpleGraph V}
    (c d : {c : G.ConnectedComponent // c.toSimpleGraph.IsBipartite}) (hcd : c.1 ≠ d.1) :
    bipartite_component_signVector c d.1.out = 0 := by
  have hd_not_mem : d.1.out ∉ c.1.supp := by
    intro hd_mem
    exact hcd (ConnectedComponent.eq_of_common_vertex hd_mem d.1.out_eq)
  -- Distinct components have disjoint supports, so the representative of `d` is outside `c`.
  simpa using bipartite_component_signVector_eq_zero_of_not_mem c hd_not_mem

/-- Helper for Exercise 4.17: distinct `Fin 2` colors contribute opposite normalized signs. -/
lemma fin2_color_sign_add_eq_zero (a b c : Fin 2) (hab : a ≠ b) :
    (if a = c then (1 : ℚ) else -1) + (if b = c then 1 else -1) = 0 := by
  fin_cases a <;> fin_cases b <;> fin_cases c <;> simp at hab ⊢

/-- Helper for Exercise 4.17: the sign vector of a bipartite connected component satisfies the
edge relations `x_u + x_v = 0` on every edge of the ambient graph. -/
lemma bipartite_component_signVector_edge_sum_eq_zero {G : SimpleGraph V}
    (c : {c : G.ConnectedComponent // c.toSimpleGraph.IsBipartite}) :
    ∀ ⦃u v : V⦄, G.Adj u v →
      bipartite_component_signVector c u + bipartite_component_signVector c v = 0 := by
  intro u v huv
  by_cases hu : u ∈ c.1.supp
  · have hv : v ∈ c.1.supp := c.1.mem_supp_of_adj_mem_supp hu huv
    have huv' : c.1.toSimpleGraph.Adj ⟨u, hu⟩ ⟨v, hv⟩ :=
      (c.1.toSimpleGraph_adj hu hv).2 huv
    have hcolors :
        bipartite_component_coloring c ⟨u, hu⟩ ≠
          bipartite_component_coloring c ⟨v, hv⟩ :=
      (bipartite_component_coloring c).valid huv'
    -- Along an edge in the component, the two endpoint colors are distinct, so the normalized
    -- signs are opposite.
    classical
    rw [bipartite_component_signVector, dif_pos hu, bipartite_component_signVector, dif_pos hv]
    simpa using
      fin2_color_sign_add_eq_zero
        (bipartite_component_coloring c ⟨u, hu⟩)
        (bipartite_component_coloring c ⟨v, hv⟩)
        (bipartite_component_coloring c ⟨c.1.out, c.1.out_eq⟩)
        hcolors
  · have hv : v ∉ c.1.supp := by
      intro hv
      exact hu ((c.1.mem_supp_congr_adj huv).2 hv)
    -- If one endpoint were in the component then adjacency would force the other one in as well,
    -- so outside the component both values are zero.
    classical
    rw [bipartite_component_signVector, dif_neg hu, bipartite_component_signVector, dif_neg hv]
    ring

/-- Helper for Exercise 4.17: the normalized sign vector of a bipartite component lies in the
kernel of the transpose incidence map. -/
lemma mem_ker_toLin'_edgeIncMatrix_transpose_of_bipartite_component (G : SimpleGraph V)
    [Fintype V] [DecidableEq V] [DecidableRel G.Adj]
    (c : {c : G.ConnectedComponent // c.toSimpleGraph.IsBipartite}) :
    bipartite_component_signVector c ∈
      LinearMap.ker (Matrix.toLin' ((G.edgeIncMatrix ℚ)ᵀ)) := by
  -- The transpose-kernel description reduces membership to the edge equation already proved.
  rw [LinearMap.mem_ker, Matrix.toLin'_apply,
    edgeIncMatrix_transpose_mulVec_eq_zero_iff_forall_adj]
  exact bipartite_component_signVector_edge_sum_eq_zero c

/-- Helper for Exercise 4.17: the kernel vector attached to a bipartite connected component. -/
noncomputable def edgeIncMatrix_transpose_ker_basis_aux (G : SimpleGraph V) [Fintype V]
    [DecidableEq V] [DecidableRel G.Adj]
    (c : {c : G.ConnectedComponent // c.toSimpleGraph.IsBipartite}) :
    LinearMap.ker (Matrix.toLin' ((G.edgeIncMatrix ℚ)ᵀ)) :=
  ⟨bipartite_component_signVector c,
    mem_ker_toLin'_edgeIncMatrix_transpose_of_bipartite_component G c⟩

/-- Helper for Exercise 4.17: every kernel vector on a bipartite connected component is a scalar
multiple of the normalized component sign vector. -/
lemma eq_smul_bipartite_component_signVector_of_mem {G : SimpleGraph V}
    (c : {c : G.ConnectedComponent // c.toSimpleGraph.IsBipartite}) {x : V → ℚ}
    (hx : ∀ ⦃u v : V⦄, G.Adj u v → x u + x v = 0) {v : V} (hv : v ∈ c.1.supp) :
    x v = x c.1.out * bipartite_component_signVector c v := by
  let y : c.1.supp → ℚ := fun w ↦
    x w - x c.1.out * bipartite_component_signVector c w
  have hy_edges :
      ∀ ⦃u w : c.1.supp⦄, c.1.toSimpleGraph.Adj u w → y u + y w = 0 := by
    intro u w huw
    have huwG : G.Adj u w := (c.1.toSimpleGraph_adj u.property w.property).1 huw
    have hxuw : x u + x w = 0 := hx huwG
    have hsign :
        bipartite_component_signVector c u + bipartite_component_signVector c w = 0 :=
      bipartite_component_signVector_edge_sum_eq_zero (G := G) c huwG
    -- Normalize by subtracting the signed component basis vector, preserving the edge equation.
    calc
      y u + y w
        = (x u + x w) -
            x c.1.out *
              (bipartite_component_signVector c u + bipartite_component_signVector c w) := by
            dsimp [y]
            ring
      _ = 0 := by
            rw [hxuw, hsign]
            ring
  have hy_out : y ⟨c.1.out, c.1.out_eq⟩ = 0 := by
    -- The normalization was chosen so the representative vertex has value zero.
    simp [y, bipartite_component_signVector_out]
  have hy_zero :
      y = 0 :=
    Connected.eq_zero_of_edge_sum_eq_zero_of_vertex_eq_zero
      (G := c.1.toSimpleGraph) c.1.connected_toSimpleGraph hy_edges hy_out
  have hyv : y ⟨v, hv⟩ = 0 := by
    simpa using congrFun hy_zero ⟨v, hv⟩
  -- Evaluating the normalized zero function at `v` recovers the desired scalar multiple formula.
  dsimp [y] at hyv
  linarith

/-- Helper for Exercise 4.17: evaluating a finite linear combination of the bipartite-component
kernel vectors at the representative of `c₀` recovers the coefficient of `c₀`. -/
lemma component_representative_evaluation_isolates_coefficient (G : SimpleGraph V) [Fintype V]
    [DecidableEq V] [DecidableRel G.Adj]
    [Fintype {c : G.ConnectedComponent // c.toSimpleGraph.IsBipartite}]
    (g : {c : G.ConnectedComponent // c.toSimpleGraph.IsBipartite} → ℚ)
    (c₀ : {c : G.ConnectedComponent // c.toSimpleGraph.IsBipartite}) :
    ((∑ c, g c • edgeIncMatrix_transpose_ker_basis_aux (G := G) c :
        LinearMap.ker (Matrix.toLin' ((G.edgeIncMatrix ℚ)ᵀ))).1) c₀.1.out = g c₀ := by
  classical
  -- Only the `c₀` summand survives at the representative vertex `c₀.out`.
  rw [AddSubmonoid.coe_finsetSum]
  simp only [edgeIncMatrix_transpose_ker_basis_aux, SetLike.mk_smul_mk, Finset.sum_apply,
    Pi.smul_apply, smul_eq_mul]
  calc
    ∑ c, g c * bipartite_component_signVector c c₀.1.out
      = g c₀ * bipartite_component_signVector c₀ c₀.1.out := by
          refine Finset.sum_eq_single c₀ ?_ ?_
          · intro c hc hcne
            have hcomp_ne : c.1 ≠ c₀.1 := by
              intro hcc
              exact hcne (Subtype.ext hcc)
            have hzero :
                bipartite_component_signVector c c₀.1.out = 0 :=
              bipartite_component_signVector_out_eq_zero_of_ne c c₀ hcomp_ne
            simp [hzero]
          · intro hc₀
            exfalso
            exact hc₀ (Finset.mem_univ _)
    _ = g c₀ * 1 := by
          rw [bipartite_component_signVector_out]
    _ = g c₀ := by
          ring

/-- Helper for Exercise 4.17: on a bipartite connected component, a transpose-kernel vector is the
representative value times the normalized sign vector. -/
lemma kernel_vector_eq_component_scalar_mul_signVector (G : SimpleGraph V) [Fintype V]
    [DecidableEq V] [DecidableRel G.Adj]
    (x : LinearMap.ker (Matrix.toLin' ((G.edgeIncMatrix ℚ)ᵀ))) {v : V}
    (hbi : (G.connectedComponentMk v).toSimpleGraph.IsBipartite) :
    x.val v = x.val (G.connectedComponentMk v).out *
      bipartite_component_signVector ⟨G.connectedComponentMk v, hbi⟩ v := by
  let c : {c : G.ConnectedComponent // c.toSimpleGraph.IsBipartite} :=
    ⟨G.connectedComponentMk v, hbi⟩
  have hxker : (G.edgeIncMatrix ℚ)ᵀ *ᵥ x.val = 0 := by
    exact x.2
  have hx :
      ∀ ⦃u w : V⦄, G.Adj u w → x.1 u + x.1 w = 0 :=
    (edgeIncMatrix_transpose_mulVec_eq_zero_iff_forall_adj (G := G)).1 hxker
  have hv_mem : v ∈ c.1.supp :=
    (ConnectedComponent.mem_supp_iff c.1 v).2 (by simp [c])
  -- The previously proved connected-component normalization lemma applies to the component of `v`.
  simpa [c] using
    eq_smul_bipartite_component_signVector_of_mem
      (G := G) c hx hv_mem

/-- Helper for Exercise 4.17: on a non-bipartite connected component, every transpose-kernel
vector vanishes identically. -/
lemma kernel_vector_eq_zero_of_nonbipartite_component (G : SimpleGraph V) [Fintype V]
    [DecidableEq V] [DecidableRel G.Adj]
    (x : LinearMap.ker (Matrix.toLin' ((G.edgeIncMatrix ℚ)ᵀ))) {v : V}
    (hbi : ¬ (G.connectedComponentMk v).toSimpleGraph.IsBipartite) :
    x.val v = 0 := by
  let c : G.ConnectedComponent := G.connectedComponentMk v
  have hxker : (G.edgeIncMatrix ℚ)ᵀ *ᵥ x.val = 0 := by
    exact x.2
  have hx :
      ∀ ⦃u w : V⦄, G.Adj u w → x.1 u + x.1 w = 0 :=
    (edgeIncMatrix_transpose_mulVec_eq_zero_iff_forall_adj (G := G)).1 hxker
  let y : c.supp → ℚ := fun w ↦ x.val w
  have hy :
      ∀ ⦃u w : c.supp⦄, c.toSimpleGraph.Adj u w → y u + y w = 0 := by
    intro u w huw
    exact hx ((c.toSimpleGraph_adj u.property w.property).1 huw)
  have hy_zero :
      y = 0 :=
    Connected.eq_zero_of_not_isBipartite_of_edge_sum_eq_zero
      (G := c.toSimpleGraph) c.connected_toSimpleGraph hbi hy
  have hv_mem : v ∈ c.supp :=
    (ConnectedComponent.mem_supp_iff c v).2 (by simp [c])
  -- Restricting to the connected component of `v` turns the global kernel vector into zero.
  simpa [y, c] using congrFun hy_zero ⟨v, hv_mem⟩

/-- Helper for Exercise 4.17: the component sign vectors are linearly independent in the transpose
kernel. -/
lemma linearIndependent_edgeIncMatrix_transpose_ker_basis_aux (G : SimpleGraph V) [Fintype V]
    [DecidableEq V] [DecidableRel G.Adj] :
    LinearIndependent ℚ (edgeIncMatrix_transpose_ker_basis_aux (G := G)) := by
  classical
  let _ : Fintype {c : G.ConnectedComponent // c.toSimpleGraph.IsBipartite} := Fintype.ofFinite _
  -- Evaluate a vanishing linear combination at each chosen representative to isolate coefficients.
  rw [Fintype.linearIndependent_iff]
  intro g hg
  rw [Subtype.ext_iff] at hg
  intro c₀
  have hEval : ((∑ c, g c • edgeIncMatrix_transpose_ker_basis_aux (G := G) c :
      LinearMap.ker (Matrix.toLin' ((G.edgeIncMatrix ℚ)ᵀ))).1) c₀.1.out = 0 := by
    simpa using congrFun hg c₀.1.out
  rw [component_representative_evaluation_isolates_coefficient (G := G) g c₀] at hEval
  exact hEval

/-- Helper for Exercise 4.17: at a vertex in a bipartite connected component, the finite sum of
component sign vectors collapses to the unique summand indexed by that component. -/
lemma sum_component_signVector_eq_single_of_bipartite_component (G : SimpleGraph V) [Fintype V]
    [DecidableEq V] [DecidableRel G.Adj]
    [Fintype {c : G.ConnectedComponent // c.toSimpleGraph.IsBipartite}]
    (x : LinearMap.ker (Matrix.toLin' ((G.edgeIncMatrix ℚ)ᵀ))) {v : V}
    (hbi : (G.connectedComponentMk v).toSimpleGraph.IsBipartite) :
    (∑ d : {c : G.ConnectedComponent // c.toSimpleGraph.IsBipartite},
        x.val d.1.out * bipartite_component_signVector d v) =
      x.val (G.connectedComponentMk v).out *
        bipartite_component_signVector ⟨G.connectedComponentMk v, hbi⟩ v := by
  let c : G.ConnectedComponent := G.connectedComponentMk v
  have hv_mem : v ∈ c.supp :=
    (ConnectedComponent.mem_supp_iff c v).2 (by simp [c])
  let cb : {c : G.ConnectedComponent // c.toSimpleGraph.IsBipartite} := ⟨c, hbi⟩
  refine Finset.sum_eq_single cb ?_ ?_
  · intro d hd hdc
    have hcomp_ne : d.1 ≠ cb.1 := by
      intro hdc'
      exact hdc (Subtype.ext hdc')
    have hv_not_mem : v ∉ d.1.supp := by
      intro hvd
      exact hcomp_ne (ConnectedComponent.eq_of_common_vertex hvd hv_mem)
    have hzero : bipartite_component_signVector d v = 0 :=
      bipartite_component_signVector_eq_zero_of_not_mem d hv_not_mem
    simp [hzero]
  · intro hcb
    exfalso
    exact hcb (Finset.mem_univ _)

/-- Helper for Exercise 4.17: at a vertex in a non-bipartite connected component, every
bipartite-component sign vector vanishes. -/
lemma sum_component_signVector_eq_zero_of_nonbipartite_component (G : SimpleGraph V) [Fintype V]
    [DecidableEq V] [DecidableRel G.Adj]
    [Fintype {c : G.ConnectedComponent // c.toSimpleGraph.IsBipartite}]
    (x : LinearMap.ker (Matrix.toLin' ((G.edgeIncMatrix ℚ)ᵀ))) {v : V}
    (hbi : ¬ (G.connectedComponentMk v).toSimpleGraph.IsBipartite) :
    (∑ d : {c : G.ConnectedComponent // c.toSimpleGraph.IsBipartite},
        x.val d.1.out * bipartite_component_signVector d v) = 0 := by
  have hv_mem : v ∈ (G.connectedComponentMk v).supp :=
    (ConnectedComponent.mem_supp_iff (G.connectedComponentMk v) v).2 (by simp)
  refine Finset.sum_eq_zero ?_
  intro d hd
  rcases d with ⟨d, hd_bi⟩
  have hv_not_mem : v ∉ d.supp := by
    intro hvd
    have hdc : d = G.connectedComponentMk v := ConnectedComponent.eq_of_common_vertex hvd hv_mem
    cases hdc
    exact hbi hd_bi
  have hzero : bipartite_component_signVector ⟨d, hd_bi⟩ v = 0 :=
    bipartite_component_signVector_eq_zero_of_not_mem ⟨d, hd_bi⟩ hv_not_mem
  simp [hzero]

/-- Helper for Exercise 4.17: the component sign vectors span the whole transpose kernel. -/
lemma top_le_span_range_edgeIncMatrix_transpose_ker_basis_aux (G : SimpleGraph V) [Fintype V]
    [DecidableEq V] [DecidableRel G.Adj] :
    ⊤ ≤ Submodule.span ℚ (Set.range (edgeIncMatrix_transpose_ker_basis_aux (G := G))) := by
  classical
  let _ : Fintype {c : G.ConnectedComponent // c.toSimpleGraph.IsBipartite} := Fintype.ofFinite _
  intro x _
  have hxeq :
      (∑ c : {c : G.ConnectedComponent // c.toSimpleGraph.IsBipartite},
          x.val c.1.out • edgeIncMatrix_transpose_ker_basis_aux (G := G) c :
        LinearMap.ker (Matrix.toLin' ((G.edgeIncMatrix ℚ)ᵀ))) = x := by
    -- Evaluate at a vertex and collapse the sum to its own connected component.
    ext v
    rw [AddSubmonoid.coe_finsetSum]
    simp only [edgeIncMatrix_transpose_ker_basis_aux, SetLike.mk_smul_mk, Finset.sum_apply,
      Pi.smul_apply, smul_eq_mul]
    let c : G.ConnectedComponent := G.connectedComponentMk v
    by_cases hbi : c.toSimpleGraph.IsBipartite
    · rw [sum_component_signVector_eq_single_of_bipartite_component (G := G) x hbi]
      -- In the bipartite case, the remaining term is exactly the normalized component expansion.
      simpa [c] using
        (kernel_vector_eq_component_scalar_mul_signVector (G := G) x hbi).symm
    · have hsum_zero :
          (∑ d : {c : G.ConnectedComponent // c.toSimpleGraph.IsBipartite},
              x.val d.1.out * bipartite_component_signVector d v) = 0 :=
        sum_component_signVector_eq_zero_of_nonbipartite_component (G := G) x hbi
      rw [hsum_zero]
      -- In the non-bipartite case, the connected-component restriction is identically zero.
      exact (kernel_vector_eq_zero_of_nonbipartite_component (G := G) x hbi).symm
  rw [← hxeq]
  refine Submodule.sum_mem _ ?_
  intro c hc
  exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨c, rfl⟩)

/-- Helper for Exercise 4.17: a basis of the transpose-incidence kernel indexed by bipartite
connected components. -/
noncomputable def edgeIncMatrix_transpose_ker_basis (G : SimpleGraph V) [Fintype V]
    [DecidableEq V] [DecidableRel G.Adj] :
    Module.Basis {c : G.ConnectedComponent // c.toSimpleGraph.IsBipartite} ℚ
      (LinearMap.ker (Matrix.toLin' ((G.edgeIncMatrix ℚ)ᵀ))) :=
  Module.Basis.mk (linearIndependent_edgeIncMatrix_transpose_ker_basis_aux (G := G))
    (top_le_span_range_edgeIncMatrix_transpose_ker_basis_aux (G := G))

/-- Helper for Exercise 4.17: the transpose-incidence kernel has dimension equal to the number of
bipartite connected components. -/
theorem card_bipartite_components_eq_finrank_ker_edgeIncMatrix_transpose (G : SimpleGraph V)
    [Fintype V] [DecidableEq V] [DecidableRel G.Adj] :
    Nat.card {c : G.ConnectedComponent // c.toSimpleGraph.IsBipartite} =
      Module.finrank ℚ (Matrix.toLin' ((G.edgeIncMatrix ℚ)ᵀ)).ker := by
  classical
  let _ : Fintype {c : G.ConnectedComponent // c.toSimpleGraph.IsBipartite} := Fintype.ofFinite _
  -- The basis above identifies the kernel dimension with the number of bipartite components.
  rw [Nat.card_eq_fintype_card, Module.finrank_eq_card_basis
    (edgeIncMatrix_transpose_ker_basis (G := G))]

/-- Helper for Exercise 4.17: a finite matrix has linearly independent columns exactly when the
number of columns equals its rank. -/
lemma linearIndependent_cols_iff_card_eq_rank {R : Type*} [Field R] {m n : Type*} [Fintype n]
    (A : Matrix m n R) :
    LinearIndependent R A.col ↔ Fintype.card n = A.rank := by
  -- Rewrite linear independence of the column family into the standard `card = finrank(span)` form.
  rw [linearIndependent_iff_card_eq_finrank_span, Matrix.rank_eq_finrank_span_cols, Set.finrank]

/-- Helper for Exercise 4.17: the chosen edge family has the same cardinality as the edge set of
the spanning graph that it generates. -/
lemma edgeFamilySubgraph_card_edgeSet_eq_card_family (G : SimpleGraph V) (F : Set G.edgeSet) :
    Nat.card (edgeFamilySubgraph G F).edgeSet = Nat.card ↥F := by
  have hcoe_injective : Function.Injective ((↑) : G.edgeSet → Sym2 V) := Subtype.val_injective
  -- The edge family is carried injectively to the generated subgraph's underlying edge set.
  rw [edgeFamilySubgraph_edgeSet]
  simpa using Nat.card_image_of_injective hcoe_injective F

/-- Helper for Exercise 4.17: deleting rows that are identically zero outside a set does not
change the matrix rank. -/
lemma rank_eq_rank_submatrix_of_row_eq_zero_outside {K : Type*} [Field K] {m n : Type*}
    [Finite m] [Fintype n] (A : Matrix m n K) (S : Set m)
    (hzero : ∀ i, i ∉ S → A.row i = 0) :
    (A.submatrix (Subtype.val : ↥S → m) id).rank = A.rank := by
  have hspan_eq :
      Submodule.span K (Set.range (A.submatrix (Subtype.val : ↥S → m) id).row) =
        Submodule.span K (Set.range A.row) := by
    apply le_antisymm
    · refine Submodule.span_le.2 ?_
      rintro _ ⟨i, rfl⟩
      -- Every restricted row is literally one of the original rows.
      exact Submodule.subset_span ⟨i.1, by ext j; rfl⟩
    · refine Submodule.span_le.2 ?_
      rintro _ ⟨i, rfl⟩
      by_cases hi : i ∈ S
      · -- Rows indexed inside `S` reappear in the restricted matrix unchanged.
        exact Submodule.subset_span ⟨⟨i, hi⟩, by ext j; rfl⟩
      · -- Outside `S`, the hypothesis says the row is zero, which is already in every span.
        have hrow_zero : A.row i = 0 := hzero i hi
        simpa [hrow_zero] using
          (Submodule.zero_mem
            (Submodule.span K (Set.range (A.submatrix (Subtype.val : ↥S → m) id).row)))
  -- `Matrix.rank_eq_finrank_span_row` turns the rank comparison into the row-span equality above.
  rw [Matrix.rank_eq_finrank_span_row, Matrix.rank_eq_finrank_span_row, hspan_eq]

/-- Helper for Exercise 4.17: the chosen edge family is canonically equivalent to the edge set of
the spanning graph that it generates. -/
noncomputable def edgeFamilySubgraph_edgeEquiv (G : SimpleGraph V) (F : Set G.edgeSet) :
    ↥F ≃ ((edgeFamilySubgraph G F).spanningCoe.edgeSet) := by
  classical
  let hset : ((↑) '' F : Set (Sym2 V)) = (edgeFamilySubgraph G F).spanningCoe.edgeSet := by
    rw [Subgraph.edgeSet_spanningCoe, edgeFamilySubgraph_edgeSet]
  exact (Equiv.Set.image (↑) F Subtype.val_injective).trans (Equiv.setCongr hset)

/-- Helper for Exercise 4.17: the canonical edge equivalence preserves the underlying edge in
`Sym2 V`. -/
lemma edgeFamilySubgraph_edgeEquiv_apply_coe (G : SimpleGraph V) (F : Set G.edgeSet) (e : ↥F) :
    (((edgeFamilySubgraph_edgeEquiv G F) e :
        ((edgeFamilySubgraph G F).spanningCoe.edgeSet)) : Sym2 V) =
      ((e : G.edgeSet) : Sym2 V) :=
  by
    classical
    simp [edgeFamilySubgraph_edgeEquiv]

/-- Helper for Exercise 4.17: the edge-family incidence submatrix is exactly the support-row
restriction of the generated spanning graph's incidence matrix after reindexing the columns by the
canonical edge equivalence. -/
lemma edgeFamilyIncidenceSubmatrix_eq_spanningCoe_support_rows_reindex (G : SimpleGraph V)
    (R : Type*) [Finite V] [DecidableEq V] [DecidableRel G.Adj] [Zero R] [One R]
    (F : Set G.edgeSet) [DecidableRel ((edgeFamilySubgraph G F).spanningCoe).Adj] :
    edgeFamilyIncidenceSubmatrix G R F =
      (((edgeFamilySubgraph G F).spanningCoe.edgeIncMatrix R).submatrix
        (Subtype.val : ↥((edgeFamilySubgraph G F).support) → V)
        (edgeFamilySubgraph_edgeEquiv G F)) := by
  let H : SimpleGraph V := (edgeFamilySubgraph G F).spanningCoe
  ext i j
  -- Route correction: compare both sides entrywise after reducing to the same underlying
  -- vertex-edge pair and then rewrite incidence-set membership through endpoint membership.
  have hinc :
      ((j : G.edgeSet) : Sym2 V) ∈ G.incidenceSet i.1 ↔
        (((edgeFamilySubgraph_edgeEquiv G F) j : H.edgeSet) : Sym2 V) ∈ H.incidenceSet i.1 := by
    constructor
    · intro hj
      rw [H.edge_mem_incidenceSet_iff]
      exact (G.edge_mem_incidenceSet_iff).1 <| by simpa using hj
    · intro hj
      apply (G.edge_mem_incidenceSet_iff).2
      rw [H.edge_mem_incidenceSet_iff] at hj
      simpa [H, edgeFamilySubgraph_edgeEquiv_apply_coe] using hj
  simp [edgeFamilyIncidenceSubmatrix, H, SimpleGraph.edgeIncMatrix, Matrix.submatrix_apply,
    SimpleGraph.incMatrix_apply', hinc]

/-- Helper for Exercise 4.17: outside the support of the generated edge-family subgraph, every
row of the spanning graph's edge-incidence matrix is zero. -/
lemma spanningCoe_edgeIncMatrix_row_eq_zero_of_not_mem_support (G : SimpleGraph V) [Finite V]
    [Fintype V] [DecidableEq V] [DecidableRel G.Adj] (F : Set G.edgeSet)
    [DecidableRel ((edgeFamilySubgraph G F).spanningCoe).Adj] {v : V}
    (hv : v ∉ (edgeFamilySubgraph G F).support) :
    (((edgeFamilySubgraph G F).spanningCoe.edgeIncMatrix ℚ).row v) = 0 := by
  let H : SimpleGraph V := (edgeFamilySubgraph G F).spanningCoe
  ext e
  have hnot_mem_edge : v ∉ ((e : H.edgeSet) : Sym2 V) := by
    intro hve
    have heF :
        ((e : H.edgeSet) : Sym2 V) ∈ (edgeFamilySubgraph G F).edgeSet := by
      simpa [H] using e.2
    rcases Sym2.mem_iff_exists.mp hve with ⟨w, hw⟩
    have hvw : (edgeFamilySubgraph G F).Adj v w := by
      have hEdge_vw : s(v, w) ∈ (edgeFamilySubgraph G F).edgeSet := by
        simpa [hw] using heF
      rw [Subgraph.mem_edgeSet] at hEdge_vw
      exact hEdge_vw
    exact hv ((Subgraph.mem_support (edgeFamilySubgraph G F)).2 ⟨w, hvw⟩)
  have hnot_inc :
      ((e : H.edgeSet) : Sym2 V) ∉ H.incidenceSet v := by
    rw [H.edge_mem_incidenceSet_iff]
    exact hnot_mem_edge
  -- Outside the support, no chosen edge is incident to the vertex, so the whole row vanishes.
  simp [H, SimpleGraph.edgeIncMatrix, SimpleGraph.incMatrix_apply', hnot_inc]

/-- Helper for Exercise 4.17: the edge-family incidence matrix has the same rank as the incidence
matrix of the spanning graph generated by the chosen edges. -/
lemma edgeFamilyIncidenceSubmatrix_rank_eq_spanningCoe_rank (G : SimpleGraph V) [Finite V]
    [Fintype V] [DecidableEq V] [DecidableRel G.Adj] (F : Set G.edgeSet) [Fintype ↥F]
    [Fintype ((edgeFamilySubgraph G F).spanningCoe.edgeSet)]
    [DecidableRel ((edgeFamilySubgraph G F).spanningCoe).Adj] :
    (edgeFamilyIncidenceSubmatrix G ℚ F).rank =
      ((edgeFamilySubgraph G F).spanningCoe.edgeIncMatrix ℚ).rank := by
  let H : SimpleGraph V := (edgeFamilySubgraph G F).spanningCoe
  let τ : ↥F ≃ H.edgeSet := edgeFamilySubgraph_edgeEquiv G F
  let row : ↥((edgeFamilySubgraph G F).support) → V := Subtype.val
  -- First remove the column transport using the explicit `↥F ≃ H.edgeSet` equivalence.
  calc
    (edgeFamilyIncidenceSubmatrix G ℚ F).rank
      = (((H.edgeIncMatrix ℚ).submatrix row id).submatrix (Equiv.refl _) τ).rank := by
          rw [edgeFamilyIncidenceSubmatrix_eq_spanningCoe_support_rows_reindex (G := G)
            (R := ℚ) (F := F)]
          simp [H, row, τ, Matrix.submatrix_submatrix]
    _ = ((H.edgeIncMatrix ℚ).submatrix row id).rank := by
          simpa using Matrix.rank_submatrix ((H.edgeIncMatrix ℚ).submatrix row id)
            (Equiv.refl ↥((edgeFamilySubgraph G F).support)) τ
    _ = (H.edgeIncMatrix ℚ).rank := by
          -- Then delete the rows outside the support, which are identically zero.
          apply rank_eq_rank_submatrix_of_row_eq_zero_outside
          intro v hv
          simpa [Matrix.row] using
            spanningCoe_edgeIncMatrix_row_eq_zero_of_not_mem_support (G := G) (F := F) hv

/-- Helper for Exercise 4.17: vertices decompose as connected components together with a vertex in
that component. -/
noncomputable def verts_sigma_connectedComponent_equiv (H : SimpleGraph V) :
    V ≃ Σ c : H.ConnectedComponent, c.supp where
  toFun v := ⟨H.connectedComponentMk v, ⟨v, rfl⟩⟩
  invFun x := x.2.1
  left_inv v := rfl
  right_inv x := by
    rcases x with ⟨c, v, hv⟩
    -- The support witness records exactly the connected component of the underlying vertex.
    simp only [ConnectedComponent.mem_supp_iff] at hv
    cases hv
    rfl

/-- Helper for Exercise 4.17: the edge set cardinality splits as the sum of the edge sets of the
connected components. -/
lemma card_edgeSet_eq_sum_card_componentEdgeSet (H : SimpleGraph V) [Finite V]
    [Fintype H.ConnectedComponent] :
    Nat.card H.edgeSet = ∑ c : H.ConnectedComponent, Nat.card c.toSimpleGraph.edgeSet := by
  classical
  let edgeComponent : H.edgeSet → H.ConnectedComponent := fun e ↦
    H.connectedComponentMk e.1.out.1
  let edgeFiberEquiv :
      ∀ c : H.ConnectedComponent, {e : H.edgeSet // edgeComponent e = c} ≃ c.toSimpleGraph.edgeSet := by
    intro c
    refine
      { toFun := ?_
        invFun := ?_
        left_inv := ?_
        right_inv := ?_ }
    · intro e
      let e₀ : H.edgeSet := e.1
      let v : V := e₀.1.out.1
      let w : V := e₀.1.out.2
      have hvw : H.Adj v w := by
        exact H.mem_edgeSet.mp (by simpa [v, w, e₀.1.out_eq] using e₀.2)
      have hv : v ∈ c.supp := by
        exact (ConnectedComponent.mem_supp_iff c v).2 (by simpa [edgeComponent, e₀, v] using e.2)
      have hw : w ∈ c.supp := c.mem_supp_of_adj_mem_supp hv hvw
      exact ⟨s(⟨v, hv⟩, ⟨w, hw⟩), (c.toSimpleGraph_adj hv hw).2 hvw⟩
    · intro e
      let v : c.supp := e.1.out.1
      let w : c.supp := e.1.out.2
      have hvw : c.toSimpleGraph.Adj v w := by
        exact c.toSimpleGraph.mem_edgeSet.mp (by simpa [v, w, e.1.out_eq] using e.2)
      let q : Sym2 V := s(v.1, w.1)
      refine ⟨⟨q, (c.toSimpleGraph_adj v.2 w.2).1 hvw⟩, ?_⟩
      have hout_mem : q.out.1 ∈ q := by
        simpa using Sym2.out_fst_mem q
      have h_endpoint : q.out.1 = v.1 ∨ q.out.1 = w.1 := by
        simpa [q] using (Sym2.mem_iff.mp hout_mem)
      have hq : q.out.1 ∈ c.supp := by
        rcases h_endpoint with hqv | hqw
        · simpa [hqv] using v.2
        · simpa [hqw] using w.2
      exact (ConnectedComponent.mem_supp_iff c q.out.1).1 hq
    · intro e
      apply Subtype.ext
      apply Subtype.ext
      simpa using e.1.1.out_eq
    · intro e
      ext x
      rw [← e.1.out_eq]
      simp only [Sym2.mem_iff, or_comm]
  -- Route correction: only the cardinal decomposition is used later, so replace the old
  -- dependent sigma equivalence by fiberwise counting over the component map.
  calc
    Nat.card H.edgeSet =
        Nat.card (Σ c : H.ConnectedComponent, {e : H.edgeSet // edgeComponent e = c}) := by
          simpa [edgeComponent] using
            (Nat.card_congr (Equiv.sigmaFiberEquiv edgeComponent)).symm
    _ = ∑ c : H.ConnectedComponent, Nat.card {e : H.edgeSet // edgeComponent e = c} := by
          rw [Nat.card_sigma]
    _ = ∑ c : H.ConnectedComponent, Nat.card c.toSimpleGraph.edgeSet := by
          refine Finset.sum_congr rfl ?_
          intro c hc
          exact Nat.card_congr (edgeFiberEquiv c)

/-- Helper for Exercise 4.17: a connected graph contributes at least `|V|-1` edges if it is
bipartite, and at least `|V|` edges otherwise. -/
lemma connected_card_vertices_le_card_edgeSet_add_bip_indicator {W : Type*}
    (K : SimpleGraph W) [Finite W] [Decidable K.IsBipartite] (hconn : K.Connected) :
    Nat.card W ≤ Nat.card K.edgeSet + (if K.IsBipartite then 1 else 0) := by
  classical
  by_cases hbi : K.IsBipartite
  · -- In the bipartite case the standard tree lower bound is exactly the needed inequality.
    simpa [hbi] using hconn.card_vert_le_card_edgeSet_add_one
  · have hle : Nat.card W ≤ Nat.card K.edgeSet + 1 := hconn.card_vert_le_card_edgeSet_add_one
    have hne : Nat.card W ≠ Nat.card K.edgeSet + 1 := by
      intro hEq
      have htree : K.IsTree := by
        rw [K.isTree_iff_connected_and_card]
        exact ⟨hconn, hEq.symm⟩
      exact hbi htree.isBipartite
    -- Route correction: the non-bipartite branch must rule out the tree equality case before
    -- lowering `+ 1` to `+ 0`.
    have hlt : Nat.card W < Nat.card K.edgeSet + 1 := lt_of_le_of_ne hle hne
    simpa [hbi] using Nat.lt_succ_iff.mp hlt

/-- Helper for Exercise 4.17: for a connected graph, achieving the minimum possible edge count is
equivalent to being a tree or a connected non-bipartite graph with exactly as many edges as
vertices. -/
lemma connected_edge_count_eq_min_iff_tree_or_odd_unicyclic {W : Type*}
    (K : SimpleGraph W) [Finite W] [Decidable K.IsBipartite] (hconn : K.Connected) :
    Nat.card K.edgeSet + (if K.IsBipartite then 1 else 0) = Nat.card W ↔
      tree_or_odd_unicyclic K := by
  classical
  by_cases hbi : K.IsBipartite
  · -- When the graph is bipartite, the extremal equality is exactly the tree count.
    rw [show tree_or_odd_unicyclic K ↔ K.IsTree by
      constructor
      · intro h
        rcases h with htree | ⟨-, -, hnon⟩
        · exact htree
        · exact False.elim (hnon hbi)
      · intro htree
        exact Or.inl htree]
    simp [hbi, K.isTree_iff_connected_and_card, hconn]
  · -- When the graph is not bipartite, the tree branch is impossible, so only the `|E| = |V|`
    -- alternative remains.
    rw [show tree_or_odd_unicyclic K ↔ (K.Connected ∧ Nat.card K.edgeSet = Nat.card W ∧
        ¬ K.IsBipartite) by
      constructor
      · intro h
        rcases h with htree | hodd
        · exact False.elim (hbi htree.isBipartite)
        · exact hodd
      · intro hodd
        exact Or.inr hodd]
    simp [hbi, hconn]

/-- Helper for Exercise 4.17: the global edge-count equality is equivalent to asking each
connected component to be either a tree or a connected odd-unicyclic graph. -/
lemma cardEdgeSet_add_cardBipartiteComponents_eq_cardVertices_iff_treeOrOddUnicyclic
    (H : SimpleGraph V) [Finite V] :
    Nat.card H.edgeSet + Nat.card {c : H.ConnectedComponent // c.toSimpleGraph.IsBipartite} =
        Nat.card V ↔
      ∀ c : H.ConnectedComponent, tree_or_odd_unicyclic c.toSimpleGraph := by
  classical
  let _ : Fintype H.ConnectedComponent := Fintype.ofFinite _
  let bipSum : H.ConnectedComponent → ℕ := fun c ↦ if c.toSimpleGraph.IsBipartite then 1 else 0
  have hverts :
      Nat.card V = ∑ c : H.ConnectedComponent, Nat.card ↥c.supp := by
    rw [Nat.card_congr (verts_sigma_connectedComponent_equiv H), Nat.card_sigma]
  have hedges :
      Nat.card H.edgeSet = ∑ c : H.ConnectedComponent, Nat.card c.toSimpleGraph.edgeSet := by
    simpa using card_edgeSet_eq_sum_card_componentEdgeSet (H := H)
  have hbip :
      Nat.card {c : H.ConnectedComponent // c.toSimpleGraph.IsBipartite} =
        ∑ c : H.ConnectedComponent, bipSum c := by
    rw [Nat.card_eq_fintype_card, Fintype.card_subtype]
    simpa [bipSum] using
      (Finset.card_filter (p := fun c : H.ConnectedComponent ↦ c.toSimpleGraph.IsBipartite)
        Finset.univ)
  have hcomp_le :
      ∀ c ∈ (Finset.univ : Finset H.ConnectedComponent),
        Nat.card ↥c.supp ≤ Nat.card c.toSimpleGraph.edgeSet + bipSum c := by
    intro c hc
    -- Each connected component satisfies the standard lower bound `|V| ≤ |E| + bipartiteIndicator`.
    simpa [bipSum] using
      connected_card_vertices_le_card_edgeSet_add_bip_indicator
        (K := c.toSimpleGraph) c.connected_toSimpleGraph
  have hsum :
      Nat.card H.edgeSet + Nat.card {c : H.ConnectedComponent // c.toSimpleGraph.IsBipartite} =
        ∑ c : H.ConnectedComponent, (Nat.card c.toSimpleGraph.edgeSet + bipSum c) := by
    -- Rewrite the two global cardinalities as finite sums over connected components.
    rw [hedges, hbip, Finset.sum_add_distrib]
  constructor
  · intro h
    have hsum_eq :
        ∑ c : H.ConnectedComponent, Nat.card ↥c.supp =
          ∑ c : H.ConnectedComponent, (Nat.card c.toSimpleGraph.edgeSet + bipSum c) := by
      calc
        ∑ c : H.ConnectedComponent, Nat.card ↥c.supp = Nat.card V := hverts.symm
        _ =
            Nat.card H.edgeSet +
              Nat.card {c : H.ConnectedComponent // c.toSimpleGraph.IsBipartite} := h.symm
        _ = ∑ c : H.ConnectedComponent, (Nat.card c.toSimpleGraph.edgeSet + bipSum c) := hsum
    have hcomp_eq :=
      (Finset.sum_eq_sum_iff_of_le
        (s := (Finset.univ : Finset H.ConnectedComponent))
        (f := fun c ↦ Nat.card ↥c.supp)
        (g := fun c ↦ Nat.card c.toSimpleGraph.edgeSet + bipSum c)
        hcomp_le).1 hsum_eq
    intro c
    -- Equality in the global sum forces equality in each connected component.
    exact
      (connected_edge_count_eq_min_iff_tree_or_odd_unicyclic
        (K := c.toSimpleGraph) c.connected_toSimpleGraph).1
        (hcomp_eq c (Finset.mem_univ c)).symm
  · intro h
    have hcomp_eq :
        ∀ c : H.ConnectedComponent,
          Nat.card c.toSimpleGraph.edgeSet + bipSum c = Nat.card ↥c.supp := by
      intro c
      -- The componentwise extremal criterion is exactly the previously proved connected lemma.
      exact
        (connected_edge_count_eq_min_iff_tree_or_odd_unicyclic
          (K := c.toSimpleGraph) c.connected_toSimpleGraph).2
          (h c)
    calc
      Nat.card H.edgeSet + Nat.card {c : H.ConnectedComponent // c.toSimpleGraph.IsBipartite}
        = ∑ c : H.ConnectedComponent, (Nat.card c.toSimpleGraph.edgeSet + bipSum c) := hsum
      _ = ∑ c : H.ConnectedComponent, Nat.card ↥c.supp := by
            refine Finset.sum_congr rfl ?_
            intro c hc
            exact hcomp_eq c
      _ = Nat.card V := hverts.symm

lemma card_edgeSet_eq_card_vertices_sub_card_bipartite_components_iff_tree_or_odd_unicyclic
    (H : SimpleGraph V) [Finite V] :
    Nat.card H.edgeSet =
        Nat.card V - Nat.card {c : H.ConnectedComponent // c.toSimpleGraph.IsBipartite} ↔
      ∀ c : H.ConnectedComponent, tree_or_odd_unicyclic c.toSimpleGraph := by
  classical
  have hbip_le :
      Nat.card {c : H.ConnectedComponent // c.toSimpleGraph.IsBipartite} ≤ Nat.card V := by
    refine Finite.card_le_of_embedding ⟨fun c ↦ c.1.out, ?_⟩
    intro c d hcd
    change c.1.out = d.1.out at hcd
    have hd_mem : c.1.out ∈ d.1.supp := by
      rw [hcd]
      exact d.1.out_eq
    apply Subtype.ext
    exact ConnectedComponent.eq_of_common_vertex c.1.out_eq hd_mem
  constructor
  · intro h
    have hsub :
        Nat.card V - Nat.card {c : H.ConnectedComponent // c.toSimpleGraph.IsBipartite} =
          Nat.card H.edgeSet := h.symm
    have hadd :
        Nat.card H.edgeSet + Nat.card {c : H.ConnectedComponent // c.toSimpleGraph.IsBipartite} =
          Nat.card V := by
      -- Convert the subtraction statement to the additive form needed for the componentwise proof.
      simpa [Nat.add_comm] using ((tsub_eq_iff_eq_add_of_le hbip_le).1 hsub).symm
    exact
      (cardEdgeSet_add_cardBipartiteComponents_eq_cardVertices_iff_treeOrOddUnicyclic
        (H := H)).1 hadd
  · intro h
    have hadd :
        Nat.card H.edgeSet + Nat.card {c : H.ConnectedComponent // c.toSimpleGraph.IsBipartite} =
          Nat.card V :=
      (cardEdgeSet_add_cardBipartiteComponents_eq_cardVertices_iff_treeOrOddUnicyclic
        (H := H)).2 h
    have hsub :
        Nat.card V - Nat.card {c : H.ConnectedComponent // c.toSimpleGraph.IsBipartite} =
          Nat.card H.edgeSet := by
      -- Solve the additive equality back for the edge count.
      refine (tsub_eq_iff_eq_add_of_le hbip_le).2 ?_
      simpa [Nat.add_comm] using hadd.symm
    exact hsub.symm

/-- Helper for Exercise 4.17: a connected non-bipartite graph with `|E| = |V|` is either a union
of cycles or it has a leaf. -/
lemma connectedCardEqCard_not_isBipartite_isCycles_or_existsDegreeOne {W : Type*}
    (H : SimpleGraph W) [Finite W] [Fintype W] [DecidableEq W] [DecidableRel H.Adj]
    (hconn : H.Connected) (hcard : Nat.card H.edgeSet = Nat.card W)
    (hnon : ¬ H.IsBipartite) :
    H.IsCycles ∨ ∃ v : W, H.degree v = 1 := by
  classical
  by_cases hcyc : H.IsCycles
  · exact Or.inl hcyc
  · right
    have hnontriv : Nontrivial W := by
      by_contra hsub
      haveI : Subsingleton W := not_nontrivial_iff_subsingleton.mp hsub
      haveI : Nonempty W := hconn.nonempty
      exact hnon (IsTree.of_subsingleton (G := H)).isBipartite
    have hdeg_pos : ∀ v : W, 0 < H.degree v := by
      intro v
      obtain ⟨w, hw⟩ := exists_ne v
      exact (hconn v w).degree_pos_left hw.symm
    by_cases hleaf : ∃ v : W, H.degree v = 1
    · exact hleaf
    · have hall_two : ∀ v : W, 2 ≤ H.degree v := by
        intro v
        have hpos : 1 ≤ H.degree v := Nat.succ_le_of_lt (hdeg_pos v)
        have hne_one : H.degree v ≠ 1 := by
          intro hv
          exact hleaf ⟨v, hv⟩
        omega
      have hgt_two : ∃ v : W, 2 < H.degree v := by
        by_contra hnot
        push Not at hnot
        apply hcyc
        intro v hv
        have hdeg_two : H.degree v = 2 := le_antisymm (hnot v) (hall_two v)
        rw [Set.ncard_eq_toFinset_card']
        simpa [hdeg_two] using (H.card_neighborSet_eq_degree (v := v))
      rcases hgt_two with ⟨v, hv⟩
      have hcard' : Fintype.card H.edgeSet = Fintype.card W := by
        simpa [Nat.card_eq_fintype_card] using hcard
      have hsum : ∑ w : W, H.degree w = 2 * Fintype.card W := by
        calc
          ∑ w : W, H.degree w = 2 * H.edgeFinset.card := by
            simpa using H.sum_degrees_eq_twice_card_edges
          _ = 2 * Fintype.card H.edgeSet := by rw [H.edgeFinset_card]
          _ = 2 * Fintype.card W := by rw [hcard']
      have hsum_lt : 2 * Fintype.card W < ∑ w : W, H.degree w := by
        calc
          2 * Fintype.card W = Fintype.card W * 2 := by ring
          _ = ∑ w : W, 2 := by simp
          _ < ∑ w : W, H.degree w := by
            exact Finset.sum_lt_sum (fun w _ ↦ hall_two w) ⟨v, Finset.mem_univ _, hv⟩
      omega

/-- Helper for Exercise 4.17: deleting a leaf from a connected graph with `|E| = |V|` preserves
connectedness and lowers both cardinalities by one. -/
lemma deleteLeafPreservesConnectedCard {W : Type*} (H : SimpleGraph W)
    [Finite W] [Fintype W] [DecidableEq W] [DecidableRel H.Adj]
    (hconn : H.Connected) (hcard : Nat.card H.edgeSet = Nat.card W) {v : W}
    (hleaf : H.degree v = 1) :
    let H' := H.induce ({v}ᶜ : Set W)
    H'.Connected ∧ Nat.card H'.edgeSet = Nat.card ↥({v}ᶜ : Set W) := by
  classical
  let H' := H.induce ({v}ᶜ : Set W)
  have hconn' : H'.Connected := hconn.induce_compl_singleton_of_degree_eq_one hleaf
  have hedge' : Nat.card H'.edgeSet = Nat.card H.edgeSet - 1 := by
    rw [Nat.card_eq_fintype_card, Nat.card_eq_fintype_card, ← H'.edgeFinset_card,
      H.card_edgeFinset_induce_compl_singleton, H.card_edgeFinset_deleteIncidenceSet, hleaf,
      H.edgeFinset_card]
  have hverts' : Nat.card ↥({v}ᶜ : Set W) = Nat.card W - 1 := by
    rw [Nat.card_eq_fintype_card, Nat.card_eq_fintype_card, Fintype.card_compl_set]
    simp
  refine ⟨hconn', ?_⟩
  calc
    Nat.card H'.edgeSet = Nat.card H.edgeSet - 1 := hedge'
    _ = Nat.card W - 1 := by rw [hcard]
    _ = Nat.card ↥({v}ᶜ : Set W) := hverts'.symm

/-- Helper for Exercise 4.17: deleting a leaf from a non-bipartite graph cannot create a
bipartition, because any bipartite coloring of the complement extends by coloring the leaf
opposite to its unique neighbor. -/
lemma induceComplSingleton_not_isBipartite_of_leaf {W : Type*} (H : SimpleGraph W)
    [Finite W] [Fintype W] [DecidableEq W] [DecidableRel H.Adj] {v : W}
    (hleaf : H.degree v = 1) (hnon : ¬ H.IsBipartite) :
    ¬ (H.induce ({v}ᶜ : Set W)).IsBipartite := by
  classical
  intro hbip
  let H' : SimpleGraph ↥({v}ᶜ : Set W) := H.induce ({v}ᶜ : Set W)
  obtain ⟨u, huv, hu_unique⟩ := SimpleGraph.degree_eq_one_iff_existsUnique_adj.mp hleaf
  have hu' : u ∈ ({v}ᶜ : Set W) := by
    simpa [Set.mem_compl_iff] using huv.ne.symm
  have huv_ne : u ≠ v := by
    simpa [Set.mem_compl_iff] using hu'
  let c : H'.Coloring Bool := hbip.toColoring (by decide)
  let color : W → Bool :=
    fun x ↦
      if hx : x = v then
        !(c ⟨u, hu'⟩)
      else
        c ⟨x, by simpa [Set.mem_compl_iff] using hx⟩
  have hcolor_v : color v = !(c ⟨u, hu'⟩) := by
    simp [color]
  have hcolor_u : color u = c ⟨u, hu'⟩ := by
    simp [color, huv_ne]
  let d : H.Coloring Bool :=
    SimpleGraph.Coloring.mk
      color
      (by
        intro x y hxy
        -- Check the three adjacency patterns: the leaf edge from either side, or an edge inside
        -- the deleted graph where the original bipartite coloring already works.
        by_cases hx : x = v
        · have hyu : y = u := hu_unique y (hx ▸ hxy)
          subst hx
          subst hyu
          rw [hcolor_v, hcolor_u]
          simp
        · by_cases hy : y = v
          · have hxu : x = u := hu_unique x (hy ▸ hxy.symm)
            subst hy
            subst hxu
            rw [hcolor_u, hcolor_v]
            simp
          · have hxy' :
              H'.Adj ⟨x, by simpa [Set.mem_compl_iff] using hx⟩
                ⟨y, by simpa [Set.mem_compl_iff] using hy⟩ := by
              simpa [H', SimpleGraph.induce_adj]
            simpa [color, hx, hy] using c.valid hxy')
  exact hnon d.colorable

/-- Helper for Exercise 4.17: in the connected `IsCycles` non-bipartite branch, mathlib already
produces a cycle walk whose spanning graph is the whole graph. -/
lemma connectedIsCycles_exists_cycle_spanning_eq {W : Type*}
    [Finite W] (H : SimpleGraph W) [DecidableEq W] [DecidableRel H.Adj]
    (hconn : H.Connected) (hnon : ¬ H.IsBipartite) (hcyc : H.IsCycles) :
    ∃ v, ∃ p : H.Walk v v, p.IsCycle ∧ p.toSubgraph.spanningCoe = H := by
  classical
  let _ : Fintype W := Fintype.ofFinite W
  have hedge : H.edgeSet.Nonempty := by
    by_contra hedge
    let c : H.Coloring Bool :=
      SimpleGraph.Coloring.mk
        (fun _ ↦ false)
        (by
          intro x y hxy
          exact False.elim (hedge ⟨s(x, y), H.mem_edgeSet.mpr hxy⟩))
    exact hnon c.colorable
  rcases hedge with ⟨e, he⟩
  induction e using Sym2.ind with
  | h v w =>
      let c : H.ConnectedComponent := H.connectedComponentMk v
      have hv : v ∈ c.supp := by
        simpa [c] using
          (SimpleGraph.ConnectedComponent.connectedComponentMk_mem (G := H) (v := v))
      have hneigh : (H.neighborSet v).Nonempty := ⟨w, by simpa using he⟩
      have hc_supp : c.supp = Set.univ := by
        ext x
        constructor
        · intro _
          simp
        · intro _
          rw [SimpleGraph.ConnectedComponent.mem_supp_iff]
          simpa [c] using
            (SimpleGraph.ConnectedComponent.sound (G := H) (hconn x v))
      obtain ⟨p, hpCycle, hpVerts⟩ :=
        SimpleGraph.IsCycles.exists_cycle_toSubgraph_verts_eq_connectedComponentSupp
          (G := H) (v := v) (c := c) hcyc hv hneigh
      refine ⟨v, p, hpCycle, ?_⟩
      have hpVertsUniv : p.toSubgraph.verts = Set.univ := by
        simpa [hc_supp] using hpVerts
      -- Once the cycle support is all vertices, the cycle walk's spanning graph is exactly `H`.
      ext x y
      constructor
      · intro hxy
        have hx : x ∈ p.toSubgraph.verts := by
          rw [hpVertsUniv]
          simp
        exact
          (SimpleGraph.Walk.IsCycle.adj_toSubgraph_iff_of_isCycles
            (G := H) (p := p) hpCycle hcyc hx y).1
            (by simpa [SimpleGraph.Subgraph.spanningCoe_adj] using hxy)
      · intro hxy
        have hx : x ∈ p.toSubgraph.verts := by
          rw [hpVertsUniv]
          simp
        exact
          (by
            simpa [SimpleGraph.Subgraph.spanningCoe_adj] using
              (SimpleGraph.Walk.IsCycle.adj_toSubgraph_iff_of_isCycles
                (G := H) (p := p) hpCycle hcyc hx y).2 hxy)

/-- Helper for Exercise 4.17: a spanning cycle in a connected non-bipartite graph meets every
vertex, because every vertex is incident to some edge of the spanning cycle subgraph. -/
lemma mem_support_of_cycle_spanning_eq {W : Type*} (H : SimpleGraph W)
    [Finite W] [Fintype W] [DecidableEq W] [DecidableRel H.Adj]
    (hconn : H.Connected) (hnon : ¬ H.IsBipartite) {v : W} {p : H.Walk v v}
    (hpSpan : p.toSubgraph.spanningCoe = H) :
    ∀ w : W, w ∈ p.support := by
  intro w
  let _ : Nonempty W := hconn.nonempty
  have hnontriv : Nontrivial W := by
    by_contra hsub
    haveI : Subsingleton W := not_nontrivial_iff_subsingleton.mp hsub
    exact hnon (IsTree.of_subsingleton (G := H)).isBipartite
  obtain ⟨x, hwx⟩ := hconn.preconnected.exists_adj_of_nontrivial w
  have hspanAdj : p.toSubgraph.spanningCoe.Adj w x := by
    simpa [hpSpan] using hwx
  have hsubAdj : p.toSubgraph.Adj w x := by
    simpa [SimpleGraph.Subgraph.spanningCoe_adj] using hspanAdj
  -- Any endpoint of an edge in the walk subgraph lies on the walk support.
  exact SimpleGraph.Walk.mem_support_of_adj_toSubgraph hsubAdj

/-- Helper for Exercise 4.17: a cycle walk spanning the whole connected non-bipartite graph is a
Hamiltonian cycle once its tail is recognized as a path through every vertex. -/
lemma cycle_spanning_eq_isHamiltonianCycle {W : Type*} (H : SimpleGraph W)
    [Finite W] [Fintype W] [DecidableEq W] [DecidableRel H.Adj]
    (hconn : H.Connected) (hnon : ¬ H.IsBipartite) {v : W} {p : H.Walk v v}
    (hpCycle : p.IsCycle) (hpSpan : p.toSubgraph.spanningCoe = H) :
    p.IsHamiltonianCycle := by
  have htailPath : p.tail.IsPath := by
    cases p with
    | nil =>
        exact False.elim (hpCycle.not_nil SimpleGraph.Walk.nil_nil)
    | @cons a b c hab q =>
        -- Route correction: isolate the tail-path fact from `cons_isCycle_iff` before asking for
        -- Hamiltonicity of the tail.
        simpa using (SimpleGraph.Walk.cons_isCycle_iff (p := q) hab).1 hpCycle |>.1
  have htailMem : ∀ w : W, w ∈ p.tail.support := by
    intro w
    by_cases hwv : w = v
    · subst w
      have hvTail : v ∈ p.support.tail := by
        simpa using SimpleGraph.Walk.end_mem_tail_support (p := p) hpCycle.not_nil
      simpa [SimpleGraph.Walk.support_tail_of_not_nil (p := p) hpCycle.not_nil] using hvTail
    · have hwSupport : w ∈ p.support :=
        mem_support_of_cycle_spanning_eq (H := H) hconn hnon hpSpan w
      have hwTail : w ∈ p.support.tail := by
        have hwCons : w ∈ v :: p.support.tail := by
          rw [SimpleGraph.Walk.cons_tail_support (p := p)]
          exact hwSupport
        rcases List.mem_cons.1 hwCons with hEq | hTail
        · exact False.elim (hwv hEq)
        · exact hTail
      simpa [SimpleGraph.Walk.support_tail_of_not_nil (p := p) hpCycle.not_nil] using hwTail
  refine ⟨hpCycle, ?_⟩
  -- Once every vertex is in the tail support, the tail is Hamiltonian by the path criterion.
  exact htailPath.isHamiltonian_of_mem htailMem

/-- Helper for Exercise 4.17: a spanning cycle in the connected non-bipartite branch has length
equal to the number of vertices. -/
lemma cycle_spanning_eq_length_eq_card {W : Type*} (H : SimpleGraph W)
    [Finite W] [Fintype W] [DecidableEq W] [DecidableRel H.Adj]
    (hconn : H.Connected) (hnon : ¬ H.IsBipartite) {v : W} {p : H.Walk v v}
    (hpCycle : p.IsCycle) (hpSpan : p.toSubgraph.spanningCoe = H) :
    p.length = Fintype.card W := by
  -- The Hamiltonian-cycle normalization packages the vertex-count identity for the cycle length.
  exact
    (cycle_spanning_eq_isHamiltonianCycle (H := H) hconn hnon hpCycle hpSpan).length_eq

/-- Helper for Exercise 4.17: an integer of absolute value `2` is exactly `2` or `-2`. -/
lemma eq_two_or_neg_two_of_abs_eq_two {z : ℤ} (hz : |z| = 2) :
    z = 2 ∨ z = -2 := by
  have hz' : |z| = |(2 : ℤ)| := by
    simpa using hz
  exact eq_or_eq_neg_of_abs_eq hz'

/-- Helper for Exercise 4.17: at the initial vertex of a Hamiltonian cycle, adjacency in the walk
subgraph agrees with adjacency in the corresponding cycle graph. -/
private lemma cycleWalkSubgraph_adj_iff_cycleGraph_zeroIndex {W : Type*} (H : SimpleGraph W)
    [Finite W] [Fintype W] [DecidableEq W] [DecidableRel H.Adj] {v : W} {p : H.Walk v v}
    (hpHam : p.IsHamiltonianCycle) (zero : Fin p.length) (hzero : (zero : ℕ) = 0)
    (hgetVert_eq_iff : ∀ {k l : Fin p.length}, p.getVert k = p.getVert l ↔ k = l)
    (j : Fin p.length) :
    p.toSubgraph.Adj (p.getVert zero) (p.getVert j) ↔ (cycleGraph p.length).Adj zero j := by
  have hlen : 3 ≤ p.length := hpHam.isCycle.three_le_length
  have hpos : 0 < p.length := by
    linarith
  let zeroIndex : Fin p.length := ⟨0, hpos⟩
  have hzero_eq : zero = zeroIndex := by
    apply Fin.ext
    simpa [zeroIndex] using hzero
  subst zero
  let oneIndex : Fin p.length := ⟨1, by omega⟩
  let lastIndex : Fin p.length := ⟨p.length - 1, by omega⟩
  have hzero_vert : p.getVert zeroIndex = v := by
    simp [zeroIndex]
  constructor
  · intro hij
    rw [← Subgraph.mem_neighborSet, hzero_vert,
      hpHam.isCycle.neighborSet_toSubgraph_endpoint] at hij
    have hj_cases : j = oneIndex ∨ j = lastIndex := by
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff, Walk.snd, Walk.penultimate] at hij
      rcases hij with hj1 | hjlast
      · exact Or.inl ((hgetVert_eq_iff).1 (by simpa [oneIndex, Walk.snd] using hj1))
      · exact Or.inr ((hgetVert_eq_iff).1 (by simpa [lastIndex, Walk.penultimate] using hjlast))
    rw [SimpleGraph.cycleGraph_adj']
    rcases hj_cases with hj1 | hjlast
    · right
      subst j
      have hsub : oneIndex - zeroIndex = oneIndex := by
        apply Fin.ext
        fin_omega
      simpa [oneIndex, zeroIndex, Nat.mod_eq_of_lt (by omega : 1 < p.length)] using
        congrArg Fin.val hsub
    · left
      subst j
      have hsub : zeroIndex - lastIndex = oneIndex := by
        apply Fin.ext
        fin_omega
      simpa [oneIndex, zeroIndex, Nat.mod_eq_of_lt (by omega : 1 < p.length)] using
        congrArg Fin.val hsub
  · intro hij
    rw [SimpleGraph.cycleGraph_adj'] at hij
    have hendpoint :
        p.toSubgraph.neighborSet (p.getVert zeroIndex) = {p.snd, p.penultimate} := by
      simpa [zeroIndex] using hpHam.isCycle.neighborSet_toSubgraph_endpoint (p := p)
    rw [← Subgraph.mem_neighborSet, hendpoint]
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff, Walk.snd, Walk.penultimate]
    rcases hij with hij | hij
    · right
      have hjlast : j = lastIndex := by
        apply Fin.ext
        fin_omega
      simpa [lastIndex, Walk.penultimate] using (hgetVert_eq_iff).2 hjlast
    · left
      have hjone : j = oneIndex := by
        apply Fin.ext
        fin_omega
      simpa [oneIndex, Walk.snd] using (hgetVert_eq_iff).2 hjone

/-- Helper for Exercise 4.17: at a non-initial vertex of a Hamiltonian cycle, adjacency in the
walk subgraph agrees with adjacency in the corresponding cycle graph. -/
private lemma cycleWalkSubgraph_adj_iff_cycleGraph_nonzeroIndex {W : Type*} (H : SimpleGraph W)
    [Finite W] [Fintype W] [DecidableEq W] [DecidableRel H.Adj] {v : W} {p : H.Walk v v}
    (hpHam : p.IsHamiltonianCycle) (zero i j : Fin p.length) (hi0 : (i : ℕ) ≠ 0)
    (hgetVert_eq_iff : ∀ {k l : Fin p.length}, p.getVert k = p.getVert l ↔ k = l)
    (hgetVert_eq_start_iff : ∀ {k : Fin p.length}, p.getVert k = v ↔ k = zero) :
    p.toSubgraph.Adj (p.getVert i) (p.getVert j) ↔ (cycleGraph p.length).Adj i j := by
  have hlen : 3 ≤ p.length := hpHam.isCycle.three_le_length
  let oneIndex : Fin p.length := ⟨1, by omega⟩
  constructor
  · intro hij
    rw [← Subgraph.mem_neighborSet,
      hpHam.isCycle.neighborSet_toSubgraph_internal hi0 (by omega)] at hij
    rw [SimpleGraph.cycleGraph_adj']
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hij
    rcases hij with hij | hij
    · let iprev : Fin p.length := ⟨(i : ℕ) - 1, by omega⟩
      have hjprev : j = iprev := (hgetVert_eq_iff).1 (by simpa [iprev] using hij)
      subst j
      left
      have hsub : i - iprev = oneIndex := by
        apply Fin.ext
        fin_omega
      simpa [oneIndex, Nat.mod_eq_of_lt (by omega : 1 < p.length)] using congrArg Fin.val hsub
    · by_cases hinext : (i : ℕ) + 1 < p.length
      · let inext : Fin p.length := ⟨(i : ℕ) + 1, hinext⟩
        have hjnext : j = inext := (hgetVert_eq_iff).1 (by simpa [inext] using hij)
        subst j
        right
        have hsub : inext - i = oneIndex := by
          apply Fin.ext
          fin_omega
        simpa [oneIndex, Nat.mod_eq_of_lt (by omega : 1 < p.length)] using congrArg Fin.val hsub
      · have hi_last : (i : ℕ) + 1 = p.length := by omega
        have hjzero : j = zero := (hgetVert_eq_start_iff).1 (by simpa [hi_last] using hij)
        subst j
        right
        have hsub : zero - i = oneIndex := by
          apply Fin.ext
          fin_omega
        simpa [oneIndex, Nat.mod_eq_of_lt (by omega : 1 < p.length)] using congrArg Fin.val hsub
  · intro hij
    rw [SimpleGraph.cycleGraph_adj'] at hij
    rw [← Subgraph.mem_neighborSet,
      hpHam.isCycle.neighborSet_toSubgraph_internal hi0 (by omega)]
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff]
    rcases hij with hij | hij
    · left
      let iprev : Fin p.length := ⟨(i : ℕ) - 1, by omega⟩
      have hjprev : j = iprev := by
        apply Fin.ext
        fin_omega
      simpa [iprev] using (hgetVert_eq_iff).2 hjprev
    · by_cases hinext : (i : ℕ) + 1 < p.length
      · right
        let inext : Fin p.length := ⟨(i : ℕ) + 1, hinext⟩
        have hjnext : j = inext := by
          apply Fin.ext
          fin_omega
        simpa [inext] using (hgetVert_eq_iff).2 hjnext
      · right
        have hi_last : (i : ℕ) + 1 = p.length := by omega
        have hjzero : j = zero := by
          apply Fin.ext
          fin_omega
        rw [hjzero]
        simpa [hi_last] using (hgetVert_eq_start_iff).2 rfl

/-- Helper for Exercise 4.17: a spanning Hamiltonian cycle expresses adjacency in the walk order
as cyclic successor or predecessor. -/
lemma hamiltonianCycleSpanning_adj_iff_finRotate {W : Type*} (H : SimpleGraph W)
    [Finite W] [Fintype W] [DecidableEq W] [DecidableRel H.Adj] {v : W} {p : H.Walk v v}
    (hpHam : p.IsHamiltonianCycle) (hpSpan : p.toSubgraph.spanningCoe = H) (i j : Fin p.length) :
    H.Adj (p.getVert i) (p.getVert j) ↔ j = finRotate p.length i ∨ i = finRotate p.length j := by
  classical
  have hlen : 3 ≤ p.length := hpHam.isCycle.three_le_length
  have hpos : 0 < p.length := by
    linarith
  let zero : Fin p.length := ⟨0, hpos⟩
  have hgetVert_inj :
      Function.Injective (fun k : Fin p.length ↦ p.getVert k) := by
    intro k l hkl
    apply Fin.ext
    exact hpHam.isCycle.getVert_injOn'
      (by simpa using Nat.le_pred_of_lt k.is_lt)
      (by simpa using Nat.le_pred_of_lt l.is_lt)
      hkl
  have hgetVert_eq_iff {k l : Fin p.length} :
      p.getVert k = p.getVert l ↔ k = l := by
    constructor
    · intro hkl
      exact hgetVert_inj hkl
    · intro hkl
      simpa [hkl]
  have hgetVert_eq_start_iff {k : Fin p.length} :
      p.getVert k = v ↔ k = zero := by
    constructor
    · intro hk
      rcases (hpHam.isCycle.getVert_endpoint_iff (i := k) (by omega)).1 (by simpa using hk) with
        hk0 | hklen
      · exact Fin.ext (by simpa [zero] using hk0)
      · exact False.elim (Nat.ne_of_lt k.is_lt hklen)
    · intro hk
      simpa [hk, zero]
  have hsub :
      p.toSubgraph.Adj (p.getVert i) (p.getVert j) ↔ (cycleGraph p.length).Adj i j := by
    by_cases hi0 : i = zero
    · rw [hi0]
      have hzero : ((zero : Fin p.length) : ℕ) = 0 := by
        simp [zero]
      exact cycleWalkSubgraph_adj_iff_cycleGraph_zeroIndex
        (H := H) hpHam zero hzero hgetVert_eq_iff j
    · have hi0_val : (i : ℕ) ≠ 0 := by
          intro hi
          apply hi0
          apply Fin.ext
          simpa [zero] using hi
      exact cycleWalkSubgraph_adj_iff_cycleGraph_nonzeroIndex
        (H := H) hpHam zero i j hi0_val hgetVert_eq_iff hgetVert_eq_start_iff
  have hmain : H.Adj (p.getVert i) (p.getVert j) ↔ (cycleGraph p.length).Adj i j := by
    have hsub' :
        p.toSubgraph.spanningCoe.Adj (p.getVert i) (p.getVert j) ↔
          (cycleGraph p.length).Adj i j := by
      simpa [SimpleGraph.Subgraph.spanningCoe_adj] using hsub
    simpa [hpSpan] using hsub'
  -- Route correction: isolate the long endpoint/internal walk argument once, then normalize both
  -- graphs to the shared `finRotate` adjacency form.
  exact hmain.trans (cycleGraph_adj_iff_finRotate (n := p.length) hlen i j)

/-- Helper for Exercise 4.17: a spanning Hamiltonian cycle identifies the graph with the
corresponding cycle graph indexed by the walk order, omitting the repeated final base vertex. -/
private lemma hamiltonianCycleSpanning_map_rel_iff {W : Type*} (H : SimpleGraph W)
    [Finite W] [Fintype W] [DecidableEq W] [DecidableRel H.Adj] {v : W} {p : H.Walk v v}
    (hpHam : p.IsHamiltonianCycle) (hpSpan : p.toSubgraph.spanningCoe = H)
    (ρ : Fin p.length ≃ W) (hρ : ∀ i : Fin p.length, ρ i = p.getVert i) :
    ∀ a b, H.Adj a b ↔ (cycleGraph p.length).Adj (ρ.symm a) (ρ.symm b) := by
  have hlen : 3 ≤ p.length := hpHam.isCycle.three_le_length
  intro a b
  let i : Fin p.length := ρ.symm a
  let j : Fin p.length := ρ.symm b
  have hH :
      H.Adj (p.getVert i) (p.getVert j) ↔
        j = finRotate p.length i ∨ i = finRotate p.length j := by
    exact hamiltonianCycleSpanning_adj_iff_finRotate (H := H) hpHam hpSpan i j
  have hCycle :
      (cycleGraph p.length).Adj i j ↔
        j = finRotate p.length i ∨ i = finRotate p.length j := by
    exact cycleGraph_adj_iff_finRotate (n := p.length) hlen i j
  have hmain : H.Adj (p.getVert i) (p.getVert j) ↔ (cycleGraph p.length).Adj i j := by
    exact hH.trans hCycle.symm
  have ha : p.getVert i = a := by
    rw [← hρ i]
    exact Equiv.apply_symm_apply ρ a
  have hb : p.getVert j = b := by
    rw [← hρ j]
    exact Equiv.apply_symm_apply ρ b
  simpa [ha, hb, i, j] using hmain

/-- Helper for Exercise 4.17: a spanning Hamiltonian cycle identifies the graph with the
corresponding cycle graph indexed by the walk order, omitting the repeated final base vertex. -/
noncomputable def hamiltonianCycleSpanningIsoCycleGraph {W : Type*} (H : SimpleGraph W)
    [Finite W] [Fintype W] [DecidableEq W] [DecidableRel H.Adj] {v : W} {p : H.Walk v v}
    (hpHam : p.IsHamiltonianCycle) (hpSpan : p.toSubgraph.spanningCoe = H) :
    H ≃g cycleGraph p.length := by
  classical
  have hgetVert_inj :
      Function.Injective (fun i : Fin p.length ↦ p.getVert i) := by
    intro i j hij
    apply Fin.ext
    exact hpHam.isCycle.getVert_injOn'
      (by simpa using Nat.le_pred_of_lt i.is_lt)
      (by simpa using Nat.le_pred_of_lt j.is_lt)
      hij
  have hgetVert_bij :
      Function.Bijective (fun i : Fin p.length ↦ p.getVert i) := by
    refine (Fintype.bijective_iff_injective_and_card _).2 ?_
    refine ⟨hgetVert_inj, ?_⟩
    simpa using hpHam.length_eq
  let ρ : Fin p.length ≃ W := Equiv.ofBijective (fun i : Fin p.length ↦ p.getVert i) hgetVert_bij
  have hρ : ∀ i : Fin p.length, ρ i = p.getVert i := by
    intro i
    rfl
  refine { toEquiv := ρ.symm, map_rel_iff' := ?_ }
  intro a b
  simpa [ρ] using (hamiltonianCycleSpanning_map_rel_iff (H := H) hpHam hpSpan ρ hρ a b).symm

/-- Helper for Exercise 4.17: deleting the vertex `v` embeds an edge of the induced complement
graph back into an ambient edge of `H`. -/
private def induceComplSingletonEdgeEmbedding {W : Type*} (H : SimpleGraph W)
    [DecidableEq W] [DecidableRel H.Adj] (v : W) :
    (H.induce ({v}ᶜ : Set W)).edgeSet ↪ H.edgeSet :=
  -- Use the canonical induced-graph embedding and its induced edge-set map.
  (SimpleGraph.Embedding.induce ({v}ᶜ : Set W)).mapEdgeSet

/-- Helper for Exercise 4.17: every edge of the induced complement graph avoids the deleted
vertex in the ambient graph. -/
private lemma induceComplSingletonEdgeEmbedding_avoids_vertex {W : Type*} (H : SimpleGraph W)
    [DecidableEq W] [DecidableRel H.Adj] (v : W) (e : (H.induce ({v}ᶜ : Set W)).edgeSet) :
    v ∉ ((induceComplSingletonEdgeEmbedding H v e : H.edgeSet) : Sym2 W) := by
  intro hv
  rcases Sym2.mem_map.mp hv with ⟨w, hw, hwv⟩
  exact w.2 (by simpa using hwv)

/-- Helper for Exercise 4.17: an ambient edge avoiding `v` can be reread as an edge of the
induced complement graph. -/
private noncomputable def ambientEdgeAvoidingVertexToInducedEdge {W : Type*} (H : SimpleGraph W)
    [DecidableEq W] [DecidableRel H.Adj] (v : W) :
    {e : H.edgeSet // v ∉ (e : Sym2 W)} → (H.induce ({v}ᶜ : Set W)).edgeSet := fun e ↦ by
  let a : {x : W // x ≠ v} := ⟨e.1.1.out.1, by
    intro hav
    have hv_mem : v ∈ (e.1 : Sym2 W) := by
      simpa [hav] using Sym2.out_fst_mem e.1.1
    exact e.2 hv_mem⟩
  let b : {x : W // x ≠ v} := ⟨e.1.1.out.2, by
    intro hbv
    have hv_mem : v ∈ (e.1 : Sym2 W) := by
      simpa [hbv] using Sym2.out_snd_mem e.1.1
    exact e.2 hv_mem⟩
  refine ⟨s(a, b), ?_⟩
  -- The ambient adjacency witnesses that the same unordered pair is an edge in the induced graph.
  have hab : H.Adj e.1.1.out.1 e.1.1.out.2 := by
    exact H.mem_edgeSet.mp (by simpa [e.1.1.out_eq] using e.1.2)
  exact ((H.induce ({v}ᶜ : Set W)).mem_edgeSet).2 <| by
    simpa [SimpleGraph.induce_adj, a, b] using hab

/-- Helper for Exercise 4.17: embedding back the induced edge rebuilt from an avoiding ambient edge
returns the original ambient edge. -/
private lemma induceComplSingletonEdgeEmbedding_ambientEdgeAvoidingVertexToInducedEdge
    {W : Type*} (H : SimpleGraph W) [DecidableEq W] [DecidableRel H.Adj] (v : W)
    (e : {f : H.edgeSet // v ∉ (f : Sym2 W)}) :
    induceComplSingletonEdgeEmbedding H v
        (ambientEdgeAvoidingVertexToInducedEdge H v e) = e.1 := by
  apply Subtype.ext
  -- Rebuilding the induced edge from the concrete ambient endpoints gives back the same pair.
  change s(e.1.1.out.1, e.1.1.out.2) = e.1.1
  exact e.1.1.out_eq

/-- Helper for Exercise 4.17: deleting the vertex `v` identifies the induced edge set with the
ambient edges that avoid `v`. -/
private noncomputable def induceComplSingletonEdgeEquivAvoidingVertex {W : Type*}
    (H : SimpleGraph W)
    [DecidableEq W] [DecidableRel H.Adj] (v : W) :
    (H.induce ({v}ᶜ : Set W)).edgeSet ≃ {e : H.edgeSet // v ∉ (e : Sym2 W)} where
  toFun e :=
    ⟨induceComplSingletonEdgeEmbedding H v e,
      induceComplSingletonEdgeEmbedding_avoids_vertex H v e⟩
  invFun := ambientEdgeAvoidingVertexToInducedEdge H v
  left_inv := by
    intro e
    apply (induceComplSingletonEdgeEmbedding H v).injective
    -- Reduce the left inverse to the explicit right inverse on ambient avoiding edges.
    simpa using
      induceComplSingletonEdgeEmbedding_ambientEdgeAvoidingVertexToInducedEdge H v
        ⟨induceComplSingletonEdgeEmbedding H v e,
          induceComplSingletonEdgeEmbedding_avoids_vertex H v e⟩
  right_inv := by
    intro e
    apply Subtype.ext
    -- The ambient avoiding-edge subtype equality is exactly the underlying edge equality above.
    simpa using
      induceComplSingletonEdgeEmbedding_ambientEdgeAvoidingVertexToInducedEdge H v e

/-- Helper for Exercise 4.17: once the unique leaf edge is moved to the `v`-column, the remaining
column indices identify with the edges of the deleted-leaf graph. -/
noncomputable def leafTailEdgeEquiv {W : Type*} (H : SimpleGraph W) [DecidableEq W]
    [DecidableRel H.Adj] (σ : W ≃ H.edgeSet) {v : W} {e₀ : H.edgeSet}
    (hσ : σ v = e₀) (he₀ : v ∈ (e₀ : Sym2 W))
    (hunique : ∀ e : H.edgeSet, v ∈ (e : Sym2 W) → e = e₀) :
    {x : W // x ≠ v} ≃ (H.induce ({v}ᶜ : Set W)).edgeSet := by
  classical
  let tailAvoid : {x : W // x ≠ v} ≃ {e : H.edgeSet // v ∉ (e : Sym2 W)} :=
    { toFun := fun j ↦
        ⟨σ j.1, by
          intro hv
          have hEq : σ j.1 = e₀ := hunique (σ j.1) hv
          have hjv : j.1 = v := σ.injective (by simpa [hσ] using hEq)
          exact j.2 hjv⟩
      invFun := fun e ↦
        ⟨σ.symm e.1, by
          intro h
          have hEq : e.1 = e₀ := by
            simpa [hσ] using congrArg σ h
          exact e.2 (hEq ▸ he₀)⟩
      left_inv := by
        intro j
        apply Subtype.ext
        simp
      right_inv := by
        intro e
        apply Subtype.ext
        simp }
  exact tailAvoid.trans (induceComplSingletonEdgeEquivAvoidingVertex H v).symm

/-- Helper for Exercise 4.17: embedding the induced edge selected by `leafTailEdgeEquiv` recovers
the corresponding ambient edge indexed by the permuted column equivalence. -/
lemma induceComplSingletonEdgeEmbedding_leafTailEdgeEquiv {W : Type*} (H : SimpleGraph W)
    [DecidableEq W] [DecidableRel H.Adj] (σ : W ≃ H.edgeSet) {v : W} {e₀ : H.edgeSet}
    (hσ : σ v = e₀) (he₀ : v ∈ (e₀ : Sym2 W))
    (hunique : ∀ e : H.edgeSet, v ∈ (e : Sym2 W) → e = e₀) (j : {x : W // x ≠ v}) :
    induceComplSingletonEdgeEmbedding H v
        (leafTailEdgeEquiv H σ hσ he₀ hunique j) = σ j.1 := by
  classical
  -- Unfold the tail equivalence once, then use the explicit right inverse for induced edges.
  unfold leafTailEdgeEquiv
  simp [induceComplSingletonEdgeEquivAvoidingVertex,
    induceComplSingletonEdgeEmbedding_ambientEdgeAvoidingVertexToInducedEdge]

/-- Helper for Exercise 4.17: after moving the unique leaf edge to the distinguished column, the
incidence relation on the deleted-vertex block matches the induced complement graph. -/
lemma leafTailBlock_incidenceSet_iff {W : Type*} (H : SimpleGraph W)
    [DecidableEq W] [DecidableRel H.Adj] (σ : W ≃ H.edgeSet) {v : W} {e₀ : H.edgeSet}
    (hσ : σ v = e₀) (he₀ : v ∈ (e₀ : Sym2 W))
    (hunique : ∀ e : H.edgeSet, v ∈ (e : Sym2 W) → e = e₀)
    (i j : {x : W // x ≠ v}) :
    ((σ j.1 : H.edgeSet) : Sym2 W) ∈ H.incidenceSet i.1 ↔
      ((leafTailEdgeEquiv H σ hσ he₀ hunique j).1 : Sym2 {x : W // x ≠ v}) ∈
        (H.induce ({v}ᶜ : Set W)).incidenceSet i := by
  -- Rewrite both incidence statements as endpoint membership in the underlying unordered edge.
  rw [SimpleGraph.edge_mem_incidenceSet_iff, SimpleGraph.edge_mem_incidenceSet_iff]
  rw [← induceComplSingletonEdgeEmbedding_leafTailEdgeEquiv
    (H := H) (σ := σ) hσ he₀ hunique j]
  change i.1 ∈
      Sym2.map (Subtype.val : {x : W // x ≠ v} → W)
        ((leafTailEdgeEquiv H σ hσ he₀ hunique j).1 : Sym2 {x : W // x ≠ v}) ↔
    i ∈ ((leafTailEdgeEquiv H σ hσ he₀ hunique j).1 : Sym2 {x : W // x ≠ v})
  rw [Sym2.mem_map]
  constructor
  · rintro ⟨w, hw, hwEq⟩
    have hwi : w = i := Subtype.ext hwEq
    simpa [hwi] using hw
  · intro hi
    exact ⟨i, hi, rfl⟩

/-- Helper for Exercise 4.17: the deleted-vertex square block of the special-column incidence
matrix is exactly the incidence matrix of the deleted-leaf graph. -/
lemma leafTailBlock_eq_deleteLeafIncidence {W : Type*} (H : SimpleGraph W)
    [DecidableEq W] [DecidableRel H.Adj] (σ : W ≃ H.edgeSet) {v : W} {e₀ : H.edgeSet}
    (hσ : σ v = e₀) (he₀ : v ∈ (e₀ : Sym2 W))
    (hunique : ∀ e : H.edgeSet, v ∈ (e : Sym2 W) → e = e₀) :
    Matrix.toSquareBlockProp ((H.edgeIncMatrix ℤ).submatrix id σ) (fun x => x ≠ v) =
      (((H.induce ({v}ᶜ : Set W)).edgeIncMatrix ℤ).submatrix id
        (leafTailEdgeEquiv H σ hσ he₀ hunique)) := by
  ext i j
  change H.incMatrix ℤ i.1 (σ j.1) =
    (H.induce ({v}ᶜ : Set W)).incMatrix ℤ i (leafTailEdgeEquiv H σ hσ he₀ hunique j)
  by_cases hinc : ((σ j.1 : H.edgeSet) : Sym2 W) ∈ H.incidenceSet i.1
  · have hinc' :=
      (leafTailBlock_incidenceSet_iff (H := H) (σ := σ) hσ he₀ hunique i j).1 hinc
    -- On an incident edge, both incidence entries are `1`.
    rw [H.incMatrix_of_mem_incidenceSet (R := ℤ) hinc,
      (H.induce ({v}ᶜ : Set W)).incMatrix_of_mem_incidenceSet (R := ℤ) hinc']
  · have hinc' :
        ((leafTailEdgeEquiv H σ hσ he₀ hunique j).1 : Sym2 {x : W // x ≠ v}) ∉
          (H.induce ({v}ᶜ : Set W)).incidenceSet i := by
      intro hinc'
      exact hinc <|
        (leafTailBlock_incidenceSet_iff (H := H) (σ := σ) hσ he₀ hunique i j).2 hinc'
    -- Off the incidence set, both entries vanish.
    rw [H.incMatrix_of_notMem_incidenceSet (R := ℤ) hinc,
      (H.induce ({v}ᶜ : Set W)).incMatrix_of_notMem_incidenceSet (R := ℤ) hinc']

/-- Helper for Exercise 4.17: once the unique leaf edge occupies the distinguished column, the
determinant reduces to the determinant of the deleted-leaf incidence matrix. -/
lemma leafSpecialColumn_det_eq_deleteLeafDet {W : Type*} (H : SimpleGraph W)
    [Fintype W] [DecidableEq W] [DecidableRel H.Adj] (σ : W ≃ H.edgeSet) {v : W}
    {e₀ : H.edgeSet}
    (hσ : σ v = e₀) (he₀ : v ∈ (e₀ : Sym2 W))
    (hunique : ∀ e : H.edgeSet, v ∈ (e : Sym2 W) → e = e₀) :
    (((H.edgeIncMatrix ℤ).submatrix id σ).det) =
      ((((H.induce ({v}ᶜ : Set W)).edgeIncMatrix ℤ).submatrix id
          (leafTailEdgeEquiv H σ hσ he₀ hunique)).det) := by
  let M : Matrix W W ℤ := ((H.edgeIncMatrix ℤ).submatrix id σ)
  have he₀_inc : (e₀ : Sym2 W) ∈ H.incidenceSet v := by
    simpa using (SimpleGraph.edge_mem_incidenceSet_iff (G := H) (a := v) (e := e₀)).2 he₀
  have htop :
      (Matrix.toSquareBlockProp M (fun x => x = v)).det = 1 := by
    have hdet :=
      Matrix.det_eq_elem_of_subsingleton
        (Matrix.toSquareBlockProp M (fun x => x = v)) ⟨v, rfl⟩
    rw [hdet]
    -- The singleton block records the unique `1` on the leaf row and special leaf column.
    simpa [M, Matrix.toSquareBlockProp_def, Matrix.submatrix_apply, SimpleGraph.edgeIncMatrix, hσ]
      using H.incMatrix_of_mem_incidenceSet (R := ℤ) he₀_inc
  have hupper :
      ∀ i : W, i = v → ∀ j : W, j ≠ v → M i j = 0 := by
    intro i hi j hj
    subst i
    -- Every non-special column avoids the leaf vertex, so the leaf row vanishes there.
    rw [show M v j = H.incMatrix ℤ v (σ j) by
      simp [M, SimpleGraph.edgeIncMatrix, Matrix.submatrix_apply]]
    refine H.incMatrix_of_notMem_incidenceSet (R := ℤ) ?_
    intro hmem
    have hv : v ∈ ((σ j : H.edgeSet) : Sym2 W) :=
      (SimpleGraph.edge_mem_incidenceSet_iff (G := H) (a := v) (e := σ j)).1 hmem
    have hσj : σ j = e₀ := hunique (σ j) hv
    exact hj (σ.injective (by simpa [hσ] using hσj))
  -- The special-column matrix is upper block triangular with singleton `1` block.
  calc
    M.det =
        (Matrix.toSquareBlockProp M (fun x => x = v)).det *
          (Matrix.toSquareBlockProp M (fun x => x ≠ v)).det := by
            simpa [M] using Matrix.twoBlockTriangular_det' M (fun x => x = v) hupper
    _ =
        (((H.induce ({v}ᶜ : Set W)).edgeIncMatrix ℤ).submatrix id
          (leafTailEdgeEquiv H σ hσ he₀ hunique)).det := by
            rw [htop, one_mul, leafTailBlock_eq_deleteLeafIncidence
              (H := H) (σ := σ) hσ he₀ hunique]
            rfl

/-- Helper for Exercise 4.17: on a connected non-bipartite unicyclic graph, the absolute value of
every square edge-incidence minor is `2`. -/
lemma connected_nonbipartite_unicyclic_abs_det_eq_two {W : Type u} (H : SimpleGraph W)
    [Finite W] [Fintype W] [DecidableEq W] [DecidableRel H.Adj] (hconn : H.Connected)
    (hcard : Nat.card H.edgeSet = Nat.card W) (hnon : ¬ H.IsBipartite)
    (σ : W ≃ H.edgeSet) :
    |(((H.edgeIncMatrix ℤ).submatrix id σ).det)| = 2 := by
  classical
  let P : ℕ → Prop := fun n ↦
    ∀ {W : Type u} (H : SimpleGraph W), [Finite W] → [Fintype W] → [DecidableEq W] →
      [DecidableRel H.Adj] → H.Connected → Nat.card H.edgeSet = Nat.card W →
      ¬ H.IsBipartite → (σ : W ≃ H.edgeSet) → Nat.card W = n →
      |(((H.edgeIncMatrix ℤ).submatrix id σ).det)| = 2
  have hmain : ∀ n : ℕ, P n := by
    intro n
    induction n with
    | zero =>
        intro W H _ _ _ _ hconn hcard hnon σ hW
        have hne : Nat.card W ≠ 0 := by
          intro hzero
          haveI : IsEmpty W := (Finite.card_eq_zero_iff).1 hzero
          rcases hconn.nonempty with ⟨x⟩
          exact isEmptyElim x
        exact False.elim (hne hW)
    | succ n ih =>
        intro W H _ _ _ _ hconn hcard hnon σ hW
        rcases connectedCardEqCard_not_isBipartite_isCycles_or_existsDegreeOne
            (H := H) hconn hcard hnon with hcyc | ⟨v, hleaf⟩
        · rcases
            connectedIsCycles_exists_cycle_spanning_eq (H := H) hconn hnon hcyc
              with ⟨v, p, hpCycle, hpSpan⟩
          have hpHam : p.IsHamiltonianCycle :=
            cycle_spanning_eq_isHamiltonianCycle (H := H) hconn hnon hpCycle hpSpan
          have hlen : p.length = Fintype.card W :=
            cycle_spanning_eq_length_eq_card (H := H) hconn hnon hpCycle hpSpan
          have hcycle : H ≃g cycleGraph p.length :=
            hamiltonianCycleSpanningIsoCycleGraph (H := H) hpHam hpSpan
          have hodd : Odd p.length := by
            by_contra hEven
            have hbiCycle : (cycleGraph p.length).IsBipartite :=
              (SimpleGraph.cycleGraph.bicoloring_of_even p.length
                (Nat.not_odd_iff_even.mp hEven)).colorable
            exact hnon ⟨Classical.choice hbiCycle |>.comp hcycle.toHom⟩
          -- The cycle branch is exactly Exercise 4.15 after transporting along the Hamiltonian
          -- cycle indexing.
          simpa using
            (odd_cycle_abs_det_cycle_incidence_square_matrix (G := H) σ hcycle
              (by simpa [hlen] using hpCycle.three_le_length) hodd)
        · let H' : SimpleGraph ↥({v}ᶜ : Set W) := H.induce ({v}ᶜ : Set W)
          have hpack :
              H'.Connected ∧ Nat.card H'.edgeSet = Nat.card ↥({v}ᶜ : Set W) :=
            deleteLeafPreservesConnectedCard (H := H) hconn hcard hleaf
          have hconn' : H'.Connected := hpack.1
          have hcard' : Nat.card H'.edgeSet = Nat.card ↥({v}ᶜ : Set W) := hpack.2
          have hnon' : ¬ H'.IsBipartite :=
            induceComplSingleton_not_isBipartite_of_leaf (H := H) hleaf hnon
          obtain ⟨u, huv, hu_unique⟩ := SimpleGraph.degree_eq_one_iff_existsUnique_adj.mp hleaf
          let e₀ : H.edgeSet := ⟨s(v, u), H.mem_edgeSet.mpr huv⟩
          have he₀_mem : v ∈ (e₀ : Sym2 W) := by
            simp [e₀]
          have hleaf_edge_unique : ∀ e : H.edgeSet, v ∈ (e : Sym2 W) → e = e₀ := by
            intro e hv
            rcases Sym2.mem_iff_exists.mp hv with ⟨w, hw⟩
            have hvw : H.Adj v w := by
              exact H.mem_edgeSet.mp (by simpa [hw] using e.2)
            have hwu : w = u := hu_unique w hvw
            apply Subtype.ext
            simpa [e₀, hw, hwu]
          let _ := hconn'
          let _ := hcard'
          let _ := hnon'
          let _ := he₀_mem
          let _ := hleaf_edge_unique
          let σ₀ : W ≃ H.edgeSet := (Equiv.swap v (σ.symm e₀)).trans σ
          have hσ₀ : σ₀ v = e₀ := by
            simp [σ₀]
          have hσ_swap :
              |(((H.edgeIncMatrix ℤ).submatrix id σ₀).det)| =
                |(((H.edgeIncMatrix ℤ).submatrix id σ).det)| := by
            -- Reindex the columns by a single swap so the leaf edge lands in the `v`-column.
            simpa [σ₀] using
              Matrix.abs_det_submatrix_equiv_equiv (Equiv.refl W)
                (Equiv.swap v (σ.symm e₀)) ((H.edgeIncMatrix ℤ).submatrix id σ)
          have hW' : Nat.card ↥({v}ᶜ : Set W) = n := by
            have hverts' : Nat.card ↥({v}ᶜ : Set W) = Nat.card W - 1 := by
              rw [Nat.card_eq_fintype_card, Nat.card_eq_fintype_card, Fintype.card_compl_set]
              simp
            omega
          have hdet_delete :
              |(((H.edgeIncMatrix ℤ).submatrix id σ₀).det)| = 2 := by
            -- Reduce the determinant to the deleted graph and invoke the induction hypothesis.
            rw [leafSpecialColumn_det_eq_deleteLeafDet
              (H := H) (σ := σ₀) hσ₀ he₀_mem hleaf_edge_unique]
            exact ih (W := ↥({v}ᶜ : Set W)) H' hconn' hcard' hnon'
              (leafTailEdgeEquiv H σ₀ hσ₀ he₀_mem hleaf_edge_unique) hW'
          -- Route correction: the leaf branch now stays in the same index type until the
          -- deleted-graph block is identified entrywise, avoiding the previous `Fin.succ` minor
          -- transport.
          exact hσ_swap.symm.trans hdet_delete
  exact hmain (Nat.card W) H hconn hcard hnon σ rfl

/-- Helper for Exercise 4.17: a connected non-bipartite unicyclic graph has every square
edge-incidence minor of determinant `±2`. -/
lemma connected_nonbipartite_unicyclic_det_eq_two_or_neg_two {W : Type*} (H : SimpleGraph W)
    [Finite W] [Fintype W] [DecidableEq W] [DecidableRel H.Adj] (hconn : H.Connected)
    (hcard : Nat.card H.edgeSet = Nat.card W) (hnon : ¬ H.IsBipartite)
    (σ : W ≃ H.edgeSet) :
    (((H.edgeIncMatrix ℤ).submatrix id σ).det = 2) ∨
      (((H.edgeIncMatrix ℤ).submatrix id σ).det = -2) := by
  -- Route correction: prove the absolute-value companion first, then convert the final result
  -- from `|det| = 2` to the native `±2` split required by the statement.
  exact eq_two_or_neg_two_of_abs_eq_two <|
    connected_nonbipartite_unicyclic_abs_det_eq_two (H := H) hconn hcard hnon σ

/-- Exercise 4.17 (4). The rank of the edge-indexed incidence matrix over `ℚ` is the number of
vertices minus the number of bipartite connected components. -/
theorem incMatrix_rank_eq_card_vertices_sub_card_bipartite_components (G : SimpleGraph V)
    [Fintype V] [DecidableEq V] [DecidableRel G.Adj] :
    (G.edgeIncMatrix ℚ).rank =
      Fintype.card V - Nat.card {c : G.ConnectedComponent // c.toSimpleGraph.IsBipartite} :=
  by
    classical
    let _ : Fintype {c : G.ConnectedComponent // c.toSimpleGraph.IsBipartite} := Fintype.ofFinite _
    have hker :
        Module.finrank ℚ (Matrix.toLin' ((G.edgeIncMatrix ℚ)ᵀ)).ker =
          Nat.card {c : G.ConnectedComponent // c.toSimpleGraph.IsBipartite} := by
      simpa using
        (card_bipartite_components_eq_finrank_ker_edgeIncMatrix_transpose (G := G)).symm
    have hsum :
        ((G.edgeIncMatrix ℚ)ᵀ).rank +
            Nat.card {c : G.ConnectedComponent // c.toSimpleGraph.IsBipartite} =
          Fintype.card V := by
      -- Rank-nullity for the transpose reduces the rank computation to the kernel basis above.
      simpa [Matrix.rank, hker, Module.finrank_pi] using
        (LinearMap.finrank_range_add_finrank_ker (Matrix.toLin' ((G.edgeIncMatrix ℚ)ᵀ)))
    have hsum' :
        (G.edgeIncMatrix ℚ).rank +
            Nat.card {c : G.ConnectedComponent // c.toSimpleGraph.IsBipartite} =
          Fintype.card V := by
      calc
        (G.edgeIncMatrix ℚ).rank +
            Nat.card {c : G.ConnectedComponent // c.toSimpleGraph.IsBipartite}
          = ((G.edgeIncMatrix ℚ)ᵀ).rank +
              Nat.card {c : G.ConnectedComponent // c.toSimpleGraph.IsBipartite} := by
                rw [Matrix.rank_transpose]
        _ = Fintype.card V := hsum
    -- Solve the cardinality identity for the rank term.
    exact Nat.eq_sub_of_add_eq hsum'

/-- Exercise 4.17 (1). The columns of the edge-indexed incidence submatrix indexed by `F` are
linearly independent over `ℚ` exactly when every connected component generated by `F` is a tree or
a connected odd-unicyclic graph. -/
theorem incMatrix_columns_linearIndependent_iff_edge_family (G : SimpleGraph V) [Finite V]
    [DecidableEq V] [DecidableRel G.Adj] (F : Set G.edgeSet) :
    LinearIndependent ℚ ((edgeFamilyIncidenceSubmatrix G ℚ F).col) ↔
      incidence_independent_edge_family G F := by
  classical
  let H : SimpleGraph V := (edgeFamilySubgraph G F).spanningCoe
  let _ : Fintype V := Fintype.ofFinite V
  let _ : Fintype ↥F := Fintype.ofFinite ↥F
  let _ : Fintype {c : H.ConnectedComponent // c.toSimpleGraph.IsBipartite} := Fintype.ofFinite _
  have hcard : Nat.card ↥F = Nat.card H.edgeSet := by
    simpa [H] using (edgeFamilySubgraph_card_edgeSet_eq_card_family (G := G) F).symm
  -- Route correction: reduce column independence to the rank formula for the generated graph, and
  -- leave only the matrix-rank adapter plus the pure component-count criterion.
  calc
    LinearIndependent ℚ ((edgeFamilyIncidenceSubmatrix G ℚ F).col)
      ↔ Nat.card ↥F = (edgeFamilyIncidenceSubmatrix G ℚ F).rank := by
          simpa using
            (linearIndependent_cols_iff_card_eq_rank
              (R := ℚ) (A := edgeFamilyIncidenceSubmatrix G ℚ F))
    _ ↔ Nat.card H.edgeSet = (H.edgeIncMatrix ℚ).rank := by
          rw [hcard, edgeFamilyIncidenceSubmatrix_rank_eq_spanningCoe_rank (G := G) (F := F)]
    _ ↔ Nat.card H.edgeSet =
          Fintype.card V - Nat.card {c : H.ConnectedComponent // c.toSimpleGraph.IsBipartite} := by
          have hrankH :
              (H.edgeIncMatrix ℚ).rank =
                Fintype.card V - Nat.card {c : H.ConnectedComponent // c.toSimpleGraph.IsBipartite} :=
            incMatrix_rank_eq_card_vertices_sub_card_bipartite_components (G := H)
          -- Rewrite the rank term explicitly inside the cardinality equality.
          constructor <;> intro h <;> simpa [hrankH] using h
    _ ↔ incidence_independent_edge_family G F := by
          simpa [Nat.card_eq_fintype_card, H, incidence_independent_edge_family] using
            (card_edgeSet_eq_card_vertices_sub_card_bipartite_components_iff_tree_or_odd_unicyclic
              (H := H))

/-- Exercise 4.17 (2). If the graph generated by `F` is connected, belongs to the family from
Exercise 4.17, and is not a tree, then its incidence submatrix has equally many row and column
indices. -/
theorem edge_family_connected_non_tree_square (G : SimpleGraph V) [Finite V] (F : Set G.edgeSet)
    (hF : incidence_independent_edge_family G F)
    (hconn : (edgeFamilySubgraph G F).Connected)
    (hnotTree : ¬ (edgeFamilySubgraph G F).coe.IsTree) :
    Nat.card ↥((edgeFamilySubgraph G F).support) = Nat.card ↥F := by
  let H : G.Subgraph := edgeFamilySubgraph G F
  have hsupport : H.support = H.verts := by
    exact support_eq_verts_of_connected_not_isTree (by simpa [H] using hconn)
      (by simpa [H] using hnotTree)
  have hedgeSet : H.edgeSet = ((↑) '' F : Set (Sym2 V)) := by
    simpa [H] using edgeFamilySubgraph_edgeSet G F
  have hcoe_injective : Function.Injective ((↑) : G.edgeSet → Sym2 V) := Subtype.val_injective
  have hedge_card : Nat.card H.edgeSet = Nat.card ↥F := by
    rw [hedgeSet]
    simpa using Nat.card_image_of_injective hcoe_injective F
  have hcoe_edge_card : Nat.card H.coe.edgeSet = Nat.card H.edgeSet := by
    rw [← H.image_coe_edgeSet_coe]
    simpa using
      Nat.card_image_of_injective
        (Function.Embedding.sym2Map (Function.Embedding.subtype H.verts)).injective
        H.coe.edgeSet |>.symm
  obtain ⟨v, hv⟩ := hconn.nonempty
  let vH : H.verts := ⟨v, hv⟩
  let K : SimpleGraph V := H.spanningCoe
  let c : K.ConnectedComponent := K.connectedComponentMk v
  have hc_support : c.supp = H.support := by
    ext w
    constructor
    · intro hw
      by_cases hwv : w = v
      · simpa [hsupport, hwv] using vH.property
      · have hw_reachable : K.Reachable w v := by
          rw [ConnectedComponent.mem_supp_iff] at hw
          simpa [c] using ConnectedComponent.eq.mp hw
        simpa [K] using mem_support_of_reachable hwv hw_reachable
    · intro hw
      have hw_verts : w ∈ H.verts := by simpa [hsupport] using hw
      have hw_reachable : K.Reachable w v := by
        exact
          Reachable.map (Subgraph.coeEmbeddingSpanningCoe H).toHom
            (hconn ⟨w, hw_verts⟩ vH)
      rw [ConnectedComponent.mem_supp_iff]
      simpa [c] using ConnectedComponent.sound hw_reachable
  have hc_verts : c.supp = H.verts := hc_support.trans hsupport
  have hc_iso : c.toSimpleGraph ≃g H.coe := by
    refine
      { toEquiv := Equiv.subtypeEquivRight fun x ↦ by
          change x ∈ c.supp ↔ x ∈ H.verts
          simp [hc_verts]
        map_rel_iff' := ?_ }
    intro a b
    change K.Adj a.1 b.1 ↔ H.Adj a.1 b.1
    simp [K]
  have hc_family : tree_or_odd_unicyclic c.toSimpleGraph := by
    simpa [H, K] using hF c
  rcases hc_family with hc_tree | ⟨_, hc_card, _⟩
  · have htree_H : H.coe.IsTree := (hc_iso.isTree_iff).mp hc_tree
    exact False.elim (hnotTree htree_H)
  · have hcard_component_support : Nat.card ↥c.supp = Nat.card ↥H.support := by
      simp [hc_support]
    have hcard_component_edges : Nat.card c.toSimpleGraph.edgeSet = Nat.card H.edgeSet := by
      calc
        Nat.card c.toSimpleGraph.edgeSet = Nat.card H.coe.edgeSet :=
          Nat.card_congr (Iso.mapEdgeSet hc_iso)
        _ = Nat.card H.edgeSet := hcoe_edge_card
    calc
      Nat.card ↥H.support = Nat.card ↥c.supp := hcard_component_support.symm
      _ = Nat.card c.toSimpleGraph.edgeSet := hc_card.symm
      _ = Nat.card H.edgeSet := hcard_component_edges
      _ = Nat.card ↥F := hedge_card

/-- Exercise 4.17 (3). In the connected non-tree case from Exercise 4.17, any square reindexing
of the edge-indexed incidence submatrix has determinant `± 2`. -/
theorem edge_family_connected_non_tree_det_eq_two_or_neg_two (G : SimpleGraph V) [Finite V]
    [DecidableEq V] [DecidableRel G.Adj] (F : Set G.edgeSet)
    (hF : incidence_independent_edge_family G F)
    (hconn : (edgeFamilySubgraph G F).Connected)
    (hnotTree : ¬ (edgeFamilySubgraph G F).coe.IsTree)
    (e : ↥((edgeFamilySubgraph G F).support) ≃ ↥F) :
    by
      classical
      let _ : Fintype ↥((edgeFamilySubgraph G F).support) := Fintype.ofFinite _
      let _ : Fintype ↥F := Fintype.ofFinite _
      exact (((edgeFamilyIncidenceSubmatrix G ℤ F).submatrix id e).det = 2) ∨
        (((edgeFamilyIncidenceSubmatrix G ℤ F).submatrix id e).det = -2) := by
    classical
    let _ : Fintype ↥((edgeFamilySubgraph G F).support) := Fintype.ofFinite _
    let _ : Fintype ↥F := Fintype.ofFinite _
    let _ : Fintype V := Fintype.ofFinite V
    let H : G.Subgraph := edgeFamilySubgraph G F
    let K : SimpleGraph V := H.spanningCoe
    let _ : Fintype {c : K.ConnectedComponent // c.toSimpleGraph.IsBipartite} := Fintype.ofFinite _
    have hspanning : H.IsSpanning := by
      intro v
      simp [H, edgeFamilySubgraph]
    -- Route correction: since `edgeFamilySubgraph` is built with `toSubgraph`, its vertex set is
    -- already `univ`; the only work here is to reindex rows/columns to the spanning graph `K`
    -- and then invoke the connected odd-unicyclic core lemma.
    have hsupport : H.support = Set.univ := by
      calc
        H.support = H.verts := support_eq_verts_of_connected_not_isTree
          (by simpa [H] using hconn) (by simpa [H] using hnotTree)
        _ = Set.univ := hspanning.verts_eq_univ
    let ρ : V ≃ ↥H.support :=
      (Equiv.Set.univ V).symm.trans (Equiv.setCongr hsupport.symm)
    let σ : V ≃ K.edgeSet := (ρ.trans e).trans (edgeFamilySubgraph_edgeEquiv G F)
    have hmatrix :
        ((((edgeFamilyIncidenceSubmatrix G ℤ F).submatrix id e).submatrix ρ ρ)) =
          ((K.edgeIncMatrix ℤ).submatrix id σ) := by
      -- After replacing the support rows by all vertices and composing the column equivalences,
      -- both sides are literally the same incidence entry.
      rw [edgeFamilyIncidenceSubmatrix_eq_spanningCoe_support_rows_reindex (G := G) (R := ℤ)
        (F := F)]
      ext i j
      simp [H, K, ρ, σ, Matrix.submatrix_apply]
    have hdet_transport :
        ((edgeFamilyIncidenceSubmatrix G ℤ F).submatrix id e).det =
          ((K.edgeIncMatrix ℤ).submatrix id σ).det := by
      -- Reindexing rows and columns along the same equivalence preserves the determinant.
      have hdet :=
        Matrix.det_submatrix_equiv_self ρ ((edgeFamilyIncidenceSubmatrix G ℤ F).submatrix id e)
      rw [hmatrix] at hdet
      exact hdet.symm
    let κ : K ≃g H.coe := H.spanningCoeEquivCoeOfSpanning hspanning
    have hconnK : K.Connected := by
      -- The spanning graph `K` is the same connected graph as the connected subgraph `H`.
      simpa [K] using (κ.connected_iff).2 hconn
    have hnotTreeK : ¬ K.IsTree := by
      intro hkTree
      exact hnotTree ((κ.isTree_iff).1 hkTree)
    have hcardVK : Nat.card V = Nat.card ↥F := by
      calc
        Nat.card V = Nat.card ↥H.support := Nat.card_congr ρ
        _ = Nat.card ↥F := edge_family_connected_non_tree_square (G := G) F hF hconn hnotTree
    have hcardK : Nat.card K.edgeSet = Nat.card V := by
      calc
        Nat.card K.edgeSet = Nat.card ↥F := by
          simpa [K] using edgeFamilySubgraph_card_edgeSet_eq_card_family (G := G) F
        _ = Nat.card V := hcardVK.symm
    have hfamilyK : ∀ c : K.ConnectedComponent, tree_or_odd_unicyclic c.toSimpleGraph := by
      simpa [H, K] using hF
    have hbipCountEq :
        Nat.card K.edgeSet =
          Nat.card V - Nat.card {c : K.ConnectedComponent // c.toSimpleGraph.IsBipartite} := by
      exact
        (card_edgeSet_eq_card_vertices_sub_card_bipartite_components_iff_tree_or_odd_unicyclic
          (H := K)).2 hfamilyK
    have hbipCountZero :
        Nat.card {c : K.ConnectedComponent // c.toSimpleGraph.IsBipartite} = 0 := by
      omega
    have hnonK : ¬ K.IsBipartite := by
      intro hbiK
      obtain ⟨v⟩ := hconnK.nonempty
      have hcomponentBi : (K.connectedComponentMk v).toSimpleGraph.IsBipartite := by
        simpa using hbiK.subgraph (K.connectedComponentMk v).toSubgraph
      have hpos :
          0 < Nat.card {c : K.ConnectedComponent // c.toSimpleGraph.IsBipartite} := by
        rw [Nat.card_eq_fintype_card]
        exact Fintype.card_pos_iff.mpr ⟨⟨K.connectedComponentMk v, hcomponentBi⟩⟩
      omega
    -- The remaining determinant computation is exactly the connected odd-unicyclic core theorem.
    rcases connected_nonbipartite_unicyclic_det_eq_two_or_neg_two (H := K) hconnK hcardK hnonK σ with
      hdetK | hdetK
    · left
      simpa using hdet_transport.trans hdetK
    · right
      simpa using hdet_transport.trans hdetK
