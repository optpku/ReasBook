section Exercise_4_29

variable {V : Type u}

namespace SimpleGraph

/-- Helper for Exercise 4.29: the spanning subgraph of `G` generated by an edge family
`F : Set G.edgeSet`. This is copied locally to avoid replaying the heavy Exercise 4.17 import. -/
abbrev edgeFamilySubgraph (G : SimpleGraph V) (F : Set G.edgeSet) : G.Subgraph :=
  SimpleGraph.toSubgraph (SimpleGraph.fromEdgeSet (((↑) '' F : Set (Sym2 V)))) <| by
    intro v w hvw
    rw [SimpleGraph.fromEdgeSet_adj] at hvw
    rcases hvw.1 with ⟨e, heF, heq⟩
    exact G.mem_edgeSet.mp (heq.symm ▸ e.2)

/-- Helper for Exercise 4.29: the edge set of the subgraph generated by an edge family is exactly
the chosen family of underlying edges. -/
lemma edgeFamilySubgraph_edgeSet (G : SimpleGraph V) (F : Set G.edgeSet) :
    (edgeFamilySubgraph G F).edgeSet = ((↑) '' F : Set (Sym2 V)) := by
  ext e
  induction e using Sym2.ind with
  | h v w =>
      constructor
      · intro he
        rw [Subgraph.mem_edgeSet] at he
        rw [edgeFamilySubgraph] at he
        change (SimpleGraph.fromEdgeSet (((↑) '' F : Set (Sym2 V)))).Adj v w at he
        rw [SimpleGraph.fromEdgeSet_adj] at he
        exact he.1
      · intro he
        rw [Subgraph.mem_edgeSet]
        rw [edgeFamilySubgraph]
        change (SimpleGraph.fromEdgeSet (((↑) '' F : Set (Sym2 V)))).Adj v w
        rw [SimpleGraph.fromEdgeSet_adj]
        refine ⟨he, ?_⟩
        have hs : s(v, w) ∈ G.edgeSet := by
          rcases he with ⟨e, -, heq⟩
          simpa [heq] using e.2
        exact G.ne_of_adj (G.mem_edgeSet.mp hs)

end SimpleGraph

namespace SimpleGraph.Subgraph

/-- Helper for Exercise 4.29: a subgraph of `G` is an edge cover when every vertex of `G` is
incident to one of its edges. -/
def IsEdgeCover {G : SimpleGraph V} (H : G.Subgraph) : Prop :=
  H.support = Set.univ

/-- Helper for Exercise 4.29: in a finite graph, an edge cover has minimum cardinality when no
other edge cover of `G` uses fewer edges. -/
@[mk_iff]
structure IsMinimumCardinalityEdgeCover {G : SimpleGraph V} [Finite V] (H : G.Subgraph) :
    Prop where
  isEdgeCover : H.IsEdgeCover
  minimum (H' : G.Subgraph) (_ : H'.IsEdgeCover) : H.edgeSet.ncard ≤ H'.edgeSet.ncard

/-- Helper for Exercise 4.29: every edge cover leaves no vertex isolated in the ambient graph. -/
lemma IsEdgeCover.exists_adj {G : SimpleGraph V} {H : G.Subgraph} (hH : H.IsEdgeCover) (v : V) :
    ∃ w : V, G.Adj v w := by
  have hv : v ∈ H.support := by
    rw [hH]
    simp
  rw [Subgraph.mem_support] at hv
  rcases hv with ⟨w, hvw⟩
  exact ⟨w, H.adj_sub hvw⟩

/-- Helper for Exercise 4.29: completing a matching by adjoining an incident edge for every
uncovered vertex produces an edge cover. -/
lemma IsMatching.isEdgeCover_of_completion {G : SimpleGraph V} {M C : G.Subgraph}
    (hM : M.IsMatching) {f : {v // v ∉ M.verts} → G.edgeSet}
    (hincident : ∀ u, (u : V) ∈ ((f u : G.edgeSet) : Sym2 V))
    (hC : C.edgeSet = M.edgeSet ∪ Set.range fun u ↦ ((f u : G.edgeSet) : Sym2 V)) :
    C.IsEdgeCover := by
  rw [SimpleGraph.Subgraph.IsEdgeCover]
  apply Set.eq_univ_of_forall
  intro v
  rw [SimpleGraph.Subgraph.mem_support]
  by_cases hv : v ∈ M.verts
  · obtain ⟨w, hvw, -⟩ := hM hv
    refine ⟨w, ?_⟩
    apply (SimpleGraph.Subgraph.mem_edgeSet).mp
    rw [hC]
    exact Or.inl <| (SimpleGraph.Subgraph.mem_edgeSet).2 hvw
  · let u : {v // v ∉ M.verts} := ⟨v, hv⟩
    let w := Sym2.Mem.other (hincident u)
    refine ⟨w, ?_⟩
    apply (SimpleGraph.Subgraph.mem_edgeSet).mp
    rw [hC]
    refine Or.inr ?_
    refine ⟨u, ?_⟩
    simp [u, w]

end SimpleGraph.Subgraph

section Polytope

variable (G : SimpleGraph V) [Fintype V]

local instance : DecidableEq V := Classical.decEq V
local instance : DecidableRel G.Adj := Classical.decRel G.Adj

/-- The edge-cover polytope is the convex hull of the incidence vectors of the edge covers of
`G`. -/
def edge_cover_polytope : Set (G.edgeSet → ℝ) :=
  convexHull ℝ {x | ∃ C : G.Subgraph, C.IsEdgeCover ∧ x = G.subgraphIncidenceVector ℝ C}

/-- The polyhedron given by the standard box and vertex-incidence description of the edge-cover
polytope together with the odd-set inequalities needed for perfection. -/
def edge_cover_perfect_formulation : Set (G.edgeSet → ℝ) :=
  fun x ↦
    (∀ e : G.edgeSet, 0 ≤ x e ∧ x e ≤ 1) ∧
      (∀ v : V,
        1 ≤ (Finset.univ.filter
          fun e : G.edgeSet ↦ (e : Sym2 V) ∈ G.incidenceFinset v).sum x) ∧
      ∀ S : Set V, Odd S.ncard →
        ((S.ncard : ℝ) + 1) / 2 ≤ (E[G] S).sum x + (δ[G] S).sum x

end Polytope

section MinimumEdgeCover

variable (G : SimpleGraph V) [Finite V]

/-- Helper for Exercise 4.29: the generated subgraph has exactly as many edges as the finite edge
family used to define it. -/
private lemma edgeFamilySubgraph_edgeSet_ncard_finset (F : Finset G.edgeSet) :
    (edgeFamilySubgraph G (F : Set G.edgeSet)).edgeSet.ncard = F.card := by
  rw [edgeFamilySubgraph_edgeSet G (F : Set G.edgeSet)]
  rw [Set.ncard_image_of_injective _ Subtype.val_injective]
  simp

/-- Helper for Exercise 4.29: a matching saturates exactly two vertices per chosen edge. -/
lemma ncard_verts_eq_two_mul_ncard_edgeSet_of_isMatching {M : G.Subgraph} (hM : M.IsMatching) :
    M.verts.ncard = 2 * M.edgeSet.ncard := by
  simpa using matching_verts_ncard_eq_two_mul_edgeSet_ncard hM

/-- Helper for Exercise 4.29: once the ambient graph has no isolated vertices, every unmatched
vertex can be assigned an incident edge of `G`. -/
private noncomputable def completionEdge (M : G.Subgraph)
    (hNoIsolated : ∀ v : V, ∃ w : V, G.Adj v w) :
    {v // v ∉ M.verts} → G.edgeSet := fun u ↦
  let w := Classical.choose (hNoIsolated u)
  ⟨s((u : V), w), (G.mem_edgeSet).2 (Classical.choose_spec (hNoIsolated u))⟩

/-- Helper for Exercise 4.29: the chosen completion edge is incident to the unmatched vertex it
was selected for. -/
private lemma mem_completionEdge (M : G.Subgraph)
    {hNoIsolated : ∀ v : V, ∃ w : V, G.Adj v w} (u : {v // v ∉ M.verts}) :
    (u : V) ∈ ((completionEdge G M hNoIsolated u : G.edgeSet) : Sym2 V) := by
  -- The completion edge is defined as the chosen incident edge at `u`.
  simp [completionEdge]

/-- Helper for Exercise 4.29: the edge family obtained by keeping `M` and adjoining one chosen
incident edge for every unmatched vertex still lies in `G.edgeSet`. -/
private lemma completion_edge_family_subset_edgeSet {M : G.Subgraph}
    (hNoIsolated : ∀ v : V, ∃ w : V, G.Adj v w) :
    M.edgeSet ∪ Set.range
        (fun u : {v // v ∉ M.verts} ↦
          ((completionEdge G M hNoIsolated u : G.edgeSet) : Sym2 V)) ⊆
      G.edgeSet := by
  intro e he
  rcases he with heM | ⟨u, rfl⟩
  · exact M.edgeSet_subset heM
  · exact (completionEdge G M hNoIsolated u).property

/-- Helper for Exercise 4.29: an arbitrary completion family on the unmatched vertices of `M`
still defines edges of `G`. -/
private lemma chosen_completion_edge_family_subset_edgeSet {M : G.Subgraph}
    {f : {v // v ∉ M.verts} → G.edgeSet} :
    M.edgeSet ∪ Set.range (fun u ↦ (f u : Sym2 V)) ⊆ G.edgeSet := by
  -- Route correction: parameterize the completion family by the chosen outside edges, so the
  -- minimum-case comparison subgraph is explicit and transport-stable.
  intro e he
  rcases he with heM | ⟨u, rfl⟩
  · exact M.edgeSet_subset heM
  · exact (f u).property

/-- Helper for Exercise 4.29: the arbitrary completion family defines a subgraph of `G` via
`fromEdgeSet`. -/
private lemma chosen_completion_edge_family_fromEdgeSet_le {M : G.Subgraph}
    {f : {v // v ∉ M.verts} → G.edgeSet} :
    SimpleGraph.fromEdgeSet
        (M.edgeSet ∪ Set.range (fun u ↦ (f u : Sym2 V))) ≤
      G := by
  -- Every chosen edge already lies in the ambient edge set of `G`.
  rw [SimpleGraph.fromEdgeSet_le]
  intro e he
  exact chosen_completion_edge_family_subset_edgeSet G he.1

/-- Helper for Exercise 4.29: the arbitrary completion subgraph has the expected edge set. -/
private lemma chosen_completion_subgraph_edgeSet_eq {M : G.Subgraph}
    {f : {v // v ∉ M.verts} → G.edgeSet} :
    (G.toSubgraph
        (SimpleGraph.fromEdgeSet (M.edgeSet ∪ Set.range (fun u ↦ (f u : Sym2 V))))
        (chosen_completion_edge_family_fromEdgeSet_le G)).edgeSet =
      M.edgeSet ∪ Set.range (fun u ↦ (f u : Sym2 V)) := by
  -- The arbitrary completion family is already disjoint from the diagonal inside `G.edgeSet`.
  change
    (SimpleGraph.fromEdgeSet
      (M.edgeSet ∪ Set.range (fun u ↦ (f u : Sym2 V)))).edgeSet =
        M.edgeSet ∪ Set.range (fun u ↦ (f u : Sym2 V))
  rw [SimpleGraph.edgeSet_fromEdgeSet]
  ext e
  constructor
  · intro he
    exact he.1
  · intro he
    refine ⟨he, ?_⟩
    exact G.edgeSet_subset_compl_diagSet
      (chosen_completion_edge_family_subset_edgeSet G he)

/-- Helper for Exercise 4.29: adjoining an arbitrary incident edge for each unmatched vertex of a
matching produces an edge cover. -/
private lemma chosen_completion_subgraph_isEdgeCover_of_isMatching {M : G.Subgraph}
    (hM : M.IsMatching) {f : {v // v ∉ M.verts} → G.edgeSet}
    (hf_inc : ∀ u, (u : V) ∈ (f u : Sym2 V)) :
    (G.toSubgraph
        (SimpleGraph.fromEdgeSet (M.edgeSet ∪ Set.range (fun u ↦ (f u : Sym2 V))))
        (chosen_completion_edge_family_fromEdgeSet_le G)).IsEdgeCover :=
    by
  -- The completion theorem from Exercise 4.21 applies directly to the arbitrary chosen family.
  refine hM.isEdgeCover_of_completion
      hf_inc
      (chosen_completion_subgraph_edgeSet_eq G)

/-- Helper for Exercise 4.29: the completion edge family defines a subgraph of `G` via
`fromEdgeSet`. -/
private lemma completion_edge_family_fromEdgeSet_le {M : G.Subgraph}
    (hNoIsolated : ∀ v : V, ∃ w : V, G.Adj v w) :
    SimpleGraph.fromEdgeSet
        (M.edgeSet ∪ Set.range
          (fun u : {v // v ∉ M.verts} ↦
            ((completionEdge G M hNoIsolated u : G.edgeSet) : Sym2 V))) ≤
      G := by
  -- This is the canonical arbitrary-family completion specialized to `completionEdge`.
  let f : {v // v ∉ M.verts} → G.edgeSet := completionEdge G M hNoIsolated
  simpa using
    (chosen_completion_edge_family_fromEdgeSet_le G :
      SimpleGraph.fromEdgeSet
          (M.edgeSet ∪ Set.range (fun u ↦ (f u : Sym2 V))) ≤
        G)

/-- Helper for Exercise 4.29: the completion subgraph has exactly the expected edge set. -/
private lemma completion_subgraph_edgeSet_eq {M : G.Subgraph}
    (hNoIsolated : ∀ v : V, ∃ w : V, G.Adj v w) :
    (G.toSubgraph
        (SimpleGraph.fromEdgeSet
          (M.edgeSet ∪ Set.range
            (fun u : {v // v ∉ M.verts} ↦
              ((completionEdge G M hNoIsolated u : G.edgeSet) : Sym2 V))))
        (completion_edge_family_fromEdgeSet_le G hNoIsolated)).edgeSet =
      M.edgeSet ∪ Set.range
        (fun u : {v // v ∉ M.verts} ↦
          ((completionEdge G M hNoIsolated u : G.edgeSet) : Sym2 V)) := by
  -- This is the arbitrary-family edge-set identity specialized to `completionEdge`.
  let f : {v // v ∉ M.verts} → G.edgeSet := completionEdge G M hNoIsolated
  simpa using
    (chosen_completion_subgraph_edgeSet_eq G :
      (G.toSubgraph
          (SimpleGraph.fromEdgeSet (M.edgeSet ∪ Set.range (fun u ↦ (f u : Sym2 V))))
          (chosen_completion_edge_family_fromEdgeSet_le G)).edgeSet =
        M.edgeSet ∪ Set.range (fun u ↦ (f u : Sym2 V)))

/-- Helper for Exercise 4.29: completing a matching by one chosen edge at each unmatched vertex
produces an edge cover of `G`. -/
private lemma completion_subgraph_isEdgeCover_of_isMatching {M : G.Subgraph} (hM : M.IsMatching)
    (hNoIsolated : ∀ v : V, ∃ w : V, G.Adj v w) :
    (G.toSubgraph
        (SimpleGraph.fromEdgeSet
          (M.edgeSet ∪ Set.range
            (fun u : {v // v ∉ M.verts} ↦
              ((completionEdge G M hNoIsolated u : G.edgeSet) : Sym2 V))))
        (completion_edge_family_fromEdgeSet_le G hNoIsolated)).IsEdgeCover := by
  -- This is the arbitrary-family edge-cover construction specialized to `completionEdge`.
  let f : {v // v ∉ M.verts} → G.edgeSet := completionEdge G M hNoIsolated
  have hf_inc : ∀ u, (u : V) ∈ (f u : Sym2 V) := by
    intro u
    simpa [f] using mem_completionEdge G M u
  simpa using
    (chosen_completion_subgraph_isEdgeCover_of_isMatching G hM hf_inc)

/-- Helper for Exercise 4.29: any completion of a matching uses at most `|V| - |M|` edges. -/
lemma completion_edge_cover_ncard_le_of_isMatching
    {M C : G.Subgraph} (hM : M.IsMatching)
    {f : {v // v ∉ M.verts} → G.edgeSet}
    (hC : C.edgeSet = M.edgeSet ∪ Set.range fun u ↦ (f u : Sym2 V)) :
    C.edgeSet.ncard ≤ Nat.card V - M.edgeSet.ncard := by
  -- Count the completion edges by the unmatched vertices that chose them, then use the matching
  -- identity `|verts(M)| = 2|M|`.
  have hUnion :
      C.edgeSet.ncard ≤
        M.edgeSet.ncard + (Set.range fun u : {v // v ∉ M.verts} ↦ (f u : Sym2 V)).ncard := by
    rw [hC]
    exact Set.ncard_union_le _ _
  have hRange :
      (Set.range fun u : {v // v ∉ M.verts} ↦ (f u : Sym2 V)).ncard ≤
        Nat.card {v // v ∉ M.verts} := by
    have hImage :
        ((fun u : {v // v ∉ M.verts} ↦ (f u : Sym2 V)) ''
            (Set.univ : Set {v // v ∉ M.verts})).ncard ≤
          (Set.univ : Set {v // v ∉ M.verts}).ncard :=
      Set.ncard_image_le
    simpa [Set.image_univ, Nat.card_coe_set_eq] using hImage
  have hVerts : M.verts.ncard = 2 * M.edgeSet.ncard :=
    ncard_verts_eq_two_mul_ncard_edgeSet_of_isMatching G hM
  have hFinal :
      M.edgeSet.ncard + Nat.card {v // v ∉ M.verts} ≤ Nat.card V - M.edgeSet.ncard := by
    have hFinal' :
        M.edgeSet.ncard + (M.vertsᶜ).ncard ≤ Nat.card V - M.edgeSet.ncard := by
      have hVertsLe : 2 * M.edgeSet.ncard ≤ Nat.card V := by
        have hVertsLe' : M.verts.ncard ≤ Nat.card V := by
          simpa using Set.ncard_le_ncard M.verts.subset_univ
        rw [← hVerts]
        exact hVertsLe'
      rw [Set.ncard_compl, hVerts]
      omega
    change M.edgeSet.ncard + (M.vertsᶜ).ncard ≤ Nat.card V - M.edgeSet.ncard
    exact hFinal'
  calc
    C.edgeSet.ncard ≤
        M.edgeSet.ncard + (Set.range fun u : {v // v ∉ M.verts} ↦ (f u : Sym2 V)).ncard :=
      hUnion
    _ ≤ M.edgeSet.ncard + Nat.card {v // v ∉ M.verts} :=
      Nat.add_le_add_left hRange M.edgeSet.ncard
    _ ≤ Nat.card V - M.edgeSet.ncard := hFinal

/-- Helper for Exercise 4.29: once an edge of `C` is identified with `s(u, v)`, membership in
`C.edgeSet` can be read as the concrete adjacency `C.Adj u v`. -/
lemma adj_of_edge_eq_of_mem_edgeSet {C : G.Subgraph} {e : Sym2 V} (he : e ∈ C.edgeSet)
    {u v : V} (huv : s(u, v) = e) : C.Adj u v := by
  -- Route correction: endpoint membership alone does not determine the adjacency, so we first
  -- rewrite the abstract edge as the concrete unordered pair `s(u, v)`.
  rw [← huv] at he
  exact (Subgraph.mem_edgeSet).1 he

/-- Helper for Exercise 4.29: a vertex not covered by the internal matching of `C` must be covered
by an edge of `C` that lies outside that matching. -/
lemma unmatched_vertex_has_covering_edge_outside_internal_matching
    {C : G.Subgraph} (hC : C.IsEdgeCover) {N : C.coe.Subgraph}
    (u : {v // v ∉ (Subgraph.coeSubgraph N).verts}) :
    ∃ e ∈ C.edgeSet \ (Subgraph.coeSubgraph N).edgeSet, (u : V) ∈ e := by
  -- Because `C` is an edge cover, the unmatched vertex lies on some edge of `C`.
  have huSupport : (u : V) ∈ C.support := by
    rw [hC]
    simp
  rcases (Subgraph.mem_support C).1 huSupport with ⟨w, huw⟩
  refine ⟨s((u : V), w), ?_, ?_⟩
  · refine ⟨(Subgraph.mem_edgeSet).2 huw, ?_⟩
    intro hNedge
    -- If that same edge belonged to the internal matching, `u` would already be matched there.
    have huN : (u : V) ∈ (Subgraph.coeSubgraph N).verts :=
      (Subgraph.coeSubgraph N).edge_vert ((Subgraph.mem_edgeSet).1 hNedge)
    exact u.property huN
  · simp

/-- Helper for Exercise 4.29: adjoining a concrete outside edge with two unmatched endpoints to an
internal matching of `C` produces a strictly larger matching of `C.coe`. -/
lemma augment_internal_matching_with_concrete_outside_edge
    {C : G.Subgraph} {N : C.coe.Subgraph} (hN : N.IsMatching)
    {u v : V} (huv : u ≠ v)
    (huN : u ∉ (Subgraph.coeSubgraph N).verts)
    (hvN : v ∉ (Subgraph.coeSubgraph N).verts)
    (he : s(u, v) ∈ C.edgeSet \ (Subgraph.coeSubgraph N).edgeSet) :
    ∃ N' : C.coe.Subgraph, N'.IsMatching ∧ N.edgeSet.ncard < N'.edgeSet.ncard := by
  -- Route correction: package the coercions once by turning the concrete outside edge `s(u, v)`
  -- into the one-edge subgraph of `C.coe`.
  have hadj : C.Adj u v := (Subgraph.mem_edgeSet).1 he.1
  let uC : C.verts := ⟨u, C.edge_vert hadj⟩
  let vC : C.verts := ⟨v, C.edge_vert hadj.symm⟩
  have hadjC : C.coe.Adj uC vC := by
    simpa [uC, vC] using hadj
  let K : C.coe.Subgraph := C.coe.subgraphOfAdj hadjC
  have hK : K.IsMatching := subgraphOfAdj hadjC
  have hdisj : Disjoint N.support K.support := by
    -- The new edge uses exactly the two unmatched endpoints, so its support misses `N.support`.
    rw [hN.support_eq_verts, Set.disjoint_left]
    intro x hx hxK
    have hxK' : x = uC ∨ x = vC := by
      simpa [K, SimpleGraph.support_subgraphOfAdj] using hxK
    rcases hxK' with rfl | rfl
    · exact huN (by
        refine ⟨uC, ?_⟩
        simpa [uC] using hx)
    · exact hvN (by
        refine ⟨vC, ?_⟩
        simpa [vC] using hx)
  have hfresh : s(uC, vC) ∉ N.edgeSet := by
    -- Freshness is read on global edges by mapping `N.edgeSet` through `coeSubgraph`.
    intro hEdge
    have hGlobal : s(u, v) ∈ (Subgraph.coeSubgraph N).edgeSet := by
      rw [Subgraph.edgeSet_map]
      refine ⟨s(uC, vC), hEdge, ?_⟩
      simp [uC, vC]
    exact he.2 hGlobal
  let N' : C.coe.Subgraph := N ⊔ K
  have hN' : N'.IsMatching := hN.sup hK hdisj
  have hSubset : N.edgeSet ⊂ N'.edgeSet := by
    refine ⟨Subgraph.edgeSet_mono le_sup_left, ?_⟩
    intro hEq
    have hNew : s(uC, vC) ∈ N'.edgeSet := by
      have hKedge : s(uC, vC) ∈ K.edgeSet := by
        simpa [K] using (by
          rw [SimpleGraph.edgeSet_subgraphOfAdj]
          simp [uC, vC] :
            s(uC, vC) ∈ (C.coe.subgraphOfAdj hadjC).edgeSet)
      exact (Subgraph.edgeSet_mono le_sup_right) hKedge
    exact hfresh (hEq hNew)
  refine ⟨N', hN', ?_⟩
  -- A proper edge-set enlargement gives the strict cardinality increase.
  exact Set.ncard_lt_ncard hSubset

/-- Helper for Exercise 4.29: an outside edge of `C` cannot have two distinct endpoints unmatched
by an internal maximum matching. -/
lemma two_unmatched_vertices_on_concrete_outside_edge_eq
    {C : G.Subgraph} {N : C.coe.Subgraph} (hN : N.IsMaximumCardinalityMatching)
    {u v : V} (huv : u ≠ v)
    (huN : u ∉ (Subgraph.coeSubgraph N).verts)
    (hvN : v ∉ (Subgraph.coeSubgraph N).verts)
    (he : s(u, v) ∈ C.edgeSet \ (Subgraph.coeSubgraph N).edgeSet) : False := by
  -- A concrete outside edge with two unmatched endpoints would enlarge the internal matching.
  rcases augment_internal_matching_with_concrete_outside_edge
      G hN.isMatching huv huN hvN he with ⟨N', hN', hlt⟩
  exact Nat.not_lt_of_ge (hN.maximum N' hN') hlt

/-- Helper for Exercise 4.29: the chosen covering edge for each unmatched vertex is injective once
two-unmatched-endpoint outside edges are ruled out. -/
lemma covering_edge_choice_injective
    {C : G.Subgraph} {N : C.coe.Subgraph} (hN : N.IsMaximumCardinalityMatching)
    {f : {x // x ∉ (Subgraph.coeSubgraph N).verts} → G.edgeSet}
    (hf_out : ∀ u, (f u : Sym2 V) ∈ C.edgeSet \ (Subgraph.coeSubgraph N).edgeSet)
    (hf_inc : ∀ u, (u : V) ∈ (f u : Sym2 V)) :
    Function.Injective f := by
  intro u v huv
  apply Subtype.ext
  by_contra huv_ne
  -- The common covering edge contains both endpoints, so it must be the concrete edge `s(u, v)`.
  have hmem :
      (u : V) ∈ ((f u : G.edgeSet) : Sym2 V) ∧
        (v : V) ∈ ((f u : G.edgeSet) : Sym2 V) := by
    refine ⟨hf_inc u, ?_⟩
    simpa [huv] using hf_inc v
  have hEdgeEq : ((f u : G.edgeSet) : Sym2 V) = s((u : V), (v : V)) :=
    (Sym2.mem_and_mem_iff huv_ne).mp hmem
  have hOutside : s((u : V), (v : V)) ∈ C.edgeSet \ (Subgraph.coeSubgraph N).edgeSet := by
    simpa [hEdgeEq] using hf_out u
  exact two_unmatched_vertices_on_concrete_outside_edge_eq
    G hN huv_ne u.property v.property hOutside

/-- Helper for Exercise 4.29: every edge cover is at least as large as the Gallai lower bound
coming from an internal maximum matching. -/
lemma edge_cover_card_ge_nat_card_sub_internal_maximum_matching
    {C : G.Subgraph} (hC : C.IsEdgeCover) {N : C.coe.Subgraph}
    (hN : N.IsMaximumCardinalityMatching) :
    Nat.card V - (Subgraph.coeSubgraph N).edgeSet.ncard ≤ C.edgeSet.ncard := by
  -- Route correction: the lower bound now goes through the explicit covering-edge map from
  -- unmatched vertices into `C.edgeSet \ (Subgraph.coeSubgraph N).edgeSet`.
  classical
  let f : {v // v ∉ (Subgraph.coeSubgraph N).verts} → G.edgeSet := fun u ↦
    ⟨Classical.choose
        (unmatched_vertex_has_covering_edge_outside_internal_matching
          G hC u),
      C.edgeSet_subset
        (Classical.choose_spec
          (unmatched_vertex_has_covering_edge_outside_internal_matching
            G hC u)).1.1⟩
  have hf_out : ∀ u, (f u : Sym2 V) ∈ C.edgeSet \ (Subgraph.coeSubgraph N).edgeSet := by
    intro u
    exact (Classical.choose_spec
      (unmatched_vertex_has_covering_edge_outside_internal_matching
        G hC u)).1
  have hf_inc : ∀ u, (u : V) ∈ (f u : Sym2 V) := by
    intro u
    exact (Classical.choose_spec
      (unmatched_vertex_has_covering_edge_outside_internal_matching
        G hC u)).2
  have hf_inj : Function.Injective f :=
    covering_edge_choice_injective G hN hf_out hf_inc
  have hRangeSubset :
      Set.range (fun u : {v // v ∉ (Subgraph.coeSubgraph N).verts} ↦ (f u : Sym2 V)) ⊆
        C.edgeSet \ (Subgraph.coeSubgraph N).edgeSet := by
    rintro e ⟨u, rfl⟩
    exact hf_out u
  have hRangeCard :
      (Set.range fun u : {v // v ∉ (Subgraph.coeSubgraph N).verts} ↦ (f u : Sym2 V)).ncard =
        Nat.card {v // v ∉ (Subgraph.coeSubgraph N).verts} := by
    exact Set.ncard_range_of_injective (Subtype.val_injective.comp hf_inj)
  have hRangeLe :
      Nat.card {v // v ∉ (Subgraph.coeSubgraph N).verts} ≤
        (C.edgeSet \ (Subgraph.coeSubgraph N).edgeSet).ncard := by
    rw [← hRangeCard]
    exact Set.ncard_le_ncard hRangeSubset
  have hVerts :
      (Subgraph.coeSubgraph N).verts.ncard =
        2 * (Subgraph.coeSubgraph N).edgeSet.ncard :=
    ncard_verts_eq_two_mul_ncard_edgeSet_of_isMatching G hN.isMatching.coeSubgraph
  have hCompl :
      Nat.card {v // v ∉ (Subgraph.coeSubgraph N).verts} =
        Nat.card V - 2 * (Subgraph.coeSubgraph N).edgeSet.ncard := by
    classical
    let N₀ : G.Subgraph := Subgraph.coeSubgraph N
    letI : Fintype V := Fintype.ofFinite V
    letI : Fintype N₀.verts := Fintype.ofFinite N₀.verts
    calc
      Nat.card {v // v ∉ N₀.verts} = Nat.card V - Nat.card N₀.verts := by
        rw [Nat.card_eq_fintype_card, Nat.card_eq_fintype_card, Nat.card_eq_fintype_card]
        exact Fintype.card_subtype_compl fun v : V ↦ v ∈ N₀.verts
      _ = Nat.card V - N₀.verts.ncard := by rw [Nat.card_coe_set_eq]
      _ = Nat.card V - 2 * N₀.edgeSet.ncard := by rw [hVerts]
  have hDiffLower :
      Nat.card V - 2 * (Subgraph.coeSubgraph N).edgeSet.ncard ≤
        (C.edgeSet \ (Subgraph.coeSubgraph N).edgeSet).ncard := by
    rw [← hCompl]
    exact hRangeLe
  have hSubset : (Subgraph.coeSubgraph N).edgeSet ⊆ C.edgeSet :=
    Subgraph.edgeSet_mono (Subgraph.coeSubgraph_le N)
  have hSplit :
      (C.edgeSet \ (Subgraph.coeSubgraph N).edgeSet).ncard +
          (Subgraph.coeSubgraph N).edgeSet.ncard =
        C.edgeSet.ncard :=
    Set.ncard_diff_add_ncard_of_subset hSubset
  have hMain :
      Nat.card V - (Subgraph.coeSubgraph N).edgeSet.ncard ≤
        (C.edgeSet \ (Subgraph.coeSubgraph N).edgeSet).ncard +
          (Subgraph.coeSubgraph N).edgeSet.ncard := by
    omega
  rw [hSplit] at hMain
  exact hMain

/-- Helper for Exercise 4.29: minimumity forces the outside edges of `C` to be exactly the range
of any chosen covering-edge family on the vertices unmatched by an internal maximum matching. -/
lemma outside_edge_diff_eq_range_of_minimumity
    {C : G.Subgraph} (hC : C.IsMinimumCardinalityEdgeCover) {N : C.coe.Subgraph}
    (hN : N.IsMaximumCardinalityMatching)
    {f : {v // v ∉ (Subgraph.coeSubgraph N).verts} → G.edgeSet}
    (hf_out : ∀ u, (f u : Sym2 V) ∈ C.edgeSet \ (Subgraph.coeSubgraph N).edgeSet)
    (hf_inc : ∀ u, (u : V) ∈ (f u : Sym2 V)) :
    C.edgeSet \ (Subgraph.coeSubgraph N).edgeSet = Set.range (fun u ↦ (f u : Sym2 V)) := by
  classical
  let N₀ : G.Subgraph := Subgraph.coeSubgraph N
  let D : G.Subgraph :=
    G.toSubgraph
      (SimpleGraph.fromEdgeSet (N₀.edgeSet ∪ Set.range (fun u ↦ (f u : Sym2 V))))
      (chosen_completion_edge_family_fromEdgeSet_le G)
  have hDcover : D.IsEdgeCover := by
    -- The comparison subgraph is the chosen completion of the internal matching `N₀`.
    simpa [D, N₀] using
      (chosen_completion_subgraph_isEdgeCover_of_isMatching
        G hN.isMatching.coeSubgraph hf_inc)
  have hC_le : C.edgeSet.ncard ≤ D.edgeSet.ncard :=
    hC.minimum D hDcover
  have hD_edgeSet :
      D.edgeSet = N₀.edgeSet ∪ Set.range (fun u ↦ (f u : Sym2 V)) := by
    -- This turns the comparison against `D` into a concrete set-cardinality statement.
    change
      (SimpleGraph.fromEdgeSet (N₀.edgeSet ∪ Set.range (fun u ↦ (f u : Sym2 V)))).edgeSet =
        N₀.edgeSet ∪ Set.range (fun u ↦ (f u : Sym2 V))
    rw [SimpleGraph.edgeSet_fromEdgeSet]
    ext e
    constructor
    · intro he
      exact he.1
    · intro he
      refine ⟨he, ?_⟩
      exact G.edgeSet_subset_compl_diagSet
        (chosen_completion_edge_family_subset_edgeSet G he)
  have hD_le : D.edgeSet.ncard ≤ Nat.card V - N₀.edgeSet.ncard := by
    -- Any completion of a matching uses at most one extra edge per unmatched vertex.
    simpa [N₀] using
      (completion_edge_cover_ncard_le_of_isMatching
        G hN.isMatching.coeSubgraph hD_edgeSet)
  have hLower : Nat.card V - N₀.edgeSet.ncard ≤ C.edgeSet.ncard :=
    edge_cover_card_ge_nat_card_sub_internal_maximum_matching
      G hC.isEdgeCover hN
  have hCardEq : C.edgeSet.ncard = Nat.card V - N₀.edgeSet.ncard := by
    apply le_antisymm
    · exact le_trans hC_le hD_le
    · exact hLower
  have hSubset : N₀.edgeSet ⊆ C.edgeSet :=
    Subgraph.edgeSet_mono (Subgraph.coeSubgraph_le N)
  have hDiffCard :
      (C.edgeSet \ N₀.edgeSet).ncard = Nat.card V - 2 * N₀.edgeSet.ncard := by
    -- Splitting `C.edgeSet` into the internal matching edges and the outside edges isolates the
    -- unmatched-vertex contribution.
    have hSplit :
        (C.edgeSet \ N₀.edgeSet).ncard + N₀.edgeSet.ncard = C.edgeSet.ncard :=
      Set.ncard_diff_add_ncard_of_subset hSubset
    rw [hCardEq] at hSplit
    omega
  have hVerts :
      N₀.verts.ncard = 2 * N₀.edgeSet.ncard :=
    ncard_verts_eq_two_mul_ncard_edgeSet_of_isMatching
      G hN.isMatching.coeSubgraph
  have hCompl :
      Nat.card {v // v ∉ N₀.verts} = Nat.card V - 2 * N₀.edgeSet.ncard := by
    have hCompl' : (N₀.vertsᶜ).ncard = Nat.card V - 2 * N₀.edgeSet.ncard := by
      rw [Set.ncard_compl, hVerts]
    simpa [Nat.card_coe_set_eq] using hCompl'
  have hf_inj : Function.Injective f :=
    covering_edge_choice_injective G hN hf_out hf_inc
  have hRangeCard :
      (Set.range fun u : {v // v ∉ N₀.verts} ↦ (f u : Sym2 V)).ncard =
        Nat.card {v // v ∉ N₀.verts} := by
    exact Set.ncard_range_of_injective (Subtype.val_injective.comp hf_inj)
  have hDiffEqRangeCard :
      (C.edgeSet \ N₀.edgeSet).ncard =
        (Set.range fun u : {v // v ∉ N₀.verts} ↦ (f u : Sym2 V)).ncard := by
    rw [hDiffCard, hRangeCard, hCompl]
  have hRangeSubset :
      Set.range (fun u : {v // v ∉ N₀.verts} ↦ (f u : Sym2 V)) ⊆ C.edgeSet \ N₀.edgeSet := by
    rintro e ⟨u, rfl⟩
    exact hf_out u
  have hDiffLe :
      (C.edgeSet \ N₀.edgeSet).ncard ≤
        (Set.range fun u : {v // v ∉ N₀.verts} ↦ (f u : Sym2 V)).ncard := by
    exact le_of_eq hDiffEqRangeCard
  -- The chosen outside edges already sit inside the outside part of `C`, so equal cardinalities
  -- upgrade the inclusion to equality.
  exact (Set.eq_of_subset_of_ncard_le hRangeSubset hDiffLe).symm

/-- Helper for Exercise 4.29: a minimum edge cover decomposes into an internal maximum matching
plus one edge for each unmatched vertex of that matching. -/
lemma exists_completion_from_internal_maximum_matching_of_minimum_edge_cover
    {C : G.Subgraph} (hC : C.IsMinimumCardinalityEdgeCover) {N : C.coe.Subgraph}
    (hN : N.IsMaximumCardinalityMatching) :
    ∃ f : {v // v ∉ (Subgraph.coeSubgraph N).verts} → G.edgeSet,
      (∀ u, (u : V) ∈ (f u : Sym2 V)) ∧
        C.edgeSet = (Subgraph.coeSubgraph N).edgeSet ∪ Set.range fun u ↦ (f u : Sym2 V) := by
  -- Route correction: after the Gallai lower bound is exact in the minimum case, identify
  -- `C.edgeSet \ (Subgraph.coeSubgraph N).edgeSet` with the range of the chosen covering-edge map
  -- by equal finite cardinalities.
  classical
  let N₀ : G.Subgraph := Subgraph.coeSubgraph N
  let f : {v // v ∉ N₀.verts} → G.edgeSet := fun u ↦
    ⟨Classical.choose
        (unmatched_vertex_has_covering_edge_outside_internal_matching
          G hC.isEdgeCover u),
      C.edgeSet_subset
        (Classical.choose_spec
          (unmatched_vertex_has_covering_edge_outside_internal_matching
            G hC.isEdgeCover u)).1.1⟩
  have hf_out : ∀ u, (f u : Sym2 V) ∈ C.edgeSet \ N₀.edgeSet := by
    intro u
    exact (Classical.choose_spec
      (unmatched_vertex_has_covering_edge_outside_internal_matching
        G hC.isEdgeCover u)).1
  have hf_inc : ∀ u, (u : V) ∈ (f u : Sym2 V) := by
    intro u
    exact (Classical.choose_spec
      (unmatched_vertex_has_covering_edge_outside_internal_matching
        G hC.isEdgeCover u)).2
  refine ⟨f, hf_inc, ?_⟩
  have hDiffEq :
      C.edgeSet \ N₀.edgeSet = Set.range (fun u ↦ (f u : Sym2 V)) :=
    outside_edge_diff_eq_range_of_minimumity
      G hC hN hf_out hf_inc
  have hSubset : N₀.edgeSet ⊆ C.edgeSet :=
    Subgraph.edgeSet_mono (Subgraph.coeSubgraph_le N)
  -- Reassemble `C.edgeSet` from its internal matching edges and the outside edges just identified.
  calc
    C.edgeSet = N₀.edgeSet ∪ (C.edgeSet \ N₀.edgeSet) := by
      symm
      exact Set.union_diff_cancel hSubset
    _ = N₀.edgeSet ∪ Set.range (fun u ↦ (f u : Sym2 V)) := by rw [hDiffEq]

/-- Exercise 4.29 (1). An edge cover `C` has minimum cardinality if and only if it arises from a
maximum-cardinality matching `M` by adjoining, for each vertex not covered by `M`, an edge of `G`
incident to that vertex. -/
theorem is_minimum_cardinality_edge_cover_iff_exists_maximum_cardinality_matching
    {C : G.Subgraph} :
    C.IsMinimumCardinalityEdgeCover ↔
      ∃ M : G.Subgraph,
        ∃ f : {v // v ∉ M.verts} → G.edgeSet,
          M.IsMaximumCardinalityMatching ∧
            (∀ u, (u : V) ∈ (f u : Sym2 V)) ∧
            C.edgeSet = M.edgeSet ∪ Set.range fun u ↦ (f u : Sym2 V) := by
  classical
  constructor
  · intro hC
    obtain ⟨N, hNmax⟩ : ∃ N : C.coe.Subgraph, N.IsMaximumCardinalityMatching :=
      Subgraph.exists_isMaximumCardinalityMatching
    -- Route correction: the proof works through an internal maximum matching of `C`, then upgrades
    -- it to a global maximum by comparing minimum edge-cover cardinalities with matching
    -- completions.
    obtain ⟨f, hincident, hdecomp⟩ :
        ∃ f : {v // v ∉ (Subgraph.coeSubgraph N).verts} → G.edgeSet,
          (∀ u, (u : V) ∈ (f u : Sym2 V)) ∧
            C.edgeSet = (Subgraph.coeSubgraph N).edgeSet ∪ Set.range fun u ↦ (f u : Sym2 V) :=
      exists_completion_from_internal_maximum_matching_of_minimum_edge_cover
        G hC hNmax
    refine ⟨Subgraph.coeSubgraph N, f, ?_, hincident, hdecomp⟩
    refine ⟨hNmax.isMatching.coeSubgraph, ?_⟩
    intro M hM
    let hNoIsolated : ∀ v : V, ∃ w : V, G.Adj v w := fun v ↦
      hC.isEdgeCover.exists_adj v
    let D : G.Subgraph :=
      G.toSubgraph
        (SimpleGraph.fromEdgeSet
          (M.edgeSet ∪ Set.range
            (fun u : {v // v ∉ M.verts} ↦
              ((completionEdge G M hNoIsolated u : G.edgeSet) : Sym2 V))))
        (completion_edge_family_fromEdgeSet_le G hNoIsolated)
    -- Compare the given minimum edge cover `C` with the canonical completion of the arbitrary
    -- matching `M`.
    have hDcover : D.IsEdgeCover := by
      simpa [D] using
        completion_subgraph_isEdgeCover_of_isMatching G hM hNoIsolated
    have hC_le : C.edgeSet.ncard ≤ D.edgeSet.ncard :=
      hC.minimum D hDcover
    have hD_le : D.edgeSet.ncard ≤ Nat.card V - M.edgeSet.ncard := by
      simpa [D] using
        completion_edge_cover_ncard_le_of_isMatching
          G hM (completion_subgraph_edgeSet_eq G hNoIsolated)
    -- The internal maximum matching inside `C` already attains the global maximum size by the
    -- Gallai lower bound.
    have hLower :
        Nat.card V - (Subgraph.coeSubgraph N).edgeSet.ncard ≤ C.edgeSet.ncard :=
      edge_cover_card_ge_nat_card_sub_internal_maximum_matching
        G hC.isEdgeCover hNmax
    have hCompare :
        Nat.card V - (Subgraph.coeSubgraph N).edgeSet.ncard ≤ Nat.card V - M.edgeSet.ncard :=
      le_trans hLower (le_trans hC_le hD_le)
    have hNVertsLe : 2 * (Subgraph.coeSubgraph N).edgeSet.ncard ≤ Nat.card V := by
      have hVerts :
          (Subgraph.coeSubgraph N).verts.ncard =
            2 * (Subgraph.coeSubgraph N).edgeSet.ncard :=
        ncard_verts_eq_two_mul_ncard_edgeSet_of_isMatching
          G hNmax.isMatching.coeSubgraph
      have hVertsLe : (Subgraph.coeSubgraph N).verts.ncard ≤ Nat.card V := by
        simpa using Set.ncard_le_ncard (Subgraph.coeSubgraph N).verts.subset_univ
      rw [hVerts] at hVertsLe
      exact hVertsLe
    have hMVertsLe : 2 * M.edgeSet.ncard ≤ Nat.card V := by
      have hVerts : M.verts.ncard = 2 * M.edgeSet.ncard :=
        ncard_verts_eq_two_mul_ncard_edgeSet_of_isMatching G hM
      have hVertsLe : M.verts.ncard ≤ Nat.card V := by
        simpa using Set.ncard_le_ncard M.verts.subset_univ
      rw [hVerts] at hVertsLe
      exact hVertsLe
    omega
  · rintro ⟨M, f, hMmax, hincident, hC⟩
    refine ⟨hMmax.isMatching.isEdgeCover_of_completion hincident hC, ?_⟩
    intro C' hC'
    obtain ⟨N, hNmaxInC'⟩ : ∃ N : C'.coe.Subgraph, N.IsMaximumCardinalityMatching :=
      Subgraph.exists_isMaximumCardinalityMatching
    -- Compare the proposed completion of `M` against an arbitrary edge cover `C'`.
    have hUpper :
        C.edgeSet.ncard ≤ Nat.card V - M.edgeSet.ncard :=
      completion_edge_cover_ncard_le_of_isMatching
        G hMmax.isMatching hC
    have hLower :
        Nat.card V - (Subgraph.coeSubgraph N).edgeSet.ncard ≤ C'.edgeSet.ncard :=
      edge_cover_card_ge_nat_card_sub_internal_maximum_matching
        G hC' hNmaxInC'
    -- The global maximum property of `M` dominates the internal maximum matching extracted from
    -- `C'`, so the Gallai lower bound for `C'` is at least the completion size of `M`.
    have hN_le_M :
        (Subgraph.coeSubgraph N).edgeSet.ncard ≤ M.edgeSet.ncard :=
      hMmax.maximum (Subgraph.coeSubgraph N) hNmaxInC'.isMatching.coeSubgraph
    have hBridge :
        Nat.card V - M.edgeSet.ncard ≤
          Nat.card V - (Subgraph.coeSubgraph N).edgeSet.ncard := by
      omega
    exact le_trans hUpper (le_trans hBridge hLower)

end MinimumEdgeCover

section PolytopeTheorem

variable (G : SimpleGraph V) [Fintype V]

/-- Exercise 4.29 (2). The edge-cover polytope of `G` is exactly the polyhedron cut out in the
edge space of `G` by the box constraints `0 ≤ x_e ≤ 1`, the vertex-incidence inequalities
`x(δ(v)) ≥ 1` for every vertex `v`, and the odd-set inequalities
`(|S| + 1) / 2 ≤ x(E[S]) + x(δ(S))` for every odd-cardinality vertex set `S`. -/
theorem edge_cover_polytope_eq_perfect_formulation :
    edge_cover_polytope G = edge_cover_perfect_formulation G := by
  ext x
  simp [edge_cover_polytope, edge_cover_perfect_formulation]

end PolytopeTheorem

end Exercise_4_29
