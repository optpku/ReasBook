import IntegerProgramming_Conforti_2014.Integer.Chapters.Chap09.section_9_1.ch9_sec9_1_1_theorem_9_4

-- Declarations for this item will be appended below by the statement pipeline.

-- Layer triage:
-- * source-facing statement: the first vector bound for a reduced basis and a shortest nonzero
--   lattice vector
-- * core/canonical owner: the Chapter 9 predicate `IsReducedBasis`
-- * source-facing lattice object: `b.integerSpan`
