open InnerProductSpace Module
open scoped BigOperators

universe u

section Exercise95

variable {n : ℕ} {E : Type u} [NormedAddCommGroup E] [InnerProductSpace ℝ E]

/-- The lattice generated by a real basis is the `ℤ`-span of its vectors. -/
abbrev Module.Basis.integerSpan (b : Basis (Fin n) ℝ E) : Submodule ℤ E :=
  Submodule.span ℤ (Set.range b)

namespace Submodule

/-- A vector is shortest nonzero in `Λ` when it lies in `Λ`, is nonzero, and no other nonzero
vector of `Λ` has smaller norm. -/
def IsShortestNonzeroVector (Λ : Submodule ℤ E) (u : E) : Prop :=
  u ∈ Λ ∧ u ≠ 0 ∧ ∀ v ∈ Λ, v ≠ 0 → ‖u‖ ≤ ‖v‖

omit [InnerProductSpace ℝ E] in
theorem IsShortestNonzeroVector.mem
    {Λ : Submodule ℤ E} {u : E}
    (hu : Λ.IsShortestNonzeroVector u) :
    u ∈ Λ :=
  hu.1

omit [InnerProductSpace ℝ E] in
theorem IsShortestNonzeroVector.ne_zero
    {Λ : Submodule ℤ E} {u : E}
    (hu : Λ.IsShortestNonzeroVector u) :
    u ≠ 0 :=
  hu.2.1

omit [InnerProductSpace ℝ E] in
theorem IsShortestNonzeroVector.norm_le
    {Λ : Submodule ℤ E} {u v : E}
    (hu : Λ.IsShortestNonzeroVector u)
    (hv : v ∈ Λ)
    (hv_ne : v ≠ 0) :
    ‖u‖ ≤ ‖v‖ :=
  hu.2.2 v hv hv_ne

end Submodule

/-- Helper for Exercise 9.5: a nonzero vector in `b.integerSpan` admits integer coordinates with a
last nonzero coefficient. -/
lemma existsLastNonzeroIntegerCoeff
    (b : Basis (Fin n) ℝ E) {u : E}
    (hu : u ∈ b.integerSpan)
    (hu_ne : u ≠ 0) :
    ∃ coeff : Fin n → ℤ, ∃ j : Fin n,
      (∑ i, (coeff i : ℝ) • b i) = u ∧
      coeff j ≠ 0 ∧
      ∀ i : Fin n, j < i → coeff i = 0 := by
  obtain ⟨coeff, hcoeff⟩ :=
    (Submodule.mem_span_range_iff_exists_fun ℤ).mp (by
      simpa [Module.Basis.integerSpan] using hu)
  have hcoeff_real : (∑ i, (coeff i : ℝ) • b i) = u := by
    simpa [← Int.cast_smul_eq_zsmul ℝ] using hcoeff
  let support : Finset (Fin n) := Finset.univ.filter fun i : Fin n ↦ coeff i ≠ 0
  have hsupport_nonempty : support.Nonempty := by
    by_contra hsupport
    have hsupport_eq : support = ∅ := Finset.not_nonempty_iff_eq_empty.mp hsupport
    have hcoeff_zero : ∀ i : Fin n, coeff i = 0 := by
      intro i
      have hi_not_mem : i ∉ support := by
        simp [hsupport_eq]
      have hi_zero : coeff i = 0 := by
        simpa [support] using hi_not_mem
      exact hi_zero
    have hu_zero : u = 0 := by
      calc
        u = ∑ i, (coeff i : ℝ) • b i := hcoeff_real.symm
        _ = 0 := by
          simp [hcoeff_zero]
    exact hu_ne hu_zero
  let j : Fin n := support.max' hsupport_nonempty
  have hj_mem : j ∈ support := Finset.max'_mem support hsupport_nonempty
  have hcoeffj : coeff j ≠ 0 := by
    simpa [support] using (Finset.mem_filter.mp hj_mem).2
  refine ⟨coeff, j, hcoeff_real, hcoeffj, ?_⟩
  intro i hji
  by_contra hi_ne
  have hi_mem : i ∈ support := by
    simp [support, hi_ne]
  have hi_le : i ≤ j := Finset.le_max' support i hi_mem
  exact (not_le_of_gt hji) hi_le

/-- Helper for Exercise 9.5: the `j`-th Gram-Schmidt vector pairs with `b j` by its norm square. -/
lemma gramSchmidtSelfInner_eq_normSq
    (b : Basis (Fin n) ℝ E) (j : Fin n) :
    ⟪gramSchmidt ℝ b j, b j⟫_ℝ = ‖gramSchmidt ℝ b j‖ ^ 2 := by
  -- Expand `b j` into its Gram-Schmidt part plus earlier orthogonal directions.
  rw [gramSchmidt_def'' ℝ b j]
  simp only [inner_add_right, inner_sum, inner_smul_right]
  have hsum :
      ∑ i ∈ Finset.Iio j,
        (⟪gramSchmidt ℝ b i, b j⟫_ℝ / ‖gramSchmidt ℝ b i‖ ^ 2) *
          ⟪gramSchmidt ℝ b j, gramSchmidt ℝ b i⟫_ℝ = 0 := by
    apply Finset.sum_eq_zero
    intro i hi
    have hij : i < j := Finset.mem_Iio.mp hi
    simp [gramSchmidt_orthogonal ℝ b hij.ne']
  simp [hsum]

/-- Helper for Exercise 9.5: the last nonzero lattice coefficient forces the vector norm to
dominate the corresponding Gram-Schmidt length. -/
lemma lastNonzeroCoeffGramSchmidt_normSq_le
    (b : Basis (Fin n) ℝ E) {u : E}
    (coeff : Fin n → ℤ) (j : Fin n)
    (hu : (∑ i, (coeff i : ℝ) • b i) = u)
    (hcoeffj : coeff j ≠ 0)
    (hupper : ∀ i : Fin n, j < i → coeff i = 0) :
    ‖gramSchmidt ℝ b j‖ ^ 2 ≤ ‖u‖ ^ 2 := by
  let e : Fin n → E := gramSchmidtNormed ℝ b
  have he_orth : Orthonormal ℝ e := gramSchmidtNormed_orthonormal (𝕜 := ℝ) b.linearIndependent
  have hg_ne : gramSchmidt ℝ b j ≠ 0 := by
    exact InnerProductSpace.gramSchmidt_ne_zero (𝕜 := ℝ) (f := b) j b.linearIndependent
  have hnorm_ne : ‖gramSchmidt ℝ b j‖ ≠ 0 := norm_ne_zero_iff.mpr hg_ne
  -- Bessel's inequality on the singleton `{j}` reduces the problem to computing one coefficient.
  have hcoord_bound : ‖⟪e j, u⟫_ℝ‖ ^ 2 ≤ ‖u‖ ^ 2 := by
    simpa using (he_orth.sum_inner_products_le (x := u) (s := ({j} : Finset (Fin n))))
  have hcoord :
      ⟪e j, u⟫_ℝ = (coeff j : ℝ) * ‖gramSchmidt ℝ b j‖ := by
    -- All coefficients above `j` vanish by construction, and all coefficients below `j`
    -- are orthogonal to the normalized `j`-th Gram-Schmidt direction.
    rw [← hu, inner_sum, Finset.sum_eq_single j]
    · calc
        ⟪e j, (coeff j : ℝ) • b j⟫_ℝ
            = ⟪gramSchmidtNormed ℝ b j, (coeff j : ℝ) • b j⟫_ℝ := by
              rfl
        _ = (‖gramSchmidt ℝ b j‖ : ℝ)⁻¹ *
                ⟪gramSchmidt ℝ b j, (coeff j : ℝ) • b j⟫_ℝ := by
              simp [gramSchmidtNormed, inner_smul_left]
        _ = (‖gramSchmidt ℝ b j‖ : ℝ)⁻¹ * ((coeff j : ℝ) *
              ⟪gramSchmidt ℝ b j, b j⟫_ℝ) := by
              rw [inner_smul_right]
        _ = (‖gramSchmidt ℝ b j‖ : ℝ)⁻¹ * (coeff j : ℝ) * ‖gramSchmidt ℝ b j‖ ^ 2 := by
              rw [gramSchmidtSelfInner_eq_normSq b j]
              ring
        _ = (coeff j : ℝ) * ‖gramSchmidt ℝ b j‖ := by
              field_simp [hnorm_ne]
    · intro i _ hij
      rcases lt_or_gt_of_ne hij with hij_lt | hij_gt
      · have htri : ⟪gramSchmidt ℝ b j, b i⟫_ℝ = 0 := gramSchmidt_inv_triangular ℝ b hij_lt
        have hinner : ⟪e j, b i⟫_ℝ = 0 := by
          change ⟪gramSchmidtNormed ℝ b j, b i⟫_ℝ = 0
          rw [gramSchmidtNormed, inner_smul_left, htri]
          ring
        rw [inner_smul_right, hinner]
        ring
      · have hcoeffi : coeff i = 0 := hupper i hij_gt
        rw [inner_smul_right, hcoeffi]
        ring
    · intro hj_not_mem
      exact (hj_not_mem (Finset.mem_univ j)).elim
  have hcoeff_norm : (1 : ℝ) ≤ ‖(coeff j : ℝ)‖ := by
    have hcoeff_natAbs_pos : 0 < Int.natAbs (coeff j) := Int.natAbs_pos.mpr hcoeffj
    have hcoeff_natAbs_ge : 1 ≤ Int.natAbs (coeff j) := Nat.succ_le_of_lt hcoeff_natAbs_pos
    have hcoeff_cast : (1 : ℝ) ≤ (Int.natAbs (coeff j) : ℝ) := by
      exact_mod_cast hcoeff_natAbs_ge
    simpa [Int.norm_cast_real, Nat.cast_natAbs] using hcoeff_cast
  have hcoeff_norm_sq : (1 : ℝ) ≤ ‖(coeff j : ℝ)‖ ^ 2 := by
    have hcoeff_norm_nonneg : 0 ≤ ‖(coeff j : ℝ)‖ := norm_nonneg _
    nlinarith
  have hgs_coord :
      ‖gramSchmidt ℝ b j‖ ^ 2 ≤ ‖⟪e j, u⟫_ℝ‖ ^ 2 := by
    rw [hcoord, norm_mul, norm_norm, pow_two]
    have hgs_nonneg : 0 ≤ ‖gramSchmidt ℝ b j‖ := norm_nonneg _
    nlinarith
  exact le_trans hgs_coord hcoord_bound

/-- Helper for Exercise 9.5: adjacent Gram-Schmidt lengths of a reduced basis differ by at most a
factor of `√2`, expressed on squared norms. -/
lemma adjacentGramSchmidt_normSq_le_two_mul
    (b : Basis (Fin n) ℝ E)
    (h_reduced : IsReducedBasis b)
    (j : Fin (n - 1)) :
    let i : Fin n := ⟨j.1, Nat.lt_of_lt_pred j.2⟩
    let i' : Fin n := ⟨j.1 + 1, Nat.succ_lt_of_lt_pred j.2⟩
    ‖gramSchmidt ℝ b i‖ ^ 2 ≤ 2 * ‖gramSchmidt ℝ b i'‖ ^ 2 := by
  let i : Fin n := ⟨j.1, Nat.lt_of_lt_pred j.2⟩
  let i' : Fin n := ⟨j.1 + 1, Nat.succ_lt_of_lt_pred j.2⟩
  have hii' : i < i' := by
    simp [i, i']
  have hstep :
      ‖gramSchmidt ℝ b i‖ ≤
        ‖gramSchmidt ℝ b i' + (gram_schmidt_coefficient b i' i) • gramSchmidt ℝ b i‖ := by
    simpa [basis_reduction_condition_ii, i, i', coe_gramSchmidtBasis] using
      (h_reduced.condition_ii j)
  have hstep_sq :
      ‖gramSchmidt ℝ b i‖ ^ 2 ≤
        ‖gramSchmidt ℝ b i' + (gram_schmidt_coefficient b i' i) • gramSchmidt ℝ b i‖ ^ 2 := by
    exact (sq_le_sq₀ (norm_nonneg _) (norm_nonneg _)).mpr hstep
  have hmu :
      |gram_schmidt_coefficient b i' i| ≤ (1 : ℝ) / 2 :=
    h_reduced.condition_i hii'
  have hmu_left :
      -(1 / 2 : ℝ) ≤ gram_schmidt_coefficient b i' i := by
    exact (abs_le.mp hmu).1
  have hmu_right :
      gram_schmidt_coefficient b i' i ≤ (1 : ℝ) / 2 := by
    exact (abs_le.mp hmu).2
  have hmu_sq :
      (gram_schmidt_coefficient b i' i) ^ 2 ≤ (1 : ℝ) / 4 := by
    nlinarith
  have horth :
      ⟪gramSchmidt ℝ b i', (gram_schmidt_coefficient b i' i) • gramSchmidt ℝ b i⟫_ℝ = 0 := by
    simp [inner_smul_right, gramSchmidt_orthogonal ℝ b hii'.ne']
  have hnorm_add :
      ‖gramSchmidt ℝ b i' + (gram_schmidt_coefficient b i' i) • gramSchmidt ℝ b i‖ ^ 2 =
        ‖gramSchmidt ℝ b i'‖ ^ 2 +
          ‖(gram_schmidt_coefficient b i' i) • gramSchmidt ℝ b i‖ ^ 2 := by
    simpa [pow_two] using norm_add_sq_eq_norm_sq_add_norm_sq_real horth
  have hnorm_smul :
      ‖(gram_schmidt_coefficient b i' i) • gramSchmidt ℝ b i‖ ^ 2 =
        (gram_schmidt_coefficient b i' i) ^ 2 * ‖gramSchmidt ℝ b i‖ ^ 2 := by
    rw [norm_smul, Real.norm_eq_abs, pow_two]
    calc
      (|gram_schmidt_coefficient b i' i| * ‖gramSchmidt ℝ b i‖) *
          (|gram_schmidt_coefficient b i' i| * ‖gramSchmidt ℝ b i‖)
          = |gram_schmidt_coefficient b i' i| ^ 2 * ‖gramSchmidt ℝ b i‖ ^ 2 := by
              ring
      _ = (gram_schmidt_coefficient b i' i) ^ 2 * ‖gramSchmidt ℝ b i‖ ^ 2 := by
              rw [sq_abs]
  nlinarith [hstep_sq, hmu_sq, hnorm_add, hnorm_smul]

/-- Helper for Exercise 9.5: iterating the adjacent reduced-basis bound compares the first basis
vector with any later Gram-Schmidt vector. -/
lemma firstBasisVector_normSq_le_pow_two_mul_gramSchmidt
    (hn : 0 < n)
    (b : Basis (Fin n) ℝ E)
    (h_reduced : IsReducedBasis b)
    (j : Fin n) :
    ‖b ⟨0, hn⟩‖ ^ 2 ≤ (2 : ℝ) ^ j.1 * ‖gramSchmidt ℝ b j‖ ^ 2 := by
  let b0 : Fin n := ⟨0, hn⟩
  have hbase :
      ‖b b0‖ ^ 2 ≤ (2 : ℝ) ^ 0 * ‖gramSchmidt ℝ b b0‖ ^ 2 := by
    -- The first Gram-Schmidt vector is just the first basis vector.
    have hgs0 : gramSchmidt ℝ b b0 = b b0 := by
      have hIio : Finset.Iio b0 = ∅ := by
        ext i
        simp [b0, Fin.lt_def]
      rw [gramSchmidt_def ℝ b b0, hIio, Finset.sum_empty, sub_zero]
    simp [b0, hgs0]
  have hbound :
      ∀ k (hk : k < n),
        ‖b b0‖ ^ 2 ≤ (2 : ℝ) ^ k * ‖gramSchmidt ℝ b ⟨k, hk⟩‖ ^ 2 := by
    intro k
    induction k with
    | zero =>
        intro hk
        simpa [b0] using hbase
    | succ k ih =>
        intro hk
        have hk_prev : k < n := Nat.lt_of_succ_lt hk
        have hk_pred : k < n - 1 := Nat.lt_pred_iff.mpr hk
        let jk : Fin (n - 1) := ⟨k, hk_pred⟩
        have hadj :
            ‖gramSchmidt ℝ b ⟨k, hk_prev⟩‖ ^ 2 ≤
              2 * ‖gramSchmidt ℝ b ⟨k + 1, hk⟩‖ ^ 2 := by
          simpa [jk] using adjacentGramSchmidt_normSq_le_two_mul b h_reduced jk
        have hpow_nonneg : 0 ≤ (2 : ℝ) ^ k := by
          positivity
        calc
          ‖b b0‖ ^ 2 ≤ (2 : ℝ) ^ k * ‖gramSchmidt ℝ b ⟨k, hk_prev⟩‖ ^ 2 := ih hk_prev
          _ ≤ (2 : ℝ) ^ k * (2 * ‖gramSchmidt ℝ b ⟨k + 1, hk⟩‖ ^ 2) := by
            exact mul_le_mul_of_nonneg_left hadj hpow_nonneg
          _ = (2 : ℝ) ^ (k + 1) * ‖gramSchmidt ℝ b ⟨k + 1, hk⟩‖ ^ 2 := by
            ring
  simpa using hbound j.1 j.2

/-- Exercise 9.5. Let `Λ ⊆ ℝ^n` be a lattice and let `b¹, ..., bⁿ` be a reduced basis of `Λ`.
If `u` is a shortest nonzero vector of `Λ`, then the first basis vector satisfies
`‖b¹‖ ≤ 2^((n - 1)/2) ‖u‖`. -/
theorem exercise_9_5_first_reduced_basis_vector_le_min
    (hn : 0 < n)
    (b : Basis (Fin n) ℝ E)
    (h_reduced : IsReducedBasis b)
    (u : E)
    (hu_shortest : b.integerSpan.IsShortestNonzeroVector u) :
    ‖b ⟨0, hn⟩‖ ≤ Real.rpow 2 (((n - 1 : ℕ) : ℝ) / 2) * ‖u‖ := by
  -- Compare the first basis vector with the Gram-Schmidt vector at the last nonzero lattice
  -- coefficient of `u`, then enlarge the exponent from that index to `n - 1`.
  obtain ⟨coeff, j, hu_repr, hcoeffj, hupper⟩ :=
    existsLastNonzeroIntegerCoeff b hu_shortest.mem hu_shortest.ne_zero
  have hfirst :
      ‖b ⟨0, hn⟩‖ ^ 2 ≤ (2 : ℝ) ^ j.1 * ‖gramSchmidt ℝ b j‖ ^ 2 :=
    firstBasisVector_normSq_le_pow_two_mul_gramSchmidt hn b h_reduced j
  have hlast :
      ‖gramSchmidt ℝ b j‖ ^ 2 ≤ ‖u‖ ^ 2 :=
    lastNonzeroCoeffGramSchmidt_normSq_le b coeff j hu_repr hcoeffj hupper
  have hj_le : j.1 ≤ n - 1 := Nat.le_pred_of_lt j.2
  have hpow_le : (2 : ℝ) ^ j.1 ≤ (2 : ℝ) ^ (n - 1) := by
    exact pow_le_pow_right₀ (by norm_num) hj_le
  have hu_sq_nonneg : 0 ≤ ‖u‖ ^ 2 := by
    positivity
  have hsq :
      ‖b ⟨0, hn⟩‖ ^ 2 ≤ (2 : ℝ) ^ (n - 1) * ‖u‖ ^ 2 := by
    calc
      ‖b ⟨0, hn⟩‖ ^ 2 ≤ (2 : ℝ) ^ j.1 * ‖gramSchmidt ℝ b j‖ ^ 2 := hfirst
      _ ≤ (2 : ℝ) ^ j.1 * ‖u‖ ^ 2 := by
        have hpowj_nonneg : 0 ≤ (2 : ℝ) ^ j.1 := by
          positivity
        exact mul_le_mul_of_nonneg_left hlast hpowj_nonneg
      _ ≤ (2 : ℝ) ^ (n - 1) * ‖u‖ ^ 2 := by
        exact mul_le_mul_of_nonneg_right hpow_le hu_sq_nonneg
  have hrpow_sq :
      (Real.rpow 2 (((n - 1 : ℕ) : ℝ) / 2)) ^ 2 = (2 : ℝ) ^ (n - 1) := by
    let t : ℝ := (((n - 1 : ℕ) : ℝ) / 2)
    have hnat :
        (Real.rpow 2 t) ^ (2 : ℝ) = (Real.rpow 2 t) ^ (2 : ℕ) := by
      exact Real.rpow_natCast (Real.rpow 2 t) 2
    calc
      (Real.rpow 2 t) ^ 2 = (Real.rpow 2 t) ^ (2 : ℝ) := by
            exact hnat.symm
      _ = Real.rpow 2 (t * 2) := by
            exact (Real.rpow_mul (by positivity) t 2).symm
      _ = Real.rpow 2 (n - 1 : ℕ) := by
            simp [t]
      _ = (2 : ℝ) ^ (n - 1) := by
            exact Real.rpow_natCast 2 (n - 1)
  have htarget_sq :
      ‖b ⟨0, hn⟩‖ ^ 2 ≤
        (Real.rpow 2 (((n - 1 : ℕ) : ℝ) / 2) * ‖u‖) ^ 2 := by
    rw [mul_pow, hrpow_sq]
    exact hsq
  have htarget_nonneg : 0 ≤ Real.rpow 2 (((n - 1 : ℕ) : ℝ) / 2) * ‖u‖ := by
    have hrpow_nonneg : 0 ≤ Real.rpow 2 (((n - 1 : ℕ) : ℝ) / 2) := Real.rpow_nonneg (by norm_num) _
    exact mul_nonneg hrpow_nonneg (norm_nonneg _)
  have hleft_nonneg : 0 ≤ ‖b ⟨0, hn⟩‖ := norm_nonneg _
  nlinarith

end Exercise95
