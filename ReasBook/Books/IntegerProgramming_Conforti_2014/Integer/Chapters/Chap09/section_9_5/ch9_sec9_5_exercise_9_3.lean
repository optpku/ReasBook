import Mathlib

-- Declarations for this item will be appended below by the statement pipeline.

-- Domain sampling for this exercise:
-- * primary domain: finite-index `ℤ`-submodules of `ℤ^n` coming from square integral matrices
-- * source-facing owner: the integral column lattice of a matrix
-- * core mathlib owner abstraction: `A.mulVecLin.range`
-- * source-facing span description: `Matrix.range_mulVecLin`
-- * determinant/index API: `Submodule.natAbs_det_basis_change`,
--   `AddSubgroup.relIndex_eq_natAbs_det`

open scoped Matrix

section Exercise93

variable {n : ℕ}

/-- The lattice generated by the columns of an integral square matrix `A`, realized intrinsically
as the `ℤ`-submodule of `ℤ^n` given by the range of the matrix map. -/
def integral_matrix_lattice (A : Matrix (Fin n) (Fin n) ℤ) : Submodule ℤ (Fin n → ℤ) :=
  A.mulVecLin.range

/-- The intrinsic integral matrix lattice is exactly the `ℤ`-span of the columns of `A`. -/
theorem integral_matrix_lattice_eq_span_cols (A : Matrix (Fin n) (Fin n) ℤ) :
    integral_matrix_lattice A = Submodule.span ℤ (Set.range A.col) := by
  simpa [integral_matrix_lattice] using Matrix.range_mulVecLin A

/-- Helper for Exercise 9.3: a nonsingular integral matrix provides a canonical `ℤ`-basis of its
integral column lattice given by its columns. -/
theorem integral_matrix_lattice_basis_of_det_ne_zero
    (A : Matrix (Fin n) (Fin n) ℤ) (hA : A.det ≠ 0) :
    ∃ b : Module.Basis (Fin n) ℤ (integral_matrix_lattice A),
      ∀ i : Fin n, ((b i : integral_matrix_lattice A) : Fin n → ℤ) = A.col i := by
  classical
  let bSpan : Module.Basis (Fin n) ℤ (Submodule.span ℤ (Set.range A.col)) :=
    Module.Basis.span (R := ℤ) (v := A.col) (Matrix.linearIndependent_cols_of_det_ne_zero hA)
  let e : Submodule.span ℤ (Set.range A.col) ≃ₗ[ℤ] integral_matrix_lattice A :=
    LinearEquiv.ofEq _ _ (integral_matrix_lattice_eq_span_cols A).symm
  refine ⟨bSpan.map e, ?_⟩
  -- The transported span basis still evaluates to the original matrix columns.
  intro i
  simp [bSpan, e]

/-- Helper for Exercise 9.3: the lattice of a nonsingular integral `n × n` matrix has rank `n`. -/
theorem finrank_integral_matrix_lattice_of_det_ne_zero
    (A : Matrix (Fin n) (Fin n) ℤ) (hA : A.det ≠ 0) :
    Module.finrank ℤ (integral_matrix_lattice A) = n := by
  classical
  -- The column basis gives the exact rank count.
  obtain ⟨b, _hb⟩ := integral_matrix_lattice_basis_of_det_ne_zero A hA
  simpa using Module.finrank_eq_card_basis b

/-- Helper for Exercise 9.3: the index of the lattice generated by a nonsingular integral matrix
in `ℤ^n` is the absolute value of its determinant. -/
theorem integral_matrix_lattice_index_eq_natAbs_det
    (A : Matrix (Fin n) (Fin n) ℤ) (hA : A.det ≠ 0) :
    (integral_matrix_lattice A).toAddSubgroup.index = Int.natAbs A.det := by
  classical
  obtain ⟨b, hb⟩ := integral_matrix_lattice_basis_of_det_ne_zero A hA
  -- The determinant-index formula becomes literal in the column basis.
  rw [AddSubgroup.index_eq_natAbs_det (Pi.basisFun ℤ (Fin n)) _ b]
  have hfamily :
      (fun i ↦ ((b i : integral_matrix_lattice A) : Fin n → ℤ)) = A.col := by
    funext i
    exact hb i
  have hdet : Matrix.detRowAlternating A.col = A.det := by
    have hof : Matrix.of A.col = Aᵀ := by
      ext i j
      rfl
    simpa [hof, Matrix.det_transpose] using
      (Pi.basisFun_det_apply (R := ℤ) (ι := Fin n) A.col)
  simpa [hfamily, hdet]

/-- Helper for Exercise 9.3: if `Λ_A ≤ Λ_B` and `A` is nonsingular, then `B` is also
nonsingular because its lattice still has full rank `n`. -/
theorem det_ne_zero_of_integral_matrix_lattice_le_aux
    (A B : Matrix (Fin n) (Fin n) ℤ)
    (hA : A.det ≠ 0)
    (hAB : integral_matrix_lattice A ≤ integral_matrix_lattice B) :
    B.det ≠ 0 := by
  classical
  have hfinrankA :
      Module.finrank ℤ (integral_matrix_lattice A) = n :=
    finrank_integral_matrix_lattice_of_det_ne_zero A hA
  have hfinrankB_ge :
      n ≤ Module.finrank ℤ (integral_matrix_lattice B) := by
    simpa [hfinrankA] using (Submodule.finrank_mono hAB)
  have hfinrankB :
      Module.finrank ℤ (integral_matrix_lattice B) = n :=
    Nat.le_antisymm
      (by simpa using (Submodule.finrank_le (integral_matrix_lattice B :
        Submodule ℤ (Fin n → ℤ))))
      hfinrankB_ge
  let φ : (Fin n → ℤ) →ₗ[ℤ] (Fin n → ℚ) :=
    { toFun := fun x i ↦ (x i : ℚ)
      map_add' := by
        intro x y
        ext i
        simp
      map_smul' := by
        intro c x
        ext i
        simp }
  have hφinj : Function.Injective φ := by
    intro x y hxy
    ext i
    exact Int.cast_injective (congrFun hxy i)
  let P : Submodule ℤ (Fin n → ℚ) := (integral_matrix_lattice B).map φ
  have hP :
      P = Submodule.span ℤ (Set.range (φ ∘ B.col)) := by
    -- Mapping the lattice into `ℚ^n` preserves its column-span description.
    change (integral_matrix_lattice B).map φ = _
    rw [integral_matrix_lattice_eq_span_cols B, Submodule.map_span, Set.range_comp]
  have hPfinrank :
      Module.finrank ℤ P = n := by
    calc
      Module.finrank ℤ P = Module.finrank ℤ (integral_matrix_lattice B) := by
        simpa [P] using
          (Submodule.equivMapOfInjective φ hφinj (integral_matrix_lattice B)).finrank_eq.symm
      _ = n := hfinrankB
  have hspanQ :
      Module.finrank ℚ (Submodule.span ℚ (Set.range (φ ∘ B.col))) = n := by
    have hspanP :
        Module.finrank ℚ (Submodule.span ℚ (P : Set (Fin n → ℚ))) = n := by
      calc
        Module.finrank ℚ (Submodule.span ℚ (P : Set (Fin n → ℚ))) = Module.finrank ℤ P := by
          simpa using (Submodule.finrank_span_eq_finrank (R := ℤ) (A := ℚ) P)
        _ = n := hPfinrank
    have hspanEq :
        Submodule.span ℚ (P : Set (Fin n → ℚ)) =
          Submodule.span ℚ (Set.range (φ ∘ B.col)) := by
      rw [hP]
      simpa using
        (Submodule.span_span_of_tower (R := ℤ) (S := ℚ) (s := Set.range (φ ∘ B.col)))
    rwa [hspanEq] at hspanP
  have hspanQ_top :
      Submodule.span ℚ (Set.range (φ ∘ B.col)) = ⊤ := by
    apply Submodule.eq_top_of_finrank_eq
    simpa [Module.finrank_fintype_fun_eq_card] using hspanQ
  have hlinQ :
      LinearIndependent ℚ (φ ∘ B.col) := by
    -- The mapped columns span all of `ℚ^n`, so the square family is independent.
    apply linearIndependent_of_top_le_span_of_card_eq_finrank (R := ℚ) (b := φ ∘ B.col)
    · exact hspanQ_top.ge
    · simpa using (Module.finrank_fintype_fun_eq_card ℚ (Fin n)).symm
  have hmap_cols :
      LinearIndependent ℚ (B.map (Int.castRingHom ℚ)).col := by
    simpa [φ, Function.comp, Matrix.col, RingHom.mapMatrix_apply] using hlinQ
  have hmap_det_ne_zero : (B.map (Int.castRingHom ℚ)).det ≠ 0 := by
    have hmap_unit : IsUnit (B.map (Int.castRingHom ℚ)) :=
      (Matrix.linearIndependent_cols_iff_isUnit (A := B.map (Int.castRingHom ℚ))).mp hmap_cols
    exact ((B.map (Int.castRingHom ℚ)).isUnit_iff_isUnit_det.mp hmap_unit).ne_zero
  -- If the determinant vanished over `ℤ`, it would also vanish after mapping to `ℚ`.
  intro hB
  apply hmap_det_ne_zero
  exact ((Int.castRingHom ℚ).map_det B).symm.trans (by simpa [hB])

/-- Exercise 9.3 (1). If two integral matrices generate lattices with `Λ_A ≤ Λ_B`, then
`|det B|` divides `|det A|`. -/
theorem natAbs_det_dvd_of_integral_matrix_lattice_le
    (A B : Matrix (Fin n) (Fin n) ℤ)
    (hAB : integral_matrix_lattice A ≤ integral_matrix_lattice B) :
    Int.natAbs B.det ∣ Int.natAbs A.det := by
  by_cases hA : A.det = 0
  · -- The singular case is immediate.
    rw [hA, Int.natAbs_zero]
    exact dvd_zero _
  · have hB : B.det ≠ 0 :=
      det_ne_zero_of_integral_matrix_lattice_le_aux A B hA hAB
    -- The inclusion of lattices gives a divisibility relation between subgroup indices.
    have hindex :
        (integral_matrix_lattice B).toAddSubgroup.index ∣
          (integral_matrix_lattice A).toAddSubgroup.index :=
      AddSubgroup.index_dvd_of_le hAB
    rw [integral_matrix_lattice_index_eq_natAbs_det B hB,
      integral_matrix_lattice_index_eq_natAbs_det A hA] at hindex
    exact hindex

/-- If `A` is nonsingular and `Λ_A ≤ Λ_B`, then `B` is also nonsingular. -/
theorem det_ne_zero_of_integral_matrix_lattice_le
    (A B : Matrix (Fin n) (Fin n) ℤ)
    (hA : A.det ≠ 0)
    (hAB : integral_matrix_lattice A ≤ integral_matrix_lattice B) :
    B.det ≠ 0 := by
  -- Route correction: use the full-rank auxiliary lemma instead of the circular divisibility route.
  exact det_ne_zero_of_integral_matrix_lattice_le_aux A B hA hAB

/-- Exercise 9.3 (2). If `A` is a nonsingular integral matrix and `Λ_A ≤ Λ_B`, then there are
`ℤ`-bases `u¹, ..., uⁿ` of `Λ_A` and `v¹, ..., vⁿ` of `Λ_B` and positive integers
`k₁, ..., kₙ` such that `uⁱ = kᵢ vⁱ` for each `i`. The nonsingularity of `B` follows from
part (1). -/
theorem exists_bases_of_integral_matrix_lattice_le
    (A B : Matrix (Fin n) (Fin n) ℤ)
    (hA : A.det ≠ 0)
    (hAB : integral_matrix_lattice A ≤ integral_matrix_lattice B) :
    ∃ u : Module.Basis (Fin n) ℤ (integral_matrix_lattice A),
      ∃ v : Module.Basis (Fin n) ℤ (integral_matrix_lattice B),
        ∃ k : Fin n → ℕ,
          (∀ i : Fin n, 0 < k i) ∧
            ∀ i : Fin n, (u i : Fin n → ℤ) = (k i : ℤ) • (v i : Fin n → ℤ) := by
  classical
  let N : Submodule ℤ (integral_matrix_lattice B) :=
    (integral_matrix_lattice A).comap (integral_matrix_lattice B).subtype
  have hB : B.det ≠ 0 :=
    det_ne_zero_of_integral_matrix_lattice_le A B hA hAB
  obtain ⟨bB, hbB⟩ := integral_matrix_lattice_basis_of_det_ne_zero B hB
  have hRank :
      Module.finrank ℤ N = Module.finrank ℤ (integral_matrix_lattice B) := by
    -- Transport the lower lattice into `Λ_B` and compare both full ranks.
    calc
      Module.finrank ℤ N = Module.finrank ℤ (integral_matrix_lattice A) := by
        exact LinearEquiv.finrank_eq (Submodule.comapSubtypeEquivOfLe hAB)
      _ = n := finrank_integral_matrix_lattice_of_det_ne_zero A hA
      _ = Module.finrank ℤ (integral_matrix_lattice B) := by
        symm
        exact finrank_integral_matrix_lattice_of_det_ne_zero B hB
  let u₀ : Module.Basis (Fin n) ℤ (integral_matrix_lattice A) :=
    (Submodule.smithNormalFormBotBasis (N := N) bB hRank).map
      (Submodule.comapSubtypeEquivOfLe hAB)
  let v₀ : Module.Basis (Fin n) ℤ (integral_matrix_lattice B) :=
    Submodule.smithNormalFormTopBasis (N := N) bB hRank
  let a : Fin n → ℤ :=
    Submodule.smithNormalFormCoeffs (N := N) bB hRank
  have ha_ne_zero : ∀ i : Fin n, a i ≠ 0 := by
    intro i
    exact Submodule.smithNormalFormCoeffs_ne_zero (N := N) bB hRank i
  have hsigned : ∀ i : Fin n, IsUnit (Int.sign (a i)) := by
    intro i
    rw [Int.isUnit_iff_natAbs_eq]
    exact Int.natAbs_sign_of_ne_zero (ha_ne_zero i)
  let v : Module.Basis (Fin n) ℤ (integral_matrix_lattice B) := v₀.isUnitSMul hsigned
  let k : Fin n → ℕ := fun i ↦ Int.natAbs (a i)
  refine ⟨u₀, v, k, ?_, ?_⟩
  · -- The Smith coefficients are nonzero, hence their absolute values are positive.
    intro i
    exact Int.natAbs_pos.mpr (ha_ne_zero i)
  · intro i
    have hdiag₀ :=
      Submodule.smithNormalFormBotBasis_def (N := N) bB hRank i
    have hdiag : (u₀ i : Fin n → ℤ) = a i • (v₀ i : Fin n → ℤ) := by
      change
        (((Submodule.comapSubtypeEquivOfLe hAB)
          (Submodule.smithNormalFormBotBasis (N := N) bB hRank i) :
            integral_matrix_lattice A) : Fin n → ℤ) =
          Submodule.smithNormalFormCoeffs (N := N) bB hRank i •
            ((Submodule.smithNormalFormTopBasis (N := N) bB hRank i :
              integral_matrix_lattice B) : Fin n → ℤ)
      simpa using congrArg (fun x : integral_matrix_lattice B => (x : Fin n → ℤ)) hdiag₀
    -- Rewrite the Smith diagonal relation after transporting the lower basis back to `Λ_A`.
    calc
      (u₀ i : Fin n → ℤ) = a i • (v₀ i : Fin n → ℤ) := by
        exact hdiag
      _ = ((Int.natAbs (a i) : ℤ) * Int.sign (a i)) • (v₀ i : Fin n → ℤ) := by
        congr 1
        simpa [mul_comm] using (Int.sign_mul_natAbs (a i)).symm
      _ = (k i : ℤ) • (Int.sign (a i) • (v₀ i : Fin n → ℤ)) := by
        rw [mul_smul]
      _ = (k i : ℤ) • (v i : Fin n → ℤ) := by
        simp [v, k, Module.Basis.isUnitSMul_apply]

end Exercise93
