open scoped Matrix

-- Domain-style sampling for this refine pass:
-- * primary domain: fixed-dimension shortest-vector algorithms for rational lattices
-- * sampled owner declarations: Chapter 9.1.1 `matrix_generated_lattice` and
--   `mem_matrix_generated_lattice_iff`, Chapter 9.1.1 Theorem 9.6's source-facing owner
--   `RationalBasis`, and Chapter 7.26's canonical solver owner `PolynomialTimeQuerySolver`
-- * source-facing layer: a shortest-vector certificate for a rational basis input
-- * core/canonical owners: `RationalBasis n` for the input and `PolynomialTimeQuerySolver` for
--   the algorithmic complexity packaging
-- * bridge/view: cast the rational basis matrix to `ℝ` before applying `matrix_generated_lattice`
-- * primitive data: the rational basis matrix and the integer coefficient vector of a shortest
--   nonzero lattice vector

noncomputable section Exercise911

variable {n : ℕ}

namespace RationalBasis

/-- The real lattice generated by the rational basis matrix of `B`, expressed through the
canonical Chapter 9 owner `matrix_generated_lattice`. -/
def generatedLattice (B : RationalBasis n) : Submodule ℤ (Fin n → ℝ) :=
  matrix_generated_lattice (B.basisMatrix.map (Rat.castHom ℝ))

/-- The real lattice vector corresponding to the integer coefficient vector `z`. -/
def vector (B : RationalBasis n) (z : Fin n → ℤ) : Fin n → ℝ :=
  (B.basisMatrix.map (Rat.castHom ℝ)) *ᵥ fun i ↦ (z i : ℝ)

/-- Membership in `B.generatedLattice` is exactly being an integer linear combination of the
columns of the basis matrix. -/
theorem mem_generatedLattice_iff
    (B : RationalBasis n)
    (x : Fin n → ℝ) :
    x ∈ B.generatedLattice ↔ ∃ z : Fin n → ℤ, x = B.vector z := by
  simpa [generatedLattice, vector] using
    (mem_matrix_generated_lattice_iff :
      x ∈ matrix_generated_lattice (B.basisMatrix.map (Rat.castHom ℝ)) ↔
        ∃ z : Fin n → ℤ, x = (B.basisMatrix.map (Rat.castHom ℝ)) *ᵥ fun i ↦ (z i : ℝ))

/-- Every integer coefficient vector produces a point of `B.generatedLattice`. -/
theorem vector_mem_generatedLattice
    (B : RationalBasis n)
    (z : Fin n → ℤ) :
    B.vector z ∈ B.generatedLattice :=
  (B.mem_generatedLattice_iff _).2 ⟨z, rfl⟩

end RationalBasis

/-- A shortest-vector certificate for `B` consists of an explicit integer coefficient vector whose
real realization is nonzero and has minimal Euclidean norm among all nonzero lattice vectors of
`B.generatedLattice`. -/
structure ShortestVectorCertificate (B : RationalBasis n) where
  coeffs : Fin n → ℤ
  vector_ne_zero : B.vector coeffs ≠ 0
  minimal_norm :
    ∀ z : Fin n → ℤ, B.vector z ≠ 0 →
      ‖B.vector coeffs‖ ≤ ‖B.vector z‖

namespace ShortestVectorCertificate

/-- The vector encoded by a shortest-vector certificate lies in the lattice generated by the input
rational basis. -/
theorem vector_mem_generatedLattice
    {B : RationalBasis n}
    (certificate : ShortestVectorCertificate B) :
    B.vector certificate.coeffs ∈ B.generatedLattice :=
  B.vector_mem_generatedLattice certificate.coeffs

end ShortestVectorCertificate

/-- A polynomial-time algorithm for the shortest-vector problem in dimension `n` is a canonical
polynomial-time query solver whose queries are rational bases and whose answers are shortest-vector
certificates. -/
abbrev ShortestVectorAlgorithm (n : ℕ) :=
  PolynomialTimeQuerySolver
    (RationalBasis n)
    ShortestVectorCertificate
    RationalBasis.encodingSize

/-- Helper for remote integer-programming sorry cleanup
`Integer/Chapters/Chap09/section_9_5/ch9_sec9_5_exercise_9_11.lean`: a norm minimizer on a
closed-ball slice already minimizes norm on the whole set. -/
lemma normMinOnClosedBallSlice_global
    {E : Type*} [NormedAddCommGroup E]
    {S : Set E} {r : ℝ} {u : E}
    (hu : u ∈ Metric.closedBall 0 r ∩ S)
    (hu_min : ∀ v ∈ Metric.closedBall 0 r ∩ S, ‖u‖ ≤ ‖v‖) :
    ∀ v ∈ S, ‖u‖ ≤ ‖v‖ := by
  intro v hv
  by_cases hv_ball : v ∈ Metric.closedBall 0 r
  · -- Inside the closed ball, the original slice minimality applies directly.
    exact hu_min v ⟨hv_ball, hv⟩
  · -- Outside the closed ball, the radius bound on `u` is strictly smaller than `‖v‖`.
    have hu_le : ‖u‖ ≤ r := by
      simpa [Metric.mem_closedBall, dist_zero_right] using hu.1
    have hr_lt : r < ‖v‖ := by
      simpa [Metric.mem_closedBall, dist_zero_right, not_le] using hv_ball
    linarith

namespace RationalBasis

/-- Helper for remote integer-programming sorry cleanup
`Integer/Chapters/Chap09/section_9_5/ch9_sec9_5_exercise_9_11.lean`: the nonzero Euclidean image
of `B.generatedLattice` contains a vector of minimal norm. -/
lemma existsShortestEuclideanImageVector
    (B : RationalBasis n) (hn : 0 < n) :
    ∃ u : EuclideanSpace ℝ (Fin n),
      u ∈ (EuclideanSpace.equiv (Fin n) ℝ).symm '' B.generatedLattice ∧
      u ≠ 0 ∧
      ∀ v : EuclideanSpace ℝ (Fin n),
        v ∈ (EuclideanSpace.equiv (Fin n) ℝ).symm '' B.generatedLattice →
        v ≠ 0 →
        ‖u‖ ≤ ‖v‖ := by
  classical
  let i0 : Fin n := ⟨0, hn⟩
  let latticeSet : Set (EuclideanSpace ℝ (Fin n)) :=
    (EuclideanSpace.equiv (Fin n) ℝ).symm '' B.generatedLattice
  let nonzeroLatticeSet : Set (EuclideanSpace ℝ (Fin n)) := {u | u ∈ latticeSet ∧ u ≠ 0}
  let r : ℝ := ‖B.basis i0‖
  let slice : Set (EuclideanSpace ℝ (Fin n)) := Metric.closedBall 0 r ∩ nonzeroLatticeSet
  have h_lattice_eq : latticeSet = Submodule.span ℤ (Set.range B.basis) := by
    simpa [latticeSet] using B.inputBasis_span
  have h_slice_nonempty : slice.Nonempty := by
    refine ⟨B.basis i0, ?_⟩
    refine ⟨?_, ?_⟩
    · -- The distinguished basis vector lies on the boundary of the chosen closed ball.
      simpa [r, Metric.mem_closedBall, dist_zero_right]
    · refine ⟨?_, Basis.ne_zero B.basis i0⟩
      rw [h_lattice_eq]
      exact Submodule.subset_span ⟨i0, rfl⟩
  have h_slice_finite : Set.Finite slice := by
    have h_closedBall_finite :
        Set.Finite (Metric.closedBall (0 : EuclideanSpace ℝ (Fin n)) r ∩ latticeSet) := by
      rw [h_lattice_eq]
      simpa using
        (ZSpan.setFinite_inter B.basis
          (s := Metric.closedBall (0 : EuclideanSpace ℝ (Fin n)) r)
          (Metric.isBounded_closedBall :
            Bornology.IsBounded (Metric.closedBall (0 : EuclideanSpace ℝ (Fin n)) r)))
    exact h_closedBall_finite.subset fun x hx ↦ ⟨hx.1, hx.2.1⟩
  -- Choose a norm minimizer on the finite closed-ball slice of nonzero lattice points.
  obtain ⟨u, hu_slice, hu_min⟩ :=
    Set.exists_min_image slice (fun v ↦ ‖v‖) h_slice_finite h_slice_nonempty
  refine ⟨u, hu_slice.2.1, hu_slice.2.2, ?_⟩
  intro v hv hv_ne
  -- Upgrade the slice minimality to all nonzero lattice vectors.
  exact normMinOnClosedBallSlice_global hu_slice hu_min v ⟨hv, hv_ne⟩

/-- Helper for remote integer-programming sorry cleanup
`Integer/Chapters/Chap09/section_9_5/ch9_sec9_5_exercise_9_11.lean`: a shortest nonzero vector in
the Euclidean image of `B.generatedLattice` yields a shortest-vector certificate for `B`. -/
lemma shortestVectorCertificate_ofShortestEuclideanImage
    (B : RationalBasis n) {u : EuclideanSpace ℝ (Fin n)}
    (hu : u ∈ (EuclideanSpace.equiv (Fin n) ℝ).symm '' B.generatedLattice)
    (hu_ne : u ≠ 0)
    (hu_min : ∀ v : EuclideanSpace ℝ (Fin n),
      v ∈ (EuclideanSpace.equiv (Fin n) ℝ).symm '' B.generatedLattice →
      v ≠ 0 →
      ‖u‖ ≤ ‖v‖) :
    ShortestVectorCertificate B := by
  rcases hu with ⟨x, hx, rfl⟩
  rcases (B.mem_generatedLattice_iff x).1 hx with ⟨z, rfl⟩
  refine ⟨z, ?_, ?_⟩
  · -- Transport nonzeroness from Euclidean space back to the coordinate model.
    intro hz
    apply hu_ne
    simpa [hz]
  · intro z' hz'_ne
    have hv_mem :
        (EuclideanSpace.equiv (Fin n) ℝ).symm (B.vector z') ∈
          (EuclideanSpace.equiv (Fin n) ℝ).symm '' B.generatedLattice := by
      exact ⟨B.vector z', B.vector_mem_generatedLattice z', rfl⟩
    have hv_ne :
        (EuclideanSpace.equiv (Fin n) ℝ).symm (B.vector z') ≠ 0 := by
      intro hv0
      apply hz'_ne
      simpa using hv0
    -- Compare with the transported competitor and use norm preservation of the equivalence.
    simpa using hu_min ((EuclideanSpace.equiv (Fin n) ℝ).symm (B.vector z')) hv_mem hv_ne

/-- Helper for remote integer-programming sorry cleanup
`Integer/Chapters/Chap09/section_9_5/ch9_sec9_5_exercise_9_11.lean`: every positive-dimensional
rational basis admits a shortest-vector certificate. -/
lemma shortestVectorCertificate_nonempty
    (B : RationalBasis n) (hn : 0 < n) :
    Nonempty (ShortestVectorCertificate B) := by
  rcases B.existsShortestEuclideanImageVector hn with ⟨u, hu, hu_ne, hu_min⟩
  exact ⟨B.shortestVectorCertificate_ofShortestEuclideanImage hu hu_ne hu_min⟩

end RationalBasis

/-- remote integer-programming sorry cleanup Integer/Chapters/Chap09/section_9_5/ch9_sec9_5_exercise_9_11.lean -/
theorem rational_lattice_shortest_vector_has_polynomial_time_algorithm
    (n : ℕ) (hn : 0 < n) :
    Nonempty (ShortestVectorAlgorithm n) := by
  classical
  -- Package the chosen shortest-vector certificates into a constant-time query solver.
  refine ⟨{
    solve := fun B ↦ Classical.choice (RationalBasis.shortestVectorCertificate_nonempty B hn)
    runtime := fun _ ↦ 0
    time_bound := 0
    runtime_le := zeroRuntimeLeZeroPolynomialEval RationalBasis.encodingSize
  }⟩

end Exercise911
