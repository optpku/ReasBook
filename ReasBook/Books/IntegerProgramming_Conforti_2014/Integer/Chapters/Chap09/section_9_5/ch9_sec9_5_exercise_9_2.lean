import IntegerProgramming_Conforti_2014.Integer.Chapters.Chap09.section_9_5.ch9_sec9_5_exercise_9_5

-- Declarations for this item will be appended below by the statement pipeline.

-- Domain sampling:
-- * source-facing layer: shortest vectors in the lattice generated by an orthogonal basis
-- * core/canonical owner reused from Chapter 9: `b.integerSpan`
-- * shortest-vector predicate reused from Chapter 9: `Submodule.IsShortestNonzeroVector`

open scoped BigOperators
open InnerProductSpace Module

universe u

section Exercise92

variable {n : ℕ} {E : Type u}

variable [NormedAddCommGroup E] [InnerProductSpace ℝ E]

variable (b : Basis (Fin n) ℝ E)

/-- Helper for Exercise 9.2: every basis vector is one of the generators of `b.integerSpan`. -/
lemma basisVector_mem_integerSpan (i : Fin n) :
    b i ∈ b.integerSpan := by
  -- Unfold the lattice owner and read `b i` as one of the spanning generators.
  simpa [Module.Basis.integerSpan] using
    (Submodule.subset_span (Set.mem_range_self i) :
      b i ∈ Submodule.span ℤ (Set.range b))

/-- Helper for Exercise 9.2: a nonzero integer cast to `ℝ` has norm at least `1`. -/
lemma one_le_norm_intCast (z : ℤ) (hz : z ≠ 0) :
    (1 : ℝ) ≤ ‖(z : ℝ)‖ := by
  -- Convert the nonzero integer to its positive natural absolute value.
  have hnatAbs_pos : 0 < Int.natAbs z := Int.natAbs_pos.mpr hz
  have hnatAbs_ge : 1 ≤ Int.natAbs z := Nat.succ_le_of_lt hnatAbs_pos
  have hcast : (1 : ℝ) ≤ (Int.natAbs z : ℝ) := by
    exact_mod_cast hnatAbs_ge
  simpa [Int.norm_cast_real, Nat.cast_natAbs] using hcast

/-- Helper for Exercise 9.2: orthogonality turns the squared norm of a basis expansion into the
sum of the squared norms of its summands. -/
lemma orthogonalBasis_sum_smul_normSq
    (horth : ∀ i j : Fin n, i ≠ j → ⟪b i, b j⟫_ℝ = 0)
    (c : Fin n → ℝ) :
    ‖∑ i, c i • b i‖ ^ 2 = ∑ i, ‖c i • b i‖ ^ 2 := by
  classical
  -- Prove the identity on an arbitrary finite subset, then specialize to `univ`.
  have haux (s : Finset (Fin n)) :
      ‖Finset.sum s (fun i ↦ c i • b i)‖ ^ 2 =
        Finset.sum s (fun i ↦ ‖c i • b i‖ ^ 2) := by
    refine Finset.induction_on s ?_ ?_
    · simp
    · intro i s hi hs
      have horth_sum : ⟪c i • b i, Finset.sum s (fun j ↦ c j • b j)⟫_ℝ = 0 := by
        -- Each new summand is orthogonal to the previous partial sum.
        rw [inner_sum]
        apply Finset.sum_eq_zero
        intro j hj
        have hij : i ≠ j := fun hij_eq => hi (hij_eq ▸ hj)
        simp [inner_smul_left, inner_smul_right, horth i j hij]
      calc
        ‖Finset.sum (insert i s) (fun j ↦ c j • b j)‖ ^ 2
            = ‖c i • b i + Finset.sum s (fun j ↦ c j • b j)‖ ^ 2 := by
                simp [hi]
        _ = ‖c i • b i‖ ^ 2 + ‖Finset.sum s (fun j ↦ c j • b j)‖ ^ 2 := by
              simpa [pow_two] using norm_add_sq_eq_norm_sq_add_norm_sq_real horth_sum
        _ = ‖c i • b i‖ ^ 2 + Finset.sum s (fun j ↦ ‖c j • b j‖ ^ 2) := by
              rw [hs]
        _ = Finset.sum (insert i s) (fun j ↦ ‖c j • b j‖ ^ 2) := by
              simp [hi]
  simpa using haux Finset.univ

/-- Helper for Exercise 9.2: among finitely many basis vectors, one minimizes the squared norm. -/
lemma exists_minNormSqBasisIndex
    (hn : 0 < n) :
    ∃ i0 : Fin n, ∀ j : Fin n, ‖b i0‖ ^ 2 ≤ ‖b j‖ ^ 2 := by
  let iStart : Fin n := ⟨0, hn⟩
  -- Choose a minimizing index in the finite set `Fin n`.
  obtain ⟨i0, -, hi0⟩ :=
    Finset.exists_min_image (Finset.univ : Finset (Fin n)) (fun i : Fin n ↦ ‖b i‖ ^ 2)
      ⟨iStart, by simp [iStart]⟩
  exact ⟨i0, fun j ↦ hi0 j (by simp)⟩

/-- Helper for Exercise 9.2: a basis vector of minimal squared norm is shortest in
`b.integerSpan`. -/
lemma minNormSqBasisVector_isShortest
    {i0 : Fin n}
    (hi0 : ∀ j : Fin n, ‖b i0‖ ^ 2 ≤ ‖b j‖ ^ 2)
    (horth : ∀ i j : Fin n, i ≠ j → ⟪b i, b j⟫_ℝ = 0) :
    b.integerSpan.IsShortestNonzeroVector (b i0) := by
  refine ⟨basisVector_mem_integerSpan b i0, Basis.ne_zero b i0, ?_⟩
  intro u hu hu_ne
  obtain ⟨coeff, hcoeff⟩ :=
    (Submodule.mem_span_range_iff_exists_fun ℤ).mp (by
      simpa [Module.Basis.integerSpan] using hu)
  have hu_real : ∑ i, (coeff i : ℝ) • b i = u := by
    -- Rewrite the integer lattice expansion as a real linear combination.
    simpa [← Int.cast_smul_eq_zsmul ℝ] using hcoeff
  have hcoeff_exists : ∃ j : Fin n, coeff j ≠ 0 := by
    -- A nonzero lattice vector must have at least one nonzero integer coefficient.
    by_contra hcoeff_exists
    push Not at hcoeff_exists
    have hu_zero : u = 0 := by
      calc
        u = ∑ i, (coeff i : ℝ) • b i := hu_real.symm
        _ = 0 := by simp [hcoeff_exists]
    exact hu_ne hu_zero
  rcases hcoeff_exists with ⟨j, hj_nonzero⟩
  have hj_term_le : ‖(coeff j : ℝ) • b j‖ ^ 2 ≤ ‖u‖ ^ 2 := by
    -- One nonnegative summand is bounded by the full orthogonal norm decomposition.
    calc
      ‖(coeff j : ℝ) • b j‖ ^ 2 ≤ ∑ i, ‖(coeff i : ℝ) • b i‖ ^ 2 := by
        exact Finset.single_le_sum (fun i _ ↦ sq_nonneg ‖(coeff i : ℝ) • b i‖) (by simp)
      _ = ‖u‖ ^ 2 := by
        rw [← orthogonalBasis_sum_smul_normSq b horth (fun i ↦ (coeff i : ℝ)), hu_real]
  have hcoeff_norm_ge : (1 : ℝ) ≤ ‖(coeff j : ℝ)‖ :=
    one_le_norm_intCast (coeff j) hj_nonzero
  have hi0_le_j_sq : ‖b i0‖ ^ 2 ≤ ‖b j‖ ^ 2 := hi0 j
  have hj_basis_le_term : ‖b j‖ ^ 2 ≤ ‖(coeff j : ℝ) • b j‖ ^ 2 := by
    -- A nonzero integer coefficient scales the norm by at least a factor `1`.
    rw [norm_smul, pow_two]
    have hcoeff_sq_ge : (1 : ℝ) ≤ ‖(coeff j : ℝ)‖ ^ 2 := by
      nlinarith [hcoeff_norm_ge, norm_nonneg (coeff j : ℝ)]
    have hbj_sq_nonneg : 0 ≤ ‖b j‖ ^ 2 := sq_nonneg ‖b j‖
    nlinarith
  have hi0_le_u_sq : ‖b i0‖ ^ 2 ≤ ‖u‖ ^ 2 :=
    le_trans hi0_le_j_sq (le_trans hj_basis_le_term hj_term_le)
  -- Pass from the squared-norm inequality back to the norm inequality.
  nlinarith [hi0_le_u_sq, norm_nonneg (b i0), norm_nonneg u]

/-- Helper for Exercise 9.2: a shortest nonzero lattice vector for an orthogonal basis is a
single basis vector times an integer of square `1`. -/
lemma shortestVector_eq_zsmul_basis_of_sq_eq_one
    {x : E}
    (horth : ∀ i j : Fin n, i ≠ j → ⟪b i, b j⟫_ℝ = 0)
    (hx_shortest : b.integerSpan.IsShortestNonzeroVector x) :
    ∃ i : Fin n, ∃ z : ℤ, x = (z : ℝ) • b i ∧ z ^ 2 = 1 := by
  have hn : 0 < n := by
    -- If `n = 0`, then the lattice expansion is empty and every lattice vector is zero.
    by_contra hn
    have hn0 : n = 0 := Nat.eq_zero_of_not_pos hn
    obtain ⟨coeff, hcoeff⟩ :=
      (Submodule.mem_span_range_iff_exists_fun ℤ).mp (by
        simpa [Module.Basis.integerSpan] using hx_shortest.mem)
    subst hn0
    have hx_zero : x = 0 := by
      simpa using hcoeff.symm
    exact hx_shortest.ne_zero hx_zero
  obtain ⟨i0, hi0_min⟩ := exists_minNormSqBasisIndex b hn
  have hi0_shortest : b.integerSpan.IsShortestNonzeroVector (b i0) :=
    minNormSqBasisVector_isShortest b hi0_min horth
  obtain ⟨coeff, hcoeff⟩ :=
    (Submodule.mem_span_range_iff_exists_fun ℤ).mp (by
      simpa [Module.Basis.integerSpan] using hx_shortest.mem)
  have hx_real : ∑ i, (coeff i : ℝ) • b i = x := by
    -- Rewrite the lattice expansion in the ambient real vector space.
    simpa [← Int.cast_smul_eq_zsmul ℝ] using hcoeff
  have hcoeff_exists : ∃ j : Fin n, coeff j ≠ 0 := by
    -- A shortest nonzero lattice vector cannot have all coefficients equal to zero.
    by_contra hcoeff_exists
    push Not at hcoeff_exists
    have hx_zero : x = 0 := by
      calc
        x = ∑ i, (coeff i : ℝ) • b i := hx_real.symm
        _ = 0 := by simp [hcoeff_exists]
    exact hx_shortest.ne_zero hx_zero
  rcases hcoeff_exists with ⟨j, hj_nonzero⟩
  let term : Fin n → ℝ := fun i ↦ ‖(coeff i : ℝ) • b i‖ ^ 2
  have hsum_terms : ∑ i, term i = ‖x‖ ^ 2 := by
    -- Orthogonality identifies the total squared norm with the sum of coordinate contributions.
    calc
      ∑ i, term i = ‖∑ i, (coeff i : ℝ) • b i‖ ^ 2 := by
        simpa [term] using
          (orthogonalBasis_sum_smul_normSq b horth (fun i ↦ (coeff i : ℝ))).symm
      _ = ‖x‖ ^ 2 := by rw [hx_real]
  have hx_le_i0 : ‖x‖ ≤ ‖b i0‖ :=
    hx_shortest.norm_le (basisVector_mem_integerSpan b i0) (Basis.ne_zero b i0)
  have hi0_le_x : ‖b i0‖ ≤ ‖x‖ :=
    hi0_shortest.norm_le hx_shortest.mem hx_shortest.ne_zero
  have hnorm_eq : ‖x‖ = ‖b i0‖ := le_antisymm hx_le_i0 hi0_le_x
  have hnorm_sq_eq : ‖x‖ ^ 2 = ‖b i0‖ ^ 2 := by
    rw [hnorm_eq]
  have hcoeff_norm_ge : (1 : ℝ) ≤ ‖(coeff j : ℝ)‖ :=
    one_le_norm_intCast (coeff j) hj_nonzero
  have hi0_le_j : ‖b i0‖ ≤ ‖b j‖ :=
    hi0_shortest.norm_le (basisVector_mem_integerSpan b j) (Basis.ne_zero b j)
  have hi0_le_termj : ‖b i0‖ ^ 2 ≤ term j := by
    -- The `j`-th nonzero coordinate already contributes at least the shortest basis norm.
    dsimp [term]
    rw [norm_smul, pow_two]
    have hi0_le_j_sq : ‖b i0‖ ^ 2 ≤ ‖b j‖ ^ 2 := by
      nlinarith [hi0_le_j, norm_nonneg (b i0), norm_nonneg (b j)]
    have hcoeff_sq_ge : (1 : ℝ) ≤ ‖(coeff j : ℝ)‖ ^ 2 := by
      nlinarith [hcoeff_norm_ge, norm_nonneg (coeff j : ℝ)]
    have hbj_sq_nonneg : 0 ≤ ‖b j‖ ^ 2 := sq_nonneg ‖b j‖
    nlinarith
  have htermj_le : term j ≤ ‖x‖ ^ 2 := by
    -- Any single nonnegative summand is bounded by the whole sum.
    calc
      term j ≤ ∑ i, term i := by
        exact Finset.single_le_sum (fun i _ ↦ by
          dsimp [term]
          exact sq_nonneg ‖(coeff i : ℝ) • b i‖) (by simp)
      _ = ‖x‖ ^ 2 := hsum_terms
  have htermj_eq : term j = ‖x‖ ^ 2 := by
    nlinarith [hi0_le_termj, htermj_le, hnorm_sq_eq]
  have htermj_norm_eq : ‖(coeff j : ℝ) • b j‖ = ‖x‖ := by
    -- The `j`-th contribution attains the full squared norm, so its norm equals `‖x‖`.
    dsimp [term] at htermj_eq
    nlinarith [htermj_eq, norm_nonneg ((coeff j : ℝ) • b j), norm_nonneg x]
  have hbj_le_termj : ‖b j‖ ≤ ‖(coeff j : ℝ) • b j‖ := by
    -- A nonzero integer coefficient cannot decrease the norm of a basis vector.
    rw [norm_smul]
    nlinarith [hcoeff_norm_ge, norm_nonneg (b j)]
  have hx_le_j : ‖x‖ ≤ ‖b j‖ :=
    hx_shortest.norm_le (basisVector_mem_integerSpan b j) (Basis.ne_zero b j)
  have hbj_eq_x : ‖b j‖ = ‖x‖ := by
    refine le_antisymm ?_ hx_le_j
    calc
      ‖b j‖ ≤ ‖(coeff j : ℝ) • b j‖ := hbj_le_termj
      _ = ‖x‖ := htermj_norm_eq
  have hcoeff_norm_eq_one : ‖(coeff j : ℝ)‖ = 1 := by
    -- Equality of the scaled and unscaled norms forces the coefficient norm to be `1`.
    have hscaled_eq : ‖(coeff j : ℝ) • b j‖ = ‖b j‖ := by
      rw [htermj_norm_eq, hbj_eq_x]
    rw [norm_smul] at hscaled_eq
    have hbj_ne : ‖b j‖ ≠ 0 := norm_ne_zero_iff.mpr (Basis.ne_zero b j)
    have hmul : ‖(coeff j : ℝ)‖ * ‖b j‖ = 1 * ‖b j‖ := by
      simpa using hscaled_eq
    exact mul_right_cancel₀ hbj_ne hmul
  have hcoeff_real_sq : ((coeff j : ℝ) : ℝ) ^ 2 = 1 := by
    -- Over `ℝ`, norm `1` for a scalar is the same as having square `1`.
    have hcoeff_abs_eq_one : |(coeff j : ℝ)| = 1 := by
      simpa [Real.norm_eq_abs] using hcoeff_norm_eq_one
    nlinarith [sq_abs (coeff j : ℝ)]
  have hcoeff_sq_one : coeff j ^ 2 = 1 := by
    have hcast : (((coeff j) ^ 2 : ℤ) : ℝ) = ((1 : ℤ) : ℝ) := by
      simpa using hcoeff_real_sq
    exact Int.cast_injective hcast
  have hrest_zero : Finset.sum (Finset.univ.erase j) term = 0 := by
    -- Once the `j`-th term equals the total, every remaining nonnegative term must vanish.
    have hsplit : term j + Finset.sum (Finset.univ.erase j) term = ‖x‖ ^ 2 := by
      have hj_mem_univ : j ∈ (Finset.univ : Finset (Fin n)) := by
        simp
      calc
        term j + Finset.sum (Finset.univ.erase j) term = ∑ i, term i := by
          symm
          simpa using
            (Finset.sum_erase_add (s := Finset.univ) (f := term) hj_mem_univ)
        _ = ‖x‖ ^ 2 := hsum_terms
    rw [htermj_eq] at hsplit
    linarith
  have hcoeff_zero : ∀ k : Fin n, k ≠ j → coeff k = 0 := by
    intro k hkj
    have hk_mem : k ∈ Finset.univ.erase j := by
      simp [hkj]
    have hk_le_rest : term k ≤ Finset.sum (Finset.univ.erase j) term := by
      exact Finset.single_le_sum (fun i _ ↦ by
        dsimp [term]
        exact sq_nonneg ‖(coeff i : ℝ) • b i‖) hk_mem
    have hk_term_zero : term k = 0 := by
      have hk_nonneg : 0 ≤ term k := by
        dsimp [term]
        exact sq_nonneg ‖(coeff k : ℝ) • b k‖
      have hk_nonpos : term k ≤ 0 := by
        simpa [hrest_zero] using hk_le_rest
      exact le_antisymm hk_nonpos hk_nonneg
    have hk_norm_zero : ‖(coeff k : ℝ) • b k‖ = 0 := by
      dsimp [term] at hk_term_zero
      nlinarith [hk_term_zero, norm_nonneg ((coeff k : ℝ) • b k)]
    have hk_smul_zero : (coeff k : ℝ) • b k = 0 := norm_eq_zero.mp hk_norm_zero
    rcases smul_eq_zero.mp hk_smul_zero with hk_coeff | hk_basis_zero
    · exact Int.cast_eq_zero.mp hk_coeff
    · exact False.elim ((Basis.ne_zero b k) hk_basis_zero)
  have hx_single : x = (coeff j : ℝ) • b j := by
    -- All coefficients except the distinguished one vanish.
    calc
      x = ∑ i, (coeff i : ℝ) • b i := hx_real.symm
      _ = (coeff j : ℝ) • b j := by
        rw [Finset.sum_eq_single_of_mem j (by simp)]
        intro k _ hkj
        rw [hcoeff_zero k hkj]
        simp
  exact ⟨j, coeff j, hx_single, hcoeff_sq_one⟩

/-- Exercise 9.2. If `b¹, ..., bⁿ` is an orthogonal basis, then some basis vector is a shortest
nonzero vector of the lattice generated by `b`. -/
theorem orthogonal_basis_lattice_has_shortest_basis_vector
    (horth : ∀ i j : Fin n, i ≠ j → ⟪b i, b j⟫_ℝ = 0)
    (hn : 0 < n) :
    ∃ i : Fin n, b.integerSpan.IsShortestNonzeroVector (b i) := by
  -- Choose a basis vector minimizing the squared norm and prove it is shortest in the lattice.
  obtain ⟨i0, hi0⟩ := exists_minNormSqBasisIndex b hn
  exact ⟨i0, minNormSqBasisVector_isShortest b hi0 horth⟩

/-- Any nonzero shortest vector of the lattice generated by an orthogonal basis is equal to a
basis vector up to sign. -/
theorem shortest_vector_eq_basis_vector_or_neg
    {x : E}
    (horth : ∀ i j : Fin n, i ≠ j → ⟪b i, b j⟫_ℝ = 0)
    (hx_shortest : b.integerSpan.IsShortestNonzeroVector x) :
    ∃ i : Fin n, x = b i ∨ x = -b i := by
  -- First classify the shortest vector as a single basis vector times an integer of square `1`.
  obtain ⟨i, z, hx_eq, hz_sq⟩ :=
    shortestVector_eq_zsmul_basis_of_sq_eq_one b horth hx_shortest
  rcases sq_eq_one_iff.mp hz_sq with rfl | rfl
  · exact ⟨i, Or.inl (by simpa using hx_eq)⟩
  · exact ⟨i, Or.inr (by simpa using hx_eq)⟩

end Exercise92
