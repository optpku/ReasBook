open scoped Matrix
open Module

section Theorem91

variable {n : ℕ}

/-- The basis of `ℝ^n` whose coordinate columns are the nonsingular square matrix `A`. -/
noncomputable def basisOfMatrix
    {n : ℕ} (A : Matrix (Fin n) (Fin n) ℝ) (hA : IsUnit A.det) :
    Basis (Fin n) ℝ (Fin n → ℝ) :=
  (Pi.basisFun ℝ (Fin n)).map (A.toLinearEquiv (Pi.basisFun ℝ (Fin n)) hA)

/-- Transporting `basisOfMatrix A hA` across the canonical equivalence with Euclidean space gives
the corresponding Euclidean-space basis with the same coordinate columns. -/
noncomputable def euclideanBasisOfMatrix
    (A : Matrix (Fin n) (Fin n) ℝ) (hA : IsUnit A.det) :
    Basis (Fin n) ℝ (EuclideanSpace ℝ (Fin n)) :=
  (basisOfMatrix A hA).map (EuclideanSpace.equiv (Fin n) ℝ).symm.toLinearEquiv

/-- The intrinsic lattice in `ℝ^n` generated by the columns of `A`. -/
def matrix_generated_lattice (A : Matrix (Fin n) (Fin n) ℝ) : Submodule ℤ (Fin n → ℝ) :=
  Submodule.span ℤ (Set.range A.col)

/-- The intrinsic matrix-generated lattice is exactly the `ℤ`-span of the columns of `A`. -/
theorem matrix_generated_lattice_eq_span_cols (A : Matrix (Fin n) (Fin n) ℝ) :
    matrix_generated_lattice A = Submodule.span ℤ (Set.range A.col) :=
  rfl

/-
Domain sampling for this theorem:
* primary domain: column lattices of square real matrices and unimodular basis changes
* sampled owner declarations:
  - `matrix_generated_lattice` for the intrinsic lattice generated by the columns
  - `Submodule.span ℤ (Set.range A.col)` for the intrinsic lattice generated by the columns
  - `Matrix.range_mulVecLin` for the canonical matrix-column span owner in mathlib
  - Chapter 9.5's `integral_matrix_lattice_eq_span_cols` as project precedent for the same owner
* source/core/bridge triage:
