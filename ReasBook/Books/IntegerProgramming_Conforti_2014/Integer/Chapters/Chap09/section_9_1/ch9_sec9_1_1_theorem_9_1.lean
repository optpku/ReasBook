  - core/canonical owner: `matrix_generated_lattice`
  - bridge/view: explicit integer-coordinate membership and Euclidean-space transport
-/

/-- Membership in the intrinsic `ℤ`-span of the columns of `A` is exactly the existence of an
integral coordinate vector whose image under `A` equals the given point. -/
theorem mem_matrix_generated_lattice_iff
    {A : Matrix (Fin n) (Fin n) ℝ} {x : Fin n → ℝ} :
    x ∈ matrix_generated_lattice A ↔
      ∃ z : Fin n → ℤ, x = A *ᵥ fun i ↦ (z i : ℝ) := by
  constructor
  · intro hx
    rw [matrix_generated_lattice_eq_span_cols A, Submodule.mem_span_range_iff_exists_fun] at hx
    rcases hx with ⟨z, hz⟩
    -- Normalize the finite `ℤ`-linear combination of columns into a matrix-vector product.
    refine ⟨z, hz.symm.trans ?_⟩
    ext j
    simp [Matrix.mulVec_eq_sum, Matrix.col_apply, mul_comm]
  · rintro ⟨z, rfl⟩
    rw [matrix_generated_lattice_eq_span_cols A, Submodule.mem_span_range_iff_exists_fun]
    -- Expand the matrix-vector product back into an explicit integer linear combination.
    refine ⟨z, ?_⟩
    ext j
    simp [Matrix.mulVec_eq_sum, Matrix.col_apply, mul_comm]

/-- Membership in the `ℤ`-span of the columns of `A` is exactly the existence of an integral
coordinate vector whose image under `A` equals the given point. -/
theorem mem_span_cols_iff_exists_int_vec
    {A : Matrix (Fin n) (Fin n) ℝ} {x : Fin n → ℝ} :
    x ∈ Submodule.span ℤ (Set.range A.col) ↔
      ∃ z : Fin n → ℤ, x = A *ᵥ fun i ↦ (z i : ℝ) := by
  simpa [matrix_generated_lattice] using
    (mem_matrix_generated_lattice_iff :
      x ∈ matrix_generated_lattice A ↔
        ∃ z : Fin n → ℤ, x = A *ᵥ fun i ↦ (z i : ℝ))

/-- Transporting the intrinsic `ℤ`-span of the columns of `A` across the canonical equivalence
with `EuclideanSpace ℝ (Fin n)` identifies it with the corresponding column span in Euclidean
space. -/
theorem image_span_cols_eq_euclidean_span_cols
    (A : Matrix (Fin n) (Fin n) ℝ) :
    (EuclideanSpace.equiv (Fin n) ℝ).symm '' matrix_generated_lattice A =
      Submodule.span ℤ (Set.range ((EuclideanSpace.equiv (Fin n) ℝ).symm ∘ A.col)) := by
  let e : EuclideanSpace ℝ (Fin n) ≃ₗ[ℝ] (Fin n → ℝ) := EuclideanSpace.equiv (Fin n) ℝ
  let φ : (Fin n → ℝ) →ₗ[ℤ] EuclideanSpace ℝ (Fin n) := e.symm.toLinearMap.restrictScalars ℤ
  have hMap :
      (matrix_generated_lattice A).map φ =
        Submodule.span ℤ (Set.range ((EuclideanSpace.equiv (Fin n) ℝ).symm ∘ A.col)) := by
    -- Transport the lattice by the Euclidean equivalence and rewrite the image as a range.
    rw [matrix_generated_lattice_eq_span_cols A, Submodule.map_span, Set.range_comp]
    simp [φ, e]
  ext y
  constructor
  · rintro ⟨x, hx, rfl⟩
    -- The set image is exactly the underlying set of the mapped submodule.
    have hy : e.symm x ∈ (matrix_generated_lattice A).map φ :=
      Submodule.mem_map.mpr ⟨x, hx, rfl⟩
    simpa [hMap, φ, e]
      using hy
  · intro hy
    have hy' : y ∈ (matrix_generated_lattice A).map φ := by
      simpa [hMap, φ, e] using hy
    rcases Submodule.mem_map.mp hy' with ⟨x, hx, hxy⟩
    exact ⟨x, hx, hxy⟩

/-- Helper for Theorem 9.1: if two integer matrices multiply to the identity after casting to
`ℝ`, then they already multiply to the identity over `ℤ`. -/
theorem intMatrixEqOneOfRealCastEqOne
    {U Y : Matrix (Fin n) (Fin n) ℤ}
    (h : U.map (Int.castRingHom ℝ) * Y.map (Int.castRingHom ℝ) = 1) :
    U * Y = 1 := by
  -- Rewrite the real identity as the cast of the integer matrix product.
  have hMap : (U * Y).map (Int.castRingHom ℝ) = 1 := by
    calc
      (U * Y).map (Int.castRingHom ℝ) = U.map (Int.castRingHom ℝ) * Y.map (Int.castRingHom ℝ) := by
        simpa using (Matrix.map_mul (f := Int.castRingHom ℝ) (L := U) (M := Y))
      _ = 1 := h
  -- Compare entries and use injectivity of the integer cast into `ℝ`.
  ext i j
  have hij0 :
      ((U * Y).map (Int.castRingHom ℝ)) i j = (1 : Matrix (Fin n) (Fin n) ℝ) i j := by
    exact congrFun (congrFun hMap i) j
  have hij : (((U * Y) i j : ℤ) : ℝ) = (((1 : Matrix (Fin n) (Fin n) ℤ) i j : ℤ) : ℝ) := by
    simpa [Matrix.one_apply] using hij0
  exact Int.cast_injective hij

/-- Theorem 9.1. If `A` is nonsingular, then a square matrix `B` generates the same column lattice
as `A` if and only if there exists a unimodular integer matrix `U` such that `B = A U`. -/
theorem span_cols_eq_iff_exists_unimodular_right_mul
    (A B : Matrix (Fin n) (Fin n) ℝ)
    (hA : IsUnit A.det) :
    matrix_generated_lattice A = matrix_generated_lattice B ↔
      ∃ U : Matrix (Fin n) (Fin n) ℤ,
        IsUnit U.det ∧
          B = A * U.map (Int.castRingHom ℝ) := by
  constructor
  · intro hAB
    classical
    have hBcols : ∀ j : Fin n, ∃ z : Fin n → ℤ, B.col j = A *ᵥ fun i ↦ (z i : ℝ) := by
      intro j
      have hBj : B.col j ∈ matrix_generated_lattice A := by
        have hBj' : B.col j ∈ matrix_generated_lattice B := by
          rw [matrix_generated_lattice_eq_span_cols B]
          exact Submodule.subset_span ⟨j, rfl⟩
        simpa [hAB] using hBj'
      exact mem_matrix_generated_lattice_iff.mp hBj
    have hAcols : ∀ j : Fin n, ∃ z : Fin n → ℤ, A.col j = B *ᵥ fun i ↦ (z i : ℝ) := by
      intro j
      have hAj : A.col j ∈ matrix_generated_lattice B := by
        have hAj' : A.col j ∈ matrix_generated_lattice A := by
          rw [matrix_generated_lattice_eq_span_cols A]
          exact Submodule.subset_span ⟨j, rfl⟩
        simpa [hAB] using hAj'
      exact mem_matrix_generated_lattice_iff.mp hAj
    choose u hu using hBcols
    choose y hy using hAcols
    let U : Matrix (Fin n) (Fin n) ℤ := fun i j ↦ u j i
    let Y : Matrix (Fin n) (Fin n) ℤ := fun i j ↦ y j i
    have hBU : B = A * U.map (Int.castRingHom ℝ) := by
      -- Assemble the column witnesses into a single integer change-of-basis matrix.
      ext i j
      simpa [U, Matrix.mul_apply, Matrix.mulVec, Matrix.col_apply] using congrFun (hu j) i
    have hAY : A = B * Y.map (Int.castRingHom ℝ) := by
      -- The symmetric column witnesses give the inverse change-of-basis matrix.
      ext i j
      simpa [Y, Matrix.mul_apply, Matrix.mulVec, Matrix.col_apply] using congrFun (hy j) i
    have hAeq : A = A * (U.map (Int.castRingHom ℝ) * Y.map (Int.castRingHom ℝ)) := by
      calc
        A = B * Y.map (Int.castRingHom ℝ) := hAY
        _ = (A * U.map (Int.castRingHom ℝ)) * Y.map (Int.castRingHom ℝ) := by rw [hBU]
        _ = A * (U.map (Int.castRingHom ℝ) * Y.map (Int.castRingHom ℝ)) := by
          rw [Matrix.mul_assoc]
    have hUYReal : U.map (Int.castRingHom ℝ) * Y.map (Int.castRingHom ℝ) = 1 := by
      -- Cancel the nonsingular left factor `A`.
      have hCancel := congrArg (fun M => A⁻¹ * M) hAeq
      calc
        U.map (Int.castRingHom ℝ) * Y.map (Int.castRingHom ℝ) =
            A⁻¹ * (A * (U.map (Int.castRingHom ℝ) * Y.map (Int.castRingHom ℝ))) := by
              symm
              simpa [Matrix.mul_assoc] using
                (Matrix.nonsing_inv_mul_cancel_left
                  (A := A)
                  (B := U.map (Int.castRingHom ℝ) * Y.map (Int.castRingHom ℝ))
                  hA)
        _ = A⁻¹ * A := hCancel.symm
        _ = 1 := Matrix.nonsing_inv_mul (A := A) hA
    have hUY : U * Y = 1 :=
      intMatrixEqOneOfRealCastEqOne hUYReal
    exact ⟨U, Matrix.isUnit_det_of_right_inverse hUY, hBU⟩
  · rintro ⟨U, hUdet, hBU⟩
    have hU : IsUnit U := (Matrix.isUnit_iff_isUnit_det (A := U)).mpr hUdet
    rcases hU with ⟨u, rfl⟩
    let Y : Matrix (Fin n) (Fin n) ℤ := ↑u⁻¹
    have hUY : ((u : Matrix (Fin n) (Fin n) ℤ) * Y) = 1 := by
      simp [Y]
    have hUYReal :
        (u : Matrix (Fin n) (Fin n) ℤ).map (Int.castRingHom ℝ) * Y.map (Int.castRingHom ℝ) = 1 := by
      -- Cast the integral inverse identity into `ℝ`.
      calc
        (u : Matrix (Fin n) (Fin n) ℤ).map (Int.castRingHom ℝ) * Y.map (Int.castRingHom ℝ) =
            (((u : Matrix (Fin n) (Fin n) ℤ) * Y).map (Int.castRingHom ℝ)) := by
              simpa using
                (Matrix.map_mul
                  (f := Int.castRingHom ℝ)
                  (L := (u : Matrix (Fin n) (Fin n) ℤ))
                  (M := Y)).symm
        _ = 1 := by rw [hUY]; simp
    have hAY : A = B * Y.map (Int.castRingHom ℝ) := by
      -- Use the integral inverse of `U` to recover the columns of `A` from `B`.
      calc
        A = A * 1 := by simp
        _ =
            A *
              ((u : Matrix (Fin n) (Fin n) ℤ).map (Int.castRingHom ℝ) *
                Y.map (Int.castRingHom ℝ)) := by
          rw [hUYReal]
        _ =
            (A * (u : Matrix (Fin n) (Fin n) ℤ).map (Int.castRingHom ℝ)) *
              Y.map (Int.castRingHom ℝ) := by
          rw [Matrix.mul_assoc]
        _ = B * Y.map (Int.castRingHom ℝ) := by rw [hBU]
    have hAcol (j : Fin n) :
        A.col j = B *ᵥ fun i ↦ (Y i j : ℝ) := by
      -- Read the inverse change-of-basis equality one column at a time.
      ext i
      simpa [Y, Matrix.mul_apply, Matrix.mulVec, Matrix.col_apply] using congrFun (congrFun hAY i) j
    have hBcol (j : Fin n) :
        B.col j = A *ᵥ fun i ↦ ((u : Matrix (Fin n) (Fin n) ℤ) i j : ℝ) := by
      -- Read the original change-of-basis equality one column at a time.
      ext i
      simpa [Matrix.mul_apply, Matrix.mulVec, Matrix.col_apply] using congrFun (congrFun hBU i) j
    apply le_antisymm
    · rw [matrix_generated_lattice_eq_span_cols A]
      apply Submodule.span_le.mpr
      rintro x ⟨j, rfl⟩
      -- Each column of `A` is an integer combination of the columns of `B`.
      exact (mem_matrix_generated_lattice_iff.mpr ⟨fun i ↦ Y i j, hAcol j⟩)
    · rw [matrix_generated_lattice_eq_span_cols B]
      apply Submodule.span_le.mpr
      rintro x ⟨j, rfl⟩
      -- Each column of `B` is an integer combination of the columns of `A`.
      exact
        (mem_matrix_generated_lattice_iff.mpr
          ⟨fun i ↦ (u : Matrix (Fin n) (Fin n) ℤ) i j, hBcol j⟩)

end Theorem91
