import IntegerProgramming_Conforti_2014.Integer.Chapters.Chap09.section_9_1.ch9_sec9_1_1_theorem_9_1
import IntegerProgramming_Conforti_2014.Integer.Chapters.Chap09.section_9_1.ch9_sec9_1_1_theorem_9_4

open scoped Matrix
open InnerProductSpace Module

noncomputable section Example95

/-
Domain sampling for this example:
* primary domain: explicit rank-`2` lattice bases in Euclidean space and their Chapter 9
  Gram-Schmidt data
* sampled owner declarations:
  - `euclideanBasisOfMatrix` for the Euclidean basis attached to a nonsingular coordinate matrix
  - `gram_schmidt_coefficient` for the Chapter 9 Gram-Schmidt scalar
  - `IsReducedBasis` for the reduction conditions built from those coefficients
  - `Submodule.span ℤ (Set.range b)` for the intrinsic lattice generated by the basis vectors
* source/core/bridge triage:
  - source-facing data here: the concrete Example 9.5 basis vectors and their Step 1 / swap
    updates
  - core/canonical owners reused here: `euclideanBasisOfMatrix`,
    `gram_schmidt_coefficient`, `Submodule.span ℤ (Set.range b)`
  - bridge/view kept internal: the concrete coordinate matrices for the source-facing bases
-/

/-- The first basis vector `b¹ = (2, 3)` from Example 9.5. -/
def example_9_5_b1 : EuclideanSpace ℝ (Fin 2) :=
  !₂[(2 : ℝ), 3]

/-- The second basis vector `b² = (3, 2)` from Example 9.5. -/
def example_9_5_b2 : EuclideanSpace ℝ (Fin 2) :=
  !₂[(3 : ℝ), 2]

/-- The Step 1 replacement `b² - b¹` from Lovász's algorithm in Example 9.5. -/
def example_9_5_step1_b2 : EuclideanSpace ℝ (Fin 2) :=
  example_9_5_b2 - example_9_5_b1

private def example_9_5_basisMatrix : Matrix (Fin 2) (Fin 2) ℝ :=
  !![(2 : ℝ), 3; 3, 2]

private def example_9_5_step1_basisMatrix : Matrix (Fin 2) (Fin 2) ℝ :=
  !![(2 : ℝ), 1; 3, -1]

private def example_9_5_final_basisMatrix : Matrix (Fin 2) (Fin 2) ℝ :=
  !![(1 : ℝ), 2; -1, 3]

/-- The original basis `(b¹, b²)` of Example 9.5, promoted to the canonical `Basis` owner. -/
noncomputable def example_9_5_basis : Basis (Fin 2) ℝ (EuclideanSpace ℝ (Fin 2)) :=
  euclideanBasisOfMatrix example_9_5_basisMatrix <| by
    rw [example_9_5_basisMatrix, Matrix.det_fin_two_of]
    norm_num

/-- The Step 1 basis `(b¹, b² - b¹)` of Example 9.5. -/
noncomputable def example_9_5_step1_basis : Basis (Fin 2) ℝ (EuclideanSpace ℝ (Fin 2)) :=
  euclideanBasisOfMatrix example_9_5_step1_basisMatrix <| by
    rw [example_9_5_step1_basisMatrix, Matrix.det_fin_two_of]
    norm_num

/-- The final swapped basis `((1, -1), (2, 3))` of Example 9.5. -/
noncomputable def example_9_5_final_basis : Basis (Fin 2) ℝ (EuclideanSpace ℝ (Fin 2)) :=
  euclideanBasisOfMatrix example_9_5_final_basisMatrix <| by
    rw [example_9_5_final_basisMatrix, Matrix.det_fin_two_of]
    norm_num

/-- The lattice `Λ` from Example 9.5, generated by the original basis vectors. -/
def example_9_5_lattice : Submodule ℤ (EuclideanSpace ℝ (Fin 2)) :=
  Submodule.span ℤ (Set.range example_9_5_basis)

/-- The original basis of Example 9.5 has first vector `b¹`. -/
theorem example_9_5_basis_apply_zero :
    example_9_5_basis 0 = example_9_5_b1 := by
  -- Normalize the Euclidean basis back to the first column of the defining matrix.
  rw [example_9_5_basis, euclideanBasisOfMatrix, Basis.map_apply, basisOfMatrix, Basis.map_apply]
  ext i
  fin_cases i <;>
    simp [Matrix.toLinearEquiv_apply, Matrix.toLin_apply, example_9_5_basisMatrix,
      example_9_5_b1, Matrix.mulVec, dotProduct, Pi.single_apply]

/-- The original basis of Example 9.5 has second vector `b²`. -/
theorem example_9_5_basis_apply_one :
    example_9_5_basis 1 = example_9_5_b2 := by
  -- The second basis vector is the second defining column.
  rw [example_9_5_basis, euclideanBasisOfMatrix, Basis.map_apply, basisOfMatrix, Basis.map_apply]
  ext i
  fin_cases i <;>
    simp [Matrix.toLinearEquiv_apply, Matrix.toLin_apply, example_9_5_basisMatrix,
      example_9_5_b2, Matrix.mulVec, dotProduct, Pi.single_apply]

/-- The Step 1 basis keeps the first vector `b¹`. -/
theorem example_9_5_step1_basis_apply_zero :
    example_9_5_step1_basis 0 = example_9_5_b1 := by
  -- Step 1 changes only the second column, so the first column stays `b¹`.
  rw [example_9_5_step1_basis, euclideanBasisOfMatrix, Basis.map_apply, basisOfMatrix,
    Basis.map_apply]
  ext i
  fin_cases i <;>
    simp [Matrix.toLinearEquiv_apply, Matrix.toLin_apply, example_9_5_step1_basisMatrix,
      example_9_5_b1, Matrix.mulVec, dotProduct, Pi.single_apply]

/-- The Step 1 basis replaces the second vector by `b² - b¹`. -/
theorem example_9_5_step1_basis_apply_one :
    example_9_5_step1_basis 1 = example_9_5_step1_b2 := by
  -- The updated second column is the explicit Step 1 difference.
  rw [example_9_5_step1_basis, euclideanBasisOfMatrix, Basis.map_apply, basisOfMatrix,
    Basis.map_apply]
  ext i
  fin_cases i <;>
    simp [Matrix.toLinearEquiv_apply, Matrix.toLin_apply, example_9_5_step1_basisMatrix,
      example_9_5_step1_b2, example_9_5_b1, example_9_5_b2, Matrix.mulVec, dotProduct,
      Pi.single_apply]
  · norm_num
  · norm_num

/-- After the swap, the first vector is `b² - b¹`. -/
theorem example_9_5_final_basis_apply_zero :
    example_9_5_final_basis 0 = example_9_5_step1_b2 := by
  -- After swapping, the first column is the short vector found in Step 1.
  rw [example_9_5_final_basis, euclideanBasisOfMatrix, Basis.map_apply, basisOfMatrix,
    Basis.map_apply]
  ext i
  fin_cases i <;>
    simp [Matrix.toLinearEquiv_apply, Matrix.toLin_apply, example_9_5_final_basisMatrix,
      example_9_5_step1_b2, example_9_5_b1, example_9_5_b2, Matrix.mulVec, dotProduct,
      Pi.single_apply]
  · norm_num
  · norm_num

/-- After the swap, the second vector is the original `b¹`. -/
theorem example_9_5_final_basis_apply_one :
    example_9_5_final_basis 1 = example_9_5_b1 := by
  -- The second column after the swap is the original first basis vector.
  rw [example_9_5_final_basis, euclideanBasisOfMatrix, Basis.map_apply, basisOfMatrix,
    Basis.map_apply]
  ext i
  fin_cases i <;>
    simp [Matrix.toLinearEquiv_apply, Matrix.toLin_apply, example_9_5_final_basisMatrix,
      example_9_5_b1, Matrix.mulVec, dotProduct, Pi.single_apply]

/-- Helper for Example 9.5: the Lovász Step 1 replacement is the vector `(1, -1)`. -/
theorem example_9_5_step1_b2_eq :
    example_9_5_step1_b2 = !₂[(1 : ℝ), -1] := by
  -- Compute the coordinatewise difference `b² - b¹`.
  ext i
  fin_cases i <;>
    simp [example_9_5_step1_b2, example_9_5_b1, example_9_5_b2]
  · norm_num
  · norm_num

/-- Helper for Example 9.5: the initial Gram-Schmidt coefficient is `μ₂₁ = 12 / 13`. -/
theorem example_9_5_initial_mu21_eq :
    gram_schmidt_coefficient example_9_5_basis 1 0 = (12 : ℝ) / 13 := by
  -- The first Gram-Schmidt vector is just the first basis vector in dimension `2`.
  have hgs0 : gramSchmidtBasis example_9_5_basis 0 = example_9_5_b1 := by
    rw [coe_gramSchmidtBasis]
    calc
      gramSchmidt ℝ (⇑example_9_5_basis) 0 = example_9_5_basis 0 :=
        gramSchmidt_bot (𝕜 := ℝ) (f := example_9_5_basis)
      _ = example_9_5_b1 := example_9_5_basis_apply_zero
  -- Once the basis vectors are explicit, the coefficient is a direct coordinate computation.
  unfold gram_schmidt_coefficient
  rw [example_9_5_basis_apply_one, hgs0]
  rw [EuclideanSpace.inner_eq_star_dotProduct, EuclideanSpace.real_norm_sq_eq]
  norm_num [dotProduct, example_9_5_b1, example_9_5_b2]

/-- Helper for Example 9.5: the Step 1 replacement `b² - b¹` is shorter than `b²`. -/
theorem example_9_5_step1_b2_shorter :
    ‖example_9_5_step1_b2‖ ^ 2 < ‖example_9_5_b2‖ ^ 2 := by
  -- Compare squared norms directly from the explicit coordinates.
  rw [example_9_5_step1_b2_eq, EuclideanSpace.real_norm_sq_eq, EuclideanSpace.real_norm_sq_eq]
  norm_num [example_9_5_b2]

/-- Helper for Example 9.5: after Step 1 the Gram-Schmidt coefficient becomes `μ₂₁ = -1 / 13`. -/
theorem example_9_5_step1_mu21_eq :
    gram_schmidt_coefficient example_9_5_step1_basis 1 0 = (-1 : ℝ) / 13 := by
  -- The first Gram-Schmidt vector of the Step 1 basis is still `b¹`.
  have hgs0 : gramSchmidtBasis example_9_5_step1_basis 0 = example_9_5_b1 := by
    rw [coe_gramSchmidtBasis]
    calc
      gramSchmidt ℝ (⇑example_9_5_step1_basis) 0 = example_9_5_step1_basis 0 :=
        gramSchmidt_bot (𝕜 := ℝ) (f := example_9_5_step1_basis)
      _ = example_9_5_b1 := example_9_5_step1_basis_apply_zero
  -- The updated second vector gives the textbook value `-1 / 13`.
  unfold gram_schmidt_coefficient
  rw [example_9_5_step1_basis_apply_one, hgs0]
  rw [EuclideanSpace.inner_eq_star_dotProduct, EuclideanSpace.real_norm_sq_eq]
  norm_num [dotProduct, example_9_5_step1_b2, example_9_5_b1, example_9_5_b2]

/-- Helper for Example 9.5: after Step 1 the Lovász inequality is violated:
`‖b² - b¹‖² < (3 / 4) ‖b¹‖²`. -/
theorem example_9_5_step1_violates_lovasz_condition :
    ‖example_9_5_step1_b2‖ ^ 2 < (3 : ℝ) / 4 * ‖example_9_5_b1‖ ^ 2 := by
  -- The squared norms are `2` and `13`, so the Lovász bound fails immediately.
  rw [example_9_5_step1_b2_eq, EuclideanSpace.real_norm_sq_eq, EuclideanSpace.real_norm_sq_eq]
  norm_num [example_9_5_b1]

/-- Helper for Example 9.5: swapping `(b¹, b² - b¹)` yields the basis
`((1, -1), (2, 3))`, which still
generates the original lattice `Λ`. -/
theorem example_9_5_final_basis_spans_example_9_5_lattice :
    Submodule.span ℤ (Set.range example_9_5_final_basis) = example_9_5_lattice := by
  rw [example_9_5_lattice]
  apply le_antisymm
  · -- Each swapped generator is an integer combination of the original basis vectors.
    refine Submodule.span_le.mpr ?_
    rintro x ⟨i, rfl⟩
    fin_cases i
    · have hb2 : example_9_5_b2 ∈ Submodule.span ℤ (Set.range example_9_5_basis) :=
        Submodule.subset_span ⟨1, example_9_5_basis_apply_one⟩
      have hb1 : example_9_5_b1 ∈ Submodule.span ℤ (Set.range example_9_5_basis) :=
        Submodule.subset_span ⟨0, example_9_5_basis_apply_zero⟩
      simpa [example_9_5_final_basis_apply_zero] using Submodule.sub_mem _ hb2 hb1
    · simpa [example_9_5_final_basis_apply_one] using
        (Submodule.subset_span ⟨0, example_9_5_basis_apply_zero⟩ :
          example_9_5_b1 ∈ Submodule.span ℤ (Set.range example_9_5_basis))
  · -- Conversely, recover `b²` as `(b² - b¹) + b¹` inside the swapped span.
    refine Submodule.span_le.mpr ?_
    rintro x ⟨i, rfl⟩
    fin_cases i
    · simpa [example_9_5_basis_apply_zero, example_9_5_final_basis_apply_one] using
        (Submodule.subset_span ⟨1, example_9_5_final_basis_apply_one⟩ :
          example_9_5_b1 ∈ Submodule.span ℤ (Set.range example_9_5_final_basis))
    · have hstep : example_9_5_step1_b2 ∈ Submodule.span ℤ (Set.range example_9_5_final_basis) :=
        Submodule.subset_span ⟨0, example_9_5_final_basis_apply_zero⟩
      have hb1 : example_9_5_b1 ∈ Submodule.span ℤ (Set.range example_9_5_final_basis) :=
        Submodule.subset_span ⟨1, example_9_5_final_basis_apply_one⟩
      have hb2 : example_9_5_b2 ∈ Submodule.span ℤ (Set.range example_9_5_final_basis) := by
        simpa [example_9_5_step1_b2] using Submodule.add_mem _ hstep hb1
      simpa [example_9_5_basis_apply_one] using hb2

/-- Helper for Example 9.5: the final swapped basis has Gram-Schmidt coefficient `μ₂₁ = -1 / 2`. -/
theorem example_9_5_final_mu21_eq :
    gram_schmidt_coefficient example_9_5_final_basis 1 0 = (-1 : ℝ) / 2 := by
  -- After the swap, the first Gram-Schmidt vector is the short vector `(1, -1)`.
  have hgs0 : gramSchmidtBasis example_9_5_final_basis 0 = example_9_5_step1_b2 := by
    rw [coe_gramSchmidtBasis]
    calc
      gramSchmidt ℝ (⇑example_9_5_final_basis) 0 = example_9_5_final_basis 0 :=
        gramSchmidt_bot (𝕜 := ℝ) (f := example_9_5_final_basis)
      _ = example_9_5_step1_b2 := example_9_5_final_basis_apply_zero
  -- The coefficient against that first Gram-Schmidt vector is `-1 / 2`.
  unfold gram_schmidt_coefficient
  rw [example_9_5_final_basis_apply_one, hgs0]
  rw [EuclideanSpace.inner_eq_star_dotProduct, EuclideanSpace.real_norm_sq_eq]
  norm_num [dotProduct, example_9_5_step1_b2, example_9_5_b1, example_9_5_b2]

/-- Example 9.5. The final swapped basis `((1, -1), (2, 3))` is reduced. -/
theorem example_9_5_final_basis_reduction_conditions :
    IsReducedBasis example_9_5_final_basis := by
  -- Assemble the reduced-basis proof from the unique size-reduction and Lovász cases in rank `2`.
  refine basis_reduction_algorithm_terminates_with_reduced_basis ?_ ?_
  · intro j k hjk
    fin_cases j <;> fin_cases k
    · norm_num at hjk
    · norm_num at hjk
    · simpa [example_9_5_final_mu21_eq] using
        (show |gram_schmidt_coefficient example_9_5_final_basis 1 0| ≤ (1 : ℝ) / 2 by
          rw [example_9_5_final_mu21_eq]
          norm_num)
    · norm_num at hjk
  · intro j
    fin_cases j
    dsimp
    -- Rewrite the Step 2 inequality to the explicit vectors `b² - b¹` and `b¹`.
    have hgs0 : gramSchmidt ℝ (⇑example_9_5_final_basis) 0 = example_9_5_step1_b2 := by
      calc
        gramSchmidt ℝ (⇑example_9_5_final_basis) 0 = example_9_5_final_basis 0 :=
          gramSchmidt_bot (𝕜 := ℝ) (f := example_9_5_final_basis)
        _ = example_9_5_step1_b2 := example_9_5_final_basis_apply_zero
    have hIio : Finset.Iio (1 : Fin 2) = {0} := by
      decide
    have hrhs :
        example_9_5_b1 =
          gramSchmidt ℝ (⇑example_9_5_final_basis) 1 +
            gram_schmidt_coefficient example_9_5_final_basis 1 0 • example_9_5_step1_b2 := by
      calc
        example_9_5_b1 = example_9_5_final_basis 1 := example_9_5_final_basis_apply_one.symm
        _ = gramSchmidt ℝ (⇑example_9_5_final_basis) 1 +
              (⟪gramSchmidt ℝ (⇑example_9_5_final_basis) 0, example_9_5_final_basis 1⟫_ℝ /
                  ‖gramSchmidt ℝ (⇑example_9_5_final_basis) 0‖ ^ 2) •
                gramSchmidt ℝ (⇑example_9_5_final_basis) 0 := by
              have hdecomp0 :=
                (gramSchmidt_def'' (𝕜 := ℝ) (f := example_9_5_final_basis) (n := 1))
              rw [hIio, Finset.sum_singleton] at hdecomp0
              exact hdecomp0
        _ = gramSchmidt ℝ (⇑example_9_5_final_basis) 1 +
              gram_schmidt_coefficient example_9_5_final_basis 1 0 • example_9_5_step1_b2 := by
              rw [gram_schmidt_coefficient, coe_gramSchmidtBasis, real_inner_comm, hgs0]
    rw [coe_gramSchmidtBasis, hgs0, ← hrhs]
    -- The last inequality is the explicit norm comparison `‖(1,-1)‖ ≤ ‖(2,3)‖`.
    have hsquared : ‖example_9_5_step1_b2‖ ^ 2 ≤ ‖example_9_5_b1‖ ^ 2 := by
      rw [EuclideanSpace.real_norm_sq_eq, EuclideanSpace.real_norm_sq_eq]
      norm_num [example_9_5_step1_b2, example_9_5_b1, example_9_5_b2]
    have hnonnegStep : 0 ≤ ‖example_9_5_step1_b2‖ := norm_nonneg _
    have hnonnegB1 : 0 ≤ ‖example_9_5_b1‖ := norm_nonneg _
    nlinarith

end Example95
