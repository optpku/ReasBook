import IntegerProgramming_Conforti_2014.Integer.Chapters.Chap06.section_6_2.ch6_sec6_2_theorem_6_5

open IntersectionCut
open scoped BigOperators

section Example68

local notation "R2" => Fin 2 → ℝ
local notation "Z2" => Fin 2 → ℤ

/-- Membership in the canonical embedded lattice `mixed_integer_prefix_lattice le_rfl : Set R2`
means that the point is the real coercion of an integral vector. -/
theorem mem_example_6_8_integer_lattice_iff
    (x : R2) :
    x ∈ mixed_integer_prefix_lattice (le_rfl : 2 ≤ 2) ↔
      ∃ z : Z2, x = fun i ↦ (z i : ℝ) := by
  rw [mem_mixed_integer_prefix_lattice_iff]
  constructor
  · intro hx
    classical
    refine ⟨fun i ↦ Classical.choose (hx i), ?_⟩
    funext i
    exact Classical.choose_spec (hx i)
  · rintro ⟨z, rfl⟩ i
    exact ⟨z i, rfl⟩

/-- The cone with apex `b` generated by the two rays from Example 6.8. -/
def example_6_8_two_ray_cone
    (b : R2)
    (rays : Fin 2 → R2) :
    Set R2 :=
  {x | ∃ y : R2, (∀ j : Fin 2, 0 ≤ y j) ∧ x = corner_point b rays y}

/-- Membership in `example_6_8_two_ray_cone b rays` means that the point is obtained from the
apex by a nonnegative combination of the two rays. -/
theorem mem_example_6_8_two_ray_cone_iff
    (b : R2)
    (rays : Fin 2 → R2)
    (x : R2) :
    x ∈ example_6_8_two_ray_cone b rays ↔
      ∃ y : R2, (∀ j : Fin 2, 0 ≤ y j) ∧ x = corner_point b rays y :=
  Iff.rfl

/-- Membership in the canonical ambient corner polyhedron specialized to Example 6.8 means that
`x` is a lattice point obtained from `b` by a nonnegative combination of the two rays. -/
theorem mem_example_6_8_ambient_corner_polyhedron_iff
    (b : R2)
    (rays : Fin 2 → R2)
    (x : R2) :
    x ∈ ambient_corner_polyhedron (le_rfl : 2 ≤ 2) b rays ↔
      ∃ y : R2,
        (∀ j : Fin 2, 0 ≤ y j) ∧
          x = corner_point b rays y ∧
            x ∈ mixed_integer_prefix_lattice (le_rfl : 2 ≤ 2) := by
  rw [mem_ambient_corner_polyhedron_iff]
  constructor
  · rintro ⟨y, hy, hxy⟩
    rw [mem_corner_polyhedron_iff] at hy
    exact ⟨y, hy.1, hxy.symm, by simpa [hxy] using hy.2⟩
  · rintro ⟨y, hy_nonneg, hxy, hx_int⟩
    refine ⟨y, ?_, hxy.symm⟩
    rw [mem_corner_polyhedron_iff]
    exact ⟨hy_nonneg, by simpa [hxy] using hx_int⟩

/-- The boundary point obtained by following the `j`th half-line from `b` for parameter
`α j`. -/
def example_6_8_boundary_point
    (b : R2)
    (rays : Fin 2 → R2)
    (α : R2)
    (j : Fin 2) : R2 :=
  b + α j • rays j

/-- `example_6_8_boundary_point b rays α j` is the translated ray point `b + αⱼ rʲ`. -/
theorem example_6_8_boundary_point_def
    (b : R2)
    (rays : Fin 2 → R2)
    (α : R2)
    (j : Fin 2) :
    example_6_8_boundary_point b rays α j = b + α j • rays j :=
  rfl

/-- The two-variable intersection cut `y₁ / α₁ + y₂ / α₂ ≥ 1` attached to the boundary
intersection parameters `α₁`, `α₂`. -/
def example_6_8_intersection_cut
    (α : R2) :
    Set R2 :=
  {y | (∀ j : Fin 2, 0 ≤ y j) ∧ 1 ≤ ∑ j : Fin 2, y j / α j}

/-- Membership in `example_6_8_intersection_cut α` is the nonnegativity of the ray variables
together with the inequality `y₁ / α₁ + y₂ / α₂ ≥ 1`. -/
theorem mem_example_6_8_intersection_cut_iff
    (α : R2)
    (y : R2) :
    y ∈ example_6_8_intersection_cut α ↔
      (∀ j : Fin 2, 0 ≤ y j) ∧ 1 ≤ ∑ j : Fin 2, y j / α j :=
  Iff.rfl

/-- The line through the two boundary intersection points `p¹ = b + α₁ r¹` and
`p² = b + α₂ r²`. -/
def example_6_8_cut_line
    (b : R2)
    (rays : Fin 2 → R2)
    (α : R2) :
    Set R2 :=
  Set.range fun t : ℝ ↦
    (1 - t) • example_6_8_boundary_point b rays α 0 + t • example_6_8_boundary_point b rays α 1

/-- Membership in `example_6_8_cut_line b rays α` means belonging to the affine line through the
two boundary intersection points on the rays. -/
theorem mem_example_6_8_cut_line_iff
    (b : R2)
    (rays : Fin 2 → R2)
    (α : R2)
    (x : R2) :
    x ∈ example_6_8_cut_line b rays α ↔
      ∃ t : ℝ,
        x =
          (1 - t) • example_6_8_boundary_point b rays α 0 +
            t • example_6_8_boundary_point b rays α 1 := by
  simp [example_6_8_cut_line, eq_comm]

/-- First claim from Example 6.8. The projection of the linear relaxation of (6.10) onto the
`(x₁,x₂)`-space
is the image of the nonnegative ray-coordinate orthant under `corner_point b rays`, hence the cone
with apex `b` generated by the two rays. -/
theorem example_6_8_linear_relaxation_projection_eq_two_ray_cone
    (b : R2)
    (rays : Fin 2 → R2) :
    corner_point b rays '' {y : R2 | ∀ j : Fin 2, 0 ≤ y j} =
      example_6_8_two_ray_cone b rays := by
  ext x
  constructor
  · rintro ⟨y, hy_nonneg, rfl⟩
    exact ⟨y, hy_nonneg, rfl⟩
  · rintro ⟨y, hy_nonneg, rfl⟩
    exact ⟨y, hy_nonneg, rfl⟩

/-- Second claim from Example 6.8. The projected mixed-integer feasible set of (6.10), namely the
canonical
ambient corner polyhedron, is exactly the set of lattice points of the cone with apex `b` and rays
`r¹`, `r²`. -/
theorem example_6_8_mixed_integer_projection_eq_lattice_points_in_cone
    (b : R2)
    (rays : Fin 2 → R2) :
    ambient_corner_polyhedron (le_rfl : 2 ≤ 2) b rays =
      example_6_8_two_ray_cone b rays ∩
        mixed_integer_prefix_lattice (le_rfl : 2 ≤ 2) := by
  ext x
  constructor
  · rw [mem_example_6_8_ambient_corner_polyhedron_iff]
    rintro ⟨y, hy_nonneg, rfl, hx_int⟩
    exact ⟨⟨y, hy_nonneg, rfl⟩, hx_int⟩
  · rintro ⟨hx_cone, hx_int⟩
    rcases hx_cone with ⟨y, hy_nonneg, rfl⟩
    rw [mem_example_6_8_ambient_corner_polyhedron_iff]
    exact ⟨y, hy_nonneg, rfl, hx_int⟩

/-- Helper for Example 6.8: expanding the affine combination of the two boundary points yields
the apex `b` together with the corresponding weighted rays. -/
theorem example_6_8_affineBoundaryCombination
    (b : R2)
    (rays : Fin 2 → R2)
    (α : R2)
    (t : ℝ) :
    (1 - t) • example_6_8_boundary_point b rays α 0 +
        t • example_6_8_boundary_point b rays α 1 =
      b + ((1 - t) * α 0) • rays 0 + (t * α 1) • rays 1 := by
  -- Expand both boundary points and verify the affine identity coordinatewise.
  ext i
  simp [example_6_8_boundary_point_def]
  ring

/-- Helper for Example 6.8: the line parameter `t = y 1 / α 1` turns the affine weights of the
boundary points into the original ray coefficients. -/
theorem example_6_8_cutWeightIdentities
    (α y : R2)
    (hα : ∀ j : Fin 2, 0 < α j)
    (hy_eq : y 0 / α 0 + y 1 / α 1 = 1) :
    (1 - y 1 / α 1) * α 0 = y 0 ∧
      (y 1 / α 1) * α 1 = y 1 := by
  have hα0 : α 0 ≠ 0 := (hα 0).ne'
  have hweight : 1 - y 1 / α 1 = y 0 / α 0 := by
    linarith
  constructor
  · -- Rewrite the first affine weight using the cut equation, then cancel `α 0`.
    calc
      (1 - y 1 / α 1) * α 0 = (y 0 / α 0) * α 0 := by rw [hweight]
      _ = y 0 := by
        rw [div_eq_mul_inv, mul_assoc, inv_mul_cancel₀ hα0, mul_one]
  · -- The second affine weight is a direct division cancellation.
    rw [div_eq_mul_inv, mul_assoc, inv_mul_cancel₀ (hα 1).ne', mul_one]

/-- Example 6.8 (3). When `y₁ / α₁ + y₂ / α₂ = 1`, the corresponding point
`b + y₁ r¹ + y₂ r²` lies on the line through the ray-boundary intersection points
`p¹ = b + α₁ r¹` and `p² = b + α₂ r²`. -/
theorem example_6_8_cut_boundary_maps_to_line
    (b : R2)
    (rays : Fin 2 → R2)
    (α y : R2)
    (hα : ∀ j : Fin 2, 0 < α j)
    (hy_eq : y 0 / α 0 + y 1 / α 1 = 1) :
    b + ∑ j : Fin 2, y j • rays j ∈ example_6_8_cut_line b rays α := by
  rw [mem_example_6_8_cut_line_iff]
  refine ⟨y 1 / α 1, ?_⟩
  obtain ⟨hweight0, hweight1⟩ := example_6_8_cutWeightIdentities α y hα hy_eq
  -- Rewrite the target point into the affine form given by the two boundary points.
  calc
    b + ∑ j : Fin 2, y j • rays j = b + y 0 • rays 0 + y 1 • rays 1 := by
      simp [Fin.sum_univ_two, add_assoc]
    _ = b + ((1 - y 1 / α 1) * α 0) • rays 0 + ((y 1 / α 1) * α 1) • rays 1 := by
      rw [hweight0, hweight1]
    _ = (1 - y 1 / α 1) • example_6_8_boundary_point b rays α 0 +
          (y 1 / α 1) • example_6_8_boundary_point b rays α 1 := by
      rw [example_6_8_affineBoundaryCombination]

/-- Helper for Example 6.8: subtracting the apex from the `j`th boundary point recovers the
scaled ray displacement `α j • rays j`. -/
theorem example_6_8_boundaryPoint_sub_eq_smul
    (b : R2)
    (rays : Fin 2 → R2)
    (α : R2)
    (j : Fin 2) :
    example_6_8_boundary_point b rays α j - b = α j • rays j := by
  -- Cancel the common apex term before taking norms.
  ext i
  simp [example_6_8_boundary_point_def]

/-- Helper for Example 6.8: the norm of the boundary displacement is `α j` times the norm of the
`j`th ray whenever `α j` is nonnegative. -/
theorem example_6_8_boundaryPoint_norm_eq_mul_norm
    (b : R2)
    (rays : Fin 2 → R2)
    (α : R2)
    (j : Fin 2)
    (hαj : 0 ≤ α j) :
    ‖example_6_8_boundary_point b rays α j - b‖ = α j * ‖rays j‖ := by
  -- Move to the pure ray displacement and evaluate the scalar norm exactly.
  rw [example_6_8_boundaryPoint_sub_eq_smul, norm_smul, Real.norm_of_nonneg hαj]

/-- Final claim from Example 6.8. For the boundary intersection point `pʲ = b + αⱼ rʲ`, the ray
parameter is
the norm ratio `αⱼ = ‖pʲ - b‖ / ‖rʲ‖`. -/
theorem example_6_8_intersection_parameters_eq_norm_ratios
    (b : R2)
    (rays : Fin 2 → R2)
    (α : R2)
    (hα : ∀ j : Fin 2, 0 ≤ α j)
    (hr : ∀ j : Fin 2, rays j ≠ 0)
    (j : Fin 2) :
    α j = ‖example_6_8_boundary_point b rays α j - b‖ / ‖rays j‖ := by
  have hnorm : 0 < ‖rays j‖ := norm_pos_iff.mpr (hr j)
  -- Normalize the numerator first, then cancel the positive ray norm.
  calc
    α j = (α j * ‖rays j‖) / ‖rays j‖ := by
      rw [mul_div_assoc, div_self hnorm.ne', mul_one]
    _ = ‖example_6_8_boundary_point b rays α j - b‖ / ‖rays j‖ := by
      rw [← example_6_8_boundaryPoint_norm_eq_mul_norm b rays α j (hα j)]

end Example68
