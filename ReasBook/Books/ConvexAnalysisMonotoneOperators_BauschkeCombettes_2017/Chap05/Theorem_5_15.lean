section

variable {H : Type u} [AddCommGroup H] [Module ℝ H]
variable {D : Set H}

-- Proof sketch: write the next step as the convex combination
-- `(1 - λ n) • x + λ n • T x`; since both endpoints lie in `D` and `λ n ∈ [0, 1]`, convexity of
-- `D` keeps the step inside `D`.
/-- The Krasnosel'skii-Mann step stays in a convex set when the relaxation parameter lies in
`[0, 1]`. -/
theorem krasnoselskiiMannStep_mem
    (hD_convex : Convex ℝ D) (T : D → D) (relax : ℕ → ℝ)
    (hrelax : ∀ n, relax n ∈ Set.Icc (0 : ℝ) 1) (x : D) (n : ℕ) :
    (1 - relax n) • (x : H) + relax n • (T x : H) ∈ D := by
  -- Realize the next iterate as the standard line-map point between `x` and `T x`.
  have hline : AffineMap.lineMap (x : H) (T x : H) (relax n) ∈ D :=
    hD_convex.lineMap_mem x.2 (T x).2 (hrelax n)
  simpa [AffineMap.lineMap_apply, sub_eq_add_neg, smul_sub, add_smul, one_smul, add_assoc,
    add_left_comm, add_comm] using hline

/-- The Krasnosel'skii-Mann iteration on `D` generated by a self-map `T`, relaxation parameters
`λ`, and an initial point `x₀`. This is the source-facing recursive orbit; under additive-group
assumptions, it agrees with the chapter owner `relaxedOperatorIteration` for the induced ambient
self-map. -/
def krasnoselskiiMannIteration
    (hD_convex : Convex ℝ D) (T : D → D) (relax : ℕ → ℝ)
    (hrelax : ∀ n, relax n ∈ Set.Icc (0 : ℝ) 1) (x₀ : D) : ℕ → D
  | 0 => x₀
  | n + 1 =>
      let xₙ := krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n
      ⟨(1 - relax n) • (xₙ : H) + relax n • (T xₙ : H),
        krasnoselskiiMannStep_mem hD_convex T relax hrelax xₙ n⟩

-- Proof sketch: unfold the recursive definition at index `0`.
/-- The Krasnosel'skii-Mann iteration starts at the prescribed initial point. -/
@[simp]
theorem krasnoselskiiMannIteration_zero
    (hD_convex : Convex ℝ D) (T : D → D) (relax : ℕ → ℝ)
    (hrelax : ∀ n, relax n ∈ Set.Icc (0 : ℝ) 1) (x₀ : D) :
    krasnoselskiiMannIteration hD_convex T relax hrelax x₀ 0 = x₀ := by
  -- The recursive orbit is defined to start at `x₀`.
  rfl

end

section

variable {H : Type u} [AddCommGroup H] [Module ℝ H]
variable {D : Set H}

-- Proof sketch: unfold the recursive definition at `n + 1` and rewrite the affine combination
-- `(1 - λ n) • xₙ + λ n • T xₙ` as `xₙ + λ n • (T xₙ - xₙ)`.
/-- The ambient-value recursion for the Krasnosel'skii-Mann iteration is the textbook formula
`xₙ₊₁ = xₙ + λₙ (T xₙ - xₙ)`. -/
@[simp]
theorem krasnoselskiiMannIteration_succ
    (hD_convex : Convex ℝ D) (T : D → D) (relax : ℕ → ℝ)
    (hrelax : ∀ n, relax n ∈ Set.Icc (0 : ℝ) 1) (x₀ : D) (n : ℕ) :
    (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ (n + 1) : H) =
      (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n : H) +
        relax n •
          ((T (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n) : H) -
            (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n : H)) := by
  -- Unfold the subtype-valued step and rewrite the affine combination into textbook residual form.
  let xn := krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n
  calc
    (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ (n + 1) : H) =
        (1 - relax n) • (xn : H) + relax n • (T xn : H) := by
          simp [krasnoselskiiMannIteration, xn]
    _ = (xn : H) + relax n • ((T xn : H) - (xn : H)) := by
          rw [smul_sub]
          rw [sub_smul, one_smul]
          abel_nf

/-- Helper for Theorem 5.15: subtracting an ambient point from one Krasnosel'skii-Mann step
rewrites the result as the corresponding affine combination of error vectors. -/
private theorem krasnoselskiiMannIteration_sub_eq_affineCombination
    (hD_convex : Convex ℝ D) (T : D → D) (relax : ℕ → ℝ)
    (hrelax : ∀ n, relax n ∈ Set.Icc (0 : ℝ) 1) (x₀ : D) (y : H) (n : ℕ) :
    (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ (n + 1) : H) - y =
      (1 - relax n) •
          ((krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n : H) - y) +
        relax n •
          ((T (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n) : H) - y) := by
  -- Distribute subtraction across the affine step and collect the like terms.
  let xn := krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n
  have hrelax_rewrite :
      relax n • ((T xn : H) - (xn : H)) =
        -(relax n • ((xn : H) - y)) + relax n • ((T xn : H) - y) := by
    have hsub :
        ((T xn : H) - y) - ((xn : H) - y) = (T xn : H) - (xn : H) := by
      abel_nf
    calc
      relax n • ((T xn : H) - (xn : H)) =
          relax n • (((T xn : H) - y) - ((xn : H) - y)) := by rw [hsub]
      _ = relax n • ((T xn : H) - y) - relax n • ((xn : H) - y) := by
            rw [smul_sub]
      _ = -(relax n • ((xn : H) - y)) + relax n • ((T xn : H) - y) := by
            abel_nf
  calc
    (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ (n + 1) : H) - y =
        ((xn : H) + relax n • ((T xn : H) - (xn : H))) - y := by
          rw [krasnoselskiiMannIteration_succ]
    _ = ((xn : H) - y) + relax n • ((T xn : H) - (xn : H)) := by
          abel_nf
    _ = ((xn : H) - y) + (-(relax n • ((xn : H) - y)) + relax n • ((T xn : H) - y)) := by
          rw [hrelax_rewrite]
    _ = (1 - relax n) • ((xn : H) - y) + relax n • ((T xn : H) - y) := by
      have hu :
          ((xn : H) - y) + -(relax n • ((xn : H) - y)) =
            (1 - relax n) • ((xn : H) - y) := by
          rw [sub_smul, one_smul]
          abel_nf
      calc
        ((xn : H) - y) + (-(relax n • ((xn : H) - y)) + relax n • ((T xn : H) - y)) =
            (((xn : H) - y) + -(relax n • ((xn : H) - y))) +
              relax n • ((T xn : H) - y) := by
                abel_nf
        _ = (1 - relax n) • ((xn : H) - y) + relax n • ((T xn : H) - y) := by
              rw [hu]

/-- Helper for Theorem 5.15: consecutive Krasnosel'skii-Mann iterates differ by the relaxed
residual. -/
private theorem krasnoselskiiMannIteration_sub_eq_relax_residual
    (hD_convex : Convex ℝ D) (T : D → D) (relax : ℕ → ℝ)
    (hrelax : ∀ n, relax n ∈ Set.Icc (0 : ℝ) 1) (x₀ : D) (n : ℕ) :
    (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ (n + 1) : H) -
        (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n : H) =
      relax n •
        ((T (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n) : H) -
          (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n : H)) := by
  -- The successor formula already has the desired increment after moving `xₙ` to the left.
  let xn := krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n
  calc
    (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ (n + 1) : H) -
        (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n : H) =
      ((xn : H) + relax n • ((T xn : H) - (xn : H))) - (xn : H) := by
        rw [krasnoselskiiMannIteration_succ]
    _ = relax n • ((T xn : H) - (xn : H)) := by
        abel_nf

end

section

variable {H : Type u} [NormedAddCommGroup H] [NormedSpace ℝ H]
variable {D : Set H}

-- Proof sketch: for each fixed point `y` of `T`, expand the squared norm of
-- `(1 - λ n) • (xₙ - y) + λ n • (T xₙ - y)` in the subtype metric and use nonexpansiveness of `T`
-- together with `T y = y` to obtain the one-step Fejér inequality.
/-- Theorem 5.15 (1): the Krasnosel'skii-Mann iteration is Fejér monotone with respect to the
ambient realization of its fixed-point set. -/
theorem krasnoselskiiMannIteration_fejerMonotone
    (hD_convex : Convex ℝ D) (T : D → D) (hT : LipschitzWith 1 T)
    (relax : ℕ → ℝ) (hrelax : ∀ n, relax n ∈ Set.Icc (0 : ℝ) 1) (x₀ : D) :
    FejerMonotone (Subtype.val '' fixedPoints T)
      (fun n ↦ (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n : H)) :=
  by
    intro y hy n
    rcases hy with ⟨y, hy, rfl⟩
    let xn := krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n
    have hyfix : T y = y := Function.mem_fixedPoints_iff.mp hy
    have hrelax_nonneg : 0 ≤ relax n := (hrelax n).1
    have hone_sub_nonneg : 0 ≤ 1 - relax n := sub_nonneg.mpr (hrelax n).2
    have hTx :
        ‖(T xn : H) - y‖ ≤ ‖(xn : H) - y‖ := by
      simpa [Subtype.dist_eq, dist_eq_norm, hyfix, one_mul, xn] using hT.dist_le_mul xn y
    have hweighted :
        relax n * ‖(T xn : H) - y‖ ≤ relax n * ‖(xn : H) - y‖ :=
      mul_le_mul_of_nonneg_left hTx hrelax_nonneg
    -- Rewrite the successor error as the convex combination of the current error and image error.
    calc
      dist (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ (n + 1) : H) y =
          ‖(1 - relax n) • ((xn : H) - y) + relax n • ((T xn : H) - y)‖ := by
            rw [dist_eq_norm, krasnoselskiiMannIteration_sub_eq_affineCombination]
      _ ≤ ‖(1 - relax n) • ((xn : H) - y)‖ + ‖relax n • ((T xn : H) - y)‖ :=
            norm_add_le _ _
      _ = (1 - relax n) * ‖(xn : H) - y‖ + relax n * ‖(T xn : H) - y‖ := by
            rw [norm_smul, norm_smul, Real.norm_eq_abs, Real.norm_eq_abs,
              abs_of_nonneg hone_sub_nonneg, abs_of_nonneg hrelax_nonneg]
      _ ≤ (1 - relax n) * ‖(xn : H) - y‖ + relax n * ‖(xn : H) - y‖ := by
            exact add_le_add le_rfl hweighted
      _ = dist (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n : H) y := by
            rw [dist_eq_norm]
            ring

end

section

variable {H : Type u} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
variable {D : Set H}

/-- Helper for Theorem 5.15: the squared norm of an affine combination plus the weighted squared
gap equals the corresponding affine combination of squared norms. -/
private theorem weighted_affine_norm_sq_identity (u v : H) (α : ℝ) :
    ‖α • u + (1 - α) • v‖ ^ 2 + α * (1 - α) * ‖u - v‖ ^ 2 =
      α * ‖u‖ ^ 2 + (1 - α) * ‖v‖ ^ 2 := by
  -- Expand both squared norms by the real inner-product identities and normalize the coefficients.
  rw [norm_add_sq_real, norm_sub_sq_real, norm_smul, norm_smul, Real.norm_eq_abs,
    Real.norm_eq_abs]
  simp [real_inner_smul_left, real_inner_smul_right]
  nlinarith [sq_abs α, sq_abs (1 - α)]

/-- Helper for Theorem 5.15: one Krasnosel'skii-Mann step satisfies the textbook energy inequality
with respect to every fixed point of `T`. -/
private theorem krasnoselskiiMann_sqdist_step_le_sqdist_of_fixedPoint
    (hD_convex : Convex ℝ D) (T : D → D) (hT : LipschitzWith 1 T)
    (relax : ℕ → ℝ) (hrelax : ∀ n, relax n ∈ Set.Icc (0 : ℝ) 1) (x₀ : D)
    (y : fixedPoints T) (n : ℕ) :
    ‖(krasnoselskiiMannIteration hD_convex T relax hrelax x₀ (n + 1) : H) - y‖ ^ 2 ≤
      ‖(krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n : H) - y‖ ^ 2 -
        relax n * (1 - relax n) *
          ‖(T (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n) : H) -
              (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n : H)‖ ^ 2 := by
  let xn := krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n
  have hyfix : T y = y := Function.mem_fixedPoints_iff.mp y.2
  have hnonexp :
      ‖(T xn : H) - y‖ ≤ ‖(xn : H) - y‖ := by
    simpa [Subtype.dist_eq, dist_eq_norm, hyfix, one_mul, xn] using hT.dist_le_mul xn y
  have hnonexp_sq : ‖(T xn : H) - y‖ ^ 2 ≤ ‖(xn : H) - y‖ ^ 2 := by
    nlinarith [hnonexp, norm_nonneg ((T xn : H) - y), norm_nonneg ((xn : H) - y)]
  have hidentity :=
    weighted_affine_norm_sq_identity ((T xn : H) - y) ((xn : H) - y) (relax n)
  have hrewrite :
      (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ (n + 1) : H) - y =
        relax n • ((T xn : H) - y) + (1 - relax n) • ((xn : H) - y) := by
    simpa [add_comm] using
      krasnoselskiiMannIteration_sub_eq_affineCombination hD_convex T relax hrelax x₀ (y : H) n
  have hresidual :
      ((T xn : H) - y) - ((xn : H) - y) = (T xn : H) - (xn : H) := by
    abel_nf
  have hstep :
      ‖(krasnoselskiiMannIteration hD_convex T relax hrelax x₀ (n + 1) : H) - y‖ ^ 2 +
          relax n * (1 - relax n) *
            ‖(T xn : H) - (xn : H)‖ ^ 2 ≤
        ‖(xn : H) - y‖ ^ 2 := by
    -- Compare the affine-combination identity with nonexpansiveness at the fixed point `y`.
    calc
      ‖(krasnoselskiiMannIteration hD_convex T relax hrelax x₀ (n + 1) : H) - y‖ ^ 2 +
          relax n * (1 - relax n) * ‖(T xn : H) - (xn : H)‖ ^ 2 =
        relax n * ‖(T xn : H) - y‖ ^ 2 + (1 - relax n) * ‖(xn : H) - y‖ ^ 2 := by
          rw [hrewrite]
          simpa [hresidual] using hidentity
      _ ≤ ‖(xn : H) - y‖ ^ 2 := by
          have hrelax_nonneg : 0 ≤ relax n := (hrelax n).1
          have hrelax_le_one : relax n ≤ 1 := (hrelax n).2
          nlinarith
  have hweight_nonneg :
      0 ≤ relax n * (1 - relax n) *
        ‖(T xn : H) - (xn : H)‖ ^ 2 := by
    have hrelax_nonneg : 0 ≤ relax n := (hrelax n).1
    have hone_sub_nonneg : 0 ≤ 1 - relax n := sub_nonneg.mpr (hrelax n).2
    positivity
  -- Discard the nonnegative residual term from the left-hand side.
  nlinarith

/-- Helper for Theorem 5.15: the partial residual energy plus the current squared distance to a
fixed point stays below the initial squared distance. -/
private theorem krasnoselskiiMann_sqdist_add_weighted_partial_sum_le_sqdist_of_fixedPoint
    (hD_convex : Convex ℝ D) (T : D → D) (hT : LipschitzWith 1 T)
    (relax : ℕ → ℝ) (hrelax : ∀ n, relax n ∈ Set.Icc (0 : ℝ) 1) (x₀ : D)
    (y : fixedPoints T) :
    ∀ N : ℕ,
      ‖(krasnoselskiiMannIteration hD_convex T relax hrelax x₀ N : H) - y‖ ^ 2 +
          ∑ n ∈ Finset.range N,
            relax n * (1 - relax n) *
              ‖(T (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n) : H) -
                  (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n : H)‖ ^ 2 ≤
        ‖(x₀ : H) - y‖ ^ 2 := by
  intro N
  induction N with
  | zero =>
      -- The empty partial sum leaves only the initial squared distance.
      simp
  | succ N ih =>
      have hstep :=
        krasnoselskiiMann_sqdist_step_le_sqdist_of_fixedPoint
          hD_convex T hT relax hrelax x₀ y N
      -- Telescope the one-step inequality with the induction hypothesis.
      rw [Finset.sum_range_succ]
      nlinarith [ih, hstep]

/-- Helper for Theorem 5.15: every weighted partial sum of squared residuals is bounded by the
initial squared distance to a fixed point. -/
theorem krasnoselskiiMann_residual_weighted_partial_sum_le_sqdist_of_fixedPoint
    (hD_convex : Convex ℝ D) (T : D → D) (hT : LipschitzWith 1 T)
    (relax : ℕ → ℝ) (hrelax : ∀ n, relax n ∈ Set.Icc (0 : ℝ) 1) (x₀ : D)
    (y : fixedPoints T) (N : ℕ) :
    ∑ n ∈ Finset.range N,
      relax n * (1 - relax n) *
        ‖(T (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n) : H) -
            (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n : H)‖ ^ 2 ≤
      ‖(x₀ : H) - y‖ ^ 2 := by
  have hbound :=
    krasnoselskiiMann_sqdist_add_weighted_partial_sum_le_sqdist_of_fixedPoint
      hD_convex T hT relax hrelax x₀ y N
  have hsq_nonneg :
      0 ≤ ‖(krasnoselskiiMannIteration hD_convex T relax hrelax x₀ N : H) - y‖ ^ 2 := by
    positivity
  -- Drop the nonnegative squared-distance term from the stronger telescoping bound.
  nlinarith

/-- Helper for Theorem 5.15: the norms of the Krasnosel'skii-Mann residuals form an antitone
sequence. -/
theorem krasnoselskiiMann_residual_norm_antitone
    (hD_convex : Convex ℝ D) (T : D → D) (hT : LipschitzWith 1 T)
    (relax : ℕ → ℝ) (hrelax : ∀ n, relax n ∈ Set.Icc (0 : ℝ) 1) (x₀ : D) (n : ℕ) :
    ‖(T (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ (n + 1)) : H) -
        (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ (n + 1) : H)‖ ≤
      ‖(T (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n) : H) -
          (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n : H)‖ := by
  let xn := krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n
  let xn1 := krasnoselskiiMannIteration hD_convex T relax hrelax x₀ (n + 1)
  have hdist :
      ‖(T xn1 : H) - T xn‖ ≤ ‖(xn1 : H) - xn‖ := by
    simpa [Subtype.dist_eq, dist_eq_norm, xn, xn1] using hT.dist_le_mul xn1 xn
  have hdiff :
      (xn1 : H) - (xn : H) = relax n • ((T xn : H) - (xn : H)) := by
    exact
      krasnoselskiiMannIteration_sub_eq_relax_residual hD_convex T relax hrelax x₀ n
  have hexpand :
      (T xn1 : H) - (xn1 : H) =
        ((T xn1 : H) - T xn) + (1 - relax n) • ((T xn : H) - (xn : H)) := by
    have htail :
        (T xn : H) - (xn1 : H) = (1 - relax n) • ((T xn : H) - (xn : H)) := by
      have hsucc :
          (xn1 : H) = (xn : H) + relax n • ((T xn : H) - (xn : H)) := by
        exact
          krasnoselskiiMannIteration_succ hD_convex T relax hrelax x₀ n
      rw [hsucc]
      rw [sub_smul, one_smul]
      abel_nf
    calc
      (T xn1 : H) - (xn1 : H) = ((T xn1 : H) - T xn) + ((T xn : H) - (xn1 : H)) := by
        abel_nf
      _ = ((T xn1 : H) - T xn) + (1 - relax n) • ((T xn : H) - (xn : H)) := by
        rw [htail]
  have hrelax_nonneg : 0 ≤ relax n := (hrelax n).1
  have hone_sub_nonneg : 0 ≤ 1 - relax n := sub_nonneg.mpr (hrelax n).2
  -- Expand the next residual, then bound the two summands by the current residual.
  calc
    ‖(T xn1 : H) - (xn1 : H)‖ =
        ‖((T xn1 : H) - T xn) + (1 - relax n) • ((T xn : H) - (xn : H))‖ := by
          rw [hexpand]
    _ ≤ ‖(T xn1 : H) - T xn‖ + ‖(1 - relax n) • ((T xn : H) - (xn : H))‖ :=
          norm_add_le _ _
    _ ≤ ‖(xn1 : H) - xn‖ + ‖(1 - relax n) • ((T xn : H) - (xn : H))‖ := by
          exact add_le_add hdist le_rfl
    _ = ‖relax n • ((T xn : H) - (xn : H))‖ +
          ‖(1 - relax n) • ((T xn : H) - (xn : H))‖ := by
          rw [hdiff]
    _ = relax n * ‖(T xn : H) - (xn : H)‖ +
          (1 - relax n) * ‖(T xn : H) - (xn : H)‖ := by
          rw [norm_smul, norm_smul, Real.norm_eq_abs, Real.norm_eq_abs,
            abs_of_nonneg hrelax_nonneg, abs_of_nonneg hone_sub_nonneg]
    _ = ‖(T xn : H) - (xn : H)‖ := by
          ring

-- Proof sketch: combine the Fejér estimate from part (1) with a fixed point `y` of `T` to get a
-- summable bound on `λ n * (1 - λ n) * ‖T xₙ - xₙ‖ ^ 2`. The divergence of the scalar weights
-- forces `liminf ‖T xₙ - xₙ‖ = 0`, and the standard monotonicity estimate for the residual norms
-- then upgrades this to convergence to `0`.
/-- Theorem 5.15 (2): if the fixed point set of `T` is nonempty and
`∑ λₙ (1 - λₙ) = +∞`, then the Krasnosel'skii-Mann residuals `T xₙ - xₙ` converge strongly to
`0`. -/
theorem krasnoselskiiMannIteration_residual_tendsto_zero
    (hD_convex : Convex ℝ D) (T : D → D) (hT : LipschitzWith 1 T)
    (hfix : (fixedPoints T).Nonempty)
    (relax : ℕ → ℝ) (hrelax : ∀ n, relax n ∈ Set.Icc (0 : ℝ) 1)
    (hdiv :
      Tendsto (fun N ↦ (∑ n ∈ Finset.range N, relax n * (1 - relax n))) atTop atTop)
    (x₀ : D) :
    Tendsto
      (fun n ↦
        (T (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n) : H) -
          (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n : H))
      atTop (𝓝 (0 : H)) := by
  rcases hfix with ⟨y, hy⟩
  let yFix : fixedPoints T := ⟨y, hy⟩
  let residual : ℕ → H := fun n ↦
    (T (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n) : H) -
      (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n : H)
  let residualNorm : ℕ → ℝ := fun n ↦ ‖residual n‖
  let weight : ℕ → ℝ := fun n ↦ relax n * (1 - relax n)
  have hanti : Antitone residualNorm := by
    refine antitone_nat_of_succ_le fun n ↦ ?_
    simpa [residualNorm, residual] using
      krasnoselskiiMann_residual_norm_antitone hD_convex T hT relax hrelax x₀ n
  have hboundedBelow : BddBelow (Set.range residualNorm) := by
    refine ⟨0, ?_⟩
    rintro _ ⟨n, rfl⟩
    exact norm_nonneg _
  have hlim :
      Tendsto residualNorm atTop (𝓝 (⨅ n, residualNorm n)) :=
    tendsto_atTop_ciInf hanti hboundedBelow
  have hweight_nonneg : ∀ n, 0 ≤ weight n := by
    intro n
    have hrelax_nonneg : 0 ≤ relax n := (hrelax n).1
    have hone_sub_nonneg : 0 ≤ 1 - relax n := sub_nonneg.mpr (hrelax n).2
    positivity
  have hbound :
      ∀ N : ℕ,
        ∑ n ∈ Finset.range N, weight n * residualNorm n ^ 2 ≤ ‖(x₀ : H) - yFix‖ ^ 2 := by
    intro N
    simpa [weight, residualNorm, residual] using
      krasnoselskiiMann_residual_weighted_partial_sum_le_sqdist_of_fixedPoint
        hD_convex T hT relax hrelax x₀ yFix N
  let l : ℝ := sInf (residualNorm '' Set.Ici 0)
  have hset_bddBelow : BddBelow (residualNorm '' Set.Ici 0) := by
    refine ⟨0, ?_⟩
    rintro _ ⟨n, hn, rfl⟩
    exact norm_nonneg (residual n)
  have hl_le : ∀ n : ℕ, l ≤ residualNorm n := by
    intro n
    exact csInf_le hset_bddBelow ⟨n, Nat.zero_le n, rfl⟩
  have hl_nonneg : 0 ≤ l := by
    have hset_nonempty : (residualNorm '' Set.Ici 0).Nonempty := by
      exact ⟨residualNorm 0, ⟨0, Nat.zero_le 0, rfl⟩⟩
    have hzero_lower : 0 ∈ lowerBounds (residualNorm '' Set.Ici 0) := by
      rintro _ ⟨n, hn, rfl⟩
      exact norm_nonneg (residual n)
    exact le_csInf hset_nonempty hzero_lower
  have hlim' :
      Tendsto residualNorm atTop (𝓝 l) := by
    simpa [l] using
      (Real.tendsto_atTop_csInf_of_antitoneOn_bddBelow_nat_Ici (k := 0)
        (fun m hm n hn hmn ↦ hanti hmn)
        hset_bddBelow)
  have hl_eq_zero : l = 0 := by
    by_contra hzero
    have hne : 0 ≠ l := by
      simpa [eq_comm] using hzero
    have hpos : 0 < l := lt_of_le_of_ne hl_nonneg hne
    have hscaled_bound :
        ∀ N : ℕ,
          l ^ 2 * (∑ n ∈ Finset.range N, weight n) ≤ ‖(x₀ : H) - yFix‖ ^ 2 := by
      intro N
      have hterm :
          ∀ n ∈ Finset.range N,
            l ^ 2 * weight n ≤ weight n * residualNorm n ^ 2 := by
        intro n hn
        have hsq_nonneg : 0 ≤ residualNorm n := norm_nonneg (residual n)
        have hweight_n_nonneg : 0 ≤ weight n := hweight_nonneg n
        have hsquare : l ^ 2 ≤ residualNorm n ^ 2 := by
          nlinarith [hl_nonneg, hsq_nonneg, hl_le n]
        simpa [mul_comm, mul_left_comm, mul_assoc] using
          mul_le_mul_of_nonneg_left hsquare hweight_n_nonneg
      calc
        l ^ 2 * (∑ n ∈ Finset.range N, weight n) =
            ∑ n ∈ Finset.range N, (l ^ 2 * weight n) := by
              rw [Finset.mul_sum]
        _ ≤ ∑ n ∈ Finset.range N, weight n * residualNorm n ^ 2 := by
              exact Finset.sum_le_sum fun n hn ↦ hterm n hn
        _ ≤ ‖(x₀ : H) - yFix‖ ^ 2 := hbound N
    have hscaled :
        Tendsto (fun N ↦ l ^ 2 * (∑ n ∈ Finset.range N, weight n)) atTop atTop :=
      hdiv.const_mul_atTop (by positivity)
    rcases (hscaled.eventually_ge_atTop (‖(x₀ : H) - yFix‖ ^ 2 + 1)).exists with ⟨N, hN⟩
    have hN' := hscaled_bound N
    linarith
  have hnorm :
      Tendsto (fun n ↦ ‖residual n‖) atTop (𝓝 (0 : ℝ)) := by
    simpa [residualNorm, l, hl_eq_zero] using hlim'
  -- Norm convergence of the residuals is equivalent to strong convergence to `0`.
  simpa [residual] using (tendsto_zero_iff_norm_tendsto_zero).mpr hnorm

end

section

variable {H : Type u} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
variable {D : Set H}

-- Proof sketch: part (1) gives Fejér monotonicity of the Krasnosel'skii-Mann orbit with respect
-- to the ambient fixed-point set, and part (2) shows that the residuals tend strongly to `0`.
-- Corollary 4.28 identifies every weak sequential cluster point as a fixed point, and Theorem 5.5
-- then yields weak convergence to a point of `fixedPoints T`.
omit [CompleteSpace H] in
/-- Helper for Theorem 5.15: every weak sequential cluster point of the Krasnosel'skii-Mann orbit
still belongs to the closed convex domain `D`. -/
private theorem weak_cluster_point_mem_domain_of_krasnoselskiiMann
    (hD_closed : IsClosed D) (hD_convex : Convex ℝ D) (T : D → D)
    (relax : ℕ → ℝ) (hrelax : ∀ n, relax n ∈ Set.Icc (0 : ℝ) 1) (x₀ : D)
    {z : H}
    (hz :
      IsSequentialClusterPt
        (fun n ↦ toWeakSpace ℝ H (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n : H))
        (toWeakSpace ℝ H z)) :
    z ∈ D := by
  rcases hz.exists_subseq_tendsto with ⟨φ, hφ, hφz⟩
  -- Closed convexity makes the weak image of `D` closed, so subsequential weak limits stay in `D`.
  have hD_weakClosed : IsClosed ((toWeakSpace ℝ H) '' D) :=
    (isClosed_iff_weak_image_isClosed_of_convex hD_convex).1 hD_closed
  have hzWeak : toWeakSpace ℝ H z ∈ closure ((toWeakSpace ℝ H) '' D) := by
    exact mem_closure_of_tendsto hφz <|
      Filter.Eventually.of_forall fun n ↦
        ⟨(krasnoselskiiMannIteration hD_convex T relax hrelax x₀ (φ n) : H),
          (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ (φ n)).2, rfl⟩
  rw [hD_weakClosed.closure_eq] at hzWeak
  rcases hzWeak with ⟨y, hyD, hyz⟩
  exact (toWeakSpace ℝ H).injective hyz ▸ hyD

/-- Helper for Theorem 5.15: every weak sequential cluster point of the Krasnosel'skii-Mann orbit
lies in the ambient image of the fixed-point set once the residuals converge to `0`. -/
private theorem weak_cluster_point_mem_ambient_fixedPoints_of_krasnoselskiiMann
    (hD_closed : IsClosed D) (hD_convex : Convex ℝ D) (T : D → D)
    (hT : LipschitzWith 1 T) (hfix : (fixedPoints T).Nonempty)
    (relax : ℕ → ℝ) (hrelax : ∀ n, relax n ∈ Set.Icc (0 : ℝ) 1)
    (hdiv :
      Tendsto (fun N ↦ (∑ n ∈ Finset.range N, relax n * (1 - relax n))) atTop atTop)
    (x₀ : D) {z : H}
    (hz :
      IsSequentialClusterPt
        (fun n ↦ toWeakSpace ℝ H (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n : H))
        (toWeakSpace ℝ H z)) :
    z ∈ Subtype.val '' fixedPoints T := by
  rcases hz.exists_subseq_tendsto with ⟨φ, hφ, hφz⟩
  have hzD : z ∈ D :=
    weak_cluster_point_mem_domain_of_krasnoselskiiMann
      hD_closed hD_convex T relax hrelax x₀ hz
  let zD : D := ⟨z, hzD⟩
  have hres :
      Tendsto
        (fun n ↦
          (T (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n) : H) -
            (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n : H))
        atTop (𝓝 (0 : H)) :=
    krasnoselskiiMannIteration_residual_tendsto_zero
      hD_convex T hT hfix relax hrelax hdiv x₀
  have hres_sub :
      Tendsto
        (fun n ↦
          (T (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ (φ n)) : H) -
            (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ (φ n) : H))
        atTop (𝓝 (0 : H)) := by
    -- Residual convergence survives along the convergent subsequence witnessing the cluster point.
    exact hres.comp hφ.tendsto_atTop
  have hz_fixed : T zD = (z : H) := by
    have hres_sub' :
        Tendsto
          (fun n ↦
            (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ (φ n) : H) -
              (T (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ (φ n)) : H))
          atTop (𝓝 (0 : H)) := by
      -- Corollary 4.28 is phrased for `xₙ - T xₙ`, so negate the residual subsequence.
      simpa [sub_eq_add_neg, add_assoc, add_left_comm, add_comm] using hres_sub.neg
    have hφz' :
        Tendsto
          (fun n ↦
            toWeakSpace ℝ H
              ((krasnoselskiiMannIteration hD_convex T relax hrelax x₀ (φ n) : D) : H))
          atTop (𝓝 (toWeakSpace ℝ H (zD : H))) := by
      -- Route correction: specialize Corollary 4.28 to the KM subsequence instead of seeking a
      -- new abstract demiclosedness bridge.
      simpa [zD] using hφz
    -- Demiclosedness upgrades the approximate fixed-point limit into an actual fixed point.
    simpa [zD] using
      map_eq_of_tendsto_weakly_of_residual_tendsto_zero_of_nonexpansive
        (xₙ := fun n ↦ krasnoselskiiMannIteration hD_convex T relax hrelax x₀ (φ n))
        (x := zD) hD_closed hD_convex hT hφz' hres_sub'
  refine ⟨zD, ?_, rfl⟩
  rw [Function.mem_fixedPoints_iff]
  exact Subtype.ext hz_fixed

/-- Theorem 5.15 (3): if `D` is closed and convex, `T` is nonexpansive with a fixed point, and
`∑ λₙ (1 - λₙ) = +∞`, then the Krasnosel'skii-Mann iteration converges weakly to a fixed point of
`T`. -/
theorem krasnoselskiiMannIteration_tendsto_weakly_to_fixedPoint
    (hD_closed : IsClosed D) (hD_convex : Convex ℝ D) (T : D → D) (hT : LipschitzWith 1 T)
    (hfix : (fixedPoints T).Nonempty)
    (relax : ℕ → ℝ) (hrelax : ∀ n, relax n ∈ Set.Icc (0 : ℝ) 1)
    (hdiv :
      Tendsto (fun N ↦ (∑ n ∈ Finset.range N, relax n * (1 - relax n))) atTop atTop)
    (x₀ : D) :
    ∃ z ∈ fixedPoints T,
      Tendsto
        (fun n ↦ toWeakSpace ℝ H (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n : H))
        atTop (𝓝 (toWeakSpace ℝ H (z : H))) := by
  have hfejer :
      FejerMonotone (Subtype.val '' fixedPoints T)
        (fun n ↦ (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n : H)) :=
    krasnoselskiiMannIteration_fejerMonotone hD_convex T hT relax hrelax x₀
  have hfix_image : (Subtype.val '' fixedPoints T).Nonempty := by
    rcases hfix with ⟨z, hz⟩
    exact ⟨z, ⟨z, hz, rfl⟩⟩
  -- Feed the Fejér-monotone orbit into Theorem 5.5 once cluster points are known to be fixed.
  rcases
      tendsto_weakly_of_fejerMonotone_of_weakSequentialClusterPts_mem
        hfix_image
        (fun n ↦ (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n : H))
        hfejer
        (fun z hz ↦
          weak_cluster_point_mem_ambient_fixedPoints_of_krasnoselskiiMann
            hD_closed hD_convex T hT hfix relax hrelax hdiv x₀ hz) with
    ⟨z, hz, hweak⟩
  rcases hz with ⟨zD, hzD, rfl⟩
  exact ⟨zD, hzD, hweak⟩

end
