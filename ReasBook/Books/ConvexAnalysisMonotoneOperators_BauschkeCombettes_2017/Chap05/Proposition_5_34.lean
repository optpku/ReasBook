open Filter
open scoped BigOperators Topology NNReal

universe u

section

variable {H : Type u} [AddCommGroup H] [Module ℝ H]

/-- The inexact Krasnosel'skii-Mann orbit generated by a self-map `T`, relaxation parameters
`λ`, error sequence `e`, and initial point `x0`. -/
def inexactKrasnoselskiiMannOrbit (T : H → H) (relax : ℕ → ℝ) (e : ℕ → H) (x0 : H) : ℕ → H
  | 0 => x0
  | n + 1 =>
      let xn := inexactKrasnoselskiiMannOrbit T relax e x0 n
      xn + relax n • (T xn + e n - xn)

-- Proof sketch: unfold the recursive definition at index `0`.
/-- The inexact Krasnosel'skii-Mann orbit starts at the prescribed initial point. -/
theorem inexactKrasnoselskiiMannOrbit_zero
    (T : H → H) (relax : ℕ → ℝ) (e : ℕ → H) (x0 : H) :
    inexactKrasnoselskiiMannOrbit T relax e x0 0 = x0 := by
  -- The recursion is defined to start at `x0`.
  rfl

-- Proof sketch: unfold the recursive definition at `n + 1`.
/-- The inexact Krasnosel'skii-Mann orbit satisfies the recursion
`xₙ₊₁ = xₙ + λₙ (T xₙ + eₙ - xₙ)`. -/
theorem inexactKrasnoselskiiMannOrbit_succ
    (T : H → H) (relax : ℕ → ℝ) (e : ℕ → H) (x0 : H) (n : ℕ) :
    inexactKrasnoselskiiMannOrbit T relax e x0 (n + 1) =
      inexactKrasnoselskiiMannOrbit T relax e x0 n +
        relax n •
          (T (inexactKrasnoselskiiMannOrbit T relax e x0 n) + e n -
            inexactKrasnoselskiiMannOrbit T relax e x0 n) := by
  -- The successor clause of the recursive definition is already the textbook formula.
  rfl

end

section

variable {H : Type u} [NormedAddCommGroup H] [InnerProductSpace ℝ H]

/-- Helper for Proposition 5.34: the squared norm of an affine combination plus the weighted
squared gap equals the corresponding affine combination of squared norms. -/
private theorem weighted_affine_norm_sq_identity (u v : H) (α : ℝ) :
    ‖α • u + (1 - α) • v‖ ^ 2 + α * (1 - α) * ‖u - v‖ ^ 2 =
      α * ‖u‖ ^ 2 + (1 - α) * ‖v‖ ^ 2 := by
  -- Expand both squared norms by the Hilbert-space identities and normalize the coefficients.
  rw [norm_add_sq_real, norm_sub_sq_real, norm_smul, norm_smul, Real.norm_eq_abs,
    Real.norm_eq_abs]
  simp [real_inner_smul_left, real_inner_smul_right]
  nlinarith [sq_abs α, sq_abs (1 - α)]

/-- Helper for Proposition 5.34: subtracting an ambient point from one exact Krasnosel'skii-Mann
step rewrites the result as the corresponding affine combination of translated vectors. -/
private theorem exact_krasnoselskiiMann_sub_eq_affineCombination
    {T : H → H} (relax : ℕ → ℝ) (x : ℕ → H) (y : H) (n : ℕ) :
    x n + relax n • (T (x n) - x n) - y =
      (1 - relax n) • (x n - y) + relax n • (T (x n) - y) := by
  have hrelax_rewrite :
      relax n • (T (x n) - x n) =
        -(relax n • (x n - y)) + relax n • (T (x n) - y) := by
    have hsub : (T (x n) - y) - (x n - y) = T (x n) - x n := by
      abel_nf
    calc
      relax n • (T (x n) - x n) =
          relax n • ((T (x n) - y) - (x n - y)) := by
            rw [hsub]
      _ = relax n • (T (x n) - y) - relax n • (x n - y) := by
            rw [smul_sub]
      _ = -(relax n • (x n - y)) + relax n • (T (x n) - y) := by
            abel_nf
  calc
    x n + relax n • (T (x n) - x n) - y =
        (x n - y) + relax n • (T (x n) - x n) := by
          abel_nf
    _ = (x n - y) + (-(relax n • (x n - y)) + relax n • (T (x n) - y)) := by
          rw [hrelax_rewrite]
    _ = (1 - relax n) • (x n - y) + relax n • (T (x n) - y) := by
          have hu :
              (x n - y) + -(relax n • (x n - y)) = (1 - relax n) • (x n - y) := by
            rw [sub_smul, one_smul]
            abel_nf
          calc
            (x n - y) + (-(relax n • (x n - y)) + relax n • (T (x n) - y)) =
                ((x n - y) + -(relax n • (x n - y))) + relax n • (T (x n) - y) := by
                  abel_nf
            _ = (1 - relax n) • (x n - y) + relax n • (T (x n) - y) := by
                  rw [hu]

/-- Helper for Proposition 5.34: the exact Krasnosel'skii-Mann step satisfies the textbook
energy inequality with respect to every fixed point of `T`. -/
private theorem exact_krasnoselskiiMann_sqdist_step_le_of_mem_fixedPoints
    {T : H → H} (hT : LipschitzWith 1 T) (relax : ℕ → ℝ)
    (hrelax : ∀ n, relax n ∈ Set.Icc (0 : ℝ) 1) (x : ℕ → H) {z : H}
    (hz : z ∈ Function.fixedPoints T) (n : ℕ) :
    ‖x n + relax n • (T (x n) - x n) - z‖ ^ 2 +
        relax n * (1 - relax n) * ‖T (x n) - x n‖ ^ 2 ≤
      ‖x n - z‖ ^ 2 := by
  have hzfix : T z = z := Function.mem_fixedPoints_iff.mp hz
  have hnonexp :
      ‖T (x n) - z‖ ≤ ‖x n - z‖ := by
    simpa [dist_eq_norm, hzfix, one_mul] using hT.dist_le_mul (x n) z
  have hnonexp_sq : ‖T (x n) - z‖ ^ 2 ≤ ‖x n - z‖ ^ 2 := by
    nlinarith [hnonexp, norm_nonneg (T (x n) - z), norm_nonneg (x n - z)]
  have hidentity :=
    weighted_affine_norm_sq_identity (T (x n) - z) (x n - z) (relax n)
  have hresidual :
      (T (x n) - z) - (x n - z) = T (x n) - x n := by
    abel_nf
  have hrewrite :
      x n + relax n • (T (x n) - x n) - z =
        relax n • (T (x n) - z) + (1 - relax n) • (x n - z) := by
    simpa [add_comm] using exact_krasnoselskiiMann_sub_eq_affineCombination relax x z n
  -- Compare the affine-combination identity with nonexpansiveness at the fixed point `z`.
  calc
    ‖x n + relax n • (T (x n) - x n) - z‖ ^ 2 +
        relax n * (1 - relax n) * ‖T (x n) - x n‖ ^ 2 =
      relax n * ‖T (x n) - z‖ ^ 2 + (1 - relax n) * ‖x n - z‖ ^ 2 := by
        rw [hrewrite]
        simpa [hresidual] using hidentity
    _ ≤ ‖x n - z‖ ^ 2 := by
        have hrelax_nonneg : 0 ≤ relax n := (hrelax n).1
        have hrelax_le_one : relax n ≤ 1 := (hrelax n).2
        nlinarith

/-- Helper for Proposition 5.34: dropping the nonnegative residual term shows that the exact
Krasnosel'skii-Mann step does not increase the distance to a fixed point. -/
private theorem exact_krasnoselskiiMann_norm_step_le_of_mem_fixedPoints
    {T : H → H} (hT : LipschitzWith 1 T) (relax : ℕ → ℝ)
    (hrelax : ∀ n, relax n ∈ Set.Icc (0 : ℝ) 1) (x : ℕ → H) {z : H}
    (hz : z ∈ Function.fixedPoints T) (n : ℕ) :
    ‖x n + relax n • (T (x n) - x n) - z‖ ≤ ‖x n - z‖ := by
  have hstep :=
    exact_krasnoselskiiMann_sqdist_step_le_of_mem_fixedPoints hT relax hrelax x hz n
  have hweight_nonneg :
      0 ≤ relax n * (1 - relax n) * ‖T (x n) - x n‖ ^ 2 := by
    have hrelax_nonneg : 0 ≤ relax n := (hrelax n).1
    have hone_sub_nonneg : 0 ≤ 1 - relax n := sub_nonneg.mpr (hrelax n).2
    positivity
  have hsq :
      ‖x n + relax n • (T (x n) - x n) - z‖ ^ 2 ≤ ‖x n - z‖ ^ 2 := by
    nlinarith
  exact (sq_le_sq₀ (norm_nonneg _) (norm_nonneg _)).1 hsq

/-- Helper for Proposition 5.34: one inexact Krasnosel'skii-Mann step increases the distance to a
fixed point by at most the scalar perturbation `λₙ ‖eₙ‖`. -/
private theorem inexact_krasnoselskiiMann_dist_step_le_of_mem_fixedPoints
    {T : H → H} (hT : LipschitzWith 1 T) (relax : ℕ → ℝ)
    (hrelax : ∀ n, relax n ∈ Set.Icc (0 : ℝ) 1) (e : ℕ → H) (x0 : H) {z : H}
    (hz : z ∈ Function.fixedPoints T) (n : ℕ) :
    ‖inexactKrasnoselskiiMannOrbit T relax e x0 (n + 1) - z‖ ≤
      ‖inexactKrasnoselskiiMannOrbit T relax e x0 n - z‖ + relax n * ‖e n‖ := by
  let x := inexactKrasnoselskiiMannOrbit T relax e x0
  have hsucc :
      x (n + 1) - z =
        (x n + relax n • (T (x n) - x n) - z) + relax n • e n := by
    simpa [x, sub_eq_add_neg, add_assoc, add_left_comm, add_comm] using
      congrArg (fun y ↦ y - z) (inexactKrasnoselskiiMannOrbit_succ T relax e x0 n)
  have hexact :
      ‖x n + relax n • (T (x n) - x n) - z‖ ≤ ‖x n - z‖ :=
    exact_krasnoselskiiMann_norm_step_le_of_mem_fixedPoints hT relax hrelax x hz n
  have hsmul :
      ‖relax n • e n‖ = relax n * ‖e n‖ := by
    rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg (hrelax n).1]
  -- Split the inexact step into the exact step plus the additive error.
  calc
    ‖inexactKrasnoselskiiMannOrbit T relax e x0 (n + 1) - z‖ =
        ‖(x n + relax n • (T (x n) - x n) - z) + relax n • e n‖ := by
          rw [hsucc]
    _ ≤ ‖x n + relax n • (T (x n) - x n) - z‖ + ‖relax n • e n‖ := norm_add_le _ _
    _ ≤ ‖x n - z‖ + relax n * ‖e n‖ := by
          rw [hsmul]
          exact add_le_add hexact le_rfl

/-- Helper for Proposition 5.34: the distance to a fixed point is bounded by the initial distance
plus the corresponding finite error sum. -/
private theorem inexact_krasnoselskiiMann_dist_le_initial_add_partialError_of_mem_fixedPoints
    {T : H → H} (hT : LipschitzWith 1 T) (relax : ℕ → ℝ)
    (hrelax : ∀ n, relax n ∈ Set.Icc (0 : ℝ) 1) (e : ℕ → H) (x0 : H) {z : H}
    (hz : z ∈ Function.fixedPoints T) :
    ∀ N : ℕ,
      ‖inexactKrasnoselskiiMannOrbit T relax e x0 N - z‖ ≤
        ‖x0 - z‖ + ∑ n ∈ Finset.range N, relax n * ‖e n‖ := by
  intro N
  induction N with
  | zero =>
      -- At time `0`, the orbit starts at `x0`, so there is no accumulated error term.
      simp [inexactKrasnoselskiiMannOrbit_zero]
  | succ N ih =>
      have hstep :=
        inexact_krasnoselskiiMann_dist_step_le_of_mem_fixedPoints
          hT relax hrelax e x0 hz N
      -- Append one more perturbation term to the finite bound from the induction hypothesis.
      calc
        ‖inexactKrasnoselskiiMannOrbit T relax e x0 (N + 1) - z‖ ≤
            ‖inexactKrasnoselskiiMannOrbit T relax e x0 N - z‖ + relax N * ‖e N‖ := hstep
        _ ≤ (‖x0 - z‖ + ∑ n ∈ Finset.range N, relax n * ‖e n‖) + relax N * ‖e N‖ := by
              exact add_le_add ih le_rfl
        _ = ‖x0 - z‖ + ∑ n ∈ Finset.range (N + 1), relax n * ‖e n‖ := by
              rw [Finset.sum_range_succ]
              ring

/-- Helper for Proposition 5.34: the error scalar `λₙ ‖eₙ‖` is bounded by the total error sum. -/
private theorem error_term_le_tsum
    (relax : ℕ → ℝ) (hrelax : ∀ n, relax n ∈ Set.Icc (0 : ℝ) 1) (e : ℕ → H)
    (hsummable : Summable (fun n ↦ relax n * ‖e n‖)) (n : ℕ) :
    relax n * ‖e n‖ ≤ ∑' k, relax k * ‖e k‖ := by
  have hnonneg : ∀ k, 0 ≤ relax k * ‖e k‖ := by
    intro k
    have hrelax_nonneg : 0 ≤ relax k := (hrelax k).1
    positivity
  have hsingle :
      relax n * ‖e n‖ ≤ ∑ k ∈ Finset.range (n + 1), relax k * ‖e k‖ := by
    simpa using
      (Finset.single_le_sum
        (fun k hk ↦ hnonneg k)
        (Finset.mem_range.mpr (Nat.lt_succ_self n)))
  exact le_trans hsingle (hsummable.sum_le_tsum _ fun _ _ ↦ hnonneg _)

/-- Helper for Proposition 5.34: the perturbed orbit satisfies the textbook one-step squared
distance inequality with a summable error term. -/
private theorem sqdist_step_le_sqdist_sub_weighted_residual_add_error_of_mem_fixedPoints
    {T : H → H} (hT : LipschitzWith 1 T) (relax : ℕ → ℝ)
    (hrelax : ∀ n, relax n ∈ Set.Icc (0 : ℝ) 1) (e : ℕ → H)
    (hsummable : Summable (fun n ↦ relax n * ‖e n‖)) (x0 : H) {z : H}
    (hz : z ∈ Function.fixedPoints T) (n : ℕ) :
    let x := inexactKrasnoselskiiMannOrbit T relax e x0
    let weight := relax n * (1 - relax n)
    let residual := T (x n) - x n
    let B := ‖x0 - z‖ + ∑' k, relax k * ‖e k‖
    ‖x (n + 1) - z‖ ^ 2 + weight * ‖residual‖ ^ 2 ≤
      ‖x n - z‖ ^ 2 + (3 * B) * (relax n * ‖e n‖) := by
  let x := inexactKrasnoselskiiMannOrbit T relax e x0
  let weight : ℝ := relax n * (1 - relax n)
  let residual : H := T (x n) - x n
  let B : ℝ := ‖x0 - z‖ + ∑' k, relax k * ‖e k‖
  have hB_nonneg : 0 ≤ B := by
    have htsum_nonneg : 0 ≤ ∑' k, relax k * ‖e k‖ := by
      exact tsum_nonneg fun k ↦ by
        have hk : 0 ≤ relax k := (hrelax k).1
        positivity
    dsimp [B]
    nlinarith [norm_nonneg (x0 - z), htsum_nonneg]
  have hx_le_B :
      ‖x n - z‖ ≤ B := by
    have hpartial :=
      inexact_krasnoselskiiMann_dist_le_initial_add_partialError_of_mem_fixedPoints
        hT relax hrelax e x0 hz n
    have hsum_le :
        ∑ k ∈ Finset.range n, relax k * ‖e k‖ ≤ ∑' k, relax k * ‖e k‖ := by
      exact hsummable.sum_le_tsum _ fun k _ ↦ by
        have hk : 0 ≤ relax k := (hrelax k).1
        positivity
    calc
      ‖x n - z‖ ≤ ‖x0 - z‖ + ∑ k ∈ Finset.range n, relax k * ‖e k‖ := hpartial
      _ ≤ B := by
            dsimp [B]
            linarith [hsum_le]
  have ha_nonneg : 0 ≤ relax n * ‖e n‖ := by
    have hrelax_nonneg : 0 ≤ relax n := (hrelax n).1
    positivity
  have ha_le_B : relax n * ‖e n‖ ≤ B := by
    calc
      relax n * ‖e n‖ ≤ ∑' k, relax k * ‖e k‖ :=
        error_term_le_tsum relax hrelax e hsummable n
      _ ≤ B := by
            dsimp [B]
            nlinarith [norm_nonneg (x0 - z)]
  have hexact_sq :
      ‖x n + relax n • residual - z‖ ^ 2 + weight * ‖residual‖ ^ 2 ≤ ‖x n - z‖ ^ 2 := by
    simpa [x, weight, residual] using
      exact_krasnoselskiiMann_sqdist_step_le_of_mem_fixedPoints hT relax hrelax x hz n
  have hexact_norm :
      ‖x n + relax n • residual - z‖ ≤ B := by
    have hstep :
        ‖x n + relax n • residual - z‖ ≤ ‖x n - z‖ := by
      simpa [x, residual] using
        exact_krasnoselskiiMann_norm_step_le_of_mem_fixedPoints hT relax hrelax x hz n
    exact le_trans hstep hx_le_B
  have hsucc :
      x (n + 1) - z = (x n + relax n • residual - z) + relax n • e n := by
    simpa [x, residual, sub_eq_add_neg, add_assoc, add_left_comm, add_comm] using
      congrArg (fun y ↦ y - z) (inexactKrasnoselskiiMannOrbit_succ T relax e x0 n)
  have hsmul :
      ‖relax n • e n‖ = relax n * ‖e n‖ := by
    rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg (hrelax n).1]
  have hsq_bound :
      (relax n * ‖e n‖) ^ 2 ≤ B * (relax n * ‖e n‖) := by
    nlinarith
  have hcross_bound :
      2 * ‖x n + relax n • residual - z‖ * (relax n * ‖e n‖) ≤
        2 * B * (relax n * ‖e n‖) := by
    gcongr
  -- Expand the inexact step as the exact step plus the perturbation and bound the new terms by
  -- the uniform distance bound `B`.
  calc
    ‖x (n + 1) - z‖ ^ 2 + weight * ‖residual‖ ^ 2 =
        ‖(x n + relax n • residual - z) + relax n • e n‖ ^ 2 + weight * ‖residual‖ ^ 2 := by
          rw [hsucc]
    _ ≤ (‖x n + relax n • residual - z‖ + ‖relax n • e n‖) ^ 2 + weight * ‖residual‖ ^ 2 := by
          gcongr
          exact norm_add_le _ _
    _ = ‖x n + relax n • residual - z‖ ^ 2 +
          2 * ‖x n + relax n • residual - z‖ * (relax n * ‖e n‖) +
          (relax n * ‖e n‖) ^ 2 + weight * ‖residual‖ ^ 2 := by
          rw [hsmul]
          ring
    _ ≤ ‖x n + relax n • residual - z‖ ^ 2 +
          2 * B * (relax n * ‖e n‖) +
          B * (relax n * ‖e n‖) + weight * ‖residual‖ ^ 2 := by
          nlinarith
    _ = (‖x n + relax n • residual - z‖ ^ 2 + weight * ‖residual‖ ^ 2) +
          (3 * B) * (relax n * ‖e n‖) := by
          ring
    _ ≤ ‖x n - z‖ ^ 2 + (3 * B) * (relax n * ‖e n‖) := by
          simpa [add_assoc, add_left_comm, add_comm] using
            add_le_add_right hexact_sq ((3 * B) * (relax n * ‖e n‖))

/-- Helper for Proposition 5.34: the residuals satisfy the perturbed one-step estimate
`‖rₙ₊₁‖ ≤ ‖rₙ‖ + 2 λₙ ‖eₙ‖`. -/
private theorem inexactKrasnoselskiiMann_residual_norm_step_le
    {T : H → H} (hT : LipschitzWith 1 T) (relax : ℕ → ℝ)
    (hrelax : ∀ n, relax n ∈ Set.Icc (0 : ℝ) 1) (e : ℕ → H) (x0 : H) (n : ℕ) :
    let x := inexactKrasnoselskiiMannOrbit T relax e x0
    let residual : ℕ → H := fun m ↦ T (x m) - x m
    ‖residual (n + 1)‖ ≤ ‖residual n‖ + 2 * (relax n * ‖e n‖) := by
  let x := inexactKrasnoselskiiMannOrbit T relax e x0
  let residual : ℕ → H := fun m ↦ T (x m) - x m
  have hdist :
      ‖T (x (n + 1)) - T (x n)‖ ≤ ‖x (n + 1) - x n‖ := by
    simpa [dist_eq_norm, one_mul] using hT.dist_le_mul (x (n + 1)) (x n)
  have hstep_eq :
      x (n + 1) = x n + relax n • (residual n + e n) := by
    simpa [x, residual, sub_eq_add_neg, add_assoc, add_left_comm, add_comm] using
      inexactKrasnoselskiiMannOrbit_succ T relax e x0 n
  have hdiff :
      x (n + 1) - x n = relax n • (residual n + e n) := by
    rw [hstep_eq]
    abel_nf
  have htail :
      T (x n) - x (n + 1) = (1 - relax n) • residual n - relax n • e n := by
    rw [hstep_eq]
    rw [sub_smul, one_smul, smul_add]
    dsimp [residual]
    abel_nf
  have hexpand :
      residual (n + 1) =
        (T (x (n + 1)) - T (x n)) + (1 - relax n) • residual n - relax n • e n := by
    dsimp [residual]
    calc
      T (x (n + 1)) - x (n + 1) =
          (T (x (n + 1)) - T (x n)) + (T (x n) - x (n + 1)) := by
            abel_nf
      _ = (T (x (n + 1)) - T (x n)) + (1 - relax n) • residual n - relax n • e n := by
            simpa [sub_eq_add_neg, add_assoc] using
              congrArg (fun v ↦ (T (x (n + 1)) - T (x n)) + v) htail
  have hrelax_nonneg : 0 ≤ relax n := (hrelax n).1
  have hone_sub_nonneg : 0 ≤ 1 - relax n := sub_nonneg.mpr (hrelax n).2
  -- Rewrite the next residual, then estimate the new perturbation and exact residual pieces.
  calc
    ‖residual (n + 1)‖ =
        ‖(T (x (n + 1)) - T (x n)) + (1 - relax n) • residual n - relax n • e n‖ := by
          rw [hexpand]
    _ ≤ ‖T (x (n + 1)) - T (x n)‖ + ‖(1 - relax n) • residual n - relax n • e n‖ := by
          simpa [sub_eq_add_neg, add_assoc] using
            (norm_add_le (T (x (n + 1)) - T (x n))
              ((1 - relax n) • residual n - relax n • e n))
    _ ≤ ‖x (n + 1) - x n‖ + ‖(1 - relax n) • residual n - relax n • e n‖ := by
          exact add_le_add hdist le_rfl
    _ = ‖relax n • (residual n + e n)‖ + ‖(1 - relax n) • residual n - relax n • e n‖ := by
          rw [hdiff]
    _ ≤ relax n * ‖residual n + e n‖ +
          ((1 - relax n) * ‖residual n‖ + relax n * ‖e n‖) := by
          rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg hrelax_nonneg]
          have htriangle :
              ‖(1 - relax n) • residual n - relax n • e n‖ ≤
                ‖(1 - relax n) • residual n‖ + ‖relax n • e n‖ := by
            simpa [sub_eq_add_neg] using norm_add_le ((1 - relax n) • residual n) (-(relax n • e n))
          have hnorm_sub :
              ‖(1 - relax n) • residual n - relax n • e n‖ ≤
                (1 - relax n) * ‖residual n‖ + relax n * ‖e n‖ := by
            calc
              ‖(1 - relax n) • residual n - relax n • e n‖ ≤
                  ‖(1 - relax n) • residual n‖ + ‖relax n • e n‖ := htriangle
              _ = (1 - relax n) * ‖residual n‖ + relax n * ‖e n‖ := by
                    rw [norm_smul, norm_smul, Real.norm_eq_abs, Real.norm_eq_abs,
                      abs_of_nonneg hone_sub_nonneg, abs_of_nonneg hrelax_nonneg]
          exact add_le_add le_rfl hnorm_sub
    _ ≤ relax n * (‖residual n‖ + ‖e n‖) +
          ((1 - relax n) * ‖residual n‖ + relax n * ‖e n‖) := by
          gcongr
          exact norm_add_le _ _
    _ = ‖residual n‖ + 2 * (relax n * ‖e n‖) := by
          ring

-- Proof sketch: for each fixed point `z` of `T`, compare the exact Krasnosel'skii-Mann step with
-- the error-perturbed step, use the standard Hilbert-space squared-norm identity for convex
-- combinations, and absorb the perturbation term into a summable error sequence controlled by
-- `∑ λₙ ‖eₙ‖`.
/-- Proposition 5.34 (1): (i) if `T` is nonexpansive, `λₙ ∈ [0,1]`, and `∑ λₙ ‖eₙ‖ < +∞`, then
the inexact Krasnosel'skii-Mann orbit is quasi-Fejér monotone with respect to `Function.fixedPoints T`. -/
theorem inexactKrasnoselskiiMannOrbit_quasiFejerMonotone
    {T : H → H} (hT : LipschitzWith 1 T) (relax : ℕ → ℝ)
    (hrelax : ∀ n, relax n ∈ Set.Icc (0 : ℝ) 1) (e : ℕ → H)
    (hsummable : Summable (fun n ↦ relax n * ‖e n‖)) (x0 : H) :
    QuasiFejerMonotone (Function.fixedPoints T)
      (inexactKrasnoselskiiMannOrbit T relax e x0) := by
  intro z hz
  let a : ℕ → ℝ := fun n ↦ relax n * ‖e n‖
  let aNN : ℕ → ℝ≥0 := fun n ↦ ⟨a n, by
    have hrelax_nonneg : 0 ≤ relax n := (hrelax n).1
    positivity⟩
  let B : ℝ := ‖x0 - z‖ + ∑' n, a n
  let Cnn : ℝ≥0 := ⟨3 * B, by
    have hnonneg : 0 ≤ B := by
      have htsum_nonneg : 0 ≤ ∑' n, a n := by
        exact tsum_nonneg fun n ↦ by
          have hrelax_nonneg : 0 ≤ relax n := (hrelax n).1
          positivity
      dsimp [B, a]
      nlinarith [norm_nonneg (x0 - z), htsum_nonneg]
    positivity⟩
  let ε : ℕ → ℝ≥0 := fun n ↦ Cnn * aNN n
  have haNN : Summable aNN := by
    have hreal : Summable (fun n ↦ (aNN n : ℝ)) := by
      simpa [aNN, a] using hsummable
    exact (NNReal.summable_coe).1 hreal
  refine ⟨ε, by simpa [ε] using haNN.mul_left Cnn, ?_⟩
  intro n
  -- The perturbed squared-distance inequality gives exactly the required quasi-Fejér step.
  have hstep :=
    sqdist_step_le_sqdist_sub_weighted_residual_add_error_of_mem_fixedPoints
      hT relax hrelax e hsummable x0 hz n
  have hweight_nonneg :
      0 ≤
        relax n * (1 - relax n) *
          ‖T (inexactKrasnoselskiiMannOrbit T relax e x0 n) -
              inexactKrasnoselskiiMannOrbit T relax e x0 n‖ ^ 2 := by
    have hrelax_nonneg : 0 ≤ relax n := (hrelax n).1
    have hone_sub_nonneg : 0 ≤ 1 - relax n := sub_nonneg.mpr (hrelax n).2
    positivity
  have hstep' :
      ‖inexactKrasnoselskiiMannOrbit T relax e x0 (n + 1) - z‖ ^ 2 ≤
        ‖inexactKrasnoselskiiMannOrbit T relax e x0 n - z‖ ^ 2 +
          (3 * B) * (relax n * ‖e n‖) := by
    nlinarith
  simpa [ε, Cnn, aNN, a, B] using hstep'

-- Proof sketch: use the quasi-Fejér inequality from part (i) to obtain summability of
-- `λₙ (1 - λₙ) ‖T xₙ - xₙ‖²` via the perturbed-descent lemma, then combine the divergence of
-- `∑ λₙ (1 - λₙ)` with the standard asymptotic-regularity argument for nonexpansive
-- Krasnosel'skii-Mann iterations.
/-- Proposition 5.34 (2): (ii) if `Function.fixedPoints T` is nonempty and
`∑ λₙ (1 - λₙ) = +∞`, then the residuals `T xₙ - xₙ` of the inexact Krasnosel'skii-Mann orbit
converge strongly to `0`. -/
theorem inexactKrasnoselskiiMannOrbit_residual_tendsto_zero
    {T : H → H} (hT : LipschitzWith 1 T) (hfix : (Function.fixedPoints T).Nonempty)
    (relax : ℕ → ℝ) (hrelax : ∀ n, relax n ∈ Set.Icc (0 : ℝ) 1)
    (hdiv :
      Tendsto (fun N ↦ (∑ n ∈ Finset.range N, relax n * (1 - relax n))) atTop atTop)
    (e : ℕ → H) (hsummable : Summable (fun n ↦ relax n * ‖e n‖)) (x0 : H) :
    Tendsto
      (fun n ↦
        T (inexactKrasnoselskiiMannOrbit T relax e x0 n) -
          inexactKrasnoselskiiMannOrbit T relax e x0 n)
      atTop (𝓝 (0 : H)) := by
  rcases hfix with ⟨z, hz⟩
  let x : ℕ → H := inexactKrasnoselskiiMannOrbit T relax e x0
  let residual : ℕ → H := fun n ↦ T (x n) - x n
  let residualNorm : ℕ → ℝ := fun n ↦ ‖residual n‖
  let weight : ℕ → ℝ := fun n ↦ relax n * (1 - relax n)
  let a : ℕ → ℝ := fun n ↦ relax n * ‖e n‖
  let aNN : ℕ → ℝ≥0 := fun n ↦ ⟨a n, by
    have hrelax_nonneg : 0 ≤ relax n := (hrelax n).1
    positivity⟩
  let B : ℝ := ‖x0 - z‖ + ∑' n, a n
  let Cnn : ℝ≥0 := ⟨3 * B, by
    have hnonneg : 0 ≤ B := by
      have htsum_nonneg : 0 ≤ ∑' n, a n := by
        exact tsum_nonneg fun n ↦ by
          have hrelax_nonneg : 0 ≤ relax n := (hrelax n).1
          positivity
      dsimp [B, a]
      nlinarith [norm_nonneg (x0 - z), htsum_nonneg]
    positivity⟩
  let α : ℕ → ℝ≥0 := fun n ↦ ⟨‖x n - z‖ ^ 2, sq_nonneg _⟩
  let β : ℕ → ℝ≥0 := fun n ↦ ⟨weight n * residualNorm n ^ 2, by
    have hrelax_nonneg : 0 ≤ relax n := (hrelax n).1
    have hone_sub_nonneg : 0 ≤ 1 - relax n := sub_nonneg.mpr (hrelax n).2
    positivity⟩
  let ε : ℕ → ℝ≥0 := fun n ↦ Cnn * aNN n
  have haNN : Summable aNN := by
    have hreal : Summable (fun n ↦ (aNN n : ℝ)) := by
      simpa [aNN, a] using hsummable
    exact (NNReal.summable_coe).1 hreal
  have hsqrec : ∀ n : ℕ, α (n + 1) + β n ≤ (1 + 0) * α n + ε n := by
    intro n
    -- The perturbed squared-distance estimate matches Lemma 5.31 with `γ = 0`.
    have hstep :=
      sqdist_step_le_sqdist_sub_weighted_residual_add_error_of_mem_fixedPoints
        hT relax hrelax e hsummable x0 hz n
    simpa [α, β, ε, Cnn, aNN, a, weight, residualNorm, residual, x, B] using hstep
  rcases
      tendsto_and_summable_of_summable_perturbed_descent
        (α := α) (β := β) (γ := fun _ ↦ 0) (ε := ε)
        summable_zero (by simpa [ε] using haNN.mul_left Cnn) hsqrec with
    ⟨_, hβsumm⟩
  have hweighted : Summable (fun n ↦ weight n * residualNorm n ^ 2) := by
    have hβreal : Summable (fun n ↦ (β n : ℝ)) := (NNReal.summable_coe).2 hβsumm
    simpa [β, weight, residualNorm] using hβreal
  let αres : ℕ → ℝ≥0 := fun n ↦ ⟨residualNorm n, norm_nonneg _⟩
  let εres : ℕ → ℝ≥0 := fun n ↦ (2 : ℝ≥0) * aNN n
  have hresrec : ∀ n : ℕ, αres (n + 1) + 0 ≤ (1 + 0) * αres n + εres n := by
    intro n
    -- The residual one-step estimate supplies the second perturbed-descent recursion.
    have hstep :=
      inexactKrasnoselskiiMann_residual_norm_step_le hT relax hrelax e x0 n
    simpa [αres, εres, aNN, a, residualNorm, residual, x] using hstep
  rcases
      tendsto_and_summable_of_summable_perturbed_descent
        (α := αres) (β := fun _ ↦ 0) (γ := fun _ ↦ 0) (ε := εres)
        summable_zero (by simpa [εres] using haNN.mul_left (2 : ℝ≥0)) hresrec with
    ⟨⟨lNN, hαres⟩, _⟩
  have hresNorm_tendsto :
      Tendsto residualNorm atTop (𝓝 (lNN : ℝ)) := by
    have hcoer :
        Tendsto (fun n ↦ ((αres n : ℝ≥0) : ℝ)) atTop (𝓝 (lNN : ℝ)) :=
      (NNReal.tendsto_coe').2 ⟨lNN.2, hαres⟩
    change Tendsto (fun n ↦ ((αres n : ℝ≥0) : ℝ)) atTop (𝓝 (lNN : ℝ))
    exact hcoer
  have hlNN_eq_zero : lNN = 0 := by
    by_contra hne
    have hposNN : 0 < lNN := pos_iff_ne_zero.mpr hne
    have hpos : 0 < (lNN : ℝ) := by exact_mod_cast hposNN
    have hevent :
        ∀ᶠ n in atTop, (lNN : ℝ) / 2 < residualNorm n := by
      exact hresNorm_tendsto (Ioi_mem_nhds (by linarith))
    rcases Filter.eventually_atTop.1 hevent with ⟨N, hN⟩
    let c : ℝ := ((lNN : ℝ) / 2) ^ 2
    have hc_pos : 0 < c := by
      dsimp [c]
      positivity
    have htail_bound :
        ∀ n : ℕ, c * weight (n + N) ≤ weight (n + N) * residualNorm (n + N) ^ 2 := by
      intro n
      have hweight_nonneg : 0 ≤ weight (n + N) := by
        dsimp [weight]
        have hrelax_nonneg : 0 ≤ relax (n + N) := (hrelax (n + N)).1
        have hone_sub_nonneg : 0 ≤ 1 - relax (n + N) := sub_nonneg.mpr (hrelax (n + N)).2
        positivity
      have hlower : (lNN : ℝ) / 2 < residualNorm (n + N) := by
        exact hN (n + N) (Nat.le_add_left N n)
      have hsq : c ≤ residualNorm (n + N) ^ 2 := by
        dsimp [c]
        nlinarith
      simpa [mul_comm, mul_left_comm, mul_assoc] using
        mul_le_mul_of_nonneg_left hsq hweight_nonneg
    have hweighted_tail :
        Summable (fun n ↦ weight (n + N) * residualNorm (n + N) ^ 2) :=
      (summable_nat_add_iff N).2 hweighted
    have hscaled_tail : Summable (fun n ↦ c * weight (n + N)) := by
      refine Summable.of_nonneg_of_le
        (fun n ↦ mul_nonneg hc_pos.le <| by
          dsimp [weight]
          have hrelax_nonneg : 0 ≤ relax (n + N) := (hrelax (n + N)).1
          have hone_sub_nonneg : 0 ≤ 1 - relax (n + N) := sub_nonneg.mpr (hrelax (n + N)).2
          positivity)
        htail_bound hweighted_tail
    have hweight_tail : Summable (fun n ↦ weight (n + N)) := by
      have hc_ne : c ≠ 0 := by
        exact ne_of_gt hc_pos
      have hscaled_back := hscaled_tail.mul_left c⁻¹
      simpa [c, hc_ne, mul_assoc] using hscaled_back
    have hweight_summable : Summable weight := (summable_nat_add_iff N).1 hweight_tail
    have hweight_tendsto :
        Tendsto (fun M ↦ ∑ n ∈ Finset.range M, weight n) atTop (𝓝 (∑' n, weight n)) :=
      hweight_summable.hasSum.tendsto_sum_nat
    have hweight_diverges_past_tsum :
        ∀ᶠ b in atTop, (∑ n ∈ Finset.range b, weight n) > (∑' n, weight n) + 1 := by
      have hIoi_atTop : Set.Ioi ((∑' n, weight n) + 1 : ℝ) ∈ (atTop : Filter ℝ) := by
        rw [Filter.mem_atTop_sets]
        refine ⟨(∑' n, weight n) + 2, ?_⟩
        intro x hx
        show (∑' n, weight n) + 1 < x
        linarith
      exact hdiv hIoi_atTop
    rcases
        Filter.eventually_atTop.1 hweight_diverges_past_tsum with
      ⟨N₁, hN₁⟩
    rcases
        Filter.eventually_atTop.1
          (hweight_tendsto (Iio_mem_nhds (lt_add_of_pos_right (∑' n, weight n) zero_lt_one))) with
      ⟨N₂, hN₂⟩
    have hbig : (∑ n ∈ Finset.range (max N₁ N₂), weight n) > (∑' n, weight n) + 1 :=
      by simpa [weight] using hN₁ _ (le_max_left _ _)
    have hsmall : (∑ n ∈ Finset.range (max N₁ N₂), weight n) < (∑' n, weight n) + 1 :=
      by simpa [weight] using hN₂ _ (le_max_right _ _)
    linarith
  have hnorm :
      Tendsto residualNorm atTop (𝓝 (0 : ℝ)) := by
    simpa [hlNN_eq_zero] using hresNorm_tendsto
  -- Norm convergence of the residuals is equivalent to strong convergence to `0`.
  simpa [residual, residualNorm, x] using
    (tendsto_zero_iff_norm_tendsto_zero).mpr hnorm

end

section

variable {H : Type u} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]

/-- Helper for Proposition 5.34: a quasi-Fejér monotone sequence has convergent distances to each
comparison point of the reference set. -/
private theorem quasiFejerMonotone_norm_tendsto {C : Set H} {x : ℕ → H} {z : H}
    (hquasi : QuasiFejerMonotone C x) (hz : z ∈ C) :
    ∃ l : ℝ, Tendsto (fun n ↦ ‖x n - z‖) atTop (𝓝 l) := by
  rcases hquasi.exists_summable_sqdist_error z hz with ⟨ε, hεsumm, hstep⟩
  let α : ℕ → ℝ≥0 := fun n ↦ ⟨‖x n - z‖ ^ 2, sq_nonneg _⟩
  have hrec : ∀ n : ℕ, α (n + 1) + 0 ≤ (1 + 0) * α n + ε n := by
    intro n
    -- The quasi-Fejér step is already the scalar perturbed-descent recursion.
    simpa [α] using hstep n
  rcases
      tendsto_and_summable_of_summable_perturbed_descent
        (α := α) (β := fun _ ↦ 0) (γ := fun _ ↦ 0) (ε := ε)
        summable_zero hεsumm hrec with
    ⟨⟨l, hα⟩, _⟩
  refine ⟨Real.sqrt l, ?_⟩
  have hαreal :
      Tendsto (fun n ↦ ((α n : ℝ≥0) : ℝ)) atTop (𝓝 (l : ℝ)) :=
    (NNReal.tendsto_coe').2 ⟨l.2, hα⟩
  have hsqrt :
      Tendsto (fun n ↦ Real.sqrt (((α n : ℝ≥0) : ℝ))) atTop (𝓝 (Real.sqrt (l : ℝ))) :=
    (Real.continuous_sqrt.tendsto _).comp hαreal
  -- Taking square roots converts convergence of squared distances into convergence of distances.
  have hsqrt_apply :
      (fun n ↦ Real.sqrt (((α n : ℝ≥0) : ℝ))) = (fun n ↦ ‖x n - z‖) := by
    funext n
    change Real.sqrt (‖x n - z‖ ^ 2) = ‖x n - z‖
    rw [Real.sqrt_sq_eq_abs, abs_of_nonneg (norm_nonneg _)]
  rw [hsqrt_apply] at hsqrt
  exact hsqrt

/-- Helper for Proposition 5.34: every weak sequential cluster point of the inexact orbit belongs
to `Function.fixedPoints T` once the residuals converge strongly to `0`. -/
private theorem weak_clusterPoint_mem_fixedPoints_of_inexactKrasnoselskiiMann
    {T : H → H} (hT : LipschitzWith 1 T) (relax : ℕ → ℝ) (e : ℕ → H) (x0 : H)
    (hres :
      Tendsto
        (fun n ↦
          T (inexactKrasnoselskiiMannOrbit T relax e x0 n) -
            inexactKrasnoselskiiMannOrbit T relax e x0 n)
        atTop (𝓝 (0 : H)))
    {z : H}
    (hz :
      IsSequentialClusterPt
        (fun n ↦ toWeakSpace ℝ H (inexactKrasnoselskiiMannOrbit T relax e x0 n))
        (toWeakSpace ℝ H z)) :
    z ∈ Function.fixedPoints T := by
  let x := inexactKrasnoselskiiMannOrbit T relax e x0
  rcases hz.exists_subseq_tendsto with ⟨φ, hφ, hφz⟩
  let zD : {x : H // x ∈ (Set.univ : Set H)} := ⟨z, Set.mem_univ _⟩
  let xSub : ℕ → {x : H // x ∈ (Set.univ : Set H)} := fun n ↦ ⟨x (φ n), Set.mem_univ _⟩
  have hTsub : LipschitzWith 1 (fun y : {x : H // x ∈ (Set.univ : Set H)} ↦ T y) := by
    refine LipschitzWith.of_dist_le_mul ?_
    intro y₁ y₂
    simpa [Subtype.dist_eq, dist_eq_norm, one_mul] using hT.dist_le_mul y₁ y₂
  have hweak :
      Tendsto (fun n ↦ toWeakSpace ℝ H (xSub n : H)) atTop (𝓝 (toWeakSpace ℝ H (zD : H))) := by
    -- The subsequence witness already gives the weak convergence required by Corollary 4.28.
    simpa [xSub, zD, x] using hφz
  have hres_sub :
      Tendsto (fun n ↦ (xSub n : H) - T (xSub n)) atTop (𝓝 (0 : H)) := by
    have hres' :
        Tendsto (fun n ↦ T (x (φ n)) - x (φ n)) atTop (𝓝 (0 : H)) := by
      exact hres.comp hφ.tendsto_atTop
    -- Corollary 4.28 is stated for `xₙ - T xₙ`, so flip the sign of the residual subsequence.
    simpa [xSub, x, sub_eq_add_neg, add_assoc, add_left_comm, add_comm] using
      hres'.const_smul (-1 : ℝ)
  have hz_fixed : T zD = (zD : H) := by
    -- Apply demiclosedness on the whole space `D = Set.univ`.
    simpa [zD] using
      map_eq_of_tendsto_weakly_of_residual_tendsto_zero_of_nonexpansive
        (D := (Set.univ : Set H))
        (T := fun y : {x : H // x ∈ (Set.univ : Set H)} ↦ T y)
        (xₙ := xSub)
        (x := zD)
        isClosed_univ convex_univ hTsub hweak hres_sub
  rw [Function.mem_fixedPoints_iff]
  simpa [zD] using hz_fixed

-- Proof sketch: part (i) gives quasi-Fejér monotonicity of the orbit, and part (ii) gives
-- asymptotic regularity. Corollary 4.28 identifies every weak sequential cluster point as a fixed
-- point of `T`, and the quasi-Fejér convergence theorem then yields weak convergence of the whole
-- orbit to a point of `Function.fixedPoints T`.
/-- Proposition 5.34 (3): (iii) under the same hypotheses, the inexact Krasnosel'skii-Mann orbit
converges weakly to a point of `Function.fixedPoints T`. -/
theorem inexactKrasnoselskiiMannOrbit_tendsto_weakly_to_fixedPoint
    {T : H → H} (hT : LipschitzWith 1 T) (hfix : (Function.fixedPoints T).Nonempty)
    (relax : ℕ → ℝ) (hrelax : ∀ n, relax n ∈ Set.Icc (0 : ℝ) 1)
    (hdiv :
      Tendsto (fun N ↦ (∑ n ∈ Finset.range N, relax n * (1 - relax n))) atTop atTop)
    (e : ℕ → H) (hsummable : Summable (fun n ↦ relax n * ‖e n‖)) (x0 : H) :
    ∃ z ∈ Function.fixedPoints T,
      Tendsto
        (fun n ↦ toWeakSpace ℝ H (inexactKrasnoselskiiMannOrbit T relax e x0 n))
        atTop (𝓝 (toWeakSpace ℝ H z)) := by
  let x := inexactKrasnoselskiiMannOrbit T relax e x0
  have hquasi :
      QuasiFejerMonotone (Function.fixedPoints T) x :=
    inexactKrasnoselskiiMannOrbit_quasiFejerMonotone hT relax hrelax e hsummable x0
  have hres :
      Tendsto (fun n ↦ T (x n) - x n) atTop (𝓝 (0 : H)) := by
    simpa [x] using
      inexactKrasnoselskiiMannOrbit_residual_tendsto_zero
        hT hfix relax hrelax hdiv e hsummable x0
  have hcluster :
      ∀ z : H,
        IsSequentialClusterPt (fun n ↦ toWeakSpace ℝ H (x n)) (toWeakSpace ℝ H z) →
          z ∈ Function.fixedPoints T := by
    intro z hz
    -- Route correction: close clause (iii) by direct Opial plus demiclosedness, not by importing
    -- the later quasi-Fejér convergence API.
    exact
      weak_clusterPoint_mem_fixedPoints_of_inexactKrasnoselskiiMann
        hT relax e x0 hres hz
  -- Opial's lemma applies once every fixed-point distance converges and every weak cluster point
  -- is known to be fixed.
  exact opial_lemma hfix x
    (fun z hz ↦ quasiFejerMonotone_norm_tendsto hquasi hz)
    hcluster

end
