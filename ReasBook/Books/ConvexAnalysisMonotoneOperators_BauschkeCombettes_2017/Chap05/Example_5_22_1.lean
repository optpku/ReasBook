omit [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H] in
-- Proof sketch: choose a point in the common intersection `⋂ i, C i`; its `i`-th coordinate
-- membership shows that `C i` is nonempty.
/-- If the common intersection of a family of sets is nonempty, then each member of the family is
nonempty. -/
theorem set_nonempty_of_iInter_nonempty {C : I → Set H} (hC : (⋂ i, C i).Nonempty) (i : I) :
    (C i).Nonempty := by
  -- Project a witness of the common intersection to the `i`-th component set.
  rcases hC with ⟨x, hx⟩
  exact ⟨x, Set.mem_iInter.mp hx i⟩

variable [Fintype I]

/-- The weighted average of the metric projectors onto the family `C i`. -/
noncomputable def parallelProjectionOperator (C : I → Set H) (hC : (⋂ i, C i).Nonempty)
    (hC_closed : ∀ i, IsClosed (C i)) (hC_convex : ∀ i, Convex ℝ (C i)) (ω : I → ℝ) :
    H → H :=
  fun x ↦
    ∑ i,
      ω i •
        projectionPoint (C i)
          (isChebyshev_of_nonempty_isClosed_convex
            (set_nonempty_of_iInter_nonempty hC i) (hC_closed i) (hC_convex i))
          x

-- Proof sketch: unfold `parallelProjectionOperator` and evaluate the finite weighted sum of the
-- individual metric projectors.
/-- Evaluating the parallel projection operator gives the weighted sum of the projectors onto the
sets `C i`. -/
@[simp] theorem parallelProjectionOperator_apply (C : I → Set H) (hC : (⋂ i, C i).Nonempty)
    (hC_closed : ∀ i, IsClosed (C i)) (hC_convex : ∀ i, Convex ℝ (C i)) (ω : I → ℝ) (x : H) :
    parallelProjectionOperator C hC hC_closed hC_convex ω x =
      ∑ i,
        ω i •
          projectionPoint (C i)
            (isChebyshev_of_nonempty_isClosed_convex
              (set_nonempty_of_iInter_nonempty hC i) (hC_closed i) (hC_convex i))
            x := by
  -- This is just the defining weighted sum of the projector family.
  rfl

-- Proof sketch: unfold `relaxedOperatorIteration` for the constant operator family generated by
-- `parallelProjectionOperator` and then expand the weighted projector operator.
/-- The relaxed iteration of the parallel projection operator satisfies the recursion
`xₙ₊₁ = xₙ + λₙ (∑ i, ω i • P_i xₙ - xₙ)`. -/
theorem parallelProjectionOrbit_succ (C : I → Set H) (hC : (⋂ i, C i).Nonempty)
    (hC_closed : ∀ i, IsClosed (C i)) (hC_convex : ∀ i, Convex ℝ (C i)) (ω : I → ℝ)
    (relax : ℕ → ℝ) (x0 : H) (n : ℕ) :
    relaxedOperatorIteration (fun _ ↦ parallelProjectionOperator C hC hC_closed hC_convex ω)
        relax x0 (n + 1) =
      relaxedOperatorIteration (fun _ ↦ parallelProjectionOperator C hC hC_closed hC_convex ω)
        relax x0 n +
        relax n •
          ((∑ i,
              ω i •
                projectionPoint (C i)
                  (isChebyshev_of_nonempty_isClosed_convex
                    (set_nonempty_of_iInter_nonempty hC i) (hC_closed i) (hC_convex i))
                  (relaxedOperatorIteration
                    (fun _ ↦ parallelProjectionOperator C hC hC_closed hC_convex ω)
                    relax x0 n)) -
            relaxedOperatorIteration (fun _ ↦ parallelProjectionOperator C hC hC_closed
              hC_convex ω) relax x0 n) := by
  -- Unfold one relaxed step and then expand the weighted projector operator.
  simpa [parallelProjectionOperator_apply] using
    (relaxedOperatorIteration_succ
      (fun _ ↦ parallelProjectionOperator C hC hC_closed hC_convex ω) relax x0 n)

/-- Helper for Example 5.22.1: a finite family of weights summing to `1`
cannot have an empty index type. -/
private theorem nonempty_of_weights_sum_one (ω : I → ℝ) (hω_sum : ∑ i, ω i = 1) :
    Nonempty I := by
  classical
  by_contra hI
  letI : IsEmpty I := not_nonempty_iff.mp hI
  simp at hω_sum

omit [CompleteSpace H] in
/-- Helper for Example 5.22.1: whole-space firm nonexpansiveness is equivalent to the standard
Hilbert-space inner-product estimate. -/
private theorem firmlyNonexpansiveOn_univ_iff_inner {T : H → H} :
    FirmlyNonexpansiveOn (Set.univ : Set H) T ↔
      ∀ x y : H, ‖T x - T y‖ ^ (2 : ℕ) ≤ ⟪T x - T y, x - y⟫_ℝ := by
  rw [firmlyNonexpansiveOn_iff]
  constructor
  · intro h x y
    -- Rewrite the residual term as `(x - y) - (T x - T y)` and expand its squared norm.
    have hxy :
        ‖T x - T y‖ ^ (2 : ℕ) + ‖(x - T x) - (y - T y)‖ ^ (2 : ℕ) ≤ ‖x - y‖ ^ (2 : ℕ) := by
      simpa using h x (by simp) y (by simp)
    have hres : (x - T x) - (y - T y) = (x - y) - (T x - T y) := by
      abel_nf
    rw [hres] at hxy
    have hnorm :
        ‖(x - y) - (T x - T y)‖ ^ (2 : ℕ) =
          ‖x - y‖ ^ (2 : ℕ) - 2 * ⟪x - y, T x - T y⟫_ℝ + ‖T x - T y‖ ^ (2 : ℕ) := by
      simpa [real_inner_comm] using norm_sub_sq_real (x - y) (T x - T y)
    rw [hnorm] at hxy
    have hxy' : ‖T x - T y‖ ^ (2 : ℕ) ≤ ⟪x - y, T x - T y⟫_ℝ := by
      nlinarith
    simpa [real_inner_comm] using hxy'
  · intro h x hx y hy
    -- Run the same norm expansion backwards to recover the residual inequality.
    have hxy : ‖T x - T y‖ ^ (2 : ℕ) ≤ ⟪T x - T y, x - y⟫_ℝ := h x y
    have hres : (x - T x) - (y - T y) = (x - y) - (T x - T y) := by
      abel_nf
    have hnorm :
        ‖(x - T x) - (y - T y)‖ ^ (2 : ℕ) =
          ‖x - y‖ ^ (2 : ℕ) - 2 * ⟪x - y, T x - T y⟫_ℝ + ‖T x - T y‖ ^ (2 : ℕ) := by
      rw [hres]
      simpa [real_inner_comm] using norm_sub_sq_real (x - y) (T x - T y)
    have hxy' : ‖T x - T y‖ ^ (2 : ℕ) ≤ ⟪x - y, T x - T y⟫_ℝ := by
      simpa [real_inner_comm] using hxy
    rw [hnorm]
    nlinarith [hxy']

/-- Helper for Example 5.22.1: positive weights summing to `1` lie in the interval `(0, 1]`. -/
private theorem weights_mem_Ioc_of_pos_sum_one (ω : I → ℝ) (hω_pos : ∀ i, 0 < ω i)
    (hω_sum : ∑ i, ω i = 1) (i : I) :
    ω i ∈ Set.Ioc (0 : ℝ) 1 := by
  refine ⟨hω_pos i, ?_⟩
  -- Each positive term is bounded above by the whole normalized sum.
  have hi_le_sum : ω i ≤ ∑ j, ω j := by
    simpa using
      (Finset.single_le_sum
        (fun j _ ↦ (hω_pos j).le)
        (by simp : i ∈ (Finset.univ : Finset I)))
  rw [hω_sum] at hi_le_sum
  simpa using hi_le_sum

/-- Helper for Example 5.22.1: each projector onto a nonempty closed convex set is firmly
nonexpansive on the whole space. -/
private theorem projectionPoint_firmlyNonexpansiveOn_univ {C : Set H}
    (hC_nonempty : C.Nonempty) (hC_closed : IsClosed C) (hC_convex : Convex ℝ C) :
    FirmlyNonexpansiveOn (Set.univ : Set H)
      (projectionPoint C
        (isChebyshev_of_nonempty_isClosed_convex hC_nonempty hC_closed hC_convex)) := by
  -- Proposition 4.16 provides exactly the Hilbert-space firm estimate for the projector.
  rw [firmlyNonexpansiveOn_univ_iff_inner]
  intro x y
  exact
    norm_sq_projectionPoint_sub_le_inner_projectionPoint_sub_of_nonempty_isClosed_convex
      hC_nonempty hC_closed hC_convex x y

/-- Helper for Example 5.22.1: every point of a closed convex set is fixed by its metric
projection. -/
private theorem projectionPoint_eq_self_of_mem_of_nonempty_isClosed_convex {C : Set H}
    (hC_nonempty : C.Nonempty) (hC_closed : IsClosed C) (hC_convex : Convex ℝ C) {x : H}
    (hx : x ∈ C) :
    projectionPoint C (isChebyshev_of_nonempty_isClosed_convex hC_nonempty hC_closed hC_convex)
      x = x := by
  -- The projection characterization is realized by `x` itself because its residual vanishes.
  have hxproj :
      x =
        projectionPoint C
          (isChebyshev_of_nonempty_isClosed_convex hC_nonempty hC_closed hC_convex) x := by
    exact
      (eq_projectionPoint_iff_mem_and_inner_sub_right_nonpos_of_nonempty_isClosed_convex
        hC_nonempty hC_closed hC_convex).mpr <| by
          refine ⟨hx, ?_⟩
          intro y hy
          simp
  simpa using hxproj.symm

/-- Helper for Example 5.22.1: the fixed points of the metric projection onto a nonempty closed
convex set are exactly the points of that set. -/
private theorem fixedPoints_projectionPoint_eq_of_nonempty_isClosed_convex {C : Set H}
    (hC_nonempty : C.Nonempty) (hC_closed : IsClosed C) (hC_convex : Convex ℝ C) :
    Function.fixedPoints
        (projectionPoint C
          (isChebyshev_of_nonempty_isClosed_convex hC_nonempty hC_closed hC_convex)) = C := by
  ext x
  constructor
  · intro hx
    rw [Function.mem_fixedPoints_iff] at hx
    -- Fixed points belong to the target set because projections land in the set.
    simpa [hx] using
      projectionPoint_mem C
        (isChebyshev_of_nonempty_isClosed_convex hC_nonempty hC_closed hC_convex) x
  · intro hx
    rw [Function.mem_fixedPoints_iff]
    -- Points already in the set are fixed by the projector.
    exact projectionPoint_eq_self_of_mem_of_nonempty_isClosed_convex
      hC_nonempty hC_closed hC_convex hx

omit [InnerProductSpace ℝ H] [CompleteSpace H] in
/-- Helper for Example 5.22.1: whole-space firm nonexpansiveness implies whole-space
quasinonexpansiveness. -/
private theorem quasinonexpansiveOn_univ_of_firmlyNonexpansiveOn_univ {T : H → H}
    (hT : FirmlyNonexpansiveOn (Set.univ : Set H) T) :
    QuasinonexpansiveOn (Set.univ : Set H) T := by
  rw [firmlyNonexpansiveOn_iff] at hT
  rw [quasinonexpansiveOn_iff]
  intro x hx y hy
  rcases mem_fixedPointSetOn_iff.mp hy with ⟨hy_univ, hyfix⟩
  have hxy :
      ‖T x - y‖ ^ (2 : ℕ) + ‖x - T x‖ ^ (2 : ℕ) ≤ ‖x - y‖ ^ (2 : ℕ) := by
    simpa [hyfix, hy_univ] using hT x hx y hy_univ
  have hsq : ‖T x - y‖ ^ (2 : ℕ) ≤ ‖x - y‖ ^ (2 : ℕ) := by
    nlinarith [hxy]
  exact (sq_le_sq₀ (norm_nonneg _) (norm_nonneg _)).1 hsq

/-- Helper for Example 5.22.1: Proposition 4.6 makes the weighted projector average firmly
nonexpansive on the whole space. -/
private theorem parallelProjectionOperator_firmlyNonexpansive
    (C : I → Set H) (hC : (⋂ i, C i).Nonempty) (hC_closed : ∀ i, IsClosed (C i))
    (hC_convex : ∀ i, Convex ℝ (C i)) (ω : I → ℝ) (hω_pos : ∀ i, 0 < ω i)
    (hω_sum : ∑ i, ω i = 1) :
    FirmlyNonexpansive (parallelProjectionOperator C hC hC_closed hC_convex ω) := by
  letI : Nonempty I := nonempty_of_weights_sum_one ω hω_sum
  let P : I → H → H := fun i x ↦
    projectionPoint (C i)
      (isChebyshev_of_nonempty_isClosed_convex
        (set_nonempty_of_iInter_nonempty hC i) (hC_closed i) (hC_convex i))
      x
  have hPfirm : ∀ i, IsFirmlyNonexpansiveOn (fun x : H_univ ↦ P i x) := by
    intro i
    change FirmlyNonexpansiveOn (Set.univ : Set H) (P i)
    exact projectionPoint_firmlyNonexpansiveOn_univ
      (set_nonempty_of_iInter_nonempty hC i) (hC_closed i) (hC_convex i)
  have hω_mem : ∀ i, ω i ∈ Set.Ioc (0 : ℝ) 1 := by
    intro i
    exact weights_mem_Ioc_of_pos_sum_one ω hω_pos hω_sum i
  -- Route correction: use Proposition 4.6 directly rather than the conflicting averagedness API.
  rw [FirmlyNonexpansive]
  change IsFirmlyNonexpansiveOn (fun x : H_univ ↦ parallelProjectionOperator C hC hC_closed
    hC_convex ω x)
  simpa [P, parallelProjectionOperator_apply, weightedOperatorAverage_apply] using
    weightedOperatorAverage_isFirmlyNonexpansiveOn
      ω (fun i ↦ fun x : H_univ ↦ P i x) hPfirm hω_mem hω_sum

/-- Helper for Example 5.22.1: the fixed points of the weighted parallel projector are exactly the
common points of the family `C i`. -/
private theorem fixedPoints_parallelProjectionOperator_eq_iInter
    (C : I → Set H) (hC : (⋂ i, C i).Nonempty) (hC_closed : ∀ i, IsClosed (C i))
    (hC_convex : ∀ i, Convex ℝ (C i)) (ω : I → ℝ) (hω_pos : ∀ i, 0 < ω i)
    (hω_sum : ∑ i, ω i = 1) :
    Function.fixedPoints (parallelProjectionOperator C hC hC_closed hC_convex ω) = ⋂ i, C i := by
  let P : I → H → H := fun i x ↦
    projectionPoint (C i)
      (isChebyshev_of_nonempty_isClosed_convex
        (set_nonempty_of_iInter_nonempty hC i) (hC_closed i) (hC_convex i))
      x
  have hPfirm : ∀ i, FirmlyNonexpansiveOn (Set.univ : Set H) (P i) := by
    intro i
    exact projectionPoint_firmlyNonexpansiveOn_univ
      (set_nonempty_of_iInter_nonempty hC i) (hC_closed i) (hC_convex i)
  have hPquasi : ∀ i, IsQuasinonexpansiveOn (fun x : H_univ ↦ P i x) := by
    intro i
    change QuasinonexpansiveOn (Set.univ : Set H) (P i)
    exact quasinonexpansiveOn_univ_of_firmlyNonexpansiveOn_univ (hPfirm i)
  have hC_nonempty : ∀ i, (C i).Nonempty := by
    intro i
    exact set_nonempty_of_iInter_nonempty hC i
  have hFix_nonempty :
      (⋂ i, fixedPointsWithin (fun x : H_univ ↦ P i x)).Nonempty := by
    rcases hC with ⟨z, hz⟩
    refine ⟨⟨z, Set.mem_univ _⟩, ?_⟩
    rw [Set.mem_iInter]
    intro i
    rw [mem_fixedPointsWithin_iff, ← Function.mem_fixedPoints_iff]
    -- A point in every `C i` is fixed by every component projector.
    have hzi : z ∈ C i := (Set.mem_iInter.mp hz) i
    simpa [P,
      fixedPoints_projectionPoint_eq_of_nonempty_isClosed_convex
        (C := C i) (hC_nonempty i) (hC_closed i) (hC_convex i)] using hzi
  have hFixWithin_eq :
      fixedPointsWithin (weightedOperatorAverage ω (fun i ↦ fun x : H_univ ↦ P i x)) =
        ⋂ i, fixedPointsWithin (fun x : H_univ ↦ P i x) :=
    fixedPointsWithin_weightedAverage_eq_iInter
      ω (fun i ↦ fun x : H_univ ↦ P i x) hPquasi hFix_nonempty hω_pos hω_sum
  ext x
  constructor
  · intro hx
    have hxWithin :
        (⟨x, Set.mem_univ _⟩ : H_univ) ∈
          fixedPointsWithin (weightedOperatorAverage ω (fun i ↦ fun y : H_univ ↦ P i y)) := by
      rw [mem_fixedPointsWithin_iff]
      rw [Function.mem_fixedPoints_iff] at hx
      -- Reinterpret the ambient fixed-point relation as a subtype fixed-point relation.
      simpa [P, parallelProjectionOperator_apply, weightedOperatorAverage_apply] using hx
    have hxComponents :
        (⟨x, Set.mem_univ _⟩ : H_univ) ∈
          ⋂ i, fixedPointsWithin (fun y : H_univ ↦ P i y) := by
      rw [← hFixWithin_eq]
      exact hxWithin
    rw [Set.mem_iInter]
    intro i
    have hxi :
        (⟨x, Set.mem_univ _⟩ : H_univ) ∈ fixedPointsWithin (fun y : H_univ ↦ P i y) :=
      (Set.mem_iInter.mp hxComponents) i
    rw [mem_fixedPointsWithin_iff, ← Function.mem_fixedPoints_iff] at hxi
    -- Convert the component fixed-point condition back to membership in `C i`.
    simpa [P,
      fixedPoints_projectionPoint_eq_of_nonempty_isClosed_convex
        (C := C i)
        (set_nonempty_of_iInter_nonempty hC i)
        (hC_closed i)
        (hC_convex i)] using hxi
  · intro hx
    have hxComponents :
        (⟨x, Set.mem_univ _⟩ : H_univ) ∈
          ⋂ i, fixedPointsWithin (fun y : H_univ ↦ P i y) := by
      rw [Set.mem_iInter]
      intro i
      rw [mem_fixedPointsWithin_iff, ← Function.mem_fixedPoints_iff]
      -- Membership in `C i` identifies `x` as a fixed point of the `i`-th projector.
      simpa [P,
        fixedPoints_projectionPoint_eq_of_nonempty_isClosed_convex
          (C := C i)
          (set_nonempty_of_iInter_nonempty hC i)
          (hC_closed i)
          (hC_convex i)] using (Set.mem_iInter.mp hx i)
    have hxWithin :
        (⟨x, Set.mem_univ _⟩ : H_univ) ∈
          fixedPointsWithin (weightedOperatorAverage ω (fun i ↦ fun y : H_univ ↦ P i y)) := by
      rw [hFixWithin_eq]
      exact hxComponents
    rw [Function.mem_fixedPoints_iff]
    rw [mem_fixedPointsWithin_iff] at hxWithin
    -- The subtype fixed-point equation is the ambient one for the parallel projection operator.
    simpa [P, parallelProjectionOperator_apply, weightedOperatorAverage_apply] using hxWithin

-- Proof sketch: let `T` be the weighted average of the projectors onto the sets `C i`. Each
-- projector is firmly nonexpansive by Proposition 4.16, so Proposition 4.6 makes `T` firmly
-- nonexpansive. Proposition 4.47 identifies `Function.fixedPoints T` with `⋂ i, C i`, and then
-- Corollary 5.17 (3) applied to the relaxed iteration of `T` gives the weak convergence of the
-- parallel projection algorithm.
/-- Example 5.22.1: for a finite family of closed convex sets with nonempty common intersection,
the Krasnosel'skii-Mann iteration of the weighted average of the metric projectors converges
weakly to a point in the common intersection whenever the weights are strictly positive, sum to
`1`, and the relaxation parameters satisfy `∑ λₙ (2 - λₙ) = +∞`. -/
theorem parallelProjectionOrbit_tendsto_weakly_to_point_of_iInter
    (C : I → Set H) (hC : (⋂ i, C i).Nonempty) (hC_closed : ∀ i, IsClosed (C i))
    (hC_convex : ∀ i, Convex ℝ (C i)) (ω : I → ℝ) (hω_pos : ∀ i, 0 < ω i)
    (hω_sum : ∑ i, ω i = 1) (relax : ℕ → ℝ)
    (hrelax : ∀ n, relax n ∈ Set.Icc (0 : ℝ) 2)
    (hdiv :
      Tendsto (fun N ↦ ∑ n ∈ Finset.range N, relax n * (2 - relax n)) atTop atTop)
    (x0 : H) :
    ∃ z ∈ ⋂ i, C i,
      Tendsto
        (fun n ↦
          toWeakSpace ℝ H
            (relaxedOperatorIteration
              (fun _ ↦ parallelProjectionOperator C hC hC_closed hC_convex ω) relax x0 n))
        atTop (𝓝 (toWeakSpace ℝ H z)) := by
  have hfirm :
      FirmlyNonexpansive (parallelProjectionOperator C hC hC_closed hC_convex ω) :=
    parallelProjectionOperator_firmlyNonexpansive
      C hC hC_closed hC_convex ω hω_pos hω_sum
  have hfix_nonempty :
      (Function.fixedPoints (parallelProjectionOperator C hC hC_closed hC_convex ω)).Nonempty := by
    rw [fixedPoints_parallelProjectionOperator_eq_iInter C hC hC_closed hC_convex ω
      hω_pos hω_sum]
    exact hC
  rcases
      exists_tendsto_weakly_to_fixedPoint_of_relaxedOperatorIteration_of_firmlyNonexpansive
        hfirm hfix_nonempty relax hrelax hdiv x0 with
    ⟨z, hz, hz_tendsto⟩
  refine ⟨z, ?_, hz_tendsto⟩
  -- Identify the abstract fixed-point witness with the common intersection `⋂ i, C i`.
  simpa [fixedPoints_parallelProjectionOperator_eq_iInter C hC hC_closed hC_convex ω
    hω_pos hω_sum] using hz

end
