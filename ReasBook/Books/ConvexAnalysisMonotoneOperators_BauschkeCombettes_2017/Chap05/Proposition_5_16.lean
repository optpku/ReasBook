variable {H : Type u} [NormedAddCommGroup H] [NormedSpace ℝ H]
variable {D : Set H}

-- Proof sketch: for each fixed point `y` of `T`, expand the squared norm of
-- `(1 - λ n) • (xₙ - y) + λ n • (T xₙ - y)` in the subtype metric and use nonexpansiveness of `T`
-- together with `T y = y` to obtain the one-step Fejér inequality.
/-- Theorem 5.15 (1): the Krasnosel'skii-Mann iteration is Fejér monotone with respect to the
ambient realization of its fixed-point set. -/
theorem krasnoselskiiMannIteration_fejerMonotone
    (hD_convex : Convex ℝ D) (T : D → D) (hT : LipschitzWith 1 T)
    (relax : ℕ → ℝ) (hrelax : ∀ n, relax n ∈ Set.Icc (0 : ℝ) 1) (x₀ : D) :
    FejerMonotone (Subtype.val '' fixedPoints T)
      (fun n ↦ (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n : H)) := by
  intro y hy n
  rcases hy with ⟨y, hy, rfl⟩
  let xn := krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n
  have hyfix : T y = y := Function.mem_fixedPoints_iff.mp hy
  have hrelax_nonneg : 0 ≤ relax n := (hrelax n).1
  have hone_sub_nonneg : 0 ≤ 1 - relax n := sub_nonneg.mpr (hrelax n).2
  have hTx :
      ‖(T xn : H) - y‖ ≤ ‖(xn : H) - y‖ := by
    simpa [Subtype.dist_eq, dist_eq_norm, hyfix, one_mul, xn] using hT.dist_le_mul xn y
  have hweighted :
      relax n * ‖(T xn : H) - y‖ ≤ relax n * ‖(xn : H) - y‖ :=
    mul_le_mul_of_nonneg_left hTx hrelax_nonneg
  -- Rewrite the successor error as the convex combination of the current error and image error.
  calc
    dist (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ (n + 1) : H) y =
        ‖(1 - relax n) • ((xn : H) - y) + relax n • ((T xn : H) - y)‖ := by
          rw [dist_eq_norm, krasnoselskiiMannIteration_sub_eq_affineCombination]
    _ ≤ ‖(1 - relax n) • ((xn : H) - y)‖ + ‖relax n • ((T xn : H) - y)‖ :=
          norm_add_le _ _
    _ = (1 - relax n) * ‖(xn : H) - y‖ + relax n * ‖(T xn : H) - y‖ := by
          rw [norm_smul, norm_smul, Real.norm_eq_abs, Real.norm_eq_abs,
            abs_of_nonneg hone_sub_nonneg, abs_of_nonneg hrelax_nonneg]
    _ ≤ (1 - relax n) * ‖(xn : H) - y‖ + relax n * ‖(xn : H) - y‖ := by
          exact add_le_add le_rfl hweighted
    _ = dist (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n : H) y := by
          rw [dist_eq_norm]
          ring

end

