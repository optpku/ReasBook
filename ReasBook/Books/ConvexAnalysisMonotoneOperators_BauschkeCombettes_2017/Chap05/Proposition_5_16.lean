variable {H : Type u} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
variable {D : Set H}

/-- Helper for Theorem 5.15: the squared norm of an affine combination plus the weighted squared
gap equals the corresponding affine combination of squared norms. -/
private theorem weighted_affine_norm_sq_identity (u v : H) (α : ℝ) :
    ‖α • u + (1 - α) • v‖ ^ 2 + α * (1 - α) * ‖u - v‖ ^ 2 =
      α * ‖u‖ ^ 2 + (1 - α) * ‖v‖ ^ 2 := by
  -- Expand both squared norms by the real inner-product identities and normalize the coefficients.
  rw [norm_add_sq_real, norm_sub_sq_real, norm_smul, norm_smul, Real.norm_eq_abs,
    Real.norm_eq_abs]
  simp [real_inner_smul_left, real_inner_smul_right]
  nlinarith [sq_abs α, sq_abs (1 - α)]

/-- Helper for Theorem 5.15: one Krasnosel'skii-Mann step satisfies the textbook energy inequality
with respect to every fixed point of `T`. -/
private theorem krasnoselskiiMann_sqdist_step_le_sqdist_of_fixedPoint
    (hD_convex : Convex ℝ D) (T : D → D) (hT : LipschitzWith 1 T)
    (relax : ℕ → ℝ) (hrelax : ∀ n, relax n ∈ Set.Icc (0 : ℝ) 1) (x₀ : D)
    (y : fixedPoints T) (n : ℕ) :
    ‖(krasnoselskiiMannIteration hD_convex T relax hrelax x₀ (n + 1) : H) - y‖ ^ 2 ≤
      ‖(krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n : H) - y‖ ^ 2 -
        relax n * (1 - relax n) *
          ‖(T (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n) : H) -
              (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n : H)‖ ^ 2 := by
  let xn := krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n
  have hyfix : T y = y := Function.mem_fixedPoints_iff.mp y.2
  have hnonexp :
      ‖(T xn : H) - y‖ ≤ ‖(xn : H) - y‖ := by
    simpa [Subtype.dist_eq, dist_eq_norm, hyfix, one_mul, xn] using hT.dist_le_mul xn y
  have hnonexp_sq : ‖(T xn : H) - y‖ ^ 2 ≤ ‖(xn : H) - y‖ ^ 2 := by
    nlinarith [hnonexp, norm_nonneg ((T xn : H) - y), norm_nonneg ((xn : H) - y)]
  have hidentity :=
    weighted_affine_norm_sq_identity ((T xn : H) - y) ((xn : H) - y) (relax n)
  have hrewrite :
      (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ (n + 1) : H) - y =
        relax n • ((T xn : H) - y) + (1 - relax n) • ((xn : H) - y) := by
    simpa [add_comm] using
      krasnoselskiiMannIteration_sub_eq_affineCombination hD_convex T relax hrelax x₀ (y : H) n
  have hresidual :
      ((T xn : H) - y) - ((xn : H) - y) = (T xn : H) - (xn : H) := by
    abel_nf
  have hstep :
      ‖(krasnoselskiiMannIteration hD_convex T relax hrelax x₀ (n + 1) : H) - y‖ ^ 2 +
          relax n * (1 - relax n) *
            ‖(T xn : H) - (xn : H)‖ ^ 2 ≤
        ‖(xn : H) - y‖ ^ 2 := by
    -- Compare the affine-combination identity with nonexpansiveness at the fixed point `y`.
    calc
      ‖(krasnoselskiiMannIteration hD_convex T relax hrelax x₀ (n + 1) : H) - y‖ ^ 2 +
          relax n * (1 - relax n) * ‖(T xn : H) - (xn : H)‖ ^ 2 =
        relax n * ‖(T xn : H) - y‖ ^ 2 + (1 - relax n) * ‖(xn : H) - y‖ ^ 2 := by
          rw [hrewrite]
          simpa [hresidual] using hidentity
      _ ≤ ‖(xn : H) - y‖ ^ 2 := by
          have hrelax_nonneg : 0 ≤ relax n := (hrelax n).1
          have hrelax_le_one : relax n ≤ 1 := (hrelax n).2
          nlinarith
  have hweight_nonneg :
      0 ≤ relax n * (1 - relax n) *
        ‖(T xn : H) - (xn : H)‖ ^ 2 := by
    have hrelax_nonneg : 0 ≤ relax n := (hrelax n).1
    have hone_sub_nonneg : 0 ≤ 1 - relax n := sub_nonneg.mpr (hrelax n).2
    positivity
  -- Discard the nonnegative residual term from the left-hand side.
  nlinarith

/-- Helper for Theorem 5.15: the partial residual energy plus the current squared distance to a
fixed point stays below the initial squared distance. -/
private theorem krasnoselskiiMann_sqdist_add_weighted_partial_sum_le_sqdist_of_fixedPoint
    (hD_convex : Convex ℝ D) (T : D → D) (hT : LipschitzWith 1 T)
    (relax : ℕ → ℝ) (hrelax : ∀ n, relax n ∈ Set.Icc (0 : ℝ) 1) (x₀ : D)
    (y : fixedPoints T) :
    ∀ N : ℕ,
      ‖(krasnoselskiiMannIteration hD_convex T relax hrelax x₀ N : H) - y‖ ^ 2 +
          ∑ n ∈ Finset.range N,
            relax n * (1 - relax n) *
              ‖(T (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n) : H) -
                  (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n : H)‖ ^ 2 ≤
        ‖(x₀ : H) - y‖ ^ 2 := by
  intro N
  induction N with
  | zero =>
      -- The empty partial sum leaves only the initial squared distance.
      simp
  | succ N ih =>
      have hstep :=
        krasnoselskiiMann_sqdist_step_le_sqdist_of_fixedPoint
          hD_convex T hT relax hrelax x₀ y N
      -- Telescope the one-step inequality with the induction hypothesis.
      rw [Finset.sum_range_succ]
      nlinarith [ih, hstep]

/-- Helper for Theorem 5.15: every weighted partial sum of squared residuals is bounded by the
initial squared distance to a fixed point. -/
theorem krasnoselskiiMann_residual_weighted_partial_sum_le_sqdist_of_fixedPoint
    (hD_convex : Convex ℝ D) (T : D → D) (hT : LipschitzWith 1 T)
    (relax : ℕ → ℝ) (hrelax : ∀ n, relax n ∈ Set.Icc (0 : ℝ) 1) (x₀ : D)
    (y : fixedPoints T) (N : ℕ) :
    ∑ n ∈ Finset.range N,
      relax n * (1 - relax n) *
        ‖(T (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n) : H) -
            (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n : H)‖ ^ 2 ≤
      ‖(x₀ : H) - y‖ ^ 2 := by
  have hbound :=
    krasnoselskiiMann_sqdist_add_weighted_partial_sum_le_sqdist_of_fixedPoint
      hD_convex T hT relax hrelax x₀ y N
  have hsq_nonneg :
      0 ≤ ‖(krasnoselskiiMannIteration hD_convex T relax hrelax x₀ N : H) - y‖ ^ 2 := by
    positivity
  -- Drop the nonnegative squared-distance term from the stronger telescoping bound.
  nlinarith

/-- Helper for Theorem 5.15: the norms of the Krasnosel'skii-Mann residuals form an antitone
sequence. -/
theorem krasnoselskiiMann_residual_norm_antitone
    (hD_convex : Convex ℝ D) (T : D → D) (hT : LipschitzWith 1 T)
    (relax : ℕ → ℝ) (hrelax : ∀ n, relax n ∈ Set.Icc (0 : ℝ) 1) (x₀ : D) (n : ℕ) :
    ‖(T (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ (n + 1)) : H) -
        (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ (n + 1) : H)‖ ≤
      ‖(T (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n) : H) -
          (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n : H)‖ := by
  let xn := krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n
  let xn1 := krasnoselskiiMannIteration hD_convex T relax hrelax x₀ (n + 1)
  have hdist :
      ‖(T xn1 : H) - T xn‖ ≤ ‖(xn1 : H) - xn‖ := by
    simpa [Subtype.dist_eq, dist_eq_norm] using hT.dist_le_mul xn1 xn
  have hdiff :
      (xn1 : H) - (xn : H) = relax n • ((T xn : H) - (xn : H)) := by
    exact krasnoselskiiMannIteration_sub_eq_relax_residual hD_convex T relax hrelax x₀ n
  have hexpand :
      (T xn1 : H) - (xn1 : H) =
        ((T xn1 : H) - T xn) + (1 - relax n) • ((T xn : H) - (xn : H)) := by
    have htail :
        (T xn : H) - (xn1 : H) = (1 - relax n) • ((T xn : H) - (xn : H)) := by
      have hsucc :
          (xn1 : H) = (xn : H) + relax n • ((T xn : H) - (xn : H)) := by
        exact krasnoselskiiMannIteration_succ hD_convex T relax hrelax x₀ n
      rw [hsucc]
      rw [sub_smul, one_smul]
      abel_nf
    calc
      (T xn1 : H) - (xn1 : H) = ((T xn1 : H) - T xn) + ((T xn : H) - (xn1 : H)) := by
        abel_nf
      _ = ((T xn1 : H) - T xn) + (1 - relax n) • ((T xn : H) - (xn : H)) := by
        rw [htail]
  have hrelax_nonneg : 0 ≤ relax n := (hrelax n).1
  have hone_sub_nonneg : 0 ≤ 1 - relax n := sub_nonneg.mpr (hrelax n).2
  -- Expand the next residual, then bound the two summands by the current residual.
  calc
    ‖(T xn1 : H) - (xn1 : H)‖ =
        ‖((T xn1 : H) - T xn) + (1 - relax n) • ((T xn : H) - (xn : H))‖ := by
          rw [hexpand]
    _ ≤ ‖(T xn1 : H) - T xn‖ + ‖(1 - relax n) • ((T xn : H) - (xn : H))‖ :=
          norm_add_le _ _
    _ ≤ ‖(xn1 : H) - xn‖ + ‖(1 - relax n) • ((T xn : H) - (xn : H))‖ := by
          exact add_le_add hdist le_rfl
    _ = ‖relax n • ((T xn : H) - (xn : H))‖ +
          ‖(1 - relax n) • ((T xn : H) - (xn : H))‖ := by
          rw [hdiff]
    _ = relax n * ‖(T xn : H) - (xn : H)‖ +
          (1 - relax n) * ‖(T xn : H) - (xn : H)‖ := by
          rw [norm_smul, norm_smul, Real.norm_eq_abs, Real.norm_eq_abs,
            abs_of_nonneg hrelax_nonneg, abs_of_nonneg hone_sub_nonneg]
    _ = ‖(T xn : H) - (xn : H)‖ := by
          ring

-- Proof sketch: combine the Fejér estimate from part (1) with a fixed point `y` of `T` to get a
-- summable bound on `λ n * (1 - λ n) * ‖T xₙ - xₙ‖ ^ 2`. The divergence of the scalar weights
-- forces `liminf ‖T xₙ - xₙ‖ = 0`, and the standard monotonicity estimate for the residual norms
-- then upgrades this to convergence to `0`.
/-- Theorem 5.15 (2): if the fixed point set of `T` is nonempty and
`∑ λₙ (1 - λₙ) = +∞`, then the Krasnosel'skii-Mann residuals `T xₙ - xₙ` converge strongly to
`0`. -/
theorem krasnoselskiiMannIteration_residual_tendsto_zero
    (hD_convex : Convex ℝ D) (T : D → D) (hT : LipschitzWith 1 T)
    (hfix : (fixedPoints T).Nonempty)
    (relax : ℕ → ℝ) (hrelax : ∀ n, relax n ∈ Set.Icc (0 : ℝ) 1)
    (hdiv :
      Tendsto (fun N ↦ (∑ n ∈ Finset.range N, relax n * (1 - relax n))) atTop atTop)
    (x₀ : D) :
    Tendsto
      (fun n ↦
        (T (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n) : H) -
          (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n : H))
      atTop (𝓝 (0 : H)) := by
  rcases hfix with ⟨y, hy⟩
  let yFix : fixedPoints T := ⟨y, hy⟩
  let residual : ℕ → H := fun n ↦
    (T (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n) : H) -
      (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n : H)
  let residualNorm : ℕ → ℝ := fun n ↦ ‖residual n‖
  let weight : ℕ → ℝ := fun n ↦ relax n * (1 - relax n)
  have hanti : Antitone residualNorm := by
    refine antitone_nat_of_succ_le fun n ↦ ?_
    simpa [residualNorm, residual] using
      krasnoselskiiMann_residual_norm_antitone hD_convex T hT relax hrelax x₀ n
  have hboundedBelow : BddBelow (Set.range residualNorm) := by
    refine ⟨0, ?_⟩
    rintro _ ⟨n, rfl⟩
    exact norm_nonneg _
  have hlim :
      Tendsto residualNorm atTop (𝓝 (⨅ n, residualNorm n)) :=
    tendsto_atTop_ciInf hanti hboundedBelow
  have hweight_nonneg : ∀ n, 0 ≤ weight n := by
    intro n
    have hrelax_nonneg : 0 ≤ relax n := (hrelax n).1
    have hone_sub_nonneg : 0 ≤ 1 - relax n := sub_nonneg.mpr (hrelax n).2
    positivity
  have hbound :
      ∀ N : ℕ,
        ∑ n ∈ Finset.range N, weight n * residualNorm n ^ 2 ≤ ‖(x₀ : H) - yFix‖ ^ 2 := by
    intro N
    simpa [weight, residualNorm, residual] using
      krasnoselskiiMann_residual_weighted_partial_sum_le_sqdist_of_fixedPoint
        hD_convex T hT relax hrelax x₀ yFix N
  let l : ℝ := sInf (residualNorm '' Set.Ici 0)
  have hset_bddBelow : BddBelow (residualNorm '' Set.Ici 0) := by
    refine ⟨0, ?_⟩
    rintro _ ⟨n, hn, rfl⟩
    exact norm_nonneg (residual n)
  have hl_le : ∀ n : ℕ, l ≤ residualNorm n := by
    intro n
    exact csInf_le hset_bddBelow ⟨n, Nat.zero_le n, rfl⟩
  have hl_nonneg : 0 ≤ l := by
    have hset_nonempty : (residualNorm '' Set.Ici 0).Nonempty := by
      exact ⟨residualNorm 0, ⟨0, Nat.zero_le 0, rfl⟩⟩
    have hzero_lower : 0 ∈ lowerBounds (residualNorm '' Set.Ici 0) := by
      rintro _ ⟨n, hn, rfl⟩
      exact norm_nonneg (residual n)
    exact le_csInf hset_nonempty hzero_lower
  have hlim' :
      Tendsto residualNorm atTop (𝓝 l) := by
    simpa [l] using
      (Real.tendsto_atTop_csInf_of_antitoneOn_bddBelow_nat_Ici (k := 0)
        (fun m hm n hn hmn ↦ hanti hmn)
        hset_bddBelow)
  have hl_eq_zero : l = 0 := by
    by_contra hzero
    have hne : 0 ≠ l := by
      simpa [eq_comm] using hzero
    have hpos : 0 < l := lt_of_le_of_ne hl_nonneg hne
    have hscaled_bound :
        ∀ N : ℕ,
          l ^ 2 * (∑ n ∈ Finset.range N, weight n) ≤ ‖(x₀ : H) - yFix‖ ^ 2 := by
      intro N
      have hterm :
          ∀ n ∈ Finset.range N,
            l ^ 2 * weight n ≤ weight n * residualNorm n ^ 2 := by
        intro n hn
        have hsq_nonneg : 0 ≤ residualNorm n := norm_nonneg (residual n)
        have hweight_n_nonneg : 0 ≤ weight n := hweight_nonneg n
        have hsquare : l ^ 2 ≤ residualNorm n ^ 2 := by
          nlinarith [hl_nonneg, hsq_nonneg, hl_le n]
        simpa [mul_comm, mul_left_comm, mul_assoc] using
          mul_le_mul_of_nonneg_left hsquare hweight_n_nonneg
      calc
        l ^ 2 * (∑ n ∈ Finset.range N, weight n) =
            ∑ n ∈ Finset.range N, (l ^ 2 * weight n) := by
              rw [Finset.mul_sum]
        _ ≤ ∑ n ∈ Finset.range N, weight n * residualNorm n ^ 2 := by
              exact Finset.sum_le_sum fun n hn ↦ hterm n hn
        _ ≤ ‖(x₀ : H) - yFix‖ ^ 2 := hbound N
    have hscaled :
        Tendsto (fun N ↦ l ^ 2 * (∑ n ∈ Finset.range N, weight n)) atTop atTop :=
      hdiv.const_mul_atTop (by positivity)
    rcases (hscaled.eventually_ge_atTop (‖(x₀ : H) - yFix‖ ^ 2 + 1)).exists with ⟨N, hN⟩
    have hN' := hscaled_bound N
    linarith
  have hnorm :
      Tendsto (fun n ↦ ‖residual n‖) atTop (𝓝 (0 : ℝ)) := by
    simpa [residualNorm, l, hl_eq_zero] using hlim'
  -- Norm convergence of the residuals is equivalent to strong convergence to `0`.
  simpa [residual] using (tendsto_zero_iff_norm_tendsto_zero).mpr hnorm

end

end Proposition516KM

namespace Proposition516WeakKM

section

variable {H : Type u} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
variable {D : Set H}

private lemma bounded_range_of_tendsto_toWeakSpace {x : ℕ → H} {y : H}
    (hy : Tendsto (fun n ↦ toWeakSpace ℝ H (x n)) atTop (𝓝 (toWeakSpace ℝ H y))) :
    Bornology.IsBounded (Set.range x) := by
  let T : ℕ → H →L[ℝ] ℝ := fun n ↦ InnerProductSpace.toDual ℝ H (x n)
  have hB_inj : Function.Injective ((topDualPairing ℝ H).flip) := by
    intro z w hzw
    by_contra hne
    obtain ⟨f, hf⟩ := SeparatingDual.exists_separating_of_ne (R := ℝ) hne
    exact hf (DFunLike.congr_fun hzw f)
  have hpointwise : ∀ u : H, ∃ C : ℝ, ∀ n : ℕ, ‖T n u‖ ≤ C := by
    intro u
    have hu_tendsto : Tendsto (fun n ↦ inner ℝ u (x n)) atTop (𝓝 (inner ℝ u y)) := by
      have hEval :=
        (WeakBilin.tendsto_iff_forall_eval_tendsto ((topDualPairing ℝ H).flip) hB_inj).1 hy
          (InnerProductSpace.toDual ℝ H u)
      simpa [LinearMap.flip_apply, topDualPairing_apply, toWeakSpace] using hEval
    have hu_bounded : Bornology.IsBounded (Set.range fun n ↦ inner ℝ u (x n)) :=
      Metric.isBounded_range_of_tendsto _ hu_tendsto
    rcases isBounded_iff_forall_norm_le.mp hu_bounded with ⟨C, hC⟩
    refine ⟨C, ?_⟩
    intro n
    have hCn : ‖inner ℝ u (x n)‖ ≤ C := hC _ (Set.mem_range_self n)
    simpa [T, InnerProductSpace.toDual_apply_apply, real_inner_comm] using hCn
  obtain ⟨C, hC⟩ := banach_steinhaus hpointwise
  rw [isBounded_iff_forall_norm_le]
  refine ⟨C, ?_⟩
  rintro z ⟨n, rfl⟩
  have hTn : ‖T n‖ ≤ C := hC n
  change ‖InnerProductSpace.toDual ℝ H (x n)‖ ≤ C at hTn
  rw [(InnerProductSpace.toDual ℝ H).norm_map] at hTn
  exact hTn

private lemma tendsto_inner_sub_right_zero {x : ℕ → H} {y v : H}
    (hy : Tendsto (fun n ↦ toWeakSpace ℝ H (x n)) atTop (𝓝 (toWeakSpace ℝ H y))) :
    Tendsto (fun n ↦ ⟪x n - y, v⟫_ℝ) atTop (𝓝 0) := by
  have hEval :=
    ((WeakBilin.eval_continuous ((topDualPairing ℝ H).flip)
      (InnerProductSpace.toDual ℝ H v)).tendsto (toWeakSpace ℝ H y)).comp hy
  have hEval' : Tendsto (fun n ↦ ⟪v, x n⟫_ℝ) atTop (𝓝 (⟪v, y⟫_ℝ)) := by
    simpa only [toWeakSpace, LinearEquiv.refl_apply, LinearMap.flip_apply,
      topDualPairing_apply, InnerProductSpace.toDual_apply_apply] using hEval
  have hsub :
      Tendsto (fun n ↦ ⟪v, x n⟫_ℝ - ⟪v, y⟫_ℝ) atTop (𝓝 (⟪v, y⟫_ℝ - ⟪v, y⟫_ℝ)) := by
    exact hEval'.sub
      (tendsto_const_nhds : Tendsto (fun _ : ℕ ↦ ⟪v, y⟫_ℝ) atTop (𝓝 ⟪v, y⟫_ℝ))
  simpa [inner_sub_right, real_inner_comm] using hsub

omit [CompleteSpace H] in
private lemma residual_difference_norm_sq_le_two_inner
    {T : D → H} (hT : LipschitzWith 1 T) {xSeq : ℕ → D} {x : D} :
    ∀ n,
      ‖(((xSeq n : H) - T (xSeq n)) - ((x : H) - T x))‖ ^ 2 ≤
        2 * ⟪(xSeq n : H) - (x : H), (((xSeq n : H) - T (xSeq n)) - ((x : H) - T x))⟫_ℝ := by
  intro n
  have hnonexp : ‖T (xSeq n) - T x‖ ≤ ‖(xSeq n : H) - (x : H)‖ := by
    simpa [dist_eq_norm, Subtype.dist_eq] using hT.dist_le_mul (xSeq n) x
  have hsq : ‖T (xSeq n) - T x‖ ^ 2 ≤ ‖(xSeq n : H) - (x : H)‖ ^ 2 := by
    nlinarith [hnonexp, norm_nonneg (T (xSeq n) - T x), norm_nonneg ((xSeq n : H) - (x : H))]
  have hrewrite :
      T (xSeq n) - T x =
        ((xSeq n : H) - (x : H)) - (((xSeq n : H) - T (xSeq n)) - ((x : H) - T x)) := by
    abel
  have hsq' :
      ‖((xSeq n : H) - (x : H)) - (((xSeq n : H) - T (xSeq n)) - ((x : H) - T x))‖ ^ 2 ≤
        ‖(xSeq n : H) - (x : H)‖ ^ 2 := by
    simpa [hrewrite] using hsq
  have hexp :=
    norm_sub_sq_real ((xSeq n : H) - (x : H))
      (((xSeq n : H) - T (xSeq n)) - ((x : H) - T x))
  nlinarith [hsq', hexp]

private lemma residual_difference_inner_tendsto_zero
    {T : D → H} {xSeq : ℕ → D} {x : D} {u : H}
    (hx : Tendsto (fun n ↦ toWeakSpace ℝ H (xSeq n : H)) atTop
      (𝓝 (toWeakSpace ℝ H (x : H))))
    (hu : Tendsto (fun n ↦ (xSeq n : H) - T (xSeq n)) atTop (𝓝 u)) :
    Tendsto
      (fun n ↦ ⟪(xSeq n : H) - (x : H),
        (((xSeq n : H) - T (xSeq n)) - ((x : H) - T x))⟫_ℝ)
      atTop (𝓝 0) := by
  have hbounded : Bornology.IsBounded (Set.range fun n ↦ (xSeq n : H)) :=
    bounded_range_of_tendsto_toWeakSpace hx
  rcases isBounded_iff_forall_norm_le.mp hbounded with ⟨C₀, hC₀⟩
  let C : ℝ := max C₀ 0 + ‖(x : H)‖
  have hC : ∀ n, ‖(xSeq n : H) - (x : H)‖ ≤ C := by
    intro n
    calc
      ‖(xSeq n : H) - (x : H)‖ ≤ ‖(xSeq n : H)‖ + ‖(x : H)‖ := norm_sub_le _ _
      _ ≤ max C₀ 0 + ‖(x : H)‖ := by
        exact add_le_add (le_trans (hC₀ _ (Set.mem_range_self n)) (le_max_left _ _)) le_rfl
      _ = C := rfl
  have hfixed :
      Tendsto (fun n ↦ ⟪(xSeq n : H) - (x : H), u - ((x : H) - T x)⟫_ℝ) atTop (𝓝 0) := by
    simpa only [sub_eq_add_neg] using tendsto_inner_sub_right_zero hx
  have hdiff : Tendsto (fun n ↦ (((xSeq n : H) - T (xSeq n)) - u)) atTop (𝓝 0) := by
    have hsub : Tendsto (fun n ↦ (((xSeq n : H) - T (xSeq n)) - u)) atTop (𝓝 (u - u)) := by
      exact hu.sub (tendsto_const_nhds : Tendsto (fun _ : ℕ ↦ u) atTop (𝓝 u))
    simpa using hsub
  have hnorm_diff : Tendsto (fun n ↦ ‖((xSeq n : H) - T (xSeq n)) - u‖) atTop (𝓝 0) := by
    simpa using hdiff.norm
  have hmul : Tendsto (fun n ↦ C * ‖((xSeq n : H) - T (xSeq n)) - u‖) atTop (𝓝 0) := by
    simpa using hnorm_diff.const_mul C
  have hsecond_abs :
      Tendsto (fun n ↦ |⟪(xSeq n : H) - (x : H), ((xSeq n : H) - T (xSeq n)) - u⟫_ℝ|) atTop
        (𝓝 0) := by
    refine squeeze_zero' (f := fun n ↦ |⟪(xSeq n : H) - (x : H), ((xSeq n : H) - T (xSeq n)) - u⟫_ℝ|)
      (g := fun n ↦ C * ‖((xSeq n : H) - T (xSeq n)) - u‖)
      (Eventually.of_forall fun n ↦ abs_nonneg _) ?_ ?_
    · filter_upwards with n
      exact le_trans (abs_real_inner_le_norm _ _)
        (mul_le_mul_of_nonneg_right (hC n) (norm_nonneg _))
    · simpa using hmul
  have hsecond :
      Tendsto (fun n ↦ ⟪(xSeq n : H) - (x : H), ((xSeq n : H) - T (xSeq n)) - u⟫_ℝ) atTop
        (𝓝 0) := by
    rw [tendsto_zero_iff_abs_tendsto_zero]
    simpa [Function.comp] using hsecond_abs
  have hsplit :
      (fun n ↦ ⟪(xSeq n : H) - (x : H),
        (((xSeq n : H) - T (xSeq n)) - ((x : H) - T x))⟫_ℝ) =
        fun n ↦
          ⟪(xSeq n : H) - (x : H), u - ((x : H) - T x)⟫_ℝ +
            ⟪(xSeq n : H) - (x : H), ((xSeq n : H) - T (xSeq n)) - u⟫_ℝ := by
    funext n
    rw [show (((xSeq n : H) - T (xSeq n)) - ((x : H) - T x)) =
        (u - ((x : H) - T x)) + (((xSeq n : H) - T (xSeq n)) - u) by abel,
      inner_add_right]
  rw [hsplit]
  simpa using hfixed.add hsecond

/-- Helper for Proposition 5.16: a weak limit of approximate fixed points of a nonexpansive map is
itself a fixed point. -/
private theorem map_eq_of_tendsto_weakly_of_residual_tendsto_zero_of_nonexpansive
    {T : D → H} (hT : LipschitzWith 1 T) {xₙ : ℕ → D} {x : D}
    (hweak : Tendsto (fun n ↦ toWeakSpace ℝ H (xₙ n : H)) atTop
      (𝓝 (toWeakSpace ℝ H (x : H))))
    (hres : Tendsto (fun n ↦ (xₙ n : H) - T (xₙ n)) atTop (𝓝 (0 : H))) :
    T x = (x : H) := by
  have hsq_left :
      Tendsto (fun n ↦ ‖(((xₙ n : H) - T (xₙ n)) - ((x : H) - T x))‖ ^ 2) atTop
        (𝓝 (‖(0 : H) - ((x : H) - T x)‖ ^ 2)) := by
    have hdiff :
        Tendsto (fun n ↦ (((xₙ n : H) - T (xₙ n)) - ((x : H) - T x))) atTop
          (𝓝 ((0 : H) - ((x : H) - T x))) := by
      exact hres.sub
        (tendsto_const_nhds : Tendsto (fun _ : ℕ ↦ (x : H) - T x) atTop (𝓝 ((x : H) - T x)))
    simpa using hdiff.norm.pow 2
  have hinner_zero :
      Tendsto
        (fun n ↦ ⟪(xₙ n : H) - (x : H), (((xₙ n : H) - T (xₙ n)) - ((x : H) - T x))⟫_ℝ)
        atTop (𝓝 0) :=
    residual_difference_inner_tendsto_zero hweak hres
  have hsq_right :
      Tendsto
        (fun n ↦ 2 * ⟪(xₙ n : H) - (x : H), (((xₙ n : H) - T (xₙ n)) - ((x : H) - T x))⟫_ℝ)
        atTop (𝓝 0) := by
    simpa using hinner_zero.const_mul 2
  have hnonpos : ‖(0 : H) - ((x : H) - T x)‖ ^ 2 ≤ 0 := by
    exact le_of_tendsto_of_tendsto hsq_left hsq_right <|
      Eventually.of_forall (residual_difference_norm_sq_le_two_inner hT)
  have hsq_zero : ‖(0 : H) - ((x : H) - T x)‖ ^ 2 = 0 := by
    exact le_antisymm hnonpos (sq_nonneg ‖(0 : H) - ((x : H) - T x)‖)
  have hnorm_zero : ‖(0 : H) - ((x : H) - T x)‖ = 0 := eq_zero_of_pow_eq_zero hsq_zero
  have hzero : (0 : H) - ((x : H) - T x) = 0 := norm_eq_zero.mp hnorm_zero
  have hx_residual : (x : H) - T x = (0 : H) := by
    have hx_residual_neg : -((x : H) - T x) = 0 := by
      simpa using hzero
    exact neg_eq_zero.mp hx_residual_neg
  exact (sub_eq_zero.mp hx_residual).symm

/-- Helper for Theorem 5.15: every weak sequential cluster point of a Krasnosel'skii-Mann orbit is
an ambient fixed point once the residuals tend to `0`. -/
private theorem weak_cluster_point_mem_fixedPoints_image_of_krasnoselskiiMann_residual
    (hD_closed : IsClosed D) (hD_convex : Convex ℝ D) {T : D → D} (hT : LipschitzWith 1 T)
    (relax : ℕ → ℝ) (hrelax : ∀ n, relax n ∈ Set.Icc (0 : ℝ) 1) (x₀ : D)
    (hres :
      Tendsto
        (fun n ↦
          (T (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n) : H) -
            (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n : H))
        atTop (𝓝 (0 : H)))
    {z : H}
    (hz :
      IsSequentialClusterPt
        (fun n ↦ toWeakSpace ℝ H (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n : H))
        (toWeakSpace ℝ H z)) :
    z ∈ Subtype.val '' fixedPoints T := by
  rcases hz.exists_subseq_tendsto with ⟨φ, hφ, hφz⟩
  have hzD : z ∈ D := by
    -- Closed convexity keeps the weak limit of a Krasnosel'skii-Mann subsequence inside `D`.
    have hD_weakClosed : IsClosed ((toWeakSpace ℝ H) '' D) :=
      (isClosed_iff_weak_image_isClosed_of_convex hD_convex).1 hD_closed
    have hzWeak :
        toWeakSpace ℝ H z ∈ closure ((toWeakSpace ℝ H) '' D) := by
      exact mem_closure_of_tendsto hφz <|
        Filter.Eventually.of_forall fun n ↦
          ⟨(krasnoselskiiMannIteration hD_convex T relax hrelax x₀ (φ n) : H),
            (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ (φ n)).2, rfl⟩
    rw [hD_weakClosed.closure_eq] at hzWeak
    rcases hzWeak with ⟨y, hyD, hyz⟩
    exact (toWeakSpace ℝ H).injective hyz ▸ hyD
  let zD : D := ⟨z, hzD⟩
  have hres_sub :
      Tendsto
        (fun n ↦
          (T (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ (φ n)) : H) -
            (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ (φ n) : H))
        atTop (𝓝 (0 : H)) := by
    -- Residual decay persists after passage to the convergent subsequence.
    exact hres.comp hφ.tendsto_atTop
  have hz_fixed : T zD = (z : H) := by
    -- Demiclosedness turns the weak limit of approximate fixed points into a fixed point.
    have hφz' :
        Tendsto
          (fun n ↦
            toWeakSpace ℝ H
              (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ (φ n) : H))
          atTop (𝓝 (toWeakSpace ℝ H (zD : H))) := by
      simpa [zD] using hφz
    have hres_sub' :
        Tendsto
          (fun n ↦
            (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ (φ n) : H) -
              (T (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ (φ n)) : H))
          atTop (𝓝 (0 : H)) := by
      simpa [sub_eq_add_neg, add_assoc, add_left_comm, add_comm] using hres_sub.neg
    simpa [zD] using
      map_eq_of_tendsto_weakly_of_residual_tendsto_zero_of_nonexpansive
        (xₙ := fun n ↦ krasnoselskiiMannIteration hD_convex T relax hrelax x₀ (φ n))
        (x := zD) hT hφz' hres_sub'
  refine ⟨zD, ?_, rfl⟩
  rw [Function.mem_fixedPoints_iff]
  exact Subtype.ext hz_fixed

-- Proof sketch: part (1) gives Fejér monotonicity of the Krasnosel'skii-Mann orbit with respect
-- to the ambient fixed-point set, and part (2) shows that the residuals tend strongly to `0`.
-- Corollary 4.28 identifies every weak sequential cluster point as a fixed point, and Theorem 5.5
-- then yields weak convergence to a point of `fixedPoints T`.
/-- Theorem 5.15 (3): if `D` is closed and convex, `T` is nonexpansive with a fixed point, and
`∑ λₙ (1 - λₙ) = +∞`, then the Krasnosel'skii-Mann iteration converges weakly to a fixed point of
`T`. -/
theorem krasnoselskiiMannIteration_tendsto_weakly_to_fixedPoint
    (hD_closed : IsClosed D) (hD_convex : Convex ℝ D) (T : D → D) (hT : LipschitzWith 1 T)
    (hfix : (fixedPoints T).Nonempty)
    (relax : ℕ → ℝ) (hrelax : ∀ n, relax n ∈ Set.Icc (0 : ℝ) 1)
    (hdiv :
      Tendsto (fun N ↦ (∑ n ∈ Finset.range N, relax n * (1 - relax n))) atTop atTop)
    (x₀ : D) :
    ∃ z ∈ fixedPoints T,
      Tendsto
        (fun n ↦ toWeakSpace ℝ H (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n : H))
        atTop (𝓝 (toWeakSpace ℝ H (z : H))) := by
  have hfejer :
      FejerMonotone (Subtype.val '' fixedPoints T)
        (fun n ↦ (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n : H)) :=
    krasnoselskiiMannIteration_fejerMonotone hD_convex T hT relax hrelax x₀
  have hres :
      Tendsto
        (fun n ↦
          (T (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n) : H) -
            (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n : H))
        atTop (𝓝 (0 : H)) :=
    krasnoselskiiMannIteration_residual_tendsto_zero
      hD_convex T hT hfix relax hrelax hdiv x₀
  have hfix_image : (Subtype.val '' fixedPoints T).Nonempty := by
    rcases hfix with ⟨z, hz⟩
    exact ⟨z, ⟨z, hz, rfl⟩⟩
  rcases
      tendsto_weakly_of_fejerMonotone_of_weakSequentialClusterPts_mem hfix_image
        (fun n ↦ (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n : H))
        hfejer
        (fun z hz ↦
          weak_cluster_point_mem_fixedPoints_image_of_krasnoselskiiMann_residual
            hD_closed hD_convex hT relax hrelax x₀ hres hz)
    with ⟨z, hz, hlim⟩
  rcases hz with ⟨zD, hzD, rfl⟩
  exact ⟨zD, hzD, hlim⟩

end

end Proposition516WeakKM

namespace Proposition516Relaxed

section

variable {H : Type u} [AddCommGroup H] [Module ℝ H]

/-- Helper for Proposition 5.16: the relaxed fixed-point iteration attached to a family of
operators `Tₙ`, relaxation parameters `λₙ`, and an initial point `x₀`. -/
def relaxedOperatorIteration (T : ℕ → H → H) (lam : ℕ → ℝ) (x0 : H) : ℕ → H
  | 0 => x0
  | n + 1 =>
      let xn := relaxedOperatorIteration T lam x0 n
      xn + lam n • (T n xn - xn)

-- Unfold the recursive definition at index `0`.
/-- Helper for Proposition 5.16: the relaxed iteration starts from the prescribed initial point
`x₀`. -/
@[simp] theorem relaxedOperatorIteration_zero
    (T : ℕ → H → H) (lam : ℕ → ℝ) (x0 : H) :
    relaxedOperatorIteration T lam x0 0 = x0 := by
  rfl

-- Unfold the recursive definition at the successor index `n + 1`.
/-- Helper for Proposition 5.16: the relaxed iteration satisfies the defining recursion
`xₙ₊₁ = xₙ + λₙ • (Tₙ xₙ - xₙ)`. -/
@[simp] theorem relaxedOperatorIteration_succ
    (T : ℕ → H → H) (lam : ℕ → ℝ) (x0 : H) (n : ℕ) :
    relaxedOperatorIteration T lam x0 (n + 1) =
      let xn := relaxedOperatorIteration T lam x0 n
      xn + lam n • (T n xn - xn) := by
  rfl

end

end Proposition516Relaxed

section

variable {H : Type u} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
variable {α : ℝ} {T : H → H}
variable (hT : AveragedWith α (fun x : (Set.univ : Set H) ↦ T x))
variable (lam : ℕ → ℝ) (hlam : ∀ n, lam n ∈ Set.Icc (0 : ℝ) (1 / α))

private noncomputable def averagedCompanion (α : ℝ) (T : H → H) : H → H :=
  fun x ↦ (1 - 1 / α) • x + (1 / α) • T x

private noncomputable def averagedCompanionSelfMap
    (α : ℝ) (T : H → H) : {x : H // x ∈ (Set.univ : Set H)} → {x : H // x ∈ (Set.univ : Set H)} :=
  fun x ↦ ⟨averagedCompanion α T x, by simp⟩

private def scaledRelaxation (α : ℝ) (lam : ℕ → ℝ) : ℕ → ℝ :=
  fun n ↦ α * lam n

/-- Helper for Proposition 5.16: the averaged companion recovers the nonexpansive witness from the
averaged decomposition. -/
private theorem averagedCompanionSelfMap_lipschitz
    (hT : AveragedWith α (fun x : (Set.univ : Set H) ↦ T x)) :
    LipschitzWith 1 (averagedCompanionSelfMap α T) := by
  let univPoint : H → {x : H // x ∈ (Set.univ : Set H)} := fun x ↦ ⟨x, Set.mem_univ x⟩
  have hα : α ∈ Set.Ioo (0 : ℝ) 1 := AveragedWith.mem_Ioo hT
  have hα0 : α ≠ 0 := ne_of_gt hα.1
  rcases hT with ⟨_, R, hR, hTR⟩
  have hcomp :
      (fun x : {x : H // x ∈ (Set.univ : Set H)} ↦ averagedCompanion α T x) = R := by
    ext x
    have hx := congrFun hTR x
    -- Rewriting the affine decomposition shows that the companion is exactly the witness `R`.
    calc
      averagedCompanion α T x
          = (1 - 1 / α) • (x : H) + (1 / α) • ((1 - α) • (x : H) + α • R x) := by
              dsimp [averagedCompanion]
              rw [hx]
      _ = (1 - 1 / α) • (x : H) +
            (((1 / α) * (1 - α)) • (x : H) + ((1 / α) * α) • R x) := by
              rw [smul_add, smul_smul, smul_smul]
      _ = ((1 - 1 / α) + (1 / α) * (1 - α)) • (x : H) + ((1 / α) * α) • R x := by
              rw [← add_assoc, ← add_smul]
      _ = R x := by
              have hleft : (1 - 1 / α) + (1 / α) * (1 - α) = 0 := by
                field_simp [hα0]
                ring
              have hright : (1 / α) * α = 1 := by
                field_simp [hα0]
              rw [hleft, hright]
              simp
  have hself :
      averagedCompanionSelfMap α T =
        fun x : {x : H // x ∈ (Set.univ : Set H)} ↦
          univPoint (R x) := by
    funext x
    exact Subtype.ext (congrArg (fun f ↦ f x) hcomp)
  -- The codomain subtype over `Set.univ` has the ambient metric, so the witness stays
  -- nonexpansive after repackaging it as a self-map.
  rw [hself]
  simpa [univPoint] using hR

/-- Helper for Proposition 5.16: the averaged companion displacement rescales to the original
residual. -/
private theorem smul_sub_averagedCompanion_eq_residual
    (hα0 : α ≠ 0) (x : H) :
    α • (averagedCompanion α T x - x) = T x - x := by
  -- Expanding the companion shows that the only remaining scalar on `x` is `-1`.
  dsimp [averagedCompanion]
  rw [smul_sub, smul_add, smul_smul, smul_smul]
  have hleft : α * (1 - 1 / α) = α - 1 := by
    field_simp [hα0]
  have hright : α * (1 / α) = 1 := by
    field_simp [hα0]
  rw [hleft, hright, one_smul]
  have hx : (α - 1) • x + -(α • x) = -x := by
    have hcoef : (α - 1) • x + -(α • x) = ((α - 1) + -α) • x := by
      simpa [neg_smul] using (add_smul (α - 1) (-α) x).symm
    rw [hcoef]
    ring_nf
    simp
  rw [sub_eq_add_neg, add_assoc, add_left_comm ((α - 1) • x)]
  rw [hx]
  simp [sub_eq_add_neg]

/-- Helper for Proposition 5.16: a point is fixed by the averaged companion exactly when it is
fixed by the original map. -/
private theorem averagedCompanion_eq_self_iff
    (hα0 : α ≠ 0) (x : H) :
    averagedCompanion α T x = x ↔ T x = x := by
  constructor
  · intro hx
    -- The residual identity turns a fixed point of the companion into a zero residual for `T`.
    have hres : T x - x = α • (averagedCompanion α T x - x) := by
      symm
      exact smul_sub_averagedCompanion_eq_residual (α := α) (T := T) hα0 x
    rw [hx, sub_self, smul_zero] at hres
    simpa [sub_eq_zero] using hres
  · intro hx
    -- Substituting `T x = x` collapses the affine combination back to `x`.
    calc
      averagedCompanion α T x = (1 - 1 / α) • x + (1 / α) • x := by
        dsimp [averagedCompanion]
        rw [hx]
      _ = ((1 - 1 / α) + 1 / α) • x := by rw [← add_smul]
      _ = x := by ring_nf; simp

private theorem scaledRelaxation_mem_Icc
    (α : ℝ) (lam : ℕ → ℝ)
    (hT : AveragedWith α (fun x : (Set.univ : Set H) ↦ T x))
    (hlam : ∀ n, lam n ∈ Set.Icc (0 : ℝ) (1 / α)) :
    ∀ n, scaledRelaxation α lam n ∈ Set.Icc (0 : ℝ) 1 := by
  have hα : α ∈ Set.Ioo (0 : ℝ) 1 := AveragedWith.mem_Ioo hT
  intro n
  rcases hlam n with ⟨hlnonneg, hlupper⟩
  constructor
  · -- Positivity of `α` keeps the rescaled parameter nonnegative.
    simpa [scaledRelaxation] using mul_nonneg hα.1.le hlnonneg
  · -- The upper bound `λₙ ≤ 1 / α` becomes `α λₙ ≤ 1`.
    have hbound : α * lam n ≤ α * (1 / α) := by
      exact mul_le_mul_of_nonneg_left hlupper hα.1.le
    have hinv : α * (1 / α) = 1 := by
      field_simp [ne_of_gt hα.1]
    calc
      scaledRelaxation α lam n = α * lam n := rfl
      _ ≤ α * (1 / α) := hbound
      _ = 1 := hinv

private theorem image_fixedPoints_averagedCompanionSelfMap_eq
    (hT : AveragedWith α (fun x : (Set.univ : Set H) ↦ T x)) :
    Subtype.val '' fixedPoints (averagedCompanionSelfMap α T) = fixedPoints T := by
  have hα0 : α ≠ 0 := ne_of_gt (AveragedWith.mem_Ioo hT).1
  ext y
  constructor
  · rintro ⟨x, hx, rfl⟩
    rw [Function.mem_fixedPoints_iff] at hx
    rw [Function.mem_fixedPoints_iff]
    -- Taking subtype values identifies the fixed-point equation with the ambient companion one.
    exact (averagedCompanion_eq_self_iff (α := α) (T := T) hα0 x).mp (congrArg Subtype.val hx)
  · intro hy
    rw [Function.mem_fixedPoints_iff] at hy
    refine ⟨⟨y, Set.mem_univ y⟩, ?_, rfl⟩
    rw [Function.mem_fixedPoints_iff]
    -- The converse direction repackages an ambient fixed point as a subtype fixed point.
    apply Subtype.ext
    exact (averagedCompanion_eq_self_iff (α := α) (T := T) hα0 y).mpr hy

/-- Helper for Proposition 5.16: rescaling `λₙ` to `μₙ = α λₙ` preserves the divergence
hypothesis from the source proof. -/
private theorem scaledRelaxation_divergence
    (hT : AveragedWith α (fun x : (Set.univ : Set H) ↦ T x))
    (hdiv :
      Tendsto
        (fun N ↦ Finset.sum (Finset.range N) (fun n ↦ lam n * (1 - α * lam n)))
        atTop atTop) :
    Tendsto
      (fun N ↦
        Finset.sum (Finset.range N)
          (fun n ↦ scaledRelaxation α lam n * (1 - scaledRelaxation α lam n)))
      atTop atTop := by
  have hα : 0 < α := (AveragedWith.mem_Ioo hT).1
  -- Each rescaled partial sum is just `α` times the original one.
  convert Tendsto.const_mul_atTop hα hdiv using 1
  ext N
  rw [Finset.mul_sum]
  refine Finset.sum_congr rfl ?_
  intro n hn
  simp [scaledRelaxation]
  ring

private theorem relaxedOperatorIteration_eq_krasnoselskiiMannIteration
    (x₀ : H) :
    relaxedOperatorIteration (fun _ ↦ T) lam x₀ =
      fun n ↦
        (krasnoselskiiMannIteration convex_univ
          (averagedCompanionSelfMap α T) (scaledRelaxation α lam)
          (scaledRelaxation_mem_Icc α lam hT hlam) ⟨x₀, by simp⟩ n : H) := by
  have hα0 : α ≠ 0 := ne_of_gt (AveragedWith.mem_Ioo hT).1
  let x₀u : {x : H // x ∈ (Set.univ : Set H)} := ⟨x₀, Set.mem_univ x₀⟩
  funext n
  induction n with
  | zero =>
      -- Both recursions start from the same initial point.
      simp
  | succ n ihn =>
      -- Route correction: rewrite the Krasnosel'skii-Mann successor in ambient form, then use
      -- the residual identity `α (R x - x) = T x - x`.
      rw [relaxedOperatorIteration_succ, krasnoselskiiMannIteration_succ]
      simp [ihn]
      let xₙ : H :=
        (krasnoselskiiMannIteration convex_univ
          (averagedCompanionSelfMap α T) (scaledRelaxation α lam)
          (scaledRelaxation_mem_Icc α lam hT hlam) x₀u n : H)
      change
        lam n • (T xₙ - xₙ) =
          scaledRelaxation α lam n • (averagedCompanion α T xₙ - xₙ)
      calc
        lam n • (T xₙ - xₙ) = lam n • (α • (averagedCompanion α T xₙ - xₙ)) := by
          rw [smul_sub_averagedCompanion_eq_residual (α := α) (T := T) hα0 xₙ]
        _ = scaledRelaxation α lam n • (averagedCompanion α T xₙ - xₙ) := by
          simp [scaledRelaxation, smul_smul, mul_comm]

-- Proof sketch: bridge the relaxed iteration to the Krasnosel'skii-Mann iteration of the
-- averaged companion `R = (1 - 1 / α) Id + (1 / α) T`, whose fixed points agree with those of
-- `T`. Proposition 4.35 makes `R` nonexpansive, the rescaled parameters `μₙ = α λₙ` lie in
-- `[0, 1]`, and Theorem 5.15(1) then yields the Fejér monotonicity.
include hT hlam

/-- Proposition 5.16 (1): (i) for an `α`-averaged operator on a real Hilbert space, the relaxed
iteration `xₙ₊₁ = xₙ + λₙ • (T xₙ - xₙ)` is Fejér monotone with respect to `Fix T`. -/
theorem fejerMonotone_fixedPoints_of_relaxedOperatorIteration_of_averagedWith
    (x₀ : H) :
    FejerMonotone (fixedPoints T)
      (relaxedOperatorIteration (fun _ ↦ T) lam x₀) := by
  let x₀u : {x : H // x ∈ (Set.univ : Set H)} := ⟨x₀, Set.mem_univ x₀⟩
  let KM : ℕ → {x : H // x ∈ (Set.univ : Set H)} :=
    krasnoselskiiMannIteration convex_univ
      (averagedCompanionSelfMap α T) (scaledRelaxation α lam)
      (scaledRelaxation_mem_Icc α lam hT hlam) x₀u
  have hKM :=
    krasnoselskiiMannIteration_fejerMonotone convex_univ
      (averagedCompanionSelfMap α T) (averagedCompanionSelfMap_lipschitz (α := α) (T := T) hT)
      (scaledRelaxation α lam) (scaledRelaxation_mem_Icc α lam hT hlam) x₀u
  have hFejKM :
      FejerMonotone (fixedPoints T) (fun n ↦ (KM n : H)) := by
    -- First transport Theorem 5.15(1) along the fixed-point identification.
    simpa [KM, image_fixedPoints_averagedCompanionSelfMap_eq (α := α) (T := T) hT] using hKM
  -- Then rewrite the `KM` orbit back to the original relaxed iteration.
  simpa [KM, relaxedOperatorIteration_eq_krasnoselskiiMannIteration
      (hT := hT) (lam := lam) (hlam := hlam) x₀] using hFejKM

-- Proof sketch: after the same bridge to the Krasnosel'skii-Mann iteration of `R`, the
-- divergence hypothesis becomes `∑ μₙ (1 - μₙ) = +∞` for `μₙ = α λₙ`. Theorem 5.15(2) gives
-- `R xₙ - xₙ → 0`, and `α • (R xₙ - xₙ) = T xₙ - xₙ` identifies this with asymptotic regularity
-- of the relaxed iteration for `T`.
/-- Proposition 5.16 (2): (ii) if `Fix T` is nonempty and
`∑ λₙ (1 - α λₙ) = +∞`, then the residuals `T xₙ - xₙ` of the relaxed iteration converge
strongly to `0`. -/
theorem residual_tendsto_zero_of_relaxedOperatorIteration_of_averagedWith
    (hFix : (fixedPoints T).Nonempty)
    (hdiv :
      Tendsto
        (fun N ↦ Finset.sum (Finset.range N) (fun n ↦ lam n * (1 - α * lam n)))
        atTop atTop)
    (x₀ : H) :
    Tendsto
      (fun n ↦
        T (relaxedOperatorIteration (fun _ ↦ T) lam x₀ n) -
          relaxedOperatorIteration (fun _ ↦ T) lam x₀ n)
      atTop (𝓝 (0 : H)) := by
  let x₀u : {x : H // x ∈ (Set.univ : Set H)} := ⟨x₀, Set.mem_univ x₀⟩
  have hα0 : α ≠ 0 := ne_of_gt (AveragedWith.mem_Ioo hT).1
  rcases hFix with ⟨z, hz⟩
  have hzComp : ⟨z, Set.mem_univ z⟩ ∈ fixedPoints (averagedCompanionSelfMap α T) := by
    rw [Function.mem_fixedPoints_iff]
    apply Subtype.ext
    rw [Function.mem_fixedPoints_iff] at hz
    exact (averagedCompanion_eq_self_iff (α := α) (T := T) hα0 z).mpr hz
  have hKM :=
    krasnoselskiiMannIteration_residual_tendsto_zero convex_univ
      (averagedCompanionSelfMap α T) (averagedCompanionSelfMap_lipschitz (α := α) (T := T) hT)
      ⟨⟨z, Set.mem_univ z⟩, hzComp⟩
      (scaledRelaxation α lam) (scaledRelaxation_mem_Icc α lam hT hlam)
      (scaledRelaxation_divergence (α := α) (lam := lam) hT hdiv) x₀u
  let KM : ℕ → {x : H // x ∈ (Set.univ : Set H)} :=
    krasnoselskiiMannIteration convex_univ
      (averagedCompanionSelfMap α T) (scaledRelaxation α lam)
      (scaledRelaxation_mem_Icc α lam hT hlam) x₀u
  have hScaled :
      Tendsto
        (fun n ↦
          α • (((averagedCompanionSelfMap α T) (KM n) : H) - (KM n : H)))
        atTop (𝓝 (0 : H)) := by
    simpa [KM] using hKM.const_smul α
  have hResidualKM :
      Tendsto (fun n ↦ T (KM n : H) - (KM n : H)) atTop (𝓝 (0 : H)) := by
    -- The residual identity converts the companion residual into the original residual.
    simpa [KM, averagedCompanionSelfMap,
      smul_sub_averagedCompanion_eq_residual (α := α) (T := T) hα0] using hScaled
  -- The residual identity converts the Krasnosel'skii-Mann residual back to `T xₙ - xₙ`.
  simpa [KM, relaxedOperatorIteration_eq_krasnoselskiiMannIteration
      (hT := hT) (lam := lam) (hlam := hlam) x₀] using hResidualKM

omit hT hlam

end

section

variable {H : Type u} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
variable {α : ℝ} {T : H → H}
variable (hT : AveragedWith α (fun x : (Set.univ : Set H) ↦ T x))
variable (lam : ℕ → ℝ) (hlam : ∀ n, lam n ∈ Set.Icc (0 : ℝ) (1 / α))

-- Proof sketch: part (1) gives Fejér monotonicity of the relaxed orbit with respect to
-- `fixedPoints T`, and part (2) gives asymptotic regularity. The same companion-map bridge
-- identifies weak sequential cluster points with those of the Krasnosel'skii-Mann iteration of
-- `R`, so Corollary 4.28 and Theorem 5.15(3) yield weak convergence to a point of `Fix T`.
include hT hlam

/-- Proposition 5.16 (3): (iii) if `Fix T` is nonempty and
`∑ λₙ (1 - α λₙ) = +∞`, then the relaxed iteration converges weakly to a point of `Fix T`. -/
theorem exists_tendsto_weakly_to_fixedPoint_of_relaxedOperatorIteration_of_averagedWith
    (hFix : (fixedPoints T).Nonempty)
    (hdiv :
      Tendsto
        (fun N ↦ Finset.sum (Finset.range N) (fun n ↦ lam n * (1 - α * lam n)))
        atTop atTop)
    (x₀ : H) :
    ∃ z ∈ fixedPoints T,
      Tendsto
        (fun n ↦ toWeakSpace ℝ H (relaxedOperatorIteration (fun _ ↦ T) lam x₀ n))
        atTop (𝓝 (toWeakSpace ℝ H z)) := by
  let x₀u : {x : H // x ∈ (Set.univ : Set H)} := ⟨x₀, Set.mem_univ x₀⟩
  have hα0 : α ≠ 0 := ne_of_gt (AveragedWith.mem_Ioo hT).1
  rcases hFix with ⟨z, hz⟩
  let KM : ℕ → {x : H // x ∈ (Set.univ : Set H)} :=
    krasnoselskiiMannIteration convex_univ
      (averagedCompanionSelfMap α T) (scaledRelaxation α lam)
      (scaledRelaxation_mem_Icc α lam hT hlam) x₀u
  have hzComp : ⟨z, Set.mem_univ z⟩ ∈ fixedPoints (averagedCompanionSelfMap α T) := by
    rw [Function.mem_fixedPoints_iff]
    apply Subtype.ext
    rw [Function.mem_fixedPoints_iff] at hz
    exact (averagedCompanion_eq_self_iff (α := α) (T := T) hα0 z).mpr hz
  rcases
      krasnoselskiiMannIteration_tendsto_weakly_to_fixedPoint isClosed_univ convex_univ
        (averagedCompanionSelfMap α T) (averagedCompanionSelfMap_lipschitz (α := α) (T := T) hT)
        ⟨⟨z, Set.mem_univ z⟩, hzComp⟩
        (scaledRelaxation α lam) (scaledRelaxation_mem_Icc α lam hT hlam)
        (scaledRelaxation_divergence (α := α) (lam := lam) hT hdiv) x₀u
    with ⟨w, hw, hlim⟩
  have hwT : (w : H) ∈ fixedPoints T := by
    rw [Function.mem_fixedPoints_iff]
    rw [Function.mem_fixedPoints_iff] at hw
    exact (averagedCompanion_eq_self_iff (α := α) (T := T) hα0 (w : H)).mp
      (congrArg Subtype.val hw)
  refine ⟨w, hwT, ?_⟩
  -- The same orbit bridge transports weak convergence from the companion iteration back to the
  -- original relaxed iteration.
  simpa [KM, relaxedOperatorIteration_eq_krasnoselskiiMannIteration
      (hT := hT) (lam := lam) (hlam := hlam) x₀] using hlim

omit hT hlam

end
