variable {H : Type u} [AddCommGroup H] [Module ℝ H]
variable {D : Set H}

-- Proof sketch: unfold the recursive definition at `n + 1` and rewrite the affine combination
-- `(1 - λ n) • xₙ + λ n • T xₙ` as `xₙ + λ n • (T xₙ - xₙ)`.
/-- The ambient-value recursion for the Krasnosel'skii-Mann iteration is the textbook formula
`xₙ₊₁ = xₙ + λₙ (T xₙ - xₙ)`. -/
@[simp]
theorem krasnoselskiiMannIteration_succ
    (hD_convex : Convex ℝ D) (T : D → D) (relax : ℕ → ℝ)
    (hrelax : ∀ n, relax n ∈ Set.Icc (0 : ℝ) 1) (x₀ : D) (n : ℕ) :
    (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ (n + 1) : H) =
      (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n : H) +
        relax n •
          ((T (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n) : H) -
            (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n : H)) := by
  -- Unfold the subtype-valued step and rewrite the affine combination into textbook residual form.
  let xn := krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n
  calc
    (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ (n + 1) : H) =
        (1 - relax n) • (xn : H) + relax n • (T xn : H) := by
          simp [krasnoselskiiMannIteration, xn]
    _ = (xn : H) + relax n • ((T xn : H) - (xn : H)) := by
          rw [smul_sub]
          rw [sub_smul, one_smul]
          abel_nf

/-- Helper for Theorem 5.15: subtracting an ambient point from one Krasnosel'skii-Mann step
rewrites the result as the corresponding affine combination of error vectors. -/
private theorem krasnoselskiiMannIteration_sub_eq_affineCombination
    (hD_convex : Convex ℝ D) (T : D → D) (relax : ℕ → ℝ)
    (hrelax : ∀ n, relax n ∈ Set.Icc (0 : ℝ) 1) (x₀ : D) (y : H) (n : ℕ) :
    (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ (n + 1) : H) - y =
      (1 - relax n) •
          ((krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n : H) - y) +
        relax n •
          ((T (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n) : H) - y) := by
  -- Distribute subtraction across the affine step and collect the like terms.
  let xn := krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n
  have hy :
      -y = -((1 - relax n) • y) + -(relax n • y) := by
    calc
      -y = -(((1 - relax n) + relax n) • y) := by
        congr 1
        ring_nf
        simp
      _ = -((1 - relax n) • y + relax n • y) := by
        rw [← add_smul]
      _ = -((1 - relax n) • y) + -(relax n • y) := by
        abel_nf
  calc
    (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ (n + 1) : H) - y =
        ((1 - relax n) • (xn : H) + relax n • (T xn : H)) - y := by
          simp [krasnoselskiiMannIteration, xn]
    _ = ((1 - relax n) • (xn : H) + relax n • (T xn : H)) +
          (-((1 - relax n) • y) + -(relax n • y)) := by
          rw [sub_eq_add_neg, hy]
    _ = (1 - relax n) • ((xn : H) - y) + relax n • ((T xn : H) - y) := by
          rw [show (xn : H) - y = (xn : H) + -y by rw [sub_eq_add_neg]]
          rw [show (T xn : H) - y = (T xn : H) + -y by rw [sub_eq_add_neg]]
          rw [smul_add, smul_add]
          have h₁ : -((1 - relax n) • y) = (1 - relax n) • (-y) := by
            simp [smul_neg]
          have h₂ : -(relax n • y) = relax n • (-y) := by
            simp [smul_neg]
          rw [h₁, h₂]
          abel_nf

/-- Helper for Theorem 5.15: consecutive Krasnosel'skii-Mann iterates differ by the relaxed
residual. -/
private theorem krasnoselskiiMannIteration_sub_eq_relax_residual
    (hD_convex : Convex ℝ D) (T : D → D) (relax : ℕ → ℝ)
    (hrelax : ∀ n, relax n ∈ Set.Icc (0 : ℝ) 1) (x₀ : D) (n : ℕ) :
    (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ (n + 1) : H) -
        (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n : H) =
      relax n •
        ((T (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n) : H) -
          (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n : H)) := by
  -- The successor formula already has the desired increment after moving `xₙ` to the left.
  let xn := krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n
  calc
    (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ (n + 1) : H) -
        (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n : H) =
      ((xn : H) + relax n • ((T xn : H) - (xn : H))) - (xn : H) := by
        rw [krasnoselskiiMannIteration_succ]
    _ = relax n • ((T xn : H) - (xn : H)) := by
        abel_nf

end

