variable {H : Type u} [AddCommGroup H] [Module ℝ H]

/-- Helper for Corollary 5.17: the relaxed fixed-point iteration attached to a family of
operators `Tₙ`, relaxation parameters `λₙ`, and an initial point `x₀`. -/
def relaxedOperatorIteration (T : ℕ → H → H) (lam : ℕ → ℝ) (x0 : H) : ℕ → H
  | 0 => x0
  | n + 1 =>
      let xn := relaxedOperatorIteration T lam x0 n
      xn + lam n • (T n xn - xn)

-- Unfold the recursive definition at index `0`.
/-- Helper for Corollary 5.17: the relaxed iteration starts from the prescribed initial point
`x₀`. -/
@[simp] theorem relaxedOperatorIteration_zero
    (T : ℕ → H → H) (lam : ℕ → ℝ) (x0 : H) :
    relaxedOperatorIteration T lam x0 0 = x0 := by
  -- The recursion is defined to start at `x₀`.
  rfl

-- Unfold the recursive definition at the successor index `n + 1`.
/-- Helper for Corollary 5.17: the relaxed iteration satisfies the defining recursion
`xₙ₊₁ = xₙ + λₙ • (Tₙ xₙ - xₙ)`. -/
@[simp] theorem relaxedOperatorIteration_succ
    (T : ℕ → H → H) (lam : ℕ → ℝ) (x0 : H) (n : ℕ) :
    relaxedOperatorIteration T lam x0 (n + 1) =
      let xn := relaxedOperatorIteration T lam x0 n
      xn + lam n • (T n xn - xn) := by
  -- The successor clause is exactly the recursive definition.
  rfl

end

