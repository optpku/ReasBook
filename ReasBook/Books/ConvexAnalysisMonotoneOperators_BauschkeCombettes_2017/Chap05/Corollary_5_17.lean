variable {H : Type u} [AddCommGroup H] [Module ℝ H]
variable {D : Set H}

-- Proof sketch: write the next step as the convex combination
-- `(1 - λ n) • x + λ n • T x`; since both endpoints lie in `D` and `λ n ∈ [0, 1]`, convexity of
-- `D` keeps the step inside `D`.
/-- Helper for Corollary 5.17: the Krasnosel'skii-Mann step stays in a convex set when the
relaxation parameter lies in `[0, 1]`. -/
private theorem krasnoselskiiMannStep_mem
    (hD_convex : Convex ℝ D) (T : D → D) (relax : ℕ → ℝ)
    (hrelax : ∀ n, relax n ∈ Set.Icc (0 : ℝ) 1) (x : D) (n : ℕ) :
    (1 - relax n) • (x : H) + relax n • (T x : H) ∈ D := by
  -- Realize the next iterate as the standard line-map point between `x` and `T x`.
  have hline : AffineMap.lineMap (x : H) (T x : H) (relax n) ∈ D :=
    hD_convex.lineMap_mem x.2 (T x).2 (hrelax n)
  simpa [AffineMap.lineMap_apply, sub_eq_add_neg, smul_sub, add_smul, one_smul, add_assoc,
    add_left_comm, add_comm] using hline

/-- Helper for Corollary 5.17: the Krasnosel'skii-Mann iteration on `D` generated by a self-map
`T`, relaxation parameters `λ`, and an initial point `x₀`. -/
def krasnoselskiiMannIteration
    (hD_convex : Convex ℝ D) (T : D → D) (relax : ℕ → ℝ)
    (hrelax : ∀ n, relax n ∈ Set.Icc (0 : ℝ) 1) (x₀ : D) : ℕ → D
  | 0 => x₀
  | n + 1 =>
      let xₙ := krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n
      ⟨(1 - relax n) • (xₙ : H) + relax n • (T xₙ : H),
        krasnoselskiiMannStep_mem hD_convex T relax hrelax xₙ n⟩

-- Proof sketch: unfold the recursive definition at index `0`.
/-- Helper for Corollary 5.17: the Krasnosel'skii-Mann iteration starts at the prescribed initial
point. -/
@[simp] theorem krasnoselskiiMannIteration_zero
    (hD_convex : Convex ℝ D) (T : D → D) (relax : ℕ → ℝ)
    (hrelax : ∀ n, relax n ∈ Set.Icc (0 : ℝ) 1) (x₀ : D) :
    krasnoselskiiMannIteration hD_convex T relax hrelax x₀ 0 = x₀ := by
  -- The recursive orbit starts at `x₀` by definition.
  rfl

end

section

variable {H : Type u} [AddCommGroup H] [Module ℝ H]
variable {D : Set H}

-- Proof sketch: unfold the recursive definition at `n + 1` and rewrite the affine combination
-- `(1 - λ n) • xₙ + λ n • T xₙ` as `xₙ + λ n • (T xₙ - xₙ)`.
/-- Helper for Corollary 5.17: the ambient-value recursion for the Krasnosel'skii-Mann iteration
is the textbook formula `xₙ₊₁ = xₙ + λₙ (T xₙ - xₙ)`. -/
@[simp] theorem krasnoselskiiMannIteration_succ
    (hD_convex : Convex ℝ D) (T : D → D) (relax : ℕ → ℝ)
    (hrelax : ∀ n, relax n ∈ Set.Icc (0 : ℝ) 1) (x₀ : D) (n : ℕ) :
    (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ (n + 1) : H) =
      (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n : H) +
        relax n •
          ((T (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n) : H) -
            (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n : H)) := by
  -- Unfold the subtype-valued step and rewrite the affine combination into residual form.
  let xn := krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n
  calc
    (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ (n + 1) : H) =
        (1 - relax n) • (xn : H) + relax n • (T xn : H) := by
          simp [krasnoselskiiMannIteration, xn]
    _ = (xn : H) + relax n • ((T xn : H) - (xn : H)) := by
          rw [smul_sub]
          rw [sub_smul, one_smul]
          abel_nf

/-- Helper for Corollary 5.17: subtracting an ambient point from one Krasnosel'skii-Mann step
rewrites the result as the corresponding affine combination of error vectors. -/
private theorem krasnoselskiiMannIteration_sub_eq_affineCombination
    (hD_convex : Convex ℝ D) (T : D → D) (relax : ℕ → ℝ)
    (hrelax : ∀ n, relax n ∈ Set.Icc (0 : ℝ) 1) (x₀ : D) (y : H) (n : ℕ) :
    (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ (n + 1) : H) - y =
      (1 - relax n) •
          ((krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n : H) - y) +
        relax n •
          ((T (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n) : H) - y) := by
  -- Distribute subtraction across the affine step and collect the like terms.
  let xn := krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n
  have hrelax_rewrite :
      relax n • ((T xn : H) - (xn : H)) =
        -(relax n • ((xn : H) - y)) + relax n • ((T xn : H) - y) := by
    have hsub :
        ((T xn : H) - y) - ((xn : H) - y) = (T xn : H) - (xn : H) := by
      abel_nf
    calc
      relax n • ((T xn : H) - (xn : H)) =
          relax n • (((T xn : H) - y) - ((xn : H) - y)) := by rw [hsub]
      _ = relax n • ((T xn : H) - y) - relax n • ((xn : H) - y) := by
            rw [smul_sub]
      _ = -(relax n • ((xn : H) - y)) + relax n • ((T xn : H) - y) := by
            abel_nf
  calc
    (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ (n + 1) : H) - y =
        ((xn : H) + relax n • ((T xn : H) - (xn : H))) - y := by
          rw [krasnoselskiiMannIteration_succ]
    _ = ((xn : H) - y) + relax n • ((T xn : H) - (xn : H)) := by
          abel_nf
    _ = ((xn : H) - y) + (-(relax n • ((xn : H) - y)) + relax n • ((T xn : H) - y)) := by
          rw [hrelax_rewrite]
    _ = (1 - relax n) • ((xn : H) - y) + relax n • ((T xn : H) - y) := by
      have hu :
          ((xn : H) - y) + -(relax n • ((xn : H) - y)) =
            (1 - relax n) • ((xn : H) - y) := by
          rw [sub_smul, one_smul]
          abel_nf
      calc
        ((xn : H) - y) + (-(relax n • ((xn : H) - y)) + relax n • ((T xn : H) - y)) =
            (((xn : H) - y) + -(relax n • ((xn : H) - y))) +
              relax n • ((T xn : H) - y) := by
                abel_nf
        _ = (1 - relax n) • ((xn : H) - y) + relax n • ((T xn : H) - y) := by
              rw [hu]

/-- Helper for Corollary 5.17: consecutive Krasnosel'skii-Mann iterates differ by the relaxed
residual. -/
private theorem krasnoselskiiMannIteration_sub_eq_relax_residual
    (hD_convex : Convex ℝ D) (T : D → D) (relax : ℕ → ℝ)
    (hrelax : ∀ n, relax n ∈ Set.Icc (0 : ℝ) 1) (x₀ : D) (n : ℕ) :
    (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ (n + 1) : H) -
        (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n : H) =
      relax n •
        ((T (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n) : H) -
          (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n : H)) := by
  -- The successor formula already has the desired increment after moving `xₙ` to the left.
  let xn := krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n
  calc
    (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ (n + 1) : H) -
        (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n : H) =
      ((xn : H) + relax n • ((T xn : H) - (xn : H))) - (xn : H) := by
        rw [krasnoselskiiMannIteration_succ]
    _ = relax n • ((T xn : H) - (xn : H)) := by
        abel_nf

end

end Corollary517KM

