variable {H : Type u} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
variable {D : Set H}

/-- Helper for Corollary 5.17: the squared norm of an affine combination plus the weighted squared
gap equals the corresponding affine combination of squared norms. -/
private theorem weighted_affine_norm_sq_identity (u v : H) (α : ℝ) :
    ‖α • u + (1 - α) • v‖ ^ 2 + α * (1 - α) * ‖u - v‖ ^ 2 =
      α * ‖u‖ ^ 2 + (1 - α) * ‖v‖ ^ 2 := by
  -- Expand both squared norms by the real inner-product identities and normalize coefficients.
  rw [norm_add_sq_real, norm_sub_sq_real, norm_smul, norm_smul, Real.norm_eq_abs,
    Real.norm_eq_abs]
  simp [real_inner_smul_left, real_inner_smul_right]
  nlinarith [sq_abs α, sq_abs (1 - α)]

/-- Helper for Corollary 5.17: one Krasnosel'skii-Mann step satisfies the textbook energy
inequality with respect to every fixed point of `T`. -/
private theorem krasnoselskiiMann_sqdist_step_le_sqdist_of_fixedPoint
    (hD_convex : Convex ℝ D) (T : D → D) (hT : LipschitzWith 1 T)
    (relax : ℕ → ℝ) (hrelax : ∀ n, relax n ∈ Set.Icc (0 : ℝ) 1) (x₀ : D)
    (y : fixedPoints T) (n : ℕ) :
    ‖(krasnoselskiiMannIteration hD_convex T relax hrelax x₀ (n + 1) : H) - y‖ ^ 2 ≤
      ‖(krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n : H) - y‖ ^ 2 -
        relax n * (1 - relax n) *
          ‖(T (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n) : H) -
              (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n : H)‖ ^ 2 := by
  let xn := krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n
  have hyfix : T y = y := Function.mem_fixedPoints_iff.mp y.2
  have hnonexp :
      ‖(T xn : H) - y‖ ≤ ‖(xn : H) - y‖ := by
    simpa [Subtype.dist_eq, dist_eq_norm, hyfix, one_mul, xn] using hT.dist_le_mul xn y
  have hnonexp_sq : ‖(T xn : H) - y‖ ^ 2 ≤ ‖(xn : H) - y‖ ^ 2 := by
    nlinarith [hnonexp, norm_nonneg ((T xn : H) - y), norm_nonneg ((xn : H) - y)]
  have hidentity :=
    weighted_affine_norm_sq_identity ((T xn : H) - y) ((xn : H) - y) (relax n)
  have hrewrite :
      (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ (n + 1) : H) - y =
        relax n • ((T xn : H) - y) + (1 - relax n) • ((xn : H) - y) := by
    simpa [add_comm] using
      krasnoselskiiMannIteration_sub_eq_affineCombination hD_convex T relax hrelax x₀ (y : H) n
  have hresidual :
      ((T xn : H) - y) - ((xn : H) - y) = (T xn : H) - (xn : H) := by
    abel_nf
  have hstep :
      ‖(krasnoselskiiMannIteration hD_convex T relax hrelax x₀ (n + 1) : H) - y‖ ^ 2 +
          relax n * (1 - relax n) *
            ‖(T xn : H) - (xn : H)‖ ^ 2 ≤
        ‖(xn : H) - y‖ ^ 2 := by
    -- Compare the affine-combination identity with nonexpansiveness at the fixed point `y`.
    calc
      ‖(krasnoselskiiMannIteration hD_convex T relax hrelax x₀ (n + 1) : H) - y‖ ^ 2 +
          relax n * (1 - relax n) * ‖(T xn : H) - (xn : H)‖ ^ 2 =
        relax n * ‖(T xn : H) - y‖ ^ 2 + (1 - relax n) * ‖(xn : H) - y‖ ^ 2 := by
          rw [hrewrite]
          simpa [hresidual] using hidentity
      _ ≤ ‖(xn : H) - y‖ ^ 2 := by
          have hrelax_nonneg : 0 ≤ relax n := (hrelax n).1
          have hrelax_le_one : relax n ≤ 1 := (hrelax n).2
          nlinarith
  have hweight_nonneg :
      0 ≤ relax n * (1 - relax n) *
        ‖(T xn : H) - (xn : H)‖ ^ 2 := by
    have hrelax_nonneg : 0 ≤ relax n := (hrelax n).1
    have hone_sub_nonneg : 0 ≤ 1 - relax n := sub_nonneg.mpr (hrelax n).2
    positivity
  -- Discard the nonnegative residual term from the left-hand side.
  nlinarith

/-- Helper for Corollary 5.17: the partial residual energy plus the current squared distance to a
fixed point stays below the initial squared distance. -/
private theorem krasnoselskiiMann_sqdist_add_weighted_partial_sum_le_sqdist_of_fixedPoint
    (hD_convex : Convex ℝ D) (T : D → D) (hT : LipschitzWith 1 T)
    (relax : ℕ → ℝ) (hrelax : ∀ n, relax n ∈ Set.Icc (0 : ℝ) 1) (x₀ : D)
    (y : fixedPoints T) :
    ∀ N : ℕ,
      ‖(krasnoselskiiMannIteration hD_convex T relax hrelax x₀ N : H) - y‖ ^ 2 +
          ∑ n ∈ Finset.range N,
            relax n * (1 - relax n) *
              ‖(T (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n) : H) -
                  (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n : H)‖ ^ 2 ≤
        ‖(x₀ : H) - y‖ ^ 2 := by
  intro N
  induction N with
  | zero =>
      -- The empty partial sum leaves only the initial squared distance.
      simp
  | succ N ih =>
      have hstep :=
        krasnoselskiiMann_sqdist_step_le_sqdist_of_fixedPoint
          hD_convex T hT relax hrelax x₀ y N
      -- Telescope the one-step inequality with the induction hypothesis.
      rw [Finset.sum_range_succ]
      nlinarith [ih, hstep]

/-- Helper for Corollary 5.17: every weighted partial sum of squared residuals is bounded by the
initial squared distance to a fixed point. -/
private theorem krasnoselskiiMann_residual_weighted_partial_sum_le_sqdist_of_fixedPoint
    (hD_convex : Convex ℝ D) (T : D → D) (hT : LipschitzWith 1 T)
    (relax : ℕ → ℝ) (hrelax : ∀ n, relax n ∈ Set.Icc (0 : ℝ) 1) (x₀ : D)
    (y : fixedPoints T) (N : ℕ) :
    ∑ n ∈ Finset.range N,
      relax n * (1 - relax n) *
        ‖(T (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n) : H) -
            (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n : H)‖ ^ 2 ≤
      ‖(x₀ : H) - y‖ ^ 2 := by
  have hbound :=
    krasnoselskiiMann_sqdist_add_weighted_partial_sum_le_sqdist_of_fixedPoint
      hD_convex T hT relax hrelax x₀ y N
  have hsq_nonneg :
      0 ≤ ‖(krasnoselskiiMannIteration hD_convex T relax hrelax x₀ N : H) - y‖ ^ 2 := by
    positivity
  -- Drop the nonnegative squared-distance term from the stronger telescoping bound.
  nlinarith

/-- Helper for Corollary 5.17: the norms of the Krasnosel'skii-Mann residuals form an antitone
sequence. -/
private theorem krasnoselskiiMann_residual_norm_antitone
    (hD_convex : Convex ℝ D) (T : D → D) (hT : LipschitzWith 1 T)
    (relax : ℕ → ℝ) (hrelax : ∀ n, relax n ∈ Set.Icc (0 : ℝ) 1) (x₀ : D) (n : ℕ) :
    ‖(T (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ (n + 1)) : H) -
        (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ (n + 1) : H)‖ ≤
      ‖(T (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n) : H) -
          (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n : H)‖ := by
  let xn := krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n
  let xn1 := krasnoselskiiMannIteration hD_convex T relax hrelax x₀ (n + 1)
  have hdist :
      ‖(T xn1 : H) - T xn‖ ≤ ‖(xn1 : H) - xn‖ := by
    simpa [Subtype.dist_eq, dist_eq_norm, xn, xn1] using hT.dist_le_mul xn1 xn
  have hdiff :
      (xn1 : H) - (xn : H) = relax n • ((T xn : H) - (xn : H)) := by
    exact krasnoselskiiMannIteration_sub_eq_relax_residual hD_convex T relax hrelax x₀ n
  have hexpand :
      (T xn1 : H) - (xn1 : H) =
        ((T xn1 : H) - T xn) + (1 - relax n) • ((T xn : H) - (xn : H)) := by
    have htail :
        (T xn : H) - (xn1 : H) = (1 - relax n) • ((T xn : H) - (xn : H)) := by
      have hsucc :
          (xn1 : H) = (xn : H) + relax n • ((T xn : H) - (xn : H)) := by
        exact krasnoselskiiMannIteration_succ hD_convex T relax hrelax x₀ n
      rw [hsucc]
      rw [sub_smul, one_smul]
      abel_nf
    calc
      (T xn1 : H) - (xn1 : H) = ((T xn1 : H) - T xn) + ((T xn : H) - (xn1 : H)) := by
        abel_nf
      _ = ((T xn1 : H) - T xn) + (1 - relax n) • ((T xn : H) - (xn : H)) := by
        rw [htail]
  have hrelax_nonneg : 0 ≤ relax n := (hrelax n).1
  have hone_sub_nonneg : 0 ≤ 1 - relax n := sub_nonneg.mpr (hrelax n).2
  -- Expand the next residual, then bound both summands by the current residual.
  calc
    ‖(T xn1 : H) - (xn1 : H)‖ =
        ‖((T xn1 : H) - T xn) + (1 - relax n) • ((T xn : H) - (xn : H))‖ := by
          rw [hexpand]
    _ ≤ ‖(T xn1 : H) - T xn‖ + ‖(1 - relax n) • ((T xn : H) - (xn : H))‖ :=
          norm_add_le _ _
    _ ≤ ‖(xn1 : H) - xn‖ + ‖(1 - relax n) • ((T xn : H) - (xn : H))‖ := by
          exact add_le_add hdist le_rfl
    _ = ‖relax n • ((T xn : H) - (xn : H))‖ +
          ‖(1 - relax n) • ((T xn : H) - (xn : H))‖ := by
          rw [hdiff]
    _ = relax n * ‖(T xn : H) - (xn : H)‖ +
          (1 - relax n) * ‖(T xn : H) - (xn : H)‖ := by
          rw [norm_smul, norm_smul, Real.norm_eq_abs, Real.norm_eq_abs,
            abs_of_nonneg hrelax_nonneg, abs_of_nonneg hone_sub_nonneg]
    _ = ‖(T xn : H) - (xn : H)‖ := by
          ring

-- Proof sketch: combine the Fejér estimate with a fixed point to bound the weighted residual
-- energy, use divergence of the scalar weights to force the limit infimum to vanish, then upgrade
-- the vanishing liminf to convergence by monotonicity of the residual norms.
/-- Helper for Corollary 5.17: if the fixed point set is nonempty and
`∑ λₙ (1 - λₙ) = +∞`, then the Krasnosel'skii-Mann residuals converge strongly to `0`. -/
private theorem krasnoselskiiMannIteration_residual_tendsto_zero
    (hD_convex : Convex ℝ D) (T : D → D) (hT : LipschitzWith 1 T)
    (hfix : (fixedPoints T).Nonempty)
    (relax : ℕ → ℝ) (hrelax : ∀ n, relax n ∈ Set.Icc (0 : ℝ) 1)
    (hdiv :
      Tendsto (fun N ↦ (∑ n ∈ Finset.range N, relax n * (1 - relax n))) atTop atTop)
    (x₀ : D) :
    Tendsto
      (fun n ↦
        (T (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n) : H) -
          (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n : H))
      atTop (𝓝 (0 : H)) := by
  rcases hfix with ⟨y, hy⟩
  let yFix : fixedPoints T := ⟨y, hy⟩
  let residual : ℕ → H := fun n ↦
    (T (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n) : H) -
      (krasnoselskiiMannIteration hD_convex T relax hrelax x₀ n : H)
  let residualNorm : ℕ → ℝ := fun n ↦ ‖residual n‖
  let weight : ℕ → ℝ := fun n ↦ relax n * (1 - relax n)
  have hanti : Antitone residualNorm := by
    refine antitone_nat_of_succ_le fun n ↦ ?_
    simpa [residualNorm, residual] using
      krasnoselskiiMann_residual_norm_antitone hD_convex T hT relax hrelax x₀ n
  have hboundedBelow : BddBelow (Set.range residualNorm) := by
    refine ⟨0, ?_⟩
    rintro _ ⟨n, rfl⟩
    exact norm_nonneg _
  have hlim :
      Tendsto residualNorm atTop (𝓝 (⨅ n, residualNorm n)) :=
    tendsto_atTop_ciInf hanti hboundedBelow
  have hweight_nonneg : ∀ n, 0 ≤ weight n := by
    intro n
    have hrelax_nonneg : 0 ≤ relax n := (hrelax n).1
    have hone_sub_nonneg : 0 ≤ 1 - relax n := sub_nonneg.mpr (hrelax n).2
    positivity
  have hbound :
      ∀ N : ℕ,
        ∑ n ∈ Finset.range N, weight n * residualNorm n ^ 2 ≤ ‖(x₀ : H) - yFix‖ ^ 2 := by
    intro N
    simpa [weight, residualNorm, residual] using
      krasnoselskiiMann_residual_weighted_partial_sum_le_sqdist_of_fixedPoint
        hD_convex T hT relax hrelax x₀ yFix N
  let l : ℝ := sInf (residualNorm '' Set.Ici 0)
  have hset_bddBelow : BddBelow (residualNorm '' Set.Ici 0) := by
    refine ⟨0, ?_⟩
    rintro _ ⟨n, hn, rfl⟩
    exact norm_nonneg (residual n)
  have hl_le : ∀ n : ℕ, l ≤ residualNorm n := by
    intro n
    exact csInf_le hset_bddBelow ⟨n, Nat.zero_le n, rfl⟩
  have hl_nonneg : 0 ≤ l := by
    have hset_nonempty : (residualNorm '' Set.Ici 0).Nonempty := by
      exact ⟨residualNorm 0, ⟨0, Nat.zero_le 0, rfl⟩⟩
    have hzero_lower : 0 ∈ lowerBounds (residualNorm '' Set.Ici 0) := by
      rintro _ ⟨n, hn, rfl⟩
      exact norm_nonneg (residual n)
    exact le_csInf hset_nonempty hzero_lower
  have hlim' :
      Tendsto residualNorm atTop (𝓝 l) := by
    simpa [l] using
      (Real.tendsto_atTop_csInf_of_antitoneOn_bddBelow_nat_Ici (k := 0)
        (fun m hm n hn hmn ↦ hanti hmn)
        hset_bddBelow)
  have hl_eq_zero : l = 0 := by
    by_contra hzero
    have hne : 0 ≠ l := by
      simpa [eq_comm] using hzero
    have hpos : 0 < l := lt_of_le_of_ne hl_nonneg hne
    have hscaled_bound :
        ∀ N : ℕ,
          l ^ 2 * (∑ n ∈ Finset.range N, weight n) ≤ ‖(x₀ : H) - yFix‖ ^ 2 := by
      intro N
      have hterm :
          ∀ n ∈ Finset.range N,
            l ^ 2 * weight n ≤ weight n * residualNorm n ^ 2 := by
        intro n hn
        have hsq_nonneg : 0 ≤ residualNorm n := norm_nonneg (residual n)
        have hweight_n_nonneg : 0 ≤ weight n := hweight_nonneg n
        have hsquare : l ^ 2 ≤ residualNorm n ^ 2 := by
          nlinarith [hl_nonneg, hsq_nonneg, hl_le n]
        simpa [mul_comm, mul_left_comm, mul_assoc] using
          mul_le_mul_of_nonneg_left hsquare hweight_n_nonneg
      calc
        l ^ 2 * (∑ n ∈ Finset.range N, weight n) =
            ∑ n ∈ Finset.range N, (l ^ 2 * weight n) := by
              rw [Finset.mul_sum]
        _ ≤ ∑ n ∈ Finset.range N, weight n * residualNorm n ^ 2 := by
              exact Finset.sum_le_sum fun n hn ↦ hterm n hn
        _ ≤ ‖(x₀ : H) - yFix‖ ^ 2 := hbound N
    have hscaled :
        Tendsto (fun N ↦ l ^ 2 * (∑ n ∈ Finset.range N, weight n)) atTop atTop :=
      hdiv.const_mul_atTop (by positivity)
    rcases (hscaled.eventually_ge_atTop (‖(x₀ : H) - yFix‖ ^ 2 + 1)).exists with ⟨N, hN⟩
    have hN' := hscaled_bound N
    linarith
  have hnorm :
      Tendsto (fun n ↦ ‖residual n‖) atTop (𝓝 (0 : ℝ)) := by
    simpa [residualNorm, l, hl_eq_zero] using hlim'
  -- Norm convergence of the residuals is equivalent to strong convergence to `0`.
  simpa [residual] using (tendsto_zero_iff_norm_tendsto_zero).mpr hnorm

end

section

variable {H : Type u} [NormedAddCommGroup H] [InnerProductSpace ℝ H]

/-- Helper for Corollary 5.17: whole-space firm nonexpansiveness is `FirmlyNonexpansiveOn`
specialized to `Set.univ`. -/
abbrev FirmlyNonexpansive (T : H → H) : Prop :=
  FirmlyNonexpansiveOn (Set.univ : Set H) T

/-- Helper for Corollary 5.17: the reflector `2T - Id`, packaged as a self-map of `Set.univ`. -/
private def reflectedSelfMap (T : H → H) :
    {x : H // x ∈ (Set.univ : Set H)} → {x : H // x ∈ (Set.univ : Set H)} :=
  fun x ↦ ⟨(2 : ℝ) • T x - x, Set.mem_univ _⟩

/-- Helper for Corollary 5.17: the scaled Krasnosel'skii-Mann parameters `λₙ / 2`. -/
private noncomputable def halfRelax (relax : ℕ → ℝ) : ℕ → ℝ :=
  fun n ↦ relax n / 2

/-- Helper for Corollary 5.17: if `λₙ ∈ [0, 2]`, then `λₙ / 2 ∈ [0, 1]`. -/
private theorem halfRelax_mem_Icc {relax : ℕ → ℝ}
    (hrelax : ∀ n, relax n ∈ Set.Icc (0 : ℝ) 2) :
    ∀ n, halfRelax relax n ∈ Set.Icc (0 : ℝ) 1 := by
  intro n
  rcases hrelax n with ⟨h0, h2⟩
  change relax n / 2 ∈ Set.Icc (0 : ℝ) 1
  constructor
  · linarith
  · linarith

/-- Helper for Corollary 5.17: the divergence hypothesis rescales from
`∑ λₙ (2 - λₙ)` to `∑ (λₙ / 2) (1 - λₙ / 2)`. -/
private theorem tendsto_partialSum_halfRelax_mul_one_sub_halfRelax_atTop {relax : ℕ → ℝ}
    (hdiv :
      Tendsto (fun N ↦ ∑ n ∈ Finset.range N, relax n * (2 - relax n)) atTop atTop) :
    Tendsto
      (fun N ↦ ∑ n ∈ Finset.range N, halfRelax relax n * (1 - halfRelax relax n))
      atTop atTop := by
  -- Rewrite each summand as `(1 / 4) * (λₙ * (2 - λₙ))`, then preserve divergence under the
  -- positive scalar `1 / 4`.
  convert Tendsto.const_mul_atTop (by norm_num : 0 < (1 / 4 : ℝ)) hdiv using 1
  ext N
  rw [Finset.mul_sum]
  refine Finset.sum_congr rfl ?_
  intro n hn
  show halfRelax relax n * (1 - halfRelax relax n) =
      (1 / 4 : ℝ) * (relax n * (2 - relax n))
  simp [halfRelax]
  ring

/-- Helper for Corollary 5.17: on the whole space, firm nonexpansiveness makes the reflector
`x ↦ 2 • T x - x` nonexpansive. -/
private theorem reflectedSelfMap_lipschitz_of_firmlyNonexpansive {T : H → H}
    (hT : FirmlyNonexpansive T) :
    LipschitzWith 1 (reflectedSelfMap T) := by
  rw [FirmlyNonexpansive, firmlyNonexpansiveOn_iff] at hT
  let R : H → H := fun x ↦ (2 : ℝ) • T x - x
  have hReflect : ∀ x y : H, ‖R x - R y‖ ≤ ‖x - y‖ := by
    intro x y
    have hxy :
        ‖T x - T y‖ ^ (2 : ℕ) + ‖(x - T x) - (y - T y)‖ ^ (2 : ℕ) ≤ ‖x - y‖ ^ (2 : ℕ) := by
      simpa using hT x (by simp) y (by simp)
    have hfirm : ‖T x - T y‖ ^ (2 : ℕ) ≤ ⟪x - y, T x - T y⟫_ℝ := by
      have hres : (x - T x) - (y - T y) = (x - y) - (T x - T y) := by
        abel
      have hnorm :
          ‖(x - T x) - (y - T y)‖ ^ (2 : ℕ) =
            ‖x - y‖ ^ (2 : ℕ) - 2 * ⟪x - y, T x - T y⟫_ℝ + ‖T x - T y‖ ^ (2 : ℕ) := by
        rw [hres]
        simpa [real_inner_comm] using norm_sub_sq_real (x - y) (T x - T y)
      nlinarith [hxy, hnorm]
    have hsq : ‖R x - R y‖ ^ (2 : ℕ) ≤ ‖x - y‖ ^ (2 : ℕ) := by
      have hnorm :
          ‖R x - R y‖ ^ (2 : ℕ) =
            4 * ‖T x - T y‖ ^ (2 : ℕ) - 4 * ⟪T x - T y, x - y⟫_ℝ + ‖x - y‖ ^ (2 : ℕ) := by
        change ‖((2 : ℝ) • T x - x) - ((2 : ℝ) • T y - y)‖ ^ (2 : ℕ) =
            4 * ‖T x - T y‖ ^ (2 : ℕ) - 4 * ⟪T x - T y, x - y⟫_ℝ + ‖x - y‖ ^ (2 : ℕ)
        have hrewrite :
            ((2 : ℝ) • T x - x) - ((2 : ℝ) • T y - y) =
              (2 : ℝ) • (T x - T y) - (x - y) := by
          simp [sub_eq_add_neg, add_assoc, add_left_comm, add_comm]
        rw [hrewrite, norm_sub_sq_real]
        rw [show ‖(2 : ℝ) • (T x - T y)‖ ^ (2 : ℕ) = 4 * ‖T x - T y‖ ^ (2 : ℕ) by
          rw [norm_smul]
          norm_num
          ring]
        rw [show ⟪(2 : ℝ) • (T x - T y), x - y⟫_ℝ = 2 * ⟪T x - T y, x - y⟫_ℝ by
          rw [real_inner_smul_left]]
        ring
      have hfirm' : ‖T x - T y‖ ^ (2 : ℕ) ≤ ⟪T x - T y, x - y⟫_ℝ := by
        simpa [real_inner_comm] using hfirm
      nlinarith [hfirm', hnorm]
    exact (sq_le_sq₀ (norm_nonneg _) (norm_nonneg _)).1 hsq
  -- Convert the ambient nonexpansive inequality into `LipschitzWith 1` on `Set.univ`.
  refine LipschitzWith.of_dist_le_mul ?_
  intro x y
  simpa [R, reflectedSelfMap, Subtype.dist_eq, dist_eq_norm, one_mul] using
    hReflect (x : H) (y : H)

/-- Helper for Corollary 5.17: the reflector `2T - Id` has the same fixed points as `T`. -/
private theorem image_fixedPoints_reflectedSelfMap_eq {T : H → H} :
    Subtype.val '' fixedPoints (reflectedSelfMap T) = fixedPoints T := by
  ext y
  constructor
  · rintro ⟨x, hx, rfl⟩
    have hx' : (((reflectedSelfMap T) x : (Set.univ : Set H)) : H) = x := by
      exact congrArg Subtype.val hx
    change T (x : H) = (x : H)
    change ((2 : ℝ) • T x - x : H) = x at hx'
    have hzero : (2 : ℝ) • (T x - x) = 0 := by
      calc
        (2 : ℝ) • (T x - x) = (2 : ℝ) • T x - (2 : ℝ) • x := by
          rw [smul_sub]
        _ = ((2 : ℝ) • T x - x : H) - x := by
          simp [two_smul, sub_eq_add_neg, add_assoc]
        _ = 0 := by
          rw [hx', sub_self]
    rcases smul_eq_zero.mp hzero with htwo | hsub
    · norm_num at htwo
    · exact sub_eq_zero.mp hsub
  · intro hy
    refine ⟨⟨y, Set.mem_univ _⟩, ?_, rfl⟩
    apply Subtype.ext
    change ((2 : ℝ) • T y - y : H) = y
    rw [hy]
    simp [two_smul]

/-- Helper for Corollary 5.17: a fixed point of `T` is also a fixed point of the reflector. -/
private theorem fixedPoints_reflectedSelfMap_nonempty {T : H → H}
    (hfix : (fixedPoints T).Nonempty) :
    (fixedPoints (reflectedSelfMap T)).Nonempty := by
  rcases hfix with ⟨z, hz⟩
  refine ⟨⟨z, Set.mem_univ _⟩, ?_⟩
  apply Subtype.ext
  change ((2 : ℝ) • T z - z : H) = z
  rw [hz]
  simp [two_smul]

/-- Helper for Corollary 5.17: one Krasnosel'skii-Mann step for the reflector with parameter
`λₙ / 2` is exactly one relaxed step for `T` with parameter `λₙ`. -/
private theorem relaxedOperatorIteration_eq_krasnoselskiiMannIteration_reflected
    {T : H → H} (relax : ℕ → ℝ)
    (hrelax : ∀ n, relax n ∈ Set.Icc (0 : ℝ) 2) (x0 : H) :
    relaxedOperatorIteration (fun _ ↦ T) relax x0 =
      fun n ↦
        (krasnoselskiiMannIteration convex_univ (reflectedSelfMap T) (halfRelax relax)
          (halfRelax_mem_Icc hrelax) ⟨x0, Set.mem_univ _⟩ n : H) := by
  funext n
  induction n with
  | zero =>
      simp
  | succ n ihn =>
      rw [relaxedOperatorIteration_succ, krasnoselskiiMannIteration_succ, ihn]
      let x_n : H :=
        (krasnoselskiiMannIteration convex_univ (reflectedSelfMap T) (halfRelax relax)
          (halfRelax_mem_Icc hrelax) ⟨x0, Set.mem_univ _⟩ n : H)
      have hstep :
          (halfRelax relax n) • (((reflectedSelfMap T) ⟨x_n, Set.mem_univ _⟩ : H) - x_n) =
            relax n • (T x_n - x_n) := by
        have hreflect :
            ((reflectedSelfMap T) ⟨x_n, Set.mem_univ _⟩ : H) - x_n =
              (2 : ℝ) • (T x_n - x_n) := by
          change ((2 : ℝ) • T x_n - x_n : H) - x_n = (2 : ℝ) • (T x_n - x_n)
          simp [sub_eq_add_neg, two_smul, add_assoc, add_left_comm, add_comm]
        calc
          (halfRelax relax n) • (((reflectedSelfMap T) ⟨x_n, Set.mem_univ _⟩ : H) - x_n)
              = (halfRelax relax n) • ((2 : ℝ) • (T x_n - x_n)) := by rw [hreflect]
          _ = relax n • (T x_n - x_n) := by
                rw [smul_smul]
                congr 1
                simp [halfRelax]
      simpa [x_n] using hstep.symm

/-- Helper for Corollary 5.17: halving the reflector residual recovers the residual of `T`. -/
private theorem half_smul_reflected_residual_eq_residual {T : H → H} (x : H) :
    (1 / 2 : ℝ) • (((reflectedSelfMap T) ⟨x, Set.mem_univ _⟩ : H) - x) = T x - x := by
  change (1 / 2 : ℝ) • (((2 : ℝ) • T x - x : H) - x) = T x - x
  calc
    (1 / 2 : ℝ) • (((2 : ℝ) • T x - x : H) - x)
        = (1 / 2 : ℝ) • ((2 : ℝ) • (T x - x)) := by
            simp [sub_eq_add_neg, two_smul, add_assoc, add_left_comm, add_comm]
    _ = ((1 / 2 : ℝ) * (2 : ℝ)) • (T x - x) := by
          rw [smul_smul]
    _ = T x - x := by
          norm_num

end

section

variable {H : Type u} [NormedAddCommGroup H] [InnerProductSpace ℝ H]

-- Proof sketch: replace the relaxed iteration for `T` by the Krasnosel'skii-Mann iteration of
-- the reflector `R = 2T - Id` with parameters `λₙ / 2`, then use that `Fix R = Fix T`.
/-- Corollary 5.17 (1): for a firmly nonexpansive self-map, the relaxed iteration generated by
relaxation parameters in `[0, 2]` is Fejér monotone with respect to the fixed-point set of `T`. -/
theorem fejerMonotone_fixedPoints_of_relaxedOperatorIteration_of_firmlyNonexpansive
    {T : H → H} (hT : FirmlyNonexpansive T)
    (relax : ℕ → ℝ) (hrelax : ∀ n, relax n ∈ Set.Icc (0 : ℝ) 2) (x0 : H) :
    FejerMonotone (fixedPoints T) (relaxedOperatorIteration (fun _ ↦ T) relax x0) := by
  -- Route correction: keep the reflector skeleton but localize the KM Fejér theorem instead of
  -- importing the broken `Theorem_5_15` dependency chain.
  have hKM :
      FejerMonotone (Subtype.val '' fixedPoints (reflectedSelfMap T))
        (fun n ↦
          (krasnoselskiiMannIteration convex_univ (reflectedSelfMap T) (halfRelax relax)
            (halfRelax_mem_Icc hrelax) ⟨x0, Set.mem_univ _⟩ n : H)) := by
    -- The localized KM Fejér theorem applies because the reflector is nonexpansive.
    exact krasnoselskiiMannIteration_fejerMonotone convex_univ (reflectedSelfMap T)
      (reflectedSelfMap_lipschitz_of_firmlyNonexpansive hT) (halfRelax relax)
      (halfRelax_mem_Icc hrelax) ⟨x0, Set.mem_univ _⟩
  -- Rewrite the orbit and the fixed-point set back to the original firmly nonexpansive map.
  simpa [relaxedOperatorIteration_eq_krasnoselskiiMannIteration_reflected relax hrelax x0,
    image_fixedPoints_reflectedSelfMap_eq (T := T)] using hKM

-- Proof sketch: apply the localized KM residual theorem to the reflector `R = 2T - Id` and the
-- halved parameters `λₙ / 2`, then rescale the reflector residual back to `T xₙ - xₙ`.
/-- Corollary 5.17 (2): for a firmly nonexpansive self-map with a fixed point, if
`∑ λₙ (2 - λₙ) = +∞`, then the residuals `T xₙ - xₙ` of the relaxed iteration converge strongly
to `0`. -/
theorem residual_tendsto_zero_of_relaxedOperatorIteration_of_firmlyNonexpansive
    {T : H → H} (hT : FirmlyNonexpansive T)
    (hfix : (fixedPoints T).Nonempty)
    (relax : ℕ → ℝ) (hrelax : ∀ n, relax n ∈ Set.Icc (0 : ℝ) 2)
    (hdiv :
      Tendsto (fun N ↦ ∑ n ∈ Finset.range N, relax n * (2 - relax n)) atTop atTop)
    (x0 : H) :
    Tendsto
      (fun n ↦
        T (relaxedOperatorIteration (fun _ ↦ T) relax x0 n) -
          relaxedOperatorIteration (fun _ ↦ T) relax x0 n)
      atTop (𝓝 (0 : H)) := by
  have hKM :
      Tendsto
        (fun n ↦
          ((reflectedSelfMap T)
              (krasnoselskiiMannIteration convex_univ (reflectedSelfMap T) (halfRelax relax)
                (halfRelax_mem_Icc hrelax) ⟨x0, Set.mem_univ _⟩ n) : H) -
            (krasnoselskiiMannIteration convex_univ (reflectedSelfMap T) (halfRelax relax)
              (halfRelax_mem_Icc hrelax) ⟨x0, Set.mem_univ _⟩ n : H))
        atTop (𝓝 (0 : H)) := by
    -- The localized KM asymptotic-regularity theorem applies to the reflector orbit.
    exact krasnoselskiiMannIteration_residual_tendsto_zero convex_univ (reflectedSelfMap T)
      (reflectedSelfMap_lipschitz_of_firmlyNonexpansive hT)
      (fixedPoints_reflectedSelfMap_nonempty hfix) (halfRelax relax)
      (halfRelax_mem_Icc hrelax)
      (tendsto_partialSum_halfRelax_mul_one_sub_halfRelax_atTop hdiv) ⟨x0, Set.mem_univ _⟩
  have hscaled :
      Tendsto
        (fun n ↦
          (1 / 2 : ℝ) •
            (((reflectedSelfMap T)
                (krasnoselskiiMannIteration convex_univ (reflectedSelfMap T) (halfRelax relax)
                  (halfRelax_mem_Icc hrelax) ⟨x0, Set.mem_univ _⟩ n) : H) -
              (krasnoselskiiMannIteration convex_univ (reflectedSelfMap T) (halfRelax relax)
                (halfRelax_mem_Icc hrelax) ⟨x0, Set.mem_univ _⟩ n : H)))
        atTop (𝓝 (0 : H)) := by
    -- Scalar multiplication preserves convergence to `0`.
    simpa using hKM.const_smul (1 / 2 : ℝ)
  have hresidual :
      (fun n ↦
        (1 / 2 : ℝ) •
          (((reflectedSelfMap T)
              (krasnoselskiiMannIteration convex_univ (reflectedSelfMap T) (halfRelax relax)
                (halfRelax_mem_Icc hrelax) ⟨x0, Set.mem_univ _⟩ n) : H) -
            (krasnoselskiiMannIteration convex_univ (reflectedSelfMap T) (halfRelax relax)
              (halfRelax_mem_Icc hrelax) ⟨x0, Set.mem_univ _⟩ n : H))) =
        (fun n ↦
          T (relaxedOperatorIteration (fun _ ↦ T) relax x0 n) -
            relaxedOperatorIteration (fun _ ↦ T) relax x0 n) := by
    funext n
    let xn : H :=
      (krasnoselskiiMannIteration convex_univ (reflectedSelfMap T) (halfRelax relax)
        (halfRelax_mem_Icc hrelax) ⟨x0, Set.mem_univ _⟩ n : H)
    have hxn :
        relaxedOperatorIteration (fun _ ↦ T) relax x0 n = xn := by
      simpa [xn] using
        congrArg (fun f : ℕ → H ↦ f n)
          (relaxedOperatorIteration_eq_krasnoselskiiMannIteration_reflected relax hrelax x0)
    calc
      (1 / 2 : ℝ) •
          (((reflectedSelfMap T)
              (krasnoselskiiMannIteration convex_univ (reflectedSelfMap T) (halfRelax relax)
                (halfRelax_mem_Icc hrelax) ⟨x0, Set.mem_univ _⟩ n) : H) -
            (krasnoselskiiMannIteration convex_univ (reflectedSelfMap T) (halfRelax relax)
              (halfRelax_mem_Icc hrelax) ⟨x0, Set.mem_univ _⟩ n : H))
          = T xn - xn := by
            simpa [xn] using half_smul_reflected_residual_eq_residual (T := T) xn
      _ = T (relaxedOperatorIteration (fun _ ↦ T) relax x0 n) -
            relaxedOperatorIteration (fun _ ↦ T) relax x0 n := by
            rw [hxn]
  rw [hresidual] at hscaled
  exact hscaled

end

section

variable {H : Type u} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]

omit [InnerProductSpace ℝ H] [CompleteSpace H] in
/-- Helper for Corollary 5.17: whole-space firm nonexpansiveness implies whole-space
nonexpansiveness. -/
private theorem lipschitzWith_one_of_firmlyNonexpansive {T : H → H}
    (hT : FirmlyNonexpansive T) :
    LipschitzWith 1 (fun x : (Set.univ : Set H) ↦ T x) := by
  rw [FirmlyNonexpansive, firmlyNonexpansiveOn_iff] at hT
  refine LipschitzWith.of_dist_le_mul ?_
  intro x y
  have hfirm :
      ‖T x - T y‖ ^ (2 : ℕ) + ‖((x : H) - T x) - ((y : H) - T y)‖ ^ (2 : ℕ) ≤
        ‖(x : H) - y‖ ^ (2 : ℕ) := by
    simpa using hT x (by simp) y (by simp)
  have hsq :
      ‖T x - T y‖ ^ (2 : ℕ) ≤ ‖(x : H) - y‖ ^ (2 : ℕ) := by
    have hnonneg : 0 ≤ ‖((x : H) - T x) - ((y : H) - T y)‖ ^ (2 : ℕ) := by
      positivity
    nlinarith
  have hnorm : ‖T x - T y‖ ≤ ‖(x : H) - y‖ :=
    (sq_le_sq₀ (norm_nonneg _) (norm_nonneg _)).1 hsq
  simpa [Subtype.dist_eq, dist_eq_norm, one_mul] using hnorm

/-- Helper for Corollary 5.17: every weak sequential cluster point of the relaxed orbit belongs to
`fixedPoints T` once the residuals tend to `0`. -/
private theorem weak_cluster_point_mem_fixedPoints_of_relaxedOperatorIteration_of_firmlyNonexpansive
    {T : H → H} (hT : FirmlyNonexpansive T) (relax : ℕ → ℝ) (x0 : H)
    (hres :
      Tendsto
        (fun n ↦
          T (relaxedOperatorIteration (fun _ ↦ T) relax x0 n) -
            relaxedOperatorIteration (fun _ ↦ T) relax x0 n)
        atTop (𝓝 (0 : H)))
    {z : H}
    (hz :
      IsSequentialClusterPt
        (fun n ↦ toWeakSpace ℝ H (relaxedOperatorIteration (fun _ ↦ T) relax x0 n))
        (toWeakSpace ℝ H z)) :
    z ∈ fixedPoints T := by
  rcases hz.exists_subseq_tendsto with ⟨φ, hφ, hφz⟩
  let zD : {x : H // x ∈ (Set.univ : Set H)} := ⟨z, Set.mem_univ _⟩
  let xSub : ℕ → {x : H // x ∈ (Set.univ : Set H)} := fun n ↦
    ⟨relaxedOperatorIteration (fun _ ↦ T) relax x0 (φ n), Set.mem_univ _⟩
  have hweak :
      Tendsto
        (fun n ↦ toWeakSpace ℝ H (xSub n : H))
        atTop (𝓝 (toWeakSpace ℝ H (zD : H))) := by
    -- The subsequence witness already gives the weak convergence needed by Corollary 4.28.
    simpa [xSub, zD] using hφz
  have hres_sub :
      Tendsto
        (fun n ↦ (xSub n : H) - T (xSub n))
        atTop (𝓝 (0 : H)) := by
    have hres' :
        Tendsto
          (fun n ↦
            T (relaxedOperatorIteration (fun _ ↦ T) relax x0 (φ n)) -
              relaxedOperatorIteration (fun _ ↦ T) relax x0 (φ n))
          atTop (𝓝 (0 : H)) := by
      exact hres.comp hφ.tendsto_atTop
    -- Flip the residual sign to match the demiclosedness statement.
    simpa [xSub, sub_eq_add_neg, add_assoc, add_left_comm, add_comm] using
      hres'.const_smul (-1 : ℝ)
  have hz_fixed :
      T zD = (zD : H) := by
    -- Apply the demiclosedness principle on `D = Set.univ`.
    simpa [zD] using
      map_eq_of_tendsto_weakly_of_residual_tendsto_zero_of_nonexpansive
        (D := (Set.univ : Set H))
        (T := fun x : {x : H // x ∈ (Set.univ : Set H)} ↦ T x)
        (xₙ := xSub)
        (x := zD)
        isClosed_univ convex_univ
        (lipschitzWith_one_of_firmlyNonexpansive hT)
        hweak hres_sub
  rw [Function.mem_fixedPoints_iff]
  simpa [zD] using hz_fixed

-- Proof sketch: combine part (i) with part (ii), identify every weak sequential cluster point as
-- a fixed point via Corollary 4.28, and then invoke Theorem 5.5.
/-- Corollary 5.17 (3): for a firmly nonexpansive self-map with a fixed point, if
`∑ λₙ (2 - λₙ) = +∞`, then the relaxed iteration converges weakly to a fixed point of `T`. -/
theorem exists_tendsto_weakly_to_fixedPoint_of_relaxedOperatorIteration_of_firmlyNonexpansive
    {T : H → H} (hT : FirmlyNonexpansive T)
    (hfix : (fixedPoints T).Nonempty)
    (relax : ℕ → ℝ) (hrelax : ∀ n, relax n ∈ Set.Icc (0 : ℝ) 2)
    (hdiv :
      Tendsto (fun N ↦ ∑ n ∈ Finset.range N, relax n * (2 - relax n)) atTop atTop)
    (x0 : H) :
    ∃ z ∈ fixedPoints T,
      Tendsto
        (fun n ↦ toWeakSpace ℝ H (relaxedOperatorIteration (fun _ ↦ T) relax x0 n))
        atTop (𝓝 (toWeakSpace ℝ H z)) := by
  -- Route correction: derive weak convergence from Fejér monotonicity plus demiclosedness,
  -- rather than importing the stale `Theorem_5_15` artifact chain.
  have hfejer :
      FejerMonotone (fixedPoints T) (relaxedOperatorIteration (fun _ ↦ T) relax x0) :=
    fejerMonotone_fixedPoints_of_relaxedOperatorIteration_of_firmlyNonexpansive
      hT relax hrelax x0
  have hres :
      Tendsto
        (fun n ↦
          T (relaxedOperatorIteration (fun _ ↦ T) relax x0 n) -
            relaxedOperatorIteration (fun _ ↦ T) relax x0 n)
        atTop (𝓝 (0 : H)) :=
    residual_tendsto_zero_of_relaxedOperatorIteration_of_firmlyNonexpansive
      hT hfix relax hrelax hdiv x0
  have hcluster :
      ∀ z : H,
        IsSequentialClusterPt
            (fun n ↦ toWeakSpace ℝ H (relaxedOperatorIteration (fun _ ↦ T) relax x0 n))
            (toWeakSpace ℝ H z) →
          z ∈ fixedPoints T := by
    intro z hz
    -- Clause (ii) feeds into Corollary 4.28 along any weakly convergent subsequence.
    exact
      weak_cluster_point_mem_fixedPoints_of_relaxedOperatorIteration_of_firmlyNonexpansive
        hT relax x0 hres hz
  -- Theorem 5.5 closes the argument once Fejér monotonicity and the cluster-point criterion hold.
  exact tendsto_weakly_of_fejerMonotone_of_weakSequentialClusterPts_mem
    hfix (relaxedOperatorIteration (fun _ ↦ T) relax x0) hfejer hcluster

end
