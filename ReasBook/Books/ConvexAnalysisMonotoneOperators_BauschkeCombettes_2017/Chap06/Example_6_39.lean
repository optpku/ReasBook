import Mathlib
import ConvexAnalysisMonotoneOperators_BauschkeCombettes_2017.Chap06.Definition_6_38

-- Declarations for this item will be appended below by the statement pipeline.

open scoped InnerProductSpace Pointwise

universe u

section

variable {H : Type u} [NormedAddCommGroup H] [InnerProductSpace ℝ H]

local notation "C" => Metric.closedBall (0 : H) 1

/-
The first helper only uses the additive-group structure, so we omit the inner-product instance to
avoid carrying an unused section variable.
-/
omit [InnerProductSpace ℝ H] in
/-- Helper for Example 6.39: membership in the translated closed unit ball is equivalent to the
corresponding translated point lying in the original ball. -/
lemma mem_closedUnitBall_sub_singleton_iff {x y : H} :
    y ∈ C - ({x} : Set H) ↔ x + y ∈ C := by
  constructor
  · rintro ⟨z, hz, w, hw, hzw⟩
    have hw' : w = x := by simpa using hw
    subst w
    have hz' : z = y + x := sub_eq_iff_eq_add.mp hzw
    simpa [hz', add_comm] using hz
  · intro hy
    refine ⟨x + y, hy, x, by simp, ?_⟩
    abel

/-- Helper for Example 6.39: the translate `closedBall 0 1 - {x}` remains convex. -/
lemma convex_closedUnitBall_sub_singleton (x : H) :
    Convex ℝ (C - ({x} : Set H)) :=
  (convex_closedBall (0 : H) 1).sub (convex_singleton x)

/-- Helper for Example 6.39: a vector in the translated closed unit ball at a boundary point has
nonpositive inner product with the boundary point. -/
lemma inner_nonpos_of_mem_closedUnitBall_sub_singleton_of_norm_eq_one {x y : H} (hx : ‖x‖ = 1)
    (hy : y ∈ C - ({x} : Set H)) :
    ⟪y, x⟫_ℝ ≤ 0 := by
  rcases (mem_closedUnitBall_sub_singleton_iff.mp hy) with hy_ball
  have hy_norm : ‖x + y‖ ≤ 1 := by
    simpa [Metric.mem_closedBall, dist_eq_norm] using hy_ball
  have hinner_le : ⟪x + y, x⟫_ℝ ≤ 1 := by
    calc
      ⟪x + y, x⟫_ℝ ≤ ‖⟪x + y, x⟫_ℝ‖ := by
        exact le_abs_self _
      _ ≤ ‖x + y‖ * ‖x‖ := by
        simpa using (norm_inner_le_norm (x + y) x : ‖⟪x + y, x⟫_ℝ‖ ≤ ‖x + y‖ * ‖x‖)
      _ = ‖x + y‖ := by
        simp [hx]
      _ ≤ 1 := hy_norm
  -- Expand the inner product against `x` to isolate the directional term.
  rw [inner_add_left, real_inner_self_eq_norm_sq, hx, pow_two] at hinner_le
  linarith

/-- Helper for Example 6.39: an interior point of the closed unit ball admits a positive step in
every direction while staying inside the ball. -/
lemma exists_pos_smul_add_mem_closedUnitBall_of_norm_lt_one {x y : H} (hx : ‖x‖ < 1) :
    ∃ t : ℝ, 0 < t ∧ x + t • y ∈ C := by
  let t : ℝ := (1 - ‖x‖) / (‖y‖ + 1)
  have hden_pos : 0 < ‖y‖ + 1 := by
    positivity
  have ht_pos : 0 < t := by
    dsimp [t]
    have hnum_pos : 0 < 1 - ‖x‖ := by
      nlinarith
    exact div_pos hnum_pos hden_pos
  refine ⟨t, ht_pos, ?_⟩
  rw [Metric.mem_closedBall, dist_eq_norm, sub_zero]
  have hy_div_le : ‖y‖ / (‖y‖ + 1) ≤ (1 : ℝ) := by
    exact (div_le_iff₀ hden_pos).2 (by nlinarith [norm_nonneg y])
  have hty_le : t * ‖y‖ ≤ 1 - ‖x‖ := by
    have hnum_nonneg : 0 ≤ 1 - ‖x‖ := sub_nonneg.mpr hx.le
    have hmul : (1 - ‖x‖) * (‖y‖ / (‖y‖ + 1)) ≤ (1 - ‖x‖) * 1 :=
      mul_le_mul_of_nonneg_left hy_div_le hnum_nonneg
    have hrewrite : t * ‖y‖ = (1 - ‖x‖) * (‖y‖ / (‖y‖ + 1)) := by
      calc
        t * ‖y‖ = ((1 - ‖x‖) / (‖y‖ + 1)) * ‖y‖ := by rfl
        _ = (1 - ‖x‖) * (‖y‖ / (‖y‖ + 1)) := by ring
    rw [hrewrite]
    simpa using hmul
  have hsum_le : ‖x‖ + t * ‖y‖ ≤ ‖x‖ + (1 - ‖x‖) := by
    simpa [add_comm, add_left_comm, add_assoc] using add_le_add_left hty_le ‖x‖
  calc
    ‖x + t • y‖ ≤ ‖x‖ + ‖t • y‖ := norm_add_le _ _
    _ = ‖x‖ + t * ‖y‖ := by
      rw [norm_smul, Real.norm_of_nonneg ht_pos.le]
    _ ≤ ‖x‖ + (1 - ‖x‖) := hsum_le
    _ = 1 := by ring

/-- Helper for Example 6.39: a strictly inward boundary direction already belongs to the cone
generated by the translated closed unit ball. -/
lemma strict_direction_mem_cone_diff_closedUnitBall_of_norm_eq_one {x y : H} (hx : ‖x‖ = 1)
    (hxy : ⟪y, x⟫_ℝ < 0) :
    y ∈ Set.cone (C - ({x} : Set H)) := by
  let t : ℝ := -⟪y, x⟫_ℝ / ‖y‖ ^ 2
  have hy_ne : y ≠ 0 := by
    intro hy0
    simp [hy0] at hxy
  have hy_sq_pos : 0 < ‖y‖ ^ 2 := by
    nlinarith [sq_pos_of_ne_zero (norm_ne_zero_iff.mpr hy_ne)]
  have ht_pos : 0 < t := by
    dsimp [t]
    have hnum_pos : 0 < -⟪y, x⟫_ℝ := by
      nlinarith
    exact div_pos hnum_pos hy_sq_pos
  have hball : x + t • y ∈ C := by
    rw [Metric.mem_closedBall, dist_eq_norm, sub_zero]
    have hsquare := norm_add_sq_real x (t • y)
    have hcomm : ⟪x, y⟫_ℝ = ⟪y, x⟫_ℝ := (real_inner_comm x y).symm
    rw [real_inner_smul_right, hcomm, norm_smul, Real.norm_of_nonneg ht_pos.le, hx] at hsquare
    have hsq_le : ‖x + t • y‖ ^ 2 ≤ 1 := by
      dsimp [t] at hsquare
      have haux : 2 * (-⟪y, x⟫_ℝ / ‖y‖ ^ 2) * ⟪y, x⟫_ℝ +
          (-⟪y, x⟫_ℝ / ‖y‖ ^ 2) ^ 2 * ‖y‖ ^ 2 ≤ 0 := by
        field_simp [hy_sq_pos.ne']
        nlinarith
      nlinarith
    nlinarith [sq_nonneg ‖x + t • y‖, hsq_le]
  have hty_mem : t • y ∈ C - ({x} : Set H) := by
    exact (mem_closedUnitBall_sub_singleton_iff).2 hball
  -- Use the explicit positive multiple `t • y` to witness membership in the cone hull.
  change y ∈ (ConvexCone.hull ℝ (C - ({x} : Set H)) : Set H)
  refine (ConvexCone.mem_hull_of_convex (convex_closedUnitBall_sub_singleton x)).2 ?_
  refine ⟨t⁻¹, inv_pos.mpr ht_pos, ?_⟩
  refine Set.mem_smul_set.mpr ⟨t • y, hty_mem, ?_⟩
  simpa [smul_smul, ht_pos.ne'] using (inv_smul_smul₀ ht_pos.ne' (t • y)).symm

/-- Helper for Example 6.39: weakly inward boundary directions lie in the tangent cone by
approximating them with strict directions. -/
lemma nonpos_direction_mem_tangentCone_closedUnitBall_of_norm_eq_one {x y : H} (hx : ‖x‖ = 1)
    (hxy : ⟪y, x⟫_ℝ ≤ 0) :
    y ∈ Set.tangentCone C x := by
  have hxC : x ∈ C := by
    simpa [Metric.mem_closedBall, dist_eq_norm] using hx.le
  rw [Set.tangentCone_of_mem hxC]
  rw [Metric.mem_closure_iff]
  intro ε hε
  let z : H := y - (ε / 2) • x
  have hz_strict : ⟪z, x⟫_ℝ < 0 := by
    dsimp [z]
    rw [inner_sub_left, real_inner_smul_left, real_inner_self_eq_norm_sq, hx, pow_two]
    nlinarith
  have hz_mem : z ∈ Set.cone (C - ({x} : Set H)) :=
    strict_direction_mem_cone_diff_closedUnitBall_of_norm_eq_one hx hz_strict
  refine ⟨z, hz_mem, ?_⟩
  -- The perturbation by `-(ε / 2) • x` has norm `ε / 2`, so it stays inside the `ε`-ball.
  rw [dist_eq_norm]
  dsimp [z]
  have hdiff : y - (y - (ε / 2) • x) = (ε / 2) • x := by
    abel
  rw [hdiff, norm_smul, Real.norm_of_nonneg (by nlinarith), hx]
  nlinarith

/-- Helper for Example 6.39: at a boundary point, the normal cone consists exactly of the
nonnegative scalar multiples of the boundary point. -/
lemma mem_normalCone_closedUnitBall_iff_nonnegative_smul_of_norm_eq_one {x u : H} (hx : ‖x‖ = 1) :
    u ∈ Set.normalCone C x ↔ ∃ a : ℝ, 0 ≤ a ∧ u = a • x := by
  have hxC : x ∈ C := by
    simpa [Metric.mem_closedBall, dist_eq_norm] using hx.le
  rw [Set.normalCone_of_mem hxC]
  constructor
  · intro hu
    have hu0 : innerSupremumOn (C - ({x} : Set H)) u ≤ 0 := by
      simpa using hu
    have huD :
        ∀ y ∈ C - ({x} : Set H), ⟪y, u⟫_ℝ ≤ 0 := by
      have hsep : innerSupremumOn (C - ({x} : Set H)) u ≤ innerInfimumOn ({0} : Set H) u := by
        simpa using hu0
      have hsup :=
        (innerSupremumOn_le_innerInfimumOn_iff_forall_inner_le
          (C - ({x} : Set H)) ({0} : Set H) u).1 hsep
      intro y hy
      simpa using hsup y hy 0 (by simp)
    have hcone_subset : Set.cone (C - ({x} : Set H)) ⊆ {y : H | ⟪y, u⟫_ℝ ≤ 0} := by
      intro y hy
      change y ∈ (ConvexCone.hull ℝ (C - ({x} : Set H)) : Set H) at hy
      rcases (ConvexCone.mem_hull_of_convex (convex_closedUnitBall_sub_singleton x)).1 hy with
        ⟨r, hr, hy⟩
      rcases Set.mem_smul_set.mp hy with ⟨z, hz, rfl⟩
      simpa [real_inner_smul_left] using mul_nonpos_of_nonneg_of_nonpos hr.le (huD z hz)
    have hclosed : IsClosed {y : H | ⟪y, u⟫_ℝ ≤ 0} := by
      exact isClosed_le (continuous_id'.inner continuous_const) continuous_const
    have hu_half :
        ∀ y : H, ⟪y, x⟫_ℝ ≤ 0 → ⟪y, u⟫_ℝ ≤ 0 := by
      intro y hy
      have hy_tangent : y ∈ Set.tangentCone C x :=
        nonpos_direction_mem_tangentCone_closedUnitBall_of_norm_eq_one hx hy
      rw [Set.tangentCone_of_mem hxC] at hy_tangent
      exact closure_minimal hcone_subset hclosed hy_tangent
    let a : ℝ := ⟪u, x⟫_ℝ
    let v : H := u - a • x
    have hvx : ⟪v, x⟫_ℝ = 0 := by
      dsimp [v, a]
      rw [inner_sub_left, real_inner_smul_left, real_inner_self_eq_norm_sq, hx, pow_two]
      ring
    have hvu_nonpos : ⟪v, u⟫_ℝ ≤ 0 := hu_half v (le_of_eq hvx)
    have hvu_eq : ⟪v, u⟫_ℝ = ‖v‖ ^ 2 := by
      have hu_decomp : u = v + a • x := by
        dsimp [v, a]
        abel
      rw [hu_decomp, inner_add_right, real_inner_smul_right, hvx, mul_zero, add_zero,
        real_inner_self_eq_norm_sq]
    have hv_zero_norm : ‖v‖ = 0 := by
      nlinarith [sq_nonneg ‖v‖, hvu_nonpos, hvu_eq]
    have hv_zero : v = 0 := norm_eq_zero.mp hv_zero_norm
    have hu_eq : u = a • x := by
      dsimp [v] at hv_zero
      exact sub_eq_zero.mp hv_zero
    have ha_nonneg : 0 ≤ a := by
      have hnegx : ⟪-x, u⟫_ℝ ≤ 0 := by
        have hxneg : ⟪-x, x⟫_ℝ ≤ 0 := by
          rw [inner_neg_left, real_inner_self_eq_norm_sq, hx, pow_two]
          norm_num
        exact hu_half (-x) hxneg
      have hnega : -a ≤ 0 := by
        simpa [a, inner_neg_left, real_inner_comm] using hnegx
      dsimp [a]
      linarith
    exact ⟨a, ha_nonneg, hu_eq⟩
  · rintro ⟨a, ha, rfl⟩
    have hpointwise :
        ∀ y ∈ C - ({x} : Set H), ∀ z ∈ ({0} : Set H), ⟪y, a • x⟫_ℝ ≤ ⟪z, a • x⟫_ℝ := by
      intro y hy z hz
      have hz' : z = 0 := by
        simpa using hz
      subst hz'
      have hy_nonpos : ⟪y, x⟫_ℝ ≤ 0 :=
        inner_nonpos_of_mem_closedUnitBall_sub_singleton_of_norm_eq_one hx hy
      simpa [real_inner_smul_right] using mul_nonpos_of_nonneg_of_nonpos ha hy_nonpos
    simpa using
      (innerSupremumOn_le_innerInfimumOn_iff_forall_inner_le
        (C - ({x} : Set H)) ({0} : Set H) (a • x)).2 hpointwise

/-- Helper for Example 6.39: an interior point of the closed unit ball has only the trivial normal
vector. -/
lemma eq_zero_of_mem_normalCone_closedUnitBall_of_norm_lt_one {x u : H} (hx : ‖x‖ < 1)
    (hu : u ∈ Set.normalCone C x) :
    u = 0 := by
  have hxC : x ∈ C := by
    simpa [Metric.mem_closedBall, dist_eq_norm] using hx.le
  rw [Set.normalCone_of_mem hxC] at hu
  have hu0 : innerSupremumOn (C - ({x} : Set H)) u ≤ 0 := by
    simpa using hu
  have huD :
      ∀ y ∈ C - ({x} : Set H), ⟪y, u⟫_ℝ ≤ 0 := by
    have hsep : innerSupremumOn (C - ({x} : Set H)) u ≤ innerInfimumOn ({0} : Set H) u := by
      simpa using hu0
    have hsup :=
      (innerSupremumOn_le_innerInfimumOn_iff_forall_inner_le
        (C - ({x} : Set H)) ({0} : Set H) u).1 hsep
    intro y hy
    simpa using hsup y hy 0 (by simp)
  obtain ⟨t, ht, hball⟩ := exists_pos_smul_add_mem_closedUnitBall_of_norm_lt_one (x := x) (y := u) hx
  have htu_mem : t • u ∈ C - ({x} : Set H) := by
    exact (mem_closedUnitBall_sub_singleton_iff).2 hball
  have hnonpos : ⟪t • u, u⟫_ℝ ≤ 0 := huD (t • u) htu_mem
  have hscalar : t * ‖u‖ ^ 2 ≤ 0 := by
    simpa [real_inner_smul_left, real_inner_self_eq_norm_sq] using hnonpos
  have hu_zero_norm : ‖u‖ = 0 := by
    have hu_sq_zero : ‖u‖ ^ 2 = 0 := by
      nlinarith [sq_nonneg ‖u‖, ht, hscalar]
    nlinarith [hu_sq_zero, norm_nonneg u]
  exact norm_eq_zero.mp hu_zero_norm

-- Proof sketch: unfold `Set.tangentCone` at the closed unit ball, identify `C - x` with the
-- translate of the closed unit ball by a boundary point, and compute the generated closed cone as
-- the supporting half-space orthogonal to `x`.
/-- Example 6.39 (1): at a boundary point of the closed unit ball, the tangent cone is the closed
half-space of directions whose inner product with the boundary point is nonpositive. -/
theorem tangentCone_closedUnitBall_eq_inner_nonpos_of_norm_eq_one {x : H} (hx : ‖x‖ = 1) :
    Set.tangentCone (Metric.closedBall (0 : H) 1) x = {y : H | ⟪y, x⟫_ℝ ≤ 0} := by
  have hxC : x ∈ C := by
    simpa [Metric.mem_closedBall, dist_eq_norm] using hx.le
  have hclosed : IsClosed {y : H | ⟪y, x⟫_ℝ ≤ 0} := by
    exact isClosed_le (continuous_id'.inner continuous_const) continuous_const
  have hsubset :
      Set.cone (C - ({x} : Set H)) ⊆ {y : H | ⟪y, x⟫_ℝ ≤ 0} := by
    intro y hy
    change y ∈ (ConvexCone.hull ℝ (C - ({x} : Set H)) : Set H) at hy
    rcases (ConvexCone.mem_hull_of_convex (convex_closedUnitBall_sub_singleton x)).1 hy with
      ⟨r, hr, hy⟩
    rcases Set.mem_smul_set.mp hy with ⟨z, hz, rfl⟩
    simpa [real_inner_smul_left] using
      mul_nonpos_of_nonneg_of_nonpos hr.le
        (inner_nonpos_of_mem_closedUnitBall_sub_singleton_of_norm_eq_one hx hz)
  apply Set.Subset.antisymm
  · rw [Set.tangentCone_of_mem hxC]
    exact closure_minimal hsubset hclosed
  · intro y hy
    exact nonpos_direction_mem_tangentCone_closedUnitBall_of_norm_eq_one hx hy

-- Proof sketch: use that a strict interior point of a convex closed ball belongs to the core, so
-- the cone generated by `C - x` is all of `H`, hence its closure is `univ`.
/-- Example 6.39 (2): at an interior point of the closed unit ball, the tangent cone is the whole
space. -/
theorem tangentCone_closedUnitBall_eq_univ_of_norm_lt_one {x : H} (hx : ‖x‖ < 1) :
    Set.tangentCone (Metric.closedBall (0 : H) 1) x = Set.univ := by
  have hxC : x ∈ C := by
    simpa [Metric.mem_closedBall, dist_eq_norm] using hx.le
  apply Set.eq_univ_of_forall
  intro y
  rw [Set.tangentCone_of_mem hxC]
  -- Route correction: the final step is a direct cone-to-closure insertion via `subset_closure`.
  -- Every direction is already in the cone via an explicit positive interior step.
  obtain ⟨t, ht, hball⟩ := exists_pos_smul_add_mem_closedUnitBall_of_norm_lt_one (x := x) (y := y) hx
  have hty_mem : t • y ∈ C - ({x} : Set H) := by
    exact (mem_closedUnitBall_sub_singleton_iff).2 hball
  have hy_cone : y ∈ Set.cone (C - ({x} : Set H)) := by
    change y ∈ (ConvexCone.hull ℝ (C - ({x} : Set H)) : Set H)
    refine (ConvexCone.mem_hull_of_convex (convex_closedUnitBall_sub_singleton x)).2 ?_
    refine ⟨t⁻¹, inv_pos.mpr ht, ?_⟩
    refine Set.mem_smul_set.mpr ⟨t • y, hty_mem, ?_⟩
    simpa [smul_smul, ht.ne'] using (inv_smul_smul₀ ht.ne' (t • y)).symm
  exact subset_closure hy_cone

-- Proof sketch: unfold `Set.normalCone`, use the supporting-hyperplane description of the closed
-- unit ball at a boundary point, and identify the resulting normal cone with the ray of
-- nonnegative multiples of `x`.
/-- Example 6.39 (3): at a boundary point of the closed unit ball, the normal cone is the ray of
nonnegative multiples of that point. -/
theorem normalCone_closedUnitBall_eq_nonnegative_ray_of_norm_eq_one {x : H} (hx : ‖x‖ = 1) :
    Set.normalCone (Metric.closedBall (0 : H) 1) x = Set.Ici (0 : ℝ) • ({x} : Set H) := by
  ext u
  constructor
  · intro hu
    rcases (mem_normalCone_closedUnitBall_iff_nonnegative_smul_of_norm_eq_one hx).1 hu with
      ⟨a, ha, rfl⟩
    refine ⟨a, ha, x, by simp, rfl⟩
  · rintro ⟨a, ha, y, hy, rfl⟩
    have hy' : y = x := by
      simpa using hy
    subst hy'
    exact (mem_normalCone_closedUnitBall_iff_nonnegative_smul_of_norm_eq_one hx).2 ⟨a, ha, rfl⟩

-- Proof sketch: an interior point of a convex set has only the trivial normal vector, so the
-- normal cone of the closed unit ball at `x` reduces to `{0}` when `‖x‖ < 1`.
/-- Example 6.39 (4): at an interior point of the closed unit ball, the normal cone is trivial. -/
theorem normalCone_closedUnitBall_eq_singleton_zero_of_norm_lt_one {x : H} (hx : ‖x‖ < 1) :
    Set.normalCone (Metric.closedBall (0 : H) 1) x = ({0} : Set H) := by
  ext u
  constructor
  · intro hu
    have hu_zero : u = 0 := eq_zero_of_mem_normalCone_closedUnitBall_of_norm_lt_one hx hu
    simp [hu_zero]
  · rintro rfl
    have hxC : x ∈ C := by
      simpa [Metric.mem_closedBall, dist_eq_norm] using hx.le
    rw [Set.normalCone_of_mem hxC]
    have hpointwise :
        ∀ y ∈ C - ({x} : Set H), ∀ z ∈ ({0} : Set H), ⟪y, (0 : H)⟫_ℝ ≤ ⟪z, (0 : H)⟫_ℝ := by
      intro y hy z hz
      simp
    simpa using
      (innerSupremumOn_le_innerInfimumOn_iff_forall_inner_le
        (C - ({x} : Set H)) ({0} : Set H) (0 : H)).2 hpointwise

end
