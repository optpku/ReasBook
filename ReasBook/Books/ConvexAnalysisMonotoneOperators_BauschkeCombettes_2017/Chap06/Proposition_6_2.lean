import Mathlib
import ConvexAnalysisMonotoneOperators_BauschkeCombettes_2017.Chap06.Definition_6_1

-- Declarations for this item will be appended below by the statement pipeline.

open scoped Pointwise

universe u

namespace Set

local notation "cone" => Set.conicalHull

section

variable {E : Type u} [AddCommGroup E] [Module ℝ E]

/-- Helper for Proposition 6.2: the set of strictly positive multiples of a set is itself a cone. -/
lemma pos_smul_isCone (C : Set E) :
    IsCone ((Ioi (0 : ℝ) : Set ℝ) • C) := by
  -- One inclusion uses the unit scalar, and the other multiplies two positive scalars.
  refine Subset.antisymm ?_ ?_
  · intro x hx
    exact Set.mem_smul.mpr ⟨1, by simp, x, hx, by simp⟩
  · intro x hx
    rcases Set.mem_smul.mp hx with ⟨a, ha, y, hy, rfl⟩
    rcases Set.mem_smul.mp hy with ⟨b, hb, z, hz, rfl⟩
    exact Set.mem_smul.mpr ⟨a * b, by simpa using mul_pos ha hb, z, hz, by rw [smul_smul]⟩

/-- Helper for Proposition 6.2: a cone is stable under any fixed strictly positive scalar. -/
lemma smul_subset_of_isCone {K : Set E} (hK : IsCone K) {a : ℝ} (ha : 0 < a) :
    a • K ⊆ K := by
  -- Membership in `a • K` gives a positive scalar multiple of a point of `K`.
  intro x hx
  rcases Set.mem_smul_set.mp hx with ⟨y, hy, rfl⟩
  have hx' : a • y ∈ (Ioi (0 : ℝ) : Set ℝ) • K :=
    Set.mem_smul.mpr ⟨a, ha, y, hy, rfl⟩
  exact hK.symm ▸ hx'

-- Proof sketch: use the project definition of `cone`; the set `(Ioi (0 : ℝ) : Set ℝ) • C` is
-- itself a cone containing `C`, and every point of it already lies in `cone C` by closure of
-- cones under positive scalar multiplication.
/-- Proposition 6.2 (1): textbook clause (i). The conical hull `cone C` is exactly the set of
strictly positive real multiples of points of `C`. -/
theorem conicalHull_eq_pos_smul (C : Set E) :
    cone C = (Ioi (0 : ℝ) : Set ℝ) • C := by
  -- Minimality gives `cone C ⊆ ℝ_{++} C` once we show the target is a cone containing `C`.
  refine Subset.antisymm ?_ ?_
  · exact conicalHull_min (pos_smul_isCone C) fun x hx ↦
      Set.mem_smul.mpr ⟨1, by simp, x, hx, by simp⟩
  · -- The cone generated by `C` is already stable under positive scaling.
    intro x hx
    rcases Set.mem_smul.mp hx with ⟨a, ha, y, hy, rfl⟩
    exact smul_subset_of_isCone (isCone_conicalHull C) ha <|
      Set.smul_mem_smul_set (subset_conicalHull C hy)

/-- Helper for Proposition 6.2: on a convex set, the source conical hull agrees with the bundled
convex-cone hull. -/
lemma conicalHull_eq_convexConeHull_of_convex {C : Set E} (hC : Convex ℝ C) :
    cone C = (ConvexCone.hull ℝ C : Set E) := by
  -- Both sides describe the strictly positive scalar multiples of `C`.
  ext x
  rw [conicalHull_eq_pos_smul]
  change x ∈ (Ioi (0 : ℝ) : Set ℝ) • C ↔ x ∈ ConvexCone.hull ℝ C
  rw [ConvexCone.mem_hull_of_convex hC]
  constructor
  · rintro ⟨a, ha, y, hy, rfl⟩
    exact ⟨a, ha, Set.mem_smul_set.mpr ⟨y, hy, rfl⟩⟩
  · rintro ⟨a, ha, hx⟩
    rcases Set.mem_smul_set.mp hx with ⟨y, hy, rfl⟩
    exact Set.mem_smul.mpr ⟨a, ha, y, hy, rfl⟩

/-- Helper for Proposition 6.2: taking the convex hull of a cone preserves the cone property. -/
lemma convexHull_isCone_of_isCone {K : Set E} (hK : IsCone K) :
    IsCone (convexHull ℝ K) := by
  -- The easy inclusion uses the scalar `1`; the reverse inclusion uses `convexHull_smul`.
  refine Subset.antisymm ?_ ?_
  · intro x hx
    exact Set.mem_smul.mpr ⟨1, by simp, x, hx, by simp⟩
  · intro x hx
    rcases Set.mem_smul.mp hx with ⟨a, ha, y, hy, rfl⟩
    have hsubset : a • convexHull ℝ K ⊆ convexHull ℝ K := by
      calc
        a • convexHull ℝ K = convexHull ℝ (a • K) := by rw [← convexHull_smul]
        _ ⊆ convexHull ℝ K := convexHull_mono (smul_subset_of_isCone hK ha)
    exact hsubset (Set.smul_mem_smul_set hy)

-- Proof sketch: `cone (convexHull ℝ C)` is the smallest source cone containing the convex set
-- `convexHull ℝ C`, while `convexHull ℝ (cone C)` is a convex cone containing `C`; compare the
-- two inclusions using the universal properties of `cone` and `convexHull`.
/-- Proposition 6.2 (2): textbook clause (iii). Taking the conical hull after the convex hull
agrees with taking the convex hull after the conical hull. -/
theorem conicalHull_convexHull_eq_convexHull_conicalHull (C : Set E) :
    cone (convexHull ℝ C) = convexHull ℝ (cone C) := by
  refine Subset.antisymm ?_ ?_
  · -- The convex hull of a cone is still a cone, so minimality of `cone` applies.
    exact conicalHull_min (convexHull_isCone_of_isCone (isCone_conicalHull C))
      (convexHull_mono (subset_conicalHull C))
  · -- The target cone over `convexHull ℝ C` is convex, so minimality of `convexHull` applies.
    refine convexHull_min ?_ ?_
    · exact conicalHull_min (isCone_conicalHull (convexHull ℝ C))
        ((subset_convexHull ℝ C).trans (subset_conicalHull (convexHull ℝ C)))
    · simpa [conicalHull_eq_convexConeHull_of_convex (convex_convexHull ℝ C)] using
        (ConvexCone.hull ℝ (convexHull ℝ C)).convex

-- Proof sketch: Proposition 6.2 (2) identifies the source-facing construction
-- `cone (convexHull ℝ C)` with the smallest convex cone containing `C`, namely
-- `ConvexCone.hull ℝ C`.
/-- Bridge to the canonical owner: `cone (convexHull ℝ C)` is the underlying
set of the convex cone hull of `C`. -/
theorem conicalHull_convexHull_eq_convexConeHull (C : Set E) :
    cone (convexHull ℝ C) = (ConvexCone.hull ℝ C : Set E) := by
  -- First rewrite the source cone over a convex set as a bundled convex-cone hull.
  rw [conicalHull_eq_convexConeHull_of_convex (convex_convexHull ℝ C)]
  apply le_antisymm
  · -- `convexHull ℝ C` already lies in the convex-cone hull of `C`.
    exact ConvexCone.hull_min <|
      convexHull_min ConvexCone.subset_hull (ConvexCone.hull ℝ C).convex
  · -- Conversely, `C` sits inside `convexHull ℝ C`, so the minimal hull over `C` is smaller.
    exact ConvexCone.hull_min <|
      (subset_convexHull ℝ C).trans ConvexCone.subset_hull

end

section

variable {E : Type u} [TopologicalSpace E] [AddCommGroup E] [Module ℝ E]
  [ContinuousConstSMul ℝ E]

/-- Helper for Proposition 6.2: the closure of a cone is still a cone. -/
lemma closure_isCone_of_isCone {K : Set E} (hK : IsCone K) :
    IsCone (closure K) := by
  -- The unit scalar gives one inclusion, and continuity transports positive scaling through
  -- closure.
  refine Subset.antisymm ?_ ?_
  · intro x hx
    exact Set.mem_smul.mpr ⟨1, by simp, x, hx, by simp⟩
  · intro x hx
    have hsubset : (Ioi (0 : ℝ) : Set ℝ) • closure K ⊆ closure K := by
      calc
        (Ioi (0 : ℝ) : Set ℝ) • closure K ⊆ closure ((Ioi (0 : ℝ) : Set ℝ) • K) :=
          set_smul_closure_subset _ _
        _ = closure K := by rw [← hK]
    exact hsubset hx

-- Proof sketch: `closure (cone C)` is a closed cone containing `C`, so the minimality of
-- `closedConicalHull C` gives one inclusion. For the reverse inclusion, `closedConicalHull C`
-- contains `cone C`, hence also its closure.
/-- Proposition 6.2 (7): textbook clause (ii). The closure of `cone C` is its
closed conical hull. -/
theorem closure_conicalHull_eq_closedConicalHull (C : Set E) :
    closure (cone C) = closedConicalHull C := by
  refine Subset.antisymm ?_ ?_
  · -- `closedConicalHull C` is a closed cone containing `cone C`, so it contains its closure.
    exact closure_minimal
      (conicalHull_min (isCone_closedConicalHull C) (subset_closedConicalHull C))
      (isClosed_closedConicalHull C)
  · -- The closure of `cone C` is itself a closed cone containing `C`.
    exact closedConicalHull_min
      (closure_isCone_of_isCone (isCone_conicalHull C))
      isClosed_closure
      ((subset_conicalHull C).trans subset_closure)

end

section

variable {E : Type u} [TopologicalSpace E] [AddCommGroup E] [Module ℝ E]
  [ContinuousAdd E] [ContinuousConstSMul ℝ E]

-- Proof sketch: clause (ii) turns the closed conical hull of `convexHull ℝ C` into the closure of
-- `cone (convexHull ℝ C)`, and clause (iii) identifies that source-facing set with the
-- canonical convex cone hull of `C`; then rewrite the resulting set-level closure via
-- `ConvexCone.coe_closure`.
/-- Proposition 6.2 (8): textbook clause (iv). The closed conical hull of the convex hull of `C`
agrees with the closure of the canonical convex cone hull of `C`. -/
theorem closedConicalHull_convexHull_eq_closure_convexConeHull (C : Set E) :
    closedConicalHull (convexHull ℝ C) = ((ConvexCone.hull ℝ C).closure : Set E) := by
  -- Rewrite the closed source construction as the closure of the bundled convex-cone hull.
  calc
    closedConicalHull (convexHull ℝ C) = closure (cone (convexHull ℝ C)) := by
      symm
      exact closure_conicalHull_eq_closedConicalHull (convexHull ℝ C)
    _ = closure ((ConvexCone.hull ℝ C : Set E)) := by
      rw [conicalHull_convexHull_eq_convexConeHull]
    _ = ((ConvexCone.hull ℝ C).closure : Set E) := by
      rw [← ConvexCone.coe_closure]

end

end Set
