import Mathlib
import ConvexAnalysisMonotoneOperators_BauschkeCombettes_2017.Chap06.Definition_6_9

-- Declarations for this item will be appended below by the statement pipeline.

open Set
open scoped Pointwise

universe u v

variable {H : Type u} {K : Type v}
variable [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
variable [NormedAddCommGroup K] [InnerProductSpace ℝ K] [CompleteSpace K]

/-- Helper for Proposition 6.21: subtracting the singleton `{0}` leaves a set unchanged. -/
lemma sub_singleton_zero_eq_self_prop621 {E : Type*} [AddGroup E] (C : Set E) :
    C - ({(0 : E)} : Set E) = C := by
  ext x
  constructor
  · intro hx
    rcases Set.mem_sub.mp hx with ⟨u, hu, v, hv, huv⟩
    have hv0 : v = 0 := by
      simpa using hv
    have hux : u = x := by
      simpa [hv0] using huv
    simpa [hux] using hu
  · intro hx
    exact Set.mem_sub.mpr ⟨x, hx, 0, by simp, by simp⟩

/-- Helper for Proposition 6.21: for a convex set, the source-facing cone notation agrees with the
canonical cone of all positive multiples of points in the set. -/
lemma convexCone_hull_eq_toCone_prop621 {E : Type*} [AddCommGroup E] [Module ℝ E] {C : Set E}
    (hC_convex : Convex ℝ C) :
    (ConvexCone.hull ℝ C : Set E) = ((hC_convex.toCone C : ConvexCone ℝ E) : Set E) := by
  simpa [ConvexCone.hull] using
    congrArg (fun S : ConvexCone ℝ E => (S : Set E)) hC_convex.toCone_eq_sInf.symm

/-- Helper for Proposition 6.21: every conic hull lies in the closed linear span of the generating
set. -/
lemma cone_subset_topologicalClosure_span {E : Type*} [AddCommGroup E] [Module ℝ E]
    [TopologicalSpace E] [ContinuousAdd E] [ContinuousConstSMul ℝ E] (C : Set E) :
    cone C ⊆ ((Submodule.span ℝ C).topologicalClosure : Set E) := by
  have hsubset : C ⊆ ((Submodule.span ℝ C).topologicalClosure : Set E) := by
    intro x hx
    exact Submodule.closure_subset_topologicalClosure_span (s := C) (subset_closure hx)
  -- The closed linear span is itself a convex cone, so minimality of `cone C` gives the inclusion.
  simpa [Set.cone_def] using
    (ConvexCone.hull_min (C := ((Submodule.span ℝ C).topologicalClosure).toConvexCone) hsubset)

/-- Helper for Proposition 6.21: for a nonempty convex set, the origin lies in the strong relative
interior exactly when the conic hull equals the closed linear span. -/
lemma zero_mem_strongRelativeInterior_iff_cone_eq_closure_span_of_nonempty_convex
    {E : Type*} [AddCommGroup E] [Module ℝ E] [TopologicalSpace E]
    [ContinuousAdd E] [ContinuousConstSMul ℝ E]
    {C : Set E} (hC_nonempty : C.Nonempty) (hC_convex : Convex ℝ C) :
    (0 : E) ∈ sri C ↔ cone C = ((Submodule.span ℝ C).topologicalClosure : Set E) := by
  constructor
  · intro h0
    rcases Set.mem_strongRelativeInterior_iff.mp h0 with ⟨h0C, hcone⟩
    -- At the origin, the translated set `C - {0}` is just `C`.
    simpa [sub_singleton_zero_eq_self_prop621] using hcone
  · intro hcone
    obtain ⟨x, hx⟩ := hC_nonempty
    have htoCone :
        ((hC_convex.toCone C : ConvexCone ℝ E) : Set E) =
          ((Submodule.span ℝ C).topologicalClosure : Set E) := by
      calc
        ((hC_convex.toCone C : ConvexCone ℝ E) : Set E)
            = cone C := by
              simpa [Set.cone_def] using (convexCone_hull_eq_toCone_prop621 hC_convex).symm
        _ = ((Submodule.span ℝ C).topologicalClosure : Set E) := hcone
    have hx_closedSpan : x ∈ ((Submodule.span ℝ C).topologicalClosure : Set E) := by
      exact Submodule.closure_subset_topologicalClosure_span (s := C) (subset_closure hx)
    have hnegx_toCone : -x ∈ ((hC_convex.toCone C : ConvexCone ℝ E) : Set E) := by
      rw [htoCone]
      exact Submodule.neg_mem _ hx_closedSpan
    rcases hC_convex.mem_toCone.mp hnegx_toCone with ⟨c, hc, y, hy, hcy⟩
    obtain ⟨z, hz, hz_eq⟩ := hC_convex.exists_mem_add_smul_eq hx hy zero_le_one hc.le
    have hz_zero : z = 0 := by
      have hz_eq_zero : (1 + c) • z = 0 := by
        simpa [hcy] using hz_eq
      exact (smul_eq_zero.mp hz_eq_zero).resolve_left (by positivity)
    have h0C : (0 : E) ∈ C := by simpa [hz_zero] using hz
    refine (Set.mem_strongRelativeInterior_iff).2 ?_
    -- Once `0 ∈ C`, the defining cone/span identity is exactly `hcone`.
    refine ⟨h0C, ?_⟩
    simpa [sub_singleton_zero_eq_self_prop621] using hcone

-- Proof sketch: compare the cones generated by `D - L '' C` and by
-- `C ×ˢ D - (L.toLinearMap.graph : Set (H × K))`, then show each is a closed linear subspace
-- exactly when the other is, using the graph decomposition from the textbook proof.
/-- Proposition 6.21 (1): for nonempty convex sets `C` and `D`, the origin belongs to the strong
relative interior of `D - L '' C` exactly when the origin of the product space belongs to the
strong relative interior of `C ×ˢ D - gra L`. -/
theorem zero_mem_strongRelativeInterior_sub_image_iff_zero_mem_strongRelativeInterior_prod_sub_graph
    {C : Set H} {D : Set K} (hC_nonempty : C.Nonempty) (hD_nonempty : D.Nonempty)
    (hC_convex : Convex ℝ C) (hD_convex : Convex ℝ D) (L : H →L[ℝ] K) :
    (0 : K) ∈ sri (D - L '' C) ↔
      (0 : H × K) ∈ sri (C ×ˢ D - (L.toLinearMap.graph : Set (H × K))) := by
  let S : Set K := D - L '' C
  let T : Set (H × K) := C ×ˢ D - (L.toLinearMap.graph : Set (H × K))
  let Φ : H × K →L[ℝ] K :=
    (ContinuousLinearMap.snd ℝ H K) - L.comp (ContinuousLinearMap.fst ℝ H K)
  have hS_nonempty : S.Nonempty := by
    rcases hC_nonempty with ⟨x, hx⟩
    rcases hD_nonempty with ⟨y, hy⟩
    refine ⟨y - L x, ?_⟩
    exact Set.mem_sub.mpr ⟨y, hy, L x, ⟨x, hx, rfl⟩, rfl⟩
  have hS_convex : Convex ℝ S := by
    dsimp [S]
    exact hD_convex.sub (hC_convex.linear_image L.toLinearMap)
  have hT_nonempty : T.Nonempty := by
    rcases hC_nonempty with ⟨x, hx⟩
    rcases hD_nonempty with ⟨y, hy⟩
    refine ⟨(0, y - L x), ?_⟩
    refine Set.mem_sub.mpr ?_
    refine ⟨(x, y), ⟨hx, hy⟩, (x, L x), ?_, by ext <;> simp⟩
    simpa [LinearMap.mem_graph_iff]
  have hT_convex : Convex ℝ T := by
    dsimp [T]
    exact (hC_convex.prod hD_convex).sub (L.toLinearMap.graph.convex)
  have hPhi_image_T : Φ '' T ⊆ S := by
    rintro _ ⟨p, hp, rfl⟩
    rcases Set.mem_sub.mp hp with ⟨cd, hcd, z, hz, hp_eq⟩
    rcases hcd with ⟨hc, hd⟩
    have hz_graph : z.2 = L z.1 := by
      simpa [LinearMap.mem_graph_iff] using hz
    refine Set.mem_sub.mpr ⟨cd.2, hd, L cd.1, ⟨cd.1, hc, rfl⟩, ?_⟩
    have hp_fst : p.1 = cd.1 - z.1 := by simpa using (congrArg Prod.fst hp_eq).symm
    have hp_snd : p.2 = cd.2 - z.2 := by simpa using (congrArg Prod.snd hp_eq).symm
    dsimp [Φ]
    simp [hp_fst, hp_snd, hz_graph, sub_eq_add_neg, add_comm, add_left_comm, add_assoc]
  have hPhi_cone : ∀ p : H × K, p ∈ cone T ↔ Φ p ∈ cone S := by
    intro p
    constructor
    · intro hp
      rcases hT_convex.mem_toCone.mp
          (by simpa [Set.cone_def, convexCone_hull_eq_toCone_prop621 hT_convex] using hp) with
        ⟨γ, hγ, q, hq, rfl⟩
      have hPhi_q : Φ q ∈ S := hPhi_image_T ⟨q, hq, rfl⟩
      refine by
        simpa [Set.cone_def, convexCone_hull_eq_toCone_prop621 hS_convex, map_smul] using
          (hS_convex.mem_toCone.mpr ⟨γ, hγ, Φ q, hPhi_q, rfl⟩)
    · intro hp
      rcases hS_convex.mem_toCone.mp
          (by simpa [Set.cone_def, convexCone_hull_eq_toCone_prop621 hS_convex] using hp) with
        ⟨γ, hγ, w, hw, hw_eq⟩
      rcases Set.mem_sub.mp hw with ⟨y, hy, Lx, hx_im, hw_sub⟩
      rcases hx_im with ⟨x, hx, rfl⟩
      let z : H := x - (γ⁻¹ : ℝ) • p.1
      have hz_graph : (z, L z) ∈ (L.toLinearMap.graph : Set (H × K)) := by
        simpa [LinearMap.mem_graph_iff]
      have hq_mem : ((x, y) - (z, L z)) ∈ T := by
        refine Set.mem_sub.mpr ⟨(x, y), ⟨hx, hy⟩, (z, L z), hz_graph, rfl⟩
      have hsmul :
          γ • ((x, y) - (z, L z)) = p := by
        ext <;> dsimp [z, Φ] at *
        · have hxz : x - (x - (γ⁻¹ : ℝ) • p.1) = (γ⁻¹ : ℝ) • p.1 := by
            abel
          simpa [hxz, smul_smul, hγ.ne'] using rfl
        · have hw_eq' : γ • (y - L x) = p.2 - L p.1 := by
            simpa [hw_sub, hw_eq, map_smul, sub_eq_add_neg, add_comm, add_left_comm, add_assoc]
              using hw_eq
          have hz_expand : y - L z = (y - L x) + (γ⁻¹ : ℝ) • L p.1 := by
            dsimp [z]
            rw [map_sub, map_smul]
            abel
          calc
            γ • (y - L z)
                = γ • ((y - L x) + (γ⁻¹ : ℝ) • L p.1) := by
                    rw [hz_expand]
            _ = γ • (y - L x) + L p.1 := by
                    simpa [smul_add, smul_smul, hγ.ne'] using rfl
            _ = (p.2 - L p.1) + L p.1 := by rw [hw_eq']
            _ = p.2 := by
                    abel
      refine by
        simpa [Set.cone_def, convexCone_hull_eq_toCone_prop621 hT_convex] using
          (hT_convex.mem_toCone.mpr ⟨γ, hγ, (x, y) - (z, L z), hq_mem, hsmul⟩)
  have hInr_image_S : (ContinuousLinearMap.inr ℝ H K) '' S ⊆ T := by
    rintro _ ⟨w, hw, rfl⟩
    rcases Set.mem_sub.mp hw with ⟨y, hy, Lx, hx_im, hw_eq⟩
    rcases hx_im with ⟨x, hx, rfl⟩
    refine Set.mem_sub.mpr ⟨(x, y), ⟨hx, hy⟩, (x, L x), ?_, ?_⟩
    · simpa [LinearMap.mem_graph_iff]
    · ext <;> simp [hw_eq]
  have hInr_cone : ∀ w : K, (0, w) ∈ cone T ↔ w ∈ cone S := by
    intro w
    simpa [Φ] using (hPhi_cone (0, w))
  have hPhi_maps_closedSpan :
      Set.MapsTo Φ (((Submodule.span ℝ T).topologicalClosure : Set (H × K)))
        (((Submodule.span ℝ S).topologicalClosure : Set K)) := by
    have hPhi_maps_span :
        Set.MapsTo Φ (Submodule.span ℝ T : Set (H × K)) (Submodule.span ℝ S : Set K) := by
      intro p hp
      exact (Submodule.span_mono hPhi_image_T) <|
        (Submodule.image_span_subset_span (f := Φ.toLinearMap) (s := T)) ⟨p, hp, rfl⟩
    simpa [Submodule.topologicalClosure_coe] using Set.MapsTo.closure hPhi_maps_span Φ.continuous
  have hInr_maps_closedSpan :
      Set.MapsTo (ContinuousLinearMap.inr ℝ H K)
        (((Submodule.span ℝ S).topologicalClosure : Set K))
        (((Submodule.span ℝ T).topologicalClosure : Set (H × K))) := by
    have hInr_maps_span :
        Set.MapsTo (ContinuousLinearMap.inr ℝ H K)
          (Submodule.span ℝ S : Set K) (Submodule.span ℝ T : Set (H × K)) := by
      intro w hw
      exact (Submodule.span_mono hInr_image_S) <|
        (Submodule.image_span_subset_span
          (f := (ContinuousLinearMap.inr ℝ H K).toLinearMap) (s := S)) ⟨w, hw, rfl⟩
    simpa [Submodule.topologicalClosure_coe] using
      Set.MapsTo.closure hInr_maps_span (ContinuousLinearMap.inr ℝ H K).continuous
  -- The proof now compares the closed linear span conditions through the two linear maps `Φ` and
  -- `w ↦ (0, w)`.
  rw [zero_mem_strongRelativeInterior_iff_cone_eq_closure_span_of_nonempty_convex hS_nonempty hS_convex,
    zero_mem_strongRelativeInterior_iff_cone_eq_closure_span_of_nonempty_convex hT_nonempty hT_convex]
  constructor
  · intro hS_cone
    apply Subset.antisymm
    · exact cone_subset_topologicalClosure_span T
    · intro p hp
      have hPhi_p :
          Φ p ∈ ((Submodule.span ℝ S).topologicalClosure : Set K) := hPhi_maps_closedSpan hp
      have hPhi_cone_p : Φ p ∈ cone S := by
        rw [hS_cone]
        exact hPhi_p
      exact (hPhi_cone p).mpr hPhi_cone_p
  · intro hT_cone
    apply Subset.antisymm
    · exact cone_subset_topologicalClosure_span S
    · intro w hw
      have hInr_w :
          (0, w) ∈ ((Submodule.span ℝ T).topologicalClosure : Set (H × K)) :=
        hInr_maps_closedSpan hw
      have hInr_cone_w : (0, w) ∈ cone T := by
        rw [hT_cone]
        exact hInr_w
      exact (hInr_cone w).mp hInr_cone_w

section

variable {A C : Set H} {B D : Set K} (L : H →L[ℝ] K)

-- Proof sketch: follow the inclusion chain from the textbook proof to identify
-- `cone (D - L '' C)` with the closed linear span of `D - L '' C`, then use the characterization
-- of `sri` at the origin from `Definition_6.9`.
/-- Proposition 6.21 (2): if `A ⊆ C ⊆ closure (convexHull ℝ A)` and
`B ⊆ D ⊆ closure (convexHull ℝ B)`, and if `cone (B - L '' A)` equals the closed span of
`B - L '' A`, then the origin belongs to the strong relative interior of `D - L '' C`. -/
theorem zero_mem_strongRelativeInterior_sub_image_of_subset_closure_convexHull
    (hC_nonempty : C.Nonempty) (hD_nonempty : D.Nonempty)
    (hC_convex : Convex ℝ C) (hD_convex : Convex ℝ D) (hAC : A ⊆ C)
    (hC_subset : C ⊆ closure (convexHull ℝ A)) (hBD : B ⊆ D)
    (hD_subset : D ⊆ closure (convexHull ℝ B))
    (hcone :
      cone (B - L '' A) =
        ((Submodule.span ℝ (B - L '' A)).topologicalClosure : Set K)) :
    (0 : K) ∈ sri (D - L '' C) := by
  let S : Set K := D - L '' C
  let U : Submodule ℝ K := (Submodule.span ℝ (B - L '' A)).topologicalClosure
  let Ψ : H × K →L[ℝ] K :=
    (ContinuousLinearMap.snd ℝ H K) - L.comp (ContinuousLinearMap.fst ℝ H K)
  have hS_nonempty : S.Nonempty := by
    rcases hC_nonempty with ⟨x, hx⟩
    rcases hD_nonempty with ⟨y, hy⟩
    refine ⟨y - L x, ?_⟩
    exact Set.mem_sub.mpr ⟨y, hy, L x, ⟨x, hx, rfl⟩, rfl⟩
  have hS_convex : Convex ℝ S := by
    dsimp [S]
    exact hD_convex.sub (hC_convex.linear_image L.toLinearMap)
  have hBA_subset_S : B - L '' A ⊆ S := by
    intro w hw
    rcases Set.mem_sub.mp hw with ⟨y, hy, Lx, hx_im, hw_eq⟩
    rcases hx_im with ⟨x, hx, rfl⟩
    exact Set.mem_sub.mpr ⟨y, hBD hy, L x, ⟨x, hAC hx, rfl⟩, hw_eq⟩
  have hPsi_image_prod :
      Ψ '' (A ×ˢ B) = B - L '' A := by
    ext w
    constructor
    · rintro ⟨p, hp, rfl⟩
      rcases hp with ⟨hx, hy⟩
      exact Set.mem_sub.mpr ⟨p.2, hy, L p.1, ⟨p.1, hx, rfl⟩, by simp [Ψ]⟩
    · intro hw
      rcases Set.mem_sub.mp hw with ⟨y, hy, Lx, hx_im, hw_eq⟩
      rcases hx_im with ⟨x, hx, rfl⟩
      refine ⟨(x, y), ⟨hx, hy⟩, ?_⟩
      simpa [Ψ, hw_eq]
  have hS_subset_closureHull : S ⊆ closure (convexHull ℝ (B - L '' A)) := by
    intro w hw
    rcases Set.mem_sub.mp hw with ⟨y, hy, Lx, hx_im, hw_eq⟩
    rcases hx_im with ⟨x, hx, rfl⟩
    have hx_cl : x ∈ closure (convexHull ℝ A) := hC_subset hx
    have hy_cl : y ∈ closure (convexHull ℝ B) := hD_subset hy
    have hprod :
        (x, y) ∈ closure (convexHull ℝ A ×ˢ convexHull ℝ B) := by
      rw [closure_prod_eq]
      exact ⟨hx_cl, hy_cl⟩
    have hmaps :
        Set.MapsTo Ψ (convexHull ℝ A ×ˢ convexHull ℝ B)
          (Ψ '' (convexHull ℝ A ×ˢ convexHull ℝ B)) := by
      intro p hp'
      exact Set.mem_image_of_mem Ψ hp'
    have hw_closure : y - L x ∈ closure (Ψ '' (convexHull ℝ A ×ˢ convexHull ℝ B)) := by
      exact (Set.MapsTo.closure hmaps Ψ.continuous) hprod
    have himageHull :
        Ψ '' (convexHull ℝ A ×ˢ convexHull ℝ B) = convexHull ℝ (B - L '' A) := by
      calc
        Ψ '' (convexHull ℝ A ×ˢ convexHull ℝ B)
            = Ψ '' convexHull ℝ (A ×ˢ B) := by
                rw [← convexHull_prod]
        _ = convexHull ℝ (Ψ '' (A ×ˢ B)) := by
                simpa using (LinearMap.image_convexHull Ψ.toLinearMap (A ×ˢ B))
        _ = convexHull ℝ (B - L '' A) := by
                rw [hPsi_image_prod]
    simpa [himageHull, hw_eq]
      using hw_closure
  have hBA_subset_U : B - L '' A ⊆ (U : Set K) := by
    intro w hw
    have hw_cone : w ∈ cone (B - L '' A) := by
      simpa [Set.cone_def] using (ConvexCone.subset_hull (s := B - L '' A) hw)
    have hw_closed :
        w ∈ ((Submodule.span ℝ (B - L '' A)).topologicalClosure : Set K) := by
      rwa [← hcone]
    simpa [U] using hw_closed
  have hclosureHull_subset_U : closure (convexHull ℝ (B - L '' A)) ⊆ (U : Set K) := by
    apply closure_minimal
    · exact convexHull_min hBA_subset_U U.convex
    · exact Submodule.isClosed_topologicalClosure _
  have hS_subset_U : S ⊆ (U : Set K) := fun w hw ↦ hclosureHull_subset_U (hS_subset_closureHull hw)
  have hclosedSpanS_le_U :
      ((Submodule.span ℝ S).topologicalClosure : Set K) ⊆ (U : Set K) := by
    exact Submodule.topologicalClosure_minimal _ (Submodule.span_le.2 hS_subset_U)
      (Submodule.isClosed_topologicalClosure _)
  have hBA_subset_coneS : B - L '' A ⊆ cone S := by
    exact hBA_subset_S.trans (by
      simpa [Set.cone_def] using (ConvexCone.subset_hull (s := S)))
  have hconeBA_le_coneS : cone (B - L '' A) ⊆ cone S := by
    simpa [Set.cone_def] using
      (ConvexCone.hull_min (C := ConvexCone.hull ℝ S) hBA_subset_coneS)
  have hU_le_coneS : (U : Set K) ⊆ cone S := by
    intro w hw
    have hw_closed :
        w ∈ ((Submodule.span ℝ (B - L '' A)).topologicalClosure : Set K) := by
      simpa [U] using hw
    have hw_cone : w ∈ cone (B - L '' A) := by
      rw [hcone]
      exact hw_closed
    exact hconeBA_le_coneS hw_cone
  have hS_cone :
      cone S = ((Submodule.span ℝ S).topologicalClosure : Set K) := by
    apply Subset.antisymm
    · exact cone_subset_topologicalClosure_span S
    · exact hclosedSpanS_le_U.trans hU_le_coneS
  -- The containment chain recovers the defining closed-span identity for `sri` at the origin.
  exact (zero_mem_strongRelativeInterior_iff_cone_eq_closure_span_of_nonempty_convex
    hS_nonempty hS_convex).mpr hS_cone

-- Proof sketch: first apply part (2) to obtain `0 ∈ sri (D - L '' C)`, then invoke part (1) to
-- transfer the statement to the product-space difference with the graph of `L`.
/-- Proposition 6.21 (3): under the same hypotheses as part (2), the origin of `H × K` belongs to
the strong relative interior of `C ×ˢ D - gra L`. -/
theorem zero_mem_strongRelativeInterior_prod_sub_graph_of_subset_closure_convexHull
    (hC_nonempty : C.Nonempty) (hD_nonempty : D.Nonempty)
    (hC_convex : Convex ℝ C) (hD_convex : Convex ℝ D) (hAC : A ⊆ C)
    (hC_subset : C ⊆ closure (convexHull ℝ A)) (hBD : B ⊆ D)
    (hD_subset : D ⊆ closure (convexHull ℝ B))
    (hcone :
      cone (B - L '' A) =
        ((Submodule.span ℝ (B - L '' A)).topologicalClosure : Set K)) :
    (0 : H × K) ∈ sri (C ×ˢ D - (L.toLinearMap.graph : Set (H × K))) := by
  have hsub :
      (0 : K) ∈ sri (D - L '' C) :=
    zero_mem_strongRelativeInterior_sub_image_of_subset_closure_convexHull
      (L := L) hC_nonempty hD_nonempty hC_convex hD_convex hAC hC_subset hBD hD_subset hcone
  -- Part (1) transfers the strong-relative-interior statement along the graph reformulation.
  exact
    (zero_mem_strongRelativeInterior_sub_image_iff_zero_mem_strongRelativeInterior_prod_sub_graph
      hC_nonempty hD_nonempty hC_convex hD_convex L).mp hsub

end
