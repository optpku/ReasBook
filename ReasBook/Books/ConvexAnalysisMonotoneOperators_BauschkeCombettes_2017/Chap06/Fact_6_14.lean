import ConvexAnalysisMonotoneOperators_BauschkeCombettes_2017.Chap03.Proposition_3_45

-- Declarations for this item will be appended below by the statement pipeline.

open Set Topology
open scoped Pointwise

universe u v

section

variable {H : Type u} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]

/-- Helper for Fact 6.14: translating by `x` and then taking a preimage is the same as
subtracting the singleton `{x}`. -/
lemma addLeft_preimage_eq_sub_singleton (C : Set H) (x : H) :
    (Homeomorph.addLeft x) ⁻¹' C = C - ({x} : Set H) := by
  ext y
  constructor
  · intro hy
    refine Set.mem_sub.mpr ?_
    refine ⟨x + y, hy, x, by simp, ?_⟩
    simp [sub_eq_add_neg, add_assoc, add_left_comm, add_comm]
  · rintro ⟨u, hu, v, hv, huv⟩
    have huv' : u = v + y := by
      simpa [sub_eq_add_neg, add_assoc] using congrArg (fun z => v + z) huv
    rcases Set.mem_singleton_iff.mp hv with rfl
    simpa [huv'] using hu

/-- Helper for Fact 6.14: the cone generated by a submodule is the submodule itself. -/
lemma cone_eq_self_of_submodule (V : Submodule ℝ H) :
    cone (V : Set H) = (V : Set H) := by
  ext y
  constructor
  · intro hy
    -- The convex-cone hull is contained in any convex cone containing the submodule.
    exact ConvexCone.hull_min (C := V.toConvexCone) (fun z hz ↦ hz) hy
  · intro hy
    -- Every vector of the submodule already belongs to the cone it generates.
    exact ConvexCone.subset_hull hy

omit [CompleteSpace H] in
/-- Helper for Fact 6.14: for a convex set, the source-facing cone hull agrees with the canonical
positive-multiple cone from mathlib. -/
lemma cone_eq_toCone_of_convex_aux {C : Set H} (hC_convex : Convex ℝ C) :
    cone C = ((hC_convex.toCone C : ConvexCone ℝ H) : Set H) := by
  have hHull :
      (ConvexCone.hull ℝ C : Set H) = ((hC_convex.toCone C : ConvexCone ℝ H) : Set H) := by
    simpa [ConvexCone.hull] using
      congrArg (fun S : ConvexCone ℝ H => (S : Set H)) hC_convex.toCone_eq_sInf.symm
  simpa [Set.cone_def] using hHull

/-- Helper for Fact 6.14: for a convex set with nonempty interior, the origin is an interior point
exactly when its cone hull is the whole ambient space. -/
lemma zero_mem_interior_iff_cone_eq_univ_of_convex_nonempty_interior_aux {S : Set H}
    (hS_convex : Convex ℝ S) (hS_int_nonempty : (interior S).Nonempty) (_h0 : (0 : H) ∈ S) :
    (0 : H) ∈ interior S ↔ cone S = (univ : Set H) := by
  constructor
  · intro h0_int
    have hmem : S ∈ 𝓝 (0 : H) := mem_interior_iff_mem_nhds.mp h0_int
    rcases Metric.mem_nhds_iff.mp hmem with ⟨ε, hε, hball⟩
    ext y
    constructor
    · intro _
      simp
    · intro _
      let t : ℝ := ε / (1 + ‖y‖)
      have ht : 0 < t := by
        dsimp [t]
        positivity
      have hty_norm : ‖t • y‖ < ε := by
        have hden : 0 < 1 + ‖y‖ := by positivity
        have hy_lt : ‖y‖ < 1 + ‖y‖ := by
          nlinarith [norm_nonneg y]
        have hfrac_lt : ‖y‖ / (1 + ‖y‖) < (1 : ℝ) := by
          exact (div_lt_iff₀ hden).2 <| by simpa using hy_lt
        have hlt' : ε / (1 + ‖y‖) * ‖y‖ < ε := by
          have hε_pos : 0 < ε := hε
          simpa [mul_comm, mul_left_comm, mul_assoc, div_eq_mul_inv] using
            mul_lt_mul_of_pos_left hfrac_lt hε_pos
        have hlt : t * ‖y‖ < ε := by
          simpa [t] using hlt'
        simpa [norm_smul, Real.norm_eq_abs, abs_of_pos ht] using hlt
      have hty_mem : t • y ∈ S := hball <| by
        simpa [Metric.mem_ball, dist_eq_norm] using hty_norm
      rw [cone_eq_toCone_of_convex_aux hS_convex]
      exact (Convex.mem_toCone hS_convex).2
        ⟨1 / t, by positivity, t • y, hty_mem, by
          rw [one_div, smul_smul, inv_mul_cancel₀ ht.ne', one_smul]⟩
  · intro hcone
    rcases hS_int_nonempty with ⟨z, hz⟩
    have hnegz : -z ∈ cone S := by
      simpa [hcone]
    rw [cone_eq_toCone_of_convex_aux hS_convex] at hnegz
    rcases (Convex.mem_toCone hS_convex).1 hnegz with ⟨c, hc, y, hy, hcy⟩
    have ha : 0 ≤ c / (c + 1) := by positivity
    have hb : 0 < 1 / (c + 1) := by positivity
    have hab : c / (c + 1) + 1 / (c + 1) = (1 : ℝ) := by
      field_simp [hc.ne']
    have hcombo :
        (c / (c + 1)) • y + (1 / (c + 1)) • z ∈ interior S :=
      hS_convex.combo_self_interior_mem_interior hy hz ha hb hab
    have hzero :
        (c / (c + 1)) • y + (1 / (c + 1)) • z = (0 : H) := by
      calc
        (c / (c + 1)) • y + (1 / (c + 1)) • z
            = (1 / (c + 1)) • (c • y) + (1 / (c + 1)) • z := by
                rw [div_eq_mul_inv, one_div, smul_smul, mul_comm c ((c + 1)⁻¹)]
        _ = (1 / (c + 1)) • (c • y + z) := by rw [smul_add]
        _ = (0 : H) := by rw [hcy, neg_add_cancel, smul_zero]
    exact hzero ▸ hcombo

/-- Helper for Fact 6.14: translating a convex set with nonempty interior turns interior
membership at `x` into the cone criterion for `C - {x}`. -/
lemma mem_interior_iff_cone_translate_eq_univ_of_convex_nonempty_interior_aux {C : Set H}
    (hC_convex : Convex ℝ C) (hC_int_nonempty : (interior C).Nonempty) {x : H} (hx : x ∈ C) :
    x ∈ interior C ↔ cone (C - ({x} : Set H)) = (univ : Set H) := by
  let S : Set H := (Homeomorph.addLeft x) ⁻¹' C
  have hS_eq : S = C - ({x} : Set H) := addLeft_preimage_eq_sub_singleton C x
  have hS_convex : Convex ℝ S := by
    simpa [S, add_comm] using hC_convex.translate_preimage_right x
  have hS_int_nonempty : (interior S).Nonempty := by
    rcases hC_int_nonempty with ⟨z, hz⟩
    refine ⟨z - x, ?_⟩
    have hz_pre : z - x ∈ (Homeomorph.addLeft x) ⁻¹' interior C := by
      simpa [sub_eq_add_neg, add_assoc] using hz
    have hz_int : z - x ∈ interior ((Homeomorph.addLeft x) ⁻¹' C) := by
      rwa [(Homeomorph.addLeft x).preimage_interior C] at hz_pre
    simpa [S] using hz_int
  have h0S : (0 : H) ∈ S := by
    simpa [S] using hx
  have hzero :
      (0 : H) ∈ interior S ↔ cone S = (univ : Set H) :=
    zero_mem_interior_iff_cone_eq_univ_of_convex_nonempty_interior_aux hS_convex hS_int_nonempty h0S
  constructor
  · intro hx_int
    have h0_int : (0 : H) ∈ interior S := by
      have hx_pre : (0 : H) ∈ (Homeomorph.addLeft x) ⁻¹' interior C := by
        simpa [S] using hx_int
      rwa [(Homeomorph.addLeft x).preimage_interior C] at hx_pre
    simpa [hS_eq] using hzero.mp h0_int
  · intro hcone
    have h0_int : (0 : H) ∈ interior S := by
      have hconeS : cone S = (univ : Set H) := by simpa [hS_eq] using hcone
      exact hzero.mpr hconeS
    have hx_img : x ∈ (Homeomorph.addLeft x) '' interior S := ⟨0, h0_int, by simp⟩
    have himageS : (Homeomorph.addLeft x) '' S = C := by
      simpa [S] using image_preimage_eq C (Homeomorph.addLeft x).surjective
    have himageInt : (Homeomorph.addLeft x) '' interior S = interior C := by
      rw [(Homeomorph.addLeft x).image_interior, himageS]
    rw [← himageInt]
    exact hx_img

/-- Helper for Fact 6.14: a convex set with nonempty interior has `interior = core`. -/
lemma interior_eq_core_of_convex_nonempty_interior_aux {C : Set H} (hC_convex : Convex ℝ C)
    (hC_int_nonempty : (interior C).Nonempty) :
    interior C = Set.core C := by
  ext x
  constructor
  · intro hx
    refine Set.mem_core_iff.mpr ⟨interior_subset hx, ?_⟩
    exact (mem_interior_iff_cone_translate_eq_univ_of_convex_nonempty_interior_aux
      hC_convex hC_int_nonempty (interior_subset hx)).mp hx
  · intro hx
    rcases Set.mem_core_iff.mp hx with ⟨hxC, hcone⟩
    exact (mem_interior_iff_cone_translate_eq_univ_of_convex_nonempty_interior_aux
      hC_convex hC_int_nonempty hxC).mpr hcone

/-- Helper for Fact 6.14: membership in the intrinsic interior is the same as interior membership
of the translated set inside the direction of `affineSpan ℝ C`. -/
lemma intrinsicInterior_mem_iff_zero_mem_interior_translated_direction_preimage {C : Set H}
    {x : H} (hx : x ∈ C) :
    let V : Submodule ℝ H := (_root_.affineSpan ℝ C).direction
    let T : Set V := ((↑) ⁻¹' (C - ({x} : Set H)))
    x ∈ intrinsicInterior ℝ C ↔ (0 : V) ∈ interior T := by
  haveI : Nonempty C := ⟨x, hx⟩
  let xA : _root_.affineSpan ℝ C := ⟨x, subset_affineSpan ℝ C hx⟩
  letI : Nonempty (_root_.affineSpan ℝ C) := ⟨xA⟩
  let S : Set (_root_.affineSpan ℝ C) := ((↑) ⁻¹' C)
  let T : Set ((_root_.affineSpan ℝ C).direction) := ((↑) ⁻¹' (C - ({x} : Set H)))
  let e : ((_root_.affineSpan ℝ C).direction) ≃ₜ (_root_.affineSpan ℝ C) :=
    (AffineIsometryEquiv.vaddConst ℝ xA).toHomeomorph
  have hzero : e (0 : (_root_.affineSpan ℝ C).direction) = xA := by
    -- The translated origin maps back to the chosen base point in the affine span.
    apply Subtype.ext
    change ↑((0 : (_root_.affineSpan ℝ C).direction) +ᵥ xA) = x
    simp [xA]
  have hmem : x ∈ intrinsicInterior ℝ C ↔ xA ∈ interior S := by
    constructor
    · intro hxInt
      -- Unfold the intrinsic-interior image and identify the unique affine-span point above `x`.
      rcases hxInt with ⟨y, hy, hyx⟩
      have hy_eq : y = xA := by
        apply Subtype.ext
        simpa [xA] using hyx
      simpa [S] using hy_eq ▸ hy
    · intro hxA
      -- The canonical affine-span representative of `x` witnesses intrinsic-interior membership.
      exact ⟨xA, by simpa [S] using hxA, by simp [xA]⟩
  have hcoee (v : (_root_.affineSpan ℝ C).direction) :
      (((e v) : _root_.affineSpan ℝ C) : H) =
        ((v : ((_root_.affineSpan ℝ C).direction)) : H) + x := by
    -- In ambient coordinates, `vaddConst` is just translation by `x`.
    change ↑(v +ᵥ xA) = ↑v + x
    simp [xA]
  have hpre : e ⁻¹' S = T := by
    -- Pulling `C` back along the translation homeomorphism gives the textbook translate `C - {x}`.
    ext v
    rw [show (v ∈ e ⁻¹' S) ↔ (((e v) : _root_.affineSpan ℝ C) : H) ∈ C by rfl]
    rw [hcoee]
    simp [T, sub_eq_add_neg, add_comm]
  have hhomeo : xA ∈ interior S ↔ (0 : (_root_.affineSpan ℝ C).direction) ∈ interior T := by
    constructor
    · intro hxA
      -- Transport interior membership from `xA` to the origin through the translation homeomorphism.
      have hpreimage : (0 : (_root_.affineSpan ℝ C).direction) ∈ e ⁻¹' interior S := by
        simpa [hzero] using hxA
      rw [e.preimage_interior, hpre] at hpreimage
      simpa using hpreimage
    · intro h0
      -- Transport the origin interior point back to `xA`.
      have hpreimage : (0 : (_root_.affineSpan ℝ C).direction) ∈ e ⁻¹' interior S := by
        rw [e.preimage_interior, hpre]
        simpa using h0
      simpa [hzero] using hpreimage
  exact hmem.trans hhomeo

/-- Helper for Fact 6.14: in finite dimension, the translated copy of a nonempty convex set has
nonempty interior inside the direction of its affine span. -/
lemma interior_nonempty_translated_direction_preimage_of_finiteDimensional {C : Set H}
    [FiniteDimensional ℝ H] (hC_convex : Convex ℝ C) {x : H} (hx : x ∈ C) :
    let V : Submodule ℝ H := (_root_.affineSpan ℝ C).direction
    let T : Set V := ((↑) ⁻¹' (C - ({x} : Set H)))
    (interior T).Nonempty := by
  let V : Submodule ℝ H := (_root_.affineSpan ℝ C).direction
  let T : Set V := ((↑) ⁻¹' (C - ({x} : Set H)))
  have htranslate_convex : Convex ℝ (C - ({x} : Set H)) := by
    -- Translation preserves convexity of the source set.
    simpa [sub_eq_add_neg, add_comm] using hC_convex.translate (-x)
  have hT_convex : Convex ℝ T := by
    -- Pull the translated convex set back to the direction subtype.
    simpa [T] using htranslate_convex.affine_preimage V.subtype.toAffineMap
  have h0T : (0 : V) ∈ T := by
    -- The origin corresponds to the trivial translate of `x`.
    change (0 : H) ∈ C - ({x} : Set H)
    exact Set.mem_sub.mpr ⟨x, hx, x, by simp, sub_self x⟩
  have hVeq : V = Submodule.span ℝ (C - ({x} : Set H)) := by
    -- The direction of the affine span is exactly the span of the translate by `x`.
    calc
      V = vectorSpan ℝ C := by
        rw [show V = (_root_.affineSpan ℝ C).direction by rfl, direction_affineSpan]
      _ = Submodule.span ℝ (C - ({x} : Set H)) := by
        simpa [vsub_eq_sub, sub_eq_add_neg] using
          (vectorSpan_eq_span_vsub_set_right (k := ℝ) (s := C) (p := x) hx)
  have himage : V.subtype '' T = C - ({x} : Set H) := by
    -- The subtype coercion identifies the translated direction copy with the ambient translate.
    ext y
    constructor
    · rintro ⟨v, hv, rfl⟩
      exact hv
    · intro hy
      have hyV : y ∈ V := by
        simpa [hVeq] using
          (Submodule.subset_span hy : y ∈ Submodule.span ℝ (C - ({x} : Set H)))
      exact ⟨⟨y, hyV⟩, hy, rfl⟩
  have hVimage : V = Submodule.span ℝ (V.subtype '' T) := by
    -- The direction is spanned by the translated copy itself.
    rw [himage]
    exact hVeq
  have hspanTopLe : (⊤ : Submodule ℝ V) ≤ Submodule.span ℝ T := by
    intro v hv
    have hvSpan : (v : H) ∈ Submodule.span ℝ (V.subtype '' T) := by
      simpa [hVimage] using v.property
    have hvMap : (v : H) ∈ Submodule.map V.subtype (Submodule.span ℝ T) := by
      rw [← Submodule.span_image (f := V.subtype) (s := T)]
      exact hvSpan
    rcases Submodule.mem_map.1 hvMap with ⟨w, hw, hwv⟩
    have hw_eq : w = v := by
      apply Subtype.ext
      exact hwv
    simpa [hw_eq] using hw
  have hspanTop : Submodule.span ℝ T = ⊤ := top_le_iff.mp hspanTopLe
  have hvectorTop : vectorSpan ℝ T = ⊤ := by
    -- Because the translated set contains the origin, its affine span is controlled by its span.
    rw [vectorSpan_eq_span_vsub_set_right (k := ℝ) (s := T) (p := (0 : V)) h0T]
    simpa [vsub_eq_sub] using hspanTop
  have haffTop : affineSpan ℝ T = ⊤ := by
    exact
      (AffineSubspace.affineSpan_eq_top_iff_vectorSpan_eq_top_of_nonempty ℝ V V ⟨0, h0T⟩).2
        hvectorTop
  exact (Convex.interior_nonempty_iff_affineSpan_eq_top hT_convex).2 haffTop

/-- Helper for Fact 6.14: core membership at the origin of the translated direction copy is
exactly the source-facing cone-equals-direction criterion. -/
lemma zero_mem_core_translated_direction_preimage_iff_cone_eq_direction {C : Set H}
    (hC_convex : Convex ℝ C) {x : H} (hx : x ∈ C) :
    let V : Submodule ℝ H := (_root_.affineSpan ℝ C).direction
    let T : Set V := ((↑) ⁻¹' (C - ({x} : Set H)))
    (0 : V) ∈ Set.core T ↔ cone (C - ({x} : Set H)) = (V : Set H) := by
  let V : Submodule ℝ H := (_root_.affineSpan ℝ C).direction
  let T : Set V := ((↑) ⁻¹' (C - ({x} : Set H)))
  have hVeq : V = Submodule.span ℝ (C - ({x} : Set H)) := by
    -- Reuse the canonical identification between direction and translated span.
    calc
      V = vectorSpan ℝ C := by
        rw [show V = (_root_.affineSpan ℝ C).direction by rfl, direction_affineSpan]
      _ = Submodule.span ℝ (C - ({x} : Set H)) := by
        simpa [vsub_eq_sub, sub_eq_add_neg] using
          (vectorSpan_eq_span_vsub_set_right (k := ℝ) (s := C) (p := x) hx)
  have htranslate_convex : Convex ℝ (C - ({x} : Set H)) := by
    -- Translation keeps the ambient cone computation in the convex world.
    simpa [sub_eq_add_neg, add_comm] using hC_convex.translate (-x)
  have hT_convex : Convex ℝ T := by
    simpa [T] using htranslate_convex.affine_preimage V.subtype.toAffineMap
  have h0T : (0 : V) ∈ T := by
    change (0 : H) ∈ C - ({x} : Set H)
    exact Set.mem_sub.mpr ⟨x, hx, x, by simp, sub_self x⟩
  have hTsub : T - ({(0 : V)} : Set V) = T := by
    -- Subtracting the origin does not change the translated copy.
    ext v
    constructor
    · rintro ⟨u, hu, w, hw, huw⟩
      rcases Set.mem_singleton_iff.mp hw with rfl
      have huv : u = v := by simpa using huw
      simpa [huv] using hu
    · intro hv
      exact Set.mem_sub.mpr ⟨v, hv, 0, by simp, by simp⟩
  have hsubset : cone (C - ({x} : Set H)) ⊆ (V : Set H) := by
    -- The source cone stays inside the direction generated by the translate.
    intro y hy
    rw [hVeq]
    exact
      ConvexCone.hull_min
        (C := (Submodule.span ℝ (C - ({x} : Set H))).toConvexCone)
        (fun z hz ↦ Submodule.subset_span hz) hy
  have hcone_mem : ∀ {v : V}, v ∈ cone T ↔ ((v : H) ∈ cone (C - ({x} : Set H))) := by
    intro v
    rw [cone_eq_toCone_of_convex_aux hT_convex, cone_eq_toCone_of_convex_aux htranslate_convex]
    constructor
    · intro hv
      rcases (Convex.mem_toCone hT_convex).1 hv with ⟨c, hc, y, hy, rfl⟩
      exact (Convex.mem_toCone htranslate_convex).2 ⟨c, hc, (y : H), hy, rfl⟩
    · intro hv
      rcases (Convex.mem_toCone htranslate_convex).1 hv with ⟨c, hc, y, hy, hyv⟩
      have hyV : y ∈ V := by
        simpa [hVeq] using
          (Submodule.subset_span hy : y ∈ Submodule.span ℝ (C - ({x} : Set H)))
      refine (Convex.mem_toCone hT_convex).2 ?_
      refine ⟨c, hc, ⟨y, hyV⟩, hy, ?_⟩
      apply Subtype.ext
      simpa using hyv
  have hcone : cone T = (univ : Set V) ↔ cone (C - ({x} : Set H)) = (V : Set H) := by
    constructor
    · intro hconeT
      apply Set.Subset.antisymm hsubset
      intro y hyV
      let yV : V := ⟨y, hyV⟩
      have hyV_cone : yV ∈ cone T := by simpa [hconeT]
      exact hcone_mem.1 hyV_cone
    · intro hconeV
      ext v
      constructor
      · intro _
        simp
      · intro _
        have hvCone : (v : H) ∈ cone (C - ({x} : Set H)) := by
          rw [hconeV]
          exact v.property
        exact hcone_mem.2 hvCone
  have hcore : (0 : V) ∈ Set.core T ↔ cone (C - ({x} : Set H)) = (V : Set H) := by
    rw [Set.mem_core_iff]
    constructor
    · rintro ⟨_, hconeT⟩
      exact hcone.1 <| by simpa [hTsub] using hconeT
    · intro hconeV
      refine ⟨h0T, ?_⟩
      simpa [hTsub] using hcone.2 hconeV
  simpa [V, T] using hcore

/-- Helper for Fact 6.14: the cone of the translated subtype preimage matches the ambient cone of
`C - {x}` under the subtype coercion. -/
lemma mem_cone_translated_span_preimage_iff_mem_cone_translate {C : Set H}
    (hC_convex : Convex ℝ C) {x : H} (hx : x ∈ C) :
    let V : Submodule ℝ H := Submodule.span ℝ (C - ({x} : Set H))
    let T : Set V := ((↑) ⁻¹' (C - ({x} : Set H)))
    ∀ {v : V}, v ∈ cone T ↔ ((v : H) ∈ cone (C - ({x} : Set H))) := by
  let V : Submodule ℝ H := Submodule.span ℝ (C - ({x} : Set H))
  let T : Set V := ((↑) ⁻¹' (C - ({x} : Set H)))
  have htranslate_convex : Convex ℝ (C - ({x} : Set H)) := by
    -- Translate the convex set by `-x` so the source-facing difference set stays convex.
    simpa [sub_eq_add_neg, add_comm] using hC_convex.translate (-x)
  have hT_convex : Convex ℝ T := by
    -- Pull convexity back along the subtype inclusion of the translated span.
    simpa [T] using htranslate_convex.affine_preimage V.subtype.toAffineMap
  -- Compare the two cone predicates through the witness-based `toCone` description.
  dsimp [V, T]
  intro v
  rw [cone_eq_toCone_of_convex_aux hT_convex, cone_eq_toCone_of_convex_aux htranslate_convex]
  constructor
  · intro hv
    rcases (Convex.mem_toCone hT_convex).1 hv with ⟨c, hc, y, hy, rfl⟩
    exact (Convex.mem_toCone htranslate_convex).2 ⟨c, hc, (y : H), hy, rfl⟩
  · intro hv
    rcases (Convex.mem_toCone htranslate_convex).1 hv with ⟨c, hc, y, hy, hyv⟩
    refine (Convex.mem_toCone hT_convex).2 ?_
    refine ⟨c, hc, ⟨y, Submodule.subset_span hy⟩, hy, ?_⟩
    apply Subtype.ext
    simpa using hyv

/-- Helper for Fact 6.14: core membership of the translated subtype preimage is exactly the source
cone-equals-span criterion defining `ri C`. -/
lemma zero_mem_core_subtype_preimage_iff_cone_eq_span_translate {C : Set H}
    (hC_convex : Convex ℝ C) {x : H} (hx : x ∈ C) :
    let V : Submodule ℝ H := Submodule.span ℝ (C - ({x} : Set H))
    let T : Set V := ((↑) ⁻¹' (C - ({x} : Set H)))
    (0 : V) ∈ Set.core T ↔ cone (C - ({x} : Set H)) = (V : Set H) := by
  let V : Submodule ℝ H := Submodule.span ℝ (C - ({x} : Set H))
  let T : Set V := ((↑) ⁻¹' (C - ({x} : Set H)))
  have h0T : (0 : V) ∈ T := by
    -- The translated set contains the origin because `x ∈ C`.
    change (0 : H) ∈ C - ({x} : Set H)
    exact Set.mem_sub.mpr ⟨x, hx, x, by simp, sub_self x⟩
  have hTsub : T - ({(0 : V)} : Set V) = T := by
    -- Subtracting the origin from a set does not change it.
    ext v
    constructor
    · rintro ⟨u, hu, w, hw, huw⟩
      rcases Set.mem_singleton_iff.mp hw with rfl
      have huv : u = v := by simpa using huw
      simpa [huv] using hu
    · intro hv
      exact Set.mem_sub.mpr ⟨v, hv, 0, by simp, by simp⟩
  have hsubset : cone (C - ({x} : Set H)) ⊆ (V : Set H) := by
    -- The ambient cone stays inside the span generated by the translated set.
    refine ConvexCone.hull_min (C := V.toConvexCone) ?_
    exact fun y hy ↦ Submodule.subset_span hy
  have hcone :
      cone T = (univ : Set V) ↔ cone (C - ({x} : Set H)) = (V : Set H) := by
    constructor
    · intro hconeT
      apply Set.Subset.antisymm hsubset
      intro y hyV
      let yV : V := ⟨y, hyV⟩
      have hyV_cone : yV ∈ cone T := by simpa [hconeT]
      exact (mem_cone_translated_span_preimage_iff_mem_cone_translate hC_convex hx).1 hyV_cone
    · intro hconeV
      ext v
      constructor
      · intro _
        simp
      · intro _
        have hvCone : (v : H) ∈ cone (C - ({x} : Set H)) := by
          rw [hconeV]
          exact v.property
        exact (mem_cone_translated_span_preimage_iff_mem_cone_translate hC_convex hx).2 hvCone
  -- Rewrite the source `core` predicate at the origin into the ambient cone equality.
  have hcore : (0 : V) ∈ Set.core T ↔ cone (C - ({x} : Set H)) = (V : Set H) := by
    rw [Set.mem_core_iff]
    constructor
    · rintro ⟨_, hconeT⟩
      exact hcone.1 <| by simpa [hTsub] using hconeT
    · intro hconeV
      refine ⟨h0T, ?_⟩
      simpa [hTsub] using hcone.2 hconeV
  simpa [V, T] using hcore

-- Proof sketch: compare the source-facing definition of `ri C` with mathlib's intrinsic interior,
-- both described as the interior of `C` inside `affineSpan ℝ C`, and identify the two predicates.
/-- Fact 6.14 (1): in source clause (i), for a convex subset of a finite-dimensional real Hilbert
space, `ri C` is the interior of `C` relative to `affineSpan ℝ C`, i.e. `intrinsicInterior ℝ C`.
-/
theorem relativeInterior_eq_intrinsicInterior_of_finiteDimensional {C : Set H}
    [FiniteDimensional ℝ H] (hC_convex : Convex ℝ C) :
    ri C = intrinsicInterior ℝ C := by
  ext x
  by_cases hx : x ∈ C
  · let V : Submodule ℝ H := (_root_.affineSpan ℝ C).direction
    let T : Set V := ((↑) ⁻¹' (C - ({x} : Set H)))
    have hVeq : V = Submodule.span ℝ (C - ({x} : Set H)) := by
      -- Route correction: rewrite the source `ri` span in the canonical affine-span direction model.
      calc
        V = vectorSpan ℝ C := by
          rw [show V = (_root_.affineSpan ℝ C).direction by rfl, direction_affineSpan]
        _ = Submodule.span ℝ (C - ({x} : Set H)) := by
          simpa [vsub_eq_sub, sub_eq_add_neg] using
            (vectorSpan_eq_span_vsub_set_right (k := ℝ) (s := C) (p := x) hx)
    have htranslate_convex : Convex ℝ (C - ({x} : Set H)) := by
      -- The translated source set stays convex.
      simpa [sub_eq_add_neg, add_comm] using hC_convex.translate (-x)
    have hT_convex : Convex ℝ T := by
      -- Pull the translate back to the direction subtype before comparing interior and core.
      simpa [T] using htranslate_convex.affine_preimage V.subtype.toAffineMap
    have hT_int_nonempty : (interior T).Nonempty :=
      interior_nonempty_translated_direction_preimage_of_finiteDimensional hC_convex hx
    haveI : FiniteDimensional ℝ V := by infer_instance
    letI : IsClosed (V : Set H) := Submodule.closed_of_finiteDimensional V
    have hIntEqCore : interior T = Set.core T := by
      let hComplete : CompleteSpace V := IsClosed.completeSpace_coe (s := (V : Set H))
      exact
        @interior_eq_core_of_convex_nonempty_interior_aux V _ _ hComplete T hT_convex
          hT_int_nonempty
    have hInt :
        x ∈ intrinsicInterior ℝ C ↔ (0 : V) ∈ interior T :=
      intrinsicInterior_mem_iff_zero_mem_interior_translated_direction_preimage hx
    have hCore :
        (0 : V) ∈ Set.core T ↔ cone (C - ({x} : Set H)) = (V : Set H) :=
      zero_mem_core_translated_direction_preimage_iff_cone_eq_direction hC_convex hx
    constructor
    · intro hxRi
      -- The source `ri` criterion is the same cone equality after rewriting the direction space.
      rcases Set.mem_relativeInterior_iff.mp hxRi with ⟨_, hconeSpan⟩
      have hcone : cone (C - ({x} : Set H)) = (V : Set H) := by
        simpa [hVeq] using hconeSpan
      have h0core : (0 : V) ∈ Set.core T := hCore.mpr hcone
      have h0int : (0 : V) ∈ interior T := by
        rw [hIntEqCore]
        exact h0core
      exact hInt.mpr h0int
    · intro hxInt
      -- Transport intrinsic-interior membership to the translated origin, then convert interior to core.
      have h0int : (0 : V) ∈ interior T := hInt.mp hxInt
      have h0core : (0 : V) ∈ Set.core T := by
        rw [← hIntEqCore]
        exact h0int
      refine Set.mem_relativeInterior_iff.mpr ⟨hx, ?_⟩
      have hcone : cone (C - ({x} : Set H)) = (V : Set H) := hCore.mp h0core
      simpa [hVeq] using hcone
  · constructor
    · intro hxRi
      exact (hx <| (Set.mem_relativeInterior_iff.mp hxRi).1).elim
    · intro hxInt
      exact (hx <| intrinsicInterior_subset hxInt).elim

-- Proof sketch: rewrite `ri C` as `intrinsicInterior ℝ C` using part (1), then apply the
-- finite-dimensional nonemptiness theorem for the intrinsic interior of a nonempty convex set.
/-- Fact 6.14 (2): in source clause (i), the relative interior of a nonempty convex set in a
finite-dimensional real Hilbert space is nonempty. -/
theorem relativeInterior_nonempty_of_finiteDimensional {C : Set H} [FiniteDimensional ℝ H]
    (hC_nonempty : C.Nonempty) (hC_convex : Convex ℝ C) :
    (ri C).Nonempty := by
  -- Rewrite `ri C` through the intrinsic interior and use the finite-dimensional nonemptiness theorem.
  rw [relativeInterior_eq_intrinsicInterior_of_finiteDimensional hC_convex]
  exact (intrinsicInterior_nonempty hC_convex).2 hC_nonempty

/-- Helper for Fact 6.14: for a nonempty convex set in finite dimension, the closure of the
intrinsic interior equals the intrinsic closure. -/
lemma closure_intrinsicInterior_eq_intrinsicClosure_of_convex_of_nonempty {C : Set H}
    [FiniteDimensional ℝ H] (hC_nonempty : C.Nonempty) (hC_convex : Convex ℝ C) :
    closure (intrinsicInterior ℝ C) = intrinsicClosure ℝ C := by
  rcases hC_nonempty with ⟨x, hx⟩
  let A : AffineSubspace ℝ H := _root_.affineSpan ℝ C
  let xA : A := ⟨x, subset_affineSpan ℝ C hx⟩
  letI : Nonempty A := ⟨xA⟩
  let V : Submodule ℝ H := A.direction
  let S : Set A := ((↑) ⁻¹' C)
  let T : Set V := ((↑) ⁻¹' (C - ({x} : Set H)))
  let e : V ≃ₜ A := (AffineIsometryEquiv.vaddConst ℝ xA).toHomeomorph
  have hpre : e ⁻¹' S = T := by
    -- The affine-span copy and the translated direction copy are the same through `vaddConst`.
    have hcoee (v : V) : (((e v) : A) : H) = (v : H) + x := by
      change ↑(((AffineIsometryEquiv.vaddConst ℝ xA) v) : A) = (v : H) + x
      rw [AffineIsometryEquiv.coe_vaddConst]
      rfl
    ext v
    rw [show (v ∈ e ⁻¹' S) ↔ (((e v) : A) : H) ∈ C by rfl]
    rw [hcoee]
    simp [S, T, sub_eq_add_neg, add_comm]
  have himage : e '' T = S := by
    simpa [hpre] using image_preimage_eq S e.surjective
  have htranslate_convex : Convex ℝ (C - ({x} : Set H)) := by
    -- Translation keeps the source set convex.
    simpa [sub_eq_add_neg, add_comm] using hC_convex.translate (-x)
  have hT_convex : Convex ℝ T := by
    -- Pull the translated convex set back to the direction subtype.
    simpa [T] using htranslate_convex.affine_preimage V.subtype.toAffineMap
  have hT_int_nonempty : (interior T).Nonempty :=
    interior_nonempty_translated_direction_preimage_of_finiteDimensional hC_convex hx
  have himageInterior : e '' interior T = interior S := by
    -- Homeomorphisms transport interior exactly.
    rw [e.image_interior, himage]
  have himageClosure : e '' closure T = closure S := by
    -- Homeomorphisms transport closure exactly.
    rw [e.image_closure, himage]
  have hclosureS : closure (interior S) = closure S := by
    -- Move the closure/interior statement to the translated direction copy `T`.
    calc
      closure (interior S) = closure (e '' interior T) := by rw [himageInterior]
      _ = e '' closure (interior T) := by rw [← e.image_closure]
      _ = e '' closure T := by
        rw [closure_interior_eq_closure_of_convex_nonempty_interior hT_convex hT_int_nonempty]
      _ = closure S := himageClosure
  let hAclosed : IsClosed (A : Set H) := A.closed_of_finiteDimensional
  -- Route correction: close the theorem in the affine-span model before coercing back to `H`.
  change closure (((↑) : A → H) '' interior S) = ((↑) : A → H) '' closure S
  calc
    closure (((↑) : A → H) '' interior S) = ((↑) : A → H) '' closure (interior S) := by
      simpa using (hAclosed.isClosedEmbedding_subtypeVal.closure_image_eq (interior S))
    _ = ((↑) : A → H) '' closure S := by rw [hclosureS]

/-- Helper for Fact 6.14: for a nonempty convex set in finite dimension, taking the intrinsic
closure does not change the intrinsic interior. -/
lemma intrinsicInterior_intrinsicClosure_eq_intrinsicInterior_of_convex_of_nonempty {C : Set H}
    [FiniteDimensional ℝ H] (hC_nonempty : C.Nonempty) (hC_convex : Convex ℝ C) :
    intrinsicInterior ℝ (intrinsicClosure ℝ C) = intrinsicInterior ℝ C := by
  rcases hC_nonempty with ⟨x, hx⟩
  let A : AffineSubspace ℝ H := _root_.affineSpan ℝ C
  let xA : A := ⟨x, subset_affineSpan ℝ C hx⟩
  letI : Nonempty A := ⟨xA⟩
  let V : Submodule ℝ H := A.direction
  let S : Set A := ((↑) ⁻¹' C)
  let T : Set V := ((↑) ⁻¹' (C - ({x} : Set H)))
  let e : V ≃ₜ A := (AffineIsometryEquiv.vaddConst ℝ xA).toHomeomorph
  have hpre : e ⁻¹' S = T := by
    -- Reuse the affine-span/direction identification from the closure helper.
    have hcoee (v : V) : (((e v) : A) : H) = (v : H) + x := by
      change ↑(((AffineIsometryEquiv.vaddConst ℝ xA) v) : A) = (v : H) + x
      rw [AffineIsometryEquiv.coe_vaddConst]
      rfl
    ext v
    rw [show (v ∈ e ⁻¹' S) ↔ (((e v) : A) : H) ∈ C by rfl]
    rw [hcoee]
    simp [S, T, sub_eq_add_neg, add_comm]
  have himage : e '' T = S := by
    simpa [hpre] using image_preimage_eq S e.surjective
  have htranslate_convex : Convex ℝ (C - ({x} : Set H)) := by
    -- Translation keeps the source set convex.
    simpa [sub_eq_add_neg, add_comm] using hC_convex.translate (-x)
  have hT_convex : Convex ℝ T := by
    -- Pull convexity back to the direction subtype.
    simpa [T] using htranslate_convex.affine_preimage V.subtype.toAffineMap
  have hT_int_nonempty : (interior T).Nonempty :=
    interior_nonempty_translated_direction_preimage_of_finiteDimensional hC_convex hx
  have himageInterior : e '' interior T = interior S := by
    -- Homeomorphisms transport interior exactly.
    rw [e.image_interior, himage]
  have himageClosure : e '' closure T = closure S := by
    -- Homeomorphisms transport closure exactly.
    rw [e.image_closure, himage]
  have hinteriorS : interior (closure S) = interior S := by
    -- Move the interior-of-closure statement to the translated direction copy `T`.
    calc
      interior (closure S) = interior (e '' closure T) := by rw [himageClosure]
      _ = e '' interior (closure T) := by rw [← e.image_interior]
      _ = e '' interior T := by
        rw [interior_closure_eq_interior_of_convex_nonempty_interior hT_convex hT_int_nonempty]
      _ = interior S := himageInterior
  -- Route correction: identify both intrinsic interiors in the same affine span `A`.
  rw [intrinsicInterior, affineSpan_intrinsicClosure (𝕜 := ℝ) C]
  change
    (((↑) : A → H) '' interior (((↑) : A → H) ⁻¹' intrinsicClosure ℝ C)) =
      ((↑) : A → H) '' interior S
  have hpreClosure : (((↑) : A → H) ⁻¹' intrinsicClosure ℝ C) = closure S := by
    ext y
    change y ∈ (((↑) : A → H) ⁻¹' (((↑) : A → H) '' closure S)) ↔ y ∈ closure S
    rw [preimage_image_eq _ Subtype.coe_injective]
  rw [hpreClosure, hinteriorS]

-- Proof sketch: use part (2) to obtain a point of `ri C`, rewrite part (1) as intrinsic interior,
-- and apply the standard convex-closure identity for a convex set with nonempty relative interior.
/-- Fact 6.14 (3): in source clause (i), the closure of the relative interior of a convex set in a
finite-dimensional real Hilbert space is the closure of the set itself. -/
theorem closure_relativeInterior_eq_closure_of_finiteDimensional {C : Set H}
    [FiniteDimensional ℝ H] (hC_convex : Convex ℝ C) :
    closure (ri C) = closure C := by
  by_cases hC_empty : C = ∅
  · -- The empty set has empty relative interior and empty closure.
    rw [hC_empty]
    simp [Set.relativeInterior]
  · have hC_nonempty : C.Nonempty := Set.nonempty_iff_ne_empty.mpr hC_empty
    -- Rewrite `ri C` as the intrinsic interior and close the argument in the affine-span model.
    rw [relativeInterior_eq_intrinsicInterior_of_finiteDimensional hC_convex]
    simpa using
      (closure_intrinsicInterior_eq_intrinsicClosure_of_convex_of_nonempty hC_nonempty hC_convex)

-- Proof sketch: combine part (1) with the preceding closure identity and the convex invariance of
-- intrinsic interior under closure in finite-dimensional spaces.
/-- Fact 6.14 (4): in source clause (i), taking closure does not change the relative interior of a
convex set in a finite-dimensional real Hilbert space. -/
theorem relativeInterior_closure_eq_relativeInterior_of_finiteDimensional {C : Set H}
    [FiniteDimensional ℝ H] (hC_convex : Convex ℝ C) :
    ri (closure C) = ri C := by
  by_cases hC_empty : C = ∅
  · -- The empty set stays empty after closure.
    rw [hC_empty]
    simp [Set.relativeInterior]
  · have hC_nonempty : C.Nonempty := Set.nonempty_iff_ne_empty.mpr hC_empty
    -- Rewrite both sides through intrinsic interior and use intrinsic-closure invariance.
    calc
      ri (closure C) = intrinsicInterior ℝ (closure C) := by
        rw [relativeInterior_eq_intrinsicInterior_of_finiteDimensional
          (convex_closure_of_convex hC_convex)]
      _ = intrinsicInterior ℝ (intrinsicClosure ℝ C) := by
        rw [intrinsicClosure_eq_closure (𝕜 := ℝ) C]
      _ = intrinsicInterior ℝ C := by
        exact
          intrinsicInterior_intrinsicClosure_eq_intrinsicInterior_of_convex_of_nonempty
            hC_nonempty hC_convex
      _ = ri C := by
        rw [relativeInterior_eq_intrinsicInterior_of_finiteDimensional hC_convex]

/-- Helper for Fact 6.14: in finite dimension, the span of a translated set is already closed. -/
lemma span_eq_topologicalClosure_span_of_finiteDimensional_translate {C : Set H}
    [FiniteDimensional ℝ H] {x : H} :
    (((Submodule.span ℝ (C - ({x} : Set H))).topologicalClosure : Submodule ℝ H) : Set H) =
      (Submodule.span ℝ (C - ({x} : Set H)) : Set H) := by
  -- Finite-dimensional subspaces are closed, so their topological closure does nothing.
  have hclosed :
      IsClosed ((Submodule.span ℝ (C - ({x} : Set H)) : Submodule ℝ H) : Set H) :=
    Submodule.closed_of_finiteDimensional _
  simp [hclosed.submodule_topologicalClosure_eq]

-- Proof sketch: in finite dimension every linear subspace is closed, so the closed-span condition
-- defining `sri C` reduces to the span condition defining `ri C`.
/-- Fact 6.14 (5): in source clause (i), for a convex set in a finite-dimensional real Hilbert
space, the strong relative interior coincides with the relative interior. -/
theorem strongRelativeInterior_eq_relativeInterior_of_finiteDimensional {C : Set H}
    [FiniteDimensional ℝ H] (_hC_convex : Convex ℝ C) :
    sri C = ri C := by
  ext x
  constructor
  · intro hx
    -- In finite dimension the closed span in `sri` collapses to the ordinary span from `ri`.
    rcases Set.mem_strongRelativeInterior_iff.mp hx with ⟨hxC, hxeq⟩
    refine Set.mem_relativeInterior_iff.mpr ⟨hxC, ?_⟩
    rw [hxeq, span_eq_topologicalClosure_span_of_finiteDimensional_translate]
  · intro hx
    -- The converse is the same rewrite in the opposite direction.
    rcases Set.mem_relativeInterior_iff.mp hx with ⟨hxC, hxeq⟩
    refine Set.mem_strongRelativeInterior_iff.mpr ⟨hxC, ?_⟩
    rw [span_eq_topologicalClosure_span_of_finiteDimensional_translate, hxeq]

/-- Helper for Fact 6.14: the relative interior of a submodule is the submodule itself. -/
lemma relativeInterior_submodule_eq_self (V : Submodule ℝ H) :
    ri (V : Set H) = (V : Set H) := by
  ext x
  constructor
  · intro hx
    exact (Set.mem_relativeInterior_iff.mp hx).1
  · intro hx
    have hsub : (V : Set H) - ({x} : Set H) = (V : Set H) := by
      -- Translating a submodule by one of its own points preserves the set.
      ext y
      constructor
      · rintro ⟨z, hz, w, hw, hzw⟩
        rcases Set.mem_singleton_iff.mp hw with rfl
        have hz' : z - w ∈ V := V.sub_mem hz hx
        simpa [hzw] using hz'
      · intro hy
        refine Set.mem_sub.mpr ?_
        refine ⟨y + x, V.add_mem hy hx, x, by simp, ?_⟩
        abel
    refine Set.mem_relativeInterior_iff.mpr ⟨hx, ?_⟩
    rw [hsub, cone_eq_self_of_submodule, Submodule.span_eq V]

/-- Helper for Fact 6.14: taking the source-facing cone twice does not change the set. -/
lemma cone_idem (S : Set H) :
    cone (cone S) = cone S := by
  ext y
  constructor
  · intro hy
    exact ConvexCone.hull_min (C := ConvexCone.hull ℝ S) (fun z hz ↦ hz) hy
  · intro hy
    exact ConvexCone.subset_hull hy

-- Proof sketch: use finite dimensionality to replace the closed span in the definition of `qri C`
-- by the ordinary span, then compare with the defining condition for `ri C`.
/-- Fact 6.14 (6): in source clause (i), for a convex set in a finite-dimensional real Hilbert
space, the quasirelative interior coincides with the relative interior. -/
theorem relativeInterior_eq_quasiRelativeInterior_of_finiteDimensional {C : Set H}
    [FiniteDimensional ℝ H] (hC_convex : Convex ℝ C) :
    ri C = qri C := by
  ext x
  constructor
  · intro hx
    rcases Set.mem_relativeInterior_iff.mp hx with ⟨hxC, hcone⟩
    refine Set.mem_quasiRelativeInterior_iff.mpr ⟨hxC, ?_⟩
    -- In finite dimension, the span of the translate is already closed.
    rw [hcone, span_eq_topologicalClosure_span_of_finiteDimensional_translate (C := C) (x := x)]
    simpa using
      (Submodule.closed_of_finiteDimensional
        (Submodule.span ℝ (C - ({x} : Set H)))).closure_eq
  · intro hx
    rcases Set.mem_quasiRelativeInterior_iff.mp hx with ⟨hxC, hclosureCone⟩
    let D : Set H := cone (C - ({x} : Set H))
    let V : Submodule ℝ H := Submodule.span ℝ (C - ({x} : Set H))
    have hD_convex : Convex ℝ D := by
      -- The source cone is the underlying set of a convex cone hull.
      simpa [D, Set.cone_def] using (ConvexCone.hull ℝ (C - ({x} : Set H))).convex
    have hDclosure : closure D = (V : Set H) := by
      -- The `qri` hypothesis identifies the closed cone with the translated span.
      calc
        closure D = ((V.topologicalClosure : Submodule ℝ H) : Set H) := by
          simpa [D, V] using hclosureCone
        _ = (V : Set H) := by
          simpa [V] using
            (span_eq_topologicalClosure_span_of_finiteDimensional_translate (C := C) (x := x))
    have hriD : ri D = (V : Set H) := by
      -- Apply part (4) to the translated cone, whose closure is already the span.
      calc
        ri D = ri (closure D) := by
          symm
          exact relativeInterior_closure_eq_relativeInterior_of_finiteDimensional hD_convex
        _ = ri (V : Set H) := by rw [hDclosure]
        _ = (V : Set H) := relativeInterior_submodule_eq_self V
    have h0riD : (0 : H) ∈ ri D := by
      simpa [hriD] using (show (0 : H) ∈ (V : Set H) from Submodule.zero_mem V)
    rcases Set.mem_relativeInterior_iff.mp h0riD with ⟨h0D, hconeD⟩
    have hDsub : D - ({(0 : H)} : Set H) = D := by
      -- Subtracting the origin does not change the cone.
      ext y
      constructor
      · rintro ⟨z, hz, w, hw, hzw⟩
        rcases Set.mem_singleton_iff.mp hw with rfl
        have hzy : z = y := by simpa using hzw
        simpa [hzy] using hz
      · intro hy
        exact Set.mem_sub.mpr ⟨y, hy, 0, by simp, by simp⟩
    have hconeD' : cone D = (Submodule.span ℝ D : Set H) := by
      -- Evaluate the relative-interior criterion at the origin.
      simpa [hDsub] using hconeD
    have hspanD_eq : Submodule.span ℝ D = V := by
      apply le_antisymm
      · refine Submodule.span_le.2 ?_
        intro y hy
        change y ∈ V
        exact ConvexCone.hull_min (C := V.toConvexCone) (fun z hz ↦ Submodule.subset_span hz) hy
      · refine Submodule.span_le.2 ?_
        intro y hy
        exact Submodule.subset_span (ConvexCone.subset_hull hy)
    have hD_eq : D = (V : Set H) := by
      calc
        D = cone D := by
          symm
          simpa [D] using (cone_idem (C - ({x} : Set H)))
        _ = (Submodule.span ℝ D : Set H) := hconeD'
        _ = (V : Set H) := by rw [hspanD_eq]
    -- The cone criterion has upgraded from closed span to ordinary span.
    refine Set.mem_relativeInterior_iff.mpr ⟨hxC, ?_⟩
    simpa [D, V] using hD_eq

end

section

variable {H : Type u} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
  [TopologicalSpace.SeparableSpace H]

-- Proof sketch: apply the separable closed-convex theorem quoted in the text to identify a closed
-- convex set with the closure of its quasirelative interior.
/-- External dependency for Fact 6.14 (7): in source clause (ii), a closed convex subset of a
separable real Hilbert space is the closure of its quasirelative interior. This is a cited
separable-Hilbert qri-density theorem, recorded as a bridge dependency rather than as a local proof
obligation. -/
axiom closed_eq_closure_quasiRelativeInterior_of_isClosed_of_separable {C : Set H}
    (hC_closed : IsClosed C) (hC_convex : Convex ℝ C) :
    C = closure (qri C)

-- Proof sketch: combine part (7) with nonemptiness of `C`; the closure of the empty set is empty,
-- so a nonempty closed convex set must have nonempty quasirelative interior.
/-- Fact 6.14 (8): in source clause (ii), a nonempty closed convex subset of a separable real
Hilbert space has nonempty quasirelative interior. -/
theorem quasiRelativeInterior_nonempty_of_isClosed_of_separable {C : Set H}
    (hC_nonempty : C.Nonempty) (hC_closed : IsClosed C) (hC_convex : Convex ℝ C) :
    (qri C).Nonempty := by
  by_contra hqri_empty
  have hclosure_empty : closure (qri C) = (∅ : Set H) := by
    rw [Set.not_nonempty_iff_eq_empty.mp hqri_empty]
    simp
  have hC_empty : C = (∅ : Set H) := by
    rw [closed_eq_closure_quasiRelativeInterior_of_isClosed_of_separable hC_closed hC_convex,
      hclosure_empty]
  exact hC_nonempty.ne_empty hC_empty

end

section

variable {H : Type u} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]

/-- Helper for Fact 6.14: for a convex set, the source-facing cone hull agrees with the canonical
positive-multiple cone from mathlib. -/
lemma cone_eq_toCone_of_convex {C : Set H} (hC_convex : Convex ℝ C) :
    cone C = ((hC_convex.toCone C : ConvexCone ℝ H) : Set H) := by
  -- Rewrite the textbook cone hull as the least convex cone generated by `C`.
  have hHull :
      (ConvexCone.hull ℝ C : Set H) = ((hC_convex.toCone C : ConvexCone ℝ H) : Set H) := by
    simpa [ConvexCone.hull] using
      congrArg (fun S : ConvexCone ℝ H => (S : Set H)) hC_convex.toCone_eq_sInf.symm
  simpa [Set.cone_def] using hHull

/-- Helper for Fact 6.14: translating by `x` and then taking a preimage is the same as
subtracting the singleton `{x}`. -/
lemma preimage_addLeft_eq_sub_singleton (C : Set H) (x : H) :
    (Homeomorph.addLeft x) ⁻¹' C = C - ({x} : Set H) := by
  ext y
  constructor
  · intro hy
    refine Set.mem_sub.mpr ?_
    refine ⟨x + y, hy, x, by simp, ?_⟩
    simp [sub_eq_add_neg, add_assoc, add_left_comm, add_comm]
  · rintro ⟨u, hu, v, hv, huv⟩
    have huv' : u = v + y := by
      simpa [sub_eq_add_neg, add_assoc] using congrArg (fun z => v + z) huv
    rcases Set.mem_singleton_iff.mp hv with rfl
    simpa [huv'] using hu

/-- Helper for Fact 6.14: for a convex set with nonempty interior, the origin is an interior point
exactly when its cone hull is the whole ambient space. -/
lemma zero_mem_interior_iff_cone_eq_univ_of_convex_nonempty_interior {S : Set H}
    (hS_convex : Convex ℝ S) (hS_int_nonempty : (interior S).Nonempty) (_h0 : (0 : H) ∈ S) :
    (0 : H) ∈ interior S ↔ cone S = (univ : Set H) := by
  constructor
  · intro h0_int
    -- A small ball around the origin scales every direction into `S`, hence the cone is all of `H`.
    have hmem : S ∈ 𝓝 (0 : H) := mem_interior_iff_mem_nhds.mp h0_int
    rcases Metric.mem_nhds_iff.mp hmem with ⟨ε, hε, hball⟩
    ext y
    constructor
    · intro _
      simp
    · intro _
      let t : ℝ := ε / (1 + ‖y‖)
      have ht : 0 < t := by
        dsimp [t]
        positivity
      have hty_norm : ‖t • y‖ < ε := by
        have hden : 0 < 1 + ‖y‖ := by positivity
        have hy_lt : ‖y‖ < 1 + ‖y‖ := by
          nlinarith [norm_nonneg y]
        have hfrac_lt : ‖y‖ / (1 + ‖y‖) < (1 : ℝ) := by
          exact (div_lt_iff₀ hden).2 <| by simpa using hy_lt
        have hlt' : ε / (1 + ‖y‖) * ‖y‖ < ε := by
          have hε_pos : 0 < ε := hε
          simpa [mul_comm, mul_left_comm, mul_assoc, div_eq_mul_inv] using
            mul_lt_mul_of_pos_left hfrac_lt hε_pos
        have hlt : t * ‖y‖ < ε := by
          simpa [t] using hlt'
        simpa [norm_smul, Real.norm_eq_abs, abs_of_pos ht] using hlt
      have hty_mem : t • y ∈ S := hball <| by
        simpa [Metric.mem_ball, dist_eq_norm] using hty_norm
      rw [cone_eq_toCone_of_convex hS_convex]
      exact (Convex.mem_toCone hS_convex).2
        ⟨1 / t, by positivity, t • y, hty_mem, by
          rw [one_div, smul_smul, inv_mul_cancel₀ ht.ne', one_smul]⟩
  · intro hcone
    rcases hS_int_nonempty with ⟨z, hz⟩
    have hnegz : -z ∈ cone S := by
      simpa [hcone]
    rw [cone_eq_toCone_of_convex hS_convex] at hnegz
    -- Route correction: rather than forcing a basis argument, use a positive multiple of `-z`
    -- coming from the cone description and average it with the interior point `z`.
    rcases (Convex.mem_toCone hS_convex).1 hnegz with ⟨c, hc, y, hy, hcy⟩
    have ha : 0 ≤ c / (c + 1) := by positivity
    have hb : 0 < 1 / (c + 1) := by positivity
    have hab : c / (c + 1) + 1 / (c + 1) = (1 : ℝ) := by
      field_simp [hc.ne']
    have hcombo :
        (c / (c + 1)) • y + (1 / (c + 1)) • z ∈ interior S :=
      hS_convex.combo_self_interior_mem_interior hy hz ha hb hab
    have hzero :
        (c / (c + 1)) • y + (1 / (c + 1)) • z = (0 : H) := by
      calc
        (c / (c + 1)) • y + (1 / (c + 1)) • z
            = (1 / (c + 1)) • (c • y) + (1 / (c + 1)) • z := by
                rw [div_eq_mul_inv, one_div, smul_smul, mul_comm c ((c + 1)⁻¹)]
        _ = (1 / (c + 1)) • (c • y + z) := by rw [smul_add]
        _ = (0 : H) := by rw [hcy, neg_add_cancel, smul_zero]
    exact hzero ▸ hcombo

/-- Helper for Fact 6.14: translating a convex set with nonempty interior turns interior
membership at `x` into the cone criterion for `C - {x}`. -/
lemma mem_interior_iff_cone_translate_eq_univ_of_convex_nonempty_interior {C : Set H}
    (hC_convex : Convex ℝ C) (hC_int_nonempty : (interior C).Nonempty) {x : H} (hx : x ∈ C) :
    x ∈ interior C ↔ cone (C - ({x} : Set H)) = (univ : Set H) := by
  let S : Set H := (Homeomorph.addLeft x) ⁻¹' C
  have hS_eq : S = C - ({x} : Set H) := preimage_addLeft_eq_sub_singleton C x
  have hS_convex : Convex ℝ S := by
    simpa [S, add_comm] using hC_convex.translate_preimage_right x
  have hS_int_nonempty : (interior S).Nonempty := by
    rcases hC_int_nonempty with ⟨z, hz⟩
    refine ⟨z - x, ?_⟩
    have hz_pre : z - x ∈ (Homeomorph.addLeft x) ⁻¹' interior C := by
      simpa [sub_eq_add_neg, add_assoc] using hz
    have hz_int : z - x ∈ interior ((Homeomorph.addLeft x) ⁻¹' C) := by
      rwa [(Homeomorph.addLeft x).preimage_interior C] at hz_pre
    simpa [S] using hz_int
  have h0S : (0 : H) ∈ S := by
    simpa [S] using hx
  have hzero :
      (0 : H) ∈ interior S ↔ cone S = (univ : Set H) :=
    zero_mem_interior_iff_cone_eq_univ_of_convex_nonempty_interior hS_convex hS_int_nonempty h0S
  constructor
  · intro hx_int
    have h0_int : (0 : H) ∈ interior S := by
      have hx_pre : (0 : H) ∈ (Homeomorph.addLeft x) ⁻¹' interior C := by
        simpa [S] using hx_int
      rwa [(Homeomorph.addLeft x).preimage_interior C] at hx_pre
    simpa [hS_eq] using hzero.mp h0_int
  · intro hcone
    have h0_int : (0 : H) ∈ interior S := by
      have hconeS : cone S = (univ : Set H) := by simpa [hS_eq] using hcone
      exact hzero.mpr hconeS
    have hx_img : x ∈ (Homeomorph.addLeft x) '' interior S := ⟨0, h0_int, by simp⟩
    have himageS : (Homeomorph.addLeft x) '' S = C := by
      simpa [S] using image_preimage_eq C (Homeomorph.addLeft x).surjective
    have himageInt : (Homeomorph.addLeft x) '' interior S = interior C := by
      rw [(Homeomorph.addLeft x).image_interior, himageS]
    rw [← himageInt]
    exact hx_img

-- Proof sketch: apply Proposition 6.12 with the nonempty-interior branch of its hypothesis.
/-- Fact 6.14 (9): in source clause (iii), if a convex set has nonempty interior, then its
interior coincides with its core. -/
theorem interior_eq_core_of_convex_nonempty_interior {C : Set H} (hC_convex : Convex ℝ C)
    (hC_int_nonempty : (interior C).Nonempty) :
    interior C = Set.core C := by
  ext x
  constructor
  · intro hx
    -- The translated cone criterion from the helper is exactly the defining condition of `core`.
    refine Set.mem_core_iff.mpr ⟨interior_subset hx, ?_⟩
    exact (mem_interior_iff_cone_translate_eq_univ_of_convex_nonempty_interior
      hC_convex hC_int_nonempty (interior_subset hx)).mp hx
  · intro hx
    rcases Set.mem_core_iff.mp hx with ⟨hxC, hcone⟩
    -- Route correction: convert the cone equality back to ordinary interior via translation.
    exact (mem_interior_iff_cone_translate_eq_univ_of_convex_nonempty_interior
      hC_convex hC_int_nonempty hxC).mpr hcone

/-- Helper for Fact 6.14: a convex set with nonempty interior has full translated span at each
point of the set. -/
lemma span_translate_eq_top_of_convex_nonempty_interior {C : Set H} (hC_convex : Convex ℝ C)
    (hC_int_nonempty : (interior C).Nonempty) {x : H} (hx : x ∈ C) :
    Submodule.span ℝ (C - ({x} : Set H)) = ⊤ := by
  -- Nonempty interior forces the affine span to be the whole ambient space.
  have hAffineTop : affineSpan ℝ C = ⊤ := by
    apply affineSpan_eq_top_of_nonempty_interior
    simpa [hC_convex.convexHull_eq] using hC_int_nonempty
  -- Re-express the direction of the affine span using the translate by `x`.
  calc
    Submodule.span ℝ (C - ({x} : Set H)) = vectorSpan ℝ C := by
      simpa [vsub_eq_sub, sub_eq_add_neg] using
        (vectorSpan_eq_span_vsub_set_right (k := ℝ) (s := C) (p := x) hx).symm
    _ = (affineSpan ℝ C).direction := by
      rw [direction_affineSpan]
    _ = ⊤ := by
      rw [hAffineTop]
      simp

-- Proof sketch: use the nonempty-interior assumption to identify the cone of each translate
-- `C - x` with the closed span appearing in the definition of `sri C`.
/-- Fact 6.14 (10): in source clause (iii), if a convex set has nonempty interior, then its
interior coincides with its strong relative interior. -/
theorem interior_eq_strongRelativeInterior_of_convex_nonempty_interior {C : Set H}
    (hC_convex : Convex ℝ C) (hC_int_nonempty : (interior C).Nonempty) :
    interior C = sri C := by
  ext x
  constructor
  · intro hx
    have hxC : x ∈ C := interior_subset hx
    have hcone :
        cone (C - ({x} : Set H)) = (univ : Set H) :=
      (mem_interior_iff_cone_translate_eq_univ_of_convex_nonempty_interior
        hC_convex hC_int_nonempty hxC).mp hx
    have hspan_top :
        Submodule.span ℝ (C - ({x} : Set H)) = ⊤ :=
      span_translate_eq_top_of_convex_nonempty_interior hC_convex hC_int_nonempty hxC
    -- Nonempty interior forces the closed span in `sri` to be the whole ambient space as well.
    refine Set.mem_strongRelativeInterior_iff.mpr ⟨hxC, ?_⟩
    rw [hcone, hspan_top]
    simp
  · intro hx
    rcases Set.mem_strongRelativeInterior_iff.mp hx with ⟨hxC, hcone_closedSpan⟩
    have hspan_top :
        Submodule.span ℝ (C - ({x} : Set H)) = ⊤ :=
      span_translate_eq_top_of_convex_nonempty_interior hC_convex hC_int_nonempty hxC
    have hcone :
        cone (C - ({x} : Set H)) = (univ : Set H) := by
      rw [hspan_top] at hcone_closedSpan
      simpa using hcone_closedSpan
    -- Once the cone is all of `H`, the translated criterion gives back ordinary interior.
    exact (mem_interior_iff_cone_translate_eq_univ_of_convex_nonempty_interior
      hC_convex hC_int_nonempty hxC).mpr hcone

-- Proof sketch: once the interior is nonempty, the affine-span interior is the ambient interior,
-- so `ri C` agrees with `interior C`.
/-- Fact 6.14 (11): in source clause (iii), if a convex set has nonempty interior, then its
interior coincides with its relative interior. -/
theorem interior_eq_relativeInterior_of_convex_nonempty_interior {C : Set H}
    (hC_convex : Convex ℝ C) (hC_int_nonempty : (interior C).Nonempty) :
    interior C = ri C := by
  ext x
  constructor
  · intro hx
    have hxC : x ∈ C := interior_subset hx
    have hcone :
        cone (C - ({x} : Set H)) = (univ : Set H) :=
      (mem_interior_iff_cone_translate_eq_univ_of_convex_nonempty_interior
        hC_convex hC_int_nonempty hxC).mp hx
    have hspan_top :
        Submodule.span ℝ (C - ({x} : Set H)) = ⊤ :=
      span_translate_eq_top_of_convex_nonempty_interior hC_convex hC_int_nonempty hxC
    -- The translated span is already all of `H`, so the `ri` equality is the same cone criterion.
    refine Set.mem_relativeInterior_iff.mpr ⟨hxC, ?_⟩
    rw [hcone, hspan_top]
    simp
  · intro hx
    rcases Set.mem_relativeInterior_iff.mp hx with ⟨hxC, hcone_span⟩
    have hspan_top :
        Submodule.span ℝ (C - ({x} : Set H)) = ⊤ :=
      span_translate_eq_top_of_convex_nonempty_interior hC_convex hC_int_nonempty hxC
    have hcone :
        cone (C - ({x} : Set H)) = (univ : Set H) := by
      rw [hspan_top] at hcone_span
      simpa using hcone_span
    exact (mem_interior_iff_cone_translate_eq_univ_of_convex_nonempty_interior
      hC_convex hC_int_nonempty hxC).mpr hcone

-- Proof sketch: identify `ri C` with `interior C` from part (11) and then compare the defining
-- closure condition of `qri C` with the same nonempty-interior geometry.
/-- Fact 6.14 (12): in source clause (iii), if a convex set has nonempty interior, then its
interior coincides with its quasirelative interior. -/
theorem interior_eq_quasiRelativeInterior_of_convex_nonempty_interior {C : Set H}
    (hC_convex : Convex ℝ C) (hC_int_nonempty : (interior C).Nonempty) :
    interior C = qri C := by
  ext x
  constructor
  · intro hx
    have hxC : x ∈ C := interior_subset hx
    have hcone :
        cone (C - ({x} : Set H)) = (univ : Set H) :=
      (mem_interior_iff_cone_translate_eq_univ_of_convex_nonempty_interior
        hC_convex hC_int_nonempty hxC).mp hx
    have hspan_top :
        Submodule.span ℝ (C - ({x} : Set H)) = ⊤ :=
      span_translate_eq_top_of_convex_nonempty_interior hC_convex hC_int_nonempty hxC
    -- The cone and its closed span are both the whole space once the translated span is `⊤`.
    refine Set.mem_quasiRelativeInterior_iff.mpr ⟨hxC, ?_⟩
    rw [hcone, hspan_top]
    simp
  · intro hx
    rcases Set.mem_quasiRelativeInterior_iff.mp hx with ⟨hxC, hclosureCone⟩
    let D : Set H := cone (C - ({x} : Set H))
    have hspan_top :
        Submodule.span ℝ (C - ({x} : Set H)) = ⊤ :=
      span_translate_eq_top_of_convex_nonempty_interior hC_convex hC_int_nonempty hxC
    have hD_closure : closure D = (univ : Set H) := by
      rw [hspan_top] at hclosureCone
      simpa [D] using hclosureCone
    have htranslate_int_nonempty : (interior (C - ({x} : Set H))).Nonempty := by
      rcases hC_int_nonempty with ⟨z, hz⟩
      refine ⟨z - x, ?_⟩
      have hz_pre : z - x ∈ (Homeomorph.addLeft x) ⁻¹' interior C := by
        simpa [sub_eq_add_neg, add_assoc] using hz
      have hz_int : z - x ∈ interior ((Homeomorph.addLeft x) ⁻¹' C) := by
        rwa [(Homeomorph.addLeft x).preimage_interior C] at hz_pre
      rw [preimage_addLeft_eq_sub_singleton C x] at hz_int
      exact hz_int
    have hD_convex : Convex ℝ D := by
      simpa [D, Set.cone_def] using (ConvexCone.hull ℝ (C - ({x} : Set H))).convex
    have hD_int_nonempty : (interior D).Nonempty := by
      rcases htranslate_int_nonempty with ⟨y, hy⟩
      refine ⟨y, ?_⟩
      -- The translated set sits inside its cone hull, so an open neighborhood in the translate
      -- is also an open neighborhood inside the cone.
      apply mem_interior_iff_mem_nhds.mpr
      exact Filter.mem_of_superset (mem_interior_iff_mem_nhds.mp hy) <| by
        intro z hz
        exact ConvexCone.subset_hull hz
    have hD_int_eq :
        interior (closure D) = interior D :=
      hD_convex.interior_closure_eq_interior_of_nonempty_interior hD_int_nonempty
    have hD_int_univ : interior D = (univ : Set H) := by
      calc
        interior D = interior (closure D) := hD_int_eq.symm
        _ = (univ : Set H) := by rw [hD_closure]; simp
    have hcone : D = (univ : Set H) := by
      ext y
      constructor
      · intro _
        simp
      · intro _
        have hy_int : y ∈ interior D := by simpa [hD_int_univ]
        exact interior_subset hy_int
    -- A dense cone that already contains an open subset must be all of `H`.
    exact (mem_interior_iff_cone_translate_eq_univ_of_convex_nonempty_interior
      hC_convex hC_int_nonempty hxC).mpr <| by simpa [D] using hcone

end

section

variable {H : Type u} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
variable {K : Type v} [NormedAddCommGroup K] [InnerProductSpace ℝ K] [CompleteSpace K]
  [FiniteDimensional ℝ K]

-- Proof sketch: use the finite-dimensional target-space image theorem for generalized interiors:
-- relative interior commutes with a continuous linear image once `qri C` is nonempty.
/-- External dependency for Fact 6.14 (13): in source clause (iv), for a continuous linear map from
a real Hilbert space to a finite-dimensional real Hilbert space, the image of the quasirelative
interior is the relative interior of the image of a convex set. -/
axiom relativeInterior_image_eq_image_quasiRelativeInterior {C : Set H}
    (L : H →L[ℝ] K) (hC_convex : Convex ℝ C) (hqri_nonempty : (qri C).Nonempty) :
    ri (L '' C) = L '' qri C

end

section

variable {H : Type u} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
  [FiniteDimensional ℝ H]

-- Proof sketch: apply the finite-dimensional intersection formula for relative interiors of convex
-- sets under the hypothesis that the two relative interiors meet.
/-- External dependency for Fact 6.14 (14): in source clause (v), for convex subsets of a
finite-dimensional real Hilbert space with intersecting relative interiors, the relative interior
of the intersection is the intersection of the relative interiors. -/
axiom relativeInterior_inter_eq_inter_relativeInterior_of_nonempty {C D : Set H}
    (hC_convex : Convex ℝ C) (hD_convex : Convex ℝ D)
    (hri_nonempty : (ri C ∩ ri D).Nonempty) :
    ri (C ∩ D) = ri C ∩ ri D

end
