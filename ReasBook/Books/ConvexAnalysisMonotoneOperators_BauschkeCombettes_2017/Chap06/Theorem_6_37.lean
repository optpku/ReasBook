import Mathlib
import ConvexAnalysisMonotoneOperators_BauschkeCombettes_2017.Chap06.Definition_6_22
import ConvexAnalysisMonotoneOperators_BauschkeCombettes_2017.Chap06.Proposition_6_24
import ConvexAnalysisMonotoneOperators_BauschkeCombettes_2017.Chap06.Proposition_6_28
import ConvexAnalysisMonotoneOperators_BauschkeCombettes_2017.Chap06.Proposition_6_32

-- Declarations for this item will be appended below by the statement pipeline.

open Set
open scoped InnerProductSpace Pointwise

universe u v

section

variable {𝓗 : Type u} {𝓚 : Type v}
variable [NormedAddCommGroup 𝓗] [InnerProductSpace ℝ 𝓗] [CompleteSpace 𝓗]
variable [NormedAddCommGroup 𝓚] [InnerProductSpace ℝ 𝓚] [CompleteSpace 𝓚]

/-- Helper for Theorem 6.37: a proper cone agrees with the double polar of its underlying set. -/
lemma polarCone_polarCone_eq_self_of_properCone (K : ProperCone ℝ 𝓗) :
    (((K : Set 𝓗)ᵒ⊖)ᵒ⊖) = (K : Set 𝓗) := by
  -- Rewrite the inner polar through the dual cone, then invoke the proper-cone bipolar theorem.
  have hdual :
      -((K : Set 𝓗)ᵒ⊖) = (ProperCone.innerDual (K : Set 𝓗) : Set 𝓗) := by
    simpa [Set.dualCone] using Set.dualCone_eq_innerDual (K : Set 𝓗)
  calc
    (((K : Set 𝓗)ᵒ⊖)ᵒ⊖) = (ProperCone.innerDual (-((K : Set 𝓗)ᵒ⊖)) : Set 𝓗) := by
      simpa using Set.polarCone_eq_innerDual_neg ((K : Set 𝓗)ᵒ⊖)
    _ = (ProperCone.innerDual ((ProperCone.innerDual (K : Set 𝓗) : Set 𝓗)) : Set 𝓗) := by
      rw [hdual]
    _ = (K : Set 𝓗) := by
      simp

/-- Helper for Theorem 6.37: taking the polar cone is unchanged by replacing a set with its
closure. -/
lemma polarCone_closure_eq (S : Set 𝓗) :
    (closure S)ᵒ⊖ = Sᵒ⊖ := by
  -- Rewrite both sides as negative polars and use Proposition 6.24 for closure invariance.
  calc
    (closure S)ᵒ⊖ = Set.negativePolar (closure S) := by
      simpa [Set.negativePolar] using Set.polarCone_eq_innerDual_neg (closure S)
    _ = Set.negativePolar S := Set.negativePolar_closure_eq S
    _ = Sᵒ⊖ := by
      simpa [Set.negativePolar] using (Set.polarCone_eq_innerDual_neg S).symm

/-- Helper for Theorem 6.37: every adjoint image of a vector from `Kᵒ⊖` already lies in the polar
cone of `L ⁻¹' K`. -/
lemma adjoint_image_polarCone_subset_polarCone_preimage
    (L : 𝓗 →L[ℝ] 𝓚) (K : ProperCone ℝ 𝓚) :
    L.adjoint '' ((K : Set 𝓚)ᵒ⊖) ⊆ (L ⁻¹' (K : Set 𝓚))ᵒ⊖ := by
  intro u hu
  rcases hu with ⟨v, hv, rfl⟩
  -- Transport the defining polar inequality across the adjoint pairing identity.
  rw [Set.mem_polarCone_iff_forall_inner_nonpos]
  intro x hx
  have hLv : ⟪L x, v⟫_ℝ ≤ 0 :=
    (Set.mem_polarCone_iff_forall_inner_nonpos.mp hv) (L x) hx
  simpa [ContinuousLinearMap.adjoint_inner_right] using hLv

/-- Helper for Theorem 6.37: the projection argument places any point of the polar cone of
`L ⁻¹' K` into the closure of `L.adjoint '' Kᵒ⊖`. -/
lemma mem_closure_adjoint_image_polarCone_of_mem_polarCone_preimage
    (L : 𝓗 →L[ℝ] 𝓚) (K : ProperCone ℝ 𝓚) {u : 𝓗}
    (hu : u ∈ (L ⁻¹' (K : Set 𝓚))ᵒ⊖) :
    u ∈ closure (L.adjoint '' ((K : Set 𝓚)ᵒ⊖)) := by
  -- Route correction: follow the source proof by projecting onto the closed cone generated by the
  -- adjoint image, instead of switching to a separation argument.
  let D : ProperCone ℝ 𝓗 := (ProperCone.innerDual (- (K : Set 𝓚))).map L.adjoint
  let p : 𝓗 := projectionPoint (D : Set 𝓗) (properConeProjectionChebyshev D) u
  have hD_carrier : (D : Set 𝓗) = closure (L.adjoint '' ((K : Set 𝓚)ᵒ⊖)) := by
    -- The mapped proper cone has carrier equal to the closure of the adjoint image.
    have hpolar : (ProperCone.innerDual (- (K : Set 𝓚)) : Set 𝓚) = ((K : Set 𝓚)ᵒ⊖) := by
      simpa using (Set.polarCone_eq_innerDual_neg (K : Set 𝓚)).symm
    calc
      (D : Set 𝓗) = closure (L.adjoint '' (ProperCone.innerDual (- (K : Set 𝓚)) : Set 𝓚)) := by
        change (((ProperCone.innerDual (- (K : Set 𝓚))).map L.adjoint : ProperCone ℝ 𝓗) : Set 𝓗) =
          closure (L.adjoint '' (ProperCone.innerDual (- (K : Set 𝓚)) : Set 𝓚))
        rfl
      _ = closure (L.adjoint '' ((K : Set 𝓚)ᵒ⊖)) := by
        rw [hpolar]
  have hresidual_Dpolar : u - p ∈ (D : Set 𝓗)ᵒ⊖ := by
    -- Proposition 6.28 puts the projection residual into the polar cone of `D`.
    simpa [p] using
      (sub_mem_polarCone_of_eq_projectionPoint_on_properCone
        (K := D) (x := u) (p := p) rfl)
  have hresidual_imagepolar : u - p ∈ (L.adjoint '' ((K : Set 𝓚)ᵒ⊖))ᵒ⊖ := by
    -- Replace the polar cone of the closed image cone by the polar of the raw image.
    rwa [hD_carrier, polarCone_closure_eq (L.adjoint '' ((K : Set 𝓚)ᵒ⊖))] at hresidual_Dpolar
  have hLu_in_K : L (u - p) ∈ (K : Set 𝓚) := by
    have hLu_bipolar : L (u - p) ∈ (((K : Set 𝓚)ᵒ⊖)ᵒ⊖) := by
      -- Test the residual polar inequality on points of the adjoint image.
      rw [Set.mem_polarCone_iff_forall_inner_nonpos]
      intro v hv
      have htest : ⟪L.adjoint v, u - p⟫_ℝ ≤ 0 :=
        (Set.mem_polarCone_iff_forall_inner_nonpos.mp hresidual_imagepolar)
          (L.adjoint v) (Set.mem_image_of_mem _ hv)
      simpa [ContinuousLinearMap.adjoint_inner_left] using htest
    simpa [polarCone_polarCone_eq_self_of_properCone K] using hLu_bipolar
  have hresidual_preimage : u - p ∈ L ⁻¹' (K : Set 𝓚) := hLu_in_K
  have hinner : ⟪u, u - p⟫_ℝ ≤ 0 :=
    by
      simpa [real_inner_comm] using
        (Set.mem_polarCone_iff_forall_inner_nonpos.mp hu) (u - p) hresidual_preimage
  have hu_mem_D : u ∈ D := by
    -- Proposition 6.32 closes the projection argument once the residual lies back in `L ⁻¹' K`.
    simpa [p] using
      (mem_of_inner_sub_projectionPoint_nonpos_of_properCone
        (K := D) u hinner)
  have hu_mem_D' : u ∈ (D : Set 𝓗) := hu_mem_D
  rw [hD_carrier] at hu_mem_D'
  exact hu_mem_D'

-- Proof sketch: identify the polar cone with the negative inner dual cone, apply the closed-cone
-- bipolar theorem to `K`, and use the adjoint pairing formula to transport the defining
-- inequalities across the preimage under `L`.
/-- Theorem 6.37 (1): the polar cone of the preimage of a nonempty closed convex cone under a
continuous linear map is the closure of the adjoint image of the polar cone of that cone. -/
theorem polarCone_preimage_eq_closure_adjoint_image_polarCone
    (L : 𝓗 →L[ℝ] 𝓚) (K : ProperCone ℝ 𝓚) :
    (L ⁻¹' (K : Set 𝓚))ᵒ⊖ = closure (L.adjoint '' ((K : Set 𝓚)ᵒ⊖)) := by
  -- The source proof has two inclusions: the easy adjoint-image inclusion and the reverse
  -- projection argument onto the closed image cone.
  apply Subset.antisymm
  · intro u hu
    exact mem_closure_adjoint_image_polarCone_of_mem_polarCone_preimage L K hu
  · have hclosed : IsClosed ((L ⁻¹' (K : Set 𝓚))ᵒ⊖ : Set 𝓗) := by
      rw [Set.polarCone_eq_innerDual_neg]
      exact (ProperCone.innerDual (- (L ⁻¹' (K : Set 𝓚)))).isClosed
    exact closure_minimal
      (adjoint_image_polarCone_subset_polarCone_preimage L K) hclosed

-- Proof sketch: the preimage under `L.adjoint` is again a nonempty closed convex cone, so its
-- double polar identifies with itself; then apply part (1) to `L.adjoint` and the cone `U`, and
-- rewrite the resulting double adjoint term using `L.adjoint_adjoint`.
/-- Theorem 6.37 (2): the preimage of a nonempty closed convex cone under the adjoint of a
continuous linear map is the polar cone of the image of the polar cone under the original map. -/
theorem preimage_adjoint_eq_polarCone_image_polarCone
    (L : 𝓗 →L[ℝ] 𝓚) (U : ProperCone ℝ 𝓗) :
    L.adjoint ⁻¹' (U : Set 𝓗) = (L '' ((U : Set 𝓗)ᵒ⊖))ᵒ⊖ := by
  -- Realize the preimage as a proper cone, identify it with its bipolar, then invoke part (1) for
  -- `L.adjoint` and remove the resulting closure inside the outer polar.
  let E : ProperCone ℝ 𝓚 := U.comap L.adjoint
  have hE_carrier : (E : Set 𝓚) = L.adjoint ⁻¹' (U : Set 𝓗) := by
    change ((U.comap L.adjoint : ProperCone ℝ 𝓚) : Set 𝓚) = L.adjoint ⁻¹' (U : Set 𝓗)
    exact ProperCone.coe_comap (f := L.adjoint) (C := U)
  calc
    L.adjoint ⁻¹' (U : Set 𝓗) = (E : Set 𝓚) := by
      exact hE_carrier.symm
    _ = (((E : Set 𝓚)ᵒ⊖)ᵒ⊖) := by
      symm
      exact polarCone_polarCone_eq_self_of_properCone E
    _ = (((L.adjoint ⁻¹' (U : Set 𝓗))ᵒ⊖)ᵒ⊖) := by
      rw [hE_carrier]
    _ = (closure ((L.adjoint).adjoint '' ((U : Set 𝓗)ᵒ⊖)))ᵒ⊖ := by
      rw [polarCone_preimage_eq_closure_adjoint_image_polarCone (L := L.adjoint) (K := U)]
    _ = (closure (L '' ((U : Set 𝓗)ᵒ⊖)))ᵒ⊖ := by
      simp
    _ = (L '' ((U : Set 𝓗)ᵒ⊖))ᵒ⊖ := by
      rw [polarCone_closure_eq (L '' ((U : Set 𝓗)ᵒ⊖))]

end
