import Mathlib

-- Declarations for this item will be appended below by the statement pipeline.

universe u

open scoped Pointwise

variable {E : Type u} [AddCommGroup E] [Module ℝ E]

/-- Helper for Proposition 6.4: the cone generated by a convex set lies in its linear span. -/
lemma toCone_subset_span {C : Set E} (hC_convex : Convex ℝ C) :
    ((hC_convex.toCone C : ConvexCone ℝ E) : Set E) ⊆ (Submodule.span ℝ C : Set E) := by
  intro x hx
  -- Unpack cone membership into a positive scalar multiple of a point of `C`.
  rcases (hC_convex.mem_toCone).mp hx with ⟨c, hc, y, hy, rfl⟩
  -- The span contains `C` and is closed under scalar multiplication.
  exact (Submodule.span ℝ C).smul_mem c (Submodule.subset_span hy)

/-- Helper for Proposition 6.4: negating the cone over `C` produces the cone over `-C`. -/
lemma neg_toCone_eq_toCone_neg {C : Set E} (hC_convex : Convex ℝ C) :
    -(((hC_convex.toCone C : ConvexCone ℝ E) : Set E)) =
      ((hC_convex.neg.toCone (-C) : ConvexCone ℝ E) : Set E) := by
  ext x
  constructor
  · intro hx
    -- Rewrite membership in the negated cone as cone membership for `-x`.
    have hnegx : -x ∈ ((hC_convex.toCone C : ConvexCone ℝ E) : Set E) := by
      rwa [Set.mem_neg] at hx
    rcases (hC_convex.mem_toCone).mp hnegx with ⟨c, hc, y, hy, hyx⟩
    have hneg_mem : -y ∈ -C := by
      rw [Set.mem_neg]
      simpa
    have hx_repr : c • (-y) = x := by
      calc
        c • (-y) = -(c • y) := by rw [smul_neg]
        _ = -(-x) := by rw [hyx]
        _ = x := by rw [neg_neg]
    exact (hC_convex.neg.mem_toCone).mpr ⟨c, hc, -y, hneg_mem, hx_repr⟩
  · intro hx
    -- Reverse the previous argument to recover membership in the negated original cone.
    rcases (hC_convex.neg.mem_toCone).mp hx with ⟨c, hc, y, hy, hyx⟩
    have hy_mem : -y ∈ C := by
      rw [Set.mem_neg] at hy
      simpa using hy
    have hnegx : -x ∈ ((hC_convex.toCone C : ConvexCone ℝ E) : Set E) := by
      have hx_repr : c • (-y) = -x := by
        calc
          c • (-y) = -(c • y) := by rw [smul_neg]
          _ = -x := by rw [hyx]
      exact (hC_convex.mem_toCone).mpr ⟨c, hc, -y, hy_mem, hx_repr⟩
    rw [Set.mem_neg]
    exact hnegx

/-- Helper for Proposition 6.4: if `C = -C`, then the cone generated by `C` is stable under
negation. -/
lemma neg_toCone_eq_self_of_symmetric {C : Set E} (hC_convex : Convex ℝ C)
    (hC_symmetric : C = -C) :
    -(((hC_convex.toCone C : ConvexCone ℝ E) : Set E)) =
      (((hC_convex.toCone C : ConvexCone ℝ E) : Set E)) := by
  ext x
  constructor
  · intro hx
    -- Pass through the cone over `-C` and rewrite the base set using symmetry.
    have hx_neg : x ∈ ((hC_convex.neg.toCone (-C) : ConvexCone ℝ E) : Set E) := by
      rw [← neg_toCone_eq_toCone_neg hC_convex]
      exact hx
    rcases (hC_convex.neg.mem_toCone).mp hx_neg with ⟨c, hc, y, hy, hyx⟩
    have hyC : y ∈ C := by
      rw [hC_symmetric]
      exact hy
    exact (hC_convex.mem_toCone).mpr ⟨c, hc, y, hyC, hyx⟩
  · intro hx
    -- The same rewrite puts every cone element into the negated cone.
    have hx_neg : x ∈ ((hC_convex.neg.toCone (-C) : ConvexCone ℝ E) : Set E) := by
      rcases (hC_convex.mem_toCone).mp hx with ⟨c, hc, y, hy, hyx⟩
      have hyNeg : y ∈ -C := by
        rw [← hC_symmetric]
        exact hy
      exact (hC_convex.neg.mem_toCone).mpr ⟨c, hc, y, hyNeg, hyx⟩
    rw [neg_toCone_eq_toCone_neg hC_convex]
    exact hx_neg

-- Proof sketch: show that every vector in the linear span of `C` can be written as a difference of
-- two elements of the cone generated by `C`, and conversely use closure of the span under positive
-- scalar multiples and subtraction.
/-- Proposition 6.4 (1): for a nonempty convex subset `C` of a real vector space, its linear span
coincides with the difference of the cone generated by `C` with itself. -/
theorem span_eq_cone_sub_cone {C : Set E} (hC_nonempty : C.Nonempty) (hC_convex : Convex ℝ C) :
    ((Submodule.span ℝ C : Submodule ℝ E) : Set E) =
      ((hC_convex.toCone C : ConvexCone ℝ E) : Set E) -
        ((hC_convex.toCone C : ConvexCone ℝ E) : Set E) := by
  let K : ConvexCone ℝ E := hC_convex.toCone C
  ext x
  constructor
  · intro hx
    -- Build the difference representation by induction over the span of `C`.
    refine
      Submodule.span_induction (p := fun z _ => z ∈ ((K : Set E) - (K : Set E))) ?_ ?_ ?_ ?_ hx
    · intro y hy
      have hyK : y ∈ (K : Set E) := hC_convex.subset_toCone hy
      have h2yK : (2 : ℝ) • y ∈ (K : Set E) := K.smul_mem (by norm_num) hyK
      refine Set.mem_sub.mpr ?_
      refine ⟨(2 : ℝ) • y, h2yK, y, hyK, ?_⟩
      simp [two_smul]
    · rcases hC_nonempty with ⟨y, hy⟩
      have hyK : y ∈ (K : Set E) := hC_convex.subset_toCone hy
      refine Set.mem_sub.mpr ?_
      refine ⟨y, hyK, y, hyK, ?_⟩
      simp
    · intro y z hy hz hy_diff hz_diff
      rcases Set.mem_sub.mp hy_diff with ⟨u, hu, v, hv, huv⟩
      rcases Set.mem_sub.mp hz_diff with ⟨u', hu', v', hv', huv'⟩
      refine Set.mem_sub.mpr ?_
      refine ⟨u + u', K.add_mem hu hu', v + v', K.add_mem hv hv', ?_⟩
      calc
        (u + u') - (v + v') = (u - v) + (u' - v') := by abel
        _ = y + z := by rw [huv, huv']
    · intro a y hy hy_diff
      rcases Set.mem_sub.mp hy_diff with ⟨u, hu, v, hv, huv⟩
      by_cases ha_zero : a = 0
      · rcases hC_nonempty with ⟨w, hw⟩
        have hwK : w ∈ (K : Set E) := hC_convex.subset_toCone hw
        refine Set.mem_sub.mpr ?_
        refine ⟨w, hwK, w, hwK, ?_⟩
        simp [ha_zero]
      · by_cases ha_pos : 0 < a
        · refine Set.mem_sub.mpr ?_
          refine ⟨a • u, K.smul_mem ha_pos hu, a • v, K.smul_mem ha_pos hv, ?_⟩
          calc
            a • u - a • v = a • (u - v) := by rw [smul_sub]
            _ = a • y := by rw [huv]
        · have ha_neg : a < 0 := lt_of_le_of_ne (le_of_not_gt ha_pos) ha_zero
          have hneg_pos : 0 < -a := by linarith
          refine Set.mem_sub.mpr ?_
          refine ⟨(-a) • v, K.smul_mem hneg_pos hv, (-a) • u, K.smul_mem hneg_pos hu, ?_⟩
          calc
            (-a) • v - (-a) • u = (-a) • (v - u) := by rw [smul_sub]
            _ = (-a) • (-(u - v)) := by simp [sub_eq_add_neg, add_comm]
            _ = a • (u - v) := by rw [smul_neg, neg_smul, neg_neg]
            _ = a • y := by rw [huv]
  · intro hx
    -- Send each cone witness into the span and close by subtraction.
    rcases Set.mem_sub.mp hx with ⟨u, hu, v, hv, rfl⟩
    exact (Submodule.span ℝ C).sub_mem (toCone_subset_span hC_convex hu)
      (toCone_subset_span hC_convex hv)

-- Proof sketch: rewrite set subtraction as addition with the negated cone, then identify the
-- negation of the cone generated by `C` with the cone generated by `-C`.
/-- Proposition 6.4 (2): for a convex subset `C` of a real vector space, the difference of the
cone generated by `C` with itself equals the sum of that cone and the cone generated by `-C`. -/
theorem cone_sub_cone_eq_cone_add_cone_neg {C : Set E} (hC_convex : Convex ℝ C) :
    ((hC_convex.toCone C : ConvexCone ℝ E) : Set E) -
        ((hC_convex.toCone C : ConvexCone ℝ E) : Set E) =
      ((hC_convex.toCone C : ConvexCone ℝ E) : Set E) +
        ((hC_convex.neg.toCone (-C) : ConvexCone ℝ E) : Set E) := by
  ext x
  constructor
  · intro hx
    -- Rewrite the subtrahend as an element of the cone over `-C`.
    rcases Set.mem_sub.mp hx with ⟨u, hu, v, hv, huv⟩
    have hnegv : -v ∈ ((hC_convex.neg.toCone (-C) : ConvexCone ℝ E) : Set E) := by
      rw [← neg_toCone_eq_toCone_neg hC_convex]
      rw [Set.mem_neg]
      simpa using hv
    refine Set.mem_add.mpr ?_
    refine ⟨u, hu, -v, hnegv, ?_⟩
    calc
      u + -v = u - v := by rw [sub_eq_add_neg]
      _ = x := huv
  · intro hx
    -- Convert the second summand back to the negated original cone.
    rcases Set.mem_add.mp hx with ⟨u, hu, v, hv, huv⟩
    have hv_neg : v ∈ -(((hC_convex.toCone C : ConvexCone ℝ E) : Set E)) := by
      rw [neg_toCone_eq_toCone_neg hC_convex]
      exact hv
    have hnegv : -v ∈ ((hC_convex.toCone C : ConvexCone ℝ E) : Set E) := by
      rwa [Set.mem_neg] at hv_neg
    refine Set.mem_sub.mpr ?_
    refine ⟨u, hu, -v, hnegv, ?_⟩
    calc
      u - (-v) = u + v := by rw [sub_eq_add_neg, neg_neg]
      _ = x := huv

-- Proof sketch: under the symmetry hypothesis `C = -C`, the cone generated by `C` is already
-- closed under negation, so the reproducing-cone description from part (i) collapses to the cone
-- itself and yields the linear span.
/-- Proposition 6.4 (3): if a nonempty convex subset `C` of a real vector space satisfies
`C = -C`, then its linear span is exactly the cone generated by `C`. -/
theorem span_eq_cone_of_eq_neg {C : Set E} (hC_nonempty : C.Nonempty) (hC_convex : Convex ℝ C)
    (hC_symmetric : C = -C) :
    ((Submodule.span ℝ C : Submodule ℝ E) : Set E) =
      ((hC_convex.toCone C : ConvexCone ℝ E) : Set E) := by
  let K : ConvexCone ℝ E := hC_convex.toCone C
  -- Collapse the reproducing description from part (1) using symmetry of the cone.
  rw [span_eq_cone_sub_cone hC_nonempty hC_convex]
  ext x
  constructor
  · intro hx
    rcases Set.mem_sub.mp hx with ⟨u, hu, v, hv, huv⟩
    have hv_neg : -v ∈ (K : Set E) := by
      have hv_mem_neg : v ∈ -((K : Set E)) := by
        rw [neg_toCone_eq_self_of_symmetric hC_convex hC_symmetric]
        exact hv
      rwa [Set.mem_neg] at hv_mem_neg
    have hsum : u + -v ∈ (K : Set E) := K.add_mem hu hv_neg
    rw [← huv]
    simpa [sub_eq_add_neg] using hsum
  · intro hx
    -- Every cone element is `(2 • x) - x`, with both witnesses still in the cone.
    have h2x : (2 : ℝ) • x ∈ (K : Set E) := K.smul_mem (by norm_num) hx
    refine Set.mem_sub.mpr ?_
    refine ⟨(2 : ℝ) • x, h2x, x, hx, ?_⟩
    simp [two_smul]
