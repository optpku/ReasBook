omit [CompleteSpace 𝓗] in
/-- Helper for Example 6.40: a cone is stable under positive scalar multiplication. -/
private lemma smul_mem_of_mem_cone {K : Set 𝓗} (hK_cone : IsCone K) {x : 𝓗} (hx : x ∈ K)
    {a : ℝ} (ha : 0 < a) :
    a • x ∈ K := by
  rw [isCone_iff] at hK_cone
  rw [hK_cone]
  exact Set.mem_smul.mpr ⟨a, ha, x, hx, rfl⟩

omit [CompleteSpace 𝓗] in
/-- Helper for Example 6.40: a convex cone is closed under addition. -/
private lemma add_mem_of_mem_convex_cone {K : Set 𝓗} (hK_cone : IsCone K) (hK_convex : Convex ℝ K)
    {x y : 𝓗} (hx : x ∈ K) (hy : y ∈ K) :
    x + y ∈ K := by
  have hmid : (1 / 2 : ℝ) • x + (1 / 2 : ℝ) • y ∈ K := by
    exact (convex_iff_add_mem.1 hK_convex) hx hy (by positivity) (by positivity) (by norm_num)
  have hsum : (2 : ℝ) • ((1 / 2 : ℝ) • x + (1 / 2 : ℝ) • y) ∈ K := by
    exact smul_mem_of_mem_cone hK_cone hmid (by positivity)
  simpa [smul_add, smul_smul] using hsum

omit [CompleteSpace 𝓗] in
/-- Helper for Example 6.40: adding the nonnegative ray generated by a point of a convex cone does
not leave the cone. -/
lemma add_nonnegative_ray_eq_self_of_mem_convex_cone {K : Set 𝓗} (hK_cone : IsCone K)
    (hK_convex : Convex ℝ K) {x : 𝓗} (hx : x ∈ K) :
    K + (Set.Ici (0 : ℝ) • ({x} : Set 𝓗)) = K := by
  ext z
  constructor
  · intro hz
    -- The cone and convexity hypotheses give additive closure of `K`.
    rcases Set.mem_add.mp hz with ⟨y, hy, w, hw, hwz⟩
    rcases Set.mem_smul.mp hw with ⟨a, ha, v, hv, hav⟩
    have hvx : v = x := by
      simpa using hv
    subst v
    have hw_eq : w = a • x := hav.symm
    subst w
    -- The ray contribution stays in `K`, so the whole sum stays in `K`.
    by_cases hzero : a = 0
    · have hz_eq : z = y := by
        simpa [hzero] using hwz.symm
      simpa [hz_eq] using hy
    · have ha_pos : 0 < a := lt_of_le_of_ne ha (Ne.symm hzero)
      have hax : a • x ∈ K := smul_mem_of_mem_cone hK_cone hx ha_pos
      have hyax : y + a • x ∈ K := add_mem_of_mem_convex_cone hK_cone hK_convex hy hax
      simpa [hwz] using hyax
  · intro hz
    -- Conversely, `z = z + 0`, and the zero vector lies on the nonnegative ray through `x`.
    have hzero_nonneg : (0 : ℝ) ∈ Set.Ici (0 : ℝ) := by
      simp
    have hx_singleton : x ∈ ({x} : Set 𝓗) := by
      simp
    have hzero_eq : (0 : ℝ) • x = (0 : 𝓗) := by
      simp
    have hzero_ray : (0 : 𝓗) ∈ Set.Ici (0 : ℝ) • ({x} : Set 𝓗) := by
      exact Set.mem_smul.mpr ⟨0, hzero_nonneg, x, hx_singleton, hzero_eq⟩
    have hsum : z + (0 : 𝓗) = z := by
      simp
    exact Set.mem_add.mpr ⟨z, hz, 0, hzero_ray, hsum⟩

omit [CompleteSpace 𝓗] in
/-- Helper for Example 6.40: membership in `K + ℝ x` is equivalent to membership in a positive
dilate of the translated cone generator `K - {x}`. -/
lemma mem_add_line_iff_exists_pos_smul_sub_singleton_of_mem_convex_cone {K : Set 𝓗}
    (hK_cone : IsCone K) (hK_convex : Convex ℝ K) {x z : 𝓗} (hx : x ∈ K) :
    z ∈ K + (ℝ ∙ x : Set 𝓗) ↔ ∃ a : ℝ, 0 < a ∧ z ∈ a • (K - ({x} : Set 𝓗)) := by
  constructor
  · intro hz
    -- Decompose the point into a cone part and a line part.
    rcases Set.mem_add.mp hz with ⟨y, hy, w, hw, hwz⟩
    have hw' : ∃ b : ℝ, b • x = w := by
      simpa [Submodule.mem_span_singleton] using hw
    rcases hw' with ⟨b, rfl⟩
    let a : ℝ := |b| + 1
    have ha_pos : 0 < a := by
      positivity
    let v : 𝓗 := (1 / a) • y + ((b + a) / a) • x
    have hy_scaled : (1 / a) • y ∈ K := smul_mem_of_mem_cone hK_cone hy (by positivity)
    have hcoeff_pos : 0 < (b + a) / a := by
      have hnum_nonneg : 0 ≤ b + |b| := by
        nlinarith [neg_abs_le b]
      have hnum_pos : 0 < b + a := by
        dsimp [a]
        nlinarith
      exact div_pos hnum_pos ha_pos
    have hx_scaled : ((b + a) / a) • x ∈ K := smul_mem_of_mem_cone hK_cone hx hcoeff_pos
    have hv_mem : v ∈ K := add_mem_of_mem_convex_cone hK_cone hK_convex hy_scaled hx_scaled
    have hx_singleton : x ∈ ({x} : Set 𝓗) := by
      simp
    have hv_sub : v - x ∈ K - ({x} : Set 𝓗) := by
      exact Set.mem_sub.mpr ⟨v, hv_mem, x, hx_singleton, rfl⟩
    -- Choosing `a = |b| + 1` makes both coefficients nonnegative and recovers `z`.
    have hscale : a • (v - x) = y + b • x := by
      have hcoeff : a * ((b + a) / a) - a = b := by
        field_simp [ha_pos.ne']
        ring
      have hscalar :
          (a * ((b + a) / a)) • x + -(a • x) = (a * ((b + a) / a) - a) • x := by
        simpa [sub_eq_add_neg] using (sub_smul (a * ((b + a) / a)) a x).symm
      calc
        a • (v - x) = y + ((a * ((b + a) / a)) • x + -(a • x)) := by
          simp [v, sub_eq_add_neg, smul_add, smul_smul, ha_pos.ne', add_assoc, add_comm]
        _ = y + (a * ((b + a) / a) - a) • x := by rw [hscalar]
        _ = y + b • x := by rw [hcoeff]
    have hz_scaled : z ∈ a • (K - ({x} : Set 𝓗)) := by
      exact Set.mem_smul_set.mpr ⟨v - x, hv_sub, Eq.trans hscale hwz⟩
    exact ⟨a, ha_pos, hz_scaled⟩
  · intro hz
    rcases hz with ⟨a, ha_pos, hz⟩
    rcases Set.mem_smul_set.mp hz with ⟨v, hv, hvz⟩
    rcases Set.mem_sub.mp hv with ⟨y, hy, w, hw, hywv⟩
    have hwx : w = x := by
      simpa using hw
    subst w
    have hv_eq : v = y - x := by
      simpa using hywv.symm
    subst v
    -- A positive dilate of a translated point splits into a cone element plus a line element.
    have hay : a • y ∈ K := smul_mem_of_mem_cone hK_cone hy ha_pos
    have hline : (-a) • x ∈ (ℝ ∙ x : Set 𝓗) := by
      exact Submodule.smul_mem (ℝ ∙ x) (-a) (Submodule.subset_span (by simp))
    have hsum : a • y + (-a) • x = z := by
      calc
        a • y + (-a) • x = a • (y - x) := by
          simp [sub_eq_add_neg, smul_add]
        _ = z := hvz
    exact Set.mem_add.mpr ⟨a • y, hay, (-a) • x, hline, hsum⟩

-- Proof sketch: rewrite `T[K] x` as `closure (cone (K - {x}))` using `tangentCone_of_mem hx`. The
-- translated cone generator is convex, so `ConvexCone.mem_hull_of_convex` identifies its cone hull
-- with the positive dilates appearing in the textbook proof, and the previous helper identifies
-- those dilates with `K + ℝ x`.
omit [CompleteSpace 𝓗] in
/-- Example 6.40 (1): if `K` is a convex cone in a real Hilbert space and `x ∈ K`, then the
tangent cone at `x` is the closure of `K + ℝ x`, represented in Lean as the set sum with the line
`ℝ ∙ x`. -/
theorem tangentCone_eq_closure_add_line_of_mem_convex_cone {K : Set 𝓗} (hK_cone : IsCone K)
    (hK_convex : Convex ℝ K) {x : 𝓗} (hx : x ∈ K) :
    T[K] x = closure (K + (ℝ ∙ x : Set 𝓗)) := by
  -- The translate `K - {x}` stays convex, so its conical hull has the standard positive-dilate form.
  have htranslate_convex : Convex ℝ (K - ({x} : Set 𝓗)) := by
    simpa [sub_eq_add_neg] using hK_convex.add (convex_singleton (-x))
  have hcone_eq : cone (K - ({x} : Set 𝓗)) = K + (ℝ ∙ x : Set 𝓗) := by
    ext z
    -- This is exactly the textbook decomposition `K + ℝ x = ⋃_{a>0} a (K - x)`.
    change z ∈ (ConvexCone.hull ℝ (K - ({x} : Set 𝓗)) : Set 𝓗) ↔ z ∈ K + (ℝ ∙ x : Set 𝓗)
    constructor
    · intro hz
      exact
        (mem_add_line_iff_exists_pos_smul_sub_singleton_of_mem_convex_cone
          hK_cone hK_convex hx).2 ((ConvexCone.mem_hull_of_convex htranslate_convex).1 hz)
    · intro hz
      exact
        (ConvexCone.mem_hull_of_convex htranslate_convex).2
          ((mem_add_line_iff_exists_pos_smul_sub_singleton_of_mem_convex_cone
            hK_cone hK_convex hx).1 hz)
  -- After rewriting the tangent cone, the cone identity can be substituted directly.
  rw [tangentCone_of_mem hx, hcone_eq]

omit [CompleteSpace 𝓗] in
/-- Helper for Example 6.40: the translated normal inequality on `K - {x}` forces orthogonality to
`x`. -/
lemma inner_eq_zero_of_normal_translate_ineq_of_mem_convex_cone {K : Set 𝓗} (hK_cone : IsCone K)
    {x u : 𝓗} (hx : x ∈ K)
    (hsub : ∀ v ∈ K - ({x} : Set 𝓗), ⟪v, u⟫_ℝ ≤ 0) :
    ⟪x, u⟫_ℝ = 0 := by
  have hhalf_mem : ((1 / 2 : ℝ) • x) ∈ K := smul_mem_of_mem_cone hK_cone hx (by positivity)
  have htwo_mem : ((2 : ℝ) • x) ∈ K := smul_mem_of_mem_cone hK_cone hx (by positivity)
  have hx_singleton : x ∈ ({x} : Set 𝓗) := by
    simp
  -- Testing the inequality at `x / 2` gives the reverse sign on `⟪x, u⟫`.
  have hneg_half_eq : ((1 / 2 : ℝ) • x) - x = (-(1 / 2 : ℝ)) • x := by
    rw [sub_eq_add_neg]
    calc
      ((1 / 2 : ℝ) • x) + -x = ((1 / 2 : ℝ) • x) + (-1 : ℝ) • x := by
        simp
      _ = ((1 / 2 : ℝ) + (-1 : ℝ)) • x := by
        simpa using (add_smul (1 / 2 : ℝ) (-1 : ℝ) x).symm
      _ = (-(1 / 2 : ℝ)) • x := by norm_num
  have hneg_half_mem : (-(1 / 2 : ℝ)) • x ∈ K - ({x} : Set 𝓗) := by
    exact Set.mem_sub.mpr ⟨(1 / 2 : ℝ) • x, hhalf_mem, x, hx_singleton, hneg_half_eq⟩
  have hneg_half_le : ⟪(-(1 / 2 : ℝ)) • x, u⟫_ℝ ≤ 0 := hsub _ hneg_half_mem
  -- Testing at `2x` gives the forward sign.
  have hx_eq : ((2 : ℝ) • x) - x = x := by
    rw [sub_eq_add_neg]
    calc
      ((2 : ℝ) • x) + -x = ((2 : ℝ) • x) + (-1 : ℝ) • x := by
        simp
      _ = ((2 : ℝ) + (-1 : ℝ)) • x := by
        simpa using (add_smul (2 : ℝ) (-1 : ℝ) x).symm
      _ = x := by norm_num
  have hx_mem_translate : x ∈ K - ({x} : Set 𝓗) := by
    exact Set.mem_sub.mpr ⟨(2 : ℝ) • x, htwo_mem, x, hx_singleton, hx_eq⟩
  have hx_le : ⟪x, u⟫_ℝ ≤ 0 := hsub _ hx_mem_translate
  have hnonneg : 0 ≤ ⟪x, u⟫_ℝ := by
    have hscaled : (-(1 / 2 : ℝ)) * ⟪x, u⟫_ℝ ≤ 0 := by
      simpa [real_inner_smul_left] using hneg_half_le
    nlinarith
  linarith

/-- Helper for Example 6.40: the translated support inequality defining the normal cone is exactly
membership in the polar cone together with orthogonality to `x`. -/
lemma
    normal_translate_ineq_iff_mem_polarCone_inter_orthogonalSet_singleton_of_mem_convex_cone
    {K : Set 𝓗} (hK_cone : IsCone K) {x u : 𝓗} (hx : x ∈ K) :
    innerSupremumOn (K - ({x} : Set 𝓗)) u ≤ 0 ↔ u ∈ Kᵒ⊖ ∩ orthogonalSet ({x} : Set 𝓗) := by
  constructor
  · intro hineq
    -- Convert the support inequality into pointwise inequalities on `K - {x}`.
    have hzero_bound : innerSupremumOn (K - ({x} : Set 𝓗)) u ≤ innerInfimumOn ({0} : Set 𝓗) u :=
      by
        simpa using hineq
    have hpointwise :=
      (innerSupremumOn_le_innerInfimumOn_iff_forall_inner_le
        (K - ({x} : Set 𝓗)) ({0} : Set 𝓗) u).mp hzero_bound
    have hzero_mem : (0 : 𝓗) ∈ ({0} : Set 𝓗) := by
      simp
    have hsub : ∀ v ∈ K - ({x} : Set 𝓗), ⟪v, u⟫_ℝ ≤ 0 := by
      intro v hv
      simpa using hpointwise v hv 0 hzero_mem
    have hx_orth : ⟪x, u⟫_ℝ = 0 :=
      inner_eq_zero_of_normal_translate_ineq_of_mem_convex_cone hK_cone hx hsub
    -- Orthogonality to `x` lets us rewrite the translated inequality as the polar inequality on `K`.
    have hu_polar : u ∈ Kᵒ⊖ := by
      rw [Set.mem_negativePolar]
      intro y hy
      have hx_singleton : x ∈ ({x} : Set 𝓗) := by
        simp
      have hy_sub : y - x ∈ K - ({x} : Set 𝓗) := by
        exact Set.mem_sub.mpr ⟨y, hy, x, hx_singleton, rfl⟩
      have hyx_le : ⟪y - x, u⟫_ℝ ≤ 0 := hsub _ hy_sub
      have hyx_eq : ⟪y - x, u⟫_ℝ = ⟪y, u⟫_ℝ - ⟪x, u⟫_ℝ := by
        rw [sub_eq_add_neg, inner_add_left]
        simp [sub_eq_add_neg]
      rw [hyx_eq, hx_orth] at hyx_le
      simpa using hyx_le
    have hu_orth : u ∈ orthogonalSet ({x} : Set 𝓗) := by
      rw [Set.mem_orthogonalSet]
      intro y hy
      have hyx : y = x := by
        simpa using hy
      simpa [hyx] using hx_orth
    exact ⟨hu_polar, hu_orth⟩
  · rintro ⟨hu_polar, hu_orth⟩
    rw [Set.mem_negativePolar] at hu_polar
    rw [Set.mem_orthogonalSet] at hu_orth
    -- Expand `⟪y - x, u⟫` and use the two target conditions separately.
    have hsub : ∀ v ∈ K - ({x} : Set 𝓗), ⟪v, u⟫_ℝ ≤ 0 := by
      intro v hv
      rcases Set.mem_sub.mp hv with ⟨y, hy, w, hw, hywv⟩
      have hwx : w = x := by
        simpa using hw
      subst w
      have hx_singleton : x ∈ ({x} : Set 𝓗) := by
        simp
      have hx_zero : ⟪x, u⟫_ℝ = 0 := hu_orth x hx_singleton
      have hy_le : ⟪y, u⟫_ℝ ≤ 0 := hu_polar y hy
      have hv_eq : v = y - x := by
        simpa using hywv.symm
      calc
        ⟪v, u⟫_ℝ = ⟪y - x, u⟫_ℝ := by
          simp [hv_eq]
        _ = ⟪y, u⟫_ℝ + ⟪-x, u⟫_ℝ := by
          rw [sub_eq_add_neg, inner_add_left]
        _ = ⟪y, u⟫_ℝ - ⟪x, u⟫_ℝ := by
          simp [sub_eq_add_neg]
        _ = ⟪y, u⟫_ℝ := by
          simp [hx_zero]
        _ ≤ 0 := hy_le
    have hpointwise : ∀ v ∈ K - ({x} : Set 𝓗), ∀ z ∈ ({0} : Set 𝓗), ⟪v, u⟫_ℝ ≤ ⟪z, u⟫_ℝ := by
      intro v hv z hz
      have hz0 : z = 0 := by
        simpa using hz
      subst z
      simpa using hsub v hv
    have hzero_bound :
        innerSupremumOn (K - ({x} : Set 𝓗)) u ≤ innerInfimumOn ({0} : Set 𝓗) u :=
      (innerSupremumOn_le_innerInfimumOn_iff_forall_inner_le
        (K - ({x} : Set 𝓗)) ({0} : Set 𝓗) u).mpr hpointwise
    simpa using hzero_bound

-- Proof sketch: rewrite `N[K] x` using `normalCone_of_mem hx`, then use the previous helper to
-- translate the support inequality into the intersection `Kᵒ⊖ ∩ {x}^⊥`.
/-- Example 6.40 (2): if `K` is a convex cone in a real Hilbert space and `x ∈ K`, then the
normal cone at `x` is the intersection of the polar cone of `K` with the orthogonal set of the
singleton `{x}`. -/
theorem normalCone_eq_polarCone_inter_orthogonalSet_singleton_of_mem_convex_cone
    {K : Set 𝓗} (hK_cone : IsCone K) (hK_convex : Convex ℝ K) {x : 𝓗} (hx : x ∈ K) :
    N[K] x = Kᵒ⊖ ∩ orthogonalSet ({x} : Set 𝓗) := by
  -- The convexity assumption is part of the textbook statement; the cone rewrite itself only uses `hx`.
  let _ := hK_convex
  rw [normalCone_of_mem hx]
  ext u
  exact
    normal_translate_ineq_iff_mem_polarCone_inter_orthogonalSet_singleton_of_mem_convex_cone
      hK_cone hx

end

end Set
