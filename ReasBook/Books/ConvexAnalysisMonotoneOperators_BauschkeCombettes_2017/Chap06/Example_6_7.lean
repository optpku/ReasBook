import Mathlib
import ConvexAnalysisMonotoneOperators_BauschkeCombettes_2017.Chap01.Text_1_0_2

-- Declarations for this item will be appended below by the statement pipeline.

open Filter
open Set
open scoped Pointwise

universe u

section

variable (I : Type u)

/-- The positive orthant in `ℓ²(I)`, consisting of vectors with nonnegative coordinates. -/
def ell2PositiveOrthant : Set (PiLp 2 fun _ : I ↦ ℝ) :=
  {ξ | ∀ i, 0 ≤ ξ i}

/-- The set of standard unit vectors in `ℓ²(I)`. -/
noncomputable def ell2StandardUnitVectors : Set (PiLp 2 fun _ : I ↦ ℝ) :=
  let _ : DecidableEq I := Classical.decEq I
  Set.range (fun i ↦ PiLp.single 2 i (1 : ℝ))

/-- The negative orthant in `ℓ²(I)`, defined as the negative of the positive orthant. -/
def ell2NegativeOrthant : Set (PiLp 2 fun _ : I ↦ ℝ) :=
  -ell2PositiveOrthant I

/-- The conic hull of the convex hull of the standard unit vectors in `ℓ²(I)`. -/
noncomputable def ell2StandardUnitCone : ConvexCone ℝ (PiLp 2 fun _ : I ↦ ℝ) :=
  (convex_convexHull ℝ (ell2StandardUnitVectors I)).toCone _

variable {I : Type u}

/-- Helper for Example 6.7: membership in the negative orthant is coordinatewise nonpositivity. -/
private theorem mem_ell2NegativeOrthant_iff (ξ : PiLp 2 fun _ : I ↦ ℝ) :
    ξ ∈ ell2NegativeOrthant I ↔ ∀ i, ξ i ≤ 0 := by
  -- Unfolding the pointwise negation turns the definition into coordinatewise inequalities.
  constructor
  · intro hξ
    rw [ell2NegativeOrthant, Set.mem_neg] at hξ
    intro i
    exact neg_nonneg.mp (by simpa using hξ i)
  · intro hξ
    rw [ell2NegativeOrthant, Set.mem_neg]
    intro i
    exact neg_nonneg.mpr (hξ i)

/-- Helper for Example 6.7: the finite truncation agrees with the expected indicator formula on
coordinates. -/
private theorem finite_truncation_apply [DecidableEq I] (ξ : PiLp 2 fun _ : I ↦ ℝ)
    (s : Finset I) (j : I) :
    (∑ i ∈ s, ξ i • PiLp.single (p := 2) (β := fun _ : I ↦ ℝ) i (1 : ℝ)) j =
      if j ∈ s then ξ j else 0 := by
  -- Coordinatewise, only the `j`-th basis vector contributes to the sum.
  classical
  induction s using Finset.induction_on with
  | empty =>
      simp
  | @insert i s hi ih =>
      by_cases hji : j = i
      · subst hji
        simp [hi, ih]
      · simp [Finset.mem_insert, hi, hji, ih]

/-- Helper for Example 6.7: the `toLp` truncation is exactly the finite sum of basis vectors. -/
private theorem toLp_truncation_eq_sum [DecidableEq I] (ξ : PiLp 2 fun _ : I ↦ ℝ) (s : Finset I) :
    WithLp.toLp 2 (fun i : I ↦ if i ∈ s then ξ i else 0) =
      ∑ i ∈ s, ξ i • PiLp.single (p := 2) (β := fun _ : I ↦ ℝ) i (1 : ℝ) := by
  -- Extensionality reduces the identity to the coordinate formula above.
  ext j
  simp [finite_truncation_apply]

/-- Helper for Example 6.7: the positive orthant is closed. -/
private theorem positiveOrthant_isClosed :
    IsClosed (ell2PositiveOrthant I) := by
  -- Each coordinate half-space is closed, and arbitrary intersections of closed sets stay closed.
  have hclosed : IsClosed (⋂ i : I, {ξ : PiLp 2 fun _ : I ↦ ℝ | 0 ≤ ξ i}) := by
    refine isClosed_iInter fun i ↦ ?_
    exact isClosed_le continuous_const (PiLp.continuous_apply (p := 2) (β := fun _ : I ↦ ℝ) i)
  convert hclosed using 1
  ext ξ
  simp [ell2PositiveOrthant]

/-- Helper for Example 6.7: the positive orthant is convex. -/
private theorem positiveOrthant_convex :
    Convex ℝ (ell2PositiveOrthant I) := by
  -- Convex combinations preserve each coordinate inequality separately.
  intro x hx y hy a b ha hb hab i
  have hx' := hx i
  have hy' := hy i
  simpa [smul_add, add_comm, add_left_comm, add_assoc, mul_comm, mul_left_comm, mul_assoc] using
    add_nonneg (mul_nonneg ha hx') (mul_nonneg hb hy')

/-- Helper for Example 6.7: every standard unit vector already lies in the positive orthant. -/
private theorem standard_unit_vectors_subset_positive_orthant :
    ell2StandardUnitVectors I ⊆ ell2PositiveOrthant I := by
  -- Each basis vector has one coordinate equal to `1` and all others equal to `0`.
  classical
  rintro x ⟨i, rfl⟩ j
  by_cases h : j = i
  · subst h
    simp
  · simp [h]

/-- Helper for Example 6.7: the zero vector lies in the closure of the cone generated by the
standard unit vectors. -/
private theorem zero_mem_closure_standardUnitCone [Nonempty I] :
    (0 : PiLp 2 fun _ : I ↦ ℝ) ∈
      closure (ell2StandardUnitCone I : Set (PiLp 2 fun _ : I ↦ ℝ)) := by
  -- Scale a fixed basis vector by `1 / (n + 1)` and let the scalar tend to `0`.
  classical
  let i0 : I := Classical.choice ‹Nonempty I›
  let f : ℕ → PiLp 2 fun _ : I ↦ ℝ := fun n ↦
    ((1 : ℝ) / (n + 1)) • PiLp.single (p := 2) (β := fun _ : I ↦ ℝ) i0 (1 : ℝ)
  have hf_mem :
      ∀ n, f n ∈ (ell2StandardUnitCone I : Set (PiLp 2 fun _ : I ↦ ℝ)) := by
    intro n
    have hvec :
        PiLp.single (p := 2) (β := fun _ : I ↦ ℝ) i0 (1 : ℝ) ∈
          convexHull ℝ (ell2StandardUnitVectors I) := by
      exact subset_convexHull ℝ _ ⟨i0, rfl⟩
    have hmem_toCone :
        f n ∈
          (convex_convexHull ℝ (ell2StandardUnitVectors I)).toCone
            (convexHull ℝ (ell2StandardUnitVectors I)) := by
      refine (convex_convexHull ℝ (ell2StandardUnitVectors I)).mem_toCone.2 ?_
      refine ⟨(1 : ℝ) / (n + 1), by positivity,
        PiLp.single (p := 2) (β := fun _ : I ↦ ℝ) i0 (1 : ℝ), hvec, rfl⟩
    simpa [ell2StandardUnitCone, f] using hmem_toCone
  have hf_fun :
      Tendsto (fun n ↦ ((f n : PiLp 2 fun _ : I ↦ ℝ) : I → ℝ)) atTop (nhds (0 : I → ℝ)) := by
    rw [tendsto_pi_nhds]
    intro j
    by_cases hj : j = i0
    · subst hj
      have h1 : Tendsto (fun n : ℕ ↦ ((n : ℝ) + 1)) atTop atTop :=
        tendsto_atTop_add_const_right _ _ tendsto_natCast_atTop_atTop
      simpa [f, one_div] using (tendsto_inv_atTop_zero.comp h1)
    · simpa [f, hj] using
        (tendsto_const_nhds : Tendsto (fun _ : ℕ ↦ (0 : ℝ)) atTop (nhds 0))
  have hf_tendsto : Tendsto f atTop (nhds 0) := by
    simpa [f] using
      ((PiLp.continuous_toLp (p := 2) (β := fun _ : I ↦ ℝ)).tendsto (0 : I → ℝ)).comp hf_fun
  exact mem_closure_of_tendsto hf_tendsto (Eventually.of_forall hf_mem)

-- Route correction: `toCone` here omits the zero vector, so zero truncations are handled in the
-- closure rather than in the raw cone.
/-- Helper for Example 6.7: every finite truncation of a nonnegative vector lies in the closure of
the cone generated by the standard unit vectors. -/
private theorem finite_truncation_mem_closure_standardUnitCone [Nonempty I] [DecidableEq I]
    (ξ : PiLp 2 fun _ : I ↦ ℝ) (hξ : ξ ∈ ell2PositiveOrthant I) (s : Finset I) :
    WithLp.toLp 2 (fun i : I ↦ if i ∈ s then ξ i else 0) ∈
      closure (ell2StandardUnitCone I : Set (PiLp 2 fun _ : I ↦ ℝ)) := by
  classical
  let total : ℝ := ∑ i ∈ s, ξ i
  by_cases htotal : total = 0
  · -- If the total mass vanishes, then every truncated coordinate is `0`, so we reduce to `0`.
    have hw_zero : ∀ j ∈ s, ξ j = 0 := by
      intro j hj
      have hj_nonneg : 0 ≤ ξ j := hξ j
      have hj_le_total : ξ j ≤ total := by
        simpa [total] using
          (Finset.single_le_sum (fun i hi ↦ hξ i) hj : ξ j ≤ ∑ i ∈ s, ξ i)
      have hj_nonpos : ξ j ≤ 0 := by
        simpa [total, htotal] using hj_le_total
      exact le_antisymm hj_nonpos hj_nonneg
    have htrunc_zero : WithLp.toLp 2 (fun i : I ↦ if i ∈ s then ξ i else 0) = 0 := by
      ext j
      by_cases hj : j ∈ s
      · simp [hj, hw_zero j hj]
      · simp [hj]
    simpa [htrunc_zero] using zero_mem_closure_standardUnitCone (I := I)
  · -- Otherwise normalize the coefficients into a convex combination and scale back.
    have htotal_nonneg : 0 ≤ total := by
      exact Finset.sum_nonneg fun i hi ↦ hξ i
    have htotal_pos : 0 < total :=
      lt_of_le_of_ne htotal_nonneg (Ne.symm htotal)
    let w : I → ℝ := fun i ↦ ξ i
    let z : I → PiLp 2 fun _ : I ↦ ℝ := fun i ↦
      PiLp.single (p := 2) (β := fun _ : I ↦ ℝ) i (1 : ℝ)
    have hcenter :
        s.centerMass w z ∈ convexHull ℝ (ell2StandardUnitVectors I) := by
      -- Normalizing the nonnegative coefficients produces a convex combination of unit vectors.
      refine Finset.centerMass_mem_convexHull _ ?_ htotal_pos ?_
      · intro i hi
        exact hξ i
      · intro i hi
        change PiLp.single (p := 2) (β := fun _ : I ↦ ℝ) i (1 : ℝ) ∈ ell2StandardUnitVectors I
        refine ⟨i, ?_⟩
        ext j
        by_cases h : j = i
        · subst h
          simp
        · simp [h]
    have hmem_toCone :
        (∑ i ∈ s, ξ i • PiLp.single (p := 2) (β := fun _ : I ↦ ℝ) i (1 : ℝ)) ∈
          (ell2StandardUnitCone I : Set (PiLp 2 fun _ : I ↦ ℝ)) := by
      have :
          (∑ i ∈ s, ξ i • PiLp.single (p := 2) (β := fun _ : I ↦ ℝ) i (1 : ℝ)) ∈
            (convex_convexHull ℝ (ell2StandardUnitVectors I)).toCone
              (convexHull ℝ (ell2StandardUnitVectors I)) := by
        refine (convex_convexHull ℝ (ell2StandardUnitVectors I)).mem_toCone.2 ?_
        refine ⟨total, htotal_pos, s.centerMass w z, hcenter, ?_⟩
        -- Multiplying the center of mass by the total mass reconstructs the truncation sum.
        simp [Finset.centerMass, total, htotal_pos.ne', w, z, smul_smul]
      simpa [ell2StandardUnitCone] using this
    have hmem_closure :
        (∑ i ∈ s, ξ i • PiLp.single (p := 2) (β := fun _ : I ↦ ℝ) i (1 : ℝ)) ∈
          closure (ell2StandardUnitCone I : Set (PiLp 2 fun _ : I ↦ ℝ)) :=
      subset_closure hmem_toCone
    simpa [toLp_truncation_eq_sum] using hmem_closure

-- Proof sketch: the positive orthant is a closed cone containing every standard unit vector, so it
-- contains the closed conic hull generated by them. For the converse inclusion, approximate any
-- nonnegative `ℓ²` vector by finitely supported truncations, each of which belongs to the closure
-- of the conic hull of the standard unit vectors.
/-- Example 6.7: the positive orthant in `ℓ²(I)` equals the closure of the conic hull of the
convex hull of the standard unit vectors. -/
theorem ell2PositiveOrthant_eq_closure_standardUnitCone [Nonempty I] :
    ell2PositiveOrthant I =
      closure (ell2StandardUnitCone I : Set (PiLp 2 fun _ : I ↦ ℝ)) := by
  classical
  refine Subset.antisymm ?_ ?_
  · intro ξ hξ
    let truncFun : Finset I → I → ℝ := fun s i ↦ if i ∈ s then ξ i else 0
    have htrunc_mem :
        ∀ s : Finset I,
          WithLp.toLp 2 (truncFun s) ∈
            closure (ell2StandardUnitCone I : Set (PiLp 2 fun _ : I ↦ ℝ)) := by
      intro s
      exact finite_truncation_mem_closure_standardUnitCone (I := I) ξ hξ s
    have htrunc_tendsto_fun :
        Tendsto truncFun atTop (nhds fun i : I ↦ ξ i) := by
      -- Each coordinate stabilizes once the truncation contains that coordinate.
      rw [tendsto_pi_nhds]
      intro i
      have hUi : ∀ᶠ s : Finset I in atTop, truncFun s i = ξ i := by
        filter_upwards [eventually_ge_atTop ({i} : Finset I)] with s hs
        have hi : i ∈ s := hs (by simp)
        simp [truncFun, hi]
      have hUi' : (fun _s : Finset I ↦ ξ i) =ᶠ[atTop] fun s ↦ truncFun s i := by
        filter_upwards [hUi] with s hs
        exact hs.symm
      exact Tendsto.congr' hUi' tendsto_const_nhds
    have htrunc_tendsto :
        Tendsto (fun s : Finset I ↦ WithLp.toLp 2 (truncFun s)) atTop (nhds ξ) := by
      simpa [truncFun] using
        ((PiLp.continuous_toLp (p := 2) (β := fun _ : I ↦ ℝ)).tendsto (fun i : I ↦ ξ i)).comp
          htrunc_tendsto_fun
    -- The closed set `closure (ell2StandardUnitCone I)` contains all truncations and their limit.
    exact isClosed_closure.mem_of_tendsto htrunc_tendsto (Eventually.of_forall htrunc_mem)
  · have hconvexHull :
        convexHull ℝ (ell2StandardUnitVectors I) ⊆ ell2PositiveOrthant I :=
      convexHull_min (standard_unit_vectors_subset_positive_orthant (I := I))
        (positiveOrthant_convex (I := I))
    have hcone :
        (ell2StandardUnitCone I : Set (PiLp 2 fun _ : I ↦ ℝ)) ⊆ ell2PositiveOrthant I := by
      intro x hx
      rcases (convex_convexHull ℝ (ell2StandardUnitVectors I)).mem_toCone.mp
          (by simpa [ell2StandardUnitCone] using hx) with ⟨c, hc, y, hy, rfl⟩
      -- Positive scaling preserves coordinatewise nonnegativity.
      intro i
      exact mul_nonneg hc.le ((hconvexHull hy) i)
    exact (positiveOrthant_isClosed (I := I)).closure_subset_iff.2 hcone

-- Proof sketch: the zero vector has all coordinates equal to `0`, so it belongs to the positive
-- orthant.
/-- The positive orthant in `ℓ²(I)` is nonempty. -/
theorem ell2PositiveOrthant_nonempty :
    (ell2PositiveOrthant I).Nonempty := by
  -- The zero vector is coordinatewise nonnegative.
  refine ⟨0, ?_⟩
  intro i
  simp

-- Proof sketch: write the positive orthant as the intersection over `i : I` of the closed
-- half-spaces `{ξ | 0 ≤ ξ i}` and use continuity of the coordinate projections.
/-- The positive orthant in `ℓ²(I)` is closed. -/
theorem ell2PositiveOrthant_isClosed :
    IsClosed (ell2PositiveOrthant I) := by
  -- This is the previously established coordinatewise closedness statement.
  exact positiveOrthant_isClosed (I := I)

-- Proof sketch: coordinatewise nonnegativity is preserved under convex combinations, so the
-- positive orthant is convex.
/-- The positive orthant in `ℓ²(I)` is convex. -/
theorem ell2PositiveOrthant_convex :
    Convex ℝ (ell2PositiveOrthant I) := by
  -- This is the previously established coordinatewise convexity statement.
  exact positiveOrthant_convex (I := I)

-- Proof sketch: if `ξ` has nonnegative coordinates and `a > 0`, then every coordinate of `a • ξ`
-- remains nonnegative; use the project definition of `IsCone`.
/-- The positive orthant in `ℓ²(I)` is a cone. -/
theorem ell2PositiveOrthant_isCone :
    IsCone (ell2PositiveOrthant I) := by
  -- Unfolding `IsCone` reduces the cone property to coordinatewise positivity under scaling.
  ext ξ
  constructor
  · intro hξ
    refine ⟨1, by simpa, ξ, hξ, by simp⟩
  · rintro ⟨a, ha, ξ, hξ, rfl⟩
    intro i
    exact mul_nonneg ha.le (hξ i)

-- Proof sketch: if a vector lies in both the positive orthant and its negative, then every
-- coordinate is both nonnegative and nonpositive, hence all coordinates vanish.
/-- The positive orthant in `ℓ²(I)` is pointed in the sense that its intersection with its
negative is `{0}`. -/
theorem ell2PositiveOrthant_inter_neg_eq_zero :
    ell2PositiveOrthant I ∩ -ell2PositiveOrthant I =
      ({0} : Set (PiLp 2 fun _ : I ↦ ℝ)) := by
  -- Coordinatewise antisymmetry forces every coordinate to vanish.
  ext ξ
  constructor
  · rintro ⟨hξ, hnegξ⟩
    have hneg := (mem_ell2NegativeOrthant_iff (I := I) ξ).mp hnegξ
    have hzero : ξ = 0 := by
      ext i
      exact le_antisymm (hneg i) (hξ i)
    simpa [hzero]
  · intro hξ
    rcases hξ with rfl
    constructor
    · intro i
      simp
    · exact (mem_ell2NegativeOrthant_iff (I := I) (0 : PiLp 2 fun _ : I ↦ ℝ)).2 fun i ↦ le_rfl

/-- Helper for Example 6.7: if `I` is infinite, then the positive orthant has empty interior in
the product topology on `PiLp 2`. -/
private theorem empty_interior_positive_orthant_of_infinite [Infinite I] :
    interior (ell2PositiveOrthant I) = ∅ := by
  -- Any neighborhood controls only finitely many coordinates, so one uncontrolled coordinate can
  -- be flipped negative.
  classical
  ext x
  constructor
  · intro hx
    let e := PiLp.homeomorph (p := 2) (β := fun _ : I ↦ ℝ)
    let Sfun : Set (I → ℝ) := {f | ∀ i, 0 ≤ f i}
    have hnhds : ell2PositiveOrthant I ∈ nhds x :=
      mem_interior_iff_mem_nhds.mp hx
    have himage_mem : e '' ell2PositiveOrthant I ∈ map e (nhds x) :=
      Filter.image_mem_map hnhds
    have hSfun_nhds : Sfun ∈ nhds (e x) := by
      rw [e.map_nhds_eq x] at himage_mem
      exact Filter.mem_of_superset himage_mem (by
        intro f hf
        rcases hf with ⟨y, hy, rfl⟩
        simpa [Sfun, ell2PositiveOrthant] using hy)
    let y : I → ℝ := fun _ ↦ (-1 : ℝ)
    rcases exists_finset_piecewise_mem_of_mem_nhds hSfun_nhds y with ⟨s, hs⟩
    obtain ⟨j, hj⟩ := Infinite.exists_notMem_finset s
    have hnot : ¬ s.piecewise (e x) y ∈ Sfun := by
      intro hsfun
      have hjval := hsfun j
      norm_num [Sfun, y, hj] at hjval
    exact hnot hs
  · intro hx
    simpa using hx

/-- Helper for Example 6.7: if `I` is finite, then the all-ones vector lies in the interior of the
positive orthant. -/
private theorem strict_positive_mem_interior_positive_orthant_of_finite [Finite I] :
    let oneVec : PiLp 2 fun _ : I ↦ ℝ := WithLp.toLp 2 (fun _ : I ↦ (1 : ℝ))
    oneVec ∈ interior (ell2PositiveOrthant I) := by
  -- Pull back the open strict orthant in the function-space model through `PiLp.homeomorph`.
  classical
  let _ := Fintype.ofFinite I
  let e := PiLp.homeomorph (p := 2) (β := fun _ : I ↦ ℝ)
  let Ufun : Set (I → ℝ) := {f | ∀ i, 0 < f i}
  let oneVec : PiLp 2 fun _ : I ↦ ℝ := WithLp.toLp 2 (fun _ : I ↦ (1 : ℝ))
  have hUfun_open : IsOpen Ufun := by
    convert isOpen_iInter_of_finite (ι := I) (s := fun i ↦ {f : I → ℝ | 0 < f i})
      (fun i ↦ isOpen_lt continuous_const (continuous_apply i)) using 1
    ext f
    simp [Ufun]
  have hone_mem : e oneVec ∈ Ufun := by
    intro i
    change 0 < oneVec i
    simp [oneVec]
  have hsubset : e ⁻¹' Ufun ⊆ ell2PositiveOrthant I := by
    intro ξ hξ i
    exact (hξ i).le
  have hpre : e ⁻¹' Ufun ∈ nhds oneVec := by
    exact (hUfun_open.preimage e.continuous).mem_nhds hone_mem
  exact mem_interior_iff_mem_nhds.mpr (Filter.mem_of_superset hpre hsubset)

-- Proof sketch: for finite `I`, a small open strict orthant around the all-ones vector sits inside
-- the positive orthant. For infinite `I`, every neighborhood leaves some coordinate uncontrolled,
-- and that coordinate can be flipped negative.
/-- The positive orthant in `ℓ²(I)` is solid exactly when the index set is finite. -/
theorem ell2PositiveOrthant_solid_iff_finite :
    (interior (ell2PositiveOrthant I)).Nonempty ↔ Finite I := by
  constructor
  · intro hinterior
    by_contra hFinite
    let _ : Infinite I := not_finite_iff_infinite.mp hFinite
    have hempty : interior (ell2PositiveOrthant I) = ∅ :=
      empty_interior_positive_orthant_of_infinite (I := I)
    simpa [hempty] using hinterior
  · intro hFinite
    let _ : Finite I := hFinite
    refine ⟨WithLp.toLp 2 (fun _ : I ↦ (1 : ℝ)), ?_⟩
    simpa using strict_positive_mem_interior_positive_orthant_of_finite (I := I)

-- Proof sketch: apply `ell2PositiveOrthant_solid_iff_finite` to `I := Fin N`, which is finite.
/-- In the canonical `ℝ^N` model `PiLp 2 (fun _ : Fin N ↦ ℝ)`, the positive orthant is solid. -/
theorem fin_ell2PositiveOrthant_solid (N : ℕ) :
    (interior (ell2PositiveOrthant (Fin N))).Nonempty := by
  -- Finite-dimensional coordinate spaces fall under the finite-index case above.
  exact (ell2PositiveOrthant_solid_iff_finite (I := Fin N)).2 inferInstance

-- Proof sketch: negate the witness `0 ∈ ell2PositiveOrthant I`, using the defining relation
-- `ell2NegativeOrthant I = -ell2PositiveOrthant I`.
/-- The negative orthant in `ℓ²(I)` is nonempty. -/
theorem ell2NegativeOrthant_nonempty :
    (ell2NegativeOrthant I).Nonempty := by
  -- The zero vector belongs to both orthants.
  refine ⟨0, ?_⟩
  exact (mem_ell2NegativeOrthant_iff (I := I) (0 : PiLp 2 fun _ : I ↦ ℝ)).2 fun i ↦ le_rfl

-- Proof sketch: negation is a homeomorphism of `ℓ²(I)`, so the image of the closed positive
-- orthant under negation is closed.
/-- The negative orthant in `ℓ²(I)` is closed. -/
theorem ell2NegativeOrthant_isClosed :
    IsClosed (ell2NegativeOrthant I) := by
  -- Coordinatewise nonpositivity is an intersection of closed half-spaces.
  have hclosed : IsClosed (⋂ i : I, {ξ : PiLp 2 fun _ : I ↦ ℝ | ξ i ≤ 0}) := by
    refine isClosed_iInter fun i ↦ ?_
    exact isClosed_le
      (PiLp.continuous_apply (p := 2) (β := fun _ : I ↦ ℝ) i) continuous_const
  convert hclosed using 1
  ext ξ
  simp [mem_ell2NegativeOrthant_iff]

-- Proof sketch: coordinatewise nonpositivity is preserved under convex combinations.
/-- The negative orthant in `ℓ²(I)` is convex. -/
theorem ell2NegativeOrthant_convex :
    Convex ℝ (ell2NegativeOrthant I) := by
  -- Convex combinations preserve coordinatewise nonpositivity.
  intro x hx y hy a b ha hb hab
  rw [mem_ell2NegativeOrthant_iff] at hx hy ⊢
  intro i
  exact add_nonpos
    (mul_nonpos_of_nonneg_of_nonpos ha (hx i))
    (mul_nonpos_of_nonneg_of_nonpos hb (hy i))

-- Proof sketch: negation preserves the cone property, so the negative of the positive orthant is
-- again a cone.
/-- The negative orthant in `ℓ²(I)` is a cone. -/
theorem ell2NegativeOrthant_isCone :
    IsCone (ell2NegativeOrthant I) := by
  -- Positive scaling preserves coordinatewise nonpositivity.
  ext ξ
  constructor
  · intro hξ
    refine ⟨1, by simpa, ξ, hξ, by simp⟩
  · rintro ⟨a, ha, ξ, hξ, rfl⟩
    rw [mem_ell2NegativeOrthant_iff] at hξ ⊢
    intro i
    exact mul_nonpos_of_nonneg_of_nonpos ha.le (hξ i)

-- Proof sketch: if a vector lies in both the negative orthant and its negative, then each
-- coordinate is simultaneously nonpositive and nonnegative, so the vector must be `0`.
/-- The negative orthant in `ℓ²(I)` is pointed in the sense that its intersection with its
negative is `{0}`. -/
theorem ell2NegativeOrthant_inter_neg_eq_zero :
    ell2NegativeOrthant I ∩ -ell2NegativeOrthant I =
      ({0} : Set (PiLp 2 fun _ : I ↦ ℝ)) := by
  -- Negating twice identifies this with the positive-orthant pointedness statement.
  simpa [ell2NegativeOrthant, inter_comm, neg_neg] using
    (ell2PositiveOrthant_inter_neg_eq_zero (I := I))

end
