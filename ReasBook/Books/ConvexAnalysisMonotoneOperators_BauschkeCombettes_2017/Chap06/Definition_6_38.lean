import Mathlib
import ConvexAnalysisMonotoneOperators_BauschkeCombettes_2017.Chap03.Definition_3_49
import ConvexAnalysisMonotoneOperators_BauschkeCombettes_2017.Chap06.Definition_6_9

-- Declarations for this item will be appended below by the statement pipeline.

open scoped InnerProductSpace Pointwise

universe u

namespace Set

section

variable {E : Type u} [NormedAddCommGroup E] [NormedSpace ℝ E]

/-- Definition 6.38 (1): the tangent cone to `C` at `x` is the closure of the cone generated by
`C - x` when `x ∈ C`, and it is empty otherwise. -/
noncomputable def tangentCone (C : Set E) (x : E) : Set E :=
  {v : E | x ∈ C ∧ v ∈ closure (cone (C - ({x} : Set E)))}

scoped notation "T[" C "]" => Set.tangentCone C

-- Proof sketch: unfold `Set.tangentCone` and simplify membership in the defining conjunction using
-- the hypothesis `x ∈ C`.
/-- The tangent cone at a point of `C` is the closure of the cone generated by the translate
`C - x`. -/
theorem tangentCone_of_mem {C : Set E} {x : E} (hx : x ∈ C) :
    T[C] x = closure (cone (C - ({x} : Set E))) := by
  ext v
  -- At a point of `C`, the defining conjunction reduces to the closure membership condition.
  simp [tangentCone, hx]

-- Proof sketch: unfold `Set.tangentCone` and simplify membership in the defining conjunction using
-- the hypothesis `x ∉ C`.
/-- The tangent cone is empty away from the set. -/
theorem tangentCone_of_not_mem {C : Set E} {x : E} (hx : x ∉ C) :
    T[C] x = ∅ := by
  ext v
  -- Away from `C`, the membership condition `x ∈ C` is impossible.
  simp [tangentCone, hx]

end

section

variable {H : Type u} [NormedAddCommGroup H] [InnerProductSpace ℝ H]

/-- Definition 6.38 (2): the normal cone to `C` at `x` is the set of vectors `u` whose
inner-product supremum on `C - x` is nonpositive when `x ∈ C`, and it is empty otherwise. -/
noncomputable def normalCone (C : Set H) (x : H) : Set H :=
  {u : H | x ∈ C ∧ innerSupremumOn (C - ({x} : Set H)) u ≤ 0}

scoped notation "N[" C "]" => Set.normalCone C

-- Proof sketch: unfold `Set.normalCone` and simplify membership in the defining conjunction using
-- the hypothesis `x ∈ C`.
/-- At a point of `C`, the normal cone is the negative polar of `C - x`, expressed by the
inequality `innerSupremumOn (C - x) u ≤ 0`. -/
theorem normalCone_of_mem {C : Set H} {x : H} (hx : x ∈ C) :
    N[C] x = {u : H | innerSupremumOn (C - ({x} : Set H)) u ≤ 0} := by
  ext u
  -- At a point of `C`, the defining conjunction reduces to the inner-supremum inequality.
  simp [normalCone, hx]

-- Proof sketch: unfold `Set.normalCone` and simplify membership in the defining conjunction using
-- the hypothesis `x ∉ C`.
/-- The normal cone is empty away from the set. -/
theorem normalCone_of_not_mem {C : Set H} {x : H} (hx : x ∉ C) :
    N[C] x = ∅ := by
  ext u
  -- Away from `C`, the leading membership condition is false, so the cone is empty.
  simp [normalCone, hx]

end

end Set
