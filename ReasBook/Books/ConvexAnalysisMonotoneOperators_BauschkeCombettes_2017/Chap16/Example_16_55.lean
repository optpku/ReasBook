import Mathlib
import ConvexAnalysisMonotoneOperators_BauschkeCombettes_2017.Chap06.Definition_6_38

-- Declarations for this item will be appended below by the statement pipeline.

open Set
open scoped InnerProductSpace Pointwise

universe u v

section

variable {ι : Type v}
variable {H : Type u} [NormedAddCommGroup H] [InnerProductSpace ℝ H]

/- Source/core/bridge triage:
- `source-facing`: Example 16.55 is the normal-cone formula for a finite intersection of
  halfspaces.
- `core/canonical`: the owner objects are `Set.normalCone` and `PointedCone.hull`.
- `bridge/view`: the proof route factors the halfspace intersection through the negative orthant
  and applies the linear-pullback normal-cone computation from Corollary 16.53 together with the
  orthant normal-cone description from Example 6.42 (2).
-/

-- Proof sketch: encode the halfspace intersection as the preimage of the negative orthant under
-- the linear map `x ↦ (⟪x, u i⟫ - β i)_i`. Corollary 16.53 identifies the normal cone with the
-- adjoint image of the normal cone of that orthant, and Example 6.42(2) rewrites the latter as
-- the cone generated by the active coordinates, whose adjoint image is the cone generated by the
-- active normals `u i`.
/-- Example 16.55: if `z` belongs to the finite halfspace intersection
`{x | ∀ i : s, ⟪x, u i⟫ ≤ β i}`, then the normal cone at `z` is the pointed cone generated by
the active normals `u i` with `⟪z, u i⟫ = β i`, which is the Lean form of
`∑_{j ∈ J} ℝ₊ u_j`. -/
theorem normalCone_finiteHalfspaceIntersection_eq_pointedConeHull_activeNormals
    (s : Finset ι) (u : s → H) (β : s → ℝ) {z : H}
    (hz : ∀ i : s, ⟪z, u i⟫_ℝ ≤ β i) :
    N[({x : H | ∀ i : s, ⟪x, u i⟫_ℝ ≤ β i} : Set H)] z =
      (PointedCone.hull ℝ (u '' {i : s | ⟪z, u i⟫_ℝ = β i}) : Set H) := sorry

end
