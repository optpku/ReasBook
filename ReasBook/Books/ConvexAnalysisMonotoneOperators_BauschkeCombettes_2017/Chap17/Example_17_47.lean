universe u

section

variable {H : Type u} [NormedAddCommGroup H] [InnerProductSpace ℝ H]

-- Proof sketch: `0 ∈ core C` means the cone generated by `C - {0}` is all of `H`, hence
-- `closure (cone C) = univ` and `0 ∈ C`. Apply Example 17.38 to identify the subdifferential of
-- `ι_C` at `0` with the singleton `{0}`.
/-- Example 17.47 (1): if the origin lies in `core C`, then the
subdifferential of the indicator `ι_C` at `0` is the singleton `{0}`. -/
theorem subdifferential_setIndicator_eq_singleton_zero_at_zero_of_mem_core
    (C : Set H) (h0core : (0 : H) ∈ core C) :
    (∂ ι[C]) (0 : H) = ({0} : Set H) := by
  rcases Set.mem_core_iff.mp h0core with ⟨h0C, hcone_translate⟩
  have hsub : C - ({(0 : H)} : Set H) = C := by
    ext x
    simp
  have hclosure : closure (cone C) = (Set.univ : Set H) := by
    simpa [hsub] using congrArg closure hcone_translate
  simpa using
    subdifferential_setIndicator_eq_singleton_zero_at_zero_of_closure_cone_eq_univ C h0C hclosure

end

section

variable {H : Type u} [TopologicalSpace H] [Zero H]

-- Proof sketch: if `0 ∈ C`, then `ι_C 0 = 0`. Since `ι_C` only takes the values `0` and `⊤`,
-- every strict lower bound of `ι_C 0` is automatically a strict lower bound of `ι_C x` for every
-- `x`, so lower semicontinuity at `0` is immediate.
/-- Example 17.47 (3), in the sharper canonical form: if `0 ∈ C`, then the indicator `ι_C` is
lower semicontinuous at `0`. -/
theorem lowerSemicontinuousAt_setIndicator_zero_of_mem
    (C : Set H) (h0C : (0 : H) ∈ C) :
    LowerSemicontinuousAt (ι[C]).asEReal (0 : H) := by
  rw [lowerSemicontinuousAt_iff]
  intro y hy
  have hy0 : y < (0 : EReal) := by
    simpa [ERealFunction.indicator, h0C] using hy
  exact Filter.Eventually.of_forall fun x ↦ by
    by_cases hx : x ∈ C
    · simpa [ERealFunction.indicator, hx] using hy0
    · have hy_top : y < (⊤ : EReal) := hy0.trans_le le_top
      simpa [ERealFunction.indicator, hx] using hy_top

end

section

variable {H : Type u} [NormedAddCommGroup H] [NormedSpace ℝ H]

-- Proof sketch: Example 8.42 already provides the two source-facing set facts for the halfspace
-- `C = {x | f x ≤ 1}`. Combine them into the textbook membership statement
-- `0 ∈ core C \ interior C`.
/-- Example 17.47 (2): if `f` is discontinuous at every point and
`C = {x | f x ≤ 1}`, then `0 ∈ core C \ interior C`. -/
theorem zero_mem_core_sdiff_interior_oneSublevelSet_linearFunctional_of_everywhereDiscontinuous
    (f : H →ₗ[ℝ] ℝ) (hdisc : ∀ x : H, ¬ ContinuousAt f x) :
    (0 : H) ∈ core {y : H | f y ≤ 1} \ interior {y : H | f y ≤ 1} := by
  refine ⟨zero_mem_core_oneSublevelSet_linearFunctional f, ?_⟩
  rw [interior_oneSublevelSet_linearFunctional_eq_empty_of_everywhereDiscontinuous f hdisc]
  simp

end

section

variable {H : Type u} [NormedAddCommGroup H] [NormedSpace ℝ H]

-- Proof sketch: for the halfspace `C = {z | f z ≤ 1}`, every direction `y` admits a short
-- positive ray `t • y` staying inside `C`; along that ray the indicator quotient is identically
-- `0`, so the source Chapter 17 directional derivative at the origin is `0`.
/-- Example 17.47, differentiability clause in the source Chapter 17 form: for the Example 8.42
halfspace `C = {y : H | f y ≤ 1}`, every directional derivative of `ι_C` at `0` exists and equals
`0`; equivalently, `ι_C` is Gâteaux differentiable at `0` with gradient `0`. -/
theorem hasDirectionalDerivativeAt_setIndicator_oneSublevelSet_linearFunctional_zero
    (f : H →ₗ[ℝ] ℝ) (y : H) :
    HasDirectionalDerivativeAt (ι[{z : H | f z ≤ 1}]) (0 : H) y (0 : EReal) := by
  let C : Set H := {z : H | f z ≤ 1}
  change HasDirectionalDerivativeAt (ι[C]) (0 : H) y (0 : EReal)
  refine ⟨by simp [C], ?_⟩
  by_cases hy : f y ≤ 0
  · have hEq :
        (fun t : ℝ ↦
          (((ι[C] ((0 : H) + t • y) : EReal) - (ι[C] (0 : H) : EReal)) / (t : EReal))) =ᶠ[
            nhdsWithin (0 : ℝ) (Set.Ioi 0)] fun _ : ℝ ↦ (0 : EReal) := by
      filter_upwards [self_mem_nhdsWithin] with t ht
      have htpos : 0 < t := ht
      have hty : f (t • y) ≤ 1 := by
        calc
          f (t • y) = t * f y := by simp
          _ ≤ 0 := mul_nonpos_of_nonneg_of_nonpos (le_of_lt htpos) hy
          _ ≤ 1 := by norm_num
      have hty' : t * f y ≤ 1 := by
        simpa using hty
      calc
        (((ι[C] ((0 : H) + t • y) : EReal) - (ι[C] (0 : H) : EReal)) / (t : EReal)) =
            (((0 : EReal) - 0) / (t : EReal)) := by
              simp [C, ERealFunction.indicator, hty']
        _ = 0 := by simp
    exact Filter.Tendsto.congr' hEq.symm tendsto_const_nhds
  · have hy' : 0 < f y := by
      linarith
    let ε : ℝ := (f y)⁻¹
    have hε : 0 < ε := by
      dsimp [ε]
      exact inv_pos.mpr hy'
    have hlt : {t : ℝ | t < ε} ∈ nhdsWithin (0 : ℝ) (Set.Ioi 0) := by
      refine mem_nhdsWithin_iff_exists_mem_nhds_inter.mpr ?_
      refine ⟨{t : ℝ | t < ε}, isOpen_Iio.mem_nhds hε, ?_⟩
      intro t ht
      exact ht.1
    have hEq :
        (fun t : ℝ ↦
          (((ι[C] ((0 : H) + t • y) : EReal) - (ι[C] (0 : H) : EReal)) / (t : EReal))) =ᶠ[
            nhdsWithin (0 : ℝ) (Set.Ioi 0)] fun _ : ℝ ↦ (0 : EReal) := by
      filter_upwards [self_mem_nhdsWithin, hlt] with t htpos htlt
      have hty : f (t • y) ≤ 1 := by
        have hlt_one : f (t • y) < 1 := by
          calc
            f (t • y) = t * f y := by simp
            _ < ε * f y := by gcongr
            _ = 1 := by
              dsimp [ε]
              field_simp [hy'.ne']
        exact le_of_lt hlt_one
      have hty' : t * f y ≤ 1 := by
        simpa using hty
      calc
        (((ι[C] ((0 : H) + t • y) : EReal) - (ι[C] (0 : H) : EReal)) / (t : EReal)) =
            (((0 : EReal) - 0) / (t : EReal)) := by
              simp [C, ERealFunction.indicator, hty']
        _ = 0 := by simp
    exact Filter.Tendsto.congr' hEq.symm tendsto_const_nhds

end

section

variable {H : Type u} [NormedAddCommGroup H] [NormedSpace ℝ H]

-- Proof sketch: package the pointwise directional-derivative statement with the canonical zero
-- continuous linear map; this is the source Chapter 17 existential linear-map form.
/-- Example 17.47, differentiability clause in the source Chapter 17 existential form: for the
halfspace `C = {y : H | f y ≤ 1}`, the indicator `ι_C` is Gâteaux differentiable at `0` with
derivative `0`. -/
theorem exists_sourceGateauxDerivativeAt_setIndicator_oneSublevelSet_linearFunctional_zero
    (f : H →ₗ[ℝ] ℝ) :
    ∃ A : H →L[ℝ] ℝ,
      ∀ y : H,
        HasDirectionalDerivativeAt (ι[{z : H | f z ≤ 1}]) (0 : H) y (A y : EReal) := by
  refine ⟨0, ?_⟩
  intro y
  simpa using hasDirectionalDerivativeAt_setIndicator_oneSublevelSet_linearFunctional_zero f y

end

section

variable {H : Type u} [TopologicalSpace H] [Zero H]

-- Proof sketch: continuity of the indicator at a point of `C` would force some neighborhood of
-- that point to remain inside `C`, which is exactly interior membership.
/-- Example 17.47 (4): if `0 ∈ C` but `0 ∉ interior C`, then the indicator `ι_C` is not
continuous at `0`. -/
theorem not_continuousAt_setIndicator_zero_of_mem_of_not_mem_interior
    (C : Set H) (h0C : (0 : H) ∈ C) (h0notint : (0 : H) ∉ interior C) :
    ¬ ContinuousAt (ι[C]).asEReal (0 : H) := by
  intro hcont
  have hC_nhds : C ∈ 𝓝 (0 : H) := by
    have hpre : (ι[C]).asEReal ⁻¹' Set.Iio (1 : EReal) ∈ 𝓝 (0 : H) := by
      refine hcont.preimage_mem_nhds ?_
      simpa [ERealFunction.indicator, h0C] using
        (isOpen_Iio.mem_nhds (show (0 : EReal) < 1 by norm_num))
    have hpreimage :
        (ι[C]).asEReal ⁻¹' Set.Iio (1 : EReal) = C := by
      ext x
      by_cases hx : x ∈ C <;> simp [ERealFunction.indicator, hx]
    rw [hpreimage] at hpre
    exact hpre
  exact h0notint <| mem_interior_iff_mem_nhds.mpr hC_nhds

end
