section

variable {H : Type u} [NormedAddCommGroup H] [InnerProductSpace ℝ H]

-- Proof sketch: rewrite `N[C] 0` as the polar cone of `C - {0} = C`. If `u ∈ N[C] 0`, then the
-- halfspace `{x | ⟪x, u⟫ ≤ 0}` contains `C`, hence also `cone C` by convex-cone hull minimality
-- and `closure (cone C)` by closedness. Since `closure (cone C) = univ`, it contains `u`, so
-- `⟪u, u⟫ ≤ 0`; positive-definiteness forces `u = 0`.
/-- If the closed cone generated by `C` is the whole space, then the normal cone of `C` at `0` is
trivial. -/
theorem normalCone_eq_singleton_zero_at_zero_of_closure_cone_eq_univ
    (C : Set H) (h0C : (0 : H) ∈ C)
    (hclosure_cone : closure (cone C) = (Set.univ : Set H)) :
    N[C] (0 : H) = ({0} : Set H) := by
  ext u
  constructor
  · intro hu
    rw [Set.normalCone_eq_polarCone_translate_of_mem h0C,
      Set.mem_polarCone_iff_forall_inner_nonpos] at hu
    have huC : ∀ x ∈ C, ⟪x, u⟫_ℝ ≤ 0 := by
      simpa using hu
    let K : ConvexCone ℝ H := {
      carrier := {x : H | ⟪x, u⟫_ℝ ≤ 0}
      smul_mem' := by
        intro a ha x hx
        simpa [real_inner_smul_left] using mul_nonpos_of_nonneg_of_nonpos ha.le hx
      add_mem' := by
        intro x hx y hy
        simpa [inner_add_left] using add_nonpos hx hy
    }
    have hK : C ⊆ K := huC
    have hcone : cone C ⊆ {x : H | ⟪x, u⟫_ℝ ≤ 0} := by
      simpa [Set.cone, K] using
        (ConvexCone.hull_min hK : (ConvexCone.hull ℝ C : Set H) ⊆ K)
    have hclosure : closure (cone C) ⊆ {x : H | ⟪x, u⟫_ℝ ≤ 0} := by
      refine closure_minimal hcone ?_
      simpa using isClosed_le (continuous_id.inner continuous_const) continuous_const
    have huu : ⟪u, u⟫_ℝ ≤ 0 := by
      have hu_mem : u ∈ closure (cone C) := by simp [hclosure_cone]
      exact hclosure hu_mem
    have hu_zero : u = 0 := by
      have hnonneg : 0 ≤ ⟪u, u⟫_ℝ := by
        exact real_inner_self_nonneg
      exact inner_self_eq_zero.mp (le_antisymm huu hnonneg)
    simp [hu_zero]
  · rintro rfl
    rw [Set.normalCone_eq_polarCone_translate_of_mem h0C,
      Set.mem_polarCone_iff_forall_inner_nonpos]
    intro x hx
    simp

-- Proof sketch: at the origin, unfold the subdifferential of `ι_C`; since `0 ∈ C`, the defining
-- inequality reduces to the normal-cone inequality. Then apply the previous normal-cone theorem.
/-- Example 17.38: if `0 ∈ C` and the closed cone generated by `C` is the whole ambient real inner
product space, then the indicator `ι_C` has subdifferential `{0}` at `0`, hence a unique
subgradient there. -/
theorem subdifferential_setIndicator_eq_singleton_zero_at_zero_of_closure_cone_eq_univ
    (C : Set H) (h0C : (0 : H) ∈ C)
    (hclosure_cone : closure (cone C) = (Set.univ : Set H)) :
    (∂ ι[C]) (0 : H) = ({0} : Set H) := by
  have hsubd : ∂ ι[C] = N[C] :=
    subdifferential_setIndicator_eq_normalCone C ⟨0, h0C⟩
  calc
    (∂ ι[C]) (0 : H) = N[C] (0 : H) := by
      simpa using congrFun hsubd (0 : H)
    _ = ({0} : Set H) :=
      normalCone_eq_singleton_zero_at_zero_of_closure_cone_eq_univ C h0C hclosure_cone

end

section

variable {H : Type u} [NormedAddCommGroup H] [NormedSpace ℝ H]

-- Proof sketch: if a continuous linear map realizes all directional derivatives of `ι_C` at `0`,
-- then every direction `y` admits some `α > 0` with `α • y ∈ C`, because the indicator's
-- difference quotient must eventually stay finite. That yields `0 ∈ C` and `cone C = univ`,
-- which is exactly `0 ∈ core C` in the ambient project API used earlier in the file.
/-- A source-facing Gâteaux derivative of the indicator `ι_C` at the origin forces `0` to lie in
the core of `C`. -/
theorem zero_mem_core_of_sourceGateauxDifferentiableAt_setIndicator_zero
    (C : Set H)
    (hA : ∃ A : H →L[ℝ] ℝ,
      ∀ y : H, ERealFunction.HasDirectionalDerivativeAt (ι[C]) (0 : H) y (A y : EReal)) :
    (0 : H) ∈ core C := by
  rcases hA with ⟨A, hA⟩
  have h0C : (0 : H) ∈ C := by
    simpa using (hA 0).1
  rw [Set.mem_core_iff]
  refine ⟨h0C, ?_⟩
  have hsub_zero : C - ({(0 : H)} : Set H) = C := by
    ext y
    simp
  rw [hsub_zero]
  ext y
  constructor
  · intro hy
    simp
  · intro hy
    have hfinite :
        {α : ℝ |
            (((ι[C] ((0 : H) + α • y) : EReal) - (ι[C] (0 : H) : EReal)) / α) < ⊤} ∈
          nhdsWithin (0 : ℝ) (Set.Ioi 0) := by
      exact (hA y).2 (isOpen_Iio.mem_nhds (by simp))
    obtain ⟨δ, hδ, hδsub⟩ := Metric.mem_nhdsWithin_iff.mp hfinite
    let α : ℝ := δ / 2
    have hα : 0 < α := by
      dsimp [α]
      positivity
    have hα_mem : α ∈ Metric.ball (0 : ℝ) δ ∩ Set.Ioi 0 := by
      refine ⟨?_, hα⟩
      rw [Metric.mem_ball, Real.dist_eq]
      have : δ / 2 < δ := by linarith
      simpa [α, abs_of_nonneg (by linarith : 0 ≤ δ / 2)] using this
    have hα_finite :
        (((ι[C] ((0 : H) + α • y) : EReal) - (ι[C] (0 : H) : EReal)) / α) < ⊤ :=
      hδsub hα_mem
    have hαyC : α • y ∈ C := by
      by_contra hαyC
      have hαy_top : (ι[C] ((0 : H) + α • y) : EReal) = ⊤ := by
        simp [ERealFunction.indicator, hαyC]
      have hzero_val : (ι[C] (0 : H) : EReal) = 0 := by
        simp [ERealFunction.indicator, h0C]
      have hquot_top :
          (((ι[C] ((0 : H) + α • y) : EReal) - (ι[C] (0 : H) : EReal)) / α) = ⊤ := by
        rw [hαy_top, hzero_val, EReal.top_sub (by simp),
          EReal.top_div_of_pos_ne_top (by exact_mod_cast hα) (EReal.coe_ne_top α)]
      have : ¬ ((((ι[C] ((0 : H) + α • y) : EReal) - (ι[C] (0 : H) : EReal)) / α) < ⊤) := by
        rw [hquot_top]
        simp
      exact this hα_finite
    change y ∈ (ConvexCone.hull ℝ C : Set H)
    have hαy_cone : α • y ∈ (ConvexCone.hull ℝ C : Set H) := by
      simpa [Set.cone_def] using (ConvexCone.subset_hull hαyC)
    have hy_cone : α⁻¹ • (α • y) ∈ (ConvexCone.hull ℝ C : Set H) :=
      (ConvexCone.hull ℝ C).smul_mem (by positivity) hαy_cone
    simpa [smul_smul, inv_mul_cancel₀ hα.ne', one_smul] using hy_cone

-- Proof sketch: contrapose the previous source-facing core-membership theorem.
/-- If the origin is not in the core of `C`, then the indicator `ι_C` is not Gâteaux
differentiable at `0` in the source Chapter 17 sense. -/
theorem not_sourceGateauxDifferentiableAt_setIndicator_zero_of_not_mem_core
    (C : Set H) (h0core : (0 : H) ∉ core C) :
    ¬ ∃ A : H →L[ℝ] ℝ,
      ∀ y : H, ERealFunction.HasDirectionalDerivativeAt (ι[C]) (0 : H) y (A y : EReal) := by
  intro hA
  exact h0core (zero_mem_core_of_sourceGateauxDifferentiableAt_setIndicator_zero C hA)

end

section

variable {H : Type u} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]

private lemma interior_nonempty_of_zero_mem_core_of_isClosed_of_convex
    {C : Set H} (hC_closed : IsClosed C) (hC_convex : Convex ℝ C) (h0core : (0 : H) ∈ core C) :
    (interior C).Nonempty := by
  rcases Set.mem_core_iff.mp h0core with ⟨h0C, hcone_translate⟩
  have hsub : C - ({(0 : H)} : Set H) = C := by
    ext x
    simp
  have hcone : cone C = (Set.univ : Set H) := by
    simpa [hsub] using hcone_translate
  have hUnion : (⋃ n : ℕ, ((((n + 1 : ℕ) : ℝ)) • C)) = (Set.univ : Set H) := by
    ext y
    constructor
    · intro _
      simp
    · intro _
      have hy_cone : y ∈ cone C := by simp [hcone]
      rcases (mem_cone_iff_exists_pos_smul_mem hC_convex).1 hy_cone with ⟨a, ha, ha_mem⟩
      rcases ha_mem with ⟨z, hz, rfl⟩
      obtain ⟨n, hn⟩ : ∃ n : ℕ, a ≤ n := exists_nat_ge a
      refine Set.mem_iUnion.mpr ⟨n, ?_⟩
      refine ⟨(a / (((n + 1 : ℕ) : ℝ))) • z, ?_, ?_⟩
      · have hfrac : a / (((n + 1 : ℕ) : ℝ)) ∈ Set.Icc (0 : ℝ) 1 := by
          constructor
          · exact div_nonneg ha.le (by positivity)
          · have hle : a ≤ (((n + 1 : ℕ) : ℝ)) := by
              exact le_trans hn (by exact_mod_cast Nat.le_succ n)
            exact div_le_one_of_le₀ hle (by positivity)
        exact hC_convex.smul_mem_of_zero_mem h0C hz hfrac
      · simp only
        rw [smul_smul]
        field_simp
  have hclosed_scaled : ∀ n : ℕ, IsClosed ((((n + 1 : ℕ) : ℝ) • C)) := fun n ↦
    hC_closed.smul₀ (((n + 1 : ℕ) : ℝ))
  rcases nonempty_interior_of_iUnion_of_closed hclosed_scaled hUnion with ⟨n, hscaled_int⟩
  rcases hscaled_int with ⟨x, hx⟩
  have hn_ne : (((n + 1 : ℕ) : ℝ)) ≠ 0 := by positivity
  have hx' : x ∈ (((n + 1 : ℕ) : ℝ) • interior C) := by
    rwa [interior_smul₀ hn_ne] at hx
  rcases hx' with ⟨y, hy, rfl⟩
  exact ⟨y, hy⟩

-- Proof sketch: Example 6.18 supplies the concrete Chapter 6 owner `Set.dyadicSignedCylinder e`,
-- which is closed, convex, has empty interior, and whose closed conic hull is all of `H`.
-- The subdifferential formula follows from the abstract first half of Example 17.38, while the
-- source-facing non-differentiability follows because closed convex sets have `interior = core`.
/-- Example 17.38, concrete Chapter 6 counterexample: for the dyadic signed cylinder
`C = Set.dyadicSignedCylinder e`, the indicator `ι_C` has subdifferential `{0}` at `0`, but `ι_C`
is not Gâteaux differentiable there in the source Chapter 17 directional-derivative sense. -/
theorem subdifferential_eq_singleton_zero_and_not_sourceGateauxDifferentiableAt_zero_setIndicator_dyadicSignedCylinder
    (e : ℕ → H) (he : Orthonormal ℝ e) :
    let C := Set.dyadicSignedCylinder e
    (∂ ι[C]) (0 : H) = ({0} : Set H) ∧
      ¬ ∃ A : H →L[ℝ] ℝ,
        ∀ y : H, ERealFunction.HasDirectionalDerivativeAt (ι[C]) (0 : H) y (A y : EReal) := by
  dsimp
  constructor
  · exact
      subdifferential_setIndicator_eq_singleton_zero_at_zero_of_closure_cone_eq_univ
        (Set.dyadicSignedCylinder e)
        (Set.zero_mem_dyadicSignedCylinder e)
        (Set.closure_cone_dyadicSignedCylinder_eq_univ e he)
  · have hconv : Convex ℝ (Set.dyadicSignedCylinder e) :=
      Set.dyadicSignedCylinder_convex e
    have h0notcore : (0 : H) ∉ core (Set.dyadicSignedCylinder e) := by
      intro h0core
      have hInt_nonempty :
          (interior (Set.dyadicSignedCylinder e)).Nonempty :=
        interior_nonempty_of_zero_mem_core_of_isClosed_of_convex
          (Set.dyadicSignedCylinder_isClosed e) hconv h0core
      rw [Set.interior_dyadicSignedCylinder_eq_empty e he] at hInt_nonempty
      simp at hInt_nonempty
    exact
      not_sourceGateauxDifferentiableAt_setIndicator_zero_of_not_mem_core
        (Set.dyadicSignedCylinder e) h0notcore

end
