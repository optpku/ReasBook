import IntroductoryLecturesOnConvexOptimization_Nesterov_2004.Chap01.Definition_1_6_3

-- Declarations for this item will be appended below by the statement pipeline.

universe u

open scoped Gradient

noncomputable section

variable {E : Type u} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]

/-
Layer targeted by this refinement:
* source-facing recursive iterate and search-direction sequences for Algorithm 1.9.9;
* bridge/view method structure adding differentiability and exact-line-search hypotheses.

Primary domain:
* nonlinear conjugate-gradient recursion on a real inner product space.

Sampled owner-style declarations:
* `SatisfiesExactLineSearchAlong`,
* `gradientMethod`,
* `VariableMetricMethod`,
* the iterate-family owner style later used by `SatisfiesSpanCondition` in `Chap02/Definition_2_9`.

Owner abstraction:
* the recursive state generating the pair `(xₖ, pₖ)`.

Primitive data:
* the objective `f`, initial point `x₀`, step sizes `hₖ`, and coefficients `βₖ`.

Derived API:
* the iterate sequence `xₖ`,
* the search-direction sequence `pₖ`,
* the exact line-search property along `pₖ`.
-/

/-- The recursive state `(xₖ, pₖ)` generated by Algorithm 1.9.9 from the initial point `x₀`, the
step-size sequence `hₖ`, and the coefficient sequence `βₖ`. -/
def nonlinearConjugateGradientState
    (f : E → ℝ) (x0 : E) (stepSize beta : ℕ → ℝ) : ℕ → E × E
  | 0 => (x0, ∇ f x0)
  | k + 1 =>
      let state := nonlinearConjugateGradientState f x0 stepSize beta k
      let xk := state.1
      let pk := state.2
      let xNext := xk - stepSize k • pk
      (xNext, ∇ f xNext - beta k • pk)

/-- The iterate sequence `xₖ` generated by Algorithm 1.9.9 from `x₀`, `hₖ`, and `βₖ`. -/
abbrev nonlinearConjugateGradientIterates
    (f : E → ℝ) (x0 : E) (stepSize beta : ℕ → ℝ) : ℕ → E :=
  fun k ↦ (nonlinearConjugateGradientState f x0 stepSize beta k).1

/-- The search-direction sequence `pₖ` generated by Algorithm 1.9.9 from `x₀`, `hₖ`, and `βₖ`. -/
abbrev nonlinearConjugateGradientDirections
    (f : E → ℝ) (x0 : E) (stepSize beta : ℕ → ℝ) : ℕ → E :=
  fun k ↦ (nonlinearConjugateGradientState f x0 stepSize beta k).2

@[simp] theorem nonlinearConjugateGradientIterates_zero
    (f : E → ℝ) (x0 : E) (stepSize beta : ℕ → ℝ) :
    nonlinearConjugateGradientIterates f x0 stepSize beta 0 = x0 :=
  rfl

@[simp] theorem nonlinearConjugateGradientDirections_zero
    (f : E → ℝ) (x0 : E) (stepSize beta : ℕ → ℝ) :
    nonlinearConjugateGradientDirections f x0 stepSize beta 0 = ∇ f x0 :=
  rfl

theorem nonlinearConjugateGradientIterates_succ
    (f : E → ℝ) (x0 : E) (stepSize beta : ℕ → ℝ) (k : ℕ) :
    nonlinearConjugateGradientIterates f x0 stepSize beta (k + 1) =
      nonlinearConjugateGradientIterates f x0 stepSize beta k -
        stepSize k • nonlinearConjugateGradientDirections f x0 stepSize beta k := by
  simp [nonlinearConjugateGradientIterates, nonlinearConjugateGradientDirections,
    nonlinearConjugateGradientState]

theorem nonlinearConjugateGradientDirections_succ
    (f : E → ℝ) (x0 : E) (stepSize beta : ℕ → ℝ) (k : ℕ) :
    nonlinearConjugateGradientDirections f x0 stepSize beta (k + 1) =
      ∇ f (nonlinearConjugateGradientIterates f x0 stepSize beta (k + 1)) -
        beta k • nonlinearConjugateGradientDirections f x0 stepSize beta k := by
  simp [nonlinearConjugateGradientIterates, nonlinearConjugateGradientDirections,
    nonlinearConjugateGradientState]

/-- Algorithm 1.9.9: a nonlinear conjugate-gradient method for minimizing `f` is determined by an
initial point `x₀`, step sizes `hₖ`, and coefficients `βₖ` such that `f` is differentiable at
every derived iterate, each `hₖ` minimizes the line-search objective over all `h ≥ 0`, and the
iterate and search-direction sequences are the canonical recursive ones generated from `x₀`, `hₖ`,
and `βₖ`. -/
structure NonlinearConjugateGradientMethod (f : E → ℝ) (x0 : E) where
  stepSize : ℕ → ℝ
  beta : ℕ → ℝ
  differentiableAt : ∀ k : ℕ,
    DifferentiableAt ℝ f (nonlinearConjugateGradientIterates f x0 stepSize beta k)
  lineSearch :
    SatisfiesExactLineSearchAlong
      f
      (nonlinearConjugateGradientIterates f x0 stepSize beta)
      (nonlinearConjugateGradientDirections f x0 stepSize beta)
      stepSize

namespace NonlinearConjugateGradientMethod

variable {f : E → ℝ} {x0 : E}

/-- The search-direction sequence generated by the recursive nonlinear conjugate-gradient state. -/
abbrev p (method : NonlinearConjugateGradientMethod f x0) : ℕ → E :=
  nonlinearConjugateGradientDirections f x0 method.stepSize method.beta

/-- A nonlinear conjugate-gradient method can be used as its underlying trajectory of iterates. -/
instance : CoeFun (NonlinearConjugateGradientMethod f x0) (fun _ ↦ ℕ → E) where
  coe method := nonlinearConjugateGradientIterates f x0 method.stepSize method.beta

/-- The zeroth iterate of a nonlinear conjugate-gradient method is the prescribed initial point
`x₀`. -/
@[simp] theorem x_zero (method : NonlinearConjugateGradientMethod f x0) :
    method 0 = x0 :=
  rfl

/-- The initial search direction is the gradient at the initial point. -/
@[simp] theorem p_zero (method : NonlinearConjugateGradientMethod f x0) :
    method.p 0 = ∇ f (method 0) := by
  simp [p]

/-- The objective is differentiable at every iterate of the method. -/
theorem differentiableAt_iterate
    (method : NonlinearConjugateGradientMethod f x0) (k : ℕ) :
    DifferentiableAt ℝ f (method k) :=
  method.differentiableAt k

/-- The iterate sequence satisfies the nonlinear conjugate-gradient update recursion. -/
theorem x_succ (method : NonlinearConjugateGradientMethod f x0) (k : ℕ) :
    method (k + 1) = method k - method.stepSize k • method.p k := by
  simpa [p] using
    nonlinearConjugateGradientIterates_succ f x0 method.stepSize method.beta k

/-- The search directions satisfy the nonlinear conjugate-gradient recursion. -/
theorem p_succ (method : NonlinearConjugateGradientMethod f x0) (k : ℕ) :
    method.p (k + 1) = ∇ f (method (k + 1)) - method.beta k • method.p k := by
  simpa [p] using
    nonlinearConjugateGradientDirections_succ f x0 method.stepSize method.beta k

/-- Each step size is nonnegative because it belongs to the exact line-search feasible set
`[0, ∞)`. -/
theorem lineSearch_nonneg
    (method : NonlinearConjugateGradientMethod f x0) (k : ℕ) :
    method.stepSize k ∈ Set.Ici (0 : ℝ) :=
  method.lineSearch.nonneg k

/-- Each step size minimizes the line-search objective along the current search direction over
`h ≥ 0`. -/
theorem lineSearch_isMinOn
    (method : NonlinearConjugateGradientMethod f x0) (k : ℕ) :
    IsMinOn
      (fun h : ℝ ↦ f (method k - h • method.p k))
      (Set.Ici (0 : ℝ))
      (method.stepSize k) :=
  method.lineSearch.isMinOn k

end NonlinearConjugateGradientMethod

end
