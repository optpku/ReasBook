import Mathlib.Analysis.Calculus.Gradient.Basic
import IntroductoryLecturesOnConvexOptimization_Nesterov_2004.Chap01.Definition_1_8_11
import ConvexAnalysisMonotoneOperators_BauschkeCombettes_2017.Chap02.Example_2_57

-- Declarations for this item will be appended below by the statement pipeline.

open Matrix
open scoped Gradient

noncomputable section

variable {n : ℕ}

local notation "E" => EuclideanSpace ℝ (Fin n)
local notation "Mat" => Matrix (Fin n) (Fin n) ℝ
local notation "Update" => ℕ → E → E → E → E → Mat → Mat

/-
Algorithm 1.8.10 lies in the variable-metric / quasi-Newton recursion domain on Euclidean space.

Primary domain:
* variable-metric first-order optimization methods on `ℝⁿ`

Sampled owner-style declarations:
* `gradientMethod` in `Algorithm_1_6_1.lean`, the chapter owner of the basic gradient trajectory
* `DampedNewton.orbitPoint` and `DampedNewton.Method` in `Algorithm_1_7_2.lean`, where the
  canonical recursive orbit is public and the method structure is a hypothesis-bearing bridge
* `nonlinearConjugateGradientState` in `Algorithm_1_9_9.lean`, whose public recursive state owns
  the iterate/search-direction family and whose method structure is derived from it
* `Matrix.toEuclideanLin` in `Definition_1_8_11.lean`, the canonical matrix action used by the
  variable-metric update

Best owner abstraction:
* the recursive state `variableMetricState`

Primitive data:
* the step-size schedule `hₖ`
* the objective `f`
* the initial point `x₀`
* the quasi-Newton update rule generating `Hₖ₊₁` from `k`, `xₖ`, `xₖ₊₁`, `∇ f(xₖ)`,
  `∇ f(xₖ₊₁)`, and `Hₖ`

Derived API:
* the iterate sequence `xₖ = variableMetricIterates ...`
* the inverse-metric sequence `Hₖ = variableMetricInverseMetrics ...`
* `VariableMetricMethod`, which adds genuine-gradient, step-size-positivity, and positive-
  definiteness hypotheses to the public recursion
* the derived metric sequence `Gₖ = Hₖ⁻¹`, the search direction, and the unit-step quasi-Newton
  specialization

Source/core/bridge triage:
* source-facing: `variableMetricState`, `variableMetricIterates`, and
  `variableMetricInverseMetrics`
* core/canonical: the matrix action `Matrix.toEuclideanLin`
* bridge/view: `VariableMetricMethod`

Because mathlib's `∇ f` is totalized, the source-facing textbook method should still record
genuine gradient data along the method trajectory. The public recursive owner therefore stays
separate from the bridge structure `VariableMetricMethod`, which records iterate-wise
`HasGradientAt f (∇ f (xₖ)) xₖ`, positive step sizes, and positive-definite inverse metrics for
the canonical update-generated sequences.
-/

/-- The recursive state `(xₖ, Hₖ)` generated by Algorithm 1.8.10 from the initial point `x₀`,
the step-size sequence `hₖ`, and a quasi-Newton update rule for `Hₖ₊₁`. -/
def variableMetricState
    (stepSize : ℕ → ℝ) (f : E → ℝ) (x0 : E) (update : Update) :
    ℕ → E × Mat
  | 0 => (x0, 1)
  | k + 1 =>
      let state := variableMetricState stepSize f x0 update k
      let xk := state.1
      let Hk := state.2
      let xNext := xk - stepSize k • Hk.toEuclideanLin (∇ f xk)
      (xNext, update k xk xNext (∇ f xk) (∇ f xNext) Hk)

/-- The iterate sequence `xₖ` generated by Algorithm 1.8.10 from `x₀`, `hₖ`, and the chosen
quasi-Newton update rule. -/
abbrev variableMetricIterates
    (stepSize : ℕ → ℝ) (f : E → ℝ) (x0 : E) (update : Update) : ℕ → E :=
  fun k ↦ (variableMetricState stepSize f x0 update k).1

/-- The inverse-metric sequence `Hₖ` generated by Algorithm 1.8.10 from `x₀`, `hₖ`, and the
chosen quasi-Newton update rule. -/
abbrev variableMetricInverseMetrics
    (stepSize : ℕ → ℝ) (f : E → ℝ) (x0 : E) (update : Update) : ℕ → Mat :=
  fun k ↦ (variableMetricState stepSize f x0 update k).2

section

variable (stepSize : ℕ → ℝ) (f : E → ℝ) (x0 : E) (update : Update)

/-- The variable-metric iterate sequence starts at the prescribed initial point `x₀`. -/
@[simp] theorem variableMetricIterates_zero :
    variableMetricIterates stepSize f x0 update 0 = x0 :=
  rfl

/-- The variable-metric inverse-metric sequence starts from the identity matrix `H₀ = Iₙ`. -/
@[simp] theorem variableMetricInverseMetrics_zero :
    variableMetricInverseMetrics stepSize f x0 update 0 = 1 :=
  rfl

/-- The canonical variable-metric iterates satisfy the textbook recursion
`xₖ₊₁ = xₖ - hₖ Hₖ ∇ f(xₖ)`. -/
theorem variableMetricIterates_succ (k : ℕ) :
    variableMetricIterates stepSize f x0 update (k + 1) =
      variableMetricIterates stepSize f x0 update k -
        stepSize k •
          (variableMetricInverseMetrics stepSize f x0 update k).toEuclideanLin
            (∇ f (variableMetricIterates stepSize f x0 update k)) := by
  simp [variableMetricIterates, variableMetricInverseMetrics, variableMetricState]

/-- The inverse-metric update uses only the previous metric, the current/successor iterates, and
their gradients. -/
theorem variableMetricInverseMetrics_succ (k : ℕ) :
    variableMetricInverseMetrics stepSize f x0 update (k + 1) =
      update k
        (variableMetricIterates stepSize f x0 update k)
        (variableMetricIterates stepSize f x0 update (k + 1))
        (∇ f (variableMetricIterates stepSize f x0 update k))
        (∇ f (variableMetricIterates stepSize f x0 update (k + 1)))
        (variableMetricInverseMetrics stepSize f x0 update k) := by
  simp [variableMetricIterates, variableMetricInverseMetrics, variableMetricState]

end

/-- Algorithm 1.8.10 together with regularity hypotheses: a variable metric method is determined
by a step-size schedule `hₖ` and a quasi-Newton update rule for `Hₖ₊₁`, while the iterate and
inverse-metric sequences are the canonical recursive ones generated from that data. The structure
records that `f` has the displayed gradients along those iterates, every step size is positive,
and every generated inverse metric is positive definite. -/
structure VariableMetricMethod
    (f : E → ℝ)
    (x0 : E) where
  stepSize : ℕ → ℝ
  update : Update
  hasGradientAt (k : ℕ) :
    HasGradientAt
      f
      (∇ f (variableMetricIterates stepSize f x0 update k))
      (variableMetricIterates stepSize f x0 update k)
  stepSize_pos (k : ℕ) : 0 < stepSize k
  inverseMetric_posDef (k : ℕ) :
    (variableMetricInverseMetrics stepSize f x0 update k).PosDef

namespace VariableMetricMethod

/-- The iterate sequence generated by the canonical variable-metric recursion. -/
def x {f : E → ℝ} {x0 : E} (method : VariableMetricMethod f x0) : ℕ → E :=
  variableMetricIterates method.stepSize f x0 method.update

/-- The inverse-metric sequence generated by the canonical variable-metric recursion. -/
def inverseMetric
    {f : E → ℝ} {x0 : E}
    (method : VariableMetricMethod f x0) : ℕ → Mat :=
  variableMetricInverseMetrics method.stepSize f x0 method.update

/-- A variable metric method can be used as its underlying trajectory of iterates. -/
instance {f : E → ℝ} {x0 : E} :
    CoeFun (VariableMetricMethod f x0) (fun _ ↦ ℕ → E) where
  coe method := method.x

/-- A variable metric method starts from the prescribed initial point `x₀`. -/
@[simp] theorem x_zero
    {f : E → ℝ} {x0 : E}
    (method : VariableMetricMethod f x0) :
    method 0 = x0 := by
  simpa [x] using variableMetricIterates_zero method.stepSize f x0 method.update

/-- The inverse-metric sequence of a variable metric method starts from `H₀ = Iₙ`. -/
@[simp] theorem inverseMetric_zero
    {f : E → ℝ} {x0 : E}
    (method : VariableMetricMethod f x0) :
    method.inverseMetric 0 = 1 := by
  simpa [inverseMetric] using
    variableMetricInverseMetrics_zero method.stepSize f x0 method.update

/-- The displayed `∇ f (xₖ)` is the genuine gradient at every iterate of a variable metric
method. -/
theorem hasGradientAt_iterate
    {f : E → ℝ} {x0 : E}
    (method : VariableMetricMethod f x0) (k : ℕ) :
    HasGradientAt f (∇ f (method k)) (method k) := by
  simpa [x] using method.hasGradientAt k

/-- The objective is differentiable at every iterate of a variable metric method. -/
theorem differentiableAt_iterate
    {f : E → ℝ} {x0 : E}
    (method : VariableMetricMethod f x0) (k : ℕ) :
    DifferentiableAt ℝ f (method k) :=
  (method.hasGradientAt_iterate k).differentiableAt

/-- The canonical recursive iterates of a variable metric method satisfy the textbook update rule
`xₖ₊₁ = xₖ - hₖ Hₖ ∇ f(xₖ)`. -/
theorem x_succ
    {f : E → ℝ} {x0 : E}
    (method : VariableMetricMethod f x0) (k : ℕ) :
    method (k + 1) =
      method k -
        method.stepSize k • (method.inverseMetric k).toEuclideanLin (∇ f (method k)) := by
  simpa [x, inverseMetric] using
    variableMetricIterates_succ method.stepSize f x0 method.update k

/-- The generated inverse metrics satisfy the chosen quasi-Newton update rule. -/
theorem inverseMetric_succ
    {f : E → ℝ} {x0 : E}
    (method : VariableMetricMethod f x0) (k : ℕ) :
    method.inverseMetric (k + 1) =
      method.update k
        (method k)
        (method (k + 1))
        (∇ f (method k))
        (∇ f (method (k + 1)))
        (method.inverseMetric k) := by
  simpa [x, inverseMetric] using
    variableMetricInverseMetrics_succ method.stepSize f x0 method.update k

/-- The metric matrix `Gₖ` associated to the inverse metric `Hₖ` is its matrix inverse. -/
def metric
    {f : E → ℝ} {x0 : E}
    (method : VariableMetricMethod f x0) (k : ℕ) : Mat :=
  (method.inverseMetric k)⁻¹

/-- Every derived metric matrix of a variable metric method is positive definite. -/
theorem metric_posDef
    {f : E → ℝ} {x0 : E}
    (method : VariableMetricMethod f x0) (k : ℕ) :
    (method.metric k).PosDef :=
  (method.inverseMetric_posDef k).inv

/-- Inverting the derived metric sequence recovers the original inverse-metric sequence. -/
@[simp] theorem metric_inv_eq_inverseMetric
    {f : E → ℝ} {x0 : E}
    (method : VariableMetricMethod f x0) (k : ℕ) :
    (method.metric k)⁻¹ = method.inverseMetric k := by
  let _ : Invertible (method.inverseMetric k) := by
    simpa [inverseMetric] using (method.inverseMetric_posDef k).isUnit.invertible
  simp [metric]

/-- The derived metric sequence starts from the identity matrix. -/
@[simp] theorem metric_zero
    {f : E → ℝ} {x0 : E}
    (method : VariableMetricMethod f x0) :
    method.metric 0 = 1 := by
  simp [metric]

/-- Under the unit-step specialization `hₖ = 1`, the variable-metric recursion takes the textbook
form `xₖ₊₁ = xₖ - Gₖ⁻¹ ∇ f(xₖ)` in terms of the derived metric sequence `Gₖ = Hₖ⁻¹`. -/
theorem x_succ_eq_sub_metric_inv_gradient
    {f : E → ℝ} {x0 : E}
    (method : VariableMetricMethod f x0)
    (hstep : method.stepSize = 1) (k : ℕ) :
    method (k + 1) =
      method k -
        ((method.metric k)⁻¹).toEuclideanLin (∇ f (method k)) := by
  simpa [hstep, method.metric_inv_eq_inverseMetric k] using method.x_succ k

/-- The search direction used by a variable metric method at step `k`. -/
def searchDirection
    {f : E → ℝ} {x0 : E}
    (method : VariableMetricMethod f x0) (k : ℕ) : E :=
  (method.inverseMetric k).toEuclideanLin (∇ f (method k))

/-- The iterate recursion is the step-size-scaled search-direction update. -/
theorem x_succ_eq_sub_stepSize_smul_searchDirection
    {f : E → ℝ} {x0 : E}
    (method : VariableMetricMethod f x0) (k : ℕ) :
    method (k + 1) = method k - method.stepSize k • method.searchDirection k := by
  simpa [searchDirection] using method.x_succ k

end VariableMetricMethod
