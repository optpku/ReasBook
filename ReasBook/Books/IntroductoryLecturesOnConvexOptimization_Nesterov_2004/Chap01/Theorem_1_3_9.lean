noncomputable section

universe u

variable {n : ℕ}

open SetConstrainedMinimizationProblem

/- Theorem 1.3.9 lies in the Chapter 1 value-oracle complexity domain with ordered sampled-value
histories.

Relevant owner-style declarations sampled before refining:
* `GeneralIterativeScheme.informationState` in `Algorithm_1_2_10.lean`, the chapter owner
  informational-set recursion, which is not reused here because the present source-facing method
  remembers an ordered sample history rather than only the underlying set of samples;
* `List.length` in mathlib, the canonical owner for the number of previously sampled values used
  by the query rule below;
* `zeroOneBoxProblem` in `Definition_1_3_3.lean`, the source-facing box-constrained minimization
  problem owned by `SetConstrainedMinimizationProblem`;
* `linftyLipschitzClass n L` and the notation `𝒫∞[n, L]` in `Definition_1_3_4.lean`, the
  source-facing owner for the admissible objective class with canonical bridge to
  `LipschitzOnWith`;
* `SetConstrainedMinimizationProblem.IsApproximateMinimizer` in
  `Definition_1_3_7.lean`, the derived owner predicate for approximate optimality.

Owner abstraction:
* the ordered sampled-value history is owned locally by
  `DeterministicValueOracleMethod.oracleTranscript`;
* the optimization statement is owned by `zeroOneBoxProblem`, `LipschitzOnWith`, and
  `IsApproximateMinimizer`.

Primitive data:
* a deterministic query rule `List (X × ℝ) → X`;
* a deterministic output rule `List (X × ℝ) → X`.

Derived API:
* the generated ordered sample history against a value oracle on any query space `X`;
* the query point and output produced after `k` oracle calls;
* the correctness predicate for solving the `𝒫∞` class within `k` calls after specializing to
  `X = zeroOneBox n`;
* the bridge from the strict source-facing gap guarantee to the canonical approximate-minimizer
  predicate. -/

/-- A deterministic value-oracle method for minimizing over `B_n = [0,1]^n` chooses each query
point from the previous value-oracle transcript and finally returns a feasible output point in
`B_n`. -/
structure DeterministicValueOracleMethod (X : Type u) where
  query : List (X × ℝ) → X
  output : List (X × ℝ) → X

namespace DeterministicValueOracleMethod

variable {X : Type u}

/-- The length-`k` transcript generated by a deterministic value-oracle method on the objective
`f`, recorded as the ordered history of feasible queried points and returned values. This
auxiliary view is kept separate from the set-valued owner
`GeneralIterativeScheme.informationState`, since the present method interface is allowed to depend
on the realized order of sampled values. -/
def oracleTranscript
    (method : DeterministicValueOracleMethod X) (oracle : X → ℝ) : ℕ → List (X × ℝ) :=
  fun
  | 0 => []
  | k + 1 =>
      let transcript := method.oracleTranscript oracle k
      let x := method.query transcript
      transcript ++ [(x, oracle x)]

/-- The query point chosen after observing the length-`k` transcript. -/
def queryAfter
    (method : DeterministicValueOracleMethod X) (oracle : X → ℝ) (k : ℕ) : X :=
  method.query (method.oracleTranscript oracle k)

/-- The output produced after observing the length-`k` transcript. -/
def outputAfter
    (method : DeterministicValueOracleMethod X) (oracle : X → ℝ) (k : ℕ) : X :=
  method.output (method.oracleTranscript oracle k)

@[simp] theorem oracleTranscript_zero
    (method : DeterministicValueOracleMethod X) (oracle : X → ℝ) :
    method.oracleTranscript oracle 0 = [] :=
  rfl

@[simp] theorem oracleTranscript_succ
    (method : DeterministicValueOracleMethod X) (oracle : X → ℝ) (k : ℕ) :
    method.oracleTranscript oracle (k + 1) =
      method.oracleTranscript oracle k ++
        [(method.queryAfter oracle k, oracle (method.queryAfter oracle k))] := by
  simp [oracleTranscript, queryAfter]

/-- Helper for Theorem 1.3.9: the length-`k` oracle transcript contains exactly `k` sampled
pairs. -/
theorem oracleTranscript_length
    (method : DeterministicValueOracleMethod X) (oracle : X → ℝ) :
    ∀ k : ℕ, (method.oracleTranscript oracle k).length = k
  | 0 => by simp
  | k + 1 => by
      -- Each step appends exactly one new query-value pair to the previous transcript.
      rw [oracleTranscript_succ, List.length_append, oracleTranscript_length]
      simp

/-- Helper for Theorem 1.3.9: if two value oracles return the same values on the query points
generated along the first oracle up to step `k`, then the resulting ordered transcripts agree up
to step `k`. -/
theorem oracleTranscript_eq_of_same_query_values
    (method : DeterministicValueOracleMethod X) (oracle₁ oracle₂ : X → ℝ) :
    ∀ {k : ℕ},
      (∀ j < k, oracle₁ (method.queryAfter oracle₁ j) = oracle₂ (method.queryAfter oracle₁ j)) →
      method.oracleTranscript oracle₁ k = method.oracleTranscript oracle₂ k
  | 0, _ => by simp
  | k + 1, hquery => by
      -- First synchronize the prefix transcript, so the next query point also synchronizes.
      have hprefix :
          method.oracleTranscript oracle₁ k = method.oracleTranscript oracle₂ k :=
        oracleTranscript_eq_of_same_query_values method oracle₁ oracle₂
          (k := k) (fun j hj ↦ hquery j (Nat.lt_succ_of_lt hj))
      have hnext_query :
          method.queryAfter oracle₁ k = method.queryAfter oracle₂ k := by
        simp [queryAfter, hprefix]
      have hnext_value :
          oracle₁ (method.queryAfter oracle₂ k) = oracle₂ (method.queryAfter oracle₂ k) := by
        simpa [hnext_query] using hquery k (Nat.lt_succ_self k)
      -- Appending the same next sampled pair yields the same successor transcript.
      rw [oracleTranscript_succ, oracleTranscript_succ, hprefix, hnext_query]
      rw [hnext_value]

/-- Helper for Theorem 1.3.9: matching queried values against the zero oracle transfers the final
output from the zero transcript to the adversarial objective transcript. -/
theorem outputAfter_eq_of_same_query_values
    (method : DeterministicValueOracleMethod X) (oracle₁ oracle₂ : X → ℝ) {k : ℕ}
    (hquery :
      ∀ j < k, oracle₁ (method.queryAfter oracle₁ j) = oracle₂ (method.queryAfter oracle₁ j)) :
    method.outputAfter oracle₁ k = method.outputAfter oracle₂ k := by
  -- The output rule depends only on the transcript, so transcript equality is enough.
  simp [outputAfter, oracleTranscript_eq_of_same_query_values method oracle₁ oracle₂ hquery]

end DeterministicValueOracleMethod

namespace DeterministicValueOracleMethod

variable {n : ℕ}

local notation "E" => EuclideanSpace ℝ (Fin n)
local notation "Coord" => Fin n → ℝ
local notation "coordEquiv" => EuclideanSpace.equiv (Fin n) ℝ

/-- Helper for Theorem 1.3.9: the `p`-mesh vertex indexed by `β` in the coordinate-cube model. -/
abbrev gridVertexPoint (p : ℕ) (β : Fin n → Fin (p + 1)) : Coord :=
  fun i ↦ ((β i : ℕ) : ℝ) / p

/-- Helper for Theorem 1.3.9: every `p`-mesh vertex lies in the coordinate cube `[0,1]^n`. -/
theorem gridVertexPoint_mem_coordBox
    {p : ℕ} (hp : 0 < p) (β : Fin n → Fin (p + 1)) :
    ∀ i : Fin n, gridVertexPoint p β i ∈ Set.Icc (0 : ℝ) 1 := by
  intro i
  constructor
  · positivity
  · have hpR : (0 : ℝ) < p := by
      exact_mod_cast hp
    have hleNat : ((β i : ℕ) : ℝ) ≤ p := by
      exact_mod_cast (Nat.lt_succ_iff.mp (β i).isLt)
    have hdiv : (((β i : ℕ) : ℝ) / p) ≤ (p : ℝ) / p :=
      div_le_div_of_nonneg_right hleNat hpR.le
    have hp_ne : (p : ℝ) ≠ 0 := by positivity
    simpa [gridVertexPoint, show (p : ℝ) / p = 1 by field_simp [hp_ne]] using hdiv

/-- Helper for Theorem 1.3.9: the coordinate version of a `p`-mesh vertex is feasible for the
textbook box `B_n = [0,1]^n`. -/
theorem gridVertexPoint_mem_zeroOneBox
    {p : ℕ} (hp : 0 < p) (β : Fin n → Fin (p + 1)) :
    ((EuclideanSpace.equiv (Fin n) ℝ).symm (gridVertexPoint p β) : E) ∈ zeroOneBox n := by
  intro i
  -- Transfer the coordinatewise box bounds from the grid vertex itself.
  simpa [gridVertexPoint] using gridVertexPoint_mem_coordBox hp β i

/-- Helper for Theorem 1.3.9: a point cannot lie within strict `ℓ∞`-radius `1 / (2p)` of two
distinct `p`-mesh vertices. -/
theorem grid_vertex_eq_of_dist_lt_half_mesh
    {p : ℕ} (hp : 0 < p) {x : Coord}
    {β γ : Fin n → Fin (p + 1)}
    (hβ : dist x (gridVertexPoint p β) < 1 / (2 * (p : ℝ)))
    (hγ : dist x (gridVertexPoint p γ) < 1 / (2 * (p : ℝ))) :
    β = γ := by
  ext i
  by_contra hne
  have hr : 0 < 1 / (2 * (p : ℝ)) := by
    positivity
  have hβi := (dist_pi_lt_iff hr).mp hβ i
  have hγi := (dist_pi_lt_iff hr).mp hγ i
  have hsep : (1 : ℝ) / p ≤ dist ((gridVertexPoint p β) i) ((gridVertexPoint p γ) i) := by
    rcases lt_or_gt_of_ne hne with hlt | hgt
    ·
      -- Distinct mesh coordinates differ by at least one full mesh step.
      have hpR : (0 : ℝ) < p := by
        exact_mod_cast hp
      have hltR :
          (((β i : Fin (p + 1)) : ℕ) : ℝ) + 1 ≤ (((γ i : Fin (p + 1)) : ℕ) : ℝ) := by
        exact_mod_cast Nat.succ_le_of_lt hlt
      have hdiv :
          ((((β i : Fin (p + 1)) : ℕ) : ℝ) + 1) / p ≤
            ((((γ i : Fin (p + 1)) : ℕ) : ℝ)) / p := by
        exact div_le_div_of_nonneg_right hltR hpR.le
      have hdiv' :
          ((((β i : Fin (p + 1)) : ℕ) : ℝ) / p) + (1 : ℝ) / p ≤
            ((((γ i : Fin (p + 1)) : ℕ) : ℝ)) / p := by
        simpa [add_div] using hdiv
      have hmain :
          (1 : ℝ) / p ≤
            ((((γ i : Fin (p + 1)) : ℕ) : ℝ)) / p -
              ((((β i : Fin (p + 1)) : ℕ) : ℝ) / p) := by
        linarith
      have habR :
          ((((β i : Fin (p + 1)) : ℕ) : ℝ) / p) ≤
            ((((γ i : Fin (p + 1)) : ℕ) : ℝ) / p) := by
        have habNat :
            ((((β i : Fin (p + 1)) : ℕ) : ℝ)) ≤
              ((((γ i : Fin (p + 1)) : ℕ) : ℝ)) := by
          exact_mod_cast (Nat.le_of_lt hlt)
        exact div_le_div_of_nonneg_right habNat hpR.le
      rw [Real.dist_eq]
      have hnonpos :
          ((((β i : Fin (p + 1)) : ℕ) : ℝ) / p) -
              ((((γ i : Fin (p + 1)) : ℕ) : ℝ) / p) ≤
            0 := sub_nonpos.mpr habR
      rw [abs_of_nonpos hnonpos]
      have hrewrite :
          -((((((β i : Fin (p + 1)) : ℕ) : ℝ) / p) -
              ((((γ i : Fin (p + 1)) : ℕ) : ℝ) / p))) =
            ((((γ i : Fin (p + 1)) : ℕ) : ℝ)) / p -
              ((((β i : Fin (p + 1)) : ℕ) : ℝ) / p) := by
        ring
      rw [hrewrite]
      exact hmain
    ·
      simpa [dist_comm] using
        (show (1 : ℝ) / p ≤ dist ((gridVertexPoint p γ) i) ((gridVertexPoint p β) i) from by
          have hpR : (0 : ℝ) < p := by
            exact_mod_cast hp
          have hltR :
              (((γ i : Fin (p + 1)) : ℕ) : ℝ) + 1 ≤ (((β i : Fin (p + 1)) : ℕ) : ℝ) := by
            exact_mod_cast Nat.succ_le_of_lt hgt
          have hdiv :
              ((((γ i : Fin (p + 1)) : ℕ) : ℝ) + 1) / p ≤
                ((((β i : Fin (p + 1)) : ℕ) : ℝ)) / p := by
            exact div_le_div_of_nonneg_right hltR hpR.le
          have hdiv' :
              ((((γ i : Fin (p + 1)) : ℕ) : ℝ) / p) + (1 : ℝ) / p ≤
                ((((β i : Fin (p + 1)) : ℕ) : ℝ)) / p := by
            simpa [add_div] using hdiv
          have hmain :
              (1 : ℝ) / p ≤
                ((((β i : Fin (p + 1)) : ℕ) : ℝ)) / p -
                  ((((γ i : Fin (p + 1)) : ℕ) : ℝ) / p) := by
            linarith
          have habR :
              ((((γ i : Fin (p + 1)) : ℕ) : ℝ) / p) ≤
                ((((β i : Fin (p + 1)) : ℕ) : ℝ) / p) := by
            have habNat :
                ((((γ i : Fin (p + 1)) : ℕ) : ℝ)) ≤
                  ((((β i : Fin (p + 1)) : ℕ) : ℝ)) := by
              exact_mod_cast (Nat.le_of_lt hgt)
            exact div_le_div_of_nonneg_right habNat hpR.le
          rw [Real.dist_eq]
          have hnonpos :
              ((((γ i : Fin (p + 1)) : ℕ) : ℝ) / p) -
                  ((((β i : Fin (p + 1)) : ℕ) : ℝ) / p) ≤
                0 := sub_nonpos.mpr habR
          rw [abs_of_nonpos hnonpos]
          have hrewrite :
              -((((((γ i : Fin (p + 1)) : ℕ) : ℝ) / p) -
                  ((((β i : Fin (p + 1)) : ℕ) : ℝ) / p))) =
                ((((β i : Fin (p + 1)) : ℕ) : ℝ)) / p -
                  ((((γ i : Fin (p + 1)) : ℕ) : ℝ) / p) := by
            ring
          rw [hrewrite]
          exact hmain)
  have hβi' : dist ((gridVertexPoint p β) i) (x i) < 1 / (2 * (p : ℝ)) := by
    simpa [dist_comm] using hβi
  have hγi' : dist (x i) ((gridVertexPoint p γ) i) < 1 / (2 * (p : ℝ)) := hγi
  have hsum :
      dist ((gridVertexPoint p β) i) (x i) +
          dist (x i) ((gridVertexPoint p γ) i) <
        (1 : ℝ) / p := by
    -- The two strict half-mesh bounds sum to a strict full-mesh bound.
    have hadd := add_lt_add hβi' hγi'
    have hrewrite : (1 / (2 * (p : ℝ))) + 1 / (2 * (p : ℝ)) = (1 : ℝ) / p := by
      field_simp [show (p : ℝ) ≠ 0 by positivity]
      norm_num
    exact hadd.trans_eq hrewrite
  have hupper : dist ((gridVertexPoint p β) i) ((gridVertexPoint p γ) i) < (1 : ℝ) / p :=
    lt_of_le_of_lt (dist_triangle _ _ _) hsum
  exact (not_lt_of_ge hsep hupper).elim

/-- Helper for Theorem 1.3.9: if fewer than `(p + 1)^n` samples are protected, then some
`p`-mesh vertex is at `ℓ∞`-distance at least `1 / (2p)` from all of them. -/
theorem exists_grid_vertex_far_from_samples
    {p m : ℕ} (hp : 0 < p) (sample : Fin m → Coord) (hm : m < (p + 1) ^ n) :
    ∃ β : Fin n → Fin (p + 1),
      ∀ t : Fin m, (1 : ℝ) / (2 * (p : ℝ)) ≤ dist (sample t) (gridVertexPoint p β) := by
  classical
  by_contra hfar
  push Not at hfar
  choose assign hassign using hfar
  have hinj : Function.Injective assign := by
    intro β γ hEq
    -- Route correction: we inject vertices into samples via their unique nearby protected point.
    apply grid_vertex_eq_of_dist_lt_half_mesh hp
    · simpa [hEq] using hassign β
    · exact hassign γ
  have hcard : Fintype.card (Fin n → Fin (p + 1)) ≤ Fintype.card (Fin m) :=
    Fintype.card_le_of_injective assign hinj
  have hcard' : (p + 1) ^ n ≤ m := by
    simpa using hcard
  exact (not_le_of_gt hm) hcard'

/-- Helper for Theorem 1.3.9: the protected transcript points, viewed in the coordinate cube. -/
def protectedTranscriptCoordSet
    {m : ℕ} (sample : Fin (m + 1) → zeroOneBox n) : Set Coord :=
  Set.range fun t => coordEquiv (sample t : E)

/-- Helper for Theorem 1.3.9: the protected transcript always yields a nonempty coordinate set. -/
theorem protectedTranscriptCoordSet_nonempty
    {m : ℕ} (sample : Fin (m + 1) → zeroOneBox n) :
    (protectedTranscriptCoordSet sample).Nonempty := by
  exact ⟨coordEquiv (sample (Fin.last m) : E), ⟨Fin.last m, rfl⟩⟩

/-- Helper for Theorem 1.3.9: the adversarial objective is the capped negative distance to the
protected transcript. It is the coordinate-set version of the source proof's capped radial well
construction. -/
def protectedTranscriptAdversary
    (L : NNReal) (ε : ℝ) {m : ℕ} (sample : Fin (m + 1) → zeroOneBox n) : E → ℝ :=
  fun x ↦ -min ε ((L : ℝ) * Metric.infDist (coordEquiv x) (protectedTranscriptCoordSet sample))

/-- Helper for Theorem 1.3.9: the protected-transcript adversary belongs to the admissible class
`𝒫∞[n, L]`. -/
theorem protectedTranscriptAdversary_mem
    {L : NNReal} {ε : ℝ} {m : ℕ} (sample : Fin (m + 1) → zeroOneBox n) :
    protectedTranscriptAdversary L ε sample ∈ 𝒫∞[n, L] := by
  rw [mem_linftyLipschitzClass_iff_lipschitzOnWith]
  -- The distance-to-set map is 1-Lipschitz, and the cap `u ↦ -min ε u` is also 1-Lipschitz.
  have hInf : LipschitzWith 1 (fun x : Coord ↦ Metric.infDist x (protectedTranscriptCoordSet sample)) :=
    Metric.lipschitz_infDist_pt _
  have hScaled : LipschitzWith L
      (fun x : Coord ↦ (L : ℝ) * Metric.infDist x (protectedTranscriptCoordSet sample)) := by
    refine LipschitzWith.of_dist_le_mul fun x y => ?_
    have hxy : dist (Metric.infDist x (protectedTranscriptCoordSet sample))
        (Metric.infDist y (protectedTranscriptCoordSet sample)) ≤ dist x y := by
      simpa using hInf.dist_le_mul x y
    have hmul := mul_le_mul_of_nonneg_left hxy L.2
    have habs :
        |(L : ℝ) * Metric.infDist x (protectedTranscriptCoordSet sample) -
            (L : ℝ) * Metric.infDist y (protectedTranscriptCoordSet sample)| =
          (L : ℝ) *
            |Metric.infDist x (protectedTranscriptCoordSet sample) -
                Metric.infDist y (protectedTranscriptCoordSet sample)| := by
      calc
        |(L : ℝ) * Metric.infDist x (protectedTranscriptCoordSet sample) -
            (L : ℝ) * Metric.infDist y (protectedTranscriptCoordSet sample)| =
          |(L : ℝ) *
              (Metric.infDist x (protectedTranscriptCoordSet sample) -
                Metric.infDist y (protectedTranscriptCoordSet sample))| := by
            ring_nf
        _ = |(L : ℝ)| *
              |Metric.infDist x (protectedTranscriptCoordSet sample) -
                Metric.infDist y (protectedTranscriptCoordSet sample)| := abs_mul _ _
        _ = (L : ℝ) *
              |Metric.infDist x (protectedTranscriptCoordSet sample) -
                Metric.infDist y (protectedTranscriptCoordSet sample)| := by
            simp
    rw [Real.dist_eq, habs]
    simpa [Real.dist_eq] using hmul
  have hMin : LipschitzWith L
      (fun x : Coord ↦
        min ε ((L : ℝ) * Metric.infDist x (protectedTranscriptCoordSet sample))) :=
    hScaled.const_min ε
  have hNeg : LipschitzWith L
      (fun x : Coord ↦
        -min ε ((L : ℝ) * Metric.infDist x (protectedTranscriptCoordSet sample))) := by
    refine LipschitzWith.of_dist_le_mul fun x y => ?_
    simpa [Real.dist_eq] using hMin.dist_le_mul x y
  simpa [protectedTranscriptAdversary, Function.comp] using hNeg.lipschitzOnWith

/-- Helper for Theorem 1.3.9: every protected transcript point receives adversarial value `0`,
so the all-zero oracle transcript is preserved. -/
theorem protectedTranscriptAdversary_eq_zero
    {L : NNReal} {ε : ℝ} {m : ℕ} (hε : 0 ≤ ε)
    (sample : Fin (m + 1) → zeroOneBox n) (t : Fin (m + 1)) :
    protectedTranscriptAdversary L ε sample (sample t) = 0 := by
  have hmem : coordEquiv ((sample t : zeroOneBox n) : E) ∈ protectedTranscriptCoordSet sample := by
    exact ⟨t, rfl⟩
  -- At a protected sample point the distance to the protected set is zero, so the cap vanishes.
  rw [protectedTranscriptAdversary, Metric.infDist_zero_of_mem hmem]
  have hmin : min ε ((L : ℝ) * 0) = 0 := by
    simp [hε]
  simpa [hmin]

/-- Helper for Theorem 1.3.9: if a coordinate point is far enough from the whole protected
transcript, then the adversarial objective attains the value `-ε` there. -/
theorem protectedTranscriptAdversary_eq_neg_epsilon
    {L : NNReal} {ε : ℝ} {m : ℕ} (sample : Fin (m + 1) → zeroOneBox n)
    {x : Coord}
    (hεx : ε ≤ (L : ℝ) * Metric.infDist x (protectedTranscriptCoordSet sample)) :
    protectedTranscriptAdversary L ε sample ((EuclideanSpace.equiv (Fin n) ℝ).symm x) = -ε := by
  -- Once the distance term exceeds `ε`, the cap is active and the adversary equals `-ε`.
  rw [protectedTranscriptAdversary]
  rw [(EuclideanSpace.equiv (Fin n) ℝ).apply_symm_apply x]
  simp [min_eq_left hεx]

/-- A deterministic value-oracle method solves the textbook class `𝒫∞` within `k` oracle calls at
accuracy threshold `ε` when every admissible objective receives an output with strict
function-value error below `ε` above the canonical optimal value; feasibility is already built
into the method itself. -/
def SolvesLinftyLipschitzProblemClassWithin
    (method : DeterministicValueOracleMethod (zeroOneBox n))
    (L : NNReal) (ε : ℝ) (k : ℕ) : Prop :=
  ∀ f : E → ℝ,
    f ∈ 𝒫∞[n, L] →
      let oracle : zeroOneBox n → ℝ := f ∘ (↑)
      let xBar := method.outputAfter oracle k
      let problem := zeroOneBoxProblem n f
      (problem xBar : EReal) < problem.optimalValue + ε

/-- A uniform `δ`-approximate-minimizer guarantee with `δ < ε` upgrades to the owner solve
predicate at accuracy `ε`. -/
theorem solvesLinftyLipschitzProblemClassWithin_of_isApproximateMinimizer_outputAfter
    (method : DeterministicValueOracleMethod (zeroOneBox n))
    {L : NNReal} {δ ε : ℝ} {k : ℕ} (hδε : δ < ε)
    (hmethod :
      ∀ f : E → ℝ, f ∈ 𝒫∞[n, L] →
        (zeroOneBoxProblem n f).IsApproximateMinimizer δ
          (method.outputAfter (f ∘ (↑)) k)) :
    method.SolvesLinftyLipschitzProblemClassWithin L ε k := by
  intro f hf
  have happrox :
      (zeroOneBoxProblem n f).IsApproximateMinimizer δ
        (method.outputAfter (f ∘ (↑)) k) :=
    hmethod f hf
  rw [isApproximateMinimizer_iff] at happrox
  have hopt_ne_bot : (zeroOneBoxProblem n f).optimalValue ≠ ⊥ := by
    intro hbot
    simpa [hbot] using happrox.2
  have hopt_ne_top : (zeroOneBoxProblem n f).optimalValue ≠ ⊤ := by
    intro htop
    have hopt_le :
        (zeroOneBoxProblem n f).optimalValue ≤
          ((zeroOneBoxProblem n f) (method.outputAfter (f ∘ (↑)) k) : EReal) :=
      (zeroOneBoxProblem n f).optimalValue_le_of_mem_feasibleSet happrox.1
    rw [htop] at hopt_le
    simp at hopt_le
  exact lt_of_le_of_lt happrox.2 <| by
    simpa [add_comm] using
      EReal.add_lt_add_of_lt_of_le
        (show (δ : EReal) < ε by exact_mod_cast hδε)
        le_rfl hopt_ne_bot hopt_ne_top

/-- Solving the textbook class `𝒫∞` within `k` calls yields an `ε`-approximate minimizer in the
canonical sense of Definition 1.3.7. -/
theorem isApproximateMinimizer_outputAfter_of_solvesLinftyLipschitzProblemClassWithin
    (method : DeterministicValueOracleMethod (zeroOneBox n))
    {L : NNReal} {ε : ℝ} {k : ℕ}
    (hmethod : method.SolvesLinftyLipschitzProblemClassWithin L ε k)
    {f : E → ℝ} (hf : f ∈ 𝒫∞[n, L]) :
    (zeroOneBoxProblem n f).IsApproximateMinimizer ε (method.outputAfter (f ∘ (↑)) k) := by
  rw [isApproximateMinimizer_iff]
  refine ⟨?_, le_of_lt ?_⟩
  · exact (method.outputAfter (f ∘ (↑)) k).property
  · simpa using hmethod f hf

/-- Solving the textbook class `𝒫∞` within `k` calls already forces the accuracy threshold to be
strictly positive. -/
theorem SolvesLinftyLipschitzProblemClassWithin.eps_pos
    {method : DeterministicValueOracleMethod (zeroOneBox n)}
    {L : NNReal} {ε : ℝ} {k : ℕ}
    (hmethod : method.SolvesLinftyLipschitzProblemClassWithin L ε k) :
    0 < ε := by
  let f : E → ℝ := fun _ ↦ 0
  let oracle : zeroOneBox n → ℝ := f ∘ (↑)
  let problem := zeroOneBoxProblem n f
  let xBar : zeroOneBox n := method.outputAfter oracle k
  have hf : f ∈ 𝒫∞[n, L] := by
    rw [mem_linftyLipschitzClass_iff]
    intro x hx y hy
    simpa [f] using (show (0 : ℝ) ≤ (L : ℝ) * ‖x - y‖∞ by positivity)
  have hgap : (0 : EReal) < problem.optimalValue + ε := by
    simpa [f, problem, xBar] using hmethod f hf
  have hzero_mem : (0 : E) ∈ problem.feasibleSet := by
    simp [problem]
  have hopt_le_zero : problem.optimalValue ≤ (0 : EReal) := by
    simpa [f, problem] using
      problem.optimalValue_le_of_mem_feasibleSet hzero_mem
  have hle : problem.optimalValue + ε ≤ (ε : EReal) := by
    simpa [add_comm, add_left_comm, add_assoc] using
      add_le_add_left hopt_le_zero (ε : EReal)
  have hεEReal : (0 : EReal) < (ε : EReal) :=
    lt_of_lt_of_le hgap hle
  simpa using hεEReal

/-- Helper for Theorem 1.3.9: an admissible objective that matches the zero transcript on the
first `k` query points but still leaves the zero-transcript output with gap at least `ε`
contradicts the claimed solve guarantee. -/
theorem not_solves_of_zero_oracle_adversarial_instance
    (method : DeterministicValueOracleMethod (zeroOneBox n))
    {L : NNReal} {ε : ℝ} {k : ℕ}
    (hmethod : method.SolvesLinftyLipschitzProblemClassWithin L ε k)
    {f : E → ℝ} (hf : f ∈ 𝒫∞[n, L])
    (hquery :
      ∀ j < k,
        f (method.queryAfter (fun _ : zeroOneBox n ↦ (0 : ℝ)) j) = 0)
    (hbad :
      ¬
        ((zeroOneBoxProblem n f)
            (method.outputAfter (fun _ : zeroOneBox n ↦ (0 : ℝ)) k) : EReal) <
          (zeroOneBoxProblem n f).optimalValue + ε) :
    False := by
  let oracle₀ : zeroOneBox n → ℝ := fun _ ↦ 0
  let oraclef : zeroOneBox n → ℝ := f ∘ (↑)
  have hout :
      method.outputAfter oracle₀ k = method.outputAfter oraclef k := by
    -- The two transcripts coincide because the adversarial function reproduces all zero answers.
    refine
      outputAfter_eq_of_same_query_values method oracle₀ oraclef (k := k) ?_
    intro j hj
    simpa [oracle₀, oraclef] using (hquery j hj).symm
  have hsolve : ((zeroOneBoxProblem n f) (method.outputAfter oraclef k) : EReal) <
      (zeroOneBoxProblem n f).optimalValue + ε := by
    simpa [oraclef] using hmethod f hf
  have hsolve₀ :
      ((zeroOneBoxProblem n f) (method.outputAfter oracle₀ k) : EReal) <
        (zeroOneBoxProblem n f).optimalValue + ε := by
    rw [hout]
    exact hsolve
  -- Rewriting the output through the synchronized transcript gives the contradiction.
  exact hbad hsolve₀

end DeterministicValueOracleMethod

open DeterministicValueOracleMethod

local notation "E" => EuclideanSpace ℝ (Fin n)
local notation "Coord" => Fin n → ℝ
local notation "coordEquiv" => EuclideanSpace.equiv (Fin n) ℝ

/- Theorem 1.3.9 remains source-facing: it is the textbook oracle-call lower bound for the
positive-dimensional box-Lipschitz class. Its core/canonical ingredients are already the owner
predicate `DeterministicValueOracleMethod.SolvesLinftyLipschitzProblemClassWithin` and the box
problem owner `zeroOneBoxProblem`; no extra wrapper around those owners is introduced here. -/

/-- Theorem 1.3.9: if `1 ≤ n` and `ε < L / 2`, then any deterministic value-oracle method that
guarantees for every objective in the textbook class `𝒫∞` a feasible output `x̄ ∈ B_n = [0,1]^n`
with function-value gap `f x̄ - f^* < ε` after `k` calls must satisfy
`⌊L / (2 ε)⌋^n ≤ k`. -/
-- Proof sketch: set `p = ⌊L / (2 ε)⌋` and argue by contradiction from `k < p^n`. Partition
-- `B_n` into `p^n` boxes and answer all oracle queries by `0`. Some box remains untouched. Center
-- the adversarial truncated-cone objective `x ↦ min (0, L ‖x - x*‖∞ - ε)` in that box. This
-- function belongs to `𝒫∞`, matches the all-zero transcript on every queried point, and has
-- minimum value `-ε` at its center, while the method still outputs a point of value `0`.
-- Therefore the guaranteed strict gap bound fails unless at least `p^n` oracle calls are made.
theorem linftyLipschitz_value_oracle_complexity_lower_bound
    (hn : 1 ≤ n) {L : NNReal} {ε : ℝ} (hεL : ε < (L : ℝ) / 2)
    {k : ℕ} (method : DeterministicValueOracleMethod (zeroOneBox n))
    (hmethod : method.SolvesLinftyLipschitzProblemClassWithin L ε k) :
    Nat.floor ((L : ℝ) / (2 * ε)) ^ n ≤ k := by
  let p := Nat.floor ((L : ℝ) / (2 * ε))
  by_contra hk
  have hklt : k < p ^ n := Nat.lt_of_not_ge hk
  have hε : 0 < ε := hmethod.eps_pos
  have hratio : 1 < (L : ℝ) / (2 * ε) := by
    have hden : 0 < 2 * ε := by positivity
    have hlt : 2 * ε < (L : ℝ) := by nlinarith
    exact (one_lt_div hden).2 hlt
  have hp : 0 < p := by
    exact Nat.floor_pos.mpr hratio.le
  let oracle₀ : zeroOneBox n → ℝ := fun _ ↦ 0
  let sample : Fin (k + 1) → zeroOneBox n :=
    Fin.snoc (fun j : Fin k ↦ method.queryAfter oracle₀ j) (method.outputAfter oracle₀ k)
  let sampleCoord : Fin (k + 1) → Coord := fun t ↦ coordEquiv (sample t : E)
  have hpow_lt : p ^ n < (p + 1) ^ n := by
    exact Nat.pow_lt_pow_left (Nat.lt_succ_self p) (Nat.ne_of_gt (lt_of_lt_of_le Nat.zero_lt_one hn))
  have hcount : k + 1 < (p + 1) ^ n := lt_of_le_of_lt (Nat.succ_le_of_lt hklt) hpow_lt
  obtain ⟨β, hfar_vertex⟩ := exists_grid_vertex_far_from_samples hp sampleCoord hcount
  let xStarCoord : Coord := gridVertexPoint p β
  let xStar : E := (EuclideanSpace.equiv (Fin n) ℝ).symm xStarCoord
  let f : E → ℝ := protectedTranscriptAdversary L ε sample
  have hf : f ∈ 𝒫∞[n, L] := protectedTranscriptAdversary_mem sample
  have hxStar_mem : xStar ∈ zeroOneBox n := by
    -- The chosen grid vertex stays inside the unit box.
    simpa [xStar, xStarCoord] using gridVertexPoint_mem_zeroOneBox hp β
  have hquery :
      ∀ j < k, f (method.queryAfter oracle₀ j) = 0 := by
    intro j hj
    let jFin : Fin k := ⟨j, hj⟩
    -- Every protected query is one of the sample points where the adversary vanishes.
    have hzero :
        protectedTranscriptAdversary L ε sample (sample jFin.castSucc) = 0 :=
      protectedTranscriptAdversary_eq_zero hε.le sample jFin.castSucc
    have hsamp : sample jFin.castSucc = method.queryAfter oracle₀ j := by
      simpa [sample, jFin] using
        (Fin.snoc_castSucc
          (α := fun _ : Fin (k + 1) ↦ zeroOneBox n)
          (x := method.outputAfter oracle₀ k)
          (p := fun j : Fin k ↦ method.queryAfter oracle₀ j)
          jFin)
    simpa [f, hsamp] using hzero
  have houtput : f (method.outputAfter oracle₀ k) = 0 := by
    -- The final zero-transcript output is also protected explicitly.
    simpa [f, sample, oracle₀] using
      protectedTranscriptAdversary_eq_zero hε.le sample (Fin.last k)
  have hmesh_to_inf :
      (1 : ℝ) / (2 * (p : ℝ)) ≤ Metric.infDist xStarCoord (protectedTranscriptCoordSet sample) := by
    -- The chosen mesh vertex is far from every protected sample, hence from the whole set.
    refine (Metric.le_infDist (protectedTranscriptCoordSet_nonempty sample)).2 ?_
    intro y hy
    rcases hy with ⟨t, rfl⟩
    simpa [sampleCoord, xStarCoord, protectedTranscriptCoordSet, dist_comm] using hfar_vertex t
  have hε_le_scale : ε ≤ (L : ℝ) / (2 * p) := by
    have hfloor : (p : ℝ) ≤ (L : ℝ) / (2 * ε) := by
      exact Nat.floor_le (by positivity)
    have hmul : (p : ℝ) * (2 * ε) ≤ (L : ℝ) := by
      exact (le_div_iff₀ (by positivity : 0 < 2 * ε)).mp hfloor
    exact (le_div_iff₀ (by positivity : 0 < 2 * (p : ℝ))).2 (by nlinarith)
  have hεx :
      ε ≤ (L : ℝ) * Metric.infDist xStarCoord (protectedTranscriptCoordSet sample) := by
    have hscaled :
        (L : ℝ) * (1 / (2 * (p : ℝ))) ≤
        (L : ℝ) * Metric.infDist xStarCoord (protectedTranscriptCoordSet sample) := by
      exact mul_le_mul_of_nonneg_left hmesh_to_inf L.2
    have hscaled' : (L : ℝ) / (2 * p) ≤
        (L : ℝ) * Metric.infDist xStarCoord (protectedTranscriptCoordSet sample) := by
      simpa [div_eq_mul_inv, mul_assoc, mul_left_comm, mul_comm] using hscaled
    exact le_trans hε_le_scale hscaled'
  have hxStar_value : f xStar = -ε := by
    -- At the far mesh vertex the capped distance is already at least `ε`, so the value is `-ε`.
    simpa [f, xStar, xStarCoord] using
      protectedTranscriptAdversary_eq_neg_epsilon sample hεx
  have hopt_le : (zeroOneBoxProblem n f).optimalValue ≤ (-ε : EReal) := by
    -- Feasibility of the far vertex gives an upper bound on the optimal value.
    have hfeas : xStar ∈ (zeroOneBoxProblem n f).feasibleSet := by
      simpa using hxStar_mem
    have hle :
        (zeroOneBoxProblem n f).optimalValue ≤ ((zeroOneBoxProblem n f) xStar : EReal) :=
      (zeroOneBoxProblem n f).optimalValue_le_of_mem_feasibleSet hfeas
    simpa [hxStar_value] using hle
  have hbad :
      ¬
        ((zeroOneBoxProblem n f) (method.outputAfter oracle₀ k) : EReal) <
          (zeroOneBoxProblem n f).optimalValue + ε := by
    intro hlt
    have hzero_lt : (0 : EReal) < (zeroOneBoxProblem n f).optimalValue + ε := by
      have hlt' :
          ((f (method.outputAfter oracle₀ k) : ℝ) : EReal) <
            (zeroOneBoxProblem n f).optimalValue + ε := by
        simpa [zeroOneBoxProblem] using hlt
      rw [houtput] at hlt'
      simpa using hlt'
    have hupper : (zeroOneBoxProblem n f).optimalValue + ε ≤ 0 := by
      have h' :
          (zeroOneBoxProblem n f).optimalValue + (ε : EReal) ≤
            (-ε : EReal) + (ε : EReal) :=
        add_le_add_left hopt_le _
      have hcancel : ((-ε : ℝ) : EReal) + (ε : EReal) = 0 := by
        rw [← EReal.coe_add]
        norm_num
      exact h'.trans_eq hcancel
    exact (lt_irrefl (0 : EReal)) (lt_of_lt_of_le hzero_lt hupper)
  -- The protected-transcript adversary contradicts the claimed solve guarantee.
  exact not_solves_of_zero_oracle_adversarial_instance method hmethod hf hquery hbad

end
