open scoped Gradient ConstrainedArgmin

noncomputable section

open LinearMap (BilinForm)
open LinearMap.BilinForm
open scoped BInducedNorm

universe u

variable {E : Type u} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]

local instance (B : BilinForm ℝ E) : AddCommGroup (PrimalSpace B) :=
  inferInstanceAs (AddCommGroup E)

local instance (B : BilinForm ℝ E) : Module ℝ (PrimalSpace B) :=
  inferInstanceAs (Module ℝ E)

/- Algorithm 4.3.1 lies in the Chapter 4 optimal cubic-Newton / `B`-induced estimating-sequence
domain.

Sampled owner declarations in this domain:
* `CubicNewtonStep` in `Definition_4_3_6`, the source-facing owner of the one-step map `T_M`
  in the `B`-geometry;
* `sampledAffineMinorant` in `Chap03/Proposition_3_26`, the canonical affine-map owner of the
  linearized increment added to the estimating functions;
* `AcceleratedCubicNewtonMethod` in `Algorithm_4_2_2`, which already separates primitive
  algorithmic choices from the derived estimating-function surface;
* `LinearOracleCompositeMethod.iterates` in `Chap06/Algorithm_6_4`, a nearby recursive owner
  pattern where the iterate sequence is derived from one-step data rather than stored
  entrywise.

Best owner abstraction:
* source-facing: Algorithm 4.3.1 itself as a recursive stage evolution in the `B`-geometry;
* core/canonical: the step owner `CubicNewtonStep B f ((Mf : ℝ) / sigma)` together with the
  affine-map owner of the estimating-function updates;
* bridge/view: the derived textbook sequences `x_k`, `v_k`, `y_k`, `A_k`, `a_k`, and `ψ_k`.

Primitive data:
* the parameter condition `σ ∈ (0, 1)`;
* the cubic Newton step owner `T_M` with `M = M_f / σ`;
* the auxiliary positive sequence `ρ_k`;
* the positive source parameter `M_f`, owned canonically as `Mf : NNRealˣ`;
* the stagewise minimizing points `v_k` actually used by the recursion.

Derived API:
* the recursive stage state storing the actual algorithm objects `x_k`, `ℓ_k`, and `A_k`;
* the canonical scalar update `a_{k+1}` as the positive quadratic root determined by `A_k` and
  `ρ_k`;
* the interpolation points `y_k`;
* the quadratic estimating functions
  `ψ_k = quadraticallyRegularizedObjective ℓ_k 1 x₀` on `PrimalSpace B`.

The previous version stored the entire families `x`, `v`, `y`, `A`, `a`, and `affinePart` as
primitive fields satisfying axioms. That erased the source-facing recursive owner of
Algorithm 4.3.1. This file now keeps the recursive state evolution as the public owner and
derives the displayed textbook sequences from that recursion. -/

/-- The positive quadratic root solving the scalar update with denominator `M ρ_k`. -/
private def nextWeightValue (M : ℝ) (rho : ℕ → ℝ) (k : ℕ) (A : ℝ) : ℝ :=
  (1 + Real.sqrt (1 + 2 * A * M * rho k)) / (M * rho k)

/-- The recursive stage state of Algorithm 4.3.1. The algorithm evolves the actual iterate
`x_k`, affine part `ℓ_k`, and accumulated weight `A_k`; the stagewise minimizers `v_k`,
interpolation points `y_k`, and next weights `a_{k+1}` are derived from this state. -/
private structure State
    (B : BilinForm ℝ E) [Fact B.toQuadraticMap.PosDef] where
  /-- The current iterate `x_k`. -/
  x : PrimalSpace B
  /-- The affine part `ℓ_k` of the estimating function
  `ψ_k = quadraticallyRegularizedObjective ℓ_k 1 x₀`. -/
  affinePart : PrimalSpace B →ᵃ[ℝ] ℝ
  /-- The accumulated weight `A_k`. -/
  A : ℝ

/-- The recursive stage state generated by the primitive step map, auxiliary sequence, and
stagewise minimizing points. -/
private def state
    {B : BilinForm ℝ E} [Fact B.toQuadraticMap.PosDef]
    (f : PrimalSpace B → ℝ) (x0 : PrimalSpace B) (M : ℝ)
    (step : CubicNewtonStep B f M) (rho : ℕ → ℝ) (v : ℕ → PrimalSpace B) :
    ℕ → State B
  | 0 =>
      { x := x0
        affinePart := 0
        A := 0 }
  | k + 1 =>
      let current := state f x0 M step rho v k
      let a := nextWeightValue M rho k current.A
      let A := current.A + a
      let y := (1 - a / A) • current.x + (a / A) • v k
      let x := step y
      { x := x
        affinePart :=
          current.affinePart +
            a • sampledAffineMinorant x (∇ f x) (f x)
        A := A }

private def primalQuadraticallyRegularizedObjective
    {B : BilinForm ℝ E} [Fact B.toQuadraticMap.PosDef]
    (affinePart : PrimalSpace B → ℝ) (x0 : PrimalSpace B) :
    PrimalSpace B → ℝ :=
  @quadraticallyRegularizedObjective (PrimalSpace B)
    (AddGroupNorm.toNormedAddCommGroup (primalAddGroupNorm B))
    affinePart
    1
    x0

omit [CompleteSpace E] in
@[simp] private theorem primalQuadraticallyRegularizedObjective_apply
    {B : BilinForm ℝ E} [Fact B.toQuadraticMap.PosDef]
    (affinePart : PrimalSpace B → ℝ) (x0 z : PrimalSpace B) :
    primalQuadraticallyRegularizedObjective affinePart x0 z =
      affinePart z + (1 / 2 : ℝ) * ‖z - x0‖[B] ^ (2 : ℕ) := by
  unfold primalQuadraticallyRegularizedObjective quadraticallyRegularizedObjective
  exact congrArg
    (fun t : ℝ ↦ affinePart z + (1 / 2 : ℝ) * t ^ (2 : ℕ))
    (primalSpace_norm_eq_bInducedNorm B (z - x0))

/-- The recursively generated estimating function `ψ_k` determined by the primitive step owner,
auxiliary sequence, and minimizing sequence. -/
def optimalCubicNewtonEstimatingFunction
    {B : BilinForm ℝ E} [Fact B.toQuadraticMap.PosDef]
    (f : PrimalSpace B → ℝ) (x0 : PrimalSpace B) (M : ℝ)
    (step : CubicNewtonStep B f M) (rho : ℕ → ℝ) (v : ℕ → PrimalSpace B) (k : ℕ) :
    PrimalSpace B → ℝ :=
  primalQuadraticallyRegularizedObjective
    ((state f x0 M step rho v k).affinePart)
    x0

/-- Algorithm 4.3.1: the conceptual optimal cubic Newton method for an objective `f`,
initialization point `x₀`, and parameter `σ ∈ (0, 1)` consists of a cubic Newton step map `T_M`
with `M = M_f / σ`, a positive auxiliary sequence `ρ_k`, and the stagewise minimizing points
`v_k` of the recursively generated quadratic estimating functions. The displayed sequences `x_k`,
`ℓ_k`, `A_k`, `a_{k+1}`, `y_k`, and `ψ_k` are then derived recursively from these data, with
`a_{k+1}` defined by the positive quadratic root solving
`a_{k+1}² = 2 (A_k + a_{k+1}) / (M ρ_k)`. -/
structure OptimalCubicNewtonMethod
    (B : BilinForm ℝ E) (Mf : NNRealˣ) (f : PrimalSpace B → ℝ)
    [Fact B.toQuadraticMap.PosDef]
    (x0 : PrimalSpace B) (sigma : ℝ) where
  /-- The algorithmic parameter satisfies `σ ∈ (0, 1)`. -/
  sigma_mem : sigma ∈ Set.Ioo (0 : ℝ) 1
  /-- The cubic Newton step map `T_M` for `M = M_f / σ`. -/
  step : CubicNewtonStep B f ((Mf : ℝ) / sigma)
  /-- The positive auxiliary parameters `ρ_k`. -/
  rho : ℕ → ℝ
  /-- Each auxiliary parameter `ρ_k` is positive. -/
  rho_pos (k : ℕ) : 0 < rho k
  /-- The stagewise minimizing points `v_k` of the recursively generated estimating functions. -/
  v : ℕ → PrimalSpace B
  /-- Each `v_k` globally minimizes the corresponding recursively generated quadratic estimating
  function. -/
  v_isMinOn (k : ℕ) :
    IsMinOn
      (optimalCubicNewtonEstimatingFunction f x0 ((Mf : ℝ) / sigma) step rho v k)
      Set.univ
      (v k)

namespace OptimalCubicNewtonMethod

variable {B : BilinForm ℝ E} {Mf : NNRealˣ} {f : PrimalSpace B → ℝ}
  [Fact B.toQuadraticMap.PosDef] {x0 : PrimalSpace B} {sigma : ℝ}

/-- The cubic-Newton regularization parameter `M = M_f / σ`. -/
def M
    (_method : OptimalCubicNewtonMethod B Mf f x0 sigma) :
    ℝ :=
  (Mf : ℝ) / sigma

/-- The objective parameter `M = M_f / σ` is positive. -/
theorem M_pos
    (method : OptimalCubicNewtonMethod B Mf f x0 sigma) :
    0 < method.M := by
  have hMf : 0 < (Mf : NNReal) := pos_iff_ne_zero.mpr (Units.ne_zero Mf)
  exact div_pos (by exact_mod_cast hMf) method.sigma_mem.1

/-- The positive quadratic root solving the scalar update with denominator `M ρ_k`. -/
def nextWeight
    (method : OptimalCubicNewtonMethod B Mf f x0 sigma)
    (k : ℕ) (A : ℝ) :
    ℝ :=
  nextWeightValue method.M method.rho k A

/-- Each canonical update weight is positive. -/
theorem nextWeight_pos
    (method : OptimalCubicNewtonMethod B Mf f x0 sigma)
    (k : ℕ) (A : ℝ) :
    0 < method.nextWeight k A := by
  have hden : 0 < method.M * method.rho k := mul_pos method.M_pos (method.rho_pos k)
  have hnum : 0 < 1 + Real.sqrt (1 + 2 * A * method.M * method.rho k) := by
    positivity
  exact div_pos hnum hden

/-- The canonical update weight solves the scalar recursion whenever `A ≥ 0`. -/
theorem nextWeight_sq
    (method : OptimalCubicNewtonMethod B Mf f x0 sigma)
    (k : ℕ) {A : ℝ} (hA : 0 ≤ A) :
    (method.nextWeight k A) ^ (2 : ℕ) =
      (2 : ℝ) * (A + method.nextWeight k A) / (method.M * method.rho k) := by
  set d : ℝ := method.M * method.rho k with hd
  have hd_pos : 0 < d := by
    -- Step (b) divides by `M ρ_k`, so we first record that this denominator is positive.
    simpa [d] using mul_pos method.M_pos (method.rho_pos k)
  have hrad : 0 ≤ 1 + 2 * A * d := by
    -- The radicand is nonnegative because both `A` and `d` are nonnegative.
    nlinarith [hA, hd_pos]
  have hsq :
      (Real.sqrt (1 + 2 * A * d)) ^ (2 : ℕ) =
        1 + 2 * A * d := by
    -- Squaring the chosen positive root removes the square root.
    simpa [pow_two] using Real.sq_sqrt hrad
  have hd0 : d ≠ 0 := ne_of_gt hd_pos
  set s : ℝ := Real.sqrt (1 + 2 * A * d)
  have hs_sq : s ^ (2 : ℕ) = 1 + 2 * A * d := by
    simpa [s] using hsq
  -- After unfolding `nextWeight`, the claim is a scalar quadratic identity for the positive root.
  have hcalc :
      ((1 + s) / d) ^ (2 : ℕ) = (2 : ℝ) * (A + (1 + s) / d) / d := by
    calc
      ((1 + s) / d) ^ (2 : ℕ)
          = (1 + s) ^ (2 : ℕ) / d ^ (2 : ℕ) := by
              rw [div_pow]
      _ = (2 * (A * d + (1 + s))) / d ^ (2 : ℕ) := by
            congr 1
            calc
              (1 + s) ^ (2 : ℕ) = 1 + 2 * s + s ^ (2 : ℕ) := by ring
              _ = 1 + 2 * s + (1 + 2 * A * d) := by rw [hs_sq]
              _ = 2 * (A * d + (1 + s)) := by ring
      _ = (2 : ℝ) * (A + (1 + s) / d) / d := by
            field_simp [pow_two, hd0]
  simpa [nextWeight, nextWeightValue, d, s, mul_assoc] using hcalc

/-- The iterate sequence `x₀, x₁, x₂, ...` obtained from the recursive state. -/
def x
    (method : OptimalCubicNewtonMethod B Mf f x0 sigma) :
    ℕ → PrimalSpace B :=
  fun k ↦ (state f x0 method.M method.step method.rho method.v k).x

/-- The affine parts `ℓ_k` of the estimating functions, obtained from the recursive state. -/
def affinePart
    (method : OptimalCubicNewtonMethod B Mf f x0 sigma) :
    ℕ → PrimalSpace B →ᵃ[ℝ] ℝ :=
  fun k ↦ (state f x0 method.M method.step method.rho method.v k).affinePart

/-- The accumulated weights `A_k`, obtained from the recursive state. -/
def A
    (method : OptimalCubicNewtonMethod B Mf f x0 sigma) :
    ℕ → ℝ :=
  fun k ↦ (state f x0 method.M method.step method.rho method.v k).A

/-- The weight sequence `a_k`; only the successor values `a_{k+1}` are used by the algorithm. -/
def a
    (method : OptimalCubicNewtonMethod B Mf f x0 sigma) :
    ℕ → ℝ
  | 0 => 0
  | k + 1 => method.nextWeight k (method.A k)

/-- The interpolation points `y_k = (1 - τ_k) x_k + τ_k v_k` with
`τ_k = a_{k+1} / A_{k+1}`. -/
def y
    (method : OptimalCubicNewtonMethod B Mf f x0 sigma) :
    ℕ → PrimalSpace B :=
  fun k ↦
    (1 - method.a (k + 1) / method.A (k + 1)) • method.x k +
      (method.a (k + 1) / method.A (k + 1)) • method.v k

/-- The estimating functions of an optimal cubic Newton method, written with their canonical
affine part plus the fixed `B`-quadratic term. -/
def psi
    (method : OptimalCubicNewtonMethod B Mf f x0 sigma) :
    ℕ → PrimalSpace B → ℝ :=
  fun k ↦ optimalCubicNewtonEstimatingFunction f x0 method.M method.step method.rho method.v k

/-- An optimal cubic Newton method can be used as its iterate sequence `x_k`. -/
instance :
    CoeFun (OptimalCubicNewtonMethod B Mf f x0 sigma) (fun _ ↦ ℕ → PrimalSpace B) where
  coe method := method.x

/-- The zeroth iterate is the prescribed initialization point `x₀`. -/
@[simp] theorem x_zero
    (method : OptimalCubicNewtonMethod B Mf f x0 sigma) :
    method.x 0 = x0 :=
  rfl

/-- The initial affine part vanishes, so `ψ₀(x) = (1 / 2) ‖x - x₀‖²`. -/
@[simp] theorem affinePart_zero
    (method : OptimalCubicNewtonMethod B Mf f x0 sigma) :
    method.affinePart 0 = 0 :=
  rfl

/-- The initial accumulated weight is `A₀ = 0`. -/
@[simp] theorem A_zero
    (method : OptimalCubicNewtonMethod B Mf f x0 sigma) :
    method.A 0 = 0 :=
  rfl

/-- Each `v_k` globally minimizes the estimating function `ψ_k`. -/
theorem v_isMin
    (method : OptimalCubicNewtonMethod B Mf f x0 sigma) (k : ℕ) :
    IsMinOn (method.psi k) Set.univ (method.v k) := by
  simpa [psi, M] using method.v_isMinOn k

/-- Each update weight `a_{k+1}` is positive. -/
theorem a_pos
    (method : OptimalCubicNewtonMethod B Mf f x0 sigma) (k : ℕ) :
    0 < method.a (k + 1) := by
  simpa [a] using method.nextWeight_pos k (method.A k)

/-- The accumulated weights satisfy `A_{k+1} = A_k + a_{k+1}`. -/
@[simp] theorem A_succ
    (method : OptimalCubicNewtonMethod B Mf f x0 sigma) (k : ℕ) :
    method.A (k + 1) = method.A k + method.a (k + 1) := by
  simp [A, a, state, nextWeight]

/-- The accumulated weights are nonnegative. -/
theorem A_nonneg
    (method : OptimalCubicNewtonMethod B Mf f x0 sigma) :
    ∀ k : ℕ, 0 ≤ method.A k
  | 0 => by simp [A, state]
  | k + 1 => by
      rw [method.A_succ k]
      exact add_nonneg (method.A_nonneg k) (method.a_pos k).le

/-- The scalar update satisfies
`a_{k+1}² = 2 (A_k + a_{k+1}) / (M ρ_k)` with `M = M_f / σ`. -/
theorem a_succ_sq
    (method : OptimalCubicNewtonMethod B Mf f x0 sigma) (k : ℕ) :
    (method.a (k + 1)) ^ (2 : ℕ) =
      (2 : ℝ) * (method.A k + method.a (k + 1)) / (method.M * method.rho k) := by
  simpa [a] using method.nextWeight_sq k (method.A_nonneg k)

/-- The interpolation point is `y_k = (1 - τ_k) x_k + τ_k v_k` with
`τ_k = a_{k+1} / A_{k+1}`. -/
@[simp] theorem y_eq
    (method : OptimalCubicNewtonMethod B Mf f x0 sigma) (k : ℕ) :
    method.y k =
      (1 - method.a (k + 1) / method.A (k + 1)) • method.x k +
        (method.a (k + 1) / method.A (k + 1)) • method.v k :=
  rfl

/-- Each next iterate is the cubic Newton step `x_{k+1} = T_M(y_k)`. -/
@[simp] theorem x_succ
    (method : OptimalCubicNewtonMethod B Mf f x0 sigma) (k : ℕ) :
    method.x (k + 1) = method.step (method.y k) := by
  simp [x, y, a, A, state, nextWeight, nextWeightValue]

/-- The affine parts satisfy the affine-gradient recursion from the algorithm. -/
@[simp] theorem affinePart_succ
    (method : OptimalCubicNewtonMethod B Mf f x0 sigma) (k : ℕ) :
    method.affinePart (k + 1) =
      method.affinePart k +
        method.a (k + 1) •
          sampledAffineMinorant
            (method.x (k + 1))
            (∇ f (method.x (k + 1)))
            (f (method.x (k + 1))) := by
  simp [x, a, A, affinePart, state, nextWeight, nextWeightValue]

/-- Helper for Algorithm 4.3.1: the estimating function `ψ_k` is the quadratic regularization of
its affine part at the initial point `x₀`. -/
@[simp] theorem psi_eq_primalQuadraticallyRegularizedObjective
    (method : OptimalCubicNewtonMethod B Mf f x0 sigma) (k : ℕ) :
    method.psi k =
      primalQuadraticallyRegularizedObjective (method.affinePart k) x0 := by
  -- The recursive owner stores `ψ_k` exactly as the quadratic regularization of `ℓ_k`.
  rfl

/-- Evaluating `method.psi k` recovers the affine part plus the fixed quadratic term
`(1 / 2) ‖z - x₀‖²` in the `B`-induced norm. -/
@[simp] theorem psi_apply
    (method : OptimalCubicNewtonMethod B Mf f x0 sigma) (k : ℕ) (z : PrimalSpace B) :
    method.psi k z = method.affinePart k z + (1 / 2 : ℝ) * ‖z - x0‖[B] ^ (2 : ℕ) :=
  by
    -- Rewrite `ψ_k` directly through the recursive owner to avoid extra coercion search.
    change
      primalQuadraticallyRegularizedObjective
        ((state f x0 method.M method.step method.rho method.v k).affinePart)
        x0
        z =
      ((state f x0 method.M method.step method.rho method.v k).affinePart) z +
        (1 / 2 : ℝ) * ‖z - x0‖[B] ^ (2 : ℕ)
    exact primalQuadraticallyRegularizedObjective_apply
      ((state f x0 method.M method.step method.rho method.v k).affinePart)
      x0
      z

/-- The initial estimating function is `ψ₀(x) = (1 / 2) ‖x - x₀‖²` in the norm induced by `B`.
-/
theorem psi_zero
    (method : OptimalCubicNewtonMethod B Mf f x0 sigma) :
    method.psi 0 = fun z ↦ (1 / 2 : ℝ) * ‖z - x0‖[B] ^ (2 : ℕ) := by
  funext z
  rw [method.psi_apply, method.affinePart_zero]
  change (0 : ℝ) + (1 / 2 : ℝ) * ‖z - x0‖[B] ^ (2 : ℕ) =
    (1 / 2 : ℝ) * ‖z - x0‖[B] ^ (2 : ℕ)
  exact zero_add _

/-- Each `v_k` globally minimizes the estimating function `ψ_k`. -/
theorem psi_isMin
    (method : OptimalCubicNewtonMethod B Mf f x0 sigma) (k : ℕ) :
    IsMinOn (method.psi k) Set.univ (method.v k) := by
  exact method.v_isMin k

/-- The estimating functions satisfy the affine-gradient recursion from the algorithm. -/
theorem psi_succ
    (method : OptimalCubicNewtonMethod B Mf f x0 sigma) (k : ℕ) :
    method.psi (k + 1) = fun z ↦
      method.psi k z +
        method.a (k + 1) *
          (f (method (k + 1)) + inner ℝ (∇ f (method (k + 1))) (z - method (k + 1))) := by
  funext z
  rw [psi_apply, psi_apply, method.affinePart_succ k]
  simp only [AffineMap.coe_add, AffineMap.coe_smul, Pi.add_apply, Pi.smul_apply,
    sampledAffineMinorant_apply, smul_eq_mul]
  ring

end OptimalCubicNewtonMethod

end
