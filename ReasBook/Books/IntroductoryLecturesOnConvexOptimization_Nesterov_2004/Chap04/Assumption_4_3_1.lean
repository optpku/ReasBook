import IntroductoryLecturesOnConvexOptimization_Nesterov_2004.Compat
import IntroductoryLecturesOnConvexOptimization_Nesterov_2004.Chap01.Definition_1_4_16

-- Declarations for this item will be appended below by the statement pipeline.

open scoped Gradient

noncomputable section

universe u

variable {E : Type u} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]

/- Assumption 4.3.1 lies in the second-order oracle / affine-span lower-complexity domain.

Sampled owner-style declarations:
* `hessian f x` in `Chap01/Definition_1_4_16`, the chapter's canonical second-order owner;
* the second-order oracle reply in `Chap01/Definition_1_2_9`, whose genuine higher-order data are
  guarded by `HasGradientAt` and `HasFDerivAt (∇ f)`;
* `SatisfiesSpanCondition` in `Chap02/Definition_2_9`, which keeps the span restriction itself
  binder-first rather than as an implication out of a regularity hypothesis;
* `AffineSubspace.mk'` and `AffineSubspace.mem_mk'` in mathlib, the canonical affine-span owner
  and its vector-form bridge.

Layer triage:
* source-facing: the second-order oracle-direction set `secondOrderOracleDirections f x`, the
  affine search space `secondOrderOracleSpanSearchSpace f testPoints k`, and the sequence
  predicate `IsSecondOrderSpanSequence f testPoints`;
* core/canonical: the pointwise oracle-data owner `HasSecondOrderOracleAt f x`, the Hessian owner
  `hessian f x`, and the affine-span owner `AffineSubspace.mk' (testPoints 0) V`;
* bridge/view: the companion vector-form restatement from `AffineSubspace.mem_mk'`.

Primitive data:
* the objective `f`;
* the query point `x`;
* the iterate sequence `testPoints`.

Derived API:
* the pointwise predicate saying the displayed gradient and Hessian at `x` are genuine second-order
  oracle data for `f`;
* the oracle-direction set at `x`, defined as the textbook closure of the convex hull of the
  solution vectors `d` to `[α I + (1 - α) ∇²f(x)] d = ∇f(x)`;
* the oracle-along-sequence predicate `HasSecondOrderOracleSequence f testPoints`;
* the affine search space generated by the earlier oracle-direction sets;
* the affine-subspace and vector-form span conditions on an oracle sequence.

The refinement keeps the source-facing oracle-direction owner at the textbook level and moves the
genuine second-order-oracle requirement to the sequence layer, in the same spirit that Chapter 2
keeps smoothness as an explicit hypothesis of the span-condition owner. This removes the earlier
off-domain reading `𝒢[f; x] = ∅` while preserving the intended `C²` semantics of Assumption 4.3.1.
-/

/-- The displayed gradient and Hessian at `x` are genuine first- and second-order oracle data for
`f`. -/
abbrev HasSecondOrderOracleAt (f : E → ℝ) (x : E) : Prop :=
  HasGradientAt f (∇ f x) x ∧ HasFDerivAt (∇ f) (hessian f x) x

/-- The textbook second-order oracle directions at `x`: the closure of the convex hull of the
solutions to `[α I + (1 - α) ∇² f(x)] d = ∇ f(x)` for `α ∈ [0,1]`. -/
def secondOrderOracleDirections
    (f : E → ℝ) (x : E) : Set E :=
  closure (convexHull ℝ (⋃ α : Set.Icc (0 : ℝ) 1, {
    u | (((α : ℝ) • ContinuousLinearMap.id ℝ E + (1 - (α : ℝ)) • hessian f x) u = ∇ f x)
  }))

/- Source-facing Lean notation for the textbook second-order oracle-direction set `𝒢_f(x)`. -/
namespace SecondOrderOracleDirections

scoped notation:max "𝒢[" f ";" x "]" => secondOrderOracleDirections f x

end SecondOrderOracleDirections

open scoped SecondOrderOracleDirections

/-- Membership in `𝒢[f; x]` is the textbook closure-convex-hull resolvent condition. -/
@[simp] theorem mem_secondOrderOracleDirections
    (f : E → ℝ) (x d : E) :
    d ∈ 𝒢[f; x] ↔
      d ∈ closure (convexHull ℝ (⋃ α : Set.Icc (0 : ℝ) 1, {
        u | (((α : ℝ) • ContinuousLinearMap.id ℝ E + (1 - (α : ℝ)) • hessian f x) u = ∇ f x)
      })) :=
  Iff.rfl

/-- A sequence of test points has genuine second-order oracle data when each query point carries
the displayed gradient and Hessian of `f`. -/
abbrev HasSecondOrderOracleSequence
    (f : E → ℝ) (testPoints : ℕ → E) : Prop :=
  ∀ k : ℕ, HasSecondOrderOracleAt f (testPoints k)

/-- The affine search space generated from the initial point `testPoints 0` and the earlier
second-order oracle directions `𝒢[f; testPoints 0], …, 𝒢[f; testPoints (k - 1)]`. -/
def secondOrderOracleSpanSearchSpace
    (f : E → ℝ) (testPoints : ℕ → E) (k : ℕ) :
    AffineSubspace ℝ E :=
  AffineSubspace.mk' (testPoints 0)
    (Submodule.span ℝ (⋃ i : Fin k, 𝒢[f; testPoints i]))

/-- Assumption 4.3.1: a sequence of test points generated by an iterative second-order scheme
satisfies `x_k ∈ x₀ + Lin{𝒢_f(x₀), …, 𝒢_f(x_{k-1})}` for every `k ≥ 0`, where the case `k = 0`
is tautological and the usual textbook form is recovered by replacing `k` with `k + 1`. The set
`𝒢_f(x)` is the textbook second-order oracle-direction set at `x`, and the sequence is required
to query points where the displayed gradient and Hessian are genuine second-order oracle data; on
a `C²` objective this is exactly the textbook affine-span restriction. -/
def IsSecondOrderSpanSequence
    (f : E → ℝ) (testPoints : ℕ → E) : Prop :=
  HasSecondOrderOracleSequence f testPoints ∧
    ∀ k : ℕ, testPoints k ∈ secondOrderOracleSpanSearchSpace f testPoints k

namespace IsSecondOrderSpanSequence

variable {f : E → ℝ} {testPoints : ℕ → E}

/-- A second-order span sequence queries only points with genuine second-order oracle data. -/
theorem oracle_at
    (hSequence : IsSecondOrderSpanSequence f testPoints) (k : ℕ) :
    HasSecondOrderOracleAt f (testPoints k) :=
  hSequence.1 k

/-- A second-order span sequence keeps every iterate in the corresponding affine search space. -/
theorem span_condition
    (hSequence : IsSecondOrderSpanSequence f testPoints) (k : ℕ) :
    testPoints k ∈ secondOrderOracleSpanSearchSpace f testPoints k :=
  hSequence.2 k

/-- A second-order span sequence keeps every iterate in the affine search space generated by the
earlier second-order oracle directions. -/
theorem sub_mem_span
    (hSequence : IsSecondOrderSpanSequence f testPoints) (k : ℕ) :
    testPoints k - testPoints 0 ∈
      Submodule.span ℝ (⋃ i : Fin k, 𝒢[f; testPoints i]) := by
  simpa [secondOrderOracleSpanSearchSpace, AffineSubspace.mem_mk'] using
    hSequence.span_condition k

end IsSecondOrderSpanSequence

/-- The affine-subspace formulation of Assumption 4.3.1 is equivalent to the corresponding
vector-form span condition. -/
theorem isSecondOrderSpanSequence_iff
    (f : E → ℝ) (testPoints : ℕ → E) :
    IsSecondOrderSpanSequence f testPoints ↔
      HasSecondOrderOracleSequence f testPoints ∧
        ∀ k : ℕ,
          testPoints k - testPoints 0 ∈
            Submodule.span ℝ (⋃ i : Fin k, 𝒢[f; testPoints i]) := by
  simp [IsSecondOrderSpanSequence, secondOrderOracleSpanSearchSpace, AffineSubspace.mem_mk']
