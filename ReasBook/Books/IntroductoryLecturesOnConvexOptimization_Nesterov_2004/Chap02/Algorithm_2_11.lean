import IntroductoryLecturesOnConvexOptimization_Nesterov_2004.Chap02.Algorithm_2_10
import IntroductoryLecturesOnConvexOptimization_Nesterov_2004.Chap02.Definition_2_48
import IntroductoryLecturesOnConvexOptimization_Nesterov_2004.Chap02.Definition_2_47

-- Declarations for this item will be appended below by the statement pipeline.

noncomputable section

open scoped SmoothFunctionalConstraintsMinimizationProblem.ConstrainedStep

universe u

variable {E : Type u} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]
variable [FiniteDimensional ℝ E]
variable {m : ℕ} {μ L : ℝ}

section

variable (problem : SmoothFunctionalConstraintsMinimizationProblem E m μ L)

local notation "parametricProblem" => problem.toParametricSmoothMinimaxProblem
local notation "modelValue" => problem.regularizedModelValue

/-
Primary domain: Chapter 2 constrained minimization on finite-dimensional real inner-product
spaces, with each internal trajectory generated by the chapter's optimal minimax method and each
outer exact step taken by the canonical regularized max-type owner.

Owner declarations sampled before refining:
* `SmoothFunctionalConstraintsMinimizationProblem` in `Definition_2_44.lean`, which owns the
  ambient set `Q`, objective `f₀`, and constraint family `fᵢ`;
* `SmoothFunctionalConstraintsMinimizationProblem.toParametricSmoothMinimaxProblem` and
  `SmoothFunctionalConstraintsMinimizationProblem.regularizedModelValue` in
  `Definition_2_47.lean`, the fixed-`t` bridge to the canonical smooth minimax owner together
  with its regularized model value;
* `optimalMinimaxMethod` and `optimalMinimaxMethodX` in `Algorithm_2_10.lean`, the recursive
  source-facing internal trajectory used at each outer stage;
* `SmoothFunctionalConstraintsMinimizationProblem.constrainedGradientMapping` and
  `.constrainedGradientMapping_isMinOn` in `Definition_2_47.lean`, the source-facing constrained
  exact step `x_f(t; xBar; L)` and its owner minimizer theorem for the fixed-`t` regularized
  affine model;
* `problem.regularizedModelValueRoot` in `Definition_2_48.lean`, the owner textbook parameter
  update `t^*(xBar, t)`.

Layer triage:
* `source-facing`: `ConstrainedMinimizationMethod`, i.e. Algorithm 2.11 with the textbook
  recursively generated outer state `(x_k, t_k)`, the first stopping index `j(k)` for Step
  `1(a)`, the minimizing prefix index `j*(k)`, and the exact outer update
  `x_{k+1} = x_f(t_k; x_{k,j*(k)}; L)`;
* `core/canonical`: the fixed-`t` bridge problem `problem.toParametricSmoothMinimaxProblem t`,
  its recursive inner trajectory `optimalMinimaxMethod`, and the constrained exact-step owner
  `problem.constrainedGradientMapping`;
* `bridge/view`: the fixed-state constructions `internalIterateAt`, `step1aAt`, `stopIndexAt`,
  `bestIndexAt`, `stoppedInternalIterateAt`, `selectedInternalIterateAt`, `nextIterateAt`, and
  the later outer `ε`-stopping API.

Primitive data at the source-facing layer are therefore the positive regularization constant `L`
and the outer trajectory `(x_k, t_k)` generated by the textbook recursion, under the explicit
assumption that Step `1(a)` reaches some internal index at every ambient outer state. The
first-stop indices, minimizing prefix indices, and outer stopping index are then derived
canonically from that owner.
-/

/-- The `j`-th internal iterate generated at the fixed outer state `(xBar, t)`. -/
def internalIterateAt
    (xBar : problem.ambientSet) (t : ℝ) (hL : 0 < L) (j : ℕ) : problem.ambientSet :=
  optimalMinimaxMethodX (parametricProblem t) xBar hL j

/-- The Step `1(a)` stopping predicate at the fixed outer state `(xBar, t)`. -/
def step1aAt
    (κ : ℝ) (xBar : problem.ambientSet) (t : ℝ) (hL : 0 < L) (j : ℕ) : Prop :=
  modelValue t (internalIterateAt problem xBar t hL j : E) μ ≥
    (1 - κ) * modelValue t (internalIterateAt problem xBar t hL j : E) L

/-- The first internal index satisfying Step `1(a)` at the fixed outer state `(xBar, t)`. -/
noncomputable def stopIndexAt
    (κ : ℝ) (xBar : problem.ambientSet) (t : ℝ) (hL : 0 < L)
    (hExists : ∃ j, step1aAt problem κ xBar t hL j) : ℕ :=
  let _ : DecidablePred (step1aAt problem κ xBar t hL) := Classical.decPred _
  Nat.find hExists

/-- The derived stopping index is first with respect to Step `1(a)`. -/
theorem stopIndexAt_isLeast
    (κ : ℝ) (xBar : problem.ambientSet) (t : ℝ) (hL : 0 < L)
    (hExists : ∃ j, step1aAt problem κ xBar t hL j) :
    IsLeast
      {j : ℕ | step1aAt problem κ xBar t hL j}
      (stopIndexAt problem κ xBar t hL hExists) := by
  classical
  simpa [stopIndexAt] using Nat.isLeast_find hExists

/-- The canonical minimizing index on the produced prefix `0, ..., j(k)`. -/
noncomputable def bestIndexAt
    (κ : ℝ) (xBar : problem.ambientSet) (t : ℝ) (hL : 0 < L)
    (hExists : ∃ j, step1aAt problem κ xBar t hL j) : ℕ :=
  match
      (List.range (stopIndexAt problem κ xBar t hL hExists + 1)).argmin
        (fun j ↦ modelValue t (internalIterateAt problem xBar t hL j : E) L) with
  | some j => j
  | none => stopIndexAt problem κ xBar t hL hExists

/-- Helper for Algorithm 2.11: the chosen minimizing index is selected by the list-level
`argmin` on the produced internal prefix `0, ..., j(k)`. -/
theorem bestIndexAt_mem_argmin
    (κ : ℝ) (xBar : problem.ambientSet) (t : ℝ) (hL : 0 < L)
    (hExists : ∃ j, step1aAt problem κ xBar t hL j) :
    bestIndexAt problem κ xBar t hL hExists ∈
      (List.range (stopIndexAt problem κ xBar t hL hExists + 1)).argmin
        (fun j ↦ modelValue t (internalIterateAt problem xBar t hL j : E) L) := by
  classical
  have hzero : 0 ∈ List.range (stopIndexAt problem κ xBar t hL hExists + 1) := by
    simp
  -- Follow the source definition of `j*(k)` and split on the list `argmin`.
  unfold bestIndexAt
  cases harg :
      (List.range (stopIndexAt problem κ xBar t hL hExists + 1)).argmin
        (fun j ↦ modelValue t (internalIterateAt problem xBar t hL j : E) L) with
  | none =>
      exfalso
      -- The `none` branch would force the produced prefix to be empty, contradicting `0 ∈ ...`.
      have hempty :
          List.range (stopIndexAt problem κ xBar t hL hExists + 1) = [] :=
        (List.argmin_eq_none).mp harg
      have : False := by
        simp [hempty] at hzero
      exact this
  | some best =>
      simp

/-- Helper for Algorithm 2.11: the chosen minimizing index lies in the produced prefix
`0, ..., j(k)`. -/
theorem bestIndexAt_mem_prefix
    (κ : ℝ) (xBar : problem.ambientSet) (t : ℝ) (hL : 0 < L)
    (hExists : ∃ j, step1aAt problem κ xBar t hL j) :
    bestIndexAt problem κ xBar t hL hExists ∈
      List.range (stopIndexAt problem κ xBar t hL hExists + 1) := by
  -- Pass from the `argmin` witness to membership in the source prefix list.
  exact List.argmin_mem (bestIndexAt_mem_argmin problem κ xBar t hL hExists)

/-- The canonical minimizing index lies in the produced prefix. -/
-- Proof sketch: if `argmin` returns `none`, then the prefix list is empty, which is impossible
-- because `List.range (stopIndexAt ... + 1)` contains `0`; if it returns `some best`, use
-- `List.argmin_mem` and membership in `List.range` to bound `best` by the stop index.
theorem bestIndexAt_le_stopIndexAt
    (κ : ℝ) (xBar : problem.ambientSet) (t : ℝ) (hL : 0 < L)
    (hExists : ∃ j, step1aAt problem κ xBar t hL j) :
    bestIndexAt problem κ xBar t hL hExists ≤ stopIndexAt problem κ xBar t hL hExists := by
  -- Convert prefix membership into the textbook inequality `j*(k) ≤ j(k)`.
  have hmem :
      bestIndexAt problem κ xBar t hL hExists ∈
        List.range (stopIndexAt problem κ xBar t hL hExists + 1) :=
    bestIndexAt_mem_prefix problem κ xBar t hL hExists
  exact Nat.lt_succ_iff.mp (List.mem_range.mp hmem)

/-- The canonical minimizing index minimizes the `L`-model value on the produced prefix. -/
-- Proof sketch: the index `j` belongs to the prefix `List.range (stopIndexAt ... + 1)` by the
-- hypothesis `j ≤ stopIndexAt ...`; if `argmin` returns `some best`, `List.le_of_mem_argmin`
-- gives the desired comparison, while the `none` branch is excluded because the prefix is
-- nonempty.
theorem bestIndexAt_is_argmin
    (κ : ℝ) (xBar : problem.ambientSet) (t : ℝ) (hL : 0 < L)
    (hExists : ∃ j, step1aAt problem κ xBar t hL j)
    (j : ℕ) (hj : j ≤ stopIndexAt problem κ xBar t hL hExists) :
    modelValue t
        (internalIterateAt problem xBar t hL
          (bestIndexAt problem κ xBar t hL hExists) : E)
        L ≤
      modelValue t (internalIterateAt problem xBar t hL j : E) L := by
  have hjmem :
      j ∈ List.range (stopIndexAt problem κ xBar t hL hExists + 1) := by
    -- Any index bounded by `j(k)` belongs to the produced prefix.
    exact List.mem_range.mpr (Nat.lt_succ_iff.mpr hj)
  have hbest :
      bestIndexAt problem κ xBar t hL hExists ∈
        (List.range (stopIndexAt problem κ xBar t hL hExists + 1)).argmin
          (fun i ↦ modelValue t (internalIterateAt problem xBar t hL i : E) L) :=
    bestIndexAt_mem_argmin problem κ xBar t hL hExists
  -- Compare the chosen prefix minimizer against any competing prefix index.
  exact
    List.le_of_mem_argmin
      (f := fun i ↦ modelValue t (internalIterateAt problem xBar t hL i : E) L)
      (l := List.range (stopIndexAt problem κ xBar t hL hExists + 1))
      hjmem
      hbest

/-- The stopped internal iterate `x_{j(xBar,t)}` at the fixed outer state `(xBar, t)`. -/
def stoppedInternalIterateAt
    (κ : ℝ) (xBar : problem.ambientSet) (t : ℝ) (hL : 0 < L)
    (hExists : ∃ j, step1aAt problem κ xBar t hL j) : problem.ambientSet :=
  internalIterateAt problem xBar t hL (stopIndexAt problem κ xBar t hL hExists)

/-- The minimizing internal iterate `x_{j*(xBar,t)}` on the produced prefix. -/
def selectedInternalIterateAt
    (κ : ℝ) (xBar : problem.ambientSet) (t : ℝ) (hL : 0 < L)
    (hExists : ∃ j, step1aAt problem κ xBar t hL j) : problem.ambientSet :=
  internalIterateAt problem xBar t hL (bestIndexAt problem κ xBar t hL hExists)

/-- Helper for Algorithm 2.11: positivity of `L` gives the nonzero `NNReal` coefficient needed
to package the exact-step parameter as a unit. -/
theorem regularizationParameter_ne_zero (hL : 0 < L) :
    Real.toNNReal L ≠ 0 := by
  have htoNNReal : 0 < Real.toNNReal L := by
    rwa [Real.toNNReal_pos]
  exact ne_of_gt htoNNReal

/-- The exact outer step `x_f(t; xBar; L)` centered at the selected internal iterate. -/
noncomputable def nextIterateAt
    (κ : ℝ) (xBar : problem.ambientSet) (t : ℝ) (hL : 0 < L)
    (hExists : ∃ j, step1aAt problem κ xBar t hL j) : problem.ambientSet :=
  let γ : NNRealˣ := Units.mk0 (Real.toNNReal L) (regularizationParameter_ne_zero hL)
  ⟨x_f[problem; t; γ]((selectedInternalIterateAt problem κ xBar t hL hExists : E)),
    problem.constrainedGradientMapping_mem
      t
      (selectedInternalIterateAt problem κ xBar t hL hExists : E)
      γ⟩

/-- The exact outer step is the owner chosen constrained gradient-mapping point. -/
@[simp] theorem nextIterateAt_coe
    (κ : ℝ) (xBar : problem.ambientSet) (t : ℝ) (hL : 0 < L)
    (hExists : ∃ j, step1aAt problem κ xBar t hL j) :
    (nextIterateAt problem κ xBar t hL hExists : E) =
      let γ : NNRealˣ := Units.mk0 (Real.toNNReal L) (regularizationParameter_ne_zero hL)
      x_f[problem; t; γ]((selectedInternalIterateAt problem κ xBar t hL hExists : E)) :=
  rfl

/-- The exact outer step minimizes the owner upper model at the selected internal iterate. -/
-- Proof sketch: rewrite the outer step to the owner point
-- `x_f[problem; t; γ](selectedInternalIterateAt ...)` and invoke the fixed-`t` constrained
-- exact-step theorem `problem.constrainedGradientMapping_isMinOn`.
theorem nextIterateAt_isMinOn
    (κ : ℝ) (xBar : problem.ambientSet) (t : ℝ) (hL : 0 < L)
    (hExists : ∃ j, step1aAt problem κ xBar t hL j) :
    IsMinOn
      (quadraticallyRegularizedObjective
        ((parametricProblem t).affineApproximation
          (selectedInternalIterateAt problem κ xBar t hL hExists : E))
        L
        (selectedInternalIterateAt problem κ xBar t hL hExists : E))
      problem.ambientSet
      (nextIterateAt problem κ xBar t hL hExists : E) := by
  let γ : NNRealˣ := Units.mk0 (Real.toNNReal L) (regularizationParameter_ne_zero hL)
  -- Rewrite the source-facing outer step to the owner chosen constrained gradient mapping.
  rw [nextIterateAt_coe]
  -- The fixed-`t` owner theorem supplies the exact minimizing property.
  simpa [γ, Real.toNNReal_of_nonneg hL.le] using
    (problem.constrainedGradientMapping_isMinOn
      t
      (selectedInternalIterateAt problem κ xBar t hL hExists : E)
      γ)

/-- The one-step outer-state update of Algorithm 2.11 on pairs `(x_k, t_k)`. -/
noncomputable def constrainedMinimizationMethodStep
    (κ : ℝ) (hL : 0 < L)
    (hStep1a :
      ∀ xBar : problem.ambientSet, ∀ t : ℝ, ∃ j, step1aAt problem κ xBar t hL j) :
    problem.ambientSet × ℝ → problem.ambientSet × ℝ :=
  fun state ↦
    let xk := state.1
    let tk := state.2
    let hExists := hStep1a xk tk
    ( nextIterateAt problem κ xk tk hL hExists
    , problem.regularizedModelValueRoot
        (stoppedInternalIterateAt problem κ xk tk hL hExists : E)
        tk )

/-- Algorithm 2.11: the Chapter 2 constrained minimization method with the textbook outer
recursion
`x_{k+1} = x_f(t_k; x_{k,j*(k)}; L)` and
`t_{k+1} = t^*(x_{k,j(k)}, t_k)`. The source-facing owner is the recursive outer trajectory
itself, while Step `1(a)` existence is an explicit hypothesis rather than packaged data. -/
noncomputable def ConstrainedMinimizationMethod
    (κ t0 : ℝ) (x0 : problem.ambientSet) (hL : 0 < L)
    (hStep1a :
      ∀ xBar : problem.ambientSet, ∀ t : ℝ, ∃ j, step1aAt problem κ xBar t hL j) :
    ℕ → problem.ambientSet × ℝ
  | 0 => (x0, t0)
  | k + 1 =>
      constrainedMinimizationMethodStep
        problem
        κ
        hL
        hStep1a
        (ConstrainedMinimizationMethod κ t0 x0 hL hStep1a k)

namespace ConstrainedMinimizationMethod

variable (problem : SmoothFunctionalConstraintsMinimizationProblem E m μ L)
variable (κ t0 : ℝ) (x0 : problem.ambientSet) (hL : 0 < L)
variable
  (hStep1a : ∀ xBar : problem.ambientSet, ∀ t : ℝ, ∃ j, step1aAt problem κ xBar t hL j)
variable {ε : ℝ}

local notation "scheme" => ConstrainedMinimizationMethod problem κ t0 x0 hL hStep1a
/-- The outer iterate sequence `x₀, x₁, x₂, ...` of Algorithm 2.11. -/
def x (k : ℕ) : problem.ambientSet :=
  (scheme k).1

/-- The outer parameter sequence `t₀, t₁, t₂, ...` of Algorithm 2.11. -/
def t (k : ℕ) : ℝ :=
  (scheme k).2

local notation "xSeq" => x problem κ t0 x0 hL hStep1a

local notation "tSeq" => t problem κ t0 x0 hL hStep1a

/-- Step `1(a)` reaches some internal index at every generated outer state. -/
def step1aExists (k : ℕ) :
    ∃ j, step1aAt problem κ (xSeq k) (tSeq k) hL j :=
  hStep1a (xSeq k) (tSeq k)

local notation "stepExistsSeq" => step1aExists problem κ t0 x0 hL hStep1a

@[simp] theorem x_zero :
    xSeq 0 = x0 :=
  rfl

@[simp] theorem t_zero :
    tSeq 0 = t0 :=
  rfl

/-- The outer iterate update is the canonical constrained exact step centered at
`x_{k,j*(k)}`. -/
@[simp] theorem x_succ (k : ℕ) :
    xSeq (k + 1) = nextIterateAt problem κ (xSeq k) (tSeq k) hL (stepExistsSeq k) :=
  rfl

/-- The parameter update is the textbook root step
`t_{k+1} = t^*(x_{k,j(k)}, t_k)`. -/
@[simp] theorem t_succ (k : ℕ) :
    tSeq (k + 1) =
      problem.regularizedModelValueRoot
        (stoppedInternalIterateAt problem κ (xSeq k) (tSeq k) hL (stepExistsSeq k) : E)
        (tSeq k) :=
  rfl

/-- The `j`-th internal iterate at outer step `k`. -/
def internalIterate
    (k j : ℕ) : problem.ambientSet :=
  internalIterateAt problem (xSeq k) (tSeq k) hL j

local notation "internalSeq" => fun k j ↦ internalIterateAt problem (xSeq k) (tSeq k) hL j

/-- The Step `1(a)` stopping predicate at outer step `k` and internal index `j`. -/
def step1a
    (k j : ℕ) : Prop :=
  step1aAt problem κ (xSeq k) (tSeq k) hL j

local notation "stepPred" => fun k j ↦ step1aAt problem κ (xSeq k) (tSeq k) hL j

/-- The stopping index `j(k)` is the first internal index satisfying Step `1(a)`. -/
noncomputable def stopIndex
    (k : ℕ) : ℕ :=
  stopIndexAt problem κ (xSeq k) (tSeq k) hL (stepExistsSeq k)

local notation "stopSeq" => fun k ↦ stopIndexAt problem κ (xSeq k) (tSeq k) hL (stepExistsSeq k)

/-- The Step `1(a)` stopping index is first with respect to the owner local-model comparison. -/
theorem stopIndex_isLeast
    (k : ℕ) :
    IsLeast
      {j : ℕ | stepPred k j}
      (stopSeq k) := by
  simpa [step1a, stopIndex] using
    stopIndexAt_isLeast problem κ (xSeq k) (tSeq k) hL (stepExistsSeq k)

/-- The stopped internal iterate `x_{k,j(k)}`. -/
def stoppedInternalIterate
    (k : ℕ) : problem.ambientSet :=
  stoppedInternalIterateAt problem κ (xSeq k) (tSeq k) hL (stepExistsSeq k)

local notation "stoppedSeq" =>
  fun k ↦ stoppedInternalIterateAt problem κ (xSeq k) (tSeq k) hL (stepExistsSeq k)

/-- The minimizing index `j*(k)` on the produced prefix `0, ..., j(k)`. -/
noncomputable def bestIndex
    (k : ℕ) : ℕ :=
  bestIndexAt problem κ (xSeq k) (tSeq k) hL (stepExistsSeq k)

local notation "bestSeq" => fun k ↦ bestIndexAt problem κ (xSeq k) (tSeq k) hL (stepExistsSeq k)

/-- The chosen minimizing index lies in the produced prefix. -/
theorem bestIndex_le_stopIndex
    (k : ℕ) :
    bestSeq k ≤ stopSeq k := by
  simpa [bestIndex, stopIndex] using
    bestIndexAt_le_stopIndexAt problem κ (xSeq k) (tSeq k) hL (stepExistsSeq k)

/-- The chosen index `j*(k)` minimizes `f^*(t_k; x_{k,j}; L)` on the produced prefix. -/
theorem bestIndex_is_argmin
    (k j : ℕ) (hj : j ≤ stopSeq k) :
    problem.regularizedModelValue (tSeq k)
        (internalSeq k (bestSeq k) : E)
        L ≤
      problem.regularizedModelValue (tSeq k)
        (internalSeq k j : E)
        L := by
  simpa [internalIterate, bestIndex, stopIndex] using
    bestIndexAt_is_argmin problem κ (xSeq k) (tSeq k) hL (stepExistsSeq k) j hj

/-- The selected internal iterate `x_{k,j*(k)}`. -/
def selectedInternalIterate
    (k : ℕ) : problem.ambientSet :=
  selectedInternalIterateAt problem κ (xSeq k) (tSeq k) hL (stepExistsSeq k)

local notation "selectedSeq" =>
  fun k ↦ selectedInternalIterateAt problem κ (xSeq k) (tSeq k) hL (stepExistsSeq k)

/-- The global `ε`-stopping predicate of Algorithm 2.11 at outer step `k`. -/
def globalStopCondition
    (ε : ℝ) (k : ℕ) : Prop :=
  problem.regularizedModelValue (tSeq k) (selectedSeq k : E) L ≤ ε

/-- The first outer index where the selected residual falls below the requested accuracy `ε`. -/
noncomputable def outerStopIndex
    (ε : ℝ)
    (hOuterStop :
      ∃ k, globalStopCondition problem κ t0 x0 hL hStep1a ε k) : ℕ :=
  let _ :
      DecidablePred (globalStopCondition problem κ t0 x0 hL hStep1a ε) := Classical.decPred _
  Nat.find hOuterStop

/-- The global stopping rule is first with respect to the selected `L`-model residual. -/
theorem outerStopIndex_isLeast
    (hOuterStop :
      ∃ k, globalStopCondition problem κ t0 x0 hL hStep1a ε k) :
    IsLeast
      {k : ℕ | globalStopCondition problem κ t0 x0 hL hStep1a ε k}
      (outerStopIndex problem κ t0 x0 hL hStep1a ε hOuterStop) := by
  classical
  simpa [outerStopIndex, globalStopCondition] using Nat.isLeast_find hOuterStop

/-- The internal trajectory at stage `k` starts from the current outer iterate `x_k`. -/
theorem internal_zero
    (k : ℕ) :
    internalSeq k 0 = xSeq k := by
  change
    optimalMinimaxMethodX (problem.toParametricSmoothMinimaxProblem (tSeq k)) (xSeq k) hL 0 =
      xSeq k
  exact
    optimalMinimaxMethodX_zero (problem.toParametricSmoothMinimaxProblem (tSeq k)) (xSeq k) hL

theorem stopping_condition
    (k : ℕ) :
    stepPred k (stopSeq k) := by
  exact (stopIndex_isLeast problem κ t0 x0 hL hStep1a k).1

theorem stopping_condition_min
    {k j : ℕ}
    (hj : j < stopSeq k) :
    ¬ stepPred k j := by
  intro hstep1a
  exact (not_le_of_gt hj) ((stopIndex_isLeast problem κ t0 x0 hL hStep1a k).2 hstep1a)

@[simp] theorem t_succ_eq_regularizedModelValueRoot
    (k : ℕ) :
    tSeq (k + 1) = problem.regularizedModelValueRoot (stoppedSeq k : E) (tSeq k) := by
  simpa [stoppedInternalIterate] using t_succ problem κ t0 x0 hL hStep1a k

theorem selected_residual_le_stopped_residual
    (k : ℕ) :
    problem.regularizedModelValue (tSeq k) (selectedSeq k : E) L ≤
      problem.regularizedModelValue (tSeq k) (stoppedSeq k : E) L := by
  simpa [selectedInternalIterate, stoppedInternalIterate] using
    bestIndex_is_argmin problem κ t0 x0 hL hStep1a k (stopSeq k) le_rfl

theorem x_succ_isMinOn_upperModel
    (k : ℕ) :
    IsMinOn
      (quadraticallyRegularizedObjective
        ((problem.toParametricSmoothMinimaxProblem (tSeq k)).affineApproximation
          (selectedSeq k : E))
        L
        (selectedSeq k : E))
      problem.ambientSet
      (xSeq (k + 1) : E) := by
  rw [x_succ problem κ t0 x0 hL hStep1a k]
  simpa [selectedInternalIterate] using
    nextIterateAt_isMinOn problem κ (xSeq k) (tSeq k) hL (stepExistsSeq k)

theorem global_stop_condition
    (hOuterStop :
      ∃ k, globalStopCondition problem κ t0 x0 hL hStep1a ε k) :
    problem.regularizedModelValue
        (tSeq (outerStopIndex problem κ t0 x0 hL hStep1a ε hOuterStop))
        (selectedSeq (outerStopIndex problem κ t0 x0 hL hStep1a ε hOuterStop) : E)
        L ≤
      ε := by
  simpa [globalStopCondition] using
    (outerStopIndex_isLeast problem κ t0 x0 hL hStep1a hOuterStop).1

theorem global_stop_condition_min
    (hOuterStop :
      ∃ k, globalStopCondition problem κ t0 x0 hL hStep1a ε k)
    {k : ℕ}
    (hk :
      k < outerStopIndex problem κ t0 x0 hL hStep1a ε hOuterStop) :
    ¬ problem.regularizedModelValue
        (tSeq k)
        (selectedSeq k : E)
        L ≤
      ε := by
  intro hstop
  have hstop' :
      k ∈ {k : ℕ | globalStopCondition problem κ t0 x0 hL hStep1a ε k} := by
    simpa [globalStopCondition] using hstop
  exact (not_le_of_gt hk)
    ((outerStopIndex_isLeast problem κ t0 x0 hL hStep1a hOuterStop).2 hstop')

end ConstrainedMinimizationMethod

end
