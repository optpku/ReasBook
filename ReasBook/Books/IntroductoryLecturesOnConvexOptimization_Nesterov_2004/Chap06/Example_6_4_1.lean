import IntroductoryLecturesOnConvexOptimization_Nesterov_2004.Compat
import IntroductoryLecturesOnConvexOptimization_Nesterov_2004.Chap01.Definition_1_3_3
import IntroductoryLecturesOnConvexOptimization_Nesterov_2004.Chap02.Lemma_2_18
import IntroductoryLecturesOnConvexOptimization_Nesterov_2004.Chap03.Definition_3_1_5

-- Declarations for this item will be appended below by the statement pipeline.

noncomputable section

open scoped ConstrainedArgmin WithTopConvexAnalysis

namespace CoordinateMaxCounterexample

local notation "E" => EuclideanSpace ℝ (Fin 2)

/-- The unit-disk feasible set `Q = closedBall 0 1` from Example 6.4.1. -/
def feasibleSet : Set E :=
  Metric.closedBall (0 : E) (1 : ℝ)

/-- The nonsmooth objective `f(x) = max{x₁, x₂}` from Example 6.4.1. -/
def objective : E → ℝ :=
  maxTypeObjective (fun i : Fin 2 ↦ fun x : E ↦ x i)

/-- The first admissible coordinate subgradient `(1, 0)`. -/
def firstSubgradient : E :=
  EuclideanSpace.single (0 : Fin 2) (1 : ℝ)

/-- The second admissible coordinate subgradient `(0, 1)`. -/
def secondSubgradient : E :=
  EuclideanSpace.single (1 : Fin 2) (1 : ℝ)

/-- The optimizer `x_* = (-1 / √2, -1 / √2)` for the unit-disk example. -/
def optimizer : E :=
  -((1 : ℝ) / Real.sqrt 2) • (firstSubgradient + secondSubgradient)

/-- The first extreme point selected by the linearized subproblem. -/
def firstOraclePoint : E :=
  -firstSubgradient

/-- The second extreme point selected by the linearized subproblem. -/
def secondOraclePoint : E :=
  -secondSubgradient

/-- The convex hull generated by the initial point `x₀` and the two possible oracle vertices. -/
def oracleHull (x0 : E) : Set E :=
  convexHull ℝ ({x0, firstOraclePoint, secondOraclePoint} : Set E)

/-- Helper for Example 6.4.1: in two coordinates, the Euclidean norm square is the sum of the
coordinate squares. -/
theorem norm_sq_eq_two_coordinates (x : E) :
    ‖x‖ ^ (2 : ℕ) = x (0 : Fin 2) ^ (2 : ℕ) + x (1 : Fin 2) ^ (2 : ℕ) := by
  -- Expand the Euclidean-space norm into the explicit two-coordinate formula.
  simp [EuclideanSpace.real_norm_sq_eq, Fin.sum_univ_two]

/-- Helper for Example 6.4.1: the objective is exactly the maximum of the two coordinates. -/
theorem objective_eq_max_coordinates (x : E) :
    objective x = max (x (0 : Fin 2)) (x (1 : Fin 2)) := by
  -- Unfold the max-type owner once to recover the textbook coordinate formula.
  simpa [objective, Fin.sum_univ_two] using
    (maxTypeObjective_apply (fun i : Fin 2 ↦ fun y : E ↦ y i) x)

/-- Helper for Example 6.4.1: the optimizer has first coordinate `-1 / √2`. -/
theorem optimizer_apply_zero :
    optimizer (0 : Fin 2) = -((1 : ℝ) / Real.sqrt 2) := by
  -- Read off the first coordinate from the explicit vector formula for `optimizer`.
  simp [optimizer, firstSubgradient, secondSubgradient]

/-- Helper for Example 6.4.1: the optimizer has second coordinate `-1 / √2`. -/
theorem optimizer_apply_one :
    optimizer (1 : Fin 2) = -((1 : ℝ) / Real.sqrt 2) := by
  -- Read off the second coordinate from the explicit vector formula for `optimizer`.
  simp [optimizer, firstSubgradient, secondSubgradient]

/-- Helper for Example 6.4.1: the optimizer lies on the supporting line
`x₁ + x₂ = -√2`. -/
theorem optimizer_coordinate_sum :
    optimizer (0 : Fin 2) + optimizer (1 : Fin 2) = -Real.sqrt 2 := by
  -- Substitute the two optimizer coordinates and simplify the resulting scalar identity.
  rw [optimizer_apply_zero, optimizer_apply_one]
  have hsqrt_ne : Real.sqrt 2 ≠ 0 := by positivity
  field_simp [hsqrt_ne]
  nlinarith [Real.sq_sqrt (show (0 : ℝ) ≤ 2 by norm_num)]

/-- Helper for Example 6.4.1: pairing with `(1, 0)` extracts the first coordinate. -/
theorem inner_firstSubgradient (x : E) :
    inner ℝ firstSubgradient x = x (0 : Fin 2) := by
  -- Specialize the Euclidean basis-vector inner-product formula to the first coordinate.
  simpa [firstSubgradient] using
    (EuclideanSpace.inner_single_left (𝕜 := ℝ) (ι := Fin 2) (0 : Fin 2) (1 : ℝ) x)

/-- Helper for Example 6.4.1: pairing with `(0, 1)` extracts the second coordinate. -/
theorem inner_secondSubgradient (x : E) :
    inner ℝ secondSubgradient x = x (1 : Fin 2) := by
  -- Specialize the Euclidean basis-vector inner-product formula to the second coordinate.
  simpa [secondSubgradient] using
    (EuclideanSpace.inner_single_left (𝕜 := ℝ) (ι := Fin 2) (1 : Fin 2) (1 : ℝ) x)

/-- Helper for Example 6.4.1: every feasible point has coordinate sum at least `-√2`. -/
theorem coordinate_sum_ge_neg_sqrt_two
    {x : E} (hx : x ∈ feasibleSet) :
    -Real.sqrt 2 ≤ x (0 : Fin 2) + x (1 : Fin 2) := by
  -- Convert disk membership into the quadratic bound on the two coordinates.
  rw [feasibleSet, mem_closedBall_zero_iff] at hx
  have hnorm_sq : ‖x‖ ^ (2 : ℕ) ≤ 1 := by
    nlinarith [hx, norm_nonneg x]
  have hcoords : x (0 : Fin 2) ^ (2 : ℕ) + x (1 : Fin 2) ^ (2 : ℕ) ≤ 1 := by
    simpa [norm_sq_eq_two_coordinates] using hnorm_sq
  -- Then apply the two-variable Cauchy estimate `(x₁ + x₂)^2 ≤ 2`.
  have hsum_sq : (x (0 : Fin 2) + x (1 : Fin 2)) ^ (2 : ℕ) ≤ 2 := by
    nlinarith [hcoords, sq_nonneg (x (0 : Fin 2) - x (1 : Fin 2))]
  have hsqrt_sq : Real.sqrt 2 ^ (2 : ℕ) = 2 := by
    nlinarith [Real.sq_sqrt (show (0 : ℝ) ≤ 2 by norm_num)]
  have hsqrt_nonneg : 0 ≤ Real.sqrt 2 := Real.sqrt_nonneg 2
  nlinarith

/-- Helper for Example 6.4.1: on the unit disk, the support line
`x₁ + x₂ = -√2` meets the feasible set only at the optimizer. -/
theorem coordinate_sum_eq_neg_sqrt_two_iff_optimizer
    {x : E} (hx : x ∈ feasibleSet) :
    x (0 : Fin 2) + x (1 : Fin 2) = -Real.sqrt 2 ↔ x = optimizer := by
  constructor
  · intro hsum
    -- Equality on the support line forces equality in the Cauchy estimate, hence equal coordinates.
    rw [feasibleSet, mem_closedBall_zero_iff] at hx
    have hnorm_sq : ‖x‖ ^ (2 : ℕ) ≤ 1 := by
      nlinarith [hx, norm_nonneg x]
    have hcoords : x (0 : Fin 2) ^ (2 : ℕ) + x (1 : Fin 2) ^ (2 : ℕ) ≤ 1 := by
      simpa [norm_sq_eq_two_coordinates] using hnorm_sq
    have hsqrt_sq : Real.sqrt 2 ^ (2 : ℕ) = 2 := by
      nlinarith [Real.sq_sqrt (show (0 : ℝ) ≤ 2 by norm_num)]
    have hsum_sq_eq : (x (0 : Fin 2) + x (1 : Fin 2)) ^ (2 : ℕ) = 2 := by
      calc
        (x (0 : Fin 2) + x (1 : Fin 2)) ^ (2 : ℕ) = (-Real.sqrt 2) ^ (2 : ℕ) := by
          rw [hsum]
        _ = 2 := by
          simp only [neg_sq]
          exact hsqrt_sq
    have hdiff_sq : (x (0 : Fin 2) - x (1 : Fin 2)) ^ (2 : ℕ) = 0 := by
      nlinarith [hcoords, hsum_sq_eq, sq_nonneg (x (0 : Fin 2) - x (1 : Fin 2))]
    have hcoords_eq : x (0 : Fin 2) = x (1 : Fin 2) := by
      nlinarith [hdiff_sq]
    -- Once the coordinates coincide, the support-line equation fixes their common value.
    have hsqrt_pos : 0 < Real.sqrt 2 := Real.sqrt_pos.2 (by norm_num)
    have hzero_mul : x (0 : Fin 2) * Real.sqrt 2 = -1 := by
      nlinarith [hsum, hcoords_eq, hsqrt_sq]
    have hzero_div :
        x (0 : Fin 2) = ((-1 : ℝ) / Real.sqrt 2) := by
      apply (eq_div_iff hsqrt_pos.ne').2
      simpa [mul_comm] using hzero_mul
    have hzero :
        x (0 : Fin 2) = -((1 : ℝ) / Real.sqrt 2) := by
      simpa [div_eq_mul_inv] using hzero_div
    have hone :
        x (1 : Fin 2) = -((1 : ℝ) / Real.sqrt 2) := by
      simpa [hcoords_eq] using hzero
    ext i
    fin_cases i
    · simpa [optimizer_apply_zero] using hzero
    · simpa [optimizer_apply_one] using hone
  · rintro rfl
    -- The optimizer coordinates already satisfy the support-line equation exactly.
    exact optimizer_coordinate_sum

/-- Helper for Example 6.4.1: if `x₀` is feasible and distinct from the optimizer, then the whole
oracle hull stays strictly above the support line `x₁ + x₂ = -√2`. -/
theorem oracleHull_subset_strict_support_halfspace
    {x0 : E} (hx0_mem : x0 ∈ feasibleSet) (hx0_ne : x0 ≠ optimizer) :
    oracleHull x0 ⊆ {z : E | -Real.sqrt 2 < z (0 : Fin 2) + z (1 : Fin 2)} := by
  let coordSum : E →ₗ[ℝ] ℝ :=
    { toFun := fun z ↦ z (0 : Fin 2) + z (1 : Fin 2)
      map_add' := by
        intro x y
        simp [add_assoc, add_left_comm]
      map_smul' := by
        intro a z
        simp [mul_add] }
  have hconvex :
      Convex ℝ {z : E | -Real.sqrt 2 < z (0 : Fin 2) + z (1 : Fin 2)} := by
    -- The target region is a strict affine halfspace cut out by the linear coordinate-sum map.
    simpa [coordSum] using (convex_Ioi (-Real.sqrt 2)).linear_preimage coordSum
  have hx0_strict :
      -Real.sqrt 2 < x0 (0 : Fin 2) + x0 (1 : Fin 2) := by
    -- Feasibility gives the lower bound, and non-optimality rules out equality.
    have hle := coordinate_sum_ge_neg_sqrt_two hx0_mem
    have hne : x0 (0 : Fin 2) + x0 (1 : Fin 2) ≠ -Real.sqrt 2 := by
      intro hsum
      exact hx0_ne ((coordinate_sum_eq_neg_sqrt_two_iff_optimizer hx0_mem).mp hsum)
    exact lt_of_le_of_ne hle hne.symm
  have hfirst :
      firstOraclePoint ∈ {z : E | -Real.sqrt 2 < z (0 : Fin 2) + z (1 : Fin 2)} := by
    -- The first oracle vertex has coordinate sum `-1`, which lies strictly above `-√2`.
    simpa [firstOraclePoint, firstSubgradient] using
      (neg_lt_neg Real.one_lt_sqrt_two)
  have hsecond :
      secondOraclePoint ∈ {z : E | -Real.sqrt 2 < z (0 : Fin 2) + z (1 : Fin 2)} := by
    -- The second oracle vertex has the same coordinate sum `-1`.
    simpa [secondOraclePoint, secondSubgradient] using
      (neg_lt_neg Real.one_lt_sqrt_two)
  -- Convexity propagates the strict inequality from the three generators to their convex hull.
  rw [oracleHull]
  refine convexHull_min ?_ hconvex
  rw [Set.insert_subset_iff, Set.insert_subset_iff, Set.singleton_subset_iff]
  exact ⟨hx0_strict, hfirst, hsecond⟩

-- Proof sketch: minimize `max{x₁, x₂}` over the unit disk by symmetry; the minimum occurs when
-- the two coordinates agree and the norm constraint is active, which gives
-- `x_* = (-1 / √2, -1 / √2)`.
/-- The point `x_* = (-1 / √2, -1 / √2)` minimizes the counterexample objective
`f(x) = max{x₁, x₂}` on the closed unit disk `Q = closedBall 0 1`. -/
theorem optimizer_isMinOn :
    IsMinOn objective feasibleSet optimizer := by
  -- Rewrite minimization on the disk into the explicit two-coordinate inequality.
  rw [isMinOn_iff]
  intro x hx
  have hsum_lower := coordinate_sum_ge_neg_sqrt_two hx
  have hmax_ge_avg : (x (0 : Fin 2) + x (1 : Fin 2)) / 2 ≤ objective x := by
    -- The maximum of two numbers dominates their arithmetic mean.
    rw [objective_eq_max_coordinates]
    have h0 : x (0 : Fin 2) ≤ max (x (0 : Fin 2)) (x (1 : Fin 2)) :=
      le_max_left _ _
    have h1 : x (1 : Fin 2) ≤ max (x (0 : Fin 2)) (x (1 : Fin 2)) :=
      le_max_right _ _
    linarith
  have hsqrt_ne : Real.sqrt 2 ≠ 0 := by positivity
  have hopt_avg :
      objective optimizer = -(Real.sqrt 2 / 2) := by
    -- At the optimizer, both coordinates agree with `-1 / √2 = -√2 / 2`.
    rw [objective_eq_max_coordinates, optimizer_apply_zero, optimizer_apply_one]
    have hdiv : (1 : ℝ) / Real.sqrt 2 = Real.sqrt 2 / 2 := by
      field_simp [hsqrt_ne]
      nlinarith [Real.sq_sqrt (show (0 : ℝ) ≤ 2 by norm_num)]
    simp [hdiv]
  have havg_lower : -(Real.sqrt 2 / 2) ≤ (x (0 : Fin 2) + x (1 : Fin 2)) / 2 := by
    linarith
  linarith

/-- If the first coordinate is active at `x`, then `(1, 0)` is an admissible subgradient of
`x ↦ max{x₁, x₂}` at `x`. -/
theorem firstSubgradient_isSubgradientAt_of_coord1_le_coord0
    {x : E} (hx : x (1 : Fin 2) ≤ x (0 : Fin 2)) :
    IsSubgradientAt (fun y ↦ (objective y : WithTop ℝ)) x firstSubgradient := by
  -- Reduce the subgradient inequality to the active coordinate formula.
  rw [IsSubgradientAt.coe_real_iff]
  intro y
  rw [objective_eq_max_coordinates, objective_eq_max_coordinates, max_eq_left hx]
  have hinner : inner ℝ firstSubgradient (y - x) = y (0 : Fin 2) - x (0 : Fin 2) := by
    -- The vector `(1, 0)` extracts the first coordinate from the displacement.
    calc
      inner ℝ firstSubgradient (y - x) = (y - x) (0 : Fin 2) := by
        simpa using inner_firstSubgradient (y - x)
      _ = y (0 : Fin 2) - x (0 : Fin 2) := rfl
  rw [hinner]
  have hymax : y (0 : Fin 2) ≤ max (y (0 : Fin 2)) (y (1 : Fin 2)) := le_max_left _ _
  linarith

/-- If the second coordinate is active at `x`, then `(0, 1)` is an admissible subgradient of
`x ↦ max{x₁, x₂}` at `x`. -/
theorem secondSubgradient_isSubgradientAt_of_coord0_le_coord1
    {x : E} (hx : x (0 : Fin 2) ≤ x (1 : Fin 2)) :
    IsSubgradientAt (fun y ↦ (objective y : WithTop ℝ)) x secondSubgradient := by
  -- Reduce the subgradient inequality to the second active coordinate.
  rw [IsSubgradientAt.coe_real_iff]
  intro y
  rw [objective_eq_max_coordinates, objective_eq_max_coordinates, max_eq_right hx]
  have hinner : inner ℝ secondSubgradient (y - x) = y (1 : Fin 2) - x (1 : Fin 2) := by
    -- The vector `(0, 1)` extracts the second coordinate from the displacement.
    calc
      inner ℝ secondSubgradient (y - x) = (y - x) (1 : Fin 2) := by
        simpa using inner_secondSubgradient (y - x)
      _ = y (1 : Fin 2) - x (1 : Fin 2) := rfl
  rw [hinner]
  have hymax : y (1 : Fin 2) ≤ max (y (0 : Fin 2)) (y (1 : Fin 2)) := le_max_right _ _
  linarith

-- Proof sketch: minimizing `⟪(1, 0), x⟫ = x₁` on the unit disk forces `x = (-1, 0)`.
/-- The linearized unit-disk subproblem for the admissible subgradient `(1, 0)` is solved
exactly by `(-1, 0)`. -/
theorem eq_firstOraclePoint_of_mem_argmin_firstSubgradient
    {v : E}
    (hv : v ∈ argmin[feasibleSet] (fun y : E ↦ inner ℝ firstSubgradient y)) :
    v = firstOraclePoint := by
  rcases mem_constrainedArgmin_iff.mp hv with ⟨hv_mem, hv_min⟩
  rw [isMinOn_iff] at hv_min
  have hfirst_mem : firstOraclePoint ∈ feasibleSet := by
    -- The explicit vertex `(-1, 0)` lies on the unit circle.
    rw [feasibleSet, mem_closedBall_zero_iff]
    simp [firstOraclePoint, firstSubgradient]
  have hcoord0_le : v (0 : Fin 2) ≤ -1 := by
    -- Compare the minimizer against the feasible competitor `(-1, 0)`.
    have hmin := hv_min firstOraclePoint hfirst_mem
    rw [inner_firstSubgradient, inner_firstSubgradient] at hmin
    simpa [firstOraclePoint, firstSubgradient] using hmin
  rw [feasibleSet, mem_closedBall_zero_iff] at hv_mem
  have hnorm_sq : v (0 : Fin 2) ^ (2 : ℕ) + v (1 : Fin 2) ^ (2 : ℕ) ≤ 1 := by
    have : ‖v‖ ^ (2 : ℕ) ≤ 1 := by
      nlinarith [hv_mem, norm_nonneg v]
    simpa [norm_sq_eq_two_coordinates] using this
  have hcoord0_ge : -1 ≤ v (0 : Fin 2) := by
    nlinarith [hnorm_sq, sq_nonneg (v (1 : Fin 2))]
  have hcoord0 : v (0 : Fin 2) = -1 := by
    linarith
  have hcoord1_sq : v (1 : Fin 2) ^ (2 : ℕ) = 0 := by
    nlinarith [hnorm_sq, hcoord0, sq_nonneg (v (1 : Fin 2))]
  have hcoord1 : v (1 : Fin 2) = 0 := by
    nlinarith [hcoord1_sq]
  -- The two coordinates now match the explicit oracle point.
  ext i
  fin_cases i
  · simpa [firstOraclePoint, firstSubgradient] using hcoord0
  · simpa [firstOraclePoint, firstSubgradient] using hcoord1

-- Proof sketch: minimizing `⟪(0, 1), x⟫ = x₂` on the unit disk forces `x = (0, -1)`.
/-- The linearized unit-disk subproblem for the admissible subgradient `(0, 1)` is solved
exactly by `(0, -1)`. -/
theorem eq_secondOraclePoint_of_mem_argmin_secondSubgradient
    {v : E}
    (hv : v ∈ argmin[feasibleSet] (fun y : E ↦ inner ℝ secondSubgradient y)) :
    v = secondOraclePoint := by
  rcases mem_constrainedArgmin_iff.mp hv with ⟨hv_mem, hv_min⟩
  rw [isMinOn_iff] at hv_min
  have hsecond_mem : secondOraclePoint ∈ feasibleSet := by
    -- The explicit vertex `(0, -1)` also lies on the unit circle.
    rw [feasibleSet, mem_closedBall_zero_iff]
    simp [secondOraclePoint, secondSubgradient]
  have hcoord1_le : v (1 : Fin 2) ≤ -1 := by
    -- Compare the minimizer against the feasible competitor `(0, -1)`.
    have hmin := hv_min secondOraclePoint hsecond_mem
    rw [inner_secondSubgradient, inner_secondSubgradient] at hmin
    simpa [secondOraclePoint, secondSubgradient] using hmin
  rw [feasibleSet, mem_closedBall_zero_iff] at hv_mem
  have hnorm_sq : v (0 : Fin 2) ^ (2 : ℕ) + v (1 : Fin 2) ^ (2 : ℕ) ≤ 1 := by
    have : ‖v‖ ^ (2 : ℕ) ≤ 1 := by
      nlinarith [hv_mem, norm_nonneg v]
    simpa [norm_sq_eq_two_coordinates] using this
  have hcoord1_ge : -1 ≤ v (1 : Fin 2) := by
    nlinarith [hnorm_sq, sq_nonneg (v (0 : Fin 2))]
  have hcoord1 : v (1 : Fin 2) = -1 := by
    linarith
  have hcoord0_sq : v (0 : Fin 2) ^ (2 : ℕ) = 0 := by
    nlinarith [hnorm_sq, hcoord1, sq_nonneg (v (0 : Fin 2))]
  have hcoord0 : v (0 : Fin 2) = 0 := by
    nlinarith [hcoord0_sq]
  -- The two coordinates now match the second explicit oracle point.
  ext i
  fin_cases i
  · simpa [secondOraclePoint, secondSubgradient] using hcoord0
  · simpa [secondOraclePoint, secondSubgradient] using hcoord1

-- Proof sketch: write a point of `conv{x₀, y₁, y₂}` as a convex combination of
-- `x₀`, `(-1, 0)`, and `(0, -1)`. Using `x₀ ∈ Q` and `x₀ ≠ x_*`, the barycentric-coordinate
-- relations for `x_* = (-1 / √2, -1 / √2)` force a contradiction.
/-- If the initial point lies in the unit disk and is not the optimizer, then the triangle
`conv{x₀, y₁, y₂}` does not contain `x_*`. -/
theorem optimizer_not_mem_oracleHull
    {x0 : E} (hx0_mem : x0 ∈ feasibleSet) (hx0_ne : x0 ≠ optimizer) :
    optimizer ∉ oracleHull x0 := by
  -- Put the whole hull into the strict halfspace and note that the optimizer lies on the boundary.
  have hsubset := oracleHull_subset_strict_support_halfspace hx0_mem hx0_ne
  intro hoptimizer
  have hstrict : -Real.sqrt 2 < optimizer (0 : Fin 2) + optimizer (1 : Fin 2) :=
    hsubset hoptimizer
  rw [optimizer_coordinate_sum] at hstrict
  exact (lt_irrefl (-Real.sqrt 2)) hstrict

-- Proof sketch: first use the two exact oracle theorems
-- `eq_firstOraclePoint_of_mem_argmin_firstSubgradient` and
-- `eq_secondOraclePoint_of_mem_argmin_secondSubgradient` to identify each oracle point with one
-- of `y₁` or `y₂`. Then induct on `t`:
-- the base case is `x₀ ∈ conv{x₀,y₁,y₂}`, and the successor step follows from the
-- convex-combination update with `τ_t ∈ [0, 1]`.
/-- Example 6.4.1: for the unit disk `Q` and `f(x) = max{x₁, x₂}`, if a conditional-gradient
trajectory starts from `x₀`, and the oracle selects one of the admissible extreme
coordinate directions `(1, 0)` or `(0, 1)`, then every iterate stays in
`conv{x₀, (-1, 0), (0, -1)}`. -/
theorem conditionalGradient_iterates_mem_oracleHull
    {x0 : E}
    {τ : ℕ → ℝ} (hτ : ∀ t : ℕ, τ t ∈ Set.Icc (0 : ℝ) 1)
    {x : ℕ → E} (hx_zero : x 0 = x0)
    {g : ℕ → E}
    (hg :
      ∀ t : ℕ,
        IsSubgradientAt (fun y ↦ (objective y : WithTop ℝ)) (x t) (g t) ∧
          (g t = firstSubgradient ∨ g t = secondSubgradient))
    {v : ℕ → E} (hv : ∀ t : ℕ, v t ∈ argmin[feasibleSet] (fun y : E ↦ inner ℝ (g t) y))
    (hx_succ : ∀ t : ℕ, x (t + 1) = (1 - τ t) • x t + τ t • v t) :
    ∀ t : ℕ, x t ∈ oracleHull x0 := by
  intro t
  induction t with
  | zero =>
      -- The initial point is one of the generators of the oracle hull.
      simpa [hx_zero, oracleHull] using
        (subset_convexHull ℝ ({x0, firstOraclePoint, secondOraclePoint} : Set E) (by simp))
  | succ t ht =>
      have hfirst_hull : firstOraclePoint ∈ oracleHull x0 := by
        -- Each oracle vertex is itself a generator of the convex hull.
        simpa [oracleHull] using
          (subset_convexHull ℝ ({x0, firstOraclePoint, secondOraclePoint} : Set E) (by simp))
      have hsecond_hull : secondOraclePoint ∈ oracleHull x0 := by
        -- The second oracle vertex is another generator of the same hull.
        simpa [oracleHull] using
          (subset_convexHull ℝ ({x0, firstOraclePoint, secondOraclePoint} : Set E) (by simp))
      have hv_hull : v t ∈ oracleHull x0 := by
        -- The oracle selection is exactly one of the two explicit vertices.
        rcases (hg t).2 with hg_first | hg_second
        · have hv_eq := eq_firstOraclePoint_of_mem_argmin_firstSubgradient (by
            simpa [hg_first] using hv t)
          simpa [hv_eq] using hfirst_hull
        · have hv_eq := eq_secondOraclePoint_of_mem_argmin_secondSubgradient (by
            simpa [hg_second] using hv t)
          simpa [hv_eq] using hsecond_hull
      have hτ_nonneg : 0 ≤ τ t := (hτ t).1
      have hτ_le_one : τ t ≤ 1 := (hτ t).2
      have h_one_sub_nonneg : 0 ≤ 1 - τ t := sub_nonneg.mpr hτ_le_one
      -- The update is a convex combination of two points already known to lie in the hull.
      rw [hx_succ]
      simpa [oracleHull] using
        (convex_convexHull ℝ ({x0, firstOraclePoint, secondOraclePoint} : Set E))
          ht hv_hull h_one_sub_nonneg hτ_nonneg (by ring)

-- Proof sketch: apply
-- `conditionalGradient_iterates_mem_oracleHull` to place each iterate in `conv{x₀, y₁, y₂}`,
-- then use `optimizer_not_mem_oracleHull`.
/-- Every iterate of the counterexample conditional-gradient trajectory stays away from the
optimizer `x_*`. -/
theorem conditionalGradient_iterates_ne_optimizer
    {x0 : E} (hx0_mem : x0 ∈ feasibleSet) (hx0_ne : x0 ≠ optimizer)
    {τ : ℕ → ℝ} (hτ : ∀ t : ℕ, τ t ∈ Set.Icc (0 : ℝ) 1)
    {x : ℕ → E} (hx_zero : x 0 = x0)
    {g : ℕ → E}
    (hg :
      ∀ t : ℕ,
        IsSubgradientAt (fun y ↦ (objective y : WithTop ℝ)) (x t) (g t) ∧
          (g t = firstSubgradient ∨ g t = secondSubgradient))
    {v : ℕ → E} (hv : ∀ t : ℕ, v t ∈ argmin[feasibleSet] (fun y : E ↦ inner ℝ (g t) y))
    (hx_succ : ∀ t : ℕ, x (t + 1) = (1 - τ t) • x t + τ t • v t) :
    ∀ t : ℕ, x t ≠ optimizer := by
  intro t hxt
  -- The iterates live in the fixed oracle hull, but that hull excludes the optimizer.
  have hx_mem :
      x t ∈ oracleHull x0 :=
    conditionalGradient_iterates_mem_oracleHull hτ hx_zero hg hv hx_succ t
  exact optimizer_not_mem_oracleHull hx0_mem hx0_ne (hxt ▸ hx_mem)

end CoordinateMaxCounterexample
