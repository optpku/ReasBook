import IntroductoryLecturesOnConvexOptimization_Nesterov_2004.Compat
import IntroductoryLecturesOnConvexOptimization_Nesterov_2004.Chap07.Definition_7_9

-- Declarations for this item will be appended below by the statement pipeline.

noncomputable section

universe u

/- Algorithm 7.4 lies in the autonomous discrete-trajectory / first-stopping-index domain.

Sampled owner-style declarations:
- `Function.iterate` for the canonical trajectory generated by an explicit update map;
- `relativeScaleSubgradientApproximationIterate` and
  `relativeScaleSubgradientApproximationStoppingIndex` in `Algorithm_7_2.lean`, where the
  iterate sequence and first stopping index are derived canonically rather than stored in a
  wrapper;
- `aPrioriRadiusEstimate` in `Definition_7_9.lean`, the Chapter 7 owner for the scalar radius
  parameter used by the lower-level scheme.

Best owner abstraction:
- source-facing: Algorithm 7.4's restarting trajectory `\hat x_t` and the first stopping time
  for the acceptance test;
- core/canonical: the autonomous iterate map `schemeSNRestartingStep S f δ alphaF gamma0F`
  together with the least stopping index derived by `Nat.find`;
- bridge/view: the stopping time `T = s + 1` and the corresponding acceptance inequality.

Primitive data:
- the explicit restart block length and stopping factor;
- the one-step update map;
- the prescribed initial point;
- existence of a stage satisfying the stopping criterion.

Derived API:
- the iterate sequence `\hat x_t`;
- the stopping predicate and termination statement;
- the canonical first stopping index `s`;
- the stopping time `T = s + 1`.

The previous `SchemeSNRestartingStrategy` structure stored the iterate sequence, stopping index,
and minimality facts as primitive fields even though they are canonical once the update map and
termination witness are fixed. This file therefore follows the owner pattern already used in
`Algorithm_7_2.lean`: the public core is the explicit step map plus the canonical orbit and
first-hit index, while the textbook stopping-time statement is a thin bridge. Since the
source-facing owner is the textbook trajectory `\hat x_t`, this file also provides its own scoped
`x̂[...]` notation and uses it on the theorem surface. -/

section

variable {X : Type u}

/-- The textbook block length
`\tilde N = ⌊(2 e / α(F)) (1 + 1 / δ)⌋` used in Algorithm 7.4. -/
def schemeSNRestartingBlockLength (δ alphaF : ℝ) : ℕ :=
  Nat.floor ((((2 : ℝ) * Real.exp 1) / alphaF) * (1 + 1 / δ))

/-- Expanding `schemeSNRestartingBlockLength δ alphaF` recovers the textbook expression
`\tilde N = ⌊(2 e / α(F)) (1 + 1 / δ)⌋`. -/
theorem schemeSNRestartingBlockLength_def (δ alphaF : ℝ) :
    schemeSNRestartingBlockLength δ alphaF =
      Nat.floor ((((2 : ℝ) * Real.exp 1) / alphaF) * (1 + 1 / δ)) :=
  rfl

/-- The stopping factor `1 / e` used in Algorithm 7.4. -/
def schemeSNRestartingStoppingFactor : ℝ :=
  1 / Real.exp 1

/-- Expanding `schemeSNRestartingStoppingFactor` recovers the threshold `1 / e` from the stopping
test. -/
theorem schemeSNRestartingStoppingFactor_def :
    schemeSNRestartingStoppingFactor = 1 / Real.exp 1 :=
  rfl

/-- The single restart update
`x ↦ S_{\tilde N} ((1 / γ₀(F)) f(x))` used in Algorithm 7.4. -/
def schemeSNRestartingStep
    (S : ℕ → ℝ → X) (f : X → ℝ) (δ alphaF gamma0F : ℝ) : X → X :=
  fun x ↦
    S (schemeSNRestartingBlockLength δ alphaF) (aPrioriRadiusEstimate f gamma0F x)

/-- Evaluating `schemeSNRestartingStep` at `x` applies `S_{\tilde N}` to
the a priori radius estimate `aPrioriRadiusEstimate f gamma0F x = (1 / γ₀(F)) f(x)` with
`\tilde N = schemeSNRestartingBlockLength δ alphaF`. -/
theorem schemeSNRestartingStep_apply
    (S : ℕ → ℝ → X) (f : X → ℝ) (δ alphaF gamma0F : ℝ) (x : X) :
    schemeSNRestartingStep S f δ alphaF gamma0F x =
      S (schemeSNRestartingBlockLength δ alphaF) (aPrioriRadiusEstimate f gamma0F x) :=
  rfl

/-- The canonical iterate sequence `\hat x_t` generated by repeatedly applying the Algorithm 7.4
restart map, started from the prescribed initial point `x₀`. -/
def schemeSNRestartingIterate
    (S : ℕ → ℝ → X) (f : X → ℝ) (x0 : X) (δ alphaF gamma0F : ℝ) : ℕ → X :=
  fun t ↦ (schemeSNRestartingStep S f δ alphaF gamma0F)^[t] x0

namespace SchemeSNRestartingNotation

scoped notation:max
    "x̂[" S:arg "; " f:arg "; " x0:arg " | " δ:arg ", " alphaF:arg ", " gamma0F:arg "]" =>
  schemeSNRestartingIterate S f x0 δ alphaF gamma0F

end SchemeSNRestartingNotation

open scoped SchemeSNRestartingNotation

/-- The canonical iterate sequence starts at the prescribed initial point `x₀`. -/
@[simp] theorem schemeSNRestartingIterate_zero
    (S : ℕ → ℝ → X) (f : X → ℝ) (x0 : X) (δ alphaF gamma0F : ℝ) :
    (x̂[S; f; x0 | δ, alphaF, gamma0F]) 0 = x0 :=
  rfl

/-- The canonical iterate sequence satisfies the Algorithm 7.4 restart rule. -/
theorem schemeSNRestartingIterate_succ
    (S : ℕ → ℝ → X) (f : X → ℝ) (x0 : X) (δ alphaF gamma0F : ℝ) (t : ℕ) :
    (x̂[S; f; x0 | δ, alphaF, gamma0F]) (t + 1) =
      schemeSNRestartingStep S f δ alphaF gamma0F
        ((x̂[S; f; x0 | δ, alphaF, gamma0F]) t) := by
  simpa [schemeSNRestartingIterate] using
    Function.iterate_succ_apply' (schemeSNRestartingStep S f δ alphaF gamma0F) t x0

/-- The stopping predicate from Algorithm 7.4, evaluated at stage `t`. -/
def schemeSNRestartingStoppingCriterion
    (S : ℕ → ℝ → X) (f : X → ℝ) (x0 : X) (δ alphaF gamma0F : ℝ) (t : ℕ) : Prop :=
  f ((x̂[S; f; x0 | δ, alphaF, gamma0F]) (t + 1)) ≥
    schemeSNRestartingStoppingFactor *
      f ((x̂[S; f; x0 | δ, alphaF, gamma0F]) t)

/-- Algorithm 7.4 terminates when some stage satisfies the acceptance test
`f(\hat x_{t+1}) ≥ (1 / e) f(\hat x_t)`. -/
def schemeSNRestartingTerminates
    (S : ℕ → ℝ → X) (f : X → ℝ) (x0 : X) (δ alphaF gamma0F : ℝ) : Prop :=
  ∃ t : ℕ, schemeSNRestartingStoppingCriterion S f x0 δ alphaF gamma0F t

/-- The textbook first stopping index `s`, derived canonically from the least stage satisfying
the Algorithm 7.4 stopping predicate. -/
noncomputable def schemeSNRestartingStoppingIndex
    {S : ℕ → ℝ → X} {f : X → ℝ} {x0 : X} {δ alphaF gamma0F : ℝ}
    (hTerminate : schemeSNRestartingTerminates S f x0 δ alphaF gamma0F) : ℕ := by
  classical
  exact Nat.find hTerminate

/-- The first stopping index is least with respect to the stopping predicate. -/
theorem schemeSNRestartingStoppingIndex_isLeast
    {S : ℕ → ℝ → X} {f : X → ℝ} {x0 : X} {δ alphaF gamma0F : ℝ}
    (hTerminate : schemeSNRestartingTerminates S f x0 δ alphaF gamma0F) :
    IsLeast
      {t : ℕ | schemeSNRestartingStoppingCriterion S f x0 δ alphaF gamma0F t}
      (schemeSNRestartingStoppingIndex hTerminate) := by
  classical
  simpa [schemeSNRestartingStoppingIndex] using Nat.isLeast_find hTerminate

/-- The stopping test succeeds at the first accepted step. -/
theorem schemeSNRestartingStoppingIndex_spec
    {S : ℕ → ℝ → X} {f : X → ℝ} {x0 : X} {δ alphaF gamma0F : ℝ}
    (hTerminate : schemeSNRestartingTerminates S f x0 δ alphaF gamma0F) :
    f ((x̂[S; f; x0 | δ, alphaF, gamma0F])
      (schemeSNRestartingStoppingIndex hTerminate + 1)) ≥
      schemeSNRestartingStoppingFactor *
        f ((x̂[S; f; x0 | δ, alphaF, gamma0F])
          (schemeSNRestartingStoppingIndex hTerminate)) := by
  simpa [schemeSNRestartingStoppingCriterion] using
    (schemeSNRestartingStoppingIndex_isLeast hTerminate).1

/-- The stopping test fails at every earlier step. -/
theorem schemeSNRestartingStoppingIndex_min
    {S : ℕ → ℝ → X} {f : X → ℝ} {x0 : X} {δ alphaF gamma0F : ℝ}
    (hTerminate : schemeSNRestartingTerminates S f x0 δ alphaF gamma0F)
    {t : ℕ} (ht : t < schemeSNRestartingStoppingIndex hTerminate) :
    f ((x̂[S; f; x0 | δ, alphaF, gamma0F]) (t + 1)) <
      schemeSNRestartingStoppingFactor *
        f ((x̂[S; f; x0 | δ, alphaF, gamma0F]) t) := by
  exact lt_of_not_ge fun hStop ↦
    (not_le_of_gt ht)
      ((schemeSNRestartingStoppingIndex_isLeast hTerminate).2
        (by simpa [schemeSNRestartingStoppingCriterion] using hStop))

/-- The textbook stopping time `T`, defined from the first stopping index `s` by `T = s + 1`. -/
def schemeSNRestartingStoppingTime
    {S : ℕ → ℝ → X} {f : X → ℝ} {x0 : X} {δ alphaF gamma0F : ℝ}
    (hTerminate : schemeSNRestartingTerminates S f x0 δ alphaF gamma0F) : ℕ :=
  schemeSNRestartingStoppingIndex hTerminate + 1

/-- At the textbook stopping time `T`, the acceptance inequality
`f(\hat x_T) ≥ (1 / e) f(\hat x_{T-1})` holds. -/
theorem schemeSNRestartingStoppingTime_spec
    {S : ℕ → ℝ → X} {f : X → ℝ} {x0 : X} {δ alphaF gamma0F : ℝ}
    (hTerminate : schemeSNRestartingTerminates S f x0 δ alphaF gamma0F) :
    f ((x̂[S; f; x0 | δ, alphaF, gamma0F])
      (schemeSNRestartingStoppingTime hTerminate)) ≥
      schemeSNRestartingStoppingFactor *
        f ((x̂[S; f; x0 | δ, alphaF, gamma0F])
          (schemeSNRestartingStoppingTime hTerminate - 1)) := by
  simpa [schemeSNRestartingStoppingTime] using
    schemeSNRestartingStoppingIndex_spec hTerminate

end
