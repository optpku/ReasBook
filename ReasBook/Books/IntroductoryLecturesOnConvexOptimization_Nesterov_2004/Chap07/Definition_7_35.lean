section Family

variable {ι : Type*} {κ : Type*}

local notation "E" => EuclideanSpace ℝ ι

/-- Definition 7.35: the sign-symmetric convex set generated by a family of boxes `B(aᵢ)` is
their convex hull `Conv {B(aᵢ)}`. -/
def signSymmetricConvexHull (a : κ → E) : Set E :=
  convexHull ℝ (⋃ i : κ, B((a i)))

-- Proof sketch: unfold `signSymmetricConvexHull`; the right-hand side is definitionally the convex
-- hull of the union of the boxes `B(a_i)`.
/- Expanding `signSymmetricConvexHull a` recovers the convex hull of the family of boxes
`B(aᵢ)`. -/
theorem signSymmetricConvexHull_def (a : κ → E) :
    signSymmetricConvexHull a = convexHull ℝ (⋃ i : κ, B((a i))) :=
  rfl

end Family

section AverageVector

variable {ι : Type*} {m : ℕ+}

local notation "E" => EuclideanSpace ℝ ι

/-- The source-facing average vector `\hat a = (1 / m) ∑ aᵢ` attached to a nonempty family
`a₁, …, aₘ`. -/
def averageVector (a : Fin (m : ℕ) → E) : E :=
  (1 / (m : ℝ)) • ∑ i : Fin (m : ℕ), a i

-- Proof sketch: evaluate the scalar multiple pointwise and use the coordinatewise formula for the
-- finite sum in `EuclideanSpace ℝ ι`.
/-- The coordinates of the source average vector `\hat a` are the textbook averaged coordinates
`\hat aⱼ = (1 / m) ∑ aᵢⱼ`. -/
theorem averageVector_apply (a : Fin (m : ℕ) → E) (j : ι) :
    averageVector a j = (1 / (m : ℝ)) * ∑ i : Fin (m : ℕ), a i j :=
  by simp [averageVector]

-- Proof sketch: rewrite the source average as the equal-weight center of mass on `Fin m`, then
-- identify that center of mass with the canonical centroid `Finset.univ.centroid ℝ a`.
/-- The nonempty-family source average vector `\hat a` agrees with the canonical equal-weight
centroid on `Fin m`. -/
theorem averageVector_eq_centroid (a : Fin (m : ℕ) → E) :
    averageVector a = Finset.univ.centroid ℝ a :=
  by
    have hnonempty : (Finset.univ : Finset (Fin (m : ℕ))).Nonempty := Finset.univ_nonempty
    rw [Finset.centroid_eq_centerMass _ hnonempty, Finset.centerMass, Finset.centroidWeights]
    simp [averageVector, Finset.smul_sum]

end AverageVector

local notation "E" => EuclideanSpace ℝ (Fin n)

section AverageDiagonal

variable {m : ℕ+}

/-- The diagonal matrix `D(\hat a) = diag(\hat a)` associated with the nonempty-family average
vector `\hat a`. -/
def averageDiagonal (a : Fin (m : ℕ) → E) : Matrix (Fin n) (Fin n) ℝ :=
  Matrix.diagonal (averageVector a)

-- Proof sketch: `averageDiagonal a` is a diagonal matrix by construction, so the canonical
-- diagonal-matrix predicate applies directly.
/-- The average diagonal matrix is canonically diagonal. -/
theorem averageDiagonal_isDiag (a : Fin (m : ℕ) → E) : (averageDiagonal a).IsDiag :=
  by simp [averageDiagonal]

-- Proof sketch: if every coordinate of `averageVector a` is positive, then the standard positive
-- definiteness criterion for diagonal matrices yields `PosDef (averageDiagonal a)`.
/-- If the centroid is strictly positive coordinatewise, its diagonal matrix is positive
definite. -/
theorem averageDiagonal_posDef (a : Fin (m : ℕ) → E) (ha : averageVector a ∈ positiveOrthant n) :
    (averageDiagonal a).PosDef :=
  by
    have hpos : ∀ i : Fin n, 0 < averageVector a i := by
      simpa [EuclideanSpace.mem_positiveOrthant_iff] using ha
    simpa [averageDiagonal] using Matrix.PosDef.diagonal hpos

-- Proof sketch: unfold `averageDiagonal`; the diagonal entry in position `(j,j)` is the
-- `j`th coordinate of the average vector.
/-- The diagonal entries of `averageDiagonal a` are exactly the coordinates of the canonical
average vector `\hat a`. -/
theorem averageDiagonal_apply (a : Fin (m : ℕ) → E) (j : Fin n) :
    averageDiagonal a j j = averageVector a j :=
  by simp [averageDiagonal]

/-- The squared diagonal matrix `\hat D = D(\hat a)^2 = diag(\hat a \circ \hat a)`. -/
def averageDiagonalSquare (a : Fin (m : ℕ) → E) : Matrix (Fin n) (Fin n) ℝ :=
  averageDiagonal a * averageDiagonal a

/-- Expanding `averageDiagonalSquare a` recovers the diagonal matrix
`diag(\hat a \circ \hat a)`. -/
theorem averageDiagonalSquare_eq_diagonal (a : Fin (m : ℕ) → E) :
    averageDiagonalSquare a = Matrix.diagonal fun j : Fin n ↦ averageVector a j ^ (2 : ℕ) := by
  simp [averageDiagonalSquare, averageDiagonal, pow_two, Matrix.diagonal_mul_diagonal]

-- Proof sketch: multiply the diagonal matrix `D(\hat a)` by itself and use the canonical product
-- formula for diagonal matrices.
/-- Squaring `averageDiagonal a` gives `averageDiagonalSquare a`. -/
theorem averageDiagonal_mul (a : Fin (m : ℕ) → E) :
    averageDiagonal a * averageDiagonal a = averageDiagonalSquare a :=
  rfl

end AverageDiagonal

end
