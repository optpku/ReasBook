noncomputable section

open Matrix
open scoped BigOperators PositiveDefMatrixNorm StandardSimplex

variable {m n : ℕ+}

/- Algorithm 7.10 lies in the finite-simplex / autonomous outer-trajectory /
first-stopping-index domain.

Sampled owner-style declarations:
- `Δ[n]` in `Chap06/Definition_6_11.lean`, the chapter simplex surface for `stdSimplex ℝ (Fin n)`;
- `positiveDefMatrixNorm` in `Chap07/Definition_7_23.lean`, the Chapter 7 owner for weighted
  norms attached to positive-definite matrices;
- `nonnegative_matrix_game_payoff` in `Chap07/Definition_7_40.lean`, the nearby Chapter 7 matrix-
  game owner already stated on the simplex owner rather than a coordinate wrapper;
- `relativeScaleSubgradientApproximationIterate` and
  `relativeScaleSubgradientApproximationStoppingIndex` in `Algorithm_7_2.lean`;
- `schemeSNRestartingIterate` and `schemeSNRestartingStoppingIndex` in `Algorithm_7_4.lean`.

Best owner abstraction:
- source-facing: Algorithm 7.10's outer iterate sequence `\hat x_t`, the first accepted stopping
  stage/time, and the source formulas for the smoothing, localization, and initialization data;
- core/canonical: the positive-definite matrix owner `⟨D, hDpos⟩`,
  `positiveDefMatrixNorm`, the explicit outer step `matrixGameRelativeScaleStep`, the canonical
  orbit generated by `Function.iterate`, and the least stopping index derived by `Nat.find`;
- bridge/view: the diagonal-entry formula for `x₀`, the localization-set membership theorem, and
  the stopping time `T = s + 1`.

Primitive data:
- the diagonal positive-definite matrix `D`;
- the block length, smoothing parameter, smoothness constant, and explicit outer step;
- the prescribed initial simplex point;
- existence of an accepted stage for the stopping rule.

Derived API:
- the canonical iterate sequence `\hat x_t`;
- the stopping predicate and termination statement;
- the first stopping index `s`;
- the stopping time `T = s + 1`;
- the acceptance inequality at `T` and the failure of the stopping test at every earlier positive
  step.

Source/core/bridge triage:
- source-facing: the initialization, update rule, and first accepted stage/time of Algorithm 7.10;
- core/canonical: `positiveDefMatrixNorm`, `matrixGameRelativeScaleStep`,
  `matrixGameRelativeScaleIterate`, `matrixGameRelativeScaleStoppingIndex`, and
  `matrixGameRelativeScaleStoppingTime`;
- bridge/view: `matrixGameRelativeScaleInitialPointVector`,
  `mem_matrixGameRelativeScaleLocalizationSet_iff`, and the stopping-time reformulations.

This refinement keeps the source-facing formulas for the step data, but deletes the duplicate
coordinate-weight norm owner in favor of the Chapter 7 positive-definite matrix owner
`positiveDefMatrixNorm`. The orbit and first accepted stopping stage remain canonical derived API.
-/

local notation "Δₙ" => Δ[(n : ℕ)]
local notation "Eₙ" => EuclideanSpace ℝ (Fin (n : ℕ))
local notation "PosMat" => { G : Matrix (Fin (n : ℕ)) (Fin (n : ℕ)) ℝ // Matrix.PosDef G }
local notation "DiagPosMat" =>
  { G : Matrix (Fin (n : ℕ)) (Fin (n : ℕ)) ℝ // Matrix.IsDiag G ∧ Matrix.PosDef G }
local notation "Solver" =>
  (Δₙ → ℝ) → ℝ → Set Δₙ → PosMat → Δₙ → ℕ → Δₙ

/-- The localization set `Q(r) = {x ∈ Δ_n : ‖x‖_D ≤ r}` used in Algorithm 7.10. -/
def matrixGameRelativeScaleLocalizationSet
    (D : DiagPosMat) (r : ℝ) : Set Δₙ :=
  {x | ‖(EuclideanSpace.equiv (Fin (n : ℕ)) ℝ).symm x‖[(⟨D.1, D.2.2⟩ : PosMat)] ≤ r}

-- Proof sketch: unfold `matrixGameRelativeScaleLocalizationSet`.
/-- Membership in `matrixGameRelativeScaleLocalizationSet D r` is exactly the bound `‖x‖_D ≤ r`
inside the simplex. -/
theorem mem_matrixGameRelativeScaleLocalizationSet_iff
    (D : DiagPosMat) (r : ℝ) (x : Δₙ) :
    x ∈ matrixGameRelativeScaleLocalizationSet D r ↔
      ‖(EuclideanSpace.equiv (Fin (n : ℕ)) ℝ).symm x‖[(⟨D.1, D.2.2⟩ : PosMat)] ≤ r :=
  Iff.rfl

/-- The ambient-vector formula
`x₀ = D⁻¹ \bar ε_n / (\bar ε_n, D⁻¹ \bar ε_n)` for the initialization of Algorithm 7.10,
written in diagonal coordinates as normalized reciprocals of the positive diagonal entries. -/
def matrixGameRelativeScaleInitialPointVector
    (D : DiagPosMat) : Fin (n : ℕ) → ℝ :=
  fun i ↦ (D.1 i i)⁻¹ / ∑ j : Fin (n : ℕ), (D.1 j j)⁻¹

-- Proof sketch: unfold `matrixGameRelativeScaleInitialPointVector`.
/-- The `i`-th coordinate of `matrixGameRelativeScaleInitialPointVector D` is
`D_{ii}^{-1} / ∑ⱼ D_{jj}^{-1}`. -/
theorem matrixGameRelativeScaleInitialPointVector_apply
    (D : DiagPosMat) (i : Fin (n : ℕ)) :
    matrixGameRelativeScaleInitialPointVector D i =
      (D.1 i i)⁻¹ / ∑ j : Fin (n : ℕ), (D.1 j j)⁻¹ :=
  rfl

/-- Helper for Algorithm 7.10: the reciprocal diagonal normalization constant in the definition of
`x₀` is strictly positive. -/
theorem matrixGameRelativeScaleDiagonalReciprocalSum_pos
    (D : DiagPosMat) :
    0 < ∑ j : Fin (n : ℕ), (D.1 j j)⁻¹ := by
  let i0 : Fin (n : ℕ) := ⟨0, n.2⟩
  -- Each reciprocal diagonal entry is nonnegative because the diagonal is positive.
  refine Finset.sum_pos' ?_ ?_
  · intro i _
    exact inv_nonneg.mpr (le_of_lt (D.2.2.diag_pos (i := i)))
  -- The explicit index `0` contributes a strictly positive reciprocal.
  refine ⟨i0, by simp, inv_pos.mpr (D.2.2.diag_pos (i := i0))⟩

-- Proof sketch: use positivity of the diagonal entries to show all reciprocal coordinates are
-- nonnegative, and compute the sum of the normalized reciprocals to be `1`.
/-- Algorithm 7.10: the normalized reciprocal vector defining `x₀` belongs to the standard
simplex. -/
theorem matrixGameRelativeScaleInitialPointVector_mem_stdSimplex
    (D : DiagPosMat) :
    matrixGameRelativeScaleInitialPointVector D ∈ (Δ[(n : ℕ)] : Set (Fin (n : ℕ) → ℝ)) :=
  by
    let s : ℝ := ∑ j : Fin (n : ℕ), (D.1 j j)⁻¹
    have hsum_pos : 0 < s := by
      -- The simplex normalization denominator is positive by the reciprocal-diagonal helper.
      simpa [s] using matrixGameRelativeScaleDiagonalReciprocalSum_pos D
    refine ⟨?_, ?_⟩
    · intro i
      -- Each coordinate is a quotient of nonnegative quantities.
      rw [matrixGameRelativeScaleInitialPointVector_apply]
      rw [show (∑ j : Fin (n : ℕ), (D.1 j j)⁻¹) = s by rfl]
      exact div_nonneg
        (inv_nonneg.mpr (le_of_lt (D.2.2.diag_pos (i := i))))
        hsum_pos.le
    · -- Summing the normalized coordinates collapses to `s / s = 1`.
      calc
        ∑ i : Fin (n : ℕ), matrixGameRelativeScaleInitialPointVector D i
            = (∑ i : Fin (n : ℕ), (D.1 i i)⁻¹) / s := by
                simp [matrixGameRelativeScaleInitialPointVector, s, Finset.sum_div]
        _ = 1 := by
          simpa [s] using div_self hsum_pos.ne'

/-- The initial simplex point
`x₀ = D⁻¹ \bar ε_n / (\bar ε_n, D⁻¹ \bar ε_n)` from Algorithm 7.10. -/
def matrixGameRelativeScaleInitialPoint
    (D : DiagPosMat) : Δₙ :=
  ⟨matrixGameRelativeScaleInitialPointVector D,
    matrixGameRelativeScaleInitialPointVector_mem_stdSimplex D⟩

-- Proof sketch: unfold `matrixGameRelativeScaleInitialPoint`.
/-- Coercing `matrixGameRelativeScaleInitialPoint d` to the ambient space recovers the normalized
reciprocal vector. -/
theorem matrixGameRelativeScaleInitialPoint_val
    (D : DiagPosMat) :
    ↑(matrixGameRelativeScaleInitialPoint D) =
      matrixGameRelativeScaleInitialPointVector D :=
  rfl

/-- The block length
`\tilde N = ⌊4 e \sqrt{2 n \ln m} (1 + 1 / δ)⌋`
used in Algorithm 7.10. -/
def matrixGameRelativeScaleBlockLength
    (m n : ℕ+) (δ : ℝ) : ℕ :=
  Nat.floor (4 * Real.exp 1 * Real.sqrt (2 * n * Real.log m) * (1 + 1 / δ))

-- Proof sketch: unfold `matrixGameRelativeScaleBlockLength`.
/-- Expanding `matrixGameRelativeScaleBlockLength m n δ` recovers the textbook formula for
`\tilde N`. -/
theorem matrixGameRelativeScaleBlockLength_def
    (m n : ℕ+) (δ : ℝ) :
    matrixGameRelativeScaleBlockLength m n δ =
      Nat.floor (4 * Real.exp 1 * Real.sqrt (2 * n * Real.log m) * (1 + 1 / δ)) :=
  rfl

/-- The smoothing parameter
`μ_t = δ f(\hat x_{t-1}) / (2 e (1 + δ) \ln m)`
chosen at each outer iteration of Algorithm 7.10. -/
def matrixGameRelativeScaleSmoothingParameter
    (m : ℕ+) (f : Δₙ → ℝ) (δ : ℝ) (x : Δₙ) : ℝ :=
  (δ * f x) / (2 * Real.exp 1 * (1 + δ) * Real.log m)

-- Proof sketch: unfold `matrixGameRelativeScaleSmoothingParameter`.
/-- Evaluating `matrixGameRelativeScaleSmoothingParameter f δ x` gives the textbook formula for
`μ_t` with `x = \hat x_{t-1}`. -/
theorem matrixGameRelativeScaleSmoothingParameter_eq
    (m : ℕ+) (f : Δₙ → ℝ) (δ : ℝ) (x : Δₙ) :
    matrixGameRelativeScaleSmoothingParameter m f δ x =
      (δ * f x) / (2 * Real.exp 1 * (1 + δ) * Real.log m) :=
  rfl

/-- The smoothness constant `L_μ = 4 n / μ` used for the smoothed objective in Algorithm 7.10. -/
def matrixGameRelativeScaleSmoothness
    (n : ℕ+) (μ : ℝ) : ℝ :=
  (4 * n) / μ

-- Proof sketch: unfold `matrixGameRelativeScaleSmoothness`.
/-- Expanding `matrixGameRelativeScaleSmoothness n μ` recovers the displayed formula
`L_μ = 4 n / μ`. -/
theorem matrixGameRelativeScaleSmoothness_eq
    (n : ℕ+) (μ : ℝ) :
    matrixGameRelativeScaleSmoothness n μ = (4 * n) / μ :=
  rfl

/-- The stopping factor `1 / e` from the acceptance test in Algorithm 7.10. -/
def matrixGameRelativeScaleStoppingFactor : ℝ :=
  1 / Real.exp 1

-- Proof sketch: unfold `matrixGameRelativeScaleStoppingFactor`.
/-- Expanding `matrixGameRelativeScaleStoppingFactor` recovers the threshold `1 / e`. -/
theorem matrixGameRelativeScaleStoppingFactor_def :
    matrixGameRelativeScaleStoppingFactor = 1 / Real.exp 1 :=
  rfl

/-- The single outer update
`\hat x_t = S(f_{μ_t}, L_{μ_t}, Q(f(\hat x_{t-1})), D, x₀, \tilde N)`
from Algorithm 7.10. -/
def matrixGameRelativeScaleStep
    (m : ℕ+) (S : Solver) (f : Δₙ → ℝ) (fμ : ℝ → Δₙ → ℝ) (D : DiagPosMat) (δ : ℝ)
    (xPrev : Δₙ) : Δₙ :=
  let μ := matrixGameRelativeScaleSmoothingParameter m f δ xPrev
  S (fμ μ)
    (matrixGameRelativeScaleSmoothness n μ)
    (matrixGameRelativeScaleLocalizationSet D (f xPrev))
    (⟨D.1, D.2.2⟩ : PosMat)
    (matrixGameRelativeScaleInitialPoint D)
    (matrixGameRelativeScaleBlockLength m n δ)

-- Proof sketch: unfold `matrixGameRelativeScaleStep`; the only auxiliary abbreviation is
-- `μ = matrixGameRelativeScaleSmoothingParameter f δ xPrev`.
/-- Evaluating `matrixGameRelativeScaleStep S f fμ D δ xPrev` applies the subroutine `S` to the
smoothed objective `f_μ`, the constant `L_μ`, the localization set `Q(f(xPrev))`, the diagonal
matrix data `D`, the initial point `x₀`, and the block length `\tilde N`. -/
theorem matrixGameRelativeScaleStep_eq
    (m : ℕ+) (S : Solver) (f : Δₙ → ℝ) (fμ : ℝ → Δₙ → ℝ) (D : DiagPosMat) (δ : ℝ)
    (xPrev : Δₙ) :
    matrixGameRelativeScaleStep m S f fμ D δ xPrev =
      let μ := matrixGameRelativeScaleSmoothingParameter m f δ xPrev
      S (fμ μ)
        (matrixGameRelativeScaleSmoothness n μ)
        (matrixGameRelativeScaleLocalizationSet D (f xPrev))
        (⟨D.1, D.2.2⟩ : PosMat)
        (matrixGameRelativeScaleInitialPoint D)
        (matrixGameRelativeScaleBlockLength m n δ) :=
  rfl

/-- The canonical iterate sequence `\hat x_t` generated by repeatedly applying the Algorithm 7.10
outer update, started from the prescribed initial simplex point `x₀`. -/
def matrixGameRelativeScaleIterate
    (m : ℕ+) (S : Solver) (f : Δₙ → ℝ) (fμ : ℝ → Δₙ → ℝ) (D : DiagPosMat) (δ : ℝ) :
    ℕ → Δₙ :=
  fun t ↦ (matrixGameRelativeScaleStep m S f fμ D δ)^[t] (matrixGameRelativeScaleInitialPoint D)

namespace MatrixGameRelativeScaleNotation

scoped notation:max
    "x̂[" m:arg "; " S:arg "; " f:arg "; " fμ:arg "; " D:arg " | " δ:arg "]" =>
  matrixGameRelativeScaleIterate m S f fμ D δ

end MatrixGameRelativeScaleNotation

open scoped MatrixGameRelativeScaleNotation

/-- The canonical iterate sequence starts at the prescribed initial point `x₀`. -/
@[simp] theorem matrixGameRelativeScaleIterate_zero
    (m : ℕ+) (S : Solver) (f : Δₙ → ℝ) (fμ : ℝ → Δₙ → ℝ) (D : DiagPosMat) (δ : ℝ) :
    (x̂[m; S; f; fμ; D | δ]) 0 = matrixGameRelativeScaleInitialPoint D :=
  rfl

/-- The canonical iterate sequence satisfies the Algorithm 7.10 update rule. -/
theorem matrixGameRelativeScaleIterate_succ
    (m : ℕ+) (S : Solver) (f : Δₙ → ℝ) (fμ : ℝ → Δₙ → ℝ) (D : DiagPosMat) (δ : ℝ)
    (t : ℕ) :
    (x̂[m; S; f; fμ; D | δ]) (t + 1) =
      matrixGameRelativeScaleStep m S f fμ D δ ((x̂[m; S; f; fμ; D | δ]) t) := by
  simpa [matrixGameRelativeScaleIterate] using
    Function.iterate_succ_apply' (matrixGameRelativeScaleStep m S f fμ D δ) t
      (matrixGameRelativeScaleInitialPoint D)

/-- The stopping predicate from Algorithm 7.10, evaluated at outer stage `t`. -/
def matrixGameRelativeScaleStoppingCriterion
    (m : ℕ+) (S : Solver) (f : Δₙ → ℝ) (fμ : ℝ → Δₙ → ℝ) (D : DiagPosMat) (δ : ℝ)
    (t : ℕ) : Prop :=
  f ((x̂[m; S; f; fμ; D | δ]) (t + 1)) ≥
    matrixGameRelativeScaleStoppingFactor *
      f ((x̂[m; S; f; fμ; D | δ]) t)

/-- Termination means that some outer stage of Algorithm 7.10 satisfies the acceptance test
`f(\hat x_{t+1}) ≥ (1 / e) f(\hat x_t)`. -/
def matrixGameRelativeScaleTerminates
    (m : ℕ+) (S : Solver) (f : Δₙ → ℝ) (fμ : ℝ → Δₙ → ℝ) (D : DiagPosMat) (δ : ℝ) : Prop :=
  ∃ t : ℕ, matrixGameRelativeScaleStoppingCriterion m S f fμ D δ t

/-- The textbook first stopping index `s`, derived canonically from the least outer stage
satisfying the Algorithm 7.10 stopping predicate. -/
noncomputable def matrixGameRelativeScaleStoppingIndex
    {S : Solver} {f : Δₙ → ℝ} {fμ : ℝ → Δₙ → ℝ} {D : DiagPosMat} {δ : ℝ}
    (hTerminate : matrixGameRelativeScaleTerminates m S f fμ D δ) : ℕ := by
  classical
  exact Nat.find hTerminate

/-- The first stopping index is least with respect to the Algorithm 7.10 stopping predicate. -/
theorem matrixGameRelativeScaleStoppingIndex_isLeast
    {S : Solver} {f : Δₙ → ℝ} {fμ : ℝ → Δₙ → ℝ} {D : DiagPosMat} {δ : ℝ}
    (hTerminate : matrixGameRelativeScaleTerminates m S f fμ D δ) :
    IsLeast {t : ℕ | matrixGameRelativeScaleStoppingCriterion m S f fμ D δ t}
      (matrixGameRelativeScaleStoppingIndex hTerminate) := by
  classical
  simpa [matrixGameRelativeScaleStoppingIndex] using Nat.isLeast_find hTerminate

/-- The stopping test succeeds at the first accepted step. -/
theorem matrixGameRelativeScaleStoppingIndex_spec
    {S : Solver} {f : Δₙ → ℝ} {fμ : ℝ → Δₙ → ℝ} {D : DiagPosMat} {δ : ℝ}
    (hTerminate : matrixGameRelativeScaleTerminates m S f fμ D δ) :
    f ((x̂[m; S; f; fμ; D | δ]) (matrixGameRelativeScaleStoppingIndex hTerminate + 1)) ≥
      matrixGameRelativeScaleStoppingFactor *
        f ((x̂[m; S; f; fμ; D | δ]) (matrixGameRelativeScaleStoppingIndex hTerminate)) := by
  simpa [matrixGameRelativeScaleStoppingCriterion] using
    (matrixGameRelativeScaleStoppingIndex_isLeast hTerminate).1

/-- The stopping test fails at every earlier step. -/
theorem matrixGameRelativeScaleStoppingIndex_min
    {S : Solver} {f : Δₙ → ℝ} {fμ : ℝ → Δₙ → ℝ} {D : DiagPosMat} {δ : ℝ}
    (hTerminate : matrixGameRelativeScaleTerminates m S f fμ D δ)
    {t : ℕ} (ht : t < matrixGameRelativeScaleStoppingIndex hTerminate) :
    f ((x̂[m; S; f; fμ; D | δ]) (t + 1)) <
      matrixGameRelativeScaleStoppingFactor *
        f ((x̂[m; S; f; fμ; D | δ]) t) := by
  exact lt_of_not_ge fun hStop ↦
    (not_le_of_gt ht)
      ((matrixGameRelativeScaleStoppingIndex_isLeast hTerminate).2
        (by simpa [matrixGameRelativeScaleStoppingCriterion] using hStop))

/-- The textbook stopping time `T`, defined from the first stopping index `s` by `T = s + 1`. -/
def matrixGameRelativeScaleStoppingTime
    {S : Solver} {f : Δₙ → ℝ} {fμ : ℝ → Δₙ → ℝ} {D : DiagPosMat} {δ : ℝ}
    (hTerminate : matrixGameRelativeScaleTerminates m S f fμ D δ) : ℕ :=
  matrixGameRelativeScaleStoppingIndex hTerminate + 1

/-- The stopping time is positive, since the acceptance test is checked only after one update. -/
theorem matrixGameRelativeScaleStoppingTime_pos
    {S : Solver} {f : Δₙ → ℝ} {fμ : ℝ → Δₙ → ℝ} {D : DiagPosMat} {δ : ℝ}
    (hTerminate : matrixGameRelativeScaleTerminates m S f fμ D δ) :
    0 < matrixGameRelativeScaleStoppingTime hTerminate := by
  simp [matrixGameRelativeScaleStoppingTime]

/-- At the textbook stopping time `T`, the acceptance inequality
`f(\hat x_T) ≥ (1 / e) f(\hat x_{T-1})` holds. -/
theorem matrixGameRelativeScaleStoppingTime_spec
    {S : Solver} {f : Δₙ → ℝ} {fμ : ℝ → Δₙ → ℝ} {D : DiagPosMat} {δ : ℝ}
    (hTerminate : matrixGameRelativeScaleTerminates m S f fμ D δ) :
    f ((x̂[m; S; f; fμ; D | δ]) (matrixGameRelativeScaleStoppingTime hTerminate)) ≥
      matrixGameRelativeScaleStoppingFactor *
        f ((x̂[m; S; f; fμ; D | δ]) (matrixGameRelativeScaleStoppingTime hTerminate - 1)) := by
  simpa [matrixGameRelativeScaleStoppingTime] using
    matrixGameRelativeScaleStoppingIndex_spec hTerminate

/-- The preterminal point of Algorithm 7.10 is the iterate `\hat x_s` at the first accepted
stopping index `s`. -/
def matrixGameRelativeScalePreterminalPoint
    {S : Solver} {f : Δₙ → ℝ} {fμ : ℝ → Δₙ → ℝ} {D : DiagPosMat} {δ : ℝ}
    (hTerminate : matrixGameRelativeScaleTerminates m S f fμ D δ) : Δₙ :=
  (x̂[m; S; f; fμ; D | δ]) (matrixGameRelativeScaleStoppingIndex hTerminate)

/-- The preterminal point is exactly the iterate indexed by the textbook stopping index `s`. -/
theorem matrixGameRelativeScalePreterminalPoint_eq
    {S : Solver} {f : Δₙ → ℝ} {fμ : ℝ → Δₙ → ℝ} {D : DiagPosMat} {δ : ℝ}
    (hTerminate : matrixGameRelativeScaleTerminates m S f fμ D δ) :
    matrixGameRelativeScalePreterminalPoint hTerminate =
      (x̂[m; S; f; fμ; D | δ]) (matrixGameRelativeScaleStoppingIndex hTerminate) :=
  rfl

/-- The output point of Algorithm 7.10 is the accepted iterate `\hat x_T`. -/
def matrixGameRelativeScaleOutputPoint
    {S : Solver} {f : Δₙ → ℝ} {fμ : ℝ → Δₙ → ℝ} {D : DiagPosMat} {δ : ℝ}
    (hTerminate : matrixGameRelativeScaleTerminates m S f fμ D δ) : Δₙ :=
  (x̂[m; S; f; fμ; D | δ]) (matrixGameRelativeScaleStoppingTime hTerminate)

/-- The output point is exactly the iterate indexed by the textbook stopping time `T`. -/
theorem matrixGameRelativeScaleOutputPoint_eq
    {S : Solver} {f : Δₙ → ℝ} {fμ : ℝ → Δₙ → ℝ} {D : DiagPosMat} {δ : ℝ}
    (hTerminate : matrixGameRelativeScaleTerminates m S f fμ D δ) :
    matrixGameRelativeScaleOutputPoint hTerminate =
      (x̂[m; S; f; fμ; D | δ]) (matrixGameRelativeScaleStoppingTime hTerminate) :=
  rfl

/-- The acceptance test fails at every earlier positive step. -/
theorem matrixGameRelativeScaleStoppingTime_min
    {S : Solver} {f : Δₙ → ℝ} {fμ : ℝ → Δₙ → ℝ} {D : DiagPosMat} {δ : ℝ}
    (hTerminate : matrixGameRelativeScaleTerminates m S f fμ D δ)
    {t : ℕ} (ht_pos : 0 < t) (ht : t < matrixGameRelativeScaleStoppingTime hTerminate) :
    f ((x̂[m; S; f; fμ; D | δ]) t) <
      matrixGameRelativeScaleStoppingFactor *
        f ((x̂[m; S; f; fμ; D | δ]) (t - 1)) := by
  have ht_eq : t = t - 1 + 1 := by
    exact (Nat.succ_pred_eq_of_pos ht_pos).symm
  have ht' : t - 1 < matrixGameRelativeScaleStoppingIndex hTerminate := by
    rw [matrixGameRelativeScaleStoppingTime] at ht
    have ht'' : t - 1 + 1 < matrixGameRelativeScaleStoppingIndex hTerminate + 1 := by
      exact ht_eq ▸ ht
    exact Nat.lt_of_add_lt_add_right ht''
  have hmin := matrixGameRelativeScaleStoppingIndex_min hTerminate ht'
  rw [← ht_eq] at hmin
  exact hmin

end
