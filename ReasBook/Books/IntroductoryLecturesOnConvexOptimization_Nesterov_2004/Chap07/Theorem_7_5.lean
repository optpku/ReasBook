import IntroductoryLecturesOnConvexOptimization_Nesterov_2004.Compat
import IntroductoryLecturesOnConvexOptimization_Nesterov_2004.Chap07.Algorithm_7_4
import IntroductoryLecturesOnConvexOptimization_Nesterov_2004.Chap07.Definition_7_1

-- Declarations for this item will be appended below by the statement pipeline.

noncomputable section

universe u

section

variable {X : Type u}
variable {f : X → ℝ} {S : ℕ → ℝ → X} {x0 xStar : X} {δ alphaF gamma0F : ℝ}

/- Theorem 7.5 lies in Chapter 7's relative-scale restarting / stopping-time domain.

Sampled owner-style declarations:
- `schemeSNRestartingIterate`, `schemeSNRestartingStoppingIndex`, and
  `schemeSNRestartingStoppingTime` in `Algorithm_7_4.lean`, which already own the canonical
  restart orbit and its first accepted stage;
- `relativeScaleSubgradientApproximation_stopping_time_bound` in `Theorem_7_3.lean`, the nearby
  chapter pattern where the theorem is stated directly on the canonical stopping-time owner;
- `IsMinOn` from mathlib, the canonical minimizer predicate needed to express the hidden optimal
  value comparison from the source proof.

Best owner abstraction:
- source-facing: the bound on the number `T` of restart points generated by Algorithm 7.4;
- core/canonical: `schemeSNRestartingStoppingTime hTerminate`;
- bridge/view: the minimizer witness `xStar` and the normalization inequality
  `alphaF * f x0 ≤ f xStar`, which package the source proof's comparison with the optimal value.

The source item is a single stopping-time estimate, so the public API here is one theorem stated
directly on the canonical stopping-time owner, with no extra packaging or auxiliary work-count
interface.
-/

variable (hTerminate : schemeSNRestartingTerminates S f x0 δ alphaF gamma0F)

local notation "x̂" => schemeSNRestartingIterate S f x0 δ alphaF gamma0F
local notation "s" => schemeSNRestartingStoppingIndex hTerminate
local notation "T" => schemeSNRestartingStoppingTime hTerminate

/-- Helper for Theorem 7.5: before the first accepted stage, each failed stopping test multiplies
the objective by at most `e⁻¹`, so the value at stage `t` is bounded by
`exp (-t) * f (\hat x_0)`. -/
lemma schemeSNRestarting_value_le_exp_neg_until_stoppingIndex :
    ∀ ⦃t : ℕ⦄, t ≤ s → f (x̂ t) ≤ Real.exp (-(t : ℝ)) * f (x̂ 0) := by
  intro t ht
  induction t with
  | zero =>
      -- The geometric bound is exact at the initial iterate.
      simp
  | succ t ih =>
      -- Each preterminal stage fails the acceptance test, so one more factor `e⁻¹` is gained.
      have ht_lt : t < s := Nat.lt_of_succ_le ht
      have hfail :
          f (x̂ (t + 1)) <
            schemeSNRestartingStoppingFactor * f (x̂ t) :=
        schemeSNRestartingStoppingIndex_min hTerminate ht_lt
      have hprev :
          f (x̂ t) ≤ Real.exp (-(t : ℝ)) * f (x̂ 0) :=
        ih (Nat.le_of_lt ht_lt)
      have hfactor_nonneg : 0 ≤ schemeSNRestartingStoppingFactor := by
        rw [schemeSNRestartingStoppingFactor_def]
        positivity
      have hstep :
          f (x̂ (t + 1)) ≤
            schemeSNRestartingStoppingFactor * (Real.exp (-(t : ℝ)) * f (x̂ 0)) := by
        exact (le_of_lt hfail).trans (mul_le_mul_of_nonneg_left hprev hfactor_nonneg)
      calc
        f (x̂ (t + 1))
            ≤ schemeSNRestartingStoppingFactor * (Real.exp (-(t : ℝ)) * f (x̂ 0)) := hstep
        _ = Real.exp (-((t + 1 : ℕ) : ℝ)) * f (x̂ 0) := by
              calc
                schemeSNRestartingStoppingFactor * (Real.exp (-(t : ℝ)) * f (x̂ 0))
                    = ((1 / Real.exp 1) * Real.exp (-(t : ℝ))) * f (x̂ 0) := by
                        rw [schemeSNRestartingStoppingFactor_def]
                        ring
                _ = (Real.exp (-1) * Real.exp (-(t : ℝ))) * f (x̂ 0) := by
                      simp [Real.exp_neg, one_div]
                _ = Real.exp ((-1 : ℝ) + -(t : ℝ)) * f (x̂ 0) := by
                      rw [← Real.exp_add]
                _ = Real.exp (-((t + 1 : ℕ) : ℝ)) * f (x̂ 0) := by
                      congr 2
                      norm_num [Nat.cast_add, add_assoc, add_left_comm, add_comm]

/-- Helper for Theorem 7.5: comparing the preterminal restart value with the global minimizer and
the initial normalization inequality yields `exp s ≤ 1 / alphaF`. -/
lemma schemeSNRestarting_exp_stoppingIndex_le_inv_alpha
    (hAlphaF_pos : 0 < alphaF)
    (hInitialValue_pos : 0 < f x0)
    (hxStar : IsMinOn f Set.univ xStar)
    (hOptimalValue_lower : alphaF * f x0 ≤ f xStar) :
    Real.exp (s : ℝ) ≤ 1 / alphaF := by
  -- The global minimizer bounds the preterminal restart value from below.
  have hs_lower :
      f xStar ≤ f (x̂ s) :=
    (isMinOn_univ_iff.mp hxStar) (x̂ s)
  -- The failed-stage contraction controls the same preterminal value from above.
  have hs_decay :
      f (x̂ s) ≤ Real.exp (-(s : ℝ)) * f x0 := by
    simpa using
      (schemeSNRestarting_value_le_exp_neg_until_stoppingIndex
        (hTerminate := hTerminate) (t := s) le_rfl)
  have hcomparison :
      alphaF * f x0 ≤ Real.exp (-(s : ℝ)) * f x0 :=
    hOptimalValue_lower.trans (hs_lower.trans hs_decay)
  have halpha_le_exp_neg :
      alphaF ≤ Real.exp (-(s : ℝ)) :=
    le_of_mul_le_mul_right hcomparison hInitialValue_pos
  -- Multiplying by `exp s` cancels the decay factor and isolates the stopping index.
  have hexp_mul_le_one :
      Real.exp (s : ℝ) * alphaF ≤ 1 := by
    have hmul :
        Real.exp (s : ℝ) * alphaF ≤
          Real.exp (s : ℝ) * Real.exp (-(s : ℝ)) :=
      mul_le_mul_of_nonneg_left halpha_le_exp_neg (Real.exp_nonneg _)
    calc
      Real.exp (s : ℝ) * alphaF ≤
          Real.exp (s : ℝ) * Real.exp (-(s : ℝ)) := hmul
      _ = Real.exp ((s : ℝ) + -(s : ℝ)) := by
            rw [← Real.exp_add]
      _ = 1 := by
            simp
  exact (le_div_iff₀ hAlphaF_pos).2 hexp_mul_le_one

-- Proof sketch: for every `t < schemeSNRestartingStoppingTime hTerminate - 1`,
-- `schemeSNRestartingStoppingIndex_min` shows that the restart orbit contracts by the factor
-- `1 / e`. Iterating this strict decay up to the last pre-accepted stage bounds
-- `f (x̂_{T-1})` by `exp (-(T - 1)) * f x0`. Since `xStar` is a global minimizer, one has
-- `f xStar ≤ f (x̂_{T-1})`; combining this with the normalization inequality
-- `alphaF * f x0 ≤ f xStar` and `0 < f x0` yields `alphaF ≤ exp (-(T - 1))`, hence
-- `(T : ℝ) ≤ 1 + log (1 / alphaF)`.
/-- Theorem 7.5 [Chapter7_1.json:29]: if Algorithm 7.4 terminates at its canonical stopping time
and `xStar` is a global minimizer whose value satisfies the homogeneous-model normalization
`alphaF * f(x₀) ≤ f(xStar)`, then the number `T` of generated restart points is bounded by
`1 + log (1 / alphaF)`. -/
theorem schemeSNRestarting_stopping_time_bound
    (hAlphaF_pos : 0 < alphaF)
    (hInitialValue_pos : 0 < f x0)
    (hxStar : IsMinOn f Set.univ xStar)
    (hOptimalValue_lower : alphaF * f x0 ≤ f xStar) :
    (schemeSNRestartingStoppingTime hTerminate : ℝ) ≤ 1 + Real.log (1 / alphaF) := by
  -- The scalar helper gives the exponential bound needed for the logarithm step.
  have hs_le_log :
      (s : ℝ) ≤ Real.log (1 / alphaF) :=
    (Real.le_log_iff_exp_le (one_div_pos.mpr hAlphaF_pos)).2
      (schemeSNRestarting_exp_stoppingIndex_le_inv_alpha
        (hTerminate := hTerminate) hAlphaF_pos hInitialValue_pos hxStar hOptimalValue_lower)
  -- Rewriting the stopping time as `T = s + 1` finishes the estimate.
  simpa [schemeSNRestartingStoppingTime, Nat.cast_add, add_assoc, add_left_comm, add_comm] using
    add_le_add_left hs_le_log 1

end
