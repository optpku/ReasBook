-- Declarations for this item will be appended below by the statement pipeline.

noncomputable section

open EuclideanSpace (nonnegativeOrthant)
open scoped BigOperators SupportFunction SymmetricBox WithTopConvexAnalysis

variable {n : ℕ} {m : ℕ+}

local notation "E" => EuclideanSpace ℝ (Fin n)
local notation "SignPattern" => Fin n → Bool

/-- Helper for Proposition 7.20: the signed vertices whose convex hull generates the coordinate
boxes `B(aᵢ)`. -/
def signedOrthantVertex (a : Fin (m : ℕ) → E) (p : Fin (m : ℕ) × SignPattern) : E :=
  WithLp.toLp 2 fun j ↦ if p.2 j then a p.1 j else -a p.1 j

/-- Helper for Proposition 7.20: the coordinatewise sign-change map attached to a sign vector. -/
def signDiagonalLinearMap (σ : Fin n → ℝ) : E →ₗ[ℝ] E where
  toFun x := WithLp.toLp 2 fun j ↦ σ j * x j
  map_add' x y := by
    ext j
    simp [mul_add]
  map_smul' c x := by
    ext j
    simp [smul_eq_mul, mul_left_comm]

/-- Helper for Proposition 7.20: each signed vertex lies in the box generated by its underlying
nonnegative vector. -/
lemma signedOrthantVertex_mem_box
    {a : Fin (m : ℕ) → E} (ha : ∀ i : Fin (m : ℕ), a i ∈ nonnegativeOrthant n)
    (p : Fin (m : ℕ) × SignPattern) :
    signedOrthantVertex a p ∈ B((a p.1)) := by
  rw [mem_symmetricBox_iff_abs_le]
  intro j
  have haj : 0 ≤ a p.1 j := by
    simpa using ha p.1 j
  by_cases hp : p.2 j
  · simp [signedOrthantVertex, hp, abs_of_nonneg, haj]
  · simp [signedOrthantVertex, hp, abs_of_nonneg, haj]

/-- Helper for Proposition 7.20: on real scalar coordinates, the inner product is multiplication. -/
lemma real_inner_eq_mul (u v : ℝ) : inner ℝ u v = u * v := by
  simpa using (RCLike.inner_apply' (x := u) (y := v))

/-- Helper for Proposition 7.20: every box `B(aᵢ)` is contained in the convex hull of its signed
vertices. -/
lemma symmetricBox_subset_convexHull_signedOrthantVertices
    {a : Fin (m : ℕ) → E} (ha : ∀ i : Fin (m : ℕ), a i ∈ nonnegativeOrthant n)
    (i : Fin (m : ℕ)) :
    B((a i)) ⊆ convexHull ℝ (Set.range fun ε : SignPattern ↦ signedOrthantVertex a (i, ε)) := by
  let C : Set E := convexHull ℝ (Set.range fun ε : SignPattern ↦ signedOrthantVertex a (i, ε))
  have hC_nonempty : C.Nonempty := by
    refine ⟨signedOrthantVertex a (i, fun _ ↦ true), ?_⟩
    exact subset_convexHull ℝ _ (Set.mem_range_self _)
  have hC_closed : IsClosed C := by
    exact
      (Set.finite_range (fun ε : SignPattern ↦ signedOrthantVertex a (i, ε))).isClosed_convexHull
        ℝ
  have hC_convex : Convex ℝ C := by
    exact convex_convexHull ℝ _
  exact subset_of_supportFunction_le_on_domain (B((a i))) C hC_nonempty hC_closed hC_convex
    fun y hy ↦ by
      have hupper :
          ξ[B((a i))] y ≤ ((∑ j : Fin n, a i j * |y.ofLp j| : ℝ) : EReal) := by
        rw [supportFunction_apply]
        refine sSup_le ?_
        rintro _ ⟨s, hs, rfl⟩
        have hsabs : ∀ j : Fin n, |s j| ≤ a i j := by
          exact mem_symmetricBox_iff_abs_le.mp hs
        have hcoord :
            inner ℝ s y ≤ ∑ j : Fin n, a i j * |y.ofLp j| := by
          rw [PiLp.inner_apply]
          refine Finset.sum_le_sum ?_
          intro j hj
          have hsj : |s j| ≤ a i j := hsabs j
          have haj : 0 ≤ a i j := by
            simpa using ha i j
          calc
            y.ofLp j * s.ofLp j ≤ |y.ofLp j * s.ofLp j| := le_abs_self _
            _ = |y.ofLp j| * |s.ofLp j| := by rw [abs_mul]
            _ ≤ |y.ofLp j| * a i j := by
                  exact mul_le_mul_of_nonneg_left hsj (abs_nonneg _)
            _ = a i j * |y.ofLp j| := by ring
        change (((inner ℝ s y : ℝ) : EReal) ≤ ((∑ j : Fin n, a i j * |y.ofLp j| : ℝ) : EReal))
        exact_mod_cast hcoord
      let εy : SignPattern := fun j ↦ 0 ≤ y j
      have hcoord :
          inner ℝ (signedOrthantVertex a (i, εy)) y = ∑ j : Fin n, a i j * |y.ofLp j| := by
        rw [PiLp.inner_apply]
        refine Finset.sum_congr rfl ?_
        intro j hj
        have haj : 0 ≤ a i j := by
          simpa using ha i j
        by_cases hyj : 0 ≤ y j
        · have hεy : εy j = true := by
            simp [εy, hyj]
          calc
            inner ℝ ((signedOrthantVertex a (i, εy)).ofLp j) (y.ofLp j) =
                inner ℝ (a i j) (y.ofLp j) := by
                  simp [signedOrthantVertex, εy, hyj]
            _ = a i j * y.ofLp j := by
                  simpa using real_inner_eq_mul (a i j) (y.ofLp j)
            _ = a i j * |y.ofLp j| := by rw [abs_of_nonneg hyj]
        · have hεy : εy j = false := by
            simp [εy, hyj]
          have hyj' : y j < 0 := lt_of_not_ge hyj
          calc
            inner ℝ ((signedOrthantVertex a (i, εy)).ofLp j) (y.ofLp j) =
                inner ℝ (-a i j) (y.ofLp j) := by
                  simp [signedOrthantVertex, εy, hyj]
            _ = (-a i j) * y.ofLp j := by
                  simpa using real_inner_eq_mul (-a i j) (y.ofLp j)
            _ = -(a i j * y.ofLp j) := by ring
            _ = a i j * |y.ofLp j| := by
                  rw [abs_of_neg hyj']
                  ring
      have hlower :
          ((∑ j : Fin n, a i j * |y.ofLp j| : ℝ) : EReal) ≤ ξ[C] y := by
        dsimp [C]
        rw [supportFunction_convexHull_eq]
        rw [supportFunction_apply]
        have hmem :
            signedOrthantVertex a (i, εy) ∈
              Set.range fun ε : SignPattern ↦ signedOrthantVertex a (i, ε) :=
          Set.mem_range_self εy
        have hsup :
            (((inner ℝ (signedOrthantVertex a (i, εy)) y : ℝ) : EReal)) ≤
              sSup ((fun g : E ↦ ((inner ℝ g y : ℝ) : EReal)) ''
                Set.range fun ε : SignPattern ↦ signedOrthantVertex a (i, ε)) :=
          le_sSup ⟨signedOrthantVertex a (i, εy), hmem, rfl⟩
        simpa [hcoord] using hsup
      exact hupper.trans hlower

/-- Helper for Proposition 7.20: the sign-symmetric box hull equals the convex hull of the finite
family of signed vertices. -/
lemma signSymmetricConvexHull_eq_convexHull_signedOrthantVertices
    {a : Fin (m : ℕ) → E} (ha : ∀ i : Fin (m : ℕ), a i ∈ nonnegativeOrthant n) :
    signSymmetricConvexHull a = convexHull ℝ (Set.range (signedOrthantVertex a)) := by
  refine Set.Subset.antisymm ?_ ?_
  · rw [signSymmetricConvexHull_def]
    refine convexHull_min ?_ (convex_convexHull ℝ _)
    intro y hy
    rcases Set.mem_iUnion.mp hy with ⟨i, hyi⟩
    have hylocal :
        y ∈ convexHull ℝ (Set.range fun ε : SignPattern ↦ signedOrthantVertex a (i, ε)) :=
      (symmetricBox_subset_convexHull_signedOrthantVertices (a := a) ha i) hyi
    have hsubset_local :
        convexHull ℝ (Set.range fun ε : SignPattern ↦ signedOrthantVertex a (i, ε)) ⊆
          convexHull ℝ (Set.range (signedOrthantVertex a)) :=
      convexHull_mono fun z hz ↦ by
        rcases hz with ⟨ε, rfl⟩
        exact ⟨(i, ε), rfl⟩
    exact hsubset_local hylocal
  · have hverts :
        Set.range (signedOrthantVertex a) ⊆ ⋃ i : Fin (m : ℕ), B((a i)) := by
      rintro _ ⟨p, rfl⟩
      exact Set.mem_iUnion.mpr ⟨p.1, signedOrthantVertex_mem_box (a := a) ha p⟩
    rw [signSymmetricConvexHull_def]
    exact convexHull_mono hverts

/-- Helper for Proposition 7.20: the finite maximum of the weighted absolute-coordinate sums
attached to a family of coefficient vectors. -/
def maxWeightedAbsoluteCoordinateSum (a : Fin (m : ℕ) → E) : E → ℝ :=
  fun x ↦ Finset.univ.sup' Finset.univ_nonempty fun i : Fin (m : ℕ) ↦
    ∑ j : Fin n, a i j * |x j|

/-- Helper for Proposition 7.20: the orthant-restricted objective is the same finite maximum,
with the orthant hypothesis carried separately for later positivity arguments. -/
abbrev maxWeightedAbsoluteCoordinateSumOfOrthant
    (a : Fin (m : ℕ) → E) (_ha : ∀ i : Fin (m : ℕ), a i ∈ nonnegativeOrthant n) : E → ℝ :=
  maxWeightedAbsoluteCoordinateSum a

/-- Helper for Proposition 7.20: the support function of the box hull is the finite maximum of the
weighted absolute-coordinate sums. -/
lemma supportFunction_signSymmetricConvexHull_eq_maxWeightedAbsoluteCoordinateSum
    {a : Fin (m : ℕ) → E} (ha : ∀ i : Fin (m : ℕ), a i ∈ nonnegativeOrthant n) (x : E) :
    ξ[signSymmetricConvexHull a] x =
      (maxWeightedAbsoluteCoordinateSumOfOrthant a ha x : EReal) := by
  let v : Fin (m : ℕ) × SignPattern → E := signedOrthantVertex a
  rw [signSymmetricConvexHull_eq_convexHull_signedOrthantVertices (a := a) ha,
    supportFunction_convexHull_eq]
  let M : ℝ := Finset.univ.sup' Finset.univ_nonempty fun p : Fin (m : ℕ) × SignPattern ↦
    inner ℝ (v p) x
  have hupper : ξ[Set.range v] x ≤ (M : EReal) := by
    rw [supportFunction_apply]
    refine sSup_le ?_
    rintro _ ⟨y, ⟨p, rfl⟩, rfl⟩
    change (((inner ℝ (v p) x : ℝ) : EReal) ≤ (M : EReal))
    exact_mod_cast
      (Finset.le_sup'_of_le (fun q : Fin (m : ℕ) × SignPattern ↦ inner ℝ (v q) x)
        (by simp : p ∈ Finset.univ) le_rfl)
  have hlower : (M : EReal) ≤ ξ[Set.range v] x := by
    obtain ⟨p, -, hp⟩ :=
      Finset.exists_mem_eq_sup' Finset.univ_nonempty
        (fun q : Fin (m : ℕ) × SignPattern ↦ inner ℝ (v q) x)
    rw [supportFunction_apply]
    have hp_mem :
        (((inner ℝ (v p) x : ℝ) : EReal)) ≤
          sSup ((fun g : E ↦ ((inner ℝ g x : ℝ) : EReal)) '' Set.range v) :=
      le_sSup ⟨v p, Set.mem_range_self p, rfl⟩
    have hM : (M : EReal) = (((inner ℝ (v p) x : ℝ) : EReal)) := by
      exact_mod_cast hp
    calc
      (M : EReal) = (((inner ℝ (v p) x : ℝ) : EReal)) := hM
      _ ≤ sSup ((fun g : E ↦ ((inner ℝ g x : ℝ) : EReal)) '' Set.range v) := hp_mem
  have hξ : ξ[Set.range v] x = (M : EReal) := le_antisymm hupper hlower
  have hM_upper : M ≤ maxWeightedAbsoluteCoordinateSumOfOrthant a ha x := by
    dsimp [M]
    exact Finset.sup'_le
      (s := Finset.univ)
      (H := Finset.univ_nonempty)
      (f := fun p : Fin (m : ℕ) × SignPattern ↦ inner ℝ (v p) x)
      (by
        rintro ⟨i, ε⟩ hp
        have hcoord :
            inner ℝ (v (i, ε)) x ≤ ∑ j : Fin n, a i j * |x.ofLp j| := by
          rw [PiLp.inner_apply]
          refine Finset.sum_le_sum ?_
          intro j hj
          have haj : 0 ≤ a i j := by
            simpa using ha i j
          by_cases hε : ε j
          · calc
              inner ℝ ((v (i, ε)).ofLp j) (x.ofLp j) = inner ℝ (a i j) (x.ofLp j) := by
                simp [v, signedOrthantVertex, hε]
              _ = a i j * x.ofLp j := by
                simpa using real_inner_eq_mul (a i j) (x.ofLp j)
              _ ≤ a i j * |x.ofLp j| := by
                exact mul_le_mul_of_nonneg_left (le_abs_self _) haj
          · calc
              inner ℝ ((v (i, ε)).ofLp j) (x.ofLp j) = inner ℝ (-a i j) (x.ofLp j) := by
                simp [v, signedOrthantVertex, hε]
              _ = (-a i j) * x.ofLp j := by
                simpa using real_inner_eq_mul (-a i j) (x.ofLp j)
              _ = -(a i j * x.ofLp j) := by ring
              _ ≤ a i j * |x.ofLp j| := by
                have hneg : -(x.ofLp j) ≤ |x.ofLp j| := by
                  by_cases hxj' : 0 ≤ x.ofLp j
                  · rw [abs_of_nonneg hxj']
                    linarith
                  · have hxj'' : x.ofLp j < 0 := lt_of_not_ge hxj'
                    rw [abs_of_neg hxj'']
                nlinarith [mul_le_mul_of_nonneg_left hneg haj]
        calc
          inner ℝ (v (i, ε)) x ≤ ∑ j : Fin n, a i j * |x.ofLp j| := hcoord
          _ ≤ maxWeightedAbsoluteCoordinateSumOfOrthant a ha x := by
            dsimp [maxWeightedAbsoluteCoordinateSumOfOrthant, maxWeightedAbsoluteCoordinateSum]
            exact
              Finset.le_sup'_of_le (fun k : Fin (m : ℕ) ↦ ∑ j : Fin n, a k j * |x.ofLp j|)
                (by simp : i ∈ Finset.univ) le_rfl)
  have hM_lower : maxWeightedAbsoluteCoordinateSumOfOrthant a ha x ≤ M := by
    dsimp [maxWeightedAbsoluteCoordinateSumOfOrthant, maxWeightedAbsoluteCoordinateSum]
    change
      Finset.univ.sup' Finset.univ_nonempty
          (fun i : Fin (m : ℕ) ↦ ∑ j : Fin n, a i j * |x.ofLp j|) ≤ M
    exact Finset.sup'_le
      (s := Finset.univ)
      (H := Finset.univ_nonempty)
      (f := fun i : Fin (m : ℕ) ↦ ∑ j : Fin n, a i j * |x.ofLp j|)
      (by
        intro i hi
        let εx : SignPattern := fun j ↦ 0 ≤ x j
        have hcoord :
            inner ℝ (v (i, εx)) x = ∑ j : Fin n, a i j * |x.ofLp j| := by
          rw [PiLp.inner_apply]
          refine Finset.sum_congr rfl ?_
          intro j hj
          have haj : 0 ≤ a i j := by
            simpa using ha i j
          by_cases hxj : 0 ≤ x j
          · have hεx : εx j = true := by
              simp [εx, hxj]
            calc
              inner ℝ ((v (i, εx)).ofLp j) (x.ofLp j) = inner ℝ (a i j) (x.ofLp j) := by
                simp [v, signedOrthantVertex, εx, hxj]
              _ = a i j * x.ofLp j := by
                simpa using real_inner_eq_mul (a i j) (x.ofLp j)
              _ = a i j * |x.ofLp j| := by rw [abs_of_nonneg hxj]
          · have hεx : εx j = false := by
              simp [εx, hxj]
            have hxj' : x j < 0 := lt_of_not_ge hxj
            calc
              inner ℝ ((v (i, εx)).ofLp j) (x.ofLp j) = inner ℝ (-a i j) (x.ofLp j) := by
                simp [v, signedOrthantVertex, εx, hxj]
              _ = (-a i j) * x.ofLp j := by
                simpa using real_inner_eq_mul (-a i j) (x.ofLp j)
              _ = -(a i j * x.ofLp j) := by ring
              _ = a i j * |x.ofLp j| := by
                rw [abs_of_neg hxj']
                ring
        calc
          ∑ j : Fin n, a i j * |x.ofLp j| = inner ℝ (v (i, εx)) x := hcoord.symm
          _ ≤ M := by
            exact
              Finset.le_sup'_of_le
                (fun q : Fin (m : ℕ) × SignPattern ↦ inner ℝ (v q) x)
                (by simp [εx] : (i, εx) ∈ Finset.univ) le_rfl)
  exact hξ.trans <| by
    exact_mod_cast le_antisymm hM_upper hM_lower

/-- Proposition 7.20: if `a₁, …, aₘ ∈ ℝⁿ₊` and
`hat f(x) = maxᵢ ∑ⱼ aᵢⱼ |xⱼ|`, then `∂ hat f(0)` is the sign-symmetric convex hull
`Conv (⋃ i, B(aᵢ))`. -/
theorem subdifferential_zero_maxWeightedAbsoluteCoordinateSum_eq_signSymmetricConvexHull
    {a : Fin (m : ℕ) → E} (ha : ∀ i : Fin (m : ℕ), a i ∈ nonnegativeOrthant n) :
    ∂ (fun x : E ↦
        (maxWeightedAbsoluteCoordinateSumOfOrthant a ha x : WithTop ℝ))(0) =
      signSymmetricConvexHull a := by
  have hzero : maxWeightedAbsoluteCoordinateSumOfOrthant a ha 0 = 0 := by
    simp [maxWeightedAbsoluteCoordinateSumOfOrthant, maxWeightedAbsoluteCoordinateSum]
  ext g
  constructor
  · intro hg
    have hQ_nonempty : (signSymmetricConvexHull a).Nonempty := by
      rw [signSymmetricConvexHull_eq_convexHull_signedOrthantVertices (a := a) ha]
      refine ⟨signedOrthantVertex a (default, default), ?_⟩
      exact subset_convexHull ℝ _ (Set.mem_range_self _)
    have hQ_closed : IsClosed (signSymmetricConvexHull a) := by
      rw [signSymmetricConvexHull_eq_convexHull_signedOrthantVertices (a := a) ha]
      exact (Set.finite_range (signedOrthantVertex a)).isClosed_convexHull ℝ
    have hQ_convex : Convex ℝ (signSymmetricConvexHull a) := by
      rw [signSymmetricConvexHull_eq_convexHull_signedOrthantVertices (a := a) ha]
      exact convex_convexHull ℝ _
    have hsingleton :
        ({g} : Set E) ⊆ signSymmetricConvexHull a := by
      exact subset_of_supportFunction_le_on_domain ({g} : Set E) (signSymmetricConvexHull a)
        hQ_nonempty hQ_closed hQ_convex fun y hy ↦ by
          have hy' : inner ℝ g y ≤ maxWeightedAbsoluteCoordinateSumOfOrthant a ha y := by
            simpa [hzero, sub_eq_add_neg] using mem_subdifferential_coe_real_iff.mp hg y
          have hinner :
              ((inner ℝ g y : ℝ) : EReal) ≤ ξ[signSymmetricConvexHull a] y := by
            rw [supportFunction_signSymmetricConvexHull_eq_maxWeightedAbsoluteCoordinateSum
              (a := a) ha y]
            exact_mod_cast hy'
          simpa [supportFunction_apply] using hinner
    simpa using hsingleton (by simp)
  · intro hg
    rw [mem_subdifferential_coe_real_iff]
    intro y
    have hinner :
        ((inner ℝ g y : ℝ) : EReal) ≤ ξ[signSymmetricConvexHull a] y := by
      rw [supportFunction_apply]
      exact le_sSup ⟨g, hg, rfl⟩
    rw [supportFunction_signSymmetricConvexHull_eq_maxWeightedAbsoluteCoordinateSum
      (a := a) ha y] at hinner
    have hreal : inner ℝ g y ≤ maxWeightedAbsoluteCoordinateSumOfOrthant a ha y := by
      exact_mod_cast hinner
    simpa [hzero, sub_eq_add_neg] using hreal
