import IntroductoryLecturesOnConvexOptimization_Nesterov_2004.Compat
import IntroductoryLecturesOnConvexOptimization_Nesterov_2004.Chap02.Theorem_2_6
import IntroductoryLecturesOnConvexOptimization_Nesterov_2004.Chap03.Definition_3_9

-- Declarations for this item will be appended below by the statement pipeline.

open scoped BigOperators Gradient SupportFunction

noncomputable section

universe u v

variable {ι : Type v} [Fintype ι]
variable {M : Type u} [NormedAddCommGroup M] [InnerProductSpace ℝ M]

local notation "Eι" => EuclideanSpace ℝ ι

/- Proposition 7.24 lies in the finite-family pullback-seminorm / smooth-gradient domain.

Sampled owner-style declarations:
- `Matrix.gram` and `Matrix.gram_apply`, the canonical Gram-matrix owner for a finite family in a
  real inner-product space;
- `Seminorm.comp` together with `normSeminorm`, the canonical owner of pullback seminorms;
- `matrixInducedEuclideanSeminorm` in `Chap07/Definition_7_12`, the chapter owner for the same
  pullback-seminorm construction in the matrix-specialized Euclidean case;
- `Seminorm.dualNorm` in `Chap02/Definition_2_5`, the separated dual-norm owner for seminorms;
- `convexC1SeminormSmooth_iff_hessian_quadratic_form_bounded` in `Chap02/Theorem_2_6`, the
  Chapter 2 owner bridge from full Hessian quadratic-form bounds to the smooth-convex class;
- `supportFunction` with notation `ξ[Q]` in `Chap03/Definition_3_9`, the chapter owner for the
  support function of a set.

Best owner abstraction:
- source-facing: Proposition 7.24's gradient estimate controlled by the Gram seminorm generated by
  a finite family `A : ι → M` and by its induced dual seminorm on coefficient space
  `EuclideanSpace ℝ ι`;
- core/canonical: the pullback seminorm of the linear combination map
  `h ↦ ∑ i, h i • A i`;
- bridge/view: the textbook Gram-matrix formula
  `‖h‖ = √(dotProduct h ((Matrix.gram ℝ A).mulVec h))`, the support-function formula for the dual
  seminorm, and the separated `Seminorm.dualNorm` identification.

Primitive data:
- a finite family `A : ι → M`;
- the linear combination map it determines on coefficient space;
- the Hessian quadratic-form bounds in terms of the induced pullback seminorm.

Derived API kept here:
- the induced seminorm owner on `EuclideanSpace ℝ ι`;
- the induced dual seminorm owner on the same coefficient space;
- the bridge from that owner to the textbook Gram formula;
- the source-facing dual-seminorm estimate for the gradient;
- under a stronger separation hypothesis, the companion dual-norm estimate.

Source/core/bridge triage:
- source-facing: the induced dual seminorm and Proposition 7.24's dual-seminorm estimate;
- core/canonical: `familyLinearCombination A` and
  `familyInducedEuclideanSeminorm A := Seminorm.comp (normSeminorm ℝ M) ...`;
- bridge/view: `familyInducedEuclideanSeminorm_eq_sqrt_gram`,
  `familyInducedEuclideanDualSeminorm_apply`, and the separated-seminorm dual-norm companion.

The previous version stated the conclusion as a raw real-valued `sSup` and cited the Chapter 2
smooth-convex bridge while omitting the nonnegativity half of the Hessian hypothesis. This
refinement restores the full Hessian quadratic-form assumptions, keeps a direct source-facing dual
seminorm owner for the possibly degenerate Gram seminorm, and treats both the support-function
formula and the stronger separated `Seminorm.dualNorm` surface only as bridge companions. The
textbook `A₁, …, A_m` formulation is recovered by specializing `ι = Fin m`.
-/

private theorem familyLinearCombination_map_add
    (A : ι → M) (x y : Eι) :
    (∑ i, (x + y) i • A i) =
      (∑ i, x i • A i) + ∑ i, y i • A i := by
  simp [add_smul, Finset.sum_add_distrib]

private theorem familyLinearCombination_map_smul
    (A : ι → M) (a : ℝ) (x : Eι) :
    (∑ i, (a • x) i • A i) = a • ∑ i, x i • A i := by
  -- Pull the common scalar through the finite linear combination.
  simp [smul_smul, Finset.smul_sum]

/-- The linear combination map on coefficient space attached to a finite family
`A : ι → M` in a real inner-product space. -/
def familyLinearCombination (A : ι → M) : Eι →ₗ[ℝ] M where
  toFun h := ∑ i, h i • A i
  map_add' x y := familyLinearCombination_map_add A x y
  map_smul' a x := familyLinearCombination_map_smul A a x

/-- Evaluating `familyLinearCombination A` gives the coefficient combination
`∑ i, h i • A i`. -/
theorem familyLinearCombination_apply
    (A : ι → M) (h : Eι) :
    familyLinearCombination A h = ∑ i, h i • A i := rfl

/-- The Euclidean pullback seminorm on coefficient space induced by the family
`A : ι → M`. -/
abbrev familyInducedEuclideanSeminorm (A : ι → M) : Seminorm ℝ Eι :=
  Seminorm.comp (normSeminorm ℝ M) (familyLinearCombination A)

/-- Evaluating the induced seminorm gives the norm of the family linear combination. -/
theorem familyInducedEuclideanSeminorm_apply
    (A : ι → M) (h : Eι) :
    familyInducedEuclideanSeminorm A h = ‖∑ i, h i • A i‖ :=
  rfl

/-- The dual seminorm induced by the Gram seminorm of a finite family `A : ι → M`, defined for
the possibly degenerate case as the support function of the induced unit ball. -/
def familyInducedEuclideanDualSeminorm (A : ι → M) : Eι → EReal :=
  ξ[{h : Eι | familyInducedEuclideanSeminorm A h ≤ 1}]

/-- Evaluating the induced dual seminorm recovers the support function of the induced unit ball. -/
theorem familyInducedEuclideanDualSeminorm_apply
    (A : ι → M) (g : Eι) :
    familyInducedEuclideanDualSeminorm A g =
      ξ[{h : Eι | familyInducedEuclideanSeminorm A h ≤ 1}] g :=
  rfl

/-- Helper for Proposition 7.24: the affine line `s ↦ x + s • d` has derivative `d`. -/
private theorem line_hasDerivAt (x d : Eι) (t : ℝ) :
    HasDerivAt (fun s : ℝ ↦ x + s • d) d t := by
  -- Differentiate the scalar multiple and then translate by the base point.
  simpa [one_smul] using ((hasDerivAt_id t).smul_const d).const_add x

/-- Helper for Proposition 7.24: scalarizing the gradient along an affine line differentiates to
the corresponding Hessian pairing. -/
private theorem scalarized_gradient_line_hasDerivAt
    {f : Eι → ℝ} (hf_C2 : ContDiff ℝ 2 f) (x d u : Eι) (t : ℝ) :
    HasDerivAt (fun s : ℝ ↦ inner ℝ (∇ f (x + s • d)) u)
      (inner ℝ (hessian f (x + t • d) d) u) t := by
  let D : StrongDual ℝ Eι →L[ℝ] Eι :=
    (InnerProductSpace.toDual ℝ Eι).symm.toContinuousLinearEquiv.toContinuousLinearMap
  have hfderiv : DifferentiableAt ℝ (fderiv ℝ f) (x + t • d) := by
    -- A `C²` function has a differentiable Fréchet derivative field.
    have hcont : ContDiffAt ℝ 1 (fderiv ℝ f) (x + t • d) :=
      (hf_C2.contDiffAt (x := x + t • d)).fderiv_right
        (by norm_num : (1 : WithTop ℕ∞) + 1 ≤ 2)
    exact hcont.differentiableAt one_ne_zero
  have hgrad : DifferentiableAt ℝ (∇ f) (x + t • d) := by
    -- Rewrite the gradient through the Riesz map to differentiate it.
    simpa [gradient, D] using D.differentiableAt.comp (x + t • d) hfderiv
  have hgradLine :
      HasFDerivAt (fun s : ℝ ↦ ∇ f (x + s • d))
        ((hessian f (x + t • d)).comp (ContinuousLinearMap.toSpanSingleton ℝ d)) t := by
    -- Compose the derivative of the gradient with the derivative of the affine line.
    simpa using (hgrad.hasFDerivAt.comp t (line_hasDerivAt x d t).hasFDerivAt)
  let φ : Eι →L[ℝ] ℝ := (InnerProductSpace.toDual ℝ Eι) u
  have hscalar :
      HasFDerivAt (fun s : ℝ ↦ φ (∇ f (x + s • d)))
        (φ.comp ((hessian f (x + t • d)).comp (ContinuousLinearMap.toSpanSingleton ℝ d))) t := by
    -- Postcompose with the scalar functional `v ↦ ⟪v, u⟫`.
    simpa [φ] using ((φ.hasFDerivAt).comp t hgradLine)
  simpa [φ, InnerProductSpace.toDual_apply_apply, real_inner_comm] using hscalar.hasDerivAt

/-- Helper for Proposition 7.24: a positive operator whose quadratic form is bounded by
`L * q(v)^2` also satisfies the mixed pairing bound `|⟪T d, u⟫| ≤ L q(d) q(u)`. -/
private theorem mixed_pairing_le_of_isPositive_and_quadratic_form_bound
    (q : Seminorm ℝ Eι) {L : ℝ} (hL_nonneg : 0 ≤ L)
    {T : Eι →L[ℝ] Eι}
    (hTpos : T.IsPositive)
    (hTupper : ∀ v : Eι, inner ℝ (T v) v ≤ L * (q v) ^ (2 : ℕ)) :
    ∀ d u : Eι, |inner ℝ (T d) u| ≤ L * q d * q u := by
  intro d u
  let a : ℝ := inner ℝ (T u) u
  let b : ℝ := 2 * inner ℝ (T d) u
  let c : ℝ := inner ℝ (T d) d
  have hpoly : ∀ α : ℝ, 0 ≤ a * (α * α) + b * α + c := by
    intro α
    have hnonneg := hTpos.inner_nonneg_left (d + α • u)
    -- Expand the positive quadratic form on `d + α • u` into a scalar quadratic polynomial.
    rw [show inner ℝ (T (d + α • u)) (d + α • u) = a * (α * α) + b * α + c by
      dsimp [a, b, c]
      calc
        inner ℝ (T (d + α • u)) (d + α • u)
            = inner ℝ (T d + α • T u) (d + α • u) := by simp [map_add, map_smul]
        _ = (inner ℝ (T d) d + inner ℝ (T d) (α • u)) +
              (inner ℝ (α • T u) d + inner ℝ (α • T u) (α • u)) := by
              rw [inner_add_right, inner_add_left, inner_add_left]
              ring
        _ = inner ℝ (T d) d + inner ℝ (T d) (α • u) +
              inner ℝ (α • T u) d + inner ℝ (α • T u) (α • u) := by
              ring_nf
        _ = inner ℝ (T d) d + α * inner ℝ (T d) u + α * inner ℝ (T u) d +
              (α * α) * inner ℝ (T u) u := by
              simp [real_inner_smul_right, real_inner_smul_left, mul_assoc]
        _ = inner ℝ (T d) d + α * inner ℝ (T d) u + α * inner ℝ (T d) u +
              (α * α) * inner ℝ (T u) u := by
              rw [show inner ℝ (T u) d = inner ℝ (T d) u by
                calc
                  inner ℝ (T u) d = inner ℝ u (T d) := hTpos.inner_left_eq_inner_right _ _
                  _ = inner ℝ (T d) u := by simpa [real_inner_comm]]
        _ = a * (α * α) + b * α + c := by
              dsimp [a, b, c]
              ring] at hnonneg
    exact hnonneg
  have hdiscr : discrim a b c ≤ 0 := discrim_le_zero hpoly
  have hsq : (inner ℝ (T d) u) ^ (2 : ℕ) ≤ a * c := by
    -- The quadratic discriminant estimate gives the Cauchy--Schwarz bound for the positive form.
    rw [discrim, sq] at hdiscr
    dsimp [b] at hdiscr
    nlinarith
  have hbound_sq : (inner ℝ (T d) u) ^ (2 : ℕ) ≤ (L * q d * q u) ^ (2 : ℕ) := by
    have hd : c ≤ L * (q d) ^ (2 : ℕ) := by
      simpa [c] using hTupper d
    have hu : a ≤ L * (q u) ^ (2 : ℕ) := by
      simpa [a] using hTupper u
    have ha_nonneg : 0 ≤ a := by
      simpa [a] using hTpos.inner_nonneg_left u
    have hc_nonneg : 0 ≤ c := by
      simpa [c] using hTpos.inner_nonneg_left d
    nlinarith
  have habs_sq : |inner ℝ (T d) u| ^ (2 : ℕ) ≤ (L * q d * q u) ^ (2 : ℕ) := by
    simpa [sq_abs] using hbound_sq
  have hR_nonneg : 0 ≤ L * q d * q u := by
    positivity
  -- Compare squares and use nonnegativity of the right-hand side to remove the absolute values.
  nlinarith [abs_nonneg (inner ℝ (T d) u), hR_nonneg, habs_sq]

/-- Helper for Proposition 7.24: when the induced seminorm is separated, its dual norm is attained
on the closed induced unit ball. -/
private theorem familyInduced_dualNorm_attained_on_closedBall
    (A : ι → M)
    [Seminorm.IsNorm (familyInducedEuclideanSeminorm A)]
    (g : Eι) :
    ∃ u ∈ (familyInducedEuclideanSeminorm A).closedBall 0 1,
      inner ℝ g u = (familyInducedEuclideanSeminorm A).dualNorm g ∧
      IsMaxOn (fun v : Eι ↦ inner ℝ g v)
        ((familyInducedEuclideanSeminorm A).closedBall 0 1) u := by
  let q : Seminorm ℝ Eι := familyInducedEuclideanSeminorm A
  obtain ⟨D, hD_pos, hD⟩ := q.exists_norm_le_mul
  have hq_cont : Continuous q := by
    -- The induced seminorm is the norm of a continuous linear combination map.
    simpa [q, familyInducedEuclideanSeminorm] using
      (continuous_norm.comp (LinearMap.continuous_of_finiteDimensional (familyLinearCombination A)))
  have hclosed : IsClosed (q.closedBall 0 1) := by
    rw [q.closedBall_zero_eq_preimage_closedBall]
    exact IsClosed.preimage hq_cont Metric.isClosed_closedBall
  have hsubset : q.closedBall 0 1 ⊆ Metric.closedBall (0 : Eι) D := by
    intro u hu
    rw [Metric.mem_closedBall, dist_eq_norm, sub_zero]
    have hqu : q u ≤ 1 := by
      simpa [Seminorm.mem_closedBall_zero] using hu
    calc
      ‖u‖ ≤ D * q u := hD u
      _ ≤ D * 1 := by
        gcongr
      _ = D := by ring
  have hcompact : IsCompact (q.closedBall 0 1) :=
    (isCompact_closedBall (0 : Eι) D).of_isClosed_subset hclosed hsubset
  have hnonempty : (q.closedBall 0 1).Nonempty := by
    exact ⟨0, by simpa [Seminorm.mem_closedBall_zero]⟩
  have hcont : ContinuousOn (fun v : Eι ↦ inner ℝ g v) (q.closedBall 0 1) := by
    simpa using (continuous_const.inner continuous_id).continuousOn
  obtain ⟨u, hu, huMax⟩ := hcompact.exists_isMaxOn hnonempty hcont
  have himage_bdd :
      BddAbove ((fun v : Eι ↦ inner ℝ g v) '' q.closedBall 0 1) :=
    (hcompact.image (continuous_const.inner continuous_id)).bddAbove
  have himage_nonempty :
      ((fun v : Eι ↦ inner ℝ g v) '' q.closedBall 0 1).Nonempty := by
    exact ⟨inner ℝ g 0, ⟨0, by simpa [Seminorm.mem_closedBall_zero], by simp⟩⟩
  have hsup_le :
      sSup ((fun v : Eι ↦ inner ℝ g v) '' q.closedBall 0 1) ≤ inner ℝ g u := by
    refine csSup_le himage_nonempty ?_
    rintro t ⟨v, hv, rfl⟩
    exact huMax hv
  have hu_le :
      inner ℝ g u ≤ sSup ((fun v : Eι ↦ inner ℝ g v) '' q.closedBall 0 1) := by
    exact le_csSup himage_bdd ⟨u, hu, rfl⟩
  refine ⟨u, hu, ?_, huMax⟩
  rw [Seminorm.dualNorm]
  exact le_antisymm hu_le hsup_le

/-- The induced seminorm attached to `A` is the square root of the quadratic form of the canonical
Gram matrix `Matrix.gram ℝ A`. -/
theorem familyInducedEuclideanSeminorm_eq_sqrt_gram
    (A : ι → M) (h : Eι) :
    familyInducedEuclideanSeminorm A h =
      Real.sqrt (dotProduct h ((Matrix.gram ℝ A).mulVec h)) := by
  have hgram :
      dotProduct h ((Matrix.gram ℝ A).mulVec h) =
        inner ℝ (∑ i, h i • A i) (∑ i, h i • A i) := by
    -- Identify the Gram quadratic form with the squared norm of the family linear combination.
    simpa using (Matrix.star_dotProduct_gram_mulVec (𝕜 := ℝ) A h h)
  -- Rewrite the induced seminorm as the square root of its squared norm and then as the Gram form.
  rw [familyInducedEuclideanSeminorm_apply]
  calc
    ‖∑ i, h i • A i‖ = Real.sqrt (‖∑ i, h i • A i‖ ^ (2 : ℕ)) := by
      rw [Real.sqrt_sq_eq_abs, abs_of_nonneg (norm_nonneg _)]
    _ = Real.sqrt (inner ℝ (∑ i, h i • A i) (∑ i, h i • A i)) := by
      rw [← real_inner_self_eq_norm_sq]
    _ = Real.sqrt (dotProduct h ((Matrix.gram ℝ A).mulVec h)) := by
      rw [hgram.symm]

/-- If the family linear combination map is injective, then the induced Euclidean seminorm is a
genuine norm. -/
theorem familyInducedEuclideanSeminorm_isNorm
    (A : ι → M)
    (hA : Function.Injective (familyLinearCombination A)) :
    Seminorm.IsNorm (familyInducedEuclideanSeminorm A) := by
  refine ⟨?_⟩
  intro h hh
  apply hA
  have hzero : familyLinearCombination A h = 0 := by
    exact norm_eq_zero.mp (by simpa [familyInducedEuclideanSeminorm] using hh)
  simpa using hzero

/-- Under the separation hypothesis, the source-facing induced dual seminorm is the `EReal`-valued
coercion of the canonical separated dual norm. -/
theorem familyInducedEuclideanDualSeminorm_eq_dualNorm
    (A : ι → M)
    [_hA : Seminorm.IsNorm (familyInducedEuclideanSeminorm A)]
    (g : Eι) :
    familyInducedEuclideanDualSeminorm A g =
      ((familyInducedEuclideanSeminorm A).dualNorm g : EReal) := by
  let q : Seminorm ℝ Eι := familyInducedEuclideanSeminorm A
  obtain ⟨u, huBall, huEq, huMax⟩ := familyInduced_dualNorm_attained_on_closedBall A g
  have huSet : q u ≤ 1 := by
    simpa [Seminorm.mem_closedBall_zero] using huBall
  have hgreatestReal :
      IsGreatest ((fun h : Eι ↦ inner ℝ h g) '' {h : Eι | q h ≤ 1}) (inner ℝ u g) := by
    refine ⟨⟨u, huSet, rfl⟩, ?_⟩
    rintro _ ⟨v, hv, rfl⟩
    have hvBall : v ∈ q.closedBall 0 1 := by
      simpa [Seminorm.mem_closedBall_zero] using hv
    simpa [real_inner_comm] using huMax hvBall
  have hgreatestEReal :
      IsGreatest
        ((fun h : Eι ↦ (inner ℝ h g : EReal)) '' {h : Eι | q h ≤ 1})
        (inner ℝ u g : EReal) := by
    simpa only [Set.image_image] using
      (EReal.coe_strictMono.map_isGreatest).2 hgreatestReal
  -- Both sides are the same maximum pairing on the closed induced unit ball.
  calc
    familyInducedEuclideanDualSeminorm A g
        = sSup ((fun h : Eι ↦ (inner ℝ h g : EReal)) '' {h : Eι | q h ≤ 1}) := by
          rw [familyInducedEuclideanDualSeminorm_apply, supportFunction_apply]
    _ = (inner ℝ u g : EReal) := hgreatestEReal.csSup_eq
    _ = (inner ℝ g u : EReal) := by simp [real_inner_comm]
    _ = (q.dualNorm g : EReal) := by
          exact_mod_cast huEq
    _ = ((familyInducedEuclideanSeminorm A).dualNorm g : EReal) := by
          rfl

/-- Helper for Proposition 7.24: a unit-ball pairing bound implies the corresponding upper bound
for the source-facing induced dual seminorm. -/
private theorem familyInducedEuclideanDualSeminorm_le_of_unit_ball_pairing_bound
    (A : ι → M) {g : Eι} {C : ℝ}
    (hC : ∀ u : Eι, familyInducedEuclideanSeminorm A u ≤ 1 → inner ℝ g u ≤ C) :
    familyInducedEuclideanDualSeminorm A g ≤ (C : EReal) := by
  -- Rewrite the source-facing dual seminorm as a support function over the induced unit ball.
  rw [familyInducedEuclideanDualSeminorm_apply, supportFunction_apply]
  refine csSup_le ?_ ?_
  · refine ⟨(0 : EReal), ?_⟩
    refine ⟨0, ?_, ?_⟩
    · simp
    · simp
  · rintro y ⟨u, hu, rfl⟩
    exact EReal.coe_le_coe <| by
      simpa [real_inner_comm] using hC u hu

/-- Helper for Proposition 7.24: the gradient difference has controlled pairing with every vector
in the induced seminorm unit ball. -/
theorem familyInduced_gradient_pairing_le_of_hessian_quadratic_form_bounded
    {f : Eι → ℝ} {p : ℝ} {A : ι → M}
    (hf_C2 : ContDiff ℝ 2 f)
    (hessian_quadratic_form_bounded :
      ∀ y h : Eι,
        0 ≤ inner ℝ (hessian f y h) h ∧
          inner ℝ (hessian f y h) h ≤
            (2 * p - 1) * familyInducedEuclideanSeminorm A h ^ (2 : ℕ))
    {y z u : Eι}
    (hu : familyInducedEuclideanSeminorm A u ≤ 1) :
    inner ℝ (∇ f y - ∇ f z) u ≤
      (2 * p - 1) * familyInducedEuclideanSeminorm A (y - z) := by
  let q : Seminorm ℝ Eι := familyInducedEuclideanSeminorm A
  let L : ℝ := 2 * p - 1
  have hnonneg : ∀ x h : Eι, 0 ≤ inner ℝ (hessian f x h) h := by
    intro x h
    exact (hessian_quadratic_form_bounded x h).1
  have hpos : ∀ x : Eι, (hessian f x).IsPositive := by
    intro x
    -- Package the quadratic-form nonnegativity as positivity of the Hessian operator.
    exact (ContinuousLinearMap.isPositive_iff _).2
      ⟨fderiv_gradient_isSymmetric_of_contDiffAt (hf_C2.contDiffAt (x := x)), hnonneg x⟩
  by_cases hzero : ∀ h : Eι, q h = 0
  · let d : Eι := y - z
    let ψ : ℝ → ℝ := fun t ↦ inner ℝ (∇ f (z + t • d)) u
    have hupper_zero : ∀ x h : Eι, inner ℝ (hessian f x h) h ≤ 0 := by
      intro x h
      simpa [L, q, hzero h] using (hessian_quadratic_form_bounded x h).2
    have hψ_deriv :
        ∀ t ∈ Set.Icc (0 : ℝ) 1,
          HasDerivWithinAt ψ (inner ℝ (hessian f (z + t • d) d) u) (Set.Icc (0 : ℝ) 1) t := by
      intro t ht
      -- Differentiate the scalarized gradient along the segment from `z` to `y`.
      exact (scalarized_gradient_line_hasDerivAt (f := f) hf_C2 z d u t).hasDerivWithinAt
    have hψ_bound :
        ∀ t ∈ Set.Ico (0 : ℝ) 1,
          ‖inner ℝ (hessian f (z + t • d) d) u‖ ≤ 0 := by
      intro t ht
      have hmixed :=
        mixed_pairing_le_of_isPositive_and_quadratic_form_bound
          (q := q) (L := 0) (by norm_num) (hpos (z + t • d))
          (fun v ↦ by simpa using hupper_zero (z + t • d) v) d u
      simpa [q, hzero d, hzero u] using hmixed
    have hsegment := norm_image_sub_le_of_norm_deriv_le_segment_01' (f := ψ) hψ_deriv hψ_bound
    have hrewrite : ψ 1 - ψ 0 = inner ℝ (∇ f y - ∇ f z) u := by
      simp [ψ, d, inner_sub_left]
    have habs : |inner ℝ (∇ f y - ∇ f z) u| ≤ 0 := by
      -- Integrating the zero derivative bound shows every unit-ball pairing vanishes.
      simpa [Real.dist_eq, dist_eq_norm, hrewrite] using hsegment
    have hpair_zero : inner ℝ (∇ f y - ∇ f z) u = 0 := by
      exact abs_eq_zero.mp <| le_antisymm habs (abs_nonneg _)
    have hpair_le : inner ℝ (∇ f y - ∇ f z) u ≤ 0 := by
      simpa [hpair_zero]
    simpa [L, q, d, hzero (y - z)] using hpair_le
  · obtain ⟨w, hw_nonzero⟩ := not_forall.mp hzero
    have hw_pos : 0 < q w := lt_of_le_of_ne (by positivity) (Ne.symm hw_nonzero)
    have hL_nonneg : 0 ≤ L := by
      have hquad := hessian_quadratic_form_bounded z w
      have hupper_nonneg : 0 ≤ L * q w ^ (2 : ℕ) := le_trans hquad.1 hquad.2
      have hw_sq_pos : 0 < q w ^ (2 : ℕ) := by positivity
      nlinarith
    let d : Eι := y - z
    let ψ : ℝ → ℝ := fun t ↦ inner ℝ (∇ f (z + t • d)) u
    have hψ_deriv :
        ∀ t ∈ Set.Icc (0 : ℝ) 1,
          HasDerivWithinAt ψ (inner ℝ (hessian f (z + t • d) d) u) (Set.Icc (0 : ℝ) 1) t := by
      intro t ht
      -- Differentiate the scalarized gradient along the segment from `z` to `y`.
      exact (scalarized_gradient_line_hasDerivAt (f := f) hf_C2 z d u t).hasDerivWithinAt
    have hψ_bound :
        ∀ t ∈ Set.Ico (0 : ℝ) 1,
          ‖inner ℝ (hessian f (z + t • d) d) u‖ ≤ L * q d := by
      intro t ht
      have hmixed :=
        mixed_pairing_le_of_isPositive_and_quadratic_form_bound
          (q := q) (L := L) hL_nonneg (hpos (z + t • d))
          (fun v ↦ (hessian_quadratic_form_bounded (z + t • d) v).2) d u
      have hpu_le : L * q d * q u ≤ L * q d := by
        have hmul : q d * q u ≤ q d := by
          calc
            q d * q u ≤ q d * 1 := by
              gcongr
            _ = q d := by ring
        nlinarith
      exact hmixed.trans hpu_le
    have hsegment := norm_image_sub_le_of_norm_deriv_le_segment_01' (f := ψ) hψ_deriv hψ_bound
    have hrewrite : ψ 1 - ψ 0 = inner ℝ (∇ f y - ∇ f z) u := by
      simp [ψ, d, inner_sub_left]
    have habs : |inner ℝ (∇ f y - ∇ f z) u| ≤ L * q d := by
      -- Integrate the Hessian pairing bound along the segment to control the endpoint pairing.
      simpa [Real.dist_eq, dist_eq_norm, hrewrite] using hsegment
    simpa [L, q, d] using (abs_le.mp habs).2

-- Canonical organization: the source-facing owner is the induced dual seminorm itself, defined
-- without a separation hypothesis through the support function of the induced seminorm unit ball.
-- The companion dual-norm theorem below is the separated bridge obtained through
-- `familyInducedEuclideanDualSeminorm_eq_dualNorm`.
/-- Proposition 7.24 in source-facing owner form: if the Hessian quadratic form of `f` is
nonnegative and bounded above by `(2p - 1)` times the squared pullback seminorm induced by
`A : ι → M`, then the gradient is bounded by the induced dual seminorm of that Gram seminorm. The
surface statement depends only on the explicit coefficient `(2 * p - 1)`, so no separate
assumption `1 ≤ p` is part of the owner API. -/
theorem gradient_familyInducedEuclideanDualSeminorm_le_of_hessian_quadratic_form_bounded
    {f : Eι → ℝ} {p : ℝ} {A : ι → M}
    (hf_C2 : ContDiff ℝ 2 f)
    (hessian_quadratic_form_bounded :
      ∀ y h : Eι,
        0 ≤ inner ℝ (hessian f y h) h ∧
          inner ℝ (hessian f y h) h ≤
            (2 * p - 1) * familyInducedEuclideanSeminorm A h ^ (2 : ℕ)) :
    ∀ y z : Eι,
      familyInducedEuclideanDualSeminorm A (∇ f y - ∇ f z) ≤
        ((2 * p - 1) * familyInducedEuclideanSeminorm A (y - z) : EReal) := by
  intro y z
  -- Bound the source-facing support function by controlling every pairing on the induced unit ball.
  exact
    familyInducedEuclideanDualSeminorm_le_of_unit_ball_pairing_bound (A := A)
      (g := ∇ f y - ∇ f z)
      (C := (2 * p - 1) * familyInducedEuclideanSeminorm A (y - z))
      (fun u hu ↦
        familyInduced_gradient_pairing_le_of_hessian_quadratic_form_bounded
          (A := A) (f := f) (p := p) hf_C2 hessian_quadratic_form_bounded hu)

-- Canonical bridge: once `[Seminorm.IsNorm (familyInducedEuclideanSeminorm A)]` is available,
-- `familyInducedEuclideanDualSeminorm_eq_dualNorm` identifies the source-facing induced dual
-- seminorm with the Chapter 2 owner `(familyInducedEuclideanSeminorm A).dualNorm`.
/-- Under the stronger separation hypothesis on `familyInducedEuclideanSeminorm A`, Proposition
7.24 can be restated with the canonical dual-norm owner. -/
theorem gradient_dualNorm_familyInducedEuclideanSeminorm_le_of_hessian_quadratic_form_bounded
    {f : Eι → ℝ} {p : ℝ} {A : ι → M}
    [_hA : Seminorm.IsNorm (familyInducedEuclideanSeminorm A)]
    (hf_C2 : ContDiff ℝ 2 f)
    (hessian_quadratic_form_bounded :
      ∀ y h : Eι,
        0 ≤ inner ℝ (hessian f y h) h ∧
          inner ℝ (hessian f y h) h ≤
            (2 * p - 1) * familyInducedEuclideanSeminorm A h ^ (2 : ℕ)) :
    ∀ y z : Eι,
      (familyInducedEuclideanSeminorm A).dualNorm (∇ f y - ∇ f z) ≤
        (2 * p - 1) * familyInducedEuclideanSeminorm A (y - z) := by
  intro y z
  have hsource :=
    gradient_familyInducedEuclideanDualSeminorm_le_of_hessian_quadratic_form_bounded
      (A := A) (f := f) (p := p) hf_C2 hessian_quadratic_form_bounded y z
  -- Rewrite the source-facing support-function owner through the separated dual norm.
  rw [familyInducedEuclideanDualSeminorm_eq_dualNorm (A := A)] at hsource
  exact EReal.coe_le_coe_iff.mp hsource

end
