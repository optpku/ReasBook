import IntroductoryLecturesOnConvexOptimization_Nesterov_2004.Compat
import IntroductoryLecturesOnConvexOptimization_Nesterov_2004.Chap07.Definition_7_9

-- Declarations for this item will be appended below by the statement pipeline.

noncomputable section

universe u

/- Algorithm 7.2 lies in the autonomous discrete-trajectory / first-stopping-index domain.

Sampled owner-style declarations:
- `Function.iterate` for autonomous trajectories;
- `gradientMethod` in `Chap01/Algorithm_1_6_1.lean`, where the trajectory is the owner and
  constant-step iteration is only a bridge;
- `NewtonSystem.orbit` in `Chap01/Algorithm_1_7_1.lean`, where a canonical autonomous orbit is
  derived from the update map;
- `ConstrainedLevelMethod.stoppingIndex` in `Chap03/Algorithm_3_11.lean`, where the first
  stopping index is derived canonically from an existence witness via `Nat.find`.

Best owner abstraction:
- source-facing: the relative-scale subgradient approximation trajectory from Algorithm 7.2;
- core/canonical: the autonomous iterate map generated by the explicit update
  `relativeScaleSubgradientApproximationStep` together with the first stopping index derived from
  the stopping predicate;
- bridge/view: the source notation `\hat x_t`, the termination predicate, the stopping time
  `T = s + 1`, and the corresponding stopping inequality.

Primitive data:
- the block length and stopping factor;
- the explicit update map;
- the initial point;
- existence of some index satisfying the stopping predicate.

Derived API:
- the iterate sequence `\hat x_t`;
- the termination predicate that some iterate passes the stopping test;
- the canonical first stopping index `s`;
- the stopping time `T = s + 1`;
- the first-hit characterization of the stopping rule.

The update rule is explicit, so the iterate sequence is canonical and should not be stored as a
primitive field. Likewise, the first stopping index is the canonical least index satisfying the
stopping predicate, so it is derived from an existence witness instead of being stored in a
wrapper. The side conditions `δ ∈ (0, 1)`, `α > 0`, and `γ₀ > 0` do not change the definitional
body of the iterate or stopping rule, so they belong in theorem-level hypotheses rather than as
primitive fields.
-/

/-- The textbook block length
`\hat N = ⌊(e / α²) (1 + 1 / δ)²⌋` used in Algorithm 7.2. -/
def relativeScaleSubgradientApproximationBlockLength (δ α : ℝ) : ℕ :=
  Nat.floor (((Real.exp 1) / (α ^ (2 : ℕ))) * (1 + 1 / δ) ^ (2 : ℕ))

/-- Expanding `relativeScaleSubgradientApproximationBlockLength δ α` recovers the textbook
expression `\hat N = ⌊(e / α²) (1 + 1 / δ)²⌋`. -/
theorem relativeScaleSubgradientApproximationBlockLength_def (δ α : ℝ) :
    relativeScaleSubgradientApproximationBlockLength δ α =
      Nat.floor (((Real.exp 1) / (α ^ (2 : ℕ))) * (1 + 1 / δ) ^ (2 : ℕ)) :=
  rfl

/-- The stopping factor `1 / √e` used in Algorithm 7.2. -/
def relativeScaleSubgradientApproximationStoppingFactor : ℝ :=
  1 / Real.sqrt (Real.exp 1)

/-- Expanding `relativeScaleSubgradientApproximationStoppingFactor` recovers the threshold
`1 / √e` appearing in the stopping test. -/
theorem relativeScaleSubgradientApproximationStoppingFactor_def :
    relativeScaleSubgradientApproximationStoppingFactor = 1 / Real.sqrt (Real.exp 1) :=
  rfl

/-- The single update map
`x ↦ G_{\hat N}((1 / γ₀) f(x))` used by Algorithm 7.2. -/
def relativeScaleSubgradientApproximationStep
    {X : Type u} (G : ℕ → ℝ → X) (f : X → ℝ) (δ α γ0 : ℝ) : X → X :=
  fun x ↦
    G (relativeScaleSubgradientApproximationBlockLength δ α) (aPrioriRadiusEstimate f γ0 x)

/-- Evaluating `relativeScaleSubgradientApproximationStep` at `x` applies
`G_{\hat N}` to the a priori radius estimate `aPrioriRadiusEstimate f γ0 x = (1 / γ₀) f(x)` with
`\hat N = relativeScaleSubgradientApproximationBlockLength δ α`. -/
theorem relativeScaleSubgradientApproximationStep_apply
    {X : Type u} (G : ℕ → ℝ → X) (f : X → ℝ) (δ α γ0 : ℝ) (x : X) :
    relativeScaleSubgradientApproximationStep G f δ α γ0 x =
      G (relativeScaleSubgradientApproximationBlockLength δ α) (aPrioriRadiusEstimate f γ0 x) :=
  rfl

/-- The canonical iterate sequence `\hat x_t` generated by repeatedly applying the Algorithm 7.2
update map, started from the prescribed initial point `x₀`. -/
def relativeScaleSubgradientApproximationIterate
    {X : Type u} (G : ℕ → ℝ → X) (f : X → ℝ) (x0 : X) (δ α γ0 : ℝ) : ℕ → X :=
  fun t ↦ (relativeScaleSubgradientApproximationStep G f δ α γ0)^[t] x0

namespace RelativeScaleSubgradientApproximationNotation

scoped notation:max "x̂[" G:arg "; " f:arg "; " x0:arg " | " δ:arg ", " α:arg ", " γ0:arg "]" =>
  relativeScaleSubgradientApproximationIterate G f x0 δ α γ0

end RelativeScaleSubgradientApproximationNotation

open scoped RelativeScaleSubgradientApproximationNotation

/-- The canonical iterate sequence starts at the prescribed initial point `x₀`. -/
@[simp] theorem relativeScaleSubgradientApproximationIterate_zero
    {X : Type u} (G : ℕ → ℝ → X) (f : X → ℝ) (x0 : X) (δ α γ0 : ℝ) :
    (x̂[G; f; x0 | δ, α, γ0]) 0 = x0 :=
  rfl

/-- The canonical iterate sequence satisfies the Algorithm 7.2 update rule. -/
theorem relativeScaleSubgradientApproximationIterate_succ
    {X : Type u} (G : ℕ → ℝ → X) (f : X → ℝ) (x0 : X) (δ α γ0 : ℝ) (t : ℕ) :
    (x̂[G; f; x0 | δ, α, γ0]) (t + 1) =
      relativeScaleSubgradientApproximationStep G f δ α γ0
        ((x̂[G; f; x0 | δ, α, γ0]) t) := by
  simpa [relativeScaleSubgradientApproximationIterate] using
    Function.iterate_succ_apply' (relativeScaleSubgradientApproximationStep G f δ α γ0) t x0

/-- The stopping predicate from Algorithm 7.2, evaluated at stage `t`. -/
def relativeScaleSubgradientApproximationStoppingCriterion
    {X : Type u} (G : ℕ → ℝ → X) (f : X → ℝ) (x0 : X) (δ α γ0 : ℝ) (t : ℕ) : Prop :=
  f ((x̂[G; f; x0 | δ, α, γ0]) (t + 1)) ≥
    relativeScaleSubgradientApproximationStoppingFactor *
      f ((x̂[G; f; x0 | δ, α, γ0]) t)

/-- Algorithm 7.2 terminates when some stage satisfies the stopping criterion
`f(\hat x_{t+1}) ≥ (1 / √e) f(\hat x_t)`. -/
def relativeScaleSubgradientApproximationTerminates
    {X : Type u} (G : ℕ → ℝ → X) (f : X → ℝ) (x0 : X) (δ α γ0 : ℝ) : Prop :=
  ∃ t : ℕ, relativeScaleSubgradientApproximationStoppingCriterion G f x0 δ α γ0 t

/-- The textbook first stopping index `s`, derived canonically from the least stage satisfying
the Algorithm 7.2 stopping predicate. -/
noncomputable def relativeScaleSubgradientApproximationStoppingIndex
    {X : Type u} {G : ℕ → ℝ → X} {f : X → ℝ} {x0 : X} {δ α γ0 : ℝ}
    (hTerminate : relativeScaleSubgradientApproximationTerminates G f x0 δ α γ0) : ℕ := by
  classical
  exact Nat.find hTerminate

/-- The first stopping index is least with respect to the stopping predicate. -/
theorem relativeScaleSubgradientApproximationStoppingIndex_isLeast
    {X : Type u} {G : ℕ → ℝ → X} {f : X → ℝ} {x0 : X} {δ α γ0 : ℝ}
    (hTerminate : relativeScaleSubgradientApproximationTerminates G f x0 δ α γ0) :
    IsLeast
      {t : ℕ | relativeScaleSubgradientApproximationStoppingCriterion G f x0 δ α γ0 t}
      (relativeScaleSubgradientApproximationStoppingIndex hTerminate) := by
  classical
  simpa [relativeScaleSubgradientApproximationStoppingIndex] using Nat.isLeast_find hTerminate

/-- The stopping test succeeds at the first accepted step. -/
theorem relativeScaleSubgradientApproximationStoppingIndex_spec
    {X : Type u} {G : ℕ → ℝ → X} {f : X → ℝ} {x0 : X} {δ α γ0 : ℝ}
    (hTerminate : relativeScaleSubgradientApproximationTerminates G f x0 δ α γ0) :
    f ((x̂[G; f; x0 | δ, α, γ0])
      (relativeScaleSubgradientApproximationStoppingIndex hTerminate + 1)) ≥
      relativeScaleSubgradientApproximationStoppingFactor *
        f ((x̂[G; f; x0 | δ, α, γ0])
          (relativeScaleSubgradientApproximationStoppingIndex hTerminate)) := by
  simpa [relativeScaleSubgradientApproximationStoppingCriterion] using
    (relativeScaleSubgradientApproximationStoppingIndex_isLeast hTerminate).1

/-- The stopping test fails at every earlier step. -/
theorem relativeScaleSubgradientApproximationStoppingIndex_min
    {X : Type u} {G : ℕ → ℝ → X} {f : X → ℝ} {x0 : X} {δ α γ0 : ℝ}
    (hTerminate : relativeScaleSubgradientApproximationTerminates G f x0 δ α γ0)
    {t : ℕ} (ht : t < relativeScaleSubgradientApproximationStoppingIndex hTerminate) :
    f ((x̂[G; f; x0 | δ, α, γ0]) (t + 1)) <
      relativeScaleSubgradientApproximationStoppingFactor *
        f ((x̂[G; f; x0 | δ, α, γ0]) t) := by
  exact lt_of_not_ge fun hStop ↦
    (not_le_of_gt ht)
      ((relativeScaleSubgradientApproximationStoppingIndex_isLeast hTerminate).2
        (by simpa [relativeScaleSubgradientApproximationStoppingCriterion] using hStop))

/-- The textbook stopping time `T`, defined from the first stopping index `s` by `T = s + 1`. -/
def relativeScaleSubgradientApproximationStoppingTime
    {X : Type u} {G : ℕ → ℝ → X} {f : X → ℝ} {x0 : X} {δ α γ0 : ℝ}
    (hTerminate : relativeScaleSubgradientApproximationTerminates G f x0 δ α γ0) : ℕ :=
  relativeScaleSubgradientApproximationStoppingIndex hTerminate + 1

/-- At the textbook stopping time `T`, the stopping inequality
`f(\hat x_T) ≥ (1 / √e) f(\hat x_{T-1})` holds. -/
theorem relativeScaleSubgradientApproximationStoppingTime_spec
    {X : Type u} {G : ℕ → ℝ → X} {f : X → ℝ} {x0 : X} {δ α γ0 : ℝ}
    (hTerminate : relativeScaleSubgradientApproximationTerminates G f x0 δ α γ0) :
    f ((x̂[G; f; x0 | δ, α, γ0])
      (relativeScaleSubgradientApproximationStoppingTime hTerminate)) ≥
      relativeScaleSubgradientApproximationStoppingFactor *
        f ((x̂[G; f; x0 | δ, α, γ0])
          (relativeScaleSubgradientApproximationStoppingIndex hTerminate)) := by
  simpa [relativeScaleSubgradientApproximationStoppingTime] using
    relativeScaleSubgradientApproximationStoppingIndex_spec hTerminate

end
