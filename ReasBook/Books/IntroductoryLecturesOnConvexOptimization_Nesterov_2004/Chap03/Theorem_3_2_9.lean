import IntroductoryLecturesOnConvexOptimization_Nesterov_2004.Compat
import IntroductoryLecturesOnConvexOptimization_Nesterov_2004.Chap03.Definition_3_49
import IntroductoryLecturesOnConvexOptimization_Nesterov_2004.Chap03.Definition_3_55
import IntroductoryLecturesOnConvexOptimization_Nesterov_2004.Chap03.Lemma_3_2_1
import IntroductoryLecturesOnConvexOptimization_Nesterov_2004.Chap03.Theorem_3_51

-- Declarations for this item will be appended below by the statement pipeline.

noncomputable section

open MeasureTheory
open scoped SubgradientLocalizationMeasure

universe u

section Ambient

variable {E : Type u} [NormedAddCommGroup E] [InnerProductSpace ℝ E]

/-
Theorem 3.2.9 lies in the chapter's localization-radius / inner-ball volume-comparison domain.

Sampled owner-style declarations:
- `subgradientLocalizationMeasure` in `Lemma_3_2_1`, the pointwise localization owner
  `v[g; xStar] x`;
- `bestRadiusUpTo` in `Definition_3_55`, the chapter owner for a finite prefix minimum of real
  radii;
- `inner_ball_radius_le_outer_radius_mul_volume_ratio_rpow_of_convex` in `Theorem_3_51`, the
  intrinsic finite-dimensional radius/volume comparison owner;
- `cuttingHalfspace` in `Definition_3_49`, the canonical one-step retained-cut owner consumed by
  the later recursive localization family.

Best owner abstraction:
- source-facing: the closed-form stage localization set `localizationSet Q xSeq gSeq k` and the
  best localization radius `localization_radius xStar g xSeq k`;
- core/canonical: `subgradientLocalizationMeasure`, `bestRadiusUpTo`, and
  `inner_ball_radius_le_outer_radius_mul_volume_ratio_rpow_of_convex`;
- bridge/view: the nonnegative closed-ball inclusion characterizations of `localization_radius`.

Primitive data:
- the feasible set `Q`;
- the center `xStar`;
- the query sequence `xSeq`;
- either the cut sequence `gSeq` or the chosen subgradient selection `g`.

Derived API:
- membership expansion for `localizationSet`;
- finite-family comparison of `localization_radius` with each pointwise localization measure;
- the nonnegative closed-ball characterization of `localization_radius`;
- the final volume-ratio bound, expressed at the intrinsic finite-dimensional owner level.

The previous Euclidean `ℝⁿ` owner choice was only a display model. The localization set and radius
depend only on the real inner-product-space structure already used by
`subgradientLocalizationMeasure`, so this file now keeps the same source-facing objects at that
intrinsic owner level and leaves the textbook `EuclideanSpace ℝ (Fin n)` statement as a
specialization.
-/

/-- The localization set generated by the first `k + 1` query/cut pairs. -/
def localizationSet
    (Q : Set E) (xSeq gSeq : ℕ → E) (k : ℕ) : Set E :=
  Q ∩ ⋂ i : Fin (k + 1), cuttingHalfspace (xSeq i) (gSeq i)

/-- Membership in the localization set means feasibility in `Q` together with all first-stage
cutting-plane inequalities. -/
-- Proof sketch: unfold `localizationSet`; membership is definitionally the conjunction of
-- belonging to `Q` and satisfying each inequality indexed by `Fin (k + 1)`.
theorem mem_localizationSet_iff
    {Q : Set E} {xSeq gSeq : ℕ → E} {k : ℕ} {x : E} :
    x ∈ localizationSet Q xSeq gSeq k ↔
      x ∈ Q ∧ ∀ i : Fin (k + 1), 0 ≤ inner ℝ (gSeq i) (xSeq i - x) :=
  by
    simp [localizationSet, mem_cuttingHalfspace_iff]

/-- The best localization radius `v_k^*` is the minimum of the first `k + 1` localization
measures. -/
abbrev localization_radius
    (xStar : E) (g : E → E) (xSeq : ℕ → E) (k : ℕ) : ℝ :=
  bestRadiusUpTo (fun i ↦ v[g; xStar] (xSeq i)) k

/-- The best localization radius is bounded above by each individual localization measure from the
first `k + 1` iterates. -/
-- Proof sketch: `localization_radius` is defined as the infimum over the finite family
-- `i ↦ subgradientLocalizationMeasure g xStar (xSeq i)`, so it is at most every member of that
-- family.
theorem localization_radius_le_measure
    {xStar : E} {g : E → E} {xSeq : ℕ → E} {k : ℕ} (i : Fin (k + 1)) :
    localization_radius xStar g xSeq k ≤
      v[g; xStar] (xSeq i) := by
  simpa [localization_radius, bestRadiusUpTo, bestFunctionValueUpTo] using
    (Finite.ciInf_le
      (fun j : Fin (k + 1) ↦ v[g; xStar] (xSeq j))
      i)

/-- Helper for Theorem 3.2.9: if the radius `r` does not exceed the localization measure at `x`,
then the entire closed ball centered at `xStar` with radius `r` satisfies the retained cut
generated by `g x`. -/
-- Proof sketch: rewrite the localization measure as the normalized pairing
-- `⟪g x, x - xStar⟫ / ‖g x‖` when `g x ≠ 0`; then every `y` in the closed ball satisfies
-- `⟪g x, xStar - y⟫ ≥ -‖g x‖ r` by Cauchy-Schwarz, so
-- `⟪g x, x - y⟫ = ⟪g x, x - xStar⟫ + ⟪g x, xStar - y⟫ ≥ 0`.
lemma closedBall_subset_cuttingHalfspace_of_le_localization_measure
    {xStar x : E} {g : E → E} {r : NNReal}
    (hr : (r : ℝ) ≤ v[g; xStar] x) :
    Metric.closedBall xStar r ⊆ cuttingHalfspace x (g x) := by
  intro y hy
  by_cases hgx : g x = 0
  · -- A zero cutting vector produces the trivial halfspace `Set.univ`.
    simp [mem_cuttingHalfspace_iff, hgx]
  · -- In the nonzero case, compare the support pairing against `x - xStar` and `xStar - y`.
    have hmeasure :
        (r : ℝ) ≤ inner ℝ (g x) (x - xStar) / ‖g x‖ := by
      simpa [subgradientLocalizationMeasure_eq_inner_div_norm_of_ne_zero
        (g := g) (xBar := xStar) (x := x) hgx] using hr
    have hnorm_pos : 0 < ‖g x‖ := norm_pos_iff.mpr hgx
    have hmain :
        (r : ℝ) * ‖g x‖ ≤ inner ℝ (g x) (x - xStar) := by
      exact (le_div_iff₀ hnorm_pos).mp hmeasure
    rw [Metric.mem_closedBall] at hy
    have hy_norm : ‖xStar - y‖ ≤ (r : ℝ) := by
      simpa [dist_eq_norm, norm_sub_rev] using hy
    have habs :
        |inner ℝ (g x) (xStar - y)| ≤ ‖g x‖ * ‖xStar - y‖ :=
      abs_real_inner_le_norm (g x) (xStar - y)
    have hinner_ball :
        -(‖g x‖ * (r : ℝ)) ≤ inner ℝ (g x) (xStar - y) := by
      have hleft :
          -(‖g x‖ * ‖xStar - y‖) ≤ inner ℝ (g x) (xStar - y) :=
        (abs_le.mp habs).1
      have hmul :
          ‖g x‖ * ‖xStar - y‖ ≤ ‖g x‖ * (r : ℝ) :=
        mul_le_mul_of_nonneg_left hy_norm (norm_nonneg _)
      linarith
    have hsum :
        0 ≤ inner ℝ (g x) (x - xStar) + inner ℝ (g x) (xStar - y) := by
      linarith
    have hsplit : x - y = (x - xStar) + (xStar - y) := by
      abel
    rw [mem_cuttingHalfspace_iff, hsplit, inner_add_right]
    exact hsum

/-- Helper for Theorem 3.2.9: if the radius-`r` closed ball around `xStar` is contained in the
retained cut generated by `g x`, then `r` is bounded by the localization measure at `x` whenever
`g x` is nonzero. -/
-- Proof sketch: test the cut inclusion at the ray point
-- `xStar + (r / ‖g x‖) • g x`, which lies on the radius-`r` sphere around `xStar`; the cut
-- inequality at that point rewrites to `r * ‖g x‖ ≤ ⟪g x, x - xStar⟫`.
lemma le_localization_measure_of_closedBall_subset_cuttingHalfspace
    {xStar x : E} {g : E → E} {r : NNReal}
    (hgx : g x ≠ 0)
    (hball : Metric.closedBall xStar r ⊆ cuttingHalfspace x (g x)) :
    (r : ℝ) ≤ v[g; xStar] x := by
  have hnorm_pos : 0 < ‖g x‖ := norm_pos_iff.mpr hgx
  let y : E := xStar + (((r : ℝ) / ‖g x‖) • g x)
  have hy_mem : y ∈ Metric.closedBall xStar r := by
    -- The chosen ray point lies exactly at distance `r` from `xStar`.
    rw [Metric.mem_closedBall]
    have hdiv_nonneg : 0 ≤ (r : ℝ) / ‖g x‖ := div_nonneg r.2 (norm_nonneg _)
    have hnorm :
        ‖(((r : ℝ) / ‖g x‖) • g x)‖ = (r : ℝ) := by
      rw [norm_smul]
      rw [Real.norm_of_nonneg hdiv_nonneg]
      field_simp [hnorm_pos.ne']
    have hy_dist : dist y xStar = (r : ℝ) := by
      simpa [y, dist_eq_norm, sub_eq_add_neg, add_comm, add_left_comm, add_assoc] using hnorm
    exact le_of_eq hy_dist
  have hy_cut : y ∈ cuttingHalfspace x (g x) := hball hy_mem
  have hy_inner : 0 ≤ inner ℝ (g x) (x - y) := by
    simpa [mem_cuttingHalfspace_iff] using hy_cut
  have hsplit : x - y = (x - xStar) - (((r : ℝ) / ‖g x‖) • g x) := by
    dsimp [y]
    abel
  have hinner :
      inner ℝ (g x) (x - y) =
        inner ℝ (g x) (x - xStar) - (((r : ℝ) / ‖g x‖) * ‖g x‖ ^ 2) := by
    calc
      inner ℝ (g x) (x - y)
          = inner ℝ (g x) ((x - xStar) - (((r : ℝ) / ‖g x‖) • g x)) := by
              rw [hsplit]
      _ = inner ℝ (g x) (x - xStar) - inner ℝ (g x) ((((r : ℝ) / ‖g x‖) • g x)) := by
            rw [inner_sub_right]
      _ = inner ℝ (g x) (x - xStar) - (((r : ℝ) / ‖g x‖) * ‖g x‖ ^ 2) := by
            rw [inner_smul_right, real_inner_self_eq_norm_sq]
  have hcancel :
      (((r : ℝ) / ‖g x‖) * ‖g x‖ ^ 2) = (r : ℝ) * ‖g x‖ := by
    field_simp [pow_two, hnorm_pos.ne']
  have hbound :
      (r : ℝ) * ‖g x‖ ≤ inner ℝ (g x) (x - xStar) := by
    rw [hinner, hcancel] at hy_inner
    linarith
  have hmeasure :
      (r : ℝ) ≤ inner ℝ (g x) (x - xStar) / ‖g x‖ := by
    exact (le_div_iff₀ hnorm_pos).2 hbound
  simpa [subgradientLocalizationMeasure_eq_inner_div_norm_of_ne_zero
    (g := g) (xBar := xStar) (x := x) hgx] using hmeasure

/-- A closed ball centered at `xStar` with radius at most `v_k^*` is contained in the
localization set after intersecting with `Q`. -/
-- Proof sketch: for each `i ≤ k`, the bound `r ≤ v_k^*` implies `r ≤ v_f(xStar; xᵢ)`, so every
-- point of `Metric.closedBall xStar r` satisfies the `i`-th support inequality. Intersecting with
-- `Q` then supplies the feasibility condition in the definition of `localizationSet`.
theorem closedBall_inter_subset_localizationSet_of_le_localization_radius
    {Q : Set E} {xStar : E} {g : E → E} {xSeq : ℕ → E} {k : ℕ} (r : NNReal)
    (hr : (r : ℝ) ≤ localization_radius xStar g xSeq k) :
    Metric.closedBall xStar r ∩ Q ⊆
      localizationSet Q xSeq (g ∘ xSeq) k := by
  intro y hy
  rw [mem_localizationSet_iff]
  constructor
  · -- The intersection hypothesis already gives feasibility in `Q`.
    exact hy.2
  · -- Each cut follows from the pointwise localization-measure control at that index.
    intro i
    have hri :
        (r : ℝ) ≤ v[g; xStar] (xSeq i) :=
      le_trans hr (localization_radius_le_measure (xStar := xStar) (g := g) (xSeq := xSeq) i)
    have hy_cut :
        y ∈ cuttingHalfspace (xSeq i) (g (xSeq i)) :=
      closedBall_subset_cuttingHalfspace_of_le_localization_measure
        (xStar := xStar) (g := g) (x := xSeq i) (r := r) hri hy.1
    simpa [mem_cuttingHalfspace_iff] using hy_cut

/-- A closed ball centered at `xStar` with radius at most `v_k^*` is contained in the
localization set as soon as that ball is already contained in `Q`. -/
-- Proof sketch: apply
-- `closedBall_inter_subset_localizationSet_of_le_localization_radius` and use the hypothesis
-- `Metric.closedBall xStar r ⊆ Q` to remove the intersection with `Q`.
theorem closedBall_subset_localizationSet_of_le_localization_radius
    {Q : Set E} {xStar : E} {g : E → E} {xSeq : ℕ → E} {k : ℕ} {r : NNReal}
    (hQ : Metric.closedBall xStar r ⊆ Q)
    (hr : (r : ℝ) ≤ localization_radius xStar g xSeq k) :
    Metric.closedBall xStar r ⊆
      localizationSet Q xSeq (g ∘ xSeq) k := by
  intro x hx
  exact closedBall_inter_subset_localizationSet_of_le_localization_radius r hr ⟨hx, hQ hx⟩

/-- If the closed ball of radius `r` around `xStar` is contained in the localization set, then
that radius is bounded by `v_k^*`. -/
-- Proof sketch: from the inclusion in `localizationSet`, every point of the radius-`r` closed
-- ball satisfies each support inequality `⟪g(xᵢ), xᵢ - x⟫ ≥ 0`. For every `i ≤ k`, this is exactly
-- the geometric characterization of the individual localization measure `v_f(xStar; xᵢ)`, so
-- `r ≤ v_f(xStar; xᵢ)` for all `i`. Taking the minimum over `i = 0, ..., k` gives `r ≤ v_k^*`.
theorem le_localization_radius_of_closedBall_subset_localizationSet
    {Q : Set E} {xStar : E} {g : E → E} {xSeq : ℕ → E} {k : ℕ} {r : NNReal}
    (hcut_nonzero : ∀ i : Fin (k + 1), g (xSeq i) ≠ 0)
    (hS :
      Metric.closedBall xStar r ⊆ localizationSet Q xSeq (g ∘ xSeq) k) :
    (r : ℝ) ≤ localization_radius xStar g xSeq k := by
  -- Route correction: the unrestricted converse is false when some cut vector vanishes, so the
  -- nonzero-cut hypothesis records the exact source-faithful regime where the ray test applies.
  rw [localization_radius, bestRadiusUpTo, bestFunctionValueUpTo]
  refine le_ciInf ?_
  intro i
  have hcut :
      Metric.closedBall xStar r ⊆ cuttingHalfspace (xSeq i) (g (xSeq i)) := by
    intro y hy
    have hyS : y ∈ localizationSet Q xSeq (g ∘ xSeq) k := hS hy
    have hyi : 0 ≤ inner ℝ ((g ∘ xSeq) i) (xSeq i - y) :=
      (mem_localizationSet_iff.mp hyS).2 i
    simpa [mem_cuttingHalfspace_iff] using hyi
  exact le_localization_measure_of_closedBall_subset_cuttingHalfspace
    (xStar := xStar) (g := g) (x := xSeq i) (r := r) (hcut_nonzero i) hcut

end Ambient

section FiniteDimensional

variable {E : Type u} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
variable [FiniteDimensional ℝ E] [MeasurableSpace E] [BorelSpace E]

local notation "μ" => (Measure.addHaar : Measure E)

/-- Theorem 3.2.9 at the intrinsic owner level: if `0 < Module.finrank ℝ E`, if the stage set
`localizationSet Q xSeq (g ∘ xSeq) k` is measurable, and if the best localization radius is
already known to stay inside the outer ball of radius `D`, then that radius is bounded by `D`
times the `Module.finrank ℝ E`-th root of the Haar-measure ratio `μ(S_k(X)) / μ(Q)` for
`μ = Measure.addHaar`. Specializing to `E = EuclideanSpace ℝ (Fin n)` with `0 < n`
recovers the textbook `ℝⁿ` statement, since the normalization factor cancels in the ratio. -/
-- Proof sketch: this is the generic inner-ball/outer-ball comparison from `Theorem_3_51`
-- specialized to `Sk = localizationSet Q xSeq (g ∘ xSeq) k` and
-- `vkStar = localization_radius xStar g xSeq k`. The only extra input is that
-- `Metric.closedBall xStar v_k^* ∩ Q` lies in the localization set, which is exactly
-- `closedBall_inter_subset_localizationSet_of_le_localization_radius _ le_rfl`; the updated
-- `Theorem_3_51` also needs the measurability of the stage set and the prior bound
-- `v_k^* ≤ D`, so this owner theorem records those side conditions explicitly.
theorem localization_radius_le_outer_radius_mul_volume_ratio_rpow
    (hdim : 0 < Module.finrank ℝ E)
    {Q : Set E} {xStar : E} {g : E → E} {xSeq : ℕ → E} {k : ℕ} {D : ℝ}
    (hQ_convex : Convex ℝ Q) (hxStar : xStar ∈ Q)
    (hQ_pos : 0 < Measure.real μ Q)
    (hQ_subset : Q ⊆ Metric.closedBall xStar D)
    (hSk_meas : MeasurableSet (localizationSet Q xSeq (g ∘ xSeq) k))
    (hloc_le_D : localization_radius xStar g xSeq k ≤ D) :
    localization_radius xStar g xSeq k ≤
      D *
        Real.rpow
          (Measure.real μ (localizationSet Q xSeq (g ∘ xSeq) k) / Measure.real μ Q)
          (1 / (Module.finrank ℝ E : ℝ)) := by
  -- Route correction: `Theorem_3_51` now expects the stage measurability and the prior outer-
  -- radius bound explicitly, so we pass those owner-side conditions instead of the stale finite-
  -- measure argument order.
  have hD_pos : 0 < D := by
    exact outer_radius_pos_of_positive_measure hdim hxStar hQ_pos hQ_subset
  have hSk_subset :
      localizationSet Q xSeq (g ∘ xSeq) k ⊆ Q := by
    intro x hx
    exact (mem_localizationSet_iff.mp hx).1
  by_cases hloc_nonneg : 0 ≤ localization_radius xStar g xSeq k
  · let r : NNReal := ⟨localization_radius xStar g xSeq k, hloc_nonneg⟩
    have hball :
        Metric.closedBall xStar (localization_radius xStar g xSeq k) ∩ Q ⊆
          localizationSet Q xSeq (g ∘ xSeq) k := by
      simpa [r] using
        (closedBall_inter_subset_localizationSet_of_le_localization_radius
          r le_rfl)
    simpa [r] using
      inner_ball_radius_le_outer_radius_mul_volume_ratio_rpow_of_convex
        hdim hQ_convex hxStar hQ_pos hD_pos hloc_le_D hQ_subset hSk_meas hSk_subset hball
  · have hloc_nonpos : localization_radius xStar g xSeq k ≤ 0 := le_of_not_ge hloc_nonneg
    have hD_nonneg : 0 ≤ D := by
      have hxBall : xStar ∈ Metric.closedBall xStar D := hQ_subset hxStar
      simpa [Metric.mem_closedBall] using hxBall
    have hratio_nonneg :
        0 ≤
          Measure.real μ (localizationSet Q xSeq (g ∘ xSeq) k) /
            Measure.real μ Q := by
      positivity
    have hbound_nonneg :
        0 ≤
          D *
            Real.rpow
              (Measure.real μ (localizationSet Q xSeq (g ∘ xSeq) k) / Measure.real μ Q)
              (1 / (Module.finrank ℝ E : ℝ)) := by
      exact mul_nonneg hD_nonneg (Real.rpow_nonneg hratio_nonneg _)
    exact hloc_nonpos.trans hbound_nonneg

end FiniteDimensional
