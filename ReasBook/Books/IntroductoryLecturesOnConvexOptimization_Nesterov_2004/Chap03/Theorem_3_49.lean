namespace SeparationOracleOutput

/-- A terminal output `some x` is a proposed feasible point, while `none` is the certificate that
the feasible set misses `B∞(0, ε)`. It is correct when it satisfies the corresponding textbook
condition. -/
def IsCorrect
    (output : Option E)
    (problem : FeasibilityProblemWithSeparationOracle E) (ε : ℝ) : Prop :=
  match output with
  | some x => x ∈ problem
  | none => (problem : Set E) ∩ linftyClosedBall ε = ∅

/-- A candidate point output is correct exactly when the proposed point is feasible. -/
@[simp] theorem isCorrect_some_iff
    (problem : FeasibilityProblemWithSeparationOracle E) (ε : ℝ) (x : E) :
    SeparationOracleOutput.IsCorrect (some x) problem ε ↔ x ∈ problem :=
  Iff.rfl

/-- A `none` output is correct exactly when the feasible set is disjoint from the textbook ball
`B∞(0, ε)`. -/
@[simp] theorem isCorrect_none_iff
    (problem : FeasibilityProblemWithSeparationOracle E) (ε : ℝ) :
    SeparationOracleOutput.IsCorrect (none : Option E) problem ε ↔
      (problem : Set E) ∩ linftyClosedBall ε = ∅ :=
  Iff.rfl

end SeparationOracleOutput

/-- A deterministic separation-oracle algorithm chooses each new query from the previous oracle
transcript and, after finitely many calls, returns either a candidate feasible point or a
certificate that the feasible set misses `B∞(0, ε)`. The transcript records only the black-box
observable reply: `none` for a certified feasible query point and `some g` for a separating vector
`g`. -/
structure SeparationOracleAlgorithm (X : Type u) where
  /-- The next query point as a function of the observable oracle transcript accumulated so far. -/
  query : List (X × Option X) → X
  /-- The terminal output computed from the same transcript. -/
  output : List (X × Option X) → Option X

namespace SeparationOracleAlgorithm

variable {X : Type u}

local notation "Transcript" => List (X × Option X)

/-- The length-`k` oracle transcript generated by repeatedly querying the problem's separation
oracle according to the algorithm's deterministic query rule, recording only the observable
black-box replies. -/
def oracleTranscript
    (algorithm : SeparationOracleAlgorithm X)
    (oracle : X → Option X) : ℕ → Transcript
  | 0 => []
  | k + 1 =>
      let transcript := algorithm.oracleTranscript oracle k
      let x := algorithm.query transcript
      transcript ++ [(x, oracle x)]

/-- Helper for Theorem 3.49: the query point chosen after observing the length-`k` transcript. -/
def queryAfter
    (algorithm : SeparationOracleAlgorithm X)
    (oracle : X → Option X) (k : ℕ) : X :=
  algorithm.query (algorithm.oracleTranscript oracle k)

/-- Helper for Theorem 3.49: the terminal output produced after observing the length-`k`
transcript. -/
def outputAfter
    (algorithm : SeparationOracleAlgorithm X)
    (oracle : X → Option X) (k : ℕ) : Option X :=
  algorithm.output (algorithm.oracleTranscript oracle k)

/-- Helper for Theorem 3.49: the separation-oracle transcript starts empty. -/
@[simp] theorem oracleTranscript_zero
    (algorithm : SeparationOracleAlgorithm X)
    (oracle : X → Option X) :
    algorithm.oracleTranscript oracle 0 = [] :=
  rfl

/-- Helper for Theorem 3.49: each successor transcript appends exactly one new query-reply pair.
-/
@[simp] theorem oracleTranscript_succ
    (algorithm : SeparationOracleAlgorithm X)
    (oracle : X → Option X) (k : ℕ) :
    algorithm.oracleTranscript oracle (k + 1) =
      algorithm.oracleTranscript oracle k ++
        [(algorithm.queryAfter oracle k, oracle (algorithm.queryAfter oracle k))] := by
  -- Unfold the one-step transcript recursion and rewrite the next query through `queryAfter`.
  simp [oracleTranscript, queryAfter]

/-- Helper for Theorem 3.49: the length-`k` transcript contains exactly `k` query-reply pairs. -/
theorem oracleTranscript_length
    (algorithm : SeparationOracleAlgorithm X)
    (oracle : X → Option X) :
    ∀ k : ℕ, (algorithm.oracleTranscript oracle k).length = k
  | 0 => by
      -- The empty transcript has length `0`.
      simp
  | k + 1 => by
      -- Each step appends one new pair to the previous transcript.
      rw [oracleTranscript_succ, List.length_append, oracleTranscript_length]
      simp

/-- Helper for Theorem 3.49: if two oracles agree on the replies returned along the first oracle
path up to step `k`, then the resulting observed transcripts agree up to step `k`. -/
theorem oracleTranscript_eq_of_same_query_values
    (algorithm : SeparationOracleAlgorithm X)
    (oracle₁ oracle₂ : X → Option X) :
    ∀ {k : ℕ},
      (∀ j < k,
        oracle₁ (algorithm.queryAfter oracle₁ j) =
          oracle₂ (algorithm.queryAfter oracle₁ j)) →
      algorithm.oracleTranscript oracle₁ k = algorithm.oracleTranscript oracle₂ k
  | 0, _ => by
      -- Both length-`0` transcripts are definitionally empty.
      simp
  | k + 1, hquery => by
      -- First synchronize the prefix transcript, which also synchronizes the next query point.
      have hprefix :
          algorithm.oracleTranscript oracle₁ k = algorithm.oracleTranscript oracle₂ k :=
        oracleTranscript_eq_of_same_query_values algorithm oracle₁ oracle₂
          (k := k) (fun j hj ↦ hquery j (Nat.lt_succ_of_lt hj))
      have hnext_query :
          algorithm.queryAfter oracle₁ k = algorithm.queryAfter oracle₂ k := by
        simp [queryAfter, hprefix]
      have hnext_value :
          oracle₁ (algorithm.queryAfter oracle₂ k) =
            oracle₂ (algorithm.queryAfter oracle₂ k) := by
        simpa [hnext_query] using hquery k (Nat.lt_succ_self k)
      -- Appending the same next query-reply pair yields the same successor transcript.
      rw [oracleTranscript_succ, oracleTranscript_succ, hprefix, hnext_query]
      rw [hnext_value]

/-- Helper for Theorem 3.49: once the queried replies agree along the first oracle path, the
algorithm's terminal outputs also agree at that transcript length. -/
theorem outputAfter_eq_of_same_query_values
    (algorithm : SeparationOracleAlgorithm X)
    (oracle₁ oracle₂ : X → Option X) {k : ℕ}
    (hquery :
      ∀ j < k,
        oracle₁ (algorithm.queryAfter oracle₁ j) =
          oracle₂ (algorithm.queryAfter oracle₁ j)) :
    algorithm.outputAfter oracle₁ k = algorithm.outputAfter oracle₂ k := by
  -- The output rule depends only on the observed transcript, so transcript equality is enough.
  simp [outputAfter, oracleTranscript_eq_of_same_query_values algorithm oracle₁ oracle₂ hquery]

/-- An algorithm solves the feasibility problem within `k` oracle calls when there exists some
transcript length `j ≤ k` after which its output is already a correct feasible point or a correct
no-point-in-ball certificate. -/
def SolvesWithin
    (algorithm : SeparationOracleAlgorithm E)
    (problem : FeasibilityProblemWithSeparationOracle E)
    (ε : ℝ) (k : ℕ) : Prop :=
  ∃ j ≤ k,
    SeparationOracleOutput.IsCorrect
      (algorithm.output
        (algorithm.oracleTranscript (fun x ↦ (problem.oracle x).oracleReply) j))
      problem ε

/-- Solving within `k` calls means producing a correct output after some transcript of length at
most `k`. -/
theorem solvesWithin_iff
    (algorithm : SeparationOracleAlgorithm E)
    (problem : FeasibilityProblemWithSeparationOracle E)
    (ε : ℝ) (k : ℕ) :
    SeparationOracleAlgorithm.SolvesWithin algorithm problem ε k ↔
      ∃ j ≤ k,
        SeparationOracleOutput.IsCorrect
          (algorithm.output
            (algorithm.oracleTranscript (fun x ↦ (problem.oracle x).oracleReply) j))
          problem ε :=
  Iff.rfl

end SeparationOracleAlgorithm

-- Proof sketch: fix an oracle budget `k` below the logarithmic threshold and let an arbitrary
-- deterministic separation-oracle algorithm interact with the resisting-oracle box construction
-- inside `B∞(0, R)`. After `k` calls, the answers are still compatible with a box whose Euclidean
-- inradius is at least `(R / 2) * exp (-k / n)`, hence still larger than `ε`. Using the interior
-- ball assumption, choose a feasible set contained in the remaining uncertainty region so that the
-- algorithm cannot distinguish a genuine feasible point from the alternative that the feasible set
-- misses `B∞(0, ε)`. Therefore each deterministic algorithm with fewer than the threshold many
-- calls admits a corresponding hard instance on which it cannot produce a correct output.
-- LeanSearch note: no dedicated hardness-owner analogue surfaced; the local owners
-- `SeparationOracleAlgorithm.SolvesWithin` and `linftyClosedBall` determine the direct predicate.
/-- A feasibility problem is a hard instance for `algorithm` at radius bound `R`, tolerance `ε`,
and oracle budget `k` when it has nonempty interior, stays inside `B∞(0, R)`, and defeats the
algorithm within `k` oracle calls. -/
def IsHardFeasibilityInstanceFor
    {m : ℕ}
    (algorithm : SeparationOracleAlgorithm (EuclideanSpace ℝ (Fin m)))
    (R ε : ℝ) (k : ℕ)
    (problem : FeasibilityProblemWithSeparationOracle (EuclideanSpace ℝ (Fin m))) : Prop :=
  (interior (problem : Set (EuclideanSpace ℝ (Fin m)))).Nonempty ∧
    ((problem : Set (EuclideanSpace ℝ (Fin m))) ⊆ linftyClosedBall R ∧
      ¬ SeparationOracleAlgorithm.SolvesWithin algorithm problem ε k)

/-- The hard-instance predicate expands to the three source-facing conditions used in Theorem 3.49.
-/
theorem isHardFeasibilityInstanceFor_iff
    {m : ℕ}
    (algorithm : SeparationOracleAlgorithm (EuclideanSpace ℝ (Fin m)))
    (R ε : ℝ) (k : ℕ)
    (problem : FeasibilityProblemWithSeparationOracle (EuclideanSpace ℝ (Fin m))) :
    IsHardFeasibilityInstanceFor algorithm R ε k problem ↔
      (interior (problem : Set (EuclideanSpace ℝ (Fin m)))).Nonempty ∧
        ((problem : Set (EuclideanSpace ℝ (Fin m))) ⊆ linftyClosedBall R ∧
          ¬ SeparationOracleAlgorithm.SolvesWithin algorithm problem ε k) :=
  Iff.rfl

/-- Helper for Theorem 3.49: a strict oracle-budget inequality forces the ambient dimension to be
positive, since the right-hand side collapses to `0` when `m = 0`. -/
theorem positive_dimension_of_short_budget
    {m k : ℕ} {R ε : ℝ}
    (hk : (k : ℝ) < (m : ℝ) * Real.log (R / (2 * ε))) :
    0 < m := by
  by_contra hm
  have hm0 : m = 0 := Nat.eq_zero_of_not_pos hm
  subst hm0
  -- In dimension `0`, the budget bound reads `(k : ℝ) < 0`, impossible for a natural number.
  have hk_nonneg : 0 ≤ (k : ℝ) := by
    exact_mod_cast Nat.zero_le k
  have : ¬ (k : ℝ) < 0 := not_lt.mpr hk_nonneg
  exact this (by simpa using hk)

/-- Helper for Theorem 3.49: the source-faithful midpoint response leaves the current resisting
state unchanged for queries outside the current box, and otherwise keeps the half-box opposite the
queried midpoint side. -/
private def resistingSuccessor
    {m : ℕ} {R : ℝ}
    (hm : 0 < m) (state : FeasibilityResistingOracleState m) (x : EuclideanSpace ℝ (Fin m)) :
    FeasibilityResistingOracleState m := by
  if hx : x ∈ state.currentBox R hm then
    if hmid : (state.currentCenter R hm) (state.nextCoord hm) ≤ x (state.nextCoord hm) then
      exact FeasibilityResistingOracleState.keepLowerHalf state
    else
      exact FeasibilityResistingOracleState.keepUpperHalf state
  else
    exact state

/-- Helper for Theorem 3.49: an outside-box query does not change the resisting state. -/
private theorem resistingSuccessor_eq_self_of_not_mem_currentBox
    {m : ℕ} {R : ℝ}
    (hm : 0 < m) (state : FeasibilityResistingOracleState m) {x : EuclideanSpace ℝ (Fin m)}
    (hx : x ∉ state.currentBox R hm) :
    resistingSuccessor (R := R) hm state x = state := by
  -- The outside-box branch is the identity case of the source update.
  simp [resistingSuccessor, hx]

/-- Helper for Theorem 3.49: an in-box query on or above the active midpoint keeps the lower
child. -/
private theorem resistingSuccessor_eq_keepLowerHalf_of_mem_currentBox
    {m : ℕ} {R : ℝ}
    (hm : 0 < m) (state : FeasibilityResistingOracleState m) {x : EuclideanSpace ℝ (Fin m)}
    (hx : x ∈ state.currentBox R hm)
    (hmid : (state.currentCenter R hm) (state.nextCoord hm) ≤ x (state.nextCoord hm)) :
    resistingSuccessor (R := R) hm state x = FeasibilityResistingOracleState.keepLowerHalf state := by
  -- The midpoint comparison selects the lower descendant exactly as in Algorithm 3.5.
  simp [resistingSuccessor, hx, hmid]

/-- Helper for Theorem 3.49: an in-box query strictly below the active midpoint keeps the upper
child. -/
private theorem resistingSuccessor_eq_keepUpperHalf_of_mem_currentBox
    {m : ℕ} {R : ℝ}
    (hm : 0 < m) (state : FeasibilityResistingOracleState m) {x : EuclideanSpace ℝ (Fin m)}
    (hx : x ∈ state.currentBox R hm)
    (hmid : x (state.nextCoord hm) < (state.currentCenter R hm) (state.nextCoord hm)) :
    resistingSuccessor (R := R) hm state x = FeasibilityResistingOracleState.keepUpperHalf state := by
  -- The strict opposite-side inequality rules out the lower-child branch.
  have hnot : ¬ (state.currentCenter R hm) (state.nextCoord hm) ≤ x (state.nextCoord hm) :=
    not_le_of_gt hmid
  simp [resistingSuccessor, hx, hnot]

/-- Helper for Theorem 3.49: the midpoint of each current coordinate interval lies between the
current lower and upper bounds. -/
private theorem midpoint_currentBounds_mem_interval
    {m : ℕ} {R : ℝ}
    (hR : 0 < R) (hm : 0 < m) (state : FeasibilityResistingOracleState m) (i : Fin m) :
    state.currentLower R hm i ≤
        midpoint ℝ (state.currentLower R hm) (state.currentUpper R hm) i ∧
      midpoint ℝ (state.currentLower R hm) (state.currentUpper R hm) i ≤
        state.currentUpper R hm i := by
  have hcenter_mem : state.currentCenter R hm ∈ state.currentBox R hm := by
    -- The inradius lemma puts the current center inside the current box.
    have hsubset := FeasibilityResistingOracleState.closedBall_subset_currentBox (R := R) hm state
    have hrad_nonneg :
        0 ≤ (R / 2) * Real.rpow (1 / 2 : ℝ) ((state.depth : ℝ) / m) := by
      exact mul_nonneg (by positivity : 0 ≤ R / 2) (Real.rpow_nonneg (by norm_num) _)
    exact hsubset <| by
      change dist (state.currentCenter R hm) (state.currentCenter R hm) ≤
        (R / 2) * Real.rpow (1 / 2 : ℝ) ((state.depth : ℝ) / m)
      simpa using hrad_nonneg
  -- Rewriting the center as the coordinate midpoint exposes the interval bounds.
  rw [currentBox_eq_currentBounds_set (R := R) hm state,
    currentCenter_eq_midpoint_currentBounds (R := R) hm state] at hcenter_mem
  simpa using hcenter_mem i

/-- Helper for Theorem 3.49: the strict current box is the open coordinate box cut out by the
current lower and upper bounds. -/
private def strictCurrentBox
    {m : ℕ} {R : ℝ}
    (hm : 0 < m) (state : FeasibilityResistingOracleState m) :
    Set (EuclideanSpace ℝ (Fin m)) :=
  {x | ∀ i : Fin m, state.currentLower R hm i < x i ∧ x i < state.currentUpper R hm i}

/-- Helper for Theorem 3.49: on the lower-half child, the lower bounds are unchanged. -/
private theorem keepLowerHalf_currentLower_eq
    {m : ℕ} {R : ℝ}
    (hm : 0 < m) (state : FeasibilityResistingOracleState m) :
    (FeasibilityResistingOracleState.keepLowerHalf state).currentLower R hm =
      state.currentLower R hm := by
  rfl

/-- Helper for Theorem 3.49: on the lower-half child, only the active upper bound is updated to
the current midpoint. -/
private theorem keepLowerHalf_currentUpper_eq_update
    {m : ℕ} {R : ℝ}
    (hm : 0 < m) (state : FeasibilityResistingOracleState m) :
    (FeasibilityResistingOracleState.keepLowerHalf state).currentUpper R hm =
      Function.update
        (state.currentUpper R hm)
        (state.nextCoord hm)
        (midpoint ℝ (state.currentLower R hm) (state.currentUpper R hm) (state.nextCoord hm)) := by
  rfl

/-- Helper for Theorem 3.49: on the upper-half child, only the active lower bound is updated to
the current midpoint. -/
private theorem keepUpperHalf_currentLower_eq_update
    {m : ℕ} {R : ℝ}
    (hm : 0 < m) (state : FeasibilityResistingOracleState m) :
    (FeasibilityResistingOracleState.keepUpperHalf state).currentLower R hm =
      Function.update
        (state.currentLower R hm)
        (state.nextCoord hm)
        (midpoint ℝ (state.currentLower R hm) (state.currentUpper R hm) (state.nextCoord hm)) := by
  rfl

/-- Helper for Theorem 3.49: on the upper-half child, the upper bounds are unchanged. -/
private theorem keepUpperHalf_currentUpper_eq
    {m : ℕ} {R : ℝ}
    (hm : 0 < m) (state : FeasibilityResistingOracleState m) :
    (FeasibilityResistingOracleState.keepUpperHalf state).currentUpper R hm =
      state.currentUpper R hm := by
  rfl

/-- Helper for Theorem 3.49: the strict current box is contained in the closed current box. -/
private theorem strictCurrentBox_subset_currentBox
    {m : ℕ} {R : ℝ}
    (hm : 0 < m) (state : FeasibilityResistingOracleState m) :
    strictCurrentBox (R := R) hm state ⊆ state.currentBox R hm := by
  intro x hx
  rw [currentBox_eq_currentBounds_set (R := R) hm state]
  intro i
  exact ⟨(hx i).1.le, (hx i).2.le⟩

/-- Helper for Theorem 3.49: the lower-half child strict box remains inside the parent strict
box. -/
private theorem keepLowerHalf_strictCurrentBox_subset_strictCurrentBox
    {m : ℕ} {R : ℝ}
    (hR : 0 < R) (hm : 0 < m) (state : FeasibilityResistingOracleState m) :
    strictCurrentBox (R := R) hm (FeasibilityResistingOracleState.keepLowerHalf state) ⊆
      strictCurrentBox (R := R) hm state := by
  intro x hx i
  by_cases hi : i = state.nextCoord hm
  · subst hi
    constructor
    · -- The lower bound stays fixed on the retained lower child.
      simpa [keepLowerHalf_currentLower_eq (R := R) hm state] using
        (hx (state.nextCoord hm)).1
    · -- The new midpoint upper bound still lies below the parent's upper bound.
      have hupper_mid :
          x (state.nextCoord hm) <
            midpoint ℝ (state.currentLower R hm) (state.currentUpper R hm) (state.nextCoord hm) := by
        simpa [keepLowerHalf_currentUpper_eq_update (R := R) hm state, Function.update_self] using
          (hx (state.nextCoord hm)).2
      exact lt_of_lt_of_le hupper_mid
        (midpoint_currentBounds_mem_interval (R := R) hR hm state (state.nextCoord hm)).2
  · constructor
    · -- Away from the active coordinate, the lower bounds are unchanged.
      simpa [keepLowerHalf_currentLower_eq (R := R) hm state] using (hx i).1
    · -- Away from the active coordinate, the upper bounds are unchanged as well.
      simpa [keepLowerHalf_currentUpper_eq_update (R := R) hm state, Function.update, hi] using
        (hx i).2

/-- Helper for Theorem 3.49: the upper-half child strict box remains inside the parent strict
box. -/
private theorem keepUpperHalf_strictCurrentBox_subset_strictCurrentBox
    {m : ℕ} {R : ℝ}
    (hR : 0 < R) (hm : 0 < m) (state : FeasibilityResistingOracleState m) :
    strictCurrentBox (R := R) hm (FeasibilityResistingOracleState.keepUpperHalf state) ⊆
      strictCurrentBox (R := R) hm state := by
  intro x hx i
  by_cases hi : i = state.nextCoord hm
  · subst hi
    constructor
    · -- The child midpoint lower bound still lies above the parent's lower bound.
      have hmid_lower :
          midpoint ℝ (state.currentLower R hm) (state.currentUpper R hm) (state.nextCoord hm) <
            x (state.nextCoord hm) := by
        simpa [keepUpperHalf_currentLower_eq_update (R := R) hm state, Function.update_self] using
          (hx (state.nextCoord hm)).1
      exact lt_of_le_of_lt
        (midpoint_currentBounds_mem_interval (R := R) hR hm state (state.nextCoord hm)).1
        hmid_lower
    · -- The upper bound stays fixed on the retained upper child.
      simpa [keepUpperHalf_currentUpper_eq (R := R) hm state] using
        (hx (state.nextCoord hm)).2
  · constructor
    · -- Away from the active coordinate, the lower bounds are unchanged.
      simpa [keepUpperHalf_currentLower_eq_update (R := R) hm state, Function.update, hi] using
        (hx i).1
    · -- Away from the active coordinate, the upper bounds are unchanged too.
      simpa [keepUpperHalf_currentUpper_eq (R := R) hm state] using (hx i).2

/-- Helper for Theorem 3.49: every query point lies outside the strict/open successor box cut out
by the realized midpoint update. -/
private theorem query_not_mem_strictCurrentBox_of_resistingSuccessor
    {m : ℕ} {R : ℝ}
    (hm : 0 < m) (state : FeasibilityResistingOracleState m)
    (x : EuclideanSpace ℝ (Fin m)) :
    x ∉ strictCurrentBox (R := R) hm (resistingSuccessor (R := R) hm state x) := by
  by_cases hx : x ∈ state.currentBox R hm
  · by_cases hmid : (state.currentCenter R hm) (state.nextCoord hm) ≤ x (state.nextCoord hm)
    · rw [resistingSuccessor_eq_keepLowerHalf_of_mem_currentBox (R := R) hm state hx hmid]
      intro hxstrict
      -- On the retained lower child, the query violates the strict upper bound at the split
      -- coordinate.
      have hupper_mid :
          x (state.nextCoord hm) <
            midpoint ℝ (state.currentLower R hm) (state.currentUpper R hm) (state.nextCoord hm) := by
        simpa [keepLowerHalf_currentUpper_eq_update (R := R) hm state, Function.update_self] using
          (hxstrict (state.nextCoord hm)).2
      have hmid' :
          midpoint ℝ (state.currentLower R hm) (state.currentUpper R hm) (state.nextCoord hm) ≤
            x (state.nextCoord hm) := by
        simpa [currentCenter_eq_midpoint_currentBounds (R := R) hm state] using hmid
      exact (not_lt_of_ge hmid') hupper_mid
    · have hlt :
        x (state.nextCoord hm) < (state.currentCenter R hm) (state.nextCoord hm) :=
        lt_of_not_ge hmid
      rw [resistingSuccessor_eq_keepUpperHalf_of_mem_currentBox (R := R) hm state hx hlt]
      intro hxstrict
      -- On the retained upper child, the query violates the strict lower bound at the split
      -- coordinate.
      have hmid_lower :
          midpoint ℝ (state.currentLower R hm) (state.currentUpper R hm) (state.nextCoord hm) <
            x (state.nextCoord hm) := by
        simpa [keepUpperHalf_currentLower_eq_update (R := R) hm state, Function.update_self] using
          (hxstrict (state.nextCoord hm)).1
      have hmid' :
          x (state.nextCoord hm) <
            midpoint ℝ (state.currentLower R hm) (state.currentUpper R hm) (state.nextCoord hm) := by
        simpa [currentCenter_eq_midpoint_currentBounds (R := R) hm state] using hlt
      exact (not_lt_of_ge hmid'.le) hmid_lower
  · rw [resistingSuccessor_eq_self_of_not_mem_currentBox (R := R) hm state hx]
    intro hxstrict
    -- Outside the closed box, the query is automatically outside the stricter open box.
    exact hx (strictCurrentBox_subset_currentBox (R := R) hm state hxstrict)

/-- Helper for Theorem 3.49: the resisting-prefix recursion records only the sequence of midpoint
state updates forced by the algorithm's successive query points. -/
private def resistingPrefixState
    {m : ℕ} {R : ℝ}
    (hm : 0 < m) (algorithm : SeparationOracleAlgorithm (EuclideanSpace ℝ (Fin m)))
    (oracle : EuclideanSpace ℝ (Fin m) → Option (EuclideanSpace ℝ (Fin m))) :
    ℕ → FeasibilityResistingOracleState m
  | 0 => FeasibilityResistingOracleState.initial
  | t + 1 =>
      resistingSuccessor (R := R) hm (resistingPrefixState (R := R) hm algorithm oracle t)
        (algorithm.queryAfter oracle t)

/-- Helper for Theorem 3.49: the resisting-prefix recursion starts from the initial uncertainty
box. -/
@[simp] private theorem resistingPrefixState_zero
    {m : ℕ} {R : ℝ}
    (hm : 0 < m) (algorithm : SeparationOracleAlgorithm (EuclideanSpace ℝ (Fin m)))
    (oracle : EuclideanSpace ℝ (Fin m) → Option (EuclideanSpace ℝ (Fin m))) :
    resistingPrefixState (R := R) hm algorithm oracle 0 = FeasibilityResistingOracleState.initial := by
  simp [resistingPrefixState]

/-- Helper for Theorem 3.49: each successor resisting-prefix state is obtained by applying the
one-step midpoint response to the current query point. -/
@[simp] private theorem resistingPrefixState_succ
    {m : ℕ} {R : ℝ}
    (hm : 0 < m) (algorithm : SeparationOracleAlgorithm (EuclideanSpace ℝ (Fin m)))
    (oracle : EuclideanSpace ℝ (Fin m) → Option (EuclideanSpace ℝ (Fin m))) (t : ℕ) :
    resistingPrefixState (R := R) hm algorithm oracle (t + 1) =
      resistingSuccessor (R := R) hm (resistingPrefixState (R := R) hm algorithm oracle t)
        (algorithm.queryAfter oracle t) := by
  simp [resistingPrefixState]

/-- Helper for Theorem 3.49: later resisting-prefix strict boxes only refine earlier ones. -/
private theorem strictCurrentBox_antitone_along_resistingPrefix
    {m : ℕ} {R : ℝ}
    (hR : 0 < R) (hm : 0 < m)
    (algorithm : SeparationOracleAlgorithm (EuclideanSpace ℝ (Fin m)))
    (oracle : EuclideanSpace ℝ (Fin m) → Option (EuclideanSpace ℝ (Fin m))) :
    ∀ {s t : ℕ}, s ≤ t →
      strictCurrentBox (R := R) hm (resistingPrefixState (R := R) hm algorithm oracle t) ⊆
        strictCurrentBox (R := R) hm (resistingPrefixState (R := R) hm algorithm oracle s)
  | s, 0, hst => by
      have hs : s = 0 := Nat.eq_zero_of_le_zero hst
      subst hs
      intro x hx
      exact hx
  | s, t + 1, hst => by
      by_cases hs : s = t + 1
      · subst hs
        intro x hx
        exact hx
      · have hle : s ≤ t := Nat.le_of_lt_succ (lt_of_le_of_ne hst hs)
        have hstep :
            strictCurrentBox (R := R) hm (resistingPrefixState (R := R) hm algorithm oracle (t + 1)) ⊆
              strictCurrentBox (R := R) hm (resistingPrefixState (R := R) hm algorithm oracle t) := by
          let state := resistingPrefixState (R := R) hm algorithm oracle t
          let query := algorithm.queryAfter oracle t
          rw [resistingPrefixState_succ (R := R) hm algorithm oracle]
          by_cases hx : query ∈ state.currentBox R hm
          · by_cases hmid : (state.currentCenter R hm) (state.nextCoord hm) ≤ query (state.nextCoord hm)
            · simpa [state, query,
                resistingSuccessor_eq_keepLowerHalf_of_mem_currentBox (R := R) hm state hx hmid] using
                keepLowerHalf_strictCurrentBox_subset_strictCurrentBox (R := R) hR hm state
            · have hlt : query (state.nextCoord hm) < (state.currentCenter R hm) (state.nextCoord hm) :=
                lt_of_not_ge hmid
              simpa [state, query,
                resistingSuccessor_eq_keepUpperHalf_of_mem_currentBox (R := R) hm state hx hlt] using
                keepUpperHalf_strictCurrentBox_subset_strictCurrentBox (R := R) hR hm state
          · simpa [state, query,
              resistingSuccessor_eq_self_of_not_mem_currentBox (R := R) hm state hx] using
              (Set.Subset.rfl :
                strictCurrentBox (R := R) hm state ⊆ strictCurrentBox (R := R) hm state)
        exact Set.Subset.trans hstep
          (strictCurrentBox_antitone_along_resistingPrefix (R := R) hR hm algorithm oracle hle)

/-- Helper for Theorem 3.49: every earlier query lies outside the final strict box attached to
the same resisting-prefix path. -/
private theorem queryAfter_not_mem_final_strictCurrentBox_of_lt
    {m : ℕ} {R : ℝ}
    (hR : 0 < R) (hm : 0 < m)
    (algorithm : SeparationOracleAlgorithm (EuclideanSpace ℝ (Fin m)))
    (oracle : EuclideanSpace ℝ (Fin m) → Option (EuclideanSpace ℝ (Fin m)))
    {j T : ℕ} (hj : j < T) :
    algorithm.queryAfter oracle j ∉
      strictCurrentBox (R := R) hm (resistingPrefixState (R := R) hm algorithm oracle T) := by
  have hstep :
      algorithm.queryAfter oracle j ∉
        strictCurrentBox (R := R) hm (resistingPrefixState (R := R) hm algorithm oracle (j + 1)) := by
    simpa [resistingPrefixState_succ (R := R) hm algorithm oracle] using
      query_not_mem_strictCurrentBox_of_resistingSuccessor (R := R) hm
        (resistingPrefixState (R := R) hm algorithm oracle j)
        (algorithm.queryAfter oracle j)
  intro hxfinal
  have hsubset :
      strictCurrentBox (R := R) hm (resistingPrefixState (R := R) hm algorithm oracle T) ⊆
        strictCurrentBox (R := R) hm (resistingPrefixState (R := R) hm algorithm oracle (j + 1)) :=
    strictCurrentBox_antitone_along_resistingPrefix (R := R) hR hm algorithm oracle
      (Nat.succ_le_of_lt hj)
  exact hstep (hsubset hxfinal)

/-- Helper for Theorem 3.49: if the feasible set meets `B∞(0, ε)`, then the certificate output
`none` is incorrect. -/
private theorem not_isCorrect_none_of_intersectsLinftyClosedBall
    {m : ℕ}
    (problem : FeasibilityProblemWithSeparationOracle (EuclideanSpace ℝ (Fin m))) {ε : ℝ}
    (hinter : ((problem : Set (EuclideanSpace ℝ (Fin m))) ∩ linftyClosedBall ε).Nonempty) :
    ¬ SeparationOracleOutput.IsCorrect (none : Option (EuclideanSpace ℝ (Fin m))) problem ε := by
  intro hcorrect
  rcases hinter with ⟨x, hxproblem, hxball⟩
  have hempty :
      (problem : Set (EuclideanSpace ℝ (Fin m))) ∩ linftyClosedBall ε = ∅ :=
    (SeparationOracleOutput.isCorrect_none_iff (problem := problem) (ε := ε)).mp hcorrect
  have hxinter :
      x ∈ (problem : Set (EuclideanSpace ℝ (Fin m))) ∩ linftyClosedBall ε := ⟨hxproblem, hxball⟩
  simpa [hempty] using hxinter

/-- Helper for Theorem 3.49: among `k + 2` pairwise-disjoint problems whose prefix outputs up to
`k` are fixed in advance, at least one problem is not solved within `k` calls. -/
private theorem exists_problem_not_solved_of_commonPrefixOutputs
    {m : ℕ}
    (algorithm : SeparationOracleAlgorithm (EuclideanSpace ℝ (Fin m)))
    {ε : ℝ} {k : ℕ}
    (problem : Fin (k + 2) →
      FeasibilityProblemWithSeparationOracle (EuclideanSpace ℝ (Fin m)))
    (commonOutput : ℕ → Option (EuclideanSpace ℝ (Fin m)))
    (houtput :
      ∀ i j, j ≤ k →
        algorithm.outputAfter (fun x ↦ ((problem i).oracle x).oracleReply) j = commonOutput j)
    (hinter :
      ∀ i, ((problem i : Set (EuclideanSpace ℝ (Fin m))) ∩ linftyClosedBall ε).Nonempty)
    (hdisjoint :
      Pairwise fun i₁ i₂ =>
        Disjoint
          (problem i₁ : Set (EuclideanSpace ℝ (Fin m)))
          (problem i₂ : Set (EuclideanSpace ℝ (Fin m)))) :
    ∃ i, ¬ SeparationOracleAlgorithm.SolvesWithin algorithm (problem i) ε k := by
  classical
  by_contra hnone
  push Not at hnone
  have hsolves :
      ∀ i,
        ∃ j ≤ k,
          SeparationOracleOutput.IsCorrect
            (algorithm.outputAfter (fun x ↦ ((problem i).oracle x).oracleReply) j)
            (problem i) ε := by
    intro i
    simpa [SeparationOracleAlgorithm.SolvesWithin, SeparationOracleAlgorithm.outputAfter] using
      hnone i
  choose j hjle hcorrect using hsolves
  let solvedPrefix : Fin (k + 2) → Fin (k + 1) :=
    fun i ↦ ⟨j i, Nat.lt_succ_of_le (hjle i)⟩
  have hsolvedPrefix_injective : Function.Injective solvedPrefix := by
    intro i₁ i₂ hij
    by_contra hne
    have hj : j i₁ = j i₂ := congrArg Fin.val hij
    have hcorrect₁_common :
        SeparationOracleOutput.IsCorrect (commonOutput (j i₁)) (problem i₁) ε := by
      -- The shared prefix output specializes to the chosen solving index for problem `i₁`.
      simpa [houtput i₁ (j i₁) (hjle i₁)] using hcorrect i₁
    have hcorrect₂_at_j₁ :
        SeparationOracleOutput.IsCorrect
          (algorithm.outputAfter (fun x ↦ ((problem i₂).oracle x).oracleReply) (j i₁))
          (problem i₂) ε := by
      -- Rewriting the chosen index for problem `i₂` along `hij` aligns both solving prefixes.
      simpa [hj] using hcorrect i₂
    have hcorrect₂_common :
        SeparationOracleOutput.IsCorrect (commonOutput (j i₁)) (problem i₂) ε := by
      -- The same shared output is therefore also correct for problem `i₂`.
      simpa [houtput i₂ (j i₁) (hjle i₁)] using hcorrect₂_at_j₁
    by_cases hout : commonOutput (j i₁) = none
    · -- A common `none` output cannot be correct because every feasible set still meets
      -- `B∞(0, ε)`.
      exact
        not_isCorrect_none_of_intersectsLinftyClosedBall (problem := problem i₁) (ε := ε)
          (hinter i₁) <| by
            simpa [hout] using hcorrect₁_common
    · obtain ⟨x, hxout⟩ := Option.ne_none_iff_exists'.mp hout
      -- A common candidate point can solve at most one pairwise-disjoint feasible set.
      have hx₁ : x ∈ problem i₁ :=
        (SeparationOracleOutput.isCorrect_some_iff (problem := problem i₁) (ε := ε) (x := x)).mp
          (by simpa [hxout] using hcorrect₁_common)
      have hx₂ : x ∈ problem i₂ :=
        (SeparationOracleOutput.isCorrect_some_iff (problem := problem i₂) (ε := ε) (x := x)).mp
          (by simpa [hxout] using hcorrect₂_common)
      exact (Set.disjoint_left.mp (hdisjoint hne) hx₁ hx₂)
  have hcard :
      Fintype.card (Fin (k + 2)) ≤ Fintype.card (Fin (k + 1)) :=
    Fintype.card_le_of_injective solvedPrefix hsolvedPrefix_injective
  have : k + 2 ≤ k + 1 := by
    simpa using hcard
  omega

/-- Helper for Theorem 3.49: pairwise equality of all prefix outputs up to `k` is enough to feed
the counting endgame above. -/
private theorem exists_problem_not_solved_of_pairwiseEqualPrefixOutputs
    {m : ℕ}
    (algorithm : SeparationOracleAlgorithm (EuclideanSpace ℝ (Fin m)))
    {ε : ℝ} {k : ℕ}
    (problem : Fin (k + 2) →
      FeasibilityProblemWithSeparationOracle (EuclideanSpace ℝ (Fin m)))
    (houtput :
      ∀ i₁ i₂ j, j ≤ k →
        algorithm.outputAfter (fun x ↦ ((problem i₁).oracle x).oracleReply) j =
          algorithm.outputAfter (fun x ↦ ((problem i₂).oracle x).oracleReply) j)
    (hinter :
      ∀ i, ((problem i : Set (EuclideanSpace ℝ (Fin m))) ∩ linftyClosedBall ε).Nonempty)
    (hdisjoint :
      Pairwise fun i₁ i₂ =>
        Disjoint
          (problem i₁ : Set (EuclideanSpace ℝ (Fin m)))
          (problem i₂ : Set (EuclideanSpace ℝ (Fin m)))) :
    ∃ i, ¬ SeparationOracleAlgorithm.SolvesWithin algorithm (problem i) ε k := by
  let commonOutput : ℕ → Option (EuclideanSpace ℝ (Fin m)) :=
    fun j ↦ algorithm.outputAfter (fun x ↦ ((problem 0).oracle x).oracleReply) j
  -- Fix one prefix-output function and transport the pairwise-equality hypothesis into the
  -- common-output counting lemma.
  refine exists_problem_not_solved_of_commonPrefixOutputs
    (algorithm := algorithm) (problem := problem) (commonOutput := commonOutput) ?_ hinter hdisjoint
  intro i j hj
  simpa [commonOutput] using houtput i 0 j hj

/-- Helper for Theorem 3.49: a point outside a nonempty closed convex set admits a separating
vector in the chapter's retained-halfspace form. -/
private theorem exists_separatingVector_of_nonempty_closedConvex
    {m : ℕ} {S : Set (EuclideanSpace ℝ (Fin m))}
    (hS_nonempty : S.Nonempty) (hS_closed : IsClosed S) (hS_convex : Convex ℝ S)
    {xBar : EuclideanSpace ℝ (Fin m)} (hxBar : xBar ∉ S) :
    ∃ g : EuclideanSpace ℝ (Fin m),
      SeparatesPointFromWith S xBar g (inner ℝ g xBar) := by
  obtain ⟨f, u, hlt, hux⟩ :=
    geometric_hahn_banach_closed_point hS_convex hS_closed hxBar
  let g : EuclideanSpace ℝ (Fin m) := (InnerProductSpace.toDual ℝ _).symm f
  have hlt' : ∀ y ∈ S, inner ℝ y g < u := by
    intro y hy
    have : inner ℝ g y < u := by
      simpa [g] using hlt y hy
    simpa [real_inner_comm] using this
  have hux' : u < inner ℝ xBar g := by
    have : u < inner ℝ g xBar := by
      simpa [g] using hux
    simpa [real_inner_comm] using this
  have hg_ne : g ≠ 0 := by
    intro hg
    rcases hS_nonempty with ⟨y, hy⟩
    have hy_lt : inner ℝ y g < u := hlt' y hy
    have hx_lt : u < inner ℝ xBar g := hux'
    simp [hg] at hy_lt hx_lt
    linarith
  refine ⟨g, (separatesPointFromWith_inner_iff).2 ?_⟩
  refine ⟨hg_ne, ?_⟩
  intro y hy
  rw [mem_cuttingHalfspace_iff]
  have hy_lt : inner ℝ y g < u := hlt' y hy
  have hy_lt' : inner ℝ g y < u := by
    simpa [real_inner_comm] using hy_lt
  have hux'': u < inner ℝ g xBar := by
    simpa [real_inner_comm] using hux'
  have hpos : 0 < inner ℝ g (xBar - y) := by
    rw [inner_sub_right]
    linarith
  exact hpos.le

/-- Helper for Theorem 3.49: the first coordinate direction has unit Euclidean norm in positive
dimension. -/
private theorem firstCoordinateDirection_norm_eq_one
    {m : ℕ} (hm : 0 < m) :
    ‖(EuclideanSpace.single (⟨0, hm⟩ : Fin m) (1 : ℝ) :
      EuclideanSpace ℝ (Fin m))‖ = 1 := by
  simpa [EuclideanSpace.single] using
    (PiLp.norm_single (p := (2 : ENNReal)) (β := fun _ : Fin m => ℝ)
      (⟨0, hm⟩ : Fin m) (1 : ℝ))

/-- Helper for Theorem 3.49: every positive-radius Euclidean closed ball in positive dimension
contains two smaller disjoint closed balls. -/
private theorem exists_two_disjoint_closedSubballs_subset_closedBall
    {m : ℕ} (hm : 0 < m) (c : EuclideanSpace ℝ (Fin m)) {r : ℝ} (hr : 0 < r) :
    ∃ c₁ c₂ : EuclideanSpace ℝ (Fin m), ∃ δ : ℝ,
      0 < δ ∧
        Metric.closedBall c₁ δ ⊆ Metric.closedBall c r ∧
        Metric.closedBall c₂ δ ⊆ Metric.closedBall c r ∧
        Disjoint (Metric.closedBall c₁ δ) (Metric.closedBall c₂ δ) := by
  let i0 : Fin m := ⟨0, hm⟩
  let e : EuclideanSpace ℝ (Fin m) := EuclideanSpace.single i0 (1 : ℝ)
  let c₁ : EuclideanSpace ℝ (Fin m) := c
  let c₂ : EuclideanSpace ℝ (Fin m) := c + (r / 2) • e
  let δ : ℝ := r / 8
  have hδ : 0 < δ := by
    dsimp [δ]
    linarith
  have hsubset₁ : Metric.closedBall c₁ δ ⊆ Metric.closedBall c r := by
    -- The centered child ball fits in the parent ball by shrinking its radius.
    refine Metric.closedBall_subset_closedBall ?_
    dsimp [c₁, δ]
    linarith
  have hdist₂ : dist c₂ c = r / 2 := by
    -- Moving by `(r / 2)` along a unit coordinate direction shifts the center by that distance.
    dsimp [c₂]
    rw [dist_eq_norm]
    have hshift : c + (r / 2) • e - c = (r / 2) • e := by
      simp [sub_eq_add_neg, add_assoc]
    rw [hshift, norm_smul, firstCoordinateDirection_norm_eq_one hm, Real.norm_eq_abs]
    simpa using (abs_of_pos (half_pos hr) : |r / 2| = r / 2)
  have hsubset₂ : Metric.closedBall c₂ δ ⊆ Metric.closedBall c r := by
    -- The shifted child ball still fits because its center moves by `r / 2` and its radius is
    -- only `r / 8`.
    refine Metric.closedBall_subset_closedBall' ?_
    dsimp [δ]
    rw [hdist₂]
    linarith
  have hdisjoint : Disjoint (Metric.closedBall c₁ δ) (Metric.closedBall c₂ δ) := by
    -- The center separation `r / 2` is strictly larger than the sum of the child radii.
    refine Metric.closedBall_disjoint_closedBall ?_
    dsimp [c₁, δ]
    rw [dist_comm, hdist₂]
    linarith
  exact ⟨c₁, c₂, δ, hδ, hsubset₁, hsubset₂, hdisjoint⟩

/-- Helper for Theorem 3.49: from any positive-radius closed ball in positive dimension, one can
choose a smaller closed ball contained in it and avoiding any prescribed point. -/
private theorem exists_closedSubball_avoidsPoint
    {m : ℕ} (hm : 0 < m) (c q : EuclideanSpace ℝ (Fin m)) {r : ℝ} (hr : 0 < r) :
    ∃ c' : EuclideanSpace ℝ (Fin m), ∃ δ : ℝ,
      0 < δ ∧
        Metric.closedBall c' δ ⊆ Metric.closedBall c r ∧
        q ∉ Metric.closedBall c' δ := by
  obtain ⟨c₁, c₂, δ, hδ, hsubset₁, hsubset₂, hdisjoint⟩ :=
    exists_two_disjoint_closedSubballs_subset_closedBall hm c hr
  by_cases hq : q ∈ Metric.closedBall c₁ δ
  · -- If the prescribed point lies in the first child ball, choose the disjoint second child.
    refine ⟨c₂, δ, hδ, hsubset₂, ?_⟩
    intro hq₂
    exact hdisjoint.le_bot ⟨hq, hq₂⟩
  · -- Otherwise the first child ball already avoids the prescribed point.
    exact ⟨c₁, δ, hδ, hsubset₁, hq⟩

/-- Helper for Theorem 3.49: the ambient Euclidean norm dominates the source-facing `ℓ∞` norm. -/
private theorem linftyNorm_le_norm
    {m : ℕ} (x : EuclideanSpace ℝ (Fin m)) :
    ‖x‖∞ ≤ ‖x‖ := by
  -- Rewrite the `ℓ∞` norm as the coordinate sup norm and compare each coordinate with `‖x‖`.
  rw [linftyNorm_eq_coordNorm]
  refine (pi_norm_le_iff_of_nonneg ?_).2 ?_
  · positivity
  · intro i
    simpa using (PiLp.norm_apply_le x i)

/-- Helper for Theorem 3.49: the seed Euclidean ball of radius `ε / 2` already lies inside the
textbook `ℓ∞` ball `B∞(0, ε)`. -/
private theorem closedBall_halfEps_subset_linftyClosedBall
    {m : ℕ} {ε : ℝ}
    (hε : 0 < ε) :
    Metric.closedBall (0 : EuclideanSpace ℝ (Fin m)) (ε / 2) ⊆ linftyClosedBall ε := by
  intro x hx
  -- Compare the `ℓ∞` norm with the Euclidean norm and then use the closed-ball radius bound.
  rw [mem_linftyClosedBall_iff]
  have hx_norm : ‖x‖ ≤ ε / 2 := by
    simpa [Metric.mem_closedBall, dist_eq_norm] using hx
  have hlinfty : ‖x‖∞ ≤ ‖x‖ := linftyNorm_le_norm x
  calc
    ‖x‖∞ ≤ ‖x‖ := hlinfty
    _ ≤ ε / 2 := hx_norm
    _ ≤ ε := by linarith

/-- Helper for Theorem 3.49: if two separation oracles agree on every previously queried reply
along the first oracle path, then the next query point is the same for both oracles. -/
private theorem queryAfter_eq_of_same_query_values
    {m : ℕ}
    (algorithm : SeparationOracleAlgorithm (EuclideanSpace ℝ (Fin m)))
    (oracle₁ oracle₂ :
      EuclideanSpace ℝ (Fin m) → Option (EuclideanSpace ℝ (Fin m)))
    {j : ℕ}
    (hquery :
      ∀ t < j,
        oracle₁ (algorithm.queryAfter oracle₁ t) =
          oracle₂ (algorithm.queryAfter oracle₁ t)) :
    algorithm.queryAfter oracle₁ j = algorithm.queryAfter oracle₂ j := by
  -- The next query depends only on the observed prefix transcript, so transcript equality
  -- synchronizes the query rule.
  have htrans :
      algorithm.oracleTranscript oracle₁ j = algorithm.oracleTranscript oracle₂ j :=
    SeparationOracleAlgorithm.oracleTranscript_eq_of_same_query_values
      algorithm oracle₁ oracle₂ (k := j) hquery
  simp [SeparationOracleAlgorithm.queryAfter, htrans]

/-- Helper for Theorem 3.49: updating a previously unanswered query point does not change any
earlier-or-equal query chosen along an already answered prefix. -/
private theorem queryAfter_eq_of_update_none_on_answeredPrefix
    {m : ℕ}
    (algorithm : SeparationOracleAlgorithm (EuclideanSpace ℝ (Fin m)))
    (oracle : EuclideanSpace ℝ (Fin m) → Option (EuclideanSpace ℝ (Fin m)))
    {q gNew : EuclideanSpace ℝ (Fin m)} {t j : ℕ}
    (hanswered :
      ∀ s < t,
        ∃ g, oracle (algorithm.queryAfter oracle s) = some g)
    (hqnone : oracle q = none)
    (hj : j ≤ t) :
    algorithm.queryAfter (Function.update oracle q (some gNew)) j =
      algorithm.queryAfter oracle j := by
  classical
  have hsync :
      ∀ u : ℕ, u ≤ t →
        algorithm.queryAfter (Function.update oracle q (some gNew)) u =
          algorithm.queryAfter oracle u := by
    intro u
    refine Nat.strong_induction_on u ?_
    intro u ih hu_le
    -- Synchronize the next query by showing that the update leaves every earlier answered reply
    -- unchanged along the updated path.
    refine queryAfter_eq_of_same_query_values algorithm
      (Function.update oracle q (some gNew)) oracle ?_
    intro s hs
    have hs_le_t : s ≤ t := Nat.le_trans (Nat.le_of_lt hs) hu_le
    have hquery_eq :
        algorithm.queryAfter (Function.update oracle q (some gNew)) s =
          algorithm.queryAfter oracle s :=
      ih s hs hs_le_t
    obtain ⟨g, hg⟩ := hanswered s (lt_of_lt_of_le hs hu_le)
    have hq_ne :
        q ≠ algorithm.queryAfter oracle s := by
      intro hq_eq
      have : oracle q = some g := by
        simpa [hq_eq] using hg
      rw [hqnone] at this
      cases this
    -- Rewriting through the synchronized query exposes a plain `Function.update` non-hit.
    rw [hquery_eq]
    by_cases hhit : algorithm.queryAfter oracle s = q
    · exact False.elim (hq_ne hhit.symm)
    · simp [Function.update, hhit]
  exact hsync j hj

/-- Helper for Theorem 3.49: if two replay oracles both reproduce a common reference oracle on
the reference-path queries, then they agree on the queried replies along the first replay path. -/
private theorem same_query_values_of_common_reference
    {m : ℕ}
    (algorithm : SeparationOracleAlgorithm (EuclideanSpace ℝ (Fin m)))
    (oracleRef oracle₁ oracle₂ :
      EuclideanSpace ℝ (Fin m) → Option (EuclideanSpace ℝ (Fin m)))
    {T : ℕ}
    (h₁ :
      ∀ j < T,
        oracle₁ (algorithm.queryAfter oracleRef j) =
          oracleRef (algorithm.queryAfter oracleRef j))
    (h₂ :
      ∀ j < T,
        oracle₂ (algorithm.queryAfter oracleRef j) =
          oracleRef (algorithm.queryAfter oracleRef j)) :
    ∀ j < T,
      oracle₁ (algorithm.queryAfter oracle₁ j) =
        oracle₂ (algorithm.queryAfter oracle₁ j) := by
  intro j hj
  have hsync₁ :
      ∀ t, t ≤ j → algorithm.queryAfter oracle₁ t = algorithm.queryAfter oracleRef t := by
    intro t
    refine Nat.strong_induction_on t ?_
    intro s ih hs_le_j
    -- Rebuild the first replay transcript from the common reference replies on shorter prefixes.
    refine queryAfter_eq_of_same_query_values algorithm oracle₁ oracleRef ?_
    intro m hm
    have hmj : m ≤ j := Nat.le_trans (Nat.le_of_lt hm) hs_le_j
    have hquery_eq :
        algorithm.queryAfter oracle₁ m = algorithm.queryAfter oracleRef m :=
      ih m hm hmj
    have hmT : m < T := lt_of_lt_of_le hm (Nat.le_trans hs_le_j (Nat.le_of_lt hj))
    -- Rewrite the replay-oracle value through the synchronized query and use the reference path.
    rw [hquery_eq]
    exact h₁ m hmT
  have hquery_eq :
      algorithm.queryAfter oracle₁ j = algorithm.queryAfter oracleRef j :=
    hsync₁ j le_rfl
  -- Both replay oracles now evaluate at the same reference query, so the common reference
  -- identifies their returned replies.
  calc
    oracle₁ (algorithm.queryAfter oracle₁ j) =
        oracleRef (algorithm.queryAfter oracleRef j) := by
          rw [hquery_eq]
          exact h₁ j hj
    _ = oracle₂ (algorithm.queryAfter oracleRef j) := by
          symm
          exact h₂ j hj
    _ = oracle₂ (algorithm.queryAfter oracle₁ j) := by
          rw [hquery_eq]

/-- Helper for Theorem 3.49: two replay oracles with the same replies as a common reference
oracle on the reference path produce the same terminal output at that prefix length. -/
private theorem outputAfter_eq_of_commonReferencePrefix
    {m : ℕ}
    (algorithm : SeparationOracleAlgorithm (EuclideanSpace ℝ (Fin m)))
    (oracleRef oracle₁ oracle₂ :
      EuclideanSpace ℝ (Fin m) → Option (EuclideanSpace ℝ (Fin m)))
    {j : ℕ}
    (h₁ :
      ∀ t < j,
        oracle₁ (algorithm.queryAfter oracleRef t) =
          oracleRef (algorithm.queryAfter oracleRef t))
    (h₂ :
      ∀ t < j,
        oracle₂ (algorithm.queryAfter oracleRef t) =
          oracleRef (algorithm.queryAfter oracleRef t)) :
    algorithm.outputAfter oracle₁ j = algorithm.outputAfter oracle₂ j := by
  -- First transfer the common-reference agreement to equality of queried replies along the first
  -- replay path, then invoke the transcript-to-output owner lemma.
  refine SeparationOracleAlgorithm.outputAfter_eq_of_same_query_values algorithm oracle₁ oracle₂ ?_
  exact same_query_values_of_common_reference algorithm oracleRef oracle₁ oracle₂ h₁ h₂

/-- Helper for Theorem 3.49: every positive-radius Euclidean closed ball in positive dimension
contains an explicit family of `k + 2` pairwise-disjoint smaller closed balls. -/
private theorem existsPackedClosedBallFamilyInClosedBall
    {m k : ℕ}
    (hm : 0 < m) (c : EuclideanSpace ℝ (Fin m)) {r : ℝ} (hr : 0 < r) :
    ∃ δ : ℝ, 0 < δ ∧
      ∃ centers : Fin (k + 2) → EuclideanSpace ℝ (Fin m),
        (∀ i, Metric.closedBall (centers i) δ ⊆ Metric.closedBall c r) ∧
        Pairwise fun i₁ i₂ =>
          Disjoint
            (Metric.closedBall (centers i₁) δ)
            (Metric.closedBall (centers i₂) δ) := by
  let e : EuclideanSpace ℝ (Fin m) := EuclideanSpace.single (⟨0, hm⟩ : Fin m) (1 : ℝ)
  let step : ℝ := r / (k + 2 : ℝ)
  let δ : ℝ := step / 4
  let centers : Fin (k + 2) → EuclideanSpace ℝ (Fin m) :=
    fun i ↦ c + (((i : ℝ) * step)) • e
  have hstep_pos : 0 < step := by
    dsimp [step]
    positivity
  have hstep_nonneg : 0 ≤ step := hstep_pos.le
  have hδ : 0 < δ := by
    dsimp [δ]
    linarith
  have hnorm_e : ‖e‖ = 1 := firstCoordinateDirection_norm_eq_one hm
  have hstep_mul : (k + 2 : ℝ) * step = r := by
    dsimp [step]
    field_simp
  have hcenter_dist :
      ∀ i : Fin (k + 2), dist (centers i) c = (i : ℝ) * step := by
    intro i
    -- Each center is shifted from `c` by `(i : ℝ) * step` along the unit first-coordinate axis.
    rw [dist_eq_norm]
    calc
      ‖centers i - c‖ = ‖(((i : ℝ) * step)) • e‖ := by
        simp [centers]
      _ = |(i : ℝ) * step| * ‖e‖ := by rw [norm_smul, Real.norm_eq_abs]
      _ = (i : ℝ) * step := by
        have hnonneg : 0 ≤ (i : ℝ) * step := by positivity
        simp [hnorm_e, abs_of_nonneg hnonneg]
  have hpair_dist :
      ∀ i₁ i₂ : Fin (k + 2),
        dist (centers i₁) (centers i₂) = |(i₁ : ℝ) - (i₂ : ℝ)| * step := by
    intro i₁ i₂
    -- Distances between centers reduce to one-dimensional spacing along the chosen axis.
    rw [dist_eq_norm]
    calc
      ‖centers i₁ - centers i₂‖ = ‖(((i₁ : ℝ) - (i₂ : ℝ)) * step) • e‖ := by
        rw [show centers i₁ - centers i₂ =
            (((i₁ : ℝ) * step) - ((i₂ : ℝ) * step)) • e by
              rw [show centers i₁ = c + (((i₁ : ℝ) * step)) • e by rfl,
                show centers i₂ = c + (((i₂ : ℝ) * step)) • e by rfl,
                add_sub_add_left_eq_sub, ← sub_smul]]
        congr 1
        ring
      _ = |((i₁ : ℝ) - (i₂ : ℝ)) * step| * ‖e‖ := by
        rw [norm_smul, Real.norm_eq_abs]
      _ = |(i₁ : ℝ) - (i₂ : ℝ)| * step := by
        rw [abs_mul, abs_of_nonneg hstep_nonneg, hnorm_e]
        ring
  refine ⟨δ, hδ, centers, ?_, ?_⟩
  · intro i
    -- The `i`-th child ball stays inside the parent because its center is at most
    -- `(i + 1 / 4) * step` away from `c`, and `i + 1 / 4 < k + 2`.
    refine Metric.closedBall_subset_closedBall' ?_
    rw [hcenter_dist]
    have hi_le : (i : ℝ) ≤ (k + 1 : ℝ) := by
      exact_mod_cast Nat.le_of_lt_succ i.is_lt
    have hi_quarter : (i : ℝ) + (1 / 4 : ℝ) ≤ (k + 2 : ℝ) := by
      nlinarith
    have hbound : δ + (i : ℝ) * step ≤ r := by
      calc
        δ + (i : ℝ) * step = ((i : ℝ) + (1 / 4 : ℝ)) * step := by
          dsimp [δ]
          ring
        _ ≤ (k + 2 : ℝ) * step := by
          gcongr
        _ = r := hstep_mul
    simpa [add_comm] using hbound
  · intro i₁ i₂ hne
    -- Distinct centers differ by at least one step, while each child radius is only `step / 4`.
    have habs_one : (1 : ℝ) ≤ |(i₁ : ℝ) - (i₂ : ℝ)| := by
      have hne_val : (i₁ : ℕ) ≠ (i₂ : ℕ) := by
        intro hval
        exact hne (Fin.ext hval)
      by_cases hlt : (i₁ : ℕ) < (i₂ : ℕ)
      · have hdiff : (1 : ℝ) ≤ (i₂ : ℝ) - (i₁ : ℝ) := by
          have hsucc : (i₁ : ℝ) + 1 ≤ (i₂ : ℝ) := by
            exact_mod_cast Nat.succ_le_of_lt hlt
          linarith
        have hnonpos : (i₁ : ℝ) - (i₂ : ℝ) ≤ 0 := by
          linarith
        rw [abs_of_nonpos hnonpos]
        linarith
      · have hgt : (i₂ : ℕ) < (i₁ : ℕ) := by
          exact lt_of_le_of_ne (Nat.le_of_not_lt hlt) (Ne.symm hne_val)
        have hdiff : (1 : ℝ) ≤ (i₁ : ℝ) - (i₂ : ℝ) := by
          have hsucc : (i₂ : ℝ) + 1 ≤ (i₁ : ℝ) := by
            exact_mod_cast Nat.succ_le_of_lt hgt
          linarith
        have hnonneg : 0 ≤ (i₁ : ℝ) - (i₂ : ℝ) := by
          linarith
        rw [abs_of_nonneg hnonneg]
        exact hdiff
    have hstep_le_dist : step ≤ dist (centers i₁) (centers i₂) := by
      rw [hpair_dist]
      nlinarith
    refine Metric.closedBall_disjoint_closedBall ?_
    calc
      δ + δ = step / 2 := by
        dsimp [δ]
        ring
      _ < step := by linarith
      _ ≤ dist (centers i₁) (centers i₂) := hstep_le_dist

/-- Helper for Theorem 3.49: by updating only freshly unanswered queries, one can build a
pointwise reference oracle whose queried prefix is fully supported by separating vectors while a
positive-radius protected closed ball remains inside the seed ball `Metric.closedBall 0 (ε / 2)`.
-/
private theorem exists_supportedReferenceOracleOnProtectedClosedBall
    {m : ℕ}
    (algorithm : SeparationOracleAlgorithm (EuclideanSpace ℝ (Fin m)))
    (hm : 0 < m) {ε : ℝ} (hε : 0 < ε) {k : ℕ} :
    ∃ oracleRef : EuclideanSpace ℝ (Fin m) → Option (EuclideanSpace ℝ (Fin m)),
      ∃ c : EuclideanSpace ℝ (Fin m), ∃ r : ℝ,
        0 < r ∧
          Metric.closedBall c r ⊆ Metric.closedBall 0 (ε / 2) ∧
            (∀ {x g}, oracleRef x = some g →
              x ∉ Metric.closedBall c r ∧
                g ≠ 0 ∧
                  Metric.closedBall c r ⊆ cuttingHalfspace x g) ∧
            (∀ j < k, ∃ g, oracleRef (algorithm.queryAfter oracleRef j) = some g) := by
  have hbuild :
      ∀ t ≤ k,
        ∃ oracleRef : EuclideanSpace ℝ (Fin m) → Option (EuclideanSpace ℝ (Fin m)),
          ∃ c : EuclideanSpace ℝ (Fin m), ∃ r : ℝ,
            0 < r ∧
              Metric.closedBall c r ⊆ Metric.closedBall 0 (ε / 2) ∧
                (∀ {x g}, oracleRef x = some g →
                  x ∉ Metric.closedBall c r ∧
                    g ≠ 0 ∧
                      Metric.closedBall c r ⊆ cuttingHalfspace x g) ∧
                (∀ j < t, ∃ g, oracleRef (algorithm.queryAfter oracleRef j) = some g) := by
    intro t
    induction t with
    | zero =>
        intro hk0
        refine ⟨fun _ ↦ none, 0, ε / 2, by positivity, Set.Subset.rfl, ?_, ?_⟩
        · intro x g hx
          cases hx
        · intro j hj
          exact False.elim (Nat.not_lt_zero _ hj)
    | succ t iht =>
        intro htk
        have htk' : t ≤ k := Nat.le_of_succ_le htk
        rcases iht htk' with ⟨oracle, c, r, hr, hseed, hsupport, hanswered⟩
        let q : EuclideanSpace ℝ (Fin m) := algorithm.queryAfter oracle t
        cases hq : oracle q with
        | some gOld =>
            refine ⟨oracle, c, r, hr, hseed, hsupport, ?_⟩
            intro j hj
            rcases Nat.lt_or_eq_of_le (Nat.le_of_lt_succ hj) with hjt | rfl
            · exact hanswered j hjt
            · exact ⟨gOld, by simpa [q] using hq⟩
        | none =>
            have hnextBall :
                ∃ c' : EuclideanSpace ℝ (Fin m), ∃ r' : ℝ,
                  0 < r' ∧
                    Metric.closedBall c' r' ⊆ Metric.closedBall c r ∧
                    q ∉ Metric.closedBall c' r' := by
              by_cases hqmem : q ∈ Metric.closedBall c r
              · rcases exists_closedSubball_avoidsPoint hm c q hr with
                  ⟨c', r', hr', hsubset, hqout⟩
                exact ⟨c', r', hr', hsubset, hqout⟩
              · exact ⟨c, r, hr, Set.Subset.rfl, hqmem⟩
            rcases hnextBall with ⟨c', r', hr', hsubset', hqout'⟩
            have hnonempty : (Metric.closedBall c' r').Nonempty := by
              exact ⟨c', Metric.mem_closedBall_self hr'.le⟩
            obtain ⟨gNew, hsep⟩ :=
              exists_separatingVector_of_nonempty_closedConvex
                hnonempty Metric.isClosed_closedBall (convex_closedBall c' r') hqout'
            have hgNew_ne : gNew ≠ 0 := (separatesPointFromWith_inner_iff.mp hsep).1
            have hcut' :
                Metric.closedBall c' r' ⊆ cuttingHalfspace q gNew :=
              (separatesPointFromWith_inner_iff.mp hsep).2
            let oracleRef : EuclideanSpace ℝ (Fin m) → Option (EuclideanSpace ℝ (Fin m)) :=
              Function.update oracle q (some gNew)
            have hquery_eq :
                ∀ j : ℕ, j ≤ t →
                  algorithm.queryAfter oracleRef j = algorithm.queryAfter oracle j := by
              intro j hj
              -- Updating a fresh unanswered query point preserves the entire answered prefix.
              exact
                queryAfter_eq_of_update_none_on_answeredPrefix
                  algorithm oracle hanswered hq hj
            have hsupport' :
                ∀ {x g}, oracleRef x = some g →
                  x ∉ Metric.closedBall c' r' ∧
                    g ≠ 0 ∧
                      Metric.closedBall c' r' ⊆ cuttingHalfspace x g := by
              intro x g hxg
              by_cases hxq : x = q
              · subst hxq
                have hg_eq : g = gNew := by
                  have : some gNew = some g := by
                    simpa [oracleRef, Function.update_self] using hxg
                  exact (Option.some.inj this).symm
                subst hg_eq
                exact ⟨hqout', hgNew_ne, hcut'⟩
              · have hold : oracle x = some g := by
                  simpa [oracleRef, Function.update, hxq] using hxg
                rcases hsupport hold with ⟨hxout, hg_ne, hcut⟩
                refine ⟨?_, hg_ne, ?_⟩
                · intro hxball
                  exact hxout (hsubset' hxball)
                · exact Set.Subset.trans hsubset' hcut
            have hanswered' :
                ∀ j < t + 1, ∃ g, oracleRef (algorithm.queryAfter oracleRef j) = some g := by
              intro j hj
              by_cases hjeq : j = t
              · refine ⟨gNew, ?_⟩
                have hquery_last :
                    algorithm.queryAfter oracleRef j = q := by
                  calc
                    algorithm.queryAfter oracleRef j = algorithm.queryAfter oracle j :=
                      hquery_eq j (Nat.le_of_lt_succ hj)
                    _ = q := by
                      rw [hjeq]
                rw [hquery_last]
                simp [oracleRef, Function.update]
              · have hjt : j < t := Nat.lt_of_le_of_ne (Nat.le_of_lt_succ hj) hjeq
                rcases hanswered j hjt with ⟨gOld, hgOld⟩
                have hquery_old :
                    algorithm.queryAfter oracleRef j = algorithm.queryAfter oracle j :=
                  hquery_eq j (Nat.le_of_lt hjt)
                have hneq :
                    algorithm.queryAfter oracle j ≠ q := by
                  intro hsame
                  have : oracle q = some gOld := by
                    simpa [hsame] using hgOld
                  rw [hq] at this
                  cases this
                refine ⟨gOld, ?_⟩
                rw [hquery_old]
                simpa [oracleRef, Function.update, hneq] using hgOld
            refine ⟨oracleRef, c', r', hr', ?_, hsupport', hanswered'⟩
            exact Set.Subset.trans hsubset' hseed
  exact hbuild k le_rfl

/-- Helper for Theorem 3.49: every packed child closed ball inside the protected ball defines a
genuine feasibility problem whose oracle replays the protected reference replies whenever they are
available. -/
private theorem mkReplayProblemOnClosedBall
    {m : ℕ}
    (oracleRef : EuclideanSpace ℝ (Fin m) → Option (EuclideanSpace ℝ (Fin m)))
    (cP : EuclideanSpace ℝ (Fin m)) {rP : ℝ}
    (hsupport :
      ∀ {x g}, oracleRef x = some g →
        x ∉ Metric.closedBall cP rP ∧
          g ≠ 0 ∧
            Metric.closedBall cP rP ⊆ cuttingHalfspace x g)
    (c : EuclideanSpace ℝ (Fin m)) {r : ℝ} (hr : 0 < r)
    (hsubset : Metric.closedBall c r ⊆ Metric.closedBall cP rP) :
    ∃ problem : FeasibilityProblemWithSeparationOracle (EuclideanSpace ℝ (Fin m)),
      (problem : Set (EuclideanSpace ℝ (Fin m))) = Metric.closedBall c r ∧
        (∀ {x g}, oracleRef x = some g →
          ((problem.oracle x).oracleReply = some g)) := by
  classical
  let child : Set (EuclideanSpace ℝ (Fin m)) := Metric.closedBall c r
  have hchild_nonempty : child.Nonempty := by
    exact ⟨c, Metric.mem_closedBall_self hr.le⟩
  have hchild_closed : IsClosed child := by
    simpa [child] using Metric.isClosed_closedBall
  have hchild_convex : Convex ℝ child := by
    simpa [child] using convex_closedBall c r
  have hreplayedSeparator :
      ∀ {x g}, oracleRef x = some g →
        SeparatesPointFromWith child x g (inner ℝ g x) := by
    intro x g hRef
    rcases hsupport hRef with ⟨_, hg_ne, hcut⟩
    exact (separatesPointFromWith_inner_iff).2 ⟨hg_ne, Set.Subset.trans hsubset hcut⟩
  let fallbackVector :
      ∀ x : EuclideanSpace ℝ (Fin m), x ∉ child → EuclideanSpace ℝ (Fin m) :=
    fun x hx ↦
      Classical.choose <|
        exists_separatingVector_of_nonempty_closedConvex
          hchild_nonempty hchild_closed hchild_convex hx
  have hfallbackSeparator :
      ∀ x : EuclideanSpace ℝ (Fin m), ∀ hx : x ∉ child,
        SeparatesPointFromWith child x (fallbackVector x hx)
          (inner ℝ (fallbackVector x hx) x) := by
    intro x hx
    exact Classical.choose_spec <|
      exists_separatingVector_of_nonempty_closedConvex
        hchild_nonempty hchild_closed hchild_convex hx
  let replayOracle : SeparationOracle child := fun x ↦
    if hx : x ∈ child then
      SeparationOracleAnswer.feasible hx
    else
      if hRef : ∃ g : EuclideanSpace ℝ (Fin m), oracleRef x = some g then
        SeparationOracleAnswer.separatingVector
          (Classical.choose hRef) hx
          (hreplayedSeparator (Classical.choose_spec hRef))
      else
        SeparationOracleAnswer.separatingVector
          (fallbackVector x hx) hx (hfallbackSeparator x hx)
  refine ⟨{
    feasibleSet := child
    feasibleSet_nonempty := hchild_nonempty
    feasibleSet_closed := hchild_closed
    feasibleSet_convex := hchild_convex
    oracle := replayOracle
  }, rfl, ?_⟩
  intro x g hRef
  have hxnot : x ∉ child := by
    intro hx
    exact (hsupport hRef).1 (hsubset hx)
  let hExists : ∃ g' : EuclideanSpace ℝ (Fin m), oracleRef x = some g' := ⟨g, hRef⟩
  have hchoose_eq : Classical.choose hExists = g := by
    apply Option.some.inj
    calc
      some (Classical.choose hExists) = oracleRef x := by
        symm
        exact Classical.choose_spec hExists
      _ = some g := hRef
  simpa [replayOracle, hxnot, hExists, hchoose_eq] using
    (SeparationOracleAnswer.oracleReply_separatingVector
      (S := child) (xBar := x) (g := Classical.choose hExists) hxnot
      (hreplayedSeparator (Classical.choose_spec hExists)))

/-- Helper for Theorem 3.49: if every child oracle replays the same protected reference oracle on
its supported query points, then all replay problems have identical prefix outputs up to the
budget `k`. -/
private theorem pairwiseEqualPrefixOutputs_of_replayFamily
    {m : ℕ}
    (algorithm : SeparationOracleAlgorithm (EuclideanSpace ℝ (Fin m)))
    (oracleRef : EuclideanSpace ℝ (Fin m) → Option (EuclideanSpace ℝ (Fin m)))
    {k : ℕ}
    (problem : Fin (k + 2) →
      FeasibilityProblemWithSeparationOracle (EuclideanSpace ℝ (Fin m)))
    (hanswered :
      ∀ j < k, ∃ g, oracleRef (algorithm.queryAfter oracleRef j) = some g)
    (hreplay :
      ∀ i {x g}, oracleRef x = some g →
        ((problem i).oracle x).oracleReply = some g) :
    ∀ i₁ i₂ j, j ≤ k →
      algorithm.outputAfter (fun x ↦ ((problem i₁).oracle x).oracleReply) j =
        algorithm.outputAfter (fun x ↦ ((problem i₂).oracle x).oracleReply) j := by
  intro i₁ i₂ j hj
  -- Each replay oracle agrees with the common reference oracle on every supported query of the
  -- reference path, so the output-matching lemma applies verbatim.
  refine outputAfter_eq_of_commonReferencePrefix
    algorithm oracleRef
    (fun x ↦ ((problem i₁).oracle x).oracleReply)
    (fun x ↦ ((problem i₂).oracle x).oracleReply) ?_ ?_
  · intro t ht
    rcases hanswered t (lt_of_lt_of_le ht hj) with ⟨g, hg⟩
    calc
      ((problem i₁).oracle (algorithm.queryAfter oracleRef t)).oracleReply = some g :=
        hreplay i₁ hg
      _ = oracleRef (algorithm.queryAfter oracleRef t) := by
        symm
        exact hg
  · intro t ht
    rcases hanswered t (lt_of_lt_of_le ht hj) with ⟨g, hg⟩
    calc
      ((problem i₂).oracle (algorithm.queryAfter oracleRef t)).oracleReply = some g :=
        hreplay i₂ hg
      _ = oracleRef (algorithm.queryAfter oracleRef t) := by
        symm
        exact hg

/-- Theorem 3.49: fix `R > 0` and `ε ∈ (0, R / 2)`. Then for every deterministic
separation-oracle algorithm and every oracle budget below `n log (R / (2 ε))`, there exists a
feasibility problem with separation oracle, whose feasible set has nonempty interior and is
contained in the textbook ball `B∞(0, R)`, on which that algorithm cannot correctly output either
a feasible point or a certificate that the feasible set misses `B∞(0, ε)` within that many
oracle calls. -/
-- Proof sketch: construct a resisting-oracle hard instance whose feasible set remains compatible
-- with the transcript of the given algorithm after `k` queries; this yields an instance whose
-- feasible set has nonempty interior, lies in `B∞(0, R)`, and defeats that deterministic
-- separation-oracle algorithm within `k` oracle calls.
theorem exists_hard_feasibility_problem_for_short_separation_oracle_algorithms
    (m : ℕ)
    (algorithm : SeparationOracleAlgorithm (EuclideanSpace ℝ (Fin m)))
    {R ε : ℝ} (hR : 0 < R) (hε : 0 < ε) (hεR : ε < R / 2) {k : ℕ}
    (hk : (k : ℝ) < (m : ℝ) * Real.log (R / (2 * ε))) :
    ∃ problem : FeasibilityProblemWithSeparationOracle (EuclideanSpace ℝ (Fin m)),
      IsHardFeasibilityInstanceFor algorithm R ε k problem := by
  have hm : 0 < m := positive_dimension_of_short_budget hk
  have hfamily :
      ∀ problem : Fin (k + 2) →
          FeasibilityProblemWithSeparationOracle (EuclideanSpace ℝ (Fin m)),
        (∀ i₁ i₂ j, j ≤ k →
          algorithm.outputAfter (fun x ↦ ((problem i₁).oracle x).oracleReply) j =
            algorithm.outputAfter (fun x ↦ ((problem i₂).oracle x).oracleReply) j) →
        (∀ i, ((problem i : Set (EuclideanSpace ℝ (Fin m))) ∩ linftyClosedBall ε).Nonempty) →
        (Pairwise fun i₁ i₂ =>
          Disjoint
            (problem i₁ : Set (EuclideanSpace ℝ (Fin m)))
            (problem i₂ : Set (EuclideanSpace ℝ (Fin m)))) →
        ∃ i, ¬ SeparationOracleAlgorithm.SolvesWithin algorithm (problem i) ε k := by
    intro problem houtput hinter hdisjoint
    -- The replay-family endgame is now abstracted away from the remaining geometry.
    exact exists_problem_not_solved_of_pairwiseEqualPrefixOutputs
      (algorithm := algorithm) (problem := problem) (ε := ε) (k := k)
      houtput hinter hdisjoint
  have hsubball :
      ∀ c q : EuclideanSpace ℝ (Fin m), ∀ {r : ℝ}, 0 < r →
        ∃ c' : EuclideanSpace ℝ (Fin m), ∃ δ : ℝ,
          0 < δ ∧
            Metric.closedBall c' δ ⊆ Metric.closedBall c r ∧
            q ∉ Metric.closedBall c' δ :=
    fun c q {r} hr ↦ exists_closedSubball_avoidsPoint hm c q hr
  have hseed :
      Metric.closedBall (0 : EuclideanSpace ℝ (Fin m)) (ε / 2) ⊆ linftyClosedBall ε :=
    closedBall_halfEps_subset_linftyClosedBall hε
  have hpack :
      ∀ {c : EuclideanSpace ℝ (Fin m)} {r : ℝ}, 0 < r →
        ∃ δ : ℝ, 0 < δ ∧
          ∃ centers : Fin (k + 2) → EuclideanSpace ℝ (Fin m),
            (∀ i, Metric.closedBall (centers i) δ ⊆ Metric.closedBall c r) ∧
            Pairwise fun i₁ i₂ =>
              Disjoint
                (Metric.closedBall (centers i₁) δ)
                (Metric.closedBall (centers i₂) δ) :=
    fun {c} {r} hr ↦ existsPackedClosedBallFamilyInClosedBall (k := k) hm c hr
  -- Route correction: the strict-box exclusion infrastructure above fixes the earlier midpoint-tie
  -- issue, but the remaining blocker is not transcript replay itself. The current final-box route
  -- correction is now explicit: recurse on positive-radius closed balls instead of on the final
  -- strict current box. The new `hseed`, `hsubball`, and `hpack` helpers now isolate the
  -- geometric front-end: start from the protected seed ball inside `B∞(0, ε)`, shrink around
  -- fresh queries while preserving a positive-radius closed ball, and later pack the final ball
  -- with the exact `Fin (k + 2)` disjoint replay family required by `hfamily`.
  obtain ⟨oracleRef, c, r, hr, hseedBall, hsupport, hanswered⟩ :=
    exists_supportedReferenceOracleOnProtectedClosedBall algorithm hm hε (k := k)
  obtain ⟨δ, hδ, centers, hchild_subset, hchild_disjoint⟩ := hpack hr
  classical
  have hmk :
      ∀ i : Fin (k + 2),
        ∃ problem : FeasibilityProblemWithSeparationOracle (EuclideanSpace ℝ (Fin m)),
          (problem : Set (EuclideanSpace ℝ (Fin m))) = Metric.closedBall (centers i) δ ∧
            (∀ {x g}, oracleRef x = some g →
              ((problem.oracle x).oracleReply = some g)) := by
    intro i
    -- Each packed child ball inherits the protected separators and becomes a replay problem.
    exact
      mkReplayProblemOnClosedBall
        oracleRef c hsupport (centers i) hδ (hchild_subset i)
  choose problem hproblem_set hproblem_replay using hmk
  have houtput :
      ∀ i₁ i₂ j, j ≤ k →
        algorithm.outputAfter (fun x ↦ ((problem i₁).oracle x).oracleReply) j =
          algorithm.outputAfter (fun x ↦ ((problem i₂).oracle x).oracleReply) j :=
    pairwiseEqualPrefixOutputs_of_replayFamily
      algorithm oracleRef problem hanswered
      (fun i {x g} hRef ↦ hproblem_replay i hRef)
  have hinter :
      ∀ i, ((problem i : Set (EuclideanSpace ℝ (Fin m))) ∩ linftyClosedBall ε).Nonempty := by
    intro i
    have hchild_seed :
        Metric.closedBall (centers i) δ ⊆ Metric.closedBall 0 (ε / 2) :=
      Set.Subset.trans (hchild_subset i) hseedBall
    have hcenter_child : centers i ∈ Metric.closedBall (centers i) δ :=
      Metric.mem_closedBall_self hδ.le
    refine ⟨centers i, ?_, ?_⟩
    · simpa [hproblem_set i] using hcenter_child
    · exact hseed (hchild_seed hcenter_child)
  have hdisjoint :
      Pairwise fun i₁ i₂ =>
        Disjoint
          (problem i₁ : Set (EuclideanSpace ℝ (Fin m)))
          (problem i₂ : Set (EuclideanSpace ℝ (Fin m))) := by
    intro i₁ i₂ hne
    simpa [hproblem_set i₁, hproblem_set i₂] using hchild_disjoint hne
  obtain ⟨i, hnotSolved⟩ := hfamily problem houtput hinter hdisjoint
  have hinterior_child :
      (interior (problem i : Set (EuclideanSpace ℝ (Fin m)))).Nonempty := by
    have hδhalf : 0 < δ / 2 := by positivity
    have hball_subset :
        Metric.ball (centers i) (δ / 2) ⊆ Metric.closedBall (centers i) δ := by
      intro x hx
      rw [Metric.mem_ball] at hx
      rw [Metric.mem_closedBall]
      linarith
    have hcenter_mem_interior :
        centers i ∈ interior (Metric.closedBall (centers i) δ) := by
      rw [mem_interior_iff_mem_nhds]
      exact Filter.mem_of_superset (Metric.ball_mem_nhds _ hδhalf) hball_subset
    exact ⟨centers i, by simpa [hproblem_set i] using hcenter_mem_interior⟩
  have hlinfty_subset :
      (linftyClosedBall (n := m) ε) ⊆ linftyClosedBall (n := m) R := by
    intro x hx
    rw [mem_linftyClosedBall_iff] at hx ⊢
    linarith
  have hsubset_R :
      (problem i : Set (EuclideanSpace ℝ (Fin m))) ⊆ linftyClosedBall R := by
    have hchild_eps :
        Metric.closedBall (centers i) δ ⊆ linftyClosedBall ε :=
      Set.Subset.trans (Set.Subset.trans (hchild_subset i) hseedBall) hseed
    simpa [hproblem_set i] using Set.Subset.trans hchild_eps hlinfty_subset
  exact ⟨problem i, ⟨hinterior_child, hsubset_R, hnotSolved⟩⟩

end
