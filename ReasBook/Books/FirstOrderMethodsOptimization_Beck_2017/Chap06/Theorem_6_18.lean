import FirstOrderMethodsOptimization_Beck_2017.Chap02.Definition_2_5
import FirstOrderMethodsOptimization_Beck_2017.Chap02.Definition_2_6
import FirstOrderMethodsOptimization_Beck_2017.Chap06.Definition_6_1

-- Declarations for this item will be appended below by the statement pipeline.

noncomputable section

universe u

section

variable {E : Type u} [NormedAddCommGroup E] [InnerProductSpace ℝ E]

attribute [local instance] Classical.propDecidable

/- Theorem 6.18 is `source-facing` in the Chapter 6 proximal-operator API. Domain sampling against
the owner `prox[...]` from Definition 6.1, the scalar properness owner
`IsProperExtendedRealFunction` from Definition 2.5, and the chapter's norm-radial examples shows
that the public statement should stay on the canonical proximal owner, with the scalar-to-radial
passage recorded only as a `bridge/view`.

The primitive data are the scalar profile `g`, its canonical properness owner `hproper`, the
negative-ray bridge `hdom`, and the base point `x`. The nonnegative `≠ ⊥` branch and the finite
witness on `[0, ∞)` are derived from `hproper` together with `hdom`, so they should not remain as
parallel primitive hypotheses. -/

-- Proof sketch: for fixed `x`, write the proximal objective for `u ↦ g ‖u‖` in polar form using
-- `r = ‖u‖`. Expanding `‖u - x‖²` shows that, for each fixed radius `r`, minimizing over the
-- sphere `‖u‖ = r` is equivalent to maximizing `⟪u, x⟫`; by Cauchy-Schwarz, this forces the
-- unique optimizer `u = (r / ‖x‖) • x` when `x ≠ 0`, while for `x = 0` every vector of radius
-- `r` is optimal. The scalar objective is exactly the proximal objective of `g` at `‖x‖`. The
-- properness rules out the degenerate `⊥` and everywhere-`⊤` branches, while `hdom` forces the
-- effective-domain witness to lie on `[0, ∞)` and excludes negative radii from the minimizing
-- scalar profile.
section NormComposition

variable [Nontrivial E]
variable (g : ℝ → EReal) (hproper : IsProperExtendedRealFunction g)
variable (hclosed : LowerSemicontinuous g) (hconvex : is_convex_function g)
variable (hdom : ∀ t : ℝ, t < 0 → g t = ⊤)

include hproper hclosed hconvex hdom

/-- Helper for Theorem 6.18: properness together with the negative-ray domain restriction
provides a finite scalar comparison point on `[0, ∞)`. -/
lemma existsNonnegativeEffectiveDomainPoint :
    ∃ s : ℝ, 0 ≤ s ∧ s ∈ effective_domain g := by
  -- Start from the properness witness and rule out the negative branch using `hdom`.
  rcases hproper.effective_domain_nonempty with ⟨s, hs⟩
  have hs_nonneg : 0 ≤ s := by
    by_contra hs_nonneg
    have hs_top : g s = ⊤ := hdom s (lt_of_not_ge hs_nonneg)
    exact (mem_effective_domain.mp hs).ne hs_top
  exact ⟨s, hs_nonneg, hs⟩

/-- Helper for Theorem 6.18: a scalar proximal radius must be nonnegative. -/
lemma scalarProx_nonneg {a t : ℝ} (ht : t ∈ prox[g] a) : 0 ≤ t := by
  -- Compare a hypothetical negative minimizer to a finite nonnegative comparison point.
  rcases existsNonnegativeEffectiveDomainPoint
      (g := g) (hproper := hproper) (hclosed := hclosed) (hconvex := hconvex) (hdom := hdom)
      with ⟨s, hs_nonneg, hs⟩
  rw [mem_proximal_mapping_iff, isMinOn_univ_iff] at ht
  by_contra ht_nonneg
  have ht_top : proximal_objective g a t = ⊤ := by
    rw [proximal_objective_apply, hdom t (lt_of_not_ge ht_nonneg),
      EReal.top_add_of_ne_bot (EReal.coe_ne_bot _)]
  have hs_lt_top : proximal_objective g a s < ⊤ := by
    simpa [proximal_objective_apply] using
      EReal.add_lt_top (mem_effective_domain.mp hs).ne (EReal.coe_ne_top _)
  have hts : proximal_objective g a t ≤ proximal_objective g a s := ht s
  rw [ht_top] at hts
  exact not_le_of_gt hs_lt_top hts

/-- Helper for Theorem 6.18: the scalar proximal objective at the radius `‖u‖` is bounded above
by the vector proximal objective at `u`. -/
lemma scalarObjective_le_radialObjective (x u : E) :
    proximal_objective g ‖x‖ ‖u‖ ≤ proximal_objective (g ∘ norm) x u := by
  -- The reverse triangle inequality compares the scalar and vector distance terms.
  have hdist : ‖‖u‖ - ‖x‖‖ ≤ ‖u - x‖ := abs_norm_sub_norm_le u x
  have hsq :
      (1 / 2 : ℝ) * ‖‖u‖ - ‖x‖‖ ^ (2 : ℕ) ≤
        (1 / 2 : ℝ) * ‖u - x‖ ^ (2 : ℕ) := by
    nlinarith [hdist, norm_nonneg (‖u‖ - ‖x‖), norm_nonneg (u - x)]
  have hsqE :
      (((((1 / 2 : ℝ) * ‖‖u‖ - ‖x‖‖ ^ (2 : ℕ)) : ℝ)) : EReal) ≤
        (((((1 / 2 : ℝ) * ‖u - x‖ ^ (2 : ℕ)) : ℝ)) : EReal) := by
    exact_mod_cast hsq
  simpa [proximal_objective_apply, Function.comp, add_comm, add_left_comm, add_assoc] using
    add_le_add_left hsqE (g ‖u‖)

/-- Helper for Theorem 6.18: along the ray generated by `x`, the vector proximal objective reduces
to the scalar proximal objective in the radius parameter. -/
lemma proximalObjective_radialLift_eq_scalar
    {x : E} (hx : x ≠ 0) {t : ℝ} (ht : 0 ≤ t) :
    proximal_objective (g ∘ norm) x ((t / ‖x‖) • x) = proximal_objective g ‖x‖ t := by
  -- Compute the norm of the radial lift and the norm of its displacement from `x`.
  have hnorm_x : 0 < ‖x‖ := norm_pos_iff.mpr hx
  have hnorm_lift : ‖(t / ‖x‖) • x‖ = t := by
    rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg (div_nonneg ht hnorm_x.le)]
    field_simp [hnorm_x.ne']
  have hsub :
      ((t / ‖x‖) • x) - x = (((t - ‖x‖) / ‖x‖) : ℝ) • x := by
    calc
      ((t / ‖x‖) • x) - x = ((t / ‖x‖) • x) - (1 : ℝ) • x := by rw [one_smul]
      _ = (((t / ‖x‖) - 1 : ℝ)) • x := by rw [sub_smul]
      _ = (((t - ‖x‖) / ‖x‖ : ℝ)) • x := by
        field_simp [hnorm_x.ne']
  have hnorm_sub : ‖((t / ‖x‖) • x) - x‖ = ‖t - ‖x‖‖ := by
    rw [hsub, norm_smul, Real.norm_eq_abs, abs_div, abs_of_pos hnorm_x]
    field_simp [hnorm_x.ne']
    simp [Real.norm_eq_abs]
  simpa [proximal_objective_apply, Function.comp, hnorm_lift, hnorm_sub]

/-- Theorem 6.18: norm composition. For the radial function `f = g ∘ norm`, the proximal set at
`x` is the radial image of the scalar proximal set at `‖x‖` when `x ≠ 0`, and at the origin it is
the set of vectors whose norm belongs to the scalar proximal set at `0`, provided `g` is proper,
closed, convex, and has effective domain contained in `[0, ∞)`.

The nontriviality hypothesis records the Euclidean-space assumption used in the textbook proof:
at `x = 0`, every nonnegative optimal scalar radius must be realized as the norm of some vector.
Without this, the statement is false in the zero-dimensional space. -/
theorem prox_norm_composition_eq_piecewise
    (x : E) :
    prox[g ∘ norm] x =
      if x = 0 then
        {u : E | ‖u‖ ∈ prox[g] 0}
      else
        (fun t : ℝ ↦ (t / ‖x‖) • x) '' prox[g] ‖x‖ := by
  -- Split into the origin and nonzero cases from the textbook piecewise formula.
  by_cases hx : x = 0
  · subst x
    rw [if_pos rfl]
    ext u
    constructor
    · intro hu
      -- At the origin, the vector objective depends only on `‖u‖`, so every scalar competitor is
      -- represented by some vector with the same norm when the radius is nonnegative.
      rw [mem_proximal_mapping_iff, isMinOn_univ_iff] at hu
      change ‖u‖ ∈ prox[g] 0
      rw [mem_proximal_mapping_iff, isMinOn_univ_iff]
      intro t
      by_cases ht : 0 ≤ t
      · rcases exists_norm_eq E ht with ⟨v, hv⟩
        simpa [proximal_objective_apply, Function.comp, hv] using hu v
      · have ht_top : proximal_objective g 0 t = ⊤ := by
          rw [proximal_objective_apply, hdom t (lt_of_not_ge ht),
            EReal.top_add_of_ne_bot (EReal.coe_ne_bot _)]
        rw [ht_top]
        simp
    · intro hu
      -- Scalar optimality of `‖u‖` transfers directly back to vector optimality at the origin.
      change ‖u‖ ∈ prox[g] 0 at hu
      rw [mem_proximal_mapping_iff, isMinOn_univ_iff] at hu
      rw [mem_proximal_mapping_iff, isMinOn_univ_iff]
      intro v
      calc
        proximal_objective (g ∘ norm) (0 : E) u = proximal_objective g 0 ‖u‖ := by
          simp [proximal_objective_apply, Function.comp]
        _ ≤ proximal_objective g 0 ‖v‖ := hu ‖v‖
        _ = proximal_objective (g ∘ norm) (0 : E) v := by
          simp [proximal_objective_apply, Function.comp]
  · ext u
    rw [if_neg hx]
    constructor
    · intro hu
      -- Away from the origin, a proximal vector determines a proximal scalar radius and then must
      -- lie on the same ray as `x`, so it is exactly the radial lift of that radius.
      rw [Set.mem_image]
      have hu_min : ∀ v : E,
          proximal_objective (g ∘ norm) x u ≤ proximal_objective (g ∘ norm) x v := by
        rw [mem_proximal_mapping_iff, isMinOn_univ_iff] at hu
        exact hu
      let r : ℝ := ‖u‖
      have hr_mem : r ∈ prox[g] ‖x‖ := by
        rw [mem_proximal_mapping_iff, isMinOn_univ_iff]
        intro t
        by_cases ht : 0 ≤ t
        · calc
            proximal_objective g ‖x‖ r ≤ proximal_objective (g ∘ norm) x u :=
              scalarObjective_le_radialObjective
                (g := g) (hproper := hproper) (hclosed := hclosed) (hconvex := hconvex)
                (hdom := hdom) x u
            _ ≤ proximal_objective (g ∘ norm) x ((t / ‖x‖) • x) :=
              hu_min ((t / ‖x‖) • x)
            _ = proximal_objective g ‖x‖ t :=
              proximalObjective_radialLift_eq_scalar
                (g := g) (hproper := hproper) (hclosed := hclosed) (hconvex := hconvex)
                (hdom := hdom) hx ht
        · have ht_top : proximal_objective g ‖x‖ t = ⊤ := by
            rw [proximal_objective_apply, hdom t (lt_of_not_ge ht),
              EReal.top_add_of_ne_bot (EReal.coe_ne_bot _)]
          rw [ht_top]
          simp
      have hr_nonneg : 0 ≤ r := by
        simpa [r] using scalarProx_nonneg
          (g := g) (hproper := hproper) (hclosed := hclosed) (hconvex := hconvex) (hdom := hdom)
          hr_mem
      have hnorm_x : 0 < ‖x‖ := norm_pos_iff.mpr hx
      let v : E := (r / ‖x‖) • x
      have hradial_eq : proximal_objective (g ∘ norm) x v = proximal_objective g ‖x‖ r := by
        simpa [v, r] using proximalObjective_radialLift_eq_scalar
          (g := g) (hproper := hproper) (hclosed := hclosed) (hconvex := hconvex) (hdom := hdom)
          hx hr_nonneg
      have hscalar_le : proximal_objective g ‖x‖ r ≤ proximal_objective (g ∘ norm) x u :=
        scalarObjective_le_radialObjective
          (g := g) (hproper := hproper) (hclosed := hclosed) (hconvex := hconvex) (hdom := hdom)
          x u
      have hu_le_v : proximal_objective (g ∘ norm) x u ≤ proximal_objective (g ∘ norm) x v :=
        hu_min v
      have hfinite_r : proximal_objective g ‖x‖ r < ⊤ := by
        rcases existsNonnegativeEffectiveDomainPoint
            (g := g) (hproper := hproper) (hclosed := hclosed) (hconvex := hconvex)
            (hdom := hdom) with ⟨s, hs_nonneg, hs⟩
        have hrs : proximal_objective g ‖x‖ r ≤ proximal_objective g ‖x‖ s := by
          rw [mem_proximal_mapping_iff, isMinOn_univ_iff] at hr_mem
          exact hr_mem s
        have hs_lt_top : proximal_objective g ‖x‖ s < ⊤ := by
          simpa [proximal_objective_apply] using
            EReal.add_lt_top (mem_effective_domain.mp hs).ne (EReal.coe_ne_top _)
        exact lt_of_le_of_lt hrs hs_lt_top
      have hgr_top : g r ≠ ⊤ := by
        intro hgr_top
        have hobj_top : proximal_objective g ‖x‖ r = ⊤ := by
          rw [proximal_objective_apply, hgr_top, EReal.top_add_of_ne_bot (EReal.coe_ne_bot _)]
        exact hfinite_r.ne hobj_top
      have hgr_coe : g r = (((g r).toReal : ℝ) : EReal) := by
        exact (EReal.coe_toReal hgr_top (hproper.ne_bot r)).symm
      have hu_ray : SameRay ℝ u x := by
        by_contra hu_ray
        have hdist : ‖r - ‖x‖‖ < ‖u - x‖ := by
          simpa [r, Real.norm_eq_abs] using (not_sameRay_iff_abs_lt_norm_sub.mp hu_ray)
        have hpenalty_lt :
            (1 / 2 : ℝ) * ‖r - ‖x‖‖ ^ (2 : ℕ) <
              (1 / 2 : ℝ) * ‖u - x‖ ^ (2 : ℕ) := by
          nlinarith [hdist, norm_nonneg (r - ‖x‖), norm_nonneg (u - x)]
        have hobj_lt : proximal_objective g ‖x‖ r < proximal_objective (g ∘ norm) x u := by
          have hobj_lt_real :
              (g r).toReal + (1 / 2 : ℝ) * ‖r - ‖x‖‖ ^ (2 : ℕ) <
                (g r).toReal + (1 / 2 : ℝ) * ‖u - x‖ ^ (2 : ℕ) := by
            simpa [add_comm] using add_lt_add_left hpenalty_lt (g r).toReal
          rw [proximal_objective_apply, proximal_objective_apply, Function.comp, hgr_coe]
          exact_mod_cast hobj_lt_real
        have hu_le_scalar : proximal_objective (g ∘ norm) x u ≤ proximal_objective g ‖x‖ r := by
          calc
            proximal_objective (g ∘ norm) x u ≤ proximal_objective (g ∘ norm) x v := hu_le_v
            _ = proximal_objective g ‖x‖ r := hradial_eq
        exact (not_lt_of_ge hu_le_scalar) hobj_lt
      have hv_ray : SameRay ℝ v x := by
        exact SameRay.sameRay_nonneg_smul_left x (div_nonneg hr_nonneg (norm_nonneg x))
      have huv_ray : SameRay ℝ u v := hu_ray.trans hv_ray.symm (fun hx0 => False.elim (hx hx0))
      have hnorm_v : ‖v‖ = r := by
        rw [show v = (r / ‖x‖) • x by rfl, norm_smul, Real.norm_eq_abs,
          abs_of_nonneg (div_nonneg hr_nonneg hnorm_x.le)]
        field_simp [hnorm_x.ne']
      refine ⟨r, hr_mem, ?_⟩
      simpa [v] using (huv_ray.eq_of_norm_eq (by simpa [r] using hnorm_v.symm)).symm
    · rintro ⟨t, ht, rfl⟩
      -- A scalar proximal radius lifts back to a vector proximal point along the ray through `x`.
      have ht_nonneg : 0 ≤ t := scalarProx_nonneg
        (g := g) (hproper := hproper) (hclosed := hclosed) (hconvex := hconvex) (hdom := hdom)
        ht
      have ht_min : ∀ s : ℝ,
          proximal_objective g ‖x‖ t ≤ proximal_objective g ‖x‖ s := by
        rw [mem_proximal_mapping_iff, isMinOn_univ_iff] at ht
        exact ht
      rw [mem_proximal_mapping_iff, isMinOn_univ_iff]
      intro v
      calc
        proximal_objective (g ∘ norm) x ((t / ‖x‖) • x) = proximal_objective g ‖x‖ t :=
          proximalObjective_radialLift_eq_scalar
            (g := g) (hproper := hproper) (hclosed := hclosed) (hconvex := hconvex)
            (hdom := hdom) hx ht_nonneg
        _ ≤ proximal_objective g ‖x‖ ‖v‖ := ht_min ‖v‖
        _ ≤ proximal_objective (g ∘ norm) x v :=
          scalarObjective_le_radialObjective
            (g := g) (hproper := hproper) (hclosed := hclosed) (hconvex := hconvex)
            (hdom := hdom) x v

-- Proof sketch: specialize `prox_norm_composition_eq_piecewise` to the origin, where the `if`
-- branch reduces definitionally to the radius-membership description.
/-- At the origin, the proximal set of the radial function `g ∘ norm` consists exactly of the
vectors whose norm belongs to the scalar proximal set of `g` at `0`. -/
@[simp] theorem prox_norm_composition_at_zero
    : prox[g ∘ norm] (0 : E) = {u : E | ‖u‖ ∈ prox[g] 0} := by
  simpa using prox_norm_composition_eq_piecewise g hproper hclosed hconvex hdom (0 : E)

-- Proof sketch: rewrite `prox_norm_composition_at_zero` as a membership statement in the displayed
-- set; this unfolds directly to the scalar-radius condition.
/-- A vector belongs to `prox[g ∘ norm] 0` exactly when its norm belongs to `prox[g] 0`. -/
@[simp] theorem mem_prox_norm_composition_at_zero_iff {u : E} :
    u ∈ prox[g ∘ norm] (0 : E) ↔ ‖u‖ ∈ prox[g] 0 := by
  rw [prox_norm_composition_at_zero g hproper hclosed hconvex hdom]
  rfl

-- Proof sketch: specialize `prox_norm_composition_eq_piecewise` away from the origin, where the
-- nonzero hypothesis selects the radial-image branch of the piecewise formula.
/-- Away from the origin, the proximal set of `g ∘ norm` is the radial image of the scalar
proximal set of `g` at `‖x‖`. -/
theorem prox_norm_composition_of_ne_zero
    {x : E} (hx : x ≠ 0) :
    prox[g ∘ norm] x = (fun t : ℝ ↦ (t / ‖x‖) • x) '' prox[g] ‖x‖ := by
  simpa [hx] using prox_norm_composition_eq_piecewise g hproper hclosed hconvex hdom x

-- Proof sketch: rewrite by `prox_norm_composition_of_ne_zero`; membership in a set image is
-- exactly the existence of a scalar proximal radius whose radial lift is the vector.
/-- Away from the origin, membership in `prox[g ∘ norm] x` is equivalent to belonging to the
radial image of the scalar proximal set `prox[g] ‖x‖`. -/
theorem mem_prox_norm_composition_of_ne_zero_iff
    {x u : E} (hx : x ≠ 0) :
    u ∈ prox[g ∘ norm] x ↔ ∃ t : ℝ, t ∈ prox[g] ‖x‖ ∧ (t / ‖x‖) • x = u := by
  rw [prox_norm_composition_of_ne_zero g hproper hclosed hconvex hdom hx, Set.mem_image]

omit hproper hclosed hconvex hdom

end NormComposition

end
