import FirstOrderMethodsOptimization_Beck_2017.Chap12.Algorithm_12_4
import FirstOrderMethodsOptimization_Beck_2017.Chap10.Algorithm_10_13
import FirstOrderMethodsOptimization_Beck_2017.Chap12.Algorithm_12_5

-- Declarations for this item will be appended below by the statement pipeline.

noncomputable section

section

open Matrix

variable {n p : ℕ}
/- Algorithm 12.6 is `source-facing` in the subsection on orthogonal projection onto a polyhedral
set.

Domain sampling against nearby project owners identifies:
- `source-facing`: the named iterate families `u^k`, `y^k`, and `w^k`;
- `core/canonical`: `polyhedral_projection_primal_point`, `polyhedral_projection_dual_update`,
  the pointwise minimum `min` on `EuclideanSpace`, and `PolyhedralProjectionStepsizeParameter` from
  Algorithm 12.5
  for the shared projection data, together with `fista_momentum_sequence` and
  `fista_momentum_update` from Algorithm 10.13 for the scalar recursion
  `t_(k+1) = (1 + √(1 + 4 t_k²)) / 2`;
- `bridge/view`: the private recursive state carrying only the hidden bookkeeping convention
  needed to encode the extrapolation step.

This separates primitive data from derived API as follows: the only genuinely new public owners in
this file are the explicit iterate families `u^k`, `y^k`, and `w^k`, while the scalar sequence
`t_k` is already owned upstream by `fista_momentum_sequence` and should therefore be reused
directly on theorem surfaces rather than reintroduced through a parallel local definition carrying
the polyhedral problem-data binders. The canonical bridge/view layer is the Chapter 12.4 owner
`IsFastDualProximalGradientPrimalTrajectory`, instantiated here by the explicit projection
recursion through the theorem
`polyhedral_projection_fdpg_isFastDualProximalGradientPrimalTrajectory` and its companion
instance below. -/

/-- Internal recursion state for the private FDPG helper. -/
private structure PolyhedralProjectionFDPGState (n p : ℕ) where
  yCur : EuclideanSpace ℝ (Fin p)
  wCur : EuclideanSpace ℝ (Fin p)
  tCur : ℝ

/-- The initial internal state with `y⁰ = w⁰ = y0` and `t₀ = 1`. -/
private def polyhedral_projection_fdpg_initial_state
    (y0 : EuclideanSpace ℝ (Fin p)) : PolyhedralProjectionFDPGState n p :=
  { yCur := y0
    wCur := y0
    tCur := 1 }

/-- One internal FDPG state update step. -/
private def polyhedral_projection_fdpg_state_update
    (A : Matrix (Fin p) (Fin n) ℝ) (b : EuclideanSpace ℝ (Fin p)) (d : EuclideanSpace ℝ (Fin n))
    (L : PolyhedralProjectionStepsizeParameter A)
    (state : PolyhedralProjectionFDPGState n p) : PolyhedralProjectionFDPGState n p :=
  let u := polyhedral_projection_primal_point A d state.wCur
  let yNext := polyhedral_projection_dual_update A b L u state.wCur
  let tNext := fista_momentum_update state.tCur
  { yCur := yNext
    wCur := yNext + ((state.tCur - 1) / tNext) • (yNext - state.yCur)
    tCur := tNext }

/-- Internal recursion helper for the polyhedral-projection FDPG iterates. -/
private def polyhedral_projection_fdpg_state
    (A : Matrix (Fin p) (Fin n) ℝ) (b : EuclideanSpace ℝ (Fin p)) (d : EuclideanSpace ℝ (Fin n))
    (L : PolyhedralProjectionStepsizeParameter A) (y0 : EuclideanSpace ℝ (Fin p)) :
    ℕ → PolyhedralProjectionFDPGState n p
  | 0 => polyhedral_projection_fdpg_initial_state y0
  | k + 1 =>
      polyhedral_projection_fdpg_state_update A b d L
        (polyhedral_projection_fdpg_state A b d L y0 k)

/-- Algorithm 12.6: for the projection problem
`min_x {(1 / 2) ‖x - d‖^2 : A x ≤ b}`, given an admissible constant parameter `L ≥ ‖A‖₂,₂²`
and an initial point `y⁰ = w⁰ = y0`, the recursive families below generate the FDPG iterates
with step-(a) auxiliary point `u^k = Aᵀ w^k + d`, step-(b) update
`y^(k+1) = w^k - (1 / L) A u^k + (1 / L) min {A u^k - L w^k, b}`, step-(c) momentum recursion
`t_(k+1) = (1 + √(1 + 4 t_k^2)) / 2`, and step-(d) extrapolation
`w^(k+1) = y^(k+1) + ((t_k - 1) / t_(k+1)) (y^(k+1) - y^k)`. The public API keeps this direct
source-facing recursion and also provides the convenient corollaries `w¹ = y¹` and
`w^(k+2) = y^(k+2) + ((t_(k+1) - 1) / t_(k+2)) (y^(k+2) - y^(k+1))`. -/
def polyhedral_projection_fdpg_y
    (A : Matrix (Fin p) (Fin n) ℝ) (b : EuclideanSpace ℝ (Fin p)) (d : EuclideanSpace ℝ (Fin n))
    (L : PolyhedralProjectionStepsizeParameter A) (y0 : EuclideanSpace ℝ (Fin p)) :
    ℕ → EuclideanSpace ℝ (Fin p) :=
  fun k ↦ (polyhedral_projection_fdpg_state A b d L y0 k).yCur

/-- The extrapolated sequence `w^k` generated by Algorithm 12.6. -/
def polyhedral_projection_fdpg_w
    (A : Matrix (Fin p) (Fin n) ℝ) (b : EuclideanSpace ℝ (Fin p)) (d : EuclideanSpace ℝ (Fin n))
    (L : PolyhedralProjectionStepsizeParameter A) (y0 : EuclideanSpace ℝ (Fin p)) :
    ℕ → EuclideanSpace ℝ (Fin p) :=
  fun k ↦ (polyhedral_projection_fdpg_state A b d L y0 k).wCur

/-- The auxiliary primal sequence `u^k = Aᵀ w^k + d` derived from the FDPG iterates. -/
def polyhedral_projection_fdpg_u
    (A : Matrix (Fin p) (Fin n) ℝ) (b : EuclideanSpace ℝ (Fin p)) (d : EuclideanSpace ℝ (Fin n))
    (L : PolyhedralProjectionStepsizeParameter A) (y0 : EuclideanSpace ℝ (Fin p)) :
    ℕ → EuclideanSpace ℝ (Fin n) :=
  fun k ↦ polyhedral_projection_primal_point A d (polyhedral_projection_fdpg_w A b d L y0 k)

private theorem polyhedral_projection_fdpg_state_tCur_eq
    (A : Matrix (Fin p) (Fin n) ℝ) (b : EuclideanSpace ℝ (Fin p)) (d : EuclideanSpace ℝ (Fin n))
    (L : PolyhedralProjectionStepsizeParameter A) (y0 : EuclideanSpace ℝ (Fin p)) (k : ℕ) :
    (polyhedral_projection_fdpg_state A b d L y0 k).tCur = fista_momentum_sequence k := by
  induction k with
  | zero =>
      rfl
  | succ k ih =>
      simp [polyhedral_projection_fdpg_state, polyhedral_projection_fdpg_state_update,
        fista_momentum_sequence_succ, ih]

section

/-- The FDPG dual sequence starts at the prescribed initial point `y⁰ = y0`. -/
theorem polyhedral_projection_fdpg_y_zero
    (A : Matrix (Fin p) (Fin n) ℝ) (b : EuclideanSpace ℝ (Fin p)) (d : EuclideanSpace ℝ (Fin n))
    (L : PolyhedralProjectionStepsizeParameter A) (y0 : EuclideanSpace ℝ (Fin p)) :
    polyhedral_projection_fdpg_y A b d L y0 0 = y0 :=
  rfl

/-- The extrapolated FDPG sequence satisfies `w⁰ = y0`. -/
theorem polyhedral_projection_fdpg_w_zero
    (A : Matrix (Fin p) (Fin n) ℝ) (b : EuclideanSpace ℝ (Fin p)) (d : EuclideanSpace ℝ (Fin n))
    (L : PolyhedralProjectionStepsizeParameter A) (y0 : EuclideanSpace ℝ (Fin p)) :
    polyhedral_projection_fdpg_w A b d L y0 0 = y0 :=
  rfl

/-- At every iteration `k`, the auxiliary point satisfies the textbook step-(a) formula
`u^k = Aᵀ w^k + d`. -/
theorem polyhedral_projection_fdpg_u_eq
    (A : Matrix (Fin p) (Fin n) ℝ) (b : EuclideanSpace ℝ (Fin p)) (d : EuclideanSpace ℝ (Fin n))
    (L : PolyhedralProjectionStepsizeParameter A) (y0 : EuclideanSpace ℝ (Fin p)) (k : ℕ) :
    polyhedral_projection_fdpg_u A b d L y0 k =
      A.transpose.toEuclideanLin (polyhedral_projection_fdpg_w A b d L y0 k) + d :=
  rfl

/-- At every iteration `k`, the next dual iterate is obtained by the shared polyhedral-projection
dual-update owner applied to `u^k` and `w^k`. -/
theorem polyhedral_projection_fdpg_y_succ
    (A : Matrix (Fin p) (Fin n) ℝ) (b : EuclideanSpace ℝ (Fin p)) (d : EuclideanSpace ℝ (Fin n))
    (L : PolyhedralProjectionStepsizeParameter A) (y0 : EuclideanSpace ℝ (Fin p)) (k : ℕ) :
    polyhedral_projection_fdpg_y A b d L y0 (k + 1) =
      polyhedral_projection_dual_update A b L
        (polyhedral_projection_fdpg_u A b d L y0 k)
        (polyhedral_projection_fdpg_w A b d L y0 k) :=
  rfl

/-- The extrapolated FDPG iterates satisfy the textbook step-(d) recursion
`w^(k+1) = y^(k+1) + ((t_k - 1) / t_(k+1)) (y^(k+1) - y^k)`, where `t_k` is the canonical
Chapter 10 FISTA momentum sequence. -/
theorem polyhedral_projection_fdpg_w_succ
    (A : Matrix (Fin p) (Fin n) ℝ) (b : EuclideanSpace ℝ (Fin p)) (d : EuclideanSpace ℝ (Fin n))
    (L : PolyhedralProjectionStepsizeParameter A) (y0 : EuclideanSpace ℝ (Fin p)) (k : ℕ) :
    polyhedral_projection_fdpg_w A b d L y0 (k + 1) =
      polyhedral_projection_fdpg_y A b d L y0 (k + 1) +
        ((fista_momentum_sequence k - 1) / fista_momentum_sequence (k + 1)) •
          (polyhedral_projection_fdpg_y A b d L y0 (k + 1) -
            polyhedral_projection_fdpg_y A b d L y0 k) := by
  simp only [polyhedral_projection_fdpg_w, polyhedral_projection_fdpg_y,
    polyhedral_projection_fdpg_state, polyhedral_projection_fdpg_state_update]
  rw [polyhedral_projection_fdpg_state_tCur_eq A b d L y0 k, ← fista_momentum_sequence_succ]

/-- The first extrapolated iterate satisfies `w¹ = y¹`. -/
theorem polyhedral_projection_fdpg_w_one
    (A : Matrix (Fin p) (Fin n) ℝ) (b : EuclideanSpace ℝ (Fin p)) (d : EuclideanSpace ℝ (Fin n))
    (L : PolyhedralProjectionStepsizeParameter A) (y0 : EuclideanSpace ℝ (Fin p)) :
    polyhedral_projection_fdpg_w A b d L y0 1 =
      polyhedral_projection_fdpg_y A b d L y0 1 :=
  by
    simpa using polyhedral_projection_fdpg_w_succ A b d L y0 0

/-- For every `k`, the later extrapolated iterates satisfy the shifted textbook step-(d)
recursion
`w^(k+2) = y^(k+2) + ((t_(k+1) - 1) / t_(k+2)) (y^(k+2) - y^(k+1))`, where `t_k` is the
canonical Chapter 10 FISTA momentum sequence. -/
theorem polyhedral_projection_fdpg_w_succ_succ
    (A : Matrix (Fin p) (Fin n) ℝ) (b : EuclideanSpace ℝ (Fin p)) (d : EuclideanSpace ℝ (Fin n))
    (L : PolyhedralProjectionStepsizeParameter A) (y0 : EuclideanSpace ℝ (Fin p)) (k : ℕ) :
    polyhedral_projection_fdpg_w A b d L y0 (k + 2) =
      polyhedral_projection_fdpg_y A b d L y0 (k + 2) +
        ((fista_momentum_sequence (k + 1) - 1) / fista_momentum_sequence (k + 2)) •
          (polyhedral_projection_fdpg_y A b d L y0 (k + 2) -
            polyhedral_projection_fdpg_y A b d L y0 (k + 1)) :=
  by
    simpa [Nat.add_assoc] using polyhedral_projection_fdpg_w_succ A b d L y0 (k + 1)

/-- The explicit FDPG projection recursion is a Chapter 12.4 fast dual proximal-gradient primal
trajectory for the quadratic projection objective and the upper-box indicator. -/
theorem polyhedral_projection_fdpg_isFastDualProximalGradientPrimalTrajectory
    (A : Matrix (Fin p) (Fin n) ℝ) (b : EuclideanSpace ℝ (Fin p)) (d : EuclideanSpace ℝ (Fin n))
    (L : PolyhedralProjectionStepsizeParameter A) (y0 : EuclideanSpace ℝ (Fin p)) :
    IsFastDualProximalGradientPrimalTrajectory
      (denoising_data_fidelity d)
      (δ_ {z : EuclideanSpace ℝ (Fin p) | ∀ i : Fin p, z i ≤ b i})
      A.toEuclideanLin
      (1 : PosReal)
      L
      y0
      (polyhedral_projection_fdpg_u A b d L y0)
      (polyhedral_projection_fdpg_y A b d L y0)
      (polyhedral_projection_fdpg_w A b d L y0)
      fista_momentum_sequence := by
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · exact polyhedral_projection_fdpg_y_zero A b d L y0
  · exact polyhedral_projection_fdpg_w_zero A b d L y0
  · exact fista_momentum_sequence_zero
  · intro k
    simpa [polyhedral_projection_fdpg_u] using
      polyhedral_projection_primal_point_mem_argmax
        A d (polyhedral_projection_fdpg_w A b d L y0 k)
  · intro k
    simpa [polyhedral_projection_fdpg_y_succ] using
      polyhedral_projection_dual_update_mem_y_step
        A b L
        (polyhedral_projection_fdpg_u A b d L y0 k)
        (polyhedral_projection_fdpg_w A b d L y0 k)
  · intro k
    exact fista_momentum_sequence_succ k
  · intro k
    exact polyhedral_projection_fdpg_w_succ A b d L y0 k

/-- Typeclass inference can use the explicit Algorithm 12.6 polyhedral-projection recursion as the
canonical Chapter 12.4 fast dual proximal-gradient primal trajectory. -/
instance instPolyhedralProjectionFDPGIsFastDualProximalGradientPrimalTrajectory
    (A : Matrix (Fin p) (Fin n) ℝ) (b : EuclideanSpace ℝ (Fin p)) (d : EuclideanSpace ℝ (Fin n))
    (L : PolyhedralProjectionStepsizeParameter A) (y0 : EuclideanSpace ℝ (Fin p)) :
    IsFastDualProximalGradientPrimalTrajectory
      (denoising_data_fidelity d)
      (δ_ {z : EuclideanSpace ℝ (Fin p) | ∀ i : Fin p, z i ≤ b i})
      A.toEuclideanLin
      (1 : PosReal)
      L
      y0
      (polyhedral_projection_fdpg_u A b d L y0)
      (polyhedral_projection_fdpg_y A b d L y0)
      (polyhedral_projection_fdpg_w A b d L y0)
      fista_momentum_sequence :=
  polyhedral_projection_fdpg_isFastDualProximalGradientPrimalTrajectory A b d L y0

end

end
