variable {ι : Type u} [Fintype ι]
variable {Ei : ι → Type v}
variable [∀ i, NormedAddCommGroup (Ei i)] [∀ i, NormedSpace ℝ (Ei i)]

/-- The deterministic initial Lyapunov quantity
`(1 / 2) ‖xInit - xStar‖_[L]^2 + objective xInit - Fopt`
appearing on the right-hand side of the RBPG sublinear bound. -/
abbrev rbpg_initial_lyapunov
    (L : ι → PosReal)
    (Fopt : ℝ)
    (objective : ((i : ι) → Ei i) → EReal)
    (xInit xStar : (i : ι) → Ei i) : ℝ :=
  (1 / 2 : ℝ) * ‖xInit - xStar‖_[L] ^ (2 : ℕ) + (objective xInit).toReal - Fopt

/-- Expanding `rbpg_initial_lyapunov` recovers the textbook Lyapunov quantity
`(1 / 2) ‖xInit - xStar‖_[L]^2 + objective xInit - Fopt`. -/
@[simp] theorem rbpg_initial_lyapunov_def
    (L : ι → PosReal)
    (Fopt : ℝ)
    (objective : ((i : ι) → Ei i) → EReal)
    (xInit xStar : (i : ι) → Ei i) :
    rbpg_initial_lyapunov L Fopt objective xInit xStar =
      (1 / 2 : ℝ) * ‖xInit - xStar‖_[L] ^ (2 : ℕ) + (objective xInit).toReal - Fopt :=
  rfl

end

section

variable {Ω : Type w} [MeasurableSpace Ω]
variable {ι : Type u} [Fintype ι] [MeasurableSpace ι] [DiscreteMeasurableSpace ι]
variable {Ei : ι → Type v}
variable [∀ i, NormedAddCommGroup (Ei i)] [∀ i, InnerProductSpace ℝ (Ei i)]
variable [∀ i, ProperSpace (Ei i)]
variable {Li : ι → PosReal}
variable {f : ((i : ι) → Ei i) → EReal} {g : (i : ι) → Ei i → EReal}
variable {block_gradient : (i : ι) → ((j : ι) → Ei j) → Ei i}
variable {XStar : Set ((i : ι) → Ei i)} {FOpt : ℝ}

/-- The realized `n`-th RBPG iterate along the sample path `ω`, obtained by feeding the block
sequence `m ↦ sampled_block m ω` into the pathwise recursion from `Algorithm_11_5`. -/
abbrev rbpg_pathwise_iterate
    (hproblem : RandomizedBlockProximalGradientAssumptions f g block_gradient XStar FOpt Li)
    (x0 : effective_domain (separableSum g))
    (sampled_block : ℕ → Ω → ι)
    (ω : Ω) (n : ℕ) : (i : ι) → Ei i :=
  randomized_block_proximal_gradient_method
    hproblem.toIsBlockProximalGradientProblem
    (hproblem.interior_effective_domain_point x0)
    (fun m ↦ sampled_block m ω)
    n

/-- Expanding `rbpg_pathwise_iterate` recovers the deterministic RBPG recursion driven by the
realized sample path `m ↦ sampled_block m ω`. -/
@[simp] theorem rbpg_pathwise_iterate_def
    (hproblem : RandomizedBlockProximalGradientAssumptions f g block_gradient XStar FOpt Li)
    (x0 : effective_domain (separableSum g))
    (sampled_block : ℕ → Ω → ι)
    (ω : Ω) (n : ℕ) :
    rbpg_pathwise_iterate hproblem x0 sampled_block ω n =
      randomized_block_proximal_gradient_method
        hproblem.toIsBlockProximalGradientProblem
        (hproblem.interior_effective_domain_point x0)
        (fun m ↦ sampled_block m ω)
        n :=
  rfl

/-- The expected RBPG objective gap
`E[(composite_model_objective f (separableSum g)) (x^n)] - FOpt`
for the pathwise iterates generated by `sampled_block`. -/
abbrev rbpg_expected_objective_gap
    (hproblem : RandomizedBlockProximalGradientAssumptions f g block_gradient XStar FOpt Li)
    (x0 : effective_domain (separableSum g))
    (sampled_block : ℕ → Ω → ι)
    (μ : Measure Ω)
    [IsProbabilityMeasure μ] : ℕ → ℝ :=
  fun n ↦
    μ[fun ω ↦
      (composite_model_objective f (separableSum g)
        (rbpg_pathwise_iterate hproblem x0 sampled_block ω n)).toReal] - FOpt

/-- Expanding `rbpg_expected_objective_gap` gives the expectation of the composite objective along
the realized RBPG iterate `rbpg_pathwise_iterate hproblem x0 sampled_block ω n`, shifted by
`FOpt`. -/
@[simp] theorem rbpg_expected_objective_gap_apply
    (hproblem : RandomizedBlockProximalGradientAssumptions f g block_gradient XStar FOpt Li)
    (x0 : effective_domain (separableSum g))
    (sampled_block : ℕ → Ω → ι)
    (μ : Measure Ω)
    [IsProbabilityMeasure μ]
    (n : ℕ) :
    rbpg_expected_objective_gap hproblem x0 sampled_block μ n =
      μ[fun ω ↦
        (composite_model_objective f (separableSum g)
          (rbpg_pathwise_iterate hproblem x0 sampled_block ω n)).toReal] - FOpt :=
  rfl

/-- Helper for Theorem 11.11: a finite block history `ξ : Fin n → ι` together with a current
block `i` is extended to a full schedule by reusing `i` from time `n` onward. -/
def rbpgHistoryWithCurrent
    (n : ℕ) (ξ : Fin n → ι) (i : ι) : ℕ → ι :=
  fun m ↦ if hm : m < n then ξ ⟨m, hm⟩ else i

/-- Helper for Theorem 11.11: on times strictly before `n`, `rbpgHistoryWithCurrent n ξ i`
recovers the frozen history `ξ`. -/
@[simp] theorem rbpgHistoryWithCurrent_apply_lt
    (n : ℕ) (ξ : Fin n → ι) (i : ι) {m : ℕ} (hm : m < n) :
    rbpgHistoryWithCurrent n ξ i m = ξ ⟨m, hm⟩ := by
  simp [rbpgHistoryWithCurrent, hm]

/-- Helper for Theorem 11.11: at time `n`, `rbpgHistoryWithCurrent n ξ i` returns the current
block `i`. -/
@[simp] theorem rbpgHistoryWithCurrent_apply_self
    (n : ℕ) (ξ : Fin n → ι) (i : ι) :
    rbpgHistoryWithCurrent n ξ i n = i := by
  simp [rbpgHistoryWithCurrent]

/-- Helper for Theorem 11.11: the iterate at time `n` depends only on the first `n` sampled
blocks. -/
lemma rbpgIterate_eq_of_prefix_eq
    (hproblem : RandomizedBlockProximalGradientAssumptions f g block_gradient XStar FOpt Li)
    (x0 : effective_domain (separableSum g))
    {σ τ : ℕ → ι} {n : ℕ}
    (hprefix : ∀ m < n, σ m = τ m) :
    randomized_block_proximal_gradient_method
        hproblem.toIsBlockProximalGradientProblem
        (hproblem.interior_effective_domain_point x0)
        σ
        n =
      randomized_block_proximal_gradient_method
        hproblem.toIsBlockProximalGradientProblem
        (hproblem.interior_effective_domain_point x0)
        τ
        n := by
  revert hprefix
  induction n with
  | zero =>
      intro _
      rfl
  | succ n ih =>
      intro hprefix
      -- Rewrite both successors and apply the induction hypothesis to the shared prefix.
      rw [randomized_block_proximal_gradient_method_succ,
        randomized_block_proximal_gradient_method_succ]
      have hprev :
          randomized_block_proximal_gradient_method
              hproblem.toIsBlockProximalGradientProblem
              (hproblem.interior_effective_domain_point x0)
              σ
              n =
            randomized_block_proximal_gradient_method
              hproblem.toIsBlockProximalGradientProblem
              (hproblem.interior_effective_domain_point x0)
              τ
              n := by
        refine ih ?_
        intro m hm
        exact hprefix m (Nat.lt_trans hm (Nat.lt_succ_self n))
      rw [hprefix n (Nat.lt_succ_self n), hprev]

/-- Helper for Theorem 11.11: the realized RBPG iterate at time `n` agrees with the iterate
driven by the frozen history `ξ_{n-1}` extended by the current block `i_n`. -/
lemma rbpgPathwiseIterate_eq_historyCurrent
    (hproblem : RandomizedBlockProximalGradientAssumptions f g block_gradient XStar FOpt Li)
    (x0 : effective_domain (separableSum g))
    (sampled_block : ℕ → Ω → ι)
    (ω : Ω) (n : ℕ) :
    rbpg_pathwise_iterate hproblem x0 sampled_block ω n =
      randomized_block_proximal_gradient_method
        hproblem.toIsBlockProximalGradientProblem
        (hproblem.interior_effective_domain_point x0)
        (rbpgHistoryWithCurrent
          n
          (randomized_block_history (fun m ↦ sampled_block m ω) n)
          (sampled_block n ω))
        n := by
  -- Up to time `n`, the frozen-history extension matches the realized sample path exactly.
  apply rbpgIterate_eq_of_prefix_eq hproblem x0
  intro m hm
  simp [rbpgHistoryWithCurrent, randomized_block_history, hm]

/-- Helper for Theorem 11.11: the realized RBPG iterate at time `n + 1` is obtained from the same
frozen history and current block `i_n`. -/
lemma rbpgPathwiseIterate_succ_eq_historyCurrent
    (hproblem : RandomizedBlockProximalGradientAssumptions f g block_gradient XStar FOpt Li)
    (x0 : effective_domain (separableSum g))
    (sampled_block : ℕ → Ω → ι)
    (ω : Ω) (n : ℕ) :
    rbpg_pathwise_iterate hproblem x0 sampled_block ω (n + 1) =
      randomized_block_proximal_gradient_method
        hproblem.toIsBlockProximalGradientProblem
        (hproblem.interior_effective_domain_point x0)
        (rbpgHistoryWithCurrent
          n
          (randomized_block_history (fun m ↦ sampled_block m ω) n)
          (sampled_block n ω))
        (n + 1) := by
  -- The extended history also matches the realized path at the current block `i_n`.
  apply rbpgIterate_eq_of_prefix_eq hproblem x0
  intro m hm
  by_cases hmn : m < n
  · simp [rbpgHistoryWithCurrent, randomized_block_history, hmn]
  · have hm_eq : m = n := Nat.eq_of_lt_succ_of_not_lt hm hmn
    subst hm_eq
    simp [rbpgHistoryWithCurrent]

/-- Helper for Theorem 11.11: every realized RBPG objective value is finite, so it agrees with
the coercion of its real part. -/
lemma rbpgIterateObjective_eq_coeToReal
    (hproblem : RandomizedBlockProximalGradientAssumptions f g block_gradient XStar FOpt Li)
    (x0 : effective_domain (separableSum g))
    (sampled_block : ℕ → Ω → ι)
    (ω : Ω) (n : ℕ) :
    composite_model_objective f (separableSum g)
        (rbpg_pathwise_iterate hproblem x0 sampled_block ω n) =
      ((((composite_model_objective f (separableSum g)
          (rbpg_pathwise_iterate hproblem x0 sampled_block ω n)).toReal : ℝ)) : EReal) := by
  let xn := rbpg_pathwise_iterate hproblem x0 sampled_block ω n
  have hxn_g :
      xn ∈ effective_domain (separableSum g) :=
    IsBlockProximalGradientProblem.randomized_block_proximal_gradient_iterate_mem_effective_domain
      hproblem.toIsBlockProximalGradientProblem
      x0
      (fun m ↦ sampled_block m ω)
      n
  have hxn_f :
      xn ∈ effective_domain f := by
    exact
      interior_subset
        (IsBlockProximalGradientProblem.mem_interior_effective_domain_of_mem_g_effective_domain
          hproblem.toIsBlockProximalGradientProblem
          hxn_g)
  have hsep_ne_bot : separableSum g xn ≠ ⊥ :=
    (separableSum_proper g hproblem.block_g_proper).ne_bot xn
  have hobj_ne_top :
      composite_model_objective f (separableSum g) xn ≠ ⊤ := by
    rw [composite_model_objective_apply]
    exact EReal.add_ne_top (mem_effective_domain.mp hxn_f).ne (mem_effective_domain.mp hxn_g).ne
  have hobj_ne_bot :
      composite_model_objective f (separableSum g) xn ≠ ⊥ := by
    rw [composite_model_objective_apply, EReal.add_ne_bot_iff]
    exact ⟨hproblem.toIsBlockProximalGradientProblem.f_ne_bot xn, hsep_ne_bot⟩
  -- Once the objective is finite, `toReal` is a lossless coercion.
  exact (EReal.coe_toReal hobj_ne_top hobj_ne_bot).symm

/-- Helper for Theorem 11.11: after freezing the history `ξ_{n-1}` and the current block `i_n`,
the one-step RBPG sufficient-decrease estimate yields monotonicity of the realized objective on
the real layer. -/
lemma rbpgHistoryCurrentObjectiveStepMonotone
    (hproblem : RandomizedBlockProximalGradientAssumptions f g block_gradient XStar FOpt Li)
    (x0 : effective_domain (separableSum g))
    (n : ℕ) (ξ : Fin n → ι) (i : ι) :
    (composite_model_objective f (separableSum g)
        (randomized_block_proximal_gradient_method
          hproblem.toIsBlockProximalGradientProblem
          (hproblem.interior_effective_domain_point x0)
          (rbpgHistoryWithCurrent n ξ i)
          (n + 1))).toReal ≤
      (composite_model_objective f (separableSum g)
        (randomized_block_proximal_gradient_method
          hproblem.toIsBlockProximalGradientProblem
          (hproblem.interior_effective_domain_point x0)
          (rbpgHistoryWithCurrent n ξ i)
          n)).toReal := by
  let σ : ℕ → ι := rbpgHistoryWithCurrent n ξ i
  let xk :=
    randomized_block_proximal_gradient_method
      hproblem.toIsBlockProximalGradientProblem
      (hproblem.interior_effective_domain_point x0)
      σ
      n
  let xkNext :=
    randomized_block_proximal_gradient_method
      hproblem.toIsBlockProximalGradientProblem
      (hproblem.interior_effective_domain_point x0)
      σ
      (n + 1)
  let ik : ι := σ n
  let stepResidual : Ei ik :=
    xk ik -
      T[Li ik; g, block_gradient, hproblem.block_g_proper, hproblem.block_g_closed,
        hproblem.block_g_convex] xk ik
  have hstepE :
      ((((1 / (2 * (Li ik : ℝ))) *
            ‖(Li ik : ℝ) • stepResidual‖ ^ (2 : ℕ) : ℝ)) :
          EReal) ≤
        composite_model_objective f (separableSum g) xk -
          composite_model_objective f (separableSum g) xkNext := by
    -- Specialize the owner sufficient-decrease theorem to the frozen history and current block.
    simpa [σ, xk, xkNext, ik, stepResidual, block_partial_gradient_mapping_def] using
      RandomizedBlockProximalGradientAssumptions.randomized_block_proximal_gradient_sufficient_decrease
        hproblem
        x0
        σ
        n
  have hxk_val :
      composite_model_objective f (separableSum g) xk =
        ((((composite_model_objective f (separableSum g) xk).toReal : ℝ)) : EReal) := by
    -- The deterministic iterate is a realized pathwise iterate on the one-point sample space.
    simpa [rbpg_pathwise_iterate, σ, xk] using
      rbpgIterateObjective_eq_coeToReal
        (Ω := Unit)
        hproblem
        x0
        (fun m (_ : Unit) ↦ σ m)
        ()
        n
  have hxkNext_val :
      composite_model_objective f (separableSum g) xkNext =
        ((((composite_model_objective f (separableSum g) xkNext).toReal : ℝ)) : EReal) := by
    -- The same finiteness argument applies after one more deterministic block update.
    simpa [rbpg_pathwise_iterate, σ, xkNext] using
      rbpgIterateObjective_eq_coeToReal
        (Ω := Unit)
        hproblem
        x0
        (fun m (_ : Unit) ↦ σ m)
        ()
        (n + 1)
  have hstepReal :
      (1 / (2 * (Li ik : ℝ))) *
          ‖(Li ik : ℝ) • stepResidual‖ ^ (2 : ℕ) ≤
        (composite_model_objective f (separableSum g) xk).toReal -
          (composite_model_objective f (separableSum g) xkNext).toReal := by
    -- After rewriting both finite objective values as real coercions, the drop is purely real.
    rw [hxk_val, hxkNext_val] at hstepE
    have hstepE' :
        ((((1 / (2 * (Li ik : ℝ))) *
              ‖(Li ik : ℝ) • stepResidual‖ ^ (2 : ℕ) : ℝ)) :
            EReal) ≤
          ((((composite_model_objective f (separableSum g) xk).toReal -
                (composite_model_objective f (separableSum g) xkNext).toReal : ℝ)) : EReal) := by
      simpa [EReal.coe_sub] using hstepE
    exact EReal.coe_le_coe_iff.mp hstepE'
  have hdrop_nonneg :
      0 ≤
        (1 / (2 * (Li ik : ℝ))) *
          ‖(Li ik : ℝ) • stepResidual‖ ^ (2 : ℕ) := by
    have hLi_pos : 0 < (Li ik : ℝ) := PosReal.coe_pos (Li ik)
    have hden_pos : 0 < 2 * (Li ik : ℝ) := by nlinarith
    have hcoef_nonneg : 0 ≤ 1 / (2 * (Li ik : ℝ)) := by
      exact one_div_nonneg.mpr hden_pos.le
    have hsq_nonneg :
        0 ≤ ‖(Li ik : ℝ) • stepResidual‖ ^ (2 : ℕ) := by
      positivity
    exact mul_nonneg hcoef_nonneg hsq_nonneg
  have hobj_drop_nonneg :
      0 ≤
        (composite_model_objective f (separableSum g) xk).toReal -
          (composite_model_objective f (separableSum g) xkNext).toReal :=
    hdrop_nonneg.trans hstepReal
  -- The real objective drop is nonnegative, so the next objective value is bounded by the current one.
  exact sub_nonneg.mp hobj_drop_nonneg

/-- Helper for Theorem 11.11: the expected objective-gap sequence is antitone. -/
lemma rbpgExpectedObjectiveGapAntitone
    (hproblem : RandomizedBlockProximalGradientAssumptions f g block_gradient XStar FOpt Li)
    (x0 : effective_domain (separableSum g))
    (sampled_block : ℕ → Ω → ι)
    (μ : Measure Ω)
    [IsProbabilityMeasure μ]
    (h_sampled_block_meas : ∀ k, Measurable (sampled_block k))
    (h_sampled_block_indep : iIndepFun sampled_block μ)
    (h_sampled_block_uniform :
      ∀ k (i : ι), μ ((sampled_block k) ⁻¹' {i}) = 1 / (Fintype.card ι : ENNReal)) :
    Antitone (rbpg_expected_objective_gap hproblem x0 sampled_block μ) := by
  refine antitone_nat_of_succ_le fun n ↦ ?_
  let ψ : (Fin n → ι) → ι → ℝ :=
    fun ξ i ↦
      (composite_model_objective f (separableSum g)
        (randomized_block_proximal_gradient_method
          hproblem.toIsBlockProximalGradientProblem
          (hproblem.interior_effective_domain_point x0)
          (rbpgHistoryWithCurrent n ξ i)
          (n + 1))).toReal
  let χ : (Fin n → ι) → ι → ℝ :=
    fun ξ i ↦
      (composite_model_objective f (separableSum g)
        (randomized_block_proximal_gradient_method
          hproblem.toIsBlockProximalGradientProblem
          (hproblem.interior_effective_domain_point x0)
          (rbpgHistoryWithCurrent n ξ i)
          n)).toReal
  let history : Ω → Fin n → ι :=
    fun ω ↦ randomized_block_history (fun m ↦ sampled_block m ω) n
  let avgψ : (Fin n → ι) → ℝ :=
    fun ξ ↦ ((Fintype.card ι : ℝ)⁻¹) * ∑ i, ψ ξ i
  let avgχ : (Fin n → ι) → ℝ :=
    fun ξ ↦ ((Fintype.card ι : ℝ)⁻¹) * ∑ i, χ ξ i
  have hψ_path :
      μ[fun ω ↦
        (composite_model_objective f (separableSum g)
          (rbpg_pathwise_iterate hproblem x0 sampled_block ω (n + 1))).toReal] =
        μ[fun ω ↦ ψ (history ω) (sampled_block n ω)] := by
    -- Rewrite the realized `(n + 1)`-st iterate through the frozen history and current block.
    refine integral_congr_ae ?_
    filter_upwards with ω
    have hω :=
      rbpgPathwiseIterate_succ_eq_historyCurrent hproblem x0 sampled_block ω n
    simpa [ψ, history] using
      congrArg (fun x ↦ (composite_model_objective f (separableSum g) x).toReal) hω
  have hχ_path :
      μ[fun ω ↦
        (composite_model_objective f (separableSum g)
          (rbpg_pathwise_iterate hproblem x0 sampled_block ω n)).toReal] =
        μ[fun ω ↦ χ (history ω) (sampled_block n ω)] := by
    -- The same frozen-history rewrite identifies the current objective observable.
    refine integral_congr_ae ?_
    filter_upwards with ω
    have hω :=
      rbpgPathwiseIterate_eq_historyCurrent hproblem x0 sampled_block ω n
    simpa [χ, history] using
      congrArg (fun x ↦ (composite_model_objective f (separableSum g) x).toReal) hω
  have hψ_avg :
      μ[fun ω ↦ ψ (history ω) (sampled_block n ω)] =
        μ[fun ω ↦ avgψ (history ω)] := by
    -- Average the next-step objective over the current sampled block.
    simpa [history, avgψ] using
      randomized_block_history_current_block_average
        (μ := μ)
        (sampled_block := sampled_block)
        n
        ψ
        h_sampled_block_meas
        h_sampled_block_indep
        h_sampled_block_uniform
  have hχ_avg :
      μ[fun ω ↦ χ (history ω) (sampled_block n ω)] =
        μ[fun ω ↦ avgχ (history ω)] := by
    -- Average the current objective over the same frozen history/current-block decomposition.
    simpa [history, avgχ] using
      randomized_block_history_current_block_average
        (μ := μ)
        (sampled_block := sampled_block)
        n
        χ
        h_sampled_block_meas
        h_sampled_block_indep
        h_sampled_block_uniform
  have havgψ_int :
      Integrable (fun ω ↦ avgψ (history ω)) μ := by
    -- The averaged next-step observable depends only on the finite history `ξ_{n-1}`.
    simpa [history, avgψ] using
      randomized_block_history_observable_integrable
        (μ := μ)
        (sampled_block := sampled_block)
        n
        avgψ
        h_sampled_block_meas
  have havgχ_int :
      Integrable (fun ω ↦ avgχ (history ω)) μ := by
    -- The averaged current-step observable is another finite-history function.
    simpa [history, avgχ] using
      randomized_block_history_observable_integrable
        (μ := μ)
        (sampled_block := sampled_block)
        n
        avgχ
        h_sampled_block_meas
  have hcardInv_nonneg : 0 ≤ (Fintype.card ι : ℝ)⁻¹ := by
    exact inv_nonneg.mpr <| by exact_mod_cast Nat.zero_le (Fintype.card ι)
  have havg_le :
      μ[fun ω ↦ avgψ (history ω)] ≤
        μ[fun ω ↦ avgχ (history ω)] := by
    -- Apply the deterministic monotonicity blockwise and sum the resulting inequalities.
    refine integral_mono_ae havgψ_int havgχ_int ?_
    filter_upwards with ω
    have hsum :
        ∑ i, ψ (history ω) i ≤
          ∑ i, χ (history ω) i := by
      refine Finset.sum_le_sum ?_
      intro i hi
      exact
        rbpgHistoryCurrentObjectiveStepMonotone
          hproblem
          x0
          n
          (history ω)
          i
    exact mul_le_mul_of_nonneg_left hsum hcardInv_nonneg
  have hstep_obj :
      μ[fun ω ↦
        (composite_model_objective f (separableSum g)
          (rbpg_pathwise_iterate hproblem x0 sampled_block ω (n + 1))).toReal] ≤
        μ[fun ω ↦
          (composite_model_objective f (separableSum g)
            (rbpg_pathwise_iterate hproblem x0 sampled_block ω n)).toReal] := by
    -- Combine the pathwise rewrites with the averaged blockwise monotonicity.
    calc
      μ[fun ω ↦
        (composite_model_objective f (separableSum g)
          (rbpg_pathwise_iterate hproblem x0 sampled_block ω (n + 1))).toReal] =
          μ[fun ω ↦ ψ (history ω) (sampled_block n ω)] := hψ_path
      _ = μ[fun ω ↦ avgψ (history ω)] := hψ_avg
      _ ≤ μ[fun ω ↦ avgχ (history ω)] := havg_le
      _ = μ[fun ω ↦ χ (history ω) (sampled_block n ω)] := hχ_avg.symm
      _ =
          μ[fun ω ↦
            (composite_model_objective f (separableSum g)
              (rbpg_pathwise_iterate hproblem x0 sampled_block ω n)).toReal] := hχ_path.symm
  -- Subtracting the common optimal value transfers the one-step objective monotonicity to the gap.
  simpa [rbpg_expected_objective_gap_apply] using sub_le_sub_right hstep_obj FOpt

/-- Helper for Theorem 11.11: the pathwise Lyapunov observable packages the squared weighted
distance to `xStar` and the objective gap at time `n`. -/
abbrev rbpgLyapunovObservable
    (hproblem : RandomizedBlockProximalGradientAssumptions f g block_gradient XStar FOpt Li)
    (x0 : effective_domain (separableSum g))
    (sampled_block : ℕ → Ω → ι)
    (xStar : (i : ι) → Ei i)
    (ω : Ω) (n : ℕ) : ℝ :=
  (1 / 2 : ℝ) * ‖rbpg_pathwise_iterate hproblem x0 sampled_block ω n - xStar‖_[Li] ^ (2 : ℕ) +
    (composite_model_objective f (separableSum g)
      (rbpg_pathwise_iterate hproblem x0 sampled_block ω n)).toReal - FOpt

/-- Helper for Theorem 11.11: the expected objective gap is bounded above by the expected
Lyapunov observable because the squared weighted norm term is pointwise nonnegative. -/
lemma rbpgExpectedObjectiveGap_le_expectedLyapunov
    (hproblem : RandomizedBlockProximalGradientAssumptions f g block_gradient XStar FOpt Li)
    (x0 : effective_domain (separableSum g))
    (sampled_block : ℕ → Ω → ι)
    (μ : Measure Ω)
    [IsProbabilityMeasure μ]
    (xStar : (i : ι) → Ei i)
    (h_sampled_block_meas : ∀ k, Measurable (sampled_block k))
    (h_sampled_block_indep : iIndepFun sampled_block μ)
    (h_sampled_block_uniform :
      ∀ k (i : ι), μ ((sampled_block k) ⁻¹' {i}) = 1 / (Fintype.card ι : ENNReal))
    (n : ℕ) :
    rbpg_expected_objective_gap hproblem x0 sampled_block μ (n + 1) ≤
      μ[fun ω ↦ rbpgLyapunovObservable hproblem x0 sampled_block xStar ω (n + 1)] := by
  -- Route correction: prove integrability through the finite joint state `(ξ_{n-1}, i_n)` and
  -- compare the realized shifted objective directly against the realized Lyapunov observable.
  let history : Ω → Fin n → ι :=
    fun ω ↦ randomized_block_history (fun m ↦ sampled_block m ω) n
  let joint : Ω → (Fin n → ι) × ι :=
    fun ω ↦ (history ω, sampled_block n ω)
  let objNext : Ω → ℝ :=
    fun ω ↦
      (composite_model_objective f (separableSum g)
        (rbpg_pathwise_iterate hproblem x0 sampled_block ω (n + 1))).toReal
  let shiftedObjective : Ω → ℝ :=
    fun ω ↦ objNext ω - FOpt
  let ψGap : (Fin n → ι) → ι → ℝ :=
    fun ξ i ↦
      (composite_model_objective f (separableSum g)
        (randomized_block_proximal_gradient_method
          hproblem.toIsBlockProximalGradientProblem
          (hproblem.interior_effective_domain_point x0)
          (rbpgHistoryWithCurrent n ξ i)
          (n + 1))).toReal - FOpt
  let ψLyap : (Fin n → ι) → ι → ℝ :=
    fun ξ i ↦
      (1 / 2 : ℝ) *
          ‖randomized_block_proximal_gradient_method
              hproblem.toIsBlockProximalGradientProblem
              (hproblem.interior_effective_domain_point x0)
              (rbpgHistoryWithCurrent n ξ i)
              (n + 1) - xStar‖_[Li] ^ (2 : ℕ) +
        (composite_model_objective f (separableSum g)
          (randomized_block_proximal_gradient_method
            hproblem.toIsBlockProximalGradientProblem
            (hproblem.interior_effective_domain_point x0)
            (rbpgHistoryWithCurrent n ξ i)
            (n + 1))).toReal - FOpt
  let φGap : ((Fin n → ι) × ι) → ℝ := fun z ↦ ψGap z.1 z.2
  let φLyap : ((Fin n → ι) × ι) → ℝ := fun z ↦ ψLyap z.1 z.2
  have hhistory_meas : Measurable history := by
    -- The frozen history is measurable because each coordinate is one sampled block.
    refine measurable_pi_lambda _ fun t ↦ ?_
    simpa [history, randomized_block_history] using h_sampled_block_meas t
  have hjoint_meas : Measurable joint := by
    -- Pairing the frozen history with the current block keeps the observable measurable.
    exact hhistory_meas.prodMk (h_sampled_block_meas n)
  have hshift_repr :
      shiftedObjective =
        fun ω ↦ ψGap (history ω) (sampled_block n ω) := by
    -- Rewrite the `(n + 1)`-st iterate through the frozen-history/current-block decomposition.
    funext ω
    have hω :=
      rbpgPathwiseIterate_succ_eq_historyCurrent hproblem x0 sampled_block ω n
    simpa [shiftedObjective, objNext, ψGap, history] using
      congrArg (fun x ↦ (composite_model_objective f (separableSum g) x).toReal - FOpt) hω
  have hlyap_repr :
      (fun ω ↦ rbpgLyapunovObservable hproblem x0 sampled_block xStar ω (n + 1)) =
        fun ω ↦ ψLyap (history ω) (sampled_block n ω) := by
    -- The same rewrite identifies the Lyapunov observable with a finite joint observable.
    funext ω
    have hω :=
      rbpgPathwiseIterate_succ_eq_historyCurrent hproblem x0 sampled_block ω n
    simpa [rbpgLyapunovObservable, ψLyap, history] using
      congrArg
        (fun x ↦
          (1 / 2 : ℝ) * ‖x - xStar‖_[Li] ^ (2 : ℕ) +
            (composite_model_objective f (separableSum g) x).toReal - FOpt)
        hω
  have hgap_joint_int :
      Integrable (fun ω ↦ ψGap (history ω) (sampled_block n ω)) μ := by
    -- Any real observable of the finite joint state `(ξ_{n-1}, i_n)` is integrable.
    have hφGap_int : Integrable φGap (μ.map joint) := by
      exact Integrable.of_finite
    simpa [joint, φGap] using hφGap_int.comp_measurable hjoint_meas
  have hlyap_joint_int :
      Integrable (fun ω ↦ ψLyap (history ω) (sampled_block n ω)) μ := by
    -- The same finite-range argument gives integrability of the Lyapunov observable.
    have hφLyap_int : Integrable φLyap (μ.map joint) := by
      exact Integrable.of_finite
    simpa [joint, φLyap] using hφLyap_int.comp_measurable hjoint_meas
  have hshift_int : Integrable shiftedObjective μ := by
    -- Transport integrability back to the realized pathwise shifted objective.
    rw [hshift_repr]
    exact hgap_joint_int
  have hlyap_int :
      Integrable (fun ω ↦ rbpgLyapunovObservable hproblem x0 sampled_block xStar ω (n + 1)) μ := by
    -- Transport integrability back to the realized pathwise Lyapunov observable.
    rw [hlyap_repr]
    exact hlyap_joint_int
  have hobj_int : Integrable objNext μ := by
    -- Adding back the constant `FOpt` recovers integrability of the raw objective observable.
    have hsum_int : Integrable (fun ω ↦ shiftedObjective ω + FOpt) μ := by
      exact hshift_int.add (integrable_const FOpt)
    simpa [shiftedObjective, objNext, sub_eq_add_neg, add_assoc] using hsum_int
  have hgap_eq :
      rbpg_expected_objective_gap hproblem x0 sampled_block μ (n + 1) =
        μ[fun ω ↦ shiftedObjective ω] := by
    -- Move the constant `FOpt` inside the integral once integrability is available.
    calc
      rbpg_expected_objective_gap hproblem x0 sampled_block μ (n + 1) =
          μ[fun ω ↦ objNext ω] - FOpt := by
            rfl
      _ = μ[fun ω ↦ objNext ω] - μ[fun _ : Ω ↦ FOpt] := by
            simp
      _ = μ[fun ω ↦ objNext ω - FOpt] := by
            symm
            exact integral_sub hobj_int (integrable_const FOpt)
      _ = μ[fun ω ↦ shiftedObjective ω] := by
            rfl
  have hmono :
      μ[fun ω ↦ shiftedObjective ω] ≤
        μ[fun ω ↦ rbpgLyapunovObservable hproblem x0 sampled_block xStar ω (n + 1)] := by
    -- Pointwise, the Lyapunov observable is the shifted objective plus a nonnegative norm term.
    refine integral_mono_ae hshift_int hlyap_int ?_
    filter_upwards with ω
    have hnorm_nonneg :
        0 ≤
          (1 / 2 : ℝ) *
            ‖rbpg_pathwise_iterate hproblem x0 sampled_block ω (n + 1) - xStar‖_[Li] ^ (2 : ℕ) := by
      positivity
    dsimp [shiftedObjective, objNext, rbpgLyapunovObservable]
    nlinarith
  exact hgap_eq.trans_le hmono

/-- Helper for Theorem 11.11: every optimizer in `XStar` attains the optimal value `FOpt`. -/
lemma rbpgObjective_eq_optimal_value_of_mem_optimal_set
    (hproblem : RandomizedBlockProximalGradientAssumptions f g block_gradient XStar FOpt Li)
    {xStar : (i : ι) → Ei i}
    (hxStar : xStar ∈ XStar) :
    composite_model_objective f (separableSum g) xStar = (FOpt : EReal) := by
  -- Route correction: normalize optimizer values through the owner optimal-set characterization
  -- before assembling the deterministic one-step Lyapunov inequality.
  apply le_antisymm
  · exact hproblem.optimal_value_isGLB.2 <| by
      rintro _ ⟨y, rfl⟩
      have hxOpt :
          xStar ∈ unconstrained_problem_solutions
            (composite_model_objective f (separableSum g)) := by
        simpa [hproblem.optimal_set_eq] using hxStar
      exact (mem_unconstrained_problem_solutions_iff_forall_le.mp hxOpt) y
  · exact hproblem.optimal_value_isGLB.1 ⟨xStar, rfl⟩

/-- Helper for Theorem 11.11: every optimizer has finite separable penalty value, hence lies in
the effective domain of `separableSum g`. -/
lemma rbpgMemEffectiveDomain_of_mem_optimal_set
    (hproblem : RandomizedBlockProximalGradientAssumptions f g block_gradient XStar FOpt Li)
    {xStar : (i : ι) → Ei i}
    (hxStar : xStar ∈ XStar) :
    xStar ∈ effective_domain (separableSum g) := by
  have hFxStar :
      composite_model_objective f (separableSum g) xStar = (FOpt : EReal) :=
    rbpgObjective_eq_optimal_value_of_mem_optimal_set hproblem hxStar
  have hg_ne_top :
      separableSum g xStar ≠ ⊤ := by
    -- If the separable penalty were `⊤`, then the composite objective would also be `⊤`,
    -- contradicting the finite optimizer value.
    intro hg_top
    have htop : composite_model_objective f (separableSum g) xStar = ⊤ := by
      calc
        composite_model_objective f (separableSum g) xStar = f xStar + separableSum g xStar := by
          rw [composite_model_objective_apply]
        _ = f xStar + ⊤ := by rw [hg_top]
        _ = ⊤ :=
          EReal.add_top_of_ne_bot (hproblem.toIsBlockProximalGradientProblem.f_ne_bot xStar)
    rw [htop] at hFxStar
    exact EReal.coe_ne_top FOpt hFxStar.symm
  -- A finite optimizer value from above is exactly the effective-domain condition.
  exact mem_effective_domain.mpr (lt_top_iff_ne_top.mpr hg_ne_top)

/-- Helper for Theorem 11.11: at any feasible point, the composite objective is the coercion of
the real smooth term plus the real blockwise penalty sum. -/
lemma rbpgObjective_eq_real_sum_of_mem_effective_domain
    (hproblem : RandomizedBlockProximalGradientAssumptions f g block_gradient XStar FOpt Li)
    {xPoint : (i : ι) → Ei i}
    (hxPoint : xPoint ∈ effective_domain (separableSum g)) :
    composite_model_objective f (separableSum g) xPoint =
      ((((f xPoint).toReal + (∑ j, (g j (xPoint j)).toReal) : ℝ)) : EReal) := by
  have hxf :
      xPoint ∈ effective_domain f := by
    -- Feasibility for the block-separable penalty places the point in the smooth effective domain.
    exact
      interior_subset
        (IsBlockProximalGradientProblem.mem_interior_effective_domain_of_mem_g_effective_domain
          hproblem.toIsBlockProximalGradientProblem
          hxPoint)
  have hfx_val :
      f xPoint = ((((f xPoint).toReal : ℝ)) : EReal) := by
    -- The smooth term is finite on that domain, so `toReal` is lossless.
    exact
      (EReal.coe_toReal
        (mem_effective_domain.mp hxf).ne
        (hproblem.toIsBlockProximalGradientProblem.f_ne_bot xPoint)).symm
  -- Normalize both the smooth term and the separable term on the real layer.
  rw [composite_model_objective_apply, hfx_val,
    IsBlockProximalGradientProblem.separableSumEqCoeToRealSum
      hproblem.toIsBlockProximalGradientProblem
      hxPoint]
  simp [EReal.coe_add]

/-- Helper for Theorem 11.11: any point in `effective_domain (separableSum g)` has finite
composite objective value, so the objective equals the coercion of its real part. -/
lemma rbpgObjective_eq_coeToReal_of_mem_effective_domain
    (hproblem : RandomizedBlockProximalGradientAssumptions f g block_gradient XStar FOpt Li)
    {xPoint : (i : ι) → Ei i}
    (hxPoint : xPoint ∈ effective_domain (separableSum g)) :
    composite_model_objective f (separableSum g) xPoint =
      ((((composite_model_objective f (separableSum g) xPoint).toReal : ℝ)) : EReal) := by
  have hxf :
      xPoint ∈ effective_domain f := by
    exact
      interior_subset
        (IsBlockProximalGradientProblem.mem_interior_effective_domain_of_mem_g_effective_domain
          hproblem.toIsBlockProximalGradientProblem
          hxPoint)
  have hsep_ne_bot : separableSum g xPoint ≠ ⊥ :=
    (separableSum_proper g hproblem.block_g_proper).ne_bot xPoint
  have hobj_ne_top :
      composite_model_objective f (separableSum g) xPoint ≠ ⊤ := by
    rw [composite_model_objective_apply]
    exact EReal.add_ne_top (mem_effective_domain.mp hxf).ne (mem_effective_domain.mp hxPoint).ne
  have hobj_ne_bot :
      composite_model_objective f (separableSum g) xPoint ≠ ⊥ := by
    rw [composite_model_objective_apply, EReal.add_ne_bot_iff]
    exact ⟨hproblem.toIsBlockProximalGradientProblem.f_ne_bot xPoint, hsep_ne_bot⟩
  -- Feasible points have finite smooth and separable parts, so the full objective is finite.
  exact (EReal.coe_toReal hobj_ne_top hobj_ne_bot).symm

/-- Helper for Theorem 11.11: an antitone sequence is bounded below by its final value on every
prefix. -/
lemma antitonePrefixSumLowerBound
    {a : ℕ → ℝ}
    (hanti : Antitone a)
    (k : ℕ) :
    (k + 1 : ℝ) * a (k + 1) ≤
      Finset.sum (Finset.range (k + 1)) (fun n ↦ a (n + 1)) := by
  -- Each prefix term dominates the final term because the sequence is antitone.
  calc
    (k + 1 : ℝ) * a (k + 1)
      = Finset.sum (Finset.range (k + 1)) (fun _n ↦ a (k + 1)) := by
          simp
    _ ≤ Finset.sum (Finset.range (k + 1)) (fun n ↦ a (n + 1)) := by
          refine Finset.sum_le_sum ?_
          intro n hn
          exact hanti (Nat.succ_le_of_lt (Finset.mem_range.mp hn))

/-- Helper for Theorem 11.11: the scalar Lyapunov recursion with coefficient `1 / p` implies the
textbook `O(1 / k)` bound once the gap sequence is antitone. -/
lemma sublinearBoundOfAntitoneGapLyapunovRecursion
    (p : ℝ)
    (Φ a : ℕ → ℝ)
    (hp : 0 < p)
    (hstep : ∀ n, Φ (n + 1) ≤ Φ n - p⁻¹ * a n)
    (hgap_le : ∀ n, a (n + 1) ≤ Φ (n + 1))
    (hanti : Antitone a)
    (k : ℕ) :
    a (k + 1) ≤ (p / (p + k + 1 : ℝ)) * Φ 0 := by
  have hp_inv_nonneg : 0 ≤ p⁻¹ := inv_nonneg.mpr hp.le
  have hstep' :
      ∀ n, p⁻¹ * a (n + 1) ≤ Φ n - Φ (n + 1) := by
    intro n
    have ha_mono : a (n + 1) ≤ a n := hanti (Nat.le_succ n)
    have hscaled :
        p⁻¹ * a (n + 1) ≤ p⁻¹ * a n := by
      exact mul_le_mul_of_nonneg_left ha_mono hp_inv_nonneg
    have hrec : p⁻¹ * a n ≤ Φ n - Φ (n + 1) := by
      linarith [hstep n]
    exact hscaled.trans hrec
  have hsum :
      p⁻¹ * Finset.sum (Finset.range (k + 1)) (fun n ↦ a (n + 1)) ≤
        Φ 0 - Φ (k + 1) := by
    -- Summing the one-step recursion telescopes the Lyapunov term.
    have htel := Finset.sum_range_sub Φ (k + 1)
    calc
      p⁻¹ * Finset.sum (Finset.range (k + 1)) (fun n ↦ a (n + 1)) =
          Finset.sum (Finset.range (k + 1)) (fun n ↦ p⁻¹ * a (n + 1)) := by
            rw [Finset.mul_sum]
      _ ≤ Finset.sum (Finset.range (k + 1)) (fun n ↦ Φ n - Φ (n + 1)) := by
            refine Finset.sum_le_sum ?_
            intro n hn
            exact hstep' n
      _ = Φ 0 - Φ (k + 1) := by
            calc
              Finset.sum (Finset.range (k + 1)) (fun n ↦ Φ n - Φ (n + 1)) =
                  Finset.sum (Finset.range (k + 1)) (fun n ↦ -(Φ (n + 1) - Φ n)) := by
                    refine Finset.sum_congr rfl ?_
                    intro n hn
                    ring
              _ = -Finset.sum (Finset.range (k + 1)) (fun n ↦ Φ (n + 1) - Φ n) := by
                    rw [Finset.sum_neg_distrib]
              _ = -(Φ (k + 1) - Φ 0) := by
                    rw [htel]
              _ = Φ 0 - Φ (k + 1) := by
                    ring
  have hprefix :
      p⁻¹ * ((k + 1 : ℝ) * a (k + 1)) ≤
        Φ 0 - Φ (k + 1) := by
    -- Antitonicity lets us replace the whole prefix sum by its final term.
    have hprefix_sum :=
      antitonePrefixSumLowerBound hanti k
    calc
      p⁻¹ * ((k + 1 : ℝ) * a (k + 1)) ≤
          p⁻¹ * Finset.sum (Finset.range (k + 1)) (fun n ↦ a (n + 1)) := by
            exact mul_le_mul_of_nonneg_left hprefix_sum hp_inv_nonneg
      _ ≤ Φ 0 - Φ (k + 1) := hsum
  have haux :
      ((1 : ℝ) + (k + 1 : ℝ) / p) * a (k + 1) ≤ Φ 0 := by
    -- Combine the prefix estimate with `a (k + 1) ≤ Φ (k + 1)`.
    have hprefix' :
        ((k + 1 : ℝ) / p) * a (k + 1) ≤ Φ 0 - Φ (k + 1) := by
      simpa [div_eq_mul_inv, mul_assoc, mul_left_comm, mul_comm] using hprefix
    nlinarith [hprefix', hgap_le k]
  have hcoeff :
      ((p + k + 1 : ℝ) / p) * a (k + 1) ≤ Φ 0 := by
    -- Rewrite the coefficient into the single denominator used in the textbook statement.
    have hcoeff_eq :
        ((p + k + 1 : ℝ) / p) * a (k + 1) =
          ((1 : ℝ) + (k + 1 : ℝ) / p) * a (k + 1) := by
      field_simp [hp.ne']
      ring
    rw [hcoeff_eq]
    exact haux
  have hfactor :
      a (k + 1) =
        (p / (p + k + 1 : ℝ)) * (((p + k + 1 : ℝ) / p) * a (k + 1)) := by
    field_simp [hp.ne', show (p + k + 1 : ℝ) ≠ 0 by positivity]
  -- Multiply the coefficient bound by the positive reciprocal denominator.
  calc
    a (k + 1) =
        (p / (p + k + 1 : ℝ)) * (((p + k + 1 : ℝ) / p) * a (k + 1)) := hfactor
    _ ≤ (p / (p + k + 1 : ℝ)) * Φ 0 := by
        exact mul_le_mul_of_nonneg_left hcoeff (by positivity)

/-- Helper for Theorem 11.11: the time-`n` iterate only depends on the frozen prefix
`ξ₀, …, ξ_{n-1}`, so changing the current block placeholder does not affect that iterate. -/
lemma rbpgHistoryCurrentIterate_eq_anchor
    (hproblem : RandomizedBlockProximalGradientAssumptions f g block_gradient XStar FOpt Li)
    (x0 : effective_domain (separableSum g))
    (n : ℕ) (ξ : Fin n → ι) (i i0 : ι) :
    randomized_block_proximal_gradient_method
        hproblem.toIsBlockProximalGradientProblem
        (hproblem.interior_effective_domain_point x0)
        (rbpgHistoryWithCurrent n ξ i)
        n =
      randomized_block_proximal_gradient_method
        hproblem.toIsBlockProximalGradientProblem
        (hproblem.interior_effective_domain_point x0)
        (rbpgHistoryWithCurrent n ξ i0)
        n := by
  -- Both schedules agree at every time strictly before `n`, so the time-`n` iterate is shared.
  apply rbpgIterate_eq_of_prefix_eq hproblem x0
  intro m hm
  simp [rbpgHistoryWithCurrent, hm]

/-- Helper for Theorem 11.11: after freezing the history `ξ₀, …, ξ_{n-1}`, the successor driven
by the current block `i` is the one-block update of the anchored iterate `x^k` by the randomized
block gradient mapping residual. -/
lemma rbpgFrozenHistoryNextIterate_eq_blockUpdate
    (hproblem : RandomizedBlockProximalGradientAssumptions f g block_gradient XStar FOpt Li)
    (x0 : effective_domain (separableSum g))
    (n : ℕ) (ξ : Fin n → ι) (i i0 : ι) :
    let xk :=
      randomized_block_proximal_gradient_method
        hproblem.toIsBlockProximalGradientProblem
        (hproblem.interior_effective_domain_point x0)
        (rbpgHistoryWithCurrent n ξ i0)
        n
    randomized_block_proximal_gradient_method
        hproblem.toIsBlockProximalGradientProblem
        (hproblem.interior_effective_domain_point x0)
        (rbpgHistoryWithCurrent n ξ i)
        (n + 1) =
      block_coordinate_update
        xk
        i
        (-(1 / (Li i : ℝ)) • (Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i) := by
  dsimp
  set xk :=
    randomized_block_proximal_gradient_method
      hproblem.toIsBlockProximalGradientProblem
      (hproblem.interior_effective_domain_point x0)
      (rbpgHistoryWithCurrent n ξ i0)
      n
  have hanchor :
      randomized_block_proximal_gradient_method
          hproblem.toIsBlockProximalGradientProblem
          (hproblem.interior_effective_domain_point x0)
          (rbpgHistoryWithCurrent n ξ i)
          n = xk := by
    -- The time-`n` iterate depends only on the frozen prefix, so all current-block choices share
    -- the same anchor `xk`.
    simpa [xk] using rbpgHistoryCurrentIterate_eq_anchor hproblem x0 n ξ i i0
  have hdisp :
      hproblem.toIsBlockProximalGradientProblem.prox_point (Li i) i xk - xk i =
        -(1 / (Li i : ℝ)) • (Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i := by
    have hGdef :
        (Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i =
          (Li i : ℝ) •
            (xk i - hproblem.toIsBlockProximalGradientProblem.prox_point (Li i) i xk) := by
      -- Rewrite the randomized block residual to the owner-level scaled prox displacement.
      simpa using
        randomized_block_gradient_mapping_apply_def
          (h := hproblem.toIsBlockProximalGradientProblem)
          (x := xk)
          (i := i)
    have hLi_ne : (Li i : ℝ) ≠ 0 := ne_of_gt (PosReal.coe_pos (Li i))
    -- Solve the scaled residual identity for the actual active-block displacement.
    calc
      hproblem.toIsBlockProximalGradientProblem.prox_point (Li i) i xk - xk i =
          -(xk i - hproblem.toIsBlockProximalGradientProblem.prox_point (Li i) i xk) := by
            abel
      _ =
          (-(1 / (Li i : ℝ))) •
            ((Li i : ℝ) •
              (xk i - hproblem.toIsBlockProximalGradientProblem.prox_point (Li i) i xk)) := by
            have hscale : (-(1 / (Li i : ℝ))) * (Li i : ℝ) = -1 := by
              field_simp [hLi_ne]
            calc
              -(xk i - hproblem.toIsBlockProximalGradientProblem.prox_point (Li i) i xk) =
                  (-1 : ℝ) •
                    (xk i - hproblem.toIsBlockProximalGradientProblem.prox_point (Li i) i xk) := by
                      simp
              _ =
                  ((-(1 / (Li i : ℝ))) * (Li i : ℝ)) •
                    (xk i - hproblem.toIsBlockProximalGradientProblem.prox_point (Li i) i xk) := by
                      rw [hscale]
              _ =
                  (-(1 / (Li i : ℝ))) •
                    ((Li i : ℝ) •
                      (xk i - hproblem.toIsBlockProximalGradientProblem.prox_point (Li i) i xk)) := by
                      rw [smul_smul]
      _ = (-(1 / (Li i : ℝ))) • (Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i := by
            rw [hGdef]
  -- Rewrite the deterministic successor through the owner recursion and normalize the active
  -- displacement to the residual spelling.
  calc
    randomized_block_proximal_gradient_method
        hproblem.toIsBlockProximalGradientProblem
        (hproblem.interior_effective_domain_point x0)
        (rbpgHistoryWithCurrent n ξ i)
        (n + 1) =
      block_coordinate_update
        (randomized_block_proximal_gradient_method
          hproblem.toIsBlockProximalGradientProblem
          (hproblem.interior_effective_domain_point x0)
          (rbpgHistoryWithCurrent n ξ i)
          n)
        (rbpgHistoryWithCurrent n ξ i n)
        (hproblem.toIsBlockProximalGradientProblem.prox_point
            (Li (rbpgHistoryWithCurrent n ξ i n))
            (rbpgHistoryWithCurrent n ξ i n)
            (randomized_block_proximal_gradient_method
              hproblem.toIsBlockProximalGradientProblem
              (hproblem.interior_effective_domain_point x0)
              (rbpgHistoryWithCurrent n ξ i)
              n) -
          (randomized_block_proximal_gradient_method
            hproblem.toIsBlockProximalGradientProblem
            (hproblem.interior_effective_domain_point x0)
            (rbpgHistoryWithCurrent n ξ i)
            n)
            (rbpgHistoryWithCurrent n ξ i n)) := by
            rw [randomized_block_proximal_gradient_method_succ]
    _ =
      block_coordinate_update
        (randomized_block_proximal_gradient_method
          hproblem.toIsBlockProximalGradientProblem
          (hproblem.interior_effective_domain_point x0)
          (rbpgHistoryWithCurrent n ξ i)
          n)
        i
        (hproblem.toIsBlockProximalGradientProblem.prox_point
            (Li i)
            i
            (randomized_block_proximal_gradient_method
              hproblem.toIsBlockProximalGradientProblem
              (hproblem.interior_effective_domain_point x0)
              (rbpgHistoryWithCurrent n ξ i)
              n) -
          (randomized_block_proximal_gradient_method
            hproblem.toIsBlockProximalGradientProblem
              (hproblem.interior_effective_domain_point x0)
              (rbpgHistoryWithCurrent n ξ i)
              n) i) := by
            have hself : rbpgHistoryWithCurrent n ξ i n = i := by
              simp [rbpgHistoryWithCurrent]
            rw [hself]
    _ = block_coordinate_update
          xk
          i
          (-(1 / (Li i : ℝ)) • (Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i) := by
            rw [hanchor, hdisp]

/-- Helper for Theorem 11.11: changing one block of a feasible point changes the real-valued
separable penalty by exactly the corresponding active-block real-value difference. -/
lemma rbpgSeparableSum_toRealDiff_blockCoordinateUpdate
    (hproblem : RandomizedBlockProximalGradientAssumptions f g block_gradient XStar FOpt Li)
    {x : (i : ι) → Ei i}
    (hx : x ∈ effective_domain (separableSum g))
    {i : ι} {yi : Ei i}
    (hy : block_coordinate_update x i (yi - x i) ∈ effective_domain (separableSum g)) :
    (separableSum g (block_coordinate_update x i (yi - x i))).toReal -
        (separableSum g x).toReal =
      (g i yi).toReal - (g i (x i)).toReal := by
  classical
  let y := block_coordinate_update x i (yi - x i)
  have hsum_x :
      (separableSum g x).toReal = ∑ j, (g j (x j)).toReal := by
    rw [IsBlockProximalGradientProblem.separableSumEqCoeToRealSum
      hproblem.toIsBlockProximalGradientProblem
      hx, EReal.toReal_coe]
  have hsum_y :
      (separableSum g y).toReal = ∑ j, (g j (y j)).toReal := by
    rw [IsBlockProximalGradientProblem.separableSumEqCoeToRealSum
      hproblem.toIsBlockProximalGradientProblem
      hy, EReal.toReal_coe]
  have hsum_x_split :
      ∑ j, (g j (x j)).toReal =
        (g i (x i)).toReal +
          Finset.sum (Finset.univ.erase i) (fun j ↦ (g j (x j)).toReal) := by
    -- Split the unchanged point into the active block and the untouched complement.
    symm
    exact Finset.add_sum_erase Finset.univ (fun j ↦ (g j (x j)).toReal) (Finset.mem_univ i)
  have hsum_y_split :
      ∑ j, (g j (y j)).toReal =
        (g i yi).toReal +
          Finset.sum (Finset.univ.erase i) (fun j ↦ (g j (x j)).toReal) := by
    calc
      ∑ j, (g j (y j)).toReal =
          (g i (y i)).toReal +
            Finset.sum (Finset.univ.erase i) (fun j ↦ (g j (y j)).toReal) := by
              symm
              exact
                Finset.add_sum_erase Finset.univ (fun j ↦ (g j (y j)).toReal)
                  (Finset.mem_univ i)
      _ =
          (g i yi).toReal +
            Finset.sum (Finset.univ.erase i) (fun j ↦ (g j (x j)).toReal) := by
              congr 1
              · have hyi : y i = yi := by
                  -- The active block of the coordinate update is exactly the replacement value.
                  dsimp [y]
                  rw [block_coordinate_update_apply_same]
                  abel
                simpa [hyi]
              · refine Finset.sum_congr rfl ?_
                intro j hj
                have hji : j ≠ i := (Finset.mem_erase.mp hj).1
                simp [y, block_coordinate_update_apply_ne, hji]
  -- After splitting off the active block, the untouched block sum cancels from both sides.
  rw [hsum_x, hsum_y, hsum_x_split, hsum_y_split]
  linarith

/-- Helper for Theorem 11.11: after freezing the history `ξ₀, …, ξ_{n-1}`, averaging the
one-step sufficient-decrease estimate over the current block gives the deterministic average
objective decrease for the frozen-history successors. -/
lemma rbpgFrozenHistoryAverageObjectiveDecrease
    (hproblem : RandomizedBlockProximalGradientAssumptions f g block_gradient XStar FOpt Li)
    (x0 : effective_domain (separableSum g))
    (n : ℕ) (ξ : Fin n → ι) (i0 : ι) :
    let xk :=
      randomized_block_proximal_gradient_method
        hproblem.toIsBlockProximalGradientProblem
        (hproblem.interior_effective_domain_point x0)
        (rbpgHistoryWithCurrent n ξ i0)
        n
    let xNext : ι → ((i : ι) → Ei i) :=
      fun i ↦
        randomized_block_proximal_gradient_method
          hproblem.toIsBlockProximalGradientProblem
          (hproblem.interior_effective_domain_point x0)
          (rbpgHistoryWithCurrent n ξ i)
          (n + 1)
    ((Fintype.card ι : ℝ)⁻¹) * ∑ i,
      (composite_model_objective f (separableSum g) (xNext i)).toReal ≤
      (composite_model_objective f (separableSum g) xk).toReal -
        ((Fintype.card ι : ℝ)⁻¹) * (1 / 2 : ℝ) *
          ‖Gtilde[hproblem.toIsBlockProximalGradientProblem] xk‖_[Li,*] ^ (2 : ℕ) := by
  -- Route correction: isolate the easy deterministic objective decrease first, so the remaining
  -- blocker is only the weighted-distance/support assembly at the optimizer.
  dsimp
  set xk :=
    randomized_block_proximal_gradient_method
      hproblem.toIsBlockProximalGradientProblem
      (hproblem.interior_effective_domain_point x0)
      (rbpgHistoryWithCurrent n ξ i0)
      n
  set xNext : ι → ((i : ι) → Ei i) :=
    fun i ↦
      randomized_block_proximal_gradient_method
        hproblem.toIsBlockProximalGradientProblem
        (hproblem.interior_effective_domain_point x0)
        (rbpgHistoryWithCurrent n ξ i)
        (n + 1)
  have hcard_pos : 0 < (Fintype.card ι : ℝ) := by
    exact_mod_cast Fintype.card_pos_iff.mpr ⟨i0⟩
  have hcardInv_nonneg : 0 ≤ (Fintype.card ι : ℝ)⁻¹ := by
    exact inv_nonneg.mpr hcard_pos.le
  have hstep :
      ∀ i,
        (composite_model_objective f (separableSum g) (xNext i)).toReal ≤
          (composite_model_objective f (separableSum g) xk).toReal -
            ((1 : ℝ) / (2 * (Li i : ℝ))) *
              ‖(Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i‖ ^ (2 : ℕ) := by
    intro i
    have hraw :=
      RandomizedBlockProximalGradientAssumptions.randomized_block_proximal_gradient_sufficient_decrease
        hproblem
        x0
        (rbpgHistoryWithCurrent n ξ i)
        n
    have hself : rbpgHistoryWithCurrent n ξ i n = i := by
      simp [rbpgHistoryWithCurrent]
    rw [hself] at hraw
    have hanchor :
        randomized_block_proximal_gradient_method
            hproblem.toIsBlockProximalGradientProblem
            (hproblem.interior_effective_domain_point x0)
            (rbpgHistoryWithCurrent n ξ i)
            n = xk := by
      simpa [xk] using
        rbpgHistoryCurrentIterate_eq_anchor hproblem x0 n ξ i i0
    rw [hanchor] at hraw
    have hxk_val :
        composite_model_objective f (separableSum g) xk =
          ((((composite_model_objective f (separableSum g) xk).toReal : ℝ)) : EReal) := by
      -- The anchored iterate is a deterministic RBPG iterate, so its objective value is finite.
      simpa [rbpg_pathwise_iterate, xk] using
        rbpgIterateObjective_eq_coeToReal
          (Ω := Unit)
          hproblem
          x0
          (fun m (_ : Unit) ↦ rbpgHistoryWithCurrent n ξ i0 m)
          ()
          n
    have hxNext_val :
        composite_model_objective f (separableSum g) (xNext i) =
          ((((composite_model_objective f (separableSum g) (xNext i)).toReal : ℝ)) : EReal) := by
      -- The same finiteness argument applies to the deterministic successor in the current block.
      simpa [rbpg_pathwise_iterate, xNext] using
        rbpgIterateObjective_eq_coeToReal
          (Ω := Unit)
          hproblem
          x0
          (fun m (_ : Unit) ↦ rbpgHistoryWithCurrent n ξ i m)
          ()
          (n + 1)
    rw [hxk_val, hxNext_val] at hraw
    have hraw' :
        ((((1 : ℝ) / (2 * (Li i : ℝ))) *
            ‖(Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i‖ ^ (2 : ℕ) :
            ℝ) : EReal) ≤
          ((((composite_model_objective f (separableSum g) xk).toReal -
                (composite_model_objective f (separableSum g) (xNext i)).toReal : ℝ)) : EReal) := by
      simpa [EReal.coe_sub, randomized_block_gradient_mapping_apply] using hraw
    have hraw_real :
        ((1 : ℝ) / (2 * (Li i : ℝ))) *
            ‖(Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i‖ ^ (2 : ℕ) ≤
          (composite_model_objective f (separableSum g) xk).toReal -
            (composite_model_objective f (separableSum g) (xNext i)).toReal := by
      exact EReal.coe_le_coe_iff.mp hraw'
    linarith
  have hsum :
      ∑ i, (composite_model_objective f (separableSum g) (xNext i)).toReal ≤
        ∑ i,
          ((composite_model_objective f (separableSum g) xk).toReal -
            ((1 : ℝ) / (2 * (Li i : ℝ))) *
              ‖(Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i‖ ^ (2 : ℕ)) := by
    -- Sum the deterministic one-block decreases over the whole current-block family.
    refine Finset.sum_le_sum ?_
    intro i hi
    exact hstep i
  have hdual :
      ∑ i,
        (((1 : ℝ) / (2 * (Li i : ℝ))) *
          ‖(Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i‖ ^ (2 : ℕ)) =
        (1 / 2 : ℝ) *
          ‖Gtilde[hproblem.toIsBlockProximalGradientProblem] xk‖_[Li,*] ^ (2 : ℕ) := by
    have hnorm_sq :
        ‖Gtilde[hproblem.toIsBlockProximalGradientProblem] xk‖_[Li,*] ^ (2 : ℕ) =
          ∑ i,
            ((Li i : ℝ)⁻¹) *
              ‖(Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i‖ ^ (2 : ℕ) := by
      rw [randomized_block_weighted_dual_norm_def]
      have hnonneg :
          0 ≤
            ∑ i,
              ((Li i : ℝ)⁻¹) *
                ‖(Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i‖ ^ (2 : ℕ) := by
        refine Finset.sum_nonneg ?_
        intro i hi
        exact mul_nonneg (inv_nonneg.mpr (le_of_lt (PosReal.coe_pos (Li i)))) (by positivity)
      simpa using Real.sq_sqrt hnonneg
    calc
      ∑ i,
          (((1 : ℝ) / (2 * (Li i : ℝ))) *
            ‖(Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i‖ ^ (2 : ℕ)) =
          ∑ i,
            (1 / 2 : ℝ) *
              (((Li i : ℝ)⁻¹) *
                ‖(Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i‖ ^ (2 : ℕ)) := by
            refine Finset.sum_congr rfl ?_
            intro i hi
            have hLi_ne : (Li i : ℝ) ≠ 0 := ne_of_gt (PosReal.coe_pos (Li i))
            calc
              (((1 : ℝ) / (2 * (Li i : ℝ))) *
                  ‖(Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i‖ ^ (2 : ℕ)) =
              (((1 / 2 : ℝ) * ((Li i : ℝ)⁻¹)) *
                  ‖(Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i‖ ^ (2 : ℕ)) := by
                    field_simp [hLi_ne]
              _ =
                (1 / 2 : ℝ) *
                  (((Li i : ℝ)⁻¹) *
                    ‖(Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i‖ ^ (2 : ℕ)) := by
                    ring
      _ =
          (1 / 2 : ℝ) *
            ∑ i,
              ((Li i : ℝ)⁻¹) *
                ‖(Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i‖ ^ (2 : ℕ) := by
            rw [← Finset.mul_sum]
      _ =
          (1 / 2 : ℝ) *
            ‖Gtilde[hproblem.toIsBlockProximalGradientProblem] xk‖_[Li,*] ^ (2 : ℕ) := by
            rw [hnorm_sq]
  have havg :
      ((Fintype.card ι : ℝ)⁻¹) *
          ∑ i, (composite_model_objective f (separableSum g) (xNext i)).toReal ≤
        ((Fintype.card ι : ℝ)⁻¹) *
          ∑ i,
            ((composite_model_objective f (separableSum g) xk).toReal -
              ((1 : ℝ) / (2 * (Li i : ℝ))) *
                ‖(Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i‖ ^ (2 : ℕ)) := by
    -- Averaging preserves the summed inequality because the uniform weight is nonnegative.
    exact mul_le_mul_of_nonneg_left hsum hcardInv_nonneg
  calc
    ((Fintype.card ι : ℝ)⁻¹) *
        ∑ i, (composite_model_objective f (separableSum g) (xNext i)).toReal ≤
      ((Fintype.card ι : ℝ)⁻¹) *
        ∑ i,
          ((composite_model_objective f (separableSum g) xk).toReal -
            ((1 : ℝ) / (2 * (Li i : ℝ))) *
              ‖(Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i‖ ^ (2 : ℕ)) := havg
    _ =
        ((Fintype.card ι : ℝ)⁻¹) *
          (((Fintype.card ι : ℝ) *
              (composite_model_objective f (separableSum g) xk).toReal) -
            ∑ i,
              (((1 : ℝ) / (2 * (Li i : ℝ))) *
                ‖(Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i‖ ^ (2 : ℕ))) := by
          rw [Finset.sum_sub_distrib, Finset.sum_const, nsmul_eq_mul]
          simp
    _ =
        (composite_model_objective f (separableSum g) xk).toReal -
          ((Fintype.card ι : ℝ)⁻¹) *
            ∑ i,
              (((1 : ℝ) / (2 * (Li i : ℝ))) *
                ‖(Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i‖ ^ (2 : ℕ)) := by
          rw [mul_sub, ← mul_assoc, inv_mul_cancel₀ hcard_pos.ne', one_mul]
    _ =
        (composite_model_objective f (separableSum g) xk).toReal -
          ((Fintype.card ι : ℝ)⁻¹) * (1 / 2 : ℝ) *
            ‖Gtilde[hproblem.toIsBlockProximalGradientProblem] xk‖_[Li,*] ^ (2 : ℕ) := by
          rw [hdual]
          ring

/-- Helper for Theorem 11.11: a single fixed-block RBPG displacement satisfies the textbook
weighted-distance identity against `xStar`. -/
lemma rbpgFrozenHistoryOneBlockDistanceIdentity
    (hproblem : RandomizedBlockProximalGradientAssumptions f g block_gradient XStar FOpt Li)
    (xk xStar : (i : ι) → Ei i)
    (i : ι) :
    let gi := (Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i
    (1 / 2 : ℝ) *
        ‖block_coordinate_update xk i (-(1 / (Li i : ℝ)) • gi) - xStar‖_[Li] ^ (2 : ℕ) =
      (1 / 2 : ℝ) * ‖xk - xStar‖_[Li] ^ (2 : ℕ) -
        inner ℝ gi (xk i - xStar i) +
        ((1 : ℝ) / (2 * (Li i : ℝ))) * ‖gi‖ ^ (2 : ℕ) := by
  classical
  dsimp
  let gi := (Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i
  have hLi_pos : 0 < (Li i : ℝ) := PosReal.coe_pos (Li i)
  have hnorm_sq :
      ‖xk - xStar‖_[Li] ^ (2 : ℕ) =
        ∑ j, (Li j : ℝ) * ‖(xk - xStar) j‖ ^ (2 : ℕ) := by
    rw [randomized_block_weighted_norm_def]
    have hsum_nonneg :
        0 ≤ ∑ j, (Li j : ℝ) * ‖(xk - xStar) j‖ ^ (2 : ℕ) := by
      refine Finset.sum_nonneg ?_
      intro j hj
      exact mul_nonneg (le_of_lt (PosReal.coe_pos (Li j))) (by positivity)
    simpa using Real.sq_sqrt hsum_nonneg
  have hupdate_sq :
      ‖block_coordinate_update xk i (-(1 / (Li i : ℝ)) • gi) - xStar‖_[Li] ^ (2 : ℕ) =
        ∑ j,
          (Li j : ℝ) *
            ‖(block_coordinate_update xk i (-(1 / (Li i : ℝ)) • gi) - xStar) j‖ ^ (2 : ℕ) := by
    rw [randomized_block_weighted_norm_def]
    have hsum_nonneg :
        0 ≤
          ∑ j,
            (Li j : ℝ) *
              ‖(block_coordinate_update xk i (-(1 / (Li i : ℝ)) • gi) - xStar) j‖ ^ (2 : ℕ) := by
      refine Finset.sum_nonneg ?_
      intro j hj
      exact mul_nonneg (le_of_lt (PosReal.coe_pos (Li j))) (by positivity)
    simpa using Real.sq_sqrt hsum_nonneg
  have hbase_split :
      ∑ j, (Li j : ℝ) * ‖(xk - xStar) j‖ ^ (2 : ℕ) =
        (Li i : ℝ) * ‖xk i - xStar i‖ ^ (2 : ℕ) +
          Finset.sum (Finset.univ.erase i) (fun j ↦ (Li j : ℝ) * ‖xk j - xStar j‖ ^ (2 : ℕ)) := by
    -- Split the weighted norm sum into the active block and the untouched complement.
    symm
    exact
      Finset.add_sum_erase
        Finset.univ
        (fun j ↦ (Li j : ℝ) * ‖xk j - xStar j‖ ^ (2 : ℕ))
        (Finset.mem_univ i)
  have hupdate_split :
      ∑ j,
          (Li j : ℝ) *
            ‖(block_coordinate_update xk i (-(1 / (Li i : ℝ)) • gi) - xStar) j‖ ^ (2 : ℕ) =
        (Li i : ℝ) * ‖xk i - xStar i - (1 / (Li i : ℝ)) • gi‖ ^ (2 : ℕ) +
          Finset.sum (Finset.univ.erase i) (fun j ↦ (Li j : ℝ) * ‖xk j - xStar j‖ ^ (2 : ℕ)) := by
    -- Only the active block changes under the one-block update.
    calc
      ∑ j,
          (Li j : ℝ) *
            ‖(block_coordinate_update xk i (-(1 / (Li i : ℝ)) • gi) - xStar) j‖ ^ (2 : ℕ) =
        (Li i : ℝ) *
            ‖(block_coordinate_update xk i (-(1 / (Li i : ℝ)) • gi) - xStar) i‖ ^ (2 : ℕ) +
          Finset.sum
            (Finset.univ.erase i)
            (fun j ↦
              (Li j : ℝ) *
                ‖(block_coordinate_update xk i (-(1 / (Li i : ℝ)) • gi) - xStar) j‖ ^ (2 : ℕ)) := by
          symm
          exact
            Finset.add_sum_erase
              Finset.univ
              (fun j ↦
                (Li j : ℝ) *
                  ‖(block_coordinate_update xk i (-(1 / (Li i : ℝ)) • gi) - xStar) j‖ ^ (2 : ℕ))
              (Finset.mem_univ i)
      _ =
        (Li i : ℝ) * ‖xk i - xStar i - (1 / (Li i : ℝ)) • gi‖ ^ (2 : ℕ) +
          Finset.sum (Finset.univ.erase i) (fun j ↦ (Li j : ℝ) * ‖xk j - xStar j‖ ^ (2 : ℕ)) := by
          congr 1
          · simp [block_coordinate_update_apply_same, sub_eq_add_neg, add_assoc, add_left_comm,
              add_comm]
          · refine Finset.sum_congr rfl ?_
            intro j hj
            have hji : j ≠ i := (Finset.mem_erase.mp hj).1
            simp [block_coordinate_update_apply_ne, hji]
  have hactive :
      (Li i : ℝ) * ‖xk i - xStar i - (1 / (Li i : ℝ)) • gi‖ ^ (2 : ℕ) =
        (Li i : ℝ) * ‖xk i - xStar i‖ ^ (2 : ℕ) -
          2 * inner ℝ gi (xk i - xStar i) +
          ((Li i : ℝ)⁻¹) * ‖gi‖ ^ (2 : ℕ) := by
    -- Expand the active-block norm square and simplify the scalar factors using `Li i > 0`.
    have habs : |(1 / (Li i : ℝ))| = (1 / (Li i : ℝ)) := by
      exact abs_of_pos (one_div_pos.mpr hLi_pos)
    rw [norm_sub_sq_real, real_inner_smul_right, norm_smul, Real.norm_eq_abs, habs]
    rw [real_inner_comm gi (xk i - xStar i)]
    field_simp [hLi_pos.ne']
  have hsum_eq :
      ∑ j,
          (Li j : ℝ) *
            ‖(block_coordinate_update xk i (-(1 / (Li i : ℝ)) • gi) - xStar) j‖ ^ (2 : ℕ) =
        (∑ j, (Li j : ℝ) * ‖(xk - xStar) j‖ ^ (2 : ℕ)) -
          2 * inner ℝ gi (xk i - xStar i) +
          ((Li i : ℝ)⁻¹) * ‖gi‖ ^ (2 : ℕ) := by
    -- Reassemble the untouched blocks into the original weighted norm sum.
    rw [hupdate_split, hbase_split, hactive]
    ring
  -- Move from the weighted norm sums back to the textbook half-distance identity.
  calc
    (1 / 2 : ℝ) *
        ‖block_coordinate_update xk i (-(1 / (Li i : ℝ)) • gi) - xStar‖_[Li] ^ (2 : ℕ) =
      (1 / 2 : ℝ) *
        ∑ j,
          (Li j : ℝ) *
            ‖(block_coordinate_update xk i (-(1 / (Li i : ℝ)) • gi) - xStar) j‖ ^ (2 : ℕ) := by
          rw [hupdate_sq]
    _ =
      (1 / 2 : ℝ) *
        ((∑ j, (Li j : ℝ) * ‖(xk - xStar) j‖ ^ (2 : ℕ)) -
          2 * inner ℝ gi (xk i - xStar i) +
          ((Li i : ℝ)⁻¹) * ‖gi‖ ^ (2 : ℕ)) := by
          rw [hsum_eq]
    _ =
      (1 / 2 : ℝ) * ‖xk - xStar‖_[Li] ^ (2 : ℕ) -
        inner ℝ gi (xk i - xStar i) +
        ((1 : ℝ) / (2 * (Li i : ℝ))) * ‖gi‖ ^ (2 : ℕ) := by
          rw [← hnorm_sq]
          field_simp [hLi_pos.ne']

/-- Helper for Theorem 11.11: after freezing the history `ξ₀, …, ξ_{n-1}`, averaging the
weighted squared distance to `xStar` over the current block yields the textbook distance
recursion in the anchored iterate spelling. -/
lemma rbpgFrozenHistoryAverageDistanceRecursion
    (hproblem : RandomizedBlockProximalGradientAssumptions f g block_gradient XStar FOpt Li)
    (x0 : effective_domain (separableSum g))
    (xStar : (i : ι) → Ei i)
    (n : ℕ) (ξ : Fin n → ι) (i0 : ι) :
    let xk :=
      randomized_block_proximal_gradient_method
        hproblem.toIsBlockProximalGradientProblem
        (hproblem.interior_effective_domain_point x0)
        (rbpgHistoryWithCurrent n ξ i0)
        n
    let xNext : ι → ((i : ι) → Ei i) :=
      fun i ↦
        randomized_block_proximal_gradient_method
          hproblem.toIsBlockProximalGradientProblem
          (hproblem.interior_effective_domain_point x0)
          (rbpgHistoryWithCurrent n ξ i)
          (n + 1)
    ((Fintype.card ι : ℝ)⁻¹) * ∑ i, (1 / 2 : ℝ) * ‖xNext i - xStar‖_[Li] ^ (2 : ℕ) =
      (1 / 2 : ℝ) * ‖xk - xStar‖_[Li] ^ (2 : ℕ) -
        ((Fintype.card ι : ℝ)⁻¹) *
          ∑ i, inner ℝ ((Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i) (xk i - xStar i) +
        ((Fintype.card ι : ℝ)⁻¹) * (1 / 2 : ℝ) *
          ‖Gtilde[hproblem.toIsBlockProximalGradientProblem] xk‖_[Li,*] ^ (2 : ℕ) := by
  classical
  -- Normalize every deterministic successor to the anchored one-block update spelling.
  dsimp
  set xk :=
    randomized_block_proximal_gradient_method
      hproblem.toIsBlockProximalGradientProblem
      (hproblem.interior_effective_domain_point x0)
      (rbpgHistoryWithCurrent n ξ i0)
      n
  set xNext : ι → ((i : ι) → Ei i) :=
    fun i ↦
      randomized_block_proximal_gradient_method
        hproblem.toIsBlockProximalGradientProblem
        (hproblem.interior_effective_domain_point x0)
        (rbpgHistoryWithCurrent n ξ i)
        (n + 1)
  have hcard_pos : 0 < (Fintype.card ι : ℝ) := by
    exact_mod_cast Fintype.card_pos_iff.mpr ⟨i0⟩
  have hstep :
      ∀ i,
        (1 / 2 : ℝ) * ‖xNext i - xStar‖_[Li] ^ (2 : ℕ) =
          (1 / 2 : ℝ) * ‖xk - xStar‖_[Li] ^ (2 : ℕ) -
            inner ℝ ((Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i) (xk i - xStar i) +
            ((1 : ℝ) / (2 * (Li i : ℝ))) *
              ‖(Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i‖ ^ (2 : ℕ) := by
    intro i
    have hbridge :=
      rbpgFrozenHistoryNextIterate_eq_blockUpdate hproblem x0 n ξ i i0
    have hxNext_eq :
        xNext i =
          block_coordinate_update
            xk
            i
            (-(1 / (Li i : ℝ)) • (Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i) := by
      simpa [xk, xNext] using hbridge
    -- Apply the one-block identity after rewriting the deterministic successor into block-update
    -- form.
    calc
      (1 / 2 : ℝ) * ‖xNext i - xStar‖_[Li] ^ (2 : ℕ) =
        (1 / 2 : ℝ) *
            ‖block_coordinate_update
                xk
                i
                (-(1 / (Li i : ℝ)) • (Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i) -
              xStar‖_[Li] ^ (2 : ℕ) := by
            rw [hxNext_eq]
      _ =
        (1 / 2 : ℝ) * ‖xk - xStar‖_[Li] ^ (2 : ℕ) -
          inner ℝ ((Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i) (xk i - xStar i) +
          ((1 : ℝ) / (2 * (Li i : ℝ))) *
            ‖(Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i‖ ^ (2 : ℕ) := by
            simpa using rbpgFrozenHistoryOneBlockDistanceIdentity hproblem xk xStar i
  have hsum_step :
      ∑ i, (1 / 2 : ℝ) * ‖xNext i - xStar‖_[Li] ^ (2 : ℕ) =
        ∑ i,
          ((1 / 2 : ℝ) * ‖xk - xStar‖_[Li] ^ (2 : ℕ) -
            inner ℝ ((Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i) (xk i - xStar i) +
            ((1 : ℝ) / (2 * (Li i : ℝ))) *
              ‖(Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i‖ ^ (2 : ℕ)) := by
    -- Sum the per-block identities over the finite block family.
    refine Finset.sum_congr rfl ?_
    intro i hi
    exact hstep i
  have hdual :
      ∑ i,
        (((1 : ℝ) / (2 * (Li i : ℝ))) *
          ‖(Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i‖ ^ (2 : ℕ)) =
        (1 / 2 : ℝ) *
          ‖Gtilde[hproblem.toIsBlockProximalGradientProblem] xk‖_[Li,*] ^ (2 : ℕ) := by
    -- Repackage the averaged one-block residual squares into the dual weighted norm.
    have hnorm_sq :
        ‖Gtilde[hproblem.toIsBlockProximalGradientProblem] xk‖_[Li,*] ^ (2 : ℕ) =
          ∑ i,
            ((Li i : ℝ)⁻¹) *
              ‖(Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i‖ ^ (2 : ℕ) := by
      rw [randomized_block_weighted_dual_norm_def]
      have hnonneg :
          0 ≤
            ∑ i,
              ((Li i : ℝ)⁻¹) *
                ‖(Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i‖ ^ (2 : ℕ) := by
        refine Finset.sum_nonneg ?_
        intro i hi
        exact mul_nonneg (inv_nonneg.mpr (le_of_lt (PosReal.coe_pos (Li i)))) (by positivity)
      simpa using Real.sq_sqrt hnonneg
    calc
      ∑ i,
          (((1 : ℝ) / (2 * (Li i : ℝ))) *
            ‖(Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i‖ ^ (2 : ℕ)) =
        ∑ i,
          (1 / 2 : ℝ) *
            (((Li i : ℝ)⁻¹) *
              ‖(Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i‖ ^ (2 : ℕ)) := by
          refine Finset.sum_congr rfl ?_
          intro i hi
          have hLi_ne : (Li i : ℝ) ≠ 0 := ne_of_gt (PosReal.coe_pos (Li i))
          field_simp [hLi_ne]
      _ =
        (1 / 2 : ℝ) *
          ∑ i,
            ((Li i : ℝ)⁻¹) *
              ‖(Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i‖ ^ (2 : ℕ) := by
          rw [← Finset.mul_sum]
      _ =
        (1 / 2 : ℝ) *
          ‖Gtilde[hproblem.toIsBlockProximalGradientProblem] xk‖_[Li,*] ^ (2 : ℕ) := by
          rw [hnorm_sq]
  -- Average the per-block identity and collapse the residual squares into the dual norm term.
  calc
    ((Fintype.card ι : ℝ)⁻¹) * ∑ i, (1 / 2 : ℝ) * ‖xNext i - xStar‖_[Li] ^ (2 : ℕ) =
      ((Fintype.card ι : ℝ)⁻¹) *
        ∑ i,
          ((1 / 2 : ℝ) * ‖xk - xStar‖_[Li] ^ (2 : ℕ) -
            inner ℝ ((Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i) (xk i - xStar i) +
            ((1 : ℝ) / (2 * (Li i : ℝ))) *
              ‖(Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i‖ ^ (2 : ℕ)) := by
          rw [hsum_step]
    _ =
      ((Fintype.card ι : ℝ)⁻¹) *
        (((Fintype.card ι : ℝ) * ((1 / 2 : ℝ) * ‖xk - xStar‖_[Li] ^ (2 : ℕ))) -
          ∑ i, inner ℝ ((Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i) (xk i - xStar i) +
          ∑ i,
            (((1 : ℝ) / (2 * (Li i : ℝ))) *
              ‖(Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i‖ ^ (2 : ℕ))) := by
          rw [Finset.sum_add_distrib, Finset.sum_sub_distrib, Finset.sum_const, nsmul_eq_mul]
          simp [Finset.card_univ]
    _ =
      (1 / 2 : ℝ) * ‖xk - xStar‖_[Li] ^ (2 : ℕ) -
        ((Fintype.card ι : ℝ)⁻¹) *
          ∑ i, inner ℝ ((Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i) (xk i - xStar i) +
        ((Fintype.card ι : ℝ)⁻¹) *
          ∑ i,
            (((1 : ℝ) / (2 * (Li i : ℝ))) *
              ‖(Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i‖ ^ (2 : ℕ)) := by
          field_simp [hcard_pos.ne']
    _ =
      (1 / 2 : ℝ) * ‖xk - xStar‖_[Li] ^ (2 : ℕ) -
        ((Fintype.card ι : ℝ)⁻¹) *
          ∑ i, inner ℝ ((Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i) (xk i - xStar i) +
        ((Fintype.card ι : ℝ)⁻¹) * (1 / 2 : ℝ) *
          ‖Gtilde[hproblem.toIsBlockProximalGradientProblem] xk‖_[Li,*] ^ (2 : ℕ) := by
          rw [hdual]
          ring

/-- Helper for Theorem 11.11: the owner-stable singleton insertion map coincides with the
canonical `ContinuousLinearMap.single`. -/
lemma rbpgRawSingletonLinearMap_apply_eq_single
    [DecidableEq ι]
    (j : ι) (d : Ei j) :
    (ContinuousLinearMap.pi (Pi.single j (ContinuousLinearMap.id ℝ (Ei j)))) d =
      (Pi.single j d : (i : ι) → Ei i) := by
  -- Compare the owner-stable singleton map with the canonical inserted vector coordinatewise.
  ext i
  by_cases hij : i = j
  · subst i
    simp
  · simp [hij]

/-- Helper for Theorem 11.11: the owner-stable singleton insertion map coincides with the
canonical `ContinuousLinearMap.single`. -/
lemma rbpgRawSingletonLinearMap_eq_single
    [DecidableEq ι]
    (j : ι) :
    ContinuousLinearMap.pi (Pi.single j (ContinuousLinearMap.id ℝ (Ei j))) =
      ContinuousLinearMap.single ℝ Ei j := by
  -- Compare the two singleton insertions coordinatewise on an arbitrary block vector.
  ext d i
  by_cases hij : i = j
  · subst i
    simp
  · simp [hij]

/-- Helper for Theorem 11.11: differentiating the translated one-block update in the active
coordinate recovers the owner-stable singleton insertion map. -/
lemma rbpgRawBlockCoordinateUpdate_hasFDerivAt
    [DecidableEq ι]
    (x : (i : ι) → Ei i) (j : ι) :
    HasFDerivAt
      (fun y : Ei j ↦ block_coordinate_update x j (y - x j))
      (.pi (Pi.single j (.id ℝ (Ei j))))
      (x j) := by
  have hrewrite :
      (fun y : Ei j ↦ block_coordinate_update x j (y - x j)) = Function.update x j := by
    funext y
    ext i
    by_cases hij : i = j
    · subst i
      simp [block_coordinate_update, Function.update]
    · simp [block_coordinate_update, Function.update, hij]
  -- The translated block update is exactly the standard `Function.update` map in the active
  -- coordinate.
  rw [hrewrite]
  simpa using hasFDerivAt_update (𝕜 := ℝ) x (i := j) (y := x j)

/-- Helper for Theorem 11.11: differentiating the translated one-block update in the active
coordinate recovers the canonical singleton insertion map. -/
lemma rbpgRawBlockCoordinateUpdate_hasFDerivAt_single
    [DecidableEq ι]
    (x : (i : ι) → Ei i) (j : ι) :
    HasFDerivAt
      (fun y : Ei j ↦ block_coordinate_update x j (y - x j))
      (ContinuousLinearMap.single ℝ Ei j)
      (x j) := by
  -- Rewrite the owner-stable derivative into the canonical singleton insertion spelling once.
  simpa [rbpgRawSingletonLinearMap_eq_single (Ei := Ei) j] using
    rbpgRawBlockCoordinateUpdate_hasFDerivAt (Ei := Ei) x j

/-- Helper for Theorem 11.11: restricting the Fréchet derivative of `x ↦ (f x).toReal` to the
`j`-th block insertion gives the corresponding block Riesz functional. -/
lemma rbpgRawFDerivCompBlockInsertion_eq_blockToDual
    [DecidableEq ι]
    (hproblem : RandomizedBlockProximalGradientAssumptions f g block_gradient XStar FOpt Li)
    {xPoint : (i : ι) → Ei i}
    (hxPoint : xPoint ∈ interior (effective_domain f))
    (j : ι) :
    (fderiv ℝ (fun y : (i : ι) → Ei i ↦ (f y).toReal) xPoint).comp
        (ContinuousLinearMap.pi (Pi.single j (ContinuousLinearMap.id ℝ (Ei j)))) =
      InnerProductSpace.toDualMap ℝ (Ei j) (block_gradient j xPoint) := by
  -- Route correction: identify the translated block slice derivative with the ambient derivative
  -- restricted along the singleton insertion, then use uniqueness of `HasFDerivAt`.
  have hsub :
      HasFDerivAt
        (fun y : Ei j ↦ y - xPoint j)
        (ContinuousLinearMap.id ℝ (Ei j))
        (xPoint j) := by
    -- The coordinate translation is affine, so its derivative is the identity map.
    simpa using (hasFDerivAt_sub_const (xPoint j) (x := xPoint j))
  have htranslated :
      HasFDerivAt
        (fun y : Ei j ↦ (f (block_coordinate_update xPoint j (y - xPoint j))).toReal)
        (InnerProductSpace.toDualMap ℝ (Ei j) (block_gradient j xPoint))
        (xPoint j) := by
    have hblockAt :
        HasFDerivAt
          (block_coordinate_slice f xPoint j)
          (InnerProductSpace.toDualMap ℝ (Ei j) (block_gradient j xPoint))
          (xPoint j - xPoint j) := by
      -- Re-express the block-slice base point as the zero displacement used in the owner
      -- gradient specification.
      simpa using
        hproblem.toIsBlockProximalGradientProblem.block_partial_gradient_spec j hxPoint
    -- First translate the one-block slice from displacement `0` to the actual block coordinate.
    simpa [block_coordinate_slice_apply, Function.comp] using
      (HasFDerivAt.comp
        (f := fun y : Ei j ↦ y - xPoint j)
        (g := block_coordinate_slice f xPoint j)
        (x := xPoint j)
        hblockAt
        hsub)
  have hambientDiffAt :
      DifferentiableAt ℝ (fun y : (i : ι) → Ei i ↦ (f y).toReal) xPoint := by
    -- The ambient differentiability hypothesis is available on the interior of the effective
    -- domain, so specialize it at `xPoint`.
    have hdiffOn :
        DifferentiableOn ℝ (fun y : (i : ι) → Ei i ↦ (f y).toReal)
          (interior (effective_domain f)) :=
      hproblem.f_toReal_differentiableOn_interior_effective_domain
    have hdiffWithin := hdiffOn xPoint hxPoint
    exact hdiffWithin.differentiableAt (isOpen_interior.mem_nhds hxPoint)
  have hambient :
      HasFDerivAt
        (fun y : (i : ι) → Ei i ↦ (f y).toReal)
        (fderiv ℝ (fun y : (i : ι) → Ei i ↦ (f y).toReal) xPoint)
        xPoint :=
    hambientDiffAt.hasFDerivAt
  have hupdate :
      HasFDerivAt
        (fun y : Ei j ↦ block_coordinate_update xPoint j (y - xPoint j))
        (ContinuousLinearMap.single ℝ Ei j)
        (xPoint j) :=
    rbpgRawBlockCoordinateUpdate_hasFDerivAt_single xPoint j
  have hcompSingle :
      HasFDerivAt
        (fun y : Ei j ↦ (f (block_coordinate_update xPoint j (y - xPoint j))).toReal)
        ((fderiv ℝ (fun y : (i : ι) → Ei i ↦ (f y).toReal) xPoint).comp
          (ContinuousLinearMap.single ℝ Ei j))
        (xPoint j) := by
    have hbase_eq : block_coordinate_update xPoint j (xPoint j - xPoint j) = xPoint := by
      ext i
      by_cases hij : i = j
      · subst i
        simp [block_coordinate_update]
      · simp [block_coordinate_update, hij]
    have hambientAtUpdate :
        HasFDerivAt
          (fun y : (i : ι) → Ei i ↦ (f y).toReal)
          (fderiv ℝ (fun y : (i : ι) → Ei i ↦ (f y).toReal) xPoint)
          (block_coordinate_update xPoint j (xPoint j - xPoint j)) := by
      exact hbase_eq.symm ▸ hambient
    -- Compose the ambient derivative with the canonical singleton insertion map first.
    simpa [Function.comp] using hambientAtUpdate.comp (xPoint j) hupdate
  have hcomp :
      HasFDerivAt
        (fun y : Ei j ↦ (f (block_coordinate_update xPoint j (y - xPoint j))).toReal)
        ((fderiv ℝ (fun y : (i : ι) → Ei i ↦ (f y).toReal) xPoint).comp
          (ContinuousLinearMap.pi (Pi.single j (ContinuousLinearMap.id ℝ (Ei j)))))
        (xPoint j) := by
    -- Rewrite the singleton insertion back to the owner-stable block map once.
    simpa [rbpgRawSingletonLinearMap_eq_single (Ei := Ei) j] using hcompSingle
  exact hcomp.unique htranslated

/-- Helper for Theorem 11.11: the Fréchet derivative of `x ↦ (f x).toReal` on a singleton block
direction is the corresponding block-gradient pairing. -/
lemma rbpgRawFDerivApply_single_eq_blockPairing
    [DecidableEq ι]
    (hproblem : RandomizedBlockProximalGradientAssumptions f g block_gradient XStar FOpt Li)
    {xPoint : (i : ι) → Ei i}
    (hxPoint : xPoint ∈ interior (effective_domain f))
    (j : ι)
    (d : Ei j) :
    (fderiv ℝ (fun y : (i : ι) → Ei i ↦ (f y).toReal) xPoint) (Pi.single j d) =
      inner ℝ (block_gradient j xPoint) d := by
  have hcomp :=
    rbpgRawFDerivCompBlockInsertion_eq_blockToDual hproblem hxPoint j
  have happly := congrArg (fun A : Ei j →L[ℝ] ℝ ↦ A d) hcomp
  -- Evaluate the composition identity on the test block vector `d`.
  simpa [ContinuousLinearMap.comp_apply, rbpgRawSingletonLinearMap_apply_eq_single (Ei := Ei) j d,
    InnerProductSpace.toDualMap_apply_apply] using happly

/-- Helper for Theorem 11.11: the ambient Fréchet derivative along a block vector displacement
decomposes as the finite sum of the block-gradient pairings. -/
lemma rbpgRawFDeriv_apply_eq_sumBlockPairings
    [DecidableEq ι]
    (hproblem : RandomizedBlockProximalGradientAssumptions f g block_gradient XStar FOpt Li)
    {xPoint h : (i : ι) → Ei i}
    (hxPoint : xPoint ∈ interior (effective_domain f)) :
    (fderiv ℝ (fun y : (i : ι) → Ei i ↦ (f y).toReal) xPoint) h =
      ∑ i, inner ℝ (block_gradient i xPoint) (h i) := by
  have hcoord :
      ∀ j,
        (fderiv ℝ (fun y : (i : ι) → Ei i ↦ (f y).toReal) xPoint) (Pi.single j (h j)) =
          inner ℝ (block_gradient j xPoint) (h j) := by
    intro j
    simpa using rbpgRawFDerivApply_single_eq_blockPairing hproblem hxPoint j (h j)
  have hsplit : h = ∑ i, Pi.single i (h i) := by
    ext i
    rw [Finset.sum_apply, Finset.sum_eq_single i]
    · simp
    · intro j _ hji
      have hij : i ≠ j := by
        intro hijEq
        exact hji hijEq.symm
      simp [Pi.single_eq_of_ne hij]
    · simp
  -- Expand the displacement into singleton blocks and use linearity of the Fréchet derivative.
  calc
    (fderiv ℝ (fun y : (i : ι) → Ei i ↦ (f y).toReal) xPoint) h =
        (fderiv ℝ (fun y : (i : ι) → Ei i ↦ (f y).toReal) xPoint)
          (∑ i, Pi.single i (h i)) := by
          exact congrArg
            (fun z : (i : ι) → Ei i ↦
              (fderiv ℝ (fun y : (i : ι) → Ei i ↦ (f y).toReal) xPoint) z)
            hsplit
    _ = ∑ i,
          (fderiv ℝ (fun y : (i : ι) → Ei i ↦ (f y).toReal) xPoint)
            (Pi.single i (h i)) := by
          rw [map_sum]
    _ = ∑ i, inner ℝ (block_gradient i xPoint) (h i) := by
          refine Finset.sum_congr rfl ?_
          intro i hi
          exact hcoord i

/-- Helper for Theorem 11.11: convexity of `f` bounds the block-gradient support sum at `x`
against any feasible comparison point `xStar`. -/
lemma rbpgConvexSupportSumAtPoint
    (hproblem : RandomizedBlockProximalGradientAssumptions f g block_gradient XStar FOpt Li)
    {x xStar : (i : ι) → Ei i}
    (hx : x ∈ interior (effective_domain f))
    (hxStar : xStar ∈ effective_domain f) :
    ∑ i, inner ℝ (block_gradient i x) (xStar i - x i) ≤
      (f xStar).toReal - (f x).toReal := by
  classical
  have hdiffAt :
      DifferentiableAt ℝ (fun y : (i : ι) → Ei i ↦ (f y).toReal) x := by
    -- The smooth term is differentiable on the interior effective domain visited by RBPG.
    exact
      (hproblem.f_toReal_differentiableOn_interior_effective_domain x hx).differentiableAt
        (isOpen_interior.mem_nhds hx)
  have hconv :
      ConvexOn ℝ (effective_domain f) (fun y ↦ (f y).toReal) :=
    convexOn_toReal_of_is_convex_function
      hproblem.f_convex
      (fun y _ ↦ hproblem.toIsBlockProximalGradientProblem.f_ne_bot y)
  let line : ℝ →ᵃ[ℝ] ((i : ι) → Ei i) := AffineMap.lineMap x xStar
  let φ : ℝ → ℝ := fun t ↦ (f (line t)).toReal
  have hφ_convex :
      ConvexOn ℝ (line ⁻¹' effective_domain f) φ := by
    -- Restrict the convex real model of `f` to the line segment from `x` to `xStar`.
    simpa [φ, line] using hconv.comp_affineMap line
  have hφ_zero :
      (0 : ℝ) ∈ line ⁻¹' effective_domain f := by
    simpa [line] using interior_subset hx
  have hφ_one :
      (1 : ℝ) ∈ line ⁻¹' effective_domain f := by
    simpa [line] using hxStar
  have hφ_deriv :
      HasDerivAt φ
        ((fderiv ℝ (fun y : (i : ι) → Ei i ↦ (f y).toReal) x) (xStar - x))
        0 := by
    -- Differentiate the line restriction at the current iterate and identify the derivative.
    have hbase :
        HasFDerivAt
          (fun y : (i : ι) → Ei i ↦ (f y).toReal)
          (fderiv ℝ (fun y : (i : ι) → Ei i ↦ (f y).toReal) x)
          (line 0) := by
      simpa [line] using hdiffAt.hasFDerivAt
    have hline :
        HasDerivAt line (xStar - x) 0 := by
      simpa [line] using
        (show HasDerivAt (AffineMap.lineMap x xStar) (xStar - x) (0 : ℝ) from
          AffineMap.hasDerivAt_lineMap)
    simpa [φ, line] using HasFDerivAt.comp_hasDerivAt (x := 0) hbase hline
  have hsecant :
      ((fderiv ℝ (fun y : (i : ι) → Ei i ↦ (f y).toReal) x) (xStar - x)) ≤
        slope φ 0 1 := by
    -- Convexity bounds the directional derivative at `0` by the secant slope to `1`.
    exact hφ_convex.le_slope_of_hasDerivAt hφ_zero hφ_one zero_lt_one hφ_deriv
  have hsecant' :
      ((fderiv ℝ (fun y : (i : ι) → Ei i ↦ (f y).toReal) x) (xStar - x)) ≤
        (f xStar).toReal - (f x).toReal := by
    simpa [φ, line, slope] using hsecant
  -- Rewrite the ambient Fréchet derivative as the finite sum of block-gradient pairings.
  rw [rbpgRawFDeriv_apply_eq_sumBlockPairings hproblem hx] at hsecant'
  exact hsecant'

/-- Helper for Theorem 11.11: the one-block prox support inequality at `xStar_i` rearranges into
the real-layer RBPG penalty estimate used in the deterministic objective bound. -/
lemma rbpgFrozenHistoryOneBlockProxSupportRearranged
    (hproblem : RandomizedBlockProximalGradientAssumptions f g block_gradient XStar FOpt Li)
    {xk xStar : (i : ι) → Ei i}
    (i : ι)
    (hxStari : xStar i ∈ effective_domain (g i)) :
    let gi := (Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i
    let yi := xk i - (1 / (Li i : ℝ)) • gi
    (g i yi).toReal - ((1 / (Li i : ℝ)) * inner ℝ (block_gradient i xk) gi) ≤
      (g i (xStar i)).toReal +
        inner ℝ (block_gradient i xk - gi) (xStar i - xk i) -
        ((Li i : ℝ)⁻¹) * ‖gi‖ ^ (2 : ℕ) := by
  -- Rewrite the owner prox-support inequality in the normalized RBPG residual spelling.
  dsimp
  let gi := (Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i
  let yi := xk i - (1 / (Li i : ℝ)) • gi
  change (g i yi).toReal - ((1 / (Li i : ℝ)) * inner ℝ (block_gradient i xk) gi) ≤
    (g i (xStar i)).toReal +
      inner ℝ (block_gradient i xk - gi) (xStar i - xk i) -
      ((Li i : ℝ)⁻¹) * ‖gi‖ ^ (2 : ℕ)
  have hsupport :=
    (block_partial_gradient_mapping_support_ineq_real
      (g := g)
      (block_gradient := block_gradient)
      (hg_proper := hproblem.block_g_proper)
      (hg_closed := hproblem.block_g_closed)
      (hg_convex := hproblem.block_g_convex)
      (i := i)
      (Li i)
      xk).2 (xStar i) hxStari
  have hT :
      T[Li i; g, block_gradient, hproblem.block_g_proper, hproblem.block_g_closed,
          hproblem.block_g_convex] xk i = yi := by
    -- Replace the prox point by the current block minus the scaled randomized residual.
    calc
      T[Li i; g, block_gradient, hproblem.block_g_proper, hproblem.block_g_closed,
          hproblem.block_g_convex] xk i =
          xk i - (1 / (Li i : ℝ)) •
            G[Li i; hproblem.toIsBlockProximalGradientProblem] xk i := by
              rw [block_partial_prox_grad_point_eq_sub_gradient_mapping
                (hg_proper := hproblem.block_g_proper)
                (hg_closed := hproblem.block_g_closed)
                (hg_convex := hproblem.block_g_convex)
                (i := i)]
      _ = xk i - (1 / (Li i : ℝ)) • gi := by
            rw [← randomized_block_gradient_mapping_apply
              (h := hproblem.toIsBlockProximalGradientProblem) (x := xk) (i := i)]
      _ = yi := rfl
  have hsupport' :
      inner ℝ (gi - block_gradient i xk) (xStar i - yi) ≤
        (g i (xStar i)).toReal - (g i yi).toReal := by
    simpa [gi, hT] using hsupport
  have hrewrite :
      inner ℝ (gi - block_gradient i xk) (xStar i - yi) =
        -inner ℝ (block_gradient i xk - gi) (xStar i - xk i) +
          ((Li i : ℝ)⁻¹) * ‖gi‖ ^ (2 : ℕ) -
          (1 / (Li i : ℝ)) * inner ℝ (block_gradient i xk) gi := by
    have hpair :
        inner ℝ (gi - block_gradient i xk) gi =
          ‖gi‖ ^ (2 : ℕ) - inner ℝ (block_gradient i xk) gi := by
      rw [inner_sub_left, real_inner_self_eq_norm_sq]
    have hterm :
        inner ℝ (gi - block_gradient i xk) (xStar i - xk i) =
          -inner ℝ (block_gradient i xk - gi) (xStar i - xk i) := by
      calc
        inner ℝ (gi - block_gradient i xk) (xStar i - xk i) =
            inner ℝ gi (xStar i - xk i) -
              inner ℝ (block_gradient i xk) (xStar i - xk i) := by
                rw [inner_sub_left]
        _ =
            -(inner ℝ (block_gradient i xk) (xStar i - xk i) -
              inner ℝ gi (xStar i - xk i)) := by
                ring
        _ =
            -inner ℝ (block_gradient i xk - gi) (xStar i - xk i) := by
                rw [inner_sub_left]
    -- Expand the translated comparison vector and separate the block-gradient and residual terms.
    calc
      inner ℝ (gi - block_gradient i xk) (xStar i - yi) =
          inner ℝ (gi - block_gradient i xk)
            ((xStar i - xk i) + (1 / (Li i : ℝ)) • gi) := by
              congr 2
              simp [yi, sub_eq_add_neg, add_assoc, add_left_comm, add_comm]
      _ =
          inner ℝ (gi - block_gradient i xk) (xStar i - xk i) +
            inner ℝ (gi - block_gradient i xk) ((1 / (Li i : ℝ)) • gi) := by
              rw [inner_add_right]
      _ =
          inner ℝ (gi - block_gradient i xk) (xStar i - xk i) +
            (1 / (Li i : ℝ)) * inner ℝ (gi - block_gradient i xk) gi := by
              rw [inner_smul_right]
      _ =
          -inner ℝ (block_gradient i xk - gi) (xStar i - xk i) +
            ((Li i : ℝ)⁻¹) * ‖gi‖ ^ (2 : ℕ) -
            (1 / (Li i : ℝ)) * inner ℝ (block_gradient i xk) gi := by
              rw [hterm, hpair]
              ring
  -- Move the support inequality into the rearranged RBPG penalty form.
  rw [hrewrite] at hsupport'
  linarith [hsupport']

/-- Helper for Theorem 11.11: one anchored block update packages the smooth descent estimate and
the prox support inequality into the composite-objective upper bound used before averaging. -/
lemma rbpgOneBlockCompositeObjectiveUpper
    (hproblem : RandomizedBlockProximalGradientAssumptions f g block_gradient XStar FOpt Li)
    {xk xStar : (i : ι) → Ei i}
    (i : ι)
    (hxk : xk ∈ effective_domain (separableSum g))
    (hxNext :
      block_coordinate_update
          xk
          i
          (-(1 / (Li i : ℝ)) • (Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i) ∈
        effective_domain (separableSum g))
    (hxStari : xStar i ∈ effective_domain (g i)) :
    let gi := (Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i
    let xNext := block_coordinate_update xk i (-(1 / (Li i : ℝ)) • gi)
    (composite_model_objective f (separableSum g) xNext).toReal ≤
      (composite_model_objective f (separableSum g) xk).toReal +
        ((g i (xStar i)).toReal - (g i (xk i)).toReal) +
        inner ℝ (block_gradient i xk - gi) (xStar i - xk i) -
        ((1 : ℝ) / (2 * (Li i : ℝ))) * ‖gi‖ ^ (2 : ℕ) := by
  dsimp
  let gi := (Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i
  let yi := xk i - (1 / (Li i : ℝ)) • gi
  let xNext := block_coordinate_update xk i (-(1 / (Li i : ℝ)) • gi)
  let extra : ℝ :=
    ((g i (xStar i)).toReal - (g i (xk i)).toReal) +
      inner ℝ (block_gradient i xk - gi) (xStar i - xk i) -
      ((1 : ℝ) / (2 * (Li i : ℝ))) * ‖gi‖ ^ (2 : ℕ)
  have hy_disp_neg : yi - xk i = -((1 / (Li i : ℝ)) • gi) := by
    dsimp [yi]
    abel_nf
  have hy_disp : yi - xk i = (-(1 / (Li i : ℝ)) : ℝ) • gi := by
    simpa [neg_smul] using hy_disp_neg
  have hxNext_eff : xNext ∈ effective_domain (separableSum g) := by
    simpa [xNext] using hxNext
  have hyNext_eff :
      block_coordinate_update xk i (yi - xk i) ∈ effective_domain (separableSum g) := by
    simpa [xNext, hy_disp] using hxNext_eff
  have hLi_pos : 0 < (Li i : ℝ) := PosReal.coe_pos (Li i)
  have hxk_int :
      xk ∈ interior (effective_domain f) :=
    IsBlockProximalGradientProblem.mem_interior_effective_domain_of_mem_g_effective_domain
      hproblem.toIsBlockProximalGradientProblem
      hxk
  have hxNext_int :
      xNext ∈ interior (effective_domain f) :=
    IsBlockProximalGradientProblem.mem_interior_effective_domain_of_mem_g_effective_domain
      hproblem.toIsBlockProximalGradientProblem
      hxNext_eff
  have hyNext_int :
      block_coordinate_update xk i (yi - xk i) ∈ interior (effective_domain f) := by
    simpa [xNext, hy_disp] using hxNext_int
  have hdescent_raw :
      (f xNext).toReal ≤
        (f xk).toReal +
          inner ℝ (block_gradient i xk) (-(1 / (Li i : ℝ)) • gi) +
          (((Li i : ℝ) / 2) * ‖-(1 / (Li i : ℝ)) • gi‖ ^ (2 : ℕ)) := by
    -- Apply the block descent lemma to the anchored block update.
    simpa [xNext, gi, block_coordinate_update] using
        block_coordinate_descent_lemma_of_slice_smooth
          f
          block_gradient
          (PosReal.toNNReal (Li i))
          i
          (IsBlockProximalGradientProblem.blockCoordinateSliceDomainConvexOfConvexEffectiveDomain
            (f := f)
            (i := i)
            (effective_domain_convex_of_is_convex_function hproblem.f_convex))
        (IsBlockProximalGradientProblem.blockCoordinateSliceIsLSmoothOnOfBlockLipschitz
          (f := f)
          (g := g)
          (block_gradient := block_gradient)
          (XStar := XStar)
          (FOpt := FOpt)
          (Li := Li)
          (hproblem := hproblem.toIsBlockProximalGradientProblem)
          (i := i)
          (M := Li i)
          (x := xk)
          (fun x d hx hxd ↦ by
            simpa using hproblem.block_partial_gradient_lipschitz i hx hxd))
        (hproblem.toIsBlockProximalGradientProblem.block_partial_gradient_hasGradientAt i hxk_int)
        hxk_int
        hxNext_int
  have hdescent :
      (f xNext).toReal ≤
        (f xk).toReal -
          (1 / (Li i : ℝ)) * inner ℝ (block_gradient i xk) gi +
          ((1 : ℝ) / (2 * (Li i : ℝ))) * ‖gi‖ ^ (2 : ℕ) := by
    have hquad :
        (((Li i : ℝ) / 2) * ‖-(1 / (Li i : ℝ)) • gi‖ ^ (2 : ℕ)) =
          ((1 : ℝ) / (2 * (Li i : ℝ))) * ‖gi‖ ^ (2 : ℕ) := by
      rw [norm_smul, Real.norm_eq_abs, abs_neg, abs_of_pos (one_div_pos.mpr hLi_pos)]
      field_simp [hLi_pos.ne']
    -- Normalize the step length and the quadratic term to the textbook coefficients.
    rw [inner_smul_right, hquad] at hdescent_raw
    linarith
  have hsupport :=
    rbpgFrozenHistoryOneBlockProxSupportRearranged
      hproblem
      (xk := xk)
      (xStar := xStar)
      i
      hxStari
  have hsupport' :
      (g i yi).toReal - (1 / (Li i : ℝ)) * inner ℝ (block_gradient i xk) gi ≤
        (g i (xStar i)).toReal +
          inner ℝ (block_gradient i xk - gi) (xStar i - xk i) -
          (1 / (Li i : ℝ)) * ‖gi‖ ^ (2 : ℕ) := by
    simpa [gi, yi, one_div] using hsupport
  have hreal :
      (-extra) + (f xNext).toReal + (g i yi).toReal ≤
        (f xk).toReal + (g i (xk i)).toReal := by
    -- Combine the smooth descent estimate with the prox-support inequality in the active block.
    have hsupport'' :
        (g i yi).toReal ≤
          (g i (xStar i)).toReal +
            inner ℝ (block_gradient i xk - gi) (xStar i - xk i) -
            (1 / (Li i : ℝ)) * ‖gi‖ ^ (2 : ℕ) +
            (1 / (Li i : ℝ)) * inner ℝ (block_gradient i xk) gi := by
      linarith [hsupport']
    have hsum :
        (f xNext).toReal + (g i yi).toReal ≤
          (f xk).toReal + (g i (xStar i)).toReal +
            inner ℝ (block_gradient i xk - gi) (xStar i - xk i) -
            ((1 : ℝ) / (2 * (Li i : ℝ))) * ‖gi‖ ^ (2 : ℕ) := by
      have hsum0 := add_le_add hdescent hsupport''
      convert hsum0 using 1 <;> ring_nf
    dsimp [extra]
    linarith [hsum]
  have hreal' :
      (-extra) + (f (block_coordinate_update xk i (yi - xk i))).toReal + (g i yi).toReal ≤
        (f xk).toReal + (g i (xk i)).toReal := by
    simpa [xNext, hy_disp] using hreal
  have hbridge :
      (((-extra : ℝ) : EReal)) + composite_model_objective f (separableSum g) xNext ≤
        composite_model_objective f (separableSum g) xk := by
    -- Upgrade the real active-block inequality to the full composite objective.
    simpa [xNext, yi, gi, extra] using
      hproblem.toIsBlockProximalGradientProblem.fullObjectiveSufficientDecreaseOfActiveRealInequality
        (i := i)
        (x := xk)
        (yi := yi)
        (c := -extra)
        hxk
        hyNext_eff
        hxk_int
        hyNext_int
        hreal'
  have hxk_val :
      composite_model_objective f (separableSum g) xk =
        ((((composite_model_objective f (separableSum g) xk).toReal : ℝ)) : EReal) := by
    exact rbpgObjective_eq_coeToReal_of_mem_effective_domain hproblem hxk
  have hxNext_val :
      composite_model_objective f (separableSum g) xNext =
        ((((composite_model_objective f (separableSum g) xNext).toReal : ℝ)) : EReal) := by
    exact
      rbpgObjective_eq_coeToReal_of_mem_effective_domain hproblem
        (by simpa [xNext, gi] using hxNext)
  have hbridge_real :
      ((-extra) + (composite_model_objective f (separableSum g) xNext).toReal) ≤
        (composite_model_objective f (separableSum g) xk).toReal := by
    rw [hxNext_val, hxk_val] at hbridge
    have hbridge' :
        ((((-extra) + (composite_model_objective f (separableSum g) xNext).toReal : ℝ)) : EReal) ≤
          ((((composite_model_objective f (separableSum g) xk).toReal : ℝ)) : EReal) := by
      simpa [EReal.coe_add] using hbridge
    exact EReal.coe_le_coe_iff.mp hbridge'
  -- Move the correction term to the right-hand side to obtain the desired objective upper bound.
  let correction : ℝ :=
    (g i (xStar i)).toReal - (g i (xk i)).toReal +
      inner ℝ (block_gradient i xk - gi) (xStar i - xk i) -
      ((1 : ℝ) / (2 * (Li i : ℝ))) * ‖gi‖ ^ (2 : ℕ)
  have hbridge_shift :
      (-correction) + (composite_model_objective f (separableSum g) xNext).toReal ≤
        (composite_model_objective f (separableSum g) xk).toReal := by
    simpa [correction, extra] using hbridge_real
  have hupper :
      (composite_model_objective f (separableSum g) xNext).toReal ≤
        (composite_model_objective f (separableSum g) xk).toReal + correction := by
    linarith [hbridge_shift]
  simpa [xNext, gi, correction, sub_eq_add_neg, add_assoc, add_left_comm, add_comm] using hupper

/-- Helper for Theorem 11.11: summing the blockwise penalty/support terms at an optimizer is
bounded by the global composite objective gap at the anchored iterate. -/
lemma rbpgCompositeSupportGapAtOptimizer
    (hproblem : RandomizedBlockProximalGradientAssumptions f g block_gradient XStar FOpt Li)
    {xk xStar : (i : ι) → Ei i}
    (hxk : xk ∈ effective_domain (separableSum g))
    (hxStar : xStar ∈ XStar) :
    ∑ i,
      (((g i (xStar i)).toReal - (g i (xk i)).toReal) +
        inner ℝ (block_gradient i xk) (xStar i - xk i)) ≤
      FOpt - (composite_model_objective f (separableSum g) xk).toReal := by
  -- Compare the summed block support terms against the optimizer objective in one global step.
  have hxk_int :
      xk ∈ interior (effective_domain f) :=
    IsBlockProximalGradientProblem.mem_interior_effective_domain_of_mem_g_effective_domain
      hproblem.toIsBlockProximalGradientProblem
      hxk
  have hxStar_g :
      xStar ∈ effective_domain (separableSum g) :=
    rbpgMemEffectiveDomain_of_mem_optimal_set hproblem hxStar
  have hxStar_f :
      xStar ∈ effective_domain f := by
    exact
      interior_subset
        (IsBlockProximalGradientProblem.mem_interior_effective_domain_of_mem_g_effective_domain
          hproblem.toIsBlockProximalGradientProblem
          hxStar_g)
  have hsupport :
      ∑ i, inner ℝ (block_gradient i xk) (xStar i - xk i) ≤
        (f xStar).toReal - (f xk).toReal :=
    rbpgConvexSupportSumAtPoint hproblem hxk_int hxStar_f
  have hsep_xk :
      (separableSum g xk).toReal = ∑ i, (g i (xk i)).toReal := by
    rw [IsBlockProximalGradientProblem.separableSumEqCoeToRealSum
      hproblem.toIsBlockProximalGradientProblem
      hxk, EReal.toReal_coe]
  have hsep_xStar :
      (separableSum g xStar).toReal = ∑ i, (g i (xStar i)).toReal := by
    rw [IsBlockProximalGradientProblem.separableSumEqCoeToRealSum
      hproblem.toIsBlockProximalGradientProblem
      hxStar_g, EReal.toReal_coe]
  have hobj_xk :
      (composite_model_objective f (separableSum g) xk).toReal =
        (f xk).toReal + (separableSum g xk).toReal := by
    rw [rbpgObjective_eq_real_sum_of_mem_effective_domain hproblem hxk, EReal.toReal_coe, hsep_xk]
  have hobj_xStar :
      FOpt = (f xStar).toReal + (separableSum g xStar).toReal := by
    calc
      FOpt = (composite_model_objective f (separableSum g) xStar).toReal := by
        simpa [rbpgObjective_eq_optimal_value_of_mem_optimal_set hproblem hxStar]
      _ = (f xStar).toReal + (separableSum g xStar).toReal := by
        rw [rbpgObjective_eq_real_sum_of_mem_effective_domain hproblem hxStar_g, EReal.toReal_coe,
          hsep_xStar]
  have hpenalty :
      ∑ i, ((g i (xStar i)).toReal - (g i (xk i)).toReal) =
        (separableSum g xStar).toReal - (separableSum g xk).toReal := by
    rw [Finset.sum_sub_distrib, hsep_xStar, hsep_xk]
  have hsum_split :
      ∑ i,
        (((g i (xStar i)).toReal - (g i (xk i)).toReal) +
          inner ℝ (block_gradient i xk) (xStar i - xk i)) =
        (∑ i, ((g i (xStar i)).toReal - (g i (xk i)).toReal)) +
          ∑ i, inner ℝ (block_gradient i xk) (xStar i - xk i) := by
    rw [Finset.sum_add_distrib]
  -- Separate the penalty and support sums, then combine them with the optimizer-value identity.
  rw [hsum_split]
  linarith [hpenalty, hsupport, hobj_xk, hobj_xStar]

/-- Helper for Theorem 11.11: after freezing the history `ξ₀, …, ξ_{n-1}`, averaging the
deterministic one-block objective estimate over the current block gives the sharp source-level
objective upper bound at the optimizer `xStar`. -/
lemma rbpgFrozenHistoryAverageObjectiveUpperAtOptimizer
    (hproblem : RandomizedBlockProximalGradientAssumptions f g block_gradient XStar FOpt Li)
    (x0 : effective_domain (separableSum g))
    (xStar : (i : ι) → Ei i)
    (hxStar : xStar ∈ XStar)
    (n : ℕ) (ξ : Fin n → ι) (i0 : ι) :
    let xk :=
      randomized_block_proximal_gradient_method
        hproblem.toIsBlockProximalGradientProblem
        (hproblem.interior_effective_domain_point x0)
        (rbpgHistoryWithCurrent n ξ i0)
        n
    let xNext : ι → ((i : ι) → Ei i) :=
      fun i ↦
        randomized_block_proximal_gradient_method
          hproblem.toIsBlockProximalGradientProblem
          (hproblem.interior_effective_domain_point x0)
          (rbpgHistoryWithCurrent n ξ i)
          (n + 1)
    ((Fintype.card ι : ℝ)⁻¹) * ∑ i,
      (composite_model_objective f (separableSum g) (xNext i)).toReal ≤
      ((1 : ℝ) - (Fintype.card ι : ℝ)⁻¹) *
          (composite_model_objective f (separableSum g) xk).toReal +
        ((Fintype.card ι : ℝ)⁻¹) * FOpt -
        ((Fintype.card ι : ℝ)⁻¹) * (1 / 2 : ℝ) *
          ‖Gtilde[hproblem.toIsBlockProximalGradientProblem] xk‖_[Li,*] ^ (2 : ℕ) -
        ((Fintype.card ι : ℝ)⁻¹) *
          ∑ i, inner ℝ ((Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i) (xStar i - xk i) := by
  classical
  -- Route correction: sum the fixed-block composite inequality first, then insert the optimizer
  -- comparison only once at the anchored iterate.
  dsimp
  set xk :=
    randomized_block_proximal_gradient_method
      hproblem.toIsBlockProximalGradientProblem
      (hproblem.interior_effective_domain_point x0)
      (rbpgHistoryWithCurrent n ξ i0)
      n
  set xNext : ι → ((i : ι) → Ei i) :=
    fun i ↦
      randomized_block_proximal_gradient_method
        hproblem.toIsBlockProximalGradientProblem
        (hproblem.interior_effective_domain_point x0)
        (rbpgHistoryWithCurrent n ξ i)
        (n + 1)
  have hcard_pos : 0 < (Fintype.card ι : ℝ) := by
    exact_mod_cast Fintype.card_pos_iff.mpr ⟨i0⟩
  have hcardInv_nonneg : 0 ≤ (Fintype.card ι : ℝ)⁻¹ := by
    exact inv_nonneg.mpr hcard_pos.le
  have hxk :
      xk ∈ effective_domain (separableSum g) := by
    simpa [xk] using
      IsBlockProximalGradientProblem.randomized_block_proximal_gradient_iterate_mem_effective_domain
        hproblem.toIsBlockProximalGradientProblem
        x0
        (rbpgHistoryWithCurrent n ξ i0)
        n
  have hxStar_g :
      xStar ∈ effective_domain (separableSum g) :=
    rbpgMemEffectiveDomain_of_mem_optimal_set hproblem hxStar
  have hxStari :
      ∀ i, xStar i ∈ effective_domain (g i) := by
    intro i
    exact
      block_mem_effective_domain_of_mem_separableSum_effective_domain
        g
        hproblem.block_g_proper
        hxStar_g
        i
  have hxNext_eff :
      ∀ i, xNext i ∈ effective_domain (separableSum g) := by
    intro i
    simpa [xNext] using
      IsBlockProximalGradientProblem.randomized_block_proximal_gradient_iterate_mem_effective_domain
        hproblem.toIsBlockProximalGradientProblem
        x0
        (rbpgHistoryWithCurrent n ξ i)
        (n + 1)
  have hstep :
      ∀ i,
        (composite_model_objective f (separableSum g) (xNext i)).toReal ≤
          (composite_model_objective f (separableSum g) xk).toReal +
            ((g i (xStar i)).toReal - (g i (xk i)).toReal) +
            inner ℝ
              (block_gradient i xk -
                (Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i)
              (xStar i - xk i) -
            ((1 : ℝ) / (2 * (Li i : ℝ))) *
              ‖(Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i‖ ^ (2 : ℕ) := by
    intro i
    have hbridge :=
      rbpgFrozenHistoryNextIterate_eq_blockUpdate hproblem x0 n ξ i i0
    have hxNext_eq :
        xNext i =
          block_coordinate_update
            xk
            i
            (-(1 / (Li i : ℝ)) • (Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i) := by
      simpa [xk, xNext] using hbridge
    -- Rewrite the deterministic successor into the anchored block-update spelling once.
    simpa [hxNext_eq] using
      rbpgOneBlockCompositeObjectiveUpper
        hproblem
        (xk := xk)
        (xStar := xStar)
        i
        hxk
        (by simpa [hxNext_eq] using hxNext_eff i)
        (hxStari i)
  have hsum :
      ∑ i, (composite_model_objective f (separableSum g) (xNext i)).toReal ≤
        ∑ i,
          ((composite_model_objective f (separableSum g) xk).toReal +
            ((g i (xStar i)).toReal - (g i (xk i)).toReal) +
            inner ℝ
              (block_gradient i xk -
                (Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i)
              (xStar i - xk i) -
            ((1 : ℝ) / (2 * (Li i : ℝ))) *
              ‖(Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i‖ ^ (2 : ℕ)) := by
    -- Sum the fixed-block composite objective bounds over the whole block family.
    refine Finset.sum_le_sum ?_
    intro i hi
    exact hstep i
  have hgap :
      ∑ i,
        (((g i (xStar i)).toReal - (g i (xk i)).toReal) +
          inner ℝ (block_gradient i xk) (xStar i - xk i)) ≤
        FOpt - (composite_model_objective f (separableSum g) xk).toReal :=
    rbpgCompositeSupportGapAtOptimizer hproblem hxk hxStar
  have hsplit :
      ∑ i,
        (((g i (xStar i)).toReal - (g i (xk i)).toReal) +
          inner ℝ
            (block_gradient i xk -
              (Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i)
            (xStar i - xk i)) =
        ∑ i,
          (((g i (xStar i)).toReal - (g i (xk i)).toReal) +
            inner ℝ (block_gradient i xk) (xStar i - xk i)) -
          ∑ i, inner ℝ ((Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i) (xStar i - xk i) := by
    -- Split the block-gradient/support term into the optimizer comparison part and the residual.
    rw [← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl ?_
    intro i hi
    rw [inner_sub_left]
    ring
  have hdual :
      ∑ i,
        (((1 : ℝ) / (2 * (Li i : ℝ))) *
          ‖(Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i‖ ^ (2 : ℕ)) =
        (1 / 2 : ℝ) *
          ‖Gtilde[hproblem.toIsBlockProximalGradientProblem] xk‖_[Li,*] ^ (2 : ℕ) := by
    -- Collapse the weighted blockwise residual squares into the weighted dual norm.
    have hnorm_sq :
        ‖Gtilde[hproblem.toIsBlockProximalGradientProblem] xk‖_[Li,*] ^ (2 : ℕ) =
          ∑ i,
            ((Li i : ℝ)⁻¹) *
              ‖(Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i‖ ^ (2 : ℕ) := by
      rw [randomized_block_weighted_dual_norm_def]
      have hnonneg :
          0 ≤
            ∑ i,
              ((Li i : ℝ)⁻¹) *
                ‖(Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i‖ ^ (2 : ℕ) := by
        refine Finset.sum_nonneg ?_
        intro i hi
        exact mul_nonneg (inv_nonneg.mpr (le_of_lt (PosReal.coe_pos (Li i)))) (by positivity)
      simpa using Real.sq_sqrt hnonneg
    calc
      ∑ i,
          (((1 : ℝ) / (2 * (Li i : ℝ))) *
            ‖(Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i‖ ^ (2 : ℕ)) =
          ∑ i,
            (1 / 2 : ℝ) *
              (((Li i : ℝ)⁻¹) *
                ‖(Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i‖ ^ (2 : ℕ)) := by
            refine Finset.sum_congr rfl ?_
            intro i hi
            have hLi_ne : (Li i : ℝ) ≠ 0 := ne_of_gt (PosReal.coe_pos (Li i))
            calc
              (((1 : ℝ) / (2 * (Li i : ℝ))) *
                  ‖(Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i‖ ^ (2 : ℕ)) =
                (((1 / 2 : ℝ) * ((Li i : ℝ)⁻¹)) *
                  ‖(Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i‖ ^ (2 : ℕ)) := by
                    field_simp [hLi_ne]
              _ =
                (1 / 2 : ℝ) *
                  (((Li i : ℝ)⁻¹) *
                    ‖(Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i‖ ^ (2 : ℕ)) := by
                    ring
      _ =
          (1 / 2 : ℝ) *
            ∑ i,
              ((Li i : ℝ)⁻¹) *
                ‖(Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i‖ ^ (2 : ℕ) := by
            rw [← Finset.mul_sum]
      _ =
          (1 / 2 : ℝ) *
            ‖Gtilde[hproblem.toIsBlockProximalGradientProblem] xk‖_[Li,*] ^ (2 : ℕ) := by
            rw [hnorm_sq]
  have hsum_bound :
      ∑ i, (composite_model_objective f (separableSum g) (xNext i)).toReal ≤
        ((Fintype.card ι : ℝ) - 1) *
            (composite_model_objective f (separableSum g) xk).toReal +
          FOpt -
          ∑ i, inner ℝ ((Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i) (xStar i - xk i) -
          (1 / 2 : ℝ) *
            ‖Gtilde[hproblem.toIsBlockProximalGradientProblem] xk‖_[Li,*] ^ (2 : ℕ) := by
    calc
      ∑ i, (composite_model_objective f (separableSum g) (xNext i)).toReal ≤
          ∑ i,
            ((composite_model_objective f (separableSum g) xk).toReal +
              ((g i (xStar i)).toReal - (g i (xk i)).toReal) +
              inner ℝ
                (block_gradient i xk -
                  (Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i)
                (xStar i - xk i) -
              ((1 : ℝ) / (2 * (Li i : ℝ))) *
                ‖(Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i‖ ^ (2 : ℕ)) := hsum
      _ =
          ∑ i,
            (((composite_model_objective f (separableSum g) xk).toReal +
                (((g i (xStar i)).toReal - (g i (xk i)).toReal) +
                  inner ℝ
                    (block_gradient i xk -
                      (Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i)
                    (xStar i - xk i))) -
              ((1 : ℝ) / (2 * (Li i : ℝ))) *
                ‖(Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i‖ ^ (2 : ℕ)) := by
            refine Finset.sum_congr rfl ?_
            intro i hi
            ring
      _ =
          ∑ i,
            ((composite_model_objective f (separableSum g) xk).toReal +
              (((g i (xStar i)).toReal - (g i (xk i)).toReal) +
                inner ℝ
                  (block_gradient i xk -
                    (Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i)
                  (xStar i - xk i))) -
          ∑ i,
            (((1 : ℝ) / (2 * (Li i : ℝ))) *
              ‖(Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i‖ ^ (2 : ℕ)) := by
            rw [Finset.sum_sub_distrib]
      _ =
          ∑ i, (composite_model_objective f (separableSum g) xk).toReal +
            ∑ i,
              (((g i (xStar i)).toReal - (g i (xk i)).toReal) +
                inner ℝ
                  (block_gradient i xk -
                    (Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i)
                  (xStar i - xk i)) -
            ∑ i,
              (((1 : ℝ) / (2 * (Li i : ℝ))) *
                ‖(Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i‖ ^ (2 : ℕ)) := by
            rw [Finset.sum_add_distrib]
      _ =
          (Fintype.card ι : ℝ) * (composite_model_objective f (separableSum g) xk).toReal +
            (∑ i,
              (((g i (xStar i)).toReal - (g i (xk i)).toReal) +
                inner ℝ
                  (block_gradient i xk -
                    (Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i)
                  (xStar i - xk i))) -
            ∑ i,
              (((1 : ℝ) / (2 * (Li i : ℝ))) *
                ‖(Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i‖ ^ (2 : ℕ)) := by
            rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul]
      _ =
          (Fintype.card ι : ℝ) * (composite_model_objective f (separableSum g) xk).toReal +
            (∑ i,
              (((g i (xStar i)).toReal - (g i (xk i)).toReal) +
                inner ℝ (block_gradient i xk) (xStar i - xk i)) -
              ∑ i, inner ℝ ((Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i) (xStar i - xk i)) -
            ∑ i,
              (((1 : ℝ) / (2 * (Li i : ℝ))) *
                ‖(Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i‖ ^ (2 : ℕ)) := by
            rw [hsplit]
      _ ≤
          (Fintype.card ι : ℝ) * (composite_model_objective f (separableSum g) xk).toReal +
            (FOpt - (composite_model_objective f (separableSum g) xk).toReal) -
            ∑ i, inner ℝ ((Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i) (xStar i - xk i) -
            ∑ i,
              (((1 : ℝ) / (2 * (Li i : ℝ))) *
                ‖(Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i‖ ^ (2 : ℕ)) := by
            linarith [hgap]
      _ =
          ((Fintype.card ι : ℝ) - 1) *
              (composite_model_objective f (separableSum g) xk).toReal +
            FOpt -
            ∑ i, inner ℝ ((Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i) (xStar i - xk i) -
            ∑ i,
              (((1 : ℝ) / (2 * (Li i : ℝ))) *
                ‖(Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i‖ ^ (2 : ℕ)) := by
            ring
      _ =
          ((Fintype.card ι : ℝ) - 1) *
              (composite_model_objective f (separableSum g) xk).toReal +
            FOpt -
            ∑ i, inner ℝ ((Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i) (xStar i - xk i) -
            (1 / 2 : ℝ) *
              ‖Gtilde[hproblem.toIsBlockProximalGradientProblem] xk‖_[Li,*] ^ (2 : ℕ) := by
            rw [hdual]
  have havg :
      ((Fintype.card ι : ℝ)⁻¹) * ∑ i,
        (composite_model_objective f (separableSum g) (xNext i)).toReal ≤
        ((Fintype.card ι : ℝ)⁻¹) *
          (((Fintype.card ι : ℝ) - 1) *
              (composite_model_objective f (separableSum g) xk).toReal +
            FOpt -
            ∑ i, inner ℝ ((Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i) (xStar i - xk i) -
            (1 / 2 : ℝ) *
              ‖Gtilde[hproblem.toIsBlockProximalGradientProblem] xk‖_[Li,*] ^ (2 : ℕ)) := by
    -- Average the summed bound using the nonnegative uniform block weight.
    exact mul_le_mul_of_nonneg_left hsum_bound hcardInv_nonneg
  calc
    ((Fintype.card ι : ℝ)⁻¹) * ∑ i,
        (composite_model_objective f (separableSum g) (xNext i)).toReal ≤
      ((Fintype.card ι : ℝ)⁻¹) *
        (((Fintype.card ι : ℝ) - 1) *
            (composite_model_objective f (separableSum g) xk).toReal +
          FOpt -
          ∑ i, inner ℝ ((Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i) (xStar i - xk i) -
          (1 / 2 : ℝ) *
            ‖Gtilde[hproblem.toIsBlockProximalGradientProblem] xk‖_[Li,*] ^ (2 : ℕ)) := havg
    _ =
      ((1 : ℝ) - (Fintype.card ι : ℝ)⁻¹) *
          (composite_model_objective f (separableSum g) xk).toReal +
        ((Fintype.card ι : ℝ)⁻¹) * FOpt -
        ((Fintype.card ι : ℝ)⁻¹) * (1 / 2 : ℝ) *
          ‖Gtilde[hproblem.toIsBlockProximalGradientProblem] xk‖_[Li,*] ^ (2 : ℕ) -
        ((Fintype.card ι : ℝ)⁻¹) *
          ∑ i, inner ℝ ((Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i) (xStar i - xk i) := by
        field_simp [hcard_pos.ne']
        ring

/-- Helper for Theorem 11.11: once the history `ξ₀, …, ξ_{n-1}` is frozen, averaging the
deterministic one-step Lyapunov observable over the current block yields the textbook Lyapunov
drop at the optimizer `xStar`. -/
lemma rbpgFrozenHistoryAverageLyapunovAtOptimizer
    (hproblem : RandomizedBlockProximalGradientAssumptions f g block_gradient XStar FOpt Li)
    (x0 : effective_domain (separableSum g))
    (xStar : (i : ι) → Ei i)
    (hxStar : xStar ∈ XStar)
    (n : ℕ) (ξ : Fin n → ι) (i0 : ι) :
    let xk :=
      randomized_block_proximal_gradient_method
        hproblem.toIsBlockProximalGradientProblem
        (hproblem.interior_effective_domain_point x0)
        (rbpgHistoryWithCurrent n ξ i0)
        n
    let xNext : ι → ((i : ι) → Ei i) :=
      fun i ↦
        randomized_block_proximal_gradient_method
          hproblem.toIsBlockProximalGradientProblem
          (hproblem.interior_effective_domain_point x0)
          (rbpgHistoryWithCurrent n ξ i)
          (n + 1)
    ((Fintype.card ι : ℝ)⁻¹) * ∑ i,
      ((1 / 2 : ℝ) * ‖xNext i - xStar‖_[Li] ^ (2 : ℕ) +
        (composite_model_objective f (separableSum g) (xNext i)).toReal - FOpt) ≤
      (1 / 2 : ℝ) * ‖xk - xStar‖_[Li] ^ (2 : ℕ) +
        (composite_model_objective f (separableSum g) xk).toReal - FOpt -
        ((Fintype.card ι : ℝ)⁻¹) *
          ((composite_model_objective f (separableSum g) xk).toReal - FOpt) := by
  -- Add the distance recursion and the averaged objective bound, then cancel the matching
  -- support and dual-norm terms in the anchored `xk`/`xNext` spelling.
  dsimp
  set xk :=
    randomized_block_proximal_gradient_method
      hproblem.toIsBlockProximalGradientProblem
      (hproblem.interior_effective_domain_point x0)
      (rbpgHistoryWithCurrent n ξ i0)
      n
  set xNext : ι → ((i : ι) → Ei i) :=
    fun i ↦
      randomized_block_proximal_gradient_method
        hproblem.toIsBlockProximalGradientProblem
        (hproblem.interior_effective_domain_point x0)
        (rbpgHistoryWithCurrent n ξ i)
        (n + 1)
  have hcard_pos : 0 < (Fintype.card ι : ℝ) := by
    exact_mod_cast Fintype.card_pos_iff.mpr ⟨i0⟩
  have hdist :
      ((Fintype.card ι : ℝ)⁻¹) * ∑ i, (1 / 2 : ℝ) * ‖xNext i - xStar‖_[Li] ^ (2 : ℕ) =
        (1 / 2 : ℝ) * ‖xk - xStar‖_[Li] ^ (2 : ℕ) -
          ((Fintype.card ι : ℝ)⁻¹) *
            ∑ i, inner ℝ ((Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i) (xk i - xStar i) +
          ((Fintype.card ι : ℝ)⁻¹) * (1 / 2 : ℝ) *
            ‖Gtilde[hproblem.toIsBlockProximalGradientProblem] xk‖_[Li,*] ^ (2 : ℕ) := by
    simpa [xk, xNext] using
      rbpgFrozenHistoryAverageDistanceRecursion hproblem x0 xStar n ξ i0
  have hobj :
      ((Fintype.card ι : ℝ)⁻¹) * ∑ i,
        (composite_model_objective f (separableSum g) (xNext i)).toReal ≤
          ((1 : ℝ) - (Fintype.card ι : ℝ)⁻¹) *
              (composite_model_objective f (separableSum g) xk).toReal +
            ((Fintype.card ι : ℝ)⁻¹) * FOpt -
            ((Fintype.card ι : ℝ)⁻¹) * (1 / 2 : ℝ) *
              ‖Gtilde[hproblem.toIsBlockProximalGradientProblem] xk‖_[Li,*] ^ (2 : ℕ) -
            ((Fintype.card ι : ℝ)⁻¹) *
              ∑ i, inner ℝ ((Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i) (xStar i - xk i) := by
    simpa [xk, xNext] using
      rbpgFrozenHistoryAverageObjectiveUpperAtOptimizer hproblem x0 xStar hxStar n ξ i0
  have hsum_split :
      ((Fintype.card ι : ℝ)⁻¹) * ∑ i,
        ((1 / 2 : ℝ) * ‖xNext i - xStar‖_[Li] ^ (2 : ℕ) +
          (composite_model_objective f (separableSum g) (xNext i)).toReal - FOpt) =
        (((Fintype.card ι : ℝ)⁻¹) * ∑ i, (1 / 2 : ℝ) * ‖xNext i - xStar‖_[Li] ^ (2 : ℕ)) +
          (((Fintype.card ι : ℝ)⁻¹) * ∑ i,
            (composite_model_objective f (separableSum g) (xNext i)).toReal) -
          FOpt := by
    -- Separate the averaged observable into the averaged distance term and the averaged
    -- objective term, then collapse the constant `FOpt`.
    calc
      ((Fintype.card ι : ℝ)⁻¹) * ∑ i,
          ((1 / 2 : ℝ) * ‖xNext i - xStar‖_[Li] ^ (2 : ℕ) +
            (composite_model_objective f (separableSum g) (xNext i)).toReal - FOpt) =
        ((Fintype.card ι : ℝ)⁻¹) *
          (∑ i, (1 / 2 : ℝ) * ‖xNext i - xStar‖_[Li] ^ (2 : ℕ) +
            ∑ i, (composite_model_objective f (separableSum g) (xNext i)).toReal -
            (Fintype.card ι : ℝ) * FOpt) := by
          rw [Finset.sum_sub_distrib, Finset.sum_add_distrib, Finset.sum_const,
            Finset.card_univ, nsmul_eq_mul]
      _ =
        (((Fintype.card ι : ℝ)⁻¹) * ∑ i, (1 / 2 : ℝ) * ‖xNext i - xStar‖_[Li] ^ (2 : ℕ)) +
          (((Fintype.card ι : ℝ)⁻¹) * ∑ i,
            (composite_model_objective f (separableSum g) (xNext i)).toReal) -
          FOpt := by
          rw [mul_sub, mul_add, ← mul_assoc, inv_mul_cancel₀ hcard_pos.ne', one_mul]
  have hdir :
      ∑ i, inner ℝ ((Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i) (xk i - xStar i) =
        -∑ i, inner ℝ ((Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i) (xStar i - xk i) := by
    -- Rewrite the distance-side pairing into the optimizer-oriented spelling used by the
    -- objective bound so the two sums cancel directly.
    calc
      ∑ i, inner ℝ ((Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i) (xk i - xStar i) =
          ∑ i, -inner ℝ ((Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i) (xStar i - xk i) := by
            refine Finset.sum_congr rfl ?_
            intro i hi
            have hsub : xk i - xStar i = -(xStar i - xk i) := by
              abel
            rw [hsub, inner_neg_right]
      _ = -∑ i, inner ℝ ((Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i) (xStar i - xk i) := by
            rw [Finset.sum_neg_distrib]
  calc
    ((Fintype.card ι : ℝ)⁻¹) * ∑ i,
        ((1 / 2 : ℝ) * ‖xNext i - xStar‖_[Li] ^ (2 : ℕ) +
          (composite_model_objective f (separableSum g) (xNext i)).toReal - FOpt) =
      (((Fintype.card ι : ℝ)⁻¹) * ∑ i, (1 / 2 : ℝ) * ‖xNext i - xStar‖_[Li] ^ (2 : ℕ)) +
        (((Fintype.card ι : ℝ)⁻¹) * ∑ i,
          (composite_model_objective f (separableSum g) (xNext i)).toReal) -
        FOpt := hsum_split
    _ ≤
      ((1 / 2 : ℝ) * ‖xk - xStar‖_[Li] ^ (2 : ℕ) -
          ((Fintype.card ι : ℝ)⁻¹) *
            ∑ i, inner ℝ ((Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i) (xk i - xStar i) +
          ((Fintype.card ι : ℝ)⁻¹) * (1 / 2 : ℝ) *
            ‖Gtilde[hproblem.toIsBlockProximalGradientProblem] xk‖_[Li,*] ^ (2 : ℕ)) +
        (((1 : ℝ) - (Fintype.card ι : ℝ)⁻¹) *
            (composite_model_objective f (separableSum g) xk).toReal +
          ((Fintype.card ι : ℝ)⁻¹) * FOpt -
          ((Fintype.card ι : ℝ)⁻¹) * (1 / 2 : ℝ) *
            ‖Gtilde[hproblem.toIsBlockProximalGradientProblem] xk‖_[Li,*] ^ (2 : ℕ) -
          ((Fintype.card ι : ℝ)⁻¹) *
            ∑ i, inner ℝ ((Gtilde[hproblem.toIsBlockProximalGradientProblem] xk) i) (xStar i - xk i)) -
        FOpt := by
      exact sub_le_sub_right (add_le_add (le_of_eq hdist) hobj) FOpt
    _ =
      (1 / 2 : ℝ) * ‖xk - xStar‖_[Li] ^ (2 : ℕ) +
        (composite_model_objective f (separableSum g) xk).toReal - FOpt -
        ((Fintype.card ι : ℝ)⁻¹) *
          ((composite_model_objective f (separableSum g) xk).toReal - FOpt) := by
      rw [hdir]
      field_simp [hcard_pos.ne']
      ring

/-- Helper for Theorem 11.11: the expected Lyapunov observable satisfies the one-step recursion
from the source proof. -/
lemma rbpgExpectedLyapunovStepRecursion
    (hproblem : RandomizedBlockProximalGradientAssumptions f g block_gradient XStar FOpt Li)
    (x0 : effective_domain (separableSum g))
    (sampled_block : ℕ → Ω → ι)
    (μ : Measure Ω)
    [IsProbabilityMeasure μ]
    (xStar : (i : ι) → Ei i)
    (hxStar : xStar ∈ XStar)
    (h_sampled_block_meas : ∀ k, Measurable (sampled_block k))
    (h_sampled_block_indep : iIndepFun sampled_block μ)
    (h_sampled_block_uniform :
      ∀ k (i : ι), μ ((sampled_block k) ⁻¹' {i}) = 1 / (Fintype.card ι : ENNReal)) :
    ∀ n,
      μ[fun ω ↦ rbpgLyapunovObservable hproblem x0 sampled_block xStar ω (n + 1)] ≤
        μ[fun ω ↦ rbpgLyapunovObservable hproblem x0 sampled_block xStar ω n] -
          ((Fintype.card ι : ℝ)⁻¹) * rbpg_expected_objective_gap hproblem x0 sampled_block μ n := by
  intro n
  classical
  let cardInv : ℝ := (Fintype.card ι : ℝ)⁻¹
  let history : Ω → Fin n → ι :=
    fun ω ↦ randomized_block_history (fun m ↦ sampled_block m ω) n
  let joint : Ω → (Fin n → ι) × ι :=
    fun ω ↦ (history ω, sampled_block n ω)
  let detCurrent : (Fin n → ι) → ι → ((i : ι) → Ei i) :=
    fun ξ i ↦
      randomized_block_proximal_gradient_method
        hproblem.toIsBlockProximalGradientProblem
        (hproblem.interior_effective_domain_point x0)
        (rbpgHistoryWithCurrent n ξ i)
        n
  let detNext : (Fin n → ι) → ι → ((i : ι) → Ei i) :=
    fun ξ i ↦
      randomized_block_proximal_gradient_method
        hproblem.toIsBlockProximalGradientProblem
        (hproblem.interior_effective_domain_point x0)
        (rbpgHistoryWithCurrent n ξ i)
        (n + 1)
  let avgLyapNext : (Fin n → ι) → ℝ :=
    fun ξ ↦
      cardInv * ∑ i,
        ((1 / 2 : ℝ) * ‖detNext ξ i - xStar‖_[Li] ^ (2 : ℕ) +
          (composite_model_objective f (separableSum g) (detNext ξ i)).toReal - FOpt)
  let currentLyapGap : (Fin n → ι) → ι → ℝ :=
    fun ξ i ↦
      (1 / 2 : ℝ) * ‖detCurrent ξ i - xStar‖_[Li] ^ (2 : ℕ) +
        (composite_model_objective f (separableSum g) (detCurrent ξ i)).toReal - FOpt -
        cardInv *
          ((composite_model_objective f (separableSum g) (detCurrent ξ i)).toReal - FOpt)
  let currentObjective : Ω → ℝ :=
    fun ω ↦
      (composite_model_objective f (separableSum g)
        (rbpg_pathwise_iterate hproblem x0 sampled_block ω n)).toReal
  let shiftedCurrentObjective : Ω → ℝ :=
    fun ω ↦ currentObjective ω - FOpt
  let jointCurrentLyapGap : ((Fin n → ι) × ι) → ℝ :=
    fun z ↦ currentLyapGap z.1 z.2
  let jointCurrentObjective : ((Fin n → ι) × ι) → ℝ :=
    fun z ↦ (composite_model_objective f (separableSum g) (detCurrent z.1 z.2)).toReal
  have hhistory_meas : Measurable history := by
    -- The frozen history is measurable because each coordinate is one realized sampled block.
    refine measurable_pi_lambda _ fun t ↦ ?_
    simpa [history, randomized_block_history] using h_sampled_block_meas t
  have hjoint_meas : Measurable joint := by
    -- Pairing the frozen history with the current block preserves measurability.
    exact hhistory_meas.prodMk (h_sampled_block_meas n)
  have hnext_path :
      μ[fun ω ↦ rbpgLyapunovObservable hproblem x0 sampled_block xStar ω (n + 1)] =
        μ[fun ω ↦
          (1 / 2 : ℝ) * ‖detNext (history ω) (sampled_block n ω) - xStar‖_[Li] ^ (2 : ℕ) +
            (composite_model_objective f (separableSum g)
              (detNext (history ω) (sampled_block n ω))).toReal - FOpt] := by
    -- Rewrite the realized successor iterate through the frozen history/current-block schedule.
    refine integral_congr_ae ?_
    filter_upwards with ω
    have hω :=
      rbpgPathwiseIterate_succ_eq_historyCurrent hproblem x0 sampled_block ω n
    simpa [rbpgLyapunovObservable, detNext, history] using
      congrArg
        (fun x ↦
          (1 / 2 : ℝ) * ‖x - xStar‖_[Li] ^ (2 : ℕ) +
            (composite_model_objective f (separableSum g) x).toReal - FOpt)
        hω
  have hnext_avg :
      μ[fun ω ↦
        (1 / 2 : ℝ) * ‖detNext (history ω) (sampled_block n ω) - xStar‖_[Li] ^ (2 : ℕ) +
          (composite_model_objective f (separableSum g)
            (detNext (history ω) (sampled_block n ω))).toReal - FOpt] =
        μ[fun ω ↦ avgLyapNext (history ω)] := by
    -- Average the deterministic next-step Lyapunov observable over the uniform current block.
    simpa [history, avgLyapNext, detNext, cardInv] using
      randomized_block_history_current_block_average
        (μ := μ)
        (sampled_block := sampled_block)
        n
        (fun ξ i ↦
          (1 / 2 : ℝ) * ‖detNext ξ i - xStar‖_[Li] ^ (2 : ℕ) +
            (composite_model_objective f (separableSum g) (detNext ξ i)).toReal - FOpt)
        h_sampled_block_meas
        h_sampled_block_indep
        h_sampled_block_uniform
  have havgLyapNext_int :
      Integrable (fun ω ↦ avgLyapNext (history ω)) μ := by
    -- The averaged successor Lyapunov term depends only on the finite frozen history.
    simpa [history, avgLyapNext] using
      randomized_block_history_observable_integrable
        (μ := μ)
        (sampled_block := sampled_block)
        n
        avgLyapNext
        h_sampled_block_meas
  have hjointCurrentLyapGap_int :
      Integrable (fun ω ↦ currentLyapGap (history ω) (sampled_block n ω)) μ := by
    -- Any real observable of the finite joint state `(ξ₀, …, ξ_{n-1}, i_n)` is integrable.
    have hfinite_int : Integrable jointCurrentLyapGap (μ.map joint) := by
      exact Integrable.of_finite
    simpa [joint, jointCurrentLyapGap] using hfinite_int.comp_measurable hjoint_meas
  have hdet_bound :
      μ[fun ω ↦ avgLyapNext (history ω)] ≤
        μ[fun ω ↦ currentLyapGap (history ω) (sampled_block n ω)] := by
    -- Apply the deterministic frozen-history Lyapunov drop pointwise before integrating.
    refine integral_mono_ae havgLyapNext_int hjointCurrentLyapGap_int ?_
    filter_upwards with ω
    simpa [avgLyapNext, currentLyapGap, detCurrent, detNext, cardInv] using
      rbpgFrozenHistoryAverageLyapunovAtOptimizer
        hproblem
        x0
        xStar
        hxStar
        n
        (history ω)
        (sampled_block n ω)
  have hcurrentLyapGap_repr :
      (fun ω ↦ currentLyapGap (history ω) (sampled_block n ω)) =
        fun ω ↦
          rbpgLyapunovObservable hproblem x0 sampled_block xStar ω n -
            cardInv * shiftedCurrentObjective ω := by
    -- The current deterministic Lyapunov-gap observable is exactly the realized time-`n`
    -- observable once the frozen history is rewritten back to the sampled path.
    funext ω
    have hω :=
      rbpgPathwiseIterate_eq_historyCurrent hproblem x0 sampled_block ω n
    simpa [currentLyapGap, detCurrent, history, cardInv, shiftedCurrentObjective,
      currentObjective, rbpgLyapunovObservable] using
      congrArg
        (fun x ↦
          (1 / 2 : ℝ) * ‖x - xStar‖_[Li] ^ (2 : ℕ) +
            (composite_model_objective f (separableSum g) x).toReal - FOpt -
            cardInv * ((composite_model_objective f (separableSum g) x).toReal - FOpt))
        hω.symm
  have hcurrentLyap_int :
      Integrable (fun ω ↦ rbpgLyapunovObservable hproblem x0 sampled_block xStar ω n) μ := by
    -- The realized time-`n` Lyapunov observable is another finite joint observable.
    have hfinite_int :
        Integrable
          (fun z : (Fin n → ι) × ι ↦
            (1 / 2 : ℝ) * ‖detCurrent z.1 z.2 - xStar‖_[Li] ^ (2 : ℕ) +
              (composite_model_objective f (separableSum g) (detCurrent z.1 z.2)).toReal - FOpt)
          (μ.map joint) := by
      exact Integrable.of_finite
    have hrepr :
        (fun ω ↦ rbpgLyapunovObservable hproblem x0 sampled_block xStar ω n) =
          fun ω ↦
            (1 / 2 : ℝ) * ‖detCurrent (history ω) (sampled_block n ω) - xStar‖_[Li] ^ (2 : ℕ) +
              (composite_model_objective f (separableSum g)
                (detCurrent (history ω) (sampled_block n ω))).toReal - FOpt := by
      funext ω
      have hω :=
        rbpgPathwiseIterate_eq_historyCurrent hproblem x0 sampled_block ω n
      simpa [detCurrent, history, rbpgLyapunovObservable] using
        congrArg
          (fun x ↦
            (1 / 2 : ℝ) * ‖x - xStar‖_[Li] ^ (2 : ℕ) +
              (composite_model_objective f (separableSum g) x).toReal - FOpt)
          hω
    rw [hrepr]
    simpa [joint] using hfinite_int.comp_measurable hjoint_meas
  have hcurrentObjective_int : Integrable currentObjective μ := by
    -- The current objective value is also a finite joint observable.
    have hfinite_int : Integrable jointCurrentObjective (μ.map joint) := by
      exact Integrable.of_finite
    have hrepr :
        currentObjective =
          fun ω ↦
            (composite_model_objective f (separableSum g)
              (detCurrent (history ω) (sampled_block n ω))).toReal := by
      funext ω
      have hω :=
        rbpgPathwiseIterate_eq_historyCurrent hproblem x0 sampled_block ω n
      simpa [currentObjective, detCurrent, history] using
        congrArg (fun x ↦ (composite_model_objective f (separableSum g) x).toReal) hω
    rw [hrepr]
    simpa [joint, jointCurrentObjective] using hfinite_int.comp_measurable hjoint_meas
  have hshiftedCurrentObjective_int : Integrable shiftedCurrentObjective μ := by
    -- Subtracting the constant optimal value preserves integrability of the current objective.
    exact hcurrentObjective_int.sub (integrable_const FOpt)
  have hshiftedCurrentObjective_eq :
      μ[fun ω ↦ shiftedCurrentObjective ω] =
        rbpg_expected_objective_gap hproblem x0 sampled_block μ n := by
    -- Move the constant `FOpt` inside the current objective integral.
    calc
      μ[fun ω ↦ shiftedCurrentObjective ω] =
          μ[fun ω ↦ currentObjective ω] - μ[fun _ : Ω ↦ FOpt] := by
            exact integral_sub hcurrentObjective_int (integrable_const FOpt)
      _ = μ[fun ω ↦ currentObjective ω] - FOpt := by
            simp
      _ = rbpg_expected_objective_gap hproblem x0 sampled_block μ n := by
            rfl
  have hcurrentLyapGap_eq :
      μ[fun ω ↦ currentLyapGap (history ω) (sampled_block n ω)] =
        μ[fun ω ↦ rbpgLyapunovObservable hproblem x0 sampled_block xStar ω n] -
          cardInv * rbpg_expected_objective_gap hproblem x0 sampled_block μ n := by
    -- Rewrite the current Lyapunov-gap observable back to the realized pathwise quantities.
    rw [hcurrentLyapGap_repr]
    calc
      μ[fun ω ↦
        rbpgLyapunovObservable hproblem x0 sampled_block xStar ω n -
          cardInv * shiftedCurrentObjective ω] =
          μ[fun ω ↦ rbpgLyapunovObservable hproblem x0 sampled_block xStar ω n] -
            μ[fun ω ↦ cardInv * shiftedCurrentObjective ω] := by
              exact integral_sub hcurrentLyap_int (hshiftedCurrentObjective_int.const_mul cardInv)
      _ = μ[fun ω ↦ rbpgLyapunovObservable hproblem x0 sampled_block xStar ω n] -
            cardInv * μ[fun ω ↦ shiftedCurrentObjective ω] := by
              rw [integral_const_mul]
      _ = μ[fun ω ↦ rbpgLyapunovObservable hproblem x0 sampled_block xStar ω n] -
            cardInv * rbpg_expected_objective_gap hproblem x0 sampled_block μ n := by
              rw [hshiftedCurrentObjective_eq]
  -- Route correction: after the deterministic frozen-history drop is isolated, the stochastic
  -- step is only the history/current-block averaging plus pathwise rewrites.
  calc
    μ[fun ω ↦ rbpgLyapunovObservable hproblem x0 sampled_block xStar ω (n + 1)] =
        μ[fun ω ↦
          (1 / 2 : ℝ) * ‖detNext (history ω) (sampled_block n ω) - xStar‖_[Li] ^ (2 : ℕ) +
            (composite_model_objective f (separableSum g)
              (detNext (history ω) (sampled_block n ω))).toReal - FOpt] := hnext_path
    _ = μ[fun ω ↦ avgLyapNext (history ω)] := hnext_avg
    _ ≤ μ[fun ω ↦ currentLyapGap (history ω) (sampled_block n ω)] := hdet_bound
    _ =
        μ[fun ω ↦ rbpgLyapunovObservable hproblem x0 sampled_block xStar ω n] -
          ((Fintype.card ι : ℝ)⁻¹) * rbpg_expected_objective_gap hproblem x0 sampled_block μ n := by
            simpa [cardInv] using hcurrentLyapGap_eq

section

variable {Ω : Type w} [MeasurableSpace Ω]
variable {ι : Type u} [Fintype ι] [MeasurableSpace ι] [DiscreteMeasurableSpace ι]
variable {Ei : ι → Type v}
variable [∀ i, NormedAddCommGroup (Ei i)] [∀ i, InnerProductSpace ℝ (Ei i)]
variable [∀ i, ProperSpace (Ei i)]
variable {Li : ι → PosReal}
variable {f : ((i : ι) → Ei i) → EReal} {g : (i : ι) → Ei i → EReal}
variable {block_gradient : (i : ι) → ((j : ι) → Ei j) → Ei i}
variable {XStar : Set ((i : ι) → Ei i)} {FOpt : ℝ}

/-- Theorem 11.11: for RBPG iterates generated by i.i.d. uniformly sampled blocks, the expected
objective gap satisfies the sublinear estimate
`E[F(x^(k + 1))] - F_opt ≤ (|ι| / (|ι| + k + 1)) rbpg_initial_lyapunov`. -/
theorem randomized_block_proximal_gradient_expected_objective_gap_le_sublinear
    (hproblem : RandomizedBlockProximalGradientAssumptions f g block_gradient XStar FOpt Li)
    (x0 : effective_domain (separableSum g))
    (sampled_block : ℕ → Ω → ι)
    (μ : Measure Ω)
    [IsProbabilityMeasure μ]
    (xStar : (i : ι) → Ei i)
    (hxStar : xStar ∈ XStar)
    (h_sampled_block_meas : ∀ k, Measurable (sampled_block k))
    (h_sampled_block_indep : iIndepFun sampled_block μ)
    (h_sampled_block_uniform :
      ∀ k (i : ι), μ ((sampled_block k) ⁻¹' {i}) = 1 / (Fintype.card ι : ENNReal))
    (k : ℕ) :
    rbpg_expected_objective_gap hproblem x0 sampled_block μ (k + 1) ≤
      ((Fintype.card ι : ℝ) / (Fintype.card ι + k + 1 : ℝ)) *
        rbpg_initial_lyapunov
          Li
          FOpt
          (composite_model_objective f (separableSum g))
          x0
          xStar := by
  classical
  let Φ : ℕ → ℝ :=
    fun n ↦ μ[fun ω ↦ rbpgLyapunovObservable hproblem x0 sampled_block xStar ω n]
  let a : ℕ → ℝ := rbpg_expected_objective_gap hproblem x0 sampled_block μ
  have hΩ_nonempty : Nonempty Ω := by
    by_contra hΩ
    have h_univ : (Set.univ : Set Ω) = ∅ := by
      ext ω
      exact (hΩ ⟨ω⟩).elim
    have : (1 : ENNReal) = 0 := by
      simpa [h_univ] using (IsProbabilityMeasure.measure_univ (μ := μ))
    norm_num at this
  have hι_nonempty : Nonempty ι := ⟨sampled_block 0 (Classical.choice hΩ_nonempty)⟩
  have hcard_pos : 0 < (Fintype.card ι : ℝ) := by
    exact_mod_cast Fintype.card_pos_iff.mpr hι_nonempty
  have hstep :
      ∀ n, Φ (n + 1) ≤ Φ n - ((Fintype.card ι : ℝ)⁻¹) * a n :=
    rbpgExpectedLyapunovStepRecursion
      hproblem
      x0
      sampled_block
      μ
      xStar
      hxStar
      h_sampled_block_meas
      h_sampled_block_indep
      h_sampled_block_uniform
  have hgap_le :
      ∀ n, a (n + 1) ≤ Φ (n + 1) := by
    intro n
    simpa [Φ, a] using
      rbpgExpectedObjectiveGap_le_expectedLyapunov
        hproblem
        x0
        sampled_block
        μ
        xStar
        h_sampled_block_meas
        h_sampled_block_indep
        h_sampled_block_uniform
        n
  have hanti :
      Antitone a :=
    rbpgExpectedObjectiveGapAntitone
      hproblem
      x0
      sampled_block
      μ
      h_sampled_block_meas
      h_sampled_block_indep
      h_sampled_block_uniform
  -- Route correction: isolate the missing stochastic Lyapunov recursion in one helper and
  -- finish the theorem through the scalar recurrence lemma.
  have hbound :=
    sublinearBoundOfAntitoneGapLyapunovRecursion
      (p := (Fintype.card ι : ℝ))
      Φ
      a
      hcard_pos
      hstep
      hgap_le
      hanti
      k
  simpa [Φ, a, rbpg_initial_lyapunov, rbpgLyapunovObservable, rbpg_pathwise_iterate] using hbound

end
