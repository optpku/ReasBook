import Mathlib
import FirstOrderMethodsOptimization_Beck_2017.Chap06.Definition_6_7
import FirstOrderMethodsOptimization_Beck_2017.Chap10.Lemma_10_61

local notation "Λ[" a "]" => primalCounterparts a

-- Declarations for this item will be appended below by the statement pipeline.

noncomputable section

universe u

scoped[DualNorm] notation:max "‖" y "‖_*" => ‖y‖

open scoped DualNorm

section

variable {E : Type u} [NormedAddCommGroup E] [NormedSpace ℝ E]

/- Algorithm 10.61 is `source-facing` in the chapter's non-Euclidean first-order API.

Domain sampling identifies the canonical owner declarations already present in the workspace:
- `fderiv` for the Fréchet derivative `f'(x^k)` in the ambient normed space;
- the operator norm on `E →L[ℝ] ℝ`, written on this theorem surface as `‖·‖_*`;
- `Λ[·]` from Lemma 10.61 for the source set `Λ_{f'(x^k)}`;
- `PosReal` from Chapter 6 for the positive curvature parameters `L_k > 0`.

Because the source algorithm makes a noncanonical choice
`f'(x^k)^† ∈ Λ_{f'(x^k)}` at each step, the clean public interface is a concrete recursion driven
by an explicit counterpart-selection rule, together with an admissibility predicate recording that
the chosen vectors are indeed primal counterparts along the generated trajectory. -/

/-- Algorithm 10.61: given an initial point `x^0 = x0`, a positive curvature sequence `L_k`, and
a rule `counterpart` selecting a primal counterpart of the current derivative, the non-Euclidean
gradient method generates iterates by
`x^(k+1) = x^k - (‖f'(x^k)‖_* / L_k) f'(x^k)^†`. -/
def non_euclidean_gradient_method
    (f : E → ℝ) (counterpart : ℕ → E → E) (L : ℕ → PosReal) (x0 : E) : ℕ → E
  | 0 => x0
  | k + 1 =>
      let xk := non_euclidean_gradient_method f counterpart L x0 k
      xk - (‖fderiv ℝ f xk‖_* / (L k : ℝ)) • counterpart k xk

/-- The chosen primal-counterpart sequence along the non-Euclidean gradient trajectory generated
by `counterpart`, `L`, and `x0`. -/
def non_euclidean_gradient_method_counterpart_sequence
    (f : E → ℝ) (counterpart : ℕ → E → E) (L : ℕ → PosReal) (x0 : E) : ℕ → E :=
  fun k ↦ counterpart k (non_euclidean_gradient_method f counterpart L x0 k)

/-- A counterpart-selection rule is admissible for the non-Euclidean gradient method when, along
the generated trajectory, each selected vector belongs to the primal-counterpart set
`Λ_{f'(x^k)}` of the current Fréchet derivative. -/
def non_euclidean_gradient_method_is_admissible
    (f : E → ℝ) (counterpart : ℕ → E → E) (L : ℕ → PosReal) (x0 : E) : Prop :=
  ∀ k : ℕ,
    let xk := non_euclidean_gradient_method f counterpart L x0 k
    DifferentiableAt ℝ f xk ∧
      counterpart k xk ∈ Λ[fderiv ℝ f xk]

section Theorems

variable {f : E → ℝ} {counterpart : ℕ → E → E} {L : ℕ → PosReal} {x0 : E}

local notation "x" => non_euclidean_gradient_method f counterpart L x0
local notation "xDagger" => non_euclidean_gradient_method_counterpart_sequence f counterpart L x0

-- Proof sketch: unfold the recursive definition of `non_euclidean_gradient_method` at the base
-- index `0`.
/-- The non-Euclidean gradient method starts at the prescribed initial point `x^0 = x0`. -/
@[simp] theorem non_euclidean_gradient_method_zero
    :
    x 0 = x0 :=
  rfl

-- Proof sketch: unfold the recursive definition of `non_euclidean_gradient_method` at `k + 1`;
-- the successor branch is exactly the textbook update formula evaluated at the current iterate
-- `x^k`.
/-- One non-Euclidean gradient step subtracts the scaled chosen primal counterpart
`(‖f'(x^k)‖_* / L_k) f'(x^k)^†` from the current iterate. -/
theorem non_euclidean_gradient_method_succ
    (k : ℕ) :
    x (k + 1) = x k - (‖fderiv ℝ f (x k)‖_* / (L k : ℝ)) • counterpart k (x k) :=
  rfl

/-- Evaluating the counterpart sequence at `k` recovers the chosen primal counterpart at the
`k`th iterate of the non-Euclidean gradient method. -/
@[simp] theorem non_euclidean_gradient_method_counterpart_sequence_apply
    (k : ℕ) :
    xDagger k = counterpart k (x k) :=
  rfl

-- Proof sketch: unfold `non_euclidean_gradient_method_is_admissible`, then specialize the
-- defining condition at the index `k` and extract its differentiability component.
/-- Under the admissibility condition, the objective is differentiable at each iterate generated by
the non-Euclidean gradient method. -/
theorem non_euclidean_gradient_method_differentiableAt
    (h : non_euclidean_gradient_method_is_admissible f counterpart L x0) (k : ℕ) :
    DifferentiableAt ℝ f (x k) :=
  (h k).1

-- Proof sketch: unfold `non_euclidean_gradient_method_is_admissible`, then specialize the
-- defining condition at the index `k` and extract the primal-counterpart membership component.
/-- Under the admissibility condition, the selected direction at iteration `k` belongs to the
primal-counterpart set `Λ_{f'(x^k)}` of the current derivative. -/
theorem non_euclidean_gradient_method_counterpart_mem
    (h : non_euclidean_gradient_method_is_admissible f counterpart L x0) (k : ℕ) :
    counterpart k (x k) ∈ Λ[fderiv ℝ f (x k)] :=
  (h k).2

/-- Under the admissibility condition, the chosen counterpart sequence takes values in the
primal-counterpart sets of the Fréchet derivatives along the generated trajectory. -/
theorem non_euclidean_gradient_method_counterpart_sequence_mem_primalCounterparts
    (h : non_euclidean_gradient_method_is_admissible f counterpart L x0) (k : ℕ) :
    xDagger k ∈ Λ[fderiv ℝ f (x k)] := by
  simpa using non_euclidean_gradient_method_counterpart_mem h k

end Theorems

end
