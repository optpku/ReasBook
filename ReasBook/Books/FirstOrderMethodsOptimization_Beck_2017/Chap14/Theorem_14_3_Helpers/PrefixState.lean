/-- Helper for Theorem 14.3: every intermediate prefix state dominates the final outer iterate in
objective value. -/
theorem alternating_minimization_next_iterate_objective_le_prefix_state
    (F : ((i : Fin p) → Ei i) → EReal)
    (x : ℕ → (i : Fin p) → Ei i)
    (htraj : is_alternating_minimization_trajectory F x)
    (k n : ℕ) :
    F (x (k + 1)) ≤ F (alternating_minimization_prefix_state x k n) := by
  by_cases hn : n ≤ p
  · have hantitone :=
      alternating_minimization_prefix_state_objective_antitone F x htraj k
    simpa [alternating_minimization_prefix_state_last] using hantitone hn
  · have hn_ge : p ≤ n := Nat.le_of_not_ge hn
    have hstate_n :
        alternating_minimization_prefix_state x k n = x (k + 1) :=
      alternating_minimization_prefix_state_eq_next_iterate_of_ge x k n hn_ge
    simp [hstate_n]

