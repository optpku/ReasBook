/-- Helper for Theorem 14.3: fixing the active block to a constant competitor preserves
convergence of the stage-`i` prefix states. -/
lemma alternating_minimization_tendsto_fixed_block_competitor_update
    (x : ℕ → (i : Fin p) → Ei i)
    {xBar : (j : Fin p) → Ei j} {ψ : ℕ → ℕ}
    (i : Fin p) (zi : Ei i)
    (hstage :
      Tendsto (fun m ↦ alternating_minimization_prefix_state x (ψ m) i.1) atTop (𝓝 xBar)) :
    Tendsto
      (fun m ↦ Function.update (alternating_minimization_prefix_state x (ψ m) i.1) i zi)
      atTop
