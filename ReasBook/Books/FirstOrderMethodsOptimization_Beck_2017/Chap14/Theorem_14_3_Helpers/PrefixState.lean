        atTop (𝓝 (F xBar)))
    (hupdated_value :
      F (Function.update xBar i (y i)) = F xBar)
    {zi : Ei i} {ziSeq : ℕ → Ei i}
    (hz : Function.update xBar i zi ∈ effective_domain F)
    (hzi :
      Tendsto ziSeq atTop (𝓝 zi))
    (hzi_dom :
      ∀ m,
        Function.update (alternating_minimization_prefix_state x (ψ m) i.1) i (ziSeq m) ∈
          effective_domain F) :
    F (Function.update xBar i (y i)) ≤ F (Function.update xBar i zi) := by
  have hcomp_tendsto :
      Tendsto
        (fun m ↦ Function.update (alternating_minimization_prefix_state x (ψ m) i.1) i (ziSeq m))
        atTop
        (𝓝 (Function.update xBar i zi)) :=
    alternating_minimization_tendsto_recovered_block_competitor_update
      x i hstage hzi
