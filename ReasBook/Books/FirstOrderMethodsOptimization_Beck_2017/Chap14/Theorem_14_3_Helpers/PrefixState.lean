  rw [tendsto_pi_nhds]
  intro j
  by_cases hji : j = i
  · subst hji
    simpa [Function.update] using tendsto_const_nhds
  · have hstage_j :
      Tendsto (fun m ↦ alternating_minimization_prefix_state x (ψ m) i.1 j)
        atTop
        (𝓝 (xBar j)) :=
      (continuous_apply j).tendsto xBar |>.comp hstage
    simpa [Function.update, hji] using hstage_j

