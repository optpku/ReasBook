/-- Helper for Theorem 14.3: in a `T0` ambient space, the previous inseparability conclusion
upgrades to literal equality. -/
theorem alternating_minimization_limit_block_eq_cluster_point
    (F : ((i : Fin p) → Ei i) → EReal)
    (xBar y : (j : Fin p) → Ei j) (i : Fin p)
    [T0Space ((j : Fin p) → Ei j)]
    (hxBar : xBar ∈ effective_domain F)
    (hyUpdate : Inseparable y (Function.update xBar i (y i)))
    (hyArgmin : y i ∈ alternating_minimization_argmin F xBar i)
    (hFy : F (Function.update xBar i (y i)) = F xBar)
    (hunique :
      ∀ xBar ∈ effective_domain F, ∀ i : Fin p,
        Set.Subsingleton (alternating_minimization_argmin F xBar i)) :
    y = xBar := by
  exact Inseparable.eq <|
    alternating_minimization_limit_block_inseparable_cluster_point
      F xBar y i hxBar hyUpdate hyArgmin hFy hunique

omit [∀ i, PseudoMetricSpace (Ei i)] [ProperSpace ((i : Fin p) → Ei i)] in
/-- Helper for Theorem 14.3: a fixed-base block minimizer produces an updated point that still
lies in the effective domain. -/
lemma alternating_minimization_argmin_update_mem_effective_domain_of_base_mem
    (F : ((i : Fin p) → Ei i) → EReal)
    {xBar : (j : Fin p) → Ei j} (i : Fin p)
    (hxBar : xBar ∈ effective_domain F) {yi : Ei i}
    (hyArgmin : yi ∈ alternating_minimization_argmin F xBar i) :
    Function.update xBar i yi ∈ effective_domain F := by
  rw [mem_alternating_minimization_argmin_update_iff, isMinOn_iff] at hyArgmin
  have hy_le : F (Function.update xBar i yi) ≤ F xBar := by
    simpa using hyArgmin (xBar i) (by simp)
  exact mem_effective_domain.mpr <|
    lt_of_le_of_lt hy_le (mem_effective_domain.mp hxBar)

