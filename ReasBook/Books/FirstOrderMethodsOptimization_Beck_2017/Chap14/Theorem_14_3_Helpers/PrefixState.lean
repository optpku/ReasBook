lemma alternating_minimization_limit_block_compare_with_recovered_competitor
    (F : ((i : Fin p) → Ei i) → EReal)
    (x : ℕ → (i : Fin p) → Ei i)
    (hcont : ContinuousOn F (effective_domain F))
    (htraj : is_alternating_minimization_trajectory F x)
    (xBar y : (j : Fin p) → Ei j) (i : Fin p)
