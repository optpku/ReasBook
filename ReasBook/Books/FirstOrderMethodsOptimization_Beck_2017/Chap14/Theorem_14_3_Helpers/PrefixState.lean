      ∀ m,
        F (alternating_minimization_prefix_state x (ψ m) (i.1 + 1)) ≤
          F (Function.update (alternating_minimization_prefix_state x (ψ m) i.1) i
            (ziSeq m)) := by
    intro m
    have hstep :=
      (isMinOn_iff.mp (is_alternating_minimization_trajectory_step htraj (ψ m) i))
