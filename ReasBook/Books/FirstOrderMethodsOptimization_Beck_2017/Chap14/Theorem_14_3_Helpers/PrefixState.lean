/-- Helper for Theorem 14.3: the outer-iterate objective sequence is antitone. -/
theorem alternating_minimization_objective_antitone
    (F : ((i : Fin p) → Ei i) → EReal)
    (x : ℕ → (i : Fin p) → Ei i)
    (htraj : is_alternating_minimization_trajectory F x) :
    Antitone fun k ↦ F (x k) :=
  antitone_nat_of_succ_le
    (alternating_minimization_objective_nonincreasing F x htraj)

omit [∀ i, PseudoMetricSpace (Ei i)] [ProperSpace ((i : Fin p) → Ei i)] in
/-- Helper for Theorem 14.3: if the objective values along a subsequence converge, then the same
limit is seen along the shifted subsequence `k_j + 1`. -/
theorem alternating_minimization_shifted_objective_tendsto
    (F : ((i : Fin p) → Ei i) → EReal)
    (x : ℕ → (i : Fin p) → Ei i)
    (htraj : is_alternating_minimization_trajectory F x)
    {ψ : ℕ → ℕ} (hψ : StrictMono ψ) {ℓ : EReal}
    (hFx :
      Tendsto (fun m ↦ F (x (ψ m))) atTop (𝓝 ℓ)) :
    Tendsto (fun m ↦ F (x (ψ m + 1))) atTop (𝓝 ℓ) := by
  let hanti := alternating_minimization_objective_antitone F x htraj
  have hFx_succ :
      Tendsto (fun m ↦ F (x (ψ (m + 1)))) atTop (𝓝 ℓ) := by
    exact hFx.comp (tendsto_add_atTop_nat 1)
  refine tendsto_of_tendsto_of_tendsto_of_le_of_le hFx_succ hFx ?_ ?_
  · intro m
    exact hanti (Nat.succ_le_of_lt (hψ (Nat.lt_succ_self m)))
  · intro m
    exact hanti (Nat.le_add_right (ψ m) 1)

