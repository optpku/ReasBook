/-- Helper for Theorem 14.3: lower semicontinuity bounds the objective value at a sequential
limit point by the liminf along any convergent sequence. -/
theorem lowerSemicontinuousValue_le_liminfAlongSequence
    (F : ((i : Fin p) → Ei i) → EReal) (hclosed : LowerSemicontinuous F)
    {u : ℕ → (i : Fin p) → Ei i} {xBar : (i : Fin p) → Ei i}
    (hu : Tendsto u atTop (𝓝 xBar)) :
    F xBar ≤ Filter.liminf (fun k ↦ F (u k)) atTop := by
  calc
    F xBar ≤ Filter.liminf F (𝓝 xBar) := hclosed.le_liminf xBar
    _ ≤ Filter.liminf F (Filter.map u atTop) := Filter.liminf_le_liminf_of_le hu
    _ = Filter.liminf (fun k ↦ F (u k)) atTop := by
      rw [← Filter.liminf_comp]
      rfl

omit [∀ i, PseudoMetricSpace (Ei i)] [ProperSpace ((i : Fin p) → Ei i)] in
/-- Helper for Theorem 14.3: if the updated limit state belongs to the fixed-base block argmin set
and attains the cluster-point objective value, then the unchanged base coordinate belongs to the
same argmin set. -/
theorem alternating_minimization_base_coordinate_mem_argmin_of_limit
    (F : ((i : Fin p) → Ei i) → EReal)
    (xBar y : (j : Fin p) → Ei j) (i : Fin p)
    (hyArgmin : y i ∈ alternating_minimization_argmin F xBar i)
    (hFy : F (Function.update xBar i (y i)) = F xBar) :
    xBar i ∈ alternating_minimization_argmin F xBar i := by
  have hy_isMin :
      IsMinOn (fun yi ↦ F (Function.update xBar i yi)) Set.univ (y i) :=
    (mem_alternating_minimization_argmin_update_iff).1 hyArgmin
  refine (mem_alternating_minimization_argmin_update_iff).2 ?_
  rw [isMinOn_iff]
  intro z hz
  have hy_min :
      F (Function.update xBar i (y i)) ≤ F (Function.update xBar i z) := by
    exact (isMinOn_iff.mp hy_isMin) z hz
  have hvalue :
      F (Function.update xBar i (xBar i)) = F (Function.update xBar i (y i)) := by
    calc
      F (Function.update xBar i (xBar i)) = F xBar := by simp
      _ = F (Function.update xBar i (y i)) := hFy.symm
  calc
    F (Function.update xBar i (xBar i)) = F (Function.update xBar i (y i)) := hvalue
    _ ≤ F (Function.update xBar i z) := hy_min

omit [ProperSpace ((i : Fin p) → Ei i)] in
/-- Helper for Theorem 14.3: once the updated limit state belongs to the fixed-base block argmin
set and attains the cluster-point objective value, uniqueness of that argmin set forces the limit
state to be topologically indistinguishable from `xBar`. -/
theorem alternating_minimization_limit_block_inseparable_cluster_point
    (F : ((i : Fin p) → Ei i) → EReal)
    (xBar y : (j : Fin p) → Ei j) (i : Fin p)
    (hxBar : xBar ∈ effective_domain F)
    (hyUpdate : Inseparable y (Function.update xBar i (y i)))
    (hyArgmin : y i ∈ alternating_minimization_argmin F xBar i)
    (hFy : F (Function.update xBar i (y i)) = F xBar)
    (hunique :
      ∀ xBar ∈ effective_domain F, ∀ i : Fin p,
        Set.Subsingleton (alternating_minimization_argmin F xBar i)) :
    Inseparable y xBar := by
  have hxBar_argmin :
      xBar i ∈ alternating_minimization_argmin F xBar i :=
    alternating_minimization_base_coordinate_mem_argmin_of_limit F xBar y i hyArgmin hFy
  have hyi : y i = xBar i :=
    (hunique xBar hxBar i) hyArgmin hxBar_argmin
  have hupdate_eq : Function.update xBar i (y i) = xBar := by
    ext j
    by_cases hji : j = i
    · subst hji
      simpa [Function.update] using hyi
    · simp [Function.update, hji]
  exact hyUpdate.trans (Inseparable.of_eq hupdate_eq)

