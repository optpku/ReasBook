    simpa [alternating_minimization_prefix_state_new_eq_partial_state,
      alternating_minimization_partial_state_eq_update_prefix_state,
      alternating_minimization_block_objective_apply] using hstep
  have hxBar_le_comp :
      F xBar ≤ F (Function.update xBar i zi) := by
    exact le_of_tendsto_of_tendsto' hFnext hcomp_obj hstep_compare
  simpa [hupdated_value] using hxBar_le_comp

namespace AlternatingMinimization

namespace PrefixState

/-- Helper for Theorem 14.3: for any strict subsequence and any stage `n < p`, the next prefix
states admit a further convergent refinement inside the initial bounded real sublevel. -/
lemma stage_succ_has_convergent_refinement
    (F : ((i : Fin p) → Ei i) → EReal)
    (x : ℕ → (i : Fin p) → Ei i)
    (hclosed : LowerSemicontinuous F)
    (hlevel : ∀ α : ℝ, Bornology.IsBounded {x | F x ≤ (α : EReal)})
    (htraj : is_alternating_minimization_trajectory F x)
    {ψ : ℕ → ℕ} {n : ℕ} (hn : n < p) :
    ∃ φ : ℕ → ℕ, StrictMono φ ∧
      ∃ y : (i : Fin p) → Ei i,
        Tendsto (fun m ↦ alternating_minimization_prefix_state x (ψ (φ m)) (n + 1))
          atTop (𝓝 y) := by
  have hx0_dom : x 0 ∈ effective_domain F :=
    is_alternating_minimization_trajectory_zero htraj
  have hx0_top : F (x 0) ≠ ⊤ := (mem_effective_domain.mp hx0_dom).ne
  let C : Set ((i : Fin p) → Ei i) := {z | F z ≤ (((F (x 0)).toReal : ℝ) : EReal)}
  have hC_closed : IsClosed C := by
    simpa [C] using hclosed.isClosed_preimage ((((F (x 0)).toReal : ℝ) : EReal))
  have hC_bounded : Bornology.IsBounded C := by
    simpa [C] using hlevel ((F (x 0)).toReal)
  have hC_compact : IsCompact C :=
    Metric.isCompact_of_isClosed_isBounded hC_closed hC_bounded
  let u : ℕ → (i : Fin p) → Ei i :=
    fun m ↦ alternating_minimization_prefix_state x (ψ m) (n + 1)
  have huC : ∀ m, u m ∈ C := by
    intro m
    have hu_pair :
        alternating_minimization_prefix_state x (ψ m) (n + 1) ∈ effective_domain F ∧
          F (alternating_minimization_prefix_state x (ψ m) (n + 1)) ≤ F (x (ψ m)) := by
      exact alternating_minimization_prefix_state_mem_effective_domain_and_le
        F x htraj (ψ m)
        (alternating_minimization_iterate_mem_effective_domain F x htraj (ψ m))
        (n + 1) (Nat.succ_le_of_lt hn)
    have hu_le :
        F (u m) ≤ (((F (x 0)).toReal : ℝ) : EReal) := by
      calc
        F (u m) ≤ F (x (ψ m)) := hu_pair.2
        _ ≤ F (x 0) := alternating_minimization_objective_le_initial F x htraj (ψ m)
        _ ≤ (((F (x 0)).toReal : ℝ) : EReal) := EReal.le_coe_toReal hx0_top
    exact hu_le
  have hfreq : ∃ᶠ m in atTop, u m ∈ C :=
    (Filter.Eventually.of_forall huC).frequently
  rcases hC_compact.exists_mapClusterPt_of_frequently hfreq with ⟨y, -, hyCluster⟩
  rcases MapClusterPt.tendsto_subseq hyCluster with ⟨φ, hφ, hφtendsto⟩
  exact ⟨φ, hφ, y, by simpa [u] using hφtendsto⟩

end PrefixState

end AlternatingMinimization

/-- Helper for Theorem 14.3: a convergent refinement of the stage-`i+1` prefix states packages
the actual new block values into a recovered domain-valued update sequence. -/
lemma alternating_minimization_stage_succ_refinement_as_recovered_updates
    (F : ((i : Fin p) → Ei i) → EReal)
    (x : ℕ → (i : Fin p) → Ei i)
    (hclosed : LowerSemicontinuous F)
    (hlevel : ∀ α : ℝ, Bornology.IsBounded {x | F x ≤ (α : EReal)})
    (htraj : is_alternating_minimization_trajectory F x)
    (i : Fin p) {ψ : ℕ → ℕ} :
    ∃ φ : ℕ → ℕ, StrictMono φ ∧
      ∃ y : (j : Fin p) → Ei j,
        Tendsto (fun m ↦ alternating_minimization_prefix_state x (ψ (φ m)) (i.1 + 1))
          atTop (𝓝 y) ∧
        Tendsto (fun m ↦ x (ψ (φ m) + 1) i) atTop (𝓝 (y i)) ∧
        ∀ m,
          Function.update (alternating_minimization_prefix_state x (ψ (φ m)) i.1) i
            (x (ψ (φ m) + 1) i) ∈ effective_domain F := by
  rcases AlternatingMinimization.PrefixState.stage_succ_has_convergent_refinement
      F x hclosed hlevel htraj i.is_lt with ⟨φ, hφ, y, hnext⟩
  have hcoord :
      Tendsto (fun m ↦ x (ψ (φ m) + 1) i) atTop (𝓝 (y i)) :=
    alternating_minimization_stage_succ_coordinate_tendsto x i hnext
  have hdom :
      ∀ m,
        Function.update (alternating_minimization_prefix_state x (ψ (φ m)) i.1) i
          (x (ψ (φ m) + 1) i) ∈ effective_domain F := by
    intro m
    have hprefix_dom :
        alternating_minimization_prefix_state x (ψ (φ m)) (i.1 + 1) ∈ effective_domain F :=
      (alternating_minimization_prefix_state_mem_effective_domain_and_le
        F x htraj (ψ (φ m))
        (alternating_minimization_iterate_mem_effective_domain F x htraj (ψ (φ m)))
        (i.1 + 1) (Nat.succ_le_of_lt i.is_lt)).1
    simpa [alternating_minimization_prefix_state_new_eq_partial_state,
      alternating_minimization_partial_state_eq_update_prefix_state] using hprefix_dom
  exact ⟨φ, hφ, y, hnext, hcoord, hdom⟩

omit [ProperSpace ((i : Fin p) → Ei i)] in
/-- Helper for Theorem 14.3: any limit of prefix states stays inside the initial real sublevel
because every prefix state already belongs to that closed set. -/
lemma alternating_minimization_prefix_state_limit_mem_initial_sublevel
    (F : ((i : Fin p) → Ei i) → EReal)
    (x : ℕ → (i : Fin p) → Ei i)
    (hclosed : LowerSemicontinuous F)
    (htraj : is_alternating_minimization_trajectory F x)
    {u : (j : Fin p) → Ei j} {ψ : ℕ → ℕ}
    (n : ℕ) (hn : n ≤ p)
    (hu :
      Tendsto (fun m ↦ alternating_minimization_prefix_state x (ψ m) n) atTop (𝓝 u)) :
    u ∈ {z | F z ≤ (((F (x 0)).toReal : ℝ) : EReal)} := by
  have hx0_dom : x 0 ∈ effective_domain F :=
    is_alternating_minimization_trajectory_zero htraj
  have hx0_top : F (x 0) ≠ ⊤ := (mem_effective_domain.mp hx0_dom).ne
  have hsublevel_closed :
      IsClosed {z | F z ≤ (((F (x 0)).toReal : ℝ) : EReal)} := by
    simpa using hclosed.isClosed_preimage ((((F (x 0)).toReal : ℝ) : EReal))
  refine hsublevel_closed.mem_of_tendsto hu ?_
  exact Filter.Eventually.of_forall fun m ↦
    alternating_minimization_prefix_state_mem_initial_sublevel F x htraj (ψ m) n hn

namespace AlternatingMinimization

namespace ChosenArgminUpdate

omit [ProperSpace ((i : Fin p) → Ei i)] in
/-- Helper for Theorem 14.3: a fixed-base block minimizer remains inside the initial real
sublevel at the stage-`i` limit point. -/
lemma mem_initial_sublevel
    (F : ((i : Fin p) → Ei i) → EReal)
    (x : ℕ → (i : Fin p) → Ei i)
    (hclosed : LowerSemicontinuous F)
    (htraj : is_alternating_minimization_trajectory F x)
    {xBar : (j : Fin p) → Ei j} (i : Fin p)
    {ψ : ℕ → ℕ}
    (hstage :
      Tendsto (fun m ↦ alternating_minimization_prefix_state x (ψ m) i.1) atTop (𝓝 xBar))
    {ziStar : Ei i}
    (hziStar : ziStar ∈ alternating_minimization_argmin F xBar i) :
    Function.update xBar i ziStar ∈ {z | F z ≤ (((F (x 0)).toReal : ℝ) : EReal)} := by
  have hxBar_sublevel :
      xBar ∈ {z | F z ≤ (((F (x 0)).toReal : ℝ) : EReal)} :=
    alternating_minimization_prefix_state_limit_mem_initial_sublevel
      F x hclosed htraj i.1 (Nat.le_of_lt i.is_lt) hstage
  have hziStar_isMin :
      IsMinOn (fun yi ↦ F (Function.update xBar i yi)) Set.univ ziStar :=
    (mem_alternating_minimization_argmin_update_iff).1 hziStar
  have hziStar_le :
      F (Function.update xBar i ziStar) ≤ F xBar := by
    simpa using (isMinOn_iff.mp hziStar_isMin) (xBar i) (by simp)
  exact le_trans hziStar_le hxBar_sublevel

omit [ProperSpace ((i : Fin p) → Ei i)] in
/-- Helper for Theorem 14.3: a fixed-base block minimizer at `xBar` produces an updated point
that stays both in the effective domain and in the initial real sublevel. -/
lemma mem_effective_domain_and_mem_initial_sublevel
    (F : ((i : Fin p) → Ei i) → EReal)
    (x : ℕ → (i : Fin p) → Ei i)
    (hclosed : LowerSemicontinuous F)
    (htraj : is_alternating_minimization_trajectory F x)
    {xBar : (j : Fin p) → Ei j} (i : Fin p)
    {ψ : ℕ → ℕ}
    (hstage :
      Tendsto (fun m ↦ alternating_minimization_prefix_state x (ψ m) i.1) atTop (𝓝 xBar))
    (hxBar : xBar ∈ effective_domain F)
    {ziStar : Ei i}
    (hziStar : ziStar ∈ alternating_minimization_argmin F xBar i) :
    Function.update xBar i ziStar ∈ effective_domain F ∧
      Function.update xBar i ziStar ∈ {z | F z ≤ (((F (x 0)).toReal : ℝ) : EReal)} := by
  constructor
  · exact alternating_minimization_argmin_update_mem_effective_domain_of_base_mem
      F i hxBar hziStar
  · exact mem_initial_sublevel
      F x hclosed htraj i hstage hziStar

end ChosenArgminUpdate

