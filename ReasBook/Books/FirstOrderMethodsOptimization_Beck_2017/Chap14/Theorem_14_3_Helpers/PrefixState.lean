open Filter
open scoped Topology

section

variable {p : ℕ} {Ei : Fin p → Type u}

/- `prompt_add/` is absent in this workspace, so the statement design is sampled directly from the
existing Chapter 2 and Chapter 14 owners.

This item is `source-facing`: it is about convergence properties of a trajectory generated by the
alternating-minimization update rule. The Chapter 14 trajectory owner
`is_alternating_minimization_trajectory` already packages the primitive initialization and
blockwise minimization data, so this file should build its convergence statements on that owner
rather than restating those clauses.

Domain sampling against the local project identifies the relevant canonical owners:
- `LowerSemicontinuous` and `ContinuousOn F (effective_domain F)` for closedness and continuity on
  the effective domain;
- `alternating_minimization_argmin` and `is_alternating_minimization_trajectory` for the Chapter
  14 fixed-base block subproblems and trajectories;
- `is_coordinatewise_minimum` for the coordinatewise optimality conclusion;
- the Chapter 2 bounded-real-sublevel hypothesis
  `∀ α : ℝ, Bornology.IsBounded {x | F x ≤ (α : EReal)}` together with
  `MapClusterPt _ Filter.atTop _` for boundedness and sequential limit points.

These owners live on the topological/pseudometric layer already used in Chapter 2 and
Lemma 14.1, so no additive or normed structure belongs in the public context of this file. -/

section

variable [∀ i, PseudoMetricSpace (Ei i)]

/-- Helper for Theorem 14.3: the `n`-th Gauss-Seidel prefix state uses the next iterate in blocks
with index `< n` and the old iterate in the remaining blocks. -/
abbrev alternating_minimization_prefix_state
    (x : ℕ → (i : Fin p) → Ei i) (k n : ℕ) : (i : Fin p) → Ei i :=
  fun j ↦ if j.1 < n then x (k + 1) j else x k j

omit [∀ i, PseudoMetricSpace (Ei i)] in
/-- Helper for Theorem 14.3: the initial prefix state is the current outer iterate. -/
@[simp] theorem alternating_minimization_prefix_state_zero
    (x : ℕ → (i : Fin p) → Ei i) (k : ℕ) :
    alternating_minimization_prefix_state x k 0 = x k := by
  funext j
  simp [alternating_minimization_prefix_state]

omit [∀ i, PseudoMetricSpace (Ei i)] in
/-- Helper for Theorem 14.3: the terminal prefix state is the next outer iterate. -/
@[simp] theorem alternating_minimization_prefix_state_last
    (x : ℕ → (i : Fin p) → Ei i) (k : ℕ) :
    alternating_minimization_prefix_state x k p = x (k + 1) := by
  funext j
  simp [alternating_minimization_prefix_state, j.2]

omit [∀ i, PseudoMetricSpace (Ei i)] in
/-- Helper for Theorem 14.3: the stage-`i` prefix state is the Algorithm 14.1 mixed state with the
old block value inserted at the active block. -/
theorem alternating_minimization_prefix_state_old_eq_partial_state
    (x : ℕ → (i : Fin p) → Ei i) (k : ℕ) (i : Fin p) :
    alternating_minimization_prefix_state x k i.1 =
      alternating_minimization_partial_state (x k) (x (k + 1)) i (x k i) := by
  funext j
  by_cases hj : j.1 < i.1
  · simp [alternating_minimization_prefix_state, alternating_minimization_partial_state, hj]
  · by_cases hji : j = i
    · subst hji
      simp [alternating_minimization_prefix_state, alternating_minimization_partial_state,
        Function.update]
    · simp [alternating_minimization_prefix_state, alternating_minimization_partial_state, hj,
        Function.update, hji]

omit [∀ i, PseudoMetricSpace (Ei i)] in
/-- Helper for Theorem 14.3: the stage-`i+1` prefix state is the Algorithm 14.1 mixed state with
the new minimizing block value inserted at the active block. -/
theorem alternating_minimization_prefix_state_new_eq_partial_state
    (x : ℕ → (i : Fin p) → Ei i) (k : ℕ) (i : Fin p) :
    alternating_minimization_prefix_state x k (i.1 + 1) =
      alternating_minimization_partial_state (x k) (x (k + 1)) i (x (k + 1) i) := by
  funext j
  by_cases hj : j.1 < i.1
  · simp [alternating_minimization_prefix_state, alternating_minimization_partial_state, hj,
      Nat.lt_succ_of_lt hj]
  · by_cases hji : j = i
    · subst hji
      simp [alternating_minimization_prefix_state, alternating_minimization_partial_state,
        Function.update]
    · have hnot : ¬ j.1 < i.1 + 1 := by
        intro hj_succ
        have hij : i.1 ≤ j.1 := Nat.le_of_not_lt hj
        have hji_le : j.1 ≤ i.1 := Nat.lt_succ_iff.mp hj_succ
        exact hji (Fin.ext (le_antisymm hji_le hij))
      simp [alternating_minimization_prefix_state, alternating_minimization_partial_state, hj,
        hji, hnot, Function.update]

omit [∀ i, PseudoMetricSpace (Ei i)] in
/-- Helper for Theorem 14.3: every prefix state produced during one outer iteration stays in the
effective domain and never raises the objective above the current iterate. -/
theorem alternating_minimization_prefix_state_mem_effective_domain_and_le
    (F : ((i : Fin p) → Ei i) → EReal)
    (x : ℕ → (i : Fin p) → Ei i)
    (htraj : is_alternating_minimization_trajectory F x) :
    ∀ k : ℕ, x k ∈ effective_domain F →
      ∀ n ≤ p,
        alternating_minimization_prefix_state x k n ∈ effective_domain F ∧
          F (alternating_minimization_prefix_state x k n) ≤ F (x k) := by
  intro k hxk n hn
  induction n with
  | zero =>
      constructor
      · simpa using hxk
      · simp
  | succ n ihn =>
      have hn_lt : n < p := Nat.lt_of_succ_le hn
      let i : Fin p := ⟨n, hn_lt⟩
      have hold := ihn (Nat.le_of_lt hn_lt)
      rcases hold with ⟨hold_dom, hold_le⟩
      have hold_old_dom :
          alternating_minimization_partial_state (x k) (x (k + 1)) i (x k i) ∈
            effective_domain F := by
        rw [← alternating_minimization_prefix_state_old_eq_partial_state x k i]
        exact hold_dom
      have hstep_compare :
          F (alternating_minimization_partial_state (x k) (x (k + 1)) i (x (k + 1) i)) ≤
            F (alternating_minimization_partial_state (x k) (x (k + 1)) i (x k i)) := by
        simpa [alternating_minimization_block_objective_apply] using
          (isMinOn_iff.mp (is_alternating_minimization_trajectory_step htraj k i))
            (x k i) (by simp)
      have hnew_dom :
          alternating_minimization_partial_state (x k) (x (k + 1)) i (x (k + 1) i) ∈
            effective_domain F := by
        exact mem_effective_domain.mpr <|
          lt_of_le_of_lt hstep_compare (mem_effective_domain.mp hold_old_dom)
      have hold_old_le :
          F (alternating_minimization_partial_state (x k) (x (k + 1)) i (x k i)) ≤ F (x k) := by
        rw [← alternating_minimization_prefix_state_old_eq_partial_state x k i]
        exact hold_le
      have hnew_le :
          F (alternating_minimization_partial_state (x k) (x (k + 1)) i (x (k + 1) i)) ≤
            F (x k) :=
        le_trans hstep_compare hold_old_le
      rw [alternating_minimization_prefix_state_new_eq_partial_state x k i]
      exact ⟨hnew_dom, hnew_le⟩

omit [∀ i, PseudoMetricSpace (Ei i)] in
/-- Helper for Theorem 14.3: every outer iterate of an alternating-minimization trajectory remains
in the effective domain. -/
theorem alternating_minimization_iterate_mem_effective_domain
    (F : ((i : Fin p) → Ei i) → EReal)
    (x : ℕ → (i : Fin p) → Ei i)
    (htraj : is_alternating_minimization_trajectory F x) :
    ∀ k : ℕ, x k ∈ effective_domain F := by
  intro k
  induction k with
  | zero =>
      simpa using is_alternating_minimization_trajectory_zero htraj
  | succ k ih =>
      simpa using
        (alternating_minimization_prefix_state_mem_effective_domain_and_le
          F x htraj k ih p (le_rfl : p ≤ p)).1

omit [∀ i, PseudoMetricSpace (Ei i)] in
/-- Helper for Theorem 14.3: one outer alternating-minimization step never increases the
objective. -/
theorem alternating_minimization_objective_nonincreasing
    (F : ((i : Fin p) → Ei i) → EReal)
    (x : ℕ → (i : Fin p) → Ei i)
    (htraj : is_alternating_minimization_trajectory F x) (k : ℕ) :
    F (x (k + 1)) ≤ F (x k) := by
  simpa using
    (alternating_minimization_prefix_state_mem_effective_domain_and_le
      F x htraj k
      (alternating_minimization_iterate_mem_effective_domain F x htraj k)
      p (le_rfl : p ≤ p)).2

omit [∀ i, PseudoMetricSpace (Ei i)] in
/-- Helper for Theorem 14.3: every trajectory objective value is bounded above by the initial
objective value. -/
theorem alternating_minimization_objective_le_initial
    (F : ((i : Fin p) → Ei i) → EReal)
    (x : ℕ → (i : Fin p) → Ei i)
    (htraj : is_alternating_minimization_trajectory F x) :
    ∀ k : ℕ, F (x k) ≤ F (x 0) := by
  intro k
  induction k with
  | zero =>
      exact le_rfl
  | succ k ih =>
      exact le_trans
        (alternating_minimization_objective_nonincreasing F x htraj k)
        ih

end

end

section

variable {p : ℕ} {Ei : Fin p → Type u}

section

variable [∀ i, PseudoMetricSpace (Ei i)]

/-- Corollary of Theorem 14.3: under the theorem hypotheses, bounded real sublevel sets keep the
alternating-minimization trajectory in a bounded subset of the ambient product space. -/
theorem alternating_minimization_trajectory_range_bounded
    (F : ((i : Fin p) → Ei i) → EReal)
    (x : ℕ → (i : Fin p) → Ei i)
    (hlevel : ∀ α : ℝ, Bornology.IsBounded {x | F x ≤ (α : EReal)})
    (htraj : is_alternating_minimization_trajectory F x) :
    Bornology.IsBounded (Set.range x) := by
  let prove :
      ∀ {p : ℕ} {Ei : Fin p → Type u},
        [∀ i, PseudoMetricSpace (Ei i)] →
        ∀ (F : ((i : Fin p) → Ei i) → EReal)
          (x : ℕ → (i : Fin p) → Ei i)
          (hlevel : ∀ α : ℝ, Bornology.IsBounded {x | F x ≤ (α : EReal)})
          (htraj : is_alternating_minimization_trajectory F x),
          Bornology.IsBounded (Set.range x) := by
    intro p Ei _ F x hlevel htraj
    have hx0_dom : x 0 ∈ effective_domain F :=
      is_alternating_minimization_trajectory_zero htraj
    have hx0_top : F (x 0) ≠ ⊤ := (mem_effective_domain.mp hx0_dom).ne
    refine (hlevel (F (x 0)).toReal).subset ?_
    rintro _ ⟨k, rfl⟩
    exact le_trans
      (alternating_minimization_objective_le_initial F x htraj k)
      (EReal.le_coe_toReal hx0_top)
  exact prove F x hlevel htraj

section

variable [ProperSpace ((i : Fin p) → Ei i)]

omit [∀ i, PseudoMetricSpace (Ei i)] [ProperSpace ((i : Fin p) → Ei i)] in
/-- Helper for Theorem 14.3: rewriting the mixed state against the stage-`i` prefix state turns
the varying-block trajectory slice into a fixed-base `Function.update`. -/
theorem alternating_minimization_partial_state_eq_update_prefix_state
    (x : ℕ → (i : Fin p) → Ei i) (k : ℕ) (i : Fin p) (yi : Ei i) :
    alternating_minimization_partial_state (x k) (x (k + 1)) i yi =
      Function.update (alternating_minimization_prefix_state x k i.1) i yi := by
  funext j
  by_cases hji : j = i
  · subst hji
    simp [alternating_minimization_partial_state, Function.update]
  · by_cases hj : j.1 < i.1
    · simp [alternating_minimization_partial_state, alternating_minimization_prefix_state, hj, hji,
        Function.update]
    · simp [alternating_minimization_partial_state, alternating_minimization_prefix_state, hj, hji,
        Function.update]

omit [∀ i, PseudoMetricSpace (Ei i)] [ProperSpace ((i : Fin p) → Ei i)] in
/-- Helper for Theorem 14.3: off the active block, the stage-`i` and stage-`i+1` prefix states
coincide. -/
theorem alternating_minimization_prefix_state_succ_eq_of_ne
    (x : ℕ → (i : Fin p) → Ei i) (k : ℕ) (i j : Fin p) (hji : j ≠ i) :
    alternating_minimization_prefix_state x k (i.1 + 1) j =
      alternating_minimization_prefix_state x k i.1 j := by
  by_cases hj : j.1 < i.1
  · simp [alternating_minimization_prefix_state, hj, Nat.lt_succ_of_lt hj]
  · have hnot : ¬ j.1 < i.1 + 1 := by
      intro hj_succ
      have hij : i.1 ≤ j.1 := Nat.le_of_not_lt hj
      have hji_le : j.1 ≤ i.1 := Nat.lt_succ_iff.mp hj_succ
      exact hji (Fin.ext (le_antisymm hji_le hij))
    simp [alternating_minimization_prefix_state, hj, hnot]

omit [∀ i, PseudoMetricSpace (Ei i)] [ProperSpace ((i : Fin p) → Ei i)] in
/-- Helper for Theorem 14.3: once the stage index reaches `p`, every prefix state has already
stabilized to the next outer iterate. -/
theorem alternating_minimization_prefix_state_eq_next_iterate_of_ge
    (x : ℕ → (i : Fin p) → Ei i) (k n : ℕ) (hn : p ≤ n) :
    alternating_minimization_prefix_state x k n = x (k + 1) := by
  funext j
  have hjn : j.1 < n := lt_of_lt_of_le j.2 hn
  simp [alternating_minimization_prefix_state, hjn]

omit [ProperSpace ((i : Fin p) → Ei i)] in
/-- Helper for Theorem 14.3: if the stage-`i` and stage-`i+1` prefix states converge, then the
limit of the latter is topologically indistinguishable from updating the stage-`i` limit only in
block `i`. -/
theorem alternating_minimization_prefix_state_limit_inseparable_update
    (x : ℕ → (i : Fin p) → Ei i) (ψ : ℕ → ℕ) (i : Fin p)
    {xBar y : (j : Fin p) → Ei j}
    (hstage :
      Tendsto (fun m ↦ alternating_minimization_prefix_state x (ψ m) i.1) atTop (𝓝 xBar))
    (hnext :
      Tendsto (fun m ↦ alternating_minimization_prefix_state x (ψ m) (i.1 + 1)) atTop (𝓝 y)) :
    Inseparable y (Function.update xBar i (y i)) := by
  have hlimit_update :
      Tendsto (fun m ↦ alternating_minimization_prefix_state x (ψ m) (i.1 + 1))
        atTop
        (𝓝 (Function.update xBar i (y i))) := by
    rw [tendsto_pi_nhds]
    intro j
    by_cases hji : j = i
    · subst j
      simpa [Function.update] using (continuous_apply i).tendsto y |>.comp hnext
    · have hstage_j :
          Tendsto (fun m ↦ alternating_minimization_prefix_state x (ψ m) i.1 j)
            atTop
            (𝓝 (xBar j)) :=
        (continuous_apply j).tendsto xBar |>.comp hstage
      have heq :
          (fun m ↦ alternating_minimization_prefix_state x (ψ m) (i.1 + 1) j) =
            fun m ↦ alternating_minimization_prefix_state x (ψ m) i.1 j := by
        funext m
        exact alternating_minimization_prefix_state_succ_eq_of_ne x (ψ m) i j hji
      have hsame :
          Tendsto (fun m ↦ alternating_minimization_prefix_state x (ψ m) (i.1 + 1) j)
            atTop
            (𝓝 (xBar j)) := by
        simpa [heq] using hstage_j
      simpa [Function.update, hji] using hsame
  exact tendsto_nhds_unique_inseparable hnext hlimit_update

omit [ProperSpace ((i : Fin p) → Ei i)] in
/-- Helper for Theorem 14.3: the stronger equality conclusion would follow from the previous
inseparability statement if the coordinate spaces were `T0`/Hausdorff. -/
theorem alternating_minimization_prefix_state_limit_eq_update
    (x : ℕ → (i : Fin p) → Ei i) (ψ : ℕ → ℕ) (i : Fin p)
    [T0Space ((j : Fin p) → Ei j)]
    {xBar y : (j : Fin p) → Ei j}
    (hstage :
      Tendsto (fun m ↦ alternating_minimization_prefix_state x (ψ m) i.1) atTop (𝓝 xBar))
    (hnext :
      Tendsto (fun m ↦ alternating_minimization_prefix_state x (ψ m) (i.1 + 1)) atTop (𝓝 y)) :
    y = Function.update xBar i (y i) := by
  exact Inseparable.eq <|
    alternating_minimization_prefix_state_limit_inseparable_update x ψ i hstage hnext

/-- Helper for Theorem 14.3: the initial real sublevel set containing the trajectory is compact in
the ambient proper product space. -/
lemma alternating_minimization_initial_sublevel_compact
    (F : ((i : Fin p) → Ei i) → EReal)
    (x : ℕ → (i : Fin p) → Ei i)
    (hclosed : LowerSemicontinuous F)
    (hlevel : ∀ α : ℝ, Bornology.IsBounded {z | F z ≤ (α : EReal)})
    (htraj : is_alternating_minimization_trajectory F x) :
    IsCompact {z | F z ≤ (((F (x 0)).toReal : ℝ) : EReal)} := by
  have hx0_dom : x 0 ∈ effective_domain F :=
    is_alternating_minimization_trajectory_zero htraj
  have hx0_top : F (x 0) ≠ ⊤ := (mem_effective_domain.mp hx0_dom).ne
  have hsublevel_closed :
      IsClosed {z | F z ≤ (((F (x 0)).toReal : ℝ) : EReal)} := by
    simpa using hclosed.isClosed_preimage ((((F (x 0)).toReal : ℝ) : EReal))
  have hsublevel_bounded :
      Bornology.IsBounded {z | F z ≤ (((F (x 0)).toReal : ℝ) : EReal)} := by
    simpa using hlevel ((F (x 0)).toReal)
  exact Metric.isCompact_of_isClosed_isBounded hsublevel_closed hsublevel_bounded

omit [∀ i, PseudoMetricSpace (Ei i)] [ProperSpace ((i : Fin p) → Ei i)] in
/-- Helper for Theorem 14.3: every intermediate prefix state lies in the initial real sublevel. -/
lemma alternating_minimization_prefix_state_mem_initial_sublevel
    (F : ((i : Fin p) → Ei i) → EReal)
    (x : ℕ → (i : Fin p) → Ei i)
    (htraj : is_alternating_minimization_trajectory F x)
    (k n : ℕ) (hn : n ≤ p) :
    alternating_minimization_prefix_state x k n ∈
      {z | F z ≤ (((F (x 0)).toReal : ℝ) : EReal)} := by
  have hxk_dom : x k ∈ effective_domain F :=
    alternating_minimization_iterate_mem_effective_domain F x htraj k
  have hx0_dom : x 0 ∈ effective_domain F :=
    is_alternating_minimization_trajectory_zero htraj
  have hx0_top : F (x 0) ≠ ⊤ := (mem_effective_domain.mp hx0_dom).ne
  have hprefix_le :
      F (alternating_minimization_prefix_state x k n) ≤ F (x k) :=
    (alternating_minimization_prefix_state_mem_effective_domain_and_le
      F x htraj k hxk_dom n hn).2
  calc
    F (alternating_minimization_prefix_state x k n) ≤ F (x k) := hprefix_le
    _ ≤ F (x 0) := alternating_minimization_objective_le_initial F x htraj k
    _ ≤ (((F (x 0)).toReal : ℝ) : EReal) := EReal.le_coe_toReal hx0_top

omit [∀ i, PseudoMetricSpace (Ei i)] [ProperSpace ((i : Fin p) → Ei i)] in
/-- Helper for Theorem 14.3: each one-block update minimizes `F` on the initial-sublevel fiber
over the current stage-`i` prefix state. -/
lemma alternating_minimization_step_isMinOn_initial_sublevel_fiber
    (F : ((i : Fin p) → Ei i) → EReal)
    (x : ℕ → (i : Fin p) → Ei i)
    (htraj : is_alternating_minimization_trajectory F x)
    (k : ℕ) (i : Fin p) :
    IsMinOn F
      {u |
        u ∈ {z | F z ≤ (((F (x 0)).toReal : ℝ) : EReal)} ∧
          u = Function.update (alternating_minimization_prefix_state x k i.1) i (u i)}
      (alternating_minimization_prefix_state x k (i.1 + 1)) := by
  rw [isMinOn_iff]
  intro u hu
  rcases hu with ⟨_, hu_update⟩
  have hstep :=
    (isMinOn_iff.mp (is_alternating_minimization_trajectory_step htraj k i))
      (u i) (by simp)
  have hstep' :
      F (alternating_minimization_prefix_state x k (i.1 + 1)) ≤
        F (Function.update (alternating_minimization_prefix_state x k i.1) i (u i)) := by
    simpa [alternating_minimization_prefix_state_new_eq_partial_state,
      alternating_minimization_partial_state_eq_update_prefix_state,
      alternating_minimization_block_objective_apply] using hstep
  calc
    F (alternating_minimization_prefix_state x k (i.1 + 1)) ≤
        F (Function.update (alternating_minimization_prefix_state x k i.1) i (u i)) := hstep'
    _ = F u := by simpa using congrArg F hu_update.symm

omit [ProperSpace ((i : Fin p) → Ei i)] in
/-- Helper for Theorem 14.3: continuity on the effective domain turns a convergent domain-valued
sequence into convergence of objective values. -/
theorem alternating_minimization_tendsto_objective_of_tendsto
    (F : ((i : Fin p) → Ei i) → EReal)
    (hcont : ContinuousOn F (effective_domain F))
    {u : ℕ → (i : Fin p) → Ei i} {xBar : (i : Fin p) → Ei i}
    (hxBar : xBar ∈ effective_domain F)
    (hu : Tendsto u atTop (𝓝 xBar))
    (hu_dom : ∀ n, u n ∈ effective_domain F) :
    Tendsto (fun n ↦ F (u n)) atTop (𝓝 (F xBar)) := by
  have hu_within : Tendsto u atTop (𝓝[effective_domain F] xBar) := by
    rw [tendsto_nhdsWithin_iff]
    exact ⟨hu, Filter.Eventually.of_forall hu_dom⟩
  exact (hcont xBar hxBar).tendsto.comp hu_within

omit [∀ i, PseudoMetricSpace (Ei i)] [ProperSpace ((i : Fin p) → Ei i)] in
/-- Helper for Theorem 14.3: each single block update during an outer iteration decreases the
prefix-state objective. -/
theorem alternating_minimization_prefix_state_succ_objective_le
    (F : ((i : Fin p) → Ei i) → EReal)
    (x : ℕ → (i : Fin p) → Ei i)
    (htraj : is_alternating_minimization_trajectory F x)
    (k n : ℕ) (hn : n < p) :
    F (alternating_minimization_prefix_state x k (n + 1)) ≤
      F (alternating_minimization_prefix_state x k n) := by
  let i : Fin p := ⟨n, hn⟩
  rw [alternating_minimization_prefix_state_new_eq_partial_state x k i,
    alternating_minimization_prefix_state_old_eq_partial_state x k i]
  exact
    (isMinOn_iff.mp (is_alternating_minimization_trajectory_step htraj k i))
      (x k i) (by simp)

omit [∀ i, PseudoMetricSpace (Ei i)] [ProperSpace ((i : Fin p) → Ei i)] in
/-- Helper for Theorem 14.3: the prefix-state objective is antitone in the stage index and becomes
constant after stage `p`. -/
theorem alternating_minimization_prefix_state_objective_antitone
    (F : ((i : Fin p) → Ei i) → EReal)
    (x : ℕ → (i : Fin p) → Ei i)
    (htraj : is_alternating_minimization_trajectory F x)
    (k : ℕ) :
    Antitone fun n ↦ F (alternating_minimization_prefix_state x k n) := by
  refine antitone_nat_of_succ_le ?_
  intro n
  by_cases hn : n < p
  · exact alternating_minimization_prefix_state_succ_objective_le F x htraj k n hn
  · have hn_ge : p ≤ n := Nat.le_of_not_lt hn
    have hstate_n :
        alternating_minimization_prefix_state x k n = x (k + 1) :=
      alternating_minimization_prefix_state_eq_next_iterate_of_ge x k n hn_ge
    have hstate_succ :
        alternating_minimization_prefix_state x k (n + 1) = x (k + 1) :=
      alternating_minimization_prefix_state_eq_next_iterate_of_ge x k (n + 1)
        (le_trans hn_ge (Nat.le_succ n))
    simp [hstate_n, hstate_succ]

