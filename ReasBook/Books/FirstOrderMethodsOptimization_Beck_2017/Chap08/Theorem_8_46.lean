import FirstOrderMethodsOptimization_Beck_2017.Chap08.Corollary_8_43
import FirstOrderMethodsOptimization_Beck_2017.Chap08.Lemma_8_27
import FirstOrderMethodsOptimization_Beck_2017.Chap08.Lemma_8_45

-- Declarations for this item will be appended below by the statement pipeline.

noncomputable section

universe u

open scoped BigOperators

section

variable {E : Type u} [NormedAddCommGroup E] [NormedSpace ℝ E]
variable {m : ℕ} [NeZero m]
variable {X XStar : Set E} {f : E → ℝ} {g : Fin m → E → ℝ} {fOpt L : ℝ}
variable (xSel : (Fin m → NNReal) → {x // x ∈ X}) (lam0 : Fin m → NNReal)

local notation "Λ" => EuclideanSpace ℝ (Fin m)
local notation "γ" => fun n : ℕ ↦ (1 : ℝ) / Real.sqrt ((n : ℝ) + 1)

local notation "xSeq" =>
  dual_projected_subgradient_primal_iterate X g xSel γ lam0

local notation "constraintSeq" =>
  fun n ↦ dual_projected_subgradient_constraint_vector g (xSeq n : E)

local notation "fullAvg" =>
  dual_projected_subgradient_full_average_iterate (X := X) (g := g) xSel γ lam0

local notation "gVec" => fun x i ↦ g i x

/- Theorem 8.46 is `source-facing`: it gives the `O(log(k) / √k)` ergodic rate for the full
averaging sequence generated by the dual projected subgradient method with the explicit dynamic
stepsizes `γ_k = 1 / √(k + 1)`. The owner abstractions are already present in the Chapter 8 API:
the standing problem class `IsDualProjectedSubgradientProblem`, the generated primal sequence from
`dual_projected_subgradient_primal_iterate`, the repaired full averaging owner
`dual_projected_subgradient_full_average_iterate` from Lemma 8.45, the dual-optimal multiplier
norm bound from Corollary 8.43, and the strict-feasibility margin from Theorem 8.42. The two
textbook inequalities share a single right-hand side and a single Slater ratio
`α = (f xBar - fOpt) / strict_feasibility_margin g xBar`, so the clean main declaration is a
scaled `max` estimate; the two displayed bounds are then recovered by companion projection
lemmas. -/

-- Proof sketch: specialize
-- `dual_projected_subgradient_full_average_gap_le` to the dynamic stepsizes
-- `γ_n = 1 / √(n + 1)` and to `ρ = 2 * ((f xBar - fOpt) / strict_feasibility_margin g xBar)`.
-- Then apply the harmonic-ratio estimate from Lemma 8.27 to the resulting quotient of sums, and
-- use the Slater-point multiplier bound from Corollary 8.43 to convert the penalized estimate
-- into simultaneous control of the objective gap and the scaled positive-part constraint
-- violation.
/-- Helper for Theorem 8.46: the squared dynamic stepsizes form the harmonic prefix sum from
Lemma 8.27. -/
lemma dynamicGammaSqSum_eq_harmonicPrefixSum (k : ℕ) :
    Finset.sum (Finset.range (k + 1)) (fun n ↦ (γ n) ^ (2 : ℕ)) =
      harmonicPrefixSum k := by
  -- Rewrite each squared stepsize as the reciprocal `(n + 1)⁻¹`.
  rw [harmonicPrefixSum_eq_sum]
  refine Finset.sum_congr rfl ?_
  intro n hn
  have hsqrt_ne : Real.sqrt ((n : ℝ) + 1) ≠ 0 := by
    positivity
  rw [show (γ n) = (1 : ℝ) / Real.sqrt ((n : ℝ) + 1) by rfl]
  field_simp [hsqrt_ne]
  nlinarith [Real.sq_sqrt (show 0 ≤ (n : ℝ) + 1 by positivity)]

/-- Helper for Theorem 8.46: the dynamic stepsizes themselves form the inverse-square-root prefix
sum from Lemma 8.27. -/
lemma dynamicGammaSum_eq_inverseSqrtPrefixSum (k : ℕ) :
    Finset.sum (Finset.range (k + 1)) γ = inverseSqrtPrefixSum k := by
  -- This is exactly the named denominator owner from Lemma 8.27.
  rw [inverseSqrtPrefixSum_eq_sum]

/-- Helper for Theorem 8.46: scaling the harmonic-prefix ratio estimate by `L / 2` preserves the
`O(log(k) / √k)` bound for the dynamic stepsize sequence. -/
lemma scaledDynamicRatioLeLogBound
    (hL : 0 ≤ L) (D : ℝ) (hD : 0 ≤ D) (k : ℕ) :
    (L / 2) *
        (D + Finset.sum (Finset.range (k + 1)) (fun n ↦ (γ n) ^ (2 : ℕ))) /
          Finset.sum (Finset.range (k + 1)) γ ≤
      (L / 2) * (D + 1 + Real.log ((k : ℝ) + 1)) / Real.sqrt ((k : ℝ) + 1) := by
  have hratio := harmonic_prefix_ratio_le_log_bound D hD k
  have hLhalf_nonneg : 0 ≤ L / 2 := by
    positivity
  have hscaled :
      (L / 2) * ((D + harmonicPrefixSum k) / inverseSqrtPrefixSum k) ≤
        (L / 2) * ((D + 1 + Real.log ((k : ℝ) + 1)) / Real.sqrt ((k : ℝ) + 1)) :=
    mul_le_mul_of_nonneg_left hratio hLhalf_nonneg
  -- First normalize the sums to the Lemma 8.27 owners, then scale by the nonnegative factor.
  rw [dynamicGammaSqSum_eq_harmonicPrefixSum, dynamicGammaSum_eq_inverseSqrtPrefixSum]
  simpa [div_eq_mul_inv, mul_assoc, mul_left_comm, mul_comm] using hscaled

/-- Helper for Theorem 8.46: on the active full-history branch, the repaired average is the
`centerMass` of the same weights used in the full-window bridge from Lemma 8.45. -/
lemma fullAverage_eq_centerMass_of_activeWindow
    {k : ℕ} (hactive : ∀ n : Fin (k + 1), constraintSeq n ≠ 0) :
    fullAvg k =
      (Finset.Icc 0 k).centerMass
        (fun n ↦ γ n / ‖constraintSeq n‖)
        (fun n ↦ (xSeq n : E)) := by
  have hbridge :
      fullAvg k =
        Finset.sum (Finset.Icc 0 k) fun n ↦
          ((γ n / ‖constraintSeq n‖) /
            Finset.sum (Finset.Icc 0 k) fun j ↦ γ j / ‖constraintSeq j‖) • (xSeq n : E) :=
    fullWindowIndexBridge (X := X) (g := g) xSel γ lam0 hactive
  -- Rewrite `fullAvg k` to the active full-window weighted sum from Lemma 8.45.
  calc
    fullAvg k
        = Finset.sum (Finset.Icc 0 k) fun n ↦
            ((γ n / ‖constraintSeq n‖) /
              Finset.sum (Finset.Icc 0 k) fun j ↦ γ j / ‖constraintSeq j‖) • (xSeq n : E) :=
      hbridge
    _ = (Finset.Icc 0 k).centerMass
          (fun n ↦ γ n / ‖constraintSeq n‖)
          (fun n ↦ (xSeq n : E)) := by
        simpa using
          (activeWindowAverage_eq_centerMass
            (X := X) (g := g) xSel γ lam0 (p := 0) (k := k))

/-- Helper for Theorem 8.46: the repaired full-history average remains in the feasible ambient
set `X`. -/
lemma fullAverage_mem
    (h_problem : IsDualProjectedSubgradientProblem X XStar f g fOpt)
    (h_admissible :
      dual_projected_subgradient_method_is_admissible X f g xSel γ)
    {k : ℕ} :
    fullAvg k ∈ X := by
  by_cases hzero : ∃ n : Fin (k + 1), constraintSeq n = 0
  · -- On the repaired zero branch the full average is the current iterate, which is already in `X`.
    have hcurrent :
        fullAvg k = (xSeq k : E) :=
      dual_projected_subgradient_full_average_iterate_eq_current_of_exists_constraint_eq_zero
        (X := X) (g := g) xSel γ lam0 hzero
    exact hcurrent ▸ (xSeq k).property
  · have hactive : ∀ n : Fin (k + 1), constraintSeq n ≠ 0 := by
      intro n hn
      exact hzero ⟨n, hn⟩
    have hweights_nonneg :
        ∀ n ∈ Finset.Icc 0 k, 0 ≤ γ n / ‖constraintSeq n‖ := by
      intro n hn
      exact div_nonneg
        (le_of_lt (dual_projected_subgradient_method_stepsize_pos
          (X := X) (g := g) xSel γ h_admissible n))
        (norm_nonneg _)
    have hweights_pos :
        0 < ∑ n ∈ Finset.Icc 0 k, γ n / ‖constraintSeq n‖ := by
      have h0_mem : 0 ∈ Finset.Icc 0 k := by simp
      have h0_pos : 0 < γ 0 / ‖constraintSeq 0‖ := by
        exact div_pos
          (dual_projected_subgradient_method_stepsize_pos
            (X := X) (g := g) xSel γ h_admissible 0)
          (norm_pos_iff.mpr (hactive 0))
      have h0_le :
          γ 0 / ‖constraintSeq 0‖ ≤ ∑ n ∈ Finset.Icc 0 k, γ n / ‖constraintSeq n‖ :=
        Finset.single_le_sum (fun n hn ↦ hweights_nonneg n hn) h0_mem
      exact lt_of_lt_of_le h0_pos h0_le
    -- Route correction: move to `centerMass` only for the feasibility proof, then apply convexity of `X`.
    have hcenter :
        fullAvg k =
          (Finset.Icc 0 k).centerMass
            (fun n ↦ γ n / ‖constraintSeq n‖)
            (fun n ↦ (xSeq n : E)) :=
      fullAverage_eq_centerMass_of_activeWindow
        (X := X) (g := g) (xSel := xSel) (lam0 := lam0) hactive
    exact hcenter ▸ h_problem.feasible_convex.centerMass_mem
      hweights_nonneg hweights_pos (fun n hn ↦ (xSeq n).property)

/-- Helper for Theorem 8.46: any feasible dual multiplier pairs with the constraint vector by at
most the Euclidean norm of the positive constraint violation. -/
lemma dualFeasiblePairing_le_positiveConstraintViolation
    {x : E} {lam : Λ} (hLam : lam ∈ dual_problem_feasible_set m) :
    ∑ i, lam i * g i x ≤ ‖lam‖ * positive_constraint_violation gVec x := by
  let posVec : Λ := WithLp.toLp 2 ((gVec x)⁺)
  have hLam_nonneg : ∀ i : Fin m, 0 ≤ lam i := mem_dual_problem_feasible_set.mp hLam
  have hcoord_le :
      ∀ i : Fin m, lam i * g i x ≤ lam i * posVec i := by
    intro i
    have hg_le : g i x ≤ max (g i x) 0 := le_max_left _ _
    have hmul :=
      mul_le_mul_of_nonneg_left hg_le (hLam_nonneg i)
    simpa [posVec] using hmul
  have hsum_le :
      ∑ i, lam i * g i x ≤ ∑ i, lam i * posVec i := by
    exact Finset.sum_le_sum fun i _ ↦ hcoord_le i
  have hinner :
      ∑ i, lam i * posVec i = inner ℝ lam posVec := by
    have hinner' : inner ℝ lam posVec = ∑ i, posVec i * lam i := by
      -- Mathlib's `EuclideanSpace` inner product is indexed in the `y * star x` order.
      simpa [dotProduct, posVec] using
        (EuclideanSpace.inner_eq_star_dotProduct (x := lam) (y := posVec))
    -- Commute the real coordinates once, then rewrite with the canonical inner-product formula.
    calc
      ∑ i, lam i * posVec i = ∑ i, posVec i * lam i := by
          refine Finset.sum_congr rfl ?_
          intro i hi
          ring
      _ = inner ℝ lam posVec := by
          simpa using hinner'.symm
  -- Route correction: isolate the sum-to-inner normalization here so later proofs only use the
  -- clean Euclidean bound against `positive_constraint_violation`.
  calc
    ∑ i, lam i * g i x ≤ ∑ i, lam i * posVec i := hsum_le
    _ = inner ℝ lam posVec := hinner
    _ ≤ ‖lam‖ * ‖posVec‖ := real_inner_le_norm _ _
    _ = ‖lam‖ * positive_constraint_violation gVec x := by
          rw [positive_constraint_violation_def]

/-- Helper for Theorem 8.46: the Slater ratio controls the positive-part constraint violation from
below through any optimal dual multiplier. -/
lemma zero_le_objectiveGap_add_slaterRatio_mul_positiveConstraintViolation
    (h_problem : IsDualProjectedSubgradientProblem X XStar f g fOpt)
    {xBar : E} (hxBar : xBar ∈ X) (hgBar : ∀ i : Fin m, g i xBar < 0)
    {x : E} (hx : x ∈ X) :
    let α := (f xBar - fOpt) / strict_feasibility_margin g xBar
    0 ≤ f x - fOpt + α * positive_constraint_violation gVec x := by
  let α := (f xBar - fOpt) / strict_feasibility_margin g xBar
  obtain ⟨lamStar, hlamStar_feasible, hlamStar_max, hqStar⟩ :=
    existsDualOptimalMultiplier_eq_fOpt
      (X := X) (XStar := XStar) (f := f) (g := g) (fOpt := fOpt) h_problem
  have hq_le_lagE :
      (fOpt : EReal) ≤
        ((lagrangian f (dual_constraint_vector g) lamStar x : ℝ) : EReal) := by
    -- Evaluate the optimal dual value at the feasible witness `x`.
    have hq_le_lag :
        lagrangian_dual_objective X f (dual_constraint_vector g) lamStar ≤
          ((lagrangian f (dual_constraint_vector g) lamStar x : ℝ) : EReal) := by
      rw [lagrangian_dual_objective_eq_sInf]
      exact sInf_le <| Set.mem_image_of_mem
        (fun y : E ↦ ((lagrangian f (dual_constraint_vector g) lamStar y : ℝ) : EReal)) hx
    simpa [hqStar] using hq_le_lag
  have hq_le_lag :
      fOpt ≤ lagrangian f (dual_constraint_vector g) lamStar x := by
    exact_mod_cast hq_le_lagE
  have hpair :
      ∑ i, lamStar i * g i x ≤ ‖lamStar‖ * positive_constraint_violation gVec x :=
    dualFeasiblePairing_le_positiveConstraintViolation
      (g := g) (x := x) hlamStar_feasible
  have hnorm :
      ‖lamStar‖ ≤ α := by
    simpa [α] using
      (norm_le_div_strict_feasibility_margin_of_dual_optimal_multiplier
        (X := X) (XStar := XStar) (f := f) (g := g) (fOpt := fOpt)
        h_problem hxBar hgBar ⟨hlamStar_feasible, hlamStar_max⟩)
  have hviolation_nonneg : 0 ≤ positive_constraint_violation gVec x := by
    simp [positive_constraint_violation_def]
  have hlag :
      fOpt ≤ f x + ∑ i, lamStar i * g i x := by
    simpa [lagrangian_apply, dotProduct] using hq_le_lag
  have hsupport :
      fOpt ≤ f x + α * positive_constraint_violation gVec x := by
    have hscaled :
        ‖lamStar‖ * positive_constraint_violation gVec x ≤
          α * positive_constraint_violation gVec x :=
      mul_le_mul_of_nonneg_right hnorm hviolation_nonneg
    linarith
  -- The optimal dual support inequality is exactly the desired lower bound after rearranging.
  linarith

/-- Helper for Theorem 8.46: the full-history average satisfies the objective-gap
`O(log(k) / √k)` bound for the dynamic stepsize sequence. -/
lemma fullAverageObjectiveGapLeLogOverSqrtBase
    (h_problem : IsDualProjectedSubgradientProblem X XStar f g fOpt)
    (h_admissible :
      dual_projected_subgradient_method_is_admissible X f g xSel γ)
    (h_constraint_bound :
      ∀ x ∈ X, ‖dual_projected_subgradient_constraint_vector g x‖ ≤ L)
    {k : ℕ} (hk : 1 ≤ k) :
    f (fullAvg k) - fOpt ≤
      (L / 2) *
        (‖dual_projected_subgradient_multiplier_vector lam0‖ ^ (2 : ℕ) +
            1 + Real.log ((k : ℝ) + 1)) /
          Real.sqrt ((k : ℝ) + 1) := by
  have hk_nonneg : 0 ≤ k := by omega
  have htail0 : Finset.Icc 0 k = Finset.range (k + 1) := by
    ext n
    simp [Finset.mem_Icc]
  have hL_nonneg : 0 ≤ L := by
    have hbound0 := h_constraint_bound (xSeq 0 : E) (xSeq 0).property
    exact le_trans (norm_nonneg _) hbound0
  by_cases hzero : ∃ n : Fin (k + 1), constraintSeq n = 0
  · rcases hzero with ⟨n, hn⟩
    have hcurrent :
        constraintSeq k = 0 := by
      exact constraintSeqEqZeroOfLeOfConstraintEqZero
        (X := X) (g := g) xSel γ lam0
        (Nat.le_of_lt_succ n.is_lt) hn
    have havg :
        fullAvg k = (xSeq k : E) :=
      dual_projected_subgradient_full_average_iterate_eq_current_of_exists_constraint_eq_zero
        (X := X) (g := g) xSel γ lam0 ⟨n, hn⟩
    have hwindow :
        f (xSeq k : E) - fOpt + 0 * positive_constraint_violation gVec (xSeq k : E) ≤
          (L / 2) *
            ((‖dual_projected_subgradient_multiplier_vector lam0‖ + 0) ^ (2 : ℕ) +
                Finset.sum (Finset.Icc 0 k) (fun n ↦ (γ n) ^ (2 : ℕ))) /
              Finset.sum (Finset.Icc 0 k) γ := by
      exact
        windowPenalizedGapLeOfCurrentConstraintEqZero
          (X := X) (XStar := XStar) (f := f) (g := g) (fOpt := fOpt)
          (L := L) xSel γ lam0
          h_problem h_admissible h_constraint_bound
          hk_nonneg hcurrent 0
    have hbase :
        f (fullAvg k) - fOpt ≤
          (L / 2) *
            (‖dual_projected_subgradient_multiplier_vector lam0‖ ^ (2 : ℕ) +
                Finset.sum (Finset.range (k + 1)) (fun n ↦ (γ n) ^ (2 : ℕ))) /
              Finset.sum (Finset.range (k + 1)) γ := by
      have hwindow' := hwindow
      rw [← havg] at hwindow'
      simpa [htail0, dual_projected_subgradient_method_zero] using hwindow'
    have hscaled :=
      scaledDynamicRatioLeLogBound
        (L := L) hL_nonneg
        (‖dual_projected_subgradient_multiplier_vector lam0‖ ^ (2 : ℕ))
        (sq_nonneg ‖dual_projected_subgradient_multiplier_vector lam0‖) k
    exact le_trans hbase (by simpa using hscaled)
  · have hactive : ∀ n : Fin (k + 1), constraintSeq n ≠ 0 := by
      intro n
      exact fun hn ↦ hzero ⟨n, hn⟩
    have hzeroMultiplier :
        dual_projected_subgradient_multiplier_vector (fun _ ↦ 0 : Fin m → NNReal) = 0 := by
      -- Normalize the zero test multiplier once so the active-window estimate matches the target.
      ext i
      simp [dual_projected_subgradient_multiplier_vector]
    have hwindowRaw :=
      windowGapWithTestMultiplierLeOfActiveWindow
        (X := X) (XStar := XStar) (f := f) (g := g) (fOpt := fOpt)
        (L := L) xSel γ lam0
        h_problem h_admissible h_constraint_bound
        hk_nonneg
        (fun n hn ↦ hactive ⟨n, by simpa [Finset.mem_Icc] using hn⟩)
        (fun _ ↦ 0)
    have hwindow :
        f (Finset.sum (Finset.Icc 0 k) fun n ↦
              ((γ n / ‖constraintSeq n‖) /
                Finset.sum (Finset.Icc 0 k) fun j ↦ γ j / ‖constraintSeq j‖) • (xSeq n : E)) -
            fOpt ≤
          (L / 2) *
            (‖dual_projected_subgradient_multiplier_vector lam0‖ ^ (2 : ℕ) +
                Finset.sum (Finset.Icc 0 k) (fun n ↦ (γ n) ^ (2 : ℕ))) /
              Finset.sum (Finset.Icc 0 k) γ := by
      -- Expose the zero multiplier vector before simplifying the norm term.
      simpa [hzeroMultiplier] using hwindowRaw
    have hbridge :=
      fullWindowIndexBridge
        (X := X) (g := g) xSel γ lam0 hactive
    have hbase :
        f (fullAvg k) - fOpt ≤
          (L / 2) *
            (‖dual_projected_subgradient_multiplier_vector lam0‖ ^ (2 : ℕ) +
                Finset.sum (Finset.range (k + 1)) (fun n ↦ (γ n) ^ (2 : ℕ))) /
              Finset.sum (Finset.range (k + 1)) γ := by
      -- Stay in the weighted-window normal form; only the zero test multiplier is used here.
      have hwindow' := hwindow
      rw [← hbridge] at hwindow'
      simpa [htail0, dual_projected_subgradient_method_zero] using hwindow'
    have hscaled :=
      scaledDynamicRatioLeLogBound
        (L := L) hL_nonneg
        (‖dual_projected_subgradient_multiplier_vector lam0‖ ^ (2 : ℕ))
        (sq_nonneg ‖dual_projected_subgradient_multiplier_vector lam0‖) k
    exact le_trans hbase (by simpa using hscaled)

/-- Helper for Theorem 8.46: the full-history average satisfies the penalized
objective-plus-violation `O(log(k) / √k)` bound with penalty coefficient `2 α`. -/
lemma fullAveragePenalizedGapLeLogOverSqrt
    (h_problem : IsDualProjectedSubgradientProblem X XStar f g fOpt)
    (h_admissible :
      dual_projected_subgradient_method_is_admissible X f g xSel γ)
    (h_constraint_bound :
      ∀ x ∈ X, ‖dual_projected_subgradient_constraint_vector g x‖ ≤ L)
    {xBar : E} (hxBar : xBar ∈ X) (hgBar : ∀ i : Fin m, g i xBar < 0)
    (hAlpha : 0 < (f xBar - fOpt) / strict_feasibility_margin g xBar)
    {k : ℕ} (hk : 1 ≤ k) :
    let α := (f xBar - fOpt) / strict_feasibility_margin g xBar
    f (fullAvg k) - fOpt + 2 * α * positive_constraint_violation gVec (fullAvg k) ≤
      (L / 2) *
        ((‖dual_projected_subgradient_multiplier_vector lam0‖ + 2 * α) ^ (2 : ℕ) +
            1 + Real.log ((k : ℝ) + 1)) /
          Real.sqrt ((k : ℝ) + 1) := by
  dsimp only
  set α : ℝ := (f xBar - fOpt) / strict_feasibility_margin g xBar
  have hρ : 0 < 2 * α := by
    dsimp [α]
    nlinarith
  have hL_nonneg : 0 ≤ L := by
    have hbound0 := h_constraint_bound (xSeq 0 : E) (xSeq 0).property
    exact le_trans (norm_nonneg _) hbound0
  have hscaled :=
    scaledDynamicRatioLeLogBound
      (L := L) hL_nonneg
      ((‖dual_projected_subgradient_multiplier_vector lam0‖ + 2 * α) ^ (2 : ℕ))
      (sq_nonneg (‖dual_projected_subgradient_multiplier_vector lam0‖ + 2 * α)) k
  by_cases hk2 : 2 ≤ k
  · have hgap :=
      show
        f (fullAvg k) - fOpt + 2 * α * positive_constraint_violation gVec (fullAvg k) ≤
          (L / 2) *
            ((‖dual_projected_subgradient_multiplier_vector lam0‖ + 2 * α) ^ (2 : ℕ) +
                Finset.sum (Finset.range (k + 1)) (fun n ↦ (γ n) ^ (2 : ℕ))) /
              Finset.sum (Finset.range (k + 1)) γ by
        exact
          dual_projected_subgradient_full_average_gap_le
            (X := X) (XStar := XStar) (f := f) (g := g) (fOpt := fOpt)
            (L := L) xSel γ lam0
            h_problem h_admissible h_constraint_bound hρ hk2
    exact le_trans hgap (by simpa [α] using hscaled)
  · have hk_eq_one : k = 1 := by
      omega
    have hk_nonneg : 0 ≤ k := by omega
    have htail0 : Finset.Icc 0 k = Finset.range (k + 1) := by
      ext n
      simp [Finset.mem_Icc]
    by_cases hzero : ∃ n : Fin (k + 1), constraintSeq n = 0
    · rcases hzero with ⟨n, hn⟩
      have hcurrent :
          constraintSeq k = 0 := by
        exact constraintSeqEqZeroOfLeOfConstraintEqZero
          (X := X) (g := g) xSel γ lam0
          (Nat.le_of_lt_succ n.is_lt) hn
      have havg :
          fullAvg k = (xSeq k : E) :=
        dual_projected_subgradient_full_average_iterate_eq_current_of_exists_constraint_eq_zero
          (X := X) (g := g) xSel γ lam0 ⟨n, hn⟩
      have hwindow :
          f (xSeq k : E) - fOpt + 2 * α * positive_constraint_violation gVec (xSeq k : E) ≤
            (L / 2) *
              ((‖dual_projected_subgradient_multiplier_vector lam0‖ + 2 * α) ^ (2 : ℕ) +
                  Finset.sum (Finset.Icc 0 k) (fun n ↦ (γ n) ^ (2 : ℕ))) /
                Finset.sum (Finset.Icc 0 k) γ := by
        exact
          windowPenalizedGapLeOfCurrentConstraintEqZero
            (X := X) (XStar := XStar) (f := f) (g := g) (fOpt := fOpt)
            (L := L) xSel γ lam0
            h_problem h_admissible h_constraint_bound
            hk_nonneg hcurrent (2 * α)
      have hbase :
          f (fullAvg k) - fOpt + 2 * α * positive_constraint_violation gVec (fullAvg k) ≤
            (L / 2) *
              ((‖dual_projected_subgradient_multiplier_vector lam0‖ + 2 * α) ^ (2 : ℕ) +
                  Finset.sum (Finset.range (k + 1)) (fun n ↦ (γ n) ^ (2 : ℕ))) /
                Finset.sum (Finset.range (k + 1)) γ := by
        have hwindow' := hwindow
        rw [← havg] at hwindow'
        simpa [α, htail0, dual_projected_subgradient_method_zero] using hwindow'
      exact le_trans hbase (by simpa [α] using hscaled)
    · have hactive : ∀ n : Fin (k + 1), constraintSeq n ≠ 0 := by
        intro n
        exact fun hn ↦ hzero ⟨n, hn⟩
      have hwindow :
          f (Finset.sum (Finset.Icc 0 k) fun n ↦
                ((γ n / ‖constraintSeq n‖) /
                  Finset.sum (Finset.Icc 0 k) fun j ↦ γ j / ‖constraintSeq j‖) • (xSeq n : E)) -
              fOpt +
              2 * α *
                positive_constraint_violation gVec
                  (Finset.sum (Finset.Icc 0 k) fun n ↦
                    ((γ n / ‖constraintSeq n‖) /
                      Finset.sum (Finset.Icc 0 k) fun j ↦ γ j / ‖constraintSeq j‖) •
                        (xSeq n : E)) ≤
            (L / 2) *
              ((‖dual_projected_subgradient_multiplier_vector lam0‖ + 2 * α) ^ (2 : ℕ) +
                  Finset.sum (Finset.Icc 0 k) (fun n ↦ (γ n) ^ (2 : ℕ))) /
                Finset.sum (Finset.Icc 0 k) γ := by
        simpa using
          (windowPenalizedGapLeOfActiveWindow
            (X := X) (XStar := XStar) (f := f) (g := g) (fOpt := fOpt)
            (L := L) xSel γ lam0
            h_problem h_admissible h_constraint_bound
            hk_nonneg hρ
            (fun n hn ↦ hactive ⟨n, by simpa [Finset.mem_Icc] using hn⟩))
      have hbridge :=
        fullWindowIndexBridge
          (X := X) (g := g) xSel γ lam0 hactive
      have hbase :
          f (fullAvg k) - fOpt + 2 * α * positive_constraint_violation gVec (fullAvg k) ≤
            (L / 2) *
              ((‖dual_projected_subgradient_multiplier_vector lam0‖ + 2 * α) ^ (2 : ℕ) +
                  Finset.sum (Finset.range (k + 1)) (fun n ↦ (γ n) ^ (2 : ℕ))) /
                Finset.sum (Finset.range (k + 1)) γ := by
        -- For `k = 1`, keep the repaired average in the same full-window normal form as Lemma 8.45.
        have hwindow' := hwindow
        rw [← hbridge] at hwindow'
        simpa [α, htail0, dual_projected_subgradient_method_zero] using hwindow'
      exact le_trans hbase (by simpa [α] using hscaled)

/-- Theorem 8.46: under Assumption 8.41, if `‖g x‖ ≤ L` on `X` and `xBar` is a strict feasible
point, then the full-history averaged iterate generated by the dual projected subgradient method
with stepsizes `γ_k = 1 / √(k + 1)` satisfies the `O(log(k) / √k)` bound on the maximum of the
objective gap and the Slater-scaled positive-part constraint violation. -/
theorem dual_projected_subgradient_full_average_rate_max_le_log_over_sqrt
    (h_problem : IsDualProjectedSubgradientProblem X XStar f g fOpt)
    (h_admissible :
      dual_projected_subgradient_method_is_admissible X f g xSel γ)
    (h_constraint_bound :
      ∀ x ∈ X, ‖dual_projected_subgradient_constraint_vector g x‖ ≤ L)
    {xBar : E} (hxBar : xBar ∈ X) (hgBar : ∀ i : Fin m, g i xBar < 0)
    {k : ℕ} (hk : 1 ≤ k) :
    let α := (f xBar - fOpt) / strict_feasibility_margin g xBar
    let rhs :=
      (L / 2) *
        ((‖dual_projected_subgradient_multiplier_vector lam0‖ + 2 * α) ^ (2 : ℕ) +
            1 + Real.log ((k : ℝ) + 1)) /
          Real.sqrt ((k : ℝ) + 1)
    max
        (f (fullAvg k) - fOpt)
        (α * positive_constraint_violation gVec (fullAvg k)) ≤
      rhs := by
  dsimp only
  set α : ℝ := (f xBar - fOpt) / strict_feasibility_margin g xBar
  set rhs : ℝ :=
    (L / 2) *
      ((‖dual_projected_subgradient_multiplier_vector lam0‖ + 2 * α) ^ (2 : ℕ) +
          1 + Real.log ((k : ℝ) + 1)) /
        Real.sqrt ((k : ℝ) + 1)
  have hmargin_pos : 0 < strict_feasibility_margin g xBar :=
    strict_feasibility_margin_pos (g := g) hgBar
  have hxBar_feasible : xBar ∈ dual_projected_subgradient_feasible_set X g := by
    exact (mem_dual_projected_subgradient_feasible_set).2
      ⟨hxBar, fun i ↦ le_of_lt (hgBar i)⟩
  have hfOpt_le_fxBar : fOpt ≤ f xBar := by
    exact h_problem.optimal_value_isGLB.1 <| Set.mem_image_of_mem f hxBar_feasible
  have hAlpha_nonneg : 0 ≤ α := by
    dsimp [α]
    exact div_nonneg (sub_nonneg.mpr hfOpt_le_fxBar) (le_of_lt hmargin_pos)
  have hL_nonneg : 0 ≤ L := by
    have hbound0 := h_constraint_bound (xSeq 0 : E) (xSeq 0).property
    exact le_trans (norm_nonneg _) hbound0
  by_cases hAlpha0 : α = 0
  · have hobj :=
      fullAverageObjectiveGapLeLogOverSqrtBase
        (X := X) (XStar := XStar) (f := f) (g := g) (fOpt := fOpt) (L := L)
        (xSel := xSel) (lam0 := lam0)
        h_problem h_admissible h_constraint_bound hk
    have hrhs_nonneg : 0 ≤ rhs := by
      -- The objective-only branch still needs the common right-hand side to be nonnegative.
      have hnum_nonneg :
          0 ≤
            (‖dual_projected_subgradient_multiplier_vector lam0‖ + 2 * α) ^ (2 : ℕ) +
              1 + Real.log ((k : ℝ) + 1) := by
        rw [hAlpha0]
        have hlog_nonneg : 0 ≤ Real.log ((k : ℝ) + 1) := by
          have hk_real : 1 ≤ (k : ℝ) + 1 := by
            nlinarith
          exact Real.log_nonneg hk_real
        nlinarith
      have hsqrt_pos : 0 < Real.sqrt ((k : ℝ) + 1) := by
        positivity
      exact div_nonneg (mul_nonneg (by positivity) hnum_nonneg) (le_of_lt hsqrt_pos)
    have hobj' : f (fullAvg k) - fOpt ≤ rhs := by
      simpa [rhs, hAlpha0] using hobj
    rw [hAlpha0]
    exact max_le_iff.mpr ⟨hobj', by simpa using hrhs_nonneg⟩
  · have hAlpha : 0 < α := lt_of_le_of_ne hAlpha_nonneg (by simpa [eq_comm] using hAlpha0)
    have hpen :=
      fullAveragePenalizedGapLeLogOverSqrt
        (X := X) (XStar := XStar) (f := f) (g := g) (fOpt := fOpt) (L := L)
        (xSel := xSel) (lam0 := lam0)
        h_problem h_admissible h_constraint_bound hxBar hgBar
        (by simpa [α] using hAlpha) hk
    have hmem :=
      fullAverage_mem
        (X := X) (XStar := XStar) (f := f) (g := g) (fOpt := fOpt)
        (xSel := xSel) (lam0 := lam0) h_problem h_admissible (k := k)
    have hsupport :=
      zero_le_objectiveGap_add_slaterRatio_mul_positiveConstraintViolation
        (X := X) (XStar := XStar) (f := f) (g := g) (fOpt := fOpt)
        h_problem hxBar hgBar hmem
    have hviolation_nonneg :
        0 ≤ positive_constraint_violation gVec (fullAvg k) := by
      simp [positive_constraint_violation_def]
    have hobj :
        f (fullAvg k) - fOpt ≤ rhs := by
      have hpenalty_nonneg :
          0 ≤ 2 * α * positive_constraint_violation gVec (fullAvg k) := by
        nlinarith
      linarith [show
        f (fullAvg k) - fOpt + 2 * α * positive_constraint_violation gVec (fullAvg k) ≤ rhs by
          simpa [rhs] using hpen]
    have hviol :
        α * positive_constraint_violation gVec (fullAvg k) ≤ rhs := by
      linarith [show
        f (fullAvg k) - fOpt + 2 * α * positive_constraint_violation gVec (fullAvg k) ≤ rhs by
          simpa [rhs] using hpen,
        show
          0 ≤ f (fullAvg k) - fOpt + α * positive_constraint_violation gVec (fullAvg k) by
            simpa [α] using hsupport]
    exact max_le_iff.mpr ⟨hobj, hviol⟩

-- Proof sketch: apply `le_max_left` to
-- `dual_projected_subgradient_full_average_rate_max_le_log_over_sqrt`.
/-- The full-history averaged iterate satisfies the objective-gap half of the
`O(log(k) / √k)` rate bound. -/
theorem dual_projected_subgradient_full_average_objective_gap_le_log_over_sqrt
    (h_problem : IsDualProjectedSubgradientProblem X XStar f g fOpt)
    (h_admissible :
      dual_projected_subgradient_method_is_admissible X f g xSel γ)
    (h_constraint_bound :
      ∀ x ∈ X, ‖dual_projected_subgradient_constraint_vector g x‖ ≤ L)
    {xBar : E} (hxBar : xBar ∈ X) (hgBar : ∀ i : Fin m, g i xBar < 0)
    {k : ℕ} (hk : 1 ≤ k) :
    f (fullAvg k) - fOpt ≤
      (L / 2) *
        ((‖dual_projected_subgradient_multiplier_vector lam0‖ +
              2 * ((f xBar - fOpt) / strict_feasibility_margin g xBar)) ^ (2 : ℕ) +
            1 + Real.log ((k : ℝ) + 1)) /
          Real.sqrt ((k : ℝ) + 1) := by
  -- Project the objective-gap component out of the main max inequality.
  exact le_trans (le_max_left _ _)
    (dual_projected_subgradient_full_average_rate_max_le_log_over_sqrt
      (X := X) (XStar := XStar) (f := f) (g := g) (fOpt := fOpt) (L := L)
      (xSel := xSel) (lam0 := lam0)
      h_problem h_admissible h_constraint_bound hxBar hgBar hk)

-- Proof sketch: apply `le_max_right` to
-- `dual_projected_subgradient_full_average_rate_max_le_log_over_sqrt`, and then divide by the
-- positive Slater ratio `(f xBar - fOpt) / strict_feasibility_margin g xBar`.
/-- If the Slater ratio is positive, the full-history averaged iterate also satisfies the
positive-part-constraint-violation half of the `O(log(k) / √k)` rate bound. -/
theorem dual_projected_subgradient_full_average_constraint_norm_le_log_over_sqrt
    (h_problem : IsDualProjectedSubgradientProblem X XStar f g fOpt)
    (h_admissible :
      dual_projected_subgradient_method_is_admissible X f g xSel γ)
    (h_constraint_bound :
      ∀ x ∈ X, ‖dual_projected_subgradient_constraint_vector g x‖ ≤ L)
    {xBar : E} (hxBar : xBar ∈ X) (hgBar : ∀ i : Fin m, g i xBar < 0)
    (hAlpha : 0 < (f xBar - fOpt) / strict_feasibility_margin g xBar)
    {k : ℕ} (hk : 1 ≤ k) :
    positive_constraint_violation gVec (fullAvg k) ≤
      ((L / (2 * ((f xBar - fOpt) / strict_feasibility_margin g xBar))) *
          ((‖dual_projected_subgradient_multiplier_vector lam0‖ +
                2 * ((f xBar - fOpt) / strict_feasibility_margin g xBar)) ^ (2 : ℕ) +
              1 + Real.log ((k : ℝ) + 1))) /
        Real.sqrt ((k : ℝ) + 1) := by
  have hsqrt_pos : 0 < Real.sqrt ((k : ℝ) + 1) := by
    positivity
  have hmain :=
    dual_projected_subgradient_full_average_rate_max_le_log_over_sqrt
      (X := X) (XStar := XStar) (f := f) (g := g) (fOpt := fOpt) (L := L)
      (xSel := xSel) (lam0 := lam0)
      h_problem h_admissible h_constraint_bound hxBar hgBar hk
  have hscaled :
      ((f xBar - fOpt) / strict_feasibility_margin g xBar) *
          positive_constraint_violation gVec (fullAvg k) ≤
        (L / 2) *
          ((‖dual_projected_subgradient_multiplier_vector lam0‖ +
                2 * ((f xBar - fOpt) / strict_feasibility_margin g xBar)) ^ (2 : ℕ) +
              1 + Real.log ((k : ℝ) + 1)) /
            Real.sqrt ((k : ℝ) + 1) := by
    exact le_trans (le_max_right _ _) hmain
  have hdiv :
      positive_constraint_violation gVec (fullAvg k) ≤
        ((L / 2) *
            ((‖dual_projected_subgradient_multiplier_vector lam0‖ +
                  2 * ((f xBar - fOpt) / strict_feasibility_margin g xBar)) ^ (2 : ℕ) +
                1 + Real.log ((k : ℝ) + 1)) /
              Real.sqrt ((k : ℝ) + 1)) /
          ((f xBar - fOpt) / strict_feasibility_margin g xBar) := by
    have hscaled' :
        positive_constraint_violation gVec (fullAvg k) *
            ((f xBar - fOpt) / strict_feasibility_margin g xBar) ≤
          (L / 2) *
            ((‖dual_projected_subgradient_multiplier_vector lam0‖ +
                  2 * ((f xBar - fOpt) / strict_feasibility_margin g xBar)) ^ (2 : ℕ) +
                1 + Real.log ((k : ℝ) + 1)) /
              Real.sqrt ((k : ℝ) + 1) := by
      simpa [mul_comm] using hscaled
    exact (le_div_iff₀ hAlpha).2 hscaled'
  have hrewrite :
      ((L / 2) *
          ((‖dual_projected_subgradient_multiplier_vector lam0‖ +
                2 * ((f xBar - fOpt) / strict_feasibility_margin g xBar)) ^ (2 : ℕ) +
              1 + Real.log ((k : ℝ) + 1)) /
            Real.sqrt ((k : ℝ) + 1)) /
        ((f xBar - fOpt) / strict_feasibility_margin g xBar) =
        ((L / (2 * ((f xBar - fOpt) / strict_feasibility_margin g xBar))) *
            ((‖dual_projected_subgradient_multiplier_vector lam0‖ +
                  2 * ((f xBar - fOpt) / strict_feasibility_margin g xBar)) ^ (2 : ℕ) +
                1 + Real.log ((k : ℝ) + 1))) /
          Real.sqrt ((k : ℝ) + 1) := by
    field_simp [hAlpha.ne', hsqrt_pos.ne']
  rw [hrewrite] at hdiv
  exact hdiv

end
