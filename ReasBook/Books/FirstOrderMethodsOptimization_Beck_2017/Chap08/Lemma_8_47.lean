import FirstOrderMethodsOptimization_Beck_2017.Chap08.Definition_8_20
import FirstOrderMethodsOptimization_Beck_2017.Chap08.Algorithm_8_14
import FirstOrderMethodsOptimization_Beck_2017.Chap08.Theorem_8_20
import FirstOrderMethodsOptimization_Beck_2017.Chap08.Theorem_8_42
import FirstOrderMethodsOptimization_Beck_2017.Chap08.Corollary_8_43
import FirstOrderMethodsOptimization_Beck_2017.Chap08.Lemma_8_44
import FirstOrderMethodsOptimization_Beck_2017.Chap08.Lemma_8_45

-- Declarations for this item will be appended below by the statement pipeline.

noncomputable section

universe u

section

variable {E : Type u} {m : ℕ} [NeZero m]
variable {f : E → ℝ} {g : Fin m → E → ℝ} {fOpt qOpt L γ₀ : ℝ}
variable (lam0 : Fin m → NNReal)

local notation "Λ" => EuclideanSpace ℝ (Fin m)

/-- The constant `M` from Lemma 8.47 that uniformly bounds the Euclidean norms of the multiplier
iterates of the dual projected subgradient method. -/
def dual_projected_subgradient_multiplier_norm_bound
    (f : E → ℝ) (fOpt qOpt : ℝ) (g : Fin m → E → ℝ) (xBar : E)
    (L γ₀ : ℝ) (lam0 : Fin m → NNReal) : ℝ :=
  max
    (‖dual_projected_subgradient_multiplier_vector lam0‖ +
      2 * ((f xBar - fOpt) / strict_feasibility_margin g xBar))
    ((f xBar - qOpt) / strict_feasibility_margin g xBar +
      γ₀ * L / (2 * strict_feasibility_margin g xBar) +
      2 * ((f xBar - fOpt) / strict_feasibility_margin g xBar) + γ₀)

-- Proof sketch: unfold `dual_projected_subgradient_multiplier_norm_bound`; this is exactly the
-- textbook formula (8.83), with `α = (f xBar - fOpt) / β` and
-- `β = strict_feasibility_margin g xBar`.
/-- Unfolding `dual_projected_subgradient_multiplier_norm_bound` gives the displayed maximum of
the two source terms from formula (8.83). -/
@[simp]
theorem dual_projected_subgradient_multiplier_norm_bound_def
    (f : E → ℝ) (fOpt qOpt : ℝ) (g : Fin m → E → ℝ) (xBar : E)
    (L γ₀ : ℝ) (lam0 : Fin m → NNReal) :
    dual_projected_subgradient_multiplier_norm_bound f fOpt qOpt g xBar L γ₀ lam0 =
      max
        (‖dual_projected_subgradient_multiplier_vector lam0‖ +
          2 * ((f xBar - fOpt) / strict_feasibility_margin g xBar))
        ((f xBar - qOpt) / strict_feasibility_margin g xBar +
          γ₀ * L / (2 * strict_feasibility_margin g xBar) +
          2 * ((f xBar - fOpt) / strict_feasibility_margin g xBar) + γ₀) := rfl

end

section

variable {E : Type u} [NormedAddCommGroup E] [NormedSpace ℝ E]
variable {m : ℕ} [NeZero m]
variable {X XStar : Set E} {f : E → ℝ} {g : Fin m → E → ℝ}
variable {fOpt qOpt L γ₀ : ℝ}
variable (xSel : (Fin m → NNReal) → {x // x ∈ X}) (γ : ℕ → ℝ) (lam0 : Fin m → NNReal)

local notation "Λ" => EuclideanSpace ℝ (Fin m)
local notation "q" => lagrangian_dual_objective X f (dual_constraint_vector g)
local notation "lamSeq" => dual_projected_subgradient_method X g xSel γ lam0
local notation "lamVecSeq" =>
  fun n ↦ dual_projected_subgradient_multiplier_vector (lamSeq n)

local notation "xSeq" =>
  dual_projected_subgradient_primal_iterate X g xSel γ lam0

local notation "constraintSeq" =>
  fun n ↦ dual_projected_subgradient_constraint_vector g (xSeq n : E)

/- Lemma 8.47 is `source-facing`: it gives a uniform Euclidean norm bound on the dual multiplier
iterates generated by Algorithm 8.14 under Assumption 8.41 and the uniform constraint bound
`‖g(x)‖₂ ≤ L` on `X`. The owner abstractions are the existing recursive multiplier sequence
`dual_projected_subgradient_method`, the Euclidean coercion
`dual_projected_subgradient_multiplier_vector`, the dual objective
`lagrangian_dual_objective X f (dual_constraint_vector g)`, and the strict-feasibility margin
`strict_feasibility_margin g xBar`; the only new local datum is the displayed source constant `M`
packaging the two candidate bounds from the textbook formula (8.83). -/

-- Proof sketch: use
-- `dual_projected_subgradient_problem_dual_attainment h_problem hdual_value`
-- to obtain a feasible optimal dual multiplier `lamStar` with dual value `qOpt`.
-- Corollary 8.43 bounds `‖lamStar‖` by
-- `(f xBar - fOpt) / strict_feasibility_margin g xBar`. Then prove by induction on `k` the
-- stronger estimate on `‖lamVecSeq k - lamStar‖`, splitting into the cases
-- `q (lamVecSeq k) ≥ qOpt - γ k * L / 2` and `q (lamVecSeq k) < qOpt - γ k * L / 2`. Use
-- Theorem 8.42 in the first case, the projected-subgradient recursion in the second, the upper
-- bound `γ k ≤ γ₀`, and finally the triangle inequality to recover the displayed uniform bound on
-- `‖lamVecSeq k‖`.
/-- Helper for Lemma 8.47: a feasible Euclidean multiplier can be repackaged as an `NNReal`
multiplier without changing its associated Euclidean vector. -/
lemma multiplierVector_eq_of_mem_dualProblemFeasibleSet
    {lam : Λ} (hLam : lam ∈ dual_problem_feasible_set m) :
    dual_projected_subgradient_multiplier_vector
        (fun i ↦ ⟨lam i, (mem_dual_problem_feasible_set.mp hLam) i⟩) =
      lam := by
  -- Compare coordinates after turning the feasible Euclidean vector into `NNReal` coordinates.
  ext i
  rfl

/-- Helper for Lemma 8.47: the current dual value equals the Lagrangian value at the selected
primal minimizer. -/
lemma dualObjective_eq_lagrangianAtPrimalIterate
    (h_admissible : dual_projected_subgradient_method_is_admissible X f g xSel γ)
    (k : ℕ) :
    q (lamVecSeq k) =
      ((f (xSeq k : E) + ∑ i, (lamSeq k i : ℝ) * g i (xSeq k : E)) : EReal) := by
  have hmin := dual_projected_subgradient_primal_iterate_isMinOn
    (X := X) (f := f) (g := g) (xSel := xSel) (γ := γ) (lam0 := lam0) h_admissible k
  have hle_raw :
      q (lamVecSeq k) ≤
        ((lagrangian f (dual_constraint_vector g) (lamVecSeq k) (xSeq k : E) : ℝ) : EReal) := by
    -- Evaluate the dual infimum at the selected minimizer.
    rw [lagrangian_dual_objective_eq_sInf]
    exact sInf_le <| Set.mem_image_of_mem
      (fun x : E ↦ ((lagrangian f (dual_constraint_vector g) (lamVecSeq k) x : ℝ) : EReal))
      (xSeq k).property
  have hle :
      q (lamVecSeq k) ≤
        ((f (xSeq k : E) + ∑ i, (lamSeq k i : ℝ) * g i (xSeq k : E)) : EReal) := by
    simpa [lagrangian_apply, dotProduct, dual_constraint_vector_apply,
      dual_projected_subgradient_multiplier_vector_apply] using hle_raw
  have hge_raw :
      ((lagrangian f (dual_constraint_vector g) (lamVecSeq k) (xSeq k : E) : ℝ) : EReal) ≤
        q (lamVecSeq k) := by
    -- The selected iterate minimizes the Lagrangian over `X`, so its value is a lower bound.
    rw [lagrangian_dual_objective_eq_sInf]
    refine le_sInf ?_
    rintro _ ⟨x, hx, rfl⟩
    have hmin_le : f (xSeq k : E) + ∑ i, (lamSeq k i : ℝ) * g i (xSeq k : E) ≤
        f x + ∑ i, (lamSeq k i : ℝ) * g i x :=
      (isMinOn_iff.mp hmin) x hx
    have hmin_leE :
        ((f (xSeq k : E) + ∑ i, (lamSeq k i : ℝ) * g i (xSeq k : E)) : EReal) ≤
          ((f x + ∑ i, (lamSeq k i : ℝ) * g i x) : EReal) := by
      exact_mod_cast hmin_le
    simpa [lagrangian_apply, dotProduct, dual_constraint_vector_apply,
      dual_projected_subgradient_multiplier_vector_apply] using hmin_leE
  have hge :
      ((f (xSeq k : E) + ∑ i, (lamSeq k i : ℝ) * g i (xSeq k : E)) : EReal) ≤
        q (lamVecSeq k) := by
    simpa [lagrangian_apply, dotProduct, dual_constraint_vector_apply,
      dual_projected_subgradient_multiplier_vector_apply] using hge_raw
  -- Both sides are finite and agree by the minimizing property.
  exact le_antisymm hle hge

/-- Helper for Lemma 8.47: one projected multiplier step increases the Euclidean norm by at most
the current stepsize. -/
lemma nextMultiplierNormLeCurrentNormAddStepsize
    (h_admissible : dual_projected_subgradient_method_is_admissible X f g xSel γ)
    (k : ℕ) :
    ‖lamVecSeq (k + 1)‖ ≤ ‖lamVecSeq k‖ + γ k := by
  by_cases hconstraint : constraintSeq k = 0
  · have hsucc :=
      dual_projected_subgradient_method_succ_of_constraint_vector_eq_zero
        (X := X) (g := g) (xSel := xSel) (γ := γ) (lam0 := lam0) k hconstraint
    have hvecsucc : lamVecSeq (k + 1) = lamVecSeq k := by
      simpa using congrArg dual_projected_subgradient_multiplier_vector hsucc
    -- In the zero-constraint branch the multiplier is frozen, and the extra `γ k` is nonnegative.
    rw [hvecsucc]
    linarith [dual_projected_subgradient_method_stepsize_pos
      (X := X) (f := f) (g := g) (xSel := xSel) (γ := γ) h_admissible k]
  · have hsucc :=
      dual_projected_subgradient_method_succ_of_constraint_vector_ne_zero
        (X := X) (g := g) (xSel := xSel) (γ := γ) (lam0 := lam0) k hconstraint
    have hnorm_pos : 0 < ‖constraintSeq k‖ := norm_pos_iff.mpr hconstraint
    let z : Λ := lamVecSeq k + (γ k / ‖constraintSeq k‖) • constraintSeq k
    have hnext_sq_le : ‖lamVecSeq (k + 1)‖ ^ (2 : ℕ) ≤ ‖z‖ ^ (2 : ℕ) := by
      have hcoord :
          ∀ i : Fin m,
            ((lamSeq (k + 1) i : ℝ) ^ (2 : ℕ)) ≤
              (((lamSeq k i : ℝ) +
                  (γ k / ‖constraintSeq k‖) * g i (xSeq k : E)) ^ (2 : ℕ)) := by
        intro i
        have hscalar :=
          toNNReal_sub_sq_le_sub_sq
            (a := (lamSeq k i : ℝ) +
              (γ k / ‖constraintSeq k‖) * g i (xSeq k : E))
            (b := 0) le_rfl
        simpa [hsucc, dual_projected_subgradient_multiplier_update_apply,
          dual_projected_subgradient_multiplier_vector_apply,
          dual_projected_subgradient_constraint_vector_apply, div_eq_mul_inv,
          mul_assoc, mul_left_comm, mul_comm] using hscalar
      calc
        ‖lamVecSeq (k + 1)‖ ^ (2 : ℕ)
            = ∑ i, ((lamSeq (k + 1) i : ℝ) ^ (2 : ℕ)) := by
                simpa [dual_projected_subgradient_multiplier_vector_apply] using
                  EuclideanSpace.real_norm_sq_eq (lamVecSeq (k + 1))
        _ ≤ ∑ i,
              (((lamSeq k i : ℝ) +
                  (γ k / ‖constraintSeq k‖) * g i (xSeq k : E)) ^ (2 : ℕ)) := by
              exact Finset.sum_le_sum fun i _ ↦ hcoord i
        _ = ‖z‖ ^ (2 : ℕ) := by
              symm
              simpa [z, dual_projected_subgradient_multiplier_vector_apply,
                dual_projected_subgradient_constraint_vector_apply, div_eq_mul_inv,
                mul_assoc, mul_left_comm, mul_comm] using
                EuclideanSpace.real_norm_sq_eq z
    have hnext_le_z : ‖lamVecSeq (k + 1)‖ ≤ ‖z‖ := by
      have hnext_nonneg : 0 ≤ ‖lamVecSeq (k + 1)‖ := norm_nonneg _
      have hz_nonneg : 0 ≤ ‖z‖ := norm_nonneg _
      nlinarith
    have hz_step :
        ‖(γ k / ‖constraintSeq k‖) • constraintSeq k‖ = γ k := by
      have hdiv_nonneg : 0 ≤ γ k / ‖constraintSeq k‖ := by
        exact div_nonneg
          (le_of_lt (dual_projected_subgradient_method_stepsize_pos
            (X := X) (f := f) (g := g) (xSel := xSel) (γ := γ) h_admissible k))
          (norm_nonneg _)
      rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg hdiv_nonneg]
      field_simp [hnorm_pos.ne']
    have hz_le : ‖z‖ ≤ ‖lamVecSeq k‖ + γ k := by
      -- Compare the unprojected step with the current vector plus a normalized unit move.
      calc
        ‖z‖ ≤ ‖lamVecSeq k‖ + ‖(γ k / ‖constraintSeq k‖) • constraintSeq k‖ := by
            simpa [z] using
              norm_add_le (lamVecSeq k) ((γ k / ‖constraintSeq k‖) • constraintSeq k)
        _ = ‖lamVecSeq k‖ + γ k := by rw [hz_step]
    exact le_trans hnext_le_z hz_le

/-- Helper for Lemma 8.47: when the current constraint vector vanishes, the current dual value is
already at least the dual optimum. -/
lemma dualOptimalValueLeCurrentDualObjectiveOfConstraintEqZero
    (h_problem : IsDualProjectedSubgradientProblem X XStar f g fOpt)
    (h_admissible : dual_projected_subgradient_method_is_admissible X f g xSel γ)
    (hdual_value : IsLUB (q '' dual_problem_feasible_set m) (qOpt : EReal))
    (k : ℕ) (hconstraint : constraintSeq k = 0) :
    (qOpt : EReal) ≤ q (lamVecSeq k) := by
  have hzero :
      ∀ i : Fin m, g i (xSeq k : E) = 0 := by
    intro i
    simpa [dual_projected_subgradient_constraint_vector_apply] using
      congrArg (fun v : Λ ↦ v i) hconstraint
  have hmin :
      IsMinOn (dual_projected_subgradient_lagrangian f g (lamSeq k)) X (xSeq k : E) :=
    dual_projected_subgradient_primal_iterate_isMinOn
      (X := X) (f := f) (g := g) (xSel := xSel) (γ := γ) (lam0 := lam0) h_admissible k
  have hprimal :=
    primal_optimality_of_lagrangian_isMinOn_of_constraint_eq_zero
      ((xSeq k).property) hmin hzero
  have hfOpt_le :
      fOpt ≤ f (xSeq k : E) := by
    exact h_problem.optimal_value_isGLB.1 <|
      Set.mem_image_of_mem f hprimal.1
  have hcurrent :
      q (lamVecSeq k) = ((f (xSeq k : E)) : EReal) := by
    have hsum_zero :
        ∑ i, (lamSeq k i : ℝ) * g i (xSeq k : E) = 0 := by
      refine Finset.sum_eq_zero ?_
      intro i hi
      rw [hzero i]
      ring
    rw [dualObjective_eq_lagrangianAtPrimalIterate
      (X := X) (f := f) (g := g) (xSel := xSel) (γ := γ) (lam0 := lam0) h_admissible k]
    rw [hsum_zero]
    norm_num
  -- Strong duality rewrites the optimal dual value to the primal optimum, and the zero-constraint
  -- branch makes the current primal iterate feasible.
  calc
    (qOpt : EReal) = (fOpt : EReal) := by
      simpa using dual_projected_subgradient_problem_strong_duality
        (X := X) (XStar := XStar) (f := f) (g := g) (fOpt := fOpt) h_problem hdual_value
    _ ≤ ((f (xSeq k : E)) : EReal) := by
      exact_mod_cast hfOpt_le
    _ = q (lamVecSeq k) := hcurrent.symm

/-- Helper for Lemma 8.47: the optimal dual value gap is controlled by the constraint pairing
against a comparison nonnegative multiplier at the current primal iterate. -/
lemma dualOptimalGapLeConstraintPairingAtIterate
    {lamBar : Fin m → NNReal}
    (hqBar : q (dual_projected_subgradient_multiplier_vector lamBar) = (qOpt : EReal))
    (k : ℕ) :
    qOpt - (f (xSeq k : E) + ∑ i, (lamSeq k i : ℝ) * g i (xSeq k : E)) ≤
      ∑ i, g i (xSeq k : E) * ((lamBar i : ℝ) - (lamSeq k i : ℝ)) := by
  have hq_le :
      q (dual_projected_subgradient_multiplier_vector lamBar) ≤
        ((f (xSeq k : E) + ∑ i, (lamBar i : ℝ) * g i (xSeq k : E)) : EReal) := by
    -- Evaluate the dual infimum at the selected primal iterate `x^k`.
    rw [lagrangian_dual_objective_eq_sInf]
    exact sInf_le <|
      Set.mem_image_of_mem
        (fun x : E ↦
          ((lagrangian f (dual_constraint_vector g)
            (dual_projected_subgradient_multiplier_vector lamBar) x : ℝ) : EReal))
        (xSeq k).property
  have hq_le_real :
      qOpt ≤ f (xSeq k : E) + ∑ i, (lamBar i : ℝ) * g i (xSeq k : E) := by
    have hq_le' :
        (qOpt : EReal) ≤
          ((f (xSeq k : E) + ∑ i, (lamBar i : ℝ) * g i (xSeq k : E)) : EReal) := by
      simpa [hqBar, lagrangian_apply, dotProduct, dual_constraint_vector_apply,
        dual_projected_subgradient_multiplier_vector_apply] using hq_le
    exact_mod_cast hq_le'
  -- Rearranging the two Lagrangian values isolates the constraint pairing term.
  have hpair_eq :
      (f (xSeq k : E) + ∑ i, (lamBar i : ℝ) * g i (xSeq k : E)) -
          (f (xSeq k : E) + ∑ i, (lamSeq k i : ℝ) * g i (xSeq k : E)) =
        ∑ i, g i (xSeq k : E) * ((lamBar i : ℝ) - (lamSeq k i : ℝ)) := by
    calc
      (f (xSeq k : E) + ∑ i, (lamBar i : ℝ) * g i (xSeq k : E)) -
            (f (xSeq k : E) + ∑ i, (lamSeq k i : ℝ) * g i (xSeq k : E))
          = (∑ i, (lamBar i : ℝ) * g i (xSeq k : E)) -
              ∑ i, (lamSeq k i : ℝ) * g i (xSeq k : E) := by
              ring
      _ = ∑ i,
            ((lamBar i : ℝ) * g i (xSeq k : E) -
              (lamSeq k i : ℝ) * g i (xSeq k : E)) := by
              rw [Finset.sum_sub_distrib]
      _ = ∑ i, g i (xSeq k : E) * ((lamBar i : ℝ) - (lamSeq k i : ℝ)) := by
              refine Finset.sum_congr rfl ?_
              intro i hi
              ring
  have hsub :
      qOpt - (f (xSeq k : E) + ∑ i, (lamSeq k i : ℝ) * g i (xSeq k : E)) ≤
        (f (xSeq k : E) + ∑ i, (lamBar i : ℝ) * g i (xSeq k : E)) -
          (f (xSeq k : E) + ∑ i, (lamSeq k i : ℝ) * g i (xSeq k : E)) :=
    sub_le_sub_right hq_le_real
      (f (xSeq k : E) + ∑ i, (lamSeq k i : ℝ) * g i (xSeq k : E))
  calc
    qOpt - (f (xSeq k : E) + ∑ i, (lamSeq k i : ℝ) * g i (xSeq k : E))
        ≤ (f (xSeq k : E) + ∑ i, (lamBar i : ℝ) * g i (xSeq k : E)) -
            (f (xSeq k : E) + ∑ i, (lamSeq k i : ℝ) * g i (xSeq k : E)) := hsub
    _ = ∑ i, g i (xSeq k : E) * ((lamBar i : ℝ) - (lamSeq k i : ℝ)) := hpair_eq

/-- Helper for Lemma 8.47: in the low-dual-value active branch, the squared distance to the
comparison multiplier is nonincreasing. -/
lemma nextDistanceSqToDualOptimalMultiplierLeOfLowDualValue
    (h_admissible : dual_projected_subgradient_method_is_admissible X f g xSel γ)
    (h_constraint_bound :
      ∀ x ∈ X, ‖dual_projected_subgradient_constraint_vector g x‖ ≤ L)
    {lamBar : Fin m → NNReal}
    (hqBar : q (dual_projected_subgradient_multiplier_vector lamBar) = (qOpt : EReal))
    (k : ℕ)
    (hlow : q (lamVecSeq k) < ((qOpt - γ k * L / 2 : ℝ) : EReal))
    (hconstraint : constraintSeq k ≠ 0) :
    ‖lamVecSeq (k + 1) - dual_projected_subgradient_multiplier_vector lamBar‖ ^ (2 : ℕ) ≤
      ‖lamVecSeq k - dual_projected_subgradient_multiplier_vector lamBar‖ ^ (2 : ℕ) := by
  have hstep :=
    multiplierStepSqDistLe
      (X := X) (g := g) (xSel := xSel) (γ := γ) (lam0 := lam0) k lamBar hconstraint
  have hγ_pos :
      0 < γ k :=
    dual_projected_subgradient_method_stepsize_pos
      (X := X) (f := f) (g := g) (xSel := xSel) (γ := γ) h_admissible k
  have hnorm_pos :
      0 < ‖constraintSeq k‖ := norm_pos_iff.mpr hconstraint
  have hnorm_le :
      ‖constraintSeq k‖ ≤ L :=
    h_constraint_bound (xSeq k : E) (xSeq k).property
  have hcurrent_lt :
      f (xSeq k : E) + ∑ i, (lamSeq k i : ℝ) * g i (xSeq k : E) <
        qOpt - γ k * L / 2 := by
    rw [dualObjective_eq_lagrangianAtPrimalIterate
      (X := X) (f := f) (g := g) (xSel := xSel) (γ := γ) (lam0 := lam0) h_admissible k] at hlow
    exact_mod_cast hlow
  have hpair_ge :
      qOpt - (f (xSeq k : E) + ∑ i, (lamSeq k i : ℝ) * g i (xSeq k : E)) ≤
        ∑ i, g i (xSeq k : E) * ((lamBar i : ℝ) - (lamSeq k i : ℝ)) :=
    dualOptimalGapLeConstraintPairingAtIterate
      (X := X) (f := f) (g := g) (xSel := xSel) (γ := γ) (lam0 := lam0)
      (qOpt := qOpt) hqBar k
  have hgap_lt :
      γ k * L / 2 <
        ∑ i, g i (xSeq k : E) * ((lamBar i : ℝ) - (lamSeq k i : ℝ)) := by
    have :
        γ k * L / 2 <
          qOpt - (f (xSeq k : E) + ∑ i, (lamSeq k i : ℝ) * g i (xSeq k : E)) := by
      linarith
    exact lt_of_lt_of_le this hpair_ge
  have hfactor_pos : 0 < 2 * (γ k / ‖constraintSeq k‖) := by
    positivity
  have hinner_le :
      γ k * ‖constraintSeq k‖ / 2 ≤ γ k * L / 2 := by
    nlinarith
  have hstep_sq_lt :
      (γ k) ^ (2 : ℕ) <
        2 * (γ k / ‖constraintSeq k‖) *
          (∑ i, g i (xSeq k : E) * ((lamBar i : ℝ) - (lamSeq k i : ℝ))) := by
    have hmid :
        2 * (γ k / ‖constraintSeq k‖) * (γ k * ‖constraintSeq k‖ / 2) ≤
          2 * (γ k / ‖constraintSeq k‖) * (γ k * L / 2) := by
      exact mul_le_mul_of_nonneg_left hinner_le hfactor_pos.le
    have htop :
        2 * (γ k / ‖constraintSeq k‖) * (γ k * L / 2) <
          2 * (γ k / ‖constraintSeq k‖) *
            (∑ i, g i (xSeq k : E) * ((lamBar i : ℝ) - (lamSeq k i : ℝ))) := by
      exact mul_lt_mul_of_pos_left hgap_lt hfactor_pos
    have hrewrite :
        (γ k) ^ (2 : ℕ) =
          2 * (γ k / ‖constraintSeq k‖) * (γ k * ‖constraintSeq k‖ / 2) := by
      field_simp [hnorm_pos.ne']
    rw [hrewrite]
    exact lt_of_le_of_lt hmid htop
  -- The one-step squared-distance recursion and the low-dual-value gain force contraction.
  linarith

/-- Helper for Lemma 8.47: the distance from the multiplier iterates to a fixed optimal
comparison multiplier stays inside the source radius from formula (8.84). -/
lemma distanceToDualOptimalMultiplierLeRadius
    (h_problem : IsDualProjectedSubgradientProblem X XStar f g fOpt)
    (h_admissible : dual_projected_subgradient_method_is_admissible X f g xSel γ)
    (h_constraint_bound :
      ∀ x ∈ X, ‖dual_projected_subgradient_constraint_vector g x‖ ≤ L)
    (h_stepsize_le : ∀ k : ℕ, γ k ≤ γ₀)
    (hdual_value : IsLUB (q '' dual_problem_feasible_set m) (qOpt : EReal))
    {xBar : E} (hxBar : xBar ∈ X) (hgBar : ∀ i : Fin m, g i xBar < 0)
    {lamBar : Fin m → NNReal}
    (hqBar : q (dual_projected_subgradient_multiplier_vector lamBar) = (qOpt : EReal)) :
    ∀ n,
      ‖lamVecSeq n - dual_projected_subgradient_multiplier_vector lamBar‖ ≤
        max
          ‖lamVecSeq 0 - dual_projected_subgradient_multiplier_vector lamBar‖
          ((f xBar - qOpt) / strict_feasibility_margin g xBar +
            γ₀ * L / (2 * strict_feasibility_margin g xBar) +
            ‖dual_projected_subgradient_multiplier_vector lamBar‖ + γ₀) := by
  have hmargin_pos :
      0 < strict_feasibility_margin g xBar :=
    strict_feasibility_margin_pos (g := g) hgBar
  have hL_nonneg : 0 ≤ L := by
    exact le_trans (norm_nonneg _) (h_constraint_bound (xSeq 0 : E) (xSeq 0).property)
  intro n
  induction n with
  | zero =>
      -- The base iterate is one of the two candidates in the defining radius.
      exact le_max_left _ _
  | succ n ihn =>
      by_cases hsuper :
          ((qOpt - γ n * L / 2 : ℝ) : EReal) ≤ q (lamVecSeq n)
      · have hsuperlevel :
            lamVecSeq n ∈ dual_objective_superlevel_set X f g (qOpt - γ n * L / 2) := by
          rw [mem_dual_objective_superlevel_set]
          refine ⟨?_, hsuper⟩
          intro i
          exact NNReal.coe_nonneg (lamSeq n i)
        have hnorm_curr :
            ‖lamVecSeq n‖ ≤
              (f xBar - (qOpt - γ n * L / 2)) / strict_feasibility_margin g xBar :=
          norm_le_div_strict_feasibility_margin_of_mem_dual_objective_superlevel_set
            X f g (qOpt - γ n * L / 2) xBar (lamVecSeq n) hxBar hgBar hsuperlevel
        have hstep :
            ‖lamVecSeq (n + 1)‖ ≤ ‖lamVecSeq n‖ + γ n :=
          nextMultiplierNormLeCurrentNormAddStepsize
            (X := X) (f := f) (g := g) (xSel := xSel) (γ := γ) (lam0 := lam0)
            h_admissible n
        have hdist_step :
            ‖lamVecSeq (n + 1) - dual_projected_subgradient_multiplier_vector lamBar‖ ≤
              ‖lamVecSeq n‖ + γ n + ‖dual_projected_subgradient_multiplier_vector lamBar‖ := by
          have htri :
              ‖lamVecSeq (n + 1) - dual_projected_subgradient_multiplier_vector lamBar‖ ≤
                ‖lamVecSeq (n + 1)‖ + ‖dual_projected_subgradient_multiplier_vector lamBar‖ :=
            norm_sub_le _ _
          linarith
        have hradius_branch :
            ‖lamVecSeq n‖ + γ n + ‖dual_projected_subgradient_multiplier_vector lamBar‖ ≤
              (f xBar - qOpt) / strict_feasibility_margin g xBar +
                γ₀ * L / (2 * strict_feasibility_margin g xBar) +
                ‖dual_projected_subgradient_multiplier_vector lamBar‖ + γ₀ := by
          have hstep_bound :
              ‖lamVecSeq n‖ + γ n ≤
                (f xBar - (qOpt - γ n * L / 2)) / strict_feasibility_margin g xBar + γ₀ := by
            calc
              ‖lamVecSeq n‖ + γ n
                  ≤ (f xBar - (qOpt - γ n * L / 2)) / strict_feasibility_margin g xBar +
                      γ n := by
                        simpa [add_comm, add_left_comm, add_assoc] using
                          add_le_add_right hnorm_curr (γ n)
              _ ≤ (f xBar - (qOpt - γ n * L / 2)) / strict_feasibility_margin g xBar +
                    γ₀ := by
                    gcongr
                    exact h_stepsize_le n
          have hgamma_part :
              γ n * L / (2 * strict_feasibility_margin g xBar) ≤
                γ₀ * L / (2 * strict_feasibility_margin g xBar) := by
            have hnum :
                γ n * L ≤ γ₀ * L :=
              mul_le_mul_of_nonneg_right (h_stepsize_le n) hL_nonneg
            exact div_le_div_of_nonneg_right hnum (by positivity)
          have hsuperlevel_bound' :
              (f xBar - (qOpt - γ n * L / 2)) / strict_feasibility_margin g xBar + γ₀ ≤
                (f xBar - qOpt) / strict_feasibility_margin g xBar +
                  γ₀ * L / (2 * strict_feasibility_margin g xBar) + γ₀ := by
            have hexpand :
                (f xBar - (qOpt - γ n * L / 2)) / strict_feasibility_margin g xBar + γ₀ =
                  (f xBar - qOpt) / strict_feasibility_margin g xBar +
                    γ n * L / (2 * strict_feasibility_margin g xBar) + γ₀ := by
              field_simp [hmargin_pos.ne']
              ring
            rw [hexpand]
            linarith
          have hsuperlevel_bound :
              (f xBar - (qOpt - γ n * L / 2)) / strict_feasibility_margin g xBar + γ₀ ≤
                (f xBar - qOpt) / strict_feasibility_margin g xBar +
                  γ₀ * L / (2 * strict_feasibility_margin g xBar) + γ₀ := hsuperlevel_bound'
          linarith
        exact le_trans hdist_step <| le_trans hradius_branch (le_max_right _ _)
      · have hlow :
            q (lamVecSeq n) < ((qOpt - γ n * L / 2 : ℝ) : EReal) :=
          lt_of_not_ge hsuper
        by_cases hconstraint : constraintSeq n = 0
        · have hdual_ge :
              (qOpt : EReal) ≤ q (lamVecSeq n) :=
            dualOptimalValueLeCurrentDualObjectiveOfConstraintEqZero
              (X := X) (XStar := XStar) (f := f) (g := g) (xSel := xSel) (γ := γ)
              (lam0 := lam0) (qOpt := qOpt) h_problem h_admissible hdual_value n hconstraint
          have hshift_le :
              (((qOpt - γ n * L / 2 : ℝ)) : EReal) ≤ (qOpt : EReal) := by
            exact_mod_cast sub_le_self qOpt <|
              div_nonneg
                (mul_nonneg
                  (le_of_lt (dual_projected_subgradient_method_stepsize_pos
                    (X := X) (f := f) (g := g) (xSel := xSel) (γ := γ) h_admissible n))
                  hL_nonneg)
                (by norm_num)
          exact False.elim <| not_lt_of_ge (le_trans hshift_le hdual_ge) hlow
        · have hsq :
              ‖lamVecSeq (n + 1) - dual_projected_subgradient_multiplier_vector lamBar‖ ^
                  (2 : ℕ) ≤
                ‖lamVecSeq n - dual_projected_subgradient_multiplier_vector lamBar‖ ^
                  (2 : ℕ) :=
            nextDistanceSqToDualOptimalMultiplierLeOfLowDualValue
              (X := X) (f := f) (g := g) (xSel := xSel) (γ := γ) (lam0 := lam0)
              (qOpt := qOpt) (L := L) h_admissible h_constraint_bound hqBar n hlow hconstraint
          have hnorm_le :
              ‖lamVecSeq (n + 1) - dual_projected_subgradient_multiplier_vector lamBar‖ ≤
                ‖lamVecSeq n - dual_projected_subgradient_multiplier_vector lamBar‖ := by
            nlinarith [hsq, norm_nonneg (lamVecSeq (n + 1) -
              dual_projected_subgradient_multiplier_vector lamBar),
              norm_nonneg (lamVecSeq n - dual_projected_subgradient_multiplier_vector lamBar)]
          exact le_trans hnorm_le ihn

/-- Lemma 8.47: under Assumption 8.41, if `‖g(x)‖₂ ≤ L` on `X` and the dual projected subgradient
method uses positive stepsizes bounded above by `γ₀`, then every multiplier iterate `λ^k`
satisfies the uniform bound `‖λ^k‖₂ ≤ M`, where `M` is the maximum in formula (8.83) built from
the Slater margin at `xBar`, the primal optimal value `fOpt`, the dual optimal value `qOpt`, and
the initial multiplier `λ^0`. -/
theorem dual_projected_subgradient_multiplier_norm_le_uniform_bound
    (h_problem : IsDualProjectedSubgradientProblem X XStar f g fOpt)
    (h_admissible : dual_projected_subgradient_method_is_admissible X f g xSel γ)
    (h_constraint_bound :
      ∀ x ∈ X, ‖dual_projected_subgradient_constraint_vector g x‖ ≤ L)
    (h_stepsize_le : ∀ k : ℕ, γ k ≤ γ₀)
    (hdual_value : IsLUB (q '' dual_problem_feasible_set m) (qOpt : EReal))
    {xBar : E} (hxBar : xBar ∈ X) (hgBar : ∀ i : Fin m, g i xBar < 0)
    (k : ℕ) :
    ‖lamVecSeq k‖ ≤
      dual_projected_subgradient_multiplier_norm_bound f fOpt qOpt g xBar L γ₀ lam0 := by
  obtain ⟨lamStar, hlamStar_feasible, hlamStar_max, hqStar⟩ :=
    dual_projected_subgradient_problem_dual_attainment
      (X := X) (XStar := XStar) (f := f) (g := g) (fOpt := fOpt) h_problem hdual_value
  let lamStarNN : Fin m → NNReal := fun i ↦
    ⟨lamStar i, (mem_dual_problem_feasible_set.mp hlamStar_feasible) i⟩
  have hlamStar_vec :
      dual_projected_subgradient_multiplier_vector lamStarNN = lamStar :=
    multiplierVector_eq_of_mem_dualProblemFeasibleSet
      (m := m) (lam := lamStar) hlamStar_feasible
  have hqStarNN :
      q (dual_projected_subgradient_multiplier_vector lamStarNN) = (qOpt : EReal) := by
    simpa [hlamStar_vec] using hqStar
  have hlamStar_norm :
      ‖dual_projected_subgradient_multiplier_vector lamStarNN‖ ≤
        (f xBar - fOpt) / strict_feasibility_margin g xBar := by
    simpa [hlamStar_vec] using
      norm_le_div_strict_feasibility_margin_of_dual_optimal_multiplier
        (X := X) (XStar := XStar) (f := f) (g := g) (fOpt := fOpt)
        h_problem hxBar hgBar ⟨hlamStar_feasible, hlamStar_max⟩
  have hradius :=
    distanceToDualOptimalMultiplierLeRadius
      (X := X) (XStar := XStar) (f := f) (g := g) (xSel := xSel) (γ := γ)
      (lam0 := lam0) (fOpt := fOpt) (qOpt := qOpt) (L := L)
      h_problem h_admissible h_constraint_bound h_stepsize_le hdual_value hxBar hgBar
      hqStarNN k
  have htri :
      ‖lamVecSeq k‖ ≤
        ‖lamVecSeq k - dual_projected_subgradient_multiplier_vector lamStarNN‖ +
          ‖dual_projected_subgradient_multiplier_vector lamStarNN‖ := by
    simpa [sub_eq_add_neg, add_assoc, add_left_comm, add_comm] using
      norm_add_le
        (lamVecSeq k - dual_projected_subgradient_multiplier_vector lamStarNN)
        (dual_projected_subgradient_multiplier_vector lamStarNN)
  let firstTerm : ℝ :=
    ‖dual_projected_subgradient_multiplier_vector lam0‖ +
      2 * ((f xBar - fOpt) / strict_feasibility_margin g xBar)
  let secondTerm : ℝ :=
    (f xBar - qOpt) / strict_feasibility_margin g xBar +
      γ₀ * L / (2 * strict_feasibility_margin g xBar) +
      2 * ((f xBar - fOpt) / strict_feasibility_margin g xBar) + γ₀
  let initialDistance : ℝ :=
    ‖lamVecSeq 0 - dual_projected_subgradient_multiplier_vector lamStarNN‖
  let radiusBranch : ℝ :=
    (f xBar - qOpt) / strict_feasibility_margin g xBar +
      γ₀ * L / (2 * strict_feasibility_margin g xBar) +
      ‖dual_projected_subgradient_multiplier_vector lamStarNN‖ + γ₀
  have hinitial_le :
      initialDistance + ‖dual_projected_subgradient_multiplier_vector lamStarNN‖ ≤ firstTerm := by
    have hinit_dist :
        initialDistance ≤
          ‖dual_projected_subgradient_multiplier_vector lam0‖ +
            ‖dual_projected_subgradient_multiplier_vector lamStarNN‖ := by
      simpa [initialDistance] using
        norm_sub_le (lamVecSeq 0) (dual_projected_subgradient_multiplier_vector lamStarNN)
    nlinarith [hinit_dist, hlamStar_norm]
  have hradiusBranch_le :
      radiusBranch + ‖dual_projected_subgradient_multiplier_vector lamStarNN‖ ≤ secondTerm := by
    nlinarith [hlamStar_norm]
  -- Route correction: keep the source proof in terms of the radius around an attained optimal
  -- multiplier, then add back the optimal multiplier norm only at the very end.
  have hradius' :
      ‖lamVecSeq k - dual_projected_subgradient_multiplier_vector lamStarNN‖ ≤
        max initialDistance radiusBranch := by
    simpa [initialDistance, radiusBranch] using hradius
  by_cases hbranch : initialDistance ≤ radiusBranch
  · have hradius_le :
        ‖lamVecSeq k - dual_projected_subgradient_multiplier_vector lamStarNN‖ ≤ radiusBranch := by
      have hmax_le : max initialDistance radiusBranch ≤ radiusBranch :=
        max_le_iff.mpr ⟨hbranch, le_rfl⟩
      exact le_trans hradius' hmax_le
    have hbound :
        ‖lamVecSeq k‖ ≤
          radiusBranch + ‖dual_projected_subgradient_multiplier_vector lamStarNN‖ := by
      linarith
    have hbound' :
        ‖lamVecSeq k‖ ≤ secondTerm := le_trans hbound hradiusBranch_le
    have :
        ‖lamVecSeq k‖ ≤ max firstTerm secondTerm := le_trans hbound' (le_max_right _ _)
    simpa [dual_projected_subgradient_multiplier_norm_bound, firstTerm, secondTerm] using this
  · have hradius_le :
        ‖lamVecSeq k - dual_projected_subgradient_multiplier_vector lamStarNN‖ ≤ initialDistance := by
      have hmax_le : max initialDistance radiusBranch ≤ initialDistance :=
        max_le_iff.mpr ⟨le_rfl, le_of_not_ge hbranch⟩
      exact le_trans hradius' hmax_le
    have hbound :
        ‖lamVecSeq k‖ ≤
          initialDistance + ‖dual_projected_subgradient_multiplier_vector lamStarNN‖ := by
      linarith
    have hbound' :
        ‖lamVecSeq k‖ ≤ firstTerm := le_trans hbound hinitial_le
    have :
        ‖lamVecSeq k‖ ≤ max firstTerm secondTerm := le_trans hbound' (le_max_left _ _)
    simpa [dual_projected_subgradient_multiplier_norm_bound, firstTerm, secondTerm] using this

end
