-- Declarations for this item will be appended below by the statement pipeline.

universe u v

open MeasureTheory
open scoped BigOperators ProbabilityTheory

noncomputable section

section

variable {E : Type u} {Ω : Type v}
variable [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]
variable [MeasurableSpace Ω] {μ : Measure Ω} [IsProbabilityMeasure μ]
variable [MeasurableSpace E] [BorelSpace E]
variable {f : E → ℝ} {C XStar : Set E} {fOpt Θ : ℝ}
variable (h_problem : IsConstrainedConvexProblem (fun x : E ↦ (f x : EReal)) C XStar fOpt)
variable (g : ℕ → C → Ω → E) (t : ℕ → ℝ) (x0 : C)

local notation "x[" k "]" =>
  stochastic_projected_subgradient_method C h_problem.feasible_nonempty h_problem.feasible_closed
    h_problem.feasible_convex g t x0 k
local notation "x̄" =>
  stochastic_projected_subgradient_method_iterate C h_problem.feasible_nonempty
    h_problem.feasible_closed h_problem.feasible_convex g t x0
local notation "x̄[" k "]" => x̄ k

/-- Helper for Theorem 8.35: the sigma-algebra generated by the `n`th stochastic iterate. -/
private abbrev stochasticIterateSigmaAlgebra (n : ℕ) : MeasurableSpace Ω :=
  MeasurableSpace.comap x̄[n] inferInstance

/-- Helper for Theorem 8.35: every feasible point has objective value at least `fOpt`. -/
private lemma feasibleObjectiveGap_nonneg
    (h_problem : IsConstrainedConvexProblem (fun x : E ↦ (f x : EReal)) C XStar fOpt)
    {y : E} (hy : y ∈ C) :
    0 ≤ f y - fOpt := by
  -- Compare the feasible objective value with the problem's recorded greatest lower bound.
  have hyImage : ((f y : ℝ) : EReal) ∈ (fun x : E ↦ ((f x : ℝ) : EReal)) '' C := by
    exact ⟨y, hy, rfl⟩
  have hlower : (fOpt : EReal) ≤ (f y : EReal) :=
    h_problem.optimal_value_isGLB.1 hyImage
  have hreal : fOpt ≤ f y := by
    exact EReal.coe_le_coe_iff.mp (by simpa using hlower)
  linarith

/-- Helper for Theorem 8.35: the objective `f` is Borel measurable because the standing problem
assumption records lower semicontinuity of the `EReal`-valued objective. -/
private lemma objectiveMeasurable
    (h_problem : IsConstrainedConvexProblem (fun x : E ↦ (f x : EReal)) C XStar fOpt) :
    Measurable f := by
  -- The constrained-problem hypothesis already packages measurability of the extended-real
  -- objective, and coercing back to `ℝ` is definitional here.
  simpa using h_problem.closed.measurable.ereal_toReal

/-- Helper for Theorem 8.35: subtracting a constant from an expected value is the same as
integrating the pointwise shifted function. -/
private lemma expectationSub_eq_integral_sub_const
    {φ : Ω → ℝ} (hφ : Integrable φ μ) (c : ℝ) :
    MeasureTheory.integral μ φ - c =
      MeasureTheory.integral μ (fun ω ↦ φ ω - c) := by
  calc
    MeasureTheory.integral μ φ - c
        = MeasureTheory.integral μ φ - MeasureTheory.integral μ (fun _ : Ω ↦ c) := by
            simp
    _ = MeasureTheory.integral μ (fun ω ↦ φ ω - c) := by
          rw [← integral_sub hφ (integrable_const c)]

/-- Helper for Theorem 8.35: the running best value along any stochastic prefix still lies above
the optimal value `fOpt`. -/
private lemma bestAchievedObjectiveGap_nonneg
    (k : ℕ) (ω : Ω) :
    0 ≤ best_achieved_function_value f (fun n ↦ (x[n] ω : E)) k - fOpt := by
  -- Every iterate in the finite prefix is feasible, so the finite minimum stays above `fOpt`.
  have hbest_lower :
      fOpt ≤ best_achieved_function_value f (fun n ↦ (x[n] ω : E)) k := by
    unfold best_achieved_function_value
    apply Finset.le_min'
    intro y hy
    rcases Finset.mem_image.mp hy with ⟨n, hn, rfl⟩
    have hgap_nonneg :=
      feasibleObjectiveGap_nonneg (h_problem := h_problem) (f := f) (x[n] ω).property
    linarith
  linarith

/-- Helper for Theorem 8.35: every stochastic iterate is almost surely strongly measurable. -/
private lemma stochasticIterateAestronglyMeasurable
    (h_oracle :
      StochasticProjectedSubgradientOracle μ f
        x̄ (fun n ω ↦ g n (x[n] ω) ω))
    (n : ℕ) :
    AEStronglyMeasurable x̄[n] μ := by
  induction n with
  | zero =>
      -- The initial iterate is the constant feasible starting point.
      simpa using
        (aestronglyMeasurable_const : AEStronglyMeasurable (fun _ : Ω ↦ (x0 : E)) μ)
  | succ n ih =>
      let P : E → E := fun y ↦
        (metricProjection C h_problem.feasible_nonempty h_problem.feasible_closed
          h_problem.feasible_convex y : E)
      have hg :
          AEStronglyMeasurable (fun ω ↦ g n (x[n] ω) ω) μ :=
        (h_oracle.integrable_subgradient n).aestronglyMeasurable
      have hupdate :
          AEStronglyMeasurable
            (fun ω ↦ x̄[n] ω - t n • g n (x[n] ω) ω) μ :=
        ih.sub (hg.const_smul (t n))
      have hproj :
          AEStronglyMeasurable
            (fun ω ↦ P (x̄[n] ω - t n • g n (x[n] ω) ω)) μ :=
        (metricProjection_nonexpansive C h_problem.feasible_nonempty h_problem.feasible_closed
          h_problem.feasible_convex).continuous.comp_aestronglyMeasurable hupdate
      -- Rewrite the recursive update into the measurable projection map applied above.
      refine hproj.congr ?_
      filter_upwards with ω
      simpa [P] using
        (stochastic_projected_subgradient_method_iterate_succ
          C h_problem.feasible_nonempty h_problem.feasible_closed
          h_problem.feasible_convex g t x0 n ω)

/-- Helper for Theorem 8.35: one stochastic projection step satisfies a coarse quadratic growth
bound, used to bootstrap square-integrability of the iterates. -/
private lemma projectedSqdistStepGrowthBound
    {xStar : E} (hxStar : xStar ∈ XStar) (n : ℕ) :
    ∀ ω,
      ‖x̄[n + 1] ω - xStar‖ ^ (2 : ℕ) ≤
        2 * ‖x̄[n] ω - xStar‖ ^ (2 : ℕ) +
          2 * (t n) ^ (2 : ℕ) * ‖g n (x[n] ω) ω‖ ^ (2 : ℕ) := by
  intro ω
  let P : E → E := fun y ↦
    (metricProjection C h_problem.feasible_nonempty h_problem.feasible_closed
      h_problem.feasible_convex y : E)
  have hxStar_data : xStar ∈ C ∧ IsMinOn (fun x : E ↦ ((f x : ℝ) : EReal)) C xStar := by
    simpa [h_problem.optimal_set_eq] using hxStar
  have hfix : P xStar = xStar := by
    simpa [P] using
      projectionPoint_eq_self_of_mem C h_problem.feasible_nonempty h_problem.feasible_closed
        h_problem.feasible_convex hxStar_data.1
  have hstep :
      x̄[n + 1] ω = P (x̄[n] ω - t n • g n (x[n] ω) ω) := by
    simpa [P] using
      (stochastic_projected_subgradient_method_iterate_succ
        C h_problem.feasible_nonempty h_problem.feasible_closed
        h_problem.feasible_convex g t x0 n ω)
  have hnonexp :
      ‖x̄[n + 1] ω - xStar‖ ≤
        ‖(x̄[n] ω - t n • g n (x[n] ω) ω) - xStar‖ := by
    -- Firm nonexpansiveness against the fixed feasible point `xStar` yields the norm contraction.
    have hfirm :
        inner ℝ (x̄[n + 1] ω - xStar)
            ((x̄[n] ω - t n • g n (x[n] ω) ω) - xStar) ≥
          ‖x̄[n + 1] ω - xStar‖ ^ (2 : ℕ) := by
      simpa [P, hstep, hfix, sub_eq_add_neg, add_assoc, add_left_comm, add_comm] using
        metricProjection_firmly_nonexpansive C h_problem.feasible_nonempty
          h_problem.feasible_closed h_problem.feasible_convex
          (x̄[n] ω - t n • g n (x[n] ω) ω) xStar
    have habs :
        inner ℝ (x̄[n + 1] ω - xStar)
            ((x̄[n] ω - t n • g n (x[n] ω) ω) - xStar) ≤
          ‖x̄[n + 1] ω - xStar‖ *
            ‖(x̄[n] ω - t n • g n (x[n] ω) ω) - xStar‖ := by
      exact le_trans (le_abs_self _) (abs_real_inner_le_norm _ _)
    nlinarith [hfirm, habs, norm_nonneg (x̄[n + 1] ω - xStar),
      norm_nonneg ((x̄[n] ω - t n • g n (x[n] ω) ω) - xStar)]
  have htriangle :
      ‖(x̄[n] ω - t n • g n (x[n] ω) ω) - xStar‖ ≤
        ‖x̄[n] ω - xStar‖ + ‖t n • g n (x[n] ω) ω‖ := by
    -- Rewrite the update vector as the iterate offset minus the stochastic step.
    simpa [sub_eq_add_neg, add_assoc, add_left_comm, add_comm] using
      norm_sub_le (x̄[n] ω - xStar) (t n • g n (x[n] ω) ω)
  have hnonexp_sq :
      ‖x̄[n + 1] ω - xStar‖ ^ (2 : ℕ) ≤
        ‖(x̄[n] ω - t n • g n (x[n] ω) ω) - xStar‖ ^ (2 : ℕ) := by
    nlinarith [hnonexp, norm_nonneg (x̄[n + 1] ω - xStar),
      norm_nonneg ((x̄[n] ω - t n • g n (x[n] ω) ω) - xStar)]
  have htriangle_sq :
      ‖(x̄[n] ω - t n • g n (x[n] ω) ω) - xStar‖ ^ (2 : ℕ) ≤
        (‖x̄[n] ω - xStar‖ + ‖t n • g n (x[n] ω) ω‖) ^ (2 : ℕ) := by
    nlinarith [htriangle, norm_nonneg ((x̄[n] ω - t n • g n (x[n] ω) ω) - xStar),
      add_nonneg (norm_nonneg (x̄[n] ω - xStar))
        (norm_nonneg (t n • g n (x[n] ω) ω))]
  have hsq_sum :
      (‖x̄[n] ω - xStar‖ + ‖t n • g n (x[n] ω) ω‖) ^ (2 : ℕ) ≤
        2 * ‖x̄[n] ω - xStar‖ ^ (2 : ℕ) +
          2 * ‖t n • g n (x[n] ω) ω‖ ^ (2 : ℕ) := by
    nlinarith [sq_nonneg (‖x̄[n] ω - xStar‖ - ‖t n • g n (x[n] ω) ω‖)]
  calc
    ‖x̄[n + 1] ω - xStar‖ ^ (2 : ℕ) ≤
        ‖(x̄[n] ω - t n • g n (x[n] ω) ω) - xStar‖ ^ (2 : ℕ) := hnonexp_sq
    _ ≤ (‖x̄[n] ω - xStar‖ + ‖t n • g n (x[n] ω) ω‖) ^ (2 : ℕ) := htriangle_sq
    _ ≤ 2 * ‖x̄[n] ω - xStar‖ ^ (2 : ℕ) +
          2 * ‖t n • g n (x[n] ω) ω‖ ^ (2 : ℕ) := hsq_sum
    _ =
        2 * ‖x̄[n] ω - xStar‖ ^ (2 : ℕ) +
          2 * (t n) ^ (2 : ℕ) * ‖g n (x[n] ω) ω‖ ^ (2 : ℕ) := by
        have habs_sq :
            (|t n| * ‖g n (x[n] ω) ω‖) ^ (2 : ℕ) =
              (t n) ^ (2 : ℕ) * ‖g n (x[n] ω) ω‖ ^ (2 : ℕ) := by
          calc
            (|t n| * ‖g n (x[n] ω) ω‖) ^ (2 : ℕ) =
                |t n| ^ (2 : ℕ) * ‖g n (x[n] ω) ω‖ ^ (2 : ℕ) := by ring
            _ = (t n) ^ (2 : ℕ) * ‖g n (x[n] ω) ω‖ ^ (2 : ℕ) := by
                rw [sq_abs]
        rw [norm_smul, Real.norm_eq_abs, habs_sq]
        ring

/-- Helper for Theorem 8.35: the squared distance to an optimal point is integrable at every
iterate. -/
private lemma stochasticIterateSqdistIntegrable
    (h_oracle :
      StochasticProjectedSubgradientOracle μ f
        x̄ (fun n ω ↦ g n (x[n] ω) ω))
    {xStar : E} (hxStar : xStar ∈ XStar) (n : ℕ) :
    Integrable (fun ω ↦ ‖x̄[n] ω - xStar‖ ^ (2 : ℕ)) μ := by
  induction n with
  | zero =>
      -- The initial squared distance is a constant random variable.
      simpa using integrable_const (‖(x0 : E) - xStar‖ ^ (2 : ℕ) : ℝ)
  | succ n ih =>
      have hbound_int :
          Integrable
            (fun ω ↦
              2 * ‖x̄[n] ω - xStar‖ ^ (2 : ℕ) +
                2 * (t n) ^ (2 : ℕ) * ‖g n (x[n] ω) ω‖ ^ (2 : ℕ)) μ := by
        -- The rough growth bound is controlled by the previous square distance plus the oracle
        -- second-moment bound.
        exact (ih.const_mul 2).add ((h_oracle.integrable_sqnorm_subgradient n).const_mul
          (2 * (t n) ^ (2 : ℕ)))
      have hmeas :
          AEStronglyMeasurable (fun ω ↦ ‖x̄[n + 1] ω - xStar‖ ^ (2 : ℕ)) μ := by
        -- Measurability comes from the iterate measurability established above and the continuity
        -- of the squared norm.
        exact
          ((continuous_norm.comp_aestronglyMeasurable
              ((stochasticIterateAestronglyMeasurable
                (h_problem := h_problem) (g := g) (t := t) (x0 := x0) h_oracle (n + 1)).sub
                  aestronglyMeasurable_const)).pow 2)
      refine Integrable.mono' hbound_int hmeas ?_
      filter_upwards with ω
      have hgrowth :=
        projectedSqdistStepGrowthBound
          (h_problem := h_problem) (g := g) (t := t) (x0 := x0) hxStar n ω
      have hnonneg : 0 ≤ ‖x̄[n + 1] ω - xStar‖ ^ (2 : ℕ) := by positivity
      simpa [abs_of_nonneg hnonneg] using hgrowth

/-- Helper for Theorem 8.35: the pathwise stochastic projection step satisfies the exact
squared-distance expansion used before conditioning. -/
private lemma projectedSqdistStepPointwise
    {xStar : E} (hxStar : xStar ∈ XStar) (n : ℕ) :
    ∀ ω,
      ‖x̄[n + 1] ω - xStar‖ ^ (2 : ℕ) ≤
        ‖x̄[n] ω - xStar‖ ^ (2 : ℕ) -
          2 * t n * inner ℝ (g n (x[n] ω) ω) (x̄[n] ω - xStar) +
          (t n) ^ (2 : ℕ) * ‖g n (x[n] ω) ω‖ ^ (2 : ℕ) := by
  intro ω
  let P : E → E := fun y ↦
    (metricProjection C h_problem.feasible_nonempty h_problem.feasible_closed
      h_problem.feasible_convex y : E)
  have hxStar_data : xStar ∈ C ∧ IsMinOn (fun x : E ↦ ((f x : ℝ) : EReal)) C xStar := by
    simpa [h_problem.optimal_set_eq] using hxStar
  have hfix : P xStar = xStar := by
    simpa [P] using
      projectionPoint_eq_self_of_mem C h_problem.feasible_nonempty h_problem.feasible_closed
        h_problem.feasible_convex hxStar_data.1
  have hstep :
      x̄[n + 1] ω = P (x̄[n] ω - t n • g n (x[n] ω) ω) := by
    simpa [P] using
      (stochastic_projected_subgradient_method_iterate_succ
        C h_problem.feasible_nonempty h_problem.feasible_closed
        h_problem.feasible_convex g t x0 n ω)
  have hnonexp :
      ‖x̄[n + 1] ω - xStar‖ ≤
        ‖(x̄[n] ω - t n • g n (x[n] ω) ω) - xStar‖ := by
    -- Firm nonexpansiveness against `xStar` again gives the exact one-step norm contraction.
    have hfirm :
        inner ℝ (x̄[n + 1] ω - xStar)
            ((x̄[n] ω - t n • g n (x[n] ω) ω) - xStar) ≥
          ‖x̄[n + 1] ω - xStar‖ ^ (2 : ℕ) := by
      simpa [P, hstep, hfix, sub_eq_add_neg, add_assoc, add_left_comm, add_comm] using
        metricProjection_firmly_nonexpansive C h_problem.feasible_nonempty
          h_problem.feasible_closed h_problem.feasible_convex
          (x̄[n] ω - t n • g n (x[n] ω) ω) xStar
    have habs :
        inner ℝ (x̄[n + 1] ω - xStar)
            ((x̄[n] ω - t n • g n (x[n] ω) ω) - xStar) ≤
          ‖x̄[n + 1] ω - xStar‖ *
            ‖(x̄[n] ω - t n • g n (x[n] ω) ω) - xStar‖ := by
      exact le_trans (le_abs_self _) (abs_real_inner_le_norm _ _)
    nlinarith [hfirm, habs, norm_nonneg (x̄[n + 1] ω - xStar),
      norm_nonneg ((x̄[n] ω - t n • g n (x[n] ω) ω) - xStar)]
  have hnonexp_sq :
      ‖x̄[n + 1] ω - xStar‖ ^ (2 : ℕ) ≤
        ‖(x̄[n] ω - t n • g n (x[n] ω) ω) - xStar‖ ^ (2 : ℕ) := by
    nlinarith [hnonexp, norm_nonneg (x̄[n + 1] ω - xStar),
      norm_nonneg ((x̄[n] ω - t n • g n (x[n] ω) ω) - xStar)]
  -- Expand the exact squared norm of the iterate offset after one stochastic step.
  calc
    ‖x̄[n + 1] ω - xStar‖ ^ (2 : ℕ) ≤
        ‖(x̄[n] ω - t n • g n (x[n] ω) ω) - xStar‖ ^ (2 : ℕ) := hnonexp_sq
    _ = ‖x̄[n] ω - xStar‖ ^ (2 : ℕ) -
          2 * t n * inner ℝ (g n (x[n] ω) ω) (x̄[n] ω - xStar) +
          (t n) ^ (2 : ℕ) * ‖g n (x[n] ω) ω‖ ^ (2 : ℕ) := by
        have hrewrite :
            (x̄[n] ω - t n • g n (x[n] ω) ω) - xStar =
              (x̄[n] ω - xStar) - t n • g n (x[n] ω) ω := by
          abel
        have habs_sq :
            (|t n| * ‖g n (x[n] ω) ω‖) ^ (2 : ℕ) =
              (t n) ^ (2 : ℕ) * ‖g n (x[n] ω) ω‖ ^ (2 : ℕ) := by
          calc
            (|t n| * ‖g n (x[n] ω) ω‖) ^ (2 : ℕ) =
                |t n| ^ (2 : ℕ) * ‖g n (x[n] ω) ω‖ ^ (2 : ℕ) := by ring
            _ = (t n) ^ (2 : ℕ) * ‖g n (x[n] ω) ω‖ ^ (2 : ℕ) := by
                rw [sq_abs]
        rw [hrewrite, norm_sub_sq_real]
        rw [real_inner_smul_right, real_inner_comm, norm_smul, Real.norm_eq_abs, habs_sq]
        ring

/-- Helper for Theorem 8.35: once the right factor is measurable with respect to the
conditioning sigma-algebra, the conditional expectation of the inner product pulls through that
factor. -/
private lemma condexpIterateScalarCompEqSelf
    (h_oracle :
      StochasticProjectedSubgradientOracle μ f
        x̄ (fun n ω ↦ g n (x[n] ω) ω))
    {φ : E → ℝ} (hφ : Continuous φ) (n : ℕ)
    (hm : stochasticIterateSigmaAlgebra (h_problem := h_problem) (g := g) (t := t) (x0 := x0) n ≤
      ‹MeasurableSpace Ω›)
    (h_int : Integrable (fun ω ↦ φ (x̄[n] ω)) μ) :
    μ[(fun ω ↦ φ (x̄[n] ω)) |
        stochasticIterateSigmaAlgebra
          (h_problem := h_problem) (g := g) (t := t) (x0 := x0) n] =ᵐ[μ]
      fun ω ↦ φ (x̄[n] ω) := by
  have hx_ae : AEMeasurable x̄[n] μ := by
    -- The ambient almost-everywhere measurability of the iterate is enough to compose by `φ`.
    exact
      (stochasticIterateAestronglyMeasurable
        (h_problem := h_problem) (g := g) (t := t) (x0 := x0) h_oracle n).aemeasurable
  have hcomp_meas :
      AEStronglyMeasurable[
          stochasticIterateSigmaAlgebra (h_problem := h_problem) (g := g) (t := t) (x0 := x0) n]
        (fun ω ↦ φ (x̄[n] ω)) μ := by
    -- Re-express the scalar observable as a composition through the iterate-generated sigma
    -- algebra so conditional expectation fixes it on the measurable branch.
    simpa [Function.comp] using
      (hφ.aestronglyMeasurable.comp_ae_measurable' hx_ae)
  exact MeasureTheory.condExp_of_aestronglyMeasurable' hm hcomp_meas h_int

/-- Helper for Theorem 8.35: once the right factor is measurable with respect to the
conditioning sigma-algebra, the conditional expectation of the inner product pulls through that
factor. -/
private lemma condexpInnerOfAestronglyMeasurableRight
    {m : MeasurableSpace Ω} {u v : Ω → E}
    (hv : AEStronglyMeasurable[m] v μ)
    (huv : Integrable (fun ω ↦ inner ℝ (u ω) (v ω)) μ)
    (hu : Integrable u μ) :
    μ[(fun ω ↦ inner ℝ (u ω) (v ω)) | m] =ᵐ[μ]
      fun ω ↦ inner ℝ (μ[u | m] ω) (v ω) := by
  -- This is exactly the Mathlib pull-out theorem specialized to the real inner product.
  simpa [innerSL_apply_apply] using
    (MeasureTheory.condExp_bilin_of_aestronglyMeasurable_right
      (innerSL ℝ) hv huv hu)

/-- Helper for Theorem 8.35: the iterate offset is almost surely strongly measurable with respect
to the sigma-algebra generated by the current iterate. -/
private lemma iterateOffsetAestronglyMeasurableComap
    (h_oracle :
      StochasticProjectedSubgradientOracle μ f
        x̄ (fun n ω ↦ g n (x[n] ω) ω))
    (n : ℕ)
    (hm : stochasticIterateSigmaAlgebra (h_problem := h_problem) (g := g) (t := t) (x0 := x0) n ≤
      ‹MeasurableSpace Ω›)
    {xStar : E} :
    AEStronglyMeasurable[
        stochasticIterateSigmaAlgebra (h_problem := h_problem) (g := g) (t := t) (x0 := x0) n]
      (fun ω ↦ x̄[n] ω - xStar) μ := by
  let offset : Ω → E := fun ω ↦ x̄[n] ω - xStar
  have hoffset_ae : AEStronglyMeasurable offset μ := by
    -- The iterate is a.e. strongly measurable in the ambient space, and translating by `xStar`
    -- preserves that ambient measurability.
    exact
      (stochasticIterateAestronglyMeasurable
        (h_problem := h_problem) (g := g) (t := t) (x0 := x0) h_oracle n).sub
        aestronglyMeasurable_const
  have hmeas_offset :
      Measurable[
          stochasticIterateSigmaAlgebra (h_problem := h_problem) (g := g) (t := t) (x0 := x0) n]
        offset := by
    -- Over the pullback sigma-algebra, the iterate map is measurable by definition.
    have hx_meas :
        Measurable[
            stochasticIterateSigmaAlgebra
              (h_problem := h_problem) (g := g) (t := t) (x0 := x0) n]
          x̄[n] := by
      simpa [stochasticIterateSigmaAlgebra] using
        (measurable_iff_comap_le.mpr (show
          stochasticIterateSigmaAlgebra
              (h_problem := h_problem) (g := g) (t := t) (x0 := x0) n ≤
            stochasticIterateSigmaAlgebra
              (h_problem := h_problem) (g := g) (t := t) (x0 := x0) n from le_rfl))
    exact (continuous_id.sub continuous_const).measurable.comp hx_meas
  rcases (aestronglyMeasurable_iff_aemeasurable_separable.1 hoffset_ae).2 with
    ⟨s, hs_sep, hs_ae⟩
  obtain ⟨s₀, hs₀_subset, hs₀_count, hs_subset_closure⟩ :=
    hs_sep.exists_countable_dense_subset
  have hs_closure_ae : ∀ᵐ ω ∂μ, offset ω ∈ closure s₀ := by
    filter_upwards [hs_ae] with ω hω
    exact hs_subset_closure hω
  have hs_meas :
      MeasurableSet[
          stochasticIterateSigmaAlgebra (h_problem := h_problem) (g := g) (t := t) (x0 := x0) n]
        {ω | offset ω ∈ closure s₀} := by
    exact hmeas_offset isClosed_closure.measurableSet
  have hs_trim : ∀ᵐ ω ∂μ.trim hm, offset ω ∈ closure s₀ := by
    have hs_meas_compl :
        MeasurableSet[
            stochasticIterateSigmaAlgebra
              (h_problem := h_problem) (g := g) (t := t) (x0 := x0) n]
          {ω | offset ω ∉ closure s₀} := hs_meas.compl
    rw [ae_iff]
    rw [trim_measurableSet_eq hm hs_meas_compl]
    simpa [ae_iff] using hs_closure_ae
  have htrim :
      AEStronglyMeasurable[
          stochasticIterateSigmaAlgebra (h_problem := h_problem) (g := g) (t := t) (x0 := x0) n]
        offset (μ.trim hm) := by
    -- On the trimmed measure, measurability in the pullback sigma-algebra plus the ambient
    -- a.e. separable range gives the desired relative strong measurability.
    exact
      (aestronglyMeasurable_iff_aemeasurable_separable).2
        ⟨hmeas_offset.aemeasurable,
          ⟨closure s₀, hs₀_count.isSeparable.closure, hs_trim⟩⟩
  exact htrim.of_trim hm

/-- Helper for Theorem 8.35: conditioning on the sigma-algebra generated by `x[n]` pulls the
iterate offset out of the inner product. -/
private lemma condexpInnerIterateOffsetComapPullout
    (h_oracle :
      StochasticProjectedSubgradientOracle μ f
        x̄ (fun n ω ↦ g n (x[n] ω) ω))
    (n : ℕ)
    (hm : stochasticIterateSigmaAlgebra (h_problem := h_problem) (g := g) (t := t) (x0 := x0) n ≤
      ‹MeasurableSpace Ω›)
    {xStar : E} (hxStar : xStar ∈ XStar) :
    μ[(fun ω ↦ inner ℝ (g n (x[n] ω) ω) (x̄[n] ω - xStar)) |
        stochasticIterateSigmaAlgebra
          (h_problem := h_problem) (g := g) (t := t) (x0 := x0) n] =ᵐ[μ]
      fun ω ↦
        inner ℝ
          (μ[fun ω ↦ g n (x[n] ω) ω |
            stochasticIterateSigmaAlgebra
              (h_problem := h_problem) (g := g) (t := t) (x0 := x0) n] ω)
          (x̄[n] ω - xStar) := by
  let gFun : Ω → E := fun ω ↦ g n (x[n] ω) ω
  let offset : Ω → E := fun ω ↦ x̄[n] ω - xStar
  have hg_ae : AEStronglyMeasurable gFun μ := by
    -- The oracle integrability hypothesis already supplies almost-everywhere measurability of the
    -- sampled stochastic subgradient.
    exact (h_oracle.integrable_subgradient n).aestronglyMeasurable
  have hoffset_ae : AEStronglyMeasurable offset μ := by
    -- The iterate itself is a.e. strongly measurable, and translating by `xStar` preserves that.
    exact
      (stochasticIterateAestronglyMeasurable
        (h_problem := h_problem) (g := g) (t := t) (x0 := x0) h_oracle n).sub
        aestronglyMeasurable_const
  have hg_memLp : MemLp gFun 2 μ := by
    -- The oracle's squared-norm integrability is exactly the `L²` membership criterion.
    exact (MeasureTheory.memLp_two_iff_integrable_sq_norm hg_ae).2
      (h_oracle.integrable_sqnorm_subgradient n)
  have hoffset_memLp : MemLp offset 2 μ := by
    -- The offset has integrable squared norm by the iterate square-distance bootstrap.
    simpa [offset] using
      (MeasureTheory.memLp_two_iff_integrable_sq_norm hoffset_ae).2
        (stochasticIterateSqdistIntegrable
          (h_problem := h_problem) (g := g) (t := t) (x0 := x0) h_oracle hxStar n)
  have hinner_lp :
      Integrable
        (fun ω ↦ inner ℝ ((hg_memLp.toLp gFun) ω) ((hoffset_memLp.toLp offset) ω)) μ := by
    -- The pointwise inner product of two `L²` functions is integrable.
    exact MeasureTheory.L2.integrable_inner (hg_memLp.toLp gFun) (hoffset_memLp.toLp offset)
  have hinner_eq :
      (fun ω ↦ inner ℝ ((hg_memLp.toLp gFun) ω) ((hoffset_memLp.toLp offset) ω)) =ᵐ[μ]
        fun ω ↦ inner ℝ (g n (x[n] ω) ω) (x̄[n] ω - xStar) := by
    filter_upwards [MemLp.coeFn_toLp hg_memLp, MemLp.coeFn_toLp hoffset_memLp] with ω hg hoffset
    simp [gFun, offset, hg, hoffset]
  have hinner_int :
      Integrable (fun ω ↦ inner ℝ (g n (x[n] ω) ω) (x̄[n] ω - xStar)) μ := by
    exact (integrable_congr hinner_eq).1 hinner_lp
  -- Pull the measurable iterate offset through the conditional expectation in one step.
  exact condexpInnerOfAestronglyMeasurableRight
    (iterateOffsetAestronglyMeasurableComap
      (h_problem := h_problem) (g := g) (t := t) (x0 := x0) h_oracle n hm)
    hinner_int
    (h_oracle.integrable_subgradient n)

/-- Helper for Theorem 8.35: the inner-product term in the projected-square expansion is
integrable because the stochastic subgradient and the iterate offset both belong to `L²`. -/
private lemma integrableInnerIterateOffset
    (h_oracle :
      StochasticProjectedSubgradientOracle μ f
        x̄ (fun n ω ↦ g n (x[n] ω) ω))
    (n : ℕ)
    {xStar : E} (hxStar : xStar ∈ XStar) :
    Integrable (fun ω ↦ inner ℝ (g n (x[n] ω) ω) (x̄[n] ω - xStar)) μ := by
  let gFun : Ω → E := fun ω ↦ g n (x[n] ω) ω
  let offset : Ω → E := fun ω ↦ x̄[n] ω - xStar
  have hg_ae : AEStronglyMeasurable gFun μ := by
    -- The oracle integrability hypothesis already supplies almost-everywhere measurability of the
    -- sampled stochastic subgradient.
    exact (h_oracle.integrable_subgradient n).aestronglyMeasurable
  have hoffset_ae : AEStronglyMeasurable offset μ := by
    -- The iterate itself is a.e. strongly measurable, and translating by `xStar` preserves that.
    exact
      (stochasticIterateAestronglyMeasurable
        (h_problem := h_problem) (g := g) (t := t) (x0 := x0) h_oracle n).sub
        aestronglyMeasurable_const
  have hg_memLp : MemLp gFun 2 μ := by
    -- The oracle's squared-norm integrability is exactly the `L²` membership criterion.
    exact (MeasureTheory.memLp_two_iff_integrable_sq_norm hg_ae).2
      (h_oracle.integrable_sqnorm_subgradient n)
  have hoffset_memLp : MemLp offset 2 μ := by
    -- The offset has integrable squared norm by the iterate square-distance bootstrap.
    simpa [offset] using
      (MeasureTheory.memLp_two_iff_integrable_sq_norm hoffset_ae).2
        (stochasticIterateSqdistIntegrable
          (h_problem := h_problem) (g := g) (t := t) (x0 := x0) h_oracle hxStar n)
  have hinner_lp :
      Integrable
        (fun ω ↦ inner ℝ ((hg_memLp.toLp gFun) ω) ((hoffset_memLp.toLp offset) ω)) μ := by
    -- The pointwise inner product of two `L²` functions is integrable.
    exact MeasureTheory.L2.integrable_inner (hg_memLp.toLp gFun) (hoffset_memLp.toLp offset)
  have hinner_eq :
      (fun ω ↦ inner ℝ ((hg_memLp.toLp gFun) ω) ((hoffset_memLp.toLp offset) ω)) =ᵐ[μ]
        fun ω ↦ inner ℝ (g n (x[n] ω) ω) (x̄[n] ω - xStar) := by
    filter_upwards [MemLp.coeFn_toLp hg_memLp, MemLp.coeFn_toLp hoffset_memLp] with ω hg hoffset
    simp [gFun, offset, hg, hoffset]
  exact (integrable_congr hinner_eq).1 hinner_lp

/-- Helper for Theorem 8.35: the oracle unbiasedness clause yields the optimality-gap lower
bound against an arbitrary optimal point. -/
private lemma aeCondexpInnerGeObjectiveGap
    (h_oracle :
      StochasticProjectedSubgradientOracle μ f
        x̄ (fun n ω ↦ g n (x[n] ω) ω))
    {xStar : E} (hxStar : xStar ∈ XStar) (n : ℕ) :
    ∀ᵐ ω ∂μ,
      f (x̄[n] ω) - fOpt ≤
        inner ℝ
          (μ[fun ω ↦ g n (x[n] ω) ω |
            stochasticIterateSigmaAlgebra
              (h_problem := h_problem) (g := g) (t := t) (x0 := x0) n] ω)
          (x̄[n] ω - xStar) := by
  have hunbiased :=
    (stochastic_projected_subgradient_unbiased_iff_ae_subgradient_inequality
      (μ := μ) (f := f) (x := x̄) (g := fun n ω ↦ g n (x[n] ω) ω) n).1 (h_oracle.unbiased n)
  have hxStar_eq : f xStar = fOpt := by
    simpa using optimal_point_toReal_eq_fOpt
      (f := fun x : E ↦ ((f x : ℝ) : EReal)) (h_problem := h_problem) hxStar
  -- Specialize the pointwise subgradient inequality at the optimal point `xStar`.
  filter_upwards [hunbiased] with ω hω
  have hpoint := hω xStar
  have hinner_neg :
      inner ℝ
          (μ[fun ω ↦ g n (x[n] ω) ω |
            stochasticIterateSigmaAlgebra
              (h_problem := h_problem) (g := g) (t := t) (x0 := x0) n] ω)
          (xStar - x̄[n] ω) =
        -inner ℝ
          (μ[fun ω ↦ g n (x[n] ω) ω |
            stochasticIterateSigmaAlgebra
              (h_problem := h_problem) (g := g) (t := t) (x0 := x0) n] ω)
          (x̄[n] ω - xStar) := by
    rw [show xStar - x̄[n] ω = -(x̄[n] ω - xStar) by abel, inner_neg_right]
  nlinarith [hpoint, hinner_neg, hxStar_eq]

/-- Helper for Theorem 8.35: if the iterate-generated sigma-algebra is not below the ambient
sigma-algebra at step `n`, then the `n`th iterate already attains the optimal value almost
surely. -/
private lemma objectiveGapAeEqZero_of_notMeasurableSigma
    (h_oracle :
      StochasticProjectedSubgradientOracle μ f
        x̄ (fun n ω ↦ g n (x[n] ω) ω))
    {xStar : E} (hxStar : xStar ∈ XStar) {n : ℕ}
    (hm :
      ¬ stochasticIterateSigmaAlgebra
          (h_problem := h_problem) (g := g) (t := t) (x0 := x0) n ≤
        ‹MeasurableSpace Ω›) :
    ∀ᵐ ω ∂μ, f (x̄[n] ω) - fOpt = 0 := by
  have hsupport :=
    aeCondexpInnerGeObjectiveGap
      (h_problem := h_problem) (g := g) (t := t) (x0 := x0) h_oracle hxStar n
  have hcond_zero :
      μ[fun ω ↦ g n (x[n] ω) ω |
        stochasticIterateSigmaAlgebra
          (h_problem := h_problem) (g := g) (t := t) (x0 := x0) n] = 0 := by
    exact MeasureTheory.condExp_of_not_le hm
  -- The degenerate conditional expectation forces the objective gap to vanish almost surely.
  filter_upwards [hsupport] with ω hω
  have hgap_nonneg :
      0 ≤ f (x̄[n] ω) - fOpt := by
    exact feasibleObjectiveGap_nonneg
      (h_problem := h_problem) (f := f) (x[n] ω).property
  have hgap_nonpos : f (x̄[n] ω) - fOpt ≤ 0 := by
    simpa [hcond_zero] using hω
  linarith

/-- Helper for Theorem 8.35: if a tail interval contains a nonmeasurable sigma-algebra branch,
then the running-best objective gap up to the end of that tail already vanishes almost surely. -/
private lemma bestAchievedGapAeEqZero_of_badTailSigma
    (h_oracle :
      StochasticProjectedSubgradientOracle μ f
        x̄ (fun n ω ↦ g n (x[n] ω) ω))
    {xStar : E} (hxStar : xStar ∈ XStar) {m k : ℕ} (hmk : m ≤ k)
    (hbad :
      ∃ n ∈ Finset.Icc m k,
        ¬ stochasticIterateSigmaAlgebra
            (h_problem := h_problem) (g := g) (t := t) (x0 := x0) n ≤
          ‹MeasurableSpace Ω›) :
    ∀ᵐ ω ∂μ, best_achieved_function_value f (fun j ↦ (x[j] ω : E)) k - fOpt = 0 := by
  rcases hbad with ⟨n, hn, hnot_le⟩
  have hiterate_zero :=
    objectiveGapAeEqZero_of_notMeasurableSigma
      (h_problem := h_problem) (g := g) (t := t) (x0 := x0) h_oracle hxStar hnot_le
  -- Compare the running minimum with the witness iterate whose gap already vanishes a.e.
  filter_upwards [hiterate_zero] with ω hω
  have hbest_nonneg :
      0 ≤ best_achieved_function_value f (fun j ↦ (x[j] ω : E)) k - fOpt :=
    bestAchievedObjectiveGap_nonneg
      (h_problem := h_problem) (g := g) (t := t) (x0 := x0) (f := f) k ω
  have hn_range : n ∈ Finset.range (k + 1) := by
    exact Finset.mem_range.mpr (Nat.lt_succ_of_le (Finset.mem_Icc.mp hn).2)
  have hbest_le :
      best_achieved_function_value f (fun j ↦ (x[j] ω : E)) k ≤ f (x[n] ω : E) :=
    best_achieved_function_value_le_objective_value
      f (fun j ↦ (x[j] ω : E)) k n hn_range
  have hbest_nonpos :
      best_achieved_function_value f (fun j ↦ (x[j] ω : E)) k - fOpt ≤ 0 := by
    have hiterate_eq : f (x[n] ω : E) - fOpt = 0 := by
      simpa using hω
    linarith
  linarith

/-- Helper for Theorem 8.35: conditioning the raw projected-square expansion on the sigma-algebra
generated by the current iterate only changes the stochastic subgradient terms. -/
private lemma condexpProjectedSqdistStepRhsEq
    (h_oracle :
      StochasticProjectedSubgradientOracle μ f
        x̄ (fun n ω ↦ g n (x[n] ω) ω))
    (n : ℕ)
    (hm : stochasticIterateSigmaAlgebra (h_problem := h_problem) (g := g) (t := t) (x0 := x0) n ≤
      ‹MeasurableSpace Ω›)
    {xStar : E} (hxStar : xStar ∈ XStar) :
    μ[(fun ω ↦
        ‖x̄[n] ω - xStar‖ ^ (2 : ℕ) -
          2 * t n * inner ℝ (g n (x[n] ω) ω) (x̄[n] ω - xStar) +
          (t n) ^ (2 : ℕ) * ‖g n (x[n] ω) ω‖ ^ (2 : ℕ)) |
        stochasticIterateSigmaAlgebra
          (h_problem := h_problem) (g := g) (t := t) (x0 := x0) n] =ᵐ[μ]
      fun ω ↦
        ‖x̄[n] ω - xStar‖ ^ (2 : ℕ) -
          2 * t n *
            inner ℝ
              (μ[fun ω ↦ g n (x[n] ω) ω |
                stochasticIterateSigmaAlgebra
                  (h_problem := h_problem) (g := g) (t := t) (x0 := x0) n] ω)
              (x̄[n] ω - xStar) +
          (t n) ^ (2 : ℕ) *
            μ[(fun ω ↦ ‖g n (x[n] ω) ω‖ ^ (2 : ℕ)) |
              stochasticIterateSigmaAlgebra
                (h_problem := h_problem) (g := g) (t := t) (x0 := x0) n] ω := by
  let sqdist : Ω → ℝ := fun ω ↦ ‖x̄[n] ω - xStar‖ ^ (2 : ℕ)
  let innerTerm : Ω → ℝ := fun ω ↦ inner ℝ (g n (x[n] ω) ω) (x̄[n] ω - xStar)
  let sqnorm : Ω → ℝ := fun ω ↦ ‖g n (x[n] ω) ω‖ ^ (2 : ℕ)
  have hsqdist_int : Integrable sqdist μ := by
    -- The current squared distance is integrable by the earlier iterate bootstrap.
    simpa [sqdist] using
      stochasticIterateSqdistIntegrable
        (h_problem := h_problem) (g := g) (t := t) (x0 := x0) h_oracle hxStar n
  have hinner_int : Integrable innerTerm μ := by
    -- The inner-product term is integrable because both factors are in `L²`.
    simpa [innerTerm] using
      integrableInnerIterateOffset
        (h_problem := h_problem) (g := g) (t := t) (x0 := x0) h_oracle n hxStar
  have hsqnorm_int : Integrable sqnorm μ := by
    -- The oracle already records integrability of the squared norm of the sampled subgradient.
    simpa [sqnorm] using h_oracle.integrable_sqnorm_subgradient n
  have hsqdist_ce :
      μ[sqdist |
          stochasticIterateSigmaAlgebra
            (h_problem := h_problem) (g := g) (t := t) (x0 := x0) n] =ᵐ[μ]
        sqdist := by
    -- The squared-distance term depends only on the current iterate, so conditioning fixes it.
    exact condexpIterateScalarCompEqSelf
      (h_problem := h_problem) (g := g) (t := t) (x0 := x0) h_oracle
      ((continuous_norm.comp (continuous_id.sub continuous_const)).pow 2)
      n hm hsqdist_int
  have hinner_ce :
      μ[innerTerm |
          stochasticIterateSigmaAlgebra
            (h_problem := h_problem) (g := g) (t := t) (x0 := x0) n] =ᵐ[μ]
        fun ω ↦
          inner ℝ
            (μ[fun ω ↦ g n (x[n] ω) ω |
              stochasticIterateSigmaAlgebra
                (h_problem := h_problem) (g := g) (t := t) (x0 := x0) n] ω)
            (x̄[n] ω - xStar) := by
    -- Pull the current-iterate offset through the conditional expectation of the inner product.
    simpa [innerTerm] using
      condexpInnerIterateOffsetComapPullout
        (h_problem := h_problem) (g := g) (t := t) (x0 := x0) h_oracle n hm hxStar
  have hscaled_inner_ce :
      μ[(fun ω ↦ (2 * t n) * innerTerm ω) |
          stochasticIterateSigmaAlgebra
            (h_problem := h_problem) (g := g) (t := t) (x0 := x0) n] =ᵐ[μ]
        fun ω ↦
          (2 * t n) *
            inner ℝ
              (μ[fun ω ↦ g n (x[n] ω) ω |
                stochasticIterateSigmaAlgebra
                  (h_problem := h_problem) (g := g) (t := t) (x0 := x0) n] ω)
              (x̄[n] ω - xStar) := by
    -- The deterministic scalar `2 * t n` commutes with conditional expectation.
    refine (MeasureTheory.condExp_smul (2 * t n) innerTerm
      (stochasticIterateSigmaAlgebra
        (h_problem := h_problem) (g := g) (t := t) (x0 := x0) n)).trans ?_
    filter_upwards [hinner_ce] with ω hω
    simp [hω]
  have hscaled_sqnorm_ce :
      μ[(fun ω ↦ (t n) ^ (2 : ℕ) * sqnorm ω) |
          stochasticIterateSigmaAlgebra
            (h_problem := h_problem) (g := g) (t := t) (x0 := x0) n] =ᵐ[μ]
        fun ω ↦
          (t n) ^ (2 : ℕ) *
            μ[sqnorm |
              stochasticIterateSigmaAlgebra
                (h_problem := h_problem) (g := g) (t := t) (x0 := x0) n] ω := by
    -- The squared-norm term is another deterministic scalar multiple.
    refine (MeasureTheory.condExp_smul ((t n) ^ (2 : ℕ)) sqnorm
      (stochasticIterateSigmaAlgebra
        (h_problem := h_problem) (g := g) (t := t) (x0 := x0) n)).trans ?_
    filter_upwards with ω
    simp
  have hsub_ce :
      μ[(fun ω ↦ sqdist ω - (2 * t n) * innerTerm ω) |
          stochasticIterateSigmaAlgebra
            (h_problem := h_problem) (g := g) (t := t) (x0 := x0) n] =ᵐ[μ]
        fun ω ↦
          sqdist ω -
            (2 * t n) *
              inner ℝ
                (μ[fun ω ↦ g n (x[n] ω) ω |
                  stochasticIterateSigmaAlgebra
                    (h_problem := h_problem) (g := g) (t := t) (x0 := x0) n] ω)
                (x̄[n] ω - xStar) := by
    -- Normalize the difference `sqdist - 2 t_n innerTerm` before adding the squared norm term.
    exact (MeasureTheory.condExp_sub hsqdist_int (hinner_int.const_mul (2 * t n))
      (stochasticIterateSigmaAlgebra
        (h_problem := h_problem) (g := g) (t := t) (x0 := x0) n)).trans
        (hsqdist_ce.sub hscaled_inner_ce)
  -- Combine the normalized difference with the conditioned squared-norm term.
  calc
    μ[(fun ω ↦
        ‖x̄[n] ω - xStar‖ ^ (2 : ℕ) -
          2 * t n * inner ℝ (g n (x[n] ω) ω) (x̄[n] ω - xStar) +
          (t n) ^ (2 : ℕ) * ‖g n (x[n] ω) ω‖ ^ (2 : ℕ)) |
        stochasticIterateSigmaAlgebra
          (h_problem := h_problem) (g := g) (t := t) (x0 := x0) n] =ᵐ[μ]
      μ[(fun ω ↦ sqdist ω - (2 * t n) * innerTerm ω + (t n) ^ (2 : ℕ) * sqnorm ω) |
        stochasticIterateSigmaAlgebra (h_problem := h_problem) (g := g) (t := t) (x0 := x0) n] := by
          exact MeasureTheory.condExp_congr_ae <| Filter.Eventually.of_forall fun ω ↦ by
            simp [sqdist, innerTerm, sqnorm]
    _ =ᵐ[μ]
      (fun ω ↦
          sqdist ω -
            (2 * t n) *
              inner ℝ
                (μ[fun ω ↦ g n (x[n] ω) ω |
                  stochasticIterateSigmaAlgebra
                    (h_problem := h_problem) (g := g) (t := t) (x0 := x0) n] ω)
                (x̄[n] ω - xStar) +
          (t n) ^ (2 : ℕ) *
            μ[sqnorm |
              stochasticIterateSigmaAlgebra
                (h_problem := h_problem) (g := g) (t := t) (x0 := x0) n] ω) := by
          exact (MeasureTheory.condExp_add
            (hsqdist_int.sub (hinner_int.const_mul (2 * t n)))
            (hsqnorm_int.const_mul ((t n) ^ (2 : ℕ)))
            _).trans
            (hsub_ce.add hscaled_sqnorm_ce)
    _ =ᵐ[μ]
      fun ω ↦
        ‖x̄[n] ω - xStar‖ ^ (2 : ℕ) -
          2 * t n *
            inner ℝ
              (μ[fun ω ↦ g n (x[n] ω) ω |
                stochasticIterateSigmaAlgebra
                  (h_problem := h_problem) (g := g) (t := t) (x0 := x0) n] ω)
              (x̄[n] ω - xStar) +
          (t n) ^ (2 : ℕ) *
            μ[(fun ω ↦ ‖g n (x[n] ω) ω‖ ^ (2 : ℕ)) |
              stochasticIterateSigmaAlgebra
                (h_problem := h_problem) (g := g) (t := t) (x0 := x0) n] ω := by
          exact Filter.Eventually.of_forall fun ω ↦ by
            simp [sqdist, sqnorm]

/-- Helper for Theorem 8.35: on the measurable branch, one stochastic projection step gives the
integrated expected-gap inequality used in the interval telescope. -/
private lemma expectedObjectiveGapStepWithRemainder_le_of_measurableSigma
    (h_stepsize_nonneg : ∀ n, 0 ≤ t n)
    (h_oracle :
      StochasticProjectedSubgradientOracle μ f
        x̄ (fun n ω ↦ g n (x[n] ω) ω))
    {xStar : E} (hxStar : xStar ∈ XStar) (n : ℕ)
    (hm : stochasticIterateSigmaAlgebra (h_problem := h_problem) (g := g) (t := t) (x0 := x0) n ≤
      ‹MeasurableSpace Ω›) :
    2 * t n * (μ[fun ω ↦ f (x̄[n] ω)] - fOpt) +
        μ[fun ω ↦ ‖x̄[n + 1] ω - xStar‖ ^ (2 : ℕ)] ≤
      μ[fun ω ↦ ‖x̄[n] ω - xStar‖ ^ (2 : ℕ)] +
        h_oracle.L_tilde_f ^ (2 : ℕ) * (t n) ^ (2 : ℕ) := by
  let sqdist : Ω → ℝ := fun ω ↦ ‖x̄[n] ω - xStar‖ ^ (2 : ℕ)
  let sqdistNext : Ω → ℝ := fun ω ↦ ‖x̄[n + 1] ω - xStar‖ ^ (2 : ℕ)
  let gapFun : Ω → ℝ := fun ω ↦ f (x̄[n] ω) - fOpt
  let rawRhs : Ω → ℝ := fun ω ↦
    ‖x̄[n] ω - xStar‖ ^ (2 : ℕ) -
      2 * t n * inner ℝ (g n (x[n] ω) ω) (x̄[n] ω - xStar) +
      (t n) ^ (2 : ℕ) * ‖g n (x[n] ω) ω‖ ^ (2 : ℕ)
  let upperRhs : Ω → ℝ := fun ω ↦
    ‖x̄[n] ω - xStar‖ ^ (2 : ℕ) - 2 * t n * (f (x̄[n] ω) - fOpt) +
      (t n) ^ (2 : ℕ) * h_oracle.L_tilde_f ^ (2 : ℕ)
  have hsqdist_int : Integrable sqdist μ := by
    -- The current squared distance is integrable from the iterate bootstrap.
    simpa [sqdist] using
      stochasticIterateSqdistIntegrable
        (h_problem := h_problem) (g := g) (t := t) (x0 := x0) h_oracle hxStar n
  have hsqdistNext_int : Integrable sqdistNext μ := by
    -- The next-step squared distance is integrable for the same reason.
    simpa [sqdistNext] using
      stochasticIterateSqdistIntegrable
        (h_problem := h_problem) (g := g) (t := t) (x0 := x0) h_oracle hxStar (n + 1)
  have hinner_int :
      Integrable (fun ω ↦ inner ℝ (g n (x[n] ω) ω) (x̄[n] ω - xStar)) μ := by
    -- The stochastic subgradient and iterate offset both lie in `L²`.
    exact integrableInnerIterateOffset
      (h_problem := h_problem) (g := g) (t := t) (x0 := x0) h_oracle n hxStar
  have hrawRhs_int : Integrable rawRhs μ := by
    -- Every term in the raw projected-square expansion is integrable.
    simpa [rawRhs] using
      hsqdist_int.sub (hinner_int.const_mul (2 * t n)) |>.add
        ((h_oracle.integrable_sqnorm_subgradient n).const_mul ((t n) ^ (2 : ℕ)))
  have hgap_int : Integrable gapFun μ := by
    -- On the measurable branch, dominate the nonnegative objective gap by the pulled-out
    -- conditional inner-product term.
    let innerCond : Ω → ℝ := fun ω ↦
      inner ℝ
        ((μ[fun ω ↦ g n (x[n] ω) ω |
            stochasticIterateSigmaAlgebra
              (h_problem := h_problem) (g := g) (t := t) (x0 := x0) n]) ω)
        (x̄[n] ω - xStar)
    have hsupport :=
      aeCondexpInnerGeObjectiveGap
        (h_problem := h_problem) (g := g) (t := t) (x0 := x0) h_oracle hxStar n
    have hinnerCond_int : Integrable innerCond μ := by
      have hcond_int :
          Integrable
            (μ[fun ω ↦ inner ℝ (g n (x[n] ω) ω) (x̄[n] ω - xStar) |
              stochasticIterateSigmaAlgebra
                (h_problem := h_problem) (g := g) (t := t) (x0 := x0) n]) μ := by
        exact MeasureTheory.integrable_condExp
      have hinnerCond_eq :
          innerCond =ᵐ[μ]
            μ[fun ω ↦ inner ℝ (g n (x[n] ω) ω) (x̄[n] ω - xStar) |
              stochasticIterateSigmaAlgebra
                (h_problem := h_problem) (g := g) (t := t) (x0 := x0) n] := by
        simpa [innerCond] using
          (condexpInnerIterateOffsetComapPullout
            (h_problem := h_problem) (g := g) (t := t) (x0 := x0) h_oracle n hm hxStar).symm
      exact hcond_int.congr hinnerCond_eq.symm
    have hgap_aemeas : AEMeasurable gapFun μ := by
      exact
        ((objectiveMeasurable (h_problem := h_problem) (f := f)).comp_aemeasurable
          (stochasticIterateAestronglyMeasurable
            (h_problem := h_problem) (g := g) (t := t) (x0 := x0) h_oracle n).aemeasurable).sub
          aemeasurable_const
    have hdom : ∀ᵐ ω ∂μ, ‖gapFun ω‖ ≤ innerCond ω := by
      filter_upwards [hsupport] with ω hω
      have hgap_nonneg : 0 ≤ gapFun ω := by
        simpa [gapFun] using
          feasibleObjectiveGap_nonneg
            (h_problem := h_problem) (f := f) (x[n] ω).property
      have hgap_le : gapFun ω ≤ innerCond ω := by
        dsimp [gapFun, innerCond] at *
        linarith
      rw [Real.norm_of_nonneg hgap_nonneg]
      exact hgap_le
    exact Integrable.mono' hinnerCond_int hgap_aemeas.aestronglyMeasurable hdom
  have hupperRhs_int : Integrable upperRhs μ := by
    -- The simplified upper bound is the sum of an integrable gap term and a constant.
    simpa [upperRhs] using
      hsqdist_int.sub (hgap_int.const_mul (2 * t n)) |>.add
        (integrable_const (((t n) ^ (2 : ℕ)) * h_oracle.L_tilde_f ^ (2 : ℕ) : ℝ))
  have hmono :
      μ[sqdistNext |
          stochasticIterateSigmaAlgebra
            (h_problem := h_problem) (g := g) (t := t) (x0 := x0) n] ≤ᵐ[μ]
        μ[rawRhs |
          stochasticIterateSigmaAlgebra
            (h_problem := h_problem) (g := g) (t := t) (x0 := x0) n] := by
    -- Condition the pathwise projected-square inequality.
    refine MeasureTheory.condExp_mono hsqdistNext_int hrawRhs_int ?_
    exact Filter.Eventually.of_forall fun ω ↦ by
      simpa [sqdistNext, rawRhs] using
        projectedSqdistStepPointwise
          (h_problem := h_problem) (g := g) (t := t) (x0 := x0) hxStar n ω
  have hcond_bound :
      ∀ᵐ ω ∂μ,
        μ[sqdistNext |
            stochasticIterateSigmaAlgebra
              (h_problem := h_problem) (g := g) (t := t) (x0 := x0) n] ω ≤
          upperRhs ω := by
    have hrhs_eq :=
      condexpProjectedSqdistStepRhsEq
        (h_problem := h_problem) (g := g) (t := t) (x0 := x0) h_oracle n hm hxStar
    have hsupport :=
      aeCondexpInnerGeObjectiveGap
        (h_problem := h_problem) (g := g) (t := t) (x0 := x0) h_oracle hxStar n
    filter_upwards [hmono, hrhs_eq, hsupport, h_oracle.sqnorm_condexp_le n] with ω
        hωmono hωrhs hωsupport hωsqnorm
    have hstep :
        μ[sqdistNext |
            stochasticIterateSigmaAlgebra
              (h_problem := h_problem) (g := g) (t := t) (x0 := x0) n] ω ≤
          ‖x̄[n] ω - xStar‖ ^ (2 : ℕ) -
            2 * t n *
              inner ℝ
                (μ[fun ω ↦ g n (x[n] ω) ω |
                    stochasticIterateSigmaAlgebra
                      (h_problem := h_problem) (g := g) (t := t) (x0 := x0) n] ω)
                (x̄[n] ω - xStar) +
            (t n) ^ (2 : ℕ) *
              μ[(fun ω ↦ ‖g n (x[n] ω) ω‖ ^ (2 : ℕ)) |
                stochasticIterateSigmaAlgebra
                  (h_problem := h_problem) (g := g) (t := t) (x0 := x0) n] ω := by
      exact hωrhs ▸ hωmono
    have hωsqnorm' :
        (μ[(fun ω ↦ ‖g n (x[n] ω) ω‖ ^ (2 : ℕ)) |
            stochasticIterateSigmaAlgebra
              (h_problem := h_problem) (g := g) (t := t) (x0 := x0) n] ω) ≤
          h_oracle.L_tilde_f ^ (2 : ℕ) := by
      simpa using hωsqnorm
    have ht_nonneg : 0 ≤ t n := h_stepsize_nonneg n
    have ht_sq_nonneg : 0 ≤ (t n) ^ (2 : ℕ) := by positivity
    have hL_sq_nonneg : 0 ≤ h_oracle.L_tilde_f ^ (2 : ℕ) := by positivity
    have hsqdist_nonneg : 0 ≤ ‖x̄[n] ω - xStar‖ ^ (2 : ℕ) := by positivity
    nlinarith [hstep, hωsupport, hωsqnorm']
  have hcond_int :
      Integrable
        (μ[sqdistNext |
          stochasticIterateSigmaAlgebra
            (h_problem := h_problem) (g := g) (t := t) (x0 := x0) n]) μ := by
    -- Conditional expectation preserves integrability of the next-step distance.
    exact MeasureTheory.integrable_condExp
  have hintegral_le :
      MeasureTheory.integral μ
          (μ[sqdistNext |
            stochasticIterateSigmaAlgebra
              (h_problem := h_problem) (g := g) (t := t) (x0 := x0) n]) ≤
        MeasureTheory.integral μ upperRhs := by
    -- Integrate the almost-everywhere conditional inequality.
    exact MeasureTheory.integral_mono_ae hcond_int hupperRhs_int hcond_bound
  have hgap_value :
      μ[fun ω ↦ f (x̄[n] ω)] - fOpt = MeasureTheory.integral μ gapFun := by
    -- Rewrite the expected objective gap as the integral of the pointwise gap function.
    have hobj_int :
        Integrable (fun ω ↦ f (x̄[n] ω)) μ := by
      simpa [gapFun, sub_eq_add_neg, add_assoc, add_left_comm, add_comm] using
        hgap_int.add (integrable_const fOpt)
    simpa [gapFun] using
      expectationSub_eq_integral_sub_const
        (μ := μ) (φ := fun ω ↦ f (x̄[n] ω)) hobj_int fOpt
  let scaledGap : Ω → ℝ := fun ω ↦ (2 * t n) * gapFun ω
  have hscaledGap_int : Integrable scaledGap μ := by
    simpa [scaledGap] using hgap_int.const_mul (2 * t n)
  have hsqdistSub_scaledGap_int :
      Integrable (fun ω ↦ sqdist ω - scaledGap ω) μ := by
    exact hsqdist_int.sub hscaledGap_int
  have hupper_integral :
      MeasureTheory.integral μ upperRhs =
        μ[fun ω ↦ ‖x̄[n] ω - xStar‖ ^ (2 : ℕ)] -
          2 * t n * (μ[fun ω ↦ f (x̄[n] ω)] - fOpt) +
          (t n) ^ (2 : ℕ) * h_oracle.L_tilde_f ^ (2 : ℕ) := by
    -- Evaluate the integral of the simplified upper bound term by term.
    have hscaled_gap :
        MeasureTheory.integral μ scaledGap =
          2 * t n * (μ[fun ω ↦ f (x̄[n] ω)] - fOpt) := by
      rw [show scaledGap = fun ω ↦ (2 * t n) * gapFun ω by rfl]
      rw [integral_const_mul, hgap_value.symm]
    calc
      MeasureTheory.integral μ upperRhs
          = MeasureTheory.integral μ
              (fun ω ↦
                sqdist ω - scaledGap ω +
                  ((t n) ^ (2 : ℕ) * h_oracle.L_tilde_f ^ (2 : ℕ))) := by
                simp [upperRhs, sqdist, gapFun, scaledGap]
      _ = MeasureTheory.integral μ sqdist -
            MeasureTheory.integral μ scaledGap +
            MeasureTheory.integral μ
              (fun _ : Ω ↦ (t n) ^ (2 : ℕ) * h_oracle.L_tilde_f ^ (2 : ℕ)) := by
              rw [integral_add hsqdistSub_scaledGap_int (integrable_const _),
                integral_sub hsqdist_int hscaledGap_int]
      _ =
          μ[fun ω ↦ ‖x̄[n] ω - xStar‖ ^ (2 : ℕ)] -
            2 * t n * (μ[fun ω ↦ f (x̄[n] ω)] - fOpt) +
            (t n) ^ (2 : ℕ) * h_oracle.L_tilde_f ^ (2 : ℕ) := by
              rw [hscaled_gap, integral_const]
              simp [sqdist]
  have hmain :
      μ[fun ω ↦ ‖x̄[n + 1] ω - xStar‖ ^ (2 : ℕ)] ≤
        μ[fun ω ↦ ‖x̄[n] ω - xStar‖ ^ (2 : ℕ)] -
          2 * t n * (μ[fun ω ↦ f (x̄[n] ω)] - fOpt) +
          (t n) ^ (2 : ℕ) * h_oracle.L_tilde_f ^ (2 : ℕ) := by
    calc
      μ[fun ω ↦ ‖x̄[n + 1] ω - xStar‖ ^ (2 : ℕ)]
          = MeasureTheory.integral μ
              (μ[sqdistNext |
                stochasticIterateSigmaAlgebra
                  (h_problem := h_problem) (g := g) (t := t) (x0 := x0) n]) := by
              simpa [sqdistNext] using
                (MeasureTheory.integral_condExp
                  (μ := μ)
                  (m :=
                    stochasticIterateSigmaAlgebra
                      (h_problem := h_problem) (g := g) (t := t) (x0 := x0) n)
                  (hm := hm) (f := sqdistNext)).symm
      _ ≤ MeasureTheory.integral μ upperRhs := hintegral_le
      _ =
          μ[fun ω ↦ ‖x̄[n] ω - xStar‖ ^ (2 : ℕ)] -
            2 * t n * (μ[fun ω ↦ f (x̄[n] ω)] - fOpt) +
            (t n) ^ (2 : ℕ) * h_oracle.L_tilde_f ^ (2 : ℕ) := hupper_integral
  nlinarith [hmain]

/-- Helper for Theorem 8.35: every positive-stepsize prefix sum `∑_{n=0}^k t n` is strictly
positive. -/
private lemma positiveStepsizePrefixSum_pos
    (h_stepsize_pos : stochastic_projected_subgradient_stepsizes_positive t) (k : ℕ) :
    0 < Finset.sum (Finset.range (k + 1)) (fun n ↦ t n) := by
  -- The initial positive stepsize already appears in every nonempty prefix sum.
  have hmem : 0 ∈ Finset.range (k + 1) := by
    simp
  have hle :
      t 0 ≤ Finset.sum (Finset.range (k + 1)) (fun n ↦ t n) := by
    simpa using
      (Finset.single_le_sum (fun n _ ↦ le_of_lt (h_stepsize_pos n)) hmem)
  exact lt_of_lt_of_le (h_stepsize_pos 0) hle

/-- Helper for Theorem 8.35: if `∑_{n=0}^k t_n^2 / ∑_{n=0}^k t_n → 0` and all `t_n` are
positive, then the prefix sums `∑_{n=0}^k t_n` tend to `+∞`. -/
private lemma stepsizePrefixSumTendstoAtTopOfRatioTendstoZero
    (h_stepsize_pos : stochastic_projected_subgradient_stepsizes_positive t)
    (h_ratio :
      Filter.Tendsto
        (fun k ↦
          (Finset.sum (Finset.range (k + 1)) fun n ↦ (t n) ^ (2 : ℕ)) /
            Finset.sum (Finset.range (k + 1)) fun n ↦ t n)
        Filter.atTop (nhds 0)) :
    Filter.Tendsto
      (fun k ↦ Finset.sum (Finset.range (k + 1)) fun n ↦ t n)
      Filter.atTop Filter.atTop := by
  let S : ℕ → ℝ := fun k ↦ Finset.sum (Finset.range (k + 1)) (fun n ↦ t n)
  let Q : ℕ → ℝ := fun k ↦ Finset.sum (Finset.range (k + 1)) (fun n ↦ (t n) ^ (2 : ℕ))
  have hS_pos : ∀ k, 0 < S k := by
    -- Every prefix contains the positive first stepsize.
    intro k
    exact positiveStepsizePrefixSum_pos (t := t) h_stepsize_pos k
  have hS_mono : Monotone S := by
    -- Adding the next positive stepsize keeps prefix sums monotone.
    refine monotone_nat_of_le_succ ?_
    intro k
    have hsucc : S (k + 1) = S k + t (k + 1) := by
      simp [S, Finset.sum_range_succ]
    calc
      S k ≤ S k + t (k + 1) := by
        exact le_add_of_nonneg_right (le_of_lt (h_stepsize_pos (k + 1)))
      _ = S (k + 1) := hsucc.symm
  refine Filter.tendsto_atTop.2 ?_
  intro b
  by_cases hb : b < S 0
  · exact
      (Filter.eventually_ge_atTop 0).mono fun n hn ↦
        le_trans (le_of_lt hb) (hS_mono hn)
  · have hS0_le_b : S 0 ≤ b := le_of_not_gt hb
    have hexists : ∃ N, b ≤ S N := by
      by_contra hbounded
      push Not at hbounded
      have hbound : ∀ k, S k ≤ b := by
        intro k
        exact le_of_lt (hbounded k)
      have hb_pos : 0 < b := lt_of_lt_of_le (hS_pos 0) hS0_le_b
      let c : ℝ := (t 0) ^ (2 : ℕ) / b
      have hc_pos : 0 < c := by
        dsimp [c]
        have ht_sq_pos : 0 < (t 0) ^ (2 : ℕ) := by
          simpa [pow_two] using sq_pos_of_pos (h_stepsize_pos 0)
        exact div_pos ht_sq_pos hb_pos
      have hratio_lower : ∀ k, c ≤ Q k / S k := by
        intro k
        have hQ_lower :
            (t 0) ^ (2 : ℕ) ≤ Q k := by
          have hmem : 0 ∈ Finset.range (k + 1) := by
            simp
          simpa [Q] using
            (Finset.single_le_sum (fun n _ ↦ sq_nonneg (t n)) hmem)
        have hQ_nonneg : 0 ≤ Q k := by
          simpa [Q] using Finset.sum_nonneg (fun n _ ↦ sq_nonneg (t n))
        calc
          c = (t 0) ^ (2 : ℕ) / b := by
            rfl
          _ ≤ Q k / b := by
            exact (div_le_div_iff_of_pos_right hb_pos).2 hQ_lower
          _ ≤ Q k / S k := by
            exact div_le_div_of_nonneg_left hQ_nonneg (hS_pos k) (hbound k)
      have hc_le_zero : c ≤ 0 := by
        have hratio' :
            Filter.Tendsto (fun k ↦ Q k / S k) Filter.atTop (nhds 0) := by
          simpa [S, Q] using h_ratio
        exact
          le_of_tendsto_of_tendsto tendsto_const_nhds hratio'
            (Filter.Eventually.of_forall hratio_lower)
      exact (not_le_of_gt hc_pos) hc_le_zero
    rcases hexists with ⟨N, hN⟩
    exact (Filter.eventually_ge_atTop N).mono fun n hn ↦ le_trans hN (hS_mono hn)

/-- Helper for Theorem 8.35: extending a prefix by one iterate updates the running best value by
taking the minimum with the new objective value. -/
private lemma bestAchievedFunctionValue_succ
    (xSeq : ℕ → E) (k : ℕ) :
    best_achieved_function_value f xSeq (k + 1) =
      min (best_achieved_function_value f xSeq k) (f (xSeq (k + 1))) := by
  -- Rewrite the enlarged prefix as the old prefix plus the new objective value.
  simp [best_achieved_function_value, Finset.range_add_one, min_comm]

/-- Helper for Theorem 8.35: the running best objective value process is almost surely strongly
measurable. -/
private lemma bestAchievedAestronglyMeasurable
    (h_oracle :
      StochasticProjectedSubgradientOracle μ f
        x̄ (fun n ω ↦ g n (x[n] ω) ω))
    (k : ℕ) :
    AEStronglyMeasurable
      (fun ω ↦ best_achieved_function_value f (fun n ↦ (x[n] ω : E)) k) μ := by
  induction k with
  | zero =>
      -- At time `0`, the running best is just the objective value of the initial iterate.
      exact
        ((objectiveMeasurable (h_problem := h_problem) (f := f)).comp_aemeasurable
          (stochasticIterateAestronglyMeasurable
            (h_problem := h_problem) (g := g) (t := t) (x0 := x0) h_oracle 0).aemeasurable
        ).aestronglyMeasurable
  | succ k hk =>
      -- Route correction: use the binary `min` recurrence instead of unfolding a finite minimum.
      have hsucc :
          (fun ω ↦ best_achieved_function_value f (fun n ↦ (x[n] ω : E)) (k + 1)) =
            fun ω ↦
              min
                (best_achieved_function_value f (fun n ↦ (x[n] ω : E)) k)
                (f (x̄[k + 1] ω)) := by
        funext ω
        simpa using
          bestAchievedFunctionValue_succ
            (f := f) (xSeq := fun n ↦ (x[n] ω : E)) k
      rw [hsucc]
      exact
        ((hk.aemeasurable).min <|
          (objectiveMeasurable (h_problem := h_problem) (f := f)).comp_aemeasurable
            (stochasticIterateAestronglyMeasurable
              (h_problem := h_problem) (g := g) (t := t) (x0 := x0) h_oracle (k + 1)
            ).aemeasurable).aestronglyMeasurable

/-- Helper for Theorem 8.35: every nonempty interval sum of positive stepsizes is strictly
positive. -/
private lemma positiveStepsizeIntervalSum_pos
    (h_stepsize_pos : stochastic_projected_subgradient_stepsizes_positive t)
    (a m : ℕ) :
    0 < Finset.sum (Finset.Icc a (a + m)) (fun n ↦ t n) := by
  -- The left endpoint `a` already contributes a positive term to the interval sum.
  have hmem : a ∈ Finset.Icc a (a + m) := by simp
  have hle :
      t a ≤ Finset.sum (Finset.Icc a (a + m)) (fun n ↦ t n) := by
    simpa using
      (Finset.single_le_sum (fun n _ ↦ le_of_lt (h_stepsize_pos n)) hmem)
  exact lt_of_lt_of_le (h_stepsize_pos a) hle

/-- Helper for Theorem 8.35: on the measurable branch, the objective gap at time `n` is
integrable. -/
private lemma objectiveGapIntegrable_of_measurableSigma
    (h_oracle :
      StochasticProjectedSubgradientOracle μ f
        x̄ (fun n ω ↦ g n (x[n] ω) ω))
    {xStar : E} (hxStar : xStar ∈ XStar) (n : ℕ)
    (hm : stochasticIterateSigmaAlgebra (h_problem := h_problem) (g := g) (t := t) (x0 := x0) n ≤
      ‹MeasurableSpace Ω›) :
    Integrable (fun ω ↦ f (x̄[n] ω) - fOpt) μ := by
  let gapFun : Ω → ℝ := fun ω ↦ f (x̄[n] ω) - fOpt
  let innerCond : Ω → ℝ := fun ω ↦
    inner ℝ
      (μ[fun ω ↦ g n (x[n] ω) ω |
        stochasticIterateSigmaAlgebra
          (h_problem := h_problem) (g := g) (t := t) (x0 := x0) n] ω)
      (x̄[n] ω - xStar)
  have hsupport :=
    aeCondexpInnerGeObjectiveGap
      (h_problem := h_problem) (g := g) (t := t) (x0 := x0) h_oracle hxStar n
  have hinnerCond_int : Integrable innerCond μ := by
    -- The pulled-out conditional expectation remains integrable.
    have hcond_int :
        Integrable
          (μ[fun ω ↦ inner ℝ (g n (x[n] ω) ω) (x̄[n] ω - xStar) |
            stochasticIterateSigmaAlgebra
              (h_problem := h_problem) (g := g) (t := t) (x0 := x0) n]) μ := by
      exact MeasureTheory.integrable_condExp
    have hinnerCond_eq :
        innerCond =ᵐ[μ]
          μ[fun ω ↦ inner ℝ (g n (x[n] ω) ω) (x̄[n] ω - xStar) |
            stochasticIterateSigmaAlgebra
              (h_problem := h_problem) (g := g) (t := t) (x0 := x0) n] := by
      simpa [innerCond] using
        (condexpInnerIterateOffsetComapPullout
          (h_problem := h_problem) (g := g) (t := t) (x0 := x0) h_oracle n hm hxStar).symm
    exact hcond_int.congr hinnerCond_eq.symm
  have hgap_aemeas : AEMeasurable gapFun μ := by
    -- Compose the measurable objective with the current iterate and subtract the constant `fOpt`.
    exact
      ((objectiveMeasurable (h_problem := h_problem) (f := f)).comp_aemeasurable
        (stochasticIterateAestronglyMeasurable
          (h_problem := h_problem) (g := g) (t := t) (x0 := x0) h_oracle n).aemeasurable).sub
        aemeasurable_const
  have hdom : ∀ᵐ ω ∂μ, ‖gapFun ω‖ ≤ innerCond ω := by
    -- The gap is nonnegative, so its absolute value equals itself and is bounded by the support
    -- inequality from the unbiased oracle clause.
    filter_upwards [hsupport] with ω hω
    have hgap_nonneg : 0 ≤ gapFun ω := by
      simpa [gapFun] using
        feasibleObjectiveGap_nonneg
          (h_problem := h_problem) (f := f) (x[n] ω).property
    rw [Real.norm_of_nonneg hgap_nonneg]
    exact hω
  exact Integrable.mono' hinnerCond_int hgap_aemeas.aestronglyMeasurable hdom

/-- Helper for Theorem 8.35: on a measurable tail interval, the expected running-best gap is
integrable. -/
private lemma bestAchievedGapIntegrable_of_goodTailSigma
    (h_oracle :
      StochasticProjectedSubgradientOracle μ f
        x̄ (fun n ω ↦ g n (x[n] ω) ω))
    {xStar : E} (hxStar : xStar ∈ XStar)
    {m k : ℕ} (hmk : m ≤ k)
    (hgood :
      ∀ n ∈ Finset.Icc m k,
        stochasticIterateSigmaAlgebra
            (h_problem := h_problem) (g := g) (t := t) (x0 := x0) n ≤
          ‹MeasurableSpace Ω›) :
    Integrable
      (fun ω ↦ best_achieved_function_value f (fun n ↦ (x[n] ω : E)) k - fOpt) μ := by
  let bestGapFun : Ω → ℝ := fun ω ↦
    best_achieved_function_value f (fun n ↦ (x[n] ω : E)) k - fOpt
  have hm_mem : m ∈ Finset.Icc m k := Finset.mem_Icc.mpr ⟨le_rfl, hmk⟩
  have hobj_int :
      Integrable (fun ω ↦ f (x̄[m] ω) - fOpt) μ :=
    objectiveGapIntegrable_of_measurableSigma
      (h_problem := h_problem) (g := g) (t := t) (x0 := x0) h_oracle hxStar m
      (hgood m hm_mem)
  have hbest_aesm :
      AEStronglyMeasurable bestGapFun μ := by
    exact
      (bestAchievedAestronglyMeasurable
        (h_problem := h_problem) (g := g) (t := t) (x0 := x0) (f := f) h_oracle k).sub
        aestronglyMeasurable_const
  have hdom : ∀ᵐ ω ∂μ, ‖bestGapFun ω‖ ≤ f (x̄[m] ω) - fOpt := by
    -- The running-best gap is nonnegative and bounded above by the gap at any index in the tail.
    filter_upwards with ω
    have hnonneg :
        0 ≤ bestGapFun ω := by
      simpa [bestGapFun] using
        bestAchievedObjectiveGap_nonneg
          (h_problem := h_problem) (g := g) (t := t) (x0 := x0) (f := f) k ω
    have hbest_le :
        best_achieved_function_value f (fun n ↦ (x[n] ω : E)) k ≤ f (x[m] ω : E) :=
      best_achieved_function_value_le_objective_value
        f (fun n ↦ (x[n] ω : E)) k m (Finset.mem_range.mpr (Nat.lt_succ_of_le hmk))
    rw [Real.norm_of_nonneg hnonneg]
    dsimp [bestGapFun]
    linarith
  exact Integrable.mono' hobj_int hbest_aesm hdom

/-- Helper for Theorem 8.35: summing the measurable one-step expected inequality over the interval
`{a, a + 1, …, a + m}` yields the telescoping expected-gap bound. -/
private lemma expectedObjectiveGapIntervalWithRemainder_le_of_goodTailSigma
    (h_stepsize_nonneg : ∀ n, 0 ≤ t n)
    (h_oracle :
      StochasticProjectedSubgradientOracle μ f
        x̄ (fun n ω ↦ g n (x[n] ω) ω))
    {xStar : E} (hxStar : xStar ∈ XStar)
    (a m : ℕ)
    (hgood :
      ∀ n ∈ Finset.Icc a (a + m),
        stochasticIterateSigmaAlgebra
            (h_problem := h_problem) (g := g) (t := t) (x0 := x0) n ≤
          ‹MeasurableSpace Ω›) :
    2 * Finset.sum (Finset.Icc a (a + m))
          (fun n ↦ t n * (μ[fun ω ↦ f (x̄[n] ω)] - fOpt)) +
        μ[fun ω ↦ ‖x̄[a + m + 1] ω - xStar‖ ^ (2 : ℕ)] ≤
      μ[fun ω ↦ ‖x̄[a] ω - xStar‖ ^ (2 : ℕ)] +
        h_oracle.L_tilde_f ^ (2 : ℕ) *
          Finset.sum (Finset.Icc a (a + m)) (fun n ↦ (t n) ^ (2 : ℕ)) := by
  induction m with
  | zero =>
      have hstep :=
        expectedObjectiveGapStepWithRemainder_le_of_measurableSigma
          (h_problem := h_problem) (g := g) (t := t) (x0 := x0)
          h_stepsize_nonneg h_oracle hxStar a (hgood a (by simp))
      simpa [two_mul, mul_assoc, mul_left_comm, mul_comm] using hstep
  | succ m ih =>
      have hprev :
          2 * Finset.sum (Finset.Icc a (a + m))
                (fun n ↦ t n * (μ[fun ω ↦ f (x̄[n] ω)] - fOpt)) +
              μ[fun ω ↦ ‖x̄[a + m + 1] ω - xStar‖ ^ (2 : ℕ)] ≤
            μ[fun ω ↦ ‖x̄[a] ω - xStar‖ ^ (2 : ℕ)] +
              h_oracle.L_tilde_f ^ (2 : ℕ) *
                Finset.sum (Finset.Icc a (a + m)) (fun n ↦ (t n) ^ (2 : ℕ)) :=
        ih fun n hn ↦ hgood n (by
          rcases Finset.mem_Icc.mp hn with ⟨hna, hnm⟩
          exact Finset.mem_Icc.mpr ⟨hna, by omega⟩)
      have hstep :=
        expectedObjectiveGapStepWithRemainder_le_of_measurableSigma
          (h_problem := h_problem) (g := g) (t := t) (x0 := x0)
          h_stepsize_nonneg h_oracle hxStar (a + m + 1)
          (hgood (a + m + 1) (by
            refine Finset.mem_Icc.mpr ?_
            omega))
      have hIcc :
          Finset.Icc a (a + m + 1) = insert (a + m + 1) (Finset.Icc a (a + m)) := by
        ext n
        simp [Finset.mem_Icc]
        omega
      calc
        2 * Finset.sum (Finset.Icc a (a + m + 1))
              (fun n ↦ t n * (μ[fun ω ↦ f (x̄[n] ω)] - fOpt)) +
            μ[fun ω ↦ ‖x̄[a + m + 1 + 1] ω - xStar‖ ^ (2 : ℕ)]
            =
          2 * Finset.sum (Finset.Icc a (a + m))
                (fun n ↦ t n * (μ[fun ω ↦ f (x̄[n] ω)] - fOpt)) +
              (2 * t (a + m + 1) * (μ[fun ω ↦ f (x̄[a + m + 1] ω)] - fOpt) +
                μ[fun ω ↦ ‖x̄[a + m + 2] ω - xStar‖ ^ (2 : ℕ)]) := by
                rw [hIcc, Finset.sum_insert]
                · ring
                · simp
        _ ≤ μ[fun ω ↦ ‖x̄[a] ω - xStar‖ ^ (2 : ℕ)] +
            (h_oracle.L_tilde_f ^ (2 : ℕ) *
                Finset.sum (Finset.Icc a (a + m)) (fun n ↦ (t n) ^ (2 : ℕ)) +
              h_oracle.L_tilde_f ^ (2 : ℕ) * (t (a + m + 1)) ^ (2 : ℕ)) := by
                nlinarith [hprev, hstep]
        _ =
          μ[fun ω ↦ ‖x̄[a] ω - xStar‖ ^ (2 : ℕ)] +
            h_oracle.L_tilde_f ^ (2 : ℕ) *
              Finset.sum (Finset.Icc a (a + m + 1)) (fun n ↦ (t n) ^ (2 : ℕ)) := by
                rw [hIcc, Finset.sum_insert]
                · ring
                · simp

/-- Helper for Theorem 8.35: on a measurable tail interval, the weighted expected running-best
gap is bounded by the weighted expected objective gaps along that tail. -/
private lemma weightedExpectedBestGap_le_tailExpectedObjectiveGap
    (h_stepsize_nonneg : ∀ n, 0 ≤ t n)
    (h_oracle :
      StochasticProjectedSubgradientOracle μ f
        x̄ (fun n ω ↦ g n (x[n] ω) ω))
    {xStar : E} (hxStar : xStar ∈ XStar)
    {m k : ℕ} (hmk : m ≤ k)
    (hgood :
      ∀ n ∈ Finset.Icc m k,
        stochasticIterateSigmaAlgebra
            (h_problem := h_problem) (g := g) (t := t) (x0 := x0) n ≤
          ‹MeasurableSpace Ω›) :
    (Finset.sum (Finset.Icc m k) fun n ↦ t n) *
        (μ[fun ω ↦ best_achieved_function_value f (fun j ↦ (x[j] ω : E)) k] - fOpt) ≤
      Finset.sum (Finset.Icc m k) (fun n ↦ t n * (μ[fun ω ↦ f (x̄[n] ω)] - fOpt)) := by
  let tail := Finset.Icc m k
  let bestGapFun : Ω → ℝ := fun ω ↦
    best_achieved_function_value f (fun j ↦ (x[j] ω : E)) k - fOpt
  have hbest_int :
      Integrable bestGapFun μ := by
    -- The good-tail hypothesis gives integrability of the running-best gap.
    simpa [bestGapFun] using
      bestAchievedGapIntegrable_of_goodTailSigma
        (h_problem := h_problem) (g := g) (t := t) (x0 := x0) h_oracle hxStar hmk hgood
  have hbest_value :
      μ[fun ω ↦ best_achieved_function_value f (fun j ↦ (x[j] ω : E)) k] - fOpt =
        MeasureTheory.integral μ bestGapFun := by
    -- Rewrite the expected running-best gap as the integral of the pointwise gap.
    have hbest_obj_int :
        Integrable
          (fun ω ↦ best_achieved_function_value f (fun j ↦ (x[j] ω : E)) k) μ := by
      simpa [bestGapFun, sub_eq_add_neg, add_assoc, add_left_comm, add_comm] using
        hbest_int.add (integrable_const fOpt)
    simpa [bestGapFun] using
      expectationSub_eq_integral_sub_const
        (μ := μ)
        (φ := fun ω ↦ best_achieved_function_value f (fun j ↦ (x[j] ω : E)) k)
        hbest_obj_int fOpt
  have hterm_le :
      ∀ n ∈ tail,
        t n * (μ[fun ω ↦ best_achieved_function_value f (fun j ↦ (x[j] ω : E)) k] - fOpt) ≤
          t n * (μ[fun ω ↦ f (x̄[n] ω)] - fOpt) := by
    intro n hn
    let objGapFun : Ω → ℝ := fun ω ↦ f (x̄[n] ω) - fOpt
    have hobj_int :
        Integrable objGapFun μ := by
      -- Every objective gap on the good tail is integrable.
      simpa [objGapFun] using
        objectiveGapIntegrable_of_measurableSigma
          (h_problem := h_problem) (g := g) (t := t) (x0 := x0) h_oracle hxStar n
          (hgood n hn)
    have hobj_value :
        μ[fun ω ↦ f (x̄[n] ω)] - fOpt = MeasureTheory.integral μ objGapFun := by
      -- Rewrite the expected objective gap at index `n` as an integral.
      have hobj_raw_int : Integrable (fun ω ↦ f (x̄[n] ω)) μ := by
        simpa [objGapFun, sub_eq_add_neg, add_assoc, add_left_comm, add_comm] using
          hobj_int.add (integrable_const fOpt)
      simpa [objGapFun] using
        expectationSub_eq_integral_sub_const
          (μ := μ) (φ := fun ω ↦ f (x̄[n] ω)) hobj_raw_int fOpt
    have hpointwise : ∀ᵐ ω ∂μ, bestGapFun ω ≤ objGapFun ω := by
      -- Pathwise, the running best never exceeds any objective value in the tail.
      filter_upwards with ω
      have hn_range : n ∈ Finset.range (k + 1) := by
        exact Finset.mem_range.mpr (Nat.lt_succ_of_le (Finset.mem_Icc.mp hn).2)
      have hbest_le :
          best_achieved_function_value f (fun j ↦ (x[j] ω : E)) k ≤ f (x[n] ω : E) :=
        best_achieved_function_value_le_objective_value
          f (fun j ↦ (x[j] ω : E)) k n hn_range
      dsimp [bestGapFun, objGapFun]
      linarith
    have hexpect_le :
        (μ[fun ω ↦ best_achieved_function_value f (fun j ↦ (x[j] ω : E)) k] - fOpt) ≤
          (μ[fun ω ↦ f (x̄[n] ω)] - fOpt) := by
      -- Integrate the pathwise running-best comparison.
      have hintegral_le := MeasureTheory.integral_mono_ae hbest_int hobj_int hpointwise
      simpa [hbest_value, hobj_value] using hintegral_le
    exact mul_le_mul_of_nonneg_left hexpect_le (h_stepsize_nonneg n)
  have hsum_le :
      Finset.sum tail
          (fun n ↦ t n *
            (μ[fun ω ↦ best_achieved_function_value f (fun j ↦ (x[j] ω : E)) k] - fOpt)) ≤
        Finset.sum tail (fun n ↦ t n * (μ[fun ω ↦ f (x̄[n] ω)] - fOpt)) := by
    -- Sum the termwise weighted comparisons across the tail.
    exact Finset.sum_le_sum fun n hn ↦ hterm_le n hn
  calc
    (Finset.sum tail fun n ↦ t n) *
        (μ[fun ω ↦ best_achieved_function_value f (fun j ↦ (x[j] ω : E)) k] - fOpt)
        =
      Finset.sum tail
        (fun n ↦ t n *
          (μ[fun ω ↦ best_achieved_function_value f (fun j ↦ (x[j] ω : E)) k] - fOpt)) := by
            rw [Finset.sum_mul]
    _ ≤ Finset.sum tail (fun n ↦ t n * (μ[fun ω ↦ f (x̄[n] ω)] - fOpt)) := hsum_le

/-- Helper for Theorem 8.35: every interval admits the textbook ratio bound for the expected
running-best gap, with a trivial zero-gap fallback on a nonmeasurable tail branch. -/
private lemma expectedBestValueGapLeIntervalRatioBound
    (h_stepsize_pos : stochastic_projected_subgradient_stepsizes_positive t)
    (h_oracle :
      StochasticProjectedSubgradientOracle μ f
        x̄ (fun n ω ↦ g n (x[n] ω) ω))
    {xStar : E} (hxStar : xStar ∈ XStar)
    (a m : ℕ) :
    μ[fun ω ↦ best_achieved_function_value f (fun n ↦ (x[n] ω : E)) (a + m)] - fOpt ≤
      (μ[fun ω ↦ ‖x̄[a] ω - xStar‖ ^ (2 : ℕ)] +
          h_oracle.L_tilde_f ^ (2 : ℕ) *
            Finset.sum (Finset.Icc a (a + m)) (fun n ↦ (t n) ^ (2 : ℕ))) /
        (2 * Finset.sum (Finset.Icc a (a + m)) (fun n ↦ t n)) := by
  classical
  let tail := Finset.Icc a (a + m)
  have h_stepsize_nonneg : ∀ n, 0 ≤ t n := fun n ↦ le_of_lt (h_stepsize_pos n)
  by_cases hgood :
      ∀ n ∈ tail,
        stochasticIterateSigmaAlgebra
            (h_problem := h_problem) (g := g) (t := t) (x0 := x0) n ≤
          ‹MeasurableSpace Ω›
  · have hweighted :=
      weightedExpectedBestGap_le_tailExpectedObjectiveGap
        (h_problem := h_problem) (g := g) (t := t) (x0 := x0)
        h_stepsize_nonneg h_oracle hxStar (Nat.le_add_right a m) hgood
    have hinterval :=
      expectedObjectiveGapIntervalWithRemainder_le_of_goodTailSigma
        (h_problem := h_problem) (g := g) (t := t) (x0 := x0)
        h_stepsize_nonneg h_oracle hxStar a m hgood
    have hsqdist_nonneg :
        0 ≤ μ[fun ω ↦ ‖x̄[a + m + 1] ω - xStar‖ ^ (2 : ℕ)] := by
      exact integral_nonneg_of_ae (Filter.Eventually.of_forall fun ω ↦ by positivity)
    have hmain :
        2 * (Finset.sum tail fun n ↦ t n) *
            (μ[fun ω ↦ best_achieved_function_value f (fun n ↦ (x[n] ω : E)) (a + m)] -
              fOpt) ≤
          μ[fun ω ↦ ‖x̄[a] ω - xStar‖ ^ (2 : ℕ)] +
            h_oracle.L_tilde_f ^ (2 : ℕ) *
              Finset.sum tail (fun n ↦ (t n) ^ (2 : ℕ)) := by
      nlinarith [hweighted, hinterval, hsqdist_nonneg]
    have hden_pos : 0 < 2 * Finset.sum tail (fun n ↦ t n) := by
      have hsum_pos :=
        positiveStepsizeIntervalSum_pos (t := t) h_stepsize_pos a m
      positivity
    exact (le_div_iff₀ hden_pos).2 <| by
      simpa [tail, mul_comm, mul_left_comm, mul_assoc] using hmain
  · have hbad :
        ∃ n ∈ tail,
          ¬ stochasticIterateSigmaAlgebra
              (h_problem := h_problem) (g := g) (t := t) (x0 := x0) n ≤
            ‹MeasurableSpace Ω› := by
      push Not at hgood
      exact hgood
    have hzero :=
      bestAchievedGapAeEqZero_of_badTailSigma
        (h_problem := h_problem) (g := g) (t := t) (x0 := x0)
        h_oracle hxStar (Nat.le_add_right a m) hbad
    let bestGapFun : Ω → ℝ := fun ω ↦
      best_achieved_function_value f (fun n ↦ (x[n] ω : E)) (a + m) - fOpt
    have hbest_zero :
        μ[fun ω ↦ best_achieved_function_value f (fun n ↦ (x[n] ω : E)) (a + m)] -
          fOpt = 0 := by
      -- On the bad branch the running-best gap vanishes almost surely, so its expectation is `0`.
      have hzero_eq : bestGapFun =ᵐ[μ] fun _ : Ω ↦ 0 := by
        filter_upwards [hzero] with ω hω
        simp [bestGapFun, hω]
      have hbest_int : Integrable bestGapFun μ := by
        exact (integrable_zero Ω ℝ μ).congr hzero_eq.symm
      have hbest_obj_int :
          Integrable
            (fun ω ↦ best_achieved_function_value f (fun n ↦ (x[n] ω : E)) (a + m)) μ := by
        simpa [bestGapFun, sub_eq_add_neg, add_assoc, add_left_comm, add_comm] using
          hbest_int.add (integrable_const fOpt)
      have hgap_zero : MeasureTheory.integral μ bestGapFun = 0 := by
        calc
          MeasureTheory.integral μ bestGapFun
              = MeasureTheory.integral μ (fun _ : Ω ↦ (0 : ℝ)) := by
                  exact integral_congr_ae hzero_eq
          _ = 0 := by simp
      rw [integral_sub hbest_obj_int (integrable_const fOpt), integral_const] at hgap_zero
      simpa [bestGapFun, sub_eq_add_neg, add_assoc, add_left_comm, add_comm] using hgap_zero
    have hnum_nonneg :
        0 ≤
          μ[fun ω ↦ ‖x̄[a] ω - xStar‖ ^ (2 : ℕ)] +
            h_oracle.L_tilde_f ^ (2 : ℕ) *
              Finset.sum tail (fun n ↦ (t n) ^ (2 : ℕ)) := by
      have hsqdist_nonneg :
          0 ≤ μ[fun ω ↦ ‖x̄[a] ω - xStar‖ ^ (2 : ℕ)] := by
        exact integral_nonneg_of_ae (Filter.Eventually.of_forall fun ω ↦ by positivity)
      have hsum_nonneg :
          0 ≤ h_oracle.L_tilde_f ^ (2 : ℕ) *
            Finset.sum tail (fun n ↦ (t n) ^ (2 : ℕ)) := by
        refine mul_nonneg ?_ ?_
        · positivity
        · exact Finset.sum_nonneg fun n _ ↦ by positivity
      exact add_nonneg hsqdist_nonneg hsum_nonneg
    have hden_pos : 0 < 2 * Finset.sum tail (fun n ↦ t n) := by
      have hsum_pos :=
        positiveStepsizeIntervalSum_pos
          (t := t) h_stepsize_pos a m
      positivity
    rw [hbest_zero]
    exact div_nonneg hnum_nonneg (le_of_lt hden_pos)

/-- Helper for Theorem 8.35: the expected running-best objective gap is always nonnegative. -/
private lemma expectedBestAchievedObjectiveGap_nonneg
    (h_oracle :
      StochasticProjectedSubgradientOracle μ f
        x̄ (fun n ω ↦ g n (x[n] ω) ω))
    {xStar : E} (hxStar : xStar ∈ XStar) (k : ℕ) :
    0 ≤ μ[fun ω ↦ best_achieved_function_value f (fun n ↦ (x[n] ω : E)) k] - fOpt := by
  let tail : Finset ℕ := Finset.Icc 0 k
  by_cases hgood :
      ∀ n ∈ tail,
        stochasticIterateSigmaAlgebra
            (h_problem := h_problem) (g := g) (t := t) (x0 := x0) n ≤
          ‹MeasurableSpace Ω›
  · let bestGapFun : Ω → ℝ := fun ω ↦
      best_achieved_function_value f (fun n ↦ (x[n] ω : E)) k - fOpt
    have hbest_int : Integrable bestGapFun μ := by
      simpa [bestGapFun] using
        bestAchievedGapIntegrable_of_goodTailSigma
          (h_problem := h_problem) (g := g) (t := t) (x0 := x0)
          h_oracle hxStar (Nat.zero_le k) hgood
    have hbest_obj_int :
        Integrable
          (fun ω ↦ best_achieved_function_value f (fun n ↦ (x[n] ω : E)) k) μ := by
      simpa [bestGapFun, sub_eq_add_neg, add_assoc, add_left_comm, add_comm] using
        hbest_int.add (integrable_const fOpt)
    have hbest_nonneg_ae : ∀ᵐ ω ∂μ, 0 ≤ bestGapFun ω := by
      filter_upwards with ω
      simpa [bestGapFun] using
        bestAchievedObjectiveGap_nonneg
          (h_problem := h_problem) (g := g) (t := t) (x0 := x0) (f := f) k ω
    have hgap_nonneg : 0 ≤ MeasureTheory.integral μ bestGapFun := by
      simpa [bestGapFun] using integral_nonneg_of_ae hbest_nonneg_ae
    rw [integral_sub hbest_obj_int (integrable_const fOpt), integral_const] at hgap_nonneg
    simpa [bestGapFun, sub_eq_add_neg, add_assoc, add_left_comm, add_comm] using hgap_nonneg
  · have hbad :
        ∃ n ∈ tail,
          ¬ stochasticIterateSigmaAlgebra
              (h_problem := h_problem) (g := g) (t := t) (x0 := x0) n ≤
            ‹MeasurableSpace Ω› := by
      push Not at hgood
      exact hgood
    let bestGapFun : Ω → ℝ := fun ω ↦
      best_achieved_function_value f (fun n ↦ (x[n] ω : E)) k - fOpt
    have hzero :=
      bestAchievedGapAeEqZero_of_badTailSigma
        (h_problem := h_problem) (g := g) (t := t) (x0 := x0)
        h_oracle hxStar (Nat.zero_le k) hbad
    have hzero_eq : bestGapFun =ᵐ[μ] fun _ : Ω ↦ 0 := by
      filter_upwards [hzero] with ω hω
      simp [bestGapFun, hω]
    have hbest_int : Integrable bestGapFun μ := by
      exact (integrable_zero Ω ℝ μ).congr hzero_eq.symm
    have hbest_obj_int :
        Integrable
          (fun ω ↦ best_achieved_function_value f (fun n ↦ (x[n] ω : E)) k) μ := by
      simpa [bestGapFun, sub_eq_add_neg, add_assoc, add_left_comm, add_comm] using
        hbest_int.add (integrable_const fOpt)
    have hbest_zero :
        μ[fun ω ↦ best_achieved_function_value f (fun n ↦ (x[n] ω : E)) k] - fOpt = 0 := by
      have hgap_zero : MeasureTheory.integral μ bestGapFun = 0 := by
        calc
          MeasureTheory.integral μ bestGapFun
              = MeasureTheory.integral μ (fun _ : Ω ↦ (0 : ℝ)) := by
                  exact integral_congr_ae hzero_eq
          _ = 0 := by simp
      rw [integral_sub hbest_obj_int (integrable_const fOpt), integral_const] at hgap_zero
      simpa [bestGapFun, sub_eq_add_neg, add_assoc, add_left_comm, add_comm] using hgap_zero
    simpa [hbest_zero]

/-- Helper for Theorem 8.35: along the textbook half-squared-diameter stepsize rule, the half-tail
sum of squared stepsizes matches `2 * Θ * harmonicHalfTailSum k / L^2`. -/
private lemma halfTailHalfSquaredDiameterStepsizeSqSum
    (hΘ_nonneg : 0 ≤ Θ) {L : ℝ} (hL_pos : 0 < L)
    (h_stepsize : ∀ n, t n = projectedSubgradientHalfSquaredDiameterStepsize Θ L n)
    (k : ℕ) :
    L ^ (2 : ℕ) * Finset.sum (Finset.Icc (k / 2) k) (fun n ↦ (t n) ^ (2 : ℕ)) =
      2 * Θ * harmonicHalfTailSum k := by
  have hterm :
      ∀ n ∈ Finset.Icc (k / 2) k,
        L ^ (2 : ℕ) * (t n) ^ (2 : ℕ) = 2 * Θ * (1 / ((n : ℝ) + 1)) := by
    intro n hn
    rw [h_stepsize n, projectedSubgradientHalfSquaredDiameterStepsize]
    have hsqrt_pos : 0 < Real.sqrt ((n : ℝ) + 1) := by
      positivity
    have hsqrt_sq :
        (Real.sqrt ((n : ℝ) + 1)) ^ (2 : ℕ) = (n : ℝ) + 1 := by
      nlinarith [Real.sq_sqrt (show 0 ≤ (n : ℝ) + 1 by positivity)]
    have hnum_sq :
        (Real.sqrt (2 * Θ)) ^ (2 : ℕ) = 2 * Θ := by
      nlinarith [Real.sq_sqrt (show 0 ≤ 2 * Θ by positivity)]
    field_simp [pow_two, hL_pos.ne', hsqrt_pos.ne']
    rw [hsqrt_sq, hnum_sq]
  calc
    L ^ (2 : ℕ) * Finset.sum (Finset.Icc (k / 2) k) (fun n ↦ (t n) ^ (2 : ℕ))
        = Finset.sum (Finset.Icc (k / 2) k) (fun n ↦ L ^ (2 : ℕ) * (t n) ^ (2 : ℕ)) := by
            rw [Finset.mul_sum]
    _ = Finset.sum (Finset.Icc (k / 2) k) (fun n ↦ 2 * Θ * (1 / ((n : ℝ) + 1))) := by
          refine Finset.sum_congr rfl ?_
          intro n hn
          exact hterm n hn
    _ = 2 * Θ * harmonicHalfTailSum k := by
          simp [harmonicHalfTailSum, Finset.mul_sum]

/-- Helper for Theorem 8.35: along the textbook half-squared-diameter stepsize rule, the half-tail
sum of stepsizes factors through `inverseSqrtHalfTailSum k`. -/
private lemma halfTailHalfSquaredDiameterStepsizeSum
    {L : ℝ} (hL_pos : 0 < L)
    (h_stepsize : ∀ n, t n = projectedSubgradientHalfSquaredDiameterStepsize Θ L n)
    (k : ℕ) :
    Finset.sum (Finset.Icc (k / 2) k) (fun n ↦ t n) =
      (Real.sqrt (2 * Θ) / L) * inverseSqrtHalfTailSum k := by
  have hterm :
      ∀ n ∈ Finset.Icc (k / 2) k,
        t n = (Real.sqrt (2 * Θ) / L) * (1 / Real.sqrt ((n : ℝ) + 1)) := by
    intro n hn
    rw [h_stepsize n, projectedSubgradientHalfSquaredDiameterStepsize]
    field_simp [hL_pos.ne']
  calc
    Finset.sum (Finset.Icc (k / 2) k) (fun n ↦ t n)
        = Finset.sum (Finset.Icc (k / 2) k)
            (fun n ↦ (Real.sqrt (2 * Θ) / L) * (1 / Real.sqrt ((n : ℝ) + 1))) := by
              refine Finset.sum_congr rfl ?_
              intro n hn
              exact hterm n hn
    _ = (Real.sqrt (2 * Θ) / L) * inverseSqrtHalfTailSum k := by
          simp [inverseSqrtHalfTailSum, Finset.mul_sum, mul_comm]

/- Theorem 8.35 is `source-facing`: it gives convergence and the `O(1 / √k)` rate for the
expected running-best objective value along the concrete stochastic projected subgradient
iterates. The canonical owners already present in Chapter 8 are the running minimum
`best_achieved_function_value`, the standing problem class `IsConstrainedConvexProblem`, and the
stochastic oracle package `StochasticProjectedSubgradientOracle`, together with the iterate owner
`stochastic_projected_subgradient_method`. The explicit stepsize in part (2) is the same scalar
formula already owned by `projectedSubgradientHalfSquaredDiameterStepsize` in Theorem 8.30, so the
stochastic statement reuses that chapter-level owner rather than duplicating it. The theorem
therefore keeps the source-facing expected best-value statements while expressing the iterate
process through the chapter's canonical Algorithm 8.10 recursion rather than through duplicate
zero/successor hypotheses. -/

-- Proof sketch: apply the stochastic one-step descent inequality obtained from the projection
-- nonexpansiveness and the oracle assumptions to an optimal point `xStar ∈ XStar`, then sum from
-- `0` to `k` and use the prefix-minimality of `best_achieved_function_value` to get
-- `μ[f_best^k] - fOpt ≤ (D + L_tilde_f^2 * ∑_{n ≤ k} t_n^2) / (2 * ∑_{n ≤ k} t_n)`.
-- The hypothesis that `(∑ t_n^2) / (∑ t_n) → 0`
-- forces the right-hand side to converge to `0`.
/-- Theorem 8.35 (1), gap form: under Assumptions 8.7 and 8.34, if the stochastic projected
subgradient method uses positive stepsizes and
`(∑_{n=0}^k t_n^2) / (∑_{n=0}^k t_n) → 0`, then the expected best objective gap attained by
the first `k + 1` stochastic iterates converges to `0`. -/
theorem stochastic_projected_subgradient_expected_best_value_gap_tendsto_zero_of_stepsize_ratio
    (h_stepsize_pos : stochastic_projected_subgradient_stepsizes_positive t)
    (h_oracle :
      StochasticProjectedSubgradientOracle μ f
        (fun k ω ↦ (x[k] ω : E))
        (fun k ω ↦ g k (x[k] ω) ω))
    (h_ratio :
      Filter.Tendsto
        (fun k ↦
          (Finset.sum (Finset.range (k + 1)) fun n ↦ (t n) ^ (2 : ℕ)) /
            Finset.sum (Finset.range (k + 1)) fun n ↦ t n)
        Filter.atTop (nhds 0)) :
    Filter.Tendsto
      (fun k ↦
        μ[fun ω ↦
          best_achieved_function_value f (fun n ↦ (x[n] ω : E)) k] - fOpt)
      Filter.atTop (nhds 0) := by
  rcases h_problem.optimal_set_nonempty with ⟨xStar, hxStar⟩
  let S : ℕ → ℝ := fun k ↦ Finset.sum (Finset.range (k + 1)) (fun n ↦ t n)
  let Q : ℕ → ℝ := fun k ↦ Finset.sum (Finset.range (k + 1)) (fun n ↦ (t n) ^ (2 : ℕ))
  let bestGap : ℕ → ℝ := fun k ↦
    μ[fun ω ↦ best_achieved_function_value f (fun n ↦ (x[n] ω : E)) k] - fOpt
  have hS_atTop :
      Filter.Tendsto S Filter.atTop Filter.atTop :=
    stepsizePrefixSumTendstoAtTopOfRatioTendstoZero (t := t) h_stepsize_pos h_ratio
  have hbest_nonneg : ∀ k, 0 ≤ bestGap k := by
    intro k
    simpa [bestGap] using
      expectedBestAchievedObjectiveGap_nonneg
        (h_problem := h_problem) (g := g) (t := t) (x0 := x0) h_oracle hxStar k
  have hfirst_tendsto :
      Filter.Tendsto
        (fun k ↦ ((1 / 2 : ℝ) * ‖(x0 : E) - xStar‖ ^ (2 : ℕ)) / S k)
        Filter.atTop (nhds 0) :=
    hS_atTop.const_div_atTop ((1 / 2 : ℝ) * ‖(x0 : E) - xStar‖ ^ (2 : ℕ))
  have hsecond_tendsto :
      Filter.Tendsto
        (fun k ↦ (h_oracle.L_tilde_f ^ (2 : ℕ) / 2) * (Q k / S k))
        Filter.atTop (nhds 0) := by
    have hratio' : Filter.Tendsto (fun k ↦ Q k / S k) Filter.atTop (nhds 0) := by
      simpa [Q, S] using h_ratio
    simpa using hratio'.const_mul (h_oracle.L_tilde_f ^ (2 : ℕ) / 2)
  have hupper_tendsto :
      Filter.Tendsto
        (fun k ↦
          ((1 / 2 : ℝ) * ‖(x0 : E) - xStar‖ ^ (2 : ℕ)) / S k +
            (h_oracle.L_tilde_f ^ (2 : ℕ) / 2) * (Q k / S k))
        Filter.atTop (nhds 0) := by
    simpa using hfirst_tendsto.add hsecond_tendsto
  refine squeeze_zero hbest_nonneg ?_ hupper_tendsto
  intro k
  have hS_pos : 0 < S k := by
    exact positiveStepsizePrefixSum_pos (t := t) h_stepsize_pos k
  have hratio_bound :=
    expectedBestValueGapLeIntervalRatioBound
      (h_problem := h_problem) (g := g) (t := t) (x0 := x0)
      h_stepsize_pos h_oracle hxStar 0 k
  have htail0 : Finset.Icc 0 k = Finset.range (k + 1) := by
    ext n
    simp [Finset.mem_Icc]
  have hdist0 :
      μ[fun ω ↦ ‖x̄[0] ω - xStar‖ ^ (2 : ℕ)] = ‖(x0 : E) - xStar‖ ^ (2 : ℕ) := by
    have hconst :
        (fun ω ↦ ‖x̄[0] ω - xStar‖ ^ (2 : ℕ)) =
          fun _ : Ω ↦ ‖(x0 : E) - xStar‖ ^ (2 : ℕ) := by
      funext ω
      have hzero :
          x̄[0] ω = (x0 : E) := by
        simpa using congrArg (fun h : Ω → E ↦ h ω)
          (stochastic_projected_subgradient_method_iterate_zero
            (C := C) (hC_nonempty := h_problem.feasible_nonempty)
            (hC_closed := h_problem.feasible_closed)
            (hC_convex := h_problem.feasible_convex) (g := g) (t := t) (x0 := x0))
      simpa [hzero]
    rw [hconst]
    simp
  calc
    bestGap k =
        μ[fun ω ↦ best_achieved_function_value f (fun n ↦ (x[n] ω : E)) k] - fOpt := by
      rfl
    _ ≤
        ((1 / 2 : ℝ) * ‖(x0 : E) - xStar‖ ^ (2 : ℕ)) / S k +
          (h_oracle.L_tilde_f ^ (2 : ℕ) / 2) * (Q k / S k) := by
            have hdiv :
                μ[fun ω ↦ best_achieved_function_value f (fun n ↦ (x[n] ω : E)) k] - fOpt ≤
                  (‖(x0 : E) - xStar‖ ^ (2 : ℕ) +
                      h_oracle.L_tilde_f ^ (2 : ℕ) * Q k) /
                    (2 * S k) := by
              simpa [S, Q, hdist0, htail0] using hratio_bound
            refine hdiv.trans_eq ?_
            field_simp [ne_of_gt hS_pos]

/-- Theorem 8.35 (1): under Assumptions 8.7 and 8.34, if the stochastic projected subgradient
method uses positive stepsizes and
`(∑_{n=0}^k t_n^2) / (∑_{n=0}^k t_n) → 0`, then the expected best objective value attained by
the first `k + 1` stochastic iterates converges to the optimal value `fOpt`. -/
theorem stochastic_projected_subgradient_expected_best_value_tendsto_of_stepsize_ratio
    (h_stepsize_pos : stochastic_projected_subgradient_stepsizes_positive t)
    (h_oracle :
      StochasticProjectedSubgradientOracle μ f
        (fun k ω ↦ (x[k] ω : E))
        (fun k ω ↦ g k (x[k] ω) ω))
    (h_ratio :
      Filter.Tendsto
        (fun k ↦
          (Finset.sum (Finset.range (k + 1)) fun n ↦ (t n) ^ (2 : ℕ)) /
            Finset.sum (Finset.range (k + 1)) fun n ↦ t n)
        Filter.atTop (nhds 0)) :
    Filter.Tendsto
      (fun k ↦
        μ[fun ω ↦
          best_achieved_function_value f (fun n ↦ (x[n] ω : E)) k])
      Filter.atTop (nhds fOpt) := by
  -- Reuse the gap-form convergence theorem and shift by the constant `fOpt`.
  simpa [sub_eq_add_neg, add_assoc, add_left_comm, add_comm] using
    (stochastic_projected_subgradient_expected_best_value_gap_tendsto_zero_of_stepsize_ratio
      (h_problem := h_problem) (g := g) (t := t) (x0 := x0)
      h_stepsize_pos h_oracle h_ratio).const_add fOpt

-- Proof sketch: sum the stochastic descent inequality from `⌈k / 2⌉` through `k`, use the
-- half-squared-diameter bound `Θ` to control the distance term because every iterate and every
-- optimal point lie in `C`, then substitute the stepsize
-- `t_n = √(2 Θ) / (L_tilde_f √(n + 1))`. The resulting ratio of a harmonic tail to an
-- inverse-square-root tail is bounded by Lemma 8.27 (2), giving the constant `2 * (1 + log 3)`.
/-- Theorem 8.35 (2): under Assumptions 8.7 and 8.34, if `Θ` bounds the half squared diameter of
`C` and the stochastic projected subgradient method uses the stepsizes
`t_k = √(2 Θ) / (L_tilde_f √(k + 1))`, then for every `k ≥ 2` the expected best objective gap
satisfies
`E[f_best^k] - fOpt ≤
  2 (1 + log 3) L_tilde_f √(2 Θ) / √(k + 2)`. -/
theorem stochastic_projected_subgradient_best_value_gap_le_of_half_squared_diameter_stepsize
    (h_oracle :
      StochasticProjectedSubgradientOracle μ f
        (fun k ω ↦ (x[k] ω : E))
        (fun k ω ↦ g k (x[k] ω) ω))
    (hΘ : C.HasHalfSquaredDiameterBound Θ)
    (h_stepsize :
      ∀ n,
        t n = projectedSubgradientHalfSquaredDiameterStepsize Θ h_oracle.L_tilde_f n)
    {k : ℕ} (hk : 2 ≤ k) :
    μ[fun ω ↦ best_achieved_function_value f (fun n ↦ (x[n] ω : E)) k] - fOpt ≤
      (2 * (1 + Real.log 3)) * h_oracle.L_tilde_f * Real.sqrt (2 * Θ) /
        Real.sqrt ((k : ℝ) + 2) := by
  rcases h_problem.optimal_set_nonempty with ⟨xStar, hxStar⟩
  let a : ℕ := k / 2
  let m : ℕ := k - k / 2
  let tail : Finset ℕ := Finset.Icc a k
  have hΘ_nonneg : 0 ≤ Θ := by
    simpa using hΘ.bound x0.property x0.property
  have hk_split : a + m = k := by
    dsimp [a, m]
    omega
  have hxStarC : xStar ∈ C := by
    have hxStar_data : xStar ∈ C ∧ IsMinOn (fun x : E ↦ ((f x : ℝ) : EReal)) C xStar := by
      simpa [h_problem.optimal_set_eq] using hxStar
    exact hxStar_data.1
  by_cases hTheta_zero : Θ = 0
  · let bestGapFun : Ω → ℝ := fun ω ↦
        best_achieved_function_value f (fun n ↦ (x[n] ω : E)) k - fOpt
    have hsingleton : ∀ {y : E}, y ∈ C → y = xStar := by
      intro y hy
      have hy_zero : (1 / 2 : ℝ) * ‖y - xStar‖ ^ (2 : ℕ) ≤ 0 := by
        simpa [hTheta_zero] using hΘ.bound hy hxStarC
      have hnorm_zero : ‖y - xStar‖ = 0 := by
        nlinarith [hy_zero, sq_nonneg ‖y - xStar‖]
      exact sub_eq_zero.mp (norm_eq_zero.mp hnorm_zero)
    have hbest_zero_ae :
        ∀ᵐ ω ∂μ, bestGapFun ω = 0 := by
      filter_upwards with ω
      have hiter_eq : ∀ n, (x[n] ω : E) = xStar := by
        intro n
        exact hsingleton (x[n] ω).property
      have hxStar_val : f xStar = fOpt := by
        simpa using
          optimal_point_toReal_eq_fOpt
            (f := fun x : E ↦ ((f x : ℝ) : EReal)) (h_problem := h_problem) hxStar
      have hbest_eval :
          best_achieved_function_value f (fun n ↦ (x[n] ω : E)) k = f xStar := by
        unfold best_achieved_function_value
        have himage :
            Finset.image (fun n ↦ f (x[n] ω : E)) (Finset.range (k + 1)) = {f xStar} := by
          ext y
          constructor
          · intro hy
            rcases Finset.mem_image.mp hy with ⟨n, hn, rfl⟩
            simpa [hiter_eq n]
          · intro hy
            have hy' : y = f xStar := by
              simpa using hy
            subst y
            refine Finset.mem_image.mpr ?_
            refine ⟨0, by simp, ?_⟩
            simpa [hiter_eq 0]
        simp [himage]
      dsimp [bestGapFun]
      rw [hbest_eval, hxStar_val]
      simp
    have hzero_eq : bestGapFun =ᵐ[μ] fun _ : Ω ↦ 0 := by
      filter_upwards [hbest_zero_ae] with ω hω
      simp [hω]
    have hbest_int : Integrable bestGapFun μ := by
      exact (integrable_zero Ω ℝ μ).congr hzero_eq.symm
    have hbest_obj_int :
        Integrable
          (fun ω ↦ best_achieved_function_value f (fun n ↦ (x[n] ω : E)) k) μ := by
      simpa [bestGapFun, sub_eq_add_neg, add_assoc, add_left_comm, add_comm] using
        hbest_int.add (integrable_const fOpt)
    have hbest_zero :
        μ[fun ω ↦ best_achieved_function_value f (fun n ↦ (x[n] ω : E)) k] - fOpt = 0 := by
      have hgap_zero : MeasureTheory.integral μ bestGapFun = 0 := by
        calc
          MeasureTheory.integral μ bestGapFun
              = MeasureTheory.integral μ (fun _ : Ω ↦ (0 : ℝ)) := by
                  exact integral_congr_ae hzero_eq
          _ = 0 := by simp
      rw [integral_sub hbest_obj_int (integrable_const fOpt), integral_const] at hgap_zero
      simpa [bestGapFun, sub_eq_add_neg, add_assoc, add_left_comm, add_comm] using hgap_zero
    have hright_zero :
        (2 * (1 + Real.log 3)) * h_oracle.L_tilde_f * Real.sqrt (2 * Θ) /
          Real.sqrt ((k : ℝ) + 2) = 0 := by
      simp [hTheta_zero]
    have hbranch :
        μ[fun ω ↦ best_achieved_function_value f (fun n ↦ (x[n] ω : E)) k] - fOpt ≤
          (2 * (1 + Real.log 3)) * h_oracle.L_tilde_f * Real.sqrt (2 * Θ) /
            Real.sqrt ((k : ℝ) + 2) := by
      rw [hbest_zero, hright_zero]
    simpa using hbranch
  · have hTheta_pos : 0 < Θ := by
      exact lt_of_le_of_ne hΘ_nonneg (by simpa [eq_comm] using hTheta_zero)
    have h_stepsize_pos : stochastic_projected_subgradient_stepsizes_positive t := by
      intro n
      rw [h_stepsize n, projectedSubgradientHalfSquaredDiameterStepsize]
      refine div_pos (Real.sqrt_pos.2 ?_) ?_
      · nlinarith
      · exact mul_pos h_oracle.L_tilde_f_pos (Real.sqrt_pos.2 (by positivity))
    have hratio_bound :=
      expectedBestValueGapLeIntervalRatioBound
        (h_problem := h_problem) (g := g) (t := t) (x0 := x0)
        h_stepsize_pos h_oracle hxStar a m
    have hstart_bound :
        μ[fun ω ↦ ‖x̄[a] ω - xStar‖ ^ (2 : ℕ)] ≤ 2 * Θ := by
      have hsqdist_int :
          Integrable (fun ω ↦ ‖x̄[a] ω - xStar‖ ^ (2 : ℕ)) μ := by
        exact stochasticIterateSqdistIntegrable
          (h_problem := h_problem) (g := g) (t := t) (x0 := x0) h_oracle hxStar a
      have hpointwise :
          ∀ᵐ ω ∂μ, ‖x̄[a] ω - xStar‖ ^ (2 : ℕ) ≤ 2 * Θ := by
        filter_upwards with ω
        have hhalf :
            (1 / 2 : ℝ) * ‖x̄[a] ω - xStar‖ ^ (2 : ℕ) ≤ Θ := by
          exact hΘ.bound (x[a] ω).property hxStarC
        nlinarith
      have hconst_int : Integrable (fun _ : Ω ↦ (2 * Θ : ℝ)) μ := integrable_const _
      simpa using MeasureTheory.integral_mono_ae hsqdist_int hconst_int hpointwise
    have hsq_term :
        h_oracle.L_tilde_f ^ (2 : ℕ) *
            Finset.sum tail (fun n ↦ (t n) ^ (2 : ℕ)) =
          2 * Θ * harmonicHalfTailSum k := by
      simpa [tail, a] using
        halfTailHalfSquaredDiameterStepsizeSqSum
          (t := t) (Θ := Θ) hΘ_nonneg h_oracle.L_tilde_f_pos h_stepsize k
    have hsum_stepsize :
        Finset.sum tail (fun n ↦ t n) =
          (Real.sqrt (2 * Θ) / h_oracle.L_tilde_f) * inverseSqrtHalfTailSum k := by
      simpa [tail, a] using
        halfTailHalfSquaredDiameterStepsizeSum
          (t := t) h_oracle.L_tilde_f_pos h_stepsize k
    have hsum_pos : 0 < Finset.sum tail (fun n ↦ t n) := by
      simpa [tail, hk_split] using
        positiveStepsizeIntervalSum_pos (t := t) h_stepsize_pos a m
    have hratio_one :
        (1 + harmonicHalfTailSum k) / inverseSqrtHalfTailSum k ≤
          (4 * (1 + Real.log 3)) / Real.sqrt ((k : ℝ) + 2) := by
      simpa using harmonic_half_tail_ratio_le_log_three_bound 1 (by positivity) k
    have hprefactor_nonneg :
        0 ≤ h_oracle.L_tilde_f * Real.sqrt (2 * Θ) / 2 := by
      have hsqrt_nonneg : 0 ≤ Real.sqrt (2 * Θ) := Real.sqrt_nonneg _
      have hmul_nonneg : 0 ≤ h_oracle.L_tilde_f * Real.sqrt (2 * Θ) := by
        exact mul_nonneg (le_of_lt h_oracle.L_tilde_f_pos) hsqrt_nonneg
      nlinarith
    have hbound_to_ratio :
        μ[fun ω ↦ best_achieved_function_value f (fun n ↦ (x[n] ω : E)) k] - fOpt ≤
          (h_oracle.L_tilde_f * Real.sqrt (2 * Θ) / 2) *
            ((1 + harmonicHalfTailSum k) / inverseSqrtHalfTailSum k) := by
      have hsum_rewrite : 2 * Finset.sum tail (fun n ↦ t n) =
          (2 * (Real.sqrt (2 * Θ) / h_oracle.L_tilde_f)) * inverseSqrtHalfTailSum k := by
        rw [hsum_stepsize]
        ring
      have hmain_num :
          μ[fun ω ↦ ‖x̄[a] ω - xStar‖ ^ (2 : ℕ)] +
              h_oracle.L_tilde_f ^ (2 : ℕ) * Finset.sum tail (fun n ↦ (t n) ^ (2 : ℕ)) ≤
            2 * Θ * (1 + harmonicHalfTailSum k) := by
        rw [hsq_term]
        nlinarith [hstart_bound]
      calc
        μ[fun ω ↦ best_achieved_function_value f (fun n ↦ (x[n] ω : E)) k] - fOpt
            ≤
              (μ[fun ω ↦ ‖x̄[a] ω - xStar‖ ^ (2 : ℕ)] +
                  h_oracle.L_tilde_f ^ (2 : ℕ) *
                    Finset.sum tail (fun n ↦ (t n) ^ (2 : ℕ))) /
                (2 * Finset.sum tail (fun n ↦ t n)) := by
                  simpa [tail, hk_split] using hratio_bound
        _ ≤ (2 * Θ * (1 + harmonicHalfTailSum k)) / (2 * Finset.sum tail (fun n ↦ t n)) := by
              refine div_le_div_of_nonneg_right hmain_num ?_
              exact (le_of_lt <| show 0 < 2 * Finset.sum tail (fun n ↦ t n) by positivity)
        _ = (2 * Θ * (1 + harmonicHalfTailSum k)) /
              ((2 * (Real.sqrt (2 * Θ) / h_oracle.L_tilde_f)) * inverseSqrtHalfTailSum k) := by
              rw [hsum_rewrite]
        _ = (h_oracle.L_tilde_f * Real.sqrt (2 * Θ) / 2) *
              ((1 + harmonicHalfTailSum k) / inverseSqrtHalfTailSum k) := by
              have hsqrt_twoTheta_ne : Real.sqrt (2 * Θ) ≠ 0 := by
                by_cases hzero : Θ = 0
                · exact (hTheta_zero hzero).elim
                · positivity
              have hsqrt_sq : Real.sqrt (2 * Θ) ^ 2 = 2 * Θ := by
                rw [Real.sq_sqrt]
                positivity
              field_simp [h_oracle.L_tilde_f_pos.ne', hsqrt_twoTheta_ne]
              rw [hsqrt_sq]
              ring_nf
    have hfinal_ratio :
        (h_oracle.L_tilde_f * Real.sqrt (2 * Θ) / 2) *
            ((1 + harmonicHalfTailSum k) / inverseSqrtHalfTailSum k) ≤
          (2 * (1 + Real.log 3)) * h_oracle.L_tilde_f * Real.sqrt (2 * Θ) /
            Real.sqrt ((k : ℝ) + 2) := by
      have hscaled :=
        mul_le_mul_of_nonneg_left hratio_one hprefactor_nonneg
      calc
        (h_oracle.L_tilde_f * Real.sqrt (2 * Θ) / 2) *
            ((1 + harmonicHalfTailSum k) / inverseSqrtHalfTailSum k)
            ≤
          (h_oracle.L_tilde_f * Real.sqrt (2 * Θ) / 2) *
            ((4 * (1 + Real.log 3)) / Real.sqrt ((k : ℝ) + 2)) := hscaled
        _ =
          (2 * (1 + Real.log 3)) * h_oracle.L_tilde_f * Real.sqrt (2 * Θ) /
            Real.sqrt ((k : ℝ) + 2) := by
              field_simp [show Real.sqrt ((k : ℝ) + 2) ≠ 0 by positivity]
              ring
    have hbranch :
        μ[fun ω ↦ best_achieved_function_value f (fun n ↦ (x[n] ω : E)) k] - fOpt ≤
          (2 * (1 + Real.log 3)) * h_oracle.L_tilde_f * Real.sqrt (2 * Θ) /
            Real.sqrt ((k : ℝ) + 2) :=
      hbound_to_ratio.trans hfinal_ratio
    simpa using hbranch

end
