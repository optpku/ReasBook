-- Proof sketch: after expressing the sampled-block observable through the current sampled block
-- and the finite sampled-block history, specialize Chapter 11's
-- `randomized_block_history_current_block_average` and rewrite the resulting block average with
-- `block_conditional_gradient_norm_eq_sum`.
section

/-- Helper for the RGBCG sublinear-rate item: the Chapter 13 RGBCG problem owner transports to the
Chapter 11 randomized block proximal-gradient owner on raw block coordinates. The stochastic
trajectory, stepsize, and diameter hypotheses remain theorem-level and are not repackaged as a
second public owner. -/
private theorem rgbcgRandomizedBlockProximalGradientAssumptions
    (h_problem : IsGeneralizedBlockConditionalGradientProblem f g Li)
    (hf_closed : LowerSemicontinuous f) :
    RandomizedBlockProximalGradientAssumptions
      (fun y : (j : ι) → Ei j ↦
        f ((PiLp.continuousLinearEquiv (2 : ENNReal) ℝ Ei).symm y))
      g
      (blockGradient f)
      (((PiLp.continuousLinearEquiv (2 : ENNReal) ℝ Ei).symm) ⁻¹'
        unconstrained_problem_solutions F)
      F_opt_real
      Li :=
  by
    let e := PiLp.continuousLinearEquiv (2 : ENNReal) ℝ Ei
    have hopen :
        IsOpen (effective_domain (fun y : (j : ι) → Ei j ↦ f (e.symm y))) := by
      -- The transported effective domain is the preimage of the open PiLp domain.
      simpa [effective_domain, mem_effective_domain] using
        h_problem.f_effective_domain_open.preimage e.symm.continuous
    have hfdiff :
        DifferentiableOn ℝ
          (fun y : (j : ι) → Ei j ↦ (f (e.symm y)).toReal)
          (interior (effective_domain (fun y : (j : ι) → Ei j ↦ f (e.symm y)))) := by
      -- Compose the PiLp differentiability clause with the coordinate equivalence.
      rw [hopen.interior_eq]
      refine h_problem.f_toReal_differentiableOn_effective_domain.comp ?_ ?_
      · exact e.symm.differentiable
      · intro y hy
        simpa [effective_domain, mem_effective_domain] using hy
    exact
      RandomizedBlockProximalGradientAssumptions.ofIsBlockProximalGradientProblem
        (h_problem.toIsBlockProximalGradientProblem hf_closed)
        h_problem.f_convex
        hfdiff

/-- Helper for Theorem 13.29: if the sampled-block point is chosen by a deterministic point rule
depending only on the current iterate and sampled block, then the iterate `x^n` depends only on
the finite sampled-block history `ξ_{n-1}`. -/
private theorem rgbcg_history_adapted_of_point_rule
    (x0 : X)
    (h_zero : x 0 = fun _ ↦ x0)
    (h_traj :
      ∀ ω,
        is_randomized_generalized_block_conditional_gradient_trajectory
          g
          (blockGradient f)
          (fun n ↦ x n ω)
          (fun n ↦ sampled_block n ω)
          (fun n ↦ point n ω)
          t)
    (h_point_rule :
      ∃ pointRule : (i : ι) → X → Ei i,
        ∀ n ω,
          point n ω = pointRule (sampled_block n ω) (x n ω)) :
    ∀ n, ∃ Φn : (Fin n → ι) → X,
      ∀ ω,
        x n ω = Φn (randomized_block_history (fun m ↦ sampled_block m ω) n) := by
  rcases h_point_rule with ⟨pointRule, h_point_rule⟩
  intro n
  induction n with
  | zero =>
      refine ⟨fun _ ↦ x0, ?_⟩
      intro ω
      -- The zeroth iterate is constant, so it is independent of the empty history.
      simpa using congrFun h_zero ω
  | succ n ih =>
      rcases ih with ⟨Φn, hΦn⟩
      refine
        ⟨fun ξ ↦
          let ξprev : Fin n → ι := fun j ↦ ξ ⟨j, Nat.lt_trans j.2 (Nat.lt_succ_self n)⟩
          let xPrev := Φn ξprev
          xPrev +
            𝒰[ξ ⟨n, Nat.lt_succ_self n⟩]
              ((t n : ℝ) •
                (pointRule (ξ ⟨n, Nat.lt_succ_self n⟩) xPrev -
                  xPrev (ξ ⟨n, Nat.lt_succ_self n⟩))), ?_⟩
      intro ω
      -- Rebuild `x (n + 1)` from `x n`, the sampled block `i_n`, and the point-rule update.
      have hstep :=
        is_randomized_generalized_block_conditional_gradient_trajectory_step (h_traj ω) n
      rw [hstep, h_point_rule]
      rw [hΦn ω]
      simp [randomized_block_history]

/-- Helper for Theorem 13.29: at step `n`, the expected sampled-block conditional-gradient
observable equals the uniform block average of the blockwise real observables
`i ↦ (Sᵇ[g, blockGradient f; i](x^n)).toReal`. -/
private lemma rgbcg_expected_sampled_block_gap_eq_uniform_average
    (x0 : X)
    (h_sampled_block_measurable : ∀ k, Measurable (sampled_block k))
    (h_sampled_block_indep : iIndepFun sampled_block μ)
    (h_sampled_block_uniform :
      ∀ k (i : ι), μ ((sampled_block k) ⁻¹' {i}) = 1 / (N : ℝ≥0∞))
    (h_zero : x 0 = fun _ ↦ x0)
    (h_traj :
      ∀ ω,
        is_randomized_generalized_block_conditional_gradient_trajectory
          g
          (blockGradient f)
          (fun n ↦ x n ω)
          (fun n ↦ sampled_block n ω)
          (fun n ↦ point n ω)
          t)
    (h_point_rule :
      ∃ pointRule : (i : ι) → X → Ei i,
        ∀ n ω,
          point n ω = pointRule (sampled_block n ω) (x n ω))
    {n : ℕ} :
    μ[fun ω ↦ (Sᵇ[g, blockGradient f; sampled_block n ω](x n ω)).toReal] =
      μ[fun ω ↦ ((N : ℝ)⁻¹) * ∑ i : ι, (Sᵇ[g, blockGradient f; i](x n ω)).toReal] := by
  classical
  rcases
      rgbcg_history_adapted_of_point_rule x0 h_zero h_traj h_point_rule n with
    ⟨Φn, hΦn⟩
  let ψ : (Fin n → ι) → ι → ℝ := fun ξ i ↦ (Sᵇ[g, blockGradient f; i](Φn ξ)).toReal
  -- Freeze the finite history `ξ_{n-1}` and average only over the current sampled block.
  simpa [ψ, hΦn, randomized_block_history] using
    randomized_block_history_current_block_average
      n
      ψ
      h_sampled_block_measurable
      h_sampled_block_indep
      h_sampled_block_uniform

/-- Helper for Theorem 13.29: a real observable depending only on the finite sampled-block history
`ξ_{n-1}` and the current sampled block `i_n` is integrable because the joint variable takes
values in the finite discrete type `(Fin n → ι) × ι`. -/
private lemma randomizedBlockHistoryCurrentBlockObservable_integrable
    (n : ℕ) (ψ : (Fin n → ι) → ι → ℝ)
    (h_sampled_block_measurable : ∀ k, Measurable (sampled_block k)) :
    Integrable
      (fun ω ↦
        ψ
          (randomized_block_history (fun m ↦ sampled_block m ω) n)
          (sampled_block n ω))
      μ := by
  let history : Ξ → Fin n → ι :=
    fun ω ↦ randomized_block_history (fun m ↦ sampled_block m ω) n
  let joint : Ξ → (Fin n → ι) × ι :=
    fun ω ↦ (history ω, sampled_block n ω)
  have h_history_measurable : Measurable history := by
    -- The finite sampled-block history is measurable coordinatewise.
    refine measurable_pi_lambda _ fun t ↦ ?_
    simpa [history, randomized_block_history] using h_sampled_block_measurable t
  have h_joint_measurable : Measurable joint := by
    -- The paired history/current-block map is measurable componentwise.
    simpa [joint] using h_history_measurable.prodMk (h_sampled_block_measurable n)
  have hψ_integrable :
      Integrable (fun z : (Fin n → ι) × ι ↦ ψ z.1 z.2) (μ.map joint) := by
    -- After mapping to the finite discrete joint space, every real observable is integrable.
    exact Integrable.of_finite
  simpa [history, joint, randomized_block_history] using
    hψ_integrable.comp_measurable h_joint_measurable

/-- Helper for Theorem 13.29: if a frozen history atom `ξ` has positive probability, then
independence and uniform current-block sampling realize every pair `(ξ, i)`. Consequently, the
deterministic point rule agrees with a genuine block argmin at `Φn ξ` for every block `i`. -/
private lemma rgbcgFrozenHistoryPointRuleArgmin_of_positive_history_mass
    (x0 : X)
    (h_sampled_block_measurable : ∀ k, Measurable (sampled_block k))
    (h_sampled_block_indep : iIndepFun sampled_block μ)
    (h_sampled_block_uniform :
      ∀ k (i : ι), μ ((sampled_block k) ⁻¹' {i}) = 1 / (N : ℝ≥0∞))
    (h_zero : x 0 = fun _ ↦ x0)
    (h_traj :
      ∀ ω,
        is_randomized_generalized_block_conditional_gradient_trajectory
          g
          (blockGradient f)
          (fun n ↦ x n ω)
          (fun n ↦ sampled_block n ω)
          (fun n ↦ point n ω)
          t)
    {pointRule : (i : ι) → X → Ei i}
    (h_point_rule :
      ∀ n ω,
        point n ω = pointRule (sampled_block n ω) (x n ω))
    {n : ℕ}
    {Φn : (Fin n → ι) → X}
    (hΦn :
      ∀ ω,
        x n ω = Φn (randomized_block_history (fun m ↦ sampled_block m ω) n))
    {ξ : Fin n → ι}
    (hξ_pos :
      0 <
        (μ.map (fun ω ↦ randomized_block_history (fun m ↦ sampled_block m ω) n)) {ξ})
    (i : ι) :
    pointRule i (Φn ξ) ∈ partial_conditional_gradient_argmin g (blockGradient f) (Φn ξ) i := by
  classical
  let history : Ξ → Fin n → ι :=
    fun ω ↦ randomized_block_history (fun m ↦ sampled_block m ω) n
  let joint : Ξ → (Fin n → ι) × ι :=
    fun ω ↦ (history ω, sampled_block n ω)
  have h_history_measurable : Measurable history := by
    -- The finite sampled-block history is measurable coordinatewise.
    refine measurable_pi_lambda _ fun t ↦ ?_
    simpa [history, randomized_block_history] using h_sampled_block_measurable t
  have h_joint_aemeasurable : AEMeasurable joint μ := by
    -- The joint pair `(ξ_{n-1}, i_n)` is measurable componentwise.
    simpa [joint] using
      h_history_measurable.aemeasurable.prodMk (h_sampled_block_measurable n).aemeasurable
  have hΞ_nonempty : Nonempty Ξ := by
    by_contra hΞ
    have huniv : (Set.univ : Set Ξ) = ∅ := by
      ext ω
      exact False.elim (hΞ ⟨ω⟩)
    have hzero : μ Set.univ = 0 := by
      simpa [huniv] using (measure_empty : μ (∅ : Set Ξ) = 0)
    simpa using hzero
  have hN_pos_nat : 0 < N := by
    exact Fintype.card_pos_iff.mpr ⟨sampled_block 0 (Classical.choice hΞ_nonempty)⟩
  have hN_ne_zero_ennreal : (N : ℝ≥0∞) ≠ 0 := by
    exact_mod_cast Nat.ne_of_gt hN_pos_nat
  have hmap_singleton :
      (μ.map (sampled_block n)) {i} = 1 / (N : ℝ≥0∞) := by
    rw [Measure.map_apply (h_sampled_block_measurable n) (MeasurableSet.singleton i)]
    exact h_sampled_block_uniform n i
  have hpair_mass :
      (μ.map joint) {(ξ, i)} =
        (μ.map history) {ξ} * (μ.map (sampled_block n)) {i} := by
    -- Factor the joint law into the history marginal times the current-block marginal.
    calc
      (μ.map joint) {(ξ, i)} =
          ((μ.map history).prod (μ.map (sampled_block n))) {(ξ, i)} := by
            rw [randomized_block_history_current_block_jointlaw
              (sampled_block := sampled_block)
              (μ := μ)
              n
              h_sampled_block_measurable
              h_sampled_block_indep]
      _ = (μ.map history) {ξ} * (μ.map (sampled_block n)) {i} := by
            simpa [singleton_prod_singleton] using
              (Measure.prod_prod
                (μ := μ.map history)
                (ν := μ.map (sampled_block n))
                ({ξ} : Set (Fin n → ι))
                ({i} : Set ι))
  have hpair_pos : 0 < (μ.map joint) {(ξ, i)} := by
    rw [hpair_mass, hmap_singleton]
    have hcurrent_pos : 0 < (1 / (N : ℝ≥0∞)) := by
      simpa [one_div] using ENNReal.inv_pos.mpr hN_ne_zero_ennreal
    exact ENNReal.mul_pos hξ_pos hcurrent_pos
  have hpreimage_pos : 0 < μ (joint ⁻¹' ({(ξ, i)} : Set ((Fin n → ι) × ι))) := by
    -- Rewrite the positive joint atom as the measure of its preimage under the joint map.
    rw [← Measure.map_apply_of_aemeasurable h_joint_aemeasurable (MeasurableSet.singleton (ξ, i))]
    exact hpair_pos
  have hpreimage_nonempty :
      Set.Nonempty (joint ⁻¹' ({(ξ, i)} : Set ((Fin n → ι) × ι))) := by
    by_contra hpreimage_empty
    have hpreimage_zero :
        μ (joint ⁻¹' ({(ξ, i)} : Set ((Fin n → ι) × ι))) = 0 := by
      simpa [Set.not_nonempty_iff_eq_empty.mp hpreimage_empty] using
        (measure_empty : μ (∅ : Set Ξ) = 0)
    exact hpair_pos.ne' <| by
      rw [← Measure.map_apply_of_aemeasurable h_joint_aemeasurable (MeasurableSet.singleton (ξ, i))]
      exact hpreimage_zero
  rcases hpreimage_nonempty with ⟨ω, hω⟩
  have hhistory : history ω = ξ := by
    exact Prod.mk.inj_iff.mp (Set.mem_singleton_iff.mp hω).1
  have hsampled : sampled_block n ω = i := by
    exact Prod.mk.inj_iff.mp (Set.mem_singleton_iff.mp hω).2
  have hx_eq : x n ω = Φn ξ := by
    simpa [history, hhistory] using hΦn ω
  have hargmin_realized :
      point n ω ∈ partial_conditional_gradient_argmin g (blockGradient f) (x n ω) i := by
    simpa [hsampled] using
      is_randomized_generalized_block_conditional_gradient_trajectory_argmin (h_traj ω) n
  -- Transfer the realized sampled-block argmin to the deterministic point rule at the frozen
  -- history representative `Φn ξ`.
  simpa [h_point_rule n ω, hsampled, hx_eq] using hargmin_realized

/-- Helper for Theorem 13.29: a minimizer of the sampled block linearized subproblem has finite
block penalty value, so it lies in the effective domain of the active block penalty. -/
private lemma rgbcgPartialArgminMemEffectiveDomain
    (h_problem : IsGeneralizedBlockConditionalGradientProblem f g Li)
    {y : X} (hy : y ∈ domG)
    {i : ι} {v : Ei i}
    (hv : v ∈ partial_conditional_gradient_argmin g (blockGradient f) y i) :
    v ∈ effective_domain (g i) := by
  -- Rewrite the block argmin witness as pointwise minimality of the block subproblem.
  rw [mem_partial_conditional_gradient_argmin_iff, isMinOn_univ_iff] at hv
  have hy_raw : ((PiLp.continuousLinearEquiv (2 : ENNReal) ℝ Ei) y) ∈ effective_domain (separableSum g) := by
    simpa [PiLp.separableSum_apply] using hy
  have hyi :
      y i ∈ effective_domain (g i) := by
    simpa using
      block_mem_effective_domain_of_mem_separableSum_effective_domain
        g
        h_problem.block_g_proper
        hy_raw
        i
  have hx_sub_lt_top :
      partial_conditional_gradient_subproblem g (blockGradient f) y i (y i) < ⊤ := by
    -- The block subproblem is finite at the comparison point `y_i` because `g_i(y_i)` is finite.
    rw [partial_conditional_gradient_subproblem_apply]
    exact EReal.add_lt_top (EReal.coe_ne_top _) (mem_effective_domain.mp hyi).ne
  have hv_sub_ne_top :
      partial_conditional_gradient_subproblem g (blockGradient f) y i v ≠ ⊤ := by
    exact ne_of_lt (lt_of_le_of_lt (hv (y i)) hx_sub_lt_top)
  have hgv_ne_top : g i v ≠ ⊤ := by
    intro hgv_top
    have hv_sub_top :
        partial_conditional_gradient_subproblem g (blockGradient f) y i v = ⊤ := by
      rw [partial_conditional_gradient_subproblem_apply, hgv_top]
      simpa [add_comm] using EReal.top_add_of_ne_bot (EReal.coe_ne_bot _)
    exact hv_sub_ne_top hv_sub_top
  -- Membership in the effective domain only asks for finiteness from above.
  exact mem_effective_domain.mpr (lt_top_iff_ne_top.mpr hgv_ne_top)

/-- Helper for Theorem 13.29: every realized RGBCG iterate stays in the effective domain of the
aggregate block-separable penalty. -/
private lemma rgbcgIterateMemEffectiveDomain
    (h_problem : IsGeneralizedBlockConditionalGradientProblem f g Li)
    (h_traj :
      ∀ ω,
        is_randomized_generalized_block_conditional_gradient_trajectory
          g
          (blockGradient f)
          (fun n ↦ x n ω)
          (fun n ↦ sampled_block n ω)
          (fun n ↦ point n ω)
          t) :
    ∀ n ω, x n ω ∈ domG := by
  intro n ω
  induction n with
  | zero =>
      -- The trajectory owner already records feasibility of the initial iterate.
      exact is_randomized_generalized_block_conditional_gradient_trajectory_zero (h_traj ω)
  | succ n ihn =>
      let i : ι := sampled_block n ω
      have hx_prev : x n ω ∈ domG := ihn ω
      have hp_argmin :
          point n ω ∈ partial_conditional_gradient_argmin g (blockGradient f) (x n ω) i := by
        simpa [i] using
          is_randomized_generalized_block_conditional_gradient_trajectory_argmin (h_traj ω) n
      have hp_dom :
          point n ω ∈ effective_domain (g i) := by
        exact rgbcgPartialArgminMemEffectiveDomain
          h_problem
          hx_prev
          hp_argmin
      have hx_prev_raw :
          ((PiLp.continuousLinearEquiv (2 : ENNReal) ℝ Ei) (x n ω)) ∈ effective_domain (separableSum g) := by
        simpa [PiLp.separableSum_apply] using hx_prev
      have hxi_dom :
          x n ω i ∈ effective_domain (g i) := by
        simpa using
          block_mem_effective_domain_of_mem_separableSum_effective_domain
            g
            h_problem.block_g_proper
            hx_prev_raw
            i
      have hactive_dom :
          (1 - (t n : ℝ)) • x n ω i + (t n : ℝ) • point n ω ∈ effective_domain (g i) := by
        -- Only the active block changes, and it stays on the feasible segment from `x_i^n` to `p_i^n`.
        simpa [add_comm] using
          combo_mem_effective_domain_of_is_convex_function
            (h_problem.block_g_convex i)
            hp_dom
            hxi_dom
            (t n).2
      have hstep :=
        is_randomized_generalized_block_conditional_gradient_trajectory_step (h_traj ω) n
      -- Route correction: prove domain feasibility coordinatewise, rather than trying to push the
      -- whole PiLp update through a heavier transport lemma.
      rw [mem_effective_domain, PiLp.separableSum_apply]
      refine ereal_sum_lt_top Finset.univ (fun j ↦ g j (x (n + 1) ω j)) ?_
      intro j _
      by_cases hj : j = i
      · subst j
        have hcoord :
            x (n + 1) ω i = (1 - (t n : ℝ)) • x n ω i + (t n : ℝ) • point n ω := by
          -- Expand the sampled-block update and collect the active coordinate into convex-combination form.
          calc
            x (n + 1) ω i = x n ω i + (t n : ℝ) • (point n ω - x n ω i) := by
              simpa [hstep, i]
            _ = (1 - (t n : ℝ)) • x n ω i + (t n : ℝ) • point n ω := by
              rw [smul_sub]
              abel
        rw [hcoord]
        exact mem_effective_domain.mp hactive_dom
      · have hcoord : x (n + 1) ω j = x n ω j := by
          -- Every inactive block is unchanged by the sampled singleton update.
          simpa [hstep, i, hj]
        rw [hcoord]
        have hxj_dom :
            x n ω j ∈ effective_domain (g j) := by
          simpa using
            block_mem_effective_domain_of_mem_separableSum_effective_domain
              g
              h_problem.block_g_proper
              hx_prev_raw
              j
        exact mem_effective_domain.mp hxj_dom

/-- Helper for Theorem 13.29: at every feasible point of the aggregate block-separable penalty,
the composite objective `F` is finite and equals the coercion of its real representative. -/
private lemma rgbcgCompositeModelObjective_eq_coe_real_of_mem_effective_domain
    (h_problem : IsGeneralizedBlockConditionalGradientProblem f g Li)
    {y : X} (hy : y ∈ domG) :
    F y = ((((f y).toReal + ((PiLp.separableSum g) y).toReal : ℝ)) : EReal) := by
  have hyf :
      y ∈ effective_domain f :=
    h_problem.g_effective_domain_subset_f_effective_domain hy
  have hfy :
      (((f y).toReal : ℝ) : EReal) = f y := by
    exact
      EReal.coe_toReal
        (mem_effective_domain.mp hyf).ne
        (h_problem.f_ne_bot y)
  have hgy :
      (((PiLp.separableSum g y).toReal : ℝ) : EReal) = PiLp.separableSum g y := by
    exact
      EReal.coe_toReal
        (mem_effective_domain.mp hy).ne
        ((separableSum_proper g h_problem.block_g_proper).ne_bot y)
  -- Rewrite both objective summands through their finite real representatives.
  rw [composite_model_objective_apply, ← hfy, ← hgy]
  simpa using
    (EReal.coe_add (f y).toReal ((PiLp.separableSum g) y).toReal).symm

/-- Helper for Theorem 13.29: at every feasible point of `dom(g)`, the composite objective
`F(y)` has the expected real-valued `toReal` formula. -/
private lemma rgbcgCompositeModelObjective_toReal_eq_of_mem_effective_domain
    (h_problem : IsGeneralizedBlockConditionalGradientProblem f g Li)
    {y : X} (hy : y ∈ domG) :
    (F y).toReal = (f y).toReal + ((PiLp.separableSum g) y).toReal := by
  -- The finite-value normalization from the previous helper turns `toReal` into the displayed sum.
  rw [rgbcgCompositeModelObjective_eq_coe_real_of_mem_effective_domain
    h_problem hy]
  simpa using EReal.toReal_coe ((f y).toReal + ((PiLp.separableSum g) y).toReal)

/-- Helper for Theorem 13.29: the block gap objectives sum to the expected affine-plus-separable
comparison expression. -/
private lemma rgbcgSumPartialGaps_eq_innerAddSub
    (y q : X) :
    ∑ i : ι, partial_conditional_gradient_gap_objective g (blockGradient f) y i (q i) =
      (((inner ℝ (∇ (fun z : X ↦ (f z).toReal) y) (y - q) : ℝ)) : EReal) +
        PiLp.separableSum g y - PiLp.separableSum g q := by
  -- Expand the partial gaps, then regroup the blockwise linear and penalty terms into the
  -- ambient inner product and separable-sum expressions.
  rw [PiLp.inner_apply, PiLp.separableSum_apply, ereal_coe_sum, sub_eq_add_neg, sub_eq_add_neg]
  rw [← Finset.sum_neg_distrib, ← Finset.sum_add_distrib, ← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl ?_
  intro i hi
  rw [partial_conditional_gradient_gap_objective_apply,
    GeneralizedBlockConditionalGradient.blockGradient_apply, PiLp.coe_symm_continuousLinearEquiv]
  simp [sub_eq_add_neg, add_assoc, add_left_comm, add_comm]

/-- Helper for Theorem 13.29: every feasible block subproblem attains its minimum on
`effective_domain (g i)`. -/
private lemma rgbcgPartialArgminNonempty
    (h_problem : IsGeneralizedBlockConditionalGradientProblem f g Li)
    {y : X} (hy : y ∈ domG) (i : ι) :
    (partial_conditional_gradient_argmin g (blockGradient f) y i).Nonempty := by
  have hy_raw :
      ((PiLp.continuousLinearEquiv (2 : ENNReal) ℝ Ei) y) ∈ effective_domain (separableSum g) := by
    simpa [PiLp.separableSum_apply] using hy
  have hyi :
      y i ∈ effective_domain (g i) := by
    simpa using
      block_mem_effective_domain_of_mem_separableSum_effective_domain
        g
        h_problem.block_g_proper
        hy_raw
        i
  have hlinear_cont :
      Continuous
        (fun v : Ei i ↦
          (((inner ℝ v (blockGradient f i y) : ℝ)) : EReal)) := by
    exact continuous_coe_real_ereal.comp (Continuous.inner continuous_id continuous_const)
  have hsub_lsc :
      LowerSemicontinuousOn
        (partial_conditional_gradient_subproblem g (blockGradient f) y i)
        (effective_domain (g i)) := by
    -- The block subproblem is a continuous finite linear term plus the closed block penalty.
    have hlinear_lsc :
        LowerSemicontinuousOn
          (fun v : Ei i ↦ (((inner ℝ v (blockGradient f i y) : ℝ)) : EReal))
          (effective_domain (g i)) :=
      hlinear_cont.continuousOn.lowerSemicontinuousOn
    refine
      hlinear_lsc.add'
        ((h_problem.block_g_closed i).lowerSemicontinuousOn _) ?_
    intro v hv
    exact
      EReal.continuousAt_add
        (.inl (EReal.coe_ne_top _))
        (.inl ((h_problem.block_g_proper i).ne_bot v))
  obtain ⟨v, hvdom, hvmin⟩ :=
    exists_isMinOn_on_compact
      (partial_conditional_gradient_subproblem g (blockGradient f) y i)
      (effective_domain (g i))
      hsub_lsc
      (h_problem.g_effective_domain_compact i)
      ⟨y i, hyi⟩
  have hvmin_univ :
      IsMinOn
        (partial_conditional_gradient_subproblem g (blockGradient f) y i)
        Set.univ
        v := by
    -- Outside `effective_domain (g i)` the composite block subproblem is `⊤`, so minimizing on
    -- the effective domain already gives the global minimizer.
    refine
      (isMinOn_composite_model_objective_univ_iff_isMinOn_effective_domain
        (fun z ↦ EReal.coe_ne_bot (inner ℝ z (blockGradient f i y)))).2 ?_
    simpa [partial_conditional_gradient_subproblem] using hvmin
  exact ⟨v, mem_partial_conditional_gradient_argmin_iff.mpr hvmin_univ⟩

/-- Helper for Theorem 13.29: convexity of `f` gives the supporting-plane inequality at the
feasible base point `x`. -/
private lemma rgbcgConvexSupportToRealAtBasepoint
    (h_problem : IsGeneralizedBlockConditionalGradientProblem f g Li)
    {x y : X}
    (hx_f : x ∈ effective_domain f)
    (hx_diff : DifferentiableAt ℝ (fun z : X ↦ (f z).toReal) x)
    (hy_f : y ∈ effective_domain f) :
    (f y).toReal ≥ (f x).toReal + inner ℝ (∇ (fun z : X ↦ (f z).toReal) x) (y - x) := by
  let line : ℝ →ᵃ[ℝ] X := AffineMap.lineMap x y
  let φ : ℝ → ℝ := fun t ↦ EReal.toReal (f (line t))
  have hconv :
      ConvexOn ℝ (effective_domain f) (fun z : X ↦ (f z).toReal) :=
    convexOn_toReal_of_is_convex_function h_problem.f_convex (fun z _ ↦ h_problem.f_ne_bot z)
  have hφ_convex :
      ConvexOn ℝ (line ⁻¹' effective_domain f) φ := by
    -- Restrict the convex real-valued model to the line through the two feasible points.
    simpa [φ, line] using hconv.comp_affineMap line
  have hφ_zero :
      (0 : ℝ) ∈ line ⁻¹' effective_domain f := by
    simpa [line] using hx_f
  have hφ_one :
      (1 : ℝ) ∈ line ⁻¹' effective_domain f := by
    simpa [line] using hy_f
  have hφ_deriv :
      HasDerivAt φ (inner ℝ (∇ (fun z : X ↦ (f z).toReal) x) (y - x)) 0 := by
    -- Differentiate the line restriction and identify the derivative with the ambient gradient.
    have hcomp :
        HasDerivAt φ (fderiv ℝ (fun z : X ↦ (f z).toReal) x (y - x)) 0 := by
      have hbase :
          HasFDerivAt (fun z : X ↦ (f z).toReal)
            (fderiv ℝ (fun z : X ↦ (f z).toReal) x)
            (line 0) := by
        simpa [line] using hx_diff.hasFDerivAt
      have hline : HasDerivAt line (y - x) 0 := by
        simpa [line] using
          (show HasDerivAt (AffineMap.lineMap x y) (y - x) (0 : ℝ) from
            AffineMap.hasDerivAt_lineMap)
      simpa [φ, line] using HasFDerivAt.comp_hasDerivAt 0 hbase hline
    have hgrad :
        fderiv ℝ (fun z : X ↦ (f z).toReal) x (y - x) =
          inner ℝ (∇ (fun z : X ↦ (f z).toReal) x) (y - x) := by
      simpa using
        (show
            fderiv ℝ (fun z : X ↦ (f z).toReal) x (y - x) =
              inner ℝ (∇ (fun z : X ↦ (f z).toReal) x) (y - x) from
          HasGradientAt.fderiv_apply hx_diff.hasGradientAt)
    simpa [hgrad] using hcomp
  have hsecant :
      inner ℝ (∇ (fun z : X ↦ (f z).toReal) x) (y - x) ≤ slope φ 0 1 := by
    exact hφ_convex.le_slope_of_hasDerivAt hφ_zero hφ_one zero_lt_one hφ_deriv
  have hsecant' :
      inner ℝ (∇ (fun z : X ↦ (f z).toReal) x) (y - x) ≤
        (f y).toReal - (f x).toReal := by
    simpa [φ, line, slope] using hsecant
  linarith

/-- Helper for Theorem 13.29: at every feasible point, the total block conditional-gradient norm
is finite. -/
private lemma rgbcgBlockConditionalGradientNorm_neTop
    (h_problem : IsGeneralizedBlockConditionalGradientProblem f g Li)
    {y : X} (hy : y ∈ domG) :
    Sᵇ[g, blockGradient f](y) ≠ ⊤ := by
  classical
  choose qSel hqSel using
    fun i : ι ↦ rgbcgPartialArgminNonempty h_problem hy i
  rw [block_conditional_gradient_norm_eq_sum]
  have hsum_eq :
      ∑ i : ι, Sᵇ[g, blockGradient f; i](y) =
        ∑ i : ι, partial_conditional_gradient_gap_objective g (blockGradient f) y i (qSel i) := by
    refine Finset.sum_congr rfl ?_
    intro i hi
    exact partial_conditional_gradient_norm_eq_of_mem_argmin (hqSel i)
  rw [hsum_eq]
  refine ereal_sum_ne_top Finset.univ ?_
  intro i hi
  rw [partial_conditional_gradient_gap_objective_apply]
  exact EReal.add_ne_top (EReal.coe_ne_top _) (mem_effective_domain.mp <|
    rgbcgPartialArgminMemEffectiveDomain
      h_problem
      hy
      (hqSel i))

/-- Helper for Theorem 13.29: at every feasible point, the total block conditional-gradient norm
is the sum of the real blockwise norms `∑ i, (S_i(x)).toReal`. -/
private lemma rgbcgBlockConditionalGradientNorm_toReal_eq_sum
    (h_problem : IsGeneralizedBlockConditionalGradientProblem f g Li)
    {y : X} (hy : y ∈ domG) :
    (Sᵇ[g, blockGradient f](y)).toReal =
      ∑ i : ι, (Sᵇ[g, blockGradient f; i](y)).toReal := by
  classical
  choose qSel hqSel using
    fun i : ι ↦ rgbcgPartialArgminNonempty h_problem hy i
  have hpartial_val :
      ∀ i : ι,
        (((Sᵇ[g, blockGradient f; i](y)).toReal : ℝ) : EReal) =
          Sᵇ[g, blockGradient f; i](y) := by
    intro i
    rw [partial_conditional_gradient_norm_eq_of_mem_argmin (hqSel i),
      partial_conditional_gradient_gap_objective_apply]
    have hqi_dom :
        qSel i ∈ effective_domain (g i) := by
      exact rgbcgPartialArgminMemEffectiveDomain h_problem hy (hqSel i)
    have hy_raw :
        ((PiLp.continuousLinearEquiv (2 : ENNReal) ℝ Ei) y) ∈ effective_domain (separableSum g) := by
      simpa [PiLp.separableSum_apply] using hy
    have hyi_dom :
        y i ∈ effective_domain (g i) := by
      simpa using
        block_mem_effective_domain_of_mem_separableSum_effective_domain
          g
          h_problem.block_g_proper
          hy_raw
          i
    have hyi_val :
        (((g i (y i)).toReal : ℝ) : EReal) = g i (y i) := by
      exact
        (EReal.coe_toReal (mem_effective_domain.mp hyi_dom).ne
          ((h_problem.block_g_proper i).ne_bot _)).symm
    have hqi_val :
        (((g i (qSel i)).toReal : ℝ) : EReal) = g i (qSel i) := by
      exact
        (EReal.coe_toReal (mem_effective_domain.mp hqi_dom).ne
          ((h_problem.block_g_proper i).ne_bot _)).symm
    rw [hyi_val, hqi_val, ← EReal.coe_add, ← EReal.coe_sub]
    simp
  rw [block_conditional_gradient_norm_eq_sum]
  have hsum_val :
      ∑ i : ι, Sᵇ[g, blockGradient f; i](y) =
        (((∑ i : ι, (Sᵇ[g, blockGradient f; i](y)).toReal : ℝ)) : EReal) := by
    calc
      ∑ i : ι, Sᵇ[g, blockGradient f; i](y) =
          ∑ i : ι, (((Sᵇ[g, blockGradient f; i](y)).toReal : ℝ) : EReal) := by
            refine Finset.sum_congr rfl ?_
            intro i hi
            exact (hpartial_val i).symm
      _ = (((∑ i : ι, (Sᵇ[g, blockGradient f; i](y)).toReal : ℝ)) : EReal) := by
            symm
            exact ereal_coe_sum
  rw [hsum_val]
  simpa using EReal.toReal_coe (∑ i : ι, (Sᵇ[g, blockGradient f; i](y)).toReal)

/-- Helper for Theorem 13.29: the RGBCG objective gap is the ordinary difference of the finite
objective value and the finite optimal value. -/
private lemma rgbcgObjectiveGap_toReal_eq_sub_optimal_value
    (h_problem : IsGeneralizedBlockConditionalGradientProblem f g Li)
    {y : X} (hy : y ∈ domG) :
    (F y - F_opt).toReal = (F y).toReal - F_opt_real := by
  obtain ⟨xStar, hxStar⟩ := h_problem.optimal_set_nonempty
  have hy_val :
      F y = (((F y).toReal : ℝ) : EReal) := by
    rw [rgbcgCompositeModelObjective_eq_coe_real_of_mem_effective_domain h_problem hy]
    exact (EReal.coe_toReal (EReal.coe_ne_top _) (EReal.coe_ne_bot _)).symm
  have hdom_nonempty : domG.Nonempty := by
    classical
    choose z hz using fun j ↦ (h_problem.block_g_proper j).effective_domain_nonempty
    refine ⟨WithLp.toLp 2 (fun j ↦ z j), ?_⟩
    rw [mem_effective_domain, PiLp.separableSum_apply]
    exact ereal_sum_lt_top Finset.univ (fun j ↦ g j ((WithLp.toLp 2 (fun k ↦ z k)) j))
      (fun j _ ↦ by simpa [PiLp.toLp_apply] using hz j)
  rcases hdom_nonempty with ⟨z, hz⟩
  have hFxStar_ne_top : F xStar ≠ ⊤ := by
    have hzF : z ∈ effective_domain F := by
      exact mem_effective_domain.mpr <|
        by
          simpa [F, composite_model_objective_apply] using
            (EReal.add_lt_top
              (mem_effective_domain.mp (h_problem.g_effective_domain_subset_f_effective_domain hz)).ne
              (mem_effective_domain.mp hz).ne)
    have hxmin : IsMinOn F Set.univ xStar := by
      simpa using hxStar
    exact ne_of_lt <| lt_of_le_of_lt (hxmin (by simp : z ∈ (Set.univ : Set X))) (mem_effective_domain.mp hzF)
  have hxStar_dom : xStar ∈ domG := by
    refine mem_effective_domain.mpr <| lt_top_iff_ne_top.mpr ?_
    intro hg_top
    have htop : F xStar = ⊤ := by
      rw [composite_model_objective_apply, hg_top]
      simpa using EReal.top_add_of_ne_bot (h_problem.f_ne_bot xStar)
    exact hFxStar_ne_top htop
  have hopt_eq :
      F_opt = F xStar :=
    h_problem.optimal_value_eq_of_mem_optimal_set hxStar
  have hopt_val :
      F_opt = (((F_opt).toReal : ℝ) : EReal) := by
    rw [hopt_eq, rgbcgCompositeModelObjective_eq_coe_real_of_mem_effective_domain h_problem hxStar_dom]
    exact (EReal.coe_toReal (EReal.coe_ne_top _) (EReal.coe_ne_bot _)).symm
  rw [hy_val, hopt_val, ← EReal.coe_sub]
  simp

/-- Helper for Theorem 13.29: convexity identifies the block conditional-gradient norm as a real
upper bound for the objective gap at every feasible point. -/
private lemma rgbcgBlockConditionalGradientNorm_toReal_ge_objectiveGap
    (h_problem : IsGeneralizedBlockConditionalGradientProblem f g Li)
    {y : X} (hy : y ∈ domG) :
    (F y).toReal - F_opt_real ≤ (Sᵇ[g, blockGradient f](y)).toReal := by
  obtain ⟨xStar, hxStar⟩ := h_problem.optimal_set_nonempty
  have hy_f :
      y ∈ effective_domain f :=
    h_problem.g_effective_domain_subset_f_effective_domain hy
  have hy_diff :
      DifferentiableAt ℝ (fun z : X ↦ (f z).toReal) y :=
    (h_problem.f_toReal_differentiableOn_effective_domain y hy_f).differentiableAt
      (h_problem.f_effective_domain_open.mem_nhds hy_f)
  have hdom_nonempty : domG.Nonempty := by
    classical
    choose z hz using fun j ↦ (h_problem.block_g_proper j).effective_domain_nonempty
    refine ⟨WithLp.toLp 2 (fun j ↦ z j), ?_⟩
    rw [mem_effective_domain, PiLp.separableSum_apply]
    exact ereal_sum_lt_top Finset.univ (fun j ↦ g j ((WithLp.toLp 2 (fun k ↦ z k)) j))
      (fun j _ ↦ by simpa [PiLp.toLp_apply] using hz j)
  rcases hdom_nonempty with ⟨z, hz⟩
  have hFxStar_ne_top : F xStar ≠ ⊤ := by
    have hzF : z ∈ effective_domain F := by
      exact mem_effective_domain.mpr <|
        by
          simpa [F, composite_model_objective_apply] using
            (EReal.add_lt_top
              (mem_effective_domain.mp (h_problem.g_effective_domain_subset_f_effective_domain hz)).ne
              (mem_effective_domain.mp hz).ne)
    have hxmin : IsMinOn F Set.univ xStar := by
      simpa using hxStar
    exact ne_of_lt <| lt_of_le_of_lt (hxmin (by simp : z ∈ (Set.univ : Set X))) (mem_effective_domain.mp hzF)
  have hxStar_dom : xStar ∈ domG := by
    refine mem_effective_domain.mpr <| lt_top_iff_ne_top.mpr ?_
    intro hg_top
    have htop : F xStar = ⊤ := by
      rw [composite_model_objective_apply, hg_top]
      simpa using EReal.top_add_of_ne_bot (h_problem.f_ne_bot xStar)
    exact hFxStar_ne_top htop
  have hxStar_f :
      xStar ∈ effective_domain f :=
    h_problem.g_effective_domain_subset_f_effective_domain hxStar_dom
  have hsupport :
      (f xStar).toReal ≥
        (f y).toReal +
          inner ℝ (∇ (fun z : X ↦ (f z).toReal) y) (xStar - y) :=
    rgbcgConvexSupportToRealAtBasepoint h_problem hy_f hy_diff hxStar_f
  have hsupport' :
      (((f y).toReal - (f xStar).toReal : ℝ) : EReal) ≤
        (((inner ℝ (∇ (fun z : X ↦ (f z).toReal) y) (y - xStar) : ℝ)) : EReal) := by
    have hreal :
        (f y).toReal - (f xStar).toReal ≤
          inner ℝ (∇ (fun z : X ↦ (f z).toReal) y) (y - xStar) := by
      have hneg :
          inner ℝ (∇ (fun z : X ↦ (f z).toReal) y) (xStar - y) =
            -inner ℝ (∇ (fun z : X ↦ (f z).toReal) y) (y - xStar) := by
        have hsub : xStar - y = -(y - xStar) := by
          abel
        rw [hsub, inner_neg_right]
      rw [hneg] at hsupport
      linarith
    exact EReal.coe_le_coe hreal
  have hblock_dom_le :
      (((inner ℝ (∇ (fun z : X ↦ (f z).toReal) y) (y - xStar) : ℝ)) : EReal) +
          PiLp.separableSum g y - PiLp.separableSum g xStar ≤
        Sᵇ[g, blockGradient f](y) := by
    rw [← rgbcgSumPartialGaps_eq_innerAddSub y xStar,
      block_conditional_gradient_norm_eq_sum]
    refine Finset.sum_le_sum ?_
    intro i hi
    rw [partial_conditional_gradient_norm_eq_sSup_gap_objective]
    exact le_sSup ⟨xStar i, rfl⟩
  have hgap_ereal :
      F y - F_opt ≤ Sᵇ[g, blockGradient f](y) := by
    rw [h_problem.optimal_value_eq_of_mem_optimal_set hxStar]
    rw [rgbcgCompositeModelObjective_eq_coe_real_of_mem_effective_domain h_problem hy,
      rgbcgCompositeModelObjective_eq_coe_real_of_mem_effective_domain h_problem hxStar_dom,
      EReal.coe_add, EReal.coe_add]
    calc
      ((((f y).toReal + (PiLp.separableSum g y).toReal : ℝ)) : EReal) -
          ((((f xStar).toReal + (PiLp.separableSum g xStar).toReal : ℝ)) : EReal)
          =
        ((((f y).toReal - (f xStar).toReal : ℝ)) : EReal) +
          (PiLp.separableSum g y - PiLp.separableSum g xStar) := by
            rw [← EReal.coe_sub, sub_eq_add_neg, sub_eq_add_neg, EReal.coe_neg]
            ring_nf
      _ ≤
        (((inner ℝ (∇ (fun z : X ↦ (f z).toReal) y) (y - xStar) : ℝ)) : EReal) +
          (PiLp.separableSum g y - PiLp.separableSum g xStar) :=
            add_le_add_right hsupport' _
      _ ≤ Sᵇ[g, blockGradient f](y) := hblock_dom_le
  have hleft_bot :
      F y - F_opt ≠ ⊥ := by
    rw [rgbcgObjectiveGap_toReal_eq_sub_optimal_value h_problem hy]
    exact EReal.coe_ne_bot _
  have hright_top :
      Sᵇ[g, blockGradient f](y) ≠ ⊤ :=
    rgbcgBlockConditionalGradientNorm_neTop h_problem hy
  have hreal :
      (F y - F_opt).toReal ≤ (Sᵇ[g, blockGradient f](y)).toReal :=
    EReal.toReal_le_toReal hgap_ereal hleft_bot hright_top
  rw [rgbcgObjectiveGap_toReal_eq_sub_optimal_value h_problem hy] at hreal
  exact hreal

/-- Helper for Theorem 13.29: re-centering the `i`-th RGBCG block slice at `d` identifies its
gradient with the Chapter 13 block gradient at the updated point `x + 𝒰[i] d`. -/
private theorem rgbcgBlockCoordinateSliceHasGradientAt
    (h_problem : IsGeneralizedBlockConditionalGradientProblem f g Li)
    (i : ι) {x : X} {d : Ei i}
    (hxd : x + (𝒰[i] d : X) ∈ interior (effective_domain f)) :
    HasGradientAt
      (block_coordinate_slice f x i)
      (blockGradient f i (x + (𝒰[i] d : X)))
      d := by
  let y := block_coordinate_update x i d
  have hy :
      block_coordinate_slice f y i =
        fun e : Ei i ↦ block_coordinate_slice f x i (d + e) := by
    funext e
    have hupdate :
        block_coordinate_update (block_coordinate_update x i d) i e =
          block_coordinate_update x i (d + e) := by
      ext j
      by_cases hji : j = i
      · subst j
        simp [block_coordinate_update, add_assoc, add_left_comm, add_comm]
      · simp [block_coordinate_update, hji]
    simpa [y, block_coordinate_slice_apply] using congrArg (fun z ↦ (f z).toReal) hupdate
  have hshift :
      HasGradientAt
        (fun e : Ei i ↦ block_coordinate_slice f x i (d + e))
        (blockGradient f i y)
        0 := by
    have hbase_fderiv :=
      h_problem.block_partial_gradient_spec
        i
        (show y ∈ effective_domain f by
          exact interior_subset hxd)
    have hbase :
        HasGradientAt (block_coordinate_slice f y i) (blockGradient f i y) 0 := by
      rw [hasGradientAt_iff_hasFDerivAt]
      simpa [y, GeneralizedBlockConditionalGradient.blockGradient_apply,
        block_coordinate_slice_apply] using hbase_fderiv
    rw [hy] at hbase
    exact hbase
  rw [hasGradientAt_iff_hasFDerivAt] at hshift ⊢
  simpa using (hasFDerivAt_comp_add_left d).1 hshift

/-- Helper for Theorem 13.29: the Chapter 13 block-Lipschitz hypothesis makes the frozen
one-block slice `Li i`-smooth on its admissible update domain. -/
private theorem rgbcgBlockCoordinateSliceIsLSmoothOn
    (h_problem : IsGeneralizedBlockConditionalGradientProblem f g Li)
    (i : ι) {x : X} :
    is_l_smooth_on
      (block_coordinate_slice f x i)
      {d : Ei i | x + (𝒰[i] d : X) ∈ interior (effective_domain f)}
      (PosReal.toNNReal (Li i)) := by
  rw [is_l_smooth_on_iff_forall_norm_sub_le]
  refine ⟨?_, ?_⟩
  · intro d hd
    exact (rgbcgBlockCoordinateSliceHasGradientAt h_problem i hd).differentiableAt
  · intro d hd e he
    have hde :
        block_coordinate_update (block_coordinate_update x i d) i (e - d) =
          block_coordinate_update x i e := by
      classical
      ext j
      by_cases hji : j = i
      · subst j
        simp [block_coordinate_update, sub_eq_add_neg, add_assoc, add_left_comm, add_comm]
      · simp [block_coordinate_update, hji]
    have hde' :
        block_coordinate_update (x + (𝒰[i] d : X)) i (e - d) =
          x + (𝒰[i] e : X) := by
      simpa [block_coordinate_update] using hde
    have he' :
        block_coordinate_update (x + (𝒰[i] d : X)) i (e - d) ∈
          interior (effective_domain f) := by
      simpa [block_coordinate_update] using (show
        block_coordinate_update (block_coordinate_update x i d) i (e - d) ∈
          interior (effective_domain f) by
        rw [hde]
        exact he)
    have hlip :=
      h_problem.block_partial_gradient_lipschitz
        i
        (show x + (𝒰[i] d : X) ∈ effective_domain f by
          exact interior_subset hd)
        (show
            block_coordinate_update (x + (𝒰[i] d : X)) i (e - d) ∈
              effective_domain f by
          exact interior_subset he')
    have hdgrad :
        HasGradientAt
          (block_coordinate_slice f x i)
          (blockGradient f i (x + (𝒰[i] d : X)))
          d :=
      rgbcgBlockCoordinateSliceHasGradientAt h_problem i hd
    have hegrad :
        HasGradientAt
          (block_coordinate_slice f x i)
          (blockGradient f i (x + (𝒰[i] e : X)))
          e :=
      rgbcgBlockCoordinateSliceHasGradientAt h_problem i he
    have hlip' :
        ‖blockGradient f i (x + (𝒰[i] d : X)) -
            blockGradient f i (x + (𝒰[i] e : X))‖ ≤
          (Li i : ℝ) * ‖d - e‖ := by
      simpa [hde', norm_sub_rev, GeneralizedBlockConditionalGradient.blockGradient_apply] using
        hlip
    simpa [hdgrad.gradient, hegrad.gradient] using hlip'

/-- Helper for Theorem 13.29: along one realized RGBCG step, the composite objective satisfies
the textbook blockwise descent inequality
`F(x^{n+1}) ≤ F(x^n) - t_n S_{i_n}(x^n) + (t_n^2 L_{i_n} / 2) ‖p_{i_n}^n - x_{i_n}^n‖²`. -/
private lemma rgbcgOneStepObjectiveBound
    (h_problem : IsGeneralizedBlockConditionalGradientProblem f g Li)
    (h_traj :
      ∀ ω,
        is_randomized_generalized_block_conditional_gradient_trajectory
          g
          (blockGradient f)
          (fun n ↦ x n ω)
          (fun n ↦ sampled_block n ω)
          (fun n ↦ point n ω)
          t)
    (n : ℕ) (ω : Ξ) :
    (F (x (n + 1) ω)).toReal ≤
      (F (x n ω)).toReal -
        (t n : ℝ) * (Sᵇ[g, blockGradient f; sampled_block n ω](x n ω)).toReal +
        (((t n : ℝ) ^ (2 : ℕ) * (Li (sampled_block n ω) : ℝ) / 2) *
          ‖point n ω - x n ω (sampled_block n ω)‖ ^ (2 : ℕ)) := by
  let i : ι := sampled_block n ω
  let y : X := x n ω
  let p : Ei i := point n ω
  let α : ℝ := t n
  have hy : y ∈ domG := by
    simpa [y] using rgbcgIterateMemEffectiveDomain h_problem h_traj n ω
  have hy_f : y ∈ effective_domain f :=
    h_problem.g_effective_domain_subset_f_effective_domain hy
  have hy_int : y ∈ interior (effective_domain f) := by
    exact h_problem.g_effective_domain_subset_interior_f_effective_domain hy
  have hp_argmin :
      p ∈ partial_conditional_gradient_argmin g (blockGradient f) y i := by
    simpa [i, y, p] using
      is_randomized_generalized_block_conditional_gradient_trajectory_argmin (h_traj ω) n
  have hp_dom : p ∈ effective_domain (g i) := by
    simpa [i, y, p] using rgbcgPartialArgminMemEffectiveDomain h_problem hy hp_argmin
  have hyi_dom :
      y i ∈ effective_domain (g i) := by
    have hy_raw :
        ((PiLp.continuousLinearEquiv (2 : ENNReal) ℝ Ei) y) ∈ effective_domain (separableSum g) := by
      simpa [PiLp.separableSum_apply] using hy
    simpa using
      block_mem_effective_domain_of_mem_separableSum_effective_domain
        g
        h_problem.block_g_proper
        hy_raw
        i
  have hnext_block_dom :
      (1 - α) • y i + α • p ∈ effective_domain (g i) := by
    -- The active block stays on the feasible segment from `x_i^n` to `p_i^n`.
    simpa [α, add_comm] using
      combo_mem_effective_domain_of_is_convex_function
        (h_problem.block_g_convex i)
        hp_dom
        hyi_dom
        (t n).2
  have hstep :=
    is_randomized_generalized_block_conditional_gradient_trajectory_step (h_traj ω) n
  have hcoord_update :
      y + 𝒰[i] (α • (p - y i)) = x (n + 1) ω := by
    simpa [i, y, p, α] using hstep.symm
  have hnext_dom : x (n + 1) ω ∈ domG := by
    simpa using rgbcgIterateMemEffectiveDomain h_problem h_traj (n + 1) ω
  have hnext_int : x (n + 1) ω ∈ interior (effective_domain f) := by
    exact h_problem.g_effective_domain_subset_interior_f_effective_domain hnext_dom
  have hdescent :
      (f (x (n + 1) ω)).toReal ≤
        (f y).toReal +
          inner ℝ (blockGradient f i y) (α • (p - y i)) +
          ((Li i : ℝ) / 2) * ‖α • (p - y i)‖ ^ (2 : ℕ) := by
    -- Apply the block descent lemma to the realized sampled block update.
    simpa [hcoord_update, y, i, α, block_coordinate_update] using
      block_coordinate_descent_lemma_of_slice_smooth
        f
        (blockGradient f)
        (PosReal.toNNReal (Li i))
        i
        (blockCoordinateSliceDomainConvexOfConvexEffectiveDomain
          (f := f)
          (i := i)
          (effective_domain_convex_of_is_convex_function h_problem.f_convex))
        (rgbcgBlockCoordinateSliceIsLSmoothOn h_problem i)
        (by
          rw [hasGradientAt_iff_hasFDerivAt]
          simpa [GeneralizedBlockConditionalGradient.blockGradient_apply,
            block_coordinate_slice_apply] using h_problem.block_partial_gradient_spec i hy_f)
        hy_int
        (by simpa [hcoord_update] using hnext_int)
  have hconv :
      (g i ((1 - α) • y i + α • p)).toReal ≤
        (1 - α) * (g i (y i)).toReal + α * (g i p).toReal := by
    have hconv_ereal :=
      (is_convex_function_iff_segment_ineq.mp (h_problem.block_g_convex i))
        p
        hp_dom
        (y i)
        hyi_dom
        (t n).2
    have hleft_val :
        (((g i ((1 - α) • y i + α • p)).toReal : ℝ) : EReal) =
          g i ((1 - α) • y i + α • p) := by
      exact
        (EReal.coe_toReal (mem_effective_domain.mp hnext_block_dom).ne
          ((h_problem.block_g_proper i).ne_bot _)).symm
    have hyi_val :
        (((g i (y i)).toReal : ℝ) : EReal) = g i (y i) := by
      exact
        (EReal.coe_toReal (mem_effective_domain.mp hyi_dom).ne
          ((h_problem.block_g_proper i).ne_bot _)).symm
    have hp_val :
        (((g i p).toReal : ℝ) : EReal) = g i p := by
      exact
        (EReal.coe_toReal (mem_effective_domain.mp hp_dom).ne
          ((h_problem.block_g_proper i).ne_bot _)).symm
    have hconv_real :
        (((g i ((1 - α) • y i + α • p)).toReal : ℝ) : EReal) ≤
          (((1 - α) * (g i (y i)).toReal + α * (g i p).toReal : ℝ) : EReal) := by
      rw [hleft_val]
      rw [hyi_val, hp_val, ← EReal.coe_mul, ← EReal.coe_mul, ← EReal.coe_add]
      simpa [α, sub_eq_add_neg, add_comm, add_left_comm, add_assoc] using hconv_ereal
    exact EReal.coe_le_coe.mp hconv_real
  have hF_curr :
      (F y).toReal = (f y).toReal + ((PiLp.separableSum g) y).toReal := by
    exact rgbcgCompositeModelObjective_toReal_eq_of_mem_effective_domain h_problem hy
  have hF_next :
      (F (x (n + 1) ω)).toReal =
        (f (x (n + 1) ω)).toReal + ((PiLp.separableSum g) (x (n + 1) ω)).toReal := by
    exact rgbcgCompositeModelObjective_toReal_eq_of_mem_effective_domain h_problem hnext_dom
  have hactive_eq :
      x (n + 1) ω i = (1 - α) • y i + α • p := by
    calc
      x (n + 1) ω i = y i + α • (p - y i) := by
        simpa [hcoord_update, i]
      _ = (1 - α) • y i + α • p := by
        rw [smul_sub]
        abel
  have hinactive_eq {j : ι} (hj : j ≠ i) :
      x (n + 1) ω j = y j := by
    simpa [hcoord_update, hj]
  have hsum_curr :
      ((PiLp.separableSum g) y).toReal =
        (g i (y i)).toReal +
          Finset.sum (Finset.univ.erase i) (fun j ↦ (g j (y j)).toReal) := by
    have hsum_erase :
          Finset.sum (Finset.univ.erase i) (fun j ↦ g j (y j)) =
            (((Finset.sum (Finset.univ.erase i) (fun j ↦ (g j (y j)).toReal) : ℝ)) : EReal) := by
        calc
          Finset.sum (Finset.univ.erase i) (fun j ↦ g j (y j)) =
              Finset.sum (Finset.univ.erase i) (fun j ↦ (((g j (y j)).toReal : ℝ) : EReal)) := by
                refine Finset.sum_congr rfl ?_
                intro j hj
                have hyj_dom :
                    y j ∈ effective_domain (g j) := by
                  have hy_raw :
                      ((PiLp.continuousLinearEquiv (2 : ENNReal) ℝ Ei) y) ∈
                        effective_domain (separableSum g) := by
                    simpa [PiLp.separableSum_apply] using hy
                  simpa using
                    block_mem_effective_domain_of_mem_separableSum_effective_domain
                      g
                      h_problem.block_g_proper
                      hy_raw
                      j
                exact
                  (EReal.coe_toReal (mem_effective_domain.mp hyj_dom).ne
                    ((h_problem.block_g_proper j).ne_bot _)).symm
          _ = (((Finset.sum (Finset.univ.erase i) (fun j ↦ (g j (y j)).toReal) : ℝ)) : EReal) := by
                symm
                exact ereal_coe_sum
    have hsum_curr_ereal :
        (PiLp.separableSum g) y =
          (((g i (y i)).toReal +
              Finset.sum (Finset.univ.erase i) (fun j ↦ (g j (y j)).toReal) : ℝ) : EReal) := by
      rw [PiLp.separableSum_apply, Finset.add_sum_erase _ _ (Finset.mem_univ i), hyi_val,
        hsum_erase, ← EReal.coe_add]
    simpa using congrArg EReal.toReal hsum_curr_ereal
  have hsum_next :
      ((PiLp.separableSum g) (x (n + 1) ω)).toReal =
        (g i ((1 - α) • y i + α • p)).toReal +
          Finset.sum (Finset.univ.erase i) (fun j ↦ (g j (y j)).toReal) := by
    have hsum_erase :
        Finset.sum (Finset.univ.erase i) (fun j ↦ g j (x (n + 1) ω j)) =
          (((Finset.sum (Finset.univ.erase i) (fun j ↦ (g j (y j)).toReal) : ℝ)) : EReal) := by
      calc
        Finset.sum (Finset.univ.erase i) (fun j ↦ g j (x (n + 1) ω j))
            = Finset.sum (Finset.univ.erase i) (fun j ↦ g j (y j)) := by
              refine Finset.sum_congr rfl ?_
              intro j hj
              rw [hinactive_eq (Finset.mem_erase.mp hj).1]
        _ = (((Finset.sum (Finset.univ.erase i) (fun j ↦ (g j (y j)).toReal) : ℝ)) : EReal) := by
              calc
                Finset.sum (Finset.univ.erase i) (fun j ↦ g j (y j)) =
                    Finset.sum (Finset.univ.erase i) (fun j ↦ (((g j (y j)).toReal : ℝ) : EReal)) := by
                      refine Finset.sum_congr rfl ?_
                      intro j hj
                      have hyj_dom :
                          y j ∈ effective_domain (g j) := by
                        have hy_raw :
                            ((PiLp.continuousLinearEquiv (2 : ENNReal) ℝ Ei) y) ∈
                              effective_domain (separableSum g) := by
                          simpa [PiLp.separableSum_apply] using hy
                        simpa using
                          block_mem_effective_domain_of_mem_separableSum_effective_domain
                            g
                            h_problem.block_g_proper
                            hy_raw
                            j
                      exact
                        (EReal.coe_toReal (mem_effective_domain.mp hyj_dom).ne
                          ((h_problem.block_g_proper j).ne_bot _)).symm
                _ = (((Finset.sum (Finset.univ.erase i) (fun j ↦ (g j (y j)).toReal) : ℝ)) : EReal) := by
                      symm
                      exact ereal_coe_sum
    have hactive_val :
        (((g i ((1 - α) • y i + α • p)).toReal : ℝ) : EReal) =
          g i ((1 - α) • y i + α • p) := by
      exact
        (EReal.coe_toReal (mem_effective_domain.mp hnext_block_dom).ne
          ((h_problem.block_g_proper i).ne_bot _)).symm
    have hsum_next_ereal :
        (PiLp.separableSum g) (x (n + 1) ω) =
          (((g i ((1 - α) • y i + α • p)).toReal +
              Finset.sum (Finset.univ.erase i) (fun j ↦ (g j (y j)).toReal) : ℝ) : EReal) := by
      rw [PiLp.separableSum_apply, Finset.add_sum_erase _ _ (Finset.mem_univ i), hactive_eq,
        hactive_val, hsum_erase, ← EReal.coe_add]
    simpa using congrArg EReal.toReal hsum_next_ereal
  have hgap_val :
      (Sᵇ[g, blockGradient f; i](y)).toReal =
        inner ℝ (blockGradient f i y) (y i - p) +
          (g i (y i)).toReal - (g i p).toReal := by
    rw [partial_conditional_gradient_norm_eq_of_mem_argmin hp_argmin,
      partial_conditional_gradient_gap_objective_apply]
    rw [hyi_val, hp_val, ← EReal.coe_add, ← EReal.coe_sub]
    simp
  have hinner :
      inner ℝ (blockGradient f i y) (α • (p - y i)) =
        -α * inner ℝ (blockGradient f i y) (y i - p) := by
    rw [inner_smul_right]
    have hsub : p - y i = -(y i - p) := by
      abel
    rw [hsub, inner_neg_right]
    ring
  have hquad :
      ((Li i : ℝ) / 2) * ‖α • (p - y i)‖ ^ (2 : ℕ) =
        ((α ^ (2 : ℕ) * (Li i : ℝ) / 2) * ‖p - y i‖ ^ (2 : ℕ)) := by
    rw [norm_smul, Real.norm_of_nonneg (t n).1, pow_two]
    ring
  -- Combine the smooth one-block descent with convexity of the active block penalty and then
  -- rewrite the resulting decrement as the sampled-block conditional-gradient gap.
  rw [hF_next, hF_curr, hsum_next, hsum_curr, hgap_val]
  rw [hinner, hquad]
  linarith

/-- Helper for Theorem 13.29: the frozen-history deterministic point rule produces a comparison
point whose weighted squared block displacement is bounded by `Ω²`, hence its expected blockwise
quadratic remainder is at most `((N : ℝ)⁻¹) * Ω²`. -/
private lemma rgbcgExpectedQuadraticRemainder_le_diameter
    (h_problem : IsGeneralizedBlockConditionalGradientProblem f g Li)
    (x0 : X)
    (h_sampled_block_measurable : ∀ k, Measurable (sampled_block k))
    (h_sampled_block_indep : iIndepFun sampled_block μ)
    (h_sampled_block_uniform :
      ∀ k (i : ι), μ ((sampled_block k) ⁻¹' {i}) = 1 / (N : ℝ≥0∞))
    (h_zero : x 0 = fun _ ↦ x0)
    (h_traj :
      ∀ ω,
        is_randomized_generalized_block_conditional_gradient_trajectory
          g
          (blockGradient f)
          (fun n ↦ x n ω)
          (fun n ↦ sampled_block n ω)
          (fun n ↦ point n ω)
          t)
    {pointRule : (i : ι) → X → Ei i}
    (h_point_rule :
      ∀ n ω,
        point n ω = pointRule (sampled_block n ω) (x n ω))
    (Ω : ℝ)
    (h_diameter_bound :
      ∀ {u v : X},
        u ∈ effective_domain (PiLp.separableSum g) →
        v ∈ effective_domain (PiLp.separableSum g) →
        ‖u - v‖_[Li] ≤ Ω)
    (n : ℕ) :
    μ[fun ω ↦
      ((N : ℝ)⁻¹) *
        ∑ i : ι, (Li i : ℝ) * ‖pointRule i (x n ω) - x n ω i‖ ^ (2 : ℕ)] ≤
      ((N : ℝ)⁻¹) * Ω ^ (2 : ℕ) := by
  classical
  rcases rgbcg_history_adapted_of_point_rule x0 h_zero h_traj
      ⟨pointRule, h_point_rule⟩ n with
    ⟨Φn, hΦn⟩
  let history : Ξ → Fin n → ι :=
    fun ω ↦ randomized_block_history (fun m ↦ sampled_block m ω) n
  let ψ : (Fin n → ι) → ℝ := fun ξ ↦
    ((N : ℝ)⁻¹) *
      ∑ i : ι, (Li i : ℝ) * ‖pointRule i (Φn ξ) - Φn ξ i‖ ^ (2 : ℕ)
  have h_history_meas : Measurable history := by
    -- The finite sampled-block history is measurable coordinatewise.
    refine measurable_pi_lambda _ fun t ↦ ?_
    simpa [history, randomized_block_history] using h_sampled_block_measurable t
  have hψ_meas :
      AEStronglyMeasurable ψ (μ.map history) := by
    exact (Measurable.of_discrete : Measurable ψ).aestronglyMeasurable
  have hψ_int : Integrable ψ (μ.map history) := by
    exact Integrable.of_finite
  have hN_pos_nat : 0 < N := by
    by_contra hN
    have hcard_zero : Fintype.card ι = 0 := by omega
    have hi_empty : IsEmpty ι := Fintype.card_eq_zero_iff.mp hcard_zero
    exact hi_empty.false (sampled_block 0 (Classical.choice <| by
      by_contra hΞ
      have huniv : (Set.univ : Set Ξ) = ∅ := by
        ext ω
        exact False.elim (hΞ ⟨ω⟩)
      have hzero : μ Set.univ = 0 := by
        simpa [huniv] using (measure_empty : μ (∅ : Set Ξ) = 0)
      simpa using hzero))
  have hsum_bound :
      ∀ ξ : Fin n → ι,
        (μ.map history).real {ξ} * ψ ξ ≤
          (μ.map history).real {ξ} * (((N : ℝ)⁻¹) * Ω ^ (2 : ℕ)) := by
    intro ξ
    by_cases hξ_zero : (μ.map history) {ξ} = 0
    · have hreal_zero : (μ.map history).real {ξ} = 0 := by
        simp [Measure.real_def, hξ_zero]
      simp [hreal_zero]
    · have hξ_pos : 0 < (μ.map history) {ξ} := by
        exact ENNReal.pos_iff_ne_zero.mpr hξ_zero
      have hpreimage_pos :
          0 < μ (history ⁻¹' ({ξ} : Set (Fin n → ι))) := by
        rw [← Measure.map_apply h_history_meas (MeasurableSet.singleton ξ)]
        exact hξ_pos
      have hpreimage_nonempty :
          Set.Nonempty (history ⁻¹' ({ξ} : Set (Fin n → ι))) := by
        by_contra hpreimage_empty
        have hpreimage_zero :
            μ (history ⁻¹' ({ξ} : Set (Fin n → ι))) = 0 := by
          simpa [Set.not_nonempty_iff_eq_empty.mp hpreimage_empty] using
            (measure_empty : μ (∅ : Set Ξ) = 0)
        exact hpreimage_pos.ne' hpreimage_zero
      rcases hpreimage_nonempty with ⟨ω, hω⟩
      have hhistory : history ω = ξ := Set.mem_singleton_iff.mp hω
      have hPhi_eq : x n ω = Φn ξ := by
        simpa [history, hhistory] using hΦn ω
      have hPhi_dom : Φn ξ ∈ domG := by
        simpa [← hPhi_eq] using rgbcgIterateMemEffectiveDomain h_problem h_traj n ω
      let qξ : X := fun i ↦ pointRule i (Φn ξ)
      have hq_argmin :
          ∀ i : ι,
            qξ i ∈ partial_conditional_gradient_argmin g (blockGradient f) (Φn ξ) i := by
        intro i
        simpa [qξ] using
          rgbcgFrozenHistoryPointRuleArgmin_of_positive_history_mass
            x0
            h_sampled_block_measurable
            h_sampled_block_indep
            h_sampled_block_uniform
            h_zero
            h_traj
            h_point_rule
            hΦn
            hξ_pos
            i
      have hq_dom_i :
          ∀ i : ι, qξ i ∈ effective_domain (g i) := by
        intro i
        exact rgbcgPartialArgminMemEffectiveDomain h_problem hPhi_dom (hq_argmin i)
      have hq_dom : qξ ∈ domG := by
        rw [mem_effective_domain, PiLp.separableSum_apply]
        exact ereal_sum_lt_top Finset.univ (fun i ↦ g i (qξ i))
          (fun i _ ↦ mem_effective_domain.mp (hq_dom_i i))
      have hΩ_nonneg : 0 ≤ Ω := by
        simpa using h_diameter_bound hPhi_dom hPhi_dom
      have hdiam : ‖qξ - Φn ξ‖_[Li] ≤ Ω := h_diameter_bound hq_dom hPhi_dom
      have hsum_nonneg :
          0 ≤ ∑ i : ι, (Li i : ℝ) * ‖qξ i - Φn ξ i‖ ^ (2 : ℕ) := by
        exact Finset.sum_nonneg (fun i _ ↦ mul_nonneg (by positivity) (sq_nonneg _))
      have hweighted_eq :
          ∑ i : ι, (Li i : ℝ) * ‖qξ i - Φn ξ i‖ ^ (2 : ℕ) =
            ‖qξ - Φn ξ‖_[Li] ^ (2 : ℕ) := by
        have hnorm := randomized_block_weighted_norm_def Li (qξ - Φn ξ)
        have hsq := congrArg (fun r : ℝ ↦ r ^ (2 : ℕ)) hnorm
        rw [pow_two, Real.sq_sqrt hsum_nonneg] at hsq
        simpa [Pi.sub_apply, pow_two] using hsq.symm
      have hpsi_le : ψ ξ ≤ ((N : ℝ)⁻¹) * Ω ^ (2 : ℕ) := by
        have hsum_le :
            ∑ i : ι, (Li i : ℝ) * ‖qξ i - Φn ξ i‖ ^ (2 : ℕ) ≤ Ω ^ (2 : ℕ) := by
          have hdiam_sq : ‖qξ - Φn ξ‖_[Li] ^ (2 : ℕ) ≤ Ω ^ (2 : ℕ) := by
            nlinarith
          simpa [hweighted_eq]
        dsimp [ψ, qξ]
        exact mul_le_mul_of_nonneg_left hsum_le (by positivity)
      exact mul_le_mul_of_nonneg_left hpsi_le (by positivity)
  calc
    μ[fun ω ↦
      ((N : ℝ)⁻¹) *
        ∑ i : ι, (Li i : ℝ) * ‖pointRule i (x n ω) - x n ω i‖ ^ (2 : ℕ)]
      = MeasureTheory.integral (μ.map history) ψ := by
          symm
          simpa [history, ψ, hΦn] using integral_map h_history_meas.aemeasurable hψ_meas
    _ = ∑ ξ, (μ.map history).real {ξ} • ψ ξ := by
          simpa [smul_eq_mul] using MeasureTheory.integral_fintype (μ := μ.map history) hψ_int
    _ ≤ ∑ ξ, (μ.map history).real {ξ} • (((N : ℝ)⁻¹) * Ω ^ (2 : ℕ)) := by
          exact Finset.sum_le_sum (fun ξ _ ↦ hsum_bound ξ)
    _ = MeasureTheory.integral (μ.map history) (fun _ : Fin n → ι ↦ ((N : ℝ)⁻¹) * Ω ^ (2 : ℕ)) := by
          symm
          simpa [smul_eq_mul] using
            MeasureTheory.integral_fintype
              (μ := μ.map history)
              (integrable_const (((N : ℝ)⁻¹) * Ω ^ (2 : ℕ)))
    _ = ((N : ℝ)⁻¹) * Ω ^ (2 : ℕ) := by
          simp

-- Proof sketch: combine the one-step expected descent inequality from the RGBCG update with the
-- uniform block-sampling average, the diameter bound `‖u - v‖_L ≤ Ω`, and the deterministic
-- stepsize formula `t_k = 2 |ι| / (k + 2 |ι|)`. Then apply the same scalar recursion lemma as in
-- the deterministic generalized conditional-gradient proof, with
-- `a_k = E[F(x^k)] - F_opt` and `b_k = E[S(x^k)]`.

variable (x0 : X) (Ω : ℝ)

local notation "rateBound" =>
  max
    ((((N - 1 : ℕ) : ℝ) * (EReal.toReal (F x0) - F_opt_real)))
    (((N : ℝ) * Ω ^ (2 : ℕ)))

section

variable (a b : ℕ → ℝ) (A : ℝ) (p : ℕ)

variable (hp : 1 ≤ p)
variable (ha_nonneg : ∀ k : ℕ, 0 ≤ a k)
variable
  (hstep : ∀ k : ℕ,
    a (k + 1) ≤
      a k -
        (2 / (k + 2 * p : ℝ)) * b k +
        (A / 2) * (2 / (k + 2 * p : ℝ)) ^ (2 : ℕ))
variable (ha_le_b : ∀ k : ℕ, a k ≤ b k)

/-- Helper for Theorem 13.29: the control constant `max {A, (p - 1) a₀}` is nonnegative. -/
private lemma rawScalarRecurrenceControlNonneg (ha_nonneg : ∀ k : ℕ, 0 ≤ a k) :
    0 ≤ max A ((((p - 1 : ℕ) : ℝ) * a 0)) := by
  -- The second branch is nonnegative because both factors are.
  refine le_trans ?_ (le_max_right A ((((p - 1 : ℕ) : ℝ) * a 0)))
  exact mul_nonneg (Nat.cast_nonneg (p - 1)) (ha_nonneg 0)

/-- Helper for Theorem 13.29: multiplying the one-step recurrence by
`(n + 2p - 1)(n + 2p)` yields the weighted increment bound needed for telescoping. -/
private lemma rawWeightedScalarRecurrenceStep
    (hp : 1 ≤ p)
    (ha_nonneg : ∀ k : ℕ, 0 ≤ a k)
    (hstep : ∀ k : ℕ,
      a (k + 1) ≤
        a k - (2 / (k + 2 * p : ℝ)) * b k +
          (A / 2) * (2 / (k + 2 * p : ℝ)) ^ (2 : ℕ))
    (ha_le_b : ∀ k : ℕ, a k ≤ b k)
    (n : ℕ) :
    (((n + 2 * p - 1 : ℕ) : ℝ) * (((n + 2 * p : ℕ) : ℝ)) * a (n + 1)) ≤
      (((n + 2 * p - 2 : ℕ) : ℝ) * (((n + 2 * p - 1 : ℕ) : ℝ)) * a n +
        2 * max A ((((p - 1 : ℕ) : ℝ) * a 0))) := by
  let d : ℝ := ((n + 2 * p : ℕ) : ℝ)
  let u : ℝ := ((n + 2 * p - 1 : ℕ) : ℝ)
  let v : ℝ := ((n + 2 * p - 2 : ℕ) : ℝ)
  have hd_pos : 0 < d := by
    dsimp [d]
    positivity
  have hu_nonneg : 0 ≤ u := by
    dsimp [u]
    positivity
  have hw_nonneg : 0 ≤ u * d := mul_nonneg hu_nonneg hd_pos.le
  have hu_eq : u = d - 1 := by
    have hnat : 1 ≤ n + 2 * p := by
      omega
    dsimp [u, d]
    rw [show ((n + 2 * p - 1 : ℕ) : ℝ) = ((n + 2 * p : ℕ) : ℝ) - 1 by
      norm_num [Nat.cast_sub hnat]]
  have hv_eq : v = d - 2 := by
    have hnat : 2 ≤ n + 2 * p := by
      omega
    dsimp [v, d]
    rw [show ((n + 2 * p - 2 : ℕ) : ℝ) = ((n + 2 * p : ℕ) : ℝ) - 2 by
      norm_num [Nat.cast_sub hnat]]
  have hu_le_d : u ≤ d := by
    nlinarith [hu_eq, hd_pos]
  have hratio_nonneg : 0 ≤ u / d := by
    positivity
  have hratio_le_one : u / d ≤ 1 := by
    exact (div_le_iff₀ hd_pos).2 (by simpa using hu_le_d)
  have hstep' := hstep n
  have hstep_mul :
      u * d * a (n + 1) ≤
        u * d * (a n - (2 / d) * b n + (A / 2) * (2 / d) ^ (2 : ℕ)) := by
    simpa [d] using mul_le_mul_of_nonneg_left hstep' hw_nonneg
  have hexpand :
      u * d * (a n - (2 / d) * b n + (A / 2) * (2 / d) ^ (2 : ℕ)) =
        u * d * a n - 2 * u * b n + 2 * A * (u / d) := by
    rw [pow_two]
    field_simp [hd_pos.ne']
  have hcontract :
      u * d * a n - 2 * u * a n = v * u * a n := by
    calc
      u * d * a n - 2 * u * a n = u * (d - 2) * a n := by ring
      _ = u * v * a n := by rw [hv_eq]
      _ = v * u * a n := by ring
  have hneg_term :
      u * d * a n - 2 * u * b n ≤ u * d * a n - 2 * u * a n := by
    nlinarith [ha_le_b n, hu_nonneg]
  have herror_bound :
      2 * A * (u / d) ≤ 2 * max A ((((p - 1 : ℕ) : ℝ) * a 0)) := by
    have hmax_nonneg :
        0 ≤ max A ((((p - 1 : ℕ) : ℝ) * a 0)) :=
      rawScalarRecurrenceControlNonneg (a := a) (A := A) (p := p) ha_nonneg
    by_cases hA_nonneg : 0 ≤ A
    · have hA_le :
          A ≤ max A ((((p - 1 : ℕ) : ℝ) * a 0)) := le_max_left _ _
      have hratio_bound : A * (u / d) ≤ A := by
        nlinarith [hratio_nonneg, hratio_le_one]
      nlinarith
    · have hA_nonpos : A ≤ 0 := le_of_not_ge hA_nonneg
      nlinarith [hA_nonpos, hratio_nonneg, hmax_nonneg]
  calc
    (((n + 2 * p - 1 : ℕ) : ℝ) * (((n + 2 * p : ℕ) : ℝ)) * a (n + 1))
        = u * d * a (n + 1) := by simp [u, d, mul_assoc]
    _ ≤ u * d * (a n - (2 / d) * b n + (A / 2) * (2 / d) ^ (2 : ℕ)) := hstep_mul
    _ = u * d * a n - 2 * u * b n + 2 * A * (u / d) := hexpand
    _ ≤ u * d * a n - 2 * u * a n + 2 * max A ((((p - 1 : ℕ) : ℝ) * a 0)) := by
      linarith
    _ = v * u * a n + 2 * max A ((((p - 1 : ℕ) : ℝ) * a 0)) := by
      rw [hcontract]
    _ = ((((n + 2 * p - 2 : ℕ) : ℝ) * (((n + 2 * p - 1 : ℕ) : ℝ)) * a n) +
          2 * max A ((((p - 1 : ℕ) : ℝ) * a 0))) := by
      simp [u, v, mul_comm]

/-- Helper for Theorem 13.29: iterating the weighted one-step estimate bounds the whole weighted
trajectory by the initial weighted value plus `2M` per iteration. -/
private lemma rawWeightedScalarRecurrenceBound
    (hp : 1 ≤ p)
    (ha_nonneg : ∀ k : ℕ, 0 ≤ a k)
    (hstep : ∀ k : ℕ,
      a (k + 1) ≤
        a k - (2 / (k + 2 * p : ℝ)) * b k +
          (A / 2) * (2 / (k + 2 * p : ℝ)) ^ (2 : ℕ))
    (ha_le_b : ∀ k : ℕ, a k ≤ b k)
    (n : ℕ) :
    ((((n + 2 * p - 2 : ℕ) : ℝ) * (((n + 2 * p - 1 : ℕ) : ℝ))) * a n) ≤
      ((((2 * p - 2 : ℕ) : ℝ) * (((2 * p - 1 : ℕ) : ℝ))) * a 0) +
        2 * max A ((((p - 1 : ℕ) : ℝ) * a 0)) * n := by
  induction n with
  | zero =>
      -- The weighted bound starts from the exact initial weighted value.
      simp
  | succ n ihn =>
      -- Advance the weighted estimate by one step and absorb the new `2M` increment.
      have hstep_weighted :=
        rawWeightedScalarRecurrenceStep
          (a := a) (b := b) (A := A) (p := p) hp ha_nonneg hstep ha_le_b n
      calc
        ((((n + 1 + 2 * p - 2 : ℕ) : ℝ) * (((n + 1 + 2 * p - 1 : ℕ) : ℝ))) * a (n + 1))
            ≤ ((((n + 2 * p - 2 : ℕ) : ℝ) * (((n + 2 * p - 1 : ℕ) : ℝ)) * a n) +
                2 * max A ((((p - 1 : ℕ) : ℝ) * a 0))) := by
              have hleft : n + 1 + 2 * p - 2 = n + 2 * p - 1 := by
                omega
              have hright : n + 1 + 2 * p - 1 = n + 2 * p := by
                omega
              simpa [hleft, hright] using hstep_weighted
        _ ≤ ((((2 * p - 2 : ℕ) : ℝ) * (((2 * p - 1 : ℕ) : ℝ))) * a 0) +
              2 * max A ((((p - 1 : ℕ) : ℝ) * a 0)) * n +
              2 * max A ((((p - 1 : ℕ) : ℝ) * a 0)) := by
            linarith
        _ = ((((2 * p - 2 : ℕ) : ℝ) * (((2 * p - 1 : ℕ) : ℝ))) * a 0) +
              2 * max A ((((p - 1 : ℕ) : ℝ) * a 0)) * ((n : ℝ) + 1) := by
            ring
        _ = ((((2 * p - 2 : ℕ) : ℝ) * (((2 * p - 1 : ℕ) : ℝ))) * a 0) +
              2 * max A ((((p - 1 : ℕ) : ℝ) * a 0)) * (((n + 1 : ℕ) : ℝ)) := by
            norm_num [Nat.cast_add]

include hp ha_nonneg hstep ha_le_b

/-- Helper for Theorem 13.29: a raw `2 / (k + 2p)` recurrence with `a_k ≤ b_k` gives the
sublinear bound `a_k ≤ 2 * max {A, (p - 1) a₀} / (k + 2p - 2)`. -/
private theorem rawScalarRecurrenceLeSublinearBound
    {k : ℕ} (hk : 1 ≤ k) :
    a k ≤
      (2 * max A ((((p - 1 : ℕ) : ℝ) * a 0))) /
        (((k + 2 * p - 2 : ℕ) : ℝ)) := by
  let M : ℝ := max A ((((p - 1 : ℕ) : ℝ) * a 0))
  let d : ℝ := ((k + 2 * p - 2 : ℕ) : ℝ)
  let e : ℝ := ((k + 2 * p - 1 : ℕ) : ℝ)
  have hM_nonneg : 0 ≤ M := by
    dsimp [M]
    exact rawScalarRecurrenceControlNonneg (a := a) (A := A) (p := p) ha_nonneg
  have hd_pos : 0 < d := by
    dsimp [d]
    have hnat : 0 < k + (2 * p - 2) := by
      have htwo : 0 ≤ 2 * p - 2 := by
        omega
      omega
    have hrewrite : k + 2 * p - 2 = k + (2 * p - 2) := by
      omega
    rw [hrewrite]
    exact Nat.cast_pos.mpr hnat
  have he_pos : 0 < e := by
    dsimp [e]
    have hnat : 0 < k + 2 * p - 1 := by
      omega
    exact Nat.cast_pos.mpr hnat
  have hweighted :=
    rawWeightedScalarRecurrenceBound
      (a := a) (b := b) (A := A) (p := p) hp ha_nonneg hstep ha_le_b k
  have hinitial :
      ((((2 * p - 2 : ℕ) : ℝ) * (((2 * p - 1 : ℕ) : ℝ))) * a 0) ≤
        2 * M * (((2 * p - 1 : ℕ) : ℝ)) := by
    have hM_ge :
        (((p - 1 : ℕ) : ℝ) * a 0) ≤ M := by
      dsimp [M]
      exact le_max_right _ _
    have hfactor : (((2 * p - 2 : ℕ) : ℝ)) = 2 * (((p - 1 : ℕ) : ℝ)) := by
      exact_mod_cast (show 2 * p - 2 = 2 * (p - 1) by omega)
    have htail_nonneg : 0 ≤ (((2 * p - 1 : ℕ) : ℝ)) := by
      positivity
    rw [hfactor]
    nlinarith [hM_ge, ha_nonneg 0, htail_nonneg]
  have hmain :
      d * e * a k ≤ 2 * M * e := by
    have hsplit_e : (((2 * p - 1 : ℕ) : ℝ)) + (k : ℝ) = e := by
      dsimp [e]
      have hnat : 2 * p - 1 + k = k + 2 * p - 1 := by
        omega
      exact_mod_cast hnat
    dsimp [d, e, M] at hweighted hinitial ⊢
    nlinarith [hweighted, hinitial, hsplit_e]
  have hcancel_e : d * a k ≤ 2 * M := by
    have hmain' : e * (d * a k) ≤ e * (2 * M) := by
      simpa [mul_assoc, mul_left_comm, mul_comm] using hmain
    exact le_of_mul_le_mul_left hmain' he_pos
  have hcancel_d : a k * d ≤ 2 * M := by
    simpa [mul_comm] using hcancel_e
  have hresult : a k ≤ (2 * M) / d := by
    exact (le_div_iff₀ hd_pos).2 hcancel_d
  dsimp [M, d] at hresult ⊢
  simpa using hresult

include hp

/-- Helper for Theorem 13.29: summing the recurrence on the interval `n = j, …, k` keeps the
terminal value `a (k + 1)` explicit on the left, exactly as in the textbook proof. -/
private lemma rawScalarRecurrenceIntervalSum
    (j k : ℕ) (hjk : j ≤ k) :
    a (k + 1) +
        Finset.sum (Finset.range (k + 1 - j))
          (fun m ↦ (2 / (j + m + 2 * p : ℝ)) * b (j + m)) ≤
      a j +
        (A / 2) *
          Finset.sum (Finset.range (k + 1 - j))
            (fun m ↦ (2 / (j + m + 2 * p : ℝ)) ^ (2 : ℕ)) := by
  let nRange : ℕ := k + 1 - j
  have hN : j + nRange = k + 1 := by
    dsimp [nRange]
    omega
  have hinterval :
      a (j + nRange) +
          Finset.sum (Finset.range nRange)
            (fun m ↦ (2 / (j + m + 2 * p : ℝ)) * b (j + m)) ≤
        a j +
          (A / 2) *
            Finset.sum (Finset.range nRange)
              (fun m ↦ (2 / (j + m + 2 * p : ℝ)) ^ (2 : ℕ)) := by
    induction nRange with
    | zero =>
        simp
    | succ r ih =>
        have hstepN'' :
            a (j + (r + 1)) ≤
              a (j + r) - (2 / (j + r + 2 * p : ℝ)) * b (j + r) +
                (A / 2) * (2 / (j + r + 2 * p : ℝ)) ^ (2 : ℕ) := by
          simpa [Nat.add_assoc, Nat.add_left_comm, Nat.add_comm] using hstep (j + r)
        have hstepN' :
            a (j + (r + 1)) + (2 / (j + r + 2 * p : ℝ)) * b (j + r) ≤
              a (j + r) + (A / 2) * (2 / (j + r + 2 * p : ℝ)) ^ (2 : ℕ) := by
          linarith
        calc
          a (j + (r + 1)) +
              Finset.sum (Finset.range (r + 1))
                (fun m ↦ (2 / (j + m + 2 * p : ℝ)) * b (j + m))
              =
                (a (j + (r + 1)) + (2 / (j + r + 2 * p : ℝ)) * b (j + r)) +
                  Finset.sum (Finset.range r)
                    (fun m ↦ (2 / (j + m + 2 * p : ℝ)) * b (j + m)) := by
                  rw [Finset.sum_range_succ]
                  ring
          _ ≤
                (a (j + r) + (A / 2) * (2 / (j + r + 2 * p : ℝ)) ^ (2 : ℕ)) +
                  Finset.sum (Finset.range r)
                    (fun m ↦ (2 / (j + m + 2 * p : ℝ)) * b (j + m)) := by
                  linarith
          _ ≤
                (a j +
                    (A / 2) *
                      Finset.sum (Finset.range r)
                        (fun m ↦ (2 / (j + m + 2 * p : ℝ)) ^ (2 : ℕ))) +
                  (A / 2) * (2 / (j + r + 2 * p : ℝ)) ^ (2 : ℕ) := by
                  linarith
          _ =
                a j +
                  (A / 2) *
                    Finset.sum (Finset.range (r + 1))
                      (fun m ↦ (2 / (j + m + 2 * p : ℝ)) ^ (2 : ℕ)) := by
                  rw [Finset.sum_range_succ]
                  ring
  simpa [nRange, hN] using hinterval

/-- Helper for Theorem 13.29: the reciprocal-square remainder is controlled by the textbook
telescoping difference `1 / (n - 1) - 1 / n` on the shifted interval. -/
private lemma rawReciprocalSquareSumLe
    (j k : ℕ) (hjk : j ≤ k) :
    Finset.sum (Finset.range (k + 1 - j))
      (fun m ↦ 1 / (j + m + 2 * p : ℝ) ^ (2 : ℕ)) ≤
      1 / (j + 2 * p - 1 : ℝ) - 1 / (k + 2 * p : ℝ) := by
  have hpointwise :
      ∀ m ∈ Finset.range (k + 1 - j),
        1 / (j + m + 2 * p : ℝ) ^ (2 : ℕ) ≤
          1 / (j + m + 2 * p - 1 : ℝ) - 1 / (j + m + 2 * p : ℝ) := by
    intro m hm
    let n : ℕ := j + m + 2 * p
    have hn_one : 1 ≤ n := by
      dsimp [n]
      omega
    have hn_two : 2 ≤ n := by
      dsimp [n]
      omega
    have hn_pos : 0 < (n : ℝ) := by
      exact_mod_cast (lt_of_lt_of_le Nat.zero_lt_one hn_one)
    have hn_sub_pos : 0 < ((n - 1 : ℕ) : ℝ) := by
      exact_mod_cast (show 0 < n - 1 by omega)
    have hmul_le : (((n - 1 : ℕ) : ℝ) * (n : ℝ)) ≤ (n : ℝ) ^ (2 : ℕ) := by
      have hn_sub_le : ((n - 1 : ℕ) : ℝ) ≤ (n : ℝ) := by
        exact_mod_cast (show n - 1 ≤ n by omega)
      nlinarith
    have hrecip :
        1 / (n : ℝ) ^ (2 : ℕ) ≤ 1 / (((n - 1 : ℕ) : ℝ) * (n : ℝ)) := by
      exact one_div_le_one_div_of_le (mul_pos hn_sub_pos hn_pos) hmul_le
    have hn_cast : (n : ℝ) = (j + m + 2 * p : ℝ) := by
      exact_mod_cast (show n = j + m + 2 * p by dsimp [n])
    have hprev_cast : (((n - 1 : ℕ) : ℝ)) = (j + m + 2 * p - 1 : ℝ) := by
      have hnat : 1 ≤ j + m + 2 * p := by
        omega
      dsimp [n]
      rw [Nat.cast_sub hnat]
      norm_num [Nat.cast_add, Nat.cast_mul]
    have hdelta : (n : ℝ) - (((n - 1 : ℕ) : ℝ)) = 1 := by
      rw [hn_cast, hprev_cast]
      ring
    have hdiff :
        1 / (((n - 1 : ℕ) : ℝ)) - 1 / (n : ℝ) =
          1 / (((n - 1 : ℕ) : ℝ) * (n : ℝ)) := by
      calc
        1 / (((n - 1 : ℕ) : ℝ)) - 1 / (n : ℝ)
            = ((n : ℝ) - (((n - 1 : ℕ) : ℝ))) /
                ((((n - 1 : ℕ) : ℝ) * (n : ℝ))) := by
                  field_simp [hn_pos.ne', hn_sub_pos.ne']
        _ = 1 / (((n - 1 : ℕ) : ℝ) * (n : ℝ)) := by rw [hdelta]
    calc
      1 / (j + m + 2 * p : ℝ) ^ (2 : ℕ) = 1 / (n : ℝ) ^ (2 : ℕ) := by rw [hn_cast]
      _ ≤ 1 / (((n - 1 : ℕ) : ℝ) * (n : ℝ)) := hrecip
      _ = 1 / (((n - 1 : ℕ) : ℝ)) - 1 / (n : ℝ) := hdiff.symm
      _ = 1 / (j + m + 2 * p - 1 : ℝ) - 1 / (j + m + 2 * p : ℝ) := by
            rw [hprev_cast, hn_cast]
  have hsum_le :
      Finset.sum (Finset.range (k + 1 - j))
        (fun m ↦ 1 / (j + m + 2 * p : ℝ) ^ (2 : ℕ)) ≤
        Finset.sum (Finset.range (k + 1 - j))
          (fun m ↦ 1 / (j + m + 2 * p - 1 : ℝ) - 1 / (j + m + 2 * p : ℝ)) := by
    exact Finset.sum_le_sum fun m hm ↦ hpointwise m hm
  have htelescoping :
      Finset.sum (Finset.range (k + 1 - j))
        (fun m ↦ 1 / (j + m + 2 * p - 1 : ℝ) - 1 / (j + m + 2 * p : ℝ)) =
          1 / (j + 2 * p - 1 : ℝ) - 1 / (k + 2 * p : ℝ) := by
    let f : ℕ → ℝ := fun m ↦ 1 / (j + m + 2 * p - 1 : ℝ)
    have htel :
        ∀ r : ℕ,
          Finset.sum (Finset.range r) (fun m ↦ f m - f (m + 1)) = f 0 - f r := by
      intro r
      induction r with
      | zero =>
          simp [f]
      | succ r ih =>
          rw [Finset.sum_range_succ, ih]
          ring
    have hrewrite :
        (fun m : ℕ ↦ 1 / (j + m + 2 * p - 1 : ℝ) - 1 / (j + m + 2 * p : ℝ)) =
          (fun m : ℕ ↦ f m - f (m + 1)) := by
      funext m
      have hsucc_cast : (j + (m + 1) + 2 * p - 1 : ℝ) = j + m + 2 * p := by
        ring
      simp [f, hsucc_cast]
    rw [hrewrite, htel]
    have hsum_cast : (j : ℝ) + ((k + 1 - j : ℕ) : ℝ) = k + 1 := by
      exact_mod_cast (show j + (k + 1 - j) = k + 1 by omega)
    have hstart : f 0 = 1 / (j + 2 * p - 1 : ℝ) := by
      simp [f]
    have hend_den : (j : ℝ) + ((k + 1 - j : ℕ) : ℝ) + 2 * p - 1 = k + 2 * p := by
      nlinarith [hsum_cast]
    have hend_term : f (k + 1 - j) = 1 / (k + 2 * p : ℝ) := by
      dsimp [f]
      rw [hend_den]
    simp [hstart, hend_term]
  calc
    Finset.sum (Finset.range (k + 1 - j))
        (fun m ↦ 1 / (j + m + 2 * p : ℝ) ^ (2 : ℕ))
      ≤
        Finset.sum (Finset.range (k + 1 - j))
          (fun m ↦ 1 / (j + m + 2 * p - 1 : ℝ) - 1 / (j + m + 2 * p : ℝ)) := hsum_le
    _ = 1 / (j + 2 * p - 1 : ℝ) - 1 / (k + 2 * p : ℝ) := htelescoping

/-- Helper for Theorem 13.29: after summing the recurrence and inserting the part `(1)` estimate
at `a j`, the entire weighted tail is controlled by `4M / (j + 2p - 2)`. -/
private lemma rawTailWeightedSumLeFourControlDiv
    (j k : ℕ) (hj : 1 ≤ j) (hjk : j ≤ k) :
    Finset.sum (Finset.range (k + 1 - j))
      (fun m ↦ (2 / (j + m + 2 * p : ℝ)) * b (j + m)) ≤
      (4 * max A ((((p - 1 : ℕ) : ℝ) * a 0))) / (j + 2 * p - 2 : ℝ) := by
  let M : ℝ := max A ((((p - 1 : ℕ) : ℝ) * a 0))
  let G : ℝ :=
    Finset.sum (Finset.range (k + 1 - j))
      (fun m ↦ (2 / (j + m + 2 * p : ℝ)) ^ (2 : ℕ))
  let T : ℝ :=
    Finset.sum (Finset.range (k + 1 - j))
      (fun m ↦ 1 / (j + m + 2 * p : ℝ) ^ (2 : ℕ))
  let U : ℝ := 1 / (j + 2 * p - 1 : ℝ) - 1 / (k + 2 * p : ℝ)
  let d : ℝ := (j + 2 * p - 2 : ℝ)
  have hM_nonneg : 0 ≤ M := by
    dsimp [M]
    exact rawScalarRecurrenceControlNonneg (a := a) (A := A) (p := p) ha_nonneg
  have hd_pos : 0 < d := by
    dsimp [d]
    have hj_real : (1 : ℝ) ≤ j := by
      exact_mod_cast hj
    have hp_real : (1 : ℝ) ≤ p := by
      exact_mod_cast hp
    nlinarith
  have hsum :
      Finset.sum (Finset.range (k + 1 - j))
        (fun m ↦ (2 / (j + m + 2 * p : ℝ)) * b (j + m)) ≤
          a j + (A / 2) * G := by
    have hinterval0 :=
      rawScalarRecurrenceIntervalSum
        (a := a) (b := b) (A := A) (p := p) hp ha_nonneg hstep ha_le_b j k hjk
    have hinterval :
        a (k + 1) +
            Finset.sum (Finset.range (k + 1 - j))
              (fun m ↦ (2 / (j + m + 2 * p : ℝ)) * b (j + m)) ≤
          a j + (A / 2) * G := by
      simpa [G] using hinterval0
    have hdrop :
        Finset.sum (Finset.range (k + 1 - j))
          (fun m ↦ (2 / (j + m + 2 * p : ℝ)) * b (j + m)) ≤
            a j + (A / 2) * G := by
      linarith [hinterval, ha_nonneg (k + 1)]
    exact hdrop
  have haj :
      a j ≤ (2 * M) / d := by
    have hcast_d : (((j + 2 * p - 2 : ℕ) : ℝ)) = d := by
      dsimp [d]
      have hnat : 2 ≤ j + 2 * p := by
        omega
      rw [Nat.cast_sub hnat]
      norm_num [Nat.cast_add, Nat.cast_mul]
    have haj' :=
      rawScalarRecurrenceLeSublinearBound
        (a := a) (b := b) (A := A) (p := p) hp ha_nonneg hstep ha_le_b (k := j) hj
    simpa [M, hcast_d] using haj'
  have hT_nonneg : 0 ≤ T := by
    dsimp [T]
    refine Finset.sum_nonneg ?_
    intro m hm
    have hden_pos : 0 < (j + m + 2 * p : ℝ) := by
      exact_mod_cast (show 0 < j + m + 2 * p by omega)
    positivity
  have hG_eq :
      (A / 2) * G = 2 * A * T := by
    dsimp [G, T]
    calc
      (A / 2) *
          Finset.sum (Finset.range (k + 1 - j))
            (fun m ↦ (2 / (j + m + 2 * p : ℝ)) ^ (2 : ℕ))
        =
          (A / 2) *
            Finset.sum (Finset.range (k + 1 - j))
              (fun m ↦ 4 * (1 / (j + m + 2 * p : ℝ) ^ (2 : ℕ))) := by
            congr 1
            refine Finset.sum_congr rfl ?_
            intro m hm
            simp [pow_two, div_eq_mul_inv]
            ring
      _ =
          Finset.sum (Finset.range (k + 1 - j))
            (fun m ↦ (A / 2) * (4 * (1 / (j + m + 2 * p : ℝ) ^ (2 : ℕ)))) := by
            rw [Finset.mul_sum]
      _ =
          Finset.sum (Finset.range (k + 1 - j))
            (fun m ↦ 2 * A * (1 / (j + m + 2 * p : ℝ) ^ (2 : ℕ))) := by
            refine Finset.sum_congr rfl ?_
            intro m hm
            ring
      _ = 2 * A *
          Finset.sum (Finset.range (k + 1 - j))
            (fun m ↦ 1 / (j + m + 2 * p : ℝ) ^ (2 : ℕ)) := by
            symm
            rw [Finset.mul_sum]
  have hT_le_U : T ≤ U := by
    dsimp [T, U]
    exact rawReciprocalSquareSumLe (a := a) (b := b) (A := A) (p := p)
      hp ha_nonneg hstep ha_le_b j k hjk
  by_cases hA_nonneg : 0 ≤ A
  · have hA_le_M : A ≤ M := by
      dsimp [M]
      exact le_max_left _ _
    have hU_nonneg : 0 ≤ U := by
      have hj_pos : 0 < (j + 2 * p - 1 : ℝ) := by
        have hj_real : (1 : ℝ) ≤ j := by
          exact_mod_cast hj
        have hp_real : (1 : ℝ) ≤ p := by
          exact_mod_cast hp
        nlinarith
      have hj_le_k : (j + 2 * p - 1 : ℝ) ≤ (k + 2 * p : ℝ) := by
        have hjk_real : (j : ℝ) ≤ k := by
          exact_mod_cast hjk
        have hp_real : (0 : ℝ) ≤ p := by
          exact_mod_cast (Nat.zero_le p)
        nlinarith
      have hrecip : 1 / (k + 2 * p : ℝ) ≤ 1 / (j + 2 * p - 1 : ℝ) := by
        exact one_div_le_one_div_of_le hj_pos hj_le_k
      dsimp [U]
      exact sub_nonneg.mpr hrecip
    have hU_le_one_div_d : U ≤ 1 / d := by
      have hdrop_last : U ≤ 1 / (j + 2 * p - 1 : ℝ) := by
        have hlast_nonneg : 0 ≤ 1 / (k + 2 * p : ℝ) := by
          positivity
        dsimp [U]
        linarith
      have hd_le : d ≤ (j + 2 * p - 1 : ℝ) := by
        dsimp [d]
        nlinarith
      have hrecip_le : 1 / (j + 2 * p - 1 : ℝ) ≤ 1 / d := by
        exact one_div_le_one_div_of_le hd_pos hd_le
      exact le_trans hdrop_last hrecip_le
    have hremainder :
        (A / 2) * G ≤ 2 * M / d := by
      rw [hG_eq]
      have hAT : A * T ≤ M * T := by
        exact mul_le_mul_of_nonneg_right hA_le_M hT_nonneg
      have hMU : M * T ≤ M * U := by
        exact mul_le_mul_of_nonneg_left hT_le_U hM_nonneg
      have hUd : M * U ≤ M * (1 / d) := by
        exact mul_le_mul_of_nonneg_left hU_le_one_div_d hM_nonneg
      have hdiv : M * (1 / d) = M / d := by
        simp [div_eq_mul_inv]
      have hUd' : 2 * (M * U) ≤ 2 * M / d := by
        have htmp :=
          mul_le_mul_of_nonneg_left hUd (show (0 : ℝ) ≤ 2 by norm_num)
        simpa [hdiv, div_eq_mul_inv, mul_assoc, mul_left_comm, mul_comm] using htmp
      calc
        2 * A * T ≤ 2 * (M * T) := by nlinarith
        _ ≤ 2 * (M * U) := by nlinarith [hMU]
        _ ≤ 2 * M / d := hUd'
    have htarget :
        Finset.sum (Finset.range (k + 1 - j))
          (fun m ↦ (2 / (j + m + 2 * p : ℝ)) * b (j + m)) ≤
            4 * M / d := by
      have hupper : a j + (A / 2) * G ≤ 4 * M / d := by
        calc
          a j + (A / 2) * G ≤ 2 * M / d + 2 * M / d := add_le_add haj hremainder
          _ = 4 * M / d := by ring
      exact le_trans hsum hupper
    dsimp [M, d] at htarget ⊢
    simpa [mul_assoc, mul_left_comm, mul_comm] using htarget
  · have hA_nonpos : A ≤ 0 := le_of_not_ge hA_nonneg
    have hG_nonneg : 0 ≤ G := by
      dsimp [G]
      refine Finset.sum_nonneg ?_
      intro m hm
      positivity
    have hremainder_nonpos : (A / 2) * G ≤ 0 := by
      nlinarith
    have htarget :
        Finset.sum (Finset.range (k + 1 - j))
          (fun m ↦ (2 / (j + m + 2 * p : ℝ)) * b (j + m)) ≤
            4 * M / d := by
      have hupper : a j + (A / 2) * G ≤ 4 * M / d := by
        have hMd_nonneg : 0 ≤ M / d := by
          exact div_nonneg hM_nonneg hd_pos.le
        have hupper₁ : a j + (A / 2) * G ≤ 2 * M / d := by
          calc
            a j + (A / 2) * G ≤ 2 * M / d + 0 := add_le_add haj hremainder_nonpos
            _ = 2 * M / d := by ring
        have hupper₂ : 2 * M / d ≤ 4 * M / d := by
          calc
            2 * M / d = 2 * (M / d) := by ring
            _ ≤ 4 * (M / d) := by
                  exact mul_le_mul_of_nonneg_right (show (2 : ℝ) ≤ 4 by norm_num) hMd_nonneg
            _ = 4 * M / d := by ring
        exact le_trans hupper₁ hupper₂
      exact le_trans hsum hupper
    dsimp [M, d] at htarget ⊢
    simpa [mul_assoc, mul_left_comm, mul_comm] using htarget

/-- Helper for Theorem 13.29: over the tail interval `j, …, k`, each shifted stepsize
`2 / (j + m + 2p)` is at least the uniform lower bound `2 / (k + 2p)`. -/
private lemma rawShiftedStepsizeSumLower
    (j k : ℕ) (hjk : j ≤ k) :
    2 * ((k + 1 - j : ℕ) : ℝ) / (k + 2 * p : ℝ) ≤
      Finset.sum (Finset.range (k + 1 - j)) (fun m ↦ 2 / (j + m + 2 * p : ℝ)) := by
  have hterm :
      ∀ m ∈ Finset.range (k + 1 - j),
        2 / (k + 2 * p : ℝ) ≤ 2 / (j + m + 2 * p : ℝ) := by
    intro m hm
    have hm_lt : m < k + 1 - j := Finset.mem_range.mp hm
    have hindex_le : j + m ≤ k := by
      omega
    have hsmall_pos : 0 < (j + m + 2 * p : ℝ) := by
      positivity
    have hsmall_le_big : (j + m + 2 * p : ℝ) ≤ (k + 2 * p : ℝ) := by
      have hindex_le_real : (j + m : ℝ) ≤ k := by
        exact_mod_cast hindex_le
      nlinarith
    have hrecip :
        (1 / (k + 2 * p : ℝ)) ≤ 1 / (j + m + 2 * p : ℝ) := by
      exact one_div_le_one_div_of_le hsmall_pos hsmall_le_big
    have hscaled :
        2 * (1 / (k + 2 * p : ℝ)) ≤ 2 * (1 / (j + m + 2 * p : ℝ)) := by
      exact mul_le_mul_of_nonneg_left hrecip (by norm_num)
    simpa [div_eq_mul_inv, mul_comm, mul_left_comm, mul_assoc] using hscaled
  have hconst_sum :
      Finset.sum (Finset.range (k + 1 - j)) (fun _ ↦ 2 / (k + 2 * p : ℝ)) =
        ((k + 1 - j : ℕ) : ℝ) * (2 / (k + 2 * p : ℝ)) := by
    simp
  calc
    2 * ((k + 1 - j : ℕ) : ℝ) / (k + 2 * p : ℝ) =
        ((k + 1 - j : ℕ) : ℝ) * (2 / (k + 2 * p : ℝ)) := by
          ring
    _ = Finset.sum (Finset.range (k + 1 - j)) (fun _ ↦ 2 / (k + 2 * p : ℝ)) := by
          symm
          simp [mul_comm]
    _ ≤ Finset.sum (Finset.range (k + 1 - j)) (fun m ↦ 2 / (j + m + 2 * p : ℝ)) := by
          exact Finset.sum_le_sum fun m hm ↦ hterm m hm

/-- Helper for Theorem 13.29: if the weighted tail is bounded above by the source estimate, then
some index in the interval `j, …, k` already satisfies the corresponding pointwise tail bound. -/
private lemma rawExistsIntervalIndexLeTailBound
    (j k : ℕ) (hj : 1 ≤ j) (hjk : j ≤ k) :
    ∃ m ∈ Finset.range (k + 1 - j),
      b (j + m) ≤
        (2 * max A ((((p - 1 : ℕ) : ℝ) * a 0)) * (k + 2 * p : ℝ)) /
          ((((j + 2 * p - 2 : ℕ) : ℝ) * (((k + 1 - j : ℕ) : ℝ)))) := by
  let M : ℝ := max A ((((p - 1 : ℕ) : ℝ) * a 0))
  let nRange : ℕ := k + 1 - j
  let d : ℝ := (j + 2 * p - 2 : ℝ)
  let B : ℝ := (2 * M * (k + 2 * p : ℝ)) / (d * (nRange : ℝ))
  have hM_nonneg : 0 ≤ M := by
    dsimp [M]
    exact rawScalarRecurrenceControlNonneg (a := a) (A := A) (p := p) ha_nonneg
  have hN_pos_nat : 0 < nRange := by
    dsimp [nRange]
    omega
  have hN_pos : 0 < (nRange : ℝ) := by
    exact_mod_cast hN_pos_nat
  have hd_pos : 0 < d := by
    dsimp [d]
    have hj_real : (1 : ℝ) ≤ j := by
      exact_mod_cast hj
    have hp_real : (1 : ℝ) ≤ p := by
      exact_mod_cast hp
    nlinarith
  have hk_shift_pos : 0 < (k + 2 * p : ℝ) := by
    positivity
  have hB_nonneg : 0 ≤ B := by
    dsimp [B]
    exact div_nonneg (mul_nonneg (mul_nonneg (by norm_num) hM_nonneg) hk_shift_pos.le)
      (mul_nonneg hd_pos.le hN_pos.le)
  by_contra hnone
  have htail_lt : ∀ m ∈ Finset.range nRange, B < b (j + m) := by
    intro m hm
    by_contra hbm
    apply hnone
    refine ⟨m, by simpa [nRange] using hm, ?_⟩
    have hbm' : b (j + m) ≤ B := le_of_not_gt hbm
    have hcast_d : (((j + 2 * p - 2 : ℕ) : ℝ)) = d := by
      dsimp [d]
      have hnat : 2 ≤ j + 2 * p := by
        omega
      rw [Nat.cast_sub hnat]
      norm_num [Nat.cast_add, Nat.cast_mul]
    dsimp [B, nRange, M] at hbm'
    simpa [d, hcast_d] using hbm'
  have hweight_pos :
      ∀ m ∈ Finset.range nRange, 0 < 2 / (j + m + 2 * p : ℝ) := by
    intro m hm
    have hden_pos : 0 < (j + m + 2 * p : ℝ) := by
      exact_mod_cast (show 0 < j + m + 2 * p by omega)
    exact div_pos (by norm_num) hden_pos
  have hscaled_strict :
      Finset.sum (Finset.range nRange) (fun m ↦ (2 / (j + m + 2 * p : ℝ)) * B) <
        Finset.sum (Finset.range nRange) (fun m ↦ (2 / (j + m + 2 * p : ℝ)) * b (j + m)) := by
    refine Finset.sum_lt_sum_of_nonempty (Finset.nonempty_range_iff.2 (Nat.ne_of_gt hN_pos_nat)) ?_
    intro m hm
    exact mul_lt_mul_of_pos_left (htail_lt m hm) (hweight_pos m hm)
  have hscaled_eq :
      Finset.sum (Finset.range nRange) (fun m ↦ (2 / (j + m + 2 * p : ℝ)) * B) =
        B * Finset.sum (Finset.range nRange) (fun m ↦ 2 / (j + m + 2 * p : ℝ)) := by
    calc
      Finset.sum (Finset.range nRange) (fun m ↦ (2 / (j + m + 2 * p : ℝ)) * B) =
          Finset.sum (Finset.range nRange) (fun m ↦ B * (2 / (j + m + 2 * p : ℝ))) := by
            refine Finset.sum_congr rfl ?_
            intro m hm
            ring
      _ = B * Finset.sum (Finset.range nRange) (fun m ↦ 2 / (j + m + 2 * p : ℝ)) := by
            rw [Finset.mul_sum]
  have hlower_weighted :
      B * (2 * (nRange : ℝ) / (k + 2 * p : ℝ)) ≤
        Finset.sum (Finset.range nRange) (fun m ↦ (2 / (j + m + 2 * p : ℝ)) * B) := by
    rw [hscaled_eq]
    exact mul_le_mul_of_nonneg_left
      (rawShiftedStepsizeSumLower (a := a) (b := b) (A := A) (p := p)
        hp ha_nonneg hstep ha_le_b j k hjk)
      hB_nonneg
  have hbase_eq : B * (2 * (nRange : ℝ) / (k + 2 * p : ℝ)) = 4 * M / d := by
    dsimp [B]
    field_simp [hd_pos.ne', hN_pos.ne', hk_shift_pos.ne']
    ring
  have hstrict :
      4 * M / d <
        Finset.sum (Finset.range nRange) (fun m ↦ (2 / (j + m + 2 * p : ℝ)) * b (j + m)) := by
    calc
      4 * M / d = B * (2 * (nRange : ℝ) / (k + 2 * p : ℝ)) := by
        symm
        exact hbase_eq
      _ ≤ Finset.sum (Finset.range nRange) (fun m ↦ (2 / (j + m + 2 * p : ℝ)) * B) := hlower_weighted
      _ < Finset.sum (Finset.range nRange) (fun m ↦ (2 / (j + m + 2 * p : ℝ)) * b (j + m)) :=
        hscaled_strict
  have hupper :=
    rawTailWeightedSumLeFourControlDiv
      (a := a) (b := b) (A := A) (p := p) hp ha_nonneg hstep ha_le_b j k hj hjk
  dsimp [M, nRange, d] at hstrict hupper
  exact (not_lt_of_ge hupper) hstrict

/-- Helper for Theorem 13.29: for the textbook choice `j = ⌊k / 2⌋ + 2`, the interval-tail ratio
compresses to the final factor `4 / (k - 2)`. -/
private lemma rawHalfTailRatioLeFourDiv
    {k : ℕ} (hk : 3 ≤ k) :
    let j := k / 2 + 2
    ((k + 2 * p : ℕ) : ℝ) /
        ((((j + 2 * p - 2 : ℕ) : ℝ) * (((k + 1 - j : ℕ) : ℝ)))) ≤
      4 / (((k - 2 : ℕ) : ℝ)) := by
  dsimp
  have hk_sub_pos : 0 < ((k - 2 : ℕ) : ℝ) := by
    exact_mod_cast (show 0 < k - 2 by omega)
  have hj_factor_pos : 0 < ((k / 2 + 2 + 2 * p - 2 : ℕ) : ℝ) := by
    exact_mod_cast (show 0 < k / 2 + 2 + 2 * p - 2 by omega)
  have hlen_pos : 0 < ((k + 1 - (k / 2 + 2) : ℕ) : ℝ) := by
    exact_mod_cast (show 0 < k + 1 - (k / 2 + 2) by omega)
  have hprod_pos :
      0 <
        (((k / 2 + 2 + 2 * p - 2 : ℕ) : ℝ) *
          (((k + 1 - (k / 2 + 2) : ℕ) : ℝ))) := by
    exact mul_pos hj_factor_pos hlen_pos
  have hfirst_nat : k + 2 * p ≤ 2 * (k / 2 + 2 + 2 * p - 2) := by
    omega
  have hsecond_nat : k - 2 ≤ 2 * (k + 1 - (k / 2 + 2)) := by
    omega
  have hfirst :
      ((k + 2 * p : ℕ) : ℝ) ≤ 2 * ((k / 2 + 2 + 2 * p - 2 : ℕ) : ℝ) := by
    exact_mod_cast hfirst_nat
  have hsecond :
      ((k - 2 : ℕ) : ℝ) ≤ 2 * ((k + 1 - (k / 2 + 2) : ℕ) : ℝ) := by
    exact_mod_cast hsecond_nat
  have hcross :
      ((k + 2 * p : ℕ) : ℝ) * ((k - 2 : ℕ) : ℝ) ≤
        4 *
          (((k / 2 + 2 + 2 * p - 2 : ℕ) : ℝ) *
            ((k + 1 - (k / 2 + 2) : ℕ) : ℝ)) := by
    nlinarith
  field_simp [hprod_pos.ne', hk_sub_pos.ne']
  nlinarith [hcross]

include ha_nonneg hstep ha_le_b

/-- Helper for Theorem 13.29: a raw `2 / (k + 2p)` recurrence yields a half-tail witness index
`n ∈ {k / 2 + 2, …, k}` with the bound
`b n ≤ 8 * max {A, (p - 1) a₀} / (k - 2)`. -/
private theorem rawExistsHalfTailIndexLeSublinearBound
    {k : ℕ} (hk : 3 ≤ k) :
    ∃ n ∈ Set.Icc (k / 2 + 2) k,
      b n ≤
        (8 * max A ((((p - 1 : ℕ) : ℝ) * a 0))) /
          (((k - 2 : ℕ) : ℝ)) := by
  let j : ℕ := k / 2 + 2
  have hj : 1 ≤ j := by
    dsimp [j]
    omega
  have hjk : j ≤ k := by
    dsimp [j]
    omega
  obtain ⟨m, hm, hbm⟩ :=
    rawExistsIntervalIndexLeTailBound
      (a := a) (b := b) (A := A) (p := p) hp ha_nonneg hstep ha_le_b j k hj hjk
  let n : ℕ := j + m
  have hm_lt : m < k + 1 - j := Finset.mem_range.mp hm
  have hn_mem : n ∈ Set.Icc (k / 2 + 2) k := by
    constructor
    · dsimp [n, j]
      omega
    · dsimp [n, j]
      omega
  let M : ℝ := max A ((((p - 1 : ℕ) : ℝ) * a 0))
  have hM_nonneg : 0 ≤ M := by
    dsimp [M]
    exact rawScalarRecurrenceControlNonneg (a := a) (A := A) (p := p) ha_nonneg
  have hratio :
      ((k + 2 * p : ℕ) : ℝ) /
          ((((j + 2 * p - 2 : ℕ) : ℝ) * (((k + 1 - j : ℕ) : ℝ)))) ≤
        4 / (((k - 2 : ℕ) : ℝ)) := by
    dsimp [j]
    simpa using
      (rawHalfTailRatioLeFourDiv (a := a) (b := b) (A := A) (p := p)
        hp ha_nonneg hstep ha_le_b (k := k) hk)
  have hscaled_ratio :
      (2 * M) *
          (((k + 2 * p : ℕ) : ℝ) /
            (((j + 2 * p - 2 : ℕ) : ℝ) * ((k + 1 - j : ℕ) : ℝ))) ≤
        (2 * M) * (4 / ((k - 2 : ℕ) : ℝ)) := by
    exact mul_le_mul_of_nonneg_left hratio (by nlinarith)
  have hbound :
      b n ≤ (8 * M) / (((k - 2 : ℕ) : ℝ)) := by
    have hbm' :
        b n ≤
          (2 * M) *
            (((k + 2 * p : ℕ) : ℝ) /
              (((j + 2 * p - 2 : ℕ) : ℝ) * ((k + 1 - j : ℕ) : ℝ))) := by
      dsimp [n, M] at hbm ⊢
      have hd_pos :
          0 <
            (((j + 2 * p - 2 : ℕ) : ℝ) * ((k + 1 - j : ℕ) : ℝ)) := by
        have hjd_pos : 0 < ((j + 2 * p - 2 : ℕ) : ℝ) := by
          exact_mod_cast (show 0 < j + 2 * p - 2 by omega)
        have hlen_pos : 0 < ((k + 1 - j : ℕ) : ℝ) := by
          exact_mod_cast (show 0 < k + 1 - j by omega)
        exact mul_pos hjd_pos hlen_pos
      have hden_ne : (((j + 2 * p - 2 : ℕ) : ℝ) * ((k + 1 - j : ℕ) : ℝ)) ≠ 0 :=
        hd_pos.ne'
      have hratio_eq :
          (2 * M) *
              (((k + 2 * p : ℕ) : ℝ) /
                (((j + 2 * p - 2 : ℕ) : ℝ) * ((k + 1 - j : ℕ) : ℝ))) =
            (2 * M * (k + 2 * p : ℝ)) /
              (((j + 2 * p - 2 : ℕ) : ℝ) * ((k + 1 - j : ℕ) : ℝ)) := by
        have hcast :
            ((k + 2 * p : ℕ) : ℝ) = (k : ℝ) + (p : ℝ) * 2 := by
          exact_mod_cast (show k + 2 * p = k + p * 2 by omega)
        rw [div_eq_mul_inv, div_eq_mul_inv]
        rw [hcast]
        ring
      rw [hratio_eq]
      exact hbm
    have htarget :
        (2 * M) *
            (((k + 2 * p : ℕ) : ℝ) /
              (((j + 2 * p - 2 : ℕ) : ℝ) * ((k + 1 - j : ℕ) : ℝ))) ≤
          (8 * M) / (((k - 2 : ℕ) : ℝ)) := by
      calc
        (2 * M) *
            (((k + 2 * p : ℕ) : ℝ) /
              (((j + 2 * p - 2 : ℕ) : ℝ) * ((k + 1 - j : ℕ) : ℝ)))
            ≤ (2 * M) * (4 / ((k - 2 : ℕ) : ℝ)) := hscaled_ratio
        _ = (8 * M) / (((k - 2 : ℕ) : ℝ)) := by
            field_simp
            ring
    exact le_trans hbm' htarget
  refine ⟨n, hn_mem, ?_⟩
  dsimp [M] at hbound ⊢
  simpa [mul_assoc, mul_left_comm, mul_comm] using hbound

end

/-- Source-faithful generated-sequence owner for Theorem 13.29: along each sample path the
iterates satisfy the RGBCG trajectory clauses, and the realized sampled-block minimizer is chosen
by a deterministic block rule depending only on the current iterate and sampled block. This keeps
the textbook “generated by the RGBCG method” condition on the theorem surface without exposing the
point-rule premise as a separate theorem hypothesis. -/
class is_generated_by_randomized_generalized_block_conditional_gradient_method
    (g : (i : ι) → Ei i → EReal)
    (block_gradient : (i : ι) → ((j : ι) → Ei j) → Ei i)
    (x : ℕ → Ξ → X)
    (sampled_block : ℕ → Ξ → ι)
    (point : (k : ℕ) → (ω : Ξ) → Ei (sampled_block k ω))
    (t : ℕ → Set.Icc (0 : ℝ) 1) : Prop where
  /-- Every sample path is a realized RGBCG trajectory. -/
  trajectory :
    ∀ ω,
      is_randomized_generalized_block_conditional_gradient_trajectory
        g
        block_gradient
        (fun n ↦ x n ω)
        (fun n ↦ sampled_block n ω)
        (fun n ↦ point n ω)
        t
  /-- The sampled-block minimizer is selected by a deterministic point rule. -/
  point_rule :
    ∃ pointRule : (i : ι) → X → Ei i,
      ∀ n ω,
        point n ω = pointRule (sampled_block n ω) (x n ω)

-- Semantic recall note: `lean_leansearch` timed out on the stochastic-history query, and the
-- nearby Chapter 11/13 owners do not expose a bundled analogue for this paired rate statement,
-- so this file packages the generated-sequence condition locally and keeps the clause-wise bounds
-- as explicit companions.
/-- Theorem 13.29. Under Assumption 13.28, if `x^k` is the RGBCG iterate process with
deterministic stepsizes `t_k = 2 |ι| / (k + 2 |ι|)` and `Ω` bounds the diameter of `dom(g)` in
the weighted norm `‖·‖_L`, then:

(a) for every `k ≥ 1`, the expected objective gap satisfies
`E(F(x^k)) - F_opt ≤ 2 max{(|ι| - 1)(F(x^0) - F_opt), |ι| Ω^2} / (k + 2 |ι| - 2)`;

(b) for every `k ≥ 3`, the minimum of `E(S(x^n))` on the half-tail interval
`{⌊k / 2⌋ + 2, …, k}` is bounded by
`8 max{(|ι| - 1)(F(x^0) - F_opt), |ι| Ω^2} / (k - 2)`.

In Lean clause `(b)` is represented by the infimum of the finite image over
`Set.Icc (k / 2 + 2) k`, and the generated-by-method hypothesis is packaged by
`is_generated_by_randomized_generalized_block_conditional_gradient_method` rather than exposed as
a separate deterministic point-rule premise. -/
theorem randomized_generalized_block_conditional_gradient_expected_sublinear_rates
    (h_problem : IsGeneralizedBlockConditionalGradientProblem f g Li)
    (h_zero : x 0 = fun _ ↦ x0)
    (h_generated :
      is_generated_by_randomized_generalized_block_conditional_gradient_method
        g
        (blockGradient f)
        x
        sampled_block
        point
        t)
    (h_stepsize :
      ∀ n : ℕ, (t n : ℝ) = (2 * Fintype.card ι : ℝ) / (n + 2 * Fintype.card ι : ℕ))
    (h_sampled_block_measurable : ∀ n, Measurable (sampled_block n))
    (h_sampled_block_indep : iIndepFun sampled_block μ)
    (h_sampled_block_uniform :
      ∀ n (i : ι), μ ((sampled_block n) ⁻¹' {i}) = 1 / (N : ℝ≥0∞))
    (h_diameter_bound :
      ∀ {u v : X},
        u ∈ effective_domain (PiLp.separableSum g) →
        v ∈ effective_domain (PiLp.separableSum g) →
        ‖u - v‖_[Li] ≤ Ω) :
    (∀ k : ℕ, 1 ≤ k →
      μ[fun ω ↦ (F (x k ω)).toReal] - F_opt_real ≤
        ((2 : ℝ) * rateBound) / ((k + 2 * N - 2 : ℕ) : ℝ)) ∧
      ∀ k : ℕ, 3 ≤ k →
        sInf
            ((fun n ↦ μ[fun ω ↦ (Sᵇ[g, blockGradient f](x n ω)).toReal]) ''
              Set.Icc (k / 2 + 2) k) ≤
          ((8 : ℝ) * rateBound) / ((k - 2 : ℕ) : ℝ) := by
  classical
  rcases h_generated.point_rule with ⟨pointRule, h_point_rule⟩
  let a : ℕ → ℝ := fun n ↦ μ[fun ω ↦ (F (x n ω)).toReal] - F_opt_real
  let b : ℕ → ℝ := fun n ↦ μ[fun ω ↦ (Sᵇ[g, blockGradient f](x n ω)).toReal]
  let A : ℝ := (N : ℝ) * Ω ^ (2 : ℕ)
  have hΞ_nonempty : Nonempty Ξ := by
    by_contra hΞ
    have huniv : (Set.univ : Set Ξ) = ∅ := by
      ext ω
      exact False.elim (hΞ ⟨ω⟩)
    have hzero : μ Set.univ = 0 := by
      simpa [huniv] using (measure_empty : μ (∅ : Set Ξ) = 0)
    simpa using hzero
  have hN_pos_nat : 0 < N := by
    exact Fintype.card_pos_iff.mpr ⟨sampled_block 0 (Classical.choice hΞ_nonempty)⟩
  have hA_nonneg : 0 ≤ A := by
    dsimp [A]
    positivity
  have hobjective_integrable :
      ∀ n : ℕ, Integrable (fun ω ↦ (F (x n ω)).toReal) μ := by
    intro n
    rcases rgbcg_history_adapted_of_point_rule x0 h_zero h_generated.trajectory
        ⟨pointRule, h_point_rule⟩ n with
      ⟨Φn, hΦn⟩
    simpa [hΦn] using
      randomized_block_history_observable_integrable
        (sampled_block := sampled_block)
        (μ := μ)
        n
        (fun ξ ↦ (F (Φn ξ)).toReal)
        h_sampled_block_measurable
  have hnorm_integrable :
      ∀ n : ℕ, Integrable (fun ω ↦ (Sᵇ[g, blockGradient f](x n ω)).toReal) μ := by
    intro n
    rcases rgbcg_history_adapted_of_point_rule x0 h_zero h_generated.trajectory
        ⟨pointRule, h_point_rule⟩ n with
      ⟨Φn, hΦn⟩
    simpa [hΦn] using
      randomized_block_history_observable_integrable
        (sampled_block := sampled_block)
        (μ := μ)
        n
        (fun ξ ↦ (Sᵇ[g, blockGradient f](Φn ξ)).toReal)
        h_sampled_block_measurable
  have hFopt_ne_bot : F_opt ≠ ⊥ := by
    obtain ⟨xStar, hxStar⟩ := h_problem.optimal_set_nonempty
    rw [h_problem.optimal_value_eq_of_mem_optimal_set hxStar, composite_model_objective_apply,
      EReal.add_ne_bot_iff]
    exact ⟨h_problem.f_ne_bot xStar, (separableSum_proper g h_problem.block_g_proper).ne_bot xStar⟩
  have hgap_eq :
      ∀ n : ℕ, a n = μ[fun ω ↦ (F (x n ω)).toReal - F_opt_real] := by
    intro n
    rw [a]
    calc
      μ[fun ω ↦ (F (x n ω)).toReal] - F_opt_real
          = μ[fun ω ↦ (F (x n ω)).toReal] - μ[fun _ : Ξ ↦ (F_opt_real : ℝ)] := by
              simp
      _ = μ[fun ω ↦ (F (x n ω)).toReal - F_opt_real] := by
            rw [← MeasureTheory.integral_sub
              (hobjective_integrable n)
              (integrable_const F_opt_real)]
  have hgap_nonneg :
      ∀ n : ℕ, 0 ≤ a n := by
    intro n
    rw [hgap_eq n]
    refine MeasureTheory.integral_nonneg_of_ae ?_
    filter_upwards with ω
    have hy : x n ω ∈ domG := rgbcgIterateMemEffectiveDomain h_problem h_generated.trajectory n ω
    have hopt_le : F_opt ≤ F (x n ω) :=
      h_problem.optimal_value_isGLB.1 ⟨x n ω, rfl⟩
    have hFx_ne_top : F (x n ω) ≠ ⊤ := by
      rw [rgbcgCompositeModelObjective_eq_coe_real_of_mem_effective_domain h_problem hy]
      exact EReal.coe_ne_top _
    have hreal_le : F_opt_real ≤ (F (x n ω)).toReal :=
      EReal.toReal_le_toReal hopt_le hFopt_ne_bot hFx_ne_top
    exact sub_nonneg.mpr hreal_le
  have hgap_le_norm :
      ∀ n : ℕ, a n ≤ b n := by
    intro n
    calc
      a n = μ[fun ω ↦ (F (x n ω)).toReal - F_opt_real] := hgap_eq n
      _ ≤ μ[fun ω ↦ (Sᵇ[g, blockGradient f](x n ω)).toReal] := by
            exact
              MeasureTheory.integral_mono_ae
                ((hobjective_integrable n).sub (integrable_const F_opt_real))
                (hnorm_integrable n)
                (by
                  filter_upwards with ω
                  exact
                    rgbcgBlockConditionalGradientNorm_toReal_ge_objectiveGap
                      h_problem
                      (rgbcgIterateMemEffectiveDomain h_problem h_generated.trajectory n ω))
      _ = b n := rfl
  have hrec :
      ∀ n : ℕ,
        a (n + 1) ≤
          a n - (2 / (n + 2 * N : ℝ)) * b n +
            (A / 2) * (2 / (n + 2 * N : ℝ)) ^ (2 : ℕ) := by
    intro n
    let gapObs : Ξ → ℝ :=
      fun ω ↦ (Sᵇ[g, blockGradient f; sampled_block n ω](x n ω)).toReal
    let remObs : Ξ → ℝ :=
      fun ω ↦ (Li (sampled_block n ω) : ℝ) *
        ‖point n ω - x n ω (sampled_block n ω)‖ ^ (2 : ℕ)
    have hgapObs_int : Integrable gapObs μ := by
      rcases rgbcg_history_adapted_of_point_rule x0 h_zero h_generated.trajectory
          ⟨pointRule, h_point_rule⟩ n with
        ⟨Φn, hΦn⟩
      let ψ : (Fin n → ι) → ι → ℝ :=
        fun ξ i ↦ (Sᵇ[g, blockGradient f; i](Φn ξ)).toReal
      simpa [gapObs, ψ, hΦn, h_point_rule] using
        randomizedBlockHistoryCurrentBlockObservable_integrable
          (sampled_block := sampled_block)
          (μ := μ)
          n
          ψ
          h_sampled_block_measurable
    have hremObs_int : Integrable remObs μ := by
      rcases rgbcg_history_adapted_of_point_rule x0 h_zero h_generated.trajectory
          ⟨pointRule, h_point_rule⟩ n with
        ⟨Φn, hΦn⟩
      let ψ : (Fin n → ι) → ι → ℝ :=
        fun ξ i ↦ (Li i : ℝ) * ‖pointRule i (Φn ξ) - Φn ξ i‖ ^ (2 : ℕ)
      simpa [remObs, ψ, hΦn, h_point_rule] using
        randomizedBlockHistoryCurrentBlockObservable_integrable
          (sampled_block := sampled_block)
          (μ := μ)
          n
          ψ
          h_sampled_block_measurable
    have hrem_eq_average :
        μ[remObs] =
          μ[fun ω ↦
            ((N : ℝ)⁻¹) *
              ∑ i : ι, (Li i : ℝ) * ‖pointRule i (x n ω) - x n ω i‖ ^ (2 : ℕ)] := by
      rcases rgbcg_history_adapted_of_point_rule x0 h_zero h_generated.trajectory
          ⟨pointRule, h_point_rule⟩ n with
        ⟨Φn, hΦn⟩
      let ψ : (Fin n → ι) → ι → ℝ :=
        fun ξ i ↦ (Li i : ℝ) * ‖pointRule i (Φn ξ) - Φn ξ i‖ ^ (2 : ℕ)
      have havg :=
        randomized_block_history_current_block_average
          (sampled_block := sampled_block)
          (μ := μ)
          n
          ψ
          h_sampled_block_measurable
          h_sampled_block_indep
          h_sampled_block_uniform
      simpa [remObs, ψ, hΦn, h_point_rule] using havg
    have hstep_integral :
        μ[fun ω ↦ (F (x (n + 1) ω)).toReal] ≤
          μ[fun ω ↦
            (F (x n ω)).toReal -
              (t n : ℝ) * gapObs ω +
              (((t n : ℝ) ^ (2 : ℕ)) / 2) * remObs ω] := by
      have hrhs_int :
          Integrable
            (fun ω ↦
              (F (x n ω)).toReal -
                (t n : ℝ) * gapObs ω +
                (((t n : ℝ) ^ (2 : ℕ)) / 2) * remObs ω)
            μ := by
        have hgap_scaled : Integrable (fun ω ↦ (t n : ℝ) * gapObs ω) μ := by
          simpa [gapObs, mul_comm] using (hgapObs_int.const_mul (t n : ℝ))
        have hrem_scaled :
            Integrable (fun ω ↦ (((t n : ℝ) ^ (2 : ℕ)) / 2) * remObs ω) μ := by
          simpa [remObs, mul_comm] using
            (hremObs_int.const_mul (((t n : ℝ) ^ (2 : ℕ)) / 2))
        exact (hobjective_integrable n).sub hgap_scaled |>.add hrem_scaled
      exact
        MeasureTheory.integral_mono_ae
          (hobjective_integrable (n + 1))
          hrhs_int
          (Filter.Eventually.of_forall (rgbcgOneStepObjectiveBound
            h_problem
            h_generated.trajectory
            n))
    have hgap_average :
        μ[gapObs] = (N : ℝ)⁻¹ * b n := by
      calc
        μ[gapObs] =
            μ[fun ω ↦ ((N : ℝ)⁻¹) * ∑ i : ι, (Sᵇ[g, blockGradient f; i](x n ω)).toReal] := by
              simpa [gapObs] using
                rgbcg_expected_sampled_block_gap_eq_uniform_average
                  x0
                  h_sampled_block_measurable
                  h_sampled_block_indep
                  h_sampled_block_uniform
                  h_zero
                  h_generated.trajectory
                  ⟨pointRule, h_point_rule⟩
                  (n := n)
        _ = (N : ℝ)⁻¹ * b n := by
              rw [b, ← MeasureTheory.integral_mul_left]
              refine integral_congr_ae ?_
              filter_upwards with ω
              rw [rgbcgBlockConditionalGradientNorm_toReal_eq_sum
                h_problem
                (rgbcgIterateMemEffectiveDomain h_problem h_generated.trajectory n ω)]
      -- The average of the sampled-block gap is the uniform block average of the total norm.
    have hrem_bound :
        μ[remObs] ≤ ((N : ℝ)⁻¹) * Ω ^ (2 : ℕ) := by
      rw [hrem_eq_average]
      exact
        rgbcgExpectedQuadraticRemainder_le_diameter
          h_problem
          x0
          h_sampled_block_measurable
          h_sampled_block_indep
          h_sampled_block_uniform
          h_zero
          h_generated.trajectory
          h_point_rule
          Ω
          h_diameter_bound
          n
    have hstep_split :
        μ[fun ω ↦
          (F (x n ω)).toReal -
            (t n : ℝ) * gapObs ω +
            (((t n : ℝ) ^ (2 : ℕ)) / 2) * remObs ω]
          =
            μ[fun ω ↦ (F (x n ω)).toReal] -
              (t n : ℝ) * μ[gapObs] +
              (((t n : ℝ) ^ (2 : ℕ)) / 2) * μ[remObs] := by
      have hgap_scaled : Integrable (fun ω ↦ (t n : ℝ) * gapObs ω) μ := by
        simpa [gapObs, mul_comm] using (hgapObs_int.const_mul (t n : ℝ))
      have hrem_scaled : Integrable (fun ω ↦ (((t n : ℝ) ^ (2 : ℕ)) / 2) * remObs ω) μ := by
        simpa [remObs, mul_comm] using
          (hremObs_int.const_mul (((t n : ℝ) ^ (2 : ℕ)) / 2))
      rw [show (fun ω ↦
          (F (x n ω)).toReal -
            (t n : ℝ) * gapObs ω +
            (((t n : ℝ) ^ (2 : ℕ)) / 2) * remObs ω) =
          (fun ω ↦ (F (x n ω)).toReal - (t n : ℝ) * gapObs ω) +
            (fun ω ↦ (((t n : ℝ) ^ (2 : ℕ)) / 2) * remObs ω) by
          funext ω
          ring]
      rw [MeasureTheory.integral_add ((hobjective_integrable n).sub hgap_scaled) hrem_scaled]
      rw [MeasureTheory.integral_sub (hobjective_integrable n) hgap_scaled]
      simp [MeasureTheory.integral_mul_left]
    have hmain :
        μ[fun ω ↦ (F (x (n + 1) ω)).toReal] ≤
          μ[fun ω ↦ (F (x n ω)).toReal] -
            (t n : ℝ) * ((N : ℝ)⁻¹ * b n) +
            (((t n : ℝ) ^ (2 : ℕ)) / 2) * (((N : ℝ)⁻¹) * Ω ^ (2 : ℕ)) := by
      calc
        μ[fun ω ↦ (F (x (n + 1) ω)).toReal]
            ≤ μ[fun ω ↦
                (F (x n ω)).toReal -
                  (t n : ℝ) * gapObs ω +
                  (((t n : ℝ) ^ (2 : ℕ)) / 2) * remObs ω] := hstep_integral
        _ = μ[fun ω ↦ (F (x n ω)).toReal] -
              (t n : ℝ) * μ[gapObs] +
              (((t n : ℝ) ^ (2 : ℕ)) / 2) * μ[remObs] := hstep_split
        _ ≤ μ[fun ω ↦ (F (x n ω)).toReal] -
              (t n : ℝ) * ((N : ℝ)⁻¹ * b n) +
              (((t n : ℝ) ^ (2 : ℕ)) / 2) * (((N : ℝ)⁻¹) * Ω ^ (2 : ℕ)) := by
                have ht_nonneg : 0 ≤ (t n : ℝ) := (t n).1
                have hcoef_nonneg : 0 ≤ (((t n : ℝ) ^ (2 : ℕ)) / 2) := by positivity
                rw [hgap_average]
                exact add_le_add_left
                  (mul_le_mul_of_nonneg_left hrem_bound hcoef_nonneg)
                  (μ[fun ω ↦ (F (x n ω)).toReal] - (t n : ℝ) * ((N : ℝ)⁻¹) * b n)
    rw [a]
    have hfinal :
        μ[fun ω ↦ (F (x (n + 1) ω)).toReal] - F_opt_real ≤
          μ[fun ω ↦ (F (x n ω)).toReal] - F_opt_real -
            (2 / (n + 2 * N : ℝ)) * b n +
            (A / 2) * (2 / (n + 2 * N : ℝ)) ^ (2 : ℕ) := by
      rw [h_stepsize]
      dsimp [A] at hmain ⊢
      nlinarith
    exact hfinal
  constructor
  · intro k hk
    have hbound :=
      rawScalarRecurrenceLeSublinearBound
        (a := a) (b := b) (A := A) (p := N)
        (Nat.succ_le_of_lt hN_pos_nat)
        hgap_nonneg
        hrec
        hgap_le_norm
        hk
    have hbound' :
        a k ≤ (2 * rateBound) / (((k + 2 * N - 2 : ℕ) : ℝ)) := by
      dsimp [a, A, rateBound] at hbound ⊢
      simpa [hA_nonneg, max_comm, max_left_comm, max_assoc, max_eq_right hA_nonneg,
        mul_assoc, mul_left_comm, mul_comm] using hbound
    simpa [a] using hbound'
  · intro k hk
    obtain ⟨n, hn, hbn⟩ :=
      rawExistsHalfTailIndexLeSublinearBound
        (a := a) (b := b) (A := A) (p := N)
        (Nat.succ_le_of_lt hN_pos_nat)
        hgap_nonneg
        hrec
        hgap_le_norm
        hk
    have hbn' :
        b n ≤ (8 * rateBound) / (((k - 2 : ℕ) : ℝ)) := by
      dsimp [b, A, rateBound] at hbn ⊢
      simpa [hA_nonneg, max_comm, max_left_comm, max_assoc, max_eq_right hA_nonneg,
        mul_assoc, mul_left_comm, mul_comm] using hbn
    exact sInf_le ⟨n, hn, hbn'⟩

/-- Objective-gap companion to the RGBCG sublinear-rate theorem. Under Assumption 13.28, if `x^k`
is the RGBCG iterate process with deterministic stepsizes `t_k = 2 |ι| / (k + 2 |ι|)` and `Ω`
bounds the diameter of `dom(g)` in the weighted norm `‖·‖_L`, then for every `k ≥ 1` the
expected objective gap satisfies
`E(F(x^k)) - F_opt ≤ 2 max{(|ι| - 1)(F(x^0) - F_opt), |ι| Ω^2} / (k + 2 |ι| - 2)`. -/
theorem randomized_generalized_block_conditional_gradient_expected_objective_gap_le_sublinear_rate
    (h_problem : IsGeneralizedBlockConditionalGradientProblem f g Li)
    (h_zero : x 0 = fun _ ↦ x0)
    (h_generated :
      is_generated_by_randomized_generalized_block_conditional_gradient_method
        g
        (blockGradient f)
        x
        sampled_block
        point
        t)
    (h_stepsize :
      ∀ n : ℕ, (t n : ℝ) = (2 * Fintype.card ι : ℝ) / (n + 2 * Fintype.card ι : ℕ))
    (h_sampled_block_measurable : ∀ n, Measurable (sampled_block n))
    (h_sampled_block_indep : iIndepFun sampled_block μ)
    (h_sampled_block_uniform :
      ∀ n (i : ι), μ ((sampled_block n) ⁻¹' {i}) = 1 / (N : ℝ≥0∞))
    (h_diameter_bound :
      ∀ {u v : X},
        u ∈ effective_domain (PiLp.separableSum g) →
        v ∈ effective_domain (PiLp.separableSum g) →
        ‖u - v‖_[Li] ≤ Ω)
    {k : ℕ} (hk : 1 ≤ k) :
    μ[fun ω ↦ (F (x k ω)).toReal] - F_opt_real ≤
      ((2 : ℝ) * rateBound) / ((k + 2 * N - 2 : ℕ) : ℝ) := by
  -- Project clause `(a)` from the paired-rate theorem.
  exact
    (randomized_generalized_block_conditional_gradient_expected_sublinear_rates
      (f := f)
      (g := g)
      (Li := Li)
      (μ := μ)
      (sampled_block := sampled_block)
      (x := x)
      (point := point)
      (t := t)
      (x0 := x0)
      (Ω := Ω)
      h_problem
      h_zero
      h_generated
      h_stepsize
      h_sampled_block_measurable
      h_sampled_block_indep
      h_sampled_block_uniform
      h_diameter_bound).1
      k
      hk

-- Proof sketch: apply the same recursion as in clause `(1)` and then invoke the half-tail
-- estimate for sequences satisfying
-- `a_{k+1} ≤ a_k - α_k b_k + (|ι| α_k^2 / 2) Ω^2` with `α_k = 2 / (k + 2 |ι|)`. The result
-- yields the textbook minimum estimate on the half-tail interval
-- `{⌊k / 2⌋ + 2, …, k}`.
/-- Half-tail minimum companion to the RGBCG sublinear-rate theorem. Under the same hypotheses,
for every `k ≥ 3`, the minimum of `E(S(x^n))` on the half-tail interval
`{⌊k / 2⌋ + 2, …, k}` is bounded by
`8 max{(|ι| - 1)(F(x^0) - F_opt), |ι| Ω^2} / (k - 2)`. In Lean this minimum is represented by the
infimum of the finite set of expectations indexed by `Set.Icc (k / 2 + 2) k`. -/
theorem
    randomized_generalized_block_conditional_gradient_half_tail_expected_norm_sInf_le_sublinear_rate
    (h_problem : IsGeneralizedBlockConditionalGradientProblem f g Li)
    (h_zero : x 0 = fun _ ↦ x0)
    (h_generated :
      is_generated_by_randomized_generalized_block_conditional_gradient_method
        g
        (blockGradient f)
        x
        sampled_block
        point
        t)
    (h_stepsize :
      ∀ n : ℕ, (t n : ℝ) = (2 * Fintype.card ι : ℝ) / (n + 2 * Fintype.card ι : ℕ))
    (h_sampled_block_measurable : ∀ n, Measurable (sampled_block n))
    (h_sampled_block_indep : iIndepFun sampled_block μ)
    (h_sampled_block_uniform :
      ∀ n (i : ι), μ ((sampled_block n) ⁻¹' {i}) = 1 / (N : ℝ≥0∞))
    (h_diameter_bound :
      ∀ {u v : X},
        u ∈ effective_domain (PiLp.separableSum g) →
        v ∈ effective_domain (PiLp.separableSum g) →
        ‖u - v‖_[Li] ≤ Ω)
    {k : ℕ} (hk : 3 ≤ k) :
    sInf
        ((fun n ↦ μ[fun ω ↦ (Sᵇ[g, blockGradient f](x n ω)).toReal]) ''
          Set.Icc (k / 2 + 2) k) ≤
      ((8 : ℝ) * rateBound) / ((k - 2 : ℕ) : ℝ) := by
  -- Project clause `(b)` from the paired-rate theorem.
  exact
    (randomized_generalized_block_conditional_gradient_expected_sublinear_rates
      (f := f)
      (g := g)
      (Li := Li)
      (μ := μ)
      (sampled_block := sampled_block)
      (x := x)
      (point := point)
      (t := t)
      (x0 := x0)
      (Ω := Ω)
      h_problem
      h_zero
      h_generated
      h_stepsize
      h_sampled_block_measurable
      h_sampled_block_indep
      h_sampled_block_uniform
      h_diameter_bound).2
      k
      hk

-- Proof sketch: on the finite nonempty half-tail interval, the infimum in clause `(2)` is a
-- minimum and therefore can be unpacked as an index attaining the same bound.
/-- Companion to clause (b): the half-tail minimum bound may be unpacked as an
index `n ∈ {⌊k / 2⌋ + 2, …, k}` whose expected conditional-gradient norm
satisfies the same estimate. -/
theorem exists_half_tail_rgbcg_expected_norm_le_sublinear_rate
    (h_problem : IsGeneralizedBlockConditionalGradientProblem f g Li)
    (h_zero : x 0 = fun _ ↦ x0)
    (h_generated :
      is_generated_by_randomized_generalized_block_conditional_gradient_method
        g
        (blockGradient f)
        x
        sampled_block
        point
        t)
    (h_stepsize :
      ∀ n : ℕ, (t n : ℝ) = (2 * Fintype.card ι : ℝ) / (n + 2 * Fintype.card ι : ℕ))
    (h_sampled_block_measurable : ∀ n, Measurable (sampled_block n))
    (h_sampled_block_indep : iIndepFun sampled_block μ)
    (h_sampled_block_uniform :
      ∀ n (i : ι), μ ((sampled_block n) ⁻¹' {i}) = 1 / (N : ℝ≥0∞))
    (h_diameter_bound :
      ∀ {u v : X},
        u ∈ effective_domain (PiLp.separableSum g) →
        v ∈ effective_domain (PiLp.separableSum g) →
        ‖u - v‖_[Li] ≤ Ω)
    {k : ℕ} (hk : 3 ≤ k) :
    ∃ n ∈ Set.Icc (k / 2 + 2) k,
      μ[fun ω ↦ (Sᵇ[g, blockGradient f](x n ω)).toReal] ≤
        ((8 : ℝ) * rateBound) / ((k - 2 : ℕ) : ℝ) := by
  let s :
      Set ℝ :=
    ((fun n ↦ μ[fun ω ↦ (Sᵇ[g, blockGradient f](x n ω)).toReal]) ''
      Set.Icc (k / 2 + 2) k)
  have hleft : k / 2 + 2 ≤ k := by
    omega
  have hs_nonempty : s.Nonempty := by
    refine ⟨μ[fun ω ↦ (Sᵇ[g, blockGradient f](x (k / 2 + 2) ω)).toReal], ?_⟩
    exact ⟨k / 2 + 2, ⟨by rfl, hleft⟩, rfl⟩
  have hs_finite : s.Finite := by
    exact (Set.finite_Icc (k / 2 + 2) k).image
      (fun n ↦ μ[fun ω ↦ (Sᵇ[g, blockGradient f](x n ω)).toReal])
  have hs_mem : sInf s ∈ s :=
    hs_nonempty.csInf_mem hs_finite
  rcases hs_mem with ⟨n, hn, hsInf_eq⟩
  refine ⟨n, hn, ?_⟩
  -- The infimum belongs to the finite half-tail image, so the companion `sInf` bound closes the
  -- selected index estimate immediately.
  rw [← hsInf_eq]
  exact
    randomized_generalized_block_conditional_gradient_half_tail_expected_norm_sInf_le_sublinear_rate
      (f := f)
      (g := g)
      (Li := Li)
      (μ := μ)
      (sampled_block := sampled_block)
      (x := x)
      (point := point)
      (t := t)
      (x0 := x0)
      (Ω := Ω)
      h_problem
      h_zero
      h_generated
      h_stepsize
      h_sampled_block_measurable
      h_sampled_block_indep
      h_sampled_block_uniform
      h_diameter_bound
      hk

end

end

