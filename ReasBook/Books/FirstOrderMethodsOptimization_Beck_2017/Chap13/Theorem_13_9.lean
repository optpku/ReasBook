variable {E : Type u} [NormedAddCommGroup E] [InnerProductSpace ℝ E]

/- `prompt_add/` is absent in this workspace, so the statement design is checked against the
existing Chapter 3 and Chapter 13 owners.

This item is `source-facing`: it states the nonconvex convergence properties of a generalized
conditional-gradient trajectory generated by Algorithm 13.2 under Assumption 13.1, when the
stepsizes are chosen either by the adaptive rule or by exact line search. The relevant canonical
owners already present in the project are:

- `IsGeneralizedConditionalGradientProblem` for Assumption 13.1 and the optimal value `F_opt`;
- `is_generalized_conditional_gradient_trajectory` for the generated iterates;
- `generalized_conditional_gradient_norm` for the chapter gap quantity `S(x^k)`;
- `uses_generalized_conditional_gradient_adaptive_or_exact_stepsize_rule` from Definition 13.6
  for the admissible stepsize choice;
- `best_achieved_function_value` from Definition 8.8 for the running minimum in clause `(c)`;
- `is_stationary_point` for the Chapter 3 stationarity condition;
- `MapClusterPt _ Filter.atTop _` for sequential limit points.

Accordingly, this file states clauses `(a)` through `(d)` directly on those owners, with no
parallel local running-min or objective-gap wrapper. -/

section

variable [CompleteSpace E]
variable {f : E → ℝ} {g : E → EReal} {Lf : NNReal}
variable [hproblem : IsGeneralizedConditionalGradientProblem f.toEReal g Lf]
variable {x p : ℕ → E} {t : ℕ → Set.Icc (0 : ℝ) 1}
variable (htraj : is_generalized_conditional_gradient_trajectory f g x p t)
variable
  (hrule : uses_generalized_conditional_gradient_adaptive_or_exact_stepsize_rule
    f g Lf x p t)

local notation "F" => composite_model_objective f.toEReal g
local notation "F_opt" => generalized_conditional_gradient_optimal_value f.toEReal g

/-- Helper for Theorem 13.9: the smoothness field from Assumption 13.1 restricts from
`effective_domain f.toEReal` to the smaller feasible core `effective_domain g`. -/
lemma generalized_conditional_gradient_smooth_on_g_effective_domain_of_problem :
    is_l_smooth_on f (effective_domain g) Lf := by
  -- Rewrite both smoothness predicates into differentiability plus gradient Lipschitz control,
  -- then restrict the original assumptions along the domain inclusion `dom(g) ⊆ dom(f)`.
  have hsm := hproblem.f_toReal_smooth_on_effective_domain
  rw [is_l_smooth_on_iff_forall_norm_sub_le] at hsm ⊢
  constructor
  · intro y hy
    exact hsm.1 y
      (hproblem.g_effective_domain_subset_f_effective_domain hy)
  · intro y hy z hz
    exact hsm.2 y
      (hproblem.g_effective_domain_subset_f_effective_domain hy) z
      (hproblem.g_effective_domain_subset_f_effective_domain hz)

/-- Helper for Theorem 13.9: every optimal point attains the canonical optimal value `F_opt`. -/
lemma generalized_conditional_gradient_optimal_value_eq_of_mem_optimal_set
    {xStar : E} (hxStar : xStar ∈ unconstrained_problem_solutions F) :
    F_opt = F xStar := by
  -- Rewrite optimizer membership as global minimality and identify `F_opt` with the resulting
  -- attained infimum.
  have hxmin : IsMinOn F Set.univ xStar := by
    simpa using hxStar
  have hglb : IsGLB (Set.range F) (F xStar) := by
    simpa using hxmin.isGLB (by simp : xStar ∈ (Set.univ : Set E))
  rw [generalized_conditional_gradient_optimal_value_eq_sInf]
  exact hglb.csInf_eq ⟨F xStar, ⟨xStar, rfl⟩⟩

/-- Helper for Theorem 13.9: every global minimizer of the composite objective is feasible for
the regularizer term `g`. -/
lemma generalized_conditional_gradient_optimal_point_mem_effective_domain
    (hproblem : IsGeneralizedConditionalGradientProblem f.toEReal g Lf)
    {xStar : E} (hxStar : xStar ∈ unconstrained_problem_solutions F) :
    xStar ∈ effective_domain g := by
  -- Compare the optimizer with one known feasible point; the minimizing value cannot be `⊤`, so
  -- the regularizer value at the minimizer must also be finite.
  obtain ⟨y, hy⟩ := hproblem.toIsProperExtendedRealFunction.effective_domain_nonempty
  have hxStar_min :
      IsMinOn F Set.univ xStar := by
    simpa using hxStar
  have hle : F xStar ≤ F y := by
    exact (isMinOn_univ_iff.mp hxStar_min) y
  have hFy_ne_top : F y ≠ ⊤ := by
    rw [composite_model_objective_eq_coe_toReal_of_mem_effective_domain hproblem.ne_bot hy]
    exact EReal.coe_ne_top _
  have hFxStar_ne_top : F xStar ≠ ⊤ := by
    exact ne_of_lt (lt_of_le_of_lt hle (lt_top_iff_ne_top.mpr hFy_ne_top))
  have hgxStar_ne_top : g xStar ≠ ⊤ := by
    intro hgxStar_top
    have hFxStar_top : F xStar = ⊤ := by
      simp [composite_model_objective_apply, hgxStar_top]
    exact hFxStar_ne_top hFxStar_top
  exact mem_effective_domain.mpr (lt_top_iff_ne_top.mpr hgxStar_ne_top)

/-- Helper for Theorem 13.9: compactness of `effective_domain g` yields a strictly positive
uniform diameter bound. -/
lemma effective_domain_pairwise_dist_le_of_compact :
    (hproblem : IsGeneralizedConditionalGradientProblem f.toEReal g Lf) →
    ∃ Ω : ℝ, 0 < Ω ∧
      ∀ u ∈ effective_domain g, ∀ v ∈ effective_domain g, ‖u - v‖ ≤ Ω := by
  intro hproblem
  -- First bound the feasible set in norm, then convert that radius bound into a diameter bound by
  -- the triangle inequality.
  have hbounded := hproblem.g_effective_domain_compact.isBounded
  obtain ⟨R, hR_pos, hRball⟩ := hbounded.subset_closedBall_lt 0 (0 : E)
  refine ⟨max 1 (2 * R), lt_of_lt_of_le zero_lt_one (le_max_left _ _), ?_⟩
  intro u hu v hv
  have hu_ball : u ∈ Metric.closedBall (0 : E) R := hRball hu
  have hv_ball : v ∈ Metric.closedBall (0 : E) R := hRball hv
  have hu_norm : ‖u‖ ≤ R := by
    simpa [Metric.mem_closedBall, dist_eq_norm] using hu_ball
  have hv_norm : ‖v‖ ≤ R := by
    simpa [Metric.mem_closedBall, dist_eq_norm] using hv_ball
  calc
    ‖u - v‖ ≤ ‖u‖ + ‖v‖ := norm_sub_le u v
    _ ≤ R + R := add_le_add hu_norm hv_norm
    _ = 2 * R := by ring
    _ ≤ max 1 (2 * R) := le_max_right _ _

/-- Helper for Theorem 13.9: the one-step sufficient-decrease inequality from Lemma 13.8 can be
read in `ℝ` once the objective values are known to be finite at consecutive iterates. -/
lemma generalized_conditional_gradient_one_step_decrease_toReal
    (htraj : is_generalized_conditional_gradient_trajectory f g x p t)
    (hrule : uses_generalized_conditional_gradient_adaptive_or_exact_stepsize_rule
      f g Lf x p t)
    {Ω : ℝ}
    (hΩ : ∀ u ∈ effective_domain g, ∀ v ∈ effective_domain g, ‖u - v‖ ≤ Ω)
    (k : ℕ) :
    (1 / 2 : ℝ) *
        min ((S[f, g](x k)).toReal)
          ((S[f, g](x k)).toReal ^ (2 : ℕ) / ((Lf : ℝ) * Ω ^ (2 : ℕ))) ≤
      (F (x k)).toReal - (F (x (k + 1))).toReal := by
  -- Apply the `EReal` sufficient-decrease theorem, then convert the finite objective values at the
  -- two feasible iterates to real subtraction.
  have hsmooth : is_l_smooth_on f (effective_domain g) Lf :=
    generalized_conditional_gradient_smooth_on_g_effective_domain_of_problem
  have hdec :
      F (x k) - F (x (k + 1)) ≥
        ((1 / 2 : ℝ) *
            min ((S[f, g](x k)).toReal)
              ((S[f, g](x k)).toReal ^ (2 : ℕ) / ((Lf : ℝ) * Ω ^ (2 : ℕ))) : EReal) :=
    generalized_conditional_gradient_sufficient_decrease_of_adaptive_or_exact_line_search
      hproblem.ne_bot hproblem.g_convex hsmooth htraj hrule hΩ k
  have hxk :
      x k ∈ effective_domain g :=
    generalized_conditional_gradient_trajectory_mem_effective_domain
      hproblem.ne_bot hproblem.g_convex htraj k
  have hxk1 :
      x (k + 1) ∈ effective_domain g :=
    generalized_conditional_gradient_trajectory_mem_effective_domain
      hproblem.ne_bot hproblem.g_convex htraj (k + 1)
  have hFxk :
      F (x k) = (((F (x k)).toReal : ℝ) : EReal) :=
    composite_model_objective_eq_coe_toReal_of_mem_effective_domain
      hproblem.ne_bot hxk
  have hFxk1 :
      F (x (k + 1)) = (((F (x (k + 1))).toReal : ℝ) : EReal) :=
    composite_model_objective_eq_coe_toReal_of_mem_effective_domain
      hproblem.ne_bot hxk1
  have hdec_real :
      (((F (x k)).toReal - (F (x (k + 1))).toReal : ℝ) : EReal) ≥
        ((1 / 2 : ℝ) *
            min ((S[f, g](x k)).toReal)
              ((S[f, g](x k)).toReal ^ (2 : ℕ) / ((Lf : ℝ) * Ω ^ (2 : ℕ))) : EReal) := by
    calc
      (((F (x k)).toReal - (F (x (k + 1))).toReal : ℝ) : EReal) =
          F (x k) - F (x (k + 1)) := by
            rw [hFxk, hFxk1]
            simpa using
              (EReal.coe_sub (F (x k)).toReal (F (x (k + 1))).toReal).symm
      _ ≥
          ((1 / 2 : ℝ) *
              min ((S[f, g](x k)).toReal)
                ((S[f, g](x k)).toReal ^ (2 : ℕ) / ((Lf : ℝ) * Ω ^ (2 : ℕ))) : EReal) :=
        hdec
  exact_mod_cast hdec_real

/-- Helper for Theorem 13.9: telescoping the one-step sufficient-decrease inequalities bounds the
prefix decrease sum by the objective drop from `x⁰` to `x^(k+1)`. -/
lemma generalized_conditional_gradient_prefix_min_decrease_sum_le_initial_objective_drop
    (htraj : is_generalized_conditional_gradient_trajectory f g x p t)
    (hrule : uses_generalized_conditional_gradient_adaptive_or_exact_stepsize_rule
      f g Lf x p t)
    {Ω : ℝ}
    (hΩpos : 0 < Ω)
    (hΩ : ∀ u ∈ effective_domain g, ∀ v ∈ effective_domain g, ‖u - v‖ ≤ Ω)
    (k : ℕ) :
    ((1 / 2 : ℝ) *
        Finset.sum (Finset.range (k + 1)) (fun n ↦
          min ((S[f, g](x n)).toReal)
            ((S[f, g](x n)).toReal ^ (2 : ℕ) / ((Lf : ℝ) * Ω ^ (2 : ℕ))))) ≤
      (F (x 0)).toReal - (F (x (k + 1))).toReal := by
  -- Sum the real one-step decrease estimates and collapse the resulting telescoping objective
  -- differences.
  induction' k with k hk
  · -- The base prefix has exactly one decrease term, so this is the one-step estimate at `0`.
    simpa using generalized_conditional_gradient_one_step_decrease_toReal
      htraj hrule hΩ 0
  · -- Append the next one-step estimate and simplify the objective differences by telescoping.
    have hkStep :
        (1 / 2 : ℝ) *
            min ((S[f, g](x (k + 1))).toReal)
              ((S[f, g](x (k + 1))).toReal ^ (2 : ℕ) / ((Lf : ℝ) * Ω ^ (2 : ℕ))) ≤
          (F (x (k + 1))).toReal - (F (x (k + 2))).toReal := by
      simpa using generalized_conditional_gradient_one_step_decrease_toReal
        htraj hrule hΩ (k + 1)
    have hsum :
        ((1 / 2 : ℝ) *
            Finset.sum (Finset.range (k + 1)) (fun n ↦
              min ((S[f, g](x n)).toReal)
                ((S[f, g](x n)).toReal ^ (2 : ℕ) / ((Lf : ℝ) * Ω ^ (2 : ℕ))))) +
            ((1 / 2 : ℝ) *
              min ((S[f, g](x (k + 1))).toReal)
                ((S[f, g](x (k + 1))).toReal ^ (2 : ℕ) / ((Lf : ℝ) * Ω ^ (2 : ℕ)))) ≤
          ((F (x 0)).toReal - (F (x (k + 1))).toReal) +
            ((F (x (k + 1))).toReal - (F (x (k + 2))).toReal) :=
      add_le_add hk hkStep
    calc
      (1 / 2 : ℝ) *
          Finset.sum (Finset.range (k + 2)) (fun n ↦
            min ((S[f, g](x n)).toReal)
              ((S[f, g](x n)).toReal ^ (2 : ℕ) / ((Lf : ℝ) * Ω ^ (2 : ℕ)))) =
          ((1 / 2 : ℝ) *
              Finset.sum (Finset.range (k + 1)) (fun n ↦
                min ((S[f, g](x n)).toReal)
                  ((S[f, g](x n)).toReal ^ (2 : ℕ) / ((Lf : ℝ) * Ω ^ (2 : ℕ))))) +
            ((1 / 2 : ℝ) *
              min ((S[f, g](x (k + 1))).toReal)
                ((S[f, g](x (k + 1))).toReal ^ (2 : ℕ) / ((Lf : ℝ) * Ω ^ (2 : ℕ)))) := by
            rw [Finset.sum_range_succ, left_distrib]
      _ ≤
          ((F (x 0)).toReal - (F (x (k + 1))).toReal) +
            ((F (x (k + 1))).toReal - (F (x (k + 2))).toReal) :=
        hsum
      _ = (F (x 0)).toReal - (F (x (k + 2))).toReal := by ring

/-- Helper for Theorem 13.9: if `min{s, s² / C}` is at most `B`, then `s` is controlled by the
larger of the linear and square-root scales determined by `B` and `C`. -/
lemma gap_le_max_of_min_gap_le
    {s C B : ℝ}
    (hs : 0 ≤ s)
    (hC : 0 < C)
    (hmin : min s (s ^ (2 : ℕ) / C) ≤ B) :
    s ≤ max B (Real.sqrt (C * B)) := by
  -- Split into the branch where the linear term already controls `s`, and the complementary
  -- branch where the quadratic term does.
  by_cases hsB : s ≤ B
  · exact le_trans hsB (le_max_left _ _)
  · have hB_nonneg : 0 ≤ B := by
      have hmin_nonneg : 0 ≤ min s (s ^ (2 : ℕ) / C) := by
        refine le_min hs ?_
        exact div_nonneg (sq_nonneg s) hC.le
      exact le_trans hmin_nonneg hmin
    have hBs : B < s := lt_of_not_ge hsB
    have hquad_le : s ^ (2 : ℕ) / C ≤ B := by
      by_cases hsq_le_s : s ^ (2 : ℕ) / C ≤ s
      · simpa [min_eq_right hsq_le_s] using hmin
      · have hs_le_B : s ≤ B := by
          have hs_min : min s (s ^ (2 : ℕ) / C) = s := by
            exact min_eq_left (le_of_not_ge hsq_le_s)
          simpa [hs_min] using hmin
        exact False.elim ((not_le_of_gt hBs) hs_le_B)
    have hsq_le : s ^ (2 : ℕ) ≤ C * B := by
      have hsq_le' : s ^ (2 : ℕ) ≤ B * C := by
        exact (div_le_iff₀ hC).mp hquad_le
      simpa [mul_comm] using hsq_le'
    have hs_le_sqrt : s ≤ Real.sqrt (C * B) := by
      have hsqrt_sq : (Real.sqrt (C * B)) ^ (2 : ℕ) = C * B := by
        simpa using Real.sq_sqrt (mul_nonneg hC.le hB_nonneg)
      nlinarith [hs, Real.sqrt_nonneg (C * B), hsqrt_sq, hsq_le]
    exact le_trans hs_le_sqrt (le_max_right _ _)

/-- Helper for Theorem 13.9: a bounded-below antitone real sequence has successive differences
converging to `0`. -/
lemma objective_difference_tendsto_zero_of_antitone_bddBelow
    {a : ℕ → ℝ}
    (hanti : Antitone a)
    (hbelow : BddBelow (Set.range a)) :
    Filter.Tendsto (fun k ↦ a k - a (k + 1)) Filter.atTop (nhds 0) := by
  let ℓ : ℝ := ⨅ k, a k
  have hlim :
      Filter.Tendsto (fun k ↦ a k) Filter.atTop (nhds ℓ) :=
    tendsto_atTop_ciInf hanti hbelow
  have hshift :
      Filter.Tendsto (fun k ↦ a (k + 1)) Filter.atTop (nhds ℓ) := by
    have hsucc :
        Filter.Tendsto (fun k : ℕ ↦ k + 1) Filter.atTop Filter.atTop :=
      (show StrictMono (fun k : ℕ ↦ k + 1) from
        fun m n hmn ↦ Nat.add_lt_add_right hmn 1).tendsto_atTop
    simpa [ℓ] using hlim.comp hsucc
  -- Subtract the shifted copy of the convergent monotone sequence.
  simpa [ℓ] using hlim.sub hshift

/-- Helper for Theorem 13.9: the real objective values along every generalized
conditional-gradient trajectory are bounded below by the value at a global minimizer. -/
lemma generalized_conditional_gradient_objective_toReal_bddBelow
    [hproblem : IsGeneralizedConditionalGradientProblem f.toEReal g Lf]
    (htraj : is_generalized_conditional_gradient_trajectory f g x p t) :
    BddBelow (Set.range fun k ↦ (F (x k)).toReal) := by
  -- Choose a global minimizer from Text 13.1, then compare its objective value to every iterate.
  obtain ⟨xStar, hxStar⟩ := generalized_conditional_gradient_optimal_set_nonempty hproblem
  have hxStar_g :
      xStar ∈ effective_domain g :=
    generalized_conditional_gradient_optimal_point_mem_effective_domain hproblem hxStar
  have hFxStar_ne_bot : F xStar ≠ ⊥ := by
    rw [composite_model_objective_eq_coe_toReal_of_mem_effective_domain hproblem.ne_bot hxStar_g]
    exact EReal.coe_ne_bot _
  refine ⟨(F xStar).toReal, ?_⟩
  intro y hy
  rcases hy with ⟨k, rfl⟩
  have hxk :
      x k ∈ effective_domain g :=
    generalized_conditional_gradient_trajectory_mem_effective_domain
      hproblem.ne_bot hproblem.g_convex htraj k
  have hFxk_ne_top : F (x k) ≠ ⊤ := by
    rw [composite_model_objective_eq_coe_toReal_of_mem_effective_domain hproblem.ne_bot hxk]
    exact EReal.coe_ne_top _
  have hle :
      F xStar ≤ F (x k) := by
    exact (mem_unconstrained_problem_solutions_iff_forall_le.mp hxStar) (x k)
  -- Once both sides are finite, the optimizer inequality becomes an ordinary real inequality.
  exact EReal.toReal_le_toReal hle hFxStar_ne_bot hFxk_ne_top

/-- Helper for Theorem 13.9: a nonpositive diameter bound forces every generalized
conditional-gradient gap to vanish, because each search point must coincide with the current
iterate. -/
lemma generalized_conditional_gradient_gap_eq_zero_of_nonpos_diameter_bound
    [hproblem : IsGeneralizedConditionalGradientProblem f.toEReal g Lf]
    (htraj : is_generalized_conditional_gradient_trajectory f g x p t)
    {Ω : ℝ}
    (hΩnonpos : Ω ≤ 0)
    (hΩ : ∀ u ∈ effective_domain g, ∀ v ∈ effective_domain g, ‖u - v‖ ≤ Ω)
    (k : ℕ) :
    (S[f, g](x k)).toReal = 0 := by
  -- Apply the diameter bound to `xᵏ` and the chosen subproblem minimizer `pᵏ`, forcing
  -- `‖xᵏ - pᵏ‖ = 0` and hence `xᵏ = pᵏ`; the gap objective at that point is then exactly `0`.
  have hxk :
      x k ∈ effective_domain g :=
    generalized_conditional_gradient_trajectory_mem_effective_domain
      hproblem.ne_bot hproblem.g_convex htraj k
  have hpk :
      p k ∈ effective_domain g :=
    generalized_conditional_gradient_argmin_mem_effective_domain
      hxk (htraj.argmin_mem k)
  have hdist_le_zero : ‖x k - p k‖ ≤ 0 := by
    exact le_trans (hΩ (x k) hxk (p k) hpk) hΩnonpos
  have hdist_zero : ‖x k - p k‖ = 0 := by
    exact le_antisymm hdist_le_zero (norm_nonneg _)
  have hxp : p k = x k := by
    have hdist_zero' : ‖p k - x k‖ = 0 := by
      simpa [norm_sub_rev] using hdist_zero
    exact sub_eq_zero.mp (norm_eq_zero.mp hdist_zero')
  have hS_eq :
      S[f, g](x k) = generalized_conditional_gradient_gap_objective f g (x k) (p k) :=
    generalized_conditional_gradient_norm_eq_of_mem_argmin (htraj.argmin_mem k)
  rw [hS_eq, generalized_conditional_gradient_gap_objective_apply, hxp]
  have hgx_ne_top : g (x k) ≠ ⊤ := (mem_effective_domain.mp hxk).ne
  have hgx_ne_bot : g (x k) ≠ ⊥ := hproblem.ne_bot (x k)
  simpa [EReal.toReal_sub hgx_ne_top hgx_ne_bot hgx_ne_top hgx_ne_bot]

-- Proof sketch: apply the adaptive/exact sufficient-decrease inequality from Lemma 13.8 at the
-- current iterate. Its right-hand side is a nonnegative `EReal` quantity, so dropping it yields
-- `F(x^(k+1)) ≤ F(x^k)`.
/-- Theorem 13.9 (1): clause (a). Under Assumption 13.1, every step of the generalized
conditional-gradient method with adaptive stepsize or exact line search is objective
nonincreasing: `F(x^(k+1)) ≤ F(x^k)` for all `k ≥ 0`. -/
theorem generalized_conditional_gradient_objective_step_nonincreasing
    [hproblem : IsGeneralizedConditionalGradientProblem f.toEReal g Lf]
    (htraj : is_generalized_conditional_gradient_trajectory f g x p t)
    (hrule : uses_generalized_conditional_gradient_adaptive_or_exact_stepsize_rule
      f g Lf x p t)
    (k : ℕ) :
    F (x (k + 1)) ≤ F (x k) := by
  -- Insert the compactness-derived diameter bound into Lemma 13.8 and drop the nonnegative
  -- decrease term.
  -- Route correction: the problem instance is already in scope, so the source proof runs directly
  -- through the one-step decrease estimate and finiteness of consecutive objective values.
  have hdiam :=
    @effective_domain_pairwise_dist_le_of_compact E _ _ _ f g Lf
  obtain ⟨Ω, hΩpos, hΩ⟩ := hdiam hproblem
  have hxk :
      x k ∈ effective_domain g :=
    generalized_conditional_gradient_trajectory_mem_effective_domain
      hproblem.ne_bot hproblem.g_convex htraj k
  have hxk1 :
      x (k + 1) ∈ effective_domain g :=
    generalized_conditional_gradient_trajectory_mem_effective_domain
      hproblem.ne_bot hproblem.g_convex htraj (k + 1)
  have hS_nonneg :
      0 ≤ (S[f, g](x k)).toReal :=
    generalized_conditional_gradient_norm_toReal_nonneg_of_mem_argmin
      hproblem.ne_bot hxk (htraj.argmin_mem k)
  have hterm_nonneg :
      0 ≤
        (1 / 2 : ℝ) *
          min ((S[f, g](x k)).toReal)
            ((S[f, g](x k)).toReal ^ (2 : ℕ) / ((Lf : ℝ) * Ω ^ (2 : ℕ))) := by
    have hquad_nonneg :
        0 ≤
          (S[f, g](x k)).toReal ^ (2 : ℕ) / ((Lf : ℝ) * Ω ^ (2 : ℕ)) := by
      exact div_nonneg (sq_nonneg ((S[f, g](x k)).toReal))
        (mul_nonneg hproblem.Lf_pos.le (sq_nonneg Ω))
    positivity
  have hdec :
      (1 / 2 : ℝ) *
          min ((S[f, g](x k)).toReal)
            ((S[f, g](x k)).toReal ^ (2 : ℕ) / ((Lf : ℝ) * Ω ^ (2 : ℕ))) ≤
        (F (x k)).toReal - (F (x (k + 1))).toReal := by
    exact generalized_conditional_gradient_one_step_decrease_toReal
      htraj hrule hΩ k
  have hreal :
      (F (x (k + 1))).toReal ≤ (F (x k)).toReal := by
    linarith
  rw [composite_model_objective_eq_coe_toReal_of_mem_effective_domain hproblem.ne_bot hxk1,
    composite_model_objective_eq_coe_toReal_of_mem_effective_domain hproblem.ne_bot hxk]
  exact_mod_cast hreal

-- Proof sketch: the one-step sufficient-decrease estimate yields a nonnegative lower bound on
-- `F(x^k) - F(x^(k+1))` in terms of
-- `min {S(x^k), S(x^k)^2 / (L_f Ω^2)}` for a diameter bound `Ω` on `dom(g)`. Since clause `(1)`
-- makes `F(x^k)` monotone and bounded below by `F_opt`, successive differences tend to `0`, so the
-- minimum term tends to `0`, which forces `S(x^k) → 0`.
/-- Theorem 13.9 (3): clause (b). Under Assumption 13.1, the generalized conditional-gradient gap
sequence `S(x^k)` converges to `0` along any trajectory generated with adaptive stepsize or exact
line search. -/
theorem generalized_conditional_gradient_gap_tendsto_zero
    [hproblem : IsGeneralizedConditionalGradientProblem f.toEReal g Lf]
    (htraj : is_generalized_conditional_gradient_trajectory f g x p t)
    (hrule : uses_generalized_conditional_gradient_adaptive_or_exact_stepsize_rule
      f g Lf x p t) :
    Filter.Tendsto
      (fun k ↦ (S[f, g](x k)).toReal) Filter.atTop (nhds 0) := by
  -- Use a strictly positive compactness-derived diameter bound to normalize the sufficient
  -- decrease term, then squeeze it to zero through convergence of the objective values.
  -- Route correction: the source proof first drives the successive objective differences to zero,
  -- then inverts the scalar bound `min {Sₖ, Sₖ² / (L_f Ω²)}` pointwise.
  obtain ⟨Ω, hΩpos, hΩ⟩ :=
    effective_domain_pairwise_dist_le_of_compact hproblem
  let a : ℕ → ℝ := fun k ↦ (F (x k)).toReal
  have hanti : Antitone a := by
    refine antitone_nat_of_succ_le ?_
    intro k
    have hstep :=
      generalized_conditional_gradient_objective_step_nonincreasing
        htraj hrule k
    have hxk :
        x k ∈ effective_domain g :=
      generalized_conditional_gradient_trajectory_mem_effective_domain
        hproblem.ne_bot hproblem.g_convex htraj k
    have hxk1 :
        x (k + 1) ∈ effective_domain g :=
      generalized_conditional_gradient_trajectory_mem_effective_domain
        hproblem.ne_bot hproblem.g_convex htraj (k + 1)
    rw [composite_model_objective_eq_coe_toReal_of_mem_effective_domain hproblem.ne_bot hxk1,
      composite_model_objective_eq_coe_toReal_of_mem_effective_domain hproblem.ne_bot hxk] at hstep
    exact_mod_cast hstep
  have hbelow :
      BddBelow (Set.range a) :=
    @generalized_conditional_gradient_objective_toReal_bddBelow
      E _ _ _ f g Lf hproblem x p t hproblem htraj
  have hdiff :
      Filter.Tendsto (fun k ↦ a k - a (k + 1)) Filter.atTop (nhds 0) :=
    objective_difference_tendsto_zero_of_antitone_bddBelow hanti hbelow
  let C : ℝ := (Lf : ℝ) * Ω ^ (2 : ℕ)
  have hCpos : 0 < C := by
    dsimp [C]
    have hΩsq_pos : 0 < Ω ^ (2 : ℕ) := by positivity
    exact mul_pos hproblem.Lf_pos hΩsq_pos
  let B : ℕ → ℝ := fun k ↦ (2 : ℝ) * (a k - a (k + 1))
  have hB_tendsto :
      Filter.Tendsto B Filter.atTop (nhds 0) := by
    simpa [B] using tendsto_const_nhds.mul hdiff
  have hCB_tendsto :
      Filter.Tendsto (fun k ↦ C * B k) Filter.atTop (nhds 0) := by
    simpa [C] using tendsto_const_nhds.mul hB_tendsto
  have hsqrt_tendsto :
      Filter.Tendsto (fun k ↦ Real.sqrt (C * B k)) Filter.atTop (nhds 0) := by
    simpa using hCB_tendsto.sqrt
  have hupper_tendsto :
      Filter.Tendsto
        (fun k ↦ max (B k) (Real.sqrt (C * B k))) Filter.atTop (nhds 0) :=
    by simpa using hB_tendsto.max hsqrt_tendsto
  have hnonneg :
      ∀ k, 0 ≤ (S[f, g](x k)).toReal := by
    intro k
    have hxk :
        x k ∈ effective_domain g :=
      generalized_conditional_gradient_trajectory_mem_effective_domain
        hproblem.ne_bot hproblem.g_convex htraj k
    exact generalized_conditional_gradient_norm_toReal_nonneg_of_mem_argmin
      hproblem.ne_bot hxk (htraj.argmin_mem k)
  have hupper :
      ∀ k, (S[f, g](x k)).toReal ≤ max (B k) (Real.sqrt (C * B k)) := by
    intro k
    let s : ℝ := (S[f, g](x k)).toReal
    have hs_nonneg : 0 ≤ s := hnonneg k
    have hdec :
        (1 / 2 : ℝ) * min s (s ^ (2 : ℕ) / C) ≤ a k - a (k + 1) := by
      simpa [a, C, s] using
        generalized_conditional_gradient_one_step_decrease_toReal htraj hrule hΩ k
    have hmin :
        min s (s ^ (2 : ℕ) / C) ≤ B k := by
      dsimp [B]
      nlinarith
    simpa [B, C, s] using gap_le_max_of_min_gap_le hs_nonneg hCpos hmin
  exact squeeze_zero hnonneg hupper hupper_tendsto

-- Proof sketch: sum the sufficient-decrease inequality from Lemma 13.8 over `n = 0, ..., k`,
-- telescope the objective values, bound the sum below by `(k + 1)` times the running minimum of
-- the decrease term, and then solve the scalar inequality
-- `min {s, s^2 / (L_f Ω^2)} ≤ 2 (F(x^0) - F_opt) / (k + 1)` for `s`.
/-- Theorem 13.9 (4): clause (c). If `Ω` bounds the diameter of `dom(g)`, then for every
`k ≥ 0` the running minimum of the generalized conditional-gradient gaps on `0, 1, ..., k`
satisfies the complexity estimate
`min_{0 ≤ n ≤ k} S(x^n) ≤ max {2 (F(x^0) - F_opt) / (k + 1),
sqrt (2 L_f Ω^2 (F(x^0) - F_opt)) / sqrt (k + 1)}`. -/
theorem generalized_conditional_gradient_best_gap_up_to_le_complexity_bound
    [hproblem : IsGeneralizedConditionalGradientProblem f.toEReal g Lf]
    (htraj : is_generalized_conditional_gradient_trajectory f g x p t)
    (hrule : uses_generalized_conditional_gradient_adaptive_or_exact_stepsize_rule
      f g Lf x p t)
    {Ω : ℝ}
    (hΩ : ∀ u ∈ effective_domain g, ∀ v ∈ effective_domain g, ‖u - v‖ ≤ Ω)
    (k : ℕ) :
    best_achieved_function_value (fun y ↦ (S[f, g](y)).toReal) x k ≤
      max
        ((2 : ℝ) * (F (x 0) - F_opt).toReal / (k + 1 : ℝ))
        (Real.sqrt
            ((2 : ℝ) * (Lf : ℝ) * Ω ^ (2 : ℕ) * (F (x 0) - F_opt).toReal) /
          Real.sqrt (k + 1)) := by
  -- Split off the degenerate zero-diameter case. Otherwise, the prefix telescoping estimate and
  -- the scalar inversion lemma give the desired running-best bound.
  by_cases hΩpos : 0 < Ω
  · -- Follow the source finite-prefix proof: telescope the sufficient decrease sum and compare it
    -- to `(k + 1)` copies of the best attained gap.
    let best : ℝ := best_achieved_function_value (fun y ↦ (S[f, g](y)).toReal) x k
    let C : ℝ := (Lf : ℝ) * Ω ^ (2 : ℕ)
    have hCpos : 0 < C := by
      dsimp [C]
      have hΩsq_pos : 0 < Ω ^ (2 : ℕ) := by positivity
      exact mul_pos hproblem.Lf_pos hΩsq_pos
    have hx0 :
        x 0 ∈ effective_domain g :=
      generalized_conditional_gradient_trajectory_mem_effective_domain
        hproblem.ne_bot hproblem.g_convex htraj 0
    have hxk1 :
        x (k + 1) ∈ effective_domain g :=
      generalized_conditional_gradient_trajectory_mem_effective_domain
        hproblem.ne_bot hproblem.g_convex htraj (k + 1)
    obtain ⟨xStar, hxStar⟩ := generalized_conditional_gradient_optimal_set_nonempty hproblem
    have hxStar_g :
        xStar ∈ effective_domain g :=
      generalized_conditional_gradient_optimal_point_mem_effective_domain hproblem hxStar
    have hopt_eq :
        F_opt = F xStar :=
      generalized_conditional_gradient_optimal_value_eq_of_mem_optimal_set hxStar
    have hFx0_ne_top : F (x 0) ≠ ⊤ := by
      rw [composite_model_objective_eq_coe_toReal_of_mem_effective_domain hproblem.ne_bot hx0]
      exact EReal.coe_ne_top _
    have hFx0_ne_bot : F (x 0) ≠ ⊥ := by
      rw [composite_model_objective_eq_coe_toReal_of_mem_effective_domain hproblem.ne_bot hx0]
      exact EReal.coe_ne_bot _
    have hFxk1_ne_top : F (x (k + 1)) ≠ ⊤ := by
      rw [composite_model_objective_eq_coe_toReal_of_mem_effective_domain hproblem.ne_bot hxk1]
      exact EReal.coe_ne_top _
    have hFxStar_ne_top : F xStar ≠ ⊤ := by
      rw [composite_model_objective_eq_coe_toReal_of_mem_effective_domain hproblem.ne_bot hxStar_g]
      exact EReal.coe_ne_top _
    have hFxStar_ne_bot : F xStar ≠ ⊥ := by
      rw [composite_model_objective_eq_coe_toReal_of_mem_effective_domain hproblem.ne_bot hxStar_g]
      exact EReal.coe_ne_bot _
    have hopt_le_k1 :
        F xStar ≤ F (x (k + 1)) := by
      exact (mem_unconstrained_problem_solutions_iff_forall_le.mp hxStar) (x (k + 1))
    have hopt_le_0 :
        F xStar ≤ F (x 0) := by
      exact (mem_unconstrained_problem_solutions_iff_forall_le.mp hxStar) (x 0)
    have hreal_le_k1 :
        (F xStar).toReal ≤ (F (x (k + 1))).toReal :=
      EReal.toReal_le_toReal hopt_le_k1 hFxStar_ne_bot hFxk1_ne_top
    have hreal_le_0 :
        (F xStar).toReal ≤ (F (x 0)).toReal :=
      EReal.toReal_le_toReal hopt_le_0 hFxStar_ne_bot hFx0_ne_top
    have hgap0_eq :
        (F (x 0) - F_opt).toReal = (F (x 0)).toReal - (F xStar).toReal := by
      rw [hopt_eq]
      exact EReal.toReal_sub hFx0_ne_top hFx0_ne_bot hFxStar_ne_top hFxStar_ne_bot
    have hgap0_nonneg :
        0 ≤ (F (x 0) - F_opt).toReal := by
      rw [hgap0_eq]
      exact sub_nonneg.mpr hreal_le_0
    have hdrop_le_gap0 :
        (F (x 0)).toReal - (F (x (k + 1))).toReal ≤ (F (x 0) - F_opt).toReal := by
      have hdrop_le_star :
          (F (x 0)).toReal - (F (x (k + 1))).toReal ≤
            (F (x 0)).toReal - (F xStar).toReal := by
        exact sub_le_sub_left hreal_le_k1 _
      calc
        (F (x 0)).toReal - (F (x (k + 1))).toReal ≤
            (F (x 0)).toReal - (F xStar).toReal :=
          hdrop_le_star
        _ = (F (x 0) - F_opt).toReal := by
          symm
          exact hgap0_eq
    have hsum :
        (1 / 2 : ℝ) *
            Finset.sum (Finset.range (k + 1)) (fun n ↦
              min ((S[f, g](x n)).toReal)
                ((S[f, g](x n)).toReal ^ (2 : ℕ) / C)) ≤
          (F (x 0)).toReal - (F (x (k + 1))).toReal := by
      simpa [C] using
        generalized_conditional_gradient_prefix_min_decrease_sum_le_initial_objective_drop
          htraj hrule hΩpos hΩ k
    have hbest_nonneg : 0 ≤ best := by
      have hbest_mem :
          best ∈ ((Finset.range (k + 1)).image fun n ↦ (S[f, g](x n)).toReal) := by
        dsimp [best]
        exact Finset.min'_mem _ _
      rcases Finset.mem_image.mp hbest_mem with ⟨n, hn, hbest_eq⟩
      have hnonneg_n :
          0 ≤ (S[f, g](x n)).toReal :=
        generalized_conditional_gradient_norm_toReal_nonneg_of_mem_argmin
          hproblem.ne_bot
          (generalized_conditional_gradient_trajectory_mem_effective_domain
            hproblem.ne_bot hproblem.g_convex htraj n)
          (htraj.argmin_mem n)
      simpa [← hbest_eq] using hnonneg_n
    have hpointwise :
        ∀ n ∈ Finset.range (k + 1),
          min best (best ^ (2 : ℕ) / C) ≤
            min ((S[f, g](x n)).toReal)
              ((S[f, g](x n)).toReal ^ (2 : ℕ) / C) := by
      intro n hn
      have hbest_le :
          best ≤ (S[f, g](x n)).toReal :=
        best_achieved_function_value_le_objective_value
          (fun y ↦ (S[f, g](y)).toReal) x k n hn
      have hxn :
          x n ∈ effective_domain g :=
        generalized_conditional_gradient_trajectory_mem_effective_domain
          hproblem.ne_bot hproblem.g_convex htraj n
      have hs_nonneg :
          0 ≤ (S[f, g](x n)).toReal :=
        generalized_conditional_gradient_norm_toReal_nonneg_of_mem_argmin
          hproblem.ne_bot hxn (htraj.argmin_mem n)
      have hsq_le :
          best ^ (2 : ℕ) ≤ (S[f, g](x n)).toReal ^ (2 : ℕ) := by
        nlinarith [hbest_nonneg, hs_nonneg, hbest_le]
      exact min_le_min hbest_le (div_le_div_of_nonneg_right hsq_le hCpos.le)
    have hsum_lower :
        (k + 1 : ℝ) * min best (best ^ (2 : ℕ) / C) ≤
          Finset.sum (Finset.range (k + 1)) (fun n ↦
            min ((S[f, g](x n)).toReal)
              ((S[f, g](x n)).toReal ^ (2 : ℕ) / C)) := by
      calc
        (k + 1 : ℝ) * min best (best ^ (2 : ℕ) / C) =
            Finset.sum (Finset.range (k + 1)) (fun _ ↦
              min best (best ^ (2 : ℕ) / C)) := by
              simp
        _ ≤ Finset.sum (Finset.range (k + 1)) (fun n ↦
              min ((S[f, g](x n)).toReal)
                ((S[f, g](x n)).toReal ^ (2 : ℕ) / C)) := by
              exact Finset.sum_le_sum (fun n hn ↦ hpointwise n hn)
    have hminbest :
        min best (best ^ (2 : ℕ) / C) ≤
          (2 : ℝ) * (F (x 0) - F_opt).toReal / (k + 1 : ℝ) := by
      have hmain :
          (k + 1 : ℝ) * min best (best ^ (2 : ℕ) / C) ≤
            (2 : ℝ) * (F (x 0) - F_opt).toReal := by
        have hsum_upper :
            Finset.sum (Finset.range (k + 1)) (fun n ↦
              min ((S[f, g](x n)).toReal)
                ((S[f, g](x n)).toReal ^ (2 : ℕ) / C)) ≤
              (2 : ℝ) * (F (x 0) - F_opt).toReal := by
          linarith [hsum, hdrop_le_gap0]
        exact le_trans hsum_lower hsum_upper
      have hk_pos : 0 < (k + 1 : ℝ) := by
        positivity
      exact (le_div_iff₀ hk_pos).2 (by simpa [mul_comm, mul_left_comm, mul_assoc] using hmain)
    have hbest_bound :
        best ≤
          max
            ((2 : ℝ) * (F (x 0) - F_opt).toReal / (k + 1 : ℝ))
            (Real.sqrt
                (C * ((2 : ℝ) * (F (x 0) - F_opt).toReal / (k + 1 : ℝ)))) := by
      exact gap_le_max_of_min_gap_le hbest_nonneg hCpos hminbest
    have hsqrt_eq :
        Real.sqrt (C * ((2 : ℝ) * (F (x 0) - F_opt).toReal / (k + 1 : ℝ))) =
          Real.sqrt
              ((2 : ℝ) * (Lf : ℝ) * Ω ^ (2 : ℕ) * (F (x 0) - F_opt).toReal) /
            Real.sqrt (k + 1) := by
      have hk_nonneg : 0 ≤ (k + 1 : ℝ) := by
        positivity
      have hnum_nonneg :
          0 ≤ (2 : ℝ) * (Lf : ℝ) * Ω ^ (2 : ℕ) * (F (x 0) - F_opt).toReal := by
        positivity
      rw [show C * ((2 : ℝ) * (F (x 0) - F_opt).toReal / (k + 1 : ℝ)) =
          ((2 : ℝ) * (Lf : ℝ) * Ω ^ (2 : ℕ) * (F (x 0) - F_opt).toReal) / (k + 1 : ℝ) by
            field_simp [C]
            ring]
      simpa using Real.sqrt_div hnum_nonneg (k + 1 : ℝ)
    calc
      best_achieved_function_value (fun y ↦ (S[f, g](y)).toReal) x k = best := rfl
      _ ≤
          max
            ((2 : ℝ) * (F (x 0) - F_opt).toReal / (k + 1 : ℝ))
            (Real.sqrt
                (C * ((2 : ℝ) * (F (x 0) - F_opt).toReal / (k + 1 : ℝ)))) :=
        hbest_bound
      _ =
          max
            ((2 : ℝ) * (F (x 0) - F_opt).toReal / (k + 1 : ℝ))
            (Real.sqrt
                ((2 : ℝ) * (Lf : ℝ) * Ω ^ (2 : ℕ) * (F (x 0) - F_opt).toReal) /
              Real.sqrt (k + 1)) := by
        rw [hsqrt_eq]
  · -- If the diameter bound is nonpositive, every gap on the prefix is already zero.
    have hΩnonpos : Ω ≤ 0 := le_of_not_gt hΩpos
    have hbest_zero :
        best_achieved_function_value (fun y ↦ (S[f, g](y)).toReal) x k = 0 := by
      have hS0_zero :
          (S[f, g](x 0)).toReal = 0 :=
        @generalized_conditional_gradient_gap_eq_zero_of_nonpos_diameter_bound
          E _ _ _ f g Lf hproblem x p t hproblem htraj Ω hΩnonpos hΩ 0
      have hbest_le_zero :
          best_achieved_function_value (fun y ↦ (S[f, g](y)).toReal) x k ≤ 0 := by
        calc
          best_achieved_function_value (fun y ↦ (S[f, g](y)).toReal) x k ≤
              (S[f, g](x 0)).toReal :=
            best_achieved_function_value_le_objective_value
              (fun y ↦ (S[f, g](y)).toReal) x k 0 (by simp)
          _ = 0 := hS0_zero
      have hbest_nonneg :
          0 ≤ best_achieved_function_value (fun y ↦ (S[f, g](y)).toReal) x k := by
        have hbest_mem :
            best_achieved_function_value (fun y ↦ (S[f, g](y)).toReal) x k ∈
              ((Finset.range (k + 1)).image fun n ↦ (S[f, g](x n)).toReal) := by
          unfold best_achieved_function_value
          exact Finset.min'_mem _ _
        rcases Finset.mem_image.mp hbest_mem with ⟨n, hn, hbest_eq⟩
        have hxn :
            x n ∈ effective_domain g :=
          generalized_conditional_gradient_trajectory_mem_effective_domain
            hproblem.ne_bot hproblem.g_convex htraj n
        have hnonneg_n :
            0 ≤ (S[f, g](x n)).toReal :=
          generalized_conditional_gradient_norm_toReal_nonneg_of_mem_argmin
            hproblem.ne_bot hxn (htraj.argmin_mem n)
        simpa [← hbest_eq] using hnonneg_n
      exact le_antisymm hbest_le_zero hbest_nonneg
    obtain ⟨xStar, hxStar⟩ := generalized_conditional_gradient_optimal_set_nonempty hproblem
    have hxStar_g :
        xStar ∈ effective_domain g :=
      generalized_conditional_gradient_optimal_point_mem_effective_domain hproblem hxStar
    have hx0 :
        x 0 ∈ effective_domain g :=
      generalized_conditional_gradient_trajectory_mem_effective_domain
        hproblem.ne_bot hproblem.g_convex htraj 0
    have hopt_eq :
        F_opt = F xStar :=
      generalized_conditional_gradient_optimal_value_eq_of_mem_optimal_set hxStar
    have hFx0_ne_top : F (x 0) ≠ ⊤ := by
      rw [composite_model_objective_eq_coe_toReal_of_mem_effective_domain hproblem.ne_bot hx0]
      exact EReal.coe_ne_top _
    have hFx0_ne_bot : F (x 0) ≠ ⊥ := by
      rw [composite_model_objective_eq_coe_toReal_of_mem_effective_domain hproblem.ne_bot hx0]
      exact EReal.coe_ne_bot _
    have hFxStar_ne_top : F xStar ≠ ⊤ := by
      rw [composite_model_objective_eq_coe_toReal_of_mem_effective_domain hproblem.ne_bot hxStar_g]
      exact EReal.coe_ne_top _
    have hFxStar_ne_bot : F xStar ≠ ⊥ := by
      rw [composite_model_objective_eq_coe_toReal_of_mem_effective_domain hproblem.ne_bot hxStar_g]
      exact EReal.coe_ne_bot _
    have hopt_le_0 :
        F xStar ≤ F (x 0) := by
      exact (mem_unconstrained_problem_solutions_iff_forall_le.mp hxStar) (x 0)
    have hreal_le_0 :
        (F xStar).toReal ≤ (F (x 0)).toReal :=
      EReal.toReal_le_toReal hopt_le_0 hFxStar_ne_bot hFx0_ne_top
    have hgap0_eq :
        (F (x 0) - F_opt).toReal = (F (x 0)).toReal - (F xStar).toReal := by
      rw [hopt_eq]
      exact EReal.toReal_sub hFx0_ne_top hFx0_ne_bot hFxStar_ne_top hFxStar_ne_bot
    have hgap0_nonneg :
        0 ≤ (F (x 0) - F_opt).toReal := by
      rw [hgap0_eq]
      exact sub_nonneg.mpr hreal_le_0
    rw [hbest_zero]
    have hfirst_nonneg :
        0 ≤ (2 : ℝ) * (F (x 0) - F_opt).toReal / (k + 1 : ℝ) := by
      exact div_nonneg (mul_nonneg (by norm_num) hgap0_nonneg) (by positivity)
    exact le_trans hfirst_nonneg (le_max_left _ _)

end

section

variable [FiniteDimensional ℝ E]
variable {f : E → ℝ} {g : E → EReal} {Lf : NNReal}
variable [hproblem : IsGeneralizedConditionalGradientProblem f.toEReal g Lf]
variable {x p : ℕ → E} {t : ℕ → Set.Icc (0 : ℝ) 1}
variable (htraj : is_generalized_conditional_gradient_trajectory f g x p t)
variable
  (hrule : uses_generalized_conditional_gradient_adaptive_or_exact_stepsize_rule
    f g Lf x p t)

local instance theorem13_9_completeSpace : CompleteSpace E :=
  FiniteDimensional.complete ℝ E

local notation "F" => composite_model_objective f.toEReal g

-- Proof sketch: combine the sufficient-decrease inequality from Lemma 13.8 with the
-- characterization from Chapter 3 that nonstationarity forces the generalized
-- conditional-gradient gap to be positive. The positive gap makes the decrease term strictly
-- positive, hence `F(x^(k+1)) < F(x^k)`.
/-- Theorem 13.9 (2): clause (a). If the current iterate `x^k` is not a stationary point of the
composite problem `min_x {f(x) + g(x)}`, then the adaptive/exact generalized conditional-gradient
step decreases the objective strictly: `F(x^(k+1)) < F(x^k)`. -/
theorem generalized_conditional_gradient_objective_step_strict_decrease_of_not_stationary
    [hproblem : IsGeneralizedConditionalGradientProblem f.toEReal g Lf]
    (htraj : is_generalized_conditional_gradient_trajectory f g x p t)
    (hrule : uses_generalized_conditional_gradient_adaptive_or_exact_stepsize_rule
      f g Lf x p t)
    (k : ℕ)
    (hk : ¬ is_stationary_point f.toEReal g (x k)) :
    F (x (k + 1)) < F (x k) := by
  -- Use the positive compactness-derived diameter bound so that the sufficient-decrease lower
  -- bound is strictly positive whenever the gap is nonzero.
  -- Route correction: once `x k` is recognized as a feasible point of `f`, Theorem 13.6 turns
  -- nonstationarity into strict positivity of the Chapter 13 gap.
  have hdiam :=
    @effective_domain_pairwise_dist_le_of_compact E _ _ _ f g Lf
  obtain ⟨Ω, hΩpos, hΩ⟩ := hdiam hproblem
  have hxk :
      x k ∈ effective_domain g :=
    generalized_conditional_gradient_trajectory_mem_effective_domain
      hproblem.ne_bot hproblem.g_convex htraj k
  have hxk1 :
      x (k + 1) ∈ effective_domain g :=
    generalized_conditional_gradient_trajectory_mem_effective_domain
      hproblem.ne_bot hproblem.g_convex htraj (k + 1)
  have hxk_f :
      x k ∈ effective_domain f.toEReal :=
    hproblem.g_effective_domain_subset_f_effective_domain hxk
  have hS_nonneg :
      0 ≤ (S[f, g](x k)).toReal :=
    generalized_conditional_gradient_norm_toReal_nonneg_of_mem_argmin
      hproblem.ne_bot hxk (htraj.argmin_mem k)
  have hS_eq_zero_iff :
      S[f, g](x k) = 0 ↔ is_stationary_point f.toEReal g (x k) := by
    simpa using
      (generalized_conditional_gradient_norm_eq_zero_iff_is_stationary_point
        hproblem ⟨x k, hxk_f⟩)
  have hS_ne_zero : S[f, g](x k) ≠ 0 := by
    intro hS_zero
    exact hk (hS_eq_zero_iff.mp hS_zero)
  have hS_toReal_ne_zero : (S[f, g](x k)).toReal ≠ 0 := by
    intro hS_toReal_zero
    have hS_coe :
        S[f, g](x k) = (((S[f, g](x k)).toReal : ℝ) : EReal) :=
      generalized_conditional_gradient_norm_eq_coe_toReal_of_mem_argmin
        hproblem.ne_bot hxk
        (generalized_conditional_gradient_argmin_mem_effective_domain
          hxk (htraj.argmin_mem k))
        (htraj.argmin_mem k)
    have hS_zero : S[f, g](x k) = 0 := by
      simpa [hS_toReal_zero] using hS_coe
    exact hS_ne_zero hS_zero
  have hS_pos : 0 < (S[f, g](x k)).toReal := by
    exact lt_of_le_of_ne hS_nonneg (Ne.symm hS_toReal_ne_zero)
  have hquad_pos :
      0 <
        (S[f, g](x k)).toReal ^ (2 : ℕ) / ((Lf : ℝ) * Ω ^ (2 : ℕ)) := by
    have hden_pos : 0 < (Lf : ℝ) * Ω ^ (2 : ℕ) := by
      have hΩsq_pos : 0 < Ω ^ (2 : ℕ) := by
        positivity
      exact mul_pos hproblem.Lf_pos hΩsq_pos
    exact div_pos (sq_pos_of_pos hS_pos) hden_pos
  have hterm_pos :
      0 <
        (1 / 2 : ℝ) *
          min ((S[f, g](x k)).toReal)
            ((S[f, g](x k)).toReal ^ (2 : ℕ) / ((Lf : ℝ) * Ω ^ (2 : ℕ))) := by
    have hmin_pos :
        0 <
          min ((S[f, g](x k)).toReal)
            ((S[f, g](x k)).toReal ^ (2 : ℕ) / ((Lf : ℝ) * Ω ^ (2 : ℕ))) := by
      exact lt_min hS_pos hquad_pos
    positivity
  have hdec :
      (1 / 2 : ℝ) *
          min ((S[f, g](x k)).toReal)
            ((S[f, g](x k)).toReal ^ (2 : ℕ) / ((Lf : ℝ) * Ω ^ (2 : ℕ))) ≤
        (F (x k)).toReal - (F (x (k + 1))).toReal := by
    exact generalized_conditional_gradient_one_step_decrease_toReal
      htraj hrule hΩ k
  have hreal :
      (F (x (k + 1))).toReal < (F (x k)).toReal := by
    linarith
  rw [composite_model_objective_eq_coe_toReal_of_mem_effective_domain hproblem.ne_bot hxk1,
    composite_model_objective_eq_coe_toReal_of_mem_effective_domain hproblem.ne_bot hxk]
  exact_mod_cast hreal

/-- Helper for Theorem 13.9: lower semicontinuity bounds the value at the limit point by the
`liminf` along a convergent sequence. -/
lemma lowerSemicontinuous_value_le_liminf_along_subsequence
    {h : E → EReal} (hclosed : LowerSemicontinuous h) {b : ℕ → E} {bBar : E}
    (hb : Filter.Tendsto b Filter.atTop (nhds bBar)) :
    h bBar ≤ Filter.liminf (fun k ↦ h (b k)) Filter.atTop := by
  -- Compare the neighborhood-filter liminf at `bBar` with the mapped sequence filter.
  calc
    h bBar ≤ Filter.liminf h (nhds bBar) := hclosed.le_liminf bBar
    _ ≤ Filter.liminf h (Filter.map b Filter.atTop) := Filter.liminf_le_liminf_of_le hb
    _ = Filter.liminf (fun k ↦ h (b k)) Filter.atTop := by
      rw [← Filter.liminf_comp]
      rfl

/-- Helper for Theorem 13.9: adding a finite real constant on the right is continuous on `EReal`
at every base point. -/
lemma ereal_continuousAt_add_real (c : ℝ) (a : EReal) :
    ContinuousAt (fun x : EReal ↦ x + ((c : ℝ) : EReal)) a := by
  -- Use the generic `EReal` addition continuity API with the finite-real witnesses for `c`.
  let cE : EReal := ((c : ℝ) : EReal)
  have hadd :
      ContinuousAt (fun p : EReal × EReal ↦ p.1 + p.2) (a, cE) :=
    EReal.continuousAt_add (.inr (EReal.coe_ne_bot _)) (.inr (EReal.coe_ne_top _))
  simpa [cE] using hadd.comp₂ continuousAt_id continuousAt_const

/-- Helper for Theorem 13.9: adding a fixed finite real constant commutes with `Filter.liminf`
on `EReal`. -/
lemma ereal_liminf_add_coe_real (u : ℕ → EReal) (c : ℝ) :
    Filter.liminf (fun n ↦ u n + ((c : ℝ) : EReal)) Filter.atTop =
      Filter.liminf u Filter.atTop + ((c : ℝ) : EReal) := by
  let cE : EReal := ((c : ℝ) : EReal)
  let negcE : EReal := (((-c : ℝ) : EReal))
  have hc_pos :
      Filter.liminf (fun _ : ℕ ↦ cE) Filter.atTop = cE := by
    simpa [cE] using (tendsto_const_nhds : Filter.Tendsto (fun _ : ℕ ↦ cE)
      Filter.atTop (nhds cE)).liminf_eq
  have hc_neg :
      Filter.liminf (fun _ : ℕ ↦ negcE) Filter.atTop = negcE := by
    simpa [negcE] using (tendsto_const_nhds : Filter.Tendsto (fun _ : ℕ ↦ negcE)
      Filter.atTop (nhds negcE)).liminf_eq
  have hc_add_neg : cE + negcE = 0 := by
    dsimp [cE, negcE]
    rw [← EReal.coe_neg, ← EReal.coe_add]
    norm_num
  apply le_antisymm
  · -- Cancel the finite shift after comparing `(u + c) + (-c)` with `u`.
    have hshift_back :
        Filter.liminf (fun n ↦ u n + cE) Filter.atTop + negcE ≤ Filter.liminf u Filter.atTop := by
      calc
        Filter.liminf (fun n ↦ u n + cE) Filter.atTop + negcE
            = Filter.liminf (fun n ↦ u n + cE) Filter.atTop +
                Filter.liminf (fun _ : ℕ ↦ negcE) Filter.atTop := by
                  rw [hc_neg]
        _ ≤ Filter.liminf (fun n ↦ (u n + cE) + negcE) Filter.atTop := by
              have hle :
                  Filter.liminf (fun n ↦ u n + cE) Filter.atTop +
                      Filter.liminf (fun _ : ℕ ↦ negcE) Filter.atTop ≤
                    Filter.liminf (fun n ↦ (u n + cE) + negcE) Filter.atTop :=
                EReal.le_liminf_add
              simpa using hle
        _ = Filter.liminf u Filter.atTop := by
              refine Filter.liminf_congr (Filter.Eventually.of_forall ?_)
              intro n
              simpa [cE, negcE, add_assoc] using congrArg (fun t : EReal ↦ u n + t) hc_add_neg
    have hcancel :
        Filter.liminf (fun n ↦ u n + cE) Filter.atTop + negcE ≤
          (Filter.liminf u Filter.atTop + cE) + negcE := by
      calc
        Filter.liminf (fun n ↦ u n + cE) Filter.atTop + negcE ≤ Filter.liminf u Filter.atTop :=
          hshift_back
        _ = (Filter.liminf u Filter.atTop + cE) + negcE := by
              simpa [add_assoc, hc_add_neg]
    exact (EReal.addLECancellable_coe (-c)).add_le_add_iff_right.mp hcancel
  · -- The forward direction is the direct `EReal.le_liminf_add` inequality with the constant
    -- sequence.
    calc
      Filter.liminf u Filter.atTop + cE
          = Filter.liminf u Filter.atTop + Filter.liminf (fun _ : ℕ ↦ cE) Filter.atTop := by
              rw [hc_pos]
      _ ≤ Filter.liminf (fun n ↦ u n + cE) Filter.atTop := by
            have hle :
                Filter.liminf u Filter.atTop + Filter.liminf (fun _ : ℕ ↦ cE) Filter.atTop ≤
                  Filter.liminf (fun n ↦ u n + cE) Filter.atTop :=
              EReal.le_liminf_add
            simpa using hle

/-- Helper for Theorem 13.9: the smooth term `y ↦ ⟪∇ f(y), y - v⟫` converges along every
cluster-point subsequence staying in `effective_domain g`. -/
lemma generalized_conditional_gradient_gap_inner_tendsto_of_cluster_subseq
    [hproblem : IsGeneralizedConditionalGradientProblem f.toEReal g Lf]
    {xBar v : E} {ψ : ℕ → ℕ}
    (htraj : is_generalized_conditional_gradient_trajectory f g x p t)
    (hxBarg : xBar ∈ effective_domain g)
    (hv : v ∈ effective_domain g)
    (hψtendsto : Filter.Tendsto (fun n ↦ x (ψ n)) Filter.atTop (nhds xBar)) :
    Filter.Tendsto
      (fun n ↦ (((inner ℝ (∇ f (x (ψ n))) (x (ψ n) - v) : ℝ) : EReal)))
      Filter.atTop
      (nhds (((inner ℝ (∇ f xBar) (xBar - v) : ℝ) : EReal))) := by
  -- Use the source route: continuity of the gradient on `effective_domain g`, continuity of
  -- subtraction by the fixed feasible point `v`, and then continuity of the inner product.
  let D : Set E := effective_domain g
  have hsmooth : is_l_smooth_on f (effective_domain g) Lf :=
    generalized_conditional_gradient_smooth_on_g_effective_domain_of_problem
  have hgradLip := (is_l_smooth_on_iff_lipschitzOnWith_gradient.mp hsmooth).2
  have hgradCont : ContinuousOn (∇ f) D := hgradLip.continuousOn
  have hsubCont : ContinuousOn (fun y : E ↦ y - v) D :=
    (continuous_id.sub continuous_const).continuousOn
  have hinnerCont :
      ContinuousOn (fun y : E ↦ inner ℝ (∇ f y) (y - v)) D :=
    hgradCont.inner hsubCont
  have hmem :
      ∀ᶠ n in Filter.atTop, x (ψ n) ∈ D := by
    -- Every point on the generalized conditional-gradient trajectory is feasible.
    exact Filter.Eventually.of_forall fun n ↦
      generalized_conditional_gradient_trajectory_mem_effective_domain
        hproblem.ne_bot hproblem.g_convex htraj (ψ n)
  have hwithin :
      Filter.Tendsto (fun n ↦ x (ψ n)) Filter.atTop (nhdsWithin xBar D) :=
    tendsto_nhdsWithin_of_tendsto_nhds_of_eventually_within _ hψtendsto hmem
  have hinnerReal :
      Filter.Tendsto
        (fun n ↦ inner ℝ (∇ f (x (ψ n))) (x (ψ n) - v))
        Filter.atTop
        (nhds (inner ℝ (∇ f xBar) (xBar - v))) :=
    (hinnerCont xBar hxBarg).tendsto.comp hwithin
  -- Transport the real convergence through the continuous coercion `ℝ → EReal`.
  exact (EReal.tendsto_coe.2 hinnerReal)

/-- Helper for Theorem 13.9: the gap objective at a feasible cluster point is bounded by the
`liminf` of the same fixed-feasible-`v` gap objective along the convergent subsequence. -/
lemma generalized_conditional_gradient_gap_objective_liminf_lower_bound_of_cluster_subseq
    [hproblem : IsGeneralizedConditionalGradientProblem f.toEReal g Lf]
    {xBar v : E} {ψ : ℕ → ℕ}
    (htraj : is_generalized_conditional_gradient_trajectory f g x p t)
    (hxBarg : xBar ∈ effective_domain g)
    (hv : v ∈ effective_domain g)
    (hψtendsto : Filter.Tendsto (fun n ↦ x (ψ n)) Filter.atTop (nhds xBar)) :
    generalized_conditional_gradient_gap_objective f g xBar v ≤
      Filter.liminf
        (fun n ↦ generalized_conditional_gradient_gap_objective f g (x (ψ n)) v)
        Filter.atTop := by
  -- Route correction: isolate the non-constant part
  -- `g(x_(ψ n)) + ⟪∇f(x_(ψ n)), x_(ψ n) - v⟫`, prove its `liminf` lower bound exactly as in the
  -- source proof, and only then attach the fixed finite shift `-g(v)` via
  -- `ereal_liminf_add_coe_real`.
  let innerSeq : ℕ → EReal := fun n ↦
    (((inner ℝ (∇ f (x (ψ n))) (x (ψ n) - v) : ℝ) : EReal))
  let gapCore : ℕ → EReal := fun n ↦ g (x (ψ n)) + innerSeq n
  let gapCoreBar : EReal := g xBar + (((inner ℝ (∇ f xBar) (xBar - v) : ℝ) : EReal))
  have hinner_tendsto :
      Filter.Tendsto innerSeq Filter.atTop
        (nhds (((inner ℝ (∇ f xBar) (xBar - v) : ℝ) : EReal))) := by
    -- The smooth inner-product term is continuous along the convergent subsequence.
    have hinner_tendsto' :
        Filter.Tendsto
          (fun n ↦ (((inner ℝ (∇ f (x (ψ n))) (x (ψ n) - v) : ℝ) : EReal)))
          Filter.atTop
          (nhds (((inner ℝ (∇ f xBar) (xBar - v) : ℝ) : EReal))) :=
      @generalized_conditional_gradient_gap_inner_tendsto_of_cluster_subseq
        E _ _ _ f g Lf hproblem x p t hproblem xBar v ψ htraj hxBarg hv hψtendsto
    simpa [innerSeq] using hinner_tendsto'
  have hg_liminf :
      g xBar ≤ Filter.liminf (fun n ↦ g (x (ψ n))) Filter.atTop :=
    lowerSemicontinuous_value_le_liminf_along_subsequence hproblem.g_closed hψtendsto
  have hcore_liminf :
      gapCoreBar ≤ Filter.liminf gapCore Filter.atTop := by
    -- Combine lower semicontinuity of `g` with convergence of the smooth term using
    -- `EReal.le_liminf_add`.
    calc
      gapCoreBar
          = g xBar + Filter.liminf innerSeq Filter.atTop := by
              rw [hinner_tendsto.liminf_eq]
      _ ≤ Filter.liminf (fun n ↦ g (x (ψ n))) Filter.atTop +
            Filter.liminf innerSeq Filter.atTop := by
              exact add_le_add hg_liminf le_rfl
      _ ≤ Filter.liminf gapCore Filter.atTop := by
            have hle :
                Filter.liminf (fun n ↦ g (x (ψ n))) Filter.atTop +
                    Filter.liminf innerSeq Filter.atTop ≤
                  Filter.liminf gapCore Filter.atTop :=
              EReal.le_liminf_add
            simpa [gapCore, innerSeq, add_assoc, add_left_comm, add_comm] using hle
  have hgv_ne_top : g v ≠ ⊤ := (mem_effective_domain.mp hv).ne
  have hgv_ne_bot : g v ≠ ⊥ := hproblem.ne_bot v
  have hneg_gv :
      (((-(g v).toReal : ℝ) : EReal)) = -g v := by
    calc
      (((-(g v).toReal : ℝ) : EReal)) = -((((g v).toReal : ℝ) : EReal)) := by
        rw [EReal.coe_neg]
      _ = -g v := by rw [EReal.coe_toReal hgv_ne_top hgv_ne_bot]
  -- Rewrite both gap expressions as `gapCore + (-(g v).toReal : EReal)` and apply the constant
  -- shift lemma.
  calc
    generalized_conditional_gradient_gap_objective f g xBar v
        = gapCoreBar + (((-(g v).toReal : ℝ) : EReal)) := by
            rw [generalized_conditional_gradient_gap_objective_apply, sub_eq_add_neg]
            simp [gapCoreBar, hneg_gv, add_assoc, add_left_comm, add_comm]
    _ ≤ Filter.liminf gapCore Filter.atTop + (((-(g v).toReal : ℝ) : EReal)) := by
          simpa [add_assoc, add_left_comm, add_comm] using
            add_le_add_right hcore_liminf (((-(g v).toReal : ℝ) : EReal))
    _ = Filter.liminf (fun n ↦ gapCore n + (((-(g v).toReal : ℝ) : EReal))) Filter.atTop := by
          symm
          exact ereal_liminf_add_coe_real gapCore (-(g v).toReal)
    _ = Filter.liminf
          (fun n ↦ generalized_conditional_gradient_gap_objective f g (x (ψ n)) v)
          Filter.atTop := by
            refine Filter.liminf_congr (Filter.Eventually.of_forall ?_)
            intro n
            rw [generalized_conditional_gradient_gap_objective_apply, sub_eq_add_neg]
            simp [gapCore, innerSeq, hneg_gv, add_assoc, add_left_comm, add_comm]

/-- Helper for Theorem 13.9: if the trajectory gaps converge to `0`, then every fixed-feasible
test point has subsequence gap-objective `liminf` at most `0`. -/
lemma generalized_conditional_gradient_gap_objective_liminf_nonpos_of_gap_tendsto_zero
    [hproblem : IsGeneralizedConditionalGradientProblem f.toEReal g Lf]
    {v : E} {ψ : ℕ → ℕ}
    (htraj : is_generalized_conditional_gradient_trajectory f g x p t)
    (hgap_tendsto :
      Filter.Tendsto (fun n ↦ (S[f, g](x (ψ n))).toReal) Filter.atTop (nhds 0)) :
    Filter.liminf
      (fun n ↦ generalized_conditional_gradient_gap_objective f g (x (ψ n)) v)
      Filter.atTop ≤ 0 := by
  -- Compare the fixed-`v` gap objective to the supremal gap `S(x^(ψ n))`, then rewrite that
  -- supremum as a finite real cast along the trajectory and pass the limit to `liminf`.
  let gapSeq : ℕ → EReal := fun n ↦ generalized_conditional_gradient_gap_objective f g (x (ψ n)) v
  let normSeq : ℕ → EReal := fun n ↦ (((S[f, g](x (ψ n))).toReal : ℝ) : EReal)
  have hpointwise :
      ∀ n, gapSeq n ≤ normSeq n := by
    intro n
    have hxψn :
        x (ψ n) ∈ effective_domain g :=
      generalized_conditional_gradient_trajectory_mem_effective_domain
        hproblem.ne_bot hproblem.g_convex htraj (ψ n)
    have hpψn :
        p (ψ n) ∈ effective_domain g :=
      generalized_conditional_gradient_argmin_mem_effective_domain
        hxψn (htraj.argmin_mem (ψ n))
    calc
      gapSeq n ≤ S[f, g](x (ψ n)) := by
        rw [generalized_conditional_gradient_norm_eq_sSup_gap_objective]
        exact le_sSup ⟨v, rfl⟩
      _ = normSeq n := by
        dsimp [normSeq]
        exact generalized_conditional_gradient_norm_eq_coe_toReal_of_mem_argmin
          hproblem.ne_bot hxψn hpψn (htraj.argmin_mem (ψ n))
  have hnorm_tendsto :
      Filter.Tendsto normSeq Filter.atTop (nhds (0 : EReal)) := by
    simpa [normSeq] using (EReal.tendsto_coe.2 hgap_tendsto)
  have hliminf_le :
      Filter.liminf gapSeq Filter.atTop ≤ Filter.liminf normSeq Filter.atTop :=
    Filter.liminf_le_liminf (Filter.Eventually.of_forall hpointwise)
  calc
    Filter.liminf gapSeq Filter.atTop ≤ Filter.liminf normSeq Filter.atTop := hliminf_le
    _ = 0 := by
      simpa using hnorm_tendsto.liminf_eq

/-- Helper for Theorem 13.9: along a convergent feasible subsequence whose generalized
conditional-gradient gaps tend to `0`, every fixed feasible test point yields a nonpositive limit
gap objective at the cluster point. -/
lemma generalized_conditional_gradient_gap_objective_nonpos_of_cluster_subseq_of_mem_effective_domain
    [hproblem : IsGeneralizedConditionalGradientProblem f.toEReal g Lf]
    {xBar v : E} {ψ : ℕ → ℕ}
    (htraj : is_generalized_conditional_gradient_trajectory f g x p t)
    (hxBarg : xBar ∈ effective_domain g)
    (hv : v ∈ effective_domain g)
    (hψtendsto : Filter.Tendsto (fun n ↦ x (ψ n)) Filter.atTop (nhds xBar))
    (hgap_tendsto :
      Filter.Tendsto (fun n ↦ (S[f, g](x (ψ n))).toReal) Filter.atTop (nhds 0)) :
    generalized_conditional_gradient_gap_objective f g xBar v ≤ 0 := by
  -- Route correction: split the source limit passage into the liminf lower bound coming from
  -- continuity/lower semicontinuity and the liminf upper bound coming from `gap ≤ S`.
  have hlower :
      generalized_conditional_gradient_gap_objective f g xBar v ≤
        Filter.liminf
          (fun n ↦ generalized_conditional_gradient_gap_objective f g (x (ψ n)) v)
          Filter.atTop :=
    @generalized_conditional_gradient_gap_objective_liminf_lower_bound_of_cluster_subseq
      E _ _ _ f g Lf hproblem x p t hproblem xBar v ψ htraj hxBarg hv hψtendsto
  have hupper :
      Filter.liminf
        (fun n ↦ generalized_conditional_gradient_gap_objective f g (x (ψ n)) v)
        Filter.atTop ≤ 0 :=
    @generalized_conditional_gradient_gap_objective_liminf_nonpos_of_gap_tendsto_zero
      E _ _ _ f g Lf hproblem x p t hproblem v ψ htraj hgap_tendsto
  exact le_trans hlower hupper

-- Proof sketch: let `xBar` be a sequential cluster point and extract a subsequence
-- `x^(k_j) → xBar`. Clause `(3)` gives `S(x^(k_j)) → 0`. For every `v`, the defining inequality
-- for the generalized conditional-gradient gap at `x^(k_j)` yields
-- `S(x^(k_j)) ≥ ⟪∇ f(x^(k_j)), x^(k_j) - v⟫ + g(x^(k_j)) - g(v)`. Pass to the limit using
-- continuity of `∇ f` and lower semicontinuity of `g`, obtaining the Chapter 3 stationarity
-- condition at `xBar`.
/-- Theorem 13.9 (5): clause (d). Every sequential limit point of a generalized
conditional-gradient trajectory generated with adaptive stepsize or exact line search is a
stationary point of the composite problem `min_x {f(x) + g(x)}`. -/
theorem generalized_conditional_gradient_cluster_point_is_stationary
    [hproblem : IsGeneralizedConditionalGradientProblem f.toEReal g Lf]
    (htraj : is_generalized_conditional_gradient_trajectory f g x p t)
    (hrule : uses_generalized_conditional_gradient_adaptive_or_exact_stepsize_rule
      f g Lf x p t)
    {xBar : E} (hxBar : MapClusterPt xBar Filter.atTop x) :
    is_stationary_point f.toEReal g xBar := by
  -- Route correction: isolate the source proof's only remaining hard step as the fixed-`v`
  -- cluster-limit helper, and use it to turn the supremal gap at `xBar` into `0`.
  obtain ⟨ψ, hψmono, hψtendsto⟩ := MapClusterPt.tendsto_subseq hxBar
  have hgap_tendsto :
      Filter.Tendsto (fun n ↦ (S[f, g](x (ψ n))).toReal) Filter.atTop (nhds 0) := by
    exact
      (generalized_conditional_gradient_gap_tendsto_zero
        htraj hrule).comp hψmono.tendsto_atTop
  have hxBarg :
      xBar ∈ effective_domain g := by
    have hclosed := hproblem.g_effective_domain_compact.isClosed
    refine hclosed.mem_of_mapClusterPt hxBar ?_
    exact Filter.Eventually.of_forall fun k ↦
      generalized_conditional_gradient_trajectory_mem_effective_domain
        hproblem.ne_bot hproblem.g_convex htraj k
  have hS_nonpos : S[f, g](xBar) ≤ 0 := by
    rw [generalized_conditional_gradient_norm_eq_sSup_gap_objective]
    refine sSup_le ?_
    rintro z ⟨v, rfl⟩
    by_cases hv : v ∈ effective_domain g
    · exact
        @generalized_conditional_gradient_gap_objective_nonpos_of_cluster_subseq_of_mem_effective_domain
          E _ _ _ f g Lf hproblem x p t hproblem xBar v ψ htraj hxBarg hv hψtendsto hgap_tendsto
    · have hgv_top : g v = ⊤ := by
        by_contra hgv_ne_top
        exact hv (mem_effective_domain.mpr (lt_top_iff_ne_top.mpr hgv_ne_top))
      rw [generalized_conditional_gradient_gap_objective_apply, hgv_top]
      simp
  have hgap_self :
      generalized_conditional_gradient_gap_objective f g xBar xBar = 0 := by
    rw [generalized_conditional_gradient_gap_objective_apply]
    have hgxBar_ne_top : g xBar ≠ ⊤ := (mem_effective_domain.mp hxBarg).ne
    have hgxBar_ne_bot : g xBar ≠ ⊥ := hproblem.ne_bot xBar
    have hsub_self :
        g xBar - g xBar = 0 := by
      simpa using EReal.sub_self hgxBar_ne_top hgxBar_ne_bot
    simp [hsub_self]
  have hS_nonneg : 0 ≤ S[f, g](xBar) := by
    rw [generalized_conditional_gradient_norm_eq_sSup_gap_objective]
    have hsSup : generalized_conditional_gradient_gap_objective f g xBar xBar ≤
        sSup (Set.range (generalized_conditional_gradient_gap_objective f g xBar)) :=
      le_sSup ⟨xBar, rfl⟩
    simpa [hgap_self] using hsSup
  have hS_zero : S[f, g](xBar) = 0 :=
    le_antisymm hS_nonpos hS_nonneg
  have hxBar_f :
      xBar ∈ effective_domain f.toEReal :=
    hproblem.g_effective_domain_subset_f_effective_domain hxBarg
  exact
    (generalized_conditional_gradient_norm_eq_zero_iff_is_stationary_point
      hproblem ⟨xBar, hxBar_f⟩).1 hS_zero

end

