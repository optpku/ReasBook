import Mathlib

-- Declarations for this item will be appended below by the statement pipeline.

open Matrix

section

variable {n l : ℕ}

/- `prompt_add/` is absent in this workspace, so the statement design is checked against the
nearby simplex owner `stdSimplex ℝ (Fin l)`, the matrix column owner `A.col`, and the linear map
owner `A.mulVecLin` from mathlib's finite-dimensional matrix API. This item is `bridge/view`: it
does not introduce a new optimization owner, but rewrites the convex-hull feasible region
generated by the columns of `A` as the simplex image under the canonical matrix linear map. -/

/-
Proof sketch: the columns of `A` are exactly the images of the simplex vertices `Pi.single i 1`
under `A.mulVecLin` via `Matrix.mulVec_single_one`. Push the convex hull through this linear map,
then identify the convex hull of the simplex vertices with `stdSimplex ℝ (Fin l)` using
`convexHull_rangle_single_eq_stdSimplex`.
-/
/-- The convex hull of the columns of `A` is the image of the standard simplex `Δ_l` under the
linear map `v ↦ A *ᵥ v`. -/
theorem convexHull_columns_eq_image_stdSimplex
    (A : Matrix (Fin n) (Fin l) ℝ) :
    convexHull ℝ (Set.range A.col) = A.mulVecLin '' stdSimplex ℝ (Fin l) := by
  calc
    convexHull ℝ (Set.range A.col)
        = convexHull ℝ (A.mulVecLin '' Set.range (fun i : Fin l ↦ Pi.single i 1)) := by
            congr 1
            ext x
            constructor
            · rintro ⟨i, rfl⟩
              exact ⟨Pi.single i 1, ⟨i, rfl⟩, by simp⟩
            · rintro ⟨v, ⟨i, rfl⟩, rfl⟩
              exact ⟨i, by simp⟩
    _ = A.mulVecLin '' convexHull ℝ (Set.range (fun i : Fin l ↦ Pi.single i 1)) := by
          rw [← LinearMap.image_convexHull]
    _ = A.mulVecLin '' stdSimplex ℝ (Fin l) := by
          rw [convexHull_rangle_single_eq_stdSimplex]

-- Proof sketch: rewrite membership using `convexHull_columns_eq_image_stdSimplex A`; membership
-- in the image is exactly the existence of a simplex point `v : stdSimplex ℝ (Fin l)` with
-- `x = A *ᵥ v`.
/-- Text 13.3: if `A` is the matrix whose columns are `a₁, ..., a_l`, then
`x ∈ convexHull ℝ (Set.range A.col)` exactly when there exists a simplex point
`v : Δ_l = stdSimplex ℝ (Fin l)` such that `x = A *ᵥ v`. Equivalently, the quadratic problem over
the convex hull of the columns can be rewritten as the constrained problem with variables `(x, v)`,
constraint `x = A v`, and `v ∈ Δ_l`. -/
theorem mem_convexHull_columns_iff_exists_stdSimplex
    {A : Matrix (Fin n) (Fin l) ℝ} {x : Fin n → ℝ} :
    x ∈ convexHull ℝ (Set.range A.col) ↔
      ∃ v : stdSimplex ℝ (Fin l), x = A *ᵥ (v : Fin l → ℝ) := by
  rw [convexHull_columns_eq_image_stdSimplex]
  constructor
  · rintro ⟨v, hv, rfl⟩
    exact ⟨⟨v, hv⟩, rfl⟩
  · rintro ⟨v, rfl⟩
    exact ⟨(v : Fin l → ℝ), v.2, rfl⟩

end
