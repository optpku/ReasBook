import OptimizationTheoryAndMethods_SunYuan_2006.Compat
import OptimizationTheoryAndMethods_SunYuan_2006.Chap05.Definition_5_1_extra_4
import OptimizationTheoryAndMethods_SunYuan_2006.Chap05.Theorem_5_4_9.Iteration
import OptimizationTheoryAndMethods_SunYuan_2006.Chap05.Theorem_5_4_13.Transport

noncomputable section

section Chapter05Theorem5413Iteration

variable {n : ℕ}

/-- The Jacobian-side quasi-Newton step `x - B⁻¹(F x)` used in `(5.4.63)`. -/
def broydenNextIterate (F : BroydenPoint n → BroydenPoint n)
    (x : BroydenPoint n) (B : BroydenMatrix n) : BroydenPoint n :=
  quasiNewtonNextIterate F x (matrixToOperator B)

/-- The admissibility domain for the Broyden rank-one recursion: only the iterate must lie in
`D`; invertibility is handled by the canonical quasi-Newton run owner. -/
def broydenRankOneDom (D : Set (BroydenPoint n)) :
    Set (BroydenPoint n × BroydenOperator n) :=
  {p | p.1 ∈ D}

@[simp] theorem mem_broydenRankOneDom (D : Set (BroydenPoint n))
    (x : BroydenPoint n) (B : BroydenOperator n) :
    (x, B) ∈ broydenRankOneDom D ↔ x ∈ D :=
  Iff.rfl

/-- The Broyden rank-one update as a singleton-valued Jacobian update rule on Euclidean linear
maps. -/
def broydenRankOneUpdateFunction (F : BroydenPoint n → BroydenPoint n) :
    JacobianUpdateFunction (BroydenPoint n) :=
  fun x B ↦
    {BNext |
      BNext =
        matrixToOperator
          (broydenRankOneUpdate
            (operatorToMatrix B)
            (quasiNewtonNextIterate F x B - x)
            (F (quasiNewtonNextIterate F x B) - F x))}

@[simp] theorem mem_broydenRankOneUpdateFunction_iff
    (F : BroydenPoint n → BroydenPoint n) (x : BroydenPoint n)
    (B BNext : BroydenOperator n) :
    BNext ∈ broydenRankOneUpdateFunction F x B ↔
      BNext =
        matrixToOperator
          (broydenRankOneUpdate
            (operatorToMatrix B)
            (quasiNewtonNextIterate F x B - x)
            (F (quasiNewtonNextIterate F x B) - F x)) :=
  Iff.rfl

/-- A sequence pair `x`, `B` is generated by Broyden's rank-one update from the initial data
`x0`, `B0` when it starts from `x0`, `B0` and satisfies `(5.4.63)`-`(5.4.64)` at every stage. -/
structure IsGeneratedBroydenRankOneIteration
    (F : BroydenPoint n → BroydenPoint n) (x0 : BroydenPoint n) (B0 : BroydenMatrix n)
    (x : ℕ → BroydenPoint n) (B : ℕ → BroydenMatrix n) : Prop where
  x_zero : x 0 = x0
  B_zero : B 0 = B0
  step_eq : ∀ k : ℕ, x (k + 1) = broydenNextIterate F (x k) (B k)
  update_eq :
    ∀ k : ℕ,
      B (k + 1) =
        broydenRankOneUpdate (B k) (x (k + 1) - x k) (F (x (k + 1)) - F (x k))

/-- A Broyden rank-one iteration is well-defined on `D` when it is generated by
`(5.4.63)`-`(5.4.64)`, every iterate stays in `D`, and every Jacobian approximation is
invertible. The source theorem allows the exact start `x₀ = x*`, so the source-facing
well-definedness owner does not add a nonzero-step side condition beyond the displayed
recursion. -/
structure IsWellDefinedBroydenRankOneIteration
    (D : Set (BroydenPoint n)) (F : BroydenPoint n → BroydenPoint n)
    (x0 : BroydenPoint n) (B0 : BroydenMatrix n)
    (x : ℕ → BroydenPoint n) (B : ℕ → BroydenMatrix n) : Prop where
  generated : IsGeneratedBroydenRankOneIteration F x0 B0 x B
  iterates_mem : ∀ k : ℕ, x k ∈ D
  matrices_invertible : ∀ k : ℕ, (matrixToOperator (B k)).IsInvertible

namespace IsWellDefinedBroydenRankOneIteration

/-- The source-facing Broyden well-definedness data induce the canonical Jacobian-side
quasi-Newton iteration on the singleton update rule `broydenRankOneUpdateFunction F`. -/
def toJacobian
    {D : Set (BroydenPoint n)} {F : BroydenPoint n → BroydenPoint n}
    {x0 : BroydenPoint n} {B0 : BroydenMatrix n}
    {x : ℕ → BroydenPoint n} {B : ℕ → BroydenMatrix n}
    (A : IsWellDefinedBroydenRankOneIteration D F x0 B0 x B) :
    JacobianQuasiNewtonIteration D F (broydenRankOneDom D) (broydenRankOneUpdateFunction F)
      x0 (matrixToOperator B0) :=
  { x := x
    B := fun k ↦ matrixToOperator (B k)
    x_zero := A.generated.x_zero
    B_zero := by simpa using congrArg matrixToOperator A.generated.B_zero
    iterates_mem := A.iterates_mem
    in_dom := fun k ↦ A.iterates_mem k
    matrices_invertible := A.matrices_invertible
    step_eq := fun k ↦ by
      simpa [broydenNextIterate] using A.generated.step_eq k
    update_mem := fun k ↦ by
      rw [mem_broydenRankOneUpdateFunction_iff]
      rw [A.generated.update_eq k, A.generated.step_eq k]
      simp [broydenNextIterate] }

/-- Every stage of a well-defined Broyden rank-one run satisfies the iterate-domain condition,
the canonical step equation, and the singleton update equation. -/
theorem stepSpec
    {D : Set (BroydenPoint n)} {F : BroydenPoint n → BroydenPoint n}
    {x0 : BroydenPoint n} {B0 : BroydenMatrix n}
    {x : ℕ → BroydenPoint n} {B : ℕ → BroydenMatrix n}
    (A : IsWellDefinedBroydenRankOneIteration D F x0 B0 x B) (k : ℕ) :
    x k ∈ D ∧
      (x k, matrixToOperator (B k)) ∈ broydenRankOneDom D ∧
      x (k + 1) = broydenNextIterate F (x k) (B k) ∧
      matrixToOperator (B (k + 1)) ∈
        broydenRankOneUpdateFunction F (x k) (matrixToOperator (B k)) := by
  exact ⟨A.iterates_mem k, A.iterates_mem k, A.generated.step_eq k, A.toJacobian.update_mem k⟩

end IsWellDefinedBroydenRankOneIteration

end Chapter05Theorem5413Iteration
