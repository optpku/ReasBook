import OptimizationTheoryAndMethods_SunYuan_2006.Compat
import OptimizationTheoryAndMethods_SunYuan_2006.Chap03.Theorem_3_4_4
import OptimizationTheoryAndMethods_SunYuan_2006.Chap05.Lemma_5_4_19
import OptimizationTheoryAndMethods_SunYuan_2006.Chap05.Theorem_5_4_15

noncomputable section

section Chapter05Theorem5420

variable {n : ℕ}

local notation "Point" => EuclideanSpace ℝ (Fin n)
local notation "MatrixN" => Matrix (Fin n) (Fin n) ℝ

-- Domain sampling:
-- * primary domain: DFP local convergence rates for Hessian-side quasi-Newton runs;
-- * sampled owners: `DFPHessianRun`, `DFPSmallStartConvergence`,
--   `dfpReferenceHessian`, `dfpMatrixNorm`, and `dfpOneThirdConditionInNeighborhood` from the
--   Chapter 5 DFP files, together with the canonical Chapter 3 rate owner
--   `HasSuperlinearConvergenceTo`;
-- * source/core/bridge triage: the source-facing owner introduced here is the superlinear
--   refinement `DFPSmallStartSuperlinearConvergence`, while the inherited small-start run data
--   are already canonically owned by `DFPSmallStartConvergence`;
-- * primitive data: the primitive run object remains `DFPHessianRun D f`, with prescribed
--   initial data imposed by `A.x0 = x0` and `A.B0 = B0`;
-- * derived API: linear convergence is inherited from `DFPSmallStartConvergence`, and
--   superlinear convergence is expressed by the canonical owner
--   `HasSuperlinearConvergenceTo A xStar`.

/-- A small initial DFP pair `(x0, B0)` satisfies the superlinear refinement of
Chapter05 Theorem 5.4.15 when it already has the canonical small-start linear-convergence owner
and, in addition, every DFP Hessian run with the same initial data converges to `xStar`
superlinearly. -/
class DFPSmallStartSuperlinearConvergence
    (D : Set Point) (f : Point → ℝ) (xStar : outParam Point) (x0 : Point) (B0 : MatrixN) :
    Prop extends DFPSmallStartConvergence D f xStar x0 B0 where
  superlinear :
    ∀ A : DFPHessianRun D f, A.x0 = x0 → A.B0 = B0 → HasSuperlinearConvergenceTo A xStar

namespace DFPSmallStartSuperlinearConvergence

/-- The DFP small-start superlinear owner unfolds to existence of a Hessian-side DFP run with
the prescribed initial data and the universal superlinear-convergence conclusion for every such
run. -/
theorem to_exists_and_forall
    {D : Set Point} {f : Point → ℝ} {xStar x0 : Point} {B0 : MatrixN}
    (h : DFPSmallStartSuperlinearConvergence D f xStar x0 B0) :
    (∃ A : DFPHessianRun D f,
      A.x0 = x0 ∧
      A.B0 = B0 ∧
      HasSuperlinearConvergenceTo A xStar) ∧
      ∀ A : DFPHessianRun D f,
        A.x0 = x0 →
        A.B0 = B0 →
        HasSuperlinearConvergenceTo A xStar := by
  rcases h.exists_run with ⟨A, hx0, hB0, _⟩
  exact ⟨⟨A, hx0, hB0, h.superlinear A hx0 hB0⟩, h.superlinear⟩

end DFPSmallStartSuperlinearConvergence

/-- Chapter05 Theorem 5.4.20: under the assumptions of Chapter05 Theorem 5.4.15, there exist
`ε > 0` and `δ > 0` such that every Hessian-side DFP run generated by `(5.4.79)`-`(5.4.80)`
from initial data `x0`, `B0` satisfying `‖x0 - h.xStar‖ < ε` and
`dfpMatrixNorm (dfpReferenceHessian h) (B0 - dfpReferenceHessian h) < δ` converges to
`h.xStar` superlinearly. The small-start DFP data are recorded by the Chapter 5 owner
`DFPSmallStartConvergence`, and this theorem packages the superlinear refinement into the
reusable owner `DFPSmallStartSuperlinearConvergence`, whose rate conclusion is expressed by the
canonical Chapter 3 owner `HasSuperlinearConvergenceTo`. -/
theorem dfpMethod_tendsto_and_superlinear_of_small_initial_errors
    (D : Set Point) (f : Point → ℝ)
    (h : HasQuasiNewtonStrongLocalMinimizerAssumptions D f)
    (h_oneThird : dfpOneThirdConditionInNeighborhood h) :
    ∃ ε > 0, ∃ δ > 0, ∀ x0 B0,
      ‖x0 - h.xStar‖ < ε →
      dfpMatrixNorm (dfpReferenceHessian h) (B0 - dfpReferenceHessian h) < δ →
      DFPSmallStartSuperlinearConvergence D f h.xStar x0 B0 := sorry

end Chapter05Theorem5420
