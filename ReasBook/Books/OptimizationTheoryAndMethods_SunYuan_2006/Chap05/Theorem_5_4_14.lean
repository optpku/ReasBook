import OptimizationTheoryAndMethods_SunYuan_2006.Compat
import OptimizationTheoryAndMethods_SunYuan_2006.Chap05.Assumption_5_4_1
import OptimizationTheoryAndMethods_SunYuan_2006.Chap05.Theorem_5_4_3
import Mathlib.Analysis.CStarAlgebra.Matrix
import Mathlib.Analysis.Calculus.FDeriv.Basic
import Mathlib.Analysis.InnerProductSpace.PiL2
import Mathlib.Data.Matrix.Mul
import Mathlib.LinearAlgebra.Matrix.ToLin
import Mathlib.Topology.Algebra.Module.Equiv

noncomputable section

open Filter
open scoped Matrix.Norms.L2Operator

section Chapter05Theorem5414

variable {n : ℕ}

local notation "Point" => EuclideanSpace ℝ (Fin n)
local notation "MatrixN" => Matrix (Fin n) (Fin n) ℝ

-- Semantic recall: the canonical `Q`-superlinear convergence owner already lives upstream in
-- Chapter 1, but the inverse-Broyden rank-one update `(5.4.78)` itself is still source-facing
-- local API here. This file therefore reuses `HasQSuperlinearConvergenceTo` and keeps only the
-- theorem-specific inverse-update and recursion surface on matrices.

/-- The matrix corresponding to the inverse Fréchet derivative of `F` at `x`, transported
through the Euclidean-space/matrix equivalence. -/
abbrev fderivInverseMatrix (F : Point → Point) (x : Point) : MatrixN :=
  (Matrix.toEuclideanCLM : MatrixN ≃⋆ₐ[ℝ] Point →L[ℝ] Point).symm
    (fderiv ℝ F x).inverse

/-- The denominator `⟪s, H y⟫` in the inverse Broyden rank-one correction. -/
def broydenRankOneInverseDenominator (H : MatrixN) (s y : Point) : ℝ :=
  dotProduct s (H.toEuclideanLin y)

/-- Unfolding formula for `broydenRankOneInverseDenominator`. -/
@[simp] theorem broydenRankOneInverseDenominator_eq (H : MatrixN) (s y : Point) :
    broydenRankOneInverseDenominator H s y = dotProduct s (H.toEuclideanLin y) :=
  rfl

/-- The inverse-Broyden rank-one update written directly in matrix form. This is the source
formula `(5.4.78)` with total scalar inversion; the accompanying well-definedness predicate
asserts that the denominator is nonzero at each stage. -/
def broydenRankOneInverseUpdate (H : MatrixN) (s y : Point) : MatrixN :=
  H + (broydenRankOneInverseDenominator H s y)⁻¹ •
    Matrix.vecMulVec (s - H.toEuclideanLin y) ((H.transpose).toEuclideanLin s)

/-- Unfolding formula for `broydenRankOneInverseUpdate`. -/
@[simp] theorem broydenRankOneInverseUpdate_eq (H : MatrixN) (s y : Point) :
    broydenRankOneInverseUpdate H s y =
      H + (broydenRankOneInverseDenominator H s y)⁻¹ •
        Matrix.vecMulVec (s - H.toEuclideanLin y) ((H.transpose).toEuclideanLin s) :=
  rfl

/-- A sequence pair `x`, `H` is generated by the inverse-Broyden rank-one recursion from the
initial data `x0`, `H0` when it starts from `x0`, `H0` and satisfies `(5.4.77)`-`(5.4.78)`. -/
structure IsGeneratedBroydenRankOneInverseIteration
    (F : Point → Point) (x0 : Point) (H0 : MatrixN)
    (x : ℕ → Point) (H : ℕ → MatrixN) : Prop where
  x_zero : x 0 = x0
  H_zero : H 0 = H0
  step_eq : ∀ k : ℕ, x (k + 1) = x k - (H k).toEuclideanLin (F (x k))
  update_eq :
    ∀ k : ℕ,
      H (k + 1) =
        broydenRankOneInverseUpdate (H k) (x (k + 1) - x k) (F (x (k + 1)) - F (x k))

/-- An inverse-Broyden rank-one sequence pair is well-defined on `D` when it is generated by
`(5.4.77)`-`(5.4.78)`, every iterate stays in `D`, and every stage denominator in `(5.4.78)` is
nonzero. -/
structure IsWellDefinedBroydenRankOneInverseIteration
    (D : Set Point) (F : Point → Point) (x0 : Point) (H0 : MatrixN)
    (x : ℕ → Point) (H : ℕ → MatrixN) : Prop where
  generated : IsGeneratedBroydenRankOneInverseIteration F x0 H0 x H
  iterates_mem : ∀ k : ℕ, x k ∈ D
  denominator_ne :
    ∀ k : ℕ,
    broydenRankOneInverseDenominator
      (H k) (x (k + 1) - x k) (F (x (k + 1)) - F (x k)) ≠ 0

/-- Chapter05 Theorem 5.4.14: if `F : ℝ^n → ℝ^n` satisfies
`HasQuasiNewtonLocalConvergenceAssumptions D F`, then there are radii `ε`, `δ > 0` such that
every initial point `x0` and initial inverse-Jacobian approximation `H0` with
`‖x0 - hF.xStar‖ < ε` and `‖H0 - fderivInverseMatrix F hF.xStar‖ < δ` have the property that
every inverse-Broyden rank-one sequence pair `x`, `H` generated by `(5.4.77)`-`(5.4.78)` from
`x0`, `H0` is well-defined and the iterate sequence `x` converges to `hF.xStar`
`Q`-superlinearly. -/
theorem broydenRankOneInverse_qSuperlinearConvergence_of_small_initial_pair
    (D : Set Point) (F : Point → Point)
    (hF : HasQuasiNewtonLocalConvergenceAssumptions D F) :
    ∃ ε > 0, ∃ δ > 0, ∀ x0 H0,
      ‖x0 - hF.xStar‖ < ε →
      ‖H0 - fderivInverseMatrix F hF.xStar‖ < δ →
      ∀ x : ℕ → Point, ∀ H : ℕ → MatrixN,
        IsGeneratedBroydenRankOneInverseIteration F x0 H0 x H →
          IsWellDefinedBroydenRankOneInverseIteration D F x0 H0 x H ∧
            HasQSuperlinearConvergenceTo x hF.xStar := sorry

end Chapter05Theorem5414
