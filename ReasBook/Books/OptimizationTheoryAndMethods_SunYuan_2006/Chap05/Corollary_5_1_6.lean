import OptimizationTheoryAndMethods_SunYuan_2006.Compat
import OptimizationTheoryAndMethods_SunYuan_2006.Chap01.Definition_1_4_3
import OptimizationTheoryAndMethods_SunYuan_2006.Chap05.Algorithm_5_1_4
import OptimizationTheoryAndMethods_SunYuan_2006.Chap05.Definition_5_1_extra_1
import OptimizationTheoryAndMethods_SunYuan_2006.Chap05.Theorem_5_1_5

noncomputable section

section

variable {n : ℕ}

local notation "Point" => EuclideanSpace ℝ (Fin n)

variable {f : Point → ℝ}

-- Domain sampling for this file:
-- * primary domain: DFP inverse-Hessian positive-definiteness and descent directions on Euclidean
--   quasi-Newton runs;
-- * sampled project owners in the same domain:
--   `DfpMethod`,
--   `DfpMethod.GeneratedThrough`,
--   `IsDescentDirectionAt`,
--   `satisfiesCurvatureCondition`,
--   `Matrix.PosDef`;
-- * best owner abstractions: the general quasi-Newton stage predicate
--   `DfpMethod.GeneratedThrough` for the DFP recursion, and the Chapter 1
--   predicate `IsDescentDirectionAt` for the descent-direction conclusion;
-- * primitive data kept explicit here: the current nonterminal stage `k`;
-- * derived/source-facing extra hypotheses kept here: the DFP generated-through-stage predicate
--   and the current nonterminal stage `k`.

/-- Chapter05 Corollary 5.1.6 (1): if the matrix `A.matrix k` is generated by DFP Algorithm
5.1.4, formalized by the source-facing DFP stage predicate `A.GeneratedThrough k`, then
`A.matrix k` is
positive definite. -/
theorem dfpMethod_matrix_posDef
    (A : DfpMethod f) (k : ℕ)
    (hGenerated : A.GeneratedThrough k) :
    (A.matrix k).PosDef := by
  induction k with
  | zero =>
      simpa using A.matrix0_posDef
  | succ k ih =>
      have hPos : (A.matrix k).PosDef := ih (hGenerated.of_le (Nat.le_succ k))
      have hk : A.ε < ‖A.g k‖ := hGenerated.notStopped (Nat.lt_succ_self k)
      have hCurv :
          satisfiesCurvatureCondition (A (k + 1) - A k) (A.g (k + 1) - A.g k) :=
        hGenerated.curvature (Nat.lt_succ_self k)
      have hSecant :
          dotProduct (A (k + 1) - A k) (A.g (k + 1) - A.g k) ≠ 0 := by
        exact ne_of_gt (satisfiesCurvatureCondition_iff_dotProduct_pos.mp hCurv)
      rw [A.matrix_update_eq hk]
      exact (dfpInverseUpdate_posDef_iff
        (A.matrix k) hPos (A (k + 1) - A k) (A.g (k + 1) - A.g k) hSecant).2 hCurv

/-- Chapter05 Corollary 5.1.6 (2): if `A.matrix k` has been generated by DFP Algorithm 5.1.4,
formalized by `A.GeneratedThrough k`, and the current stage `k` is nonterminal, then the
corresponding direction `A.d k = -(A.H k (A.g k))` is a descent direction in the Chapter 1 owner
sense. -/
theorem dfpMethod_direction_isDescentDirectionAt
    (A : DfpMethod f) {k : ℕ} :
    A.GeneratedThrough k →
    A.ε < ‖A.g k‖ → IsDescentDirectionAt f (A k) (A.d k) := by
  intro hGenerated hk
  have hStage : A.GeneratedThrough k := hGenerated
  have hPos : (A.matrix k).PosDef := dfpMethod_matrix_posDef A k hStage
  have hGrad : gradient f (A k) = A.g k := by
    simpa using A.toGeneralQuasiNewtonMethod.gradient_eq k
  have hg_norm : 0 < ‖A.g k‖ := lt_of_le_of_lt A.epsilon_nonneg hk
  have hg_ne : A.g k ≠ 0 := by
    exact norm_ne_zero_iff.mp (ne_of_gt hg_norm)
  have hQuad :
      0 < dotProduct (A.g k) ((A.matrix k).mulVec (A.g k)) := by
    have hg_ne' : (A.g k).1 ≠ 0 := by
      simpa using hg_ne
    simpa using hPos.dotProduct_mulVec_pos hg_ne'
  have hDir : A.d k = -(A.matrix k).toEuclideanLin (A.g k) := by
    simpa using A.toGeneralQuasiNewtonMethod.direction_eq_matrix hk
  rw [isDescentDirectionAt_iff, hGrad]
  simpa [hDir, PiLp.inner_apply, dotProduct, mul_comm] using neg_neg_of_pos hQuad

/-- The canonical descent-direction statement implies the textbook Euclidean dot-product
inequality `dotProduct (A.g k) (A.d k) < 0`. -/
theorem dfpMethod_direction_dotProduct_neg
    (A : DfpMethod f) {k : ℕ} :
    A.GeneratedThrough k →
    A.ε < ‖A.g k‖ → dotProduct (A.g k) (A.d k) < 0 := by
  intro hGenerated hNotStopped
  have hDescent :=
    dfpMethod_direction_isDescentDirectionAt A hGenerated hNotStopped
  simpa [A.toGeneralQuasiNewtonMethod.gradient_eq k, PiLp.inner_apply, dotProduct, mul_comm] using
    hDescent.inner_gradient_neg

end
