import OptimizationTheoryAndMethods_SunYuan_2006.Compat
import OptimizationTheoryAndMethods_SunYuan_2006.Chap05.Algorithm_5_7_2
import OptimizationTheoryAndMethods_SunYuan_2006.Chap05.Assumption_5_3_1
import Mathlib.Order.Filter.AtTopBot.Basic

noncomputable section

open Filter

section

variable {n : ℕ}

local notation "Point" => EuclideanSpace ℝ (Fin n)

-- Domain sampling for this refine pass:
-- * primary domain: Chapter 5 L-BFGS convergence under the global quasi-Newton assumption
--   owner and strong convexity on `ℝ^n`;
-- * sampled owner declarations in the minimal closure:
--   `LBFGSMethod`,
--   `HasQuasiNewtonGlobalConvergenceAssumptions`,
--   `StrongConvexOn.strictConvexOn`,
--   `StrictConvexOn.eq_of_isMinOn`;
-- * layer triage:
--   source-facing item: `lbfgs_tendsto_globalMinimizer_of_strongConvex`;
--   core/canonical owners: `LBFGSMethod`, `HasQuasiNewtonGlobalConvergenceAssumptions`, and the
--     mathlib strong/strict-convexity owners;
--   bridge/view layer: the uniqueness clause is only the canonical bridge
--     `StrongConvexOn.strictConvexOn` into `StrictConvexOn.eq_of_isMinOn`, so it should remain
--     recall-only instead of being reintroduced as a local theorem.
-- * primitive data for the main source-facing theorem: the L-BFGS run owner, the global
--   convergence-assumption owner on `D`, and the global strong-convexity hypothesis; the
--   `C²` regularity needed on the relevant domain is already derived from
--   `hAssumption.contDiffOn`, so it should not be duplicated as a separate public binder.

/-- Chapter05 Theorem 5.7.4 (1): let `f : ℝ^n → ℝ` be uniformly, equivalently strongly, convex on
`ℝ^n` with modulus `m > 0`. If `A` is the sequence generated by Chapter05 Algorithm 5.7.2 and
the Chapter 5 quasi-Newton global-convergence assumptions hold on a convex set `D` containing
the level set `quasiNewtonLevelSet f A.x0`, then the L-BFGS iterates converge to a global
minimizer of `f`. The regularity needed on `D` is owned by
`HasQuasiNewtonGlobalConvergenceAssumptions D f A.x0`. -/
theorem lbfgs_tendsto_globalMinimizer_of_strongConvex
    (f : Point → ℝ) (A : LBFGSMethod n f) (D : Set Point) (m : ℝ)
    (hm : 0 < m)
    (hStrong : StrongConvexOn Set.univ m f)
    (hAssumption : HasQuasiNewtonGlobalConvergenceAssumptions D f A.x0) :
    ∃ xStar : Point,
      Tendsto A atTop (nhds xStar) ∧
        IsMinOn f Set.univ xStar := sorry

/- Chapter05 Theorem 5.7.4 (2): under the same uniform, equivalently strong, convexity
hypothesis, the global minimizer of `f` is unique. This clause is exactly the canonical mathlib
uniqueness result `StrictConvexOn.eq_of_isMinOn`, reached from the source hypothesis by the bridge
`StrongConvexOn.strictConvexOn`, so the item stays at the recall layer instead of re-owning a
duplicate theorem. -/
#check
  fun {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] {f : E → ℝ} {m : ℝ}
    (hm : 0 < m) (hStrong : StrongConvexOn Set.univ m f) ↦
      (hStrong.strictConvexOn hm).eq_of_isMinOn

end
