import OptimizationTheoryAndMethods_SunYuan_2006.Compat
import Mathlib.Analysis.Normed.Group.Bounded
import Mathlib.Order.Filter.Extr
import OptimizationTheoryAndMethods_SunYuan_2006.Chap10.Algorithm_10_4_1
import OptimizationTheoryAndMethods_SunYuan_2006.Chap10.StandardPenaltyProblemBridge

open Filter

noncomputable section

variable {n m : ℕ}

local notation "Point" => EuclideanSpace ℝ (Fin n)

namespace AugmentedLagrangianMethod

/-- Algorithm 10.4.1 does not terminate finitely when every stage `k ≥ 1` fails the source
stopping test `‖c⁽-⁾(x_(k+1))‖∞ ≤ ε`. This rules out arbitrary post-termination tails in the
recorded iterate, multiplier, and penalty sequences. -/
def doesNotTerminateFinitely (method : AugmentedLagrangianMethod n m) : Prop :=
  ∀ k : ℕ, 1 ≤ k → ¬ method.terminatedAt k

/-- Unfolding `method.doesNotTerminateFinitely` gives the source nontermination condition that
every stage `k ≥ 1` fails the stopping test. -/
theorem doesNotTerminateFinitely_iff (method : AugmentedLagrangianMethod n m) :
    method.doesNotTerminateFinitely ↔
      ∀ k : ℕ, 1 ≤ k → ¬ method.terminatedAt k :=
  Iff.rfl

/-- The source consequence `(10.4.26)`: the `ℓ∞`-norm of the violation vector `c⁽-⁾(x_(k+1))`
tends to `0` along the iterates generated by Algorithm 10.4.1. -/
def constraintViolationTendstoZero (method : AugmentedLagrangianMethod n m) : Prop :=
  Tendsto
    (fun k : ℕ ↦ method.problem.linftyConstraintViolation (method.iterate (k + 1)))
    atTop
    (nhds 0)

/-- The source estimate `(10.4.27)`: every feasible comparison point bounds the objective values
`f(x_(k+1))` from below up to a vanishing error term. -/
def feasibleObjectiveLowerBoundUpToVanishingError
    (method : AugmentedLagrangianMethod n m) : Prop :=
  ∀ x : Point, x ∈ method.problem.feasibleSet →
    ∃ r : ℕ → ℝ,
      Tendsto r atTop (nhds 0) ∧
        ∀ k : ℕ,
          method.problem.objective x ≥ method.problem.objective (method.iterate (k + 1)) + r k

/-- Auxiliary ambient regularity package for Chapter10 Theorem 10.4.3: the source proof passes
subsequence limits through the Chapter 10 violation map `c⁽-⁾` and, in part (2), through
`method.problem.objective`. Since these continuity assumptions are not yet stored on
`StandardPenaltyProblem`, they are kept as a separate same-file owner rather than hidden inside
the labeled theorem's generated-sequence package. -/
structure AccumulationPointHypotheses
    (method : AugmentedLagrangianMethod n m) : Prop where
  constraintViolationContinuous : Continuous (c⁽-⁾[method.problem])
  objectiveContinuous : Continuous method.problem.objective

/-- Smart constructor for the ambient Section 10.4 regularity package used in
Chapter10 Theorem 10.4.3. -/
def accumulationPointHypothesesOfContinuous
    (method : AugmentedLagrangianMethod n m)
    (hConstraintViolationContinuous : Continuous (c⁽-⁾[method.problem]))
    (hObjectiveContinuous : Continuous method.problem.objective) :
    method.AccumulationPointHypotheses where
  constraintViolationContinuous := hConstraintViolationContinuous
  objectiveContinuous := hObjectiveContinuous

/-- The ambient Section 10.4 regularity package yields continuity of the Chapter 10 violation map
at every point, including any accumulation point used in Theorem 10.4.3. -/
theorem AccumulationPointHypotheses.constraintViolationContinuousAt
    {method : AugmentedLagrangianMethod n m}
    (hSource : method.AccumulationPointHypotheses) (x : Point) :
    ContinuousAt (c⁽-⁾[method.problem]) x :=
  hSource.constraintViolationContinuous.continuousAt

/-- The ambient Section 10.4 regularity package yields continuity of the objective at every point,
including any accumulation point used in Theorem 10.4.3 (2). -/
theorem AccumulationPointHypotheses.objectiveContinuousAt
    {method : AugmentedLagrangianMethod n m}
    (hSource : method.AccumulationPointHypotheses) (x : Point) :
    ContinuousAt method.problem.objective x :=
  hSource.objectiveContinuous.continuousAt

end AugmentedLagrangianMethod

/-- Source-faithful run owner for Chapter10 Theorem 10.4.3: besides the raw Algorithm 10.4.1
data, the source proof uses the concrete generated-sequence consequences `(10.4.26)` and, under
bounded multipliers, `(10.4.27)`. Since the current Chapter 10 algorithm API is too weak to
derive those consequences from the bare method fields alone, this theorem-specific owner records
exactly the source-level nontermination semantics together with those two proof-used properties. -/
structure AugmentedLagrangianTheorem1043Run (n m : ℕ)
    extends AugmentedLagrangianMethod n m where
  doesNotTerminateFinitely :
    toAugmentedLagrangianMethod.doesNotTerminateFinitely
  constraintViolationTendstoZero :
    toAugmentedLagrangianMethod.constraintViolationTendstoZero
  feasibleObjectiveLowerBoundUpToVanishingError_of_boundedMultipliers :
    Bornology.IsBounded
        (Set.range fun k : ℕ ↦ toAugmentedLagrangianMethod.multiplier (k + 1)) →
      toAugmentedLagrangianMethod.feasibleObjectiveLowerBoundUpToVanishingError

namespace AugmentedLagrangianMethod

/-- The source consequence `(10.4.26)` is part of the theorem-specific run owner used for
Chapter10 Theorem 10.4.3. -/
theorem constraintViolationTendstoZero_of_zeroTolerance
    (method : AugmentedLagrangianTheorem1043Run n m) :
    method.toAugmentedLagrangianMethod.constraintViolationTendstoZero := by
  -- This wrapper simply exposes the stored `(10.4.26)` field on the theorem-specific run owner.
  exact method.constraintViolationTendstoZero

/-- The source comparison estimate `(10.4.27)` is recorded on the theorem-specific run owner as
the bounded-multiplier consequence used in Chapter10 Theorem 10.4.3 (2). -/
theorem feasibleObjectiveLowerBoundUpToVanishingError_of_boundedMultipliers
    (method : AugmentedLagrangianTheorem1043Run n m)
    (hMultiplierBounded :
      Bornology.IsBounded (Set.range fun k : ℕ ↦ method.multiplier (k + 1))) :
    method.toAugmentedLagrangianMethod.feasibleObjectiveLowerBoundUpToVanishingError := by
  -- This wrapper just reuses the run-owner field carrying the `(10.4.27)` consequence.
  exact
    method.feasibleObjectiveLowerBoundUpToVanishingError_of_boundedMultipliers
      hMultiplierBounded

/-- Helper for Chapter10 Theorem 10.4.3: vanishing of the owner-level `ℓ∞` violation norm forces
the Chapter 10 constraint-violation vector itself to vanish. -/
lemma constraintViolation_eq_zero_of_linftyConstraintViolation_eq_zero
    (method : AugmentedLagrangianTheorem1043Run n m)
    {x : Point}
    (hZero : method.problem.linftyConstraintViolation x = 0) :
    c⁽-⁾[method.problem] x = 0 := by
  -- First identify the transported `ℓ∞` element as zero from its vanishing norm.
  have hToLpZero :
      WithLp.toLp (⊤ : ENNReal) (c⁽-⁾[method.problem] x).ofLp = 0 := by
    apply norm_eq_zero.mp
    simpa [StandardPenaltyProblem.linftyConstraintViolation_eq] using hZero
  -- Then transport the zero statement back through `toLp` and `ofLp`.
  have hOfLpZero : (c⁽-⁾[method.problem] x).ofLp = 0 :=
    (WithLp.toLp_eq_zero (p := (⊤ : ENNReal)) (x := (c⁽-⁾[method.problem] x).ofLp)).1 hToLpZero
  exact (WithLp.ofLp_eq_zero (p := 2) (x := c⁽-⁾[method.problem] x)).1 hOfLpZero

/-- Helper for Chapter10 Theorem 10.4.3: the source lower bound `(10.4.27)` passes to the limit
along a convergent subsequence of iterates, so the accumulation point compares below every
feasible objective value. -/
lemma objectiveLowerBoundAtAccumulationPoint
    (method : AugmentedLagrangianTheorem1043Run n m)
    {xStar : Point} {φ : ℕ → ℕ}
    (hObjectiveContinuousAt : ContinuousAt method.problem.objective xStar)
    (hφ : StrictMono φ)
    (hxStar : Tendsto (fun k : ℕ ↦ method.iterate (φ k + 1)) atTop (nhds xStar))
    (hLower : method.toAugmentedLagrangianMethod.feasibleObjectiveLowerBoundUpToVanishingError)
    {x : Point} (hx : x ∈ method.problem.feasibleSet) :
    method.problem.objective xStar ≤ method.problem.objective x := by
  rcases hLower x hx with ⟨r, hr, hr_le⟩
  -- The subsequence inherits objective convergence from continuity at the accumulation point.
  have hObjectiveSubseq :
      Tendsto
        (fun k : ℕ ↦ method.problem.objective (method.iterate (φ k + 1)))
        atTop
        (nhds (method.problem.objective xStar)) :=
    hObjectiveContinuousAt.tendsto.comp hxStar
  -- The vanishing error term also vanishes after reindexing by the subsequence.
  have hErrorSubseq :
      Tendsto (fun k : ℕ ↦ r (φ k)) atTop (nhds 0) :=
    hr.comp hφ.tendsto_atTop
  have hSumSubseq :
      Tendsto
        (fun k : ℕ ↦ method.problem.objective (method.iterate (φ k + 1)) + r (φ k))
        atTop
        (nhds (method.problem.objective xStar)) := by
    simpa using hObjectiveSubseq.add hErrorSubseq
  have hConst :
      Tendsto (fun _ : ℕ ↦ method.problem.objective x) atTop (nhds (method.problem.objective x)) :=
    tendsto_const_nhds
  have hPointwise :
      ∀ k : ℕ,
        method.problem.objective (method.iterate (φ k + 1)) + r (φ k) ≤
          method.problem.objective x := by
    -- Evaluate the stored stagewise bound at indices `φ k`.
    intro k
    have hk := hr_le (φ k)
    linarith
  -- Closedness of `≤` lets the stagewise inequality survive in the limit.
  exact le_of_tendsto_of_tendsto' hSumSubseq hConst hPointwise

/-- Feasibility part of Chapter10 Theorem 10.4.3: let the feasible region `X` of problem
`(10.1.1)`-`(10.1.3)`
be nonempty. Then, for `ε = 0`, any accumulation point `xStar` of the sequence `x_k` generated
by Algorithm 10.4.1, encoded by a convergent subsequence `x_(φ k + 1)`, is feasible. The
theorem-specific run owner `AugmentedLagrangianTheorem1043Run` packages the source-used
convergence consequence `(10.4.26)`, and the needed continuity of the violation map at `xStar`
is kept explicit rather than being silently inferred from stronger unsupported ambient data. -/
theorem accumulationPoint_mem_feasibleSet_of_zeroTolerance
    (method : AugmentedLagrangianTheorem1043Run n m)
    (hFeasible : Set.Nonempty method.problem.feasibleSet)
    (hTolerance : method.tolerance = 0)
    {xStar : Point}
    (hConstraintViolationContinuousAt : ContinuousAt (c⁽-⁾[method.problem]) xStar)
    {φ : ℕ → ℕ}
    (hφ : StrictMono φ)
    (hxStar : Tendsto (fun k : ℕ ↦ method.iterate (φ k + 1)) atTop (nhds xStar)) :
    xStar ∈ method.problem.feasibleSet := by
  -- The theorem-specific run owner already packages the consequences of these source assumptions.
  let _ := hFeasible
  let _ := hTolerance
  -- Reindex the packaged `(10.4.26)` limit along the convergent subsequence `φ`.
  have hViolationZero :
      Tendsto
        (fun k : ℕ ↦ method.problem.linftyConstraintViolation (method.iterate (φ k + 1)))
        atTop
        (nhds 0) :=
    (constraintViolationTendstoZero_of_zeroTolerance method).comp hφ.tendsto_atTop
  -- Coordinatewise continuity of `c⁽-⁾` lets us compare each limit coordinate with the vanishing
  -- `ℓ∞` bound coming from `(10.4.26)`.
  refine (method.problem.mem_iff_constraintViolation_eq_zero xStar).2 ?_
  ext i
  let u : ℕ → ℝ := fun k ↦ (c⁽-⁾[method.problem] (method.iterate (φ k + 1))) i
  have hCoordAbsLe :
      ∀ k : ℕ, |u k| ≤ method.problem.linftyConstraintViolation (method.iterate (φ k + 1)) := by
    intro k
    simpa [u, StandardPenaltyProblem.linftyConstraintViolation_eq] using
      (PiLp.norm_apply_le
        (p := (⊤ : ENNReal))
        (x := WithLp.toLp
          (⊤ : ENNReal)
          (c⁽-⁾[method.problem] (method.iterate (φ k + 1))).ofLp)
        i)
  have hCoordUpper :
      ∀ k : ℕ,
        u k ≤ method.problem.linftyConstraintViolation (method.iterate (φ k + 1)) := by
    intro k
    exact (le_abs_self (u k)).trans (hCoordAbsLe k)
  have hCoordLower :
      ∀ k : ℕ,
        -method.problem.linftyConstraintViolation (method.iterate (φ k + 1)) ≤ u k := by
    intro k
    exact le_trans (neg_le_neg (hCoordAbsLe k)) (neg_abs_le (u k))
  have hCoordZero : Tendsto u atTop (nhds 0) := by
    have hNegViolationZero :
        Tendsto
          (fun k : ℕ ↦ -method.problem.linftyConstraintViolation (method.iterate (φ k + 1)))
          atTop
          (nhds 0) := by
      simpa using hViolationZero.neg
    exact
      tendsto_of_tendsto_of_tendsto_of_le_of_le
        hNegViolationZero
        hViolationZero
        hCoordLower
        hCoordUpper
  have hCoordLimit :
      Tendsto u atTop (nhds ((c⁽-⁾[method.problem] xStar) i)) :=
    ((PiLp.continuous_apply (p := 2) (β := fun _ : Fin m ↦ ℝ) i).continuousAt.comp
      hConstraintViolationContinuousAt).tendsto.comp hxStar
  exact tendsto_nhds_unique hCoordLimit hCoordZero

/-- Chapter10 Theorem 10.4.3 (2): under the same nonempty-feasible-region and zero-tolerance
hypotheses, if the multiplier sequence `λ⁽k⁾` is bounded, then any accumulation point `xStar` of
the sequence `x_k` generated by Algorithm 10.4.1, encoded by a convergent subsequence
`x_(φ k + 1)`, solves the original problem `(10.1.1)`-`(10.1.3)`, recorded by the canonical
Chapter 10 mixed-constraint minimizer owner `method.problem.IsGlobalMinimizer xStar`. The
generated-sequence context is bundled in `AugmentedLagrangianTheorem1043Run`, which also records
the source bounded-multiplier route to `(10.4.27)` needed by the textbook proof; the continuity
assumptions used at the accumulation point are exposed by
`method.AccumulationPointHypotheses`. -/
theorem accumulationPoint_solvesProblem_of_boundedMultipliers
    (method : AugmentedLagrangianTheorem1043Run n m)
    (hFeasible : Set.Nonempty method.problem.feasibleSet)
    (hTolerance : method.tolerance = 0)
    (hSource : method.AccumulationPointHypotheses)
    (hMultiplierBounded :
      Bornology.IsBounded (Set.range fun k : ℕ ↦ method.multiplier (k + 1)))
    {xStar : Point} {φ : ℕ → ℕ}
    (hφ : StrictMono φ)
    (hxStar : Tendsto (fun k : ℕ ↦ method.iterate (φ k + 1)) atTop (nhds xStar)) :
    method.problem.IsGlobalMinimizer xStar := by
  -- Part (1) first recovers feasibility of the accumulation point.
  have hxStarFeasible : xStar ∈ method.problem.feasibleSet :=
    accumulationPoint_mem_feasibleSet_of_zeroTolerance
      method
      hFeasible
      hTolerance
      (hSource.constraintViolationContinuousAt xStar)
      hφ
      hxStar
  have hLower :
      method.toAugmentedLagrangianMethod.feasibleObjectiveLowerBoundUpToVanishingError :=
    feasibleObjectiveLowerBoundUpToVanishingError_of_boundedMultipliers method hMultiplierBounded
  -- Then `(10.4.27)` passes to the limit and yields minimization on the feasible set.
  have hMin : IsMinOn method.problem.objective method.problem.feasibleSet xStar := by
    rw [isMinOn_iff]
    intro x hx
    exact objectiveLowerBoundAtAccumulationPoint
      method
      (hSource.objectiveContinuousAt xStar)
      hφ
      hxStar
      hLower
      hx
  exact (method.problem.isGlobalMinimizer_iff xStar).2 ⟨hxStarFeasible, hMin⟩

/-- Companion source-facing expansion of Theorem 10.4.3 (2): the canonical mixed-constraint
global-minimizer conclusion is equivalent to feasibility together with minimization of
`method.problem.objective` on `method.problem.feasibleSet`. -/
theorem accumulationPoint_solvesProblem_spec
    (method : AugmentedLagrangianTheorem1043Run n m)
    (hFeasible : Set.Nonempty method.problem.feasibleSet)
    (hTolerance : method.tolerance = 0)
    (hSource : method.AccumulationPointHypotheses)
    (hMultiplierBounded :
      Bornology.IsBounded (Set.range fun k : ℕ ↦ method.multiplier (k + 1)))
    {xStar : Point} {φ : ℕ → ℕ}
    (hφ : StrictMono φ)
    (hxStar : Tendsto (fun k : ℕ ↦ method.iterate (φ k + 1)) atTop (nhds xStar)) :
    xStar ∈ method.problem.feasibleSet ∧
      IsMinOn method.problem.objective method.problem.feasibleSet xStar := by
  exact (method.problem.isGlobalMinimizer_iff xStar).1
    (accumulationPoint_solvesProblem_of_boundedMultipliers
      method hFeasible hTolerance hSource hMultiplierBounded hφ hxStar)

end AugmentedLagrangianMethod
