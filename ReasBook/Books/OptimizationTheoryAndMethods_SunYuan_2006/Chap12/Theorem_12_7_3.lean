open Filter

noncomputable section

section Chapter12Theorem1273

variable {n m : ℕ}
local notation "Multiplier" => LagrangeNewtonMultiplier m

-- Semantic recall: `lean_leansearch` surfaced generic accumulation-point APIs such as
-- `TopologicalSpace.FirstCountableTopology.tendsto_subseq`, while local Chapter 12 precedent
-- states accumulation points through a strictly monotone subsequence and `Tendsto`. This file
-- reuses the chapter SQP owners `sqpSubproblemObjective` and
-- `satisfiesSqpLinearizedConstraints`, the exact-penalty owner
-- `problem.toStandardPenaltyProblem.l1ExactPenalty`, and the scalar penalty path
-- `sqpPenaltyPath`, while tying `method.constraintJacobian` explicitly to the fixed problem's
-- constraint map.

/-- A `SmoothExactPenaltyMethodFor problem` is the Section 12.7 smooth exact penalty method
specialized to the fixed equality-constrained problem `(12.7.4)`-`(12.7.5)`: its canonical
Step-2 subproblem agrees with the quadratic model built from `problem`, its stagewise
constraint values are `problem.constraintVector (x_k)`, its Step-3 merit model is the equality-
only exact-penalty path
`sqpPenaltyPath problem.toStandardPenaltyProblem x_k d_k σ`, its recorded derivative at `0` is
the derivative of that path, and its `constraintJacobian` agrees pointwise with the fixed
problem's `constraintGradientCombination`. -/
structure SmoothExactPenaltyMethodFor
    (problem : EqualityConstrainedProblem n m)
    extends SmoothExactPenaltyMethod n m where
  sqpSubproblem_objective_eq (k : ℕ) (d : Point n) :
      (sqpSubproblem k).objective d.ofLp =
        sqpSubproblemObjective
          (gradient problem.objective (iterate k))
          (toSmoothExactPenaltyMethod.hessianOperator k)
          d
  constraintValue_eq (k : ℕ) :
    constraintValue k = problem.constraintVector (iterate k)
  phi_eq (k i : ℕ) :
    phi k i =
      sqpPenaltyPath
        problem.toStandardPenaltyProblem
        (iterate k)
        (searchDirection k)
        (sigma k i)
  phiDerivAtZero_eq (k i : ℕ) :
    phiDerivAtZero k i =
      deriv
        (sqpPenaltyPath
          problem.toStandardPenaltyProblem
          (iterate k)
          (searchDirection k)
          (sigma k i))
        0
  constraintJacobian_eq (x : Point n) (lam : Multiplier) :
    constraintJacobian x lam = problem.constraintGradientCombination x lam

/-- Chapter12 Theorem 12.7.3: under the hypotheses of `Chapter12 Lemma 12.7.2` for the Section
12.7 smooth exact penalty method `method` generated by Algorithm 12.7.1 for the fixed
equality-constrained problem `(12.7.4)`-`(12.7.5)`, assume `problem.objective` and every
component of `problem.constraint` are continuously differentiable. Then any accumulation point
of the iterate sequence `{x_k}`, encoded by a strictly monotone subsequence converging to
`xStar`, is a KKT point of `problem`. -/
theorem smoothExactPenalty_accumulationPoint_isKKTPoint
    (problem : EqualityConstrainedProblem n m)
    (method : SmoothExactPenaltyMethodFor problem)
    (hObjectiveC1 : ContDiff ℝ 1 problem.objective)
    (hConstraintC1 : ∀ i : Fin m, ContDiff ℝ 1 (problem.constraint i))
    (hx_bounded : Bornology.IsBounded (Set.range method.iterate))
    (hd_bounded : Bornology.IsBounded (Set.range method.searchDirection))
    (hB_bounded : Bornology.IsBounded (Set.range method.hessianOperator))
    (hA_fullColumnRank : ∀ x : Point n, Function.Injective (method.constraintJacobian x))
    {δ : ℝ} (hδ : 0 < δ)
    (hNullspaceCurvature :
      ∀ k : ℕ, ∀ d : Point n,
        (method.constraintJacobian (method.iterate k)).adjoint d = 0 →
          δ * ‖d‖ ^ (2 : ℕ) ≤ inner ℝ d (method.hessianOperator k d))
    {xStar : Point n} {φ : ℕ → ℕ}
    (hφ : StrictMono φ)
    (hxStar : Tendsto (method.iterate ∘ φ) atTop (nhds xStar)) :
    ∃ lamStar : Multiplier, problem.IsKKTPoint xStar lamStar := sorry

#print axioms EqualityConstrainedProblem.constraintVector
#print axioms EqualityConstrainedProblem.lagrangian
#print axioms EqualityConstrainedProblem.constraintGradientCombination
#print axioms EqualityConstrainedProblem.toStandardPenaltyProblem
#print axioms sqpSubproblemObjective
#print axioms StandardPenaltyProblem.l1ExactPenalty
#print axioms sqpPenaltyPath

end Chapter12Theorem1273
