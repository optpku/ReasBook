module

public import OptimizationTheoryAndMethods_SunYuan_2006.Compat

public import OptimizationTheoryAndMethods_SunYuan_2006.Chap13.LinearTrustRegion

noncomputable section

public section

variable {n me mi : ℕ}

local notation "Point" => EuclideanSpace ℝ (Fin n)
local notation "HessianMatrix" => Matrix (Fin n) (Fin n) ℝ

-- `LinearTrustRegion.lean` owns the fixed problem data, stage subproblem, and full algorithm
-- structure. This item keeps Algorithm 13.2.1 source-facing by exporting the generated
-- sequences `x_k`, `Δ_k`, and `B_k` together with their recorded update rules.

namespace LinearTrustRegionMethod

/-- Chapter13 Algorithm 13.2.1 records the iterate sequence `x_k` generated by the method. -/
def iterate (method : LinearTrustRegionMethod n me mi) (k : ℕ) : Point :=
  (method.stageState k).iterate

/-- Chapter13 Algorithm 13.2.1 records the trust-region directions `d_k` selected by the Step-2
subproblems. -/
def direction (method : LinearTrustRegionMethod n me mi) (k : ℕ) : Point :=
  (method.stageSubproblem k).direction

/-- Chapter13 Algorithm 13.2.1 records the trust-region radius sequence `Δ_k`. -/
def radius (method : LinearTrustRegionMethod n me mi) (k : ℕ) : ℝ :=
  (method.stageState k).radius

/-- Chapter13 Algorithm 13.2.1 records the Hessian approximation sequence `B_k`. -/
def hessianApproximation
    (method : LinearTrustRegionMethod n me mi) (k : ℕ) : HessianMatrix :=
  (method.stageState k).hessianApproximation

/-- The acceptance ratio `r_k` recorded at stage `k`. -/
def acceptanceRatio (method : LinearTrustRegionMethod n me mi) (k : ℕ) : ℝ :=
  linearTrustRegionAcceptanceRatio method.problem (method.stageState k) (method.stageSubproblem k)

/-- The first iterate `x₁` recorded by Algorithm 13.2.1 is the initial feasible point. -/
theorem iterate_one_eq
    (method : LinearTrustRegionMethod n me mi) :
    method.iterate 1 = method.initialState.iterate := by
  rw [iterate, method.stageState_one]

/-- The first trust-region radius `Δ₁` recorded by Algorithm 13.2.1 is the initial radius. -/
theorem radius_one_eq
    (method : LinearTrustRegionMethod n me mi) :
    method.radius 1 = method.initialState.radius := by
  rw [radius, method.stageState_one]

/-- The first Hessian approximation `B₁` recorded by Algorithm 13.2.1 is the initial one. -/
theorem hessianApproximation_one_eq
    (method : LinearTrustRegionMethod n me mi) :
    method.hessianApproximation 1 = method.initialState.hessianApproximation := by
  rw [hessianApproximation, method.stageState_one]

/-- Every active iterate `x_k` recorded by Algorithm 13.2.1 stays feasible for the fixed linear
constraints. -/
theorem iterate_mem_feasibleSet
    (method : LinearTrustRegionMethod n me mi) (k : ℕ) (hk : method.active k) :
    method.iterate k ∈ method.problem.feasibleSet :=
  method.feasible_stage k hk

/-- The Step-2 direction `d_k` recorded at stage `k` is feasible for the current trust-region
subproblem. -/
theorem direction_mem_stageFeasible
    (method : LinearTrustRegionMethod n me mi) (k : ℕ) :
    method.direction k ∈ linearTrustRegionStageFeasible method.problem (method.stageState k) := by
  simpa [direction] using method.stageSubproblem_direction_mem_stageFeasible k

/-- On a nonterminal active stage, the next iterate `x_(k+1)` is the source Step-3/Step-4 update
determined by `d_k` and `r_k`. -/
theorem iterate_succ_eq
    (method : LinearTrustRegionMethod n me mi)
    (k : ℕ) (hk : method.active k) (hcontinue : ¬ method.stageStops k) :
    method.iterate (k + 1) =
      linearTrustRegionNextIterate (method.stageState k) (method.direction k)
        (method.acceptanceRatio k) := by
  simpa [iterate, direction, acceptanceRatio] using
    method.stageState_succ_iterate_eq k hk hcontinue

/-- On a nonterminal active stage, the next trust-region radius `Δ_(k+1)` is the source
Step-3/Step-4 radius update determined by `d_k` and `r_k`. -/
theorem radius_succ_eq
    (method : LinearTrustRegionMethod n me mi)
    (k : ℕ) (hk : method.active k) (hcontinue : ¬ method.stageStops k) :
    method.radius (k + 1) =
      linearTrustRegionNextRadius (method.stageState k) (method.direction k)
        (method.acceptanceRatio k) := by
  simpa [radius, direction, acceptanceRatio] using
    method.stageState_succ_radius_eq k hk hcontinue

/-- On a nonterminal active stage, the recorded Hessian approximation update satisfies the source
update relation chosen for Algorithm 13.2.1. -/
theorem hessianApproximation_succ_spec
    (method : LinearTrustRegionMethod n me mi)
    (k : ℕ) (hk : method.active k) (hcontinue : ¬ method.stageStops k) :
    method.hessianUpdateRule k (method.hessianApproximation k)
      (method.hessianApproximation (k + 1)) := by
  change
    method.hessianUpdateRule k (method.stageState k).hessianApproximation
      ((method.stageState (k + 1)).hessianApproximation)
  rw [method.stageState_succ k hk hcontinue]
  exact method.hessian_update_spec k hk hcontinue

end LinearTrustRegionMethod

end
