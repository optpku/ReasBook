import OptimizationTheoryAndMethods_SunYuan_2006.Compat
import Mathlib.Analysis.Calculus.ContDiff.Basic
import Mathlib.Analysis.Calculus.Gradient.Basic
import Mathlib.Geometry.Euclidean.Angle.Unoriented.Basic
import Mathlib.Order.Filter.AtTopBot.Basic
import Mathlib.Topology.MetricSpace.Lipschitz
import OptimizationTheoryAndMethods_SunYuan_2006.Chap02.Theorem_2_5_4

open Filter
open scoped Gradient

section

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]

-- Domain sampling:
-- * source-facing: the Wolfe-Powell/Lipschitz specialization of Chapter 2 global convergence
--   stated with a chosen gradient field `g`;
-- * core/canonical: `HasGradientVectorAt`, `inexactLineSearch_globalConvergence`,
--   `InexactLineSearchAcceptance`, and `WolfePowellParameters`;
-- * bridge/view: `wolfePowellLineSearch_globalConvergence_of_uniformContinuousOn` packages the
--   explicit Wolfe-Powell iterate data into the canonical convergence owner, while the global
--   Lipschitz bound on `g` yields that bridge theorem's `UniformContinuousOn` hypothesis on the
--   initial sublevel set. The companion
--   `wolfePowellLineSearch_globalConvergence_of_contDiff` recovers the complete-space `∇ f`
--   formulation.

/-- Canonical initial-sublevel-set regularity form of Chapter02 Theorem 2.5.7: the Wolfe-Powell
iterate, direction, and steplength data remain source-facing, while the analytic hypotheses are
recorded through a chosen gradient field `g` along the iterates and on
`initialSublevelSet f (x 0)`, together with uniform continuity of `g` there. -/
theorem wolfePowellLineSearch_globalConvergence_of_uniformContinuousOn
    (f : E → ℝ)
    (g : E → E)
    (x s : ℕ → E)
    (α : ℕ → ℝ)
    (ρ σ μ : ℝ)
    (h_wolfe : WolfePowellParameters ρ σ)
    (h_hasGradientAt : ∀ k : ℕ, HasGradientVectorAt f (g (x k)) (x k))
    (h_hasGradientOnInitialSublevelSet :
      ∀ y ∈ initialSublevelSet f (x 0), HasGradientVectorAt f (g y) y)
    (h_gradUniform : UniformContinuousOn g (initialSublevelSet f (x 0)))
    (h_alphaPos : ∀ k : ℕ, g (x k) ≠ 0 → 0 < α k)
    (h_update : ∀ k : ℕ, g (x k) ≠ 0 → x (k + 1) = x k + α k • s k)
    (h_descent : ∀ k : ℕ, g (x k) ≠ 0 → inner ℝ (g (x k)) (s k) < 0)
    (h_armijo :
      ∀ k : ℕ, g (x k) ≠ 0 →
        f (x k + α k • s k) ≤
          f (x k) + ρ * α k * inner ℝ (g (x k)) (s k))
    (h_curvature :
      ∀ k : ℕ, g (x k) ≠ 0 →
        σ * inner ℝ (g (x k)) (s k) ≤
          inner ℝ (g (x (k + 1))) (s k))
    (hμ : 0 < μ)
    (h_angle :
      ∀ k : ℕ, g (x k) ≠ 0 →
        InnerProductGeometry.angle (s k) (-(g (x k))) ≤ Real.pi / 2 - μ) :
    (∃ k : ℕ, g (x k) = 0) ∨
      Tendsto (fun k : ℕ ↦ f (x k)) atTop atBot ∨
      Tendsto (fun k : ℕ ↦ g (x k)) atTop (nhds 0) := by
  have h_lineSearch :
      ∀ k : ℕ, g (x k) ≠ 0 →
        InexactLineSearchAcceptance
          f (x k) (g (x k)) (g (x (k + 1))) (s k) (α k) := by
    intro k hk
    exact Or.inr ⟨ρ, σ, h_wolfe, h_alphaPos k hk, by
      simpa [lineSearchObjective_apply, lineSearchObjective_zero] using h_armijo k hk,
      h_curvature k hk⟩
  let A : InexactLineSearchMethod f g :=
    { ε := 0
      x0 := x 0
      x := x
      d := s
      α := α
      epsilon_nonneg := le_rfl
      x_zero := rfl
      gradientAt := h_hasGradientAt
      descentDirection := fun k hk ↦
        h_descent k <| by
          simpa [norm_eq_zero] using hk.ne'
      lineSearch := fun k hk ↦
        h_lineSearch k <| by
          simpa [norm_eq_zero] using hk.ne'
      update := fun k hk ↦
        h_update k <| by
          simpa [norm_eq_zero] using hk.ne' }
  exact
    inexactLineSearch_globalConvergence
      A μ rfl h_hasGradientOnInitialSublevelSet h_gradUniform hμ h_angle

/-- Chapter02 Theorem 2.5.7 in source-facing gradient-field form: let `g` be a gradient field
for `f`, meaning `HasGradientVectorAt f (g y) y` for every `y`, and assume `g` satisfies the
Lipschitz bound `‖g x - g y‖ ≤ M * ‖x - y‖` for all `x` and `y`. Let `x`, `s`, and `α`
be generated by Chapter02 Algorithm 2.5.3 in the Wolfe-Powell branch, so that on every
nonstationary iterate `x k` the direction `s k` is a descent direction, the accepted
steplength `α k` is positive, the update is `x (k + 1) = x k + α k • s k`, and the
sufficient-decrease and curvature inequalities `(2.5.3)` and `(2.5.7)` hold. If the angle
condition `(2.5.17)` is satisfied, here written as the existence of `μ > 0` with
`InnerProductGeometry.angle (s k) (-(g (x k))) ≤ Real.pi / 2 - μ` whenever
`g (x k) ≠ 0`, then either `g (x k) = 0` for some `k`, or `f (x k) ⟶ -∞`, or
`g (x k) ⟶ 0`. -/
theorem wolfePowellLineSearch_globalConvergence
    (f : E → ℝ)
    (g : E → E)
    (x s : ℕ → E)
    (α : ℕ → ℝ)
    (ρ σ M μ : ℝ)
    (h_wolfe : WolfePowellParameters ρ σ)
    (h_hasGradient : ∀ y : E, HasGradientVectorAt f (g y) y)
    (h_gradLipschitz : ∀ x' y' : E, ‖g x' - g y'‖ ≤ M * ‖x' - y'‖)
    (h_alphaPos : ∀ k : ℕ, g (x k) ≠ 0 → 0 < α k)
    (h_update : ∀ k : ℕ, g (x k) ≠ 0 → x (k + 1) = x k + α k • s k)
    (h_descent : ∀ k : ℕ, g (x k) ≠ 0 → inner ℝ (g (x k)) (s k) < 0)
    (h_armijo :
      ∀ k : ℕ, g (x k) ≠ 0 →
        f (x k + α k • s k) ≤
          f (x k) + ρ * α k * inner ℝ (g (x k)) (s k))
    (h_curvature :
      ∀ k : ℕ, g (x k) ≠ 0 →
        σ * inner ℝ (g (x k)) (s k) ≤
          inner ℝ (g (x (k + 1))) (s k))
    (hμ : 0 < μ)
    (h_angle :
      ∀ k : ℕ, g (x k) ≠ 0 →
        InnerProductGeometry.angle (s k) (-(g (x k))) ≤ Real.pi / 2 - μ) :
    (∃ k : ℕ, g (x k) = 0) ∨
      Tendsto (fun k : ℕ ↦ f (x k)) atTop atBot ∨
      Tendsto (fun k : ℕ ↦ g (x k)) atTop (nhds 0) := by
  have h_gradUniform :
      UniformContinuousOn g (initialSublevelSet f (x 0)) := by
    let hL :
        LipschitzOnWith (Real.toNNReal M) g (initialSublevelSet f (x 0)) :=
      LipschitzOnWith.of_dist_le' fun x _ y _ ↦ by
        simpa [dist_eq_norm] using h_gradLipschitz x y
    exact hL.uniformContinuousOn
  exact
    wolfePowellLineSearch_globalConvergence_of_uniformContinuousOn
      f g x s α ρ σ μ h_wolfe (fun k ↦ h_hasGradient (x k)) (fun y _ ↦ h_hasGradient y)
      h_gradUniform h_alphaPos h_update h_descent h_armijo h_curvature hμ h_angle

/-- On a complete real inner-product space, the canonical-gradient formulation of
Chapter02 Theorem 2.5.7 is recovered from the source-facing gradient-field theorem above. -/
theorem wolfePowellLineSearch_globalConvergence_of_contDiff
    [CompleteSpace E]
    (f : E → ℝ)
    (x s : ℕ → E)
    (α : ℕ → ℝ)
    (ρ σ M μ : ℝ)
    (h_wolfe : WolfePowellParameters ρ σ)
    (h_contDiff : ContDiff ℝ 1 f)
    (h_gradLipschitz : ∀ x' y' : E, ‖∇ f x' - ∇ f y'‖ ≤ M * ‖x' - y'‖)
    (h_alphaPos : ∀ k : ℕ, ∇ f (x k) ≠ 0 → 0 < α k)
    (h_update : ∀ k : ℕ, ∇ f (x k) ≠ 0 → x (k + 1) = x k + α k • s k)
    (h_descent : ∀ k : ℕ, ∇ f (x k) ≠ 0 → inner ℝ (∇ f (x k)) (s k) < 0)
    (h_armijo :
      ∀ k : ℕ, ∇ f (x k) ≠ 0 →
        f (x k + α k • s k) ≤
          f (x k) + ρ * α k * inner ℝ (∇ f (x k)) (s k))
    (h_curvature :
      ∀ k : ℕ, ∇ f (x k) ≠ 0 →
        σ * inner ℝ (∇ f (x k)) (s k) ≤
          inner ℝ (∇ f (x (k + 1))) (s k))
    (hμ : 0 < μ)
    (h_angle :
      ∀ k : ℕ, ∇ f (x k) ≠ 0 →
        InnerProductGeometry.angle (s k) (-(∇ f (x k))) ≤ Real.pi / 2 - μ) :
    (∃ k : ℕ, ∇ f (x k) = 0) ∨
      Tendsto (fun k : ℕ ↦ f (x k)) atTop atBot ∨
      Tendsto (fun k : ℕ ↦ ∇ f (x k)) atTop (nhds 0) := by
  have h_hasGradient : ∀ y : E, HasGradientVectorAt f (∇ f y) y := fun y ↦ by
    rw [hasGradientVectorAt_iff_hasGradientAt]
    exact ((show ContDiffAt ℝ 1 f y from h_contDiff.contDiffAt).differentiableAt_one).hasGradientAt
  exact
    wolfePowellLineSearch_globalConvergence
      f (∇ f) x s α ρ σ M μ h_wolfe h_hasGradient h_gradLipschitz
      h_alphaPos h_update h_descent h_armijo h_curvature hμ h_angle

end
