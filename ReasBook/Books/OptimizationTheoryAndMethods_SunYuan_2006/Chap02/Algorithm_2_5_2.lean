import OptimizationTheoryAndMethods_SunYuan_2006.Compat
import OptimizationTheoryAndMethods_SunYuan_2006.Chap02.Definition_2_1_extra_1
import OptimizationTheoryAndMethods_SunYuan_2006.Chap02.Definition_2_5_extra_4
import Mathlib.Analysis.InnerProductSpace.Basic

/-- The backtracking trial-step sequence generated by the recorded shrink factors `ωs`,
starting from the full step `1` and continuing with the lower shrink bound `l` after the
recorded trace ends. -/
def backtrackingArmijoStepSizes (l : ℝ) : List ℝ → ℕ → ℝ
  | _, 0 => 1
  | [], n + 1 => l * backtrackingArmijoStepSizes l [] n
  | ω :: ωs, n + 1 => ω * backtrackingArmijoStepSizes l ωs n

/-- The recorded Armijo backtracking trial sequence stays positive when every recorded
shrink factor lies in `[l, u]` and `l > 0`. -/
theorem backtrackingArmijoStepSizes_pos
    {l u : ℝ} (hl : 0 < l) {ωs : List ℝ}
    (hωs : ∀ ω ∈ ωs, ω ∈ Set.Icc l u) (n : ℕ) :
    0 < backtrackingArmijoStepSizes l ωs n := by
  induction n generalizing ωs with
  | zero =>
      simp [backtrackingArmijoStepSizes]
  | succ n ih =>
      cases ωs with
      | nil =>
          have hnil : ∀ ω ∈ ([] : List ℝ), ω ∈ Set.Icc l u := by
            intro ω hω
            cases hω
          simpa [backtrackingArmijoStepSizes] using
            mul_pos hl (ih hnil)
      | cons ω ωs =>
          have hω : 0 < ω := lt_of_lt_of_le hl (hωs ω (by simp)).1
          have htail : ∀ ω' ∈ ωs, ω' ∈ Set.Icc l u := fun ω' hω' ↦
            hωs ω' (by simp [hω'])
          simpa [backtrackingArmijoStepSizes] using
            mul_pos hω (ih htail)

/-- The recorded Armijo backtracking trial sequence strictly decreases when
`0 < l < u < 1` and every recorded shrink factor lies in `[l, u]`. -/
theorem backtrackingArmijoStepSizes_strictReduction
    {l u : ℝ} (hl : 0 < l) (hlu : l < u) (hu : u < 1) {ωs : List ℝ}
    (hωs : ∀ ω ∈ ωs, ω ∈ Set.Icc l u) (n : ℕ) :
    backtrackingArmijoStepSizes l ωs (n + 1) < backtrackingArmijoStepSizes l ωs n := by
  induction n generalizing ωs with
  | zero =>
      cases ωs with
      | nil =>
          simpa [backtrackingArmijoStepSizes] using lt_trans hlu hu
      | cons ω ωs =>
          have hω_lt_one : ω < 1 := lt_of_le_of_lt (hωs ω (by simp)).2 hu
          simpa [backtrackingArmijoStepSizes] using hω_lt_one
  | succ n ih =>
      cases ωs with
      | nil =>
          have hnil : ∀ ω ∈ ([] : List ℝ), ω ∈ Set.Icc l u := by
            intro ω hω
            cases hω
          simpa [backtrackingArmijoStepSizes] using
            mul_lt_mul_of_pos_left
              (ih hnil) hl
      | cons ω ωs =>
          have hω : 0 < ω := lt_of_lt_of_le hl (hωs ω (by simp)).1
          have htail : ∀ ω' ∈ ωs, ω' ∈ Set.Icc l u := fun ω' hω' ↦
            hωs ω' (by simp [hω'])
          simpa [backtrackingArmijoStepSizes] using
            mul_lt_mul_of_pos_left (ih htail) hω

/-- The trial-step sequence generated by Armijo backtracking data is a canonical
backtracking step sequence. -/
theorem isBacktrackingStepSequence_backtrackingArmijoStepSizes
    {l u : ℝ} (hl : 0 < l) (hlu : l < u) (hu : u < 1) {ωs : List ℝ}
    (hωs : ∀ ω ∈ ωs, ω ∈ Set.Icc l u) :
    IsBacktrackingStepSequence (backtrackingArmijoStepSizes l ωs) := by
  refine
    { start := by simp [backtrackingArmijoStepSizes]
      step_pos := fun n ↦ backtrackingArmijoStepSizes_pos hl hωs n
      strictReduction := fun n ↦
        backtrackingArmijoStepSizes_strictReduction hl hlu hu hωs n }

section Armijo

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]

-- Source/core/bridge triage:
-- * source-facing: a successful Armijo backtracking step with shrink factors in `[l, u]`,
--   recorded by its finite accepted/rejected trial trace;
-- * core/canonical: `lineSearchObjective` and `IsBacktrackingLineSearchStep`;
-- * bridge/view: the derived theorem `toIsBacktrackingLineSearchStep` packaging the finite
--   Armijo trace as the canonical least-index backtracking owner.

/-- The Armijo sufficient-decrease test along the search ray from `x` in direction `d`. -/
def armijoBacktrackingAccepts (f : E → ℝ) (ρ : ℝ) (x g d : E) (α : ℝ) : Prop :=
  lineSearchObjective f x d α ≤ lineSearchObjective f x d 0 + ρ * α * inner ℝ g d

/-- Unfolding `armijoBacktrackingAccepts` recovers the explicit Armijo inequality at
`x + α • d`. -/
theorem armijoBacktrackingAccepts_iff
    (f : E → ℝ) (ρ : ℝ) (x g d : E) (α : ℝ) :
    armijoBacktrackingAccepts f ρ x g d α ↔
      f (x + α • d) ≤ f x + ρ * α * inner ℝ g d := by
  simp [armijoBacktrackingAccepts, lineSearchObjective]

/-- Chapter02 Algorithm 2.5.2: a successful backtracking Armijo step uses parameters
`ρ ∈ (0, 1 / 2)` and `0 < l < u < 1`, starts from `α = 1`, multiplies by recorded shrink
factors `ω ∈ [l, u]`, accepts the final recorded trial, and rejects every earlier recorded
trial. The generic backtracking owner is derived from this finite source-facing trace. -/
class IsBacktrackingArmijoLineSearchStep
    (f : E → ℝ) (xk gk dk : E) (ρ l u : ℝ) (ωs : List ℝ) : Prop where
  rho_mem : ρ ∈ Set.Ioo (0 : ℝ) (1 / 2 : ℝ)
  l_pos : 0 < l
  l_lt_u : l < u
  u_lt_one : u < 1
  shrinkFactors_mem : ∀ ω ∈ ωs, ω ∈ Set.Icc l u
  accepted :
    armijoBacktrackingAccepts f ρ xk gk dk (backtrackingArmijoStepSizes l ωs ωs.length)
  rejectedBefore :
    ∀ n < ωs.length,
      ¬ armijoBacktrackingAccepts f ρ xk gk dk (backtrackingArmijoStepSizes l ωs n)

/-- A backtracking Armijo witness is proposition-valued, hence subsingleton. -/
instance isBacktrackingArmijoLineSearchStepSubsingleton
    (f : E → ℝ) (xk gk dk : E) (ρ l u : ℝ) (ωs : List ℝ) :
    Subsingleton (IsBacktrackingArmijoLineSearchStep f xk gk dk ρ l u ωs) := inferInstance

/-- Expanding `IsBacktrackingArmijoLineSearchStep` gives the Armijo parameter bounds,
the shrink-factor constraints, and the accepted/rejected finite Armijo trace. -/
theorem isBacktrackingArmijoLineSearchStep_iff
    {f : E → ℝ} {xk gk dk : E} {ρ l u : ℝ} {ωs : List ℝ} :
    IsBacktrackingArmijoLineSearchStep f xk gk dk ρ l u ωs ↔
      ρ ∈ Set.Ioo (0 : ℝ) (1 / 2 : ℝ) ∧
        0 < l ∧
        l < u ∧
        u < 1 ∧
        (∀ ω ∈ ωs, ω ∈ Set.Icc l u) ∧
        armijoBacktrackingAccepts f ρ xk gk dk
          (backtrackingArmijoStepSizes l ωs ωs.length) ∧
        ∀ n < ωs.length,
          ¬ armijoBacktrackingAccepts f ρ xk gk dk (backtrackingArmijoStepSizes l ωs n) := by
  constructor
  · intro h
    exact
      ⟨h.rho_mem, h.l_pos, h.l_lt_u, h.u_lt_one, h.shrinkFactors_mem, h.accepted,
        h.rejectedBefore⟩
  · rintro ⟨hρ, hl, hlu, hu, hωs, hAccepted, hRejected⟩
    exact
      { rho_mem := hρ
        l_pos := hl
        l_lt_u := hlu
        u_lt_one := hu
        shrinkFactors_mem := hωs
        accepted := hAccepted
        rejectedBefore := hRejected }

namespace IsBacktrackingArmijoLineSearchStep

/-- The recorded Armijo shrink data induces a canonical backtracking step sequence. -/
theorem toIsBacktrackingStepSequence
    {f : E → ℝ} {xk gk dk : E} {ρ l u : ℝ} {ωs : List ℝ}
    (h : IsBacktrackingArmijoLineSearchStep f xk gk dk ρ l u ωs) :
    IsBacktrackingStepSequence (backtrackingArmijoStepSizes l ωs) :=
  isBacktrackingStepSequence_backtrackingArmijoStepSizes
    h.l_pos h.l_lt_u h.u_lt_one h.shrinkFactors_mem

/-- The finite accepted/rejected Armijo trace packages into the canonical least-index
backtracking owner on the induced trial sequence. -/
theorem toIsBacktrackingLineSearchStep
    {f : E → ℝ} {xk gk dk : E} {ρ l u : ℝ} {ωs : List ℝ}
    (h : IsBacktrackingArmijoLineSearchStep f xk gk dk ρ l u ωs) :
    IsBacktrackingLineSearchStep
      (fun α _ ↦ armijoBacktrackingAccepts f ρ xk gk dk α)
      xk
      dk
      (backtrackingArmijoStepSizes l ωs)
      ωs.length := by
  refine (isBacktrackingLineSearchStep_iff_accepts_rejects _ _ _ _ _).2 ?_
  exact ⟨h.toIsBacktrackingStepSequence, h.accepted, h.rejectedBefore⟩

/-- The accepted Armijo trial is positive. -/
theorem acceptedStep_pos
    {f : E → ℝ} {xk gk dk : E} {ρ l u : ℝ} {ωs : List ℝ}
    (h : IsBacktrackingArmijoLineSearchStep f xk gk dk ρ l u ωs) :
    0 < backtrackingArmijoStepSizes l ωs ωs.length :=
  backtrackingArmijoStepSizes_pos h.l_pos h.shrinkFactors_mem ωs.length

/-- The accepted trial satisfies the Armijo sufficient-decrease inequality. -/
theorem accepts
    {f : E → ℝ} {xk gk dk : E} {ρ l u : ℝ} {ωs : List ℝ}
    (h : IsBacktrackingArmijoLineSearchStep f xk gk dk ρ l u ωs) :
    armijoBacktrackingAccepts f ρ xk gk dk (backtrackingArmijoStepSizes l ωs ωs.length) :=
  h.accepted

/-- Every earlier recorded trial step fails the Armijo sufficient-decrease test. -/
theorem not_accepts_of_lt
    {f : E → ℝ} {xk gk dk : E} {ρ l u : ℝ} {ωs : List ℝ} {n : ℕ}
    (h : IsBacktrackingArmijoLineSearchStep f xk gk dk ρ l u ωs)
    (hn : n < ωs.length) :
    ¬ armijoBacktrackingAccepts f ρ xk gk dk (backtrackingArmijoStepSizes l ωs n) :=
  h.rejectedBefore n hn

/-- The accepted Armijo trial is the least accepted index in the induced step sequence. -/
theorem isLeastAcceptedIndex
    {f : E → ℝ} {xk gk dk : E} {ρ l u : ℝ} {ωs : List ℝ}
    (h : IsBacktrackingArmijoLineSearchStep f xk gk dk ρ l u ωs) :
    IsLeast
      {m : ℕ | armijoBacktrackingAccepts f ρ xk gk dk (backtrackingArmijoStepSizes l ωs m)}
      ωs.length := by
  simpa using h.toIsBacktrackingLineSearchStep.isLeastAcceptedIndex

end IsBacktrackingArmijoLineSearchStep

end Armijo

section TrialPoint

variable {E : Type} [Add E] [SMul ℝ E]

namespace IsBacktrackingArmijoLineSearchStep

/-- Evaluating the accepted trial point gives the update formula `xk + αk • dk`. -/
theorem acceptedTrialPoint_eq
    (xk dk : E) (l : ℝ) (ωs : List ℝ) :
    backtrackingTrialPoint xk dk (backtrackingArmijoStepSizes l ωs) ωs.length =
      xk + backtrackingArmijoStepSizes l ωs ωs.length • dk :=
  rfl

end IsBacktrackingArmijoLineSearchStep

end TrialPoint
