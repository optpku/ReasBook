import OptimizationTheoryAndMethods_SunYuan_2006.Compat
import Mathlib.Data.Real.Basic
import Mathlib.Order.Interval.Set.Basic
import Mathlib.Order.Interval.Set.UnorderedInterval
import OptimizationTheoryAndMethods_SunYuan_2006.Chap02.Definition_2_1_1

noncomputable section

-- Domain sampling for this item:
-- * `IsSearchInterval` from `Definition_2_1_1` is the chapter owner for the terminal output notion.
-- * `Set.uIcc` from mathlib is the canonical owner for the unordered closed interval between two
--   real endpoints.
-- * `quadraticInterpolationSequence` in `Algorithm_2_4_2` owns its recursive stage family directly.
-- * `GoldenSectionMethod.searchInterval` in `Algorithm_2_3_1` is derived API sitting above the
--   stage data rather than a second owner.
-- The source-facing owner here is therefore the recursive family `(α_k, h_k)` from Algorithm
-- 2.1.2 itself. Primitive data are `φ`, `α₀`, `h₀`, and `t`; the terminal bracket and
-- `IsSearchInterval` statement are derived bridge API.

/-- The two admissible textbook Step 1 initializations for Algorithm 2.1.2. -/
def ForwardBackwardStart (φ : ℝ → ℝ) (α0 h0 α h : ℝ) : Prop :=
  (φ (α0 + h0) < φ α0 ∧ α = α0 ∧ h = h0) ∨
    (φ α0 < φ (α0 + h0) ∧ α = α0 + h0 ∧ h = -h0)

/-- Unfolding `ForwardBackwardStart` recovers the two textbook Step 1 branches. -/
theorem forwardBackwardStart_iff
    {φ : ℝ → ℝ} {α0 h0 α h : ℝ} :
    ForwardBackwardStart φ α0 h0 α h ↔
      (φ (α0 + h0) < φ α0 ∧ α = α0 ∧ h = h0) ∨
        (φ α0 < φ (α0 + h0) ∧ α = α0 + h0 ∧ h = -h0) :=
  Iff.rfl

namespace ForwardBackward

/-- The recursively generated stage pair `(α_k, h_k)` from Algorithm 2.1.2. After the first
failure of decrease, the recursion remains constant; the actual terminal stage is recorded
separately by `IsTerminalIndex`. -/
private def state (φ : ℝ → ℝ) (α0 h0 t : ℝ) : ℕ → ℝ × ℝ
  | 0 =>
      if φ (α0 + h0) < φ α0 then
        (α0, h0)
      else
        (α0 + h0, -h0)
  | k + 1 =>
      let stage := state φ α0 h0 t k
      if φ (stage.1 + stage.2) < φ stage.1 then
        (stage.1 + stage.2, t * stage.2)
      else
        stage

/-- The accepted scalar stage `α_k` generated by Algorithm 2.1.2 from `α₀`, `h₀`, and `t`. -/
def alpha (φ : ℝ → ℝ) (α0 h0 t : ℝ) (k : ℕ) : ℝ :=
  (state φ α0 h0 t k).1

/-- The step length `h_k` generated by Algorithm 2.1.2 from `α₀`, `h₀`, and `t`. -/
def h (φ : ℝ → ℝ) (α0 h0 t : ℝ) (k : ℕ) : ℝ :=
  (state φ α0 h0 t k).2

/-- The comparison point `α_k + h_k` tested at stage `k`. -/
def trialPoint (φ : ℝ → ℝ) (α0 h0 t : ℝ) (k : ℕ) : ℝ :=
  alpha φ α0 h0 t k + h φ α0 h0 t k

/-- The stage-zero values agree with one of the two textbook Step 1 initializations whenever the
initial comparison is strict. -/
theorem start_zero_of_ne
    {φ : ℝ → ℝ} {α0 h0 t : ℝ} (hne : φ (α0 + h0) ≠ φ α0) :
    ForwardBackwardStart φ α0 h0 (alpha φ α0 h0 t 0) (h φ α0 h0 t 0) := by
  by_cases hlt : φ (α0 + h0) < φ α0
  · left
    simp [alpha, h, state, hlt]
  · right
    have hgt : φ α0 < φ (α0 + h0) :=
      lt_of_le_of_ne (le_of_not_gt hlt) (Ne.symm hne)
    simp [alpha, h, state, hlt, hgt]

private theorem state_succ_eq_of_strictDecrease
    {φ : ℝ → ℝ} {α0 h0 t : ℝ} {k : ℕ}
    (hdecr : φ (trialPoint φ α0 h0 t k) < φ (alpha φ α0 h0 t k)) :
    state φ α0 h0 t (k + 1) = (trialPoint φ α0 h0 t k, t * h φ α0 h0 t k) := by
  dsimp [trialPoint, alpha, h] at hdecr ⊢
  simp [state, hdecr]

private theorem state_succ_eq_of_terminalFailure
    {φ : ℝ → ℝ} {α0 h0 t : ℝ} {k : ℕ}
    (hfail : φ (trialPoint φ α0 h0 t k) ≥ φ (alpha φ α0 h0 t k)) :
    state φ α0 h0 t (k + 1) = (alpha φ α0 h0 t k, h φ α0 h0 t k) := by
  dsimp [trialPoint, alpha, h] at hfail ⊢
  have hnot : ¬ φ ((state φ α0 h0 t k).1 + (state φ α0 h0 t k).2) < φ (state φ α0 h0 t k).1 :=
    not_lt.mpr hfail
  simp [state, hnot]

/-- A strict decrease at stage `k` forces the next accepted point to be the current trial point. -/
theorem alpha_succ_eq_trialPoint_of_strictDecrease
    {φ : ℝ → ℝ} {α0 h0 t : ℝ} {k : ℕ}
    (hdecr : φ (trialPoint φ α0 h0 t k) < φ (alpha φ α0 h0 t k)) :
    alpha φ α0 h0 t (k + 1) = trialPoint φ α0 h0 t k := by
  simpa [alpha] using congrArg Prod.fst (state_succ_eq_of_strictDecrease hdecr)

/-- A strict decrease at stage `k` expands the next step size by the factor `t`. -/
theorem h_succ_eq_of_strictDecrease
    {φ : ℝ → ℝ} {α0 h0 t : ℝ} {k : ℕ}
    (hdecr : φ (trialPoint φ α0 h0 t k) < φ (alpha φ α0 h0 t k)) :
    h φ α0 h0 t (k + 1) = t * h φ α0 h0 t k := by
  simpa [h] using congrArg Prod.snd (state_succ_eq_of_strictDecrease hdecr)

/-- Once stage `k` fails to decrease `φ`, the recursive stage pair remains unchanged at stage
`k + 1`. -/
theorem alpha_succ_eq_of_terminalFailure
    {φ : ℝ → ℝ} {α0 h0 t : ℝ} {k : ℕ}
    (hfail : φ (trialPoint φ α0 h0 t k) ≥ φ (alpha φ α0 h0 t k)) :
    alpha φ α0 h0 t (k + 1) = alpha φ α0 h0 t k := by
  simpa [alpha] using congrArg Prod.fst (state_succ_eq_of_terminalFailure hfail)

/-- Once stage `k` fails to decrease `φ`, the step length remains unchanged at stage `k + 1`. -/
theorem h_succ_eq_of_terminalFailure
    {φ : ℝ → ℝ} {α0 h0 t : ℝ} {k : ℕ}
    (hfail : φ (trialPoint φ α0 h0 t k) ≥ φ (alpha φ α0 h0 t k)) :
    h φ α0 h0 t (k + 1) = h φ α0 h0 t k := by
  simpa [h] using congrArg Prod.snd (state_succ_eq_of_terminalFailure hfail)

/-- `k` is a textbook terminal stage of Algorithm 2.1.2 when `k > 0`, every earlier stage
strictly decreases `φ`, and stage `k` is the first recorded failure. The stage-zero Step 1
initialization is derived from the strict-decrease clause at `j = 0`. This is a bridge/view
predicate over the recursive owners `alpha` and `h`, not a second owner object. -/
def IsTerminalIndex (φ : ℝ → ℝ) (α0 h0 t : ℝ) (k : ℕ) : Prop :=
  0 < k ∧
    (∀ j : ℕ, j < k → φ (trialPoint φ α0 h0 t j) < φ (alpha φ α0 h0 t j)) ∧
    φ (trialPoint φ α0 h0 t k) ≥ φ (alpha φ α0 h0 t k)

/-- Unfolding `IsTerminalIndex` recovers the source terminal-stage conditions. -/
theorem isTerminalIndex_iff
    {φ : ℝ → ℝ} {α0 h0 t : ℝ} {k : ℕ} :
    IsTerminalIndex φ α0 h0 t k ↔
      0 < k ∧
        (∀ j : ℕ, j < k → φ (trialPoint φ α0 h0 t j) < φ (alpha φ α0 h0 t j)) ∧
        φ (trialPoint φ α0 h0 t k) ≥ φ (alpha φ α0 h0 t k) :=
  Iff.rfl

/-- A textbook terminal index carries one of the two strict Step 1 initializations. -/
theorem start {φ : ℝ → ℝ} {α0 h0 t : ℝ} {k : ℕ}
    (hk : IsTerminalIndex φ α0 h0 t k) :
    ForwardBackwardStart φ α0 h0 (alpha φ α0 h0 t 0) (h φ α0 h0 t 0) := by
  have hzero : φ (trialPoint φ α0 h0 t 0) < φ (alpha φ α0 h0 t 0) :=
    hk.2.1 0 hk.1
  have hne : φ (α0 + h0) ≠ φ α0 := by
    by_cases hlt : φ (α0 + h0) < φ α0
    · exact ne_of_lt hlt
    · have hgt : φ α0 < φ (α0 + h0) := by
        simpa [trialPoint, alpha, h, state, hlt] using hzero
      exact Ne.symm (ne_of_lt hgt)
  exact start_zero_of_ne hne

/-- A textbook terminal stage is positive, so the previous accepted point `α_(k-1)` is defined. -/
theorem pos {φ : ℝ → ℝ} {α0 h0 t : ℝ} {k : ℕ}
    (hk : IsTerminalIndex φ α0 h0 t k) :
    0 < k :=
  hk.1

/-- Every stage before a textbook terminal index strictly decreases `φ`. -/
theorem strictDecrease {φ : ℝ → ℝ} {α0 h0 t : ℝ} {k j : ℕ}
    (hk : IsTerminalIndex φ α0 h0 t k) (hj : j < k) :
    φ (trialPoint φ α0 h0 t j) < φ (alpha φ α0 h0 t j) :=
  hk.2.1 j hj

/-- On every stage before the terminal one, the next accepted point is the current trial point. -/
theorem alpha_succ_eq_trialPoint {φ : ℝ → ℝ} {α0 h0 t : ℝ} {k j : ℕ}
    (hk : IsTerminalIndex φ α0 h0 t k) (hj : j < k) :
    alpha φ α0 h0 t (j + 1) = trialPoint φ α0 h0 t j :=
  alpha_succ_eq_trialPoint_of_strictDecrease (strictDecrease hk hj)

/-- On every stage before the terminal one, the step size is multiplied by `t`. -/
theorem h_succ_eq {φ : ℝ → ℝ} {α0 h0 t : ℝ} {k j : ℕ}
    (hk : IsTerminalIndex φ α0 h0 t k) (hj : j < k) :
    h φ α0 h0 t (j + 1) = t * h φ α0 h0 t j :=
  h_succ_eq_of_strictDecrease (strictDecrease hk hj)

/-- The terminal stage is exactly the first recorded failure of decrease. -/
theorem terminalFailure {φ : ℝ → ℝ} {α0 h0 t : ℝ} {k : ℕ}
    (hk : IsTerminalIndex φ α0 h0 t k) :
    φ (trialPoint φ α0 h0 t k) ≥ φ (alpha φ α0 h0 t k) :=
  hk.2.2

/-- The accepted point immediately preceding the positive stage `k`. -/
def previousPoint (φ : ℝ → ℝ) (α0 h0 t : ℝ) : ∀ k : ℕ, 0 < k → ℝ
  | 0, hk => absurd hk (Nat.lt_irrefl 0)
  | k + 1, _ => alpha φ α0 h0 t k

/-- The lower textbook endpoint produced from the positive stage `k`. -/
def lowerEndpoint (φ : ℝ → ℝ) (α0 h0 t : ℝ) (k : ℕ) (hk : 0 < k) : ℝ :=
  min (previousPoint φ α0 h0 t k hk) (trialPoint φ α0 h0 t k)

/-- The upper textbook endpoint produced from the positive stage `k`. -/
def upperEndpoint (φ : ℝ → ℝ) (α0 h0 t : ℝ) (k : ℕ) (hk : 0 < k) : ℝ :=
  max (previousPoint φ α0 h0 t k hk) (trialPoint φ α0 h0 t k)

/-- The closed interval output from the positive stage `k`. -/
def outputInterval (φ : ℝ → ℝ) (α0 h0 t : ℝ) (k : ℕ) (hk : 0 < k) : Set ℝ :=
  Set.uIcc (previousPoint φ α0 h0 t k hk) (trialPoint φ α0 h0 t k)

/-- The output endpoints are ordered. -/
theorem lowerEndpoint_le_upperEndpoint
    {φ : ℝ → ℝ} {α0 h0 t : ℝ} {k : ℕ} (hk : 0 < k) :
    lowerEndpoint φ α0 h0 t k hk ≤ upperEndpoint φ α0 h0 t k hk := by
  exact min_le_max

/-- Helper for Chapter02 Algorithm 2.1.2: the textbook output bracket is the ordered closed
interval with endpoints `lowerEndpoint` and `upperEndpoint`. -/
theorem outputInterval_eq_Icc
    {φ : ℝ → ℝ} {α0 h0 t : ℝ} {k : ℕ} (hk : 0 < k) :
    outputInterval φ α0 h0 t k hk =
      Set.Icc (lowerEndpoint φ α0 h0 t k hk) (upperEndpoint φ α0 h0 t k hk) := by
  -- The unordered bracket from the source is definitionally the ordered interval between `min`
  -- and `max` of the two generating points.
  simp [outputInterval, lowerEndpoint, upperEndpoint, Set.uIcc]

/-- A point lying between the previous accepted point and the failed trial point belongs to the
output interval, regardless of the search direction. -/
theorem mem_outputInterval_of_between
    {φ : ℝ → ℝ} {α0 h0 t αStar : ℝ} {k : ℕ} (hk : 0 < k)
    (hbetween :
      previousPoint φ α0 h0 t k hk ≤ αStar ∧ αStar ≤ trialPoint φ α0 h0 t k ∨
        trialPoint φ α0 h0 t k ≤ αStar ∧ αStar ≤ previousPoint φ α0 h0 t k hk) :
    αStar ∈ outputInterval φ α0 h0 t k hk := by
  -- The source proof treats the output as an unordered bracket, so membership is exactly the
  -- unordered-interval introduction rule in the correct direction.
  rcases hbetween with hbetween | hbetween
  · exact Set.mem_uIcc_of_le hbetween.1 hbetween.2
  · exact Set.mem_uIcc_of_ge hbetween.1 hbetween.2

/-- If both output-generating points are nonnegative, then the output interval lies in the
nonnegative ray. -/
theorem outputInterval_subset_nonneg_of_previous_nonneg_of_trialPoint_nonneg
    {φ : ℝ → ℝ} {α0 h0 t : ℝ} {k : ℕ} (hk : 0 < k)
    (hprevious : 0 ≤ previousPoint φ α0 h0 t k hk)
    (htrial : 0 ≤ trialPoint φ α0 h0 t k) :
    outputInterval φ α0 h0 t k hk ⊆ Set.Ici (0 : ℝ) := by
  -- The lower endpoint is the minimum of two nonnegative generating points.
  have hlower : 0 ≤ lowerEndpoint φ α0 h0 t k hk := by
    exact le_min hprevious htrial
  intro α hα
  -- Rewriting the unordered bracket as an ordered interval exposes the lower-bound field.
  have hα' : α ∈ Set.Icc (lowerEndpoint φ α0 h0 t k hk) (upperEndpoint φ α0 h0 t k hk) := by
    simpa [outputInterval_eq_Icc hk] using hα
  exact le_trans hlower hα'.1

/-- Chapter02 Algorithm 2.1.2: under the natural output facts for the forward-backward method,
the textbook bracket formed from stage `k` is a search interval in the sense of
Chapter02 Definition 2.1.1. -/
theorem isSearchInterval_of_between
    {φ : ℝ → ℝ} {α0 h0 t αStar : ℝ} {k : ℕ} (hk : 0 < k)
    (hmin : IsMinOn φ (Set.Ici 0) αStar)
    (hbetween :
      previousPoint φ α0 h0 t k hk ≤ αStar ∧ αStar ≤ trialPoint φ α0 h0 t k ∨
        trialPoint φ α0 h0 t k ≤ αStar ∧ αStar ≤ previousPoint φ α0 h0 t k hk)
    (hprevious : 0 ≤ previousPoint φ α0 h0 t k hk)
    (htrial : 0 ≤ trialPoint φ α0 h0 t k) :
    IsSearchInterval
      φ αStar (lowerEndpoint φ α0 h0 t k hk) (upperEndpoint φ α0 h0 t k hk) := by
  -- Route correction: close the theorem through the source bracket first, then rewrite that
  -- bracket once into the ordered interval expected by `IsSearchInterval`.
  refine ⟨hmin, ?_, ?_⟩
  -- The minimizer lies in the textbook output bracket by the between-endpoints hypothesis.
  · simpa [outputInterval_eq_Icc hk] using
      mem_outputInterval_of_between hk hbetween
  -- The entire bracket stays in `α ≥ 0` because both generating points are nonnegative.
  · simpa [outputInterval_eq_Icc hk] using
      outputInterval_subset_nonneg_of_previous_nonneg_of_trialPoint_nonneg hk hprevious htrial

end ForwardBackward

end
