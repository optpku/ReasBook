import OptimizationTheoryAndMethods_SunYuan_2006.Compat
import OptimizationTheoryAndMethods_SunYuan_2006.Chap02.Algorithm_2_5_3
import OptimizationTheoryAndMethods_SunYuan_2006.Chap02.InitialSublevelSet
import Mathlib.Geometry.Euclidean.Angle.Unoriented.Basic
import Mathlib.Order.Filter.AtTopBot.Basic

open Filter

section Theorem254

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
variable {f : E → ℝ}
variable {g : E → E}

-- Domain sampling:
-- * source-facing: the global-convergence trichotomy for the Chapter 2 inexact-line-search run;
-- * core/canonical owners inspected in the local chapter API: `InexactLineSearchMethod`,
--   `InexactLineSearchAcceptance`, and the chapter support owner `initialSublevelSet`;
-- * adjacent convergence surfaces checked for statement shape: `exactLineSearch_globalConvergence`
--   in `Theorem_2_2_4` and `wolfePowellLineSearch_globalConvergence` in `Theorem_2_5_7`.
-- Primitive algorithm data belong to the owner object `A : InexactLineSearchMethod f g`; the
-- theorem-specific regularity hypotheses on the initial sublevel set remain external.

namespace InexactLineSearchMethod

/-- For a zero-tolerance inexact line-search method, the owner's continuation condition
`A.ε < ‖g (A k)‖` is exactly the source-facing nonstationary condition
`g (A k) ≠ 0`. -/
theorem continue_iff_gradient_ne_zero
    (A : InexactLineSearchMethod f g)
    (hε : A.ε = 0)
    (k : ℕ) :
    A.ε < ‖g (A k)‖ ↔ g (A k) ≠ 0 := by
  simp [hε]

/-- Under zero tolerance, `stepSpec` can be invoked with the source-facing nonstationary
hypothesis `g (A k) ≠ 0`. -/
theorem stepSpec_of_gradient_ne_zero
    (A : InexactLineSearchMethod f g)
    (hε : A.ε = 0)
    (k : ℕ)
    (hk : g (A k) ≠ 0) :
    inner ℝ (g (A k)) (A.d k) < 0 ∧
      ((∃ ρ : ℝ,
          0 < ρ ∧
          ρ < 1 / 2 ∧
          0 < A.α k ∧
          f (A k + A.α k • A.d k) ≤
            f (A k) + ρ * A.α k * inner ℝ (g (A k)) (A.d k) ∧
          f (A k) + (1 - ρ) * A.α k * inner ℝ (g (A k)) (A.d k) ≤
            f (A k + A.α k • A.d k)) ∨
        (∃ ρ σ : ℝ,
          0 < ρ ∧
          ρ < σ ∧
          σ < 1 ∧
          0 < A.α k ∧
          f (A k + A.α k • A.d k) ≤
            f (A k) + ρ * A.α k * inner ℝ (g (A k)) (A.d k) ∧
          σ * inner ℝ (g (A k)) (A.d k) ≤ inner ℝ (g (A (k + 1))) (A.d k))) ∧
      A (k + 1) = A k + A.α k • A.d k := by
  exact A.stepSpec k ((A.continue_iff_gradient_ne_zero hε k).2 hk)

end InexactLineSearchMethod

/-- Chapter02 Theorem 2.5.4: let `A : InexactLineSearchMethod f g` be generated by
Chapter02 Algorithm 2.5.3 with zero stopping tolerance. Thus `A 0 = A.x0`; each
nonstationary iterate satisfies `A (k + 1) = A k + A.α k • A.d k`; each steplength satisfies
the Step 3 inexact line-search acceptance condition from Chapter02 Algorithm 2.5.3;
the chosen gradient field `g` is the genuine gradient of `f` on
`initialSublevelSet f A.x0`; `g` is uniformly continuous there; `(2.5.17)` holds for some
`μ > 0`. Then either `g (A k) = 0` for some `k`, or `f (A k) ⟶ -∞`, or
`g (A k) ⟶ 0`. -/
theorem inexactLineSearch_globalConvergence
    (A : InexactLineSearchMethod f g)
    (μ : ℝ)
    (hε : A.ε = 0)
    (h_hasGradient :
      ∀ y ∈ initialSublevelSet f A.x0, HasGradientVectorAt f (g y) y)
    (h_gradUniform : UniformContinuousOn g (initialSublevelSet f A.x0))
    (hμ : 0 < μ)
    (h_angle :
      ∀ k : ℕ, g (A k) ≠ 0 →
        InnerProductGeometry.angle (A.d k) (-(g (A k))) ≤ Real.pi / 2 - μ) :
    (∃ k : ℕ, g (A k) = 0) ∨
      Tendsto (fun k : ℕ ↦ f (A k)) atTop atBot ∨
      Tendsto (fun k : ℕ ↦ g (A k)) atTop (nhds 0) := sorry

end Theorem254
