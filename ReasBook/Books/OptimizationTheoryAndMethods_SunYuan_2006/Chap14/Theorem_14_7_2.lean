import OptimizationTheoryAndMethods_SunYuan_2006.Compat
import OptimizationTheoryAndMethods_SunYuan_2006.Chap05.Definition_5_4_extra_1
import OptimizationTheoryAndMethods_SunYuan_2006.Chap14.Definition_14_1_extra_4
import OptimizationTheoryAndMethods_SunYuan_2006.Chap14.Algorithm_14_7_1

noncomputable section

open Filter
open scoped CompositeNonsmooth

section

variable {n m : ℕ}
variable {ρ : (Fin n → ℝ) → ℝ} [IsVectorNorm ρ]

local notation "Point" => Chapter14.Point n
local notation "Method" => @_root_.CompositeNonsmoothTrustRegionMethod n m ρ _
variable (method : Method)

-- Domain sampling:
-- * primary domain: accumulation-point existence for composite nonsmooth trust-region runs;
-- * inspected owner declarations in this domain:
--   `HasSubsequenceTendstoTo` from `Chapter05.Definition_5_4_extra_1` for convergent-subsequence
--   data;
--   `CompositeNonsmoothTrustRegionMethod` from `Algorithm_14_7_1` for the algorithm owner;
--   `IsClarkeStationaryPoint` from `Definition_14_1_extra_4` for the stationary-point owner;
--   `DF[problem](x, d)` from `Lemma_14_6_2` / `Definition_14_6_extra_1` for the owner-level
--   first-order model;
-- * best owner abstraction for the accumulation data: `HasSubsequenceTendstoTo`;
-- * core/canonical owner reused from `Algorithm_14_7_1`:
--   `CompositeNonsmoothTrustRegionMethod`;
-- * canonical stationary-point owner reused from Section 14.1:
--   `IsClarkeStationaryPoint`;
-- * layer triage:
--   - source-facing: `compositeNonsmoothTrustRegion_exists_stationaryAccumulationPoint`, which
--     keeps the textbook convergent-subsequence formulation;
--   - bridge/view:
--     `compositeNonsmoothTrustRegion_exists_clarkeStationaryAccumulationPoint`, which rewrites
--     the same content through the Chapter 5 owner `HasSubsequenceTendstoTo`;
--   - core/canonical owners remain `CompositeNonsmoothTrustRegionMethod`,
--     `HasSubsequenceTendstoTo`, and `IsClarkeStationaryPoint`.

/-- Chapter14 Theorem 14.7.2: let `method` be a run of Algorithm 14.7.1 for a composite
nonsmooth optimization problem with twice continuously differentiable component functions `f_i`.
If the iterate sequence `{x_k}` generated by `method` is bounded, then there exists an
accumulation point `xStar` of `{x_k}`, formalized by a convergent subsequence `φ`, and that
limit is a stationary point of the underlying optimization problem `(14.6.1)`. -/
theorem compositeNonsmoothTrustRegion_exists_stationaryAccumulationPoint
    (method : Method)
    (h_bounded : Bornology.IsBounded (Set.range method.iterate)) :
    ∃ xStar : Point, ∃ φ : ℕ → ℕ,
      StrictMono φ ∧
        Tendsto (method.iterate ∘ φ) atTop (nhds xStar) ∧
        IsClarkeStationaryPoint method.problem xStar := sorry

/-- Theorem 14.7.2 rewritten through the Chapter 5 accumulation-point owner
`HasSubsequenceTendstoTo`. -/
theorem compositeNonsmoothTrustRegion_exists_clarkeStationaryAccumulationPoint
    (method : Method)
    (h_bounded : Bornology.IsBounded (Set.range method.iterate)) :
    ∃ xStar : Point,
      HasSubsequenceTendstoTo method.iterate xStar ∧
        IsClarkeStationaryPoint method.problem xStar := by
  rcases compositeNonsmoothTrustRegion_exists_stationaryAccumulationPoint method h_bounded with
    ⟨xStar, φ, hφmono, hφtendsto, hstationary⟩
  exact
    ⟨xStar, (hasSubsequenceTendstoTo_iff method.iterate xStar).2 ⟨φ, hφmono, hφtendsto⟩,
      hstationary⟩

end
