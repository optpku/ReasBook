import OptimizationTheoryAndMethods_SunYuan_2006.Compat
import OptimizationTheoryAndMethods_SunYuan_2006.Chap14.Algorithm_14_4_1
import Mathlib.Order.Filter.Extr

noncomputable section

open Filter
open Chapter14

section

variable {n : ℕ}

local notation "Point" => Chapter14.Point n

-- Domain-style sampling:
-- * primary domain: convergence statements for the Chapter 14 cutting-plane owner
--   `CuttingPlaneMethod`
-- * inspected project owners: `Chapter14.Point`, `CuttingPlaneMethod`,
--   `CuttingPlaneMethod.optimalValue`, and the Chapter 12 accumulation-point theorem surface
--   `lagrangeNewtonMethod_accumulationPoint_isRoot`
-- * source-facing layer here: Theorem 14.4.2
-- * core/canonical owner reused here: `CuttingPlaneMethod`
-- * primitive data stay upstream in `Algorithm_14_4_1`; this file only adds derived monotonicity,
--   convergence, and accumulation-point theorems over that owner

namespace CuttingPlaneMethod

/-- Chapter14 Theorem 14.4.2 (1): for the sequence `{v_k}` generated by Algorithm 14.4.1, the
tail `v₂, v₃, ...` is monotone increasing. The source indexing is encoded by
`k ↦ method.lowerValue (k + 2)`. -/
theorem lowerValue_tail_monotone
    (method : CuttingPlaneMethod n) :
    Monotone (fun k : ℕ ↦ method.lowerValue (k + 2)) := sorry

/-- Chapter14 Theorem 14.4.2 (2): for the sequence `{v_k}` generated by Algorithm 14.4.1, the
tail `v₂, v₃, ...` converges to the optimal value `f*`, encoded here by `method.optimalValue`. -/
theorem lowerValue_tail_tendsto_optimalValue
    (method : CuttingPlaneMethod n)
    (hBoundedBelow : BddBelow (method.objective '' method.feasibleSet)) :
    Tendsto
      (fun k : ℕ ↦ method.lowerValue (k + 2))
      atTop
      (nhds method.optimalValue) := sorry

/-- Chapter14 Theorem 14.4.2 (3): any accumulation point of the iterate sequence `{x_k}`
generated by Algorithm 14.4.1 is a minimizer of `method.objective` on `method.feasibleSet`.
The source accumulation-point condition is represented by a convergent subsequence
`k ↦ method.iterate (φ k + 1)`. -/
theorem accumulationPoint_isMinOn_feasibleSet
    (method : CuttingPlaneMethod n)
    (hBoundedBelow : BddBelow (method.objective '' method.feasibleSet))
    {xStar : Point} {φ : ℕ → ℕ}
    (hφ : StrictMono φ)
    (hxStar : Tendsto (fun k : ℕ ↦ method.iterate (φ k + 1)) atTop (nhds xStar)) :
    xStar ∈ method.feasibleSet ∧
      IsMinOn method.objective method.feasibleSet xStar := sorry

