section

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

/-- A `C¹` scalar field at `x` is Lipschitz on some closed ball centered at `x`, so it satisfies
the local Lipschitz hypothesis required by the Chapter 14 Clarke differential owner. -/
theorem ContDiffAt.locallyLipschitzAt {f : E → ℝ} {x : E} (hf : ContDiffAt ℝ 1 f x) :
    LocallyLipschitzAt f x := by
  rcases hf.exists_lipschitzOnWith with ⟨K, t, ht, hK⟩
  rcases Metric.mem_nhds_iff.mp ht with ⟨ε, hε, hεball⟩
  refine ⟨ε / 2, by linarith, K, ?_⟩
  intro y hy z hz
  apply hK
  · exact hεball <| Metric.closedBall_subset_ball (by linarith) hy
  · exact hεball <| Metric.closedBall_subset_ball (by linarith) hz

end

section

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

/- Domain sampling:
- primary domain: Clarke differentials of smooth real-valued maps on normed spaces
- source-facing layer in this file: the smooth-function singleton formula for `(∂ᶜ f) x`
- core/canonical owner: `clarkeDifferential`, surfaced by the notation `(∂ᶜ f) x`
- primitive data: only `f` and `x`; smoothness supplies the local Lipschitz input theorem-wise
- sampled project declarations: `clarkeDifferential`, `mem_clarkeDifferential_iff`,
  `ContDiffAt.locallyLipschitzAt`
- sampled mathlib differential bridge: `HasGradientAt.hasFDerivAt`,
  `ContDiffAt.differentiableAt_one`
- bridge/view retained below: on complete inner product spaces, `fderiv ℝ f x` identifies with
  `toDual ℝ E (gradient f x)` by Fréchet-Riesz
-/

/-- Chapter14 Exercise 14.3: if `f` is continuously differentiable at `x`, then the Clarke
generalized differential `∂ᶜ f(x)` is the singleton generated by the Fréchet derivative
`fderiv ℝ f x`, viewed intrinsically in `StrongDual ℝ E`. -/
theorem clarkeDifferential_eq_singleton_fderiv_of_contDiffAt
    (f : E → ℝ) (x : E) (hf : ContDiffAt ℝ 1 f x) :
    (∂ᶜ f) x =
      ({fderiv ℝ f x} : Set (StrongDual ℝ E)) := by
  let L : StrongDual ℝ E := fderiv ℝ f x
  have hstrict : HasStrictFDerivAt f L x := by
    simpa [L] using hf.hasStrictFDerivAt (by norm_num : (1 : WithTop ℕ∞) ≠ 0)
  have hclarkeDirectional : ∀ d : E, fᵒ(x; d) = L d := by
    intro d
    let s : Set (E × ℝ) := clarkeDirectionalDerivWithinDomain Set.univ d
    let l : Filter (E × ℝ) := nhdsWithin ((x : E), (0 : ℝ)) s
    have hs : s = {p : E × ℝ | 0 < p.2} := by
      ext p
      simp [s, clarkeDirectionalDerivWithinDomain]
    have hl_ne : l.NeBot := by
      rw [show l = nhdsWithin ((x : E), (0 : ℝ)) {p : E × ℝ | 0 < p.2} by simp [l, hs]]
      refine (mem_closure_iff_nhdsWithin_neBot.1 ?_)
      rw [Metric.mem_closure_iff]
      intro ε hε
      refine ⟨(x, ε / 2), by simpa using show (0 : ℝ) < ε / 2 by linarith, ?_⟩
      rw [Prod.dist_eq, dist_self, max_lt_iff, Real.dist_eq]
      constructor
      · exact hε
      · rw [zero_sub, abs_of_nonpos (by linarith)]
        linarith
    letI := hl_ne
    let φ : E × ℝ → E × E := fun p ↦ (p.1 + p.2 • d, p.1)
    have hφ : Filter.Tendsto φ l (nhds (x, x)) := by
      have hφ_cont : Continuous φ := by
        continuity
      have hφ_nhds : Filter.Tendsto φ (nhds ((x : E), (0 : ℝ))) (nhds (x, x)) := by
        simpa [φ] using
          ((hφ_cont.continuousAt : ContinuousAt φ ((x : E), (0 : ℝ))).tendsto)
      exact hφ_nhds.comp nhdsWithin_le_nhds
    have hcomp :
        (fun p : E × ℝ ↦ f ((φ p).1) - f ((φ p).2) - L ((φ p).1 - (φ p).2))
          =o[l] fun p : E × ℝ ↦ (φ p).1 - (φ p).2 :=
      hstrict.isLittleO.comp_tendsto hφ
    have hbig :
        (fun p : E × ℝ ↦ (φ p).1 - (φ p).2) =O[l] fun p : E × ℝ ↦ p.2 := by
      have hsmul : Asymptotics.IsBigOWith ‖d‖ l (fun p : E × ℝ ↦ p.2 • d) fun p : E × ℝ ↦ p.2 := by
        refine Asymptotics.isBigOWith_of_le' l ?_
        intro p
        simp [norm_smul, Real.norm_eq_abs, mul_comm]
      simpa [φ] using
        hsmul.isBigO
    have hremainder :
        (fun p : E × ℝ ↦ f (p.1 + p.2 • d) - f p.1 - p.2 * L d) =o[l] fun p : E × ℝ ↦ p.2 := by
      simpa [φ, L.map_smul, smul_eq_mul, mul_comm, mul_left_comm, mul_assoc] using
        hcomp.trans_isBigO hbig
    obtain ⟨ψ, hψ_tendsto, hψ_eq⟩ := hremainder.exists_eq_mul
    have hpos : ∀ᶠ p : E × ℝ in l, 0 < p.2 := by
      change {p : E × ℝ | 0 < p.2} ∈ l
      simpa [l, hs] using
        (self_mem_nhdsWithin : {p : E × ℝ | 0 < p.2} ∈
          nhdsWithin ((x : E), (0 : ℝ)) {p : E × ℝ | 0 < p.2})
    have hquot_eq :
        (fun p : E × ℝ ↦ (f (p.1 + p.2 • d) - f p.1) / p.2) =ᶠ[l] fun p ↦ ψ p + L d := by
      filter_upwards [hψ_eq, hpos] with p hp hp2
      have hp2_ne : p.2 ≠ 0 := ne_of_gt hp2
      have hp' : f (p.1 + p.2 • d) - f p.1 - p.2 * L d = ψ p * p.2 := by
        simpa using hp
      have hp_mul : f (p.1 + p.2 • d) - f p.1 = p.2 * (ψ p + L d) := by
        calc
          f (p.1 + p.2 • d) - f p.1 = ψ p * p.2 + p.2 * L d := by
            exact sub_eq_iff_eq_add.mp hp'
          _ = p.2 * (ψ p + L d) := by ring
      rw [hp_mul, mul_div_cancel_left₀ _ hp2_ne]
    have hquot_tendsto :
        Filter.Tendsto (fun p : E × ℝ ↦ (f (p.1 + p.2 • d) - f p.1) / p.2) l (nhds (L d)) := by
      refine Filter.Tendsto.congr' hquot_eq.symm ?_
      simpa [add_comm] using hψ_tendsto.const_add (L d)
    have hquot_tendsto_ereal :
        Filter.Tendsto
          (fun p : E × ℝ ↦ (((f (p.1 + p.2 • d) - f p.1) / p.2 : ℝ) : EReal))
          l
          (nhds ((L d : ℝ) : EReal)) := by
      exact (EReal.tendsto_coe).2 hquot_tendsto
    rw [clarkeDirectionalDeriv_eq_limsup]
    simpa [l, s] using hquot_tendsto_ereal.limsup_eq
  apply Set.Subset.antisymm
  · intro ξ hξ
    have hξ_mem : ∀ d : E, ξ d ≤ fᵒ(x; d) := (mem_clarkeDifferential_iff f x ξ).mp hξ
    have hξ_eq : ξ = L := by
      ext d
      have hd : ξ d ≤ L d := by
        simpa [hclarkeDirectional d] using hξ_mem d
      have hneg : ξ (-d) ≤ fᵒ(x; -d) := hξ_mem (-d)
      have hd' : L d ≤ ξ d := by
        have hneg' : -ξ d ≤ -L d := by
          simpa [hclarkeDirectional (-d)] using hneg
        exact neg_le_neg_iff.mp hneg'
      exact le_antisymm hd hd'
    have : ξ = fderiv ℝ f x := by
      simpa [L] using hξ_eq
    simpa [Set.mem_singleton_iff] using this
  · intro ξ hξ
    rcases Set.mem_singleton_iff.mp hξ with rfl
    rw [mem_clarkeDifferential_iff]
    intro d
    simp [L, hclarkeDirectional d]

/-- The global `C¹` singleton-Fréchet-derivative formula is the pointwise formula applied at
`x`. -/
theorem clarkeDifferential_eq_singleton_fderiv_of_contDiff
    (f : E → ℝ) (x : E) (hf : ContDiff ℝ 1 f) :
    (∂ᶜ f) x =
      ({fderiv ℝ f x} : Set (StrongDual ℝ E)) := by
  simpa using
    clarkeDifferential_eq_singleton_fderiv_of_contDiffAt f x hf.contDiffAt

/-- Under the local `C¹` hypothesis at `x`, membership in `∂ᶜ f(x)` is equivalent to being the
Fréchet derivative `fderiv ℝ f x`. -/
theorem mem_clarkeDifferential_iff_eq_fderiv_of_contDiffAt
    (f : E → ℝ) (x : E) (ξ : StrongDual ℝ E) (hf : ContDiffAt ℝ 1 f x) :
    ξ ∈ (∂ᶜ f) x ↔
      ξ = fderiv ℝ f x := by
  rw [clarkeDifferential_eq_singleton_fderiv_of_contDiffAt f x hf]
  simp

/-- For a globally `C¹` function, membership in `∂ᶜ f(x)` is equivalent to being the Fréchet
derivative `fderiv ℝ f x`. -/
theorem mem_clarkeDifferential_iff_eq_fderiv_of_contDiff
    (f : E → ℝ) (x : E) (ξ : StrongDual ℝ E) (hf : ContDiff ℝ 1 f) :
    ξ ∈ (∂ᶜ f) x ↔
      ξ = fderiv ℝ f x := by
  simpa using
    mem_clarkeDifferential_iff_eq_fderiv_of_contDiffAt f x ξ hf.contDiffAt

end

section

open InnerProductSpace

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]

/-- On a real Hilbert space, the intrinsic singleton-derivative formula becomes the usual
singleton-gradient formula through the Fréchet-Riesz identification
`fderiv ℝ f x = toDual ℝ E (gradient f x)`. -/
theorem clarkeDifferential_eq_singleton_gradient_of_contDiffAt
    (f : E → ℝ) (x : E) (hf : ContDiffAt ℝ 1 f x) :
    (∂ᶜ f) x =
      ({toDual ℝ E (gradient f x)} : Set (StrongDual ℝ E)) := by
  have h_gradient : HasGradientAt f (gradient f x) x :=
    hf.differentiableAt_one.hasGradientAt
  have h_fderiv : fderiv ℝ f x = toDual ℝ E (gradient f x) := by
    simpa using h_gradient.hasFDerivAt.fderiv
  simpa [h_fderiv] using clarkeDifferential_eq_singleton_fderiv_of_contDiffAt f x hf

/-- The global `C¹` singleton-gradient formula is the pointwise Hilbert-space bridge. -/
theorem clarkeDifferential_eq_singleton_gradient_of_contDiff
    (f : E → ℝ) (x : E) (hf : ContDiff ℝ 1 f) :
    (∂ᶜ f) x =
      ({toDual ℝ E (gradient f x)} : Set (StrongDual ℝ E)) := by
  simpa using clarkeDifferential_eq_singleton_gradient_of_contDiffAt f x hf.contDiffAt

/-- On a real Hilbert space, membership in `∂ᶜ f(x)` is equivalent to being the gradient
functional `toDual ℝ E (gradient f x)`. -/
theorem mem_clarkeDifferential_iff_eq_gradient_of_contDiffAt
    (f : E → ℝ) (x : E) (ξ : StrongDual ℝ E) (hf : ContDiffAt ℝ 1 f x) :
    ξ ∈ (∂ᶜ f) x ↔
      ξ = toDual ℝ E (gradient f x) := by
  have h_gradient : HasGradientAt f (gradient f x) x :=
    hf.differentiableAt_one.hasGradientAt
  have h_fderiv : fderiv ℝ f x = toDual ℝ E (gradient f x) := by
    simpa using h_gradient.hasFDerivAt.fderiv
  simpa [h_fderiv] using mem_clarkeDifferential_iff_eq_fderiv_of_contDiffAt f x ξ hf

/-- For a globally `C¹` function on a real Hilbert space, membership in `∂ᶜ f(x)` is equivalent
to being the gradient functional `toDual ℝ E (gradient f x)`. -/
theorem mem_clarkeDifferential_iff_eq_gradient_of_contDiff
    (f : E → ℝ) (x : E) (ξ : StrongDual ℝ E) (hf : ContDiff ℝ 1 f) :
    ξ ∈ (∂ᶜ f) x ↔
      ξ = toDual ℝ E (gradient f x) := by
  simpa using mem_clarkeDifferential_iff_eq_gradient_of_contDiffAt f x ξ hf.contDiffAt

