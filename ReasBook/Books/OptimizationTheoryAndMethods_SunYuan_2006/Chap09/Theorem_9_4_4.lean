import OptimizationTheoryAndMethods_SunYuan_2006.Compat
import OptimizationTheoryAndMethods_SunYuan_2006.Chap09.Algorithm_9_4_2
import OptimizationTheoryAndMethods_SunYuan_2006.Chap08.Definition_8_2_10
import OptimizationTheoryAndMethods_SunYuan_2006.Chap08.Theorem_8_2_7
import OptimizationTheoryAndMethods_SunYuan_2006.Chap09.Theorem_9_1_1
import OptimizationTheoryAndMethods_SunYuan_2006.Chap09.Theorem_9_2_1
import Mathlib.Order.Bounds.Basic

noncomputable section

section Chapter09Theorem944

variable {n me mi : ℕ}

local notation "Point" => EuclideanSpace ℝ (Fin n)
local notation "pointEquiv" => EuclideanSpace.equiv (Fin n) ℝ

-- Domain-style sampling:
-- * primary domain: quadratic programming, active-set methods, LICQ, and KKT points
-- * inspected owner declarations:
--   `ConstrainedOptimizationProblem.LicqAt` from `Chapter08.Definition_8_2_10`
--   `QuadraticProgram.toConstrainedOptimizationProblem_hasConstraintGradientsAt`
--   from `Chapter09.Theorem_9_1_1`
--   `ConstrainedOptimizationProblem.IsKKTPoint` from `Chapter08.Theorem_8_2_7`
--   `QuadraticProgram.multiplierVector` from `Chapter09.Theorem_9_2_1`
--   the Chapter 9 bridge `QuadraticProgram.toConstrainedOptimizationProblem`
-- * best owner abstractions:
--   `P.toConstrainedOptimizationProblem.LicqAt` is the canonical Chapter 8 owner for the LICQ
--   hypothesis, while the active-gradient `LinearIndepOn` condition is a source-facing bridge to
--   that owner, and `P.toConstrainedOptimizationProblem.IsKKTPoint` remains the KKT conclusion
--   owner
-- * source/core/bridge triage:
--   source-facing: `ActiveSetMethod.terminatedAt` and Theorem 9.4.4 itself
--   core/canonical: `LicqAt`, `LinearIndepOn`, and `IsKKTPoint`
--   bridge/view: `P.toConstrainedOptimizationProblem`, `pointEquiv`, and `multiplierVector`
-- * primitive data vs. derived API:
--   primitive data are the active-set method iterates and stagewise multiplier data already stored
--   by `ActiveSetMethod`; the QP-side differentiability facts are derived from the affine
--   constraint bridge, and the KKT conclusion is derived API on top of the canonical owner

namespace QuadraticProgram

@[simp] theorem toLp_pointEquiv (x : Point) :
    WithLp.toLp 2 (pointEquiv x) = x := by
  ext i
  rfl

/-- For a quadratic program, the source hypothesis that the active constraint normals are
linearly independent at `x` is exactly the canonical Chapter 8 LICQ owner at the corresponding
bridge point. The differentiability component of LICQ is automatic because the constraints of a
quadratic program are affine. -/
theorem licqAt_iff_linearlyIndependentActiveConstraints
    (P : QuadraticProgram n me mi) (x : Point) :
    P.toConstrainedOptimizationProblem.LicqAt (pointEquiv x) ↔
      LinearIndepOn ℝ
        (fun i : Fin (me + mi) ↦ gradient (P.toConstrainedOptimizationProblem.euclideanConstraint i) x)
        (P.toConstrainedOptimizationProblem.activeConstraintIndexSet (pointEquiv x)) := by
  constructor
  · intro hlicq
    simpa using hlicq.linearIndepOn
  · intro hlin
    refine
      { hasActiveConstraintGradientsAt :=
          (P.toConstrainedOptimizationProblem_hasConstraintGradientsAt x).hasActiveConstraintGradientsAt
        linearIndepOn := ?_ }
    simpa using hlin

namespace ActiveSetMethod

/-- If the active-set method terminates at stage `k`, then the iterate `x_k` is a KKT point of
`P`, expressed through the chapter's canonical constrained-problem KKT owner and the combined
multiplier vector built from the recorded equality and inequality multipliers. -/
theorem terminatedAt_isKKTPoint
    {P : QuadraticProgram n me mi} {x1 : Point}
    (A : ActiveSetMethod P x1) {k : ℕ}
    (hterm : A.terminatedAt k) :
    P.toConstrainedOptimizationProblem.IsKKTPoint
      (pointEquiv (A k))
      (multiplierVector (A.eqMultiplier k, A.ineqMultiplier k)) := sorry

end ActiveSetMethod

/-- Chapter09 Theorem 9.4.4 in canonical owner form: if the Chapter 8 LICQ condition holds at
every iterate `x_k` generated by Algorithm 9.4.2, then either some stage `k` is a terminating
stage and the corresponding iterate is a KKT point of `P`, or the quadratic program is
unbounded below on its feasible set. -/
theorem activeSetMethod_finiteKKT_or_unboundedBelow_of_licqAt
    (P : QuadraticProgram n me mi) {x1 : Point} (A : ActiveSetMethod P x1)
    (hlicq : ∀ k : ℕ, P.toConstrainedOptimizationProblem.LicqAt (pointEquiv (A k))) :
    (∃ k : ℕ,
      A.terminatedAt k ∧
        P.toConstrainedOptimizationProblem.IsKKTPoint
          (pointEquiv (A k))
          (multiplierVector (A.eqMultiplier k, A.ineqMultiplier k))) ∨
      ¬ BddBelow (P.objective '' P.feasibleSet) := sorry

/-- Chapter09 Theorem 9.4.4 in the source wording: if, at every iterate `x_k`, the constraint
normals `a_i` with `i ∈ E ∪ I(x_k)` are linearly independent, then equivalently the canonical
LICQ owner holds at each iterate, so the canonical `LicqAt` version of the theorem applies. -/
theorem activeSetMethod_finiteKKT_or_unboundedBelow_of_linearlyIndependentActiveConstraints
    (P : QuadraticProgram n me mi) {x1 : Point} (A : ActiveSetMethod P x1)
    (hlin :
      ∀ k : ℕ,
        LinearIndepOn ℝ
          (fun i : Fin (me + mi) ↦
            gradient (P.toConstrainedOptimizationProblem.euclideanConstraint i) (A k))
          (P.toConstrainedOptimizationProblem.activeConstraintIndexSet (pointEquiv (A k)))) :
    (∃ k : ℕ,
      A.terminatedAt k ∧
        P.toConstrainedOptimizationProblem.IsKKTPoint
          (pointEquiv (A k))
          (multiplierVector (A.eqMultiplier k, A.ineqMultiplier k))) ∨
      ¬ BddBelow (P.objective '' P.feasibleSet) := by
  apply activeSetMethod_finiteKKT_or_unboundedBelow_of_licqAt P A
  intro k
  exact (P.licqAt_iff_linearlyIndependentActiveConstraints (A k)).2 (hlin k)

end QuadraticProgram

end Chapter09Theorem944
