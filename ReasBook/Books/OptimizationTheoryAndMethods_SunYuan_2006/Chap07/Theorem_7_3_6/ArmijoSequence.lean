import OptimizationTheoryAndMethods_SunYuan_2006.Compat
import Mathlib
import Mathlib.Analysis.Matrix.PosDef
import Mathlib.Data.Matrix.Diagonal
import Mathlib.Data.Matrix.Mul
import Mathlib.LinearAlgebra.Matrix.Hermitian
import Mathlib.LinearAlgebra.Matrix.ToLin
import OptimizationTheoryAndMethods_SunYuan_2006.Chap02.Definition_2_5_extra_1
import OptimizationTheoryAndMethods_SunYuan_2006.Chap07.Theorem_7_2_2.DifferentialData

noncomputable section

open Matrix

section

variable {m n : ℕ}

/-- The scaled Levenberg-Marquardt regularized normal matrix `Jᵀ * J + μ • D`. -/
def scaledLevenbergMarquardtRegularizedNormalMatrix
    (J : Matrix (Fin m) (Fin n) ℝ) (D : MatrixN n) (μ : ℝ) : MatrixN n :=
  Jᵀ * J + μ • D

/-- A damping matrix is positive definite diagonal in the scaled Levenberg-Marquardt sense when
it is diagonal with strictly positive diagonal entries. -/
def IsScaledLevenbergMarquardtPositiveDefiniteDiagonalMatrix (M : MatrixN n) : Prop :=
  ∃ d : Fin n → ℝ, M = Matrix.diagonal d ∧ ∀ i : Fin n, 0 < d i

/-- A scaled Levenberg-Marquardt regularized normal matrix is positive definite whenever its
damping term is positive definite diagonal and the damping parameter is positive. -/
theorem scaledLevenbergMarquardtRegularizedNormalMatrix_posDef
    (J : Matrix (Fin m) (Fin n) ℝ) (D : MatrixN n)
    (hD : IsScaledLevenbergMarquardtPositiveDefiniteDiagonalMatrix D)
    {μ : ℝ} (hμ : 0 < μ) :
    (scaledLevenbergMarquardtRegularizedNormalMatrix J D μ).PosDef := by
  rcases hD with ⟨d, rfl, hd⟩
  have hGram : (Jᵀ * J).PosSemidef := Matrix.posSemidef_conjTranspose_mul_self J
  have hDiag : (Matrix.diagonal d : MatrixN n).PosDef := by
    simpa using (Matrix.PosDef.diagonal hd)
  have hScaled : (μ • Matrix.diagonal d : MatrixN n).PosDef := hDiag.smul hμ
  simpa [scaledLevenbergMarquardtRegularizedNormalMatrix] using
    Matrix.PosDef.posSemidef_add hGram hScaled

/-- The scaled Levenberg-Marquardt direction
`-((J(x)ᵀ * J(x) + μ • D(x))⁻¹).mulVec (J(x)ᵀ.mulVec (r(x)))`. -/
def scaledLevenbergMarquardtDirection
    (J : EuclideanSpace ℝ (Fin n) → Matrix (Fin m) (Fin n) ℝ)
    (r : EuclideanSpace ℝ (Fin n) → EuclideanSpace ℝ (Fin m))
    (D : EuclideanSpace ℝ (Fin n) → MatrixN n) (μ : ℝ)
    (x : EuclideanSpace ℝ (Fin n)) : EuclideanSpace ℝ (Fin n) :=
  -((((scaledLevenbergMarquardtRegularizedNormalMatrix (J x) (D x) μ)⁻¹) * (J x)ᵀ) :
      Matrix (Fin n) (Fin m) ℝ).toEuclideanLin
      (r x)

/-- Unfolding formula for `scaledLevenbergMarquardtDirection`. -/
theorem scaledLevenbergMarquardtDirection_eq
    (J : EuclideanSpace ℝ (Fin n) → Matrix (Fin m) (Fin n) ℝ)
    (r : EuclideanSpace ℝ (Fin n) → EuclideanSpace ℝ (Fin m))
    (D : EuclideanSpace ℝ (Fin n) → MatrixN n) (μ : ℝ)
    (x : EuclideanSpace ℝ (Fin n)) :
    scaledLevenbergMarquardtDirection J r D μ x =
      -((((scaledLevenbergMarquardtRegularizedNormalMatrix (J x) (D x) μ)⁻¹) * (J x)ᵀ) :
          Matrix (Fin n) (Fin m) ℝ).toEuclideanLin
        (r x) := rfl

/-- A sequence `x_k` is generated by the scaled Levenberg-Marquardt method with Armijo rule when
each iterate uses the direction
`scaledLevenbergMarquardtDirection J r D (μ k) (x k)`, the step length is `α_k = β^(m_k)`,
the exponent `m_k` is carried by the canonical Chapter 2 Armijo owner
`IsArmijoIndex f (x_k) d_k (g(x_k)) β σ 1 m_k`, every damping parameter
satisfies `0 < μ_k`,
and every damping matrix `D(x_k)` is a positive definite diagonal matrix, so the regularized
normal matrix `J(x_k)ᵀ * J(x_k) + μ_k • D(x_k)` is positive definite. -/
structure IsScaledLevenbergMarquardtArmijoSequence
    (f : EuclideanSpace ℝ (Fin n) → ℝ)
    (g : EuclideanSpace ℝ (Fin n) → EuclideanSpace ℝ (Fin n))
    (J : EuclideanSpace ℝ (Fin n) → Matrix (Fin m) (Fin n) ℝ)
    (r : EuclideanSpace ℝ (Fin n) → EuclideanSpace ℝ (Fin m))
    (D : EuclideanSpace ℝ (Fin n) → MatrixN n)
    (x : ℕ → EuclideanSpace ℝ (Fin n)) (μ α : ℕ → ℝ) (mIndex : ℕ → ℕ) where
  β : ℝ
  σ : ℝ
  mu_pos : ∀ k : ℕ, 0 < μ k
  damping_diagonal_posDef :
    ∀ k : ℕ, IsScaledLevenbergMarquardtPositiveDefiniteDiagonalMatrix (D (x k))
  step_length :
    ∀ k : ℕ, α k = β ^ mIndex k
  armijoIndex :
    ∀ k : ℕ,
      IsArmijoIndex f (x k)
        (scaledLevenbergMarquardtDirection J r D (μ k) (x k))
        (g (x k))
        β σ 1 (mIndex k)
  update_eq :
    ∀ k : ℕ,
      x (k + 1) =
        x k + α k • scaledLevenbergMarquardtDirection J r D (μ k) (x k)

namespace IsScaledLevenbergMarquardtArmijoSequence

variable
    {f : EuclideanSpace ℝ (Fin n) → ℝ}
    {g : EuclideanSpace ℝ (Fin n) → EuclideanSpace ℝ (Fin n)}
    {J : EuclideanSpace ℝ (Fin n) → Matrix (Fin m) (Fin n) ℝ}
    {r : EuclideanSpace ℝ (Fin n) → EuclideanSpace ℝ (Fin m)}
    {D : EuclideanSpace ℝ (Fin n) → MatrixN n}
    {x : ℕ → EuclideanSpace ℝ (Fin n)} {μ α : ℕ → ℝ} {mIndex : ℕ → ℕ}

/-- The Armijo parameter bounds carried by the run data can be recovered at every stage. -/
theorem armijoParameters
    (run : IsScaledLevenbergMarquardtArmijoSequence f g J r D x μ α mIndex)
    (k : ℕ) :
    ArmijoParameters run.β run.σ 1 :=
  (run.armijoIndex k).toArmijoParameters

/-- The accepted exponent `m_k` satisfies the Armijo sufficient-decrease test. -/
theorem acceptsAtExponent
    (run : IsScaledLevenbergMarquardtArmijoSequence f g J r D x μ α mIndex)
    (k : ℕ) :
    armijoAcceptsAtExponent
      f (x k)
      (scaledLevenbergMarquardtDirection J r D (μ k) (x k))
      (g (x k))
      run.β run.σ 1 (mIndex k) :=
  (run.armijoIndex k).accepts

/-- The Armijo exponent stored by the run data is the least accepted exponent. -/
theorem isLeastAcceptedExponent
    (run : IsScaledLevenbergMarquardtArmijoSequence f g J r D x μ α mIndex)
    (k : ℕ) :
    IsLeast
      {j : ℕ |
        armijoAcceptsAtExponent
          f (x k)
          (scaledLevenbergMarquardtDirection J r D (μ k) (x k))
          (g (x k))
          run.β run.σ 1 j}
      (mIndex k) :=
  (run.armijoIndex k).isLeastAcceptedExponent

/-- Every scaled Levenberg-Marquardt step in the run has a positive definite regularized normal
matrix. -/
theorem normalMatrix_posDef
    (run : IsScaledLevenbergMarquardtArmijoSequence f g J r D x μ α mIndex)
    (k : ℕ) :
    (scaledLevenbergMarquardtRegularizedNormalMatrix (J (x k)) (D (x k)) (μ k)).PosDef :=
  scaledLevenbergMarquardtRegularizedNormalMatrix_posDef
    (J (x k)) (D (x k)) (run.damping_diagonal_posDef k) (run.mu_pos k)

end IsScaledLevenbergMarquardtArmijoSequence

end
