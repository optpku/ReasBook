import OptimizationTheoryAndMethods_SunYuan_2006.Compat
import Mathlib.Analysis.Calculus.ContDiff.Basic
import Mathlib.Analysis.Matrix.Normed
import Mathlib.Topology.Sequences
import Mathlib.Topology.UniformSpace.Basic
import OptimizationTheoryAndMethods_SunYuan_2006.Chap01.Theorem_1_3_19
import OptimizationTheoryAndMethods_SunYuan_2006.Chap07.Algorithm_7_4_2

noncomputable section

open Filter Matrix
open scoped LeastSquares

section

variable {m n : ℕ}

local notation "Point" => EuclideanSpace ℝ (Fin n)
local notation "ResidualVector" => EuclideanSpace ℝ (Fin m)
local notation "MatrixN" => Matrix (Fin n) (Fin n) ℝ
local notation "JacobianMatrix" => Matrix (Fin m) (Fin n) ℝ

local instance : NormedAddCommGroup JacobianMatrix := Matrix.normedAddCommGroup
local instance : NormedSpace ℝ JacobianMatrix := Matrix.normedSpace

-- Domain sampling for this theorem file:
-- * primary domain: Moré-type trust-region Levenberg-Marquardt convergence for nonlinear
--   least-squares on Euclidean spaces;
-- * sampled owner declarations in the local canonical API:
--   `nonlinearLeastSquaresObjective`,
--   `initialSublevelSet`,
--   `MoreLevenbergMarquardtIteration.currentScalingMatrix`,
--   `leastSquaresGradient`;
-- * source/core/bridge triage:
--   - source-facing owner here: the Moré run object carrying the iterate, radius, and scaling
--     sequences generated by Algorithm 7.4.2;
--   - core/canonical owners reused here: `initialSublevelSet` for the
--     Chapter 7 least-squares level-set hypothesis,
--     `MoreLevenbergMarquardtIteration.currentScalingMatrix` for the scaling matrices, and
--     `leastSquaresGradient` for the unscaled Gauss-Newton gradient;
--   - bridge/view API here: sequence-level Jacobian, scaling-matrix, scaled-gradient, and
--     normal-gradient views along a run.

/-- A sequence `x_k` with trust-region radii `Δ_k` and diagonal scaling data `d_k` is generated
by Chapter07 Algorithm 7.4.2 when the residual map is `r`, the Jacobian field is the genuine
Jacobian `residualJacobianMatrix r`, each stage uses a trust-region parameter `sigma k ∈ (0, 1)`,
a damping value `mu k`, a trial step `step k`, a reduction ratio `rho k`, strictly positive
scaling data, the source pseudoinverse-or-damped `step_case`, positive predicted reduction,
the exact quotient identity for `rho k`, the accepted/rejected iterate and Jacobian update
behavior, the source radius update, and the scaling update
`d_(k + 1) = max(d_k, columnNorms J_(k + 1))`. -/
structure MoreLevenbergMarquardtSequence
    (r : Point → ResidualVector) where
  x : ℕ → Point
  Δ : ℕ → ℝ
  d : ℕ → Fin n → ℝ
  iteration :
    ∀ k : ℕ,
      MoreLevenbergMarquardtIteration
        r (residualJacobianMatrix r) (x k) (Δ k) (d k)
  x_succ :
    ∀ k : ℕ, x (k + 1) = (iteration k).xNext
  delta_succ :
    ∀ k : ℕ, Δ (k + 1) = (iteration k).deltaNext
  scaling_succ :
    ∀ k : ℕ, d (k + 1) = (iteration k).scalingNext

namespace MoreLevenbergMarquardtSequence

variable {r : Point → ResidualVector}

/-- A Moré Levenberg-Marquardt run can be used as its iterate sequence. -/
instance : CoeFun (MoreLevenbergMarquardtSequence r) (fun _ ↦ ℕ → Point) where
  coe run := run.x

/-- Evaluating a Moré Levenberg-Marquardt run as a function returns its iterate sequence. -/
theorem coe_apply (run : MoreLevenbergMarquardtSequence r) (k : ℕ) : run k = run.x k := rfl

/-- The Jacobian sequence `J_k = ∇r (x_k)` attached to a Moré Levenberg-Marquardt run. -/
def jacobian
    (run : MoreLevenbergMarquardtSequence r) (k : ℕ) : JacobianMatrix :=
  residualJacobianMatrix r (run.x k)

/-- The scaling-matrix sequence `D_k = diag d_k` attached to a Moré Levenberg-Marquardt run. -/
def scalingMatrix
    (run : MoreLevenbergMarquardtSequence r) (k : ℕ) : MatrixN :=
  (run.iteration k).currentScalingMatrix

/-- Each scaling matrix in a Moré Levenberg-Marquardt run is positive definite diagonal in the
Chapter 7 sense. -/
theorem scalingMatrix_posDef
    (run : MoreLevenbergMarquardtSequence r) (k : ℕ) :
    IsPositiveDefiniteDiagonalMatrix ((scalingMatrix run k : MatrixN)) :=
  (run.iteration k).currentScalingMatrix_posDef

/-- The scaled gradient sequence `((J_k D_k⁻¹)ᵀ r_k)_k` attached to a Moré
Levenberg-Marquardt run. -/
def scaledGradient
    (run : MoreLevenbergMarquardtSequence r) (k : ℕ) : Point :=
  trustRegionLevenbergMarquardtGradient
    (run.jacobian k * (run.scalingMatrix k)⁻¹)
    (r (run.x k))

end MoreLevenbergMarquardtSequence

/-- Chapter07 Theorem 7.4.3 (1): let `r : ℝ^n → ℝ^m` be continuously differentiable, and let
`run : MoreLevenbergMarquardtSequence r` be generated by Chapter07 Algorithm 7.4.2, including the
source step-selection, reduction-ratio, accepted/rejected Jacobian update, and scaling-update
semantics. If the Chapter 7 least-squares level set
`initialSublevelSet (nonlinearLeastSquaresObjective r) (run.x 0)` is bounded, then the
scaled gradient
satisfies `liminf_(k → ∞) ‖((J_k * D_k⁻¹)ᵀ).mulVec r_k‖ = 0`, encoded as
`liminf (fun k ↦ ‖run.scaledGradient k‖) atTop = 0`. -/
theorem moreLevenbergMarquardt_liminf_scaledGradient_eq_zero
    (r : Point → ResidualVector)
    (hC1 : ContDiff ℝ 1 r)
    (run : MoreLevenbergMarquardtSequence r)
    (hLevelSetBounded :
      Bornology.IsBounded (initialSublevelSet (nonlinearLeastSquaresObjective r) (run.x 0))) :
    liminf (fun k : ℕ ↦ ‖run.scaledGradient k‖) atTop = 0 := sorry

/-- Chapter07 Theorem 7.4.3 (2): under the hypotheses of
`moreLevenbergMarquardt_liminf_scaledGradient_eq_zero`, if the Jacobian sequence `J_k` is
bounded as a matrix-valued sequence, encoded by
`Bornology.IsBounded (Set.range run.jacobian)`, then
`liminf_(k → ∞) ‖J_kᵀ r_k‖ = 0`, encoded through the canonical least-squares gradient owner as
`liminf (fun k ↦ ‖g[r](run.x k)‖) atTop = 0`. -/
theorem moreLevenbergMarquardt_liminf_normalGradient_eq_zero_of_bounded_jacobian
    (r : Point → ResidualVector)
    (hC1 : ContDiff ℝ 1 r)
    (run : MoreLevenbergMarquardtSequence r)
    (hLevelSetBounded :
      Bornology.IsBounded (initialSublevelSet (nonlinearLeastSquaresObjective r) (run.x 0)))
    (hJacobianBounded : Bornology.IsBounded (Set.range run.jacobian)) :
    liminf (fun k : ℕ ↦ ‖g[r](run.x k)‖) atTop = 0 := sorry

/-- Chapter07 Theorem 7.4.3 (3): under the hypotheses of
`moreLevenbergMarquardt_liminf_scaledGradient_eq_zero`, if `∇r` is uniformly continuous on the
relevant Chapter 7 least-squares initial sublevel set
`initialSublevelSet (nonlinearLeastSquaresObjective r) (run.x 0)`,
encoded by the canonical matrix-valued Jacobian map `residualJacobianMatrix r`, then
`‖J_kᵀ r_k‖ ⟶ 0`. -/
theorem moreLevenbergMarquardt_tendsto_normalGradientNorm_zero_of_uniformContinuous_jacobian
    (r : Point → ResidualVector)
    (hC1 : ContDiff ℝ 1 r)
    (run : MoreLevenbergMarquardtSequence r)
    (hLevelSetBounded :
      Bornology.IsBounded (initialSublevelSet (nonlinearLeastSquaresObjective r) (run.x 0)))
    (hJacobianUniform :
      UniformContinuousOn
        (residualJacobianMatrix r)
        (initialSublevelSet (nonlinearLeastSquaresObjective r) (run.x 0))) :
    Tendsto (fun k : ℕ ↦ ‖g[r](run.x k)‖) atTop (nhds 0) := sorry

#print axioms MoreLevenbergMarquardtSequence.scaledGradient

end
