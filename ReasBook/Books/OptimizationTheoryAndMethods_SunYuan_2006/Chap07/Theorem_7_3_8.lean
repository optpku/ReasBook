import OptimizationTheoryAndMethods_SunYuan_2006.Compat
import Mathlib.Order.Filter.Extr
import OptimizationTheoryAndMethods_SunYuan_2006.Chap01.Definition_1_4_1
import OptimizationTheoryAndMethods_SunYuan_2006.Chap07.Theorem_7_3_5
import OptimizationTheoryAndMethods_SunYuan_2006.Chap07.Theorem_7_3_7

noncomputable section

open Filter Matrix

section Chapter07Theorem738

variable {m n : ℕ}

local notation "Point" => EuclideanSpace ℝ (Fin n)
local notation "Residual" => EuclideanSpace ℝ (Fin m)
local notation "MatrixN" => Matrix (Fin n) (Fin n) ℝ

-- Domain sampling for this file:
-- * primary domain: finite-dimensional nonlinear least-squares Levenberg-Marquardt local rate;
-- * sampled owner declarations:
--   `Chapter07.Theorem_7_3_5.smallestHermitianEigenvalue`,
--   `IsArmijoIndex`,
--   `leastSquaresGradient`,
--   `leastSquaresCorrectionMatrix`,
--   `IsLevenbergMarquardtSequence`,
--   `levenbergMarquardtDirection`;
-- * source/core/bridge triage:
--   - source-facing owner introduced here: the identity-scaled Levenberg-Marquardt Armijo run
--     data specific to Theorem 7.3.8;
--   - core/canonical owners reused here: the Chapter 2 Armijo-index owner, the Chapter 7
--     least-squares objective/gradient owners, and the Chapter 7 base Levenberg-Marquardt
--     sequence owner from Theorem 7.3.7;
--   - bridge/view kept here: the named local-rate ratio `levenbergMarquardtLocalRateRatio`
--     expressing the source quantity `τ = M / l` directly through the canonical Hermitian
--     eigenvalue API;
-- * primitive data kept in this file: the iterate/update sequences, accepted exponents, accepted
--   Armijo parameters, limit point, and the local spectral data at `xStar`;
-- * derived API kept in this file: inherited Armijo parameter bounds, accepted-exponent
--   companions, the source-semantic run expansion, and the eventual full-step, local-rate, and
--   strict-local-minimum conclusions of Theorem 7.3.8.

section

variable {r : Point → Residual} {x : ℕ → Point} {μ α : ℕ → ℝ} {mIndex : ℕ → ℕ}
variable {xStar : Point}

/-- A sequence `x_k` is generated by the identity-scaled Levenberg-Marquardt method with Armijo
backtracking when it is already a Chapter 7 Levenberg-Marquardt sequence with nonnegative damping
parameters, the accepted step length is `α_k = β ^ m_k`, and the recorded exponent `m_k` is the
canonical Chapter 2 Armijo index for the identity-scaled Levenberg-Marquardt direction
`levenbergMarquardtDirection r (μ k) (x k)`. -/
structure IsLevenbergMarquardtArmijoSequence
    (r : Point → Residual) (x : ℕ → Point) (μ α : ℕ → ℝ) (mIndex : ℕ → ℕ)
    extends IsLevenbergMarquardtSequence r x μ where
  β : ℝ
  σ : ℝ
  step_length : ∀ k : ℕ, α k = β ^ mIndex k
  armijoIndex :
    ∀ k : ℕ,
      IsArmijoIndex (nonlinearLeastSquaresObjective r) (x k)
        (levenbergMarquardtDirection r (μ k) (x k))
        (leastSquaresGradient r (x k))
        β σ 1 (mIndex k)

namespace IsLevenbergMarquardtArmijoSequence

variable {r : Point → Residual} {x : ℕ → Point} {μ α : ℕ → ℝ} {mIndex : ℕ → ℕ}

/-- The Armijo parameter bounds recorded by a Levenberg-Marquardt Armijo run are inherited from
the canonical Chapter 2 Armijo-index owner. -/
instance armijoParameters
    (run : IsLevenbergMarquardtArmijoSequence r x μ α mIndex) :
    ArmijoParameters run.β run.σ 1 :=
  (run.armijoIndex 0).toArmijoParameters

/-- The Armijo parameter bounds exposed by `run`. -/
theorem parameterBounds
    (run : IsLevenbergMarquardtArmijoSequence r x μ α mIndex) :
    0 < run.β ∧ run.β < 1 ∧ 0 < run.σ ∧ run.σ < (1 / 2 : ℝ) := by
  let hParameters : ArmijoParameters run.β run.σ 1 := run.armijoParameters
  exact
    ⟨hParameters.beta_pos, hParameters.beta_lt_one, hParameters.rho_pos,
      hParameters.rho_lt_half⟩

/-- Each recorded backtracking exponent is the least accepted exponent for the identity-scaled
Levenberg-Marquardt trial steps `run.β ^ j • d_k`. -/
theorem isLeastAcceptedExponent
    (run : IsLevenbergMarquardtArmijoSequence r x μ α mIndex) (k : ℕ) :
    IsLeast
      {j : ℕ |
        armijoAcceptsAtExponent
          (nonlinearLeastSquaresObjective r) (x k)
          (levenbergMarquardtDirection r (μ k) (x k))
          (leastSquaresGradient r (x k))
          run.β run.σ 1 j}
      (mIndex k) :=
  (run.armijoIndex k).isLeastAcceptedExponent

/-- The recorded exponent satisfies the Armijo sufficient-decrease test at stage `k`. -/
theorem acceptsAtExponent
    (run : IsLevenbergMarquardtArmijoSequence r x μ α mIndex) (k : ℕ) :
    armijoAcceptsAtExponent
      (nonlinearLeastSquaresObjective r) (x k)
      (levenbergMarquardtDirection r (μ k) (x k))
      (leastSquaresGradient r (x k))
      run.β run.σ 1 (mIndex k) :=
  (run.armijoIndex k).accepts

/-- Source-semantic expansion of `IsLevenbergMarquardtArmijoSequence`. -/
theorem spec
    (run : IsLevenbergMarquardtArmijoSequence r x μ α mIndex) :
    ArmijoParameters run.β run.σ 1 ∧
      (∀ k : ℕ, 0 ≤ μ k) ∧
      (∀ k : ℕ, α k = run.β ^ mIndex k) ∧
      (∀ k : ℕ,
        IsArmijoIndex (nonlinearLeastSquaresObjective r) (x k)
          (levenbergMarquardtDirection r (μ k) (x k))
          (leastSquaresGradient r (x k))
          run.β run.σ 1 (mIndex k)) ∧
      ∀ k : ℕ,
        x (k + 1) =
          x k + α k • levenbergMarquardtDirection r (μ k) (x k) := by
  exact
    ⟨run.armijoParameters, run.toIsLevenbergMarquardtSequence.mu_nonneg, run.step_length,
      run.armijoIndex, run.toIsLevenbergMarquardtSequence.update_eq⟩

end IsLevenbergMarquardtArmijoSequence

/-- The source rate ratio `τ = M / l` at `xStar`, expressed directly through the Chapter 7
Hermitian-eigenvalue owners for the correction matrix and the Gauss-Newton normal matrix. -/
def levenbergMarquardtLocalRateRatio
    (r : Point → Residual) (xStar : Point) (hn : 0 < n)
    (hCorrectionSymm : (leastSquaresCorrectionMatrix r xStar).IsSymm) : ℝ :=
  max
      |largestHermitianEigenvalue ((isHermitian_iff_isSymm).2 hCorrectionSymm) hn|
      |smallestHermitianEigenvalue ((isHermitian_iff_isSymm).2 hCorrectionSymm) hn| /
    smallestHermitianEigenvalue
      (isHermitian_conjTranspose_mul_self (residualJacobianMatrix r xStar))
      hn

/-- Unfolding formula for `levenbergMarquardtLocalRateRatio`. -/
theorem levenbergMarquardtLocalRateRatio_eq
    (r : Point → Residual) (xStar : Point) (hn : 0 < n)
    (hCorrectionSymm : (leastSquaresCorrectionMatrix r xStar).IsSymm) :
    levenbergMarquardtLocalRateRatio r xStar hn hCorrectionSymm =
      max
          |largestHermitianEigenvalue ((isHermitian_iff_isSymm).2 hCorrectionSymm) hn|
          |smallestHermitianEigenvalue ((isHermitian_iff_isSymm).2 hCorrectionSymm) hn| /
        smallestHermitianEigenvalue
          (isHermitian_conjTranspose_mul_self (residualJacobianMatrix r xStar))
          hn :=
  rfl

/-- Chapter07 Theorem 7.3.8 (1): let `x_k` be a Levenberg-Marquardt Armijo sequence for the
canonical nonlinear least-squares objective attached to `r`, recorded by the source-facing owner
`IsLevenbergMarquardtArmijoSequence`. Assume the iterate sequence converges to `xStar`, the
Gauss-Newton normal matrix at `xStar` has positive smallest Hermitian eigenvalue, the correction
matrix induces the local rate ratio
`levenbergMarquardtLocalRateRatio r xStar hn hCorrectionSymm < 1`,
`run.β < (1 - levenbergMarquardtLocalRateRatio r xStar hn hCorrectionSymm) / 2`, and
`μ k → 0`. Then the accepted step size is eventually full, i.e. `α_k = 1` for all sufficiently
large `k`. -/
theorem levenbergMarquardt_stepsize_eventually_eq_one
    (run : IsLevenbergMarquardtArmijoSequence r x μ α mIndex)
    (hTendsto : Tendsto x atTop (nhds xStar))
    (hn : 0 < n)
    (hCorrectionSymm : (leastSquaresCorrectionMatrix r xStar).IsSymm)
    (hGram_smallest_pos :
      0 <
        smallestHermitianEigenvalue
          (isHermitian_conjTranspose_mul_self (residualJacobianMatrix r xStar))
          hn)
    (hRate_lt_one : levenbergMarquardtLocalRateRatio r xStar hn hCorrectionSymm < 1)
    (hBeta_lt :
      run.β < (1 - levenbergMarquardtLocalRateRatio r xStar hn hCorrectionSymm) / 2)
    (hMuTendsto : Tendsto μ atTop (nhds 0)) :
    ∃ N : ℕ, ∀ k ≥ N, α k = 1 := sorry

/-- Chapter07 Theorem 7.3.8 (2): under the same canonical Armijo and Levenberg-Marquardt
direction hypotheses as in part (1), the asymptotic contraction ratio of the iterate errors is
bounded by the source rate ratio `τ = M / l`, expressed here as the canonical owner
`levenbergMarquardtLocalRateRatio r xStar hn hCorrectionSymm`. -/
theorem limsup_levenbergMarquardt_errorRatio_le
    (run : IsLevenbergMarquardtArmijoSequence r x μ α mIndex)
    (hTendsto : Tendsto x atTop (nhds xStar))
    (hn : 0 < n)
    (hCorrectionSymm : (leastSquaresCorrectionMatrix r xStar).IsSymm)
    (hGram_smallest_pos :
      0 <
        smallestHermitianEigenvalue
          (isHermitian_conjTranspose_mul_self (residualJacobianMatrix r xStar))
          hn)
    (hRate_lt_one : levenbergMarquardtLocalRateRatio r xStar hn hCorrectionSymm < 1)
    (hBeta_lt :
      run.β < (1 - levenbergMarquardtLocalRateRatio r xStar hn hCorrectionSymm) / 2)
    (hMuTendsto : Tendsto μ atTop (nhds 0)) :
    limsup (fun k : ℕ ↦ ‖x (k + 1) - xStar‖ / ‖x k - xStar‖) atTop ≤
      levenbergMarquardtLocalRateRatio r xStar hn hCorrectionSymm := sorry

/-- Chapter07 Theorem 7.3.8 (3): under the same canonical Armijo and Levenberg-Marquardt
direction hypotheses as in part (1), if `xStar` is stationary for the nonlinear least-squares
objective, then `xStar` is a strict local minimizer of that objective. -/
theorem levenbergMarquardt_limit_isStrictLocalMin
    (run : IsLevenbergMarquardtArmijoSequence r x μ α mIndex)
    (hStationary : IsStationaryPoint (nonlinearLeastSquaresObjective r) xStar)
    (hTendsto : Tendsto x atTop (nhds xStar))
    (hn : 0 < n)
    (hCorrectionSymm : (leastSquaresCorrectionMatrix r xStar).IsSymm)
    (hGram_smallest_pos :
      0 <
        smallestHermitianEigenvalue
          (isHermitian_conjTranspose_mul_self (residualJacobianMatrix r xStar))
          hn)
    (hRate_lt_one : levenbergMarquardtLocalRateRatio r xStar hn hCorrectionSymm < 1)
    (hBeta_lt :
      run.β < (1 - levenbergMarquardtLocalRateRatio r xStar hn hCorrectionSymm) / 2)
    (hMuTendsto : Tendsto μ atTop (nhds 0)) :
    IsStrictLocalMin (nonlinearLeastSquaresObjective r) xStar := sorry

end

end Chapter07Theorem738
