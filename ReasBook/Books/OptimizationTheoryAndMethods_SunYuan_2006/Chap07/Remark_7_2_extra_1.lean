section

variable {m n : ℕ}

local notation "Point" => EuclideanSpace ℝ (Fin n)
local notation "Residual" => EuclideanSpace ℝ (Fin m)

-- Domain sampling:
-- * primary domain: damped Gauss-Newton line-search iterations for nonlinear least squares;
-- * sampled owner declarations reused here:
--   `ArmijoParameters`,
--   `IsArmijoIndex`,
--   `IsNonmonotoneArmijoLineSearch`,
--   `levenbergMarquardtDirection`,
--   `nonlinearLeastSquaresObjective`,
--   `gaussNewtonNormalMatrix`,
--   `leastSquaresGradient`,
--   `solvesGaussNewtonNormalEquation`,
--   `initialSublevelSet`,
--   `nonmonotoneArmijoLineSearch_accumulationPoint_stationary`,
--   `IsStationaryPoint`,
--   `IsDescentDirectionAt`;
-- * best owner abstraction: the Chapter 7 residual-based least-squares owners
--   `solvesGaussNewtonNormalEquation` and the zero-damping
--   Levenberg-Marquardt direction `levenbergMarquardtDirection r 0`, together with the
--   Chapter 2 line-search owner `IsNonmonotoneArmijoLineSearch` specialized to memory `M = 0`;
-- * source/core/bridge triage:
--   - source-facing declarations kept here: the remark's Armijo/update/stationarity statements;
--   - core/canonical owners reused here: the Chapter 7 least-squares owners, the
--     zero-damping Levenberg-Marquardt direction, and the Chapter 2 line-search owner;
--   - bridge/view layer here: the explicit inverse formula for
--     `levenbergMarquardtDirection r 0 x` under invertibility, the corresponding full-step
--     Gauss-Newton normal-equation lemma, and the theorem turning the source Armijo/update data
--     into the canonical memory-zero nonmonotone Armijo owner;
-- * primitive data here: the iterate update, the accepted step sizes, and the accepted Armijo
--   exponents;
-- * derived API here: the memory-zero nonmonotone Armijo bridge and the
--   objective/stationarity consequences.

/-- Under invertibility of the Gauss-Newton normal matrix, the zero-damping
Levenberg-Marquardt direction is the textbook damped Gauss-Newton inverse formula. -/
theorem levenbergMarquardtDirection_zero_eq_dampedGaussNewtonFormula
    (r : Point → Residual) (x : Point)
    (hInv : Invertible (gaussNewtonNormalMatrix r x)) :
    levenbergMarquardtDirection r 0 x =
      -((⅟ (gaussNewtonNormalMatrix r x)).toEuclideanLin (g[r](x))) := by
  sorry

/-- Under the same invertibility hypothesis, taking the zero-damping Levenberg-Marquardt step
solves the canonical Gauss-Newton normal equation. -/
theorem solvesGaussNewtonNormalEquation_add_levenbergMarquardtDirection_zero
    (r : Point → Residual) (x : Point)
    (hInv : Invertible (gaussNewtonNormalMatrix r x)) :
    solvesGaussNewtonNormalEquation r x (x + levenbergMarquardtDirection r 0 x) := by
  sorry

/-- A sequence `x_k` is generated by the damped Gauss-Newton method with Armijo backtracking
when each iterate updates by the zero-damping Levenberg-Marquardt direction, the accepted step
length is `α_k = (β ^ m_k) * τ`, and `m_k` is the canonical Chapter 2 Armijo index for that
direction and the least-squares gradient. -/
class IsDampedGaussNewtonArmijoSequence
    (r : Point → Residual) (x : ℕ → Point) (α : ℕ → ℝ)
    (β ρ τ : ℝ) (mIndex : ℕ → ℕ) : Prop where
  update_eq :
    ∀ k : ℕ,
      x (k + 1) = x k + α k • levenbergMarquardtDirection r 0 (x k)
  step_length : ∀ k : ℕ, α k = (β ^ mIndex k) * τ
  armijoIndex :
    ∀ k : ℕ,
      IsArmijoIndex
        (nonlinearLeastSquaresObjective r) (x k)
        (levenbergMarquardtDirection r 0 (x k))
        (g[r](x k))
        β ρ τ (mIndex k)

namespace IsDampedGaussNewtonArmijoSequence

variable {r : Point → Residual} {x : ℕ → Point} {α : ℕ → ℝ}
variable {β ρ τ : ℝ} {mIndex : ℕ → ℕ}

/-- The Armijo parameter bounds recorded by a damped Gauss-Newton Armijo run come from the
Chapter 2 Armijo-index owner. -/
instance armijoParameters
    (run : IsDampedGaussNewtonArmijoSequence r x α β ρ τ mIndex) :
    ArmijoParameters β ρ τ :=
  (run.armijoIndex 0).toArmijoParameters

/-- Source-semantic expansion of `IsDampedGaussNewtonArmijoSequence`. -/
theorem spec
    (run : IsDampedGaussNewtonArmijoSequence r x α β ρ τ mIndex) :
    ArmijoParameters β ρ τ ∧
      (∀ k : ℕ,
        x (k + 1) = x k + α k • levenbergMarquardtDirection r 0 (x k)) ∧
      (∀ k : ℕ, α k = (β ^ mIndex k) * τ) ∧
      ∀ k : ℕ,
        IsArmijoIndex
          (nonlinearLeastSquaresObjective r) (x k)
          (levenbergMarquardtDirection r 0 (x k))
          (g[r](x k))
          β ρ τ (mIndex k) :=
  ⟨run.armijoParameters, run.update_eq, run.step_length, run.armijoIndex⟩

/-- The source Armijo data for the damped Gauss-Newton direction induce the canonical Chapter 2
memory-zero nonmonotone Armijo owner. This is the bridge from the source-facing Armijo run to the
owner used by the Chapter 2 stationary-point theorem. -/
theorem toIsNonmonotoneArmijoLineSearch
    (run : IsDampedGaussNewtonArmijoSequence r x α β ρ τ mIndex)
    (hDirectionNe :
      ∀ k : ℕ, levenbergMarquardtDirection r 0 (x k) ≠ 0) :
    IsNonmonotoneArmijoLineSearch
      (nonlinearLeastSquaresObjective r) x (fun k ↦ g[r](x k))
      (fun k ↦ levenbergMarquardtDirection r 0 (x k)) α τ β ρ 0 (fun _ ↦ 0) mIndex := by
  refine
    { direction_ne := ?_
      update := ?_
      tau_pos := (run.armijoIndex 0).tau_pos
      gamma_mem_Ioo := ?_
      m_zero := rfl
      m_step := ?_
      alpha_eq := ?_
      backtrackingStep := ?_ }
  · intro k
    exact hDirectionNe k
  · intro k
    exact run.update_eq k
  · exact
      ⟨(run.armijoIndex 0).rho_pos,
        lt_trans (run.armijoIndex 0).rho_lt_half (by norm_num)⟩
  · intro k
    simp
  · intro k
    simpa [nonmonotoneArmijoStep] using run.step_length k
  · intro k
    refine (isBacktrackingLineSearchStep_iff _ _ _ _ (mIndex k)).2 ?_
    refine ⟨(run.armijoIndex k).toIsBacktrackingLineSearchStep.toIsBacktrackingStepSequence, ?_⟩
    simpa [nonmonotoneArmijoBacktrackingAccepts, nonmonotoneArmijoReferenceValue,
      nonmonotoneArmijoWindow, armijoBacktrackingAccepts, backtrackingTrialPoint,
      lineSearchObjective, lineSearchObjective_zero] using
      (run.armijoIndex k).toIsBacktrackingLineSearchStep.acceptedIndex_isLeast

end IsDampedGaussNewtonArmijoSequence

/-- Under invertibility of the normal matrices, a damped Gauss-Newton Armijo run updates by the
textbook explicit damped Gauss-Newton inverse formula. -/
theorem dampedGaussNewton_step_eq_dampedGaussNewtonFormula
    (r : Point → Residual) (x : ℕ → Point) (α : ℕ → ℝ)
    (β ρ τ : ℝ) (mIndex : ℕ → ℕ)
    (run : IsDampedGaussNewtonArmijoSequence r x α β ρ τ mIndex)
    (inv : ∀ k : ℕ, Invertible (gaussNewtonNormalMatrix r (x k)))
    (k : ℕ) :
    x (k + 1) =
      x k - α k • ((⅟ (gaussNewtonNormalMatrix r (x k))).toEuclideanLin (g[r](x k))) := by
  rw [run.update_eq k, levenbergMarquardtDirection_zero_eq_dampedGaussNewtonFormula r (x k) (inv k)]
  simp [sub_eq_add_neg, smul_neg]

/-- Chapter07 Remark 7.2-extra-1 (2): if the accepted line-search step in the damped
Gauss-Newton method is chosen by the concrete Armijo backtracking rule from the earlier
line-search setup and the damped Gauss-Newton direction is a descent direction at each iterate in
the canonical Chapter 1 sense,
then the nonlinear least-squares objective decreases at every step. -/
theorem dampedGaussNewtonObjective_descends
    (r : Point → Residual) (x : ℕ → Point) (α : ℕ → ℝ)
    (β ρ τ : ℝ) (mIndex : ℕ → ℕ)
    (run : IsDampedGaussNewtonArmijoSequence r x α β ρ τ mIndex)
    (h_direction_descent :
      ∀ k : ℕ,
        IsDescentDirectionAt
          (nonlinearLeastSquaresObjective r) (x k) (levenbergMarquardtDirection r 0 (x k))) :
    ∀ k : ℕ,
      nonlinearLeastSquaresObjective r (x (k + 1)) ≤
        nonlinearLeastSquaresObjective r (x k) := sorry

section AccumulationPoint

variable
    (r : Point → Residual) (x : ℕ → Point) (α : ℕ → ℝ)
    (β ρ τ : ℝ) (mIndex : ℕ → ℕ)
    (run : IsDampedGaussNewtonArmijoSequence r x α β ρ τ mIndex)
    (c1 c2 : ℝ)
    (h_compact : IsCompact (initialSublevelSet (nonlinearLeastSquaresObjective r) (x 0)))
    (h_hasGradient :
      ∀ y ∈ initialSublevelSet (nonlinearLeastSquaresObjective r) (x 0),
        HasGradientVectorAt (nonlinearLeastSquaresObjective r) (g[r](y)) y)
    (h_gradUniform :
      UniformContinuousOn
        (fun y ↦ g[r](y))
        (initialSublevelSet (nonlinearLeastSquaresObjective r) (x 0)))
    (hc1 : 0 < c1) (hc2 : 0 < c2)
    (h_descent :
      ∀ k : ℕ,
        inner ℝ (g[r](x k))
          (levenbergMarquardtDirection r 0 (x k)) ≤
            -c1 * ‖g[r](x k)‖ ^ (2 : ℕ))
    (h_dir_bound :
      ∀ k : ℕ,
        ‖levenbergMarquardtDirection r 0 (x k)‖ ≤
          c2 * ‖g[r](x k)‖)
    {xStar : Point} {φ : ℕ → ℕ}
    (hφ : StrictMono φ)
    (h_tendsto : Tendsto (x ∘ φ) atTop (nhds xStar))

/-- Chapter07 Remark 7.2-extra-1 (3): under the same earlier §7.2 line-search assumptions used
for the damped Gauss-Newton method together with the earlier global-convergence hypotheses on the
initial sublevel set, least-squares gradient regularity on that sublevel set, the Gauss-Newton
descent bound, and the direction norm bound, every accumulation point `xStar` of the iterate
sequence is a stationary point of the nonlinear least-squares objective. The proof is a thin
specialization of the Chapter 2 nonmonotone-Armijo stationary-point theorem to the memory-zero
Armijo case, with a separate stationary-tail branch when some damped Gauss-Newton step already
has zero least-squares gradient. The companion theorem
`dampedGaussNewton_accumulationPoint_objectiveGradient_eq_zero` records the zero-gradient
corollary. -/
theorem dampedGaussNewton_accumulationPoint_stationary
    (r : Point → Residual) (x : ℕ → Point) (α : ℕ → ℝ)
    (β ρ τ : ℝ) (mIndex : ℕ → ℕ)
    (run : IsDampedGaussNewtonArmijoSequence r x α β ρ τ mIndex)
    (c1 c2 : ℝ)
    (h_compact : IsCompact (initialSublevelSet (nonlinearLeastSquaresObjective r) (x 0)))
    (h_hasGradient :
      ∀ y ∈ initialSublevelSet (nonlinearLeastSquaresObjective r) (x 0),
        HasGradientVectorAt (nonlinearLeastSquaresObjective r) (g[r](y)) y)
    (h_gradUniform :
      UniformContinuousOn
        (fun y ↦ g[r](y))
        (initialSublevelSet (nonlinearLeastSquaresObjective r) (x 0)))
    (hc1 : 0 < c1) (hc2 : 0 < c2)
    (h_descent :
      ∀ k : ℕ,
        inner ℝ (g[r](x k))
          (levenbergMarquardtDirection r 0 (x k)) ≤
            -c1 * ‖g[r](x k)‖ ^ (2 : ℕ))
    (h_dir_bound :
      ∀ k : ℕ,
        ‖levenbergMarquardtDirection r 0 (x k)‖ ≤
          c2 * ‖g[r](x k)‖)
    {xStar : Point} {φ : ℕ → ℕ}
    (hφ : StrictMono φ)
    (h_tendsto : Tendsto (x ∘ φ) atTop (nhds xStar)) :
    IsStationaryPoint (nonlinearLeastSquaresObjective r) xStar := by
  classical
  let f : Point → ℝ := nonlinearLeastSquaresObjective r
  let gSeq : ℕ → Point := fun k ↦ g[r](x k)
  let d : ℕ → Point := fun k ↦ levenbergMarquardtDirection r 0 (x k)
  have h_mem :
      ∀ k : ℕ, x k ∈ initialSublevelSet f (x 0) := by
    intro k
    induction k with
    | zero =>
        simp [f]
    | succ k hk =>
        have hAccepts :
            armijoAcceptsAtExponent
              f (x k) (d k) (gSeq k) β ρ τ (mIndex k) :=
          (run.armijoIndex k).accepts
        have hρ_nonneg : 0 ≤ ρ := le_of_lt (run.armijoIndex k).rho_pos
        have hStep_nonneg : 0 ≤ (β ^ mIndex k) * τ := by
          exact
            le_of_lt
              (mul_pos (pow_pos (run.armijoIndex k).beta_pos _)
                (run.armijoIndex k).tau_pos)
        have hInner_nonpos :
            inner ℝ (gSeq k) (d k) ≤ 0 := by
          have hDesc := h_descent k
          have hNeg_nonpos : -c1 * ‖gSeq k‖ ^ (2 : ℕ) ≤ 0 := by
            nlinarith [hc1, sq_nonneg ‖gSeq k‖]
          exact le_trans hDesc hNeg_nonpos
        have hAccepts' :
            f (x k +
                ((β ^ mIndex k) * τ) • d k) ≤
              f (x k) +
                ρ * ((β ^ mIndex k) * τ) * inner ℝ (gSeq k) (d k) := by
          rw [armijoAcceptsAtExponent_iff] at hAccepts
          linarith
        have hObjective :
            f (x (k + 1)) ≤ f (x k) := by
          calc
            f (x (k + 1)) =
                f (x k +
                  ((β ^ mIndex k) * τ) • d k) := by
                  simpa [d, run.step_length k] using congrArg f (run.update_eq k)
            _ ≤
                f (x k) +
                  ρ * ((β ^ mIndex k) * τ) * inner ℝ (gSeq k) (d k) :=
              hAccepts'
            _ ≤ f (x k) := by
              have hCorrection_nonpos :
                  ρ * ((β ^ mIndex k) * τ) * inner ℝ (gSeq k) (d k) ≤
                    0 := by
                exact
                  mul_nonpos_of_nonneg_of_nonpos
                    (mul_nonneg hρ_nonneg hStep_nonneg)
                    hInner_nonpos
              linarith
        exact le_trans hObjective hk
  by_cases h_zero : ∃ k : ℕ, gSeq k = 0
  · rcases h_zero with ⟨k0, hk0⟩
    have hk0_mem : x k0 ∈ initialSublevelSet f (x 0) := h_mem k0
    have hk0' : g[r](x k0) = 0 := by
      simpa [gSeq] using hk0
    have hStationary_k0 : IsStationaryPoint f (x k0) := by
      have hGradVectorAt : HasGradientVectorAt f 0 (x k0) := by
        simpa [f, hk0'] using h_hasGradient (x k0) hk0_mem
      have hGradAt : HasGradientAt f 0 (x k0) :=
        (hasGradientAt_iff_hasGradientVectorAt).2 hGradVectorAt
      simpa [IsStationaryPoint] using hGradAt.hasFDerivAt
    have h_tail :
        ∀ t : ℕ, k0 ≤ t → x t = x k0 := by
      intro t htk0
      rcases Nat.exists_eq_add_of_le htk0 with ⟨j, rfl⟩
      induction j with
      | zero =>
          rfl
      | succ j ih =>
          have hgj : gSeq (k0 + j) = 0 := by
            simpa [gSeq, ih (Nat.le_add_right k0 j)] using hk0
          have hgj' : g[r](x (k0 + j)) = 0 := by
            simpa [gSeq] using hgj
          have hDir_zero :
              levenbergMarquardtDirection r 0 (x (k0 + j)) = 0 := by
            have hDir_norm : ‖levenbergMarquardtDirection r 0 (x (k0 + j))‖ ≤ 0 := by
              simpa [hgj'] using h_dir_bound (k0 + j)
            exact norm_eq_zero.mp <| le_antisymm hDir_norm (norm_nonneg _)
          calc
            x (k0 + (j + 1)) = x (k0 + j + 1) := by simp [Nat.add_assoc]
            _ =
                x (k0 + j) +
                  α (k0 + j) • levenbergMarquardtDirection r 0 (x (k0 + j)) :=
              run.update_eq (k0 + j)
            _ = x (k0 + j) := by simp [hDir_zero]
            _ = x k0 := ih (Nat.le_add_right k0 j)
    have h_subseq_const :
        Tendsto (x ∘ φ) atTop (nhds (x k0)) := by
      have h_eventually_eq :
          (fun _ : ℕ ↦ x k0) =ᶠ[atTop] x ∘ φ := by
        filter_upwards [Filter.eventually_ge_atTop k0] with i hi
        symm
        exact h_tail (φ i) (le_trans hi (hφ.id_le i))
      exact Tendsto.congr' h_eventually_eq tendsto_const_nhds
    have hxStar_eq : xStar = x k0 :=
      tendsto_nhds_unique h_tendsto h_subseq_const
    simpa [hxStar_eq] using hStationary_k0
  · have h_nonzero : ∀ k : ℕ, gSeq k ≠ 0 := by
        simpa [not_exists] using h_zero
    have hDirectionNe :
        ∀ k : ℕ, d k ≠ 0 := by
      intro k hk
      have hnorm : 0 < ‖gSeq k‖ := norm_pos_iff.mpr (h_nonzero k)
      have hle : 0 ≤ -c1 * ‖gSeq k‖ ^ (2 : ℕ) := by
        simpa [d, hk] using h_descent k
      have hsq : 0 < ‖gSeq k‖ ^ (2 : ℕ) := by
        nlinarith
      have hnot : ¬ 0 ≤ -c1 * ‖gSeq k‖ ^ (2 : ℕ) := by
        exact not_le_of_gt <| by
          nlinarith
      exact (hnot hle).elim
    have hDescent :
        ∀ k : ℕ, inner ℝ (gSeq k) (d k) ≤ -c1 * ‖gSeq k‖ ^ (2 : ℕ) := by
      intro k
      simpa [d, gSeq] using h_descent k
    have hDirBound :
        ∀ k : ℕ, ‖d k‖ ≤ c2 * ‖gSeq k‖ := by
      intro k
      simpa [d, gSeq] using h_dir_bound k
    have hLineSearch :
        IsNonmonotoneArmijoLineSearch
          f x gSeq d α τ β ρ 0 (fun _ ↦ 0) mIndex :=
      run.toIsNonmonotoneArmijoLineSearch (by simpa [d] using hDirectionNe)
    have hIterateGradient :
        ∀ k : ℕ,
          x k ∈ initialSublevelSet f (x 0) → HasGradientVectorAt f (gSeq k) (x k) := by
      intro k hk
      simpa [f, gSeq] using h_hasGradient (x k) hk
    have hDescentOnSet :
        ∀ k : ℕ,
          x k ∈ initialSublevelSet f (x 0) →
            inner ℝ (gSeq k) (d k) ≤ -c1 * ‖gSeq k‖ ^ (2 : ℕ) := by
      intro k _
      exact hDescent k
    have hDirBoundOnSet :
        ∀ k : ℕ,
          x k ∈ initialSublevelSet f (x 0) →
            ‖d k‖ ≤ c2 * ‖gSeq k‖ := by
      intro k _
      exact hDirBound k
    exact
      nonmonotoneArmijoLineSearch_accumulationPoint_stationary
        f x gSeq d α τ β ρ c1 c2 0 (fun _ ↦ 0) mIndex
        (fun y ↦ g[r](y)) h_compact h_hasGradient hIterateGradient hc1 hc2
        hDescentOnSet hDirBoundOnSet hLineSearch h_gradUniform hφ h_tendsto

/-- The canonical stationary-point conclusion yields the zero-gradient corollary for the
nonlinear least-squares objective. -/
theorem dampedGaussNewton_accumulationPoint_objectiveGradient_eq_zero
    (r : Point → Residual) (x : ℕ → Point) (α : ℕ → ℝ)
    (β ρ τ : ℝ) (mIndex : ℕ → ℕ)
    (run : IsDampedGaussNewtonArmijoSequence r x α β ρ τ mIndex)
    (c1 c2 : ℝ)
    (h_compact : IsCompact (initialSublevelSet (nonlinearLeastSquaresObjective r) (x 0)))
    (h_hasGradient :
      ∀ y ∈ initialSublevelSet (nonlinearLeastSquaresObjective r) (x 0),
        HasGradientVectorAt (nonlinearLeastSquaresObjective r) (g[r](y)) y)
    (h_gradUniform :
      UniformContinuousOn
        (fun y ↦ g[r](y))
        (initialSublevelSet (nonlinearLeastSquaresObjective r) (x 0)))
    (hc1 : 0 < c1) (hc2 : 0 < c2)
    (h_descent :
      ∀ k : ℕ,
        inner ℝ (g[r](x k))
          (levenbergMarquardtDirection r 0 (x k)) ≤
            -c1 * ‖g[r](x k)‖ ^ (2 : ℕ))
    (h_dir_bound :
      ∀ k : ℕ,
        ‖levenbergMarquardtDirection r 0 (x k)‖ ≤
          c2 * ‖g[r](x k)‖)
    {xStar : Point} {φ : ℕ → ℕ}
    (hφ : StrictMono φ)
    (h_tendsto : Tendsto (x ∘ φ) atTop (nhds xStar)) :
    gradient (nonlinearLeastSquaresObjective r) xStar = 0 := by
  have hStationary :
      IsStationaryPoint (nonlinearLeastSquaresObjective r) xStar :=
    dampedGaussNewton_accumulationPoint_stationary
      r x α β ρ τ mIndex run c1 c2 h_compact
      h_hasGradient h_gradUniform hc1 hc2 h_descent h_dir_bound hφ h_tendsto
  simpa using hStationary.gradient_eq_zero

end AccumulationPoint

end
