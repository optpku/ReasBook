section

variable {m n : ℕ}

local notation "Point" => EuclideanSpace ℝ (Fin n)
local notation "Residual" => EuclideanSpace ℝ (Fin m)
local notation "MatrixN" => Matrix (Fin n) (Fin n) ℝ
local notation "JacobianMatrix" => Matrix (Fin m) (Fin n) ℝ

-- Semantic recall: `lean_leansearch` surfaced `IsCompact.tendsto_subseq` and
-- `tendsto_nhds_of_unique_mapClusterPt` as the canonical sequence-convergence API. This file
-- reuses the Chapter 7 scaled Levenberg-Marquardt owners from `Theorem_7_3_6` and keeps only
-- the remaining source-facing global-convergence assumptions local.

/-- The Levenberg-Marquardt direction with identity scaling matrix. -/
def levenbergMarquardtDirection
    (r : Point → Residual) (μ : ℝ) (x : Point) : Point :=
  scaledLevenbergMarquardtDirection
    (residualJacobianMatrix r) r (fun _ : Point ↦ (1 : MatrixN)) μ x

/-- Unfolding formula for `levenbergMarquardtDirection`. -/
theorem levenbergMarquardtDirection_eq
    (r : Point → Residual) (μ : ℝ) (x : Point) :
    levenbergMarquardtDirection r μ x =
      scaledLevenbergMarquardtDirection
        (residualJacobianMatrix r) r (fun _ : Point ↦ (1 : MatrixN)) μ x :=
  rfl

/-- A sequence `x_k` is generated by the Levenberg-Marquardt method when each iterate updates by
the identity-scaled Levenberg-Marquardt direction with a nonnegative damping parameter `μ_k`. -/
structure IsLevenbergMarquardtSequence
    (r : Point → Residual) (x : ℕ → Point) (μ : ℕ → ℝ) where
  mu_nonneg : ∀ k : ℕ, 0 ≤ μ k
  update_eq :
    ∀ k : ℕ,
      x (k + 1) = x k + levenbergMarquardtDirection r (μ k) (x k)

namespace IsLevenbergMarquardtSequence

variable {r : Point → Residual} {x : ℕ → Point} {μ : ℕ → ℝ}

/-- Source-semantic expansion of `IsLevenbergMarquardtSequence`. -/
theorem spec
    (run : IsLevenbergMarquardtSequence r x μ) :
    (∀ k : ℕ, 0 ≤ μ k) ∧
      ∀ k : ℕ,
        x (k + 1) = x k + levenbergMarquardtDirection r (μ k) (x k) :=
  ⟨run.mu_nonneg, run.update_eq⟩

end IsLevenbergMarquardtSequence

/-- The stationary points of `f` at objective value `c`. -/
def levenbergMarquardtSameValueStationaryPoints
    (f : Point → ℝ) (c : ℝ) : Set Point :=
  {x | IsStationaryPoint f x ∧ f x = c}

@[simp] theorem mem_levenbergMarquardtSameValueStationaryPoints
    {f : Point → ℝ} {c : ℝ} {x : Point} :
    x ∈ levenbergMarquardtSameValueStationaryPoints f c ↔
      IsStationaryPoint f x ∧ f x = c :=
  Iff.rfl

/-- Closed and bounded nonlinear least-squares initial sublevel sets are compact. -/
theorem isCompact_initialSublevelSet_nonlinearLeastSquaresObjective
    (r : Point → Residual) (xBar : Point)
    (hClosed :
      IsClosed (initialSublevelSet (nonlinearLeastSquaresObjective r) xBar))
    (hBounded :
      Bornology.IsBounded (initialSublevelSet (nonlinearLeastSquaresObjective r) xBar)) :
    IsCompact (initialSublevelSet (nonlinearLeastSquaresObjective r) xBar) :=
  Metric.isCompact_of_isClosed_isBounded hClosed hBounded

/-- Chapter07 Theorem 7.3.7: let `x_k` be generated by the Levenberg-Marquardt method for the
nonlinear least-squares objective attached to `r`. Assume every level set
`L(x̄) = {x | f x ≤ f x̄}` of `f` is closed and bounded, for every objective value `c` the
stationary set `{x | IsStationaryPoint f x ∧ f x = c}` is finite, every Gram matrix
`J(x)ᵀ * J(x)` built from the Jacobian of `r` is positive definite, and the damping sequence
`μ_k` is bounded above. Then the whole iterate sequence converges to a stationary point of `f`.
-/
theorem levenbergMarquardt_tendsto_stationaryPoint_of_finite_sameValueStationaryPoints
    (r : Point → Residual) (x : ℕ → Point) (μ : ℕ → ℝ)
    (run : IsLevenbergMarquardtSequence r x μ)
    (hLevelClosed :
      ∀ xBar : Point,
        IsClosed (initialSublevelSet (nonlinearLeastSquaresObjective r) xBar))
    (hLevelBounded :
      ∀ xBar : Point,
        Bornology.IsBounded (initialSublevelSet (nonlinearLeastSquaresObjective r) xBar))
    (hSameValueFinite :
      ∀ c : ℝ,
        Set.Finite
          (levenbergMarquardtSameValueStationaryPoints (nonlinearLeastSquaresObjective r) c))
    (hGramPosDef :
      ∀ xStar : Point, (gaussNewtonNormalMatrix r xStar).PosDef)
    (hMuBoundedAbove : ∃ M : ℝ, ∀ k : ℕ, μ k ≤ M) :
    ∃ xStar : Point,
      Tendsto x atTop (nhds xStar) ∧
        IsStationaryPoint (nonlinearLeastSquaresObjective r) xStar := sorry

end
