import OptimizationTheoryAndMethods_SunYuan_2006.Compat
import OptimizationTheoryAndMethods_SunYuan_2006.Chap01.Definition_1_4_7
import OptimizationTheoryAndMethods_SunYuan_2006.Chap03.Theorem_3_5_8

noncomputable section

open Filter
open scoped Topology

section NegativeCurvatureDirectionMethod

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]

-- Domain sampling pass:
-- * primary domain: global convergence of negative-curvature direction sequences on a real
--   Hilbert space;
-- * sampled source/core owners: `negativeCurvatureLevelSet` from `Theorem_3_5_6` and
--   `negativeCurvatureStationaryPointsInLevelSet` below, together with
--   `IsStationaryPoint` from `Chapter01.Definition_1_4_7`, and
--   `IsNegativeCurvatureLineSearchSequence` from `Theorem_3_5_6`;
-- * source-facing layer refined here: the primitive sequence data from Theorems 3.5.6 and
--   3.5.8, plus the finite-stationary-set hypothesis.

/-- The stationary points of `f` that lie in the level set `L(x₀)`. -/
def negativeCurvatureStationaryPointsInLevelSet
    (D : Set E) (f : E → ℝ) (x₀ : E) : Set E :=
  {x | x ∈ negativeCurvatureLevelSet D f x₀ ∧ IsStationaryPoint f x}

/-- Membership in `negativeCurvatureStationaryPointsInLevelSet D f x₀` means lying in the level
set `L(x₀)` and being stationary for `f`. -/
@[simp] theorem mem_negativeCurvatureStationaryPointsInLevelSet
    {D : Set E} {f : E → ℝ} {x₀ x : E} :
    x ∈ negativeCurvatureStationaryPointsInLevelSet D f x₀ ↔
      x ∈ negativeCurvatureLevelSet D f x₀ ∧ IsStationaryPoint f x :=
  Iff.rfl

/-- Every point in `negativeCurvatureStationaryPointsInLevelSet D f x₀` lies in the level set
`L(x₀)`. -/
theorem negativeCurvatureStationaryPointsInLevelSet_subset_levelSet
    (D : Set E) (f : E → ℝ) (x₀ : E) :
    negativeCurvatureStationaryPointsInLevelSet D f x₀ ⊆
      negativeCurvatureLevelSet D f x₀ := fun _ hx ↦ hx.1

/-- Every point in `negativeCurvatureStationaryPointsInLevelSet D f x₀` is stationary for `f`. -/
theorem IsStationaryPoint.of_mem_negativeCurvatureStationaryPointsInLevelSet
    {D : Set E} {f : E → ℝ} {x₀ x : E}
    (hx : x ∈ negativeCurvatureStationaryPointsInLevelSet D f x₀) :
    IsStationaryPoint f x :=
  hx.2

variable (D : Set E) (f : E → ℝ) (x s d : ℕ → E) (backtrackingExponent : ℕ → ℕ)
  (x₀ : E) (ρ γ c₁ c₂ : ℝ)
variable (hD : IsOpen D) (hC2 : ContDiffOn ℝ 2 f D)
variable (hLevelSetCompact : IsCompact (negativeCurvatureLevelSet D f x₀))
variable (hx_mem : ∀ k, x k ∈ D)
variable (hs_bounded : Bornology.IsBounded (Set.range s))
variable (hd_bounded : Bornology.IsBounded (Set.range d))
variable (hLineSearch :
  IsNegativeCurvatureLineSearchSequence f x s d backtrackingExponent x₀ ρ γ)
variable (hDescentPair : ∀ k, IsDescentPairAt f (x k) (s k) (d k))
variable (hc₁ : 0 < c₁) (hc₂ : 0 < c₂)
variable (hDescentLowerBound :
  ∀ k, c₁ * ‖s k‖ ^ 2 ≤ -inner ℝ (s k) (gradient f (x k)))
variable (hCurvatureUpperBound :
  ∀ k, hessianQuadraticAt f (x k) (d k) ≤ -c₂ * ‖d k‖ ^ 2)
variable (hStationaryFinite :
  Set.Finite (negativeCurvatureStationaryPointsInLevelSet D f x₀))

include D f x s d backtrackingExponent x₀ ρ γ c₁ c₂
  hD hC2 hLevelSetCompact hx_mem hs_bounded hd_bounded hLineSearch hDescentPair
  hc₁ hc₂ hDescentLowerBound hCurvatureUpperBound hStationaryFinite

/-- Chapter03 Theorem 3.5.9 (1): in addition to the assumptions of
Chapter03 Theorem 3.5.8, assume that `f` has only finitely many stationary points in the
level set `L(x₀)`. Then the entire sequence generated by the second-order Armijo
steplength algorithm `(3.5.45)` and `(3.5.46)` converges to some `xStar ∈ L(x₀)`. -/
theorem negativeCurvatureLineSearchMethod_tendsto_of_finiteStationaryPoints
    :
    ∃ xStar : E, xStar ∈ negativeCurvatureLevelSet D f x₀ ∧
      Tendsto x atTop (nhds xStar) := sorry

/-- Chapter03 Theorem 3.5.9 (2): under the same hypotheses as `(1)`, every limit point `xStar`
of the negative-curvature direction method is stationary, formalized by
`IsStationaryPoint f xStar`. -/
theorem negativeCurvatureLineSearchMethod_limit_stationary
    {xStar : E}
    (hx : Tendsto x atTop (nhds xStar)) :
    IsStationaryPoint f xStar := sorry

/-- Companion form of Chapter03 Theorem 3.5.9 (1) and `(2)`: the whole line-search sequence
converges to a stationary point lying in `L(x₀)`, packaged by the source-facing owner
`negativeCurvatureStationaryPointsInLevelSet D f x₀`. -/
theorem negativeCurvatureLineSearchMethod_tendsto_to_stationaryPoint_of_finiteStationaryPoints :
    ∃ xStar : E, xStar ∈ negativeCurvatureStationaryPointsInLevelSet D f x₀ ∧
      Tendsto x atTop (nhds xStar) := by
  have hconverges :
      ∃ xStar : E, xStar ∈ negativeCurvatureLevelSet D f x₀ ∧
        Tendsto x atTop (nhds xStar) :=
    negativeCurvatureLineSearchMethod_tendsto_of_finiteStationaryPoints
      D f x s d backtrackingExponent x₀ ρ γ c₁ c₂
      hD hC2 hLevelSetCompact hx_mem hs_bounded hd_bounded hLineSearch hDescentPair
      hc₁ hc₂ hDescentLowerBound hCurvatureUpperBound hStationaryFinite
  rcases hconverges with
    ⟨xStar, hxStar_level, hxStar_tendsto⟩
  have hstationary :
      Tendsto x atTop (nhds xStar) → IsStationaryPoint f xStar :=
    negativeCurvatureLineSearchMethod_limit_stationary
      D f x s d backtrackingExponent x₀ ρ γ c₁ c₂
      hD hC2 hLevelSetCompact hx_mem hs_bounded hd_bounded hLineSearch hDescentPair
      hc₁ hc₂ hDescentLowerBound hCurvatureUpperBound hStationaryFinite
  exact ⟨xStar, ⟨hxStar_level,
    hstationary hxStar_tendsto⟩,
    hxStar_tendsto⟩

/-- Chapter03 Theorem 3.5.9 (3): under the same hypotheses as `(1)`, the Hessian at the limit
point is positive semidefinite, which formalizes `G(xStar) ≥ 0`. -/
theorem hasPositiveSemidefiniteHessianAt_limit_of_negativeCurvatureLineSearchMethod
    {xStar : E}
    (hx : Tendsto x atTop (nhds xStar)) :
    HasPositiveSemidefiniteHessianAt f xStar := sorry

/-- Chapter03 Theorem 3.5.9 (4): under the same hypotheses as `(1)`, if infinitely many
iterate Hessians `G_k` fail to be positive semidefinite, then the limit Hessian `G(xStar)`
has `0` as an eigenvalue. -/
theorem hessianAt_hasZeroEigenvalue_at_limit_of_negativeCurvatureLineSearchMethod
    {xStar : E}
    (hx : Tendsto x atTop (nhds xStar))
    (hFrequently_non_posSemidef :
      Set.Infinite {k : ℕ | ¬ HasPositiveSemidefiniteHessianAt f (x k)}) :
    Module.End.HasEigenvalue (hessianAt f xStar).toLinearMap 0 := sorry

omit D f x s d backtrackingExponent x₀ ρ γ c₁ c₂
  hD hC2 hLevelSetCompact hx_mem hs_bounded hd_bounded hLineSearch hDescentPair
  hc₁ hc₂ hDescentLowerBound hCurvatureUpperBound hStationaryFinite

end NegativeCurvatureDirectionMethod
