import OptimizationTheoryAndMethods_SunYuan_2006.Compat
import Mathlib.LinearAlgebra.Matrix.PosDef
import OptimizationTheoryAndMethods_SunYuan_2006.Chap03.Theorem_3_4_3
import OptimizationTheoryAndMethods_SunYuan_2006.Chap03.Theorem_3_5_10

noncomputable section

open Filter

section

variable {n : ℕ}

local notation "Point" => EuclideanSpace ℝ (Fin n)

/-- Chapter03 Theorem 3.5.11 (1): let `f : ℝ^n → ℝ` have twice continuous derivatives on the open
set `D`, let `x₀ ∈ D`, and assume that the level set
`L(x₀) = {x ∈ D | f x ≤ f x₀}` is compact. If `f` has only finitely many stationary points in
`L(x₀)` and `{x_k}` is generated by the second-order step rule `(3.5.50)`-`(3.5.52)`, then the
whole sequence converges to some limit point `x*`. -/
theorem secondOrderStepRule_tendsto_of_finiteStationaryPoints
    {D : Set Point} {f : Point → ℝ} {x s d : ℕ → Point} {α : ℕ → ℝ} {x₀ : Point} {ρ σ : ℝ}
    (hD : IsOpen D)
    (hC2 : ContDiffOn ℝ 2 f D)
    (hLevelCompact : IsCompact (negativeCurvatureLevelSet D f x₀))
    (hStationaryFinite : Set.Finite (negativeCurvatureStationaryPointsInLevelSet D f x₀))
    (hSeq : IsNegativeCurvatureDirectionSequenceOn f D x₀ x s d α ρ σ) :
    ∃ xStar : Point, xStar ∈ negativeCurvatureLevelSet D f x₀ ∧
      Tendsto x atTop (nhds xStar) := sorry

/-- Chapter03 Theorem 3.5.11 (2): under the same hypotheses as `(1)`, the limit point `x*`
of the second-order-step-rule sequence is stationary, formalized by
`IsStationaryPoint f xStar`. -/
theorem secondOrderStepRule_limit_stationary
    {D : Set Point} {f : Point → ℝ} {x s d : ℕ → Point} {α : ℕ → ℝ} {x₀ xStar : Point}
    {ρ σ : ℝ}
    (hD : IsOpen D)
    (hC2 : ContDiffOn ℝ 2 f D)
    (hLevelCompact : IsCompact (negativeCurvatureLevelSet D f x₀))
    (hStationaryFinite : Set.Finite (negativeCurvatureStationaryPointsInLevelSet D f x₀))
    (hSeq : IsNegativeCurvatureDirectionSequenceOn f D x₀ x s d α ρ σ)
    (hx : Tendsto x atTop (nhds xStar)) :
    IsStationaryPoint f xStar := sorry

/-- Chapter03 Theorem 3.5.11 (3): under the same hypotheses as `(1)`, the Hessian at the limit
point is positive semidefinite, formalizing `G(x*) ≥ 0` at the chapter's canonical quadratic-form
owner. -/
theorem hasPositiveSemidefiniteHessianAt_limit_of_secondOrderStepRule
    {D : Set Point} {f : Point → ℝ} {x s d : ℕ → Point} {α : ℕ → ℝ} {x₀ xStar : Point}
    {ρ σ : ℝ}
    (hD : IsOpen D)
    (hC2 : ContDiffOn ℝ 2 f D)
    (hLevelCompact : IsCompact (negativeCurvatureLevelSet D f x₀))
    (hStationaryFinite : Set.Finite (negativeCurvatureStationaryPointsInLevelSet D f x₀))
    (hSeq : IsNegativeCurvatureDirectionSequenceOn f D x₀ x s d α ρ σ)
    (hx : Tendsto x atTop (nhds xStar)) :
    HasPositiveSemidefiniteHessianAt f xStar := sorry

/-- Companion matrix form of Chapter03 Theorem 3.5.11 (3): the explicit Hessian matrix `G(x*)`
in the standard basis is positive semidefinite. -/
theorem hessianMatrix_posSemidef_at_limit_of_secondOrderStepRule
    {D : Set Point} {f : Point → ℝ} {x s d : ℕ → Point} {α : ℕ → ℝ} {x₀ xStar : Point}
    {ρ σ : ℝ}
    (hD : IsOpen D)
    (hC2 : ContDiffOn ℝ 2 f D)
    (hLevelCompact : IsCompact (negativeCurvatureLevelSet D f x₀))
    (hStationaryFinite : Set.Finite (negativeCurvatureStationaryPointsInLevelSet D f x₀))
    (hSeq : IsNegativeCurvatureDirectionSequenceOn f D x₀ x s d α ρ σ)
    (hx : Tendsto x atTop (nhds xStar)) :
    (hessianMatrixAt f xStar).PosSemidef := sorry

/-- Chapter03 Theorem 3.5.11 (4): under the same hypotheses as `(1)`, if infinitely many
iterate Hessians fail to be positive semidefinite, then the limit Hessian at `x*` has
`0` as an eigenvalue. -/
theorem hessianAt_hasZeroEigenvalue_at_limit_of_secondOrderStepRule
    {D : Set Point} {f : Point → ℝ} {x s d : ℕ → Point} {α : ℕ → ℝ} {x₀ xStar : Point}
    {ρ σ : ℝ}
    (hD : IsOpen D)
    (hC2 : ContDiffOn ℝ 2 f D)
    (hLevelCompact : IsCompact (negativeCurvatureLevelSet D f x₀))
    (hStationaryFinite : Set.Finite (negativeCurvatureStationaryPointsInLevelSet D f x₀))
    (hSeq : IsNegativeCurvatureDirectionSequenceOn f D x₀ x s d α ρ σ)
    (hx : Tendsto x atTop (nhds xStar))
    (hFrequently_non_posSemidef :
      Set.Infinite {k : ℕ | ¬ HasPositiveSemidefiniteHessianAt f (x k)}) :
    Module.End.HasEigenvalue (hessianAt f xStar).toLinearMap 0 := sorry

/-- Companion matrix form of Chapter03 Theorem 3.5.11 (4): if infinitely many explicit Hessian
matrices `G_k` fail to be positive semidefinite, then the matrix `G(x*)` has `0` as an
eigenvalue. -/
theorem hessianMatrix_hasZeroEigenvalue_at_limit_of_secondOrderStepRule
    {D : Set Point} {f : Point → ℝ} {x s d : ℕ → Point} {α : ℕ → ℝ} {x₀ xStar : Point}
    {ρ σ : ℝ}
    (hD : IsOpen D)
    (hC2 : ContDiffOn ℝ 2 f D)
    (hLevelCompact : IsCompact (negativeCurvatureLevelSet D f x₀))
    (hStationaryFinite : Set.Finite (negativeCurvatureStationaryPointsInLevelSet D f x₀))
    (hSeq : IsNegativeCurvatureDirectionSequenceOn f D x₀ x s d α ρ σ)
    (hx : Tendsto x atTop (nhds xStar))
    (hFrequently_non_posSemidef :
      Set.Infinite {k : ℕ | ¬ (hessianMatrixAt f (x k)).PosSemidef}) :
    Module.End.HasEigenvalue
      (Matrix.toEuclideanLin (hessianMatrixAt f xStar))
      0 := sorry

end
