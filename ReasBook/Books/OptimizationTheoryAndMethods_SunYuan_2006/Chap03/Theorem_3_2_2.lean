-- Semantic recall: Chapter 3 already owns the canonical Hessian-matrix and quadratic-rate
-- interfaces. This file keeps only the source-faithful Newton-sequence predicate and the
-- local Hessian-neighborhood hypothesis used in Theorem 3.2.2.

variable {n : ℕ}

local notation "Point" => EuclideanSpace ℝ (Fin n)
local notation "Hessian" => Matrix (Fin n) (Fin n) ℝ

/-- A sequence of iterates, search directions, and Hessian matrices is generated by Newton's
method with initial point `x0` when the sequence starts at `x0`, each search direction solves
the Newton linear system with an invertible Hessian matrix, and each new iterate is updated by
that direction. -/
def IsNewtonMethodSequence
    (f : Point → ℝ) (x s : ℕ → Point) (G : ℕ → Hessian) (x0 : Point) : Prop :=
  x 0 = x0 ∧
    ∀ k, IsUnit (G k) ∧ (G k).mulVec (s k) = -gradient f (x k) ∧ x (k + 1) = x k + s k

/-- A Newton method sequence starts at `x0` and each stage records invertibility, the Newton
equation, and the iterate update. -/
theorem IsNewtonMethodSequence.stepSpec
    {f : Point → ℝ} {x s : ℕ → Point} {G : ℕ → Hessian} {x0 : Point}
    (h : IsNewtonMethodSequence f x s G x0) :
    x 0 = x0 ∧
      ∀ k, IsUnit (G k) ∧
        (G k).mulVec (s k) = -gradient f (x k) ∧
          x (k + 1) = x k + s k :=
  h

/-- Unfolding formula for `IsNewtonMethodSequence`. -/
theorem isNewtonMethodSequence_iff
    (f : Point → ℝ) (x s : ℕ → Point) (G : ℕ → Hessian) (x0 : Point) :
    IsNewtonMethodSequence f x s G x0 ↔
      x 0 = x0 ∧
        ∀ k, IsUnit (G k) ∧
          (G k).mulVec (s k) = -gradient f (x k) ∧
            x (k + 1) = x k + s k := Iff.rfl

/-- The `k`-th Hessian in a Newton method sequence is invertible. -/
theorem IsNewtonMethodSequence.isUnit
    {f : Point → ℝ} {x s : ℕ → Point} {G : ℕ → Hessian} {x0 : Point}
    (h : IsNewtonMethodSequence f x s G x0) (k : ℕ) :
    IsUnit (G k) :=
  (h.stepSpec.2 k).1

/-- The `k`-th Newton direction solves the linear system
`(G k).mulVec (s k) = -gradient f (x k)`. -/
theorem IsNewtonMethodSequence.newtonEq
    {f : Point → ℝ} {x s : ℕ → Point} {G : ℕ → Hessian} {x0 : Point}
    (h : IsNewtonMethodSequence f x s G x0) (k : ℕ) :
    (G k).mulVec (s k) = -gradient f (x k) :=
  (h.stepSpec.2 k).2.1

/-- The Newton iteration updates by `x (k + 1) = x k + s k`. -/
theorem IsNewtonMethodSequence.nextEq
    {f : Point → ℝ} {x s : ℕ → Point} {G : ℕ → Hessian} {x0 : Point}
    (h : IsNewtonMethodSequence f x s G x0) (k : ℕ) :
    x (k + 1) = x k + s k :=
  (h.stepSpec.2 k).2.2

/-- A matrix field `G` is a local Lipschitz Hessian matrix field for `f` at `xStar` when
on some ball about `xStar`, `G x` represents the Hessian of `f` and varies Lipschitzly in
operator norm. -/
def HasLocalLipschitzHessianMatrixAt
    (f : Point → ℝ) (G : Point → Hessian) (xStar : Point) : Prop :=
  ∃ ε > 0,
    (∀ x, x ∈ Metric.ball xStar ε →
      HasFDerivAt (gradient f)
        (((Matrix.toEuclideanCLM : Hessian ≃⋆ₐ[ℝ] Point →L[ℝ] Point) (G x)))
        x) ∧
      ∃ L, 0 ≤ L ∧ ∀ x y,
        x ∈ Metric.ball xStar ε →
        y ∈ Metric.ball xStar ε →
        ‖G x - G y‖ ≤ L * ‖x - y‖

/-- Unfolding formula for `HasLocalLipschitzHessianMatrixAt`. -/
theorem hasLocalLipschitzHessianMatrixAt_iff
    (f : Point → ℝ) (G : Point → Hessian) (xStar : Point) :
    HasLocalLipschitzHessianMatrixAt f G xStar ↔
      ∃ ε > 0,
        (∀ x, x ∈ Metric.ball xStar ε →
          HasFDerivAt (gradient f)
            (((Matrix.toEuclideanCLM : Hessian ≃⋆ₐ[ℝ] Point →L[ℝ] Point) (G x)))
            x) ∧
          ∃ L, 0 ≤ L ∧ ∀ x y,
            x ∈ Metric.ball xStar ε →
            y ∈ Metric.ball xStar ε →
            ‖G x - G y‖ ≤ L * ‖x - y‖ := Iff.rfl

/-- A global Hessian field in the canonical `HasFDerivAt (gradient f)` form together with a
Lipschitz bound on a ball gives the local Hessian hypothesis used in Theorem 3.2.2. -/
theorem hasLocalLipschitzHessianMatrixAt_of_hasFDerivAt
    {f : Point → ℝ} {G : Point → Hessian} {xStar : Point}
    (hHessian : ∀ x,
      HasFDerivAt (gradient f)
        (((Matrix.toEuclideanCLM : Hessian ≃⋆ₐ[ℝ] Point →L[ℝ] Point) (G x)))
        x)
    (hLipschitz : ∃ ε > 0, ∃ L, 0 ≤ L ∧ ∀ x y,
      x ∈ Metric.ball xStar ε →
      y ∈ Metric.ball xStar ε →
      ‖G x - G y‖ ≤ L * ‖x - y‖) :
    HasLocalLipschitzHessianMatrixAt f G xStar := by
  rcases hLipschitz with ⟨ε, hε, L, hL_nonneg, hL⟩
  refine ⟨ε, hε, ?_, L, hL_nonneg, hL⟩
  intro x hx
  exact hHessian x

/-- Helper for Chapter03 Theorem 3.2.2: each recorded search direction in a Newton method
sequence agrees with the canonical inverse-Hessian Newton direction at that iterate. -/
theorem IsNewtonMethodSequence.direction_eq_newtonDirection
    {f : Point → ℝ} {x s : ℕ → Point} {G : Point → Hessian} {x0 : Point}
    (h : IsNewtonMethodSequence f x s (fun k ↦ G (x k)) x0) (k : ℕ) :
    s k = newtonDirection f (x k) G := by
  -- Package the `k`-th step as the canonical Newton-direction predicate.
  have hDirection : IsNewtonDirectionAt f (x k) G (s k) := by
    exact ⟨h.isUnit k, h.newtonEq k⟩
  -- Uniqueness of the invertible Newton linear system identifies the recorded step.
  exact
    (isNewtonDirectionAt_iff_eq_newtonDirection f (x k) G (h.isUnit k) (s k)).mp
      hDirection

/-- Helper for Chapter03 Theorem 3.2.2: the update formula in a Newton method sequence can be
rewritten using the canonical Newton direction. -/
theorem IsNewtonMethodSequence.nextEq_newtonUpdate
    {f : Point → ℝ} {x s : ℕ → Point} {G : Point → Hessian} {x0 : Point}
    (h : IsNewtonMethodSequence f x s (fun k ↦ G (x k)) x0) (k : ℕ) :
    x (k + 1) = x k + newtonDirection f (x k) G := by
  -- Replace the stored search direction by the canonical Newton direction.
  rw [h.nextEq k, h.direction_eq_newtonDirection k]

/-- Helper for Chapter03 Theorem 3.2.2: the Newton iterate update is the source formula
`x_(k+1) = x_k - (G(x_k))⁻¹ ∇f(x_k)` whenever the sequence satisfies the Newton system. -/
theorem IsNewtonMethodSequence.nextEq_sub_inv_gradient
    {f : Point → ℝ} {x s : ℕ → Point} {G : Point → Hessian} {x0 : Point}
    (h : IsNewtonMethodSequence f x s (fun k ↦ G (x k)) x0) (k : ℕ) :
    x (k + 1) = x k - Matrix.toEuclideanLin ((G (x k))⁻¹) (gradient f (x k)) := by
  -- Normalize the update to the explicit inverse-Hessian Newton formula.
  rw [sub_eq_add_neg, h.nextEq k, h.direction_eq_newtonDirection k,
    newtonDirection_eq_neg_inv_apply]

/-- Helper for Chapter03 Theorem 3.2.2: the local Hessian hypothesis yields a working ball on
which `gradient f` is differentiable, its derivative is represented by `G`, and that derivative
field is Lipschitz in operator norm. -/
theorem localGradientFDerivLipschitzData
    (f : Point → ℝ)
    (G : Point → Hessian)
    (xStar : Point)
    (hHessian : HasLocalLipschitzHessianMatrixAt f G xStar) :
    ∃ ε > 0, ∃ γ : NNReal,
      DifferentiableOn ℝ (gradient f) (Metric.ball xStar ε) ∧
      (∀ x, x ∈ Metric.ball xStar ε →
        fderiv ℝ (gradient f) x =
          ((Matrix.toEuclideanCLM : Hessian ≃⋆ₐ[ℝ] Point →L[ℝ] Point) (G x))) ∧
      LipschitzOnWith γ (fun x ↦ fderiv ℝ (gradient f) x) (Metric.ball xStar ε) := by
  rcases hHessian with ⟨ε, hε, hDeriv, L, hL_nonneg, hL⟩
  refine ⟨ε, hε, Real.toNNReal L, ?_, ?_, ?_⟩
  · -- Each pointwise Hessian witness gives differentiability of `gradient f` on the ball.
    intro x hx
    exact (hDeriv x hx).differentiableAt.differentiableWithinAt
  · -- Keep the derivative spelling synchronized with the source Hessian matrix field.
    intro x hx
    exact (hDeriv x hx).fderiv
  · -- Route correction: stay on the CLM side and transport the matrix norm only at the end.
    refine LipschitzOnWith.of_dist_le' ?_
    intro x hx y hy
    calc
      dist (fderiv ℝ (gradient f) x) (fderiv ℝ (gradient f) y)
          = ‖fderiv ℝ (gradient f) x - fderiv ℝ (gradient f) y‖ := by
              simp [dist_eq_norm]
      _ = ‖((Matrix.toEuclideanCLM : Hessian ≃⋆ₐ[ℝ] Point →L[ℝ] Point) (G x)) -
            ((Matrix.toEuclideanCLM : Hessian ≃⋆ₐ[ℝ] Point →L[ℝ] Point) (G y))‖ := by
            rw [(hDeriv x hx).fderiv, (hDeriv y hy).fderiv]
      _ = ‖(Matrix.toEuclideanCLM : Hessian ≃⋆ₐ[ℝ] Point →L[ℝ] Point) (G x - G y)‖ := by
            simp [map_sub]
      _ = ‖G x - G y‖ := by
            simpa using Matrix.l2_opNorm_toEuclideanCLM (G x - G y)
      _ ≤ L * ‖x - y‖ := hL x y hx hy
      _ = L * dist x y := by
            simp [dist_eq_norm]

/-- Helper for Chapter03 Theorem 3.2.2: the canonical recursive Newton orbit obtained by
repeatedly applying the explicit inverse-Hessian update. -/
def newtonIterates
    (f : Point → ℝ) (G : Point → Hessian) (x0 : Point) : ℕ → Point
  | 0 => x0
  | k + 1 =>
      newtonIterates f G x0 k -
        Matrix.toEuclideanLin ((G (newtonIterates f G x0 k))⁻¹)
          (gradient f (newtonIterates f G x0 k))

/-- Helper for Chapter03 Theorem 3.2.2: the recursive Newton orbit starts from the prescribed
initial point. -/
theorem newtonIterates_zero
    (f : Point → ℝ) (G : Point → Hessian) (x0 : Point) :
    newtonIterates f G x0 0 = x0 :=
  rfl

/-- Helper for Chapter03 Theorem 3.2.2: each successor of the recursive Newton orbit is given by
the explicit inverse-Hessian Newton update. -/
theorem newtonIterates_succ
    (f : Point → ℝ) (G : Point → Hessian) (x0 : Point) (k : ℕ) :
    newtonIterates f G x0 (k + 1) =
      newtonIterates f G x0 k -
        Matrix.toEuclideanLin ((G (newtonIterates f G x0 k))⁻¹)
          (gradient f (newtonIterates f G x0 k)) := by
  -- Unfold a single recursive Newton step and keep the update in the normalized spelling.
  simp [newtonIterates]

/-- Helper for Chapter03 Theorem 3.2.2: once the Hessian is invertible along the recursive
Newton orbit, the primitive-recursive iterates and canonical Newton directions form an
`IsNewtonMethodSequence`. -/
theorem newtonIterates_isNewtonMethodSequence_of_isUnit
    (f : Point → ℝ)
    (G : Point → Hessian)
    (x0 : Point)
    (hUnit : ∀ k : ℕ, IsUnit (G (newtonIterates f G x0 k))) :
    IsNewtonMethodSequence
      f
      (newtonIterates f G x0)
      (fun k ↦ newtonDirection f (newtonIterates f G x0 k) G)
      (fun k ↦ G (newtonIterates f G x0 k))
      x0 := by
  constructor
  · -- The recursive orbit starts from the prescribed initial point.
    exact newtonIterates_zero f G x0
  · intro k
    refine ⟨hUnit k, ?_, ?_⟩
    · -- The canonical Newton direction solves the Newton linear system at each iterate.
      simpa using
        (newtonDirection_newtonEq f (newtonIterates f G x0 k) G (hUnit k))
    · -- The recursive successor clause is exactly the Newton update.
      calc
        newtonIterates f G x0 (k + 1)
            = newtonIterates f G x0 k -
                Matrix.toEuclideanLin ((G (newtonIterates f G x0 k))⁻¹)
                  (gradient f (newtonIterates f G x0 k)) := by
                    rw [newtonIterates_succ]
        _ = newtonIterates f G x0 k +
              newtonDirection f (newtonIterates f G x0 k) G := by
              simp [newtonDirection_eq_neg_inv_apply, sub_eq_add_neg]

/-- Helper for Chapter03 Theorem 3.2.2: on a small ball around `xStar`, the Hessian matrices
stay invertible and their inverses satisfy a uniform operator-norm bound. -/
theorem hessianInverseControlNearXStar
    (f : Point → ℝ)
    (G : Point → Hessian)
    (xStar : Point)
    (hHessian : HasLocalLipschitzHessianMatrixAt f G xStar)
    (hPosDef : (G xStar).PosDef) :
    ∃ ε > 0, ∃ B : ℝ, ∀ x, x ∈ Metric.ball xStar ε →
      IsUnit (G x) ∧ ‖(G x)⁻¹‖ ≤ B := by
  classical
  by_cases hne : Nonempty (Fin n)
  · letI : Nonempty (Fin n) := hne
    rcases hHessian with ⟨ε0, hε0, _hDeriv, L, hL_nonneg, hL⟩
    let α : ℝ := ‖(G xStar)⁻¹‖
    let β : ℝ := 1 / (α + 1)
    let ε : ℝ := min ε0 (β / max L 1)
    have hε_pos : 0 < ε := by
      -- Choose a radius that is simultaneously inside the Hessian-Lipschitz ball and
      -- small enough for the von Neumann perturbation threshold.
      refine lt_min hε0 ?_
      dsimp [ε, β]
      positivity
    have hxStar : xStar ∈ Metric.ball xStar ε0 := by
      simpa [Metric.mem_ball] using hε0
    have hRootUnit : IsUnit (G xStar) := hPosDef.isUnit
    letI : Fact (1 ≤ (2 : ENNReal)) := ⟨by norm_num⟩
    have hNormL2 :
        IsMatrixNorm (lpMatrixNorm (2 : ENNReal) : Matrix (Fin n) (Fin n) ℝ → ℝ) := by
      simpa [lpMatrixNorm] using
        (inducedMatrixNorm_isMatrixNorm
          (domainNorm := lpNorm (2 : ENNReal))
          (codomainNorm := lpNorm (2 : ENNReal)))
    have hSubL2 :
        MatrixNormSubmultiplicative
          (lpMatrixNorm (2 : ENNReal) : Matrix (Fin n) (Fin n) ℝ → ℝ) := by
      simpa using (lpMatrixNorm_isSubmultiplicative (n := n) (p := (2 : ENNReal)))
    have hOneL2 :
        lpMatrixNorm (2 : ENNReal) (1 : Hessian) = 1 := by
      -- Use the chapter-owned identity-norm theorem for induced matrix norms.
      calc
        lpMatrixNorm (2 : ENNReal) (1 : Hessian) = ‖(1 : Hessian)‖ := by
          rw [l2MatrixNorm_eq_l2OperatorNorm]
        _ = 1 := by
          simp
    have hRootInvLp :
        lpMatrixNorm (2 : ENNReal) (G xStar)⁻¹ ≤ α := by
      calc
        lpMatrixNorm (2 : ENNReal) (G xStar)⁻¹ = ‖(G xStar)⁻¹‖ := by
          rw [l2MatrixNorm_eq_l2OperatorNorm]
        _ ≤ α := by
          simp [α]
    have hαβ : α * β < 1 := by
      -- The chosen scalar perturbation threshold is strictly below the inverse-norm radius.
      have hα1_pos : 0 < α + 1 := by
        dsimp [α]
        positivity
      dsimp [β]
      rw [mul_one_div]
      exact (div_lt_iff₀ hα1_pos).2 (by linarith [show (0 : ℝ) ≤ α by simp [α]])
    refine ⟨ε, hε_pos, α / (1 - α * β), ?_⟩
    intro x hx
    have hε_le_root : ε ≤ ε0 := by
      dsimp [ε]
      exact min_le_left _ _
    have hε_le_small : ε ≤ β / max L 1 := by
      dsimp [ε]
      exact min_le_right _ _
    have hx0 : x ∈ Metric.ball xStar ε0 := by
      have hxε : dist x xStar < ε := by
        simpa [Metric.mem_ball] using hx
      exact by
        simpa [Metric.mem_ball] using lt_of_lt_of_le hxε hε_le_root
    have hpert : ‖G xStar - G x‖ ≤ β := by
      have hxnorm : ‖x - xStar‖ < ε := by
        simpa [Metric.mem_ball, dist_eq_norm] using hx
      have hxnorm_le : ‖x - xStar‖ ≤ ε := le_of_lt hxnorm
      have hsmall :
          max L 1 * (β / max L 1) = β := by
        have hmax_ne : max L 1 ≠ 0 := by
          positivity
        field_simp [β, hmax_ne]
      calc
        ‖G xStar - G x‖ = ‖G x - G xStar‖ := by
          rw [norm_sub_rev]
        _ ≤ L * ‖x - xStar‖ := hL x xStar hx0 hxStar
        _ ≤ L * ε := mul_le_mul_of_nonneg_left hxnorm_le hL_nonneg
        _ ≤ L * (β / max L 1) := mul_le_mul_of_nonneg_left hε_le_small hL_nonneg
        _ ≤ max L 1 * (β / max L 1) := by
          refine mul_le_mul_of_nonneg_right (le_max_left _ _) ?_
          positivity
        _ = β := hsmall
    have hpert_lp :
        lpMatrixNorm (2 : ENNReal) (G xStar - G x) ≤ β := by
      rw [l2MatrixNorm_eq_l2OperatorNorm]
      exact hpert
    have hneumann :=
      vonNeumannLemma_isUnit_and_inv_norm_le_of_norm_sub_le
        (N := lpMatrixNorm (2 : ENNReal))
        hNormL2 hSubL2 hOneL2
        (A := G xStar) (B := G x)
        (α := α) (β := β)
        hRootUnit hRootInvLp hpert_lp hαβ
    refine ⟨hneumann.1, ?_⟩
    have hbound_lp :
        lpMatrixNorm (2 : ENNReal) (G x)⁻¹ ≤ α / (1 - α * β) := hneumann.2
    rw [l2MatrixNorm_eq_l2OperatorNorm] at hbound_lp
    exact hbound_lp
  · letI : IsEmpty (Fin n) := not_nonempty_iff.mp hne
    refine ⟨1, by norm_num, ‖(G xStar)⁻¹‖, ?_⟩
    intro x _hx
    -- In the zero-dimensional case every point and Hessian matrix is definitionally unique.
    have hx : x = xStar := Subsingleton.elim _ _
    subst hx
    exact ⟨hPosDef.isUnit, le_rfl⟩

/-- Helper for Chapter03 Theorem 3.2.2: applying the inverse Hessian operator to the Hessian
action returns the original vector. -/
theorem toEuclideanLin_inv_toEuclideanCLM_apply
    (A : Hessian)
    (hA : IsUnit A)
    (v : Point) :
    Matrix.toEuclideanLin (A⁻¹)
      (((Matrix.toEuclideanCLM : Hessian ≃⋆ₐ[ℝ] Point →L[ℝ] Point) A) v) = v := by
  letI := hA.invertible
  -- Route correction: cancel the matrix inverse once at the matrix-action layer.
  apply WithLp.ofLp_injective
  simp [Matrix.ofLp_toEuclideanCLM, Matrix.ofLp_toLpLin (p := (2 : ENNReal))
    (q := (2 : ENNReal)), Matrix.mulVec_mulVec, Matrix.inv_mul_of_invertible,
    Matrix.one_mulVec]

/-- Helper for Chapter03 Theorem 3.2.2: a Newton update can be rewritten as the inverse Hessian
applied to the first-order Taylor remainder of `gradient f` at the current iterate. -/
theorem newtonUpdateError_eq_inverseRemainder
    (f : Point → ℝ)
    (G : Point → Hessian)
    (xStar xk xNext : Point)
    (hCritical : gradient f xStar = 0)
    (hGk : IsUnit (G xk))
    (hNext :
      xNext = xk - Matrix.toEuclideanLin ((G xk)⁻¹) (gradient f xk)) :
    xNext - xStar =
      Matrix.toEuclideanLin ((G xk)⁻¹)
        (gradient f xStar - gradient f xk -
          ((Matrix.toEuclideanCLM : Hessian ≃⋆ₐ[ℝ] Point →L[ℝ] Point) (G xk))
            (xStar - xk)) := by
  letI := hGk.invertible
  subst xNext
  have hcancel :
      Matrix.toEuclideanLin ((G xk)⁻¹)
        (((Matrix.toEuclideanCLM : Hessian ≃⋆ₐ[ℝ] Point →L[ℝ] Point) (G xk))
          (xk - xStar)) =
        xk - xStar := by
    -- Reuse the dedicated cancellation bridge instead of reopening coordinate algebra here.
    simpa using
      toEuclideanLin_inv_toEuclideanCLM_apply (A := G xk) hGk (xk - xStar)
  calc
    xk - Matrix.toEuclideanLin ((G xk)⁻¹) (gradient f xk) - xStar
        = (xk - xStar) - Matrix.toEuclideanLin ((G xk)⁻¹) (gradient f xk) := by
            abel_nf
    _ = Matrix.toEuclideanLin ((G xk)⁻¹)
          (((Matrix.toEuclideanCLM : Hessian ≃⋆ₐ[ℝ] Point →L[ℝ] Point) (G xk))
            (xk - xStar)) -
          Matrix.toEuclideanLin ((G xk)⁻¹) (gradient f xk) := by
            rw [hcancel]
    _ = Matrix.toEuclideanLin ((G xk)⁻¹)
          ((((Matrix.toEuclideanCLM : Hessian ≃⋆ₐ[ℝ] Point →L[ℝ] Point) (G xk))
            (xk - xStar)) - gradient f xk) := by
            exact
              ((Matrix.toEuclideanLin ((G xk)⁻¹)).map_sub
                (((Matrix.toEuclideanCLM : Hessian ≃⋆ₐ[ℝ] Point →L[ℝ] Point) (G xk))
                  (xk - xStar))
                (gradient f xk)).symm
    _ = Matrix.toEuclideanLin ((G xk)⁻¹)
          (gradient f xStar - gradient f xk -
            ((Matrix.toEuclideanCLM : Hessian ≃⋆ₐ[ℝ] Point →L[ℝ] Point) (G xk))
              (xStar - xk)) := by
            have hflip :
                ((Matrix.toEuclideanCLM : Hessian ≃⋆ₐ[ℝ] Point →L[ℝ] Point) (G xk))
                    (xk - xStar) =
                  -((Matrix.toEuclideanCLM : Hessian ≃⋆ₐ[ℝ] Point →L[ℝ] Point) (G xk))
                    (xStar - xk) := by
              simp [sub_eq_add_neg, map_add, map_neg]
            rw [hflip]
            simp [hCritical, sub_eq_add_neg, add_left_comm, add_comm]

/-- Helper for Chapter03 Theorem 3.2.2: once convergence to `xStar` is known, a uniform
quadratic one-step bound packages directly into `HasQuadraticConvergenceTo`. -/
theorem hasQuadraticConvergenceTo_of_tendsto_and_bound
    {x : ℕ → Point}
    {xStar : Point}
    {C : ℝ}
    (hTendsto : Tendsto x atTop (𝓝 xStar))
    (_hC_nonneg : 0 ≤ C)
    (hBound : ∀ k : ℕ, ‖x (k + 1) - xStar‖ ≤ C * ‖x k - xStar‖ ^ (2 : ℕ)) :
    HasQuadraticConvergenceTo x xStar := by
  refine ⟨hTendsto, ?_⟩
  -- Record the pointwise recurrence once as an eventual `O(‖x_k - xStar‖²)` bound.
  refine Asymptotics.IsBigO.of_bound C ?_
  refine Filter.Eventually.of_forall ?_
  intro k
  simpa using hBound k

/-- Helper for Chapter03 Theorem 3.2.2: the local Lipschitz Hessian data and the local inverse
bound combine to give a uniform quadratic one-step Newton error estimate on a common ball. -/
theorem newtonUpdateQuadraticBound
    (f : Point → ℝ)
    (G : Point → Hessian)
    (xStar : Point)
    (hHessian : HasLocalLipschitzHessianMatrixAt f G xStar)
    (hCritical : gradient f xStar = 0)
    (hPosDef : (G xStar).PosDef) :
    ∃ ε > 0, ∃ C : ℝ, 0 ≤ C ∧
      (∀ x : Point, x ∈ Metric.ball xStar ε → IsUnit (G x)) ∧
      ∀ ⦃xk xNext : Point⦄,
        xk ∈ Metric.ball xStar ε →
        IsUnit (G xk) →
        xNext = xk - Matrix.toEuclideanLin ((G xk)⁻¹) (gradient f xk) →
        ‖xNext - xStar‖ ≤ C * ‖xk - xStar‖ ^ (2 : ℕ) := by
  rcases localGradientFDerivLipschitzData f G xStar hHessian with
    ⟨εDeriv, hεDeriv, γ, hDiff, hFDeriv, hLip⟩
  rcases hessianInverseControlNearXStar f G xStar hHessian hPosDef with
    ⟨εInv, hεInv, B, hInvBound⟩
  let ε : ℝ := min εDeriv εInv
  let C : ℝ := B * ((γ : ℝ) / 2)
  have hε : 0 < ε := by
    -- Work on the intersection of the derivative-Lipschitz ball and the inverse-control ball.
    exact lt_min hεDeriv hεInv
  have hxStarBall : xStar ∈ Metric.ball xStar ε := by
    change xStar ∈ Metric.ball xStar (min εDeriv εInv)
    exact Metric.mem_ball_self hε
  have hB_nonneg : 0 ≤ B := by
    -- Evaluate the inverse bound at `xStar` to record that the uniform constant is nonnegative.
    have hroot := (hInvBound xStar (Metric.ball_subset_ball (min_le_right _ _) hxStarBall)).2
    linarith [norm_nonneg ((G xStar)⁻¹)]
  have hC_nonneg : 0 ≤ C := by
    dsimp [C]
    positivity
  refine ⟨ε, hε, C, hC_nonneg, ?_, ?_⟩
  · intro x hx
    exact (hInvBound x (Metric.ball_subset_ball (min_le_right _ _) hx)).1
  intro xk xNext hxk hGk hNext
  have hxkDeriv : xk ∈ Metric.ball xStar εDeriv :=
    Metric.ball_subset_ball (min_le_left _ _) hxk
  have hxkInv : xk ∈ Metric.ball xStar εInv :=
    Metric.ball_subset_ball (min_le_right _ _) hxk
  have hxStarDeriv : xStar ∈ Metric.ball xStar εDeriv :=
    Metric.ball_subset_ball (min_le_left _ _) hxStarBall
  have hxStarEq : xk + (xStar - xk) = xStar := by
    abel_nf
  have hxd : xk + (xStar - xk) ∈ Metric.ball xStar εDeriv := by
    simpa [hxStarEq] using hxStarDeriv
  have hTaylor :=
    quadraticRemainderBound_of_fderiv_lipschitzOn
      (Metric.ball xStar εDeriv)
      (gradient f)
      xk
      (xStar - xk)
      γ
      Metric.isOpen_ball
      (convex_ball xStar εDeriv)
      hxkDeriv
      hDiff
      hLip
      hxd
  have hRemainder :
      ‖gradient f xStar - gradient f xk -
          ((Matrix.toEuclideanCLM : Hessian ≃⋆ₐ[ℝ] Point →L[ℝ] Point) (G xk))
            (xStar - xk)‖ ≤
        ((γ : ℝ) / 2) * ‖xStar - xk‖ ^ (2 : ℕ) := by
    -- Keep the Taylor remainder in the CLM normal form already used by the Newton update bridge.
    simpa [hxStarEq, hFDeriv xk hxkDeriv] using hTaylor
  have hInvNorm : ‖(G xk)⁻¹‖ ≤ B := (hInvBound xk hxkInv).2
  calc
    ‖xNext - xStar‖
        = ‖Matrix.toEuclideanLin ((G xk)⁻¹)
            (gradient f xStar - gradient f xk -
              ((Matrix.toEuclideanCLM : Hessian ≃⋆ₐ[ℝ] Point →L[ℝ] Point) (G xk))
                (xStar - xk))‖ := by
            rw [newtonUpdateError_eq_inverseRemainder f G xStar xk xNext hCritical hGk hNext]
    _ = ‖((Matrix.toEuclideanCLM : Hessian ≃⋆ₐ[ℝ] Point →L[ℝ] Point) ((G xk)⁻¹))
          (gradient f xStar - gradient f xk -
            ((Matrix.toEuclideanCLM : Hessian ≃⋆ₐ[ℝ] Point →L[ℝ] Point) (G xk))
              (xStar - xk))‖ := by
            rfl
    _ ≤ ‖((Matrix.toEuclideanCLM : Hessian ≃⋆ₐ[ℝ] Point →L[ℝ] Point) ((G xk)⁻¹))‖ *
          ‖gradient f xStar - gradient f xk -
            ((Matrix.toEuclideanCLM : Hessian ≃⋆ₐ[ℝ] Point →L[ℝ] Point) (G xk))
              (xStar - xk)‖ := by
            exact ContinuousLinearMap.le_opNorm _ _
    _ ≤ ‖(G xk)⁻¹‖ *
          ‖gradient f xStar - gradient f xk -
            ((Matrix.toEuclideanCLM : Hessian ≃⋆ₐ[ℝ] Point →L[ℝ] Point) (G xk))
              (xStar - xk)‖ := by
            rw [Matrix.l2_opNorm_toEuclideanCLM]
    _ ≤ B * (((γ : ℝ) / 2) * ‖xStar - xk‖ ^ (2 : ℕ)) := by
            exact mul_le_mul hInvNorm hRemainder (norm_nonneg _) hB_nonneg
    _ = C * ‖xk - xStar‖ ^ (2 : ℕ) := by
          have hnorm_rev : ‖xStar - xk‖ = ‖xk - xStar‖ := by
            rw [norm_sub_rev]
          rw [hnorm_rev]
          simp [C, mul_assoc]

/-- Helper for Chapter03 Theorem 3.2.2: a geometric one-step error contraction implies
convergence to `xStar`. -/
theorem tendsto_of_error_contraction
    {x : ℕ → Point}
    {xStar : Point}
    {q : ℝ}
    (hq_nonneg : 0 ≤ q)
    (hq_lt_one : q < 1)
    (hcontraction :
      ∀ k : ℕ, ‖x (k + 1) - xStar‖ ≤ q * ‖x k - xStar‖) :
    Tendsto x atTop (𝓝 xStar) := by
  have hpow :
      ∀ k : ℕ, ‖x k - xStar‖ ≤ q ^ k * ‖x 0 - xStar‖ := by
    intro k
    induction k with
    | zero =>
        simp
    | succ k hk =>
        -- Iterate the one-step contraction to obtain the geometric majorant `q^k`.
        calc
          ‖x (k + 1) - xStar‖ ≤ q * ‖x k - xStar‖ := hcontraction k
          _ ≤ q * (q ^ k * ‖x 0 - xStar‖) := by
            exact mul_le_mul_of_nonneg_left hk hq_nonneg
          _ = q ^ (k + 1) * ‖x 0 - xStar‖ := by
            rw [pow_succ']
            ring
  have hmajorant :
      Tendsto (fun k : ℕ ↦ q ^ k * ‖x 0 - xStar‖) atTop (𝓝 0) := by
    simpa [zero_mul] using
      (tendsto_pow_atTop_nhds_zero_of_lt_one hq_nonneg hq_lt_one).mul_const
        ‖x 0 - xStar‖
  have herror :
      Tendsto (fun k : ℕ ↦ x k - xStar) atTop (𝓝 0) := by
    refine squeeze_zero_norm ?_ hmajorant
    intro k
    exact hpow k
  simpa [sub_eq_add_neg, add_assoc, add_left_comm, add_comm] using
    herror.const_add xStar

/-- Helper for Chapter03 Theorem 3.2.2: a quadratic Newton one-step bound on a small ball yields
uniform small-ball invariance and a linearized contraction for every Newton method sequence
starting in that ball. -/
theorem newtonSequence_smallBallBoundAndContraction
    {f : Point → ℝ}
    {G : Point → Hessian}
    {xStar : Point}
    {ε C δ q : ℝ}
    (hδ_pos : 0 < δ)
    (hδ_lt_ε : δ < ε)
    (hC_nonneg : 0 ≤ C)
    (hq_def : q = C * δ)
    (hq_le_one : q ≤ 1)
    (hStep :
      ∀ ⦃xk xNext : Point⦄,
        xk ∈ Metric.ball xStar ε →
        IsUnit (G xk) →
        xNext = xk - Matrix.toEuclideanLin ((G xk)⁻¹) (gradient f xk) →
        ‖xNext - xStar‖ ≤ C * ‖xk - xStar‖ ^ (2 : ℕ))
    {x0 : Point}
    {x s : ℕ → Point}
    (hx0 : ‖x0 - xStar‖ < δ)
    (hSeq : IsNewtonMethodSequence f x s (fun k ↦ G (x k)) x0) :
    ∀ k : ℕ,
      ‖x k - xStar‖ ≤ δ ∧
        ‖x (k + 1) - xStar‖ ≤ q * ‖x k - xStar‖ := by
  have hq_nonneg : 0 ≤ q := by
    rw [hq_def]
    exact mul_nonneg hC_nonneg (le_of_lt hδ_pos)
  intro k
  induction k with
  | zero =>
      have hx0le : ‖x 0 - xStar‖ ≤ δ := by
        simpa [hSeq.stepSpec.1] using le_of_lt hx0
      have hx0Ball : x 0 ∈ Metric.ball xStar ε := by
        -- The initial iterate lies in the working ball because `δ < ε`.
        simpa [Metric.mem_ball, dist_eq_norm] using lt_of_le_of_lt hx0le hδ_lt_ε
      have hquad := hStep hx0Ball (hSeq.isUnit 0) (hSeq.nextEq_sub_inv_gradient 0)
      have hsq :
          ‖x 0 - xStar‖ ^ (2 : ℕ) ≤ δ * ‖x 0 - xStar‖ := by
        rw [pow_two]
        exact mul_le_mul_of_nonneg_right hx0le (norm_nonneg _)
      have hcontract0 : ‖x 1 - xStar‖ ≤ q * ‖x 0 - xStar‖ := by
        calc
          ‖x 1 - xStar‖ ≤ C * ‖x 0 - xStar‖ ^ (2 : ℕ) := hquad
          _ ≤ C * (δ * ‖x 0 - xStar‖) := by
                exact mul_le_mul_of_nonneg_left hsq hC_nonneg
          _ = q * ‖x 0 - xStar‖ := by
                calc
                  C * (δ * ‖x 0 - xStar‖) = (C * δ) * ‖x 0 - xStar‖ := by ring
                  _ = q * ‖x 0 - xStar‖ := by rw [← hq_def]
      exact ⟨hx0le, hcontract0⟩
  | succ k hk =>
      have hk1le : ‖x (k + 1) - xStar‖ ≤ δ := by
        -- The inductive contraction keeps the next iterate inside the same small ball.
        calc
          ‖x (k + 1) - xStar‖ ≤ q * ‖x k - xStar‖ := hk.2
          _ ≤ q * δ := by
                exact mul_le_mul_of_nonneg_left hk.1 hq_nonneg
          _ ≤ 1 * δ := by
                exact mul_le_mul_of_nonneg_right hq_le_one (le_of_lt hδ_pos)
          _ = δ := by ring
      have hk1Ball : x (k + 1) ∈ Metric.ball xStar ε := by
        simpa [Metric.mem_ball, dist_eq_norm] using lt_of_le_of_lt hk1le hδ_lt_ε
      have hquad :=
        hStep hk1Ball (hSeq.isUnit (k + 1)) (hSeq.nextEq_sub_inv_gradient (k + 1))
      have hsq :
          ‖x (k + 1) - xStar‖ ^ (2 : ℕ) ≤ δ * ‖x (k + 1) - xStar‖ := by
        rw [pow_two]
        exact mul_le_mul_of_nonneg_right hk1le (norm_nonneg _)
      have hcontractSucc :
          ‖x (k + 2) - xStar‖ ≤ q * ‖x (k + 1) - xStar‖ := by
        calc
          ‖x (k + 2) - xStar‖ ≤ C * ‖x (k + 1) - xStar‖ ^ (2 : ℕ) := hquad
          _ ≤ C * (δ * ‖x (k + 1) - xStar‖) := by
                exact mul_le_mul_of_nonneg_left hsq hC_nonneg
          _ = q * ‖x (k + 1) - xStar‖ := by
                calc
                  C * (δ * ‖x (k + 1) - xStar‖) =
                      (C * δ) * ‖x (k + 1) - xStar‖ := by ring
                  _ = q * ‖x (k + 1) - xStar‖ := by rw [← hq_def]
      exact ⟨hk1le, hcontractSucc⟩

/-- Helper for Chapter03 Theorem 3.2.2: the primitive-recursive Newton orbit stays inside the
same small ball, hence every Hessian along the orbit is invertible. -/
theorem newtonIterates_smallBall_isUnit
    {f : Point → ℝ}
    {G : Point → Hessian}
    {xStar : Point}
    {ε C δ q : ℝ}
    (hδ_pos : 0 < δ)
    (hδ_lt_ε : δ < ε)
    (hC_nonneg : 0 ≤ C)
    (hq_def : q = C * δ)
    (hq_le_one : q ≤ 1)
    (hInv :
      ∀ x : Point, x ∈ Metric.ball xStar ε → IsUnit (G x))
    (hStep :
      ∀ ⦃xk xNext : Point⦄,
        xk ∈ Metric.ball xStar ε →
        IsUnit (G xk) →
        xNext = xk - Matrix.toEuclideanLin ((G xk)⁻¹) (gradient f xk) →
        ‖xNext - xStar‖ ≤ C * ‖xk - xStar‖ ^ (2 : ℕ))
    {x0 : Point}
    (hx0 : ‖x0 - xStar‖ < δ) :
    ∀ k : ℕ,
      ‖newtonIterates f G x0 k - xStar‖ ≤ δ ∧
        IsUnit (G (newtonIterates f G x0 k)) := by
  have hq_nonneg : 0 ≤ q := by
    rw [hq_def]
    exact mul_nonneg hC_nonneg (le_of_lt hδ_pos)
  intro k
  induction k with
  | zero =>
      have hx0le : ‖newtonIterates f G x0 0 - xStar‖ ≤ δ := by
        simpa [newtonIterates_zero] using le_of_lt hx0
      have hx0Ball : x0 ∈ Metric.ball xStar ε := by
        -- The recursive orbit starts inside the common working ball.
        simpa [Metric.mem_ball, dist_eq_norm] using lt_of_le_of_lt
          (show ‖x0 - xStar‖ ≤ δ by exact le_of_lt hx0) hδ_lt_ε
      simpa [newtonIterates_zero] using And.intro hx0le (hInv x0 hx0Ball)
  | succ k hk =>
      have hxkBall : newtonIterates f G x0 k ∈ Metric.ball xStar ε := by
        simpa [Metric.mem_ball, dist_eq_norm] using lt_of_le_of_lt hk.1 hδ_lt_ε
      have hquad :=
        hStep hxkBall hk.2 (newtonIterates_succ f G x0 k)
      have hsq :
          ‖newtonIterates f G x0 k - xStar‖ ^ (2 : ℕ) ≤
            δ * ‖newtonIterates f G x0 k - xStar‖ := by
        rw [pow_two]
        exact mul_le_mul_of_nonneg_right hk.1 (norm_nonneg _)
      have hcontract :
          ‖newtonIterates f G x0 (k + 1) - xStar‖ ≤
            q * ‖newtonIterates f G x0 k - xStar‖ := by
        calc
          ‖newtonIterates f G x0 (k + 1) - xStar‖ ≤
              C * ‖newtonIterates f G x0 k - xStar‖ ^ (2 : ℕ) := hquad
          _ ≤ C * (δ * ‖newtonIterates f G x0 k - xStar‖) := by
                exact mul_le_mul_of_nonneg_left hsq hC_nonneg
          _ = q * ‖newtonIterates f G x0 k - xStar‖ := by
                calc
                  C * (δ * ‖newtonIterates f G x0 k - xStar‖) =
                      (C * δ) * ‖newtonIterates f G x0 k - xStar‖ := by ring
                  _ = q * ‖newtonIterates f G x0 k - xStar‖ := by rw [← hq_def]
      have hk1le : ‖newtonIterates f G x0 (k + 1) - xStar‖ ≤ δ := by
        calc
          ‖newtonIterates f G x0 (k + 1) - xStar‖ ≤
              q * ‖newtonIterates f G x0 k - xStar‖ := hcontract
          _ ≤ q * δ := by
                exact mul_le_mul_of_nonneg_left hk.1 hq_nonneg
          _ ≤ 1 * δ := by
                exact mul_le_mul_of_nonneg_right hq_le_one (le_of_lt hδ_pos)
          _ = δ := by ring
      have hxk1Ball : newtonIterates f G x0 (k + 1) ∈ Metric.ball xStar ε := by
        simpa [Metric.mem_ball, dist_eq_norm] using lt_of_le_of_lt hk1le hδ_lt_ε
      exact ⟨hk1le, hInv _ hxk1Ball⟩

/-- Well-definedness consequence of Chapter03 Theorem 3.2.2: if `f : ℝⁿ → ℝ` admits a local
Lipschitz Hessian matrix field `G` at the stationary point `xStar` and `G xStar` is positive
definite, then a Newton method started sufficiently close to `xStar` generates a
well-defined Newton iteration. -/
theorem newtonMethod_wellDefined_of_posDef_and_lipschitz
    (f : Point → ℝ)
    (G : Point → Hessian)
    (xStar : Point)
    (hHessian : HasLocalLipschitzHessianMatrixAt f G xStar)
    (hCritical : gradient f xStar = 0)
    (hPosDef : (G xStar).PosDef) :
    ∃ δ : ℝ, 0 < δ ∧ ∀ x0 : Point, ‖x0 - xStar‖ < δ →
      ∃ x s : ℕ → Point,
        IsNewtonMethodSequence f x s (fun k ↦ G (x k)) x0 := by
  rcases newtonUpdateQuadraticBound f G xStar hHessian hCritical hPosDef with
    ⟨ε, hε, C, hC_nonneg, hUnit, hStep⟩
  let δ : ℝ := min (ε / 2) (1 / (C + 1))
  let q : ℝ := C * δ
  have hδ_pos : 0 < δ := by
    -- Shrink the working ball until the quadratic estimate implies self-mapping.
    have hε_half_pos : 0 < ε / 2 := by positivity
    have hC1_pos : 0 < C + 1 := by linarith
    have hInv_pos : 0 < 1 / (C + 1) := by positivity
    exact lt_min hε_half_pos hInv_pos
  have hδ_lt_ε : δ < ε := by
    have hhalf_lt : ε / 2 < ε := by nlinarith
    exact lt_of_le_of_lt (min_le_left _ _) hhalf_lt
  have hq_le_one : q ≤ 1 := by
    have hδ_le_inv : δ ≤ 1 / (C + 1) := min_le_right _ _
    have hmul :
        q ≤ C * (1 / (C + 1)) := by
      dsimp [q]
      exact mul_le_mul_of_nonneg_left hδ_le_inv hC_nonneg
    have hfrac :
        C * (1 / (C + 1)) ≤ 1 := by
      have hC1_pos : 0 < C + 1 := by linarith
      rw [mul_one_div]
      exact (div_le_iff₀ hC1_pos).2 (by linarith)
    exact le_trans hmul hfrac
  rcases hessianInverseControlNearXStar f G xStar hHessian hPosDef with
    ⟨εInv, hεInv, B, hInvBound⟩
  refine ⟨δ, hδ_pos, ?_⟩
  intro x0 hx0
  have hUnitOrbit :=
    newtonIterates_smallBall_isUnit
      (hδ_pos := hδ_pos)
      (hδ_lt_ε := hδ_lt_ε)
      (hC_nonneg := hC_nonneg)
      (hq_def := rfl)
      (hq_le_one := hq_le_one)
      (hInv := hUnit)
      (hStep := hStep)
      hx0
  -- Use the primitive-recursive Newton orbit and the canonical Newton directions.
  refine ⟨newtonIterates f G x0, fun k ↦ newtonDirection f (newtonIterates f G x0 k) G, ?_⟩
  exact newtonIterates_isNewtonMethodSequence_of_isUnit f G x0 (fun k ↦ (hUnitOrbit k).2)

/-- Chapter03 Theorem 3.2.2: under the same hypotheses, every sufficiently close
Newton method sequence generated from `x0` converges to `xStar`. -/
theorem newtonMethod_converges_of_posDef_and_lipschitz
    (f : Point → ℝ)
    (G : Point → Hessian)
    (xStar : Point)
    (hHessian : HasLocalLipschitzHessianMatrixAt f G xStar)
    (hCritical : gradient f xStar = 0)
    (hPosDef : (G xStar).PosDef) :
    ∃ δ : ℝ, 0 < δ ∧ ∀ x0 : Point, ‖x0 - xStar‖ < δ →
      ∀ x s : ℕ → Point,
        IsNewtonMethodSequence f x s (fun k ↦ G (x k)) x0 →
        Tendsto x atTop (𝓝 xStar) := by
  rcases newtonUpdateQuadraticBound f G xStar hHessian hCritical hPosDef with
    ⟨ε, hε, C, hC_nonneg, hUnit, hStep⟩
  let δ : ℝ := min (ε / 2) (1 / (C + 1))
  let q : ℝ := C * δ
  have hδ_pos : 0 < δ := by
    -- The same small radius ensures both ball invariance and a contraction factor below `1`.
    have hε_half_pos : 0 < ε / 2 := by positivity
    have hC1_pos : 0 < C + 1 := by linarith
    have hInv_pos : 0 < 1 / (C + 1) := by positivity
    exact lt_min hε_half_pos hInv_pos
  have hδ_lt_ε : δ < ε := by
    have hhalf_lt : ε / 2 < ε := by nlinarith
    exact lt_of_le_of_lt (min_le_left _ _) hhalf_lt
  have hq_lt_one : q < 1 := by
    have hδ_le_inv : δ ≤ 1 / (C + 1) := min_le_right _ _
    have hmul :
        q ≤ C * (1 / (C + 1)) := by
      dsimp [q]
      exact mul_le_mul_of_nonneg_left hδ_le_inv hC_nonneg
    have hfrac :
        C * (1 / (C + 1)) < 1 := by
      have hC1_pos : 0 < C + 1 := by linarith
      rw [mul_one_div]
      exact (div_lt_iff₀ hC1_pos).2 (by linarith)
    exact lt_of_le_of_lt hmul hfrac
  have hq_le_one : q ≤ 1 := le_of_lt hq_lt_one
  have hq_nonneg : 0 ≤ q := by
    dsimp [q]
    exact mul_nonneg hC_nonneg (le_of_lt hδ_pos)
  refine ⟨δ, hδ_pos, ?_⟩
  intro x0 hx0 x s hSeq
  have hsmall :=
    newtonSequence_smallBallBoundAndContraction
      (hδ_pos := hδ_pos)
      (hδ_lt_ε := hδ_lt_ε)
      (hC_nonneg := hC_nonneg)
      (hq_def := rfl)
      (hq_le_one := hq_le_one)
      (hStep := hStep)
      hx0
      hSeq
  -- Convert the one-step contraction produced by the small-ball induction into convergence.
  exact tendsto_of_error_contraction hq_nonneg hq_lt_one (fun k ↦ (hsmall k).2)

/-- Quadratic-rate consequence of Chapter03 Theorem 3.2.2: under the same hypotheses, every
sufficiently close Newton method sequence generated from `x0` converges quadratically to
`xStar`. -/
theorem newtonMethod_quadratic_error_bound_of_posDef_and_lipschitz
    (f : Point → ℝ)
    (G : Point → Hessian)
    (xStar : Point)
    (hHessian : HasLocalLipschitzHessianMatrixAt f G xStar)
    (hCritical : gradient f xStar = 0)
    (hPosDef : (G xStar).PosDef) :
    ∃ δ : ℝ, 0 < δ ∧ ∀ x0 : Point, ‖x0 - xStar‖ < δ →
      ∀ x s : ℕ → Point,
        IsNewtonMethodSequence f x s (fun k ↦ G (x k)) x0 →
        HasQuadraticConvergenceTo x xStar := by
  rcases newtonMethod_converges_of_posDef_and_lipschitz
      f G xStar hHessian hCritical hPosDef with
    ⟨δConv, hδConv, hConv⟩
  rcases newtonUpdateQuadraticBound f G xStar hHessian hCritical hPosDef with
    ⟨ε, hε, C, hC_nonneg, hUnit, hStep⟩
  let δQuad : ℝ := min (ε / 2) (1 / (C + 1))
  let q : ℝ := C * δQuad
  let δ : ℝ := min δConv δQuad
  have hδQuad_pos : 0 < δQuad := by
    -- Reuse the same local radius as in the convergence proof for the quadratic recurrence.
    have hε_half_pos : 0 < ε / 2 := by positivity
    have hC1_pos : 0 < C + 1 := by linarith
    have hInv_pos : 0 < 1 / (C + 1) := by positivity
    exact lt_min hε_half_pos hInv_pos
  have hδQuad_lt_ε : δQuad < ε := by
    have hhalf_lt : ε / 2 < ε := by nlinarith
    exact lt_of_le_of_lt (min_le_left _ _) hhalf_lt
  have hq_lt_one : q < 1 := by
    have hδ_le_inv : δQuad ≤ 1 / (C + 1) := min_le_right _ _
    have hmul :
        q ≤ C * (1 / (C + 1)) := by
      dsimp [q]
      exact mul_le_mul_of_nonneg_left hδ_le_inv hC_nonneg
    have hfrac :
        C * (1 / (C + 1)) < 1 := by
      have hC1_pos : 0 < C + 1 := by linarith
      rw [mul_one_div]
      exact (div_lt_iff₀ hC1_pos).2 (by linarith)
    exact lt_of_le_of_lt hmul hfrac
  have hδ_pos : 0 < δ := by
    exact lt_min hδConv hδQuad_pos
  have hq_le_one : q ≤ 1 := le_of_lt hq_lt_one
  refine ⟨δ, hδ_pos, ?_⟩
  intro x0 hx0 x s hSeq
  have hx0Conv : ‖x0 - xStar‖ < δConv := lt_of_lt_of_le hx0 (min_le_left _ _)
  have hx0Quad : ‖x0 - xStar‖ < δQuad := lt_of_lt_of_le hx0 (min_le_right _ _)
  have hTendsto := hConv x0 hx0Conv x s hSeq
  have hsmall :=
    newtonSequence_smallBallBoundAndContraction
      (hδ_pos := hδQuad_pos)
      (hδ_lt_ε := hδQuad_lt_ε)
      (hC_nonneg := hC_nonneg)
      (hq_def := rfl)
      (hq_le_one := hq_le_one)
      (hStep := hStep)
      hx0Quad
      hSeq
  have hBound :
      ∀ k : ℕ, ‖x (k + 1) - xStar‖ ≤ C * ‖x k - xStar‖ ^ (2 : ℕ) := by
    intro k
    have hxkBall : x k ∈ Metric.ball xStar ε := by
      -- The small-ball induction feeds the one-step quadratic estimate at every iterate.
      simpa [Metric.mem_ball, dist_eq_norm] using
        lt_of_le_of_lt (hsmall k).1 hδQuad_lt_ε
    exact hStep hxkBall (hSeq.isUnit k) (hSeq.nextEq_sub_inv_gradient k)
  exact hasQuadraticConvergenceTo_of_tendsto_and_bound hTendsto hC_nonneg hBound
