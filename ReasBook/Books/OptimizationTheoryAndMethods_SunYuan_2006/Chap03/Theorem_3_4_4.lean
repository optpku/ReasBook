open Filter
open scoped Topology

noncomputable section

section Convergence

variable {E : Type*} [NormedAddCommGroup E]

/-- A sequence converges linearly to `xStar` when it converges to `xStar` and admits a
uniform one-step contraction factor strictly between `0` and `1`. -/
@[mk_iff hasLinearConvergenceTo_iff]
class HasLinearConvergenceTo (x : ℕ → E) (xStar : E) : Prop where
  tendsto : Tendsto x atTop (nhds xStar)
  contraction :
    ∃ c ∈ Set.Ioo (0 : ℝ) 1, ∀ k : ℕ, ‖x (k + 1) - xStar‖ ≤ c * ‖x k - xStar‖

/-- A sequence converges eventually linearly to `xStar` when it converges to `xStar` and,
from some index onward, admits a uniform one-step contraction factor strictly between `0`
and `1`. -/
@[mk_iff hasEventuallyLinearConvergenceTo_iff]
class HasEventuallyLinearConvergenceTo (x : ℕ → E) (xStar : E) : Prop where
  tendsto : Tendsto x atTop (nhds xStar)
  eventualContraction :
    ∃ c ∈ Set.Ioo (0 : ℝ) 1,
      ∀ᶠ k in atTop, ‖x (k + 1) - xStar‖ ≤ c * ‖x k - xStar‖

/-- A sequence converges superlinearly to `xStar` when it converges to `xStar` and its
next-step error is little-o of the current error. -/
@[mk_iff hasSuperlinearConvergenceTo_iff]
class HasSuperlinearConvergenceTo (x : ℕ → E) (xStar : E) : Prop where
  tendsto : Tendsto x atTop (nhds xStar)
  isLittleO : (fun k ↦ ‖x (k + 1) - xStar‖) =o[atTop] fun k ↦ ‖x k - xStar‖

/-- A sequence converges quadratically to `xStar` when it converges to `xStar` and its
next-step error is `O(‖x k - xStar‖^2)` along `atTop`. -/
@[mk_iff hasQuadraticConvergenceTo_iff]
class HasQuadraticConvergenceTo (x : ℕ → E) (xStar : E) : Prop where
  tendsto : Tendsto x atTop (nhds xStar)
  isBigO : (fun k ↦ ‖x (k + 1) - xStar‖) =O[atTop] fun k ↦ ‖x k - xStar‖ ^ (2 : ℕ)

end Convergence

-- Semantic recall: `lean_leansearch` surfaced only generic local-linearization APIs such as
-- `difference_quotients_converge_uniformly`; it did not surface a canonical finite-difference
-- Newton convergence owner for `F : ℝⁿ → ℝⁿ`, so this item keeps a source-faithful local
-- recurrence-only generated-sequence predicate, separates well-definedness on `D` from the
-- bare update rule, and states the linear, superlinear, and quadratic conclusions directly.
-- The forward finite-difference Jacobian owner itself already lives in `Theorem_3_4_1`, and
-- this file reuses that generic basis-level API instead of keeping a Euclidean-only duplicate.

variable {n : ℕ}

local notation "Point" => EuclideanSpace ℝ (Fin n)
local notation "coordBasis" => OrthonormalBasis.toBasis (EuclideanSpace.basisFun (Fin n) ℝ)

/-- A sequence `x` is generated by the finite-difference Newton update `(3.4.18)`-`(3.4.19)`
with initial point `x0` and step sequence `hSeq` when it starts at `x0` and each update uses
the inverse of the forward finite-difference Jacobian matrix. -/
def IsFiniteDifferenceNewtonGeneratedSequence
    (F : Point → Point) (x : ℕ → Point) (hSeq : ℕ → ℝ) (x0 : Point) : Prop :=
  x 0 = x0 ∧
    ∀ k : ℕ,
      x (k + 1) =
        x k -
          Matrix.toEuclideanLin
            ((finiteDifferenceJacobianMatrix coordBasis coordBasis F (x k) (hSeq k))⁻¹)
            (F (x k))

/-- Unfolding formula for `IsFiniteDifferenceNewtonGeneratedSequence`. -/
theorem isFiniteDifferenceNewtonGeneratedSequence_iff
    (F : Point → Point) (x : ℕ → Point) (hSeq : ℕ → ℝ) (x0 : Point) :
    IsFiniteDifferenceNewtonGeneratedSequence F x hSeq x0 ↔
      x 0 = x0 ∧
        (∀ k : ℕ,
          x (k + 1) =
            x k -
              Matrix.toEuclideanLin
                ((finiteDifferenceJacobianMatrix coordBasis coordBasis F (x k) (hSeq k))⁻¹)
                (F (x k))) :=
  Iff.rfl

namespace IsFiniteDifferenceNewtonGeneratedSequence

/-- A generated finite-difference Newton sequence starts at `x0` and satisfies the
finite-difference Newton update at every step. -/
theorem stepSpec
    {F : Point → Point} {x : ℕ → Point} {hSeq : ℕ → ℝ} {x0 : Point}
    (h : IsFiniteDifferenceNewtonGeneratedSequence F x hSeq x0) :
    x 0 = x0 ∧
      ∀ k : ℕ,
        x (k + 1) =
          x k -
            Matrix.toEuclideanLin
              ((finiteDifferenceJacobianMatrix coordBasis coordBasis F (x k) (hSeq k))⁻¹)
              (F (x k)) :=
  h

/-- The initial point of a generated finite-difference Newton sequence is `x0`. -/
theorem start_eq
    {F : Point → Point} {x : ℕ → Point} {hSeq : ℕ → ℝ} {x0 : Point}
    (h : IsFiniteDifferenceNewtonGeneratedSequence F x hSeq x0) :
    x 0 = x0 :=
  h.stepSpec.1

/-- The iterates of a generated finite-difference Newton sequence satisfy the update
`(3.4.18)`-`(3.4.19)`. -/
theorem nextEq
    {F : Point → Point} {x : ℕ → Point} {hSeq : ℕ → ℝ} {x0 : Point}
    (h : IsFiniteDifferenceNewtonGeneratedSequence F x hSeq x0) (k : ℕ) :
    x (k + 1) =
      x k -
        Matrix.toEuclideanLin
          ((finiteDifferenceJacobianMatrix coordBasis coordBasis F (x k) (hSeq k))⁻¹)
          (F (x k)) :=
  h.stepSpec.2 k

end IsFiniteDifferenceNewtonGeneratedSequence

/-- A finite-difference Newton sequence is well defined on `D` when it satisfies the update
relations from `(3.4.18)`-`(3.4.19)` and every forward finite-difference Jacobian matrix along
the sequence is invertible. -/
@[mk_iff isWellDefinedFiniteDifferenceNewtonSequenceOn_iff]
class IsWellDefinedFiniteDifferenceNewtonSequenceOn
    (F : Point → Point) (D : Set Point) (x : ℕ → Point) (hSeq : ℕ → ℝ) (x0 : Point) : Prop where
  generated : IsFiniteDifferenceNewtonGeneratedSequence F x hSeq x0
  mem_domain : ∀ k : ℕ, x k ∈ D
  step_mem_domain : ∀ k : ℕ, ∀ j : Fin n, x k + hSeq k • coordBasis j ∈ D
  jacobian_isUnit :
    ∀ k : ℕ, IsUnit (finiteDifferenceJacobianMatrix coordBasis coordBasis F (x k) (hSeq k))

namespace IsWellDefinedFiniteDifferenceNewtonSequenceOn

/-- A well-defined finite-difference Newton sequence records the update rule, domain
membership, forward-step domain membership, and Jacobian invertibility at every step. -/
theorem stepSpec
    {F : Point → Point} {D : Set Point} {x : ℕ → Point} {hSeq : ℕ → ℝ} {x0 : Point}
    (h : IsWellDefinedFiniteDifferenceNewtonSequenceOn F D x hSeq x0) :
    IsFiniteDifferenceNewtonGeneratedSequence F x hSeq x0 ∧
      (∀ k : ℕ, x k ∈ D) ∧
      (∀ k : ℕ, ∀ j : Fin n, x k + hSeq k • coordBasis j ∈ D) ∧
      ∀ k : ℕ, IsUnit (finiteDifferenceJacobianMatrix coordBasis coordBasis F (x k) (hSeq k)) :=
  ⟨h.generated, h.mem_domain, h.step_mem_domain, h.jacobian_isUnit⟩

/-- A well-defined finite-difference Newton sequence is generated by the finite-difference
Newton update rule. -/
theorem nextEq
    {F : Point → Point} {D : Set Point} {x : ℕ → Point} {hSeq : ℕ → ℝ} {x0 : Point}
    (h : IsWellDefinedFiniteDifferenceNewtonSequenceOn F D x hSeq x0) (k : ℕ) :
    x (k + 1) =
      x k -
        Matrix.toEuclideanLin
          ((finiteDifferenceJacobianMatrix coordBasis coordBasis F (x k) (hSeq k))⁻¹)
          (F (x k)) :=
  h.generated.nextEq k

end IsWellDefinedFiniteDifferenceNewtonSequenceOn

/-- A step sequence is admissible for the finite-difference Newton method with bound `h`
when every step is nonzero and has absolute value at most `h`. -/
def HasAdmissibleFiniteDifferenceSteps (hSeq : ℕ → ℝ) (h : ℝ) : Prop :=
  (∀ k : ℕ, 0 < |hSeq k|) ∧ ∀ k : ℕ, |hSeq k| ≤ h

/-- Unfolding formula for `HasAdmissibleFiniteDifferenceSteps`. -/
theorem hasAdmissibleFiniteDifferenceSteps_iff (hSeq : ℕ → ℝ) (h : ℝ) :
    HasAdmissibleFiniteDifferenceSteps hSeq h ↔
      ∀ k : ℕ, 0 < |hSeq k| ∧ |hSeq k| ≤ h := by
  constructor
  · intro hsteps k
    exact ⟨hsteps.1 k, hsteps.2 k⟩
  · intro hsteps
    exact ⟨fun k ↦ (hsteps k).1, fun k ↦ (hsteps k).2⟩

namespace HasAdmissibleFiniteDifferenceSteps

/-- An admissible finite-difference step sequence has nonzero step size at each stage. -/
theorem pos {hSeq : ℕ → ℝ} {h : ℝ} (hsteps : HasAdmissibleFiniteDifferenceSteps hSeq h) (k : ℕ) :
    0 < |hSeq k| :=
  hsteps.1 k

/-- An admissible finite-difference step sequence is uniformly bounded by `h`. -/
theorem le {hSeq : ℕ → ℝ} {h : ℝ} (hsteps : HasAdmissibleFiniteDifferenceSteps hSeq h) (k : ℕ) :
    |hSeq k| ≤ h :=
  hsteps.2 k

end HasAdmissibleFiniteDifferenceSteps

/-- A generated finite-difference Newton sequence with the full local convergence conclusions
from Theorem 3.4.4: it is well defined, converges linearly, becomes superlinear when
`hSeq ⟶ 0`, and becomes quadratic under the step-size or residual control from `(3.4.20)` or
`(3.4.21)`. -/
class FiniteDifferenceNewtonLocalConvergence
    (F : Point → Point) (D : Set Point) (x : ℕ → Point) (hSeq : ℕ → ℝ)
    (x0 xStar : Point) : Prop extends
    IsWellDefinedFiniteDifferenceNewtonSequenceOn F D x hSeq x0,
    HasLinearConvergenceTo x xStar where
  superlinear_of_step_tendsto_zero :
    Tendsto hSeq atTop (nhds 0) → HasSuperlinearConvergenceTo x xStar
  quadratic_of_step_or_residual_control :
    ((∃ c1 > 0, ∀ k : ℕ, |hSeq k| ≤ c1 * ‖x k - xStar‖) ∨
      ∃ c2 > 0, ∀ k : ℕ, |hSeq k| ≤ c2 * ‖F (x k)‖) →
    HasQuadraticConvergenceTo x xStar

/-- A `FiniteDifferenceNewtonLocalConvergence` package is a proposition, hence subsingleton. -/
instance finiteDifferenceNewtonLocalConvergenceSubsingleton
    (F : Point → Point) (D : Set Point) (x : ℕ → Point) (hSeq : ℕ → ℝ)
    (x0 xStar : Point) :
    Subsingleton (FiniteDifferenceNewtonLocalConvergence F D x hSeq x0 xStar) :=
  inferInstance

/-- Residual control `|hSeq k| ≤ c2 * ‖F (x k)‖` is one of the source-side hypotheses that
forces quadratic convergence in a `FiniteDifferenceNewtonLocalConvergence` package. -/
theorem FiniteDifferenceNewtonLocalConvergence.hasQuadraticConvergenceOfResidualControl
    {F : Point → Point} {D : Set Point} {x : ℕ → Point} {hSeq : ℕ → ℝ}
    {x0 xStar : Point}
    (hconv : FiniteDifferenceNewtonLocalConvergence F D x hSeq x0 xStar)
    (hres : ∃ c2 > 0, ∀ k : ℕ, |hSeq k| ≤ c2 * ‖F (x k)‖) :
    HasQuadraticConvergenceTo x xStar :=
  hconv.quadratic_of_step_or_residual_control <| Or.inr hres

/-- A `FiniteDifferenceNewtonLocalConvergence` package becomes superlinearly convergent when
its finite-difference step sequence tends to `0`. -/
theorem FiniteDifferenceNewtonLocalConvergence.hasSuperlinearConvergenceOfStepTendstoZero
    {F : Point → Point} {D : Set Point} {x : ℕ → Point} {hSeq : ℕ → ℝ}
    {x0 xStar : Point}
    (hconv : FiniteDifferenceNewtonLocalConvergence F D x hSeq x0 xStar)
    (hsteps : Tendsto hSeq atTop (nhds 0)) :
    HasSuperlinearConvergenceTo x xStar :=
  hconv.superlinear_of_step_tendsto_zero hsteps

/-- Step control `|hSeq k| ≤ c1 * ‖x k - xStar‖` is one of the source-side hypotheses that
forces quadratic convergence in a `FiniteDifferenceNewtonLocalConvergence` package. -/
theorem FiniteDifferenceNewtonLocalConvergence.hasQuadraticConvergenceOfStepControl
    {F : Point → Point} {D : Set Point} {x : ℕ → Point} {hSeq : ℕ → ℝ}
    {x0 xStar : Point}
    (hconv : FiniteDifferenceNewtonLocalConvergence F D x hSeq x0 xStar)
    (hstep : ∃ c1 > 0, ∀ k : ℕ, |hSeq k| ≤ c1 * ‖x k - xStar‖) :
    HasQuadraticConvergenceTo x xStar :=
  hconv.quadratic_of_step_or_residual_control <| Or.inl hstep

/-- A `FiniteDifferenceNewtonLocalConvergence` package becomes quadratically convergent under
either the step control `(3.4.20)` or the residual control `(3.4.21)`. -/
theorem FiniteDifferenceNewtonLocalConvergence.hasQuadraticConvergenceOfStepOrResidualControl
    {F : Point → Point} {D : Set Point} {x : ℕ → Point} {hSeq : ℕ → ℝ}
    {x0 xStar : Point}
    (hconv : FiniteDifferenceNewtonLocalConvergence F D x hSeq x0 xStar)
    (hcontrol : (∃ c1 > 0, ∀ k : ℕ, |hSeq k| ≤ c1 * ‖x k - xStar‖) ∨
      ∃ c2 > 0, ∀ k : ℕ, |hSeq k| ≤ c2 * ‖F (x k)‖) :
    HasQuadraticConvergenceTo x xStar :=
  hconv.quadratic_of_step_or_residual_control hcontrol

/-- Helper for Chapter03 Theorem 3.4.4: the canonical finite-difference Newton iterate sequence
obtained by primitive recursion from the update `(3.4.18)`-`(3.4.19)`. -/
def finiteDifferenceNewtonIterates
    (F : Point → Point) (hSeq : ℕ → ℝ) (x0 : Point) : ℕ → Point
  | 0 => x0
  | k + 1 =>
      finiteDifferenceNewtonIterates F hSeq x0 k -
        Matrix.toEuclideanLin
          ((finiteDifferenceJacobianMatrix
              coordBasis coordBasis F
              (finiteDifferenceNewtonIterates F hSeq x0 k)
              (hSeq k))⁻¹)
          (F (finiteDifferenceNewtonIterates F hSeq x0 k))

/-- Helper for Chapter03 Theorem 3.4.4: the primitive-recursive iterate family satisfies the
source finite-difference Newton update rule by construction. -/
theorem finiteDifferenceNewtonIterates_generated
    (F : Point → Point) (hSeq : ℕ → ℝ) (x0 : Point) :
    IsFiniteDifferenceNewtonGeneratedSequence
      F (finiteDifferenceNewtonIterates F hSeq x0) hSeq x0 := by
  constructor
  · -- The recursive sequence starts from the prescribed initial point.
    rfl
  · intro k
    -- Each successor clause is definitionally the finite-difference Newton update.
    simp [finiteDifferenceNewtonIterates]

/-- Helper for Chapter03 Theorem 3.4.4: a Jacobian matrix expressed in the Euclidean coordinate
basis corresponds to the actual Fréchet derivative `fderiv ℝ F x`. -/
lemma jacobianMatrixAt_toEuclideanLin_coordBasis
    (F : Point → Point) (x : Point) :
    Matrix.toEuclideanLin (jacobianMatrixAt coordBasis coordBasis F x) =
      (fderiv ℝ F x).toLinearMap := by
  -- Normalize the matrix Jacobian back to the orthonormal-basis linear map.
  simp [jacobianMatrixAt, Matrix.toEuclideanLin_eq_toLin_orthonormal]

/-- Helper for Chapter03 Theorem 3.4.4: the Euclidean-coordinate Jacobian matrix also matches the
continuous-linear-map model used by the matrix `ℓ₂` operator norm. -/
lemma jacobianMatrixAt_toEuclideanCLM_coordBasis
    (F : Point → Point) (x : Point) :
    (Matrix.toEuclideanCLM :
        Matrix (Fin n) (Fin n) ℝ ≃⋆ₐ[ℝ] Point →L[ℝ] Point)
        (jacobianMatrixAt coordBasis coordBasis F x) =
      fderiv ℝ F x := by
  -- Compare both continuous linear maps entrywise through the Euclidean coordinates of `Point`.
  ext y i
  simpa [Matrix.coe_toEuclideanCLM_eq_toEuclideanLin] using
    congrArg (fun T => (T y).ofLp i)
      (jacobianMatrixAt_toEuclideanLin_coordBasis (F := F) x)

/-- Helper for Chapter03 Theorem 3.4.4: transporting a continuous linear map to matrix
coordinates and back through `Matrix.toEuclideanCLM` recovers the original map. -/
lemma toEuclideanCLM_apply_symm_apply
    (T : Point →L[ℝ] Point) :
    (Matrix.toEuclideanCLM :
        Matrix (Fin n) (Fin n) ℝ ≃⋆ₐ[ℝ] Point →L[ℝ] Point)
      (((Matrix.toEuclideanCLM :
          Matrix (Fin n) (Fin n) ℝ ≃⋆ₐ[ℝ] Point →L[ℝ] Point).symm) T) = T := by
  -- This is the stable transport normal form needed by the Jacobian/unit bridge lemmas.
  exact (Matrix.toEuclideanCLM :
      Matrix (Fin n) (Fin n) ℝ ≃⋆ₐ[ℝ] Point →L[ℝ] Point).apply_symm_apply T

/-- Helper for Chapter03 Theorem 3.4.4: applying `Matrix.toEuclideanCLM` to the value of a unit
transported back along `Matrix.toEuclideanCLM.symm` recovers the original unit value. -/
lemma toEuclideanCLM_map_symm_unit_val
    (u : (Point →L[ℝ] Point)ˣ) :
    (Matrix.toEuclideanCLM :
        Matrix (Fin n) (Fin n) ℝ ≃⋆ₐ[ℝ] Point →L[ℝ] Point)
      ((↑(Units.map
          ((Matrix.toEuclideanCLM :
              Matrix (Fin n) (Fin n) ℝ ≃⋆ₐ[ℝ] Point →L[ℝ] Point).symm.toMonoidHom)
          u) : Matrix (Fin n) (Fin n) ℝ)) =
      (u : Point →L[ℝ] Point) := by
  -- Unfold the transported unit value to the raw `symm` application and normalize it once.
  exact toEuclideanCLM_apply_symm_apply (n := n) (T := (u : Point →L[ℝ] Point))

/-- Helper for Chapter03 Theorem 3.4.4: transporting `(fderiv ℝ F xStar).inverse` back through
`Matrix.toEuclideanCLM` preserves the root inverse `ℓ₂` norm bound. -/
lemma rootInverseCandidate_l2Norm_le
    (F : Point → Point) (xStar : Point) (β : ℝ)
    (h_inverse_bound : ‖(fderiv ℝ F xStar).inverse‖ ≤ β) :
    let rootInverseCandidate :
        Matrix (Fin n) (Fin n) ℝ :=
          ((Matrix.toEuclideanCLM :
              Matrix (Fin n) (Fin n) ℝ ≃⋆ₐ[ℝ] Point →L[ℝ] Point).symm)
            ((fderiv ℝ F xStar).inverse)
    ‖rootInverseCandidate‖₂ ≤ β := by
  -- Move the norm back to the continuous-linear-map side, where the source inverse bound lives.
  dsimp
  calc
    ‖((Matrix.toEuclideanCLM :
          Matrix (Fin n) (Fin n) ℝ ≃⋆ₐ[ℝ] Point →L[ℝ] Point).symm)
          ((fderiv ℝ F xStar).inverse)‖₂
        = ‖(Matrix.toEuclideanCLM :
            Matrix (Fin n) (Fin n) ℝ ≃⋆ₐ[ℝ] Point →L[ℝ] Point)
            (((Matrix.toEuclideanCLM :
                Matrix (Fin n) (Fin n) ℝ ≃⋆ₐ[ℝ] Point →L[ℝ] Point).symm)
              ((fderiv ℝ F xStar).inverse))‖ := by
            symm
            simpa using
              (Matrix.l2_opNorm_toEuclideanCLM
                (((Matrix.toEuclideanCLM :
                    Matrix (Fin n) (Fin n) ℝ ≃⋆ₐ[ℝ] Point →L[ℝ] Point).symm)
                  ((fderiv ℝ F xStar).inverse)))
    _ = ‖(fderiv ℝ F xStar).inverse‖ := by
          simp
    _ ≤ β := h_inverse_bound

/-- Helper for Chapter03 Theorem 3.4.4: transporting a continuous-linear-equivalence witness for
`fderiv ℝ F xStar` through `Matrix.toEuclideanCLM` produces a matrix unit whose value is the
root Jacobian matrix. -/
lemma jacobianMatrixAt_root_eq_transportedUnitVal
    (F : Point → Point) (xStar : Point)
    (h_invertible : (fderiv ℝ F xStar).IsInvertible) :
    ∃ uStar : (Matrix (Fin n) (Fin n) ℝ)ˣ,
      (↑uStar : Matrix (Fin n) (Fin n) ℝ) =
        jacobianMatrixAt coordBasis coordBasis F xStar := by
  rcases h_invertible with ⟨Aroot, hAroot⟩
  refine ⟨Units.map
      ((Matrix.toEuclideanCLM :
          Matrix (Fin n) (Fin n) ℝ ≃⋆ₐ[ℝ] Point →L[ℝ] Point).symm.toMonoidHom)
      Aroot.toUnit, ?_⟩
  -- Compare the transported unit on the continuous-linear-map side, where the derivative witness
  -- already lives without any inverse-product transport.
  refine (Matrix.toEuclideanCLM :
      Matrix (Fin n) (Fin n) ℝ ≃⋆ₐ[ℝ] Point →L[ℝ] Point).injective ?_
  calc
    (Matrix.toEuclideanCLM :
        Matrix (Fin n) (Fin n) ℝ ≃⋆ₐ[ℝ] Point →L[ℝ] Point)
        ((↑(Units.map
          ((Matrix.toEuclideanCLM :
              Matrix (Fin n) (Fin n) ℝ ≃⋆ₐ[ℝ] Point →L[ℝ] Point).symm.toMonoidHom)
          Aroot.toUnit) : Matrix (Fin n) (Fin n) ℝ))
      = (Aroot.toUnit : Point →L[ℝ] Point) := by
          exact toEuclideanCLM_map_symm_unit_val (n := n) (u := Aroot.toUnit)
    _ = (Aroot : Point →L[ℝ] Point) := rfl
    _ = fderiv ℝ F xStar := hAroot
    _ = (Matrix.toEuclideanCLM :
        Matrix (Fin n) (Fin n) ℝ ≃⋆ₐ[ℝ] Point →L[ℝ] Point)
        (jacobianMatrixAt coordBasis coordBasis F xStar) := by
          symm
          exact jacobianMatrixAt_toEuclideanCLM_coordBasis (F := F) (x := xStar)

/-- Helper for Chapter03 Theorem 3.4.4: the root Jacobian matrix is a unit, and its matrix
inverse inherits the source inverse-norm bound from `fderiv ℝ F xStar`. -/
lemma jacobianMatrixAt_root_isUnit_and_inv_l2_le
    (F : Point → Point) (xStar : Point) (β : ℝ)
    (h_invertible : (fderiv ℝ F xStar).IsInvertible)
    (h_inverse_bound : ‖(fderiv ℝ F xStar).inverse‖ ≤ β) :
    IsUnit (jacobianMatrixAt coordBasis coordBasis F xStar) ∧
      ‖(jacobianMatrixAt coordBasis coordBasis F xStar)⁻¹‖₂ ≤ β := by
  rcases h_invertible with ⟨Aroot, hAroot⟩
  let uStar : (Matrix (Fin n) (Fin n) ℝ)ˣ :=
    Units.map
      ((Matrix.toEuclideanCLM :
          Matrix (Fin n) (Fin n) ℝ ≃⋆ₐ[ℝ] Point →L[ℝ] Point).symm.toMonoidHom)
      Aroot.toUnit
  have huStar :
      (↑uStar : Matrix (Fin n) (Fin n) ℝ) =
        jacobianMatrixAt coordBasis coordBasis F xStar := by
    -- Keep the root Jacobian in the stable matrix spelling produced by unit transport.
    refine (Matrix.toEuclideanCLM :
        Matrix (Fin n) (Fin n) ℝ ≃⋆ₐ[ℝ] Point →L[ℝ] Point).injective ?_
    calc
      (Matrix.toEuclideanCLM :
          Matrix (Fin n) (Fin n) ℝ ≃⋆ₐ[ℝ] Point →L[ℝ] Point)
          (↑uStar : Matrix (Fin n) (Fin n) ℝ)
          = (Aroot.toUnit : Point →L[ℝ] Point) := by
              simpa [uStar] using
                toEuclideanCLM_map_symm_unit_val (n := n) (u := Aroot.toUnit)
      _ = (Aroot : Point →L[ℝ] Point) := rfl
      _ = fderiv ℝ F xStar := hAroot
      _ = (Matrix.toEuclideanCLM :
          Matrix (Fin n) (Fin n) ℝ ≃⋆ₐ[ℝ] Point →L[ℝ] Point)
          (jacobianMatrixAt coordBasis coordBasis F xStar) := by
            symm
            exact jacobianMatrixAt_toEuclideanCLM_coordBasis (F := F) (x := xStar)
  have hInvNormTransport :
      ‖((uStar⁻¹ : (Matrix (Fin n) (Fin n) ℝ)ˣ) : Matrix (Fin n) (Fin n) ℝ)‖₂ ≤ β := by
    have hArootInvEq :
        (fderiv ℝ F xStar).inverse = (Aroot.symm : Point →L[ℝ] Point) := by
      rw [← hAroot]
      exact ContinuousLinearMap.inverse_equiv (e := Aroot)
    have hArootInv :
        ‖(Aroot.symm : Point →L[ℝ] Point)‖ ≤ β := by
      -- Rewrite the source inverse bound through the invertible derivative witness `Aroot`.
      rw [← hArootInvEq]
      exact h_inverse_bound
    have hInvTransportEq :
        (Matrix.toEuclideanCLM :
            Matrix (Fin n) (Fin n) ℝ ≃⋆ₐ[ℝ] Point →L[ℝ] Point)
            (((uStar⁻¹ : (Matrix (Fin n) (Fin n) ℝ)ˣ) : Matrix (Fin n) (Fin n) ℝ)) =
          (Aroot.symm : Point →L[ℝ] Point) := by
      -- Normalize the inverse transported unit before taking norms on the CLM side.
      calc
        (Matrix.toEuclideanCLM :
            Matrix (Fin n) (Fin n) ℝ ≃⋆ₐ[ℝ] Point →L[ℝ] Point)
            (((uStar⁻¹ : (Matrix (Fin n) (Fin n) ℝ)ˣ) : Matrix (Fin n) (Fin n) ℝ))
            = ((((Aroot.toUnit)⁻¹ : (Point →L[ℝ] Point)ˣ)) : Point →L[ℝ] Point) := by
                simpa [uStar] using
                  toEuclideanCLM_map_symm_unit_val
                    (n := n) (u := ((Aroot.toUnit)⁻¹ : (Point →L[ℝ] Point)ˣ))
        _ = (Aroot.symm : Point →L[ℝ] Point) := rfl
    have hInvCLM :
        ‖(Matrix.toEuclideanCLM :
            Matrix (Fin n) (Fin n) ℝ ≃⋆ₐ[ℝ] Point →L[ℝ] Point)
            (((uStar⁻¹ : (Matrix (Fin n) (Fin n) ℝ)ˣ) : Matrix (Fin n) (Fin n) ℝ))‖ ≤ β := by
      -- The inverse of the transported unit is the transported inverse continuous linear
      -- equivalence, so the original inverse bound applies on the CLM side.
      calc
        ‖(Matrix.toEuclideanCLM :
            Matrix (Fin n) (Fin n) ℝ ≃⋆ₐ[ℝ] Point →L[ℝ] Point)
            (((uStar⁻¹ : (Matrix (Fin n) (Fin n) ℝ)ˣ) : Matrix (Fin n) (Fin n) ℝ))‖
            = ‖(Aroot.symm : Point →L[ℝ] Point)‖ := by
                rw [hInvTransportEq]
        _ ≤ β := hArootInv
    -- Move the bound back to the matrix `ℓ₂` operator norm.
    calc
      ‖((uStar⁻¹ : (Matrix (Fin n) (Fin n) ℝ)ˣ) : Matrix (Fin n) (Fin n) ℝ)‖₂
          = ‖(Matrix.toEuclideanCLM :
              Matrix (Fin n) (Fin n) ℝ ≃⋆ₐ[ℝ] Point →L[ℝ] Point)
              (((uStar⁻¹ : (Matrix (Fin n) (Fin n) ℝ)ˣ) : Matrix (Fin n) (Fin n) ℝ))‖ := by
                symm
                simpa using
                  Matrix.l2_opNorm_toEuclideanCLM
                    (((uStar⁻¹ : (Matrix (Fin n) (Fin n) ℝ)ˣ) : Matrix (Fin n) (Fin n) ℝ))
      _ ≤ β := hInvCLM
  refine ⟨⟨uStar, huStar⟩, ?_⟩
  -- Rewrite the matrix inverse of the root Jacobian to the inverse of the transported unit.
  simpa [huStar] using hInvNormTransport

/-- Helper for Chapter03 Theorem 3.4.4: on the Euclidean coordinate basis, the entrywise
finite-difference Jacobian error is uniformly bounded by the source column estimate. -/
lemma finiteDifferenceJacobianError_maxEntryNorm_le
    (F : Point → Point)
    (xStar x : Point) (r h : ℝ) (γ : NNReal)
    (hx : x ∈ Metric.ball xStar r)
    (hF : DifferentiableOn ℝ F (Metric.ball xStar r))
    (hLip : LipschitzOnWith γ (fderiv ℝ F) (Metric.ball xStar r))
    (hstep : ∀ j : Fin n, x + h • coordBasis j ∈ Metric.ball xStar r)
    (hh : h ≠ 0) :
    matrixMaxEntryNorm
        (finiteDifferenceJacobianMatrix coordBasis coordBasis F x h -
          jacobianMatrixAt coordBasis coordBasis F x) ≤
      ((γ : ℝ) / 2) * |h| := by
  have hC : 0 ≤ ((γ : ℝ) / 2) * |h| := by
    positivity
  -- Reduce the max-entry norm bound to a pointwise estimate for each matrix coefficient.
  unfold matrixMaxEntryNorm
  refine (Matrix.norm_le_iff hC).2 ?_
  intro i j
  have hcol :
      ‖WithLp.toLp (2 : ENNReal)
          ((finiteDifferenceJacobianMatrix coordBasis coordBasis F x h -
              jacobianMatrixAt coordBasis coordBasis F x).col j)‖ ≤
        ((γ : ℝ) / 2) * |h| := by
    -- The Chapter 3.4.1 column estimate already controls the full Euclidean column vector.
    simpa using
      (finiteDifferenceJacobianColumnError_le
        coordBasis coordBasis (Metric.ball xStar r) F x h γ j
        Metric.isOpen_ball (convex_ball xStar r) hx hF hLip (by simp) (hstep j) hh)
  have hentry :
      ‖(finiteDifferenceJacobianMatrix coordBasis coordBasis F x h -
            jacobianMatrixAt coordBasis coordBasis F x) i j‖ ≤
        ‖WithLp.toLp (2 : ENNReal)
          ((finiteDifferenceJacobianMatrix coordBasis coordBasis F x h -
              jacobianMatrixAt coordBasis coordBasis F x).col j)‖ := by
    -- Each entry is bounded by the Euclidean norm of its column.
    simpa using
      (PiLp.norm_apply_le
        (x := WithLp.toLp (2 : ENNReal)
          ((finiteDifferenceJacobianMatrix coordBasis coordBasis F x h -
              jacobianMatrixAt coordBasis coordBasis F x).col j)) i)
  exact hentry.trans hcol

/-- Helper for Chapter03 Theorem 3.4.4: the Euclidean matrix `ℓ₂` error of the forward
finite-difference Jacobian is obtained by combining the max-entry bound with the Chapter 1
matrix-norm comparison theorem. -/
lemma finiteDifferenceJacobianL2Error_le
    (F : Point → Point)
    (xStar x : Point) (r h : ℝ) (γ : NNReal)
    (hx : x ∈ Metric.ball xStar r)
    (hF : DifferentiableOn ℝ F (Metric.ball xStar r))
    (hLip : LipschitzOnWith γ (fderiv ℝ F) (Metric.ball xStar r))
    (hstep : ∀ j : Fin n, x + h • coordBasis j ∈ Metric.ball xStar r)
    (hh : h ≠ 0) :
    ‖finiteDifferenceJacobianMatrix coordBasis coordBasis F x h -
        jacobianMatrixAt coordBasis coordBasis F x‖₂ ≤
      Real.sqrt ((n * n : ℕ) : ℝ) * (((γ : ℝ) / 2) * |h|) := by
  -- First move from the operator norm to the max-entry norm.
  calc
    ‖finiteDifferenceJacobianMatrix coordBasis coordBasis F x h -
        jacobianMatrixAt coordBasis coordBasis F x‖₂
        ≤ Real.sqrt ((n * n : ℕ) : ℝ) *
            matrixMaxEntryNorm
              (finiteDifferenceJacobianMatrix coordBasis coordBasis F x h -
                jacobianMatrixAt coordBasis coordBasis F x) := by
          simpa using
            matrixL2OperatorNorm_le_sqrt_mul_matrixMaxEntryNorm
              (finiteDifferenceJacobianMatrix coordBasis coordBasis F x h -
                jacobianMatrixAt coordBasis coordBasis F x)
    -- Then insert the previously stabilized max-entry estimate.
    _ ≤ Real.sqrt ((n * n : ℕ) : ℝ) * (((γ : ℝ) / 2) * |h|) := by
          gcongr
          exact
            finiteDifferenceJacobianError_maxEntryNorm_le
              F xStar x r h γ hx hF hLip hstep hh

/-- Helper for Chapter03 Theorem 3.4.4: the full forward finite-difference Jacobian differs from
the root Jacobian matrix by the derivative-Lipschitz drift plus the finite-difference error. -/
lemma finiteDifferenceJacobian_sub_root_l2_le
    (F : Point → Point)
    (xStar x : Point) (r hk : ℝ) (γ : NNReal)
    (hr : 0 < r)
    (hx : x ∈ Metric.ball xStar r)
    (hF : DifferentiableOn ℝ F (Metric.ball xStar r))
    (hLip : LipschitzOnWith γ (fderiv ℝ F) (Metric.ball xStar r))
    (hstep : ∀ j : Fin n, x + hk • coordBasis j ∈ Metric.ball xStar r)
    (hhk : hk ≠ 0) :
    ‖finiteDifferenceJacobianMatrix coordBasis coordBasis F x hk -
        jacobianMatrixAt coordBasis coordBasis F xStar‖₂ ≤
      (γ : ℝ) * ‖x - xStar‖ +
        Real.sqrt ((n * n : ℕ) : ℝ) * (((γ : ℝ) / 2) * |hk|) := by
  let Afd := finiteDifferenceJacobianMatrix coordBasis coordBasis F x hk
  let Jx := jacobianMatrixAt coordBasis coordBasis F x
  let Jstar := jacobianMatrixAt coordBasis coordBasis F xStar
  have hxStar : xStar ∈ Metric.ball xStar r := by
    simpa [Metric.mem_ball] using hr
  have hfd :
      ‖Afd - Jx‖₂ ≤
        Real.sqrt ((n * n : ℕ) : ℝ) * (((γ : ℝ) / 2) * |hk|) := by
    -- This is the stabilized Chapter 3.4.1 operator-norm estimate at the current iterate.
    simpa [Afd, Jx] using
      finiteDifferenceJacobianL2Error_le F xStar x r hk γ hx hF hLip hstep hhk
  have hroot :
      ‖Jx - Jstar‖₂ ≤ (γ : ℝ) * ‖x - xStar‖ := by
    -- Transport the Jacobian matrices to `fderiv` once and use the Lipschitz hypothesis there.
    calc
      ‖Jx - Jstar‖₂
          = ‖(Matrix.toEuclideanCLM :
              Matrix (Fin n) (Fin n) ℝ ≃⋆ₐ[ℝ] Point →L[ℝ] Point) (Jx - Jstar)‖ := by
              symm
              simpa using Matrix.l2_opNorm_toEuclideanCLM (Jx - Jstar)
      _ = ‖fderiv ℝ F x - fderiv ℝ F xStar‖ := by
            simp [Jx, Jstar, jacobianMatrixAt_toEuclideanCLM_coordBasis]
      _ = dist (fderiv ℝ F x) (fderiv ℝ F xStar) := by
            simp [dist_eq_norm]
      _ ≤ (γ : ℝ) * dist x xStar := by
            exact hLip.dist_le_mul (x := x) (y := xStar) hx hxStar
      _ = (γ : ℝ) * ‖x - xStar‖ := by
            simp [dist_eq_norm]
  have hsplit : Afd - Jstar = (Afd - Jx) + (Jx - Jstar) := by
    -- Split the perturbation around the current exact Jacobian before applying the triangle
    -- inequality.
    ext i j
    simp [Afd, Jx, Jstar]
  calc
    ‖finiteDifferenceJacobianMatrix coordBasis coordBasis F x hk -
        jacobianMatrixAt coordBasis coordBasis F xStar‖₂
        = ‖(Afd - Jx) + (Jx - Jstar)‖₂ := by
            rw [show Afd - Jstar = (Afd - Jx) + (Jx - Jstar) by exact hsplit]
    _ ≤ ‖Afd - Jx‖₂ + ‖Jx - Jstar‖₂ := by
          have hAfdJx :
              ‖(Matrix.toEuclideanCLM :
                  Matrix (Fin n) (Fin n) ℝ ≃⋆ₐ[ℝ] Point →L[ℝ] Point)
                  (Afd - Jx)‖ = ‖Afd - Jx‖₂ := by
            simpa [matrixL2OperatorNorm] using
              (Matrix.l2_opNorm_toEuclideanCLM (Afd - Jx))
          have hJxJstar :
              ‖(Matrix.toEuclideanCLM :
                  Matrix (Fin n) (Fin n) ℝ ≃⋆ₐ[ℝ] Point →L[ℝ] Point)
                  (Jx - Jstar)‖ = ‖Jx - Jstar‖₂ := by
            simpa [matrixL2OperatorNorm] using
              (Matrix.l2_opNorm_toEuclideanCLM (Jx - Jstar))
          calc
            ‖(Afd - Jx) + (Jx - Jstar)‖₂
                = ‖(Matrix.toEuclideanCLM :
                    Matrix (Fin n) (Fin n) ℝ ≃⋆ₐ[ℝ] Point →L[ℝ] Point)
                    (Afd - Jx) +
                    (Matrix.toEuclideanCLM :
                      Matrix (Fin n) (Fin n) ℝ ≃⋆ₐ[ℝ] Point →L[ℝ] Point)
                      (Jx - Jstar)‖ := by
                    simpa [map_add, map_sub] using
                      (Matrix.l2_opNorm_toEuclideanCLM ((Afd - Jx) + (Jx - Jstar))).symm
            _ ≤ ‖(Matrix.toEuclideanCLM :
                    Matrix (Fin n) (Fin n) ℝ ≃⋆ₐ[ℝ] Point →L[ℝ] Point)
                    (Afd - Jx)‖ +
                  ‖(Matrix.toEuclideanCLM :
                    Matrix (Fin n) (Fin n) ℝ ≃⋆ₐ[ℝ] Point →L[ℝ] Point)
                    (Jx - Jstar)‖ := norm_add_le _ _
            _ = ‖Afd - Jx‖₂ + ‖Jx - Jstar‖₂ := by
                  rw [hAfdJx, hJxJstar]
    _ ≤ Real.sqrt ((n * n : ℕ) : ℝ) * (((γ : ℝ) / 2) * |hk|) +
          (γ : ℝ) * ‖x - xStar‖ := by
          gcongr
    _ = (γ : ℝ) * ‖x - xStar‖ +
          Real.sqrt ((n * n : ℕ) : ℝ) * (((γ : ℝ) / 2) * |hk|) := by
          ring

/-- Helper for Chapter03 Theorem 3.4.4: the Euclidean matrix `ℓ₂` norm is unchanged when the
order of a matrix difference is reversed. -/
lemma l2MatrixNorm_sub_rev
    (A B : Matrix (Fin n) (Fin n) ℝ) :
    ‖A - B‖₂ = ‖B - A‖₂ := by
  -- Transport the matrix norm to the Euclidean operator norm, where `‖u - v‖ = ‖v - u‖`.
  calc
    ‖A - B‖₂
        = ‖(Matrix.toEuclideanCLM :
            Matrix (Fin n) (Fin n) ℝ ≃⋆ₐ[ℝ] Point →L[ℝ] Point) (A - B)‖ := by
            symm
            simpa using Matrix.l2_opNorm_toEuclideanCLM (A - B)
    _ = ‖(Matrix.toEuclideanCLM :
            Matrix (Fin n) (Fin n) ℝ ≃⋆ₐ[ℝ] Point →L[ℝ] Point) (B - A)‖ := by
          simpa [map_sub] using
            (norm_sub_rev
              ((Matrix.toEuclideanCLM :
                  Matrix (Fin n) (Fin n) ℝ ≃⋆ₐ[ℝ] Point →L[ℝ] Point) A)
              ((Matrix.toEuclideanCLM :
                  Matrix (Fin n) (Fin n) ℝ ≃⋆ₐ[ℝ] Point →L[ℝ] Point) B))
    _ = ‖B - A‖₂ := by
          simpa using Matrix.l2_opNorm_toEuclideanCLM (B - A)

/-- Helper for Chapter03 Theorem 3.4.4: once the forward finite-difference Jacobian stays within
the standard Neumann perturbation radius of the root Jacobian, it is invertible and its inverse
has the source-style `2 * β` `ℓ₂` bound. -/
lemma finiteDifferenceJacobian_isUnit_and_inv_l2_le
    (F : Point → Point)
    (xStar x : Point) (r β hk : ℝ) (γ : NNReal)
    (hr : 0 < r) (hβ : 0 < β)
    (h_invertible : (fderiv ℝ F xStar).IsInvertible)
    (h_inverse_bound : ‖(fderiv ℝ F xStar).inverse‖ ≤ β)
    (hx : x ∈ Metric.ball xStar r)
    (hF : DifferentiableOn ℝ F (Metric.ball xStar r))
    (hLip : LipschitzOnWith γ (fderiv ℝ F) (Metric.ball xStar r))
    (hstep : ∀ j : Fin n, x + hk • coordBasis j ∈ Metric.ball xStar r)
    (hhk : hk ≠ 0)
    (hsmall :
      β *
          ((γ : ℝ) * ‖x - xStar‖ +
            Real.sqrt ((n * n : ℕ) : ℝ) * (((γ : ℝ) / 2) * |hk|)) <
        1 / 2) :
    IsUnit (finiteDifferenceJacobianMatrix coordBasis coordBasis F x hk) ∧
      ‖(finiteDifferenceJacobianMatrix coordBasis coordBasis F x hk)⁻¹‖₂ ≤ 2 * β := by
  let Jstar := jacobianMatrixAt coordBasis coordBasis F xStar
  let Afd := finiteDifferenceJacobianMatrix coordBasis coordBasis F x hk
  have hroot :
      IsUnit Jstar ∧ ‖Jstar⁻¹‖₂ ≤ β := by
    -- First package the root Jacobian invertibility in the exact matrix spelling used below.
    simpa [Jstar] using
      jacobianMatrixAt_root_isUnit_and_inv_l2_le
        (F := F) (xStar := xStar) (β := β) h_invertible h_inverse_bound
  have hpert :
      ‖Jstar - Afd‖₂ ≤
        (γ : ℝ) * ‖x - xStar‖ +
          Real.sqrt ((n * n : ℕ) : ℝ) * (((γ : ℝ) / 2) * |hk|) := by
    -- Route correction: use the dedicated `ℓ₂` matrix symmetry lemma instead of the generic
    -- `norm_sub_rev`, which only talks about ambient normed-group instances.
    calc
      ‖Jstar - Afd‖₂ = ‖Afd - Jstar‖₂ := l2MatrixNorm_sub_rev Jstar Afd
      _ ≤ (γ : ℝ) * ‖x - xStar‖ +
          Real.sqrt ((n * n : ℕ) : ℝ) * (((γ : ℝ) / 2) * |hk|) := by
            simpa [Afd, Jstar] using
              finiteDifferenceJacobian_sub_root_l2_le
                (F := F) (xStar := xStar) (x := x) (r := r) (hk := hk) (γ := γ)
                hr hx hF hLip hstep hhk
  have hsmall_neumann :
      β *
          ((γ : ℝ) * ‖x - xStar‖ +
            Real.sqrt ((n * n : ℕ) : ℝ) * (((γ : ℝ) / 2) * |hk|)) <
        1 := by
    -- The source smallness hypothesis is stronger than the threshold required by Theorem 1.2.6.
    linarith
  rcases isEmpty_or_nonempty (Fin n) with hFinEmpty | hFinNonempty
  · -- In the zero-dimensional case every matrix is definitionally the unique matrix, so the
    -- invertibility and inverse-norm claims are immediate.
    -- Local instance justification (empty index type): the zero-dimensional matrix space is
    -- subsingleton only after recording `IsEmpty (Fin n)`.
    letI : IsEmpty (Fin n) := hFinEmpty
    have hAfd_one : Afd = 1 := Subsingleton.elim _ _
    have hAfd_inv_zero : (Afd⁻¹ : Matrix (Fin n) (Fin n) ℝ) = 0 := Subsingleton.elim _ _
    have hAfd_isUnit : IsUnit Afd := by
      rw [hAfd_one]
      exact isUnit_one
    have hzero : ‖(0 : Matrix (Fin n) (Fin n) ℝ)‖₂ = 0 := by
      calc
        ‖(0 : Matrix (Fin n) (Fin n) ℝ)‖₂
            = ‖(Matrix.toEuclideanCLM :
                Matrix (Fin n) (Fin n) ℝ ≃⋆ₐ[ℝ] Point →L[ℝ] Point)
                (0 : Matrix (Fin n) (Fin n) ℝ)‖ := by
                  symm
                  simpa using Matrix.l2_opNorm_toEuclideanCLM (0 : Matrix (Fin n) (Fin n) ℝ)
        _ = 0 := by simp
    have hAfd_inv_bound : ‖(Afd⁻¹ : Matrix (Fin n) (Fin n) ℝ)‖₂ ≤ 2 * β := by
      rw [hAfd_inv_zero, hzero]
      nlinarith
    refine ⟨?_, ?_⟩
    · simpa [Afd] using hAfd_isUnit
    · simpa [Afd] using hAfd_inv_bound
  · -- In the positive-dimensional case the Chapter 1 induced `ℓ₂` norm satisfies `N 1 = 1`,
    -- so the standard Neumann perturbation theorem applies unchanged.
    -- Local instance justification (nonempty index type): `inducedMatrixNorm_one` needs an
    -- explicit witness that `Fin n` is inhabited.
    letI : Nonempty (Fin n) := hFinNonempty
    -- Local instance justification (`ℓ₂` owner): the induced `ℓ₂` norm API is parameterized by
    -- a `Fact (1 ≤ p)` witness.
    letI : Fact (1 ≤ (2 : ENNReal)) := ⟨by norm_num⟩
    have hNormL2 :
        IsMatrixNorm (lpMatrixNorm (2 : ENNReal) : Matrix (Fin n) (Fin n) ℝ → ℝ) := by
      simpa [lpMatrixNorm] using
        (inducedMatrixNorm_isMatrixNorm
          (domainNorm := lpNorm (2 : ENNReal))
          (codomainNorm := lpNorm (2 : ENNReal)))
    have hSubL2 :
        MatrixNormSubmultiplicative
          (lpMatrixNorm (2 : ENNReal) : Matrix (Fin n) (Fin n) ℝ → ℝ) := by
      simpa using (lpMatrixNorm_isSubmultiplicative (n := n) (p := (2 : ENNReal)))
    have hOneL2 :
        lpMatrixNorm (2 : ENNReal) (1 : Matrix (Fin n) (Fin n) ℝ) = 1 := by
      simpa [lpMatrixNorm] using
        (inducedMatrixNorm_one (n := n) (vectorNorm := lpNorm (2 : ENNReal)))
    have hroot_lp :
        lpMatrixNorm (2 : ENNReal) Jstar⁻¹ ≤ β := by
      rw [l2MatrixNorm_eq_l2OperatorNorm]
      exact hroot.2
    have hpert_lp :
        lpMatrixNorm (2 : ENNReal) (Jstar - Afd) ≤
          (γ : ℝ) * ‖x - xStar‖ +
            Real.sqrt ((n * n : ℕ) : ℝ) * (((γ : ℝ) / 2) * |hk|) := by
      rw [l2MatrixNorm_eq_l2OperatorNorm]
      exact hpert
    have hneumann :=
      vonNeumannLemma_isUnit_and_inv_norm_le_of_norm_sub_le
        (N := lpMatrixNorm (2 : ENNReal))
        hNormL2 hSubL2 hOneL2
        (A := Jstar) (B := Afd)
        (α := β)
        (β := (γ : ℝ) * ‖x - xStar‖ +
          Real.sqrt ((n * n : ℕ) : ℝ) * (((γ : ℝ) / 2) * |hk|))
        hroot.1 hroot_lp hpert_lp hsmall_neumann
    have hneumann_inv :
        ‖Afd⁻¹‖₂ ≤
          β /
            (1 -
              β *
                ((γ : ℝ) * ‖x - xStar‖ +
                  Real.sqrt ((n * n : ℕ) : ℝ) * (((γ : ℝ) / 2) * |hk|))) := by
      have hneumann_inv_lp :
          lpMatrixNorm (2 : ENNReal) Afd⁻¹ ≤
            β /
              (1 -
                β *
                  ((γ : ℝ) * ‖x - xStar‖ +
                    Real.sqrt ((n * n : ℕ) : ℝ) * (((γ : ℝ) / 2) * |hk|))) := hneumann.2
      rw [l2MatrixNorm_eq_l2OperatorNorm] at hneumann_inv_lp
      exact hneumann_inv_lp
    refine ⟨hneumann.1, ?_⟩
    -- Collapse the generic Neumann inverse bound to the source-style estimate `2 * β`.
    calc
      ‖Afd⁻¹‖₂ ≤
          β /
            (1 -
              β *
                ((γ : ℝ) * ‖x - xStar‖ +
                  Real.sqrt ((n * n : ℕ) : ℝ) * (((γ : ℝ) / 2) * |hk|))) := hneumann_inv
      _ ≤ 2 * β := by
            have hden_pos :
                0 <
                  1 -
                    β *
                      ((γ : ℝ) * ‖x - xStar‖ +
                        Real.sqrt ((n * n : ℕ) : ℝ) * (((γ : ℝ) / 2) * |hk|)) := by
              linarith
            have hhalf_le :
                (1 / 2 : ℝ) ≤
                  1 -
                    β *
                      ((γ : ℝ) * ‖x - xStar‖ +
                        Real.sqrt ((n * n : ℕ) : ℝ) * (((γ : ℝ) / 2) * |hk|)) := by
              linarith
            exact (div_le_iff₀ hden_pos).2 (by nlinarith)

/-- Helper for Chapter03 Theorem 3.4.4: the Chapter 1 local bi-Lipschitz estimate turns the
residual control `|hSeq k| ≤ c₂ * ‖F (x k)‖` into the source step control
`|hSeq k| ≤ c₁ * ‖x k - xStar‖` on a smaller working ball around `xStar`. -/
lemma residualControl_implies_stepControlNearRoot
    (F : Point → Point) (xStar : Point) (r : ℝ) (γ : NNReal)
    (hr : 0 < r)
    (h_contDiff : ContDiffOn ℝ 1 F (Metric.ball xStar r))
    (h_root : F xStar = 0)
    (h_invertible : (fderiv ℝ F xStar).IsInvertible)
    (h_lipschitz : LipschitzOnWith γ (fun x ↦ fderiv ℝ F x) (Metric.ball xStar r))
    {hSeq : ℕ → ℝ} {x : ℕ → Point} :
    ∃ εRes > 0,
      (∀ k : ℕ, x k ∈ Metric.ball xStar εRes) →
      (∃ c2 > 0, ∀ k : ℕ, |hSeq k| ≤ c2 * ‖F (x k)‖) →
      ∃ c1 > 0, ∀ k : ℕ, |hSeq k| ≤ c1 * ‖x k - xStar‖ := by
  have hxStar_mem : xStar ∈ Metric.ball xStar r := by
    simpa [Metric.mem_ball, dist_eq_norm] using hr
  rcases norm_image_sub_bounds_near_of_fderiv_isInvertible
      (D := Metric.ball xStar r) (F := F) (x := xStar) (γ := γ)
      Metric.isOpen_ball (convex_ball xStar r) hxStar_mem h_contDiff h_lipschitz h_invertible with
    ⟨ε, α, β, hBounds⟩
  let εRes : ℝ := min ε (r / 2)
  have hεRes_pos : 0 < εRes := by
    -- Shrink the Chapter 1 radius so that every iterate also stays inside the working `r`-ball.
    dsimp [εRes]
    exact lt_min hBounds.eps_pos (half_pos hr)
  refine ⟨εRes, hεRes_pos, ?_⟩
  intro hxSeq hres
  rcases hres with ⟨c2, hc2_pos, hc2⟩
  have hβ_pos : 0 < β := lt_trans hBounds.alpha_pos hBounds.alpha_lt_beta
  refine ⟨c2 * β, mul_pos hc2_pos hβ_pos, ?_⟩
  intro k
  have hxk_mem : x k ∈ Metric.ball xStar r := by
    -- The smaller ball `Metric.ball xStar εRes` sits inside the original working ball.
    have hxk_small : ‖x k - xStar‖ < εRes := by
      simpa [Metric.mem_ball, dist_eq_norm] using hxSeq k
    have hxk_half : ‖x k - xStar‖ < r / 2 := lt_of_lt_of_le hxk_small (min_le_right _ _)
    have hxk_r : ‖x k - xStar‖ < r := by
      nlinarith
    simpa [Metric.mem_ball, dist_eq_norm] using hxk_r
  have hupper :
      ‖F (x k)‖ ≤ β * ‖x k - xStar‖ := by
    -- Apply the local upper bi-Lipschitz bound with `v = xStar` and `F xStar = 0`.
    have hxk_small : ‖x k - xStar‖ < εRes := by
      simpa [Metric.mem_ball, dist_eq_norm] using hxSeq k
    have hmax :
        max ‖x k - xStar‖ ‖xStar - xStar‖ ≤ ε := by
      calc
        max ‖x k - xStar‖ ‖xStar - xStar‖ ≤ εRes := by
          simp [norm_nonneg, le_of_lt hxk_small]
        _ ≤ ε := min_le_left _ _
    simpa [h_root] using hBounds.upper hxk_mem hxStar_mem hmax
  -- Multiply the residual-control bound by the local `‖F y‖ ≤ β ‖y - xStar‖` estimate.
  calc
    |hSeq k| ≤ c2 * ‖F (x k)‖ := hc2 k
    _ ≤ c2 * (β * ‖x k - xStar‖) := by
          gcongr
    _ = (c2 * β) * ‖x k - xStar‖ := by ring

/-- Helper for Chapter03 Theorem 3.4.4: every initial point and finite-difference step sequence
admits a canonical generated sequence before any invertibility or convergence estimates are
imposed. -/
theorem exists_generatedFiniteDifferenceNewtonSequence
    (F : Point → Point) (hSeq : ℕ → ℝ) (x0 : Point) :
    ∃ x : ℕ → Point, IsFiniteDifferenceNewtonGeneratedSequence F x hSeq x0 := by
  -- Use the primitive-recursive update family as the canonical witness.
  exact ⟨finiteDifferenceNewtonIterates F hSeq x0,
    finiteDifferenceNewtonIterates_generated F hSeq x0⟩

/-- Helper for Chapter03 Theorem 3.4.4: an iterate within distance `ε` of the root and a
step of size at most `h` produces every forward finite-difference sample inside the larger
ball of radius `r` whenever `ε + h < r`. -/
lemma forwardSample_mem_ball_of_error_le
    (x xStar : Point) (η ε h r : ℝ) (j : Fin n)
    (hx : ‖x - xStar‖ ≤ ε)
    (hη : |η| ≤ h)
    (hεh_lt_r : ε + h < r) :
    x + η • coordBasis j ∈ Metric.ball xStar r := by
  have hcoordBasis_norm : ‖coordBasis j‖ = 1 := by
    -- The Euclidean coordinate basis vectors are unit vectors.
    change ‖(EuclideanSpace.basisFun (Fin n) ℝ) j‖ = 1
    simp
  have hnorm :
      ‖(x + η • coordBasis j) - xStar‖ ≤ ‖x - xStar‖ + ‖η • coordBasis j‖ := by
    have htriangle := norm_add_le (x - xStar) (η • coordBasis j)
    simpa [sub_eq_add_neg, add_assoc, add_left_comm, add_comm] using htriangle
  have hη_nonneg : 0 ≤ h := le_trans (abs_nonneg η) hη
  have hbound :
      ‖(x + η • coordBasis j) - xStar‖ < r := by
    calc
      ‖(x + η • coordBasis j) - xStar‖ ≤ ‖x - xStar‖ + ‖η • coordBasis j‖ := hnorm
      _ = ‖x - xStar‖ + |η| := by
            rw [norm_smul, hcoordBasis_norm]
            simp
      _ ≤ ε + h := add_le_add hx hη
      _ < r := hεh_lt_r
  simpa [Metric.mem_ball, dist_eq_norm] using hbound

/-- Helper for Chapter03 Theorem 3.4.4: applying the inverse finite-difference Jacobian matrix to
its transported Euclidean action cancels back to the original vector. -/
theorem toEuclideanLin_inv_toEuclideanCLM_apply
    (A : Matrix (Fin n) (Fin n) ℝ)
    (hA : IsUnit A)
    (v : Point) :
    Matrix.toEuclideanLin (A⁻¹)
      (((Matrix.toEuclideanCLM :
          Matrix (Fin n) (Fin n) ℝ ≃⋆ₐ[ℝ] Point →L[ℝ] Point) A) v) = v := by
  -- Local instance justification (matrix inverse): the cancellation lemma for `A⁻¹` is stated
  -- using an `Invertible A` instance extracted from the stagewise unit hypothesis.
  letI := hA.invertible
  -- Cancel the transported matrix action once at the coordinate level.
  apply WithLp.ofLp_injective
  simp [Matrix.ofLp_toEuclideanCLM, Matrix.ofLp_toLpLin (p := (2 : ENNReal))
    (q := (2 : ENNReal)), Matrix.mulVec_mulVec, Matrix.inv_mul_of_invertible,
    Matrix.one_mulVec]

/-- Helper for Chapter03 Theorem 3.4.4: the CLM-side Jacobian mismatch is exactly the
transport of the matrix difference `jacobianMatrixAt - Afd`. -/
lemma finiteDifferenceJacobianCLMSub_apply
    (F : Point → Point)
    (xk v : Point)
    (Afd : Matrix (Fin n) (Fin n) ℝ) :
    (((fderiv ℝ F xk) -
          (Matrix.toEuclideanCLM :
            Matrix (Fin n) (Fin n) ℝ ≃⋆ₐ[ℝ] Point →L[ℝ] Point) Afd) v) =
      (((Matrix.toEuclideanCLM :
            Matrix (Fin n) (Fin n) ℝ ≃⋆ₐ[ℝ] Point →L[ℝ] Point)
          (jacobianMatrixAt coordBasis coordBasis F xk - Afd)) v) := by
  -- Route correction: normalize the CLM subtraction once at the owner level before any norm
  -- estimates, instead of asking later proofs to unfold `fderiv` and matrix transport inline.
  calc
    (((fderiv ℝ F xk) -
          (Matrix.toEuclideanCLM :
            Matrix (Fin n) (Fin n) ℝ ≃⋆ₐ[ℝ] Point →L[ℝ] Point) Afd) v)
        = (fderiv ℝ F xk) v -
            ((Matrix.toEuclideanCLM :
              Matrix (Fin n) (Fin n) ℝ ≃⋆ₐ[ℝ] Point →L[ℝ] Point) Afd) v := by
            rfl
    _ = ((Matrix.toEuclideanCLM :
            Matrix (Fin n) (Fin n) ℝ ≃⋆ₐ[ℝ] Point →L[ℝ] Point)
            (jacobianMatrixAt coordBasis coordBasis F xk) v) -
          ((Matrix.toEuclideanCLM :
            Matrix (Fin n) (Fin n) ℝ ≃⋆ₐ[ℝ] Point →L[ℝ] Point) Afd) v := by
            rw [jacobianMatrixAt_toEuclideanCLM_coordBasis (F := F) (x := xk)]
    _ = (((Matrix.toEuclideanCLM :
            Matrix (Fin n) (Fin n) ℝ ≃⋆ₐ[ℝ] Point →L[ℝ] Point)
            (jacobianMatrixAt coordBasis coordBasis F xk - Afd)) v) := by
          simp [map_sub]

/-- Helper for Chapter03 Theorem 3.4.4: the finite-difference Newton update rewrites the next
error as the inverse stage Jacobian applied to the Taylor remainder plus the Jacobian mismatch
term at the current iterate. -/
lemma finiteDifferenceNewtonUpdateError_eq_inverseRemainder
    (F : Point → Point)
    (xStar xk xNext : Point)
    (hk : ℝ)
    (h_root : F xStar = 0)
    (hAfd : IsUnit (finiteDifferenceJacobianMatrix coordBasis coordBasis F xk hk))
    (hNext :
      xNext =
        xk -
          Matrix.toEuclideanLin
            ((finiteDifferenceJacobianMatrix coordBasis coordBasis F xk hk)⁻¹)
            (F xk)) :
    xNext - xStar =
      Matrix.toEuclideanLin
        ((finiteDifferenceJacobianMatrix coordBasis coordBasis F xk hk)⁻¹)
        (F xStar - F xk - fderiv ℝ F xk (xStar - xk) +
          ((fderiv ℝ F xk) -
              (Matrix.toEuclideanCLM :
                Matrix (Fin n) (Fin n) ℝ ≃⋆ₐ[ℝ] Point →L[ℝ] Point)
                (finiteDifferenceJacobianMatrix coordBasis coordBasis F xk hk))
            (xStar - xk)) := by
  let Afd := finiteDifferenceJacobianMatrix coordBasis coordBasis F xk hk
  let AfdCLM :=
    (Matrix.toEuclideanCLM :
      Matrix (Fin n) (Fin n) ℝ ≃⋆ₐ[ℝ] Point →L[ℝ] Point) Afd
  subst xNext
  have hcancel :
      Matrix.toEuclideanLin (Afd⁻¹) (AfdCLM (xk - xStar)) = xk - xStar := by
    -- Cancel the inverse finite-difference Jacobian against its transported action once, before
    -- rewriting the source remainder terms.
    simpa [Afd, AfdCLM] using
      toEuclideanLin_inv_toEuclideanCLM_apply (n := n) (A := Afd) hAfd (xk - xStar)
  calc
    xk - Matrix.toEuclideanLin (Afd⁻¹) (F xk) - xStar
        = (xk - xStar) - Matrix.toEuclideanLin (Afd⁻¹) (F xk) := by
            abel_nf
    _ = Matrix.toEuclideanLin (Afd⁻¹) (AfdCLM (xk - xStar)) -
          Matrix.toEuclideanLin (Afd⁻¹) (F xk) := by
            rw [hcancel]
    _ = Matrix.toEuclideanLin (Afd⁻¹) (AfdCLM (xk - xStar) - F xk) := by
          exact
            ((Matrix.toEuclideanLin (Afd⁻¹)).map_sub (AfdCLM (xk - xStar)) (F xk)).symm
    _ = Matrix.toEuclideanLin
          (Afd⁻¹)
          (F xStar - F xk - fderiv ℝ F xk (xStar - xk) +
            ((fderiv ℝ F xk) - AfdCLM) (xStar - xk)) := by
          have hflip :
              AfdCLM (xk - xStar) = -AfdCLM (xStar - xk) := by
            simp [AfdCLM, sub_eq_add_neg, map_add, map_neg]
          have hsub_apply :
              ((fderiv ℝ F xk) - AfdCLM) (xStar - xk) =
                fderiv ℝ F xk (xStar - xk) - AfdCLM (xStar - xk) := by
            rfl
          rw [hflip]
          rw [hsub_apply, h_root]
          abel_nf

/-- Helper for Chapter03 Theorem 3.4.4: a single finite-difference Newton step satisfies the
source-style factorized error recurrence on the working ball. -/
lemma finiteDifferenceNewton_oneStepError_le
    (F : Point → Point)
    (xStar xk xNext : Point)
    (r β hk : ℝ) (γ : NNReal)
    (hr : 0 < r)
    (h_root : F xStar = 0)
    (hx : xk ∈ Metric.ball xStar r)
    (hF : DifferentiableOn ℝ F (Metric.ball xStar r))
    (hLip : LipschitzOnWith γ (fderiv ℝ F) (Metric.ball xStar r))
    (hstep : ∀ j : Fin n, xk + hk • coordBasis j ∈ Metric.ball xStar r)
    (hhk : hk ≠ 0)
    (hAfd : IsUnit (finiteDifferenceJacobianMatrix coordBasis coordBasis F xk hk))
    (hAfdInv : ‖(finiteDifferenceJacobianMatrix coordBasis coordBasis F xk hk)⁻¹‖₂ ≤ 2 * β)
    (hNext :
      xNext =
        xk -
          Matrix.toEuclideanLin
            ((finiteDifferenceJacobianMatrix coordBasis coordBasis F xk hk)⁻¹)
            (F xk)) :
    ‖xNext - xStar‖ ≤
      (β * (γ : ℝ) * ‖xk - xStar‖ +
          β * Real.sqrt ((n * n : ℕ) : ℝ) * (γ : ℝ) * |hk|) *
        ‖xk - xStar‖ := by
  let Afd := finiteDifferenceJacobianMatrix coordBasis coordBasis F xk hk
  let Jx := jacobianMatrixAt coordBasis coordBasis F xk
  let d : Point := xStar - xk
  have hβ_nonneg : 0 ≤ β := by
    -- The inverse-norm estimate forces the source constant `β` to be nonnegative.
    have hAfdInv' : ‖(Afd⁻¹ : Matrix (Fin n) (Fin n) ℝ)‖₂ ≤ 2 * β := by
      simpa [Afd] using hAfdInv
    have hnonneg : 0 ≤ ‖(Afd⁻¹ : Matrix (Fin n) (Fin n) ℝ)‖₂ := by
      rw [matrixL2OperatorNorm_eq_rectangularEuclideanOpNorm]
      exact norm_nonneg _
    nlinarith
  have hxStar_mem : xStar ∈ Metric.ball xStar r := by
    simpa [Metric.mem_ball] using hr
  have hxd_eq : xk + d = xStar := by
    dsimp [d]
    abel_nf
  have hxd : xk + d ∈ Metric.ball xStar r := by
    -- The Taylor remainder is evaluated exactly at the root endpoint `xStar`.
    simpa [hxd_eq] using hxStar_mem
  have hTaylor :=
    quadraticRemainderBoundAlongSegment_of_fderiv_lipschitzOn
      (Metric.ball xStar r) F xk d γ
      Metric.isOpen_ball (convex_ball xStar r) hx hF hLip hxd
  have hRemainder :
      ‖F xStar - F xk - fderiv ℝ F xk d‖ ≤ ((γ : ℝ) / 2) * ‖d‖ ^ (2 : ℕ) := by
    -- Keep the first-order Taylor remainder in the exact source spelling `F xStar - F xk - J(xk)d`.
    simpa [hxd_eq, d, h_root] using hTaylor
  have hMismatchOp :
      ‖(fderiv ℝ F xk) -
          (Matrix.toEuclideanCLM :
            Matrix (Fin n) (Fin n) ℝ ≃⋆ₐ[ℝ] Point →L[ℝ] Point) Afd‖ =
        ‖Jx - Afd‖₂ := by
    have hCLMSub :
        (fderiv ℝ F xk) -
            (Matrix.toEuclideanCLM :
              Matrix (Fin n) (Fin n) ℝ ≃⋆ₐ[ℝ] Point →L[ℝ] Point) Afd =
          (Matrix.toEuclideanCLM :
              Matrix (Fin n) (Fin n) ℝ ≃⋆ₐ[ℝ] Point →L[ℝ] Point)
            (Jx - Afd) := by
      -- Compare both continuous linear maps pointwise in Euclidean coordinates.
      ext v i
      simpa [Jx] using
        congrArg (fun z : Point => z.ofLp i)
          (finiteDifferenceJacobianCLMSub_apply
            (n := n) (F := F) (xk := xk) (v := v) (Afd := Afd))
    -- Rewrite the CLM-side mismatch once to the matrix difference controlled by
    -- `finiteDifferenceJacobianL2Error_le`.
    calc
      ‖(fderiv ℝ F xk) -
          (Matrix.toEuclideanCLM :
            Matrix (Fin n) (Fin n) ℝ ≃⋆ₐ[ℝ] Point →L[ℝ] Point) Afd‖
          =
            ‖(Matrix.toEuclideanCLM :
                Matrix (Fin n) (Fin n) ℝ ≃⋆ₐ[ℝ] Point →L[ℝ] Point)
                (Jx - Afd)‖ := by
                rw [hCLMSub]
      _ = ‖Jx - Afd‖₂ := by
            simpa using Matrix.l2_opNorm_toEuclideanCLM (Jx - Afd)
  have hMismatchNorm :
      ‖((fderiv ℝ F xk) -
            (Matrix.toEuclideanCLM :
              Matrix (Fin n) (Fin n) ℝ ≃⋆ₐ[ℝ] Point →L[ℝ] Point) Afd) d‖ ≤
        (Real.sqrt ((n * n : ℕ) : ℝ) * (((γ : ℝ) / 2) * |hk|)) * ‖d‖ := by
    -- Combine the operator norm bound on the mismatch with the Chapter 3.4.1 finite-difference
    -- Jacobian error estimate.
    calc
      ‖((fderiv ℝ F xk) -
            (Matrix.toEuclideanCLM :
              Matrix (Fin n) (Fin n) ℝ ≃⋆ₐ[ℝ] Point →L[ℝ] Point) Afd) d‖
          ≤
            ‖(fderiv ℝ F xk) -
                (Matrix.toEuclideanCLM :
                  Matrix (Fin n) (Fin n) ℝ ≃⋆ₐ[ℝ] Point →L[ℝ] Point) Afd‖ * ‖d‖ := by
              exact ContinuousLinearMap.le_opNorm _ _
      _ = ‖Jx - Afd‖₂ * ‖d‖ := by
            rw [hMismatchOp]
      _ = ‖Afd - Jx‖₂ * ‖d‖ := by
            rw [l2MatrixNorm_sub_rev Jx Afd]
      _ ≤
          (Real.sqrt ((n * n : ℕ) : ℝ) * (((γ : ℝ) / 2) * |hk|)) * ‖d‖ := by
            gcongr
            simpa [Afd, Jx] using
              finiteDifferenceJacobianL2Error_le
                (F := F) (xStar := xStar) (x := xk) (r := r) (h := hk) (γ := γ)
                hx hF hLip hstep hhk
  have hAinvNorm :
      ‖(Matrix.toEuclideanCLM :
            Matrix (Fin n) (Fin n) ℝ ≃⋆ₐ[ℝ] Point →L[ℝ] Point) (Afd⁻¹)‖ ≤
        2 * β := by
    -- Move the inverse-norm estimate from the matrix `ℓ₂` norm to the CLM operator norm.
    have hAfdInv' : ‖(Afd⁻¹ : Matrix (Fin n) (Fin n) ℝ)‖₂ ≤ 2 * β := by
      simpa [Afd] using hAfdInv
    calc
      ‖(Matrix.toEuclideanCLM :
            Matrix (Fin n) (Fin n) ℝ ≃⋆ₐ[ℝ] Point →L[ℝ] Point) (Afd⁻¹)‖
          = ‖(Afd⁻¹ : Matrix (Fin n) (Fin n) ℝ)‖₂ := by
              simpa using Matrix.l2_opNorm_toEuclideanCLM (Afd⁻¹)
      _ ≤ 2 * β := hAfdInv'
  have hNormRev : ‖d‖ = ‖xk - xStar‖ := by
    simpa [d] using norm_sub_rev xStar xk
  calc
    ‖xNext - xStar‖
        =
          ‖Matrix.toEuclideanLin
              (Afd⁻¹)
              (F xStar - F xk - fderiv ℝ F xk d +
                ((fderiv ℝ F xk) -
                    (Matrix.toEuclideanCLM :
                      Matrix (Fin n) (Fin n) ℝ ≃⋆ₐ[ℝ] Point →L[ℝ] Point) Afd)
                  d)‖ := by
              rw [finiteDifferenceNewtonUpdateError_eq_inverseRemainder
                (n := n) (F := F) (xStar := xStar) (xk := xk) (xNext := xNext)
                (hk := hk) h_root hAfd hNext]
    _ = ‖((Matrix.toEuclideanCLM :
            Matrix (Fin n) (Fin n) ℝ ≃⋆ₐ[ℝ] Point →L[ℝ] Point) (Afd⁻¹))
            (F xStar - F xk - fderiv ℝ F xk d +
              ((fderiv ℝ F xk) -
                  (Matrix.toEuclideanCLM :
                    Matrix (Fin n) (Fin n) ℝ ≃⋆ₐ[ℝ] Point →L[ℝ] Point) Afd)
                d)‖ := by
          rfl
    _ ≤ ‖((Matrix.toEuclideanCLM :
            Matrix (Fin n) (Fin n) ℝ ≃⋆ₐ[ℝ] Point →L[ℝ] Point) (Afd⁻¹))‖ *
          ‖(F xStar - F xk - fderiv ℝ F xk d +
              ((fderiv ℝ F xk) -
                  (Matrix.toEuclideanCLM :
                    Matrix (Fin n) (Fin n) ℝ ≃⋆ₐ[ℝ] Point →L[ℝ] Point) Afd)
                d)‖ := by
          exact ContinuousLinearMap.le_opNorm _ _
    _ ≤ ‖((Matrix.toEuclideanCLM :
            Matrix (Fin n) (Fin n) ℝ ≃⋆ₐ[ℝ] Point →L[ℝ] Point) (Afd⁻¹))‖ *
          (‖F xStar - F xk - fderiv ℝ F xk d‖ +
            ‖(((fderiv ℝ F xk) -
                  (Matrix.toEuclideanCLM :
                    Matrix (Fin n) (Fin n) ℝ ≃⋆ₐ[ℝ] Point →L[ℝ] Point) Afd)
                d)‖) := by
          gcongr
          exact norm_add_le _ _
    _ ≤
        (2 * β) *
          (((γ : ℝ) / 2) * ‖d‖ ^ (2 : ℕ) +
            (Real.sqrt ((n * n : ℕ) : ℝ) * (((γ : ℝ) / 2) * |hk|)) * ‖d‖) := by
          have hsum_nonneg :
              0 ≤
                ((γ : ℝ) / 2) * ‖d‖ ^ (2 : ℕ) +
                  (Real.sqrt ((n * n : ℕ) : ℝ) * (((γ : ℝ) / 2) * |hk|)) * ‖d‖ := by
            positivity
          gcongr
    _ = (β * (γ : ℝ) * ‖d‖ +
          β * Real.sqrt ((n * n : ℕ) : ℝ) * (γ : ℝ) * |hk|) * ‖d‖ := by
          ring
    _ = (β * (γ : ℝ) * ‖xk - xStar‖ +
          β * Real.sqrt ((n * n : ℕ) : ℝ) * (γ : ℝ) * |hk|) * ‖xk - xStar‖ := by
          rw [hNormRev]

/-- Helper for Chapter03 Theorem 3.4.4: the global radius choice on `(ε,h)` implies the strict
per-stage Neumann smallness needed for the finite-difference Jacobian inverse bound. -/
lemma finiteDifferenceStageSmallness_lt_half
    (β : ℝ) (γ : NNReal) (xk xStar : Point) (ε h hk : ℝ)
    (hβ : 0 < β)
    (hx : ‖xk - xStar‖ ≤ ε)
    (hhk : |hk| ≤ h)
    (hh_pos : 0 < h)
    (hfactor :
      β * ((γ : ℝ) * ε + Real.sqrt ((n * n : ℕ) : ℝ) * (γ : ℝ) * h) ≤ 1 / 4) :
    β *
        ((γ : ℝ) * ‖xk - xStar‖ +
          Real.sqrt ((n * n : ℕ) : ℝ) * (((γ : ℝ) / 2) * |hk|)) <
      1 / 2 := by
  have hβ_nonneg : 0 ≤ β := le_of_lt hβ
  have hγ_nonneg : 0 ≤ (γ : ℝ) := by
    exact_mod_cast (show 0 ≤ γ from γ.2)
  have hh_nonneg : 0 ≤ h := le_of_lt hh_pos
  have hhalf_hk :
      ((γ : ℝ) / 2) * |hk| ≤ (γ : ℝ) * h := by
    nlinarith
  have hinner_le :
      (γ : ℝ) * ‖xk - xStar‖ +
          Real.sqrt ((n * n : ℕ) : ℝ) * (((γ : ℝ) / 2) * |hk|) ≤
        (γ : ℝ) * ε + Real.sqrt ((n * n : ℕ) : ℝ) * (γ : ℝ) * h := by
    have hfirst : (γ : ℝ) * ‖xk - xStar‖ ≤ (γ : ℝ) * ε := by
      gcongr
    have hsecond :
        Real.sqrt ((n * n : ℕ) : ℝ) * (((γ : ℝ) / 2) * |hk|) ≤
          Real.sqrt ((n * n : ℕ) : ℝ) * ((γ : ℝ) * h) := by
      exact mul_le_mul_of_nonneg_left hhalf_hk (Real.sqrt_nonneg _)
    linarith
  have hstage_le :
      β *
          ((γ : ℝ) * ‖xk - xStar‖ +
            Real.sqrt ((n * n : ℕ) : ℝ) * (((γ : ℝ) / 2) * |hk|)) ≤
        β * ((γ : ℝ) * ε + Real.sqrt ((n * n : ℕ) : ℝ) * (γ : ℝ) * h) := by
    exact mul_le_mul_of_nonneg_left hinner_le hβ_nonneg
  have hquarter_lt_half : (1 / 4 : ℝ) < 1 / 2 := by
    norm_num
  exact lt_of_le_of_lt (hstage_le.trans hfactor) hquarter_lt_half

/-- Helper for Chapter03 Theorem 3.4.4: a geometric one-step contraction of the error norms
forces convergence of the whole iterate sequence to the root. -/
theorem tendsto_of_error_contraction
    {x : ℕ → Point}
    {xStar : Point}
    {q : ℝ}
    (hq_nonneg : 0 ≤ q)
    (hq_lt_one : q < 1)
    (hcontraction :
      ∀ k : ℕ, ‖x (k + 1) - xStar‖ ≤ q * ‖x k - xStar‖) :
    Tendsto x atTop (𝓝 xStar) := by
  have hpow :
      ∀ k : ℕ, ‖x k - xStar‖ ≤ q ^ k * ‖x 0 - xStar‖ := by
    intro k
    induction k with
    | zero =>
        simp
    | succ k hk =>
        -- Iterate the one-step contraction into the usual geometric majorant.
        calc
          ‖x (k + 1) - xStar‖ ≤ q * ‖x k - xStar‖ := hcontraction k
          _ ≤ q * (q ^ k * ‖x 0 - xStar‖) := by
                exact mul_le_mul_of_nonneg_left hk hq_nonneg
          _ = q ^ (k + 1) * ‖x 0 - xStar‖ := by
                rw [pow_succ']
                ring
  have hmajorant :
      Tendsto (fun k : ℕ ↦ q ^ k * ‖x 0 - xStar‖) atTop (𝓝 0) := by
    simpa [zero_mul] using
      (tendsto_pow_atTop_nhds_zero_of_lt_one hq_nonneg hq_lt_one).mul_const
        ‖x 0 - xStar‖
  have herror :
      Tendsto (fun k : ℕ ↦ x k - xStar) atTop (𝓝 0) := by
    refine squeeze_zero_norm ?_ hmajorant
    intro k
    exact hpow k
  simpa [sub_eq_add_neg, add_assoc, add_left_comm, add_comm] using
    herror.const_add xStar

/-- Helper for Chapter03 Theorem 3.4.4: once convergence to `xStar` is known, a uniform
quadratic one-step bound packages directly into `HasQuadraticConvergenceTo`. -/
theorem hasQuadraticConvergenceTo_of_tendsto_and_bound
    {x : ℕ → Point}
    {xStar : Point}
    {C : ℝ}
    (hTendsto : Tendsto x atTop (𝓝 xStar))
    (_hC_nonneg : 0 ≤ C)
    (hBound : ∀ k : ℕ, ‖x (k + 1) - xStar‖ ≤ C * ‖x k - xStar‖ ^ (2 : ℕ)) :
    HasQuadraticConvergenceTo x xStar := by
  refine ⟨hTendsto, ?_⟩
  -- Record the pointwise recurrence once as an eventual `O(‖x_k - xStar‖²)` bound.
  refine Asymptotics.IsBigO.of_bound C ?_
  refine Filter.Eventually.of_forall ?_
  intro k
  simpa using hBound k

/-- Helper for Chapter03 Theorem 3.4.4: if the one-step error factor tends to `0`, then the
error sequence is little-o of the previous error sequence, hence the iterates converge
superlinearly. -/
theorem hasSuperlinearConvergenceTo_of_tendsto_and_factor
    {x : ℕ → Point}
    {xStar : Point}
    {a : ℕ → ℝ}
    (hTendsto : Tendsto x atTop (𝓝 xStar))
    (haTendsto : Tendsto a atTop (𝓝 0))
    (haNonneg : ∀ k : ℕ, 0 ≤ a k)
    (hBound : ∀ k : ℕ, ‖x (k + 1) - xStar‖ ≤ a k * ‖x k - xStar‖) :
    HasSuperlinearConvergenceTo x xStar := by
  refine ⟨hTendsto, Asymptotics.IsLittleO.of_bound ?_⟩
  intro c hc
  have haSmallAbs : ∀ᶠ k in atTop, |a k| < c := by
    -- Send the scalar factor into the `c`-ball around `0`, then drop the absolute value using
    -- the recorded nonnegativity of `a k`.
    simpa [Metric.mem_ball, dist_eq_norm, Real.norm_eq_abs] using
      haTendsto.eventually (Metric.ball_mem_nhds (0 : ℝ) hc)
  filter_upwards [haSmallAbs] with k hk
  have hak : a k ≤ c := by
    have hak_lt : a k < c := by
      simpa [abs_of_nonneg (haNonneg k)] using hk
    exact le_of_lt hak_lt
  have hstep :
      ‖x (k + 1) - xStar‖ ≤ c * ‖x k - xStar‖ := by
    calc
      ‖x (k + 1) - xStar‖ ≤ a k * ‖x k - xStar‖ := hBound k
      _ ≤ c * ‖x k - xStar‖ := by
            exact mul_le_mul_of_nonneg_right hak (norm_nonneg _)
  simpa [Real.norm_eq_abs, abs_of_nonneg (norm_nonneg _),
    abs_of_nonneg (mul_nonneg hc.le (norm_nonneg _))] using hstep

/-- Helper for Chapter03 Theorem 3.4.4: a factorized one-step estimate plus step control
`|hSeq k| ≤ c * ‖x k - xStar‖` packages directly into quadratic convergence. -/
theorem hasQuadraticConvergenceTo_of_tendsto_and_stepFactor
    {x : ℕ → Point}
    {xStar : Point}
    {hSeq : ℕ → ℝ}
    {A B c : ℝ}
    (hTendsto : Tendsto x atTop (𝓝 xStar))
    (hA_nonneg : 0 ≤ A)
    (hB_nonneg : 0 ≤ B)
    (hc_nonneg : 0 ≤ c)
    (hBound :
      ∀ k : ℕ, ‖x (k + 1) - xStar‖ ≤
        (A * ‖x k - xStar‖ + B * |hSeq k|) * ‖x k - xStar‖)
    (hStep : ∀ k : ℕ, |hSeq k| ≤ c * ‖x k - xStar‖) :
    HasQuadraticConvergenceTo x xStar := by
  let C : ℝ := A + B * c
  have hC_nonneg : 0 ≤ C := by
    dsimp [C]
    nlinarith
  refine hasQuadraticConvergenceTo_of_tendsto_and_bound hTendsto hC_nonneg ?_
  intro k
  have hinner :
      A * ‖x k - xStar‖ + B * |hSeq k| ≤ C * ‖x k - xStar‖ := by
    calc
      A * ‖x k - xStar‖ + B * |hSeq k|
          ≤ A * ‖x k - xStar‖ + B * (c * ‖x k - xStar‖) := by
              gcongr
              exact hStep k
      _ = C * ‖x k - xStar‖ := by
            dsimp [C]
            ring
  calc
    ‖x (k + 1) - xStar‖
        ≤ (A * ‖x k - xStar‖ + B * |hSeq k|) * ‖x k - xStar‖ := hBound k
    _ ≤ (C * ‖x k - xStar‖) * ‖x k - xStar‖ := by
          gcongr
    _ = C * ‖x k - xStar‖ ^ (2 : ℕ) := by
          rw [pow_two]
          ring

/-- Helper for Chapter03 Theorem 3.4.4: for the canonical recursive finite-difference Newton
orbit, a sufficiently small initial ball and step bound yield invariant-ball control, stagewise
Jacobian invertibility, and a uniform one-step contraction. -/
lemma finiteDifferenceNewton_smallBallContraction
    (F : Point → Point)
    (xStar : Point)
    (r β ε h : ℝ) (γ : NNReal)
    (hr : 0 < r)
    (hβ : 0 < β)
    (hε_pos : 0 < ε)
    (hh_pos : 0 < h)
    (hεh_lt_r : ε + h < r)
    (hfactor : β * ((γ : ℝ) * ε + Real.sqrt ((n * n : ℕ) : ℝ) * (γ : ℝ) * h) ≤ 1 / 4)
    (h_root : F xStar = 0)
    (h_invertible : (fderiv ℝ F xStar).IsInvertible)
    (h_inverse_bound : ‖(fderiv ℝ F xStar).inverse‖ ≤ β)
    (hF : DifferentiableOn ℝ F (Metric.ball xStar r))
    (hLip : LipschitzOnWith γ (fderiv ℝ F) (Metric.ball xStar r))
    {x0 : Point} {hSeq : ℕ → ℝ}
    (hx0 : ‖x0 - xStar‖ < ε)
    (hsteps : HasAdmissibleFiniteDifferenceSteps hSeq h) :
    let x := finiteDifferenceNewtonIterates F hSeq x0
    ∀ k : ℕ,
      ‖x k - xStar‖ ≤ ε ∧
      x k ∈ Metric.ball xStar ε ∧
      (∀ j : Fin n, x k + hSeq k • coordBasis j ∈ Metric.ball xStar r) ∧
      IsUnit (finiteDifferenceJacobianMatrix coordBasis coordBasis F (x k) (hSeq k)) ∧
      ‖(finiteDifferenceJacobianMatrix coordBasis coordBasis F (x k) (hSeq k))⁻¹‖₂ ≤ 2 * β ∧
      ‖x (k + 1) - xStar‖ ≤ (1 / 2 : ℝ) * ‖x k - xStar‖ := by
  dsimp
  set x : ℕ → Point := finiteDifferenceNewtonIterates F hSeq x0
  have hGenerated : IsFiniteDifferenceNewtonGeneratedSequence F x hSeq x0 := by
    -- Use the primitive-recursive finite-difference Newton orbit as the canonical generated
    -- sequence throughout the induction.
    simpa [x] using finiteDifferenceNewtonIterates_generated F hSeq x0
  have hβ_nonneg : 0 ≤ β := le_of_lt hβ
  have hε_lt_r : ε < r := by
    nlinarith
  have hcoeff_quarter :
      ∀ k : ℕ,
        ‖x k - xStar‖ ≤ ε →
          β * (γ : ℝ) * ‖x k - xStar‖ +
              β * Real.sqrt ((n * n : ℕ) : ℝ) * (γ : ℝ) * |hSeq k| ≤
            1 / 4 := by
    intro k hkNorm
    have hinner :
        (γ : ℝ) * ‖x k - xStar‖ +
            Real.sqrt ((n * n : ℕ) : ℝ) * (γ : ℝ) * |hSeq k| ≤
          (γ : ℝ) * ε + Real.sqrt ((n * n : ℕ) : ℝ) * (γ : ℝ) * h := by
      gcongr
      exact HasAdmissibleFiniteDifferenceSteps.le hsteps k
    calc
      β * (γ : ℝ) * ‖x k - xStar‖ +
          β * Real.sqrt ((n * n : ℕ) : ℝ) * (γ : ℝ) * |hSeq k|
          = β *
              ((γ : ℝ) * ‖x k - xStar‖ +
                Real.sqrt ((n * n : ℕ) : ℝ) * (γ : ℝ) * |hSeq k|) := by
              ring
      _ ≤ β * ((γ : ℝ) * ε + Real.sqrt ((n * n : ℕ) : ℝ) * (γ : ℝ) * h) := by
            gcongr
      _ ≤ 1 / 4 := hfactor
  intro k
  induction k with
  | zero =>
      have hxzero : x 0 = x0 := hGenerated.start_eq
      have hx0_le : ‖x 0 - xStar‖ ≤ ε := by
        rw [hxzero]
        exact le_of_lt hx0
      have hx0_ball : x 0 ∈ Metric.ball xStar ε := by
        rw [hxzero]
        simpa [Metric.mem_ball, dist_eq_norm] using hx0
      have hforward0 :
          ∀ j : Fin n, x 0 + hSeq 0 • coordBasis j ∈ Metric.ball xStar r := by
        intro j
        -- The initial error and the global step bound keep every forward sample inside the
        -- working `r`-ball.
        rw [hxzero]
        exact
          forwardSample_mem_ball_of_error_le
            x0 xStar (hSeq 0) ε h r j hx0_le
            (HasAdmissibleFiniteDifferenceSteps.le hsteps 0) hεh_lt_r
      have hx0_r : x 0 ∈ Metric.ball xStar r :=
        Metric.ball_subset_ball (le_of_lt hε_lt_r) hx0_ball
      have hh0 : hSeq 0 ≠ 0 := by
        exact abs_ne_zero.mp (ne_of_gt (HasAdmissibleFiniteDifferenceSteps.pos hsteps 0))
      have hsmall0 :
          β *
              ((γ : ℝ) * ‖x 0 - xStar‖ +
                Real.sqrt ((n * n : ℕ) : ℝ) * (((γ : ℝ) / 2) * |hSeq 0|)) <
            1 / 2 := by
        -- Route correction: use the dedicated scalar bridge instead of replaying `nlinarith`
        -- against the global `(ε,h)` choice at each stage.
        exact
          finiteDifferenceStageSmallness_lt_half
            (n := n) (β := β) (γ := γ) (xk := x 0) (xStar := xStar)
            (ε := ε) (h := h) (hk := hSeq 0)
            hβ hx0_le (HasAdmissibleFiniteDifferenceSteps.le hsteps 0) hh_pos hfactor
      have hAfd0 :
          IsUnit (finiteDifferenceJacobianMatrix coordBasis coordBasis F (x 0) (hSeq 0)) ∧
            ‖(finiteDifferenceJacobianMatrix coordBasis coordBasis F (x 0) (hSeq 0))⁻¹‖₂ ≤
              2 * β := by
        -- The stagewise Neumann bound makes the initial finite-difference Jacobian invertible.
        exact
          finiteDifferenceJacobian_isUnit_and_inv_l2_le
            (n := n) (F := F) (xStar := xStar) (x := x 0) (r := r) (β := β)
            (hk := hSeq 0) (γ := γ)
            hr hβ h_invertible h_inverse_bound hx0_r hF hLip hforward0 hh0 hsmall0
      have hNext0 :
          x 1 =
            x 0 -
              Matrix.toEuclideanLin
                ((finiteDifferenceJacobianMatrix coordBasis coordBasis F (x 0) (hSeq 0))⁻¹)
                (F (x 0)) := by
        simpa [x] using hGenerated.nextEq 0
      have honeStep0 :
          ‖x 1 - xStar‖ ≤
            (β * (γ : ℝ) * ‖x 0 - xStar‖ +
                β * Real.sqrt ((n * n : ℕ) : ℝ) * (γ : ℝ) * |hSeq 0|) *
              ‖x 0 - xStar‖ := by
        -- Invoke the stabilized one-step source estimate at the initial iterate.
        exact
          finiteDifferenceNewton_oneStepError_le
            (n := n) (F := F) (xStar := xStar) (xk := x 0) (xNext := x 1)
            (r := r) (β := β) (hk := hSeq 0) (γ := γ)
            hr h_root hx0_r hF hLip hforward0 hh0 hAfd0.1 hAfd0.2 hNext0
      have hcontract0 :
          ‖x 1 - xStar‖ ≤ (1 / 2 : ℝ) * ‖x 0 - xStar‖ := by
        calc
          ‖x 1 - xStar‖
              ≤
                (β * (γ : ℝ) * ‖x 0 - xStar‖ +
                    β * Real.sqrt ((n * n : ℕ) : ℝ) * (γ : ℝ) * |hSeq 0|) *
                  ‖x 0 - xStar‖ := honeStep0
          _ ≤ (1 / 4 : ℝ) * ‖x 0 - xStar‖ := by
                exact mul_le_mul_of_nonneg_right (hcoeff_quarter 0 hx0_le) (norm_nonneg _)
          _ ≤ (1 / 2 : ℝ) * ‖x 0 - xStar‖ := by
                nlinarith [norm_nonneg (x 0 - xStar)]
      exact ⟨hx0_le, hx0_ball, hforward0, hAfd0.1, hAfd0.2, hcontract0⟩
  | succ k hk =>
      rcases hk with ⟨hkNorm, hkBall, hkForward, hkUnit, hkInv, hkContract⟩
      have hkNext_lt : ‖x (k + 1) - xStar‖ < ε := by
        have hkBallNorm : ‖x k - xStar‖ < ε := by
          simpa [Metric.mem_ball, dist_eq_norm] using hkBall
        -- The already proved contraction keeps the next iterate strictly inside the same `ε`-ball.
        nlinarith [hkContract, hkBallNorm, hε_pos]
      have hkNext_le : ‖x (k + 1) - xStar‖ ≤ ε := le_of_lt hkNext_lt
      have hkNext_ball : x (k + 1) ∈ Metric.ball xStar ε := by
        simpa [Metric.mem_ball, dist_eq_norm] using hkNext_lt
      have hkNext_forward :
          ∀ j : Fin n, x (k + 1) + hSeq (k + 1) • coordBasis j ∈ Metric.ball xStar r := by
        intro j
        -- Once the next iterate is back in the small ball, every forward sample stays in the
        -- larger working ball by the same radius estimate.
        exact
          forwardSample_mem_ball_of_error_le
            (x (k + 1)) xStar (hSeq (k + 1)) ε h r j
            hkNext_le (HasAdmissibleFiniteDifferenceSteps.le hsteps (k + 1)) hεh_lt_r
      have hkNext_r : x (k + 1) ∈ Metric.ball xStar r :=
        Metric.ball_subset_ball (le_of_lt hε_lt_r) hkNext_ball
      have hhkNext : hSeq (k + 1) ≠ 0 := by
        exact abs_ne_zero.mp (ne_of_gt (HasAdmissibleFiniteDifferenceSteps.pos hsteps (k + 1)))
      have hsmallNext :
          β *
              ((γ : ℝ) * ‖x (k + 1) - xStar‖ +
                Real.sqrt ((n * n : ℕ) : ℝ) * (((γ : ℝ) / 2) * |hSeq (k + 1)|)) <
            1 / 2 := by
        exact
          finiteDifferenceStageSmallness_lt_half
            (n := n) (β := β) (γ := γ) (xk := x (k + 1)) (xStar := xStar)
            (ε := ε) (h := h) (hk := hSeq (k + 1))
            hβ hkNext_le (HasAdmissibleFiniteDifferenceSteps.le hsteps (k + 1)) hh_pos hfactor
      have hAfdNext :
          IsUnit
              (finiteDifferenceJacobianMatrix coordBasis coordBasis F (x (k + 1))
                (hSeq (k + 1))) ∧
            ‖(finiteDifferenceJacobianMatrix coordBasis coordBasis F (x (k + 1))
                (hSeq (k + 1)))⁻¹‖₂ ≤
              2 * β := by
        -- Reapply the Neumann perturbation argument at the next iterate.
        exact
          finiteDifferenceJacobian_isUnit_and_inv_l2_le
            (n := n) (F := F) (xStar := xStar) (x := x (k + 1)) (r := r) (β := β)
            (hk := hSeq (k + 1)) (γ := γ)
            hr hβ h_invertible h_inverse_bound hkNext_r hF hLip hkNext_forward hhkNext
            hsmallNext
      have hNextSucc :
          x (k + 2) =
            x (k + 1) -
              Matrix.toEuclideanLin
                ((finiteDifferenceJacobianMatrix coordBasis coordBasis F (x (k + 1))
                    (hSeq (k + 1)))⁻¹)
                (F (x (k + 1))) := by
        simpa [x, Nat.succ_eq_add_one, add_assoc] using hGenerated.nextEq (k + 1)
      have honeStepSucc :
          ‖x (k + 2) - xStar‖ ≤
            (β * (γ : ℝ) * ‖x (k + 1) - xStar‖ +
                β * Real.sqrt ((n * n : ℕ) : ℝ) * (γ : ℝ) * |hSeq (k + 1)|) *
              ‖x (k + 1) - xStar‖ := by
        -- The one-step recurrence is now available at every stage in the induction.
        exact
          finiteDifferenceNewton_oneStepError_le
            (n := n) (F := F) (xStar := xStar) (xk := x (k + 1)) (xNext := x (k + 2))
            (r := r) (β := β) (hk := hSeq (k + 1)) (γ := γ)
            hr h_root hkNext_r hF hLip hkNext_forward hhkNext hAfdNext.1 hAfdNext.2 hNextSucc
      have hcontractSucc :
          ‖x (k + 2) - xStar‖ ≤ (1 / 2 : ℝ) * ‖x (k + 1) - xStar‖ := by
        calc
          ‖x (k + 2) - xStar‖
              ≤
                (β * (γ : ℝ) * ‖x (k + 1) - xStar‖ +
                    β * Real.sqrt ((n * n : ℕ) : ℝ) * (γ : ℝ) * |hSeq (k + 1)|) *
                  ‖x (k + 1) - xStar‖ := honeStepSucc
          _ ≤ (1 / 4 : ℝ) * ‖x (k + 1) - xStar‖ := by
                exact
                  mul_le_mul_of_nonneg_right
                    (hcoeff_quarter (k + 1) hkNext_le) (norm_nonneg _)
          _ ≤ (1 / 2 : ℝ) * ‖x (k + 1) - xStar‖ := by
                nlinarith [norm_nonneg (x (k + 1) - xStar)]
      exact ⟨hkNext_le, hkNext_ball, hkNext_forward, hAfdNext.1, hAfdNext.2, hcontractSucc⟩

/-- Helper for Chapter03 Theorem 3.4.4: the canonical finite-difference Newton orbit inherits the
source one-step error recurrence once the small-ball induction has already produced the stagewise
ball membership and Jacobian inverse bounds. -/
lemma finiteDifferenceNewtonIterates_oneStepError_le
    (F : Point → Point)
    (xStar : Point)
    (r β ε h : ℝ) (γ : NNReal)
    (hr : 0 < r)
    (hβ : 0 < β)
    (hε_pos : 0 < ε)
    (hh_pos : 0 < h)
    (hεh_lt_r : ε + h < r)
    (hfactor : β * ((γ : ℝ) * ε + Real.sqrt ((n * n : ℕ) : ℝ) * (γ : ℝ) * h) ≤ 1 / 4)
    (h_root : F xStar = 0)
    (h_invertible : (fderiv ℝ F xStar).IsInvertible)
    (h_inverse_bound : ‖(fderiv ℝ F xStar).inverse‖ ≤ β)
    (hF : DifferentiableOn ℝ F (Metric.ball xStar r))
    (hLip : LipschitzOnWith γ (fderiv ℝ F) (Metric.ball xStar r))
    {x0 : Point} {hSeq : ℕ → ℝ}
    (hx0 : ‖x0 - xStar‖ < ε)
    (hsteps : HasAdmissibleFiniteDifferenceSteps hSeq h) :
    let x := finiteDifferenceNewtonIterates F hSeq x0
    ∀ k : ℕ,
      ‖x (k + 1) - xStar‖ ≤
        (β * (γ : ℝ) * ‖x k - xStar‖ +
            β * Real.sqrt ((n * n : ℕ) : ℝ) * (γ : ℝ) * |hSeq k|) *
          ‖x k - xStar‖ := by
  dsimp
  set x : ℕ → Point := finiteDifferenceNewtonIterates F hSeq x0
  have hGenerated : IsFiniteDifferenceNewtonGeneratedSequence F x hSeq x0 := by
    -- Freeze the primitive-recursive orbit once so every later stage can reuse its update rule.
    simpa [x] using finiteDifferenceNewtonIterates_generated F hSeq x0
  have hε_lt_r : ε < r := by
    nlinarith
  have hSmall :=
    finiteDifferenceNewton_smallBallContraction
      (n := n) (F := F) (xStar := xStar) (r := r) (β := β) (ε := ε) (h := h)
      (γ := γ) hr hβ hε_pos hh_pos hεh_lt_r hfactor h_root h_invertible
      h_inverse_bound hF hLip hx0 hsteps
  intro k
  rcases hSmall k with ⟨_, hkBall, hkForward, hkUnit, hkInv, _⟩
  have hk_r : x k ∈ Metric.ball xStar r :=
    Metric.ball_subset_ball (le_of_lt hε_lt_r) hkBall
  have hhk : hSeq k ≠ 0 := by
    exact abs_ne_zero.mp (ne_of_gt (HasAdmissibleFiniteDifferenceSteps.pos hsteps k))
  have hNext :
      x (k + 1) =
        x k -
          Matrix.toEuclideanLin
            ((finiteDifferenceJacobianMatrix coordBasis coordBasis F (x k) (hSeq k))⁻¹)
            (F (x k)) := by
    -- Reuse the canonical recursive update instead of rebuilding the iterate equation locally.
    simpa [x] using hGenerated.nextEq k
  -- Apply the stabilized one-step estimate at stage `k` using the already established orbit data.
  exact
    finiteDifferenceNewton_oneStepError_le
      (n := n) (F := F) (xStar := xStar) (xk := x k) (xNext := x (k + 1))
      (r := r) (β := β) (hk := hSeq k) (γ := γ)
      hr h_root hk_r hF hLip hkForward hhk hkUnit hkInv hNext

/-- Chapter03 Theorem 3.4.4: if `F : ℝⁿ → ℝⁿ` is continuously differentiable on an open convex
set `D`, `Metric.ball xStar r ⊆ D`, `F xStar = 0`, `fderiv ℝ F xStar` is invertible with
`‖(fderiv ℝ F xStar).inverse‖ ≤ β`, and `fderiv ℝ F` is `γ`-Lipschitz on `Metric.ball xStar r`,
then there exist `ε > 0` and `h > 0` such that for every `x0 ∈ Metric.ball xStar ε` and every
step sequence `hSeq` with `0 < |hSeq k| ≤ h`, there exists a sequence `x` generated by
`(3.4.18)`-`(3.4.19)` which is well defined on `D`, converges linearly to `xStar`, becomes
superlinear when `hSeq ⟶ 0`, and becomes quadratic under `(3.4.20)` or `(3.4.21)`. -/
theorem finiteDifferenceNewton_existsLocalConvergence
    (F : Point → Point) (D : Set Point) (xStar : Point) (r β : ℝ) (γ : NNReal)
    (hD_open : IsOpen D) (hD_convex : Convex ℝ D)
    (hr : 0 < r) (hβ : 0 < β)
    (h_ball : Metric.ball xStar r ⊆ D)
    (h_contDiff : ContDiffOn ℝ 1 F D)
    (h_root : F xStar = 0)
    (h_invertible : (fderiv ℝ F xStar).IsInvertible)
    (h_inverse_bound : ‖(fderiv ℝ F xStar).inverse‖ ≤ β)
    (h_lipschitz : LipschitzOnWith γ (fun x ↦ fderiv ℝ F x) (Metric.ball xStar r)) :
    ∃ ε > 0, ∃ h > 0, ∀ x0 : Point, ‖x0 - xStar‖ < ε →
      ∀ hSeq : ℕ → ℝ, HasAdmissibleFiniteDifferenceSteps hSeq h →
        ∃ x : ℕ → Point, FiniteDifferenceNewtonLocalConvergence F D x hSeq x0 xStar := by
  let _ : IsOpen D := hD_open
  let _ : Convex ℝ D := hD_convex
  have hxStar_ball : xStar ∈ Metric.ball xStar r := by
    -- The root is always inside the working `r`-ball centered at itself.
    simpa [Metric.mem_ball, dist_eq_norm] using hr
  have hFball : ContDiffOn ℝ 1 F (Metric.ball xStar r) := h_contDiff.mono h_ball
  have hF : DifferentiableOn ℝ F (Metric.ball xStar r) := hFball.differentiableOn_one
  rcases norm_image_sub_bounds_near_of_fderiv_isInvertible
      (D := Metric.ball xStar r) (F := F) (x := xStar) (γ := γ)
      Metric.isOpen_ball (convex_ball xStar r) hxStar_ball hFball h_lipschitz h_invertible with
    ⟨εBi, αBi, βBi, hBi⟩
  let εRes : ℝ := min εBi (r / 2)
  have hεRes_pos : 0 < εRes := by
    -- Shrink the Chapter 1 residual-control radius so that it still sits inside the working ball.
    dsimp [εRes]
    exact lt_min hBi.eps_pos (half_pos hr)
  have hεRes_lt_r : εRes < r := by
    have hεRes_le : εRes ≤ r / 2 := by
      dsimp [εRes]
      exact min_le_right _ _
    nlinarith
  let A : ℝ := β * (γ : ℝ)
  let B : ℝ := β * Real.sqrt ((n * n : ℕ) : ℝ) * (γ : ℝ)
  let K : ℝ := A + B
  let δ : ℝ := min (r / 4) (min εRes (1 / (4 * (K + 1))))
  have hδ_pos : 0 < δ := by
    -- One small radius simultaneously satisfies the contraction and residual-control constraints.
    dsimp [δ]
    refine lt_min (by positivity) ?_
    refine lt_min hεRes_pos ?_
    positivity
  have hδ_le_r_quarter : δ ≤ r / 4 := by
    dsimp [δ]
    exact min_le_left _ _
  have hδ_le_εRes : δ ≤ εRes := by
    dsimp [δ]
    exact le_trans (min_le_right _ _) (min_le_left _ _)
  have hδ_le_small : δ ≤ 1 / (4 * (K + 1)) := by
    dsimp [δ]
    exact le_trans (min_le_right _ _) (min_le_right _ _)
  have hK_nonneg : 0 ≤ K := by
    -- Both coefficients in the source recurrence are nonnegative.
    dsimp [K, A, B]
    positivity
  have hK_one_pos : 0 < K + 1 := by
    nlinarith
  have hδ_lt_r : δ < r := by
    nlinarith
  have hδδ_lt_r : δ + δ < r := by
    nlinarith
  have hfactor :
      β * ((γ : ℝ) * δ + Real.sqrt ((n * n : ℕ) : ℝ) * (γ : ℝ) * δ) ≤ 1 / 4 := by
    -- Route correction: isolate the scalar radius arithmetic once, instead of mixing it into the
    -- convergence packaging below.
    calc
      β * ((γ : ℝ) * δ + Real.sqrt ((n * n : ℕ) : ℝ) * (γ : ℝ) * δ)
          = K * δ := by
              dsimp [K, A, B]
              ring
      _ ≤ K * (1 / (4 * (K + 1))) := by
            exact mul_le_mul_of_nonneg_left hδ_le_small hK_nonneg
      _ ≤ 1 / 4 := by
            have hK_le : K ≤ K + 1 := by
              linarith
            have hratio : K * (1 / (K + 1)) ≤ 1 := by
              have hmul :=
                mul_le_mul_of_nonneg_right hK_le (by positivity : 0 ≤ 1 / (K + 1))
              simpa [hK_one_pos.ne', mul_assoc, mul_left_comm, mul_comm] using hmul
            calc
              K * (1 / (4 * (K + 1))) = (1 / 4 : ℝ) * (K * (1 / (K + 1))) := by
                field_simp [hK_one_pos.ne']
              _ ≤ (1 / 4 : ℝ) * 1 := by
                    exact mul_le_mul_of_nonneg_left hratio (by positivity)
              _ = 1 / 4 := by ring
  refine ⟨δ, hδ_pos, δ, hδ_pos, ?_⟩
  intro x0 hx0 hSeq hsteps
  let x : ℕ → Point := finiteDifferenceNewtonIterates F hSeq x0
  have hGenerated : IsFiniteDifferenceNewtonGeneratedSequence F x hSeq x0 := by
    -- Use the canonical primitive-recursive orbit as the unique witness sequence.
    simpa [x] using finiteDifferenceNewtonIterates_generated F hSeq x0
  have hSmall :=
    finiteDifferenceNewton_smallBallContraction
      (n := n) (F := F) (xStar := xStar) (r := r) (β := β) (ε := δ) (h := δ)
      (γ := γ) hr hβ hδ_pos hδ_pos hδδ_lt_r hfactor h_root h_invertible
      h_inverse_bound hF h_lipschitz hx0 hsteps
  have hRec :=
    finiteDifferenceNewtonIterates_oneStepError_le
      (n := n) (F := F) (xStar := xStar) (r := r) (β := β) (ε := δ) (h := δ)
      (γ := γ) hr hβ hδ_pos hδ_pos hδδ_lt_r hfactor h_root h_invertible
      h_inverse_bound hF h_lipschitz hx0 hsteps
  have hMemDomain : ∀ k : ℕ, x k ∈ D := by
    intro k
    rcases hSmall k with ⟨_, hkBall, _, _, _, _⟩
    exact h_ball (Metric.ball_subset_ball (le_of_lt hδ_lt_r) hkBall)
  have hStepMemDomain : ∀ k : ℕ, ∀ j : Fin n, x k + hSeq k • coordBasis j ∈ D := by
    intro k j
    rcases hSmall k with ⟨_, _, hkForward, _, _, _⟩
    exact h_ball (hkForward j)
  have hJacobianUnit :
      ∀ k : ℕ, IsUnit (finiteDifferenceJacobianMatrix coordBasis coordBasis F (x k) (hSeq k)) := by
    intro k
    rcases hSmall k with ⟨_, _, _, hkUnit, _, _⟩
    exact hkUnit
  have hContraction :
      ∀ k : ℕ, ‖x (k + 1) - xStar‖ ≤ (1 / 2 : ℝ) * ‖x k - xStar‖ := by
    intro k
    rcases hSmall k with ⟨_, _, _, _, _, hkContract⟩
    exact hkContract
  have hTendsto : Tendsto x atTop (𝓝 xStar) := by
    -- Linear convergence already follows from the uniform `1/2` contraction of the error norms.
    refine tendsto_of_error_contraction (q := (1 / 2 : ℝ)) (by norm_num) (by norm_num) ?_
    exact hContraction
  have hErrorTendsto : Tendsto (fun k : ℕ ↦ ‖x k - xStar‖) atTop (𝓝 0) := by
    -- Convergence of the orbit to `xStar` turns into convergence of the error norms to `0`.
    have hSubAtStar :
        Tendsto (fun k : ℕ ↦ x k - xStar) atTop (𝓝 (xStar - xStar)) := by
      exact hTendsto.sub tendsto_const_nhds
    have hSub : Tendsto (fun k : ℕ ↦ x k - xStar) atTop (𝓝 0) := by
      simpa using hSubAtStar
    have hNormComp :
        Tendsto ((fun a : Point ↦ ‖a‖) ∘ fun k : ℕ ↦ x k - xStar) atTop (𝓝 ‖(0 : Point)‖) :=
      continuous_norm.continuousAt.tendsto.comp hSub
    have hNormEq :
        (fun k : ℕ ↦ ‖x k - xStar‖) = ((fun a : Point ↦ ‖a‖) ∘ fun k : ℕ ↦ x k - xStar) := by
      ext k
      rfl
    simpa [hNormEq] using hNormComp
  have hA_nonneg : 0 ≤ A := by
    dsimp [A]
    positivity
  have hB_nonneg : 0 ≤ B := by
    dsimp [B]
    positivity
  have hRecAB :
      ∀ k : ℕ, ‖x (k + 1) - xStar‖ ≤
        (A * ‖x k - xStar‖ + B * |hSeq k|) * ‖x k - xStar‖ := by
    intro k
    simpa [A, B, mul_assoc, mul_left_comm, mul_comm] using hRec k
  refine ⟨x, {
    generated := hGenerated
    mem_domain := hMemDomain
    step_mem_domain := hStepMemDomain
    jacobian_isUnit := hJacobianUnit
    tendsto := hTendsto
    contraction := ?_
    superlinear_of_step_tendsto_zero := ?_
    quadratic_of_step_or_residual_control := ?_ }⟩
  · -- Record the explicit `1/2` contraction for the linear-convergence field.
    refine ⟨(1 / 2 : ℝ), by norm_num, hContraction⟩
  · intro hstepsZero
    let a : ℕ → ℝ := fun k ↦ A * ‖x k - xStar‖ + B * |hSeq k|
    have haNonneg : ∀ k : ℕ, 0 ≤ a k := by
      intro k
      dsimp [a]
      positivity
    have haTendsto : Tendsto a atTop (𝓝 0) := by
      -- The superlinear factor is the sum of an error term and a step-size term, both tending to
      -- `0`.
      have hStepAbs : Tendsto (fun k : ℕ ↦ |hSeq k|) atTop (𝓝 0) := by
        have hAbsComp : Tendsto (abs ∘ hSeq) atTop (𝓝 |(0 : ℝ)|) :=
          continuous_abs.continuousAt.tendsto.comp hstepsZero
        have hAbsEq : (fun k : ℕ ↦ |hSeq k|) = abs ∘ hSeq := by
          ext k
          rfl
        simpa [hAbsEq] using hAbsComp
      have hTerm1AtZero :
          Tendsto (fun k : ℕ ↦ A * ‖x k - xStar‖) atTop (𝓝 (A * 0)) :=
        tendsto_const_nhds.mul hErrorTendsto
      have hTerm1 : Tendsto (fun k : ℕ ↦ A * ‖x k - xStar‖) atTop (𝓝 0) := by
        simpa using hTerm1AtZero
      have hTerm2AtZero :
          Tendsto (fun k : ℕ ↦ B * |hSeq k|) atTop (𝓝 (B * 0)) :=
        tendsto_const_nhds.mul hStepAbs
      have hTerm2 : Tendsto (fun k : ℕ ↦ B * |hSeq k|) atTop (𝓝 0) := by
        simpa using hTerm2AtZero
      simpa [a] using hTerm1.add hTerm2
    -- Feed the vanishing factor sequence into the generic superlinear packaging lemma.
    refine hasSuperlinearConvergenceTo_of_tendsto_and_factor hTendsto haTendsto haNonneg ?_
    intro k
    simpa [a] using hRecAB k
  · intro hcontrol
    rcases hcontrol with hstep | hres
    · rcases hstep with ⟨c1, hc1_pos, hc1⟩
      -- Direct step control is exactly the source condition `(3.4.20)`.
      exact
        hasQuadraticConvergenceTo_of_tendsto_and_stepFactor
          (hTendsto := hTendsto) (hA_nonneg := hA_nonneg) (hB_nonneg := hB_nonneg)
          (hc_nonneg := le_of_lt hc1_pos) (hBound := hRecAB) (hStep := hc1)
    · rcases hres with ⟨c2, hc2_pos, hc2⟩
      have hβBi_pos : 0 < βBi := lt_trans hBi.alpha_pos hBi.alpha_lt_beta
      have hResidualStep :
          ∃ c1 > 0, ∀ k : ℕ, |hSeq k| ≤ c1 * ‖x k - xStar‖ := by
        refine ⟨c2 * βBi, mul_pos hc2_pos hβBi_pos, ?_⟩
        intro k
        rcases hSmall k with ⟨_, hkBall, _, _, _, _⟩
        have hkRes : x k ∈ Metric.ball xStar εRes :=
          Metric.ball_subset_ball hδ_le_εRes hkBall
        have hk_r : x k ∈ Metric.ball xStar r :=
          Metric.ball_subset_ball (le_of_lt hεRes_lt_r) hkRes
        have hk_small : ‖x k - xStar‖ < εRes := by
          simpa [Metric.mem_ball, dist_eq_norm] using hkRes
        have hmax :
            max ‖x k - xStar‖ ‖xStar - xStar‖ ≤ εBi := by
          calc
            max ‖x k - xStar‖ ‖xStar - xStar‖ ≤ εRes := by
              simp [norm_nonneg, le_of_lt hk_small]
            _ ≤ εBi := by
              dsimp [εRes]
              exact min_le_left _ _
