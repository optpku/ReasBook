          |hSeq k| ≤ c2 * ‖F (x k)‖ := hc2 k
          _ ≤ c2 * (βBi * ‖x k - xStar‖) := by
                gcongr
          _ = (c2 * βBi) * ‖x k - xStar‖ := by
                ring
      rcases hResidualStep with ⟨c1, hc1_pos, hc1⟩
