# Copy to .env for local use. Environment variables override this defaults file.
REASBOOK_REVIEWER_HOST=127.0.0.1
REASBOOK_REVIEWER_PORT=8876
REASBOOK_PUBLIC_ARTIFACTS=true
# Use an absolute path. Reuse the cache already populated by ReasBook SDK jobs.
# REASBOOK_CACHE_ROOT=/srv/reasbook-cache
# Optional overrides (normally derived from REASBOOK_CACHE_ROOT):
# REASBOOK_REVIEWER_DATA=/srv/reasbook-cache/reviewer/data
# REASBOOK_REVIEWER_DB=/srv/reasbook-cache/reviewer/state/reviews.sqlite3
# REASBOOK_REVIEWER_RELEASE_ROOT=/srv/reasbook-cache/releases

# Authentication is optional for reading, required for posting.
# Install the ReasLab auth package first; see README.md.
# REASLAB_AUTH_ROOT=/path/to/reaslab-auth/python/src
# REASLAB_OAUTH_ISSUER=https://reaslab.io
# REASLAB_OAUTH_CLIENT_ID=reasbook-reviewer
# REASLAB_OAUTH_CLIENT_SECRET=
# REASLAB_OAUTH_REDIRECT_URI=https://reasbook.reaslab.io/review/api/auth/oauth/callback
# REASBOOK_SESSION_SECRET=
# REASBOOK_ADMIN_SUBJECTS=operator-subject
REASBOOK_SECURE_COOKIES=true
# For local HTTP sign-in only, set REASBOOK_SECURE_COOKIES=false.
# Leave blank behind a path-stripping proxy; navigation stays relative.
# Production origin example (no path prefix):
# REASBOOK_APP_BASE_URL=https://reasbook.reaslab.io
REASBOOK_APP_BASE_URL=
